    step_route_review_disposition -- "ready-for-merge" --> step_approve_merge
    step_validate_qa_lane --> step_approve_merge_after_qa
    step_perform_security_review --> step_approve_merge_after_security
    step_architecture_escalation --> step_approve_merge_after_architecture
    step_route_review_disposition -- "__default__" --> step_normalize_default_lane
    step_normalize_default_lane --> step_approve_merge_after_default
    step_route_review_disposition -- "__error__" --> step_capture_workflow_failure

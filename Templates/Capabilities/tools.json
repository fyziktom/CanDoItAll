      "stableId": "tool:workspace-dotnet-stop:v1",
      "stableGuidKey": "capabilities/workspace-dotnet-stop",
      "endpointOrPath": "sandbox://workspace-dotnet-stop",
      "runtimeToolName": "workspace_dotnet_stop",

-         QuickCreateActions = [ ... hardcoded actions ... ],
-         GroupContextActions = [ ... hardcoded actions ... ]
+         QuickCreateActions = chromeCatalog.DefinitionQuickCreateActions,
+         GroupContextActions = chromeCatalog.DefinitionGroupContextActions
      };
  }
```


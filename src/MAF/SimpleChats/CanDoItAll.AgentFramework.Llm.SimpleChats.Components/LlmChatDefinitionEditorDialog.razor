@using System.Collections.Immutable
@using CanDoItAll.AgentFramework.Llm.SimpleChats.UI
@using Microsoft.Extensions.Logging
@inject ILlmChatDefinitionUiGateway Definitions
@inject ILlmChatProviderUiGateway Providers
@inject ILlmChatUiAuthorizationFacade Authorization
@inject ILogger<LlmChatDefinitionEditorSession> Logger
@implements IDisposable

@if (session is not null) {
    <LlmChatDefinitionEditorSurface Presentation="@session.Presentation" Intent="HandleIntentAsync" BundledAvatars="@BundledAvatars">
        <AvatarActions Context="avatar">
            <AvatarPicker @key="session.Presentation.Generation"
                          Value="@avatar.Values.AvatarImageUrl"
                          ValueChanged="@avatar.Changed"
                          EntityName="@avatar.Values.Name"
                          EntityDescription="@avatar.Values.Summary"
                          EntityKind="Simple Chat"
                          DefaultImageSeed="@avatar.Avatar.Seed"
                          Disabled="@avatar.IsBusy"
                          TestIdPrefix="llm-chat-definition-avatar" />
        </AvatarActions>
    </LlmChatDefinitionEditorSurface>
}

@code {
    [Parameter] public Guid? DefinitionId { get; set; }
    [Parameter] public EventCallback<LlmChatDefinitionListItem> Saved { get; set; }
    [Parameter] public EventCallback Cancelled { get; set; }
    private static readonly ImmutableArray<string> BundledAvatars = AgentAvatarImageCatalog.BundledAvatarUrls.ToImmutableArray();
    private LlmChatDefinitionEditorSession? session;
    private bool disposed;

    protected override void OnInitialized() {
        session = new(Definitions, Providers, Authorization, Logger);
        session.Changed += OnChanged;
    }
    protected override Task OnParametersSetAsync() => session!.SetTargetAsync(DefinitionId);
    private void OnChanged() {
        if (!disposed) {
            StateHasChanged();
        }
    }
    private async Task HandleIntentAsync(DefinitionEditorIntent intent) {
        if (session is null || !session.IsCurrent(intent.Generation)) {
            return;
        }
        if (intent.Action == DefinitionEditorAction.Cancel) {
            if (session.Cancel(intent.Generation)) {
                await Cancelled.InvokeAsync();
            }
            return;
        }
        if (intent.Action == DefinitionEditorAction.Reload) {
            await session.ReloadAsync(intent.Generation);
            return;
        }
        var captured = intent with { Submission = intent.Submission is { } values ? values with { Tags = values.Tags.ToImmutableArray() } : null };
        var saved = await session.SubmitAsync(captured);
        if (saved is not null && session.IsCurrent(intent.Generation)) {
            await Saved.InvokeAsync(saved);
        }
    }
    public void Dispose() {
        disposed = true;
        session?.Dispose();
    }
}

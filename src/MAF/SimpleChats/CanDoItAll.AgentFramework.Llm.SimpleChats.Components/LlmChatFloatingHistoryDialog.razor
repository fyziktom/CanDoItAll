@implements IDisposable
@{ var renderedGeneration = generation; }

@if (RequiresAcknowledgement) {
    <Stack GapScale="LayoutGap.Small">
        <Alert AlertStyle="AlertStyle.Warning">An earlier command may have succeeded. Inspect the current bounded history before authorizing another command.</Alert>
        <FormField Text="I inspected this history and understand that another command is a separate action.">
            <CheckBox TValue="bool" @bind-Value="acknowledged" data-testid="floating-simple-chat-history-acknowledge" />
        </FormField>
        <Button Text="Acknowledge reviewed commands" Disabled="@(!acknowledged)"
                Click="@(() => AcknowledgeAsync(renderedGeneration))" data-testid="floating-simple-chat-history-reviewed" />
    </Stack>
}

<ConversationThreadHistoryList Threads="@threads"
                               MaxItems="25"
                               ContextLabel="@Definition?.Name"
                               EmptyEyebrow="Simple Chat history"
                               EmptyTitle="No saved conversations"
                               EmptyDescription="This definition does not have a durable conversation yet."
                               Selected="@(key => SelectConversationAsync(key, renderedGeneration))" />

@code {
    [CascadingParameter] public DialogReference? DialogReference { get; set; }
    private long generation;
    private bool disposed;
    private bool acknowledged;

    [Parameter] public bool RequiresAcknowledgement { get; set; }

    [Parameter]
    public LlmChatDefinitionListItem? Definition { get; set; }

    [Parameter]
    public IReadOnlyList<LlmChatConversationListItem> Conversations { get; set; } = [];

    private IReadOnlyList<ConversationThreadPresentation> threads = [];

    protected override void OnParametersSet() {
        generation++;
        acknowledged = false;
        threads = Conversations
            .Select(item => LlmChatConversationPresentationMapper.ToThread(item, null, false))
            .ToArray();
    }

    private Task AcknowledgeAsync(long renderedGeneration) => !disposed && generation == renderedGeneration && acknowledged
        ? DialogReference?.CloseAsync(LlmChatFloatingHistoryResolution.CommandsReviewed) ?? Task.CompletedTask
        : Task.CompletedTask;

    private Task SelectConversationAsync(ConversationPresentationKey key, long renderedGeneration) {
        if (disposed || generation != renderedGeneration) {
            return Task.CompletedTask;
        }
        if (!LlmChatConversationPresentationMapper.TryGetConversationId(key, out var conversationId)) {
            throw new InvalidOperationException($"'{key.Value}' is not a Simple Chat conversation key.");
        }

        return Conversations.Any(item => item.ConversationId == conversationId)
            ? DialogReference?.CloseAsync(conversationId) ?? Task.CompletedTask
            : Task.CompletedTask;
    }

    public void Dispose() => disposed = true;
}

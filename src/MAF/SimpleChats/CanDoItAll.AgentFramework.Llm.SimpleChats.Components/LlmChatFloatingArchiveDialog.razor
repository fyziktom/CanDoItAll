@implements IDisposable
@{ var renderedGeneration = generation; }

@if (Conversation is not null) {
    <DangerActionDialog Eyebrow="Archive conversation"
                        Title="@($"Archive {Conversation.Title}")"
                        Description="Archiving keeps the canonical transcript but makes this conversation read-only."
                        RequiredConfirmation="@Conversation.Title"
                        ConfirmButtonText="Archive"
                        Confirmed="@(() => CloseAsync(true, renderedGeneration))"
                        Cancelled="@(() => CloseAsync(false, renderedGeneration))"
                        TestId="floating-simple-chat-archive-confirmation" />
}

@code {
    [CascadingParameter] public DialogReference? DialogReference { get; set; }
    private long generation;
    private bool disposed;

    [Parameter]
    public LlmChatConversationListItem? Conversation { get; set; }

    protected override void OnParametersSet() => generation++;

    private Task CloseAsync(bool confirmed, long renderedGeneration) => !disposed && generation == renderedGeneration
        ? DialogReference?.CloseAsync(confirmed) ?? Task.CompletedTask
        : Task.CompletedTask;

    public void Dispose() => disposed = true;
}

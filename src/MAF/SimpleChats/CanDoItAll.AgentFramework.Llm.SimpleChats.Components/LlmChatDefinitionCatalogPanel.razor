@using CanDoItAll.AgentFramework.Llm.SimpleChats.UI
@using Microsoft.Extensions.Logging
@inject ILlmChatDefinitionUiGateway Definitions
@inject ILlmChatUiAuthorizationFacade Authorization
@inject ILogger<LlmChatDefinitionCatalogSession> Logger
@implements IAsyncDisposable

<LlmChatDefinitionCatalogSurface Presentation="session.Presentation" Limits="LlmChatDefinitionCatalogSession.Limits"
                                 SelectedDefinitionId="selectedDefinitionId" OnIntent="DispatchAsync" />
@if (editorKind != EditorKind.None) {
    var ownedEditor = editorGeneration;
    <LlmChatDefinitionEditorDialog @key="ownedEditor" DefinitionId="selectedDefinitionId"
                                   Saved="@((LlmChatDefinitionListItem value) => HandleSavedAsync(ownedEditor))"
                                   Cancelled="@(() => CloseEditorAsync(ownedEditor))" />
}

@code {
    [Parameter] public Guid? RequestedDefinitionId { get; set; }
    [Parameter] public EventCallback<Guid?> SelectedDefinitionIdChanged { get; set; }
    private enum EditorKind { None, Route, LocalCreate }
    private LlmChatDefinitionCatalogSession session = default!;
    private CancellationTokenSource? authorizationOwner;
    private Guid? observedRouteTarget;
    private Guid? selectedDefinitionId;
    private EditorKind editorKind;
    private long editorGeneration;
    private bool disposed;

    protected override async Task OnInitializedAsync() {
        session = new(Definitions, LlmChatDefinitionPresentationMapper.ToCatalogCard, Logger);
        session.Changed += Render;
        using var owner = new CancellationTokenSource();
        authorizationOwner = owner;
        try {
            var access = await Authorization.GetAsync(owner.Token);
            if (disposed || owner.IsCancellationRequested) {
                return;
            }
            session.AcceptAuthorization(access);
            SynchronizeRouteTarget();
        } catch (OperationCanceledException) when (owner.IsCancellationRequested) {
        } catch (Exception exception) {
            if (!disposed) {
                Logger.LogWarning("Definition catalog authorization failed ({ExceptionType}).", exception.GetType().Name);
                session.FailAuthorization();
            }
        } finally {
            authorizationOwner = null;
        }
        await session.ReloadAsync();
    }

    protected override void OnParametersSet() => SynchronizeRouteTarget();

    private void SynchronizeRouteTarget() {
        if (disposed || session.Authorization is null) {
            return;
        }
        var target = RequestedDefinitionId == Guid.Empty ? null : RequestedDefinitionId;
        if (target == observedRouteTarget) {
            return;
        }
        observedRouteTarget = target;
        if (!session.Presentation.CanManage) {
            return;
        }
        if (target is { } id) {
            OpenEditor(id, EditorKind.Route);
        } else if (editorKind == EditorKind.Route) {
            ClearEditor();
        }
    }

    private Task DispatchAsync(DefinitionCatalogIntent intent) {
        if (disposed) {
            return Task.CompletedTask;
        }
        return intent switch {
            DefinitionCatalogIntent.CreateDefinition when session.Presentation.CanManage => SelectEditorAsync(null, EditorKind.LocalCreate),
            DefinitionCatalogIntent.EditDefinition edit when session.Presentation.CanManage && edit.DefinitionId != Guid.Empty
                => SelectEditorAsync(edit.DefinitionId, EditorKind.Route),
            _ => session.ApplyAsync(intent)
        };
    }

    private async Task SelectEditorAsync(Guid? id, EditorKind kind) {
        observedRouteTarget = id;
        OpenEditor(id, kind);
        await SelectedDefinitionIdChanged.InvokeAsync(id);
    }
    private void OpenEditor(Guid? id, EditorKind kind) {
        selectedDefinitionId = id;
        editorKind = kind;
        editorGeneration++;
    }
    private void ClearEditor() {
        editorKind = EditorKind.None;
        selectedDefinitionId = null;
        editorGeneration++;
    }
    private async Task CloseEditorAsync(long owner) {
        if (disposed || owner != editorGeneration || editorKind == EditorKind.None) {
            return;
        }
        ClearEditor();
        observedRouteTarget = null;
        await SelectedDefinitionIdChanged.InvokeAsync(null);
    }
    private async Task HandleSavedAsync(long owner) {
        if (disposed || owner != editorGeneration || editorKind == EditorKind.None) {
            return;
        }
        await CloseEditorAsync(owner);
        await session.ReloadAsync();
    }
    private void Render() => _ = InvokeAsync(() => {
        if (!disposed) {
            StateHasChanged();
        }
    });
    public ValueTask DisposeAsync() {
        if (!disposed) {
            disposed = true;
            authorizationOwner?.Cancel();
            session.Dispose();
        }
        return ValueTask.CompletedTask;
    }
}

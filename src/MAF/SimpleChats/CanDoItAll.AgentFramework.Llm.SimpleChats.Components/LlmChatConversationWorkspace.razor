@using System.Collections.Immutable
@using CanDoItAll.AgentFramework.Llm.SimpleChats.UI
@using Microsoft.Extensions.Logging
@inject ILlmChatDefinitionUiGateway Definitions
@inject ILlmChatConversationUiGateway Conversations
@inject ILlmChatOperationUiGateway Operations
@inject ILlmChatUiAuthorizationFacade Authorization
@inject ILlmChatUiEventSessionGateway EventSessions
@inject ILlmChatOperationProjectionReducer ProjectionReducer
@inject IEnumerable<ILlmChatComposerActionContributor> ComposerActionContributors
@inject ILogger<LlmChatConversationWorkspaceController> Logger
@inject ILogger<LlmChatOperationFollower> FollowerLogger
@implements IAsyncDisposable

<LlmChatConversationSurface Presentation="@LlmChatConversationPresentationMapper.ToWorkspace(controller, Focused, draftPrompt, composerKey)" Intent="HandleIntentAsync">
    <ComposerActions>
        @if (controller?.SelectedConversation is { } selected) {
            var generation = controller.SelectionGeneration;
            var context = new LlmChatComposerActionContext(selected.ProviderModel,
                EventCallback.Factory.Create<string>(this, content => InsertPromptAsync(content, generation)),
                TargetKey: generation);
            @foreach (var contributor in ComposerActionContributors) {
                @contributor.Render(context)
            }
        }
    </ComposerActions>
</LlmChatConversationSurface>

<LlmChatConversationDialogSurface Presentation="@DialogPresentation" Intent="HandleDialogIntentAsync" />

@code {
    [Parameter] public Guid? InitialConversationId { get; set; }
    [Parameter] public EventCallback<Guid?> SelectedConversationIdChanged { get; set; }
    [Parameter] public bool Focused { get; set; }
    private LlmChatConversationWorkspaceController? controller;
    private LlmChatOperationFollower? operationFollower;
    private CancellationTokenSource? followerLifetime;
    private Task followerTask = Task.CompletedTask;
    private Task initialization = Task.CompletedTask;
    private Guid? observedRoute;
    private bool routeObserved;
    private long routeGeneration;
    private long dialogGeneration;
    private bool disposed;
    private Guid? selectedStartDefinitionId;
    private string startTitle = "";
    private string renameTitle = "";
    private string draftPrompt = "";
    private int composerKey;
    private bool startDialogOpen;
    private bool renameDialogOpen;
    private bool archiveDialogOpen;

    private ConversationDialogOrigin DialogOrigin => new(dialogGeneration,
        startDialogOpen ? ConversationDialogKind.Start : renameDialogOpen ? ConversationDialogKind.Rename
            : archiveDialogOpen ? ConversationDialogKind.Archive : ConversationDialogKind.None,
        renameDialogOpen || archiveDialogOpen ? controller?.SelectedConversation?.ConversationId : null);

    private ConversationDialogPresentation DialogPresentation => new(DialogOrigin,
        startDialogOpen ? startTitle : renameDialogOpen ? renameTitle : controller?.SelectedConversation?.Title ?? "",
        selectedStartDefinitionId,
        startDialogOpen && controller is not null
            ? controller.ActiveDefinitions.Select(LlmChatDefinitionPresentationMapper.ToCatalogCard).ToImmutableArray() : [],
        controller?.HasMoreDefinitions ?? false, controller?.IsLoading ?? false, controller?.IsMutating ?? false);

    private async Task HandleDialogIntentAsync(ConversationDialogIntent intent) {
        if (disposed || controller is null || intent.Origin != DialogOrigin || intent.Origin.Kind == ConversationDialogKind.None) {
            return;
        }
        if (intent.Action == ConversationDialogAction.Close) {
            CloseOwnedDialog(intent.Origin.Generation);
            return;
        }
        if (controller.IsMutating) {
            return;
        }
        switch (intent.Action) {
            case ConversationDialogAction.TitleChanged when startDialogOpen:
                startTitle = intent.Text ?? "";
                break;
            case ConversationDialogAction.TitleChanged when renameDialogOpen:
                renameTitle = intent.Text ?? "";
                break;
            case ConversationDialogAction.SelectDefinition when startDialogOpen && intent.DefinitionId is { } id:
                SelectStartDefinition(id);
                break;
            case ConversationDialogAction.LoadMoreDefinitions when startDialogOpen:
                await controller.LoadMoreDefinitionsAsync(CancellationToken.None);
                break;
            case ConversationDialogAction.Confirm when startDialogOpen:
                await CreateConversationAsync(intent.Origin.Generation);
                break;
            case ConversationDialogAction.Confirm when renameDialogOpen:
                await RenameConversationAsync(intent.Origin.Generation);
                break;
            case ConversationDialogAction.Confirm when archiveDialogOpen:
                await ArchiveConversationAsync(intent.Origin.Generation);
                break;
        }
    }

    protected override void OnInitialized() {
        controller = new(Definitions, Conversations, Operations, Authorization, Logger, TimeProvider.System);
        operationFollower = new(EventSessions, ProjectionReducer, FollowerLogger);
    }

    protected override async Task OnParametersSetAsync() {
        var target = InitialConversationId;
        if (disposed || routeObserved && observedRoute == target) {
            return;
        }
        var first = !routeObserved;
        routeObserved = true;
        observedRoute = target;
        if (!first && controller!.DesiredConversationId == target && controller.SelectedConversation?.ConversationId == target) {
            await controller.SetRequestedConversationAsync(target, CancellationToken.None);
            return;
        }
        var owner = ++routeGeneration;
        CloseOwnedDialogs();
        StopFollower();
        ClearComposer();
        if (first) {
            initialization = controller!.InitializeAsync(CancellationToken.None, target);
            await initialization;
        } else {
            await controller!.SetRequestedConversationAsync(target, CancellationToken.None);
            if (controller.IsAuthorizing) {
                await initialization;
            }
        }
        if (!disposed && owner == routeGeneration) {
            await AcceptSelectionAsync(controller!.SelectionGeneration, notify: !first);
        }
    }

    private async Task HandleIntentAsync(ConversationWorkspaceIntent intent) {
        if (controller is null || !controller.IsCurrentSelection(intent.Generation)) {
            return;
        }
        switch (intent.Action) {
            case ConversationWorkspaceAction.Select when intent.ConversationId is { } id:
                await SelectConversationAsync(id);
                break;
            case ConversationWorkspaceAction.LoadMoreConversations:
                await controller.LoadMoreConversationsAsync(CancellationToken.None);
                break;
            case ConversationWorkspaceAction.LoadMoreMessages:
                await controller.LoadMoreMessagesAsync(CancellationToken.None);
                break;
            case ConversationWorkspaceAction.ReloadSelected:
                StopFollower();
                if (await controller.ReloadSelectedAsync(CancellationToken.None)) {
                    await AcceptSelectionAsync(intent.Generation);
                }
                break;
            case ConversationWorkspaceAction.NewConversation:
                CloseOwnedDialogs();
                startDialogOpen = controller.Authorization.CanManage;
                break;
            case ConversationWorkspaceAction.Rename when intent.ConversationId is { } renameId:
                await OpenTargetDialogAsync(renameId, archive: false);
                break;
            case ConversationWorkspaceAction.Archive when intent.ConversationId is { } archiveId:
                await OpenTargetDialogAsync(archiveId, archive: true);
                break;
            case ConversationWorkspaceAction.DraftChanged:
                draftPrompt = intent.Text ?? "";
                break;
            case ConversationWorkspaceAction.Send:
                if (await controller.SendAsync(draftPrompt, CancellationToken.None) && controller.IsCurrentSelection(intent.Generation)) {
                    ClearComposer();
                    RestartFollower();
                }
                break;
            case ConversationWorkspaceAction.CancelResponse:
                await controller.CancelActiveOperationAsync(CancellationToken.None);
                break;
            case ConversationWorkspaceAction.Reconcile:
                await controller.ReconcileActiveOperationAsync(CancellationToken.None);
                break;
            case ConversationWorkspaceAction.Abandon:
                await controller.AbandonActiveOperationAsync(CancellationToken.None);
                break;
        }
    }

    private async Task<bool> SelectConversationAsync(Guid id) {
        var owner = ++routeGeneration;
        CloseOwnedDialogs();
        StopFollower();
        ClearComposer();
        var selected = await controller!.SelectConversationAsync(id, CancellationToken.None);
        if (!selected || disposed || owner != routeGeneration) {
            return false;
        }
        return await AcceptSelectionAsync(controller.SelectionGeneration);
    }

    private async Task<bool> AcceptSelectionAsync(long generation, bool notify = true) {
        if (!controller!.IsCurrentSelection(generation)) {
            return false;
        }
        await controller.PrepareActiveOperationAsync(CancellationToken.None);
        if (!controller.IsCurrentSelection(generation) || controller.SelectedConversation?.ConversationId != controller.DesiredConversationId) {
            return false;
        }
        RestartFollower();
        if (notify) {
            await SelectedConversationIdChanged.InvokeAsync(controller.SelectedConversation?.ConversationId);
        }
        return controller.IsCurrentSelection(generation);
    }

    private async Task OpenTargetDialogAsync(Guid id, bool archive) {
        if (!controller!.Authorization.CanManage) {
            return;
        }
        CloseOwnedDialogs();
        if (controller.SelectedConversation?.ConversationId != id) {
            var selection = SelectConversationAsync(id);
            var owner = dialogGeneration;
            if (!await selection || owner != dialogGeneration) {
                return;
            }
        }
        if (disposed || controller.SelectedConversation?.ConversationId != id || controller.DesiredConversationId != id) {
            return;
        }
        dialogGeneration++;
        renameTitle = controller.SelectedConversation.Title;
        archiveDialogOpen = archive;
        renameDialogOpen = !archive;
    }

    private void CloseOwnedDialogs() {
        dialogGeneration++;
        startDialogOpen = false;
        renameDialogOpen = false;
        archiveDialogOpen = false;
        selectedStartDefinitionId = null;
        startTitle = "";
        renameTitle = "";
    }
    private void CloseOwnedDialog(long owner) {
        if (owner == dialogGeneration) {
            CloseOwnedDialogs();
        }
    }
    private void SelectStartDefinition(Guid id) {
        if (controller!.ActiveDefinitions.FirstOrDefault(item => item.DefinitionId == id) is { } definition) {
            selectedStartDefinitionId = id;
            if (string.IsNullOrWhiteSpace(startTitle)) {
                startTitle = $"{definition.Name} chat";
            }
        }
    }
    private async Task CreateConversationAsync(long owner) {
        if (owner != dialogGeneration || !startDialogOpen || selectedStartDefinitionId is not { } id) {
            return;
        }
        if (await controller!.CreateAsync(id, startTitle, CancellationToken.None) && !disposed && owner == dialogGeneration) {
            routeGeneration++;
            CloseOwnedDialog(owner);
            ClearComposer();
            await AcceptSelectionAsync(controller.SelectionGeneration);
        }
    }
    private async Task RenameConversationAsync(long owner) {
        if (owner != dialogGeneration || !renameDialogOpen) {
            return;
        }
        if (await controller!.RenameSelectedAsync(renameTitle, CancellationToken.None)) {
            CloseOwnedDialog(owner);
        }
    }
    private async Task ArchiveConversationAsync(long owner) {
        if (owner != dialogGeneration || !archiveDialogOpen) {
            return;
        }
        var generation = controller!.SelectionGeneration;
        if (await controller.ArchiveSelectedAsync(CancellationToken.None) && controller.IsCurrentSelection(generation) && owner == dialogGeneration) {
            CloseOwnedDialog(owner);
            await SelectedConversationIdChanged.InvokeAsync(controller.SelectedConversation?.ConversationId);
        }
    }
    private Task InsertPromptAsync(string content, long generation) {
        if (controller!.IsCurrentSelection(generation)) {
            ArgumentException.ThrowIfNullOrWhiteSpace(content);
            draftPrompt = string.IsNullOrWhiteSpace(draftPrompt) ? content.Trim() : $"{draftPrompt.TrimEnd()}{Environment.NewLine}{Environment.NewLine}{content.Trim()}";
            composerKey++;
            StateHasChanged();
        }
        return Task.CompletedTask;
    }
    private void ClearComposer() {
        draftPrompt = "";
        composerKey++;
    }

    private void RestartFollower() {
        StopFollower();
        if (disposed || controller?.ActiveOperation is not { } operation || operation.Status == LlmChatOperationStatus.RecoveryRequired) {
            return;
        }
        var source = new CancellationTokenSource();
        followerLifetime = source;
        followerTask = RunFollowerAsync(operation.OperationId, operation.ConversationId, controller.SelectionGeneration, source);
    }
    private bool OwnsFollower(Guid conversationId, long generation, CancellationTokenSource source)
        => !disposed && ReferenceEquals(followerLifetime, source) && !source.IsCancellationRequested
            && controller!.IsCurrentSelection(generation) && controller.SelectedConversation?.ConversationId == conversationId;

    private async Task RunFollowerAsync(Guid operationId, Guid conversationId, long generation, CancellationTokenSource source) {
        using (source) {
            try {
                var result = await operationFollower!.FollowAsync(operationId,
                    projection => !OwnsFollower(conversationId, generation, source) ? Task.CompletedTask : InvokeAsync(() => {
                        if (OwnsFollower(conversationId, generation, source)) {
                            controller!.ApplyOperationProjection(projection);
                            StateHasChanged();
                        }
                    }),
                    projection => !OwnsFollower(conversationId, generation, source) ? Task.CompletedTask : InvokeAsync(async () => {
                        if (OwnsFollower(conversationId, generation, source)) {
                            await controller!.RefreshActiveOperationAsync(projection.OperationId, source.Token);
                            if (OwnsFollower(conversationId, generation, source)) {
                                StateHasChanged();
                            }
                        }
                    }), source.Token);
                if (!OwnsFollower(conversationId, generation, source)) {
                    return;
                }
                if (result.Completion == LlmChatOperationFollowCompletion.ProfileChanged) {
                    await InvokeAsync(ReloadProfileAsync);
                } else if (result.Completion == LlmChatOperationFollowCompletion.Failed) {
                    await InvokeAsync(() => {
                        if (OwnsFollower(conversationId, generation, source)) {
                            controller!.SetFollowerFailure(result.Failures);
                            StateHasChanged();
                        }
                    });
                }
            } catch (OperationCanceledException) when (source.IsCancellationRequested) {
            } catch (Exception exception) {
                if (OwnsFollower(conversationId, generation, source)) {
                    FollowerLogger.LogWarning("Simple Chat follower failed for selection {Generation} with {ExceptionType}", generation, exception.GetType().Name);
                    await InvokeAsync(() => {
                        if (OwnsFollower(conversationId, generation, source)) {
                            controller!.SetFollowerFailure([new(LlmChatUiFailureCodes.RequestFailed, "The Simple Chat event stream could not be read.")]);
                            StateHasChanged();
                        }
                    });
                }
            } finally {
                if (ReferenceEquals(followerLifetime, source)) {
                    followerLifetime = null;
                }
            }
        }
    }
    private async Task ReloadProfileAsync() {
        if (disposed) {
            return;
        }
        var owner = ++routeGeneration;
        CloseOwnedDialogs();
        StopFollower();
        ClearComposer();
        initialization = controller!.ReloadForProfileChangeAsync(CancellationToken.None);
        await initialization;
        if (!disposed && owner == routeGeneration) {
            await AcceptSelectionAsync(controller.SelectionGeneration);
            StateHasChanged();
        }
    }
    private void StopFollower() {
        var previous = followerLifetime;
        followerLifetime = null;
        previous?.Cancel();
    }
    public async ValueTask DisposeAsync() {
        disposed = true;
        routeGeneration++;
        CloseOwnedDialogs();
        StopFollower();
        controller?.Dispose();
        await followerTask;
    }
}

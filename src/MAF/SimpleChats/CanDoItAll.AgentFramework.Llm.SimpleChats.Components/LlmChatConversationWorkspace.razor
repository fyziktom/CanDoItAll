@using System.Collections.Immutable
@using CanDoItAll.AgentFramework.Llm.SimpleChats.UI
@using CanDoItAll.AgentFramework.Llm.SimpleChats.Conversations
@using Microsoft.Extensions.Logging
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Navigation
@inject ILlmChatDefinitionUiGateway Definitions
@inject ILlmChatConversationUiGateway Conversations
@inject ILlmChatOperationUiGateway Operations
@inject ILlmChatConversationEditorAccess EditorAccess
@inject ILlmChatUiAuthorizationFacade Authorization
@inject ILlmChatUiEventSessionGateway EventSessions
@inject ILlmChatOperationProjectionReducer ProjectionReducer
@inject IEnumerable<ILlmChatComposerActionContributor> ComposerActionContributors
@inject ILogger<LlmChatConversationWorkspaceController> Logger
@inject ILogger<LlmChatOperationFollower> FollowerLogger
@implements IAsyncDisposable

<NavigationLock ConfirmExternalNavigation="@(HasUnfinishedDraft || controller?.IsMutating == true)" OnBeforeInternalNavigation="GuardNavigation" />

<LlmChatConversationSurface Presentation="@WorkspacePresentation" Intent="HandleIntentAsync">
    <ComposerActions>
        @if (controller?.SelectedConversation is { } selected) {
            var generation = controller.SelectionGeneration;
            var context = new LlmChatComposerActionContext(selected.ProviderModel,
                EventCallback.Factory.Create<string>(this, content => InsertPromptAsync(content, generation)),
                TargetKey: generation);
            @foreach (var contributor in ComposerActionContributors) {
                @contributor.Render(context)
            }
        }
    </ComposerActions>
</LlmChatConversationSurface>

<LlmChatConversationDialogSurface Presentation="@DialogPresentation" Intent="HandleDialogIntentAsync" />

@code {
    [Parameter] public Guid? InitialConversationId { get; set; }
    [Parameter] public EventCallback<Guid?> SelectedConversationIdChanged { get; set; }
    [Parameter] public bool Focused { get; set; }
    [Parameter] public Func<string, Guid?, bool>? RetainsNavigation { get; set; }
    [Parameter] public EventCallback NavigationBlocked { get; set; }
    private LlmChatConversationWorkspaceController? controller;
    private LlmChatOperationFollower? operationFollower;
    private CancellationTokenSource? followerLifetime;
    private Task followerTask = Task.CompletedTask;
    private Task initialization = Task.CompletedTask;
    private Guid? observedRoute;
    private bool routeObserved;
    private long routeGeneration;
    private long dialogGeneration;
    private bool disposed;
    private Guid? selectedStartDefinitionId;
    private string startTitle = "";
    private string draftPrompt = "";
    private long draftRevision;
    private LlmChatConversationMetadataDraft? metadataDraft;
    private LlmChatEditorOpening? dialogOpening;
    private LlmChatConversationAccessSession accessSession = default!;
    private long changeRevision;
    private long refreshedRevision;
    private bool dialogReadBusy;
    private bool dialogCommandPending;
    private bool dialogDiscard;
    private bool unconfirmedCreate;
    private string createNotice = "";
    private ConversationWorkspaceIntent? pendingTransition;
    private string? pendingNavigation;
    private int composerKey;
    private bool startDialogOpen;
    private bool renameDialogOpen;
    private bool archiveDialogOpen;

    private ConversationWorkspacePresentation WorkspacePresentation
        => LlmChatConversationPresentationMapper.ToWorkspace(controller, Focused, draftPrompt, composerKey)
            with {
                IsAuthorizing = !RendererInfo.IsInteractive || controller?.IsAuthorizing != false,
                UpdatesAvailable = changeRevision != refreshedRevision,
                RequiresDiscard = pendingTransition is not null || pendingNavigation is not null
            };

    private bool HasUnfinishedDraft => !string.IsNullOrEmpty(draftPrompt) || metadataDraft?.HasChanges == true ||
        metadataDraft?.Unconfirmed == true || dialogCommandPending || startDialogOpen && !string.IsNullOrEmpty(startTitle) || unconfirmedCreate;

    private ConversationDialogOrigin DialogOrigin => new(dialogGeneration,
        startDialogOpen ? ConversationDialogKind.Start : renameDialogOpen ? ConversationDialogKind.Rename
            : archiveDialogOpen ? ConversationDialogKind.Archive : ConversationDialogKind.None,
        renameDialogOpen || archiveDialogOpen ? metadataDraft?.Original.ConversationId : null);

    private ConversationDialogPresentation DialogPresentation => new(DialogOrigin,
        startDialogOpen ? startTitle : metadataDraft?.Title ?? "",
        selectedStartDefinitionId,
        startDialogOpen && controller is not null
            ? controller.ActiveDefinitions.Select(LlmChatDefinitionPresentationMapper.ToCatalogCard).ToImmutableArray() : [],
        controller?.HasMoreDefinitions ?? false, dialogReadBusy || controller?.IsLoading == true, dialogCommandPending || controller?.IsMutating == true,
        metadataDraft?.Comparison, metadataDraft?.NeedsReview == true || renameDialogOpen && metadataDraft?.Original.Status == LlmChatConversationStatus.Archived,
        metadataDraft?.Notice ?? createNotice, metadataDraft?.Unconfirmed ?? false, dialogDiscard, metadataDraft?.CanUndo ?? false, unconfirmedCreate,
        metadataDraft?.StateInformation ?? "");

    private async Task HandleDialogIntentAsync(ConversationDialogIntent intent) {
        if (disposed || controller is null || intent.Origin != DialogOrigin || intent.Origin.Kind == ConversationDialogKind.None) {
            return;
        }
        var submittedTitle = startDialogOpen ? startTitle : metadataDraft?.Title ?? "";
        var submittedRevision = metadataDraft?.Revision ?? 0;
        if (intent.Action == ConversationDialogAction.TitleChanged) {
            if (accessSession.IsCurrent && dialogOpening is { IsCurrent: true }) {
                await HandleAuthorizedDialogIntentAsync(intent, submittedTitle, submittedRevision);
            } else if (!disposed) {
                await RetireAccessAsync();
            }
            return;
        }
        var command = intent.Action == ConversationDialogAction.Confirm;
        if (command && (dialogCommandPending || controller.IsMutating || dialogReadBusy)) {
            return;
        }
        if (command) {
            dialogCommandPending = true;
        }
        try {
            await accessSession.AuthorizeReadAsync(CancellationToken.None);
            await HandleAuthorizedDialogIntentAsync(intent, submittedTitle, submittedRevision, command);
        } catch (Exception exception) {
            await HandleAccessFailureAsync(exception);
        } finally {
            if (command && intent.Origin.Generation == dialogGeneration) {
                dialogCommandPending = false;
            }
        }
    }

    private async Task HandleAuthorizedDialogIntentAsync(ConversationDialogIntent intent, string submittedTitle, long submittedRevision, bool ownsCommand = false) {
        if (disposed || controller is null || intent.Origin != DialogOrigin || intent.Origin.Kind == ConversationDialogKind.None) {
            return;
        }
        var localTitle = renameDialogOpen && intent.Action == ConversationDialogAction.TitleChanged;
        if ((dialogReadBusy || controller.IsMutating || dialogCommandPending && !ownsCommand) && !localTitle) {
            return;
        }
        if (intent.Action == ConversationDialogAction.Close) {
            if (metadataDraft?.HasChanges == true || metadataDraft?.Unconfirmed == true || startDialogOpen && !string.IsNullOrEmpty(startTitle) || unconfirmedCreate) {
                dialogDiscard = true;
            } else {
                CloseOwnedDialog(intent.Origin.Generation);
            }
            return;
        }
        switch (intent.Action) {
            case ConversationDialogAction.TitleChanged when startDialogOpen:
                startTitle = intent.Text ?? "";
                break;
            case ConversationDialogAction.TitleChanged when renameDialogOpen:
                metadataDraft!.SetTitle(intent.Text ?? "");
                break;
            case ConversationDialogAction.Compare:
                await CompareMetadataAsync(intent.Origin.Generation);
                break;
            case ConversationDialogAction.ApplyComparison:
                metadataDraft?.Apply(intent.Acknowledged);
                break;
            case ConversationDialogAction.Undo:
                metadataDraft?.Undo();
                break;
            case ConversationDialogAction.Discard when dialogDiscard:
                CloseOwnedDialog(intent.Origin.Generation);
                break;
            case ConversationDialogAction.KeepEditing:
                dialogDiscard = false;
                break;
            case ConversationDialogAction.SelectDefinition when startDialogOpen && intent.DefinitionId is { } id:
                SelectStartDefinition(id);
                break;
            case ConversationDialogAction.LoadMoreDefinitions when startDialogOpen:
                await controller.LoadMoreDefinitionsAsync(CancellationToken.None);
                break;
            case ConversationDialogAction.Confirm when startDialogOpen:
                await CreateConversationAsync(intent.Origin.Generation, submittedTitle);
                break;
            case ConversationDialogAction.Confirm when renameDialogOpen:
                await RenameConversationAsync(intent.Origin.Generation, submittedTitle, submittedRevision);
                break;
            case ConversationDialogAction.Confirm when archiveDialogOpen:
                await ArchiveConversationAsync(intent.Origin.Generation);
                break;
        }
    }

    protected override void OnInitialized() {
        controller = new(Definitions, Conversations, Operations, Authorization, Logger, TimeProvider.System);
        operationFollower = new(EventSessions, ProjectionReducer, FollowerLogger);
        accessSession = new(EditorAccess, () => InvokeAsync(() => {
            if (!disposed) {
                changeRevision++;
                StateHasChanged();
            }
        }), RetireAccessAsync);
    }

    protected override async Task OnParametersSetAsync() {
        var target = InitialConversationId;
        if (disposed || !RendererInfo.IsInteractive || routeObserved && observedRoute == target) {
            return;
        }
        var first = !routeObserved;
        routeObserved = true;
        observedRoute = target;
        if (!first && controller!.DesiredConversationId == target && controller.SelectedConversation?.ConversationId == target) {
            await controller.SetRequestedConversationAsync(target, CancellationToken.None);
            return;
        }
        var owner = ++routeGeneration;
        CloseOwnedDialogs();
        StopFollower();
        ClearComposer();
        if (first) {
            if (!await OpenCatalogAsync()) {
                return;
            }
            initialization = controller!.InitializeAsync(CancellationToken.None, target);
            await initialization;
        } else {
            await controller!.SetRequestedConversationAsync(target, CancellationToken.None);
            if (controller.IsAuthorizing) {
                await initialization;
            }
        }
        if (!disposed && owner == routeGeneration) {
            await AcceptSelectionAsync(controller!.SelectionGeneration, notify: !first);
        }
    }

    private async Task HandleIntentAsync(ConversationWorkspaceIntent intent) {
        if (intent.Action == ConversationWorkspaceAction.DraftChanged) {
            if (accessSession.IsCurrent) {
                await HandleAuthorizedIntentAsync(intent, draftPrompt, draftRevision);
            } else if (!disposed) {
                await RetireAccessAsync();
            }
            return;
        }
        var submittedMessage = draftPrompt;
        var submittedRevision = draftRevision;
        try {
            await accessSession.AuthorizeReadAsync(CancellationToken.None);
            await HandleAuthorizedIntentAsync(intent, submittedMessage, submittedRevision);
            if (!disposed) {
                await accessSession.AuthorizeReadAsync(CancellationToken.None);
            }
        } catch (Exception exception) {
            await HandleAccessFailureAsync(exception);
        }
    }

    private async Task HandleAuthorizedIntentAsync(ConversationWorkspaceIntent intent, string submittedMessage, long submittedRevision) {
        if (controller is null || !controller.IsCurrentSelection(intent.Generation)) {
            return;
        }
        if (intent.Action == ConversationWorkspaceAction.KeepEditing) {
            pendingTransition = null;
            pendingNavigation = null;
            return;
        }
        if (intent.Action == ConversationWorkspaceAction.DiscardDraft && !controller.IsMutating) {
            var next = pendingTransition;
            var location = pendingNavigation;
            pendingTransition = null;
            pendingNavigation = null;
            ClearComposer();
            CloseOwnedDialogs();
            if (next is not null) {
                await HandleAuthorizedIntentAsync(next, draftPrompt, draftRevision);
            } else if (location is not null) {
                Navigation.NavigateTo(location);
            }
            return;
        }
        if (intent.Action == ConversationWorkspaceAction.Select && intent.ConversationId == controller.SelectedConversation?.ConversationId) {
            return;
        }
        var changesTarget = intent.Action == ConversationWorkspaceAction.NewConversation ||
            intent.Action is ConversationWorkspaceAction.Select or ConversationWorkspaceAction.Rename or ConversationWorkspaceAction.Archive &&
            intent.ConversationId != controller.SelectedConversation?.ConversationId;
        var replacesDialog = intent.Action is ConversationWorkspaceAction.NewConversation or ConversationWorkspaceAction.Rename or ConversationWorkspaceAction.Archive &&
            (metadataDraft?.HasChanges == true || metadataDraft?.Unconfirmed == true || startDialogOpen && !string.IsNullOrEmpty(startTitle) || unconfirmedCreate);
        if (changesTarget && controller.IsMutating || dialogCommandPending && intent.Action is
            (ConversationWorkspaceAction.Select or ConversationWorkspaceAction.NewConversation or ConversationWorkspaceAction.Rename or
             ConversationWorkspaceAction.Archive or ConversationWorkspaceAction.Send or ConversationWorkspaceAction.CancelResponse or
             ConversationWorkspaceAction.Reconcile or ConversationWorkspaceAction.Abandon or ConversationWorkspaceAction.DiscardDraft)) {
            return;
        }
        if (changesTarget && HasUnfinishedDraft || replacesDialog) {
            pendingTransition = intent;
            return;
        }
        switch (intent.Action) {
            case ConversationWorkspaceAction.Select when intent.ConversationId is { } id:
                await SelectConversationAsync(id);
                break;
            case ConversationWorkspaceAction.LoadMoreConversations:
                await controller.LoadMoreConversationsAsync(CancellationToken.None);
                break;
            case ConversationWorkspaceAction.RefreshConversations:
                var coveringRevision = changeRevision;
                if (await controller.RefreshConversationsAsync(CancellationToken.None)) {
                    refreshedRevision = coveringRevision;
                }
                break;
            case ConversationWorkspaceAction.LoadMoreMessages:
                await controller.LoadMoreMessagesAsync(CancellationToken.None);
                break;
            case ConversationWorkspaceAction.ReloadSelected:
                var coveringSelectionRevision = changeRevision;
                StopFollower();
                if (await controller.ReloadSelectedAsync(CancellationToken.None)) {
                    await AcceptSelectionAsync(intent.Generation);
                    if (Focused) {
                        refreshedRevision = coveringSelectionRevision;
                    }
                }
                break;
            case ConversationWorkspaceAction.NewConversation:
                CloseOwnedDialogs();
                if (controller.Authorization.CanManage) {
                    await OpenStartDialogAsync();
                }
                break;
            case ConversationWorkspaceAction.Rename when intent.ConversationId is { } renameId:
                await OpenTargetDialogAsync(renameId, archive: false);
                break;
            case ConversationWorkspaceAction.Archive when intent.ConversationId is { } archiveId:
                await OpenTargetDialogAsync(archiveId, archive: true);
                break;
            case ConversationWorkspaceAction.DraftChanged:
                if (draftPrompt != (intent.Text ?? "")) {
                    draftPrompt = intent.Text ?? "";
                    draftRevision++;
                }
                break;
            case ConversationWorkspaceAction.Send:
                if (await WithOperationAccessAsync(() => controller.SendAsync(submittedMessage, CancellationToken.None)) && controller.IsCurrentSelection(intent.Generation)) {
                    if (submittedRevision == draftRevision) {
                        ClearComposer();
                    }
                    RestartFollower();
                }
                break;
            case ConversationWorkspaceAction.CancelResponse when intent.OperationId is { } cancelId:
                await WithOperationAccessAsync(() => controller.CancelActiveOperationAsync(cancelId, CancellationToken.None));
                break;
            case ConversationWorkspaceAction.Reconcile when intent.OperationId is { } reconcileId:
                await WithOperationAccessAsync(() => controller.ReconcileActiveOperationAsync(reconcileId, CancellationToken.None), manage: true);
                break;
            case ConversationWorkspaceAction.Abandon when intent.OperationId is { } abandonId:
                await WithOperationAccessAsync(() => controller.AbandonActiveOperationAsync(abandonId, CancellationToken.None));
                break;
        }
    }

    private async Task<bool> SelectConversationAsync(Guid id) {
        if (controller!.IsMutating) {
            return false;
        }
        var owner = ++routeGeneration;
        CloseOwnedDialogs();
        StopFollower();
        ClearComposer();
        var selected = await controller!.SelectConversationAsync(id, CancellationToken.None);
        if (!selected || disposed || owner != routeGeneration) {
            return false;
        }
        return await AcceptSelectionAsync(controller.SelectionGeneration);
    }

    private async Task<bool> AcceptSelectionAsync(long generation, bool notify = true) {
        if (!controller!.IsCurrentSelection(generation)) {
            return false;
        }
        if (!await OpenSelectionAsync(generation)) {
            return false;
        }
        await controller.PrepareActiveOperationAsync(CancellationToken.None);
        if (!controller.IsCurrentSelection(generation) || controller.SelectedConversation?.ConversationId != controller.DesiredConversationId) {
            return false;
        }
        RestartFollower();
        if (notify) {
            await SelectedConversationIdChanged.InvokeAsync(controller.SelectedConversation?.ConversationId);
        }
        return controller.IsCurrentSelection(generation);
    }

    private async Task OpenTargetDialogAsync(Guid id, bool archive) {
        if (!controller!.Authorization.CanManage) {
            return;
        }
        CloseOwnedDialogs();
        if (controller.SelectedConversation?.ConversationId != id) {
            var selection = SelectConversationAsync(id);
            var owner = dialogGeneration;
            if (!await selection || owner != dialogGeneration) {
                return;
            }
        }
        if (disposed || controller.SelectedConversation?.ConversationId != id || controller.DesiredConversationId != id) {
            return;
        }
        dialogGeneration++;
        metadataDraft = new(controller.SelectedConversation);
        var ownerGeneration = dialogGeneration;
        try {
            dialogOpening = await accessSession.OpenAsync(id, LlmChatConversationAccessKind.Metadata,
                () => InvokeAsync(() => {
                    if (!disposed && ownerGeneration == dialogGeneration) {
                        metadataDraft?.ObserveHint();
                        StateHasChanged();
                    }
                }));
            await dialogOpening.AuthorizeAsync(true, CancellationToken.None);
            if (disposed || ownerGeneration != dialogGeneration) {
                QueueDisposal(dialogOpening);
                dialogOpening = null;
                return;
            }
        } catch (Exception exception) {
            await HandleAccessFailureAsync(exception);
            return;
        }
        archiveDialogOpen = archive;
        renameDialogOpen = !archive;
    }

    private void CloseOwnedDialogs() {
        dialogGeneration++;
        startDialogOpen = false;
        renameDialogOpen = false;
        archiveDialogOpen = false;
        selectedStartDefinitionId = null;
        startTitle = "";
        metadataDraft = null;
        dialogDiscard = false;
        dialogReadBusy = false;
        dialogCommandPending = false;
        unconfirmedCreate = false;
        createNotice = "";
        QueueDisposal(dialogOpening);
        dialogOpening = null;
    }
    private void CloseOwnedDialog(long owner) {
        if (owner == dialogGeneration) {
            CloseOwnedDialogs();
        }
    }
    private void SelectStartDefinition(Guid id) {
        if (controller!.ActiveDefinitions.FirstOrDefault(item => item.DefinitionId == id) is { } definition) {
            selectedStartDefinitionId = id;
            if (string.IsNullOrWhiteSpace(startTitle)) {
                startTitle = $"{definition.Name} chat";
            }
        }
    }
    private async Task CreateConversationAsync(long owner, string submittedTitle) {
        if (owner != dialogGeneration || !startDialogOpen || unconfirmedCreate || dialogOpening is null || selectedStartDefinitionId is not { } id) {
            return;
        }
        await dialogOpening.AuthorizeAsync(true, CancellationToken.None);
        using var admission = dialogOpening.EnterWrite(accessSession.AuthorizeReadAsync);
        if (await controller!.CreateAsync(id, submittedTitle, CancellationToken.None) && !disposed && owner == dialogGeneration) {
            routeGeneration++;
            CloseOwnedDialog(owner);
            ClearComposer();
            await AcceptSelectionAsync(controller.SelectionGeneration);
        } else if (controller.LastMutationUnconfirmed && owner == dialogGeneration) {
            unconfirmedCreate = true;
            createNotice = "The creation outcome is unconfirmed. Inspect the conversation list before explicitly discarding this opening. Do not repeat Start chat.";
        }
    }
    private async Task RenameConversationAsync(long owner, string submittedTitle, long submittedRevision) {
        if (owner != dialogGeneration || !renameDialogOpen || metadataDraft is not { NeedsReview: false, Original.Status: LlmChatConversationStatus.Active } draft || dialogOpening is null) {
            return;
        }
        await dialogOpening.AuthorizeAsync(true, CancellationToken.None);
        using var admission = dialogOpening.EnterWrite(accessSession.AuthorizeReadAsync);
        if (await controller!.RenameSelectedAsync(draft.Original, submittedTitle, CancellationToken.None)) {
            if (!disposed && owner == dialogGeneration) {
                if (draft.Revision == submittedRevision) {
                    CloseOwnedDialog(owner);
                } else {
                    if (controller.HasNewerMetadataRead) {
                        draft.ObserveHint();
                    }
                    draft.Acknowledge(controller.LastAcceptedMetadata!);
                }
            }
        } else if (!disposed && owner == dialogGeneration) {
            if (controller.LastMutationUnconfirmed) {
                draft.MarkUnknown();
            } else if (!string.IsNullOrWhiteSpace(controller.LastMutationFailure)) {
                draft.Reject(controller.LastMutationFailure);
            }
        }
    }
    private async Task ArchiveConversationAsync(long owner) {
        if (owner != dialogGeneration || !archiveDialogOpen || metadataDraft is not { NeedsReview: false } draft || dialogOpening is null) {
            return;
        }
        var generation = controller!.SelectionGeneration;
        await dialogOpening.AuthorizeAsync(true, CancellationToken.None);
        using var admission = dialogOpening.EnterWrite(accessSession.AuthorizeReadAsync);
        if (await controller.ArchiveSelectedAsync(draft.Original, CancellationToken.None) && controller.IsCurrentSelection(generation) && owner == dialogGeneration) {
            CloseOwnedDialog(owner);
            await SelectedConversationIdChanged.InvokeAsync(controller.SelectedConversation?.ConversationId);
        } else if (!disposed && owner == dialogGeneration) {
            if (controller.LastMutationUnconfirmed) {
                draft.MarkUnknown();
            } else if (!string.IsNullOrWhiteSpace(controller.LastMutationFailure)) {
                draft.Reject(controller.LastMutationFailure);
            }
        }
    }
    private Task InsertPromptAsync(string content, long generation) {
        if (controller!.IsCurrentSelection(generation)) {
            ArgumentException.ThrowIfNullOrWhiteSpace(content);
            draftPrompt = string.IsNullOrWhiteSpace(draftPrompt) ? content.Trim() : $"{draftPrompt.TrimEnd()}{Environment.NewLine}{Environment.NewLine}{content.Trim()}";
            draftRevision++;
            composerKey++;
            StateHasChanged();
        }
        return Task.CompletedTask;
    }
    private void ClearComposer() {
        draftPrompt = "";
        draftRevision++;
        composerKey++;
    }

    private async Task GuardNavigation(LocationChangingContext context) {
        if (HasUnfinishedDraft || controller?.IsMutating == true) {
            if (!dialogCommandPending && controller?.IsMutating != true && RetainsNavigation?.Invoke(context.TargetLocation, InitialConversationId) == true) {
                return;
            }
            context.PreventNavigation();
            pendingNavigation = context.TargetLocation;
            await NavigationBlocked.InvokeAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<bool> OpenCatalogAsync() {
        try {
            await accessSession.OpenCatalogAsync();
            return true;
        } catch (Exception exception) {
            await HandleAccessFailureAsync(exception);
            return false;
        }
    }

    private async Task<bool> OpenSelectionAsync(long generation) {
        if (controller!.SelectedConversation is not { } selected) {
            return false;
        }
        try {
            await accessSession.OpenSelectionAsync(selected.ConversationId);
            return controller.IsCurrentSelection(generation);
        } catch (Exception exception) {
            await HandleAccessFailureAsync(exception);
            return false;
        }
    }

    private async Task OpenStartDialogAsync() {
        var owner = dialogGeneration;
        var opening = await accessSession.OpenAsync(null, LlmChatConversationAccessKind.Metadata, () => Task.CompletedTask);
        if (disposed || owner != dialogGeneration) {
            QueueDisposal(opening);
            return;
        }
        await opening.AuthorizeAsync(true, CancellationToken.None);
        dialogOpening = opening;
        startDialogOpen = true;
    }

    private async Task CompareMetadataAsync(long owner) {
        if (metadataDraft is not { } draft || dialogOpening is null || controller!.IsMutating) {
            return;
        }
        var revision = draft.Revision;
        dialogReadBusy = true;
        try {
            await dialogOpening.AuthorizeAsync(false, CancellationToken.None);
            var result = await Conversations.GetAsync(draft.Original.ConversationId, new(1), dialogOpening.Lifetime);
            if (disposed || owner != dialogGeneration || !ReferenceEquals(metadataDraft, draft)) {
                return;
            }
            await dialogOpening.AuthorizeAsync(false, CancellationToken.None);
            if (result is { IsSuccess: true, Value: { } view } && view.Conversation.ConversationId == draft.Original.ConversationId) {
                draft.Compare(view.Conversation, revision);
            } else {
                draft.Reject("Current conversation information could not be read. Your title draft is retained.");
            }
        } catch (Exception exception) when (exception is not UnauthorizedAccessException) {
            if (!disposed && owner == dialogGeneration) {
                await dialogOpening.AuthorizeAsync(false, CancellationToken.None);
                Logger.LogWarning("Simple Chat metadata comparison failed with {FailureType}.", exception.GetType().Name);
                draft.Reject("Current information could not be read. Your title draft is retained.");
            }
        } finally {
            if (owner == dialogGeneration) {
                dialogReadBusy = false;
            }
        }
    }

    private Task<bool> WithOperationAccessAsync(Func<Task<bool>> action, bool manage = false)
        => accessSession.RunOperationAsync(action, manage);

    private void QueueDisposal(LlmChatEditorOpening? opening) => accessSession.Retire(opening);

    private async Task HandleAccessFailureAsync(Exception exception) {
        Logger.LogWarning("Original Simple Chat conversation access failed with {FailureType}.", exception.GetType().Name);
        await RetireAccessAsync();
    }

    private Task RetireAccessAsync() => InvokeAsync(() => {
        if (!disposed) {
            routeGeneration++;
            CloseOwnedDialogs();
            StopFollower();
            ClearComposer();
            pendingTransition = null;
            pendingNavigation = null;
            accessSession.Stop();
            controller!.RetireAccess();
            StateHasChanged();
        }
    });

    private void RestartFollower() {
        StopFollower();
        if (disposed || controller?.ActiveOperation is not { } operation || operation.Status == LlmChatOperationStatus.RecoveryRequired) {
            return;
        }
        var source = new CancellationTokenSource();
        followerLifetime = source;
        followerTask = RunFollowerAsync(operation.OperationId, operation.ConversationId, controller.SelectionGeneration, source);
    }
    private bool OwnsFollower(Guid conversationId, long generation, CancellationTokenSource source)
        => !disposed && ReferenceEquals(followerLifetime, source) && !source.IsCancellationRequested
            && controller!.IsCurrentSelection(generation) && controller.SelectedConversation?.ConversationId == conversationId;

    private async Task RunFollowerAsync(Guid operationId, Guid conversationId, long generation, CancellationTokenSource source) {
        using (source) {
            try {
                var result = await operationFollower!.FollowAsync(operationId,
                    projection => !OwnsFollower(conversationId, generation, source) ? Task.CompletedTask : InvokeAsync(() => {
                        if (OwnsFollower(conversationId, generation, source)) {
                            controller!.ApplyOperationProjection(projection);
                            StateHasChanged();
                        }
                    }),
                    projection => !OwnsFollower(conversationId, generation, source) ? Task.CompletedTask : InvokeAsync(async () => {
                        if (OwnsFollower(conversationId, generation, source)) {
                            await controller!.RefreshActiveOperationAsync(projection.OperationId, source.Token);
                            if (OwnsFollower(conversationId, generation, source)) {
                                StateHasChanged();
                            }
                        }
                    }), source.Token);
                if (!OwnsFollower(conversationId, generation, source)) {
                    return;
                }
                if (result.Completion == LlmChatOperationFollowCompletion.ProfileChanged) {
                    await InvokeAsync(ReloadProfileAsync);
                } else if (result.Completion == LlmChatOperationFollowCompletion.Failed) {
                    await InvokeAsync(() => {
                        if (OwnsFollower(conversationId, generation, source)) {
                            controller!.SetFollowerFailure(result.Failures);
                            StateHasChanged();
                        }
                    });
                }
            } catch (OperationCanceledException) when (source.IsCancellationRequested) {
            } catch (Exception exception) {
                if (OwnsFollower(conversationId, generation, source)) {
                    FollowerLogger.LogWarning("Simple Chat follower failed for selection {Generation} with {ExceptionType}", generation, exception.GetType().Name);
                    await InvokeAsync(() => {
                        if (OwnsFollower(conversationId, generation, source)) {
                            controller!.SetFollowerFailure([new(LlmChatUiFailureCodes.RequestFailed, "The Simple Chat event stream could not be read.")]);
                            StateHasChanged();
                        }
                    });
                }
            } finally {
                if (ReferenceEquals(followerLifetime, source)) {
                    followerLifetime = null;
                }
            }
        }
    }
    private async Task ReloadProfileAsync() {
        if (disposed) {
            return;
        }
        var owner = ++routeGeneration;
        CloseOwnedDialogs();
        StopFollower();
        ClearComposer();
        initialization = controller!.ReloadForProfileChangeAsync(CancellationToken.None);
        await initialization;
        if (!disposed && owner == routeGeneration) {
            await AcceptSelectionAsync(controller.SelectionGeneration);
            StateHasChanged();
        }
    }
    private void StopFollower() {
        var previous = followerLifetime;
        followerLifetime = null;
        previous?.Cancel();
    }
    public async ValueTask DisposeAsync() {
        disposed = true;
        routeGeneration++;
        CloseOwnedDialogs();
        StopFollower();
        controller?.Dispose();
        await followerTask;
        await accessSession.DisposeAsync();
    }
}

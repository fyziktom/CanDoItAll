@using System.Collections.Immutable

<section class="definition-catalog-surface" aria-label="Simple Chat definition catalog">
<SurfaceCard Class="min-w-0 llm-chat-definition-catalog" data-testid="llm-chat-definition-catalog">
    <Stack GapScale="LayoutGap.Large">
        <Split Breakpoint="LayoutBreakpoint.Sm"
               AlignItems="AlignItems.Center"
               JustifyContent="JustifyContent.SpaceBetween"
               Gap="LayoutGap.Medium"
               Wrap="FlexWrap.Wrap"
               Class="llm-chat-definition-catalog__header"
               data-testid="llm-chat-definition-header">
            <Cluster Gap="LayoutGap.Medium"
                     Wrap="FlexWrap.Wrap"
                     AlignItems="AlignItems.Center"
                     Class="min-w-0 flex-1 llm-chat-definition-catalog__header-main">
                <Stack GapScale="LayoutGap.Tiny" Class="shrink-0 llm-chat-definition-catalog__heading">
                    <span class="cda-eyebrow">Reusable Simple Chats</span>
                    <h2 class="text-xl font-semibold text-slate-900">Definitions</h2>
                </Stack>

                @if (Presentation.CanRead) {
                    <FilterBar ResultText="@Presentation.ResultText"
                               Class="min-w-0 max-w-6xl grow basis-[52rem] llm-chat-definition-catalog__filter-bar"
                               data-testid="llm-chat-definition-filter-bar">
                        <Cluster Gap="LayoutGap.XSmall"
                                 Wrap="FlexWrap.NoWrap"
                                 AlignItems="AlignItems.Center"
                                 Class="min-w-0 w-full flex-1 max-[80rem]:flex-wrap llm-chat-definition-catalog__filters"
                                 data-testid="llm-chat-definition-filters">
                            <TextBox Value="@searchText"
                                     ValueChanged="ChangeSearchAsync"
                                     Placeholder="Search definitions"
                                     Immediate="true"
                                     Class="min-w-64 max-w-md grow basis-72 llm-chat-definition-catalog__search-filter"
                                     maxlength="@Limits.SearchLength"
                                     aria-label="Search Simple Chat definitions"
                                     data-testid="llm-chat-definition-search" />
                            <TagEditor Value="@tagFilters"
                                       ValueChanged="ChangeTagFiltersAsync"
                                       Suggestions="@AvailableTagSuggestions"
                                       Placeholder="Filter by tags"
                                       MaxTags="@Limits.TagCount"
                                       MaxLength="@Limits.TagLength"
                                       Disabled="@Presentation.IsBusy"
                                       Class="min-w-64 max-w-sm grow basis-72 llm-chat-definition-catalog__tag-filter"
                                       AriaLabel="Filter Simple Chat definitions by tags"
                                       TestId="llm-chat-definition-tag-filter"
                                       InputTestId="llm-chat-definition-tag-filter-input" />
                            <DropDown TValue="LlmChatDefinitionStatusFilter"
                                      Data="@StatusOptions"
                                      TextProperty="@nameof(LlmChatDefinitionStatusFilterOption.Label)"
                                      ValueProperty="@nameof(LlmChatDefinitionStatusFilterOption.Value)"
                                      Value="@statusFilter"
                                      ValueChanged="ChangeStatusFilterAsync"
                                      Disabled="@Presentation.IsBusy"
                                      Class="min-w-40 w-44 shrink-0 basis-44 llm-chat-definition-catalog__status-filter"
                                      aria-label="Filter Simple Chat definitions by status"
                                      data-testid="llm-chat-definition-status-filter" />
                            <TooltipTarget Text="Reset definition filters"
                                           Position="TooltipPosition.Bottom"
                                           Duration="@((TimeSpan?)null)"
                                           TestId="llm-chat-definition-reset-tooltip">
                                <Button Icon="filter_alt_off"
                                        ButtonStyle="ButtonStyle.Light"
                                        Size="ButtonSize.Small"
                                        Click="ResetFiltersAsync"
                                        Disabled="@(!HasActiveFilters || Presentation.IsBusy)"
                                        aria-label="Reset definition filters"
                                        data-testid="llm-chat-definition-filter-reset" />
                            </TooltipTarget>
                        </Cluster>
                    </FilterBar>
                }
            </Cluster>

            @if (Presentation.CanManage) {
                <Button Text="New definition"
                        Icon="add"
                        ButtonStyle="ButtonStyle.Primary"
                        Click="OpenCreateEditor"
                        data-testid="llm-chat-definition-create" />
            }
        </Split>

        @if (Presentation.Phase == DefinitionCatalogPhase.Authorizing) {
            <LoadingState Title="Checking definition access" Description="Checking Simple Chats permissions." />
        } else if (!Presentation.CanRead) {
            <EmptyState Eyebrow="Access required"
                        Title="Definitions are unavailable"
                        Description="@(Presentation.Error ?? "Read Simple Chats permission is required to view reusable definitions.")" />
        }
        else {
            @if (!string.IsNullOrWhiteSpace(Presentation.Error)) {
                <Alert AlertStyle="AlertStyle.Danger" Variant="Variant.Outlined" data-testid="llm-chat-definition-error">
                    @Presentation.Error
                </Alert>
            }

            @if (Presentation.IsBusy && Presentation.Cards.Length == 0) {
                <LoadingState Eyebrow="Definitions"
                              Title="Loading Simple Chat definitions"
                              Description="Reading the reusable definition catalog." />
            }
            else if (Presentation.Cards.Length == 0) {
                <EmptyState Eyebrow="Definitions"
                            Title="No definitions match the current filters"
                            Description="@EmptyDescription" />
            }
            else {
                <Grid ColumnTemplate="repeat(auto-fill,minmax(min(100%,17rem),22rem))"
                      Gap="LayoutGap.Medium"
                      data-testid="llm-chat-definition-grid">
                    @foreach (var definition in Presentation.Cards) {
                        <ConversationParticipantCard @key="definition.DefinitionId"
                                                     Participant="@definition.ToParticipant(SelectedDefinitionId)"
                                                     Layout="@(ParticipantCardLayout.Enterprise | ParticipantCardLayout.Centered)"
                                                     ShellTestId="@($"llm-chat-definition-{definition.DefinitionId:D}")"
                                                     SelectTestId="@($"llm-chat-definition-select-{definition.DefinitionId:D}")"
                                                     Selected="OpenSelectedEditorAsync">
                            <Actions>
                                @if (Presentation.CanManage) {
                                    <Button Text="Edit"
                                            Icon="edit"
                                            Size="ButtonSize.Small"
                                            Variant="Variant.Outlined"
                                            Click="@(() => OpenEditorAsync(definition.DefinitionId))"
                                            data-testid="@($"llm-chat-definition-edit-{definition.DefinitionId:D}")" />
                                }
                            </Actions>
                        </ConversationParticipantCard>
                    }
                </Grid>

                @if (Presentation.HasMore) {
                    <Cluster JustifyContent="JustifyContent.Center">
                        <Button Text="Load more"
                                Icon="expand_more"
                                Variant="Variant.Outlined"
                                Click="LoadMoreAsync"
                                Disabled="@Presentation.IsBusy"
                                IsBusy="@Presentation.IsBusy"
                                data-testid="llm-chat-definition-load-more" />
                    </Cluster>
                }
            }
        }
    </Stack>
</SurfaceCard>
</section>

@code {
    [Parameter, EditorRequired] public DefinitionCatalogPresentation Presentation { get; set; } = DefinitionCatalogPresentation.Initial;
    [Parameter, EditorRequired] public DefinitionCatalogFilterLimits Limits { get; set; } = default!;
    [Parameter] public Guid? SelectedDefinitionId { get; set; }
    [Parameter] public EventCallback<DefinitionCatalogIntent> OnIntent { get; set; }
    private static readonly IReadOnlyList<LlmChatDefinitionStatusFilterOption> StatusOptions = [
        new(LlmChatDefinitionStatusFilter.All, "All statuses"), new(LlmChatDefinitionStatusFilter.Draft, "Draft"),
        new(LlmChatDefinitionStatusFilter.Active, "Active"), new(LlmChatDefinitionStatusFilter.Suspended, "Suspended"),
        new(LlmChatDefinitionStatusFilter.Archived, "Archived")
    ];
    private DefinitionCatalogFilters? observedFilters;
    private string searchText = "";
    private IReadOnlyList<string> tagFilters = [];
    private LlmChatDefinitionStatusFilter statusFilter;
    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(searchText) || tagFilters.Count > 0 || statusFilter != LlmChatDefinitionStatusFilter.All;
    private string EmptyDescription => HasActiveFilters ? "Clear or change the filters to see more definitions." : "Create a reusable Simple Chat definition.";
    private IReadOnlyList<string> AvailableTagSuggestions => Presentation.Cards.SelectMany(card => card.Tags)
        .Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase).ToArray();

    protected override void OnParametersSet() {
        if (ReferenceEquals(observedFilters, Presentation.Filters)) {
            return;
        }
        observedFilters = Presentation.Filters;
        searchText = observedFilters.Search;
        tagFilters = observedFilters.Tags;
        statusFilter = observedFilters.Status;
    }

    private Task ChangeSearchAsync(string? value) {
        searchText = value ?? "";
        return OnIntent.InvokeAsync(new DefinitionCatalogIntent.SearchChanged(searchText));
    }
    private Task ChangeTagFiltersAsync(IReadOnlyList<string> value) {
        tagFilters = value.ToImmutableArray();
        return OnIntent.InvokeAsync(new DefinitionCatalogIntent.TagsChanged(value.ToImmutableArray()));
    }
    private Task ChangeStatusFilterAsync(LlmChatDefinitionStatusFilter value) {
        statusFilter = value;
        return OnIntent.InvokeAsync(new DefinitionCatalogIntent.StatusChanged(value));
    }
    private Task ResetFiltersAsync() {
        searchText = "";
        tagFilters = [];
        statusFilter = LlmChatDefinitionStatusFilter.All;
        return OnIntent.InvokeAsync(new DefinitionCatalogIntent.ResetFilters());
    }
    private Task LoadMoreAsync() => OnIntent.InvokeAsync(new DefinitionCatalogIntent.LoadMore());
    private Task OpenCreateEditor() => OnIntent.InvokeAsync(new DefinitionCatalogIntent.CreateDefinition());
    private Task OpenEditorAsync(Guid id) => Presentation.CanManage && id != Guid.Empty
        ? OnIntent.InvokeAsync(new DefinitionCatalogIntent.EditDefinition(id)) : Task.CompletedTask;
    private Task OpenSelectedEditorAsync(ConversationPresentationKey key) => DefinitionCatalogMapping.TryGetDefinitionId(key, out var id)
        ? OpenEditorAsync(id) : Task.CompletedTask;
}

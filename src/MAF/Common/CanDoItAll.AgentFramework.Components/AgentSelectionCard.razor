<article class="@ResolveContainerClass()"
         data-testid="@ShellTestId">
    @if (ShowFavorite)
    {
        <button type="button"
                class="@ResolveFavoriteClass()"
                aria-label="@(IsFavorite ? "Remove favorite" : "Mark favorite")"
                aria-pressed="@(IsFavorite ? "true" : "false")"
                disabled="@FavoriteDisabled"
                @onclick="HandleFavoriteToggleAsync"
                @onclick:stopPropagation="true"
                data-testid="@FavoriteTestId">
            <Icon Name="star" />
        </button>
    }

    <button type="button"
            class="agent-selection-card__select"
            data-testid="@ResolveSelectTestId()"
            aria-label="@ResolveSelectLabel()"
            @onclick="HandleSelectAsync"
            @ondblclick="HandleDoubleClickAsync">
        <Stack GapScale="@(Compact ? LayoutGap.Small : LayoutGap.Medium)"
               AlignItems="@ResolveStackAlignment()">
            <div class="@ResolveIdentityClass()">
                <Avatar Alt="@ResolveAvatarAlt()"
                        ImageUrl="@Agent.AvatarImageUrl"
                        FallbackText="@ResolveAvatarFallbackText()"
                        DefaultImageSeed="@ResolveAvatarSeed()"
                        Size="@(Compact ? AvatarSize.Medium : AvatarSize.Large)"
                        Shape="AvatarShape.Rounded" />

                <div class="agent-selection-card__identity-copy">
                    <Cluster Gap="LayoutGap.XSmall"
                             Wrap="FlexWrap.Wrap"
                             Class="@ResolveBadgeClusterClass()">
                        <StatusBadge Tone="@ResolveStatusTone(Agent.Status)" Text="@Agent.Status.ToString()" />
                        @if (ShowWorkload)
                        {
                            <StatusBadge Tone="info" Text="@AgentWorkloadDisplay.ResolveLabel(Agent.Workload)" />
                        }
                        @if (IsPrivateProvider)
                        {
                            <StatusBadge Tone="warning" Text="Private" data-testid="agent-private-provider-badge" />
                        }
                        @if (ShowChatHistory)
                        {
                            <StatusBadge Tone="neutral" Text="@Agent.ChatHistoryMode.ToString()" />
                        }
                        @if (IsSelected)
                        {
                            <StatusBadge Tone="info" Text="@SelectedLabel" />
                        }
                        @if (ShowDetailsTooltip)
                        {
                            <TooltipTarget Text="@BuildAgentDetails()"
                                           Position="TooltipPosition.Bottom"
                                           TriggerClass="items-center">
                                <span class="agent-selection-card__info"
                                      aria-label="Show agent details">
                                    <Icon Name="circle_info" />
                                </span>
                            </TooltipTarget>
                        }
                    </Cluster>

                    <p class="agent-selection-card__name">@Agent.Name</p>

                    @if (!string.IsNullOrWhiteSpace(ResolveAgentRole()))
                    {
                        <p class="agent-selection-card__role">@ResolveAgentRole()</p>
                    }
                </div>
            </div>

            @if (ShowSummary)
            {
                <p class="agent-selection-card__summary">@ResolveSummary()</p>
            }

            @if (ShowTags)
            {
                var visibleTags = VisibleTags();
                if (visibleTags.Count > 0)
                {
                    <Cluster Gap="LayoutGap.XSmall"
                             Wrap="FlexWrap.Wrap"
                             Class="@ResolveTagClusterClass()">
                        @foreach (var tag in visibleTags.Take(MaxVisibleTags))
                        {
                            <StatusBadge Tone="neutral" Text="@tag" />
                        }
                    </Cluster>
                }
            }

            <div class="@ResolveMetaClass()">
                @if (!string.IsNullOrWhiteSpace(Agent.Model))
                {
                    <span>@Agent.Model</span>
                }

                @if (ShowCapabilityCount)
                {
                    <span>@FormatCapabilityCount()</span>
                }

                @if (ShowUpdatedAt)
                {
                    <span>@($"Updated {Agent.UpdatedAtUtc.LocalDateTime:g}")</span>
                }
            </div>
        </Stack>
    </button>

    @if (Actions is not null)
    {
        <div class="agent-selection-card__actions">
            @Actions
        </div>
    }
</article>

@code {
    [Parameter, EditorRequired]
    public AgentDefinition Agent { get; set; } = default!;

    [Parameter]
    public bool IsSelected { get; set; }

    [Parameter]
    public bool Compact { get; set; }

    [Parameter]
    public bool CenterContent { get; set; }

    [Parameter]
    public bool ShowSummary { get; set; } = true;

    [Parameter]
    public bool ShowWorkload { get; set; } = true;

    [Parameter]
    public bool ShowChatHistory { get; set; }

    [Parameter]
    public bool ShowCapabilityCount { get; set; } = true;

    [Parameter]
    public bool ShowUpdatedAt { get; set; } = true;

    [Parameter]
    public bool ShowTags { get; set; } = true;

    [Parameter]
    public int MaxVisibleTags { get; set; } = 3;

    [Parameter]
    public bool ShowFavorite { get; set; }

    [Parameter]
    public bool IsFavorite { get; set; }

    [Parameter]
    public bool FavoriteDisabled { get; set; }

    [Parameter]
    public bool ShowDetailsTooltip { get; set; }

    [Parameter]
    public bool IsPrivateProvider { get; set; }

    [Parameter]
    public string SelectedLabel { get; set; } = "Current agent";

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? ShellTestId { get; set; }

    [Parameter]
    public string? SelectTestId { get; set; }

    [Parameter]
    public string FavoriteTestId { get; set; } = "agent-favorite-toggle";

    [Parameter]
    public EventCallback OnSelect { get; set; }

    [Parameter]
    public EventCallback OnDoubleClick { get; set; }

    [Parameter]
    public EventCallback OnFavoriteToggle { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    private Task HandleSelectAsync()
        => OnSelect.InvokeAsync();

    private Task HandleDoubleClickAsync()
        => OnDoubleClick.InvokeAsync();

    private Task HandleFavoriteToggleAsync()
        => OnFavoriteToggle.InvokeAsync();

    private string ResolveContainerClass()
    {
        return CssClassBuilder.Join(
            "agent-selection-card",
            IsSelected ? "agent-selection-card--selected" : null,
            Compact ? "agent-selection-card--compact" : null,
            CenterContent ? "agent-selection-card--center" : null,
            ShowFavorite ? "agent-selection-card--has-favorite" : null,
            Class);
    }

    private string ResolveFavoriteClass()
    {
        return CssClassBuilder.Join(
            "agent-selection-card__favorite",
            IsFavorite ? "agent-selection-card__favorite--active" : null);
    }

    private string ResolveIdentityClass()
        => CssClassBuilder.Join(
            "agent-selection-card__identity",
            CenterContent ? "agent-selection-card__identity--center" : null);

    private string ResolveBadgeClusterClass()
        => CenterContent ? "agent-selection-card__badges justify-center" : "agent-selection-card__badges";

    private string ResolveTagClusterClass()
        => CenterContent ? "agent-selection-card__tags justify-center" : "agent-selection-card__tags";

    private string ResolveMetaClass()
        => CenterContent ? "agent-selection-card__meta agent-selection-card__meta--center" : "agent-selection-card__meta";

    private AlignItems ResolveStackAlignment()
        => CenterContent ? AlignItems.Center : AlignItems.Stretch;

    private string ResolveSelectTestId()
        => string.IsNullOrWhiteSpace(SelectTestId)
            ? $"agent-card-{Agent.Id}"
            : SelectTestId;

    private string ResolveSelectLabel()
        => string.IsNullOrWhiteSpace(Agent.Name)
            ? "Select agent"
            : $"Select {Agent.Name}";

    private string ResolveAvatarAlt()
        => string.IsNullOrWhiteSpace(Agent.Name) ? "Sandbox agent" : Agent.Name;

    private string ResolveAvatarFallbackText()
        => BuildInitials(ResolveAvatarSeed());

    private string ResolveAvatarSeed()
    {
        if (!string.IsNullOrWhiteSpace(Agent.Name))
        {
            return Agent.Name;
        }

        if (!string.IsNullOrWhiteSpace(Agent.RoleTitle))
        {
            return Agent.RoleTitle;
        }

        return "Sandbox Agent";
    }

    private string ResolveAgentRole()
    {
        return string.IsNullOrWhiteSpace(Agent.RoleTitle)
            ? "Technical agent"
            : Agent.RoleTitle.Trim();
    }

    private string ResolveSummary()
    {
        if (string.IsNullOrWhiteSpace(Agent.Summary))
        {
            return "No short summary is configured yet.";
        }

        return Agent.Summary.Trim();
    }

    private IReadOnlyList<string> VisibleTags()
        => Agent.Tags
            .Where(item => !AgentSpecialTags.IsFavorite(item))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(item => item, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private string FormatCapabilityCount()
    {
        var count = Agent.Capabilities.Count;
        return count == 1 ? "1 capability" : $"{count} capabilities";
    }

    private string BuildAgentDetails()
    {
        var provider = string.IsNullOrWhiteSpace(Agent.Model)
            ? "No model configured"
            : Agent.Model;
        var tags = VisibleTags();
        var tagText = tags.Count == 0
            ? "No visible tags."
            : $"Tags: {string.Join(", ", tags)}.";

        return $"{ResolveAgentRole()}. {provider}. {Agent.Workload}. {FormatCapabilityCount()}. {tagText} {ResolveSummary()}";
    }

    private static string BuildInitials(string value)
    {
        var segments = value
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Take(2)
            .ToList();

        if (segments.Count == 0)
        {
            return "AG";
        }

        return string.Concat(segments.Select(segment => char.ToUpperInvariant(segment[0])));
    }

    private static string ResolveStatusTone(AgentLifecycleStatus status)
    {
        return status switch
        {
            AgentLifecycleStatus.Active => "success",
            AgentLifecycleStatus.Suspended => "warning",
            AgentLifecycleStatus.Archived => "neutral",
            _ => "info"
        };
    }
}

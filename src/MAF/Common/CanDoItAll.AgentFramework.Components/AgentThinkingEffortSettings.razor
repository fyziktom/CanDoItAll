@namespace CanDoItAll.AgentFramework.Components

<ConversationThinkingEffortSettings TValue="AgentReasoningEffortLevel?"
    Presentation="@AgentThinkingEffortPresentation.Create(Provider, Model, Value)"
    ValueChanged="ValueChanged" Disabled="Disabled" TestId="@TestId" SupportTestId="@SupportTestId" />

@code {
    [Parameter]
    public ProviderProfile? Provider { get; set; }
    [Parameter]
    public string? Model { get; set; }
    [Parameter]
    public AgentReasoningEffortLevel? Value { get; set; }
    [Parameter]
    public EventCallback<AgentReasoningEffortLevel?> ValueChanged { get; set; }
    [Parameter]
    public bool Disabled { get; set; }
    [Parameter]
    public string TestId { get; set; } = "agents-catalog-thinking-effort";
    [Parameter]
    public string SupportTestId { get; set; } = "agents-catalog-thinking-effort-support";
}

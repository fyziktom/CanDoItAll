    private Task HandleVoiceModeChangedAsync(bool enabled)
    {
        if (enabled && !CanUseSelectedAgentVoiceMode)
        {
            SetVoiceStatus("Voice denied", "warning", "This agent does not allow voice mode.");
            return Task.CompletedTask;
        }

        isVoiceModeEnabled = enabled;
        SetVoiceStatus(enabled ? "Audio on" : "Audio off", enabled ? "primary" : "neutral");
        return Task.CompletedTask;
    }

    private async Task ToggleVoiceRecordingAsync() {
        if (disposed || isVoiceTranscribing || isChatBusy) {
            return;
        }
        if (!CanUseSelectedAgentVoiceMode) {
            SetVoiceStatus("Voice denied", "warning", "This agent does not allow voice mode.");
            return;
        }
        if (isVoiceRecording) {
            await StopRecordingAndSendAsync();
            return;
        }
        var generation = targetGeneration;
        var voiceOwner = browserVoiceOwnerId;
        using var request = CancellationTokenSource.CreateLinkedTokenSource(targetCancellation.Token);
        try {
            await JsRuntime.InvokeVoidAsync("CanDoItAll.agentFramework.voice.startRecordingForOwner", request.Token, voiceOwner);
            if (!IsCurrentTarget(generation)) {
                return;
            }
            isVoiceModeEnabled = true;
            isVoiceRecording = true;
            SetVoiceStatus("Recording", "danger");
        } catch (Exception) when (!IsCurrentTarget(generation)) {
        } catch (Exception) {
            SetVoiceStatus("Record failed", "danger", "Recording could not be started. Check microphone access and retry.");
        }
    }

    private async Task StopRecordingAndSendAsync() {
        if (disposed) {
            return;
        }
        var generation = targetGeneration;
        var voiceOwner = browserVoiceOwnerId;
        using var request = CancellationTokenSource.CreateLinkedTokenSource(targetCancellation.Token);
        isVoiceRecording = false;
        isVoiceTranscribing = true;
        SetVoiceStatus("Transcribing", "info");
        try {
            var recording = await JsRuntime.InvokeAsync<BrowserVoiceRecording>(
                "CanDoItAll.agentFramework.voice.stopRecordingForOwner", request.Token, voiceOwner);
            if (!IsCurrentTarget(generation)) {
                return;
            }
            var transcription = await VoiceService.TranscribeAsync(recording.ToTranscriptionRequest(), request.Token);
            if (!IsCurrentTarget(generation)) {
                return;
            }
            draftPrompt = transcription.Text;
            composerKey++;
            SetVoiceStatus("Sending", "info");
            await SendMessageAsync();
        } catch (Exception) when (!IsCurrentTarget(generation)) {
        } catch (Exception) {
            SetVoiceStatus("Voice failed", "danger", "The recording could not be transcribed. Retry or enter your message as text.");
        } finally {
            if (IsCurrentTarget(generation)) {
                isVoiceTranscribing = false;
            }
        }
    }

    private Task SpeakLatestAssistantMessageAsync()
    {
        var latestAssistantMessage = workspace?.SelectedSession?.Messages
            .Where(message => message.Role == ChatMessageRole.Assistant)
            .OrderByDescending(message => message.CreatedAtUtc)
            .FirstOrDefault();
        if (latestAssistantMessage is null || string.IsNullOrWhiteSpace(latestAssistantMessage.Content))
        {
            SetVoiceStatus("Nothing to speak", "warning", "No assistant message is available.");
            return Task.CompletedTask;
        }

        return SpeakTextAsync(latestAssistantMessage.Content);
    }

    private async Task SpeakTextAsync(string text)
    {
        if (disposed || selectedAgent is null)
        {
            SetVoiceStatus("No agent", "warning", "Select an agent before using text-to-speech.");
            return;
        }

        var generation = targetGeneration;
        var voiceOwner = browserVoiceOwnerId;
        using var request = CancellationTokenSource.CreateLinkedTokenSource(targetCancellation.Token);
        isVoiceSpeaking = true;
        SetVoiceStatus("Speaking", "primary");
        try
        {
            await JsRuntime.InvokeVoidAsync("CanDoItAll.agentFramework.voice.clearAudioQueueForOwner", request.Token, voiceOwner);
            if (!IsCurrentTarget(generation)) {
                return;
            }
            var queuedChunks = 0;
            await foreach (var synthesis in VoiceService.SynthesizeChunksAsync(new AgentVoiceSynthesisRequest(
                               text,
                               SelectedAgentVoiceAccess,
                               SuppressIdentifierOmissionNotice: ShouldSuppressIdentifierOmissionNotice()), request.Token))
            {
                if (!IsCurrentTarget(generation)) {
                    return;
                }
                TrackIdentifierOmissionNotice(synthesis);
                queuedChunks++;
                await JsRuntime.InvokeVoidAsync(
                    "CanDoItAll.agentFramework.voice.enqueueAudioForOwner", request.Token, voiceOwner,
                    Convert.ToBase64String(synthesis.AudioBytes),
                    synthesis.ContentType);
                if (!IsCurrentTarget(generation)) {
                    return;
                }
                if (queuedChunks == 1)
                {
                    SetVoiceStatus("Playing", "primary");
                }
            }

            if (!IsCurrentTarget(generation)) {
                return;
            }
            SetVoiceStatus(queuedChunks == 1 ? "Audio ready" : $"Audio ready ({queuedChunks} chunks)", "success");
        }
        catch (Exception) when (!IsCurrentTarget(generation)) {
        }
        catch (Exception)
        {
            SetVoiceStatus("Speak failed", "danger", "Audio playback could not be completed. Retry when voice is available.");
        }
        finally
        {
            if (IsCurrentTarget(generation)) {
                isVoiceSpeaking = false;
            }
        }
    }

    private bool ShouldSuppressIdentifierOmissionNotice()
    {
        return selectedSessionId is { } sessionId
            ? sessionsWithVoiceIdentifierOmissionNotice.Contains(sessionId)
            : hasVoiceIdentifierOmissionNoticeWithoutSession;
    }

    private void TrackIdentifierOmissionNotice(AgentVoiceSynthesisResult synthesis)
    {
        if (!synthesis.IdentifierOmissionNoticeIncluded)
        {
            return;
        }

        if (selectedSessionId is { } sessionId)
        {
            sessionsWithVoiceIdentifierOmissionNotice.Add(sessionId);
            return;
        }

        hasVoiceIdentifierOmissionNoticeWithoutSession = true;
    }

    private void SetVoiceStatus(string text, string tone, string? notification = null)
    {
        voiceStatusText = text;
        voiceStatusTone = tone;
        if (!string.IsNullOrWhiteSpace(notification))
        {
            Notify(text, tone, notification);
        }
    }

    private ExecutionInvocationContext BuildInvocationContext()
    {
        var sourceKind = WorkspaceKind switch
        {
            ContextualAgentWorkspaceKind.ProjectStructure => ProjectStructureSourceKind,
            ContextualAgentWorkspaceKind.Processes => ProcessDefinitionSourceKind,
            _ => "workspace"
        };
        var sourceId = WorkspaceKind switch
        {
            ContextualAgentWorkspaceKind.ProjectStructure => ProjectId?.ToString("N") ?? string.Empty,
            ContextualAgentWorkspaceKind.Processes => ProcessDefinitionId?.ToString("N") ?? string.Empty,
            _ => selectedSessionId?.ToString("N") ?? string.Empty
        };

        return new ExecutionInvocationContext(
            SourceKind: sourceKind,
            SourceId: sourceId,
            CorrelationId: Guid.NewGuid().ToString("N"),
            CausationId: selectedSessionId?.ToString("N") ?? string.Empty,
            RequestedBy: ContextualWindowRequester,
            RequestedByKind: "interactive",
            MetadataJson: BuildInvocationMetadataJson());
    }

    private bool ShouldAutoApproveContextualRun()
    {
        return ContextualAgentAccessResolver.ShouldAutoApproveContextualRun(
            AccessibleAgents,
            WorkspaceKind,
            selectedAgentId,
            ProjectId,
            ProcessDefinitionId);
    }

    private string BuildInvocationMetadataJson()
    {
        var metadata = new Dictionary<string, string>
        {
            ["workspaceKind"] = WorkspaceKind.ToString(),
            ["windowId"] = WindowId,
            ["chatWindowId"] = ChatWindowId
        };

        if (ProjectId.HasValue)
        {
            metadata["projectId"] = ProjectId.Value.ToString("D");
        }

        if (WorkspaceKind == ContextualAgentWorkspaceKind.ProjectStructure)
        {
            metadata["selectedNodeIdsJson"] = JsonSerializer.Serialize(
                ContextualAgentWorkspaceContextBuilder.NormalizeSelectedNodeIds(SelectedNodeIds));
        }

        if (ProcessDefinitionId.HasValue)
        {
            metadata["processDefinitionId"] = ProcessDefinitionId.Value.ToString("D");
        }

        return System.Text.Json.JsonSerializer.Serialize(metadata);
    }

    private void ResolveRunState()
    {
        if (workspace?.SelectedRun is null)
        {
            runStateText = string.Empty;
            runStateTone = DefaultRunStateTone;
            return;
        }

        runStateText = workspace.SelectedRun.State.ToString();
        runStateTone = ResolveExecutionTone(workspace.SelectedRun.State);
    }

    private bool MatchesSearch(ContextualAgentAccessSummary item)
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return true;
        }

        var search = searchText.Trim();
        return item.Agent.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
               item.Agent.RoleTitle.Contains(search, StringComparison.OrdinalIgnoreCase) ||
               item.Agent.Summary.Contains(search, StringComparison.OrdinalIgnoreCase) ||
               item.Agent.Model.Contains(search, StringComparison.OrdinalIgnoreCase) ||
               item.ScopeLabel.Contains(search, StringComparison.OrdinalIgnoreCase) ||
               ResolveAccessLabel(item).Contains(search, StringComparison.OrdinalIgnoreCase) ||
               item.Agent.Tags.Any(tag => tag.Contains(search, StringComparison.OrdinalIgnoreCase));
    }

    private bool MatchesTags(ContextualAgentAccessSummary item)
    {
        if (tagFilters.Count == 0)
        {
            return true;
        }

        var visibleTags = VisibleTags(item.Agent);
        return tagFilters.All(filter => visibleTags.Contains(filter, StringComparer.OrdinalIgnoreCase));
    }


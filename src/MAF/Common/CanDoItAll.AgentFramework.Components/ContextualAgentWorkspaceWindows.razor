            ? "New contextual thread"
            : workspace.SelectedSession.Title;

    private string BuildRuntimeDialogSubtitle()
    {
        var agentName = selectedAgent is null ? "Selected agent" : ResolveAgentName(selectedAgent);
        var threadTitle = workspace?.SelectedSession?.Title ?? "No thread selected";
        return $"{agentName} / {threadTitle}";
    }

    private static string ResolveAccessLabel(ContextualAgentAccessSummary item)
    {
        if (item.CanWrite)
        {
            return "Read Write";
        }

        var writeScopes = new List<string>(4);
        if (item.CanWriteNonTaskStructure)
        {
            writeScopes.Add("Structure write");
        }
        if (item.CanWriteTasks)
        {
            writeScopes.Add("Task write");
        }
        if (item.CanCreateProjects)
        {
            writeScopes.Add("Project create");
        }
        if (item.CanCreateSubprojects)
        {
            writeScopes.Add("Subproject create");
        }
        if (writeScopes.Count > 0)
        {
            return $"Read {string.Join(' ', writeScopes)}";
        }

        return item.CanRead ? "Read" : "No access";
    }

    private static string ResolveExecutionTone(ExecutionState state)
    {
        return state switch
        {
            ExecutionState.Completed => "success",
            ExecutionState.WaitingOnTool => "warning",
            ExecutionState.Failed => "danger",
            ExecutionState.Running or ExecutionState.Preparing or ExecutionState.Persisting => "info",
            _ => "neutral"
        };
    }

    private void Notify(string label, string tone, string value)
    {
        switch (tone)
        {
            case "success":
                NotificationService.Success(label, value);
                break;
            case "warning":
                NotificationService.Warning(label, value);
                break;
            case "danger":
                NotificationService.Error(label, value);
                break;
            default:
                NotificationService.Info(label, value);
                break;
        }
    }

    private static IReadOnlyList<string> VisibleTags(AgentDefinition agent)
        => agent.Tags
            .Where(tag => !AgentSpecialTags.IsFavorite(tag))
            .OrderBy(tag => tag, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private static string ResolveAgentName(AgentDefinition agent)
        => string.IsNullOrWhiteSpace(agent.Name) ? ResolveAgentRole(agent) : agent.Name;

    private static string ResolveAgentRole(AgentDefinition agent)
        => string.IsNullOrWhiteSpace(agent.RoleTitle) ? "Technical agent" : agent.RoleTitle;

    private static string ResolveAgentSummary(AgentDefinition agent)
        => string.IsNullOrWhiteSpace(agent.Summary) ? agent.Model : agent.Summary;

    private static string BuildAgentTooltip(AgentDefinition agent)
    {
        var role = ResolveAgentRole(agent);
        var summary = ResolveAgentSummary(agent);

        return string.Equals(role, summary, StringComparison.Ordinal)
            ? role
            : $"{role} / {summary}";
    }

    private static string ResolveTagStyle(string tag)
    {
        var palette = TagPalette[ResolveTagColorIndex(tag)];
        return $"background:{palette.BackgroundColor};border-color:{palette.BorderColor};color:{palette.ForegroundColor};";
    }

    private static int ResolveTagColorIndex(string tag)
    {
        unchecked
        {
            var hash = 17;
            foreach (var character in tag.Trim())
            {
                hash = (hash * 31) + char.ToUpperInvariant(character);
            }

            return (int)((uint)hash % TagPalette.Length);
        }
    }

    private static string ResolveAgentSeed(AgentDefinition agent)
        => !string.IsNullOrWhiteSpace(agent.Name)
            ? agent.Name
            : !string.IsNullOrWhiteSpace(agent.RoleTitle)
                ? agent.RoleTitle
                : "Agent";

    private static string ResolveAgentInitials(AgentDefinition agent)
    {
        var segments = ResolveAgentSeed(agent)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Take(2)
            .ToList();

        if (segments.Count == 0)
        {
            return "AI";
        }

        return string.Concat(segments.Select(segment => char.ToUpperInvariant(segment[0])));
    }

    public async ValueTask DisposeAsync()
    {
        if (disposed) {
            return;
        }
        disposed = true;
        targetGeneration++;
        Interlocked.Increment(ref workspaceLoadGeneration);
        lifetime.Cancel();
        targetCancellation.Cancel();
        lifetime.Dispose();
        targetCancellation.Dispose();
        WorkspaceService.ExecutionUpdated -= HandleExecutionUpdated;
        await DisposeBrowserVoiceOwnerAsync(browserVoiceOwnerId);
    }

    private async Task DisposeBrowserVoiceOwnerAsync(string ownerId) {
        try {
            await JsRuntime.InvokeVoidAsync("CanDoItAll.agentFramework.voice.disposeOwner", ownerId);
        } catch (Exception exception) {
            Logger.LogDebug("Contextual voice owner cleanup could not finish ({FailureType}).", exception.GetType().Name);
        }
    }


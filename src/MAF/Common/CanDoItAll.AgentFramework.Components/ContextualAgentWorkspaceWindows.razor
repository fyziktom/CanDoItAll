        {
            ContextualAgentWorkspaceKind.ProjectStructure => "Create or edit an agent with project structure access for this project.",
            ContextualAgentWorkspaceKind.Processes => "Create or edit an agent with process access for this definition.",
            _ => "Create or edit an agent with contextual workspace access."
        };


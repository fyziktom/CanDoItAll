    private async Task DownloadThreadHistoryAsync()
    {
        if (disposed || !selectedAgentId.HasValue || selectedAgent is null)
        {
            Notify("Select an agent", "warning", "Open a contextual agent before exporting thread history.");
            return;
        }

        var generation = targetGeneration;
        var agent = selectedAgent;
        using var request = CancellationTokenSource.CreateLinkedTokenSource(targetCancellation.Token);
        isDownloadingThreadHistory = true;
        try
        {
            var json = await BuildThreadHistoryExportJsonAsync(agent, request.Token);
            if (!IsCurrentTarget(generation)) {
                return;
            }
            await JsRuntime.InvokeVoidAsync(
                "CanDoItAll.agentFramework.downloadJson", request.Token,
                BuildThreadHistoryExportFileName(agent),
                json);
            if (!IsCurrentTarget(generation)) {
                return;
            }
            Notify("Thread history exported", "success", "Downloaded the agent thread history JSON for debugging.");
        }
        catch (Exception) when (!IsCurrentTarget(generation)) {
        }
        catch (Exception)
        {
            Notify("Export failed", "danger", "Thread history could not be exported. Retry the current thread.");
        }
        finally
        {
            if (IsCurrentTarget(generation)) {
                isDownloadingThreadHistory = false;
            }
        }
    }

    private async Task<string> BuildThreadHistoryExportJsonAsync(AgentDefinition agent, CancellationToken cancellationToken)
    {
        var sessions = (await WorkspaceService.ListChatSessionsAsync(agent.Id, cancellationToken))
            .OrderByDescending(session => session.UpdatedAtUtc)
            .ToList();
        var exportSessions = new List<AgentThreadHistoryExportSession>(sessions.Count);

        foreach (var session in sessions)
        {
            var runs = await WorkspaceService.ListExecutionRunsAsync(
                new ExecutionRunQuery(
                    AgentId: agent.Id,
                    ChatSessionId: session.Id,
                    Take: int.MaxValue), cancellationToken);
            var exportRuns = new List<AgentThreadHistoryExportRun>(runs.Count);

            foreach (var run in runs.OrderByDescending(item => item.UpdatedAtUtc))
            {
                try
                {
                    exportRuns.Add(new AgentThreadHistoryExportRun(
                        run,
                        await WorkspaceService.GetExecutionRunDetailAsync(run.Id, cancellationToken),
                        string.Empty));
                }
                catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) {
                    throw;
                }
                catch (Exception)
                {
                    exportRuns.Add(new AgentThreadHistoryExportRun(
                        run,
                        Detail: null,
                        LoadError: "Run detail could not be loaded."));
                }
            }

            exportSessions.Add(new AgentThreadHistoryExportSession(session, exportRuns));
        }

        var payload = new AgentThreadHistoryExportPayload(
            Schema: "candoitall.contextual-agent-thread-history.v1",
            ExportedAtUtc: DateTimeOffset.UtcNow,
            WorkspaceKind,
            ProjectId,
            ProcessDefinitionId,
            ContextualAgentWorkspaceContextBuilder.NormalizeSelectedNodeIds(SelectedNodeIds),
            WindowId,
            ChatWindowId,
            agent,
            selectedSessionId,
            exportSessions);

        return JsonSerializer.Serialize(payload, ThreadHistoryJsonOptions);
    }

    private static string BuildThreadHistoryExportFileName(AgentDefinition agent)
    {
        var slug = string.Join(
            '-',
            ResolveAgentName(agent)
                .ToLowerInvariant()
                .Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(NormalizeFileNameSegment)
                .Where(segment => !string.IsNullOrWhiteSpace(segment)));

        if (string.IsNullOrWhiteSpace(slug))
        {
            slug = "agent";
        }

        return $"agent-thread-history-{slug}-{DateTimeOffset.UtcNow:yyyyMMdd-HHmmss}.json";
    }

    private static string NormalizeFileNameSegment(string value)
    {
        var characters = value
            .Select(static character =>
                (character is >= 'a' and <= 'z') ||
                (character is >= '0' and <= '9')
                    ? character
                    : '-')
            .ToArray();

        return new string(characters).Trim('-');
    }

    private void HandleExecutionUpdated(object? sender, ExecutionLogEntry entry)
    {
        if (!ShouldAcceptExecutionEntry(entry))
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            if (!ShouldAcceptExecutionEntry(entry))
            {
                return;
            }

            executionLog = UpsertExecutionLogEntry(executionLog, entry);
            if (workspace?.SelectedRun?.Id == entry.ExecutionRunId)
            {
                runStateText = entry.State.ToString();
                runStateTone = ResolveExecutionTone(entry.State);
            }

            StateHasChanged();
        });
    }

    private bool ShouldAcceptExecutionEntry(ExecutionLogEntry entry)
    {
        if (disposed || selectedAgentId != entry.AgentId)
        {
            return false;
        }

        return !selectedSessionId.HasValue ||
               entry.ChatSessionId == selectedSessionId.Value;
    }

    private static IReadOnlyList<ExecutionLogEntry> UpsertExecutionLogEntry(
        IReadOnlyList<ExecutionLogEntry> entries,
        ExecutionLogEntry entry)
    {
        return entries
            .Where(item => item.Id != entry.Id)
            .Append(entry)
            .OrderByDescending(item => item.CreatedAtUtc)
            .ToList();
    }

    private string BuildPromptWithAttachments()
    {
        draftAttachmentPaths = draftAttachmentPaths.Select(RelativeAttachmentPath.NormalizeOrNull).OfType<string>()
            .Distinct(StringComparer.Ordinal).ToArray();
        if (draftAttachmentPaths.Count == 0)
        {
            return draftPrompt.Trim();
        }

        var attachmentText = string.Join(
            Environment.NewLine,
            draftAttachmentPaths.Select(item => $"- {item}"));

        return $"""
Use these workspace artifacts as input:
{attachmentText}

{draftPrompt.Trim()}
""";
    }


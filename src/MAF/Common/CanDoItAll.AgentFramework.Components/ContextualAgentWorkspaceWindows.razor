@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Logging
@using CanDoItAll.AgentFramework.UI.Chat
@implements IAsyncDisposable
@inject IAgentFrameworkWorkspaceService WorkspaceService
@inject IAgentReferenceDataProvider AgentReferenceDataProvider
@inject IAgentChatAttachmentStagingService AttachmentStagingService
@inject IAgentVoiceService VoiceService
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject TooltipService TooltipService
@inject Microsoft.JSInterop.IJSRuntime JsRuntime
@inject ILogger<ContextualAgentWorkspaceWindows> Logger

@if (WindowState.IsVisible)
{
    <CanvasFloatingWindow WindowId="@WindowId"
                          TestId="@TestId"
                          AriaLabel="@AriaLabel"
                          Kicker="@Kicker"
                          Title="@WindowTitle"
                          Summary=""
                          BodyClass="contextual-agent-window__body"
                          DefaultPlacement="@DefaultPlacement"
                          DefaultWidth="@DefaultWidth"
                          DefaultHeight="@DefaultHeight"
                          MinWidth="320"
                          MinHeight="360"
                          MaxWidth="520"
                          MaxHeight="760"
                          State="@WindowState"
                          StateChanged="WindowStateChanged">
        <div class="contextual-agent-window" data-testid="@($"{TestId}-content")">
            <div class="contextual-agent-window__filters">
                <TextBox Value="@searchText"
                         ValueChanged="HandleSearchChangedAsync"
                         Placeholder="Search agents"
                         Immediate="true"
                         Class="contextual-agent-window__search"
                         aria-label="Search contextual agents"
                         data-testid="@($"{TestId}-search")" />
                <div class="contextual-agent-window__tag-filter">
                    <TagEditor Value="@tagFilters"
                               ValueChanged="HandleTagFiltersChangedAsync"
                               Suggestions="@AvailableTagSuggestions"
                               Placeholder="Filter tags"
                               TestId="@($"{TestId}-tag-editor")"
                               InputTestId="@($"{TestId}-tag-input")"
                               MaxTags="6" />
                </div>
            </div>

            <div class="contextual-agent-window__meta">
                <StatusBadge Tone="info" Text="@($"{FilteredAgents.Count} of {AccessibleAgents.Count}")" />
                <StatusBadge Tone="neutral" Text="@ResolveScopeLabel()" />
                <TooltipTarget Text="@WindowHelpText"
                               Position="TooltipPosition.BottomRight"
                               Duration="@((TimeSpan?)null)"
                               TriggerClass="contextual-agent-window__help-trigger"
                               TestId="@($"{TestId}-help-tooltip")">
                    <span class="contextual-agent-window__help"
                          aria-label="Show contextual agent window help">
                        <Icon Name="circle_info" />
                    </span>
                </TooltipTarget>
            </div>

            @if (isLoadingAgents)
            {
                <LoadingState Title="Loading agents" Description="Reading contextual access metadata." />
            }
            else if (!string.IsNullOrWhiteSpace(loadError))
            {
                <EmptyState Eyebrow="Agents unavailable"
                            Title="Unable to load contextual agents"
                            Description="@loadError">
                    <Actions>
                        <Button Text="Retry"
                                ButtonStyle="ButtonStyle.Light"
                                Click="LoadAgentsAsync" />
                    </Actions>
                </EmptyState>
            }
            else if (AccessibleAgents.Count == 0)
            {
                <EmptyState Eyebrow="No agents"
                            Title="No agents have access here"
                            Description="@ResolveEmptyAccessDescription()" />
            }
            else if (FilteredAgents.Count == 0)
            {
                <EmptyState Eyebrow="No matches"
                            Title="No agents match the current filters"
                            Description="Clear search or tag filters to restore the contextual agent list." />
            }
            else
            {
                <div class="contextual-agent-window__list"
                     data-testid="@($"{TestId}-agent-list")">
                    @foreach (var item in FilteredAgents)
                    {
                        var isSelected = catalogSelectedAgentId == item.Agent.Id;
                        <article class="contextual-agent-window__agent @(isSelected ? "is-selected" : string.Empty)"
                                 data-testid="@($"{TestId}-agent-{item.Agent.Id:N}")"
                                 @key="item.Agent.Id">
                            <button type="button"
                                    class="contextual-agent-window__agent-open"
                                    aria-label="@($"Open a new contextual chat thread with {ResolveAgentName(item.Agent)}")"
                                    @onclick="@(() => SelectAgent(item.Agent.Id))"
                                    @ondblclick="@(() => OpenAgentChatAsync(item))"
                                    @onkeydown="@((KeyboardEventArgs args) => HandleAgentKeyDownAsync(args, item))"
                                    data-testid="@($"{TestId}-agent-{item.Agent.Id:N}-open")">
                                <Avatar Alt="@item.Agent.Name"
                                        ImageUrl="@item.Agent.AvatarImageUrl"
                                        FallbackText="@ResolveAgentInitials(item.Agent)"
                                        DefaultImageSeed="@ResolveAgentSeed(item.Agent)"
                                        Size="AvatarSize.Medium"
                                        Shape="AvatarShape.Rounded" />

                                <span class="contextual-agent-window__agent-main">
                                    <TooltipTarget Text="@BuildAgentTooltip(item.Agent)"
                                                   Position="TooltipPosition.RightTop"
                                                   Duration="@((TimeSpan?)null)"
                                                   TriggerClass="contextual-agent-window__agent-title-trigger"
                                                   TabIndex="-1"
                                                   TestId="@($"{TestId}-agent-{item.Agent.Id:N}-details-tooltip")">
                                        <span class="contextual-agent-window__agent-title">@ResolveAgentName(item.Agent)</span>
                                    </TooltipTarget>
                                    @if (VisibleTags(item.Agent).Count > 0)
                                    {
                                        <span class="contextual-agent-window__tags">
                                            @foreach (var tag in VisibleTags(item.Agent).Take(4))
                                            {
                                                <span class="contextual-agent-window__tag"
                                                      style="@ResolveTagStyle(tag)">#@tag</span>
                                            }
                                        </span>
                                    }
                                </span>

                                <span class="contextual-agent-window__agent-access">
                                    @if (item.CanRead)
                                    {
                                        <span class="contextual-agent-window__access-chip contextual-agent-window__access-chip--read">Read</span>
                                    }
                                    @if (item.CanWrite)
                                    {
                                        <span class="contextual-agent-window__access-chip contextual-agent-window__access-chip--write">Write</span>
                                    }
                                    else
                                    {
                                        @if (item.CanWriteNonTaskStructure)
                                        {
                                            <span class="contextual-agent-window__access-chip contextual-agent-window__access-chip--write">Structure write</span>
                                        }
                                        @if (item.CanWriteTasks)
                                        {
                                            <span class="contextual-agent-window__access-chip contextual-agent-window__access-chip--write">Task write</span>
                                        }
                                        @if (item.CanCreateProjects)
                                        {
                                            <span class="contextual-agent-window__access-chip contextual-agent-window__access-chip--write">Create projects</span>
                                        }
                                        @if (item.CanCreateSubprojects)
                                        {
                                            <span class="contextual-agent-window__access-chip contextual-agent-window__access-chip--write">Create subprojects</span>
                                        }
                                    }
                                    <span class="contextual-agent-window__access-chip contextual-agent-window__access-chip--scope">@item.ScopeLabel</span>
                                </span>
                            </button>

                            <button type="button"
                                    class="contextual-agent-window__agent-history"
                                    aria-label="@($"Open recent threads with {ResolveAgentName(item.Agent)}")"
                                    title="Open recent threads"
                                    @onclick="@(() => OpenAgentThreadHistoryDialogAsync(item))"
                                    data-testid="@($"{TestId}-agent-{item.Agent.Id:N}-history")">
                                <Icon Name="history" />
                            </button>
                        </article>
                    }
                </div>
            }
        </div>
    </CanvasFloatingWindow>
}

@if (chatWindowState.IsVisible && selectedAgent is not null)
{
    <CanvasFloatingWindow WindowId="@ChatWindowId"
                          TestId="@($"{TestId}-chat-window")"
                          AriaLabel="@($"Contextual chat with {ResolveAgentName(selectedAgent)}")"
                          Kicker="@ResolveChatKicker()"
                          Title="@ResolveChatTitle()"
                          Summary="@ResolveChatSummary()"
                          BodyClass="contextual-agent-chat-window__body"
                          DefaultPlacement="top-left"
                          DefaultWidth="660"
                          DefaultHeight="700"
                          MinWidth="420"
                          MinHeight="420"
                          MaxWidth="920"
                          MaxHeight="860"
                          State="@chatWindowState"
                          StateChanged="HandleChatWindowStateChangedAsync">
        <div class="contextual-agent-chat-window" data-testid="@($"{TestId}-chat-content")">
            <ChatWorkspacePanel @key="targetGeneration" Agent="@selectedAgent"
                                Session="@workspace?.SelectedSession"
                                ActiveRun="@workspace?.SelectedRun"
                                ExecutionLog="@executionLog"
                                DraftPrompt="@draftPrompt"
                                DraftPromptChanged="HandleDraftPromptChangedAsync"
                                IsBusy="@isChatBusy"
                                ComposerKey="@composerKey"
                                RunStateText="@runStateText"
                                RunStateTone="@runStateTone"
                                PendingUserPrompt="@pendingUserPrompt"
                                PendingUserCreatedAtUtc="@pendingUserCreatedAtUtc"
                                DraftAttachmentPaths="@draftAttachmentPaths"
                                CanUseVoiceMode="@CanUseSelectedAgentVoiceMode"
                                IsVoiceModeEnabled="@isVoiceModeEnabled"
                                IsVoiceRecording="@isVoiceRecording"
                                IsVoiceTranscribing="@isVoiceTranscribing"
                                IsVoiceSpeaking="@isVoiceSpeaking"
                                VoiceStatusText="@voiceStatusText"
                                VoiceStatusTone="@voiceStatusTone"
                                SendRequested="SendMessageAsync"
                                ApprovalDecisionsRequested="HandleApprovalDecisionsAsync"
                                ApprovalDecisionForConversationRequested="ApproveConversationAsync"
                                AttachmentRequested="StageAttachmentsAsync"
                                AttachmentFilesSelected="StageUploadedAttachmentFilesAsync"
                                SessionTitleChanged="HandleSessionTitleChangedAsync"
                                VoiceModeChanged="HandleVoiceModeChangedAsync"
                                VoiceRecordingToggled="ToggleVoiceRecordingAsync"
                                SpeakLatestAssistantMessageRequested="SpeakLatestAssistantMessageAsync">
                <HeaderActions>
                    <Button Icon="file_download"
                            ButtonStyle="ButtonStyle.Light"
                            Size="ButtonSize.Small"
                            Variant="Variant.Text"
                            Disabled="@(!CanDownloadThreadHistory)"
                            IsBusy="@isDownloadingThreadHistory"
                            Click="DownloadThreadHistoryAsync"
                            aria-label="Download agent thread history JSON"
                            title="Download agent thread history JSON"
                            data-testid="@($"{TestId}-download-thread-history-json")" />
                    <span class="contextual-agent-chat-window__runtime-action"
                          @onmouseenter="OpenRuntimeDetailsTooltip"
                          @onmousemove="OpenRuntimeDetailsTooltip"
                          @onmouseleave="CloseRuntimeDetailsTooltip">
                        <Button Icon="runtime"
                                ButtonStyle="ButtonStyle.Light"
                                Size="ButtonSize.Small"
                                Click="OpenRuntimeDetailsDialogAsync"
                                aria-label="Runtime details"
                                @onmouseenter="OpenRuntimeDetailsTooltip"
                                @onmousemove="OpenRuntimeDetailsTooltip"
                                @onmouseleave="CloseRuntimeDetailsTooltip"
                                data-testid="@($"{TestId}-open-runtime-details")" />
                    </span>
                </HeaderActions>
            </ChatWorkspacePanel>
        </div>
    </CanvasFloatingWindow>
}

@code {
    private const string DefaultRunStateTone = "neutral";
    private const string ProjectStructureScopeLabel = "Project structure";
    private const string ProcessesScopeLabel = "Processes";
    private const string ProjectStructureSourceKind = "project-structure";
    private const string ProcessDefinitionSourceKind = "process-definition";
    private const string ContextualWindowRequester = "contextual-agent-window";
    private static readonly TagPaletteEntry[] TagPalette =
    [
        new("#e0f2fe", "#7dd3fc", "#0c4a6e"),
        new("#fce7f3", "#f9a8d4", "#831843"),
        new("#d1fae5", "#6ee7b7", "#064e3b"),
        new("#fef3c7", "#fcd34d", "#78350f"),
        new("#ede9fe", "#c4b5fd", "#4c1d95"),
        new("#ffedd5", "#fdba74", "#7c2d12"),
        new("#e0e7ff", "#a5b4fc", "#312e81"),
        new("#ccfbf1", "#5eead4", "#134e4a"),
        new("#fce4ec", "#f48fb1", "#880e4f"),
        new("#e8f5e9", "#81c784", "#1b5e20")
    ];

    [Parameter, EditorRequired]
    public string WindowId { get; set; } = string.Empty;

    [Parameter]
    public string ChatWindowId { get; set; } = string.Empty;

    [Parameter]
    public string TestId { get; set; } = "contextual-agent-window";

    [Parameter]
    public string AriaLabel { get; set; } = "Contextual agents";

    [Parameter]
    public string Kicker { get; set; } = "Agents";

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Summary { get; set; }

    [Parameter]
    public string DefaultPlacement { get; set; } = "top-right";

    [Parameter]
    public double DefaultWidth { get; set; } = 400;

    [Parameter]
    public double DefaultHeight { get; set; } = 620;

    [Parameter, EditorRequired]
    public CanvasWorkbenchWindowState WindowState { get; set; } = new() { IsVisible = false };

    [Parameter]
    public EventCallback<CanvasWorkbenchWindowState> WindowStateChanged { get; set; }

    [Parameter]
    public ContextualAgentWorkspaceKind WorkspaceKind { get; set; } = ContextualAgentWorkspaceKind.ProjectStructure;

    [Parameter]
    public Guid? ProjectId { get; set; }

    [Parameter]
    public Guid? ProcessDefinitionId { get; set; }

    [Parameter]
    public IReadOnlyList<string> SelectedNodeIds { get; set; } = [];

    [Parameter]
    public EventCallback<ContextualAgentWorkspaceRefreshRequest> WorkspaceRefreshRequested { get; set; }

    private IReadOnlyList<AgentDefinition> agents = [];
    private IReadOnlyList<ContextualAgentAccessSummary> accessibleAgents = [];
    private CanvasWorkbenchWindowState chatWindowState = new() { IsVisible = false };
    private ChatAgentWorkspaceSnapshot? workspace;
    private IReadOnlyList<ExecutionLogEntry> executionLog = [];
    private IReadOnlyList<AgentRunMetric> metrics = [];
    private long workspaceLoadGeneration;
    private long targetGeneration;
    private readonly CancellationTokenSource lifetime = new();
    private CancellationTokenSource targetCancellation = new();
    private bool disposed;
    private string browserVoiceOwnerId = Guid.NewGuid().ToString("N");

    private bool IsCurrentTarget(long generation) => !disposed && generation == targetGeneration;

    private void RenewTarget() {
        var previousVoiceOwner = browserVoiceOwnerId;
        browserVoiceOwnerId = Guid.NewGuid().ToString("N");
        _ = DisposeBrowserVoiceOwnerAsync(previousVoiceOwner);
        targetGeneration++;
        Interlocked.Increment(ref workspaceLoadGeneration);
        targetCancellation.Cancel();
        targetCancellation.Dispose();
        targetCancellation = new();
        pendingUserPrompt = string.Empty;
        draftAttachmentPaths = [];
        isChatBusy = false;
        isVoiceRecording = false;
        isVoiceTranscribing = false;
        isVoiceSpeaking = false;
    }
    private IReadOnlyList<string> draftAttachmentPaths = [];
    private AgentDefinition? selectedAgent;
    private Guid? selectedAgentId;
    private Guid? catalogSelectedAgentId;
    private Guid? selectedSessionId;
    private string searchText = string.Empty;
    private string draftPrompt = string.Empty;
    private string pendingUserPrompt = string.Empty;
    private DateTimeOffset? pendingUserCreatedAtUtc;
    private string runStateText = string.Empty;
    private string runStateTone = DefaultRunStateTone;
    private string loadError = string.Empty;
    private IReadOnlyList<string> tagFilters = [];
    private bool isLoadingAgents;
    private bool isChatBusy;
    private bool isDownloadingThreadHistory;
    private bool isVoiceModeEnabled;
    private bool isVoiceRecording;
    private bool isVoiceTranscribing;
    private bool isVoiceSpeaking;
    private int composerKey;
    private string lastContextKey = string.Empty;
    private string voiceStatusText = string.Empty;
    private string voiceStatusTone = "neutral";
    private readonly HashSet<Guid> sessionsWithVoiceIdentifierOmissionNotice = [];
    private bool hasVoiceIdentifierOmissionNoticeWithoutSession;

    private string WindowTitle
        => string.IsNullOrWhiteSpace(Title) ? $"{ResolveWorkspaceLabel()} agents" : Title;

    private string WindowHelpText
        => string.IsNullOrWhiteSpace(Summary)
            ? "Search agents with contextual access, filter by tags, and double-click to open a new chat thread."
            : Summary;

    private IReadOnlyList<ContextualAgentAccessSummary> AccessibleAgents
        => accessibleAgents;

    private IReadOnlyList<ContextualAgentAccessSummary> FilteredAgents
        => AccessibleAgents
            .Where(MatchesSearch)
            .Where(MatchesTags)
            .ToList();

    private IReadOnlyList<string> AvailableTagSuggestions
        => AccessibleAgents
            .SelectMany(item => VisibleTags(item.Agent))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(tag => tag, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private bool CanOpenRuntimeDetails
        => workspace?.SelectedRun is not null ||
           executionLog.Count > 0 ||
           metrics.Count > 0;

    private bool CanDownloadThreadHistory
        => selectedAgentId.HasValue && selectedAgent is not null && !isDownloadingThreadHistory;

    private AgentVoiceAccessSettings SelectedAgentVoiceAccess
        => selectedAgent is null
            ? new AgentVoiceAccessSettings()
            : AgentVoiceAccessMetadata.Read(selectedAgent.ConfigurationJson);

    private bool CanUseSelectedAgentVoiceMode
        => SelectedAgentVoiceAccess.CanUseVoiceMode;

    protected override async Task OnInitializedAsync()
    {
        WorkspaceService.ExecutionUpdated += HandleExecutionUpdated;
        await LoadAgentsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (disposed) {
            return;
        }
        var contextKey = BuildContextKey();
        if (string.Equals(contextKey, lastContextKey, StringComparison.Ordinal))
        {
            return;
        }

        if (!string.IsNullOrEmpty(lastContextKey)) {
            RenewTarget();
        }
        lastContextKey = contextKey;
        ResolveAccessibleAgents();
        await CloseChatIfOutOfScopeAsync();
    }

    private async Task LoadAgentsAsync()
    {
        using var request = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
        isLoadingAgents = true;
        loadError = string.Empty;

        try
        {
            var referenceData = await AgentReferenceDataProvider.GetAsync(
                new AgentReferenceDataRequest(AgentReferenceDataSections.Agents), request.Token);
            if (disposed) {
                return;
            }
            agents = referenceData.Agents;
            ResolveAccessibleAgents();
        }
        catch (Exception) when (disposed) {
        }
        catch (Exception)
        {
            loadError = "Contextual agents could not be loaded. Reopen the workspace to retry.";
        }
        finally
        {
            if (!disposed) {
                isLoadingAgents = false;
            }
        }
    }

    private void ResolveAccessibleAgents()
    {
        accessibleAgents = ContextualAgentAccessResolver.Resolve(
            agents,
            WorkspaceKind,
            ProjectId,
            ProcessDefinitionId);
    }

    private Task CloseChatIfOutOfScopeAsync()
    {
        if (selectedAgentId is null ||
            AccessibleAgents.Any(item => item.Agent.Id == selectedAgentId.Value))
        {
            return Task.CompletedTask;
        }

        selectedAgent = null;
        selectedAgentId = null;
        selectedSessionId = null;
        workspace = null;
        executionLog = [];
            metrics = [];
            draftPrompt = string.Empty;
            pendingUserPrompt = string.Empty;
            draftAttachmentPaths = [];
            isVoiceModeEnabled = false;
            isVoiceRecording = false;
            chatWindowState = CanvasWorkbenchWindowState.Normalize(new CanvasWorkbenchWindowState { IsVisible = false });
            return Task.CompletedTask;
    }

    private Task HandleSearchChangedAsync(string? value)
    {
        searchText = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task HandleTagFiltersChangedAsync(IReadOnlyList<string> value)
    {
        tagFilters = value;
        return Task.CompletedTask;
    }

    private void SelectAgent(Guid agentId)
    {
        catalogSelectedAgentId = agentId;
    }

    private async Task HandleAgentKeyDownAsync(KeyboardEventArgs args, ContextualAgentAccessSummary item)
    {
        if (args.Key is not ("Enter" or " "))
        {
            return;
        }

        await OpenAgentChatAsync(item);
    }

    private async Task OpenAgentChatAsync(ContextualAgentAccessSummary item)
    {
        if (disposed) {
            return;
        }
        RenewTarget();
        var generation = targetGeneration;
        using var request = CancellationTokenSource.CreateLinkedTokenSource(targetCancellation.Token);
        catalogSelectedAgentId = item.Agent.Id;
        selectedAgentId = item.Agent.Id;
        selectedAgent = item.Agent;
        selectedSessionId = null;
        workspace = null;
        executionLog = [];
        metrics = [];
        isChatBusy = true;
        OpenChatWindow();
        await InvokeAsync(StateHasChanged);

        try
        {
            var session = await WorkspaceService.GetOrCreateChatSessionAsync(item.Agent.Id, cancellationToken: request.Token);
            if (!IsCurrentTarget(generation)) {
                return;
            }
            if (session.AgentId != item.Agent.Id) {
                throw new InvalidDataException("The contextual session belongs to a different agent.");
            }
            if (await LoadWorkspaceAsync(item.Agent.Id, session.Id) && IsCurrentTarget(generation)) {
                Notify("Thread ready", "success", $"Opened a new contextual thread with {ResolveAgentName(item.Agent)}.");
            }
        }
        catch (Exception) when (!IsCurrentTarget(generation)) {
        }
        catch (Exception)
        {
            Notify("Unable to open agent chat", "danger", "The contextual thread could not be opened. Retry when the agent is available.");
        }
        finally
        {
            if (IsCurrentTarget(generation)) {
                isChatBusy = false;
            }
        }
    }

    private async Task OpenAgentThreadHistoryDialogAsync(ContextualAgentAccessSummary item) {
        if (disposed || isChatBusy) {
            return;
        }
        var generation = targetGeneration;
        using var request = CancellationTokenSource.CreateLinkedTokenSource(targetCancellation.Token);
        catalogSelectedAgentId = item.Agent.Id;
        isChatBusy = true;
        try {
            var sessions = (await WorkspaceService.ListChatSessionsAsync(item.Agent.Id, request.Token))
                .OrderByDescending(session => session.UpdatedAtUtc)
                .Take(AgentThreadHistoryDialog.MaxThreadCount)
                .ToList();
            if (!IsCurrentTarget(generation)) {
                return;
            }
            var result = await DialogService.OpenAsync<AgentThreadHistoryDialog>(
                "Agent thread history",
                new Dictionary<string, object?> {
                    [nameof(AgentThreadHistoryDialog.Agent)] = item.Agent,
                    [nameof(AgentThreadHistoryDialog.Sessions)] = sessions,
                    [nameof(AgentThreadHistoryDialog.SelectedSessionId)] = selectedSessionId
                },
                new DialogOptions {
                    Eyebrow = "Contextual agent",
                    Subtitle = $"{ResolveAgentName(item.Agent)} / latest {sessions.Count} thread(s)",
                    Size = ModalSize.Wide,
                    DenseChrome = true,
                    TestId = $"{TestId}-agent-thread-history-dialog",
                    AriaLabel = "Agent thread history"
                }, request.Token);
            if (!IsCurrentTarget(generation) || result is not Guid sessionId) {
                return;
            }
            if (!sessions.Any(session => session.Id == sessionId && session.AgentId == item.Agent.Id)) {
                throw new InvalidDataException("The selected contextual thread is unavailable.");
            }
            RenewTarget();
            generation = targetGeneration;
            selectedAgentId = item.Agent.Id;
            selectedAgent = item.Agent;
            selectedSessionId = sessionId;
            workspace = null;
            isChatBusy = true;
            if (await LoadWorkspaceAsync(item.Agent.Id, sessionId) && IsCurrentTarget(generation)) {
                OpenChatWindow();
                Notify("Thread opened", "success", $"Opened {ResolveChatSummary()} with {ResolveAgentName(item.Agent)}.");
            }
        } catch (Exception) when (!IsCurrentTarget(generation)) {
        } catch (Exception) {
            Notify("Unable to open thread", "danger", "The requested thread history could not be loaded. Retry when the agent is available.");
        } finally {
            if (IsCurrentTarget(generation)) {
                isChatBusy = false;
            }
        }
    }

    private void OpenChatWindow()
    {
        var state = chatWindowState.HasCustomGeometry
            ? chatWindowState.Clone()
            : new CanvasWorkbenchWindowState
            {
                Width = 660,
                Height = 700
            };

        state.IsVisible = true;
        state.IsMinimized = false;
        chatWindowState = CanvasWorkbenchWindowState.Normalize(state);
    }

    private Task HandleChatWindowStateChangedAsync(CanvasWorkbenchWindowState state)
    {
        chatWindowState = CanvasWorkbenchWindowState.Normalize(state);
        return Task.CompletedTask;
    }

    private Task HandleDraftPromptChangedAsync(string value)
    {
        draftPrompt = value;
        return Task.CompletedTask;
    }

    private async Task SendMessageAsync()
    {
        if (disposed || isChatBusy) {
            return;
        }
        if (!selectedAgentId.HasValue)
        {
            Notify("Select an agent", "warning", "Open a contextual agent before sending a prompt.");
            return;
        }

        var prompt = BuildPromptWithAttachments();
        if (string.IsNullOrWhiteSpace(prompt))
        {
            Notify("Prompt required", "warning", "Enter a prompt before sending it.");
            return;
        }

        var operationGeneration = targetGeneration;
        var executionAgentId = selectedAgentId.Value;
        var executionSessionId = selectedSessionId;
        var executionLoadGeneration = Volatile.Read(ref workspaceLoadGeneration);
        var executionCompleted = false;
        var continuationLoadGeneration = executionLoadGeneration;
        var continuationSessionId = executionSessionId;
        isChatBusy = true;
        pendingUserCreatedAtUtc = DateTimeOffset.UtcNow;
        pendingUserPrompt = draftPrompt;
        var previousDraft = draftPrompt;
        draftPrompt = string.Empty;
        composerKey++;

        try
        {
            var result = await WorkspaceService.ExecuteRunAsync(
                new ExecutionRunRequest(
                    AgentId: executionAgentId,
                    Prompt: BuildContextualPrompt(prompt),
                    InitialActivityOperationId: AgentExecutionOperationId.New(),
                    ChatSessionId: executionSessionId,
                    Context: BuildInvocationContext(),
                    AutoApprovePendingToolCalls: ShouldAutoApproveContextualRun(),
                    InputAttachmentPaths: draftAttachmentPaths));
            executionCompleted = true;
            if (!IsWorkspaceSelectionCurrent(
                    executionAgentId,
                    executionSessionId,
                    executionLoadGeneration))
            {
                return;
            }

            draftAttachmentPaths = [];
            continuationLoadGeneration = unchecked(executionLoadGeneration + 1);
            continuationSessionId = result.ChatSessionId ?? executionSessionId;
            var workspaceReloaded = await LoadWorkspaceAsync(
                executionAgentId,
                continuationSessionId);
            if (!workspaceReloaded ||
                !IsWorkspaceSelectionCurrent(
                    executionAgentId,
                    continuationSessionId,
                    continuationLoadGeneration))
            {
                return;
            }

            var refreshNotified = await TryNotifyCompletedWorkspaceRefreshAsync(
                result.ExecutionRunId,
                executionAgentId,
                continuationSessionId,
                "send");
            if (!IsWorkspaceSelectionCurrent(
                    executionAgentId,
                    continuationSessionId,
                    continuationLoadGeneration))
            {
                return;
            }

            Notify(
                refreshNotified ? "Prompt sent" : "Refresh needed",
                refreshNotified ? "success" : "warning",
                refreshNotified
                    ? "The contextual thread was updated."
                    : "The prompt completed and the contextual thread was loaded, but the owning workspace could not be refreshed.");
            if (isVoiceModeEnabled && !string.IsNullOrWhiteSpace(result.ResponseText))
            {
                await SpeakTextAsync(result.ResponseText);
            }
        }
        catch (AgentChatRunFailedException exception)
        {
            if (exception.AgentId != executionAgentId ||
                (executionSessionId.HasValue &&
                 exception.ChatSessionId != executionSessionId) ||
                !IsWorkspaceSelectionCurrent(
                    executionAgentId,
                    executionSessionId,
                    executionLoadGeneration))
            {
                LogInactiveSelectionRunFailure(exception, "send");
                return;
            }

            var reloadGeneration = Volatile.Read(ref workspaceLoadGeneration);
            var workspaceReloaded = await TryReloadFailedWorkspaceAsync(exception);
            if (Volatile.Read(ref workspaceLoadGeneration) != unchecked(reloadGeneration + 1) ||
                selectedAgentId != exception.AgentId ||
                selectedSessionId != exception.ChatSessionId)
            {
                LogInactiveSelectionRunFailure(exception, "send");
                return;
            }

            Notify(
                "Prompt failed",
                "danger",
                BuildFailedRunMessage(
                    exception.SanitizedDisplayMessage,
                    workspaceReloaded));
        }
        catch (Exception exception)
        {
            LogOperationContinuationFailure(
                exception,
                executionAgentId,
                executionSessionId,
                "send",
                executionCompleted);
            if (IsOperationContinuationCurrent(
                    executionAgentId,
                    executionSessionId,
                    continuationSessionId,
                    continuationLoadGeneration,
                    executionCompleted))
            {
                if (!executionCompleted)
                {
                    draftPrompt = previousDraft;
                    composerKey++;
                }

                Notify(
                    executionCompleted ? "Refresh needed" : "Prompt failed",
                    executionCompleted ? "warning" : "danger",
                    executionCompleted
                        ? "The prompt completed, but its latest contextual thread state could not be loaded. Reload this workspace to see the persisted result."
                        : "The prompt could not be completed. Retry, or inspect runtime details for the persisted failure.");
            }
        }
        finally
        {
            if (IsCurrentTarget(operationGeneration)) {
                pendingUserPrompt = string.Empty;
                isChatBusy = false;
            }
        }
    }

    private async Task<bool> TryReloadFailedWorkspaceAsync(
        AgentChatRunFailedException exception)
    {
        if (disposed) {
            return false;
        }
        using var request = CancellationTokenSource.CreateLinkedTokenSource(targetCancellation.Token);
        var loadGeneration = Interlocked.Increment(ref workspaceLoadGeneration);
        try
        {
            var failedWorkspace = await WorkspaceService.GetChatAgentWorkspaceAsync(
                exception.AgentId,
                exception.ChatSessionId, request.Token);
            if (disposed || loadGeneration != Volatile.Read(ref workspaceLoadGeneration))
            {
                return false;
            }

            if (failedWorkspace.AgentId != exception.AgentId ||
                failedWorkspace.SelectedSessionId != exception.ChatSessionId)
            {
                throw new InvalidOperationException(
                    "The contextual workspace does not belong to the persisted failed run thread.");
            }

            var failedRunDetail = await WorkspaceService.GetExecutionRunDetailAsync(
                exception.ExecutionRunId, request.Token);
            if (disposed || loadGeneration != Volatile.Read(ref workspaceLoadGeneration))
            {
                return false;
            }

            if (failedRunDetail.Run.AgentId != exception.AgentId ||
                failedRunDetail.Run.ChatSessionId != exception.ChatSessionId)
            {
                throw new InvalidOperationException(
                    "The persisted failed run does not belong to the requested contextual thread.");
            }

            selectedAgentId = exception.AgentId;
            selectedAgent = agents.FirstOrDefault(agent => agent.Id == exception.AgentId) ?? selectedAgent;
            selectedSessionId = exception.ChatSessionId;
            workspace = failedWorkspace with
            {
                SelectedRun = failedRunDetail.Run
            };
            executionLog = failedRunDetail.ExecutionLog;
            metrics = failedRunDetail.Metrics;
            ResolveRunState();
            try
            {
                await NotifyWorkspaceRefreshRequestedAsync(exception.ExecutionRunId);
            }
            catch (Exception refreshException)
            {
                Logger.LogWarning(
                    "The persisted failed contextual-agent run was reloaded, but its workspace refresh callback failed. AgentId={AgentId} ChatSessionId={ChatSessionId} ExecutionRunId={ExecutionRunId} FailureCategory={FailureCategory} RefreshFailureType={RefreshFailureType}.",
                    exception.AgentId,
                    exception.ChatSessionId,
                    exception.ExecutionRunId,
                    exception.FailureCategory,
                    refreshException.GetType().Name);
            }

            return true;
        }
        catch (Exception reloadException)
        {
            Logger.LogWarning(
                "Unable to reload the persisted failed contextual-agent run. AgentId={AgentId} ChatSessionId={ChatSessionId} ExecutionRunId={ExecutionRunId} FailureCategory={FailureCategory} ReloadFailureType={ReloadFailureType}.",
                exception.AgentId,
                exception.ChatSessionId,
                exception.ExecutionRunId,
                exception.FailureCategory,
                reloadException.GetType().Name);
            return false;
        }
    }

    private bool IsWorkspaceSelectionCurrent(
        Guid agentId,
        Guid? chatSessionId,
        long loadGeneration)
    {
        return !disposed && loadGeneration == Volatile.Read(ref workspaceLoadGeneration) &&
               selectedAgentId == agentId &&
               selectedSessionId == chatSessionId;
    }

    private bool IsOperationContinuationCurrent(
        Guid agentId,
        Guid? executionSessionId,
        Guid? continuationSessionId,
        long loadGeneration,
        bool executionCompleted)
    {
        if (disposed || loadGeneration != Volatile.Read(ref workspaceLoadGeneration) ||
            selectedAgentId != agentId)
        {
            return false;
        }

        return selectedSessionId == continuationSessionId ||
               executionCompleted && selectedSessionId == executionSessionId;
    }

    private async Task<bool> TryNotifyCompletedWorkspaceRefreshAsync(
        Guid? executionRunId,
        Guid agentId,
        Guid? chatSessionId,
        string operationKind)
    {
        try
        {
            await NotifyWorkspaceRefreshRequestedAsync(executionRunId);
            return true;
        }
        catch (Exception exception)
        {
            Logger.LogWarning(
                "A completed contextual-agent operation could not notify its owning workspace. Operation={OperationKind} AgentId={AgentId} ChatSessionId={ChatSessionId} ExecutionRunId={ExecutionRunId} RefreshFailureType={RefreshFailureType}.",
                operationKind,
                agentId,
                chatSessionId,
                executionRunId,
                exception.GetType().Name);
            return false;
        }
    }

    private void LogOperationContinuationFailure(
        Exception exception,
        Guid agentId,
        Guid? chatSessionId,
        string operationKind,
        bool executionCompleted)
    {
        Logger.LogWarning(
            "Contextual-agent operation failed. Operation={OperationKind} AgentId={AgentId} ChatSessionId={ChatSessionId} ExecutionCompleted={ExecutionCompleted} FailureType={FailureType}.",
            operationKind,
            agentId,
            chatSessionId,
            executionCompleted,
            exception.GetType().Name);
    }

    private void LogInactiveSelectionRunFailure(
        AgentChatRunFailedException exception,
        string operationKind)
    {
        Logger.LogWarning(
            "Contextual agent run failure did not match the active workspace selection. Operation={OperationKind} AgentId={AgentId} ChatSessionId={ChatSessionId} ExecutionRunId={ExecutionRunId} SelectedAgentId={SelectedAgentId} SelectedChatSessionId={SelectedChatSessionId} FailureCategory={FailureCategory}.",
            operationKind,
            exception.AgentId,
            exception.ChatSessionId,
            exception.ExecutionRunId,
            selectedAgentId,
            selectedSessionId,
            exception.FailureCategory);
    }

    private static string BuildFailedRunMessage(
        string sanitizedDisplayMessage,
        bool workspaceReloaded)
    {
        return workspaceReloaded
            ? sanitizedDisplayMessage
            : $"{sanitizedDisplayMessage} The failed run was persisted, but runtime details could not be refreshed. Reload this workspace to see the persisted failure.";
    }

    private async Task HandleApprovalDecisionsAsync(IReadOnlyList<PendingToolApprovalDecision> decisions)
    {
        await ContinueApprovalAsync(decisions, autoApprovePendingToolCalls: false);
    }

    private async Task ApproveConversationAsync()
    {
        await ContinueApprovalAsync(decisions: null, autoApprovePendingToolCalls: true);
    }

    private async Task ContinueApprovalAsync(
        IReadOnlyList<PendingToolApprovalDecision>? decisions,
        bool autoApprovePendingToolCalls)
    {
        if (disposed || isChatBusy || !selectedAgentId.HasValue || !selectedSessionId.HasValue)
        {
            return;
        }

        var operationGeneration = targetGeneration;
        var executionAgentId = selectedAgentId.Value;
        var executionSessionId = selectedSessionId.Value;
        var executionLoadGeneration = Volatile.Read(ref workspaceLoadGeneration);
        var executionCompleted = false;
        var continuationLoadGeneration = executionLoadGeneration;
        var pendingApprovals = workspace?.SelectedRun?.PendingApprovals ?? [];
        if (pendingApprovals.Count == 0)
        {
            return;
        }

        // Per-proposal decisions come from the panel unchanged; the
        // approve-remaining action explicitly approves every pending proposal.
        var effectiveDecisions = decisions
            ?? pendingApprovals
                .Select(item => new PendingToolApprovalDecision(item.ApprovalId, Approved: true))
                .ToArray();
        if (effectiveDecisions.Count == 0)
        {
            return;
        }

        var approved = effectiveDecisions.All(item => item.Approved);
        isChatBusy = true;
        try
        {
            var result = await WorkspaceService.RespondToPendingApprovalsAsync(
                executionAgentId,
                executionSessionId,
                AgentExecutionOperationId.New(),
                effectiveDecisions,
                autoApprovePendingToolCalls);
            executionCompleted = true;
            if (!IsWorkspaceSelectionCurrent(
                    executionAgentId,
                    executionSessionId,
                    executionLoadGeneration))
            {
                return;
            }

            continuationLoadGeneration = unchecked(executionLoadGeneration + 1);
            if (!await LoadWorkspaceAsync(executionAgentId, executionSessionId) ||
                !IsWorkspaceSelectionCurrent(
                    executionAgentId,
                    executionSessionId,
                    continuationLoadGeneration))
            {
                return;
            }

            var refreshNotified = await TryNotifyCompletedWorkspaceRefreshAsync(
                result.ExecutionRunId,
                executionAgentId,
                executionSessionId,
                "approval");
            if (!IsWorkspaceSelectionCurrent(
                    executionAgentId,
                    executionSessionId,
                    continuationLoadGeneration))
            {
                return;
            }

            if (!refreshNotified)
            {
                Notify(
                    "Refresh needed",
                    "warning",
                    "The approval completed and the contextual thread was loaded, but the owning workspace could not be refreshed.");
                return;
            }

            Notify(
                approved ? "Approval applied" : "Approval rejected",
                approved ? "success" : "warning",
                approved ? "The contextual thread resumed." : "The contextual thread was refreshed.");
        }
        catch (AgentChatRunFailedException exception)
        {
            if (exception.AgentId != executionAgentId ||
                exception.ChatSessionId != executionSessionId ||
                !IsWorkspaceSelectionCurrent(
                    executionAgentId,
                    executionSessionId,
                    executionLoadGeneration))
            {
                LogInactiveSelectionRunFailure(exception, "approval");
                return;
            }

            var reloadGeneration = Volatile.Read(ref workspaceLoadGeneration);
            var workspaceReloaded = await TryReloadFailedWorkspaceAsync(exception);
            if (Volatile.Read(ref workspaceLoadGeneration) != unchecked(reloadGeneration + 1) ||
                selectedAgentId != exception.AgentId ||
                selectedSessionId != exception.ChatSessionId)
            {
                LogInactiveSelectionRunFailure(exception, "approval");
                return;
            }

            Notify(
                "Approval failed",
                "danger",
                BuildFailedRunMessage(
                    exception.SanitizedDisplayMessage,
                    workspaceReloaded));
        }
        catch (Exception exception)
        {
            LogOperationContinuationFailure(
                exception,
                executionAgentId,
                executionSessionId,
                "approval",
                executionCompleted);
            if (IsOperationContinuationCurrent(
                    executionAgentId,
                    executionSessionId,
                    executionSessionId,
                    continuationLoadGeneration,
                    executionCompleted))
            {
                Notify(
                    executionCompleted ? "Refresh needed" : "Approval failed",
                    executionCompleted ? "warning" : "danger",
                    executionCompleted
                        ? "The approval completed, but its latest contextual thread state could not be loaded. Reload this workspace to see the persisted result."
                        : "The approval could not be completed. Retry, or inspect runtime details for the persisted failure.");
            }
        }
        finally
        {
            if (IsCurrentTarget(operationGeneration)) {
                isChatBusy = false;
            }
        }
    }

    private async Task StageAttachmentsAsync()
    {
        if (disposed || isChatBusy) {
            return;
        }
        if (workspace?.SelectedRun is null)
        {
            Notify("No run artifacts", "warning", "Run a prompt first so the thread has execution artifacts to stage.");
            return;
        }

        var generation = targetGeneration;
        var run = workspace.SelectedRun;
        using var request = CancellationTokenSource.CreateLinkedTokenSource(targetCancellation.Token);
        isChatBusy = true;
        try {
            var detail = await WorkspaceService.GetExecutionRunDetailAsync(run.Id, request.Token);
            if (!IsCurrentTarget(generation)) {
                return;
            }
            if (detail.Run.Id != run.Id || detail.Run.AgentId != selectedAgentId || detail.Run.ChatSessionId != selectedSessionId) {
                throw new InvalidDataException("The artifacts belong to a different contextual thread.");
            }
            draftAttachmentPaths = detail.Artifacts.Select(item => RelativeAttachmentPath.NormalizeOrNull(item.RelativePath))
                .OfType<string>().Distinct(StringComparer.Ordinal).ToArray();
            var omitted = detail.Artifacts.Count - draftAttachmentPaths.Count;
            Notify("Artifacts staged", omitted > 0 ? "warning" : "success",
                $"Staged {draftAttachmentPaths.Count} artifact path(s) for the next prompt." +
                (omitted > 0 ? " Unsafe or duplicate references were omitted." : string.Empty));
        } catch (Exception) when (!IsCurrentTarget(generation)) {
        } catch (Exception) {
            Notify("Attachment failed", "danger", "The thread artifacts could not be loaded.");
        } finally {
            if (IsCurrentTarget(generation)) {
                isChatBusy = false;
            }
        }
    }

    private async Task StageUploadedAttachmentFilesAsync(InputFileChangeEventArgs args)
    {
        if (disposed || isChatBusy) {
            return;
        }
        const int maxFiles = 8;
        var generation = targetGeneration;
        using var request = CancellationTokenSource.CreateLinkedTokenSource(targetCancellation.Token);
        isChatBusy = true;
        try
        {
            var stagedPaths = new List<string>(draftAttachmentPaths);
            foreach (var file in args.GetMultipleFiles(maxFiles))
            {
                await using var stream = file.OpenReadStream(AgentChatAttachmentStagingService.MaxImageAttachmentBytes, request.Token);
                var staged = await AttachmentStagingService.StageImageAsync(
                    file.Name,
                    file.ContentType,
                    file.Size,
                    stream, request.Token);
                if (!IsCurrentTarget(generation)) {
                    return;
                }
                if (!RelativeAttachmentPath.TryNormalize(staged.RelativePath, out var relativePath)) {
                    throw new InvalidDataException("Attachment staging returned an unsafe relative reference.");
                }
                stagedPaths.Add(relativePath);
            }

            draftAttachmentPaths = stagedPaths
                .Distinct(StringComparer.Ordinal)
                .ToList();
            Notify("Attachments staged", "success", $"Staged {draftAttachmentPaths.Count} attachment path(s) for the next prompt.");
        }
        catch (Exception) when (!IsCurrentTarget(generation)) {
        }
        catch (Exception)
        {
            Notify("Attachment failed", "danger", "The image could not be staged. Check its type and size before trying again.");
        }
        finally
        {
            if (IsCurrentTarget(generation)) {
                isChatBusy = false;
            }
        }
    }

    private async Task HandleSessionTitleChangedAsync(string title)
    {
        if (disposed || isChatBusy || !selectedAgentId.HasValue || !selectedSessionId.HasValue)
        {
            return;
        }

        var agentId = selectedAgentId.Value;
        var sessionId = selectedSessionId.Value;
        var generation = targetGeneration;
        using var request = CancellationTokenSource.CreateLinkedTokenSource(targetCancellation.Token);
        isChatBusy = true;
        try
        {
            var session = await WorkspaceService.RenameChatSessionAsync(
                agentId,
                sessionId,
                title, request.Token);
            if (!IsCurrentTarget(generation)) {
                return;
            }
            if (session.AgentId != agentId || session.Id != sessionId) {
                throw new InvalidDataException("The renamed contextual session does not match the requested target.");
            }
            if (await LoadWorkspaceAsync(agentId, sessionId) && IsCurrentTarget(generation)) {
                Notify("Thread renamed", "success", "Thread title updated.");
            }
        }
        catch (Exception) when (!IsCurrentTarget(generation)) {
        }
        catch (Exception)
        {
            Notify("Rename failed", "danger", "The rename result could not be confirmed. Reload the thread before trying again.");
        }
        finally
        {
            if (IsCurrentTarget(generation)) {
                isChatBusy = false;
            }
        }
    }

    private async Task<bool> LoadWorkspaceAsync(Guid agentId, Guid? preferredSessionId)
    {
        if (disposed) {
            return false;
        }
        using var request = CancellationTokenSource.CreateLinkedTokenSource(targetCancellation.Token);
        var loadGeneration = Interlocked.Increment(ref workspaceLoadGeneration);
        var nextAgent = agents.SingleOrDefault(agent => agent.Id == agentId)
            ?? throw new InvalidDataException("The requested contextual agent is unavailable.");
        var nextWorkspace = await WorkspaceService.GetChatAgentWorkspaceAsync(agentId, preferredSessionId, request.Token);
        if (disposed || loadGeneration != Volatile.Read(ref workspaceLoadGeneration))
        {
            return false;
        }

        if (nextWorkspace.AgentId != agentId || (preferredSessionId.HasValue && nextWorkspace.SelectedSessionId != preferredSessionId)) {
            throw new InvalidDataException("The contextual workspace belongs to a different requested target.");
        }
        var runtimeSnapshot = await WorkspaceService.GetChatRuntimeSnapshotAsync(
            agentId,
            nextWorkspace.SelectedSessionId, request.Token);
        if (disposed || loadGeneration != Volatile.Read(ref workspaceLoadGeneration))
        {
            return false;
        }

        selectedAgentId = agentId;
        selectedAgent = nextAgent;
        workspace = nextWorkspace;
        selectedSessionId = nextWorkspace.SelectedSessionId;
        if (!CanUseSelectedAgentVoiceMode)
        {
            isVoiceModeEnabled = false;
            isVoiceRecording = false;
        }

        executionLog = runtimeSnapshot.ExecutionLog;
        metrics = runtimeSnapshot.Metrics;
        ResolveRunState();
        return true;
    }

    private Task NotifyWorkspaceRefreshRequestedAsync(Guid? executionRunId)
    {
        if (!WorkspaceRefreshRequested.HasDelegate || !selectedAgentId.HasValue)
        {
            return Task.CompletedTask;
        }

        return WorkspaceRefreshRequested.InvokeAsync(
            new ContextualAgentWorkspaceRefreshRequest(
                WorkspaceKind,
                selectedAgentId.Value,
                selectedSessionId,
                executionRunId,
                ProjectId,
                ProcessDefinitionId,
                ContextualAgentWorkspaceContextBuilder.NormalizeSelectedNodeIds(SelectedNodeIds)));
    }


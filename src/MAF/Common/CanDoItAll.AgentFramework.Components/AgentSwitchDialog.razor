@implements IDisposable
@inject NotificationService NotificationService
@{ var renderedGeneration = generation; }

<div class="agent-switch-dialog" data-testid="agent-switch-dialog">
    <ConversationParticipantPicker Participants="@ProjectedAgents"
                                   Text="@PickerText"
                                   SearchTestId="agent-switch-search"
                                   TagFilterTestId="agent-switch-tag-filter"
                                   TagFilterInputTestId="agent-switch-tag-filter-input">
        <ParticipantTemplate Context="participant">
            <ConversationParticipantCard Participant="@participant"
                                         Layout="@(ParticipantCardLayout.Compact | ParticipantCardLayout.Centered)"
                                         ShellTestId="agent-switch-card-shell"
                                         SelectTestId="agent-switch-card"
                                         Selected="@(key => SelectAgentAsync(key, renderedGeneration))"
                                         FavoriteToggled="@(key => ToggleFavoriteAsync(key, renderedGeneration))" />
        </ParticipantTemplate>
    </ConversationParticipantPicker>
</div>

@code {
    private static readonly ConversationParticipantPickerText PickerText = new(
        EmptyEyebrow: "Agents",
        EmptyTitle: "No agents available",
        EmptyDescription: "Create or feed a technical agent before opening chat threads.",
        SearchPlaceholder: "Search agents",
        SearchAriaLabel: "Search agents",
        TagPlaceholder: "Filter tags",
        ItemNoun: "agents",
        NoMatchesEyebrow: "No matches",
        NoMatchesTitle: "No agents match the current filters",
        NoMatchesDescription: "Clear the text search or tag filters to show the full agent list.",
        FavoritesFirstLabel: "Favorites first");
    private IReadOnlyList<AgentDefinition> localAgents = [];
    private IReadOnlyList<AgentDefinition>? previousAgents;
    private Guid? favoriteBusyAgentId;
    private long generation;
    private bool disposed;
    [CascadingParameter] public DialogReference? DialogReference { get; set; }

    [Parameter]
    public IReadOnlyList<AgentDefinition> Agents { get; set; } = [];

    [Parameter]
    public Guid? SelectedAgentId { get; set; }

    [Parameter]
    public IReadOnlyCollection<Guid> PrivateAgentIds { get; set; } = [];

    [Parameter]
    public Func<AgentDefinition, Task<AgentDefinition>>? FavoriteToggled { get; set; }

    private IReadOnlyList<ConversationParticipantPresentation> ProjectedAgents
        => localAgents
            .Select(agent => AgentParticipantPresentationMapper.MapCard(
                agent,
                new(
                    IsSelected: agent.Id == SelectedAgentId,
                    ShowStatusRibbon: false,
                    ShowKindBadge: false,
                    KindLabel: "AI agent",
                    ShowSummary: true,
                    ShowWorkload: false,
                    ShowChatHistory: false,
                    ShowCapabilityCount: true,
                    ShowUpdatedAt: false,
                    ShowTags: true,
                    ShowFavorite: true,
                    IsFavorite: AgentParticipantPresentationMapper.IsFavorite(agent),
                    FavoriteDisabled: favoriteBusyAgentId == agent.Id || FavoriteToggled is null,
                    FavoriteTestId: "agent-favorite-toggle",
                    ShowDetailsTooltip: true,
                    IsPrivateProvider: PrivateAgentIds.Contains(agent.Id),
                    SelectedLabel: "Current agent")))
            .ToList();

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(previousAgents, Agents))
        {
            return;
        }

        previousAgents = Agents;
        generation++;
        favoriteBusyAgentId = null;
        localAgents = Agents.ToList();
    }

    private Task SelectAgentAsync(ConversationPresentationKey key, long renderedGeneration)
        => disposed || generation != renderedGeneration ? Task.CompletedTask
            : DialogReference?.CloseAsync(ResolveAgent(key).Id) ?? Task.CompletedTask;

    private async Task ToggleFavoriteAsync(ConversationPresentationKey key, long renderedGeneration) {
        if (disposed || generation != renderedGeneration || favoriteBusyAgentId is not null || FavoriteToggled is not { } toggle) {
            return;
        }

        var agent = ResolveAgent(key);
        favoriteBusyAgentId = agent.Id;
        try
        {
            var updatedAgent = await toggle.Invoke(agent);
            if (disposed || generation != renderedGeneration) {
                return;
            }
            if (updatedAgent.Id != agent.Id) {
                throw new InvalidOperationException("The favorite update returned a different agent identity.");
            }
            localAgents = localAgents
                .Select(item => item.Id == updatedAgent.Id ? updatedAgent : item)
                .ToList();
        }
        catch (Exception)
        {
            if (!disposed && generation == renderedGeneration) {
                NotificationService.Error("Favorite update failed", "The favorite change could not be confirmed. Reload the agent list before trying again.");
            }
        }
        finally
        {
            if (generation == renderedGeneration) {
                favoriteBusyAgentId = null;
            }
        }
    }

    public void Dispose() => disposed = true;

    private AgentDefinition ResolveAgent(ConversationPresentationKey key)
        => localAgents.SingleOrDefault(agent => AgentParticipantPresentationMapper.AgentKey(agent.Id) == key)
            ?? throw new InvalidOperationException($"Participant '{key}' is not present in the current agent picker.");
}

@namespace CanDoItAll.AgentFramework.Components

<ConversationProviderModelSelector Provider="@NeutralProvider"
                                   Value="@Value"
                                   ValueChanged="@ValueChanged"
                                   Change="@Change"
                                   UseEmptyValueForProviderDefault="@UseEmptyValueForProviderDefault"
                                   Disabled="@Disabled"
                                   Label="@Label"
                                   CustomModelPlaceholder="@CustomModelPlaceholder"
                                   Class="@Class"
                                   TestId="@TestId"
                                   ChoiceTestId="@ChoiceTestId"
                                   OverrideTestId="@OverrideTestId"
                                   CustomModelTestId="@CustomModelTestId" />

@code {
    private static readonly ConversationPresentationKey FacadeProviderKey = new("agent-provider-model-selector");

    [Parameter]
    public ProviderProfile? Provider { get; set; }

    [Parameter]
    public string? ProviderName { get; set; }

    [Parameter]
    public string? ProviderDefaultModel { get; set; }

    [Parameter]
    public IReadOnlyList<string>? ModelOptions { get; set; }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<string?> Change { get; set; }

    [Parameter]
    public bool UseEmptyValueForProviderDefault { get; set; } = true;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string Label { get; set; } = "Model";

    [Parameter]
    public string CustomModelPlaceholder { get; set; } = "Enter model name";

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter]
    public string? ChoiceTestId { get; set; }

    [Parameter]
    public string? OverrideTestId { get; set; }

    [Parameter]
    public string? CustomModelTestId { get; set; }

    private ConversationProviderOption? NeutralProvider
    {
        get
        {
            if (Provider is not null)
            {
                var mapped = AgentProviderPresentationMapper.Map(Provider);
                return mapped with
                {
                    Name = ResolveProviderName(mapped.Name),
                    DefaultModel = ResolveProviderDefaultModel(mapped.DefaultModel),
                    SuggestedModels = ModelOptions ?? mapped.SuggestedModels
                };
            }

            if (string.IsNullOrWhiteSpace(ProviderName) &&
                string.IsNullOrWhiteSpace(ProviderDefaultModel) &&
                ModelOptions is null)
            {
                return null;
            }

            return new ConversationProviderOption(
                FacadeProviderKey,
                ResolveProviderName(string.Empty),
                IsEnabled: true,
                ResolveProviderDefaultModel(string.Empty),
                ModelOptions ?? []);
        }
    }

    public static string NormalizeProviderDefaultModel(string? value, ProviderProfile? provider)
        => NormalizeProviderDefaultModel(value, provider?.DefaultModel);

    public static string NormalizeProviderDefaultModel(string? value, string? providerDefaultModel)
        => ConversationProviderModelSelector.NormalizeProviderDefaultModel(value);

    private string ResolveProviderName(string fallback)
        => string.IsNullOrWhiteSpace(ProviderName) ? fallback : ProviderName.Trim();

    private string ResolveProviderDefaultModel(string fallback)
        => string.IsNullOrWhiteSpace(ProviderDefaultModel) ? fallback : ProviderDefaultModel.Trim();
}

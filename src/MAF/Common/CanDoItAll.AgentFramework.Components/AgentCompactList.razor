<ConversationParticipantCompactList Items="@items"
                                    AriaLabel="@AriaLabel"
                                    TestId="@TestId"
                                    Class="@Class"
                                    Selected="HandleSelectedAsync"
                                    DoubleClicked="HandleDoubleClickedAsync"
                                    ActionRequested="HandleActionRequestedAsync" />

@code {
    private static readonly ConversationPresentationKey NewChatActionKey = new("new-chat");
    private static readonly ConversationPresentationKey HistoryActionKey = new("history");
    private IReadOnlyDictionary<ConversationPresentationKey, AgentDefinition> agentsByKey =
        new Dictionary<ConversationPresentationKey, AgentDefinition>();
    private IReadOnlyList<ConversationParticipantCompactItemPresentation> items = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<AgentDefinition> Agents { get; set; } = [];

    [Parameter]
    public Guid? SelectedAgentId { get; set; }

    [Parameter]
    public IReadOnlySet<Guid>? BusyAgentIds { get; set; }

    [Parameter]
    public string AriaLabel { get; set; } = "Agents";

    [Parameter]
    public string TestId { get; set; } = "agent-compact-list";

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public EventCallback<AgentDefinition> AgentSelected { get; set; }

    [Parameter]
    public EventCallback<AgentDefinition> AgentDoubleClicked { get; set; }

    [Parameter]
    public EventCallback<AgentDefinition> NewChatRequested { get; set; }

    [Parameter]
    public EventCallback<AgentDefinition> HistoryRequested { get; set; }

    protected override void OnParametersSet()
    {
        agentsByKey = Agents.ToDictionary(agent => AgentParticipantPresentationMapper.AgentKey(agent.Id));
        items = Agents
            .Select(agent => AgentParticipantPresentationMapper.MapCompactItem(
                agent,
                SelectedAgentId == agent.Id,
                BusyAgentIds?.Contains(agent.Id) == true,
                BuildTestId("item", agent.Id),
                BuildTestId("select", agent.Id),
                BuildActions(agent)))
            .ToList();
    }

    private IReadOnlyList<ParticipantActionPresentation> BuildActions(AgentDefinition agent)
    {
        var isBusy = BusyAgentIds?.Contains(agent.Id) == true;
        var actions = new List<ParticipantActionPresentation>();
        if (NewChatRequested.HasDelegate)
        {
            actions.Add(new(
                NewChatActionKey,
                $"Start a new chat with {ResolveDisplayName(agent)}",
                "add_comment",
                BuildTestId("new-chat", agent.Id),
                isBusy));
        }

        if (HistoryRequested.HasDelegate)
        {
            actions.Add(new(
                HistoryActionKey,
                $"Open chat history for {ResolveDisplayName(agent)}",
                "history",
                BuildTestId("history", agent.Id),
                isBusy,
                ParticipantActionStyle.Light));
        }

        return actions;
    }

    private Task HandleSelectedAsync(ConversationPresentationKey key)
        => AgentSelected.InvokeAsync(ResolveAgent(key));

    private Task HandleDoubleClickedAsync(ConversationPresentationKey key)
        => AgentDoubleClicked.InvokeAsync(ResolveAgent(key));

    private Task HandleActionRequestedAsync(ParticipantActionRequest request)
    {
        var agent = ResolveAgent(request.ParticipantKey);
        if (request.ActionKey == NewChatActionKey)
        {
            return NewChatRequested.InvokeAsync(agent);
        }

        if (request.ActionKey == HistoryActionKey)
        {
            return HistoryRequested.InvokeAsync(agent);
        }

        throw new InvalidOperationException($"Unsupported participant action '{request.ActionKey}'.");
    }

    private AgentDefinition ResolveAgent(ConversationPresentationKey key)
        => agentsByKey.TryGetValue(key, out var agent)
            ? agent
            : throw new InvalidOperationException($"Participant '{key}' is not present in the current agent list.");

    private string BuildTestId(string action, Guid agentId)
        => $"{TestId}-{action}-{agentId:N}";

    private static string ResolveDisplayName(AgentDefinition agent)
        => string.IsNullOrWhiteSpace(agent.Name) ? "Agent" : agent.Name.Trim();
}

<ConversationParticipantCompactListItem Item="@item"
                                        Class="@Class"
                                        Selected="@(_ => Selected.InvokeAsync(Agent))"
                                        DoubleClicked="@(_ => DoubleClicked.InvokeAsync(Agent))"
                                        ActionRequested="HandleActionRequestedAsync" />

@code {
    private static readonly ConversationPresentationKey NewChatActionKey = new("new-chat");
    private static readonly ConversationPresentationKey HistoryActionKey = new("history");
    private ConversationParticipantCompactItemPresentation item = default!;

    [Parameter, EditorRequired]
    public AgentDefinition Agent { get; set; } = default!;

    [Parameter]
    public bool IsSelected { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? ShellTestId { get; set; }

    [Parameter]
    public string? SelectTestId { get; set; }

    [Parameter]
    public string? NewChatTestId { get; set; }

    [Parameter]
    public string? HistoryTestId { get; set; }

    [Parameter]
    public EventCallback<AgentDefinition> Selected { get; set; }

    [Parameter]
    public EventCallback<AgentDefinition> DoubleClicked { get; set; }

    [Parameter]
    public EventCallback<AgentDefinition> NewChatRequested { get; set; }

    [Parameter]
    public EventCallback<AgentDefinition> HistoryRequested { get; set; }

    protected override void OnParametersSet()
    {
        var actions = new List<ParticipantActionPresentation>();
        if (NewChatRequested.HasDelegate)
        {
            actions.Add(new(
                NewChatActionKey,
                $"Start a new chat with {ResolveDisplayName()}",
                "add_comment",
                NewChatTestId,
                IsBusy));
        }

        if (HistoryRequested.HasDelegate)
        {
            actions.Add(new(
                HistoryActionKey,
                $"Open chat history for {ResolveDisplayName()}",
                "history",
                HistoryTestId,
                IsBusy,
                ParticipantActionStyle.Light));
        }

        item = AgentParticipantPresentationMapper.MapCompactItem(
            Agent,
            IsSelected,
            IsBusy,
            ShellTestId,
            SelectTestId,
            actions);
    }

    private Task HandleActionRequestedAsync(ParticipantActionRequest request)
    {
        if (request.ActionKey == NewChatActionKey)
        {
            return NewChatRequested.InvokeAsync(Agent);
        }

        if (request.ActionKey == HistoryActionKey)
        {
            return HistoryRequested.InvokeAsync(Agent);
        }

        throw new InvalidOperationException($"Unsupported participant action '{request.ActionKey}'.");
    }

    private string ResolveDisplayName()
        => string.IsNullOrWhiteSpace(Agent.Name) ? "Agent" : Agent.Name.Trim();
}

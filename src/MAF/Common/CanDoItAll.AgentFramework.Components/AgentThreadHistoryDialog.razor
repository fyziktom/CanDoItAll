@inject DialogService DialogService

<ConversationThreadHistoryList Threads="@visibleSessions"
                               MaxItems="@MaxThreadCount"
                               ContextLabel="@ResolveAgentName()"
                               EmptyDescription="This agent does not have saved chat threads yet."
                               Selected="SelectSessionAsync" />

@code {
    public const int MaxThreadCount = 25;

    [Parameter]
    public AgentDefinition? Agent { get; set; }

    [Parameter]
    public IReadOnlyList<ChatSessionRecord> Sessions { get; set; } = [];

    [Parameter]
    public IReadOnlyList<ChatSessionSummaryRecord> SessionSummaries { get; set; } = [];

    [Parameter]
    public Guid? SelectedSessionId { get; set; }

    private IReadOnlyList<ConversationThreadPresentation> visibleSessions = [];

    protected override void OnParametersSet()
    {
        var items = SessionSummaries.Count > 0
            ? SessionSummaries.Select(session => AgentThreadHistoryPresentationMapper.Map(session, SelectedSessionId))
            : Sessions.Select(session => AgentThreadHistoryPresentationMapper.Map(session, SelectedSessionId));
        visibleSessions = items.ToArray();
    }

    private Task SelectSessionAsync(ConversationPresentationKey key)
    {
        if (!AgentThreadHistoryPresentationMapper.TryResolveSessionId(key, out var sessionId))
        {
            throw new InvalidOperationException(
                $"Conversation thread key '{key.Value}' is not an Agent session key.");
        }

        return DialogService.CloseAsync(sessionId);
    }

    private string? ResolveAgentName()
        => Agent is null
            ? null
            : string.IsNullOrWhiteSpace(Agent.Name) ? ResolveAgentRole(Agent) : Agent.Name;

    private static string ResolveAgentRole(AgentDefinition agent)
        => string.IsNullOrWhiteSpace(agent.RoleTitle) ? "Technical agent" : agent.RoleTitle;
}

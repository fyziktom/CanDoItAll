@inject DialogService DialogService

<WorkspacePanel Class="flex h-full min-h-0 flex-col overflow-hidden"
                data-testid="chat-workspace-panel">
    <div class="chat-panel-header">
        <div class="chat-panel-header__row">
            <div class="chat-panel-header__identity">
                <Avatar Alt="@ResolveAvatarAlt()"
                        ImageUrl="@Agent?.AvatarImageUrl"
                        FallbackText="@ResolveAvatarFallbackText()"
                        DefaultImageSeed="@ResolveAvatarSeed()"
                        Size="AvatarSize.Medium"
                        Shape="AvatarShape.Rounded" />

                <div class="chat-panel-header__main">
                    <div class="chat-panel-header__meta">
                        <StatusBadge Tone="@ResolveSessionTone()" Text="@ResolveSessionBadge()" />
                        @if (!string.IsNullOrWhiteSpace(RunStateText))
                        {
                            <StatusBadge Tone="@RunStateTone"
                                         Text="@RunStateText"
                                         data-testid="agent-chat-run-state" />
                        }
                        @if (IsAutoApprovalActive())
                        {
                            <StatusBadge Tone="success" Text="@ResolveAutoApproveBadgeText()" />
                        }
                        @if (Session is not null)
                        {
                            <StatusBadge Tone="neutral" Text="@($"{Session.Messages.Count} messages")" />
                        }
                        @if (HasPendingApprovals)
                        {
                            <StatusBadge Tone="warning" Text="@($"{PendingApprovals.Count} approvals")" />
                        }
                        @if (IsVoiceModeEnabled)
                        {
                            <StatusBadge Tone="primary" Text="Audio mode" />
                        }
                        @if (Session is not null)
                        {
                            <StatusBadge Tone="primary" Text="@Session.UpdatedAtUtc.LocalDateTime.ToString("g")"/>
                        }
                    </div>

                    <div class="chat-panel-header__title-row">
                        @if (Session is null)
                        {
                            <p class="chat-panel-header__empty-title">Select or create a thread</p>
                        }
                        else
                        {
                            <Editable TItem="EditableThreadTitleModel"
                                      Item="@titleEditor"
                                      ItemChanged="HandleSessionTitleChangedAsync"
                                      ParameterName="@nameof(EditableThreadTitleModel.Title)"
                                      Placeholder="Thread title"
                                      EmptyText="Untitled thread"
                                      Class="chat-thread-title-edit" />
                        }
                    </div>
                </div>
            </div>

            @if (HeaderActions is not null)
            {
                <div class="chat-panel-header__actions">
                    @HeaderActions
                </div>
            }
        </div>
    </div>

    <div class="chat-conversation-flow" style="scrollbar-gutter:stable;">
        @{
            var hasMessages = Session?.Messages.Count > 0;
            var hasPendingApprovals = HasPendingApprovals;
            var hasPendingPrompt = !string.IsNullOrWhiteSpace(PendingUserPrompt);
            var executionEntries = ResolveActiveExecutionEntries();
            var hasExecutionStream = executionEntries.Count > 0;
            var shouldCollapseExecutionStream = hasExecutionStream && ShouldCollapseExecutionStream(executionEntries);
            var visibleExecutionEntries = shouldCollapseExecutionStream
                ? Array.Empty<ExecutionLogEntry>()
                : ResolveVisibleExecutionEntries(executionEntries);
        }

        @if (Session is null && !hasPendingPrompt)
        {
            <EmptyState Eyebrow="Conversation"
                        Title="Nothing is open in the center panel"
                        Description="Choose a thread from the left rail or create a new one to keep the active transcript in view." />
        }
        else if (!hasMessages && !hasPendingApprovals && !hasPendingPrompt && !hasExecutionStream)
        {
            <EmptyState Eyebrow="Conversation"
                        Title="This thread is ready for the first prompt"
                        Description="Use the composer below to ask for a plan, a status update, or an actual working answer from the selected agent." />
        }
        else
        {
            <Stack GapScale="LayoutGap.Medium">
                @foreach (var message in Session?.Messages.OrderBy(item => item.CreatedAtUtc) ?? Enumerable.Empty<ChatMessageRecord>())
                {
                    var isUserMessage = message.Role == ChatMessageRole.User;
                    var userMessageDisplay = isUserMessage
                        ? ResolveUserMessageDisplay(message.Content)
                        : null;

                    <div class="flex @(isUserMessage ? "justify-end" : "justify-start")">
                        <div class="flex max-w-[44rem] flex-col gap-2 @(isUserMessage ? "items-end" : "items-start")">
                            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                @if (!isUserMessage)
                                {
                                    <Avatar Alt="@ResolveAvatarAlt()"
                                            ImageUrl="@Agent?.AvatarImageUrl"
                                            FallbackText="@ResolveAvatarFallbackText()"
                                            DefaultImageSeed="@ResolveAvatarSeed()"
                                            Size="AvatarSize.Small"
                                            Shape="AvatarShape.Rounded" />
                                }

                                <StatusBadge Tone="@ResolveRoleTone(message.Role)" Text="@message.Role.ToString()" />
                                <TextBlock TextStyle="TextStyle.Caption" Value="@message.CreatedAtUtc.LocalDateTime.ToString("g")" />
                            </Cluster>

                            <div class="chat-message-bubble rounded-[1.4rem] border px-4 py-3.5 shadow-sm @(ResolveBubbleClass(isUserMessage))">
                                @if (isUserMessage && userMessageDisplay is not null)
                                {
                                    <p class="text-sm leading-6">@userMessageDisplay.VisibleContent</p>
                                    @if (!string.IsNullOrWhiteSpace(userMessageDisplay.HiddenContext))
                                    {
                                        <details class="chat-message-context chat-message-context--user" data-testid="chat-message-hidden-context">
                                            <summary>...more</summary>
                                            <pre>@userMessageDisplay.HiddenContext</pre>
                                        </details>
                                    }
                                }
                                else
                                {
                                    <div class="chat-markdown text-sm leading-6">@RenderAssistantMessage(message.Content)</div>
                                }

                                <div class="chat-message-footer">
                                    <span class="chat-message-footer-meta">
                                        @if (message.TokenEstimate > 0)
                                        {
                                            <span class="text-xs @(isUserMessage ? "text-white/70" : "text-slate-400")">~@message.TokenEstimate tokens</span>
                                        }
                                    </span>

                                    <CopyButton Value="@message.Content"
                                                Disabled="@string.IsNullOrWhiteSpace(message.Content)"
                                                DisplayMode="CopyButtonDisplayMode.IconOnly"
                                                Size="CopyButtonSize.ExtraSmall"
                                                AriaLabel="@(isUserMessage ? "Copy user message" : "Copy assistant message")"
                                                Class="@(isUserMessage ? "chat-message-copy chat-message-copy--user" : "chat-message-copy")" />
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @if (hasExecutionStream)
                {
                    <div class="agent-execution-stream" data-testid="chat-execution-stream">
                        @if (shouldCollapseExecutionStream)
                        {
                            <button type="button"
                                    class="agent-execution-stream__summary"
                                    @onclick="@(() => OpenExecutionHistoryDialogAsync(executionEntries))"
                                    data-testid="chat-execution-summary">
                                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                    <StatusBadge Tone="@ResolveExecutionTone(ResolveLatestExecutionState(executionEntries))"
                                                 Text="@BuildWorkedForLabel(executionEntries)" />
                                    <StatusBadge Tone="neutral" Text="@($"{executionEntries.Count} steps")" />
                                    <TextBlock TextStyle="TextStyle.Caption"
                                               Value="@BuildEntryPreview(executionEntries[^1])" />
                                </Cluster>
                            </button>
                        }
                        else
                        {
                            @foreach (var entry in visibleExecutionEntries)
                            {
                                <button type="button"
                                        class="agent-execution-stream__item"
                                        @onclick="@(() => OpenExecutionEntryDialogAsync(entry))"
                                        data-testid="chat-execution-entry">
                                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                        <StatusBadge Tone="@ResolveExecutionTone(entry.State)" Text="@entry.State.ToString()" />
                                        <span class="agent-execution-stream__phase">@entry.Phase</span>
                                        <span class="agent-execution-stream__time">@entry.CreatedAtUtc.LocalDateTime.ToString("t")</span>
                                    </Cluster>
                                    <span class="agent-execution-stream__preview">@BuildEntryPreview(entry)</span>
                                </button>
                            }

                            @if (executionEntries.Count > visibleExecutionEntries.Count)
                            {
                                <button type="button"
                                        class="agent-execution-stream__history"
                                        @onclick="@(() => OpenExecutionHistoryDialogAsync(executionEntries))"
                                        data-testid="chat-execution-history">
                                    View @executionEntries.Count work steps...
                                </button>
                            }
                        }
                    </div>
                }

                @if (hasPendingPrompt)
                {
                    var pendingUserMessageDisplay = ResolveUserMessageDisplay(PendingUserPrompt);

                    <div class="flex justify-end">
                        <div class="flex max-w-[44rem] flex-col items-end gap-2">
                            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                <StatusBadge Tone="info" Text="User" />
                                <StatusBadge Tone="neutral" Text="Sending..." />
                                <TextBlock TextStyle="TextStyle.Caption" Value="@DateTime.Now.ToString("g")" />
                            </Cluster>

                            <div class="rounded-[1.4rem] border border-slate-900 bg-slate-900 px-4 py-3.5 text-white shadow-sm opacity-90">
                                <p class="text-sm leading-6">@pendingUserMessageDisplay.VisibleContent</p>
                                @if (!string.IsNullOrWhiteSpace(pendingUserMessageDisplay.HiddenContext))
                                {
                                    <details class="chat-message-context chat-message-context--user" data-testid="chat-pending-hidden-context">
                                        <summary>...more</summary>
                                        <pre>@pendingUserMessageDisplay.HiddenContext</pre>
                                    </details>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (HasPendingApprovals)
                {
                    <div class="rounded-[1.5rem] border border-amber-200 bg-amber-50/80 p-4">
                        <Stack GapScale="LayoutGap.Medium">
                            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                <StatusBadge Tone="warning" Text="Approval required" />
                                <TextBlock TextStyle="TextStyle.Body2"
                                           Value="The agent is waiting on tool approval before the thread can continue." />
                            </Cluster>

                            @foreach (var approval in PendingApprovals)
                            {
                                var approvalId = approval.ApprovalId;
                                var argumentSummary = FormatApprovalArguments(approval.ArgumentsJson);
                                <div class="rounded-[1.2rem] border border-amber-200 bg-white px-4 py-3">
                                    <Stack GapScale="LayoutGap.Small">
                                        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                            <StatusBadge Tone="info" Text="@approval.ToolKind" />
                                            <TextBlock TextStyle="TextStyle.Subtitle2" Value="@approval.ToolName" />
                                            @if (TryGetApprovalChoice(approvalId, out var choice))
                                            {
                                                <StatusBadge Tone="@(choice ? "success" : "warning")"
                                                             Text="@(choice ? "Will approve" : "Will reject")" />
                                            }
                                        </Cluster>

                                        @if (!string.IsNullOrWhiteSpace(approval.Details))
                                        {
                                            <TextBlock TextStyle="TextStyle.Body2" Value="@approval.Details" />
                                        }

                                        @if (!string.IsNullOrWhiteSpace(argumentSummary))
                                        {
                                            <TextBlock TextStyle="TextStyle.Caption" Value="@argumentSummary" />
                                        }

                                        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                            <Button Text="Approve"
                                                    ButtonStyle="@(IsApprovalChoice(approvalId, true) ? ButtonStyle.Primary : ButtonStyle.Light)"
                                                    Size="ButtonSize.Small"
                                                    Disabled="@IsBusy"
                                                    Click="@(() => SetApprovalChoice(approvalId, true))"
                                                    data-testid="@($"chat-approval-approve-{approvalId}")" />
                                            <Button Text="Reject"
                                                    ButtonStyle="@(IsApprovalChoice(approvalId, false) ? ButtonStyle.Primary : ButtonStyle.Light)"
                                                    Size="ButtonSize.Small"
                                                    Disabled="@IsBusy"
                                                    Click="@(() => SetApprovalChoice(approvalId, false))"
                                                    data-testid="@($"chat-approval-reject-{approvalId}")" />
                                        </Cluster>
                                    </Stack>
                                </div>
                            }

                            @if (PendingApprovals.Count > 1)
                            {
                                <Button Text="Submit decisions"
                                        Disabled="@(IsBusy || !AllApprovalChoicesMade)"
                                        IsBusy="@IsBusy"
                                        Click="SubmitApprovalChoicesAsync"
                                        data-testid="chat-submit-approval-decisions-button" />
                            }
                        </Stack>
                    </div>
                }
            </Stack>
        }
    </div>

    @if (ActivityStreamId is not null)
    {
        <AgentExecutionActivityStatus @key="ActivityStreamId"
                                      StreamId="@ActivityStreamId" />
    }

    <div class="chat-composer-panel">
        <FormField>
            <div class="chat-composer">
                <ChatPromptTextArea @key="ComposerKey"
                                    Value="@DraftPrompt"
                                    ValueChanged="HandleDraftChanged"
                                    Rows="2"
                                    Placeholder="Ask for a plan, a diagnosis, or a concrete next step."
                                    class="chat-composer__textarea"
                                    data-testid="chat-prompt-input" />
                <div class="chat-composer__tools">
                    @ComposerActions
                    @if (AttachmentFilesSelected.HasDelegate)
                    {
                        <label for="@ResolveAttachmentInputId()"
                               class="@ResolveAttachmentUploadButtonClass()"
                               aria-label="Attach image file"
                               aria-disabled="@IsBusy"
                               title="Attach image file"
                               data-testid="chat-image-attachment-button">
                            <Icon Name="image" />
                        </label>
                        <InputFile id="@attachmentInputId"
                                   class="chat-attachment-file-input"
                                   style="display:none"
                                   OnChange="HandleAttachmentFilesSelectedAsync"
                                   accept="image/png,image/jpeg,image/gif,image/webp"
                                   multiple
                                   disabled="@IsBusy"
                                   data-testid="chat-image-attachment-input" />
                    }
                    <Button Icon="add"
                            ButtonStyle="ButtonStyle.Light"
                            Size="ButtonSize.Small"
                            Disabled="@IsBusy"
                            Class="chat-composer__icon-button"
                            Click="@(async () => await AttachmentRequested.InvokeAsync())"
                            aria-label="Attach workspace artifact"
                            title="Attach workspace artifact"
                            data-testid="chat-attachment-button" />
                    <Button Icon="send"
                            ButtonStyle="ButtonStyle.Light"
                            Size="ButtonSize.Small"
                            Disabled="@(IsBusy || HasPendingApprovals)"
                            IsBusy="@IsBusy"
                            Class="chat-composer__icon-button"
                            Click="@(async () => await SendRequested.InvokeAsync())"
                            aria-label="Send prompt"
                            title="Send prompt"
                            data-testid="chat-send-button" />
                    <Button Icon="@(IsVoiceRecording ? "stop" : "mic")"
                            ButtonStyle="@(IsVoiceModeEnabled ? ButtonStyle.Primary : ButtonStyle.Light)"
                            Size="ButtonSize.Small"
                            Disabled="@(!CanUseVoiceMode || IsBusy || IsVoiceTranscribing || HasPendingApprovals)"
                            IsBusy="@IsVoiceTranscribing"
                            Class="chat-composer__icon-button"
                            Click="ToggleVoiceRecordingAsync"
                            aria-label="@ResolveVoiceRecordingLabel()"
                            title="@ResolveVoiceRecordingLabel()"
                            data-testid="chat-voice-record-button" />
                    <Button Icon="volume_up"
                            ButtonStyle="ButtonStyle.Light"
                            Size="ButtonSize.Small"
                            Disabled="@(!CanUseVoiceMode || IsBusy || IsVoiceSpeaking)"
                            IsBusy="@IsVoiceSpeaking"
                            Class="chat-composer__icon-button"
                            Click="@(async () => await SpeakLatestAssistantMessageRequested.InvokeAsync())"
                            aria-label="Speak latest assistant message"
                            title="Speak latest assistant message"
                            data-testid="chat-voice-speak-button" />
                    <Button Icon="hearing"
                            ButtonStyle="@(IsVoiceModeEnabled ? ButtonStyle.Primary : ButtonStyle.Light)"
                            Size="ButtonSize.Small"
                            Disabled="@(!CanUseVoiceMode || IsBusy)"
                            Class="chat-composer__icon-button"
                            Click="ToggleVoiceModeAsync"
                            aria-label="Toggle audio mode"
                            title="Toggle audio mode"
                            data-testid="chat-voice-mode-button" />
                </div>
            </div>
        </FormField>

        @if (DraftAttachmentPaths.Count > 0)
        {
            <div class="mt-4 rounded-[1.35rem] border border-emerald-200 bg-emerald-50/80 px-4 py-3">
                <Stack GapScale="LayoutGap.Small">
                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                        <StatusBadge Tone="success" Text="@($"{DraftAttachmentPaths.Count} staged")" />
                        <TextBlock TextStyle="TextStyle.Body2"
                                   Value="These files are queued for the next prompt and their workspace paths will be included automatically." />
                    </Cluster>

                    @foreach (var attachmentPath in DraftAttachmentPaths)
                    {
                        <div class="flex items-start justify-between gap-3 rounded-[1rem] border border-emerald-200 bg-white/75 px-3 py-2">
                            <p class="min-w-0 flex-1 text-sm leading-6 text-slate-700" style="overflow-wrap:anywhere;">@attachmentPath</p>
                            <CopyButton Value="@attachmentPath"
                                        DisplayMode="CopyButtonDisplayMode.IconOnly"
                                        Size="CopyButtonSize.ExtraSmall"
                                        AriaLabel="Copy staged attachment path" />
                        </div>
                    }
                </Stack>
            </div>
        }

        @if (ShouldRenderComposerStatusRow())
        {
            <div class="chat-composer-status">
            <TextBlock TextStyle="TextStyle.Eyebrow"
                       Value="@ResolveComposerGuidance()" />

            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                @if (!string.IsNullOrWhiteSpace(VoiceStatusText))
                {
                    <StatusBadge Tone="@VoiceStatusTone" Text="@VoiceStatusText" />
                }
                @if (HasPendingApprovals)
                {
                    @if (!IsAutoApprovalActive())
                    {
                        <Button Text="Approve remaining in this run"
                                Disabled="@IsBusy"
                                IsBusy="@IsBusy"
                                Click="@(async () => await ApprovalDecisionForConversationRequested.InvokeAsync())"
                                data-testid="chat-approve-conversation-button" />
                    }
                    <Button Text="@(PendingApprovals.Count > 1 ? "Approve all once" : "Approve once")"
                            ButtonStyle="ButtonStyle.Light"
                            Disabled="@IsBusy"
                            IsBusy="@IsBusy"
                            Click="@(() => SubmitUniformDecisionAsync(true))"
                            data-testid="chat-approve-once-button" />
                    <Button Text="@(PendingApprovals.Count > 1 ? "Reject all and continue" : "Reject and continue")"
                            ButtonStyle="ButtonStyle.Light"
                            Disabled="@IsBusy"
                            Click="@(() => SubmitUniformDecisionAsync(false))"
                            data-testid="chat-reject-button" />
                }
            </Cluster>
            </div>
        }
    </div>
</WorkspacePanel>

@code {
    private static MarkupString RenderAssistantMessage(string? content)
        => new(ChatMarkdownRenderer.RenderHtml(content));

    private const string UserRequestMarker = "User request:";

    [Parameter]
    public AgentDefinition? Agent { get; set; }

    [Parameter]
    public ChatSessionRecord? Session { get; set; }

    [Parameter]
    public ExecutionRunRecord? ActiveRun { get; set; }

    [Parameter]
    public IReadOnlyList<ExecutionLogEntry> ExecutionLog { get; set; } = [];

    [Parameter]
    public required string DraftPrompt { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public int ComposerKey { get; set; }

    [Parameter]
    public string RunStateText { get; set; } = string.Empty;

    [Parameter]
    public string RunStateTone { get; set; } = "neutral";

    [Parameter]
    public string PendingUserPrompt { get; set; } = string.Empty;

    [Parameter]
    public AgentExecutionActivityStreamId? ActivityStreamId { get; set; }

    [Parameter]
    public IReadOnlyList<string> DraftAttachmentPaths { get; set; } = [];

    [Parameter]
    public RenderFragment? HeaderActions { get; set; }

    [Parameter]
    public RenderFragment? ComposerActions { get; set; }

    [Parameter]
    public bool CanUseVoiceMode { get; set; }

    [Parameter]
    public bool IsVoiceModeEnabled { get; set; }

    [Parameter]
    public bool IsVoiceRecording { get; set; }

    [Parameter]
    public bool IsVoiceTranscribing { get; set; }

    [Parameter]
    public bool IsVoiceSpeaking { get; set; }

    [Parameter]
    public string VoiceStatusText { get; set; } = string.Empty;

    [Parameter]
    public string VoiceStatusTone { get; set; } = "neutral";

    [Parameter]
    public EventCallback<string> DraftPromptChanged { get; set; }

    [Parameter]
    public EventCallback SendRequested { get; set; }

    /// <summary>
    /// Emits one explicit decision per pending approval (exact coverage). The
    /// host submits the list unchanged; no bool is expanded across proposals.
    /// </summary>
    [Parameter]
    public EventCallback<IReadOnlyList<PendingToolApprovalDecision>> ApprovalDecisionsRequested { get; set; }

    [Parameter]
    public EventCallback ApprovalDecisionForConversationRequested { get; set; }

    [Parameter]
    public EventCallback AttachmentRequested { get; set; }

    [Parameter]
    public EventCallback<InputFileChangeEventArgs> AttachmentFilesSelected { get; set; }

    [Parameter]
    public EventCallback<string> SessionTitleChanged { get; set; }

    [Parameter]
    public EventCallback<bool> VoiceModeChanged { get; set; }

    [Parameter]
    public EventCallback VoiceRecordingToggled { get; set; }

    [Parameter]
    public EventCallback SpeakLatestAssistantMessageRequested { get; set; }

    private IReadOnlyList<PendingToolApprovalRecord> PendingApprovals
        => ActiveRun?.PendingApprovals ?? [];

    private bool HasPendingApprovals => PendingApprovals.Count > 0;

    private readonly Dictionary<string, bool> approvalChoices = new(StringComparer.Ordinal);

    private bool AllApprovalChoicesMade =>
        PendingApprovals.Count > 0 &&
        PendingApprovals.All(approval => approvalChoices.ContainsKey(approval.ApprovalId));

    private bool TryGetApprovalChoice(string approvalId, out bool approved)
        => approvalChoices.TryGetValue(approvalId, out approved);

    private bool IsApprovalChoice(string approvalId, bool approved)
        => approvalChoices.TryGetValue(approvalId, out var choice) && choice == approved;

    private Task SetApprovalChoice(string approvalId, bool approved)
    {
        approvalChoices[approvalId] = approved;
        // A single pending approval needs no separate submit step — the
        // explicit per-proposal choice is already the complete decision set.
        return PendingApprovals.Count == 1 && AllApprovalChoicesMade
            ? SubmitApprovalChoicesAsync()
            : Task.CompletedTask;
    }

    private Task SubmitApprovalChoicesAsync()
    {
        if (!AllApprovalChoicesMade)
        {
            return Task.CompletedTask;
        }

        var decisions = PendingApprovals
            .Select(approval => new PendingToolApprovalDecision(
                approval.ApprovalId,
                approvalChoices[approval.ApprovalId]))
            .ToArray();
        return ApprovalDecisionsRequested.InvokeAsync(decisions);
    }

    private Task SubmitUniformDecisionAsync(bool approved)
    {
        // Explicit whole-set action: the user chose to apply one decision to
        // every pending proposal.
        var decisions = PendingApprovals
            .Select(approval => new PendingToolApprovalDecision(approval.ApprovalId, approved))
            .ToArray();
        return decisions.Length == 0
            ? Task.CompletedTask
            : ApprovalDecisionsRequested.InvokeAsync(decisions);
    }

    private void PruneStaleApprovalChoices()
    {
        if (approvalChoices.Count == 0)
        {
            return;
        }

        var pendingIds = PendingApprovals
            .Select(approval => approval.ApprovalId)
            .ToHashSet(StringComparer.Ordinal);
        foreach (var staleId in approvalChoices.Keys.Where(id => !pendingIds.Contains(id)).ToList())
        {
            approvalChoices.Remove(staleId);
        }
    }

    /// <summary>
    /// Display-safe projection of the proposal's arguments: values for
    /// sensitive-looking keys are masked and long values are truncated, so the
    /// user sees exactly which tool and targets are requested without the raw
    /// argument payload leaking secrets into the UI.
    /// </summary>
    internal static string FormatApprovalArguments(string? argumentsJson)
    {
        if (string.IsNullOrWhiteSpace(argumentsJson) || argumentsJson.Trim() == "{}")
        {
            return string.Empty;
        }

        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(argumentsJson);
            if (document.RootElement.ValueKind != System.Text.Json.JsonValueKind.Object)
            {
                return string.Empty;
            }

            var parts = new List<string>();
            foreach (var property in document.RootElement.EnumerateObject())
            {
                parts.Add($"{property.Name}: {FormatApprovalArgumentValue(property.Name, property.Value)}");
            }

            return string.Join(" · ", parts);
        }
        catch (System.Text.Json.JsonException)
        {
            return string.Empty;
        }
    }

    private static readonly string[] SensitiveArgumentKeyMarkers =
    [
        "secret",
        "token",
        "password",
        "credential",
        "apikey",
        "api_key",
        "authorization",
        "connectionstring"
    ];

    private static string FormatApprovalArgumentValue(string key, System.Text.Json.JsonElement value)
    {
        if (SensitiveArgumentKeyMarkers.Any(marker =>
                key.Contains(marker, StringComparison.OrdinalIgnoreCase)))
        {
            return "•••";
        }

        var text = value.ValueKind switch
        {
            System.Text.Json.JsonValueKind.String => value.GetString() ?? string.Empty,
            System.Text.Json.JsonValueKind.Number or
            System.Text.Json.JsonValueKind.True or
            System.Text.Json.JsonValueKind.False => value.GetRawText(),
            System.Text.Json.JsonValueKind.Null => "null",
            _ => $"({value.ValueKind.ToString().ToLowerInvariant()})"
        };
        const int maximumDisplayLength = 160;
        return text.Length <= maximumDisplayLength
            ? text
            : $"{text[..maximumDisplayLength]}… ({text.Length} chars)";
    }
    private readonly EditableThreadTitleModel titleEditor = new();
    private readonly string attachmentInputId = $"chat-attachment-file-input-{Guid.NewGuid():N}";
    private Guid? titleEditorSessionId;
    private string titleEditorSessionTitle = string.Empty;

    protected override void OnParametersSet()
    {
        PruneStaleApprovalChoices();
        if (Session is null)
        {
            titleEditorSessionId = null;
            titleEditorSessionTitle = string.Empty;
            titleEditor.Title = string.Empty;
            return;
        }

        if (titleEditorSessionId == Session.Id &&
            string.Equals(titleEditorSessionTitle, Session.Title, StringComparison.Ordinal))
        {
            return;
        }

        titleEditorSessionId = Session.Id;
        titleEditorSessionTitle = Session.Title;
        titleEditor.Title = Session.Title;
    }

    private Task HandleDraftChanged(string? value)
        => DraftPromptChanged.InvokeAsync(value ?? string.Empty);

    private Task HandleAttachmentFilesSelectedAsync(InputFileChangeEventArgs args)
        => AttachmentFilesSelected.InvokeAsync(args);

    private string ResolveAttachmentInputId()
        => IsBusy ? string.Empty : attachmentInputId;

    private string ResolveAttachmentUploadButtonClass()
        => IsBusy
            ? "chat-attachment-upload-button chat-attachment-upload-button--disabled"
            : "chat-attachment-upload-button";

    private Task ToggleVoiceModeAsync()
        => VoiceModeChanged.InvokeAsync(!IsVoiceModeEnabled);

    private Task ToggleVoiceRecordingAsync()
        => VoiceRecordingToggled.InvokeAsync();

    private string ResolveVoiceRecordingLabel()
        => IsVoiceRecording ? "Stop voice recording" : "Start voice recording";

    private static UserMessageDisplay ResolveUserMessageDisplay(string? content)
    {
        var normalizedContent = content?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(normalizedContent))
        {
            return new UserMessageDisplay(string.Empty, null);
        }

        var markerIndex = normalizedContent.LastIndexOf(UserRequestMarker, StringComparison.OrdinalIgnoreCase);
        if (markerIndex < 0)
        {
            return new UserMessageDisplay(normalizedContent, null);
        }

        var visibleContent = normalizedContent[(markerIndex + UserRequestMarker.Length)..].Trim();
        if (string.IsNullOrWhiteSpace(visibleContent))
        {
            return new UserMessageDisplay(normalizedContent, null);
        }

        var hiddenContext = normalizedContent[..markerIndex].Trim();
        return new UserMessageDisplay(visibleContent, hiddenContext.Length == 0 ? null : hiddenContext);
    }

    private async Task HandleSessionTitleChangedAsync(EditableThreadTitleModel editor)
    {
        if (Session is null)
        {
            return;
        }

        var nextTitle = editor.Title.Trim();
        if (string.Equals(Session.Title, nextTitle, StringComparison.Ordinal))
        {
            return;
        }

        await SessionTitleChanged.InvokeAsync(nextTitle);
    }

    private IReadOnlyList<ExecutionLogEntry> ResolveActiveExecutionEntries()
    {
        if (ActiveRun is not null)
        {
            return ExecutionLog
                .Where(item => item.ExecutionRunId == ActiveRun.Id)
                .OrderBy(item => item.CreatedAtUtc)
                .ToList();
        }

        var latestRunId = ExecutionLog
            .OrderByDescending(item => item.CreatedAtUtc)
            .Select(item => item.ExecutionRunId)
            .FirstOrDefault();

        if (latestRunId == Guid.Empty)
        {
            return [];
        }

        return ExecutionLog
            .Where(item => item.ExecutionRunId == latestRunId)
            .OrderBy(item => item.CreatedAtUtc)
            .ToList();
    }

    private static IReadOnlyList<ExecutionLogEntry> ResolveVisibleExecutionEntries(
        IReadOnlyList<ExecutionLogEntry> entries)
    {
        const int visibleEntryCount = 6;

        return entries
            .TakeLast(visibleEntryCount)
            .ToList();
    }

    private bool ShouldCollapseExecutionStream(IReadOnlyList<ExecutionLogEntry> entries)
    {
        var latestState = ResolveLatestExecutionState(entries);

        return ActiveRun?.State is ExecutionState.Completed or ExecutionState.Failed ||
               latestState is ExecutionState.Completed or ExecutionState.Failed;
    }

    private static ExecutionState ResolveLatestExecutionState(IReadOnlyList<ExecutionLogEntry> entries)
        => entries.Count == 0 ? ExecutionState.Idle : entries[^1].State;

    private string BuildWorkedForLabel(IReadOnlyList<ExecutionLogEntry> entries)
    {
        if (entries.Count == 0)
        {
            return "Worked";
        }

        var startedAtUtc = ActiveRun?.StartedAtUtc ?? ActiveRun?.CreatedAtUtc ?? entries[0].CreatedAtUtc;
        var completedAtUtc = ActiveRun?.CompletedAtUtc ?? entries[^1].CreatedAtUtc;
        var duration = completedAtUtc - startedAtUtc;
        if (duration < TimeSpan.Zero)
        {
            duration = TimeSpan.Zero;
        }

        return $"Worked for {FormatDuration(duration)}";
    }

    private static string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalHours >= 1)
        {
            return $"{(int)duration.TotalHours}h {duration.Minutes:D2}m";
        }

        if (duration.TotalMinutes >= 1)
        {
            return $"{(int)duration.TotalMinutes}m {duration.Seconds:D2}s";
        }

        return $"{Math.Max(1, (int)Math.Ceiling(duration.TotalSeconds))}s";
    }

    private static string BuildEntryPreview(ExecutionLogEntry entry)
    {
        var summary = NormalizeInlineText($"{entry.Phase}. {entry.Message}");
        var preview = TakeFirstSentences(summary, maxSentences: 2);
        const int maxLength = 190;

        if (preview.Length > maxLength)
        {
            preview = preview[..maxLength].TrimEnd();
        }

        preview = preview.TrimEnd('.', ',', ';', ':', '!', '?', ' ');
        return string.IsNullOrWhiteSpace(preview)
            ? $"{entry.State}..."
            : $"{preview}...";
    }

    private static string NormalizeInlineText(string value)
    {
        return string.Join(
            ' ',
            value.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
    }

    private static string TakeFirstSentences(string value, int maxSentences)
    {
        var sentenceCount = 0;
        for (var index = 0; index < value.Length; index++)
        {
            if (value[index] is not ('.' or '!' or '?'))
            {
                continue;
            }

            sentenceCount++;
            if (sentenceCount >= maxSentences)
            {
                return value[..(index + 1)];
            }
        }

        return value;
    }

    private Task OpenExecutionEntryDialogAsync(ExecutionLogEntry entry)
    {
        var entries = ResolveActiveExecutionEntries();
        if (entries.Count == 0)
        {
            entries = [entry];
        }

        OpenExecutionDialog(
            title: entry.Phase,
            entries,
            highlightEntryId: entry.Id,
            size: ModalSize.Wide);

        return Task.CompletedTask;
    }

    private Task OpenExecutionHistoryDialogAsync(IReadOnlyList<ExecutionLogEntry> entries)
    {
        OpenExecutionDialog(
            title: "Agent work history",
            entries,
            highlightEntryId: null,
            size: ModalSize.Full);

        return Task.CompletedTask;
    }

    private void OpenExecutionDialog(
        string title,
        IReadOnlyList<ExecutionLogEntry> entries,
        Guid? highlightEntryId,
        ModalSize size)
    {
        _ = DialogService.OpenAsync<AgentExecutionLogDialog>(
            title,
            new Dictionary<string, object?>
            {
                [nameof(AgentExecutionLogDialog.Run)] = ActiveRun,
                [nameof(AgentExecutionLogDialog.Entries)] = entries,
                [nameof(AgentExecutionLogDialog.HighlightEntryId)] = highlightEntryId
            },
            new DialogOptions
            {
                Eyebrow = "Agent work",
                Subtitle = BuildExecutionDialogSubtitle(entries),
                Size = size,
                DenseChrome = true,
                TestId = "agent-execution-log-dialog",
                AriaLabel = title,
                Style = "max-height:calc(100vh - 2rem);"
            });
    }

    private string BuildExecutionDialogSubtitle(IReadOnlyList<ExecutionLogEntry> entries)
    {
        if (entries.Count == 0)
        {
            return "No execution steps are available for the selected run.";
        }

        return $"{entries.Count} step(s) captured from {entries[0].CreatedAtUtc.LocalDateTime:g} to {entries[^1].CreatedAtUtc.LocalDateTime:g}.";
    }

    private string ResolveHeaderSummary()
    {
        if (Agent is null)
        {
            return "Select an agent on the right to make the center panel conversational again.";
        }

        if (!string.IsNullOrWhiteSpace(Agent.Summary))
        {
            return Agent.Summary;
        }

        return "Keep the active transcript visible here while the side rails handle thread switching and agent changes.";
    }

    private string ResolveComposerGuidance()
    {
        if (HasPendingApprovals)
        {
            return IsAutoApprovalActive()
                ? "A pending tool call still needs confirmation once, then the active run policy will keep the remaining approvals moving."
                : "Approve once, approve the rest of this run, or reject before sending the next prompt.";
        }

        if (ActiveRun?.AutoApprovePendingToolCalls == true)
        {
            return "The active run is allowed to auto-approve its remaining tool calls.";
        }

        if (Agent?.Permissions.AutoApproveExternalCallsByDefault == true)
        {
            return "This agent auto-approves external tool calls by default.";
        }

        return "Keep the next prompt focused so the transcript stays easy to scan.";
    }

    private bool ShouldRenderComposerStatusRow()
        => HasPendingApprovals ||
           !string.IsNullOrWhiteSpace(VoiceStatusText);

    private string ResolveSessionBadge()
    {
        if (Session is null)
        {
            return "Idle";
        }

        if (HasPendingApprovals)
        {
            return "Waiting";
        }

        return Session.Messages.Count == 0 ? "Ready" : "Active";
    }

    private string ResolveSessionTone()
    {
        if (Session is null)
        {
            return "neutral";
        }

        return HasPendingApprovals ? "warning" : "info";
    }

    private bool IsAutoApprovalActive()
        => ActiveRun?.AutoApprovePendingToolCalls == true || Agent?.Permissions.AutoApproveExternalCallsByDefault == true;

    private string ResolveAutoApproveBadgeText()
        => ActiveRun?.AutoApprovePendingToolCalls == true ? "Run Auto Approve" : "Auto Approve";

    private string ResolveAvatarAlt()
        => Agent?.Name ?? "Selected agent";

    private string ResolveAvatarFallbackText()
        => BuildInitials(ResolveAvatarSeed());

    private string ResolveAvatarSeed()
    {
        if (!string.IsNullOrWhiteSpace(Agent?.Name))
        {
            return Agent.Name;
        }

        if (!string.IsNullOrWhiteSpace(Agent?.RoleTitle))
        {
            return Agent.RoleTitle;
        }

        return "Sandbox Agent";
    }

    private static string ResolveRoleTone(ChatMessageRole role)
    {
        return role switch
        {
            ChatMessageRole.Assistant => "success",
            ChatMessageRole.User => "info",
            _ => "neutral"
        };
    }

    private static string ResolveExecutionTone(ExecutionState state)
    {
        return state switch
        {
            ExecutionState.Completed => "success",
            ExecutionState.WaitingOnTool => "warning",
            ExecutionState.Failed => "danger",
            ExecutionState.Running or ExecutionState.Preparing or ExecutionState.Persisting => "info",
            _ => "neutral"
        };
    }

    private static string ResolveBubbleClass(bool isUserMessage)
        => isUserMessage
            ? "border-slate-900 bg-slate-900 text-white"
            : "border-slate-200 bg-slate-50 text-slate-700";

    private static string BuildInitials(string value)
    {
        var segments = value
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Take(2)
            .ToList();

        if (segments.Count == 0)
        {
            return "AG";
        }

        return string.Concat(segments.Select(segment => char.ToUpperInvariant(segment[0])));
    }


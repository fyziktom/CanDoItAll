@using System.Collections.Immutable
@using CanDoItAll.AgentFramework.UI.Chat
@inject DialogService DialogService
@inject AgentToolPolicyCatalog ToolPolicies
@implements IDisposable

<AgentChatSurface Presentation="@MapPresentation()" Intent="HandleIntentAsync" Navigation="@Navigation" NavigationIntent="@NavigationIntent"
                  HeaderActions="@HeaderActions" ComposerActions="@ComposerActions">
    <ActivityContent>
        @if (ActivityStreamId is not null) {
            <AgentExecutionActivityStatus @key="ActivityStreamId"
                                          StreamId="@ActivityStreamId" />
        }
    </ActivityContent>
    <AttachmentPicker>
                    @if (AttachmentFilesSelected.HasDelegate) {
                        <label for="@ResolveAttachmentInputId()"
                               class="@ResolveAttachmentUploadButtonClass()"
                               aria-label="Attach image file"
                               aria-disabled="@IsBusy"
                               title="Attach image file"
                               data-testid="chat-image-attachment-button">
                            <Icon Name="image" />
                        </label>
                        <InputFile id="@attachmentInputId"
                                   class="chat-attachment-file-input"
                                   style="display:none"
                                   OnChange="HandleAttachmentFilesSelectedAsync"
                                   accept="image/png,image/jpeg,image/gif,image/webp"
                                   multiple
                                   disabled="@IsBusy"
                                   data-testid="chat-image-attachment-input" />
                    }
    </AttachmentPicker>
</AgentChatSurface>

@code {
    [Parameter]
    public AgentDefinition? Agent { get; set; }

    [Parameter]
    public ChatSessionRecord? Session { get; set; }

    [Parameter]
    public ExecutionRunRecord? ActiveRun { get; set; }

    [Parameter]
    public IReadOnlyList<ExecutionLogEntry> ExecutionLog { get; set; } = [];

    [Parameter]
    public required string DraftPrompt { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public int ComposerKey { get; set; }

    [Parameter]
    public string RunStateText { get; set; } = string.Empty;

    [Parameter]
    public string RunStateTone { get; set; } = "neutral";

    [Parameter]
    public string PendingUserPrompt { get; set; } = string.Empty;

    [Parameter]
    public DateTimeOffset? PendingUserCreatedAtUtc { get; set; }

    private string observedPendingPrompt = string.Empty;
    private DateTimeOffset pendingCreatedAtUtc;

    [Parameter]
    public AgentExecutionActivityStreamId? ActivityStreamId { get; set; }

    [Parameter]
    public IReadOnlyList<string> DraftAttachmentPaths { get; set; } = [];

    [Parameter]
    public RenderFragment? HeaderActions { get; set; }

    [Parameter]
    public RenderFragment? ComposerActions { get; set; }

    [Parameter]
    public bool CanUseVoiceMode { get; set; }

    [Parameter]
    public bool IsVoiceModeEnabled { get; set; }

    [Parameter]
    public bool IsVoiceRecording { get; set; }

    [Parameter]
    public bool IsVoiceTranscribing { get; set; }

    [Parameter]
    public bool IsVoiceSpeaking { get; set; }

    [Parameter]
    public string VoiceStatusText { get; set; } = string.Empty;

    [Parameter]
    public string VoiceStatusTone { get; set; } = "neutral";

    [Parameter]
    public EventCallback<string> DraftPromptChanged { get; set; }

    [Parameter]
    public EventCallback SendRequested { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyList<PendingToolApprovalDecision>> ApprovalDecisionsRequested { get; set; }

    [Parameter]
    public EventCallback ApprovalDecisionForConversationRequested { get; set; }

    [Parameter]
    public EventCallback AttachmentRequested { get; set; }

    [Parameter]
    public EventCallback<InputFileChangeEventArgs> AttachmentFilesSelected { get; set; }

    [Parameter]
    public EventCallback<string> SessionTitleChanged { get; set; }

    [Parameter]
    public EventCallback<bool> VoiceModeChanged { get; set; }

    [Parameter]
    public EventCallback VoiceRecordingToggled { get; set; }

    [Parameter]
    public EventCallback SpeakLatestAssistantMessageRequested { get; set; }

    private ConversationHeaderPresentation HeaderPresentation
        => AgentConversationPresentationMapper.MapHeader(Agent, BuildHeaderBadges());

    private IReadOnlyList<ConversationMessagePresentation> MessagePresentations
        => AgentConversationPresentationMapper.MapMessages(
            Agent,
            Session?.Messages ?? []);

    private IReadOnlyList<ConversationMessagePresentation> TransientMessagePresentations
        => string.IsNullOrWhiteSpace(PendingUserPrompt)
            ? []
            : [AgentConversationPresentationMapper.MapPendingMessage(
                Agent,
                PendingUserPrompt,
                PendingUserCreatedAtUtc ?? pendingCreatedAtUtc)];

    private ConversationEmptyStatePresentation? TranscriptEmptyState {
        get {
            var hasPendingPrompt = !string.IsNullOrWhiteSpace(PendingUserPrompt);
            if (Session is null && !hasPendingPrompt) {
                return new(
                    "Conversation",
                    "Nothing is open in the center panel",
                    "Choose a thread from the left rail or create a new one to keep the active transcript in view.");
            }

            if (Session?.Messages.Count > 0 ||
                HasPendingApprovals ||
                hasPendingPrompt ||
                ResolveActiveExecutionEntries().Count > 0) {
                return null;
            }

            return new(
                "Conversation",
                "This thread is ready for the first prompt",
                "Use the composer below to ask for a plan, a status update, or an actual working answer from the selected agent.");
        }
    }

    private IReadOnlyList<PresentationBadge> BuildHeaderBadges() {
        var badges = new List<PresentationBadge> {
            new(ResolveSessionBadge(), AgentConversationPresentationMapper.MapTone(ResolveSessionTone()))
        };
        if (!string.IsNullOrWhiteSpace(RunStateText)) {
            badges.Add(new(
                RunStateText,
                AgentConversationPresentationMapper.MapTone(RunStateTone),
                testId: "agent-chat-run-state"));
        }

        if (IsAutoApprovalActive()) {
            badges.Add(new(ResolveAutoApproveBadgeText(), PresentationTone.Success));
        }

        if (Session is not null) {
            badges.Add(new($"{Session.Messages.Count} messages"));
        }

        if (HasPendingApprovals) {
            badges.Add(new($"{PendingApprovals.Count} approvals", PresentationTone.Warning));
        }

        if (IsVoiceModeEnabled) {
            badges.Add(new("Audio mode", PresentationTone.Accent));
        }

        if (Session is not null) {
            badges.Add(new(
                ChatPresentationTime.Format(Session.UpdatedAtUtc),
                PresentationTone.Accent));
        }

        return badges;
    }

    private IReadOnlyList<PendingToolApprovalRecord> PendingApprovals
        => ActiveRun?.PendingApprovals ?? [];

    private bool HasPendingApprovals => PendingApprovals.Count > 0;

    internal static string FormatApprovalArguments(string? argumentsJson, string? toolName = null, AgentToolPolicyCatalog? toolPolicies = null)
        => AgentToolArgumentDisplayFormatter.DescribeArguments(argumentsJson, toolName, toolPolicies);

    private Task HandleAttachmentFilesSelectedAsync(InputFileChangeEventArgs args)
        => AttachmentFilesSelected.InvokeAsync(args);

    private string ResolveAttachmentInputId()
        => IsBusy ? string.Empty : attachmentInputId;

    private string ResolveAttachmentUploadButtonClass()
        => IsBusy
            ? "chat-attachment-upload-button chat-attachment-upload-button--disabled"
            : "chat-attachment-upload-button";

    private IReadOnlyList<ExecutionLogEntry> ResolveActiveExecutionEntries() {
        if (ActiveRun is not null) {
            return ExecutionLog
                .Where(item => item.ExecutionRunId == ActiveRun.Id)
                .OrderBy(item => item.CreatedAtUtc)
                .ToList();
        }

        var latestRunId = ExecutionLog
            .OrderByDescending(item => item.CreatedAtUtc)
            .Select(item => item.ExecutionRunId)
            .FirstOrDefault();

        if (latestRunId == Guid.Empty) {
            return [];
        }

        return ExecutionLog
            .Where(item => item.ExecutionRunId == latestRunId)
            .OrderBy(item => item.CreatedAtUtc)
            .ToList();
    }

    private static IReadOnlyList<ExecutionLogEntry> ResolveVisibleExecutionEntries(
        IReadOnlyList<ExecutionLogEntry> entries) {
        const int visibleEntryCount = 6;

        return entries
            .TakeLast(visibleEntryCount)
            .ToList();
    }

    private bool ShouldCollapseExecutionStream(IReadOnlyList<ExecutionLogEntry> entries) {
        var latestState = ResolveLatestExecutionState(entries);

        return ActiveRun?.State is ExecutionState.Completed or ExecutionState.Failed ||
               latestState is ExecutionState.Completed or ExecutionState.Failed;
    }

    private static ExecutionState ResolveLatestExecutionState(IReadOnlyList<ExecutionLogEntry> entries)
        => entries.Count == 0 ? ExecutionState.Idle : entries[^1].State;

    private string BuildWorkedForLabel(IReadOnlyList<ExecutionLogEntry> entries) {
        if (entries.Count == 0) {
            return "Worked";
        }

        var startedAtUtc = ActiveRun?.StartedAtUtc ?? ActiveRun?.CreatedAtUtc ?? entries[0].CreatedAtUtc;
        var completedAtUtc = ActiveRun?.CompletedAtUtc ?? entries[^1].CreatedAtUtc;
        var duration = completedAtUtc - startedAtUtc;
        if (duration < TimeSpan.Zero) {
            duration = TimeSpan.Zero;
        }

        return $"Worked for {FormatDuration(duration)}";
    }

    private static string FormatDuration(TimeSpan duration) {
        if (duration.TotalHours >= 1) {
            return $"{(int)duration.TotalHours}h {duration.Minutes:D2}m";
        }

        if (duration.TotalMinutes >= 1) {
            return $"{(int)duration.TotalMinutes}m {duration.Seconds:D2}s";
        }

        return $"{Math.Max(1, (int)Math.Ceiling(duration.TotalSeconds))}s";
    }

    private static string BuildEntryPreview(ExecutionLogEntry entry) {
        var summary = NormalizeInlineText(AgentExecutionDisplayText.Format($"{entry.Phase}. {entry.Message}"));
        var preview = TakeFirstSentences(summary, maxSentences: 2);
        const int maxLength = 190;

        if (preview.Length > maxLength) {
            preview = preview[..maxLength].TrimEnd();
        }

        preview = preview.TrimEnd('.', ',', ';', ':', '!', '?', ' ');
        return string.IsNullOrWhiteSpace(preview)
            ? $"{entry.State}..."
            : $"{preview}...";
    }

    private static string NormalizeInlineText(string value) {
        return string.Join(
            ' ',
            value.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
    }

    private static string TakeFirstSentences(string value, int maxSentences) {
        var sentenceCount = 0;
        for (var index = 0; index < value.Length; index++) {
            if (value[index] is not ('.' or '!' or '?')) {
                continue;
            }

            sentenceCount++;
            if (sentenceCount >= maxSentences) {
                return value[..(index + 1)];
            }
        }

        return value;
    }

    private Task OpenExecutionEntryDialogAsync(ExecutionLogEntry entry) {
        var entries = ResolveActiveExecutionEntries();
        if (entries.Count == 0) {
            entries = [entry];
        }

        OpenExecutionDialog(
            title: AgentExecutionDisplayText.Format(entry.Phase, 240),
            entries,
            highlightEntryId: entry.Id,
            size: ModalSize.Wide);

        return Task.CompletedTask;
    }

    private Task OpenExecutionHistoryDialogAsync(IReadOnlyList<ExecutionLogEntry> entries) {
        OpenExecutionDialog(
            title: "Agent work history",
            entries,
            highlightEntryId: null,
            size: ModalSize.Full);

        return Task.CompletedTask;
    }

    private void OpenExecutionDialog(
        string title,
        IReadOnlyList<ExecutionLogEntry> entries,
        Guid? highlightEntryId,
        ModalSize size) {
        _ = DialogService.OpenAsync<AgentExecutionLogDialog>(
            title,
            new Dictionary<string, object?> {
                [nameof(AgentExecutionLogDialog.Run)] = ActiveRun,
                [nameof(AgentExecutionLogDialog.Entries)] = entries,
                [nameof(AgentExecutionLogDialog.HighlightEntryId)] = highlightEntryId
            },
            new DialogOptions {
                Eyebrow = "Agent work",
                Subtitle = BuildExecutionDialogSubtitle(entries),
                Size = size,
                DenseChrome = true,
                TestId = "agent-execution-log-dialog",
                AriaLabel = title,
                Style = "max-height:calc(100vh - 2rem);"
            },
            dialogLifetime.Token);
    }

    private string BuildExecutionDialogSubtitle(IReadOnlyList<ExecutionLogEntry> entries) {
        if (entries.Count == 0) {
            return "No execution steps are available for the selected run.";
        }

        return $"{entries.Count} step(s) captured from {ChatPresentationTime.Format(entries[0].CreatedAtUtc)} to {ChatPresentationTime.Format(entries[^1].CreatedAtUtc)}.";
    }

    private string ResolveComposerGuidance() {
        if (HasPendingApprovals) {
            return IsAutoApprovalActive()
                ? "A pending tool call still needs confirmation once, then the active run policy will keep the remaining approvals moving."
                : "Approve once, approve the rest of this run, or reject before sending the next prompt.";
        }

        if (ActiveRun?.AutoApprovePendingToolCalls == true) {
            return "The active run is allowed to auto-approve its remaining tool calls.";
        }

        if (Agent?.Permissions.AutoApproveExternalCallsByDefault == true) {
            return "This agent auto-approves external tool calls by default.";
        }

        return "Keep the next prompt focused so the transcript stays easy to scan.";
    }

    private bool ShouldRenderComposerStatusRow()
        => HasPendingApprovals ||
           !string.IsNullOrWhiteSpace(VoiceStatusText);

    private string ResolveSessionBadge() {
        if (Session is null) {
            return "Idle";
        }

        if (HasPendingApprovals) {
            return "Waiting";
        }

        return Session.Messages.Count == 0 ? "Ready" : "Active";
    }

    private string ResolveSessionTone() {
        if (Session is null) {
            return "neutral";
        }

        return HasPendingApprovals ? "warning" : "info";
    }

    private bool IsAutoApprovalActive()
        => ActiveRun?.AutoApprovePendingToolCalls == true || Agent?.Permissions.AutoApproveExternalCallsByDefault == true;

    private string ResolveAutoApproveBadgeText()
        => ActiveRun?.AutoApprovePendingToolCalls == true ? "Run Auto Approve" : "Auto Approve";

    private static string ResolveExecutionTone(ExecutionState state) {
        return state switch {
            ExecutionState.Completed => "success",
            ExecutionState.WaitingOnTool => "warning",
            ExecutionState.Failed => "danger",
            ExecutionState.Running or ExecutionState.Preparing or ExecutionState.Persisting => "info",
            _ => "neutral"
        };
    }


    [Parameter] public AgentChatNavigationPresentation? Navigation { get; set; }
    [Parameter] public EventCallback<AgentChatNavigationIntent> NavigationIntent { get; set; }
    [Parameter] public long SelectionGeneration { get; set; }
    private long presentationRevision;
    private (Guid? Agent, Guid? Session, Guid? Run, long Generation) observedTarget;
    private CancellationTokenSource dialogLifetime = new();
    private readonly string attachmentInputId = $"chat-attachment-file-input-{Guid.NewGuid():N}";
    private bool disposed;

    protected override void OnParametersSet() {
        if (!string.Equals(observedPendingPrompt, PendingUserPrompt, StringComparison.Ordinal)) {
            observedPendingPrompt = PendingUserPrompt;
            pendingCreatedAtUtc = PendingUserCreatedAtUtc ?? DateTimeOffset.UtcNow;
        }
        var target = (Agent?.Id, Session?.Id, ActiveRun?.Id, SelectionGeneration);
        if (observedTarget == target) {
            return;
        }
        observedTarget = target;
        presentationRevision++;
        var old = dialogLifetime;
        dialogLifetime = new();
        old.Cancel();
        old.Dispose();
    }

    private ChatWorkspacePresentation MapPresentation() {
        var entries = ResolveActiveExecutionEntries();
        return new() {
            Revision = presentationRevision,
            Header = HeaderPresentation,
            Session = Session is null ? null : new(Session.Id, Session.Title),
            Messages = MessagePresentations.ToImmutableArray(),
            TransientMessages = TransientMessagePresentations.ToImmutableArray(),
            EmptyState = TranscriptEmptyState,
            Approvals = PendingApprovals.Select(item => new ChatApprovalPresentation(item.ApprovalId, item.ToolKind,
                item.ToolName, AgentExecutionDisplayText.Format(item.Details, 512), FormatApprovalArguments(item.ArgumentsJson, item.ToolName, ToolPolicies))).ToImmutableArray(),
            ExecutionSteps = ResolveVisibleExecutionEntries(entries).Select(item => new ChatExecutionStep(item.Id,
                item.State.ToString(), ResolveExecutionTone(item.State), BoundExecutionText(item.Phase),
                ChatPresentationTime.Format(item.CreatedAtUtc), BuildEntryPreview(item))).ToImmutableArray(),
            ExecutionStepCount = entries.Count,
            CollapseExecution = ShouldCollapseExecutionStream(entries),
            ExecutionSummary = BuildWorkedForLabel(entries),
            ExecutionTone = ResolveExecutionTone(ResolveLatestExecutionState(entries)),
            ExecutionPreview = entries.Count == 0 ? "" : BuildEntryPreview(entries[^1]),
            DraftPrompt = DraftPrompt,
            ComposerKey = ComposerKey,
            IsBusy = IsBusy,
            AutoApproval = IsAutoApprovalActive(),
            ComposerGuidance = ResolveComposerGuidance(),
            Attachments = DraftAttachmentPaths.Select(RelativeAttachmentPath.NormalizeOrNull).OfType<string>().ToImmutableArray(),
            CanUseVoiceMode = CanUseVoiceMode,
            IsVoiceModeEnabled = IsVoiceModeEnabled,
            IsVoiceRecording = IsVoiceRecording,
            IsVoiceTranscribing = IsVoiceTranscribing,
            IsVoiceSpeaking = IsVoiceSpeaking,
            VoiceStatusText = VoiceStatusText,
            VoiceStatusTone = VoiceStatusTone
        };
    }

    private static string BoundExecutionText(string value) => AgentExecutionDisplayText.Format(value, 240);

    private Task HandleIntentAsync(ChatWorkspaceIntent intent) {
        if (disposed || intent.Revision != presentationRevision) {
            return Task.CompletedTask;
        }
        return intent.Action switch {
            ChatWorkspaceAction.DraftChanged => DraftPromptChanged.InvokeAsync(intent.Text ?? ""),
            ChatWorkspaceAction.Send => SendRequested.InvokeAsync(),
            ChatWorkspaceAction.Approvals => ApprovalDecisionsRequested.InvokeAsync(intent.Decisions
                .Select(item => new PendingToolApprovalDecision(item.ApprovalId, item.Approved)).ToImmutableArray()),
            ChatWorkspaceAction.ApproveRemaining => ApprovalDecisionForConversationRequested.InvokeAsync(),
            ChatWorkspaceAction.AttachArtifacts => AttachmentRequested.InvokeAsync(),
            ChatWorkspaceAction.SessionTitleChanged => SessionTitleChanged.InvokeAsync(intent.Text ?? ""),
            ChatWorkspaceAction.VoiceModeChanged => VoiceModeChanged.InvokeAsync(intent.Enabled),
            ChatWorkspaceAction.ToggleRecording => VoiceRecordingToggled.InvokeAsync(),
            ChatWorkspaceAction.SpeakLatest => SpeakLatestAssistantMessageRequested.InvokeAsync(),
            ChatWorkspaceAction.ExecutionEntry when ExecutionLog.FirstOrDefault(item => item.Id == intent.EntryId) is { } entry => OpenExecutionEntryDialogAsync(entry),
            ChatWorkspaceAction.ExecutionHistory => OpenExecutionHistoryDialogAsync(ResolveActiveExecutionEntries()),
            _ => Task.CompletedTask
        };
    }

    public void Dispose() {
        disposed = true;
        dialogLifetime.Cancel();
        dialogLifetime.Dispose();
    }
}

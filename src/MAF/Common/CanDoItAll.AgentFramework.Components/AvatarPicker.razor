@using CanDoItAll.AgentFramework.UI.Avatars
@inject IAvatarGenerationGateway AvatarGenerationGateway
@inject NotificationService NotificationService

<AvatarPickerSurface Value="@Value" ValueChanged="ValueChanged" EntityName="@EntityName" EntityDescription="@EntityDescription"
                     EntityKind="@EntityKind" DefaultImageSeed="@DefaultImageSeed" GenerationSource="GenerationSource"
                     Disabled="Disabled" TestIdPrefix="@TestIdPrefix" Operations="operations" Notice="Notify" OwnerLifetime="OwnerLifetime" />

@code {
    [Parameter] public CancellationToken OwnerLifetime { get; set; }
    private AvatarPickerOperations operations = default!;

    protected override void OnInitialized()
        => operations = new(AvatarGenerationGateway.GetDefaultSourceAsync, AvatarGenerationGateway.GenerateAsync, AvatarUploadFormatter.BuildDataUrlAsync);

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public string EntityName { get; set; } = string.Empty;

    [Parameter]
    public string EntityDescription { get; set; } = string.Empty;

    [Parameter]
    public string EntityKind { get; set; } = "Agent";

    [Parameter]
    public string? DefaultImageSeed { get; set; }

    [Parameter]
    public AvatarGenerationSource? GenerationSource { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string TestIdPrefix { get; set; } = "avatar-picker";

    private void Notify(AvatarPickerNotice notice) {
        var title = notice.Kind switch {
            AvatarPickerNoticeKind.Unavailable => "Avatar picker unavailable",
            AvatarPickerNoticeKind.Uploaded => "Custom avatar loaded",
            AvatarPickerNoticeKind.UploadFailed => "Avatar upload failed",
            AvatarPickerNoticeKind.Generated => "AI avatar created",
            AvatarPickerNoticeKind.GenerationFailed => "AI avatar generation failed",
            _ => throw new ArgumentOutOfRangeException(nameof(notice))
        };
        if (notice.Kind is AvatarPickerNoticeKind.Uploaded or AvatarPickerNoticeKind.Generated) {
            NotificationService.Success(title, notice.Detail);
        } else {
            NotificationService.Error(title, notice.Detail);
        }
    }
}

@using CanDoItAll.Editing.UI
@using CanDoItAll.Modules.Security

<Dialog IsOpen="true" Title="Compare secret metadata" Subtitle="Apply the reviewed metadata to this draft, then save when ready."
        Size="ModalSize.Wide" DenseChrome="true" CloseOnBackdrop="false" OnClose="State.CloseComparison" TestId="secret-review-dialog">
    <ChildContent>
        <Stack GapScale="LayoutGap.Small">
            <MergeFieldView Label="Name" Field="Review.Name" Format="Name" ShowUnchanged="false" Changed="StateHasChanged" TestId="secret-review-name" />
            <MergeFieldView Label="Kind and scope" Field="Review.Use" Format="Use" ShowUnchanged="false" Changed="StateHasChanged" />
            <MergeFieldView Label="Rotation note and metadata JSON" Field="Review.PrivateMetadata" Format="PrivateMetadata" ShowUnchanged="false" Changed="StateHasChanged" />
            @if (Review.Replacement is { } replacement) {
                <MergeFieldView Label="Pending secret replacement" Field="replacement" Format="Replacement" Changed="StateHasChanged" TestId="secret-review-replacement" />
            }
        </Stack>
    </ChildContent>
    <Footer>
        <Button Text="Cancel" Tone="ButtonTone.Default" Click="State.CloseComparison" />
        <Button Text="Apply choices to draft" Disabled="@(!State.CanCompare || !Review.CanApply(State.Draft))"
                Click="State.ApplyComparison" data-testid="secret-review-apply" />
    </Footer>
</Dialog>

@code {
    [Parameter, EditorRequired] public IWorkspaceSecretsState State { get; set; } = default!;
    [Parameter, EditorRequired] public WorkspaceSecretReview Review { get; set; } = default!;

    private static string Name(string value) => value.Length == 0 ? "Empty" : value;
    private static string Use((SecretKind Kind, string Scope) value) => $"{value.Kind} · {value.Scope}";
    private string PrivateMetadata((string? Note, string Json) value) => value == Review.PrivateMetadata.Original ? "Original contents hidden" :
        value == Review.PrivateMetadata.Current ? "Saved changes hidden" : "Draft changes hidden";
    private static string Replacement(bool pending) => pending ? "Keep pending replacement" : "Clear pending replacement";
}

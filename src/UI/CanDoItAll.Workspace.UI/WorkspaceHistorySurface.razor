@namespace CanDoItAll.Workspace.UI
@implements IDisposable
@using CanDoItAll.AgentFramework.ProviderHistory
@using CanDoItAll.Editing.UI

<Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch" data-testid="history-policy-panel">
    <FormSection Title="Provider history policy" Description="Applies to history owned by this instance and database profile. Shared publishers and clients each apply their own policy.">
        <Button Text="Load current policy" Tone="ButtonTone.Default" Click="State.LoadAsync" Disabled="@State.IsBusy"
                IsBusy="@State.IsBusy" data-testid="history-policy-load" />
        @if (State.CanCompare) {
            <Button Text="Compare saved policy" Tone="ButtonTone.Default" Click="State.OpenComparison" data-testid="history-policy-compare" />
        }
    </FormSection>
    @if (State.Error is not null) {
        <Alert AlertStyle="AlertStyle.Danger" data-testid="history-policy-error">@State.Error</Alert>
    }
    @if (State.Message is not null) {
        <Alert AlertStyle="AlertStyle.Success" data-testid="history-policy-success">@State.Message</Alert>
    }
    @if (State.Snapshot is not null) {
        <EditForm EditContext="State.EditContext" OnSubmit="State.ApplyFutureAsync" data-testid="history-policy-form">
            <DataAnnotationsValidator />
            <FormStack>
                <FormSection Title="@($"Policy version {State.Snapshot.Version}")" Description="Light keeps request metadata. Detailed can retain bounded current-turn text and responses; it never copies assembled conversation history.">
                    <FormRow Split="true">
                        <FormField Text="Capture mode">
                            <SelectInput TValue="HistoryCaptureMode" @bind-Value="State.Draft.CaptureMode"
                                      @bind-Value:after="State.DraftChanged" Disabled="@State.IsBusy" aria-label="Capture mode" data-testid="history-policy-mode">
    @foreach (var option in CaptureModes) {
        <option value="@option">@option</option>
    }
</SelectInput>
                        </FormField>
                        <FormField Text="Maintenance batch size (1–1,000)">
                            <PolicyNumber @bind-Value="State.Draft.BatchSize" @bind-Value:after="State.DraftChanged" disabled="@State.IsBusy"
                                         class="form-input ui-input ui-input--outlined" aria-label="Maintenance batch size" data-testid="history-policy-batch" />
                        </FormField>
                    </FormRow>
                    <FormRow Split="true">
                        <FormField Text="Metadata retention days (1–3,650)">
                            <PolicyNumber @bind-Value="State.Draft.MetadataRetentionDays" @bind-Value:after="State.DraftChanged" disabled="@State.IsBusy"
                                         class="form-input ui-input ui-input--outlined" aria-label="Metadata retention days" data-testid="history-policy-metadata-days" />
                        </FormField>
                        <FormField Text="Detail retention days (no longer than metadata)">
                            <PolicyNumber @bind-Value="State.Draft.DetailRetentionDays" @bind-Value:after="State.DraftChanged" disabled="@State.IsBusy"
                                         class="form-input ui-input ui-input--outlined" aria-label="Detail retention days" data-testid="history-policy-detail-days" />
                        </FormField>
                    </FormRow>
                    <FormRow Split="true">
                        <FormField Text="Maximum text bytes per segment (1–131,072)">
                            <PolicyNumber @bind-Value="State.Draft.MaximumTextBytes" @bind-Value:after="State.DraftChanged" disabled="@State.IsBusy"
                                         class="form-input ui-input ui-input--outlined" aria-label="Maximum text bytes" data-testid="history-policy-text-bytes" />
                        </FormField>
                        <FormField Text="Total retained detail quota (bytes)">
                            <PolicyNumber @bind-Value="State.Draft.DetailQuotaBytes" @bind-Value:after="State.DraftChanged" disabled="@State.IsBusy"
                                         class="form-input ui-input ui-input--outlined" aria-label="Detail quota bytes" data-testid="history-policy-quota" />
                        </FormField>
                    </FormRow>
                </FormSection>
                @if (State.Draft.CaptureMode == HistoryCaptureMode.Detailed) {
                    <Alert AlertStyle="AlertStyle.Warning">Detailed capture can contain sensitive user text. Storage is protected, bounded and subject to quota; unsupported content or unavailable protection is reported explicitly.</Alert>
                }
                <Alert AlertStyle="AlertStyle.Info">Agent, chat and workflow records keep their own retention. These settings do not extend expired data, reconstruct old prompts, or delete canonical conversations.</Alert>
                <ValidationSummary />
                <Cluster Gap="LayoutGap.Small">
                    <Button Text="Apply to future requests" Type="submit" Disabled="@(!State.CanApply)" data-testid="history-policy-apply" />
                    <Button Text="Preview shorter retention for existing records" Tone="ButtonTone.Default"
                            Click="State.PreviewAsync" Disabled="@(!State.CanApply)" data-testid="history-policy-preview" />
                </Cluster>
            </FormStack>
        </EditForm>
    } else if (!State.IsBusy) {
        <EmptyState Title="Policy not requested" Description="Load the current policy to check management access and edit retention. No policy or history data is loaded when this tab opens." />
    }
</Stack>
@if (State.Preview is { } pending) {
    <Dialog IsOpen="true" Title="Shorten existing history retention?" Size="ModalSize.Compact" DenseChrome="true"
            CloseOnBackdrop="false" OnClose="State.ClosePreview" TestId="history-policy-confirmation">
        <ChildContent>
            <Stack GapScale="LayoutGap.Small">
                <p>Standalone metadata: @pending.Preview.MetadataRecords · Captured detail: @pending.Preview.DetailRecords</p>
                <p>This preview is bounded to @pending.Preview.Limit records per category. Counts can change before Apply; the server checks the limit and policy version again.</p>
                <p>Earlier expiry can make records unavailable immediately. Canonical conversations are unchanged.</p>
                @if (pending.Preview.ExceedsLimit) {
                    <Alert AlertStyle="AlertStyle.Warning">The preview exceeds the safe batch limit. Existing retention cannot be changed in this action. Close this preview and apply the policy to future requests only.</Alert>
                }
            </Stack>
        </ChildContent>
        <Footer>
            <Cluster Gap="LayoutGap.Small">
                <Button Text="Cancel" Tone="ButtonTone.Default" Click="State.ClosePreview" Disabled="@State.IsBusy" />
                <Button Text="Apply and shorten existing retention" Tone="ButtonTone.Danger" Click="State.ConfirmShorterAsync"
                        Disabled="@(!State.CanApply || pending.Preview.ExceedsLimit)" data-testid="history-policy-confirm" />
            </Cluster>
        </Footer>
    </Dialog>
}
@if (State.Comparison is { } comparison) {
    <Dialog IsOpen="true" Title="Compare provider history policy" Subtitle="Applying choices updates your draft. Shortening existing retention requires a fresh preview."
            Size="ModalSize.Wide" DenseChrome="true" CloseOnBackdrop="false" OnClose="State.CloseComparison" TestId="history-policy-review">
        <ChildContent>
            <Stack GapScale="LayoutGap.Small">
                <MergeFieldView Label="Capture mode and text limit" Field="comparison.Capture" Format="Capture" ShowUnchanged="false" Changed="StateHasChanged" />
                <MergeFieldView Label="Retention and quota" Field="comparison.Retention" Format="Retention" ShowUnchanged="false" Changed="StateHasChanged" TestId="history-policy-review-retention" />
                <MergeFieldView Label="Maintenance batch size" Field="comparison.Batch" Format="Batch" ShowUnchanged="false" Changed="StateHasChanged" />
            </Stack>
        </ChildContent>
        <Footer>
            <Button Text="Cancel" Tone="ButtonTone.Default" Click="State.CloseComparison" />
            <Button Text="Apply choices to draft" Disabled="@(!State.CanApplyComparison)" Click="State.ApplyComparison" data-testid="history-policy-review-apply" />
        </Footer>
    </Dialog>
}

<SettingsReceipts Entries="State.Receipts" />
@code {
    [Parameter, EditorRequired] public IWorkspaceHistoryState State { get; set; } = default!;
    private static readonly HistoryCaptureMode[] CaptureModes = Enum.GetValues<HistoryCaptureMode>();
    private static string Capture((HistoryCaptureMode Mode, int MaximumTextBytes) value) => $"{value.Mode} · {value.MaximumTextBytes:N0} bytes per segment";
    private static string Retention((int MetadataDays, int DetailDays, long QuotaBytes) value) =>
        $"Metadata {value.MetadataDays} days\nDetail {value.DetailDays} days\nQuota {value.QuotaBytes:N0} bytes";
    private static string Batch(int value) => value.ToString("N0");
    private IWorkspaceHistoryState? subscribed;
    protected override void OnParametersSet() {
        if (!ReferenceEquals(subscribed, State)) {
            if (subscribed is not null) {
                subscribed.Changed -= Changed;
            }
            subscribed = State;
            subscribed.Changed += Changed;
        }
    }
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() {
        if (subscribed is not null) {
            subscribed.Changed -= Changed;
        }
    }
}

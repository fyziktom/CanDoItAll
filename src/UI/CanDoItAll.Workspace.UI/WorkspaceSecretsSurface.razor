@namespace CanDoItAll.Workspace.UI
@implements IDisposable
<Stack GapScale="LayoutGap.Medium">
    <Button Text="Refresh references" ButtonStyle="ButtonStyle.Light" Click="State.RefreshAsync" Disabled="State.IsLoading" data-testid="secrets-refresh" />
    @if (State.Error is { } error) {
        <Alert AlertStyle="AlertStyle.Warning">@error</Alert>
    }
    <ListDetailShell ListPaneWidth="24rem">
        <ListHeader>
            <ListPanelHeader Title="Secret vault" Description="Encrypted secrets are stored once and referenced from other modules." Count="@FilteredSecrets.Count.ToString()">
                <Filters>
                    <Stack GapScale="LayoutGap.Small">
                        <Button Text="New secret" Icon="add" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="State.New" />
                        <FilterBar ResultText="@($"{FilteredSecrets.Count} matching secret(s)")">
                            <input @bind="State.Search" @bind:event="oninput" class="cda-input min-w-[14rem] flex-1" placeholder="Search secrets" />
                            <Button Text="Reset" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="ResetSearch" />
                        </FilterBar>
                    </Stack>
                </Filters>
            </ListPanelHeader>
        </ListHeader>

        <ListContent>
            @if (FilteredSecrets.Count == 0) {
                <EmptyState Eyebrow="No secrets" Title="Add the first secret" Description="Secrets appear here after they are saved through the vault editor." />
            } else {
                <Stack GapScale="LayoutGap.Medium">
                    @foreach (var secret in FilteredSecrets) {
                        <SelectionListItem Title="@secret.Name"
                                           Eyebrow="@secret.Kind.ToString()"
                                           Meta="@secret.Scope"
                                           Summary="@FormatTimestamp(secret.UpdatedAtUtc)"
                                           IsSelected="@(State.Draft.Model.Id == secret.Id)"
                                           OnSelect="@(() => State.SelectAsync(secret.Id))">
                            <Status>
                                <StatusBadge Tone="info" Text="@secret.Kind.ToString()" />
                            </Status>
                            <Actions>
                                <CopyButton Value="@secret.Name"
                                            AriaLabel="Copy secret name"
                                            DisplayMode="CopyButtonDisplayMode.IconOnly"
                                            Size="CopyButtonSize.ExtraSmall" />
                                <CopyButton Value='@secret.Id.ToString("D")'
                                            Text="Copy ID"
                                            CopiedText="ID copied"
                                            AriaLabel="Copy secret ID"
                                            DisplayMode="CopyButtonDisplayMode.TextWithIcon"
                                            Size="CopyButtonSize.ExtraSmall"
                                            data-testid="@($"settings-secret-copy-id-{secret.Id:N}")" />
                            </Actions>
                        </SelectionListItem>
                    }
                </Stack>
            }
        </ListContent>

        <DetailHeader>
            <Stack GapScale="LayoutGap.Tiny">
                <p class="cda-eyebrow">Secret editor</p>
                <h2 class="cda-title-xl">@(State.Draft.Model.Id.HasValue ? State.Draft.Model.Name : "New secret")</h2>
                <p class="cda-body-muted">Secrets stay encrypted at rest and can be referenced from providers, resources, or other modules.</p>
            </Stack>
        </DetailHeader>

        <DetailContent>
            <EditForm @key="State.Draft.Origin" EditContext="State.Draft.EditContext" OnSubmit="State.SaveAsync">
                <fieldset disabled="@(!State.CanEdit)">
                    <Stack Class="min-h-full" GapScale="LayoutGap.XXLarge">
                        <FormSection Title="Secret metadata"
                                     Icon="shield"
                                     Description="Name the secret clearly and capture its usage scope.">
                            <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                <div>
                                    <label class="cda-field-label">Name</label>
                                    <TextBox Immediate="true" @bind-Value="State.Draft.Model.Name" @bind-Value:after="State.Draft.Edited" data-testid="secret-name" class="cda-input" />
                                </div>
                                <div>
                                    <label class="cda-field-label">Kind</label>
                                    <InputSelect @bind-Value="State.Draft.Model.Kind" @bind-Value:after="State.Draft.Edited" data-testid="secret-kind" class="cda-input">
                                        @foreach (var kind in Enum.GetValues<SecretKind>()) {
                                            <option value="@kind">@kind</option>
                                        }
                                    </InputSelect>
                                </div>
                            </Grid>
                            <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                <div>
                                    <label class="cda-field-label">Scope</label>
                                    <TextBox Immediate="true" @bind-Value="State.Draft.Model.Scope" @bind-Value:after="State.Draft.Edited" data-testid="secret-scope" class="cda-input" />
                                </div>
                                <div>
                                    <label class="cda-field-label">Rotation note</label>
                                    <TextBox Immediate="true" @bind-Value="State.Draft.Model.RotationNote" @bind-Value:after="State.Draft.Edited" data-testid="secret-rotationnote" class="cda-input" />
                                </div>
                            </Grid>
                        </FormSection>

                        <FormSection Title="Encrypted payload"
                                     Icon="lock"
                                     Description="The raw value is only edited here, while other areas consume references to the saved record.">
                            <div>
                                <label class="cda-field-label">Secret value</label>
                                <SecretField @key="State.Draft.Origin" @bind-Value="State.Draft.Model.SecretValue" @bind-Value:after="State.Draft.Edited" @oninput="SecretInput"
                                             SecretName="@State.Draft.Model.Name"
                                             ShowNameCopy="true"
                                             ShowValueCopy="true"
                                             RevealDurationSeconds="30"
                                             Placeholder="Enter or update secret value"
                                             data-testid="settings-secret-value" />
                            </div>
                            <div>
                                <label class="cda-field-label">Metadata JSON</label>
                                <TextArea Immediate="true" Rows="3" @bind-Value="State.Draft.Model.MetadataJson" @bind-Value:after="State.Draft.Edited" data-testid="secret-metadatajson" class="cda-input cda-input--textarea" />
                            </div>
                        </FormSection>

                        <StickyActionFooter StatusLabel="Secret vault">
                            <SecondaryActions>
                                <Button Text="Clear" Icon="restart_alt" ButtonStyle="ButtonStyle.Light" Click="State.New" />
                            </SecondaryActions>
                            <PrimaryActions>
                                <Button Text="Save secret" Disabled="@(!State.CanMutate)" data-testid="secret-save" Icon="save" Type="submit" />
                            </PrimaryActions>
                            <DangerActions>
                                @if (State.Draft.Model.Id.HasValue) {
                                    <Button Text="Delete" Disabled="@(!State.CanMutate)" data-testid="secret-delete" Icon="delete" ButtonStyle="ButtonStyle.Danger" Click="State.DeleteAsync" />
                                }
                            </DangerActions>
                        </StickyActionFooter>
                    </Stack>
                </fieldset>
            </EditForm>
        </DetailContent>
    </ListDetailShell>
    <SettingsReceipts Entries="State.Receipts" Review="State.ReviewAsync">
        <IdentityReview Context="receipt">
            <SecretReceiptReview Receipt="receipt" Observe="id => State.ReviewIdentityAsync(receipt, id)" />
        </IdentityReview>
    </SettingsReceipts>
</Stack>
@code {
    [Parameter, EditorRequired] public IWorkspaceSecretsState State { get; set; } = default!;
    private IWorkspaceSecretsState? subscribed;
    protected override void OnParametersSet() {
        if (!ReferenceEquals(subscribed, State)) {
            if (subscribed is not null) {
                subscribed.Changed -= Changed;
            }
            subscribed = State;
            subscribed.Changed += Changed;
        }
    }
    private IReadOnlyList<SecretListItem> FilteredSecrets => State.Secrets.Where(item =>
        string.IsNullOrWhiteSpace(State.Search) || item.Name.Contains(State.Search, StringComparison.OrdinalIgnoreCase) || item.Scope.Contains(State.Search, StringComparison.OrdinalIgnoreCase)).OrderBy(item => item.Name).ToArray();
    private static string FormatTimestamp(DateTimeOffset value) => value.LocalDateTime.ToString("g");
    private void ResetSearch() => State.Search = string.Empty;
    private void SecretInput(ChangeEventArgs args) {
        if (State.CanEdit) {
            State.Draft.Model.SecretValue = args.Value?.ToString() ?? string.Empty;
            State.Draft.Edited();
        }
    }
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() {
        if (subscribed is not null) {
            subscribed.Changed -= Changed;
        }
    }
}

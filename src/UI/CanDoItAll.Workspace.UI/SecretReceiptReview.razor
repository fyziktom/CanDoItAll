<TextBox @bind-Value="candidate" Immediate="true"
               aria-label="Secret ID to observe" data-testid="secret-review-id" />
<Button Text="Observe exact secret metadata" Disabled="@(Receipt.IsReviewing || CandidateId is null)"
        Click="ObserveAsync" data-testid="secret-review-exact" />

@code {
    [Parameter, EditorRequired] public SettingsReceipt Receipt { get; set; } = default!;
    [Parameter] public EventCallback<Guid> Observe { get; set; }
    private string candidate = string.Empty;
    private Guid? CandidateId => Guid.TryParse(candidate, out var id) && id != Guid.Empty ? id : null;
    private Task ObserveAsync() => !Receipt.IsReviewing && CandidateId is { } id ? Observe.InvokeAsync(id) : Task.CompletedTask;
}

@namespace CanDoItAll.Resources.UI

@if (Workspace.CatalogError is { } catalogError) {
    <Alert AlertStyle="AlertStyle.Warning">@catalogError</Alert>
}
@if (Workspace.CleanupError is { } cleanupError) {
    <Alert AlertStyle="AlertStyle.Warning">@cleanupError</Alert>
}
@if (Workspace.Promotions.Count > 0 || Workspace.Actions.Count > 0) {
    <details class="resources-browse-receipts" open>
        <summary>File action history</summary>
        @foreach (var receipt in Workspace.Promotions.Reverse()) {
            <Alert AlertStyle="AlertStyle.Info" data-testid="resources-promotion-success">
                <TextBlock TextStyle="TextStyle.Body2" Value="@($"{receipt.Command.Selection.Source.DisplayName} / {receipt.Command.Selection.Item.Name} → {receipt.Command.Name} · {receipt.State}")" />
                <TextBlock TextStyle="TextStyle.Caption" Value="@receipt.Message" />
                @if (receipt.Observation is { } observation) {
                    <Cluster Gap="LayoutGap.Small">
                        <TextBlock TextStyle="TextStyle.Caption" Value="@($"Resource {observation.ResourceId:D} · revision {observation.ScopeRevision?.ToString() ?? "unavailable"}")" />
                        <Button Text="Open stored object" Icon="open_in_new" Size="ButtonSize.Small" data-testid="resources-open-stored-object" Click="() => Workspace.OpenResourceAsync(observation.ResourceId)" />
                    </Cluster>
                } else if (receipt.State == ResourceEffectState.Unknown) {
                    <Cluster Gap="LayoutGap.Small">
                        <TextBox Value="@ReviewId(receipt.Id)" ValueChanged="value => reviewIds[receipt.Id] = value" Immediate="true" Placeholder="Exact resource ID to review" />
                        <Button Text="Review identity" Disabled="@(receipt.IsReviewing || !Guid.TryParse(ReviewId(receipt.Id), out _))" Click="() => ReviewAsync(receipt)" />
                    </Cluster>
                }
            </Alert>
        }
        @foreach (var receipt in Workspace.Actions.Reverse()) {
            <Alert AlertStyle="AlertStyle.Info" data-testid="resources-file-action-receipt">
                @receipt.Selection.Source.DisplayName / @receipt.Selection.Item.Name · @receipt.Action · @receipt.State: @receipt.Message
            </Alert>
        }
    </details>
}

@code {
    [Parameter, EditorRequired] public IResourceBrowseWorkspace Workspace { get; set; } = default!;
    private readonly Dictionary<Guid, string> reviewIds = [];
    protected override void OnParametersSet() {
        foreach (var id in reviewIds.Keys.Where(id => !Workspace.Promotions.Any(receipt => receipt.Id == id)).ToArray()) {
            reviewIds.Remove(id);
        }
    }
    private string ReviewId(Guid id) => reviewIds.GetValueOrDefault(id, string.Empty);
    private Task ReviewAsync(ResourcePromotionReceipt receipt) => Guid.TryParse(ReviewId(receipt.Id), out var id) ? Workspace.ReviewPromotionAsync(receipt, id) : Task.CompletedTask;
}

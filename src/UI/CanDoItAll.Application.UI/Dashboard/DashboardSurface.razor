@using System.Globalization

<PageScaffold MaxWidthClass="max-w-full">
    <Header>
        <PageHeader Eyebrow="Dashboard"
                    Title="Operational overview"
                    Description="Recent projects, live execution activity, and observed agent usage in one five-minute snapshot."
                    Compact="true">
            <Stats>
                @if (SnapshotData is { } snapshotData) {
                    <CompactStat Label="Total tokens"
                                 Value="@FormatTokens(snapshotData.Usage.ObservedTokens)"
                                 TooltipText="Observed input and output tokens recorded by agent executions." />
                    <CompactStat Label="Known cost (USD)"
                                 Value="@FormatKnownCost(snapshotData.Usage.KnownCostUsd)"
                                 TooltipText="@UsageCostTooltip" />
                }
            </Stats>
            <Actions>
                <Cluster Wrap="FlexWrap.NoWrap"
                         Gap="LayoutGap.Small">
                    @if (View.NextAutomaticRefreshAtUtc.HasValue) {
                        <TextBlock TextStyle="TextStyle.Caption"
                                   Value="@AutomaticRefreshText"
                                   Class="whitespace-nowrap text-slate-500"
                                   data-testid="dashboard-refresh-countdown" />
                    }
                    <PageHeaderActionButton Icon="refresh"
                                            Label="Refresh dashboard"
                                            TooltipText="Refresh dashboard data now."
                                            Disabled="@View.IsRefreshing"
                                            IsBusy="@View.IsRefreshing"
                                            Click="Refresh"
                                            TestId="dashboard-refresh" />
                </Cluster>
            </Actions>
        </PageHeader>
    </Header>

    <ChildContent>
        <Grid Gap="LayoutGap.XLarge"
              ColumnTemplateXl="minmax(0,0.9fr) minmax(0,1.1fr)"
              data-testid="dashboard-top-grid">
            <SectionCard Title="Quick actions"
                         Description="Open the main operational workspaces.">
                <Grid Columns="2"
                      ColumnsLg="4"
                      Gap="LayoutGap.Small"
                      Class="!max-w-xl">
                    <QuickActionCard Href="/projects"
                                     Icon="folder_open"
                                     Label="Projects"
                                     TestId="dashboard-action-projects" />
                    <QuickActionCard Href="/agents"
                                     Icon="smart_toy"
                                     Label="Agents"
                                     TestId="dashboard-action-agents" />
                    <QuickActionCard Href="/processes/live"
                                     Icon="monitor_heart"
                                     Label="Live Processes"
                                     TestId="dashboard-action-processes" />
                    <QuickActionCard Href="/scheduler"
                                     Icon="calendar_month"
                                     Label="Scheduler"
                                     TestId="dashboard-action-scheduler" />
                </Grid>
            </SectionCard>

            @if (SnapshotData is { } projectData) {
                <SectionCard Title="Recently updated projects"
                             Description="The six projects with the latest recorded changes.">
                    @if (projectData.Projects.IsEmpty) {
                        <EmptyState Eyebrow="Projects"
                                    Title="No projects yet"
                                    Description="Create a project and its latest activity will appear here." />
                    } else {
                        <Grid Columns="3"
                              Gap="LayoutGap.Small"
                              data-testid="dashboard-project-grid">
                            @foreach (var project in projectData.Projects) {
                                <a href="@BuildProjectHref(project.ProjectId)"
                                   title="@project.Name"
                                   class="group block h-full min-w-0 rounded-2xl focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 focus-visible:ring-offset-2"
                                   data-testid="@BuildTestId("dashboard-project", project.ProjectId)">
                                    <ActionCard Class="h-full min-h-24 overflow-hidden !p-3 transition group-hover:-translate-y-0.5 group-hover:border-sky-300 group-hover:bg-sky-50 group-hover:shadow-md">
                                        <Stack GapScale="LayoutGap.Tiny"
                                               Class="h-full min-w-0">
                                            <Split Breakpoint="LayoutBreakpoint.None"
                                                   Gap="LayoutGap.Small"
                                                   AlignItems="AlignItems.Start"
                                                   JustifyContent="JustifyContent.SpaceBetween"
                                                   Wrap="FlexWrap.NoWrap">
                                                <TextBlock TextStyle="TextStyle.Subtitle2"
                                                           Value="@project.Name"
                                                           Class="min-w-0 flex-1 truncate text-slate-900" />
                                                <StatusBadge Tone="@MapStatusTone(project.Status.Tone)"
                                                             Text="@project.Status.Label" />
                                            </Split>
                                            <TextBlock TextStyle="TextStyle.Caption"
                                                       Value="@BuildProjectMeta(project)"
                                                       Class="mt-auto block w-full min-w-0 max-w-full truncate text-slate-500" />
                                        </Stack>
                                    </ActionCard>
                                </a>
                            }
                        </Grid>
                    }
                </SectionCard>
            }
        </Grid>

        @if (SnapshotRead?.HasRefreshFailure == true) {
            <Alert AlertStyle="AlertStyle.Warning"
                   Variant="Variant.Outlined"
                   data-testid="dashboard-stale-warning">
                <Stack GapScale="LayoutGap.Tiny">
                    <TextBlock TextStyle="TextStyle.Subtitle2"
                               Value="Showing the last successful snapshot" />
                    <TextBlock TextStyle="TextStyle.Body2"
                               Value="@StaleSnapshotMessage" />
                </Stack>
            </Alert>
        }

        @if (!string.IsNullOrWhiteSpace(View.ErrorMessage)) {
            <Alert AlertStyle="@(SnapshotData is null ? AlertStyle.Danger : AlertStyle.Warning)"
                   Variant="Variant.Outlined"
                   data-testid="dashboard-load-error">
                <Stack GapScale="LayoutGap.Small">
                    <TextBlock TextStyle="TextStyle.Subtitle2"
                               Value="@(SnapshotData is null ? "Dashboard snapshot unavailable" : "Dashboard refresh failed")" />
                    <TextBlock TextStyle="TextStyle.Body2"
                               Value="@View.ErrorMessage" />
                    <Button Text="Retry now"
                            Icon="refresh"
                            Size="ButtonSize.Small"
                            Variant="Variant.Outlined"
                            Disabled="@View.IsRefreshing"
                            IsBusy="@View.IsRefreshing"
                            Click="Refresh"
                            data-testid="dashboard-retry" />
                </Stack>
            </Alert>
        }

        @if (View.IsInitialLoading && SnapshotData is null) {
            <LoadingState Eyebrow="Dashboard"
                          Title="Loading operational snapshot"
                          Description="Collecting recent projects, execution activity, and observed agent usage." />
        } else if (SnapshotData is { } data) {
            <Grid Gap="LayoutGap.XLarge"
                  ColumnTemplateXl="minmax(0,0.9fr) minmax(0,1.1fr)">
                <Stack Class="xl:col-start-2">
                    <SectionCard Title="Execution activity"
                                 Description="Active runs when present; otherwise the five most recently updated runs.">
                        <Tabs SelectedIndex="@((int)View.Activity)"
                              SelectedIndexChanged="ChangeActivityAsync"
                              Variant="TabsVariant.WorkspaceSecondary"
                              BorderMode="TabsBorderMode.Soft"
                              OverflowMode="TabsOverflowMode.Wrap"
                              AriaLabel="Dashboard activity"
                              data-testid="dashboard-activity-tabs">
                            <TabItems>
                                <TabsItem Text="@WorkflowTabLabel"
                                          Icon="account_tree"
                                          BadgeText="@data.Workflows.Length.ToString()"
                                          data-testid="dashboard-workflows-tab">
                                @if (data.Workflows.IsEmpty) {
                                    <EmptyState Eyebrow="Workflows"
                                                Title="@WorkflowEmptyTitle"
                                                Description="Workflow run activity will appear here when available." />
                                } else {
                                    <Stack GapScale="LayoutGap.Tiny">
                                        @foreach (var workflow in data.Workflows) {
                                            <a href="@BuildWorkflowHref(workflow.WorkflowId, workflow.RunId)"
                                               title="@workflow.Summary"
                                               class="block w-full rounded-xl focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 focus-visible:ring-offset-2"
                                               data-testid="@BuildTestId("dashboard-workflow", workflow.RunId)">
                                                <SelectionListItem Title="@workflow.WorkflowName"
                                                                   Meta="@FormatUpdatedAt(workflow.UpdatedAtUtc)"
                                                                   Dense="true"
                                                                   Class="!p-2 [&_.cda-selection-list-item__title]:truncate">
                                                    <Status>
                                                        <StatusBadge Tone="@MapStatusTone(workflow.Status.Tone)"
                                                                     Text="@workflow.Status.Label" />
                                                    </Status>
                                                </SelectionListItem>
                                            </a>
                                        }
                                    </Stack>
                                }
                            </TabsItem>
                            <TabsItem Text="@ProcessTabLabel"
                                      Icon="monitor_heart"
                                      BadgeText="@data.Processes.Length.ToString()"
                                      data-testid="dashboard-processes-tab">
                                @if (data.Processes.IsEmpty) {
                                    <EmptyState Eyebrow="Processes"
                                                Title="@ProcessEmptyTitle"
                                                Description="Process run activity will appear here when available." />
                                } else {
                                    <Stack GapScale="LayoutGap.Tiny">
                                        @foreach (var process in data.Processes) {
                                            <a href="@BuildProcessHref(process.RunId)"
                                               class="block w-full rounded-xl focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 focus-visible:ring-offset-2"
                                               data-testid="@BuildTestId("dashboard-process", process.RunId)">
                                                <SelectionListItem Title="@process.ProcessName"
                                                                   Meta="@BuildProcessMeta(process)"
                                                                   Dense="true"
                                                                   Class="!p-2 [&_.cda-selection-list-item__title]:truncate">
                                                    <Status>
                                                        <Cluster Gap="LayoutGap.Tiny">
                                                            <StatusBadge Tone="@MapStatusTone(process.Status.Tone)"
                                                                         Text="@process.Status.Label" />
                                                            @if (process.ProjectionIsBehind) {
                                                                <StatusBadge Tone="warning"
                                                                             Text="Projection behind" />
                                                            }
                                                        </Cluster>
                                                    </Status>
                                                </SelectionListItem>
                                            </a>
                                        }
                                    </Stack>
                                }
                                </TabsItem>
                            </TabItems>
                        </Tabs>
                    </SectionCard>
                </Stack>
            </Grid>
        }
    </ChildContent>
</PageScaffold>

@code {
    [Parameter, EditorRequired]
    public DashboardPresentation View { get; set; } = null!;

    [Parameter]
    public EventCallback Refresh { get; set; }

    [Parameter]
    public EventCallback<DashboardActivityTab> ActivityChanged { get; set; }

    private DashboardSnapshotRead? SnapshotRead => View.Snapshot;
    private DashboardSnapshotData? SnapshotData => View.Snapshot?.Snapshot.Data;

    private Task ChangeActivityAsync(int index) => ActivityChanged.InvokeAsync(index switch {
        0 => DashboardActivityTab.Workflows,
        1 => DashboardActivityTab.Processes,
        _ => throw new ArgumentOutOfRangeException(nameof(index))
    });

    private string WorkflowTabLabel => SnapshotData?.WorkflowMode switch {
        DashboardActivityMode.Active => "Active workflows",
        DashboardActivityMode.RecentFallback => "Recent workflows",
        null => "Workflows",
        _ => throw new ArgumentOutOfRangeException()
    };

    private string ProcessTabLabel => SnapshotData?.ProcessMode switch {
        DashboardActivityMode.Active => "Active processes",
        DashboardActivityMode.RecentFallback => "Recent processes",
        null => "Processes",
        _ => throw new ArgumentOutOfRangeException()
    };

    private string WorkflowEmptyTitle => SnapshotData?.WorkflowMode == DashboardActivityMode.Active
        ? "No active workflow rows"
        : "No recent workflow runs";

    private string ProcessEmptyTitle => SnapshotData?.ProcessMode == DashboardActivityMode.Active
        ? "No active process rows"
        : "No recent process runs";

    private string UsageCostTooltip {
        get {
            var unknownCount = SnapshotData?.Usage.UnknownUsageObservationCount ?? 0;
            return unknownCount == 0
                ? "Cost from observed usage with resolved canonical provider pricing."
                : $"Known cost excludes {unknownCount.ToString("N0", CultureInfo.CurrentCulture)} usage observations without complete token or pricing data.";
        }
    }

    private string AutomaticRefreshText {
        get {
            if (View.IsRefreshing) {
                return "Refreshing…";
            }

            if (!View.NextAutomaticRefreshAtUtc.HasValue) {
                return "Auto refresh not scheduled";
            }

            var remaining = View.NextAutomaticRefreshAtUtc.Value - View.NowUtc;
            var prefix = SnapshotRead?.HasRefreshFailure == true || SnapshotData is null
                ? "Auto retry"
                : "Auto refresh";
            if (remaining <= TimeSpan.Zero) {
                return $"{prefix} due";
            }

            if (remaining < TimeSpan.FromMinutes(1)) {
                return $"{prefix} in <1 min";
            }

            var minutes = (int)Math.Ceiling(remaining.TotalMinutes);
            return $"{prefix} in {minutes} min";
        }
    }

    private string StaleSnapshotMessage {
        get {
            var read = SnapshotRead ?? throw new InvalidOperationException(
                "A stale dashboard message requires a snapshot read.");
            var failedAtUtc = read.LastRefreshFailureAtUtc ?? throw new InvalidOperationException(
                "A stale dashboard message requires a refresh failure timestamp.");
            return $"Captured {FormatUtc(read.Snapshot.CapturedAtUtc)}. Refresh failed {FormatUtc(failedAtUtc)}; the next automatic retry remains scheduled.";
        }
    }

    private string BuildProjectMeta(DashboardProjectItem project) {
        var updatedAt = FormatUpdatedAt(project.UpdatedAtUtc);
        return string.IsNullOrWhiteSpace(project.CurrentPhase)
            ? updatedAt
            : $"{project.CurrentPhase.Trim()} · {updatedAt}";
    }

    private string BuildProcessMeta(DashboardProcessRunItem process) {
        return $"{process.ProjectName} · {FormatUpdatedAt(process.UpdatedAtUtc)}";
    }

    private string FormatUpdatedAt(DateTimeOffset updatedAtUtc) {
        var elapsed = View.NowUtc - updatedAtUtc;
        if (elapsed <= TimeSpan.FromMinutes(1)) {
            return "Updated just now";
        }

        if (elapsed < TimeSpan.FromHours(1)) {
            return $"Updated {(int)elapsed.TotalMinutes} min ago";
        }

        if (elapsed < TimeSpan.FromDays(1)) {
            return $"Updated {(int)elapsed.TotalHours} h ago";
        }

        if (elapsed < TimeSpan.FromDays(7)) {
            return $"Updated {(int)elapsed.TotalDays} d ago";
        }

        return $"Updated {FormatUtc(updatedAtUtc)}";
    }

    private static string FormatTokens(long value) {
        return value.ToString("N0", CultureInfo.CurrentCulture);
    }

    private static string FormatKnownCost(decimal value) {
        if (value <= 0m) {
            return "$0";
        }

        return value < 1m
            ? FormattableString.Invariant($"${value:0.0000}")
            : FormattableString.Invariant($"${value:0.00}");
    }

    private static string MapStatusTone(DashboardStatusTone tone) {
        return tone switch {
            DashboardStatusTone.Neutral => "neutral",
            DashboardStatusTone.Info => "info",
            DashboardStatusTone.Success => "success",
            DashboardStatusTone.Warning => "warning",
            DashboardStatusTone.Danger => "danger",
            _ => throw new ArgumentOutOfRangeException(nameof(tone), tone, null)
        };
    }

    private static string BuildProjectHref(Guid projectId) {
        return FormattableString.Invariant($"/projects?projectId={projectId:D}");
    }

    private static string BuildWorkflowHref(Guid workflowId, Guid runId) {
        return FormattableString.Invariant(
            $"/agents/workflows?workflowId={workflowId:D}&runId={runId:D}");
    }

    private static string BuildProcessHref(Guid runId) {
        return FormattableString.Invariant($"/processes/live?runId={runId:D}");
    }

    private static string BuildTestId(string prefix, Guid id) {
        return FormattableString.Invariant($"{prefix}-{id:N}");
    }

    private static string FormatUtc(DateTimeOffset value) {
        return value.ToUniversalTime().ToString(
            "yyyy-MM-dd HH:mm 'UTC'",
            CultureInfo.InvariantCulture);
    }

}

@{
    var rendered = View;
    var openingId = rendered.OpeningId;
    var selectedProfileId = rendered.SelectedDatabaseProfileId;
}

<Dialog IsOpen="@rendered.IsOpen"
        Title="Database profiles"
        Eyebrow="@(rendered.IsStartupMode ? "Startup" : "Runtime")"
        Subtitle="@(rendered.IsStartupMode
            ? "Continue with the resolved runtime database or activate another saved PostgreSQL profile for the next restart."
            : "Review the active runtime database and save profile activation for the next process start.")"
        Size="ModalSize.Wide"
        TestId="@(rendered.IsStartupMode ? "database-startup-modal" : "database-switcher-dialog")"
        OnClose="@(() => CloseDatabaseDialog.InvokeAsync(openingId))">
    <ChildContent>
        <Stack GapScale="LayoutGap.Large">
            @if (rendered.DatabaseSelection is not null) {
                <div class="rounded-[1.5rem] border border-slate-200 bg-slate-50/90 p-4"
                     data-testid="database-dialog-current-selection">
                    <Split Breakpoint="LayoutBreakpoint.None"
                           Gap="LayoutGap.Medium"
                           AlignItems="AlignItems.Start"
                           JustifyContent="JustifyContent.SpaceBetween"
                           Wrap="FlexWrap.Wrap">
                        <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
                            <p class="cda-eyebrow">Current runtime profile</p>
                            <p class="text-base font-semibold text-slate-950">@rendered.DatabaseSelection.DisplayName</p>
                            @if (rendered.DatabaseSelection.HasPendingRestartActivation) {
                                <p class="text-sm leading-6 text-amber-700">
                                    Pending restart: @rendered.DatabaseSelection.PendingRestartDisplayName
                                </p>
                            }
                        </Stack>

                        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                            <StatusBadge Tone="info" Text="@rendered.DatabaseSelection.Provider" />
                            <StatusBadge Tone="neutral" Text="@rendered.DatabaseSelection.Source" />
                            @if (rendered.DatabaseSelection.IsRuntimeLocked) {
                                <StatusBadge Tone="warning" Text="Config lock" />
                            }
                        </Cluster>
                    </Split>

                    <Stack GapScale="LayoutGap.Small"
                           Class="mt-3">
                        <Split Breakpoint="LayoutBreakpoint.None"
                               Gap="LayoutGap.Small"
                               AlignItems="AlignItems.Start"
                               JustifyContent="JustifyContent.SpaceBetween"
                               Wrap="FlexWrap.Wrap">
                            <Stack GapScale="LayoutGap.Tiny"
                                   Class="min-w-0 flex-1">
                                <p class="cda-eyebrow">Runtime target</p>
                                <p class="rounded-[1rem] border border-slate-200 bg-white/90 px-3 py-2 font-mono text-xs leading-5 text-slate-600 break-all"
                                   data-testid="database-dialog-active-target">@rendered.DatabaseSelection.Descriptor</p>
                            </Stack>
                            <CopyButton Value="@rendered.DatabaseSelection.Descriptor"
                                        DisplayMode="CopyButtonDisplayMode.IconButton"
                                        Size="CopyButtonSize.Small"
                                        AriaLabel="Copy active database target"
                                        data-testid="database-dialog-copy-active-target" />
                        </Split>

                        <Split Breakpoint="LayoutBreakpoint.None"
                               Gap="LayoutGap.Small"
                               AlignItems="AlignItems.Start"
                               JustifyContent="JustifyContent.SpaceBetween"
                               Wrap="FlexWrap.Wrap">
                            <Stack GapScale="LayoutGap.Tiny"
                                   Class="min-w-0 flex-1">
                                <p class="cda-eyebrow">Workspace root</p>
                                <p class="rounded-[1rem] border border-slate-200 bg-white/90 px-3 py-2 font-mono text-xs leading-5 text-slate-600 break-all"
                                   data-testid="database-dialog-workspace-root">@rendered.DatabaseSelection.WorkspaceRoot</p>
                            </Stack>
                            <CopyButton Value="@rendered.DatabaseSelection.WorkspaceRoot"
                                        DisplayMode="CopyButtonDisplayMode.IconButton"
                                        Size="CopyButtonSize.Small"
                                        AriaLabel="Copy active database workspace root"
                                        data-testid="database-dialog-copy-workspace-root" />
                        </Split>
                    </Stack>

                    <p class="mt-3 text-xs text-slate-500">Selection source: @rendered.DatabaseSelection.Resolution</p>
                </div>
            }

            @if (rendered.Message is not null) {
                <div class="@MessageClass(rendered.Message.Tone)"
                     data-testid="database-dialog-message">
                    @rendered.Message.Text
                </div>
            }

            @if (rendered.DatabaseSelection?.IsRuntimeLocked == true) {
                <div class="rounded-[1.4rem] border border-amber-300 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-950"
                     data-testid="database-dialog-locked-message">
                    Startup configuration owns the active database for this session. Continue is still safe, but profile activation and creation are disabled until the override is removed.
                </div>
            }

            @if (rendered.DatabaseProfiles.Count == 0) {
                <EmptyState Eyebrow="No saved profiles"
                            Title="Create the first PostgreSQL profile"
                            Description="Saved profiles appear here after they are persisted through the control plane or the Data Sources settings tab." />
            } else {
                <Stack GapScale="LayoutGap.Medium" data-testid="database-dialog-profile-list">
                    @foreach (var profile in rendered.DatabaseProfiles) {
                        <SelectionListItem Title="@profile.DisplayName"
                                           Eyebrow="@profile.Provider"
                                           Meta="@profile.Source"
                                           Summary="@profile.Descriptor"
                                           DataTestId="@($"database-dialog-profile-row-{profile.Id:N}")"
                                           IsSelected="@(rendered.SelectedDatabaseProfileId == profile.Id)"
                                           OnSelect="@(() => SelectDatabaseProfile.InvokeAsync(new(openingId, profile.Id)))">
                            <Status>
                                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                    @if (profile.IsActive) {
                                        <StatusBadge Tone="success" Text="Running now" />
                                    }

                                    @if (profile.IsPendingRestartActivation) {
                                        <StatusBadge Tone="warning" Text="Pending restart" />
                                    }

                                    @if (profile.IsRuntimeLocked) {
                                        <StatusBadge Tone="warning" Text="Locked" />
                                    }
                                </Cluster>
                            </Status>
                            <Actions>
                                <CopyButton Value="@profile.Descriptor"
                                            DisplayMode="CopyButtonDisplayMode.IconButton"
                                            Size="CopyButtonSize.Small"
                                            AriaLabel="@($"Copy database target for {profile.DisplayName}")"
                                            data-testid="@($"database-dialog-copy-profile-{profile.Id:N}")" />
                            </Actions>
                        </SelectionListItem>
                    }
                </Stack>
            }
        </Stack>
    </ChildContent>
    <Footer>
        <Split Breakpoint="LayoutBreakpoint.None"
               Gap="LayoutGap.Medium"
               AlignItems="AlignItems.Center"
               JustifyContent="JustifyContent.SpaceBetween"
               Wrap="FlexWrap.Wrap">
            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                @if (rendered.IsStartupMode) {
                    <Button Text="Continue"
                            ButtonStyle="ButtonStyle.Light"
                            Disabled="@rendered.DatabaseDialogBusy"
                            Click="@(() => ContinueWithCurrentDatabase.InvokeAsync(openingId))"
                            data-testid="database-startup-continue" />
                } else {
                    <Button Text="Close"
                            ButtonStyle="ButtonStyle.Light"
                            Disabled="@rendered.DatabaseDialogBusy"
                            Click="@(() => CloseDatabaseDialog.InvokeAsync(openingId))" />
                }

                <Button Text="Open Data Sources"
                        ButtonStyle="ButtonStyle.Light"
                        Disabled="@rendered.DatabaseDialogBusy"
                        Click="@(() => OpenDatabaseSettings.InvokeAsync(openingId))"
                        data-testid="database-startup-open-settings" />
            </Cluster>

            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                <Button Text="@ResolveSwitchButtonText(rendered)"
                        ButtonStyle="ButtonStyle.Warning"
                        Disabled="@(rendered.DatabaseDialogBusy || !rendered.CanSwitchSelectedProfile)"
                        Click="@(() => ActivateAsync(openingId, selectedProfileId))"
                        data-testid="database-startup-switch" />
            </Cluster>
        </Split>
    </Footer>
</Dialog>

@code {
    [Parameter, EditorRequired]
    public DatabaseProfileDialogPresentation View { get; set; } = default!;

    [Parameter]
    public EventCallback<DatabaseProfileIntent> SelectDatabaseProfile { get; set; }

    [Parameter]
    public EventCallback<Guid> ContinueWithCurrentDatabase { get; set; }

    [Parameter]
    public EventCallback<Guid> CloseDatabaseDialog { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenDatabaseSettings { get; set; }

    [Parameter]
    public EventCallback<DatabaseProfileIntent> SwitchDatabaseProfile { get; set; }

    private Task ActivateAsync(Guid openingId, Guid? profileId) => profileId is { } id
        ? SwitchDatabaseProfile.InvokeAsync(new(openingId, id))
        : Task.CompletedTask;

    private static string ResolveSwitchButtonText(DatabaseProfileDialogPresentation view) => view.SelectedDialogProfileIsActive
        ? "Running now"
        : view.SelectedDialogProfileIsPendingRestart ? "Pending restart" : "Activate for restart";

    private static string MessageClass(DatabaseProfileMessageTone tone) =>
        "rounded-[1.35rem] border px-4 py-3 text-sm leading-6 " + (tone switch {
            DatabaseProfileMessageTone.Error => "border-rose-200 bg-rose-50 text-rose-950",
            DatabaseProfileMessageTone.RestartRequired => "border-amber-300 bg-amber-50 text-amber-950",
            _ => throw new ArgumentOutOfRangeException(nameof(tone), tone, null)
        });
}

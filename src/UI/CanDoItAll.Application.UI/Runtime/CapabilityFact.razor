@using CanDoItAll.Components.Common

<Stack GapScale="LayoutGap.Tiny" AlignItems="AlignItems.Stretch">
    <TextBlock TextStyle="TextStyle.Eyebrow" Value="@Label" />
    <TextBlock TextStyle="TextStyle.Body2" Value="@Value" />
</Stack>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Value { get; set; } = string.Empty;
}

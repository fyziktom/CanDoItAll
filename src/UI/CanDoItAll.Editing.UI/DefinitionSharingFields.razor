@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using Microsoft.AspNetCore.Components

<Stack GapScale="LayoutGap.Medium">
    <Stack GapScale="LayoutGap.Small">
        <CheckboxOption TValue="bool" Text="Available through the API" Value="@ApiAvailable" ValueChanged="@ApiAvailableChanged"
                        Disabled="@Disabled" data-testid="definition-sharing-api" />
        <TextBlock TextStyle="TextStyle.Muted" Value="Allow authorized API clients to find and use this definition." />
    </Stack>
    <Stack GapScale="LayoutGap.Small">
        <CheckboxOption TValue="bool" Text="Share as a template" Value="@SharedTemplate" ValueChanged="@SharedTemplateChanged"
                        Disabled="@Disabled" data-testid="definition-sharing-template" />
        <TextBlock TextStyle="TextStyle.Muted" Value="Let connected instances import a local copy of this definition." />
    </Stack>
</Stack>

@code {
    [Parameter] public bool ApiAvailable { get; set; }
    [Parameter, EditorRequired] public EventCallback<bool> ApiAvailableChanged { get; set; }
    [Parameter] public bool SharedTemplate { get; set; }
    [Parameter, EditorRequired] public EventCallback<bool> SharedTemplateChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
}

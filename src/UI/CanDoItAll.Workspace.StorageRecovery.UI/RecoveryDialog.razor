@implements IDisposable

<Dialog IsOpen="true" Title="Storage recovery" Size="ModalSize.Wide" DenseChrome="true"
        Subtitle="Review pending files and owner follow-up."
        OnClose="OnClose" TestId="storage-recovery-dialog">
    <HeaderActions>
        <Button Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light" Disabled="Session.IsBusy"
                Click="Session.RefreshAsync" data-testid="storage-recovery-refresh" />
    </HeaderActions>
    <ChildContent>
        <Stack GapScale="LayoutGap.Medium">
            @if (!string.IsNullOrEmpty(Session.Error)) {
                <Alert AlertStyle="AlertStyle.Warning" data-testid="storage-recovery-error">@Session.Error</Alert>
            }
            @if (!Session.PagesCurrent && Session.Rows.Any()) {
                <Alert AlertStyle="AlertStyle.Warning">These observations are no longer current. Refresh before choosing an action.</Alert>
            }
            <DataGrid TItem="RecoveryItem" Data="Session.Rows" Loading="Session.IsBusy"
                      EmptyText="@(Session.PagesCurrent ? "No pending work on these pages." : "Recovery status is unavailable.")" Caption="Pending Storage work"
                      data-testid="storage-recovery-list">
                <Columns>
                    <DataGridColumn TItem="RecoveryItem" Title="Original intent">
                        <Template Context="item">@item.Target.IntentId</Template>
                    </DataGridColumn>
                    <DataGridColumn TItem="RecoveryItem" Title="Pending work">
                        <Template Context="item">@item.Phase</Template>
                    </DataGridColumn>
                    <DataGridColumn TItem="RecoveryItem" Title="Storage state">
                        <Template Context="item">@item.StorageState</Template>
                    </DataGridColumn>
                    <DataGridColumn TItem="RecoveryItem" Title="Updated">
                        <Template Context="item">@item.UpdatedAtUtc.LocalDateTime.ToString("g")</Template>
                    </DataGridColumn>
                    <DataGridColumn TItem="RecoveryItem" Title="Review">
                        <Template Context="item">
                            <Button Text="Inspect" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Disabled="@(Session.IsBusy || !Session.PagesCurrent)"
                                    Click="@(() => Session.SelectAsync(item))" data-testid="@($"storage-recovery-inspect-{item.Target.IntentId:N}")" />
                        </Template>
                    </DataGridColumn>
                </Columns>
            </DataGrid>
            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                <Button Text="Previous placements" ButtonStyle="ButtonStyle.Light" Disabled="@(Session.IsBusy || !Session.PagesCurrent || Session.PlacementOffset == 0)"
                        Click="@(() => Session.PageAsync(RecoveryFeed.Placements, false))" />
                <Button Text="Next placements" ButtonStyle="ButtonStyle.Light" Disabled="@(Session.IsBusy || !Session.PagesCurrent || Session.Placements.NextOffset is null)"
                        Click="@(() => Session.PageAsync(RecoveryFeed.Placements, true))" data-testid="storage-recovery-next-placements" />
                <Button Text="Previous owner follow-ups" ButtonStyle="ButtonStyle.Light" Disabled="@(Session.IsBusy || !Session.PagesCurrent || Session.FollowUpOffset == 0)"
                        Click="@(() => Session.PageAsync(RecoveryFeed.OwnerFollowUps, false))" />
                <Button Text="Next owner follow-ups" ButtonStyle="ButtonStyle.Light" Disabled="@(Session.IsBusy || !Session.PagesCurrent || Session.FollowUps.NextOffset is null)"
                        Click="@(() => Session.PageAsync(RecoveryFeed.OwnerFollowUps, true))" data-testid="storage-recovery-next-owners" />
            </Cluster>
            @if (Session.Selected is { } detail) {
                var item = detail.Item;
                <FormSection Title="Selected intent" Description="Actions retain the original intent and target.">
                    <FactTable>
                        <div><dt>Intent</dt><dd data-testid="storage-recovery-selected-intent">@item.Target.IntentId</dd></div>
                        <div><dt>Database profile</dt><dd>@item.Target.Context.DatabaseProfileId</dd></div>
                        <div><dt>Original project</dt><dd>@item.OriginalProjectId</dd></div>
                        <div><dt>Original storage</dt><dd>@item.OriginalStorageId</dd></div>
                        <div><dt>File receipt</dt><dd>@(item.StorageReceiptPresent ? "Recorded" : "Not observed")</dd></div>
                        <div><dt>Native asset receipt</dt><dd>@(item.NativeReceiptPresent ? "Recorded" : "Not observed")</dd></div>
                        <div><dt>Available recovery</dt><dd>@item.BlockReason</dd></div>
                        @if (Session.Selected is { } observation) {
                            <div><dt>Run receipt status</dt><dd>@observation.OwnerState</dd></div>
                            <div><dt>Original execution</dt><dd>@observation.OriginalExecutionRunId</dd></div>
                        }
                    </FactTable>
                    @if (item.AvailableAction == RecoveryAction.Reconcile) {
                        <Button Text="Reconcile file placement" Disabled="@(!Session.CanAct)" Click="@(() => Session.ExecuteAsync(detail, RecoveryAction.Reconcile))"
                                data-testid="storage-recovery-reconcile" />
                    }
                    @if (item.AvailableAction == RecoveryAction.VerifyExternalTermination) {
                        <Stack GapScale="LayoutGap.Small">
                            <label>
                                <CheckBox TValue="bool" @bind-Value="Session.ExternalDispatchStopped" Disabled="@(!Session.CanAct)"
                                          aria-label="I verified that the original external transfer has stopped"
                                          data-testid="storage-recovery-external-stopped" />
                                I verified that the original external transfer has stopped.
                            </label>
                            <Button Text="Record verification and check file" Disabled="@(!Session.CanAct || !Session.ExternalDispatchStopped)"
                                    Click="@(() => Session.ExecuteAsync(detail, RecoveryAction.VerifyExternalTermination))" data-testid="storage-recovery-verify-external" />
                        </Stack>
                    }
                    @if (detail.WorkflowIntent is { } workflow) {
                        <FactTable>
                            <div><dt>Original workflow run</dt><dd>@workflow.RunId</dd></div>
                        </FactTable>
                        @if (detail.OwnerAction == RecoveryAction.RecordWorkflowAssetReceipt) {
                            <Button Text="Record workflow asset receipt" Disabled="@(!Session.CanAct)"
                                    Click="@(() => Session.ExecuteAsync(detail, RecoveryAction.RecordWorkflowAssetReceipt))"
                                    data-testid="storage-recovery-record-workflow-receipt" />
                        }
                        @if (detail.OwnerAction == RecoveryAction.CompletePreparedWorkflowAsset) {
                            <Button Text="Complete prepared workflow asset" Disabled="@(!Session.CanAct)"
                                    Click="@(() => Session.ExecuteAsync(detail, RecoveryAction.CompletePreparedWorkflowAsset))"
                                    data-testid="storage-recovery-complete-workflow-asset" />
                        }
                    }
                    @if (detail.OwnerAction == RecoveryAction.ReconcileCancelledRunReceipts) {
                        <Stack GapScale="LayoutGap.Small">
                            <Alert AlertStyle="AlertStyle.Info">
                                This checks all admitted receipts in the original cancelled run. It does not run tools, transfer files or resume the model.
                            </Alert>
                            <Button Text="Reconcile cancelled run receipts" Disabled="@(!Session.CanAct)" Click="@(() => Session.ExecuteAsync(detail, RecoveryAction.ReconcileCancelledRunReceipts))"
                                    data-testid="storage-recovery-reconcile-cancelled" />
                        </Stack>
                    }
                </FormSection>
            }
            @if (Session.LastResult is { } result) {
                <Alert AlertStyle="AlertStyle.Info" data-testid="storage-recovery-acknowledged">
                    Acknowledged intent @result.Item.Target.IntentId in profile @result.Item.Target.Context.DatabaseProfileId:
                    file receipt @(result.Item.StorageReceiptPresent ? "Recorded" : "Not observed"),
                    native receipt @(result.Item.NativeReceiptPresent ? "Recorded" : "Not observed").
                    @result.Detail?.OwnerState
                </Alert>
            } else if (Session.ResultUnknown && Session.LastCommand is { } command) {
                <Alert AlertStyle="AlertStyle.Warning" data-testid="storage-recovery-unknown">
                    Outcome unconfirmed for original intent @command.Target.IntentId in profile @command.Target.Context.DatabaseProfileId.
                    Refresh observes the original protocol; it does not repeat a command.
                </Alert>
            }
        </Stack>
    </ChildContent>
    <Footer><Button Text="Close" ButtonStyle="ButtonStyle.Light" Click="OnClose" data-testid="storage-recovery-close" /></Footer>
</Dialog>

@code {
    [Parameter, EditorRequired] public RecoverySession Session { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    private RecoverySession? subscribed;
    protected override void OnParametersSet() {
        if (!ReferenceEquals(subscribed, Session)) {
            Dispose();
            subscribed = Session;
            subscribed.Changed += Changed;
        }
    }
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() {
        if (subscribed is not null) {
            subscribed.Changed -= Changed;
            subscribed = null;
        }
    }
}

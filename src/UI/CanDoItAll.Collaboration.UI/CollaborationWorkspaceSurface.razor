@using CanDoItAll.Editing.UI
@{
    var create = View.NewThread;
    var newThreadEditor = create.Model;
    var reply = View.Reply;
    var replyEditor = reply.Model;
    var target = View.Target;
    var workspace = View.Workspace ?? EmptyWorkspace;
}

@if (Interactive && KeepsEditor is not null) {
    var status = View.DraftStatus;
    <DraftNavigationGuard EditorName="Collaboration" MustRetain="@(status != CollaborationDraftStatus.Clean)"
                          IsBusy="@(status == CollaborationDraftStatus.Submitting)" OutcomeUnknown="@(status == CollaborationDraftStatus.Unconfirmed)"
                          KeepsEditor="KeepsEditor" />
}

<PageScaffold MaxWidthClass="max-w-full" data-testid="collaboration-workspace" data-phase="@View.ReadState.ToString().ToLowerInvariant()" data-interactive="@Interactive.ToString().ToLowerInvariant()"
              data-selected-thread-id="@workspace.SelectedThread?.ThreadId" data-selected-unread="@workspace.SelectedThread?.IsUnread.ToString().ToLowerInvariant()">
    <Header>
        <PageHeader Eyebrow="Collaboration"
                    Title="Inbox, threads, and escalation workspace"
                    Description="Durable notifications and human conversations now live in one canonical module instead of being scattered across transport and timeline views."
                    Compact="true">
            <Stats>
                <CompactStat Label="unread"
                             Value="@(View.Workspace is null ? "—" : workspace.ShellState.UnreadCount.ToString())"
                             TooltipText="Unread collaboration items waiting for review."
                             Tone="info" />
                <CompactStat Label="escalations"
                             Value="@(View.Workspace is null ? "—" : workspace.Totals.Escalations.ToString())"
                             TooltipText="Threads flagged for explicit human attention."
                             Tone="warning" />
                <CompactStat Label="threads"
                             Value="@(View.Workspace is null ? "—" : workspace.Totals.Threads.ToString())"
                             TooltipText="Durable collaboration threads stored in the app database." />
                <CompactStat Label="transport"
                             Value="canonical"
                             TooltipText="External systems can project signals in, but Collaboration owns the read model."
                             Tone="success" />
            </Stats>
            <Actions>
                <PageHeaderActionButton Icon="calendar_month"
                                        Label="Open scheduler"
                                        TooltipText="Open scheduler planning."
                                        Click="View.OpenScheduler" />
                <PageHeaderActionButton Icon="done_all"
                                        Label="Mark selected read"
                                        TooltipText="Mark the selected collaboration thread as read."
                                        Tone="ButtonTone.Primary"
                                        Disabled="@(workspace.SelectedThread is null || !workspace.SelectedThread.IsUnread || target is null || target.IsMarkingRead || target.OutcomeUnknown)"
                                        Click="@(() => View.MarkReadAsync(target!))"
                                        data-testid="collaboration-mark-read" />
            </Actions>
        </PageHeader>
    </Header>

    <ChildContent>
        <Stack GapScale="LayoutGap.Large">
            <Cluster Gap="LayoutGap.Small">
                <Button Text="Refresh" Tone="ButtonTone.Default" Click="View.RefreshAsync" data-testid="collaboration-refresh" />
                @if (View.ReadState is CollaborationReadState.Loading or CollaborationReadState.Refreshing) {
                    <p role="status" data-testid="collaboration-loading">Loading collaboration workspace…</p>
                }
                @if (View.ReadError is not null) {
                    <p role="alert" data-testid="collaboration-read-error">@View.ReadError</p>
                }
                @if (target?.Message is not null) {
                    <p role="status" data-testid="collaboration-target-message">@target.Message</p>
                }
                @if (View.IsReplyRetained) {
                    <p role="status" data-testid="collaboration-reply-retained">This thread is outside the current list. Your reply stays attached here. Select another thread to leave it, or clear the reply and refresh.</p>
                }
                @if (create.Message is not null) {
                    <p role="status" data-testid="collaboration-create-message" data-saved-thread-id="@create.SavedThreadId">@create.Message</p>
                }
            </Cluster>
            <Tabs SelectedIndex="@SelectedIndex"
                  SelectedIndexChanged="HandleSelectedViewChangedAsync"
                  Density="TabsDensity.Compact"
                  BorderMode="TabsBorderMode.Soft"
                  OverflowMode="TabsOverflowMode.Wrap"
                  data-testid="collaboration-tabs">
                <TabItems>
                    <TabsItem Text="Inbox"
                              BadgeText="@ResolveBadgeText(workspace.ShellState.UnreadCount)" />
                    <TabsItem Text="Threads"
                              BadgeText="@ResolveBadgeText(workspace.Totals.Threads)" />
                    <TabsItem Text="Escalations"
                              BadgeText="@ResolveBadgeText(workspace.Totals.Escalations)" />
                </TabItems>
            </Tabs>

            <ListDetailShell ListPaneWidth="30rem">
                <ListHeader>
                    <ListPanelHeader Title="@ResolveListTitle()"
                                     Description="@ResolveListDescription()"
                                     Count="@(View.Workspace is null ? "Unavailable" : $"{ResolveCurrentListCount()} item(s)")">
                        <Filters>
                            <FilterBar ResultText="@(View.Workspace is null ? "Unavailable" : $"{ResolveCurrentListCount()} item(s)")">
                                @if (SelectedIndex != 1) {
                                    <Button Text="Unread only"
                                            Tone="@(View.UnreadOnly ? ButtonTone.Info : ButtonTone.Default)"
                                            Size="ButtonSize.Small"
                                            Click="@(() => View.SetUnreadOnlyAsync(true))"
                                            data-testid="collaboration-filter-unread" />
                                    <Button Text="Show all"
                                            Tone="@(View.UnreadOnly ? ButtonTone.Default : ButtonTone.Info)"
                                            Size="ButtonSize.Small"
                                            Click="@(() => View.SetUnreadOnlyAsync(false))"
                                            data-testid="collaboration-filter-all" />
                                }
                                @if (SelectedIndex == 0) {
                                    <Button Text="Notification"
                                            Tone="ButtonTone.Default"
                                            Size="ButtonSize.Small"
                                            Disabled="@create.IsLocked" Click="@(() => SetThreadKind(create, CollaborationInboxItemKind.Notification))" />
                                    <Button Text="Escalation"
                                            Tone="ButtonTone.Default"
                                            Size="ButtonSize.Small"
                                            Disabled="@create.IsLocked" Click="@(() => SetThreadKind(create, CollaborationInboxItemKind.Escalation))" />
                                }
                            </FilterBar>
                        </Filters>
                    </ListPanelHeader>
                </ListHeader>

                <ListContent>
                    <section hidden="@(View.Section != CollaborationSection.Inbox)">
                        <EditForm EditContext="create.Context" @key="create" OnSubmit="@(() => View.CreateAsync(create))" data-testid="collaboration-create-form">
                            <fieldset disabled="@create.IsLocked">
                            <SurfaceCard Soft="true">
                                <DataAnnotationsValidator />
                                <TextBlock TextStyle="TextStyle.EyebrowCaption">Quick create</TextBlock>
                                <h3 class="mt-1 text-lg font-semibold text-chrome-950">New collaboration item</h3>
                                <Grid Gap="LayoutGap.Medium" ColumnsMd="2" Class="mt-4">
                                    <div>
                                        <FormField Text="Subject">
                                            <TextInput @bind-Value="newThreadEditor.Subject" @oninput="@(args => CaptureThreadInput(create, args, nameof(newThreadEditor.Subject), value => newThreadEditor.Subject = value))" class="form-input ui-input ui-input--outlined" data-testid="collaboration-thread-subject" />
                                        </FormField>
                                        <ValidationMessage For="@(() => newThreadEditor.Subject)" />
                                    </div>
                                    <div>
                                        <FormField Text="Item kind">
                                            <SelectInput @bind-Value="newThreadEditor.ItemKind" data-testid="collaboration-thread-kind">
                                                @foreach (var kind in Enum.GetValues<CollaborationInboxItemKind>()) {
                                                    <option value="@kind">@kind</option>
                                                }
                                            </SelectInput>
                                        </FormField>
                                    </div>
                                </Grid>
                                <Grid Gap="LayoutGap.Medium" ColumnsMd="2" Class="mt-4">
                                    <FormField Text="Context kind">
                                        <SelectInput @bind-Value="newThreadEditor.ContextKind" data-testid="collaboration-thread-context-kind">
                                            @foreach (var kind in Enum.GetValues<CollaborationContextKind>()) {
                                                <option value="@kind">@kind</option>
                                            }
                                        </SelectInput>
                                    </FormField>
                                    <div>
                                        <FormField Text="Context label">
                                            <TextInput @bind-Value="newThreadEditor.ContextLabel" @oninput="@(args => CaptureThreadInput(create, args, nameof(newThreadEditor.ContextLabel), value => newThreadEditor.ContextLabel = value))" class="form-input ui-input ui-input--outlined" data-testid="collaboration-thread-context-label" />
                                        </FormField>
                                        <ValidationMessage For="@(() => newThreadEditor.ContextLabel)" />
                                    </div>
                                </Grid>
                                <div class="mt-4">
                                    <FormField Text="Context route">
                                        <TextInput @bind-Value="newThreadEditor.ContextRoute" @oninput="@(args => CaptureThreadInput(create, args, nameof(newThreadEditor.ContextRoute), value => newThreadEditor.ContextRoute = value))" class="form-input ui-input ui-input--outlined" placeholder="/processes" data-testid="collaboration-thread-context-route" />
                                    </FormField>
                                    <ValidationMessage For="@(() => newThreadEditor.ContextRoute)" />
                                </div>
                                <div class="mt-4">
                                    <FormField Text="First message">
                                        <TextAreaInput @bind-Value="newThreadEditor.MessageBody" @oninput="@(args => CaptureThreadInput(create, args, nameof(newThreadEditor.MessageBody), value => newThreadEditor.MessageBody = value))" class="form-input ui-input ui-input--outlined ui-input--textarea min-h-[6rem]" data-testid="collaboration-thread-message" />
                                    </FormField>
                                    <ValidationMessage For="@(() => newThreadEditor.MessageBody)" />
                                </div>
                                <Cluster Gap="LayoutGap.Small" Class="mt-4">
                                    <Button Text="Create collaboration item" Type="submit" data-testid="collaboration-thread-create" />
                                    <Button Text="Reset" Tone="ButtonTone.Default" Size="ButtonSize.Small" Click="@(() => View.PrepareThread(create, newThreadEditor.ItemKind))" />
                                </Cluster>
                            </SurfaceCard>
                            </fieldset>
                        </EditForm>
                        @if (create.OutcomeUnknown) {
                            <Button Text="Start a new draft after reviewing Threads" Click="@(() => View.PrepareThread(create, create.Model.ItemKind))" />
                        }
                    </section>

                    @if (View.Workspace is null) {
                        <EmptyState Title="Workspace unavailable" Description="Wait for the current read or use Refresh to retry. No empty result has been accepted." />
                    }
                    else if (SelectedIndex == 0) {
                        @if (VisibleInboxItems.Count == 0) {
                            <div class="mt-5">
                                <EmptyState Eyebrow="Inbox is empty" Title="No collaboration items yet" Description="Create a notification or escalation to start the canonical collaboration trail." />
                            </div>
                        }
                        else {
                            <Stack GapScale="LayoutGap.Medium" Class="mt-5">
                                @foreach (var item in VisibleInboxItems) {
                                    <div @key="item.ThreadId" data-testid="collaboration-inbox-item">
                                        <SelectionListItem Title="@item.Title" Eyebrow="@ResolveItemEyebrow(item)" Summary="@item.PreviewText" Meta="@(item.UpdatedAtUtc.LocalDateTime.ToString("g"))" IsSelected="@(workspace.SelectedThread?.ThreadId == item.ThreadId)" OnSelect="@(() => View.SelectAsync(item.ThreadId))">
                                            <Status>
                                                <Cluster Gap="LayoutGap.Small">
                                                    <StatusBadge Tone="@ResolveItemTone(item.ItemKind)" Text="@item.ItemKind.ToString()" />
                                                    @if (item.IsUnread) {
                                                        <StatusBadge Tone="info" Text="@($"{item.UnreadCount} unread")" />
                                                    }
                                                </Cluster>
                                            </Status>
                                        </SelectionListItem>
                                    </div>
                                }
                            </Stack>
                        }
                    }
                    else if (SelectedIndex == 1) {
                        @if (workspace.Threads.Count == 0) {
                            <EmptyState Eyebrow="No threads" Title="Create the first collaboration thread" Description="Threads collect participants, messages, context links, and unread state in one durable model." />
                        }
                        else {
                            <Stack GapScale="LayoutGap.Medium">
                                @foreach (var item in workspace.Threads) {
                                    <div @key="item.ThreadId" data-testid="collaboration-thread-item">
                                        <SelectionListItem Title="@item.Subject" Eyebrow="@item.ContextKind.ToString()" Summary="@item.ContextLabel" Meta="@($"{item.MessageCount} message(s) / {item.LastActivityAtUtc.LocalDateTime:g}")" IsSelected="@(workspace.SelectedThread?.ThreadId == item.ThreadId)" OnSelect="@(() => View.SelectAsync(item.ThreadId))">
                                            <Status>
                                                <Cluster Gap="LayoutGap.Small">
                                                    <StatusBadge Tone="@ResolveItemTone(item.ItemKind)" Text="@item.ItemKind.ToString()" />
                                                    <StatusBadge Tone="neutral" Text="@item.State.ToString()" />
                                                </Cluster>
                                            </Status>
                                        </SelectionListItem>
                                    </div>
                                }
                            </Stack>
                        }
                    }
                    else {
                        @if (VisibleEscalations.Count == 0) {
                            <EmptyState Eyebrow="No escalations" Title="Escalations will appear here" Description="Use the inbox quick-create form or project automation ingress to raise explicit human work." />
                        }
                        else {
                            <Stack GapScale="LayoutGap.Medium">
                                @foreach (var item in VisibleEscalations) {
                                    <div @key="item.ThreadId" data-testid="collaboration-escalation-item">
                                        <SelectionListItem Title="@item.Title" Eyebrow="Escalation" Summary="@item.PreviewText" Meta="@(item.UpdatedAtUtc.LocalDateTime.ToString("g"))" IsSelected="@(workspace.SelectedThread?.ThreadId == item.ThreadId)" OnSelect="@(() => View.SelectAsync(item.ThreadId))">
                                            <Status>
                                                <Cluster Gap="LayoutGap.Small">
                                                    <StatusBadge Tone="warning" Text="Escalation" />
                                                    @if (item.IsUnread) {
                                                        <StatusBadge Tone="info" Text="@($"{item.UnreadCount} unread")" />
                                                    }
                                                </Cluster>
                                            </Status>
                                        </SelectionListItem>
                                    </div>
                                }
                            </Stack>
                        }
                    }
                    @{ var total = workspace.Totals.Visible(View.Section, View.UnreadOnly); }
                    @if (View.PageOffset > 0 || total > CollaborationListWindow.Size) {
                        <Cluster Gap="LayoutGap.Small" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" data-testid="collaboration-pages">
                            <Button Text="Previous" Size="ButtonSize.Small" Tone="ButtonTone.Default" data-testid="collaboration-page-previous"
                                    Disabled="@(View.PageOffset == 0 || View.ReadState == CollaborationReadState.Refreshing)"
                                    Click="@(() => View.SetPageAsync(View.PageOffset - CollaborationListWindow.Size))" />
                            <SmallText Text="@($"Page {View.PageOffset / CollaborationListWindow.Size + 1} · {total} item(s)")" />
                            <Button Text="Next" Size="ButtonSize.Small" Tone="ButtonTone.Default" data-testid="collaboration-page-next"
                                    Disabled="@(total - View.PageOffset <= CollaborationListWindow.Size || View.ReadState == CollaborationReadState.Refreshing)"
                                    Click="@(() => View.SetPageAsync(View.PageOffset + CollaborationListWindow.Size))" />
                        </Cluster>
                    }
                </ListContent>

                <DetailHeader>
                    @if (workspace.SelectedThread is null) {
                        <EmptyState Eyebrow="Thread detail" Title="@(View.IsMissing ? "Thread not found" : "Select an inbox item or thread")" Description="Participants, context links, unread state, and message history appear here after you choose a collaboration item." />
                    }
                    else {
                        <SurfaceCard>
                            <Split Gap="LayoutGap.Medium" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap">
                                <div class="min-w-0">
                                    <TextBlock TextStyle="TextStyle.EyebrowCaption">@workspace.SelectedThread.ContextKind / @workspace.SelectedThread.ContextLabel</TextBlock>
                                    <h2 class="mt-1 text-lg font-semibold text-chrome-950" data-testid="collaboration-thread-title">@workspace.SelectedThread.Subject</h2>
                                </div>
                                <Cluster Gap="LayoutGap.Small">
                                    <StatusBadge Tone="@ResolveItemTone(workspace.SelectedThread.ItemKind)" Text="@workspace.SelectedThread.ItemKind.ToString()" />
                                    <StatusBadge Tone="neutral" Text="@workspace.SelectedThread.State.ToString()" />
                                    @if (workspace.SelectedThread.IsUnread) {
                                        <StatusBadge Tone="info" Text="@($"{workspace.SelectedThread.UnreadCount} unread")" />
                                    }
                                </Cluster>
                            </Split>
                        </SurfaceCard>
                    }
                </DetailHeader>

                <DetailContent>
                    @if (workspace.SelectedThread is null) {
                        <EmptyState Eyebrow="No selection" Title="@(View.IsMissing ? "The requested thread does not exist" : "Choose a thread to continue")" Description="The detail surface shows context, transcript, and reply actions for the selected collaboration thread." />
                    }
                    else {
                        <Stack GapScale="LayoutGap.Large">
                            <Grid Gap="LayoutGap.Medium" ColumnsMd="3">
                                <div class="rounded-[1.2rem] border border-chrome-200 bg-chrome-50/80 px-4 py-4">
                                    <p class="text-xs uppercase tracking-[0.18em] text-[var(--tone-text-muted)]">Context</p>
                                    <p class="mt-1 text-sm font-medium text-chrome-950">@workspace.SelectedThread.ContextLabel</p>
                                </div>
                                <div class="rounded-[1.2rem] border border-chrome-200 bg-chrome-50/80 px-4 py-4">
                                    <p class="text-xs uppercase tracking-[0.18em] text-[var(--tone-text-muted)]">Messages</p>
                                    <p class="mt-1 text-sm font-medium text-chrome-950">@workspace.SelectedThread.Messages.Count</p>
                                </div>
                                <div class="rounded-[1.2rem] border border-chrome-200 bg-chrome-50/80 px-4 py-4">
                                    <p class="text-xs uppercase tracking-[0.18em] text-[var(--tone-text-muted)]">Participants</p>
                                    <p class="mt-1 text-sm font-medium text-chrome-950">@workspace.SelectedThread.Participants.Count</p>
                                </div>
                            </Grid>
                            <SectionCard Title="Transcript" Description="Durable message history with preserved author and timestamp state.">
                                @if (workspace.SelectedThread.Messages.Count == 0) {
                                    <EmptyState Eyebrow="No messages" Title="This thread has no messages" Description="Messages appear here after the first collaboration post is saved." />
                                }
                                else {
                                    <Stack GapScale="LayoutGap.Medium">
                                        @foreach (var collaborationMessage in workspace.SelectedThread.Messages) {
                                            <div class="cda-panel-card--soft" data-testid="collaboration-thread-message-item">
                                                <Split Gap="LayoutGap.Medium" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap">
                                                    <div>
                                                        <p class="text-sm font-semibold text-chrome-900">@collaborationMessage.AuthorName</p>
                                                        <p class="mt-1 text-xs text-[var(--tone-text-muted)]">@collaborationMessage.AuthorKind / @collaborationMessage.MessageKind</p>
                                                    </div>
                                                    <Cluster Gap="LayoutGap.Small">
                                                        @if (collaborationMessage.RaisesEscalation) {
                                                            <StatusBadge Tone="warning" Text="Escalation" />
                                                        }
                                                        <StatusBadge Tone="neutral" Text="@(collaborationMessage.CreatedAtUtc.LocalDateTime.ToString("g"))" />
                                                    </Cluster>
                                                </Split>
                                                <p class="mt-3 text-sm leading-6 text-chrome-700">@collaborationMessage.Body</p>
                                            </div>
                                        }
                                    </Stack>
                                }
                            </SectionCard>
                            <SectionCard Title="Reply" Description="Record another collaboration message on the selected thread.">
                                <EditForm EditContext="reply.Context" @key="reply" OnSubmit="@(() => View.ReplyAsync(target!, reply))" data-testid="collaboration-reply-form">
                                    <fieldset disabled="@reply.IsLocked">
                                    <DataAnnotationsValidator />
                                    <Grid Gap="LayoutGap.Medium" ColumnsMd="2">
                                        <FormField Text="Message kind">
                                            <SelectInput @bind-Value="replyEditor.MessageKind" data-testid="collaboration-reply-kind">
                                                @foreach (var kind in Enum.GetValues<CollaborationMessageKind>()) {
                                                    <option value="@kind">@kind</option>
                                                }
                                            </SelectInput>
                                        </FormField>
                                        <div class="flex items-end">
                                            @if (!string.IsNullOrWhiteSpace(workspace.SelectedThread.ContextRoute)) {
                                                <Button Text="Open linked context" Tone="ButtonTone.Default" Size="ButtonSize.Small" Click="@(() => View.OpenContext(target!))" data-testid="collaboration-open-context" />
                                            }
                                        </div>
                                    </Grid>
                                    <div class="mt-4">
                                        <FormField Text="Reply">
                                            <TextAreaInput @bind-Value="replyEditor.MessageBody" @oninput="@(args => HandleReplyInput(reply, args))" class="form-input ui-input ui-input--outlined ui-input--textarea min-h-[6rem]" data-testid="collaboration-reply-message" />
                                        </FormField>
                                        <ValidationMessage For="@(() => replyEditor.MessageBody)" />
                                    </div>
                                    <Cluster Gap="LayoutGap.Small" Class="mt-4">
                                        <Button Text="Add reply" Type="submit" data-testid="collaboration-reply-submit" />
                                        <Button Text="Clear" Tone="ButtonTone.Default" Size="ButtonSize.Small" Click="@(() => View.ClearReply(target!, reply))" />
                                    </Cluster>
                                    </fieldset>
                                </EditForm>
                                @if (reply.Message is not null) {
                                    <p role="status" data-testid="collaboration-reply-message-status">@reply.Message</p>
                                }
                                @if (reply.OutcomeUnknown) {
                                    <Button Text="Start a new reply after reviewing the transcript" Click="@(() => View.ClearReply(target!, reply))" />
                                }
                            </SectionCard>
                        </Stack>
                    }
                </DetailContent>
            </ListDetailShell>
        </Stack>
    </ChildContent>
</PageScaffold>

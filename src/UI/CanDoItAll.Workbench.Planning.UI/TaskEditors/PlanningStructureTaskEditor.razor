@implements IDisposable
@using Microsoft.Extensions.Logging
@inject ILogger<PlanningStructureTaskEditor> Logger
@namespace CanDoItAll.Workbench.Planning.UI
@using System.Globalization
@using CanDoItAll.AppComponents
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.CanvasLib

<PlanningTaskLeaveGuard @ref="leaveGuard" ReadCurrent="ReadCloseRequest" />
<Stack GapScale="LayoutGap.Large"
       AlignItems="AlignItems.Stretch"
       Class="project-structure-task-create-dialog"
       data-testid="project-structure-task-create-content">
    <PlanningTaskComparison @ref="comparison" Owner="ComparisonOwner" ReadInput="CaptureInput" OriginalInput="initialInput"
                            ApplyLocal="ApplyComparison" ResourceOptions="ResourceOptions" IsSaving="submissionState.IsBusy"
                            CanAccept="submissionState.CanAcceptComparison" Changed="ComparisonChanged" />
    <Stack GapScale="LayoutGap.Large" AlignItems="AlignItems.Stretch" inert="@(submissionState.IsBusy || comparison?.BlocksInput == true ? string.Empty : null)">
        @if (ResourceWarnings.Count > 0)
        {
            <Alert AlertStyle="AlertStyle.Warning"
                   data-testid="project-structure-task-create-assignee-warning">
                @string.Join(" ", ResourceWarnings)
            </Alert>
        }

        @if (IsEditMode &&
            !CanEditDirectAssignee &&
            ResourceWarnings.Count == 0)
        {
            <Alert AlertStyle="AlertStyle.Warning"
                   data-testid="project-structure-task-edit-assignee-readonly">
                This task has a direct-assignment set that cannot be safely changed as one assignee. Person and agent changes are disabled here so every assignment remains intact. Other task fields can still be saved, and workflow or process definitions can be attached when available.
            </Alert>
        }

        @if (!IsEditMode) {
            <Steps Value="@((int)activeStep)" ValueChanged="ChangeStep" NavigationDisabled="@(submissionState.IsBusy || comparison?.BlocksInput == true)"
                   data-testid="project-structure-task-steps">
                <StepsItem Text="Basics" />
                <StepsItem Text="Planning (optional)" />
                <StepsItem Text="Assignment (optional)" />
            </Steps>
            <TextBlock TextStyle="TextStyle.Note" Value="Start with a name and notes. Planning and assignment are optional; create the task whenever it is ready." />
        }

        <section class="project-structure-task-create-dialog__section"
                 hidden="@(!IsEditMode && activeStep != TaskEditorStep.Basics)"
                 data-testid="project-structure-task-basics-section">
            <Grid ColumnTemplate="repeat(2,minmax(0,1fr))"
                  Gap="LayoutGap.Medium"
                  Class="project-structure-task-create-dialog__grid">
                <FormField Text="Task title"
                           Class="project-structure-task-create-dialog__wide-field">
                    <TextInput Value="@title"
                             ValueChanged="HandleTitleChangedAsync"
                             Placeholder="Describe the task"
                             Immediate="true"
                             autofocus="true"
                             data-testid="project-structure-task-create-title" />
                </FormField>

                <FormField Text="Context">
                    <TextInput Value="@subtitle"
                             ValueChanged="HandleSubtitleChangedAsync"
                             Placeholder="Phase, topic, or owner"
                             Immediate="true"
                             data-testid="project-structure-task-create-subtitle" />
                </FormField>

                <FormField Text="Notes"
                           Class="project-structure-task-create-dialog__wide-field">
                    <TextAreaInput Value="@notes"
                              ValueChanged="HandleNotesChangedAsync"
                              Placeholder="Definition of done or context"
                              Rows="4"
                              Immediate="true"
                              data-testid="project-structure-task-create-notes" />
                </FormField>
            </Grid>
        </section>

        <details class="project-structure-task-create-dialog__section"
                 open="@(!IsEditMode || planningExpanded)"
                 hidden="@(!IsEditMode && activeStep != TaskEditorStep.Planning)"
                 data-testid="project-structure-task-planning-section">
            <summary hidden="@(!IsEditMode)" @onclick="TogglePlanning" @onclick:preventDefault="true">@PlanningSummary</summary>
            <Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch">
                <TextBlock TextStyle="TextStyle.Note" Value="Add a due date or estimates when useful. These details can be changed later." />
                <FormField Text="Due (UTC)">
                    <input type="text" placeholder="yyyy-MM-ddTHH:mm"
                           class="form-input ui-input ui-input--outlined"
                           value="@dueText"
                           aria-label="Task due date in UTC"
                           data-testid="project-structure-task-create-due"
                           @oninput="HandleDueChanged" @onchange="HandleDueChanged" />
                </FormField>

                <ProjectStructureTaskEstimateEditor @ref="estimateEditor"
                                                    Value="@estimate"
                                                    ValueChanged="HandleEstimateChangedAsync"
                                                    InputChanged="EstimateInputChanged" InitialInput="initialEstimateInput"
                                                    DefaultCurrencyCode="@DefaultCurrencyCode"
                                                    ExpectedCostReadOnly="@(!ProjectTaskExecutionStatePolicy.AllowsAuthoritativeRepricing(execution.State))"
                                                    DataTestId="project-structure-task-create-estimate" />

                <details class="project-structure-task-create-dialog__section"
                         open="@executionExpanded" data-testid="project-structure-task-execution-section">
                    <summary @onclick="ToggleExecution" @onclick:preventDefault="true">@(IsEditMode ? "Repository and execution (optional)" : "Repository (optional)")</summary>
                    <Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch">
                        @if (IsEditMode) {
                            <TextBlock TextStyle="TextStyle.Body2" Value="@($"Repository: {RepositoryLabel}")"
                                       data-testid="project-structure-task-repository-current" />
                            <TextBlock TextStyle="TextStyle.Note" Value="The repository link is set when the task is created." />
                        } else {
                            <FormField Text="Repository">
                                <SelectInput TValue="string"
                                             Value="@repositoryNodeId"
                                             ValueChanged="HandleRepositoryChangedAsync"
                                             data-testid="project-structure-task-create-repository">
                                    <option value="">Optional repository</option>
                                    @foreach (var option in RepositoryOptions) {
                                        <option value="@option.Value">@option.Label</option>
                                    }
                                </SelectInput>
                            </FormField>
                        }
                        @if (IsEditMode)
                        {
                            <ProjectStructureTaskExecutionEditor @ref="executionEditor"
                                                                 Value="@execution"
                                                                 ValueChanged="HandleExecutionChangedAsync"
                                                                 DataTestId="project-structure-task-edit-execution" />
                        }

                    </Stack>
                </details>
            </Stack>
        </details>

        <details class="project-structure-task-create-dialog__section"
                 open="@(!IsEditMode || assignmentExpanded)"
                 hidden="@(!IsEditMode && activeStep != TaskEditorStep.Assignment)"
                 data-testid="project-structure-task-assignment-section">
            <summary hidden="@(!IsEditMode)" @onclick="ToggleAssignment" @onclick:preventDefault="true">@AssignmentSummary</summary>

            <Stack GapScale="LayoutGap.Small"
                   AlignItems="AlignItems.Stretch">
                <Cluster Gap="LayoutGap.Small"
                         AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween"
                         Wrap="FlexWrap.Wrap">
                    <Stack GapScale="LayoutGap.XSmall">
                        <TextBlock TextStyle="TextStyle.Subtitle2"
                                   Value="@(IsEditMode ? "Optional task resource" : "Optional person or agent")" />
                        <TextBlock TextStyle="TextStyle.Note"
                                   Value="@(IsEditMode
                                       ? "Choose a person or agent as the direct assignee, or attach a workflow or process definition. Definition resources are additive and do not replace the assignee."
                                       : "The selected CRM person or synchronized AI agent is assigned directly to this task. No child node is created.")" />
                    </Stack>
                    @if (CanClearSelectedResource)
                    {
                        <Button Text="Clear selection"
                                Icon="close"
                                Size="ButtonSize.Small"
                                Variant="Variant.Text"
                                Tone="ButtonTone.Default"
                                data-testid="project-structure-task-create-assignee-clear"
                                Click="ClearResourceAsync" />
                    }
                </Cluster>

                <ProjectStructureTaskResourcePicker Options="@ResourceOptions"
                                                    SelectedResource="@selectedResource"
                                                    SelectionChanged="SelectResourceAsync"
                                                    AllowedKinds="@SelectableResourceKinds"
                                                    SearchPlaceholder="@(IsEditMode
                                                        ? "Search people, agents, workflows, and processes"
                                                        : "Search CRM people and synchronized agents")"
                                                    EmptyEyebrow="@(IsEditMode ? "No resources" : "No assignees")"
                                                    EmptyTitle="@(IsEditMode
                                                        ? "No task resources match the current filters"
                                                        : "No people or agents match the current filters")"
                                                    EmptyDescription="Change the resource-type filters, clear the search, or save without selecting a resource."
                                                    OptionTestIdPrefix="project-structure-task-create-assignee"
                                                    DataTestId="project-structure-task-create-assignee-picker" />

                <ProjectStructureTaskResourceCostEstimator @ref="costEstimator"
                                                           ProjectId="@ProjectId"
                                                           Context="@QuoteContext"
                                                           SelectedResource="@selectedResource"
                                                           Estimate="@estimate"
                                                           EstimateChanged="HandleEstimateChangedAsync"
                                                           InputRevision="estimateInputRevision" InputIsValid="estimateInputValid"
                                                           ExecutionState="@execution.State"
                                                           QuoteResolver="@QuoteResolver"
                                                           DataTestId="project-structure-task-create-resource-cost" />
            </Stack>

        </details>

        @if (!IsEditMode) {
            <Cluster Gap="LayoutGap.Small" JustifyContent="JustifyContent.SpaceBetween">
                <Button Text="Back" Icon="arrow_back" Variant="Variant.Text" Tone="ButtonTone.Default"
                        Disabled="@(activeStep == TaskEditorStep.Basics)"
                        data-testid="project-structure-task-step-back" Click="PreviousStep" />
                @if (activeStep != TaskEditorStep.Assignment) {
                    <Button Text="@(activeStep == TaskEditorStep.Basics ? "Next: planning" : "Next: assignment")"
                            Icon="arrow_forward" Variant="Variant.Outlined" Tone="ButtonTone.Default"
                            data-testid="project-structure-task-step-next" Click="NextStep" />
                }
            </Cluster>
        }

        @if (!string.IsNullOrWhiteSpace(validationError))
        {
            <Alert AlertStyle="AlertStyle.Danger"
                   data-testid="project-structure-task-create-validation-error">
                @validationError
            </Alert>
        }

    </Stack>

    <PlanningTaskFormActions Result="@submissionState.Result" IsBusy="@submissionState.IsBusy" IsEditMode="@IsEditMode"
                             SubmitBlocked="@(comparison?.BlocksInput == true || ComparisonOwner is { IsActive: false } || (!IsEditMode && string.IsNullOrWhiteSpace(title)))"
                             TestIdPrefix="project-structure-task-create" Submitted="SubmitAsync" Cancelled="Cancelled"
                             Readback="@(Readback is null ? default : EventCallback.Factory.Create(this, ReadbackAsync))" />
</Stack>

@code {
    private enum TaskEditorStep { Basics, Planning, Assignment }
    private TaskEditorStep activeStep;
    private bool planningExpanded;
    private bool executionExpanded;
    private bool assignmentExpanded;

    private string PlanningSummary => !string.IsNullOrWhiteSpace(dueText) || estimate.ExpectedEffortHours.HasValue || estimate.ExpectedCostAmount.HasValue
        ? "Planning · schedule or estimate set" : "Planning (optional)";
    private string AssignmentSummary => selectedResource is { } resource
        ? $"Assignment · {resource.Kind}" : !CanEditDirectAssignee ? "Assignment · existing assignments retained" : "Assignment (optional)";
    private string RepositoryLabel => string.IsNullOrWhiteSpace(repositoryNodeId) ? "Not linked"
        : RepositoryOptions.FirstOrDefault(option => string.Equals(option.Value, repositoryNodeId, StringComparison.Ordinal))?.Label
            ?? "Linked repository unavailable";

    private void ChangeStep(int value) {
        if (Enum.IsDefined(typeof(TaskEditorStep), value)) {
            ShowStep((TaskEditorStep)value);
        }
    }

    private void ShowStep(TaskEditorStep step) {
        activeStep = step;
        if (step == TaskEditorStep.Planning) {
            planningExpanded = true;
        }
    }

    private void PreviousStep() => ShowStep(activeStep == TaskEditorStep.Assignment ? TaskEditorStep.Planning : TaskEditorStep.Basics);
    private void NextStep() => ShowStep(activeStep == TaskEditorStep.Basics ? TaskEditorStep.Planning : TaskEditorStep.Assignment);
    private void TogglePlanning() => planningExpanded = !planningExpanded;
    private void ToggleExecution() => executionExpanded = !executionExpanded;
    private void ToggleAssignment() => assignmentExpanded = !assignmentExpanded;

    private readonly TaskEditorSubmissionState submissionState = new();
    private PlanningTaskLeaveGuard? leaveGuard;
    private PlanningTaskEditorInput? initialInput;
    private PlanningTaskComparison? comparison;
    private PlanningTaskComparisonCurrent? acceptedComparison;
    [Parameter] public IPlanningTaskComparisonOwner? ComparisonOwner { get; set; }
    private bool CanEditDirectAssignee => acceptedComparison?.CanChangeDirectAssignee ?? CanChangeDirectAssignee;
    private Task ComparisonChanged() {
        StateHasChanged();
        return Task.CompletedTask;
    }

    private bool ApplyComparison(PlanningTaskLocalPatch patch, Func<bool> accept) {
        if (!submissionState.CanAcceptComparison || CaptureInput() != patch.Expected ||
            patch.Result is not PlanningTaskEditorInput.Structure { Estimate: { } rawEstimate, Execution: { } rawExecution } result ||
            patch.Current.Input is not PlanningTaskEditorInput.Structure { Execution: { } currentExecution } ||
            !Enum.IsDefined(rawExecution.State) || !Enum.IsDefined(currentExecution.State) ||
            estimateEditor is null || executionEditor is null || !accept()) {
            return false;
        }
        acceptedComparison = patch.Current;
        initialInput = patch.Current.Input;
        title = result.Title;
        subtitle = result.Subtitle;
        notes = result.Notes;
        dueText = result.Due;
        dueUtc = TryParseUtc(dueText, out var due) ? due : null;
        repositoryNodeId = result.Repository;
        proposedAssignee = result.Assignee;
        resourceToAttach = result.Attachment;
        selectedResource = result.SelectedResource;
        estimateBeforeDefinitionSelection = null;
        estimateBeforeDirectAssigneeSelection = null;
        estimateEditor.ApplyInput(rawEstimate);
        estimateInputValid = estimateEditor.TryGetValue(out var parsedEstimate, out validationError);
        if (estimateInputValid) {
            estimate = parsedEstimate;
        }
        execution = executionEditor.ApplyInput(rawExecution, currentExecution);
        if (!executionEditor.TryGetValue(out _, out var executionError)) {
            validationError = executionError;
        }
        estimateInputRevision++;
        submissionState.AcceptComparison();
        return true;
    }

    private PlanningTaskEditorInput CaptureInput() => new PlanningTaskEditorInput.Structure(title, subtitle, notes,
        dueText, repositoryNodeId, estimateEditor?.CaptureInput(), executionEditor?.CaptureInput(), proposedAssignee,
        resourceToAttach, selectedResource);

    public PlanningTaskCloseRequest ReadCloseRequest() {
        var input = CaptureInput();
        return new(QuoteContext.OpeningId, input, input != initialInput, submissionState.IsBusy, submissionState.Result) { Comparison = comparison?.CaptureState() };
    }

    public Task<bool> ConfirmLeaveAsync() => leaveGuard?.RequestLeaveAsync() ?? Task.FromResult(false);

    protected override void OnAfterRender(bool firstRender) {
        if (firstRender) {
            initialInput = CaptureInput();
            StateHasChanged();
        }
    }
    private long estimateInputRevision;
    private bool estimateInputValid = true;
    private void EstimateInputChanged(bool valid) {
        estimateInputRevision++;
        estimateInputValid = valid;
        estimateBeforeDefinitionSelection = null;
        estimateBeforeDirectAssigneeSelection = null;
    }
    [Parameter] public EventCallback Cancelled { get; set; }
    [Parameter] public Func<Task<PlanningTaskSaveResult>>? Readback { get; set; }
    private Task ReadbackAsync() => Readback is { } read ? submissionState.ReadbackAsync(read, Logger) : Task.CompletedTask;
    public void Dispose() => submissionState.Dispose();

    private const string DateTimeLocalFormat = "yyyy-MM-ddTHH:mm";
    private const string TaskSubtype = "task";
    private static readonly IReadOnlySet<ProjectStructureTaskResourceKind> DirectAssigneeKinds =
        new HashSet<ProjectStructureTaskResourceKind>
        {
            ProjectStructureTaskResourceKind.Person,
            ProjectStructureTaskResourceKind.Agent
        };
    private static readonly IReadOnlySet<ProjectStructureTaskResourceKind> AllResourceKinds =
        Enum.GetValues<ProjectStructureTaskResourceKind>().ToHashSet();
    private static readonly IReadOnlySet<ProjectStructureTaskResourceKind> DefinitionResourceKinds =
        new HashSet<ProjectStructureTaskResourceKind>
        {
            ProjectStructureTaskResourceKind.Workflow,
            ProjectStructureTaskResourceKind.Process
        };
    private static readonly HashSet<string> ControlledInputKeys = new(StringComparer.OrdinalIgnoreCase)
    {
        "workItemKind",
        "assigneeRef",
        ProjectTaskInputKeys.DueUtc,
        ProjectTaskInputKeys.RepositoryRef,
        ProjectTaskEstimateInputKeys.ExpectedEffortValue,
        ProjectTaskEstimateInputKeys.ExpectedEffortUnit,
        ProjectTaskEstimateInputKeys.ExpectedCostAmount,
        ProjectTaskEstimateInputKeys.ExpectedCostCurrencyCode
    };

    private bool initialized;
    private TaskEstimateInputText? initialEstimateInput;
    private CanvasWorkbenchCreateActionRequest acceptedRequest = default!;
    private string title = string.Empty;
    private string subtitle = string.Empty;
    private string notes = string.Empty;
    private DateTimeOffset? dueUtc;
    private string dueText = string.Empty;
    private string? repositoryNodeId;
    private ProjectStructureTaskResourceSelection? proposedAssignee;
    private ProjectStructureTaskResourceSelection? resourceToAttach;
    private ProjectStructureTaskResourceSelection? selectedResource;
    private ProjectTaskEstimate estimate = ProjectTaskEstimate.Empty();
    private ProjectTaskEstimate? estimateBeforeDefinitionSelection;
    private ProjectTaskEstimate? estimateBeforeDirectAssigneeSelection;
    private ProjectTaskExecutionSnapshot execution = ProjectTaskExecutionSnapshot.NotStarted;
    private ProjectStructureTaskEstimateEditor? estimateEditor;
    private ProjectStructureTaskExecutionEditor? executionEditor;
    private ProjectStructureTaskResourceCostEstimator? costEstimator;
    private string validationError = string.Empty;

    [Parameter, EditorRequired]
    public CanvasWorkbenchCreateActionRequest CreateRequest { get; set; } = default!;

    [Parameter, EditorRequired]
    public Guid ProjectId { get; set; }

    [Parameter]
    public ProjectTaskQuoteContext QuoteContext { get; set; } = new(Guid.Empty, Guid.Empty, Guid.NewGuid());

    [Parameter]
    public bool IsEditMode { get; set; }

    [Parameter]
    public ProjectStructureTaskResourceSelection? InitialAssignee { get; set; }

    [Parameter]
    public ProjectTaskExecutionSnapshot InitialExecution { get; set; } =
        ProjectTaskExecutionSnapshot.Unknown;

    [Parameter]
    public bool CanChangeDirectAssignee { get; set; } = true;

    [Parameter]
    public IReadOnlyList<CanvasWorkbenchInputOption> RepositoryOptions { get; set; } = [];

    [Parameter]
    public IReadOnlyList<ProjectStructureTaskResourceOption> ResourceOptions { get; set; } = [];

    [Parameter]
    public IReadOnlyList<string> ResourceWarnings { get; set; } = [];

    [Parameter]
    public Func<ProjectStructureTaskResourceCostRequest, CancellationToken, Task<ProjectStructureTaskResourceCostQuote>>? QuoteResolver { get; set; }

    private bool CanClearSelectedResource =>
        selectedResource is not null &&
        (resourceToAttach is not null || CanEditDirectAssignee);

    private IReadOnlySet<ProjectStructureTaskResourceKind> SelectableResourceKinds =>
        !IsEditMode
            ? DirectAssigneeKinds
            : CanEditDirectAssignee
                ? AllResourceKinds
                : DefinitionResourceKinds;

    protected override void OnParametersSet()
    {
        if (initialized)
        {
            return;
        }

        initialized = true;
        acceptedRequest = CreateRequest with {
            InputValues = CreateRequest.InputValues?.Select(value => new CanvasWorkbenchInputValue { Key = value.Key, Value = value.Value }).ToArray()
        };
        title = CreateRequest.Title ?? string.Empty;
        subtitle = CreateRequest.Subtitle ?? string.Empty;
        notes = CreateRequest.Notes ?? string.Empty;
        proposedAssignee = InitialAssignee;
        selectedResource = CanEditDirectAssignee
            ? InitialAssignee
            : null;
        execution = IsEditMode ? InitialExecution : ProjectTaskExecutionSnapshot.NotStarted;
        var inputValues = CreateRequest.InputValues ?? [];
        estimate = ResolveEstimate(inputValues);
        repositoryNodeId = inputValues
            .LastOrDefault(value => string.Equals(value.Key, ProjectTaskInputKeys.RepositoryRef, StringComparison.OrdinalIgnoreCase))
            ?.Value;
        var dueValue = inputValues
            .LastOrDefault(value => string.Equals(value.Key, ProjectTaskInputKeys.DueUtc, StringComparison.OrdinalIgnoreCase))
            ?.Value;
        dueText = dueValue ?? string.Empty;
        if (TryParseUtc(dueValue, out var parsedDue))
        {
            dueUtc = parsedDue;
            dueText = FormatDateTimeLocal(parsedDue);
        }
    }

    private Task HandleTitleChangedAsync(string? value)
    {
        title = value ?? string.Empty;
        validationError = string.Empty;
        return Task.CompletedTask;
    }

    private Task HandleSubtitleChangedAsync(string? value)
    {
        subtitle = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task HandleNotesChangedAsync(string? value)
    {
        notes = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task HandleRepositoryChangedAsync(string? value)
    {
        repositoryNodeId = string.IsNullOrWhiteSpace(value) ? null : value;
        return Task.CompletedTask;
    }

    private void HandleDueChanged(ChangeEventArgs args)
    {
        var text = Convert.ToString(args.Value, CultureInfo.InvariantCulture);
        dueText = text ?? string.Empty;
        if (string.IsNullOrWhiteSpace(text))
        {
            dueUtc = null;
            validationError = string.Empty;
            return;
        }

        if (!TryParseUtc(text, out var parsedDue))
        {
            validationError = "Enter a valid UTC due date and time.";
            ShowStep(TaskEditorStep.Planning);
            return;
        }

        dueUtc = parsedDue;
        validationError = string.Empty;
    }

    private async Task SelectResourceAsync(ProjectStructureTaskResourceSelection selection)
    {
        if (!IsEditMode &&
            selection.Kind is not (ProjectStructureTaskResourceKind.Person or ProjectStructureTaskResourceKind.Agent))
        {
            return;
        }

        if (!CanEditDirectAssignee &&
            selection.Kind is ProjectStructureTaskResourceKind.Person or ProjectStructureTaskResourceKind.Agent)
        {
            return;
        }

        if (selection.Kind is ProjectStructureTaskResourceKind.Person or ProjectStructureTaskResourceKind.Agent)
        {
            selectedResource = selection;
            RestoreEstimateBeforeDefinitionSelection();
            if (proposedAssignee != selection)
            {
                estimateBeforeDirectAssigneeSelection ??= estimate;
            }

            proposedAssignee = selection;
            resourceToAttach = null;
        }
        else if (selection.Kind is ProjectStructureTaskResourceKind.Workflow or ProjectStructureTaskResourceKind.Process)
        {
            selectedResource = selection;
            estimateBeforeDefinitionSelection ??= estimate;
            resourceToAttach = selection;
        }
        else
        {
            return;
        }

        if (costEstimator is not null && estimateInputValid)
        {
            await costEstimator.EstimateSelectedAsync(selection, estimate);
        }
    }

    private async Task ClearResourceAsync()
    {
        if (resourceToAttach is not null)
        {
            resourceToAttach = null;
            selectedResource = CanEditDirectAssignee
                ? proposedAssignee
                : null;
            RestoreEstimateBeforeDefinitionSelection();
            if (CanEditDirectAssignee &&
                proposedAssignee is not null &&
                costEstimator is not null && estimateInputValid)
            {
                await costEstimator.EstimateSelectedAsync(proposedAssignee, estimate);
            }

            return;
        }

        if (!CanEditDirectAssignee)
        {
            return;
        }

        proposedAssignee = null;
        selectedResource = null;
        RestoreEstimateBeforeDirectAssigneeSelection();
    }

    private void RestoreEstimateBeforeDefinitionSelection()
    {
        if (estimateBeforeDefinitionSelection is not { } previousEstimate)
        {
            return;
        }

        estimate = estimate with
        {
            ExpectedCostAmount = previousEstimate.ExpectedCostAmount,
            ExpectedCostCurrencyCode = previousEstimate.ExpectedCostCurrencyCode
        };
        estimateBeforeDefinitionSelection = null;
    }

    private void RestoreEstimateBeforeDirectAssigneeSelection()
    {
        if (estimateBeforeDirectAssigneeSelection is not { } previousEstimate)
        {
            return;
        }

        estimate = estimate with
        {
            ExpectedCostAmount = previousEstimate.ExpectedCostAmount,
            ExpectedCostCurrencyCode = previousEstimate.ExpectedCostCurrencyCode
        };
        estimateBeforeDirectAssigneeSelection = null;
    }

    private Task HandleEstimateChangedAsync(ProjectTaskEstimate value)
    {
        estimate = value;
        validationError = string.Empty;
        return Task.CompletedTask;
    }

    private Task HandleExecutionChangedAsync(ProjectTaskExecutionSnapshot value)
    {
        execution = value;
        validationError = string.Empty;
        return Task.CompletedTask;
    }

    private async Task SubmitAsync()
    {
        if (!submissionState.CanSubmit || comparison?.BlocksInput == true || ComparisonOwner is { IsActive: false }) {
            return;
        }
        if (!string.IsNullOrWhiteSpace(dueText) && !TryParseUtc(dueText, out _)) {
            validationError = "Enter a valid UTC due date and time.";
            ShowStep(TaskEditorStep.Planning);
            return;
        }
        dueUtc = string.IsNullOrWhiteSpace(dueText) ? null : DateTimeOffset.Parse(dueText,
            CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal);
        var normalizedTitle = title.Trim();
        if (normalizedTitle.Length == 0)
        {
            validationError = "Task title is required.";
            ShowStep(TaskEditorStep.Basics);
            return;
        }

        if (normalizedTitle.Length > 200)
        {
            validationError = "Task title cannot exceed 200 characters.";
            ShowStep(TaskEditorStep.Basics);
            return;
        }

        if (estimateEditor is null)
        {
            validationError = "Task estimate details are not ready.";
            ShowStep(TaskEditorStep.Planning);
            return;
        }

        if (!estimateEditor.TryGetValue(out estimate, out var estimateError))
        {
            validationError = estimateError;
            ShowStep(TaskEditorStep.Planning);
            return;
        }

        if (IsEditMode)
        {
            var executionError = string.Empty;
            if (executionEditor is null ||
                !executionEditor.TryGetValue(out execution, out executionError))
            {
                validationError = string.IsNullOrWhiteSpace(executionError)
                    ? "The task execution state is not ready."
                    : executionError;
                ShowStep(TaskEditorStep.Planning);
                executionExpanded = true;
                return;
            }
        }

        var inputValues = (acceptedRequest.InputValues ?? [])
            .Where(value => !ControlledInputKeys.Contains(value.Key))
            .Select(value => new CanvasWorkbenchInputValue
            {
                Key = value.Key,
                Value = value.Value
            })
            .ToList();
        inputValues.Add(new CanvasWorkbenchInputValue
        {
            Key = "workItemKind",
            Value = "task"
        });
        inputValues.Add(new CanvasWorkbenchInputValue { Key = ProjectTaskInputKeys.DueUtc, Value = dueUtc?.ToString("O", CultureInfo.InvariantCulture) ?? string.Empty });
        AddInputValue(inputValues, ProjectTaskInputKeys.RepositoryRef, repositoryNodeId);
        AddEstimateInputValues(inputValues, estimate);

        var result = new ProjectStructureTaskDialogResult(
            acceptedRequest with
            {
                Title = normalizedTitle,
                Subtitle = subtitle.Trim(),
                Notes = notes.Trim(),
                CreateMode = ProjectStructureTaskActionIds.CreateMode,
                ObjectSubtype = TaskSubtype,
                InputValues = inputValues.ToArray()
            },
            proposedAssignee,
            execution,
            estimate,
            IsEditMode ? resourceToAttach : null);
        var submit = Submitted;
        estimateInputRevision++;
        await submissionState.SaveAsync(() => submit is null
            ? Task.FromResult(new PlanningTaskSaveResult(PlanningTaskSaveStatus.Rejected,
                "This task editor is not connected to a save owner.", [], [], [])) : submit(result), Logger);
    }

    [Parameter] public string DefaultCurrencyCode { get; set; } = string.Empty;
    [Parameter] public Func<ProjectStructureTaskDialogResult, Task<PlanningTaskSaveResult>>? Submitted { get; set; }

    private static void AddInputValue(List<CanvasWorkbenchInputValue> values, string key, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        values.Add(new CanvasWorkbenchInputValue
        {
            Key = key,
            Value = value
        });
    }

    private static void AddEstimateInputValues(
        List<CanvasWorkbenchInputValue> values,
        ProjectTaskEstimate value)
    {
        var effortValue = ProjectTaskEstimatePolicy.ToInputValue(value);
        AddInputValue(
            values,
            ProjectTaskEstimateInputKeys.ExpectedEffortValue,
            effortValue?.ToString(CultureInfo.InvariantCulture));
        AddInputValue(
            values,
            ProjectTaskEstimateInputKeys.ExpectedEffortUnit,
            ToCamelCaseToken(value.ExpectedEffortUnit));
        AddInputValue(
            values,
            ProjectTaskEstimateInputKeys.ExpectedCostAmount,
            value.ExpectedCostAmount?.ToString(CultureInfo.InvariantCulture));
        AddInputValue(
            values,
            ProjectTaskEstimateInputKeys.ExpectedCostCurrencyCode,
            value.ExpectedCostAmount.HasValue ? value.ExpectedCostCurrencyCode : null);
    }

    private ProjectTaskEstimate ResolveEstimate(IReadOnlyList<CanvasWorkbenchInputValue> inputValues) {
        var values = inputValues.Where(value => !string.IsNullOrWhiteSpace(value.Key))
            .GroupBy(value => value.Key, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(group => group.Key, group => group.Last().Value ?? string.Empty, StringComparer.OrdinalIgnoreCase);
        var unit = values.GetValueOrDefault(ProjectTaskEstimateInputKeys.ExpectedEffortUnit);
        initialEstimateInput = new(values.GetValueOrDefault(ProjectTaskEstimateInputKeys.ExpectedEffortValue, "8"),
            string.IsNullOrWhiteSpace(unit) ? nameof(ProjectWorkItemEffortUnit.Hours) : unit,
            values.GetValueOrDefault(ProjectTaskEstimateInputKeys.ExpectedCostAmount, string.Empty),
            values.GetValueOrDefault(ProjectTaskEstimateInputKeys.ExpectedCostCurrencyCode, DefaultCurrencyCode));
        try {
            return initialEstimateInput.Parse();
        } catch (Exception exception) when (exception is InvalidOperationException or FormatException or ArgumentException or OverflowException) {
            estimateInputValid = false;
            validationError = exception.Message;
            return ProjectTaskEstimate.Empty();
        }
    }

    private static string ToCamelCaseToken(ProjectWorkItemEffortUnit value)
    {
        var token = value.ToString();
        return char.ToLowerInvariant(token[0]) + token[1..];
    }

    private static string FormatDateTimeLocal(DateTimeOffset? value)
        => value?.ToUniversalTime().ToString(value.Value.Ticks % TimeSpan.TicksPerMinute == 0
            ? DateTimeLocalFormat : "yyyy-MM-ddTHH:mm:ss.FFFFFFF", CultureInfo.InvariantCulture) ?? string.Empty;

    private static bool TryParseUtc(string? value, out DateTimeOffset result)
    {
        if (DateTimeOffset.TryParse(
                value,
                CultureInfo.InvariantCulture,
                DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal,
                out var parsed))
        {
            result = parsed.ToUniversalTime();
            return true;
        }

        result = default;
        return false;
    }

}

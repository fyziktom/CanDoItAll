<FormSection Title="Tool configuration"
                 Description="Edit external process or HTTP runtime parameters, bounded execution, and setup-test input.">
        <Grid Gap="LayoutGap.Large" ColumnsLg="3">
            <FormField Text="Tool setup kind">
                <SelectInput @bind-Value="Draft.ToolKind"
                             disabled="@Locked"
                             data-testid="@($"{TestId}-tool-kind")">
                    <option value="externalProcess">External process</option>
                    <option value="externalHttp">External HTTP</option>
                </SelectInput>
            </FormField>
            <div>
                <label class="cda-form-field__label">Runtime tool name</label>
                <AuthoringText @bind-Value="Draft.RuntimeToolName"
                           class="form-input ui-input ui-input--outlined"
                           disabled="@Locked"
                           data-testid="@($"{TestId}-tool-runtime-name")" />
            </div>
            <div>
                <label class="cda-form-field__label">Implementation key</label>
                <AuthoringText @bind-Value="Draft.ImplementationKey"
                           class="form-input ui-input ui-input--outlined"
                           disabled="@Locked"
                           data-testid="@($"{TestId}-tool-implementation-key")" />
            </div>
        </Grid>

        <Grid Gap="LayoutGap.Large" ColumnsLg="3">
            <div>
                <label class="cda-form-field__label">Operation classifications</label>
                <AuthoringTextArea @bind-Value="Draft.OperationClassificationsText"
                               class="form-input ui-input ui-input--outlined ui-input--textarea capability-authoring__small-textarea"
                               disabled="@Locked"
                               data-testid="@($"{TestId}-tool-classifications")" />
            </div>
            <div>
                <label class="cda-form-field__label">Side-effect kind</label>
                <AuthoringText @bind-Value="Draft.SideEffectKind"
                           class="form-input ui-input ui-input--outlined"
                           disabled="@Locked"
                           data-testid="@($"{TestId}-tool-side-effect")" />
            </div>
            <Stack Gap="0.5rem">
                <label class="ui-checkbox-option capability-authoring__inline-option">
                    <InputCheckbox class="form-checkbox ui-checkbox ui-checkbox--outlined" @bind-Value="Draft.RequiresApprovalByDefault"
                                   disabled="@Locked"
                                   data-testid="@($"{TestId}-tool-approval")" />
                    Requires approval
                </label>
                <label class="ui-checkbox-option capability-authoring__inline-option">
                    <InputCheckbox class="form-checkbox ui-checkbox ui-checkbox--outlined" @bind-Value="Draft.IsStateChanging"
                                   disabled="@Locked"
                                   data-testid="@($"{TestId}-tool-state-changing")" />
                    State changing
                </label>
            </Stack>
        </Grid>

        @if (string.Equals(Draft.ToolKind, "externalHttp", StringComparison.OrdinalIgnoreCase)) {
            <Grid Gap="LayoutGap.Large" ColumnsLg="3">
                <div>
                    <label class="cda-form-field__label">HTTP method</label>
                    <AuthoringText @bind-Value="Draft.HttpMethod"
                               class="form-input ui-input ui-input--outlined"
                               disabled="@Locked"
                               data-testid="@($"{TestId}-tool-http-method")" />
                </div>
                <div>
                    <label class="cda-form-field__label">Endpoint</label>
                    <AuthoringText @bind-Value="Draft.Endpoint"
                               class="form-input ui-input ui-input--outlined"
                               disabled="@Locked"
                               data-testid="@($"{TestId}-tool-http-endpoint")" />
                </div>
                <div>
                    <label class="cda-form-field__label">Timeout seconds</label>
                    <AuthoringText inputmode="numeric" @bind-Value="Draft.HttpTimeoutSecondsText"
                                 class="form-input ui-input ui-input--outlined"
                                 disabled="@Locked"
                                 data-testid="@($"{TestId}-tool-http-timeout")" />
                </div>
            </Grid>

            <Grid Gap="LayoutGap.Large" ColumnsLg="3">
                <div>
                    <label class="cda-form-field__label">Header bindings</label>
                    <AuthoringTextArea @bind-Value="Draft.HeaderBindingsText"
                                   class="form-input ui-input ui-input--outlined ui-input--textarea capability-authoring__small-textarea"
                                   disabled="@Locked"
                                   data-testid="@($"{TestId}-tool-http-header-bindings")" />
                </div>
                <div>
                    <label class="cda-form-field__label">Required output properties</label>
                    <AuthoringTextArea @bind-Value="Draft.HttpRequiredOutputPropertiesText"
                                   class="form-input ui-input ui-input--outlined ui-input--textarea capability-authoring__small-textarea"
                                   disabled="@Locked"
                                   data-testid="@($"{TestId}-tool-http-output")" />
                </div>
                <div>
                    <label class="cda-form-field__label">Max response bytes</label>
                    <AuthoringText inputmode="numeric" @bind-Value="Draft.MaxResponseBytesText"
                                 class="form-input ui-input ui-input--outlined"
                                 disabled="@Locked"
                                 data-testid="@($"{TestId}-tool-http-max-response")" />
                </div>
            </Grid>
        } else {
            <Grid Gap="LayoutGap.Large" ColumnsLg="3">
                <div>
                    <label class="cda-form-field__label">Command</label>
                    <AuthoringText @bind-Value="Draft.Command"
                               class="form-input ui-input ui-input--outlined"
                               disabled="@Locked"
                               data-testid="@($"{TestId}-tool-process-command")" />
                </div>
                <div>
                    <label class="cda-form-field__label">Working directory</label>
                    <AuthoringText @bind-Value="Draft.WorkingDirectory"
                               class="form-input ui-input ui-input--outlined"
                               disabled="@Locked"
                               data-testid="@($"{TestId}-tool-process-working-directory")" />
                </div>
                <div>
                    <label class="cda-form-field__label">Timeout seconds</label>
                    <AuthoringText inputmode="numeric" @bind-Value="Draft.ProcessTimeoutSecondsText"
                                 class="form-input ui-input ui-input--outlined"
                                 disabled="@Locked"
                                 data-testid="@($"{TestId}-tool-process-timeout")" />
                </div>
            </Grid>

            <Grid Gap="LayoutGap.Large" ColumnsLg="3">
                <div>
                    <label class="cda-form-field__label">Arguments</label>
                    <AuthoringTextArea @bind-Value="Draft.ArgumentsText"
                                   class="form-input ui-input ui-input--outlined ui-input--textarea capability-authoring__small-textarea"
                                   disabled="@Locked"
                                   data-testid="@($"{TestId}-tool-process-arguments")" />
                </div>
                <div>
                    <label class="cda-form-field__label">Allowed executable names</label>
                    <AuthoringTextArea @bind-Value="Draft.AllowedExecutableNamesText"
                                   class="form-input ui-input ui-input--outlined ui-input--textarea capability-authoring__small-textarea"
                                   disabled="@Locked"
                                   data-testid="@($"{TestId}-tool-process-allowed-executables")" />
                </div>
                <div>
                    <label class="cda-form-field__label">Required output properties</label>
                    <AuthoringTextArea @bind-Value="Draft.ProcessRequiredOutputPropertiesText"
                                   class="form-input ui-input ui-input--outlined ui-input--textarea capability-authoring__small-textarea"
                                   disabled="@Locked"
                                   data-testid="@($"{TestId}-tool-process-output")" />
                </div>
            </Grid>

            <div>
                <label class="cda-form-field__label">Max output bytes</label>
                <AuthoringText inputmode="numeric" @bind-Value="Draft.MaxOutputBytesText"
                             class="form-input ui-input ui-input--outlined"
                             disabled="@Locked"
                             data-testid="@($"{TestId}-tool-process-max-output")" />
            </div>
        }
    </FormSection>

@code {
    [Parameter, EditorRequired] public ToolCapabilityDraft Draft { get; set; } = default!;
    [Parameter, EditorRequired] public string TestId { get; set; } = string.Empty;
    [Parameter] public bool Locked { get; set; }
}

<FormSection Title="@(Draft.IsWizard ? "Type and identity" : "Capability identity")" Description="Edit the catalog definition. Assignment to an agent and runtime access remain separate actions.">
    <Grid Gap="LayoutGap.Large" ColumnsLg="3">
        <FormField Text="Kind">
            <SelectInput TValue="CapabilityKind" Value="Draft.Model.Kind" ValueChanged="Draft.ChangeKind" ValueExpression="@(() => Draft.Model.Kind)" disabled="@Draft.Model.IsBuiltIn" class="form-input ui-input ui-input--outlined" data-testid="@($"{TestId}-kind")">
                @foreach (var kind in Kinds) {
                    <option value="@kind">@Label(kind)</option>
                }
            </SelectInput>
        </FormField>
        <div>
            <label class="cda-form-field__label">Name</label>
            <AuthoringText Value="@Draft.Model.Name" ValueChanged="Draft.ChangeName" ValueExpression="@(() => Draft.Model.Name)" disabled="@Draft.IdentityLocked" class="form-input ui-input ui-input--outlined" data-testid="@($"{TestId}-name")" />
        </div>
        <div>
            <label class="cda-form-field__label">Key</label>
            <AuthoringText Value="@Draft.Model.Key" ValueChanged="Draft.ChangeKey" ValueExpression="@(() => Draft.Model.Key)" disabled="@Draft.IdentityLocked" class="form-input ui-input ui-input--outlined" data-testid="@($"{TestId}-key")" />
        </div>
    </Grid>
    <div>
        <label class="cda-form-field__label">Description</label>
        <AuthoringTextArea @bind-Value="Draft.Model.Description" disabled="@Draft.IdentityLocked" class="form-input ui-input ui-input--outlined capability-authoring__small-textarea" data-testid="@($"{TestId}-description")" />
    </div>
    @if (!Draft.IsWizard) {
        <div>
            <label class="cda-form-field__label">Endpoint or path</label>
            <AuthoringText @bind-Value="Draft.Model.EndpointOrPath" disabled="@Draft.IdentityLocked" class="form-input ui-input ui-input--outlined" data-testid="@($"{TestId}-endpoint")" />
        </div>
    }
    <TagEditor Value="Draft.Model.Tags" ValueChanged="ChangeTags" PendingInput="@Draft.PendingTagInput" PendingInputChanged="ChangePendingTag"
               Suggestions="TagSuggestions" Placeholder="Add capability tag" MaxTags="12" TestId="@($"{TestId}-tags")" InputTestId="@($"{TestId}-tags-input")" />
</FormSection>

@code {
    [Parameter, EditorRequired] public CapabilityAuthoringDraft Draft { get; set; } = default!;
    [Parameter, EditorRequired] public string TestId { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<string> TagSuggestions { get; set; } = [];
    private IEnumerable<CapabilityKind> Kinds => Draft.IsWizard
        ? [CapabilityKind.McpServer, CapabilityKind.Skill, CapabilityKind.Tool]
        : new[] { CapabilityKind.McpServer, CapabilityKind.Skill, CapabilityKind.Tool, CapabilityKind.Plugin, CapabilityKind.Rag, CapabilityKind.AiContext, Draft.Model.Kind }.Distinct();
    private static string Label(CapabilityKind kind) => kind switch {
        CapabilityKind.McpServer => "MCP server",
        CapabilityKind.AiContext => "AI context",
        _ => kind.ToString()
    };
    private void ChangeTags(IReadOnlyList<string> tags) {
        Draft.Model.Tags = tags.ToList();
        Draft.Changed();
    }

    private void ChangePendingTag(string value) {
        Draft.PendingTagInput = value;
        Draft.Changed();
    }
}

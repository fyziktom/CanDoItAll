@{ var editorModel = State.Draft; }
<FormSection Title="Workspace Tools" Description="These settings decide whether the current agent receives native workspace file tools, external workspace roots, and storage-driver tools.">
    <Grid Gap="LayoutGap.Large" ColumnsMd="3" data-testid="agents-catalog-workspace-tools">
        <div class="cda-admin-subpanel">
            <label class="cda-field-label" for="agents-catalog-workspace-profile">Access profile</label>
            <select id="agents-catalog-workspace-profile"
                    class="cda-input mt-2"
                    value="@editorModel.WorkspaceToolAccess.Profile"
                    @onchange="args => State.ChangeProfileAsync(args.Value)"
                    data-testid="agents-catalog-workspace-profile">
                @foreach (var profile in State.WorkspaceToolProfileOptions) {
                    <option value="@profile">@State.FormatWorkspaceToolProfile(profile)</option>
                }
            </select>
            <p class="mt-3 text-sm leading-6 text-slate-600">
                @State.DescribeWorkspaceExecutionScope(editorModel)
            </p>
        </div>
        <div class="cda-admin-subpanel md:col-span-2">
            <p class="cda-field-label mb-2">Execution tools</p>
            <Grid Gap="LayoutGap.Small" ColumnsMd="2">
                <label class="cda-inline-option">
                    <input type="checkbox"
                           checked="@editorModel.WorkspaceToolAccess.CanRunValidationCommands"
                           @onchange="args => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.WorkspaceValidationCommands, args.Value is true))"
                           data-testid="agents-catalog-workspace-validation" />
                    Can run build, test, and app commands
                </label>
                <label class="cda-inline-option">
                    <input @key="@($"scripts-{State.WorkspaceRiskInputVersion}")"
                           type="checkbox"
                           checked="@editorModel.WorkspaceToolAccess.CanRunLocalScripts"
                           disabled="@State.ConfirmingWorkspaceRisk"
                           @onchange="args => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.WorkspaceLocalScripts, args.Value is true))"
                           data-testid="agents-catalog-workspace-scripts" />
                    Can run local scripts
                </label>
                <label class="cda-inline-option">
                    <input @key="@($"environment-{State.WorkspaceRiskInputVersion}")"
                           type="checkbox"
                           checked="@editorModel.WorkspaceToolAccess.CanScriptsReadEnvironment"
                           disabled="@(State.ConfirmingWorkspaceRisk || !editorModel.WorkspaceToolAccess.CanRunLocalScripts)"
                           @onchange="args => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.ScriptsReadEnvironment, args.Value is true))"
                           data-testid="agents-catalog-workspace-scripts-environment" />
                    Scripts may read environment variables
                </label>
                <label class="cda-inline-option">
                    <input type="checkbox"
                           checked="@editorModel.WorkspaceToolAccess.CanScaffoldProjects"
                           @onchange="args => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.WorkspaceScaffoldProjects, args.Value is true))"
                           data-testid="agents-catalog-workspace-scaffold" />
                    Can scaffold projects
                </label>
                <label class="cda-inline-option">
                    <input type="checkbox"
                           checked="@editorModel.WorkspaceToolAccess.CanManageWorkspacePaths"
                           @onchange="args => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.WorkspaceManagePaths, args.Value is true))"
                           data-testid="agents-catalog-workspace-manage-paths" />
                    Can move, copy, and delete paths
                </label>
                <label class="cda-inline-option">
                    <input type="checkbox"
                           checked="@editorModel.WorkspaceToolAccess.CanTransformArtifacts"
                           @onchange="args => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.WorkspaceTransformArtifacts, args.Value is true))"
                           data-testid="agents-catalog-workspace-transform" />
                    Can transform artifacts
                </label>
            </Grid>
            @if (editorModel.WorkspaceToolAccess.CanRunLocalScripts) {
                <Alert AlertStyle="AlertStyle.Warning" class="mt-3" data-testid="agents-catalog-workspace-scripts-warning">
                    <p class="font-semibold">Local scripts are enabled</p>
                    <p class="mt-1">Scripts run with your account's rights and are not sandboxed. They are inspected before they run, and runs need approval unless auto-approval is on.</p>
                    @if (editorModel.WorkspaceToolAccess.CanScriptsReadEnvironment) {
                        <p class="mt-1" data-testid="agents-catalog-workspace-scripts-environment-warning">Scripts may also read every environment variable passed to them, including operator proxy settings.</p>
                    }
                    else {
                        <p class="mt-1">Scripts that read environment variables beyond PATH, TEMP and HOME, or list all variables, are blocked until "Scripts may read environment variables" is enabled.</p>
                    }
                </Alert>
            }
        </div>
        <div class="cda-admin-subpanel">
            <p class="cda-field-label mb-2">File access</p>
            <Stack GapScale="LayoutGap.Small">
                <label class="cda-inline-option">
                    <input type="checkbox"
                           checked="@editorModel.WorkspaceToolAccess.CanReadFiles"
                           @onchange="args => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.WorkspaceFileRead, args.Value is true))"
                           data-testid="agents-catalog-workspace-read" />
                    Can browse and read files
                </label>
                <label class="cda-inline-option">
                    <input type="checkbox"
                           checked="@editorModel.WorkspaceToolAccess.CanWriteFiles"
                           @onchange="args => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.WorkspaceFileWrite, args.Value is true))"
                           data-testid="agents-catalog-workspace-write" />
                    Can write files
                </label>
            </Stack>
            <p class="mt-3 text-sm leading-6 text-slate-600">
                @State.DescribeWorkspaceFileScope(editorModel)
            </p>
        </div>
        <div class="cda-admin-subpanel md:col-span-2">
            @ExternalRoots
        </div>
        <div class="cda-admin-subpanel">
            <p class="cda-field-label mb-2">Storage access</p>
            <Stack GapScale="LayoutGap.Small">
                <label class="cda-inline-option">
                    <input type="checkbox"
                           checked="@editorModel.WorkspaceToolAccess.CanReadStorage"
                           @onchange="args => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.StorageRead, args.Value is true))"
                           data-testid="agents-catalog-storage-read" />
                    Can read storage driver catalogs
                </label>
                <label class="cda-inline-option">
                    <input type="checkbox"
                           checked="@editorModel.WorkspaceToolAccess.CanWriteStorage"
                           @onchange="args => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.StorageWrite, args.Value is true))"
                           data-testid="agents-catalog-storage-write" />
                    Can write storage driver objects
                </label>
                <label class="cda-inline-option">
                    <input type="checkbox"
                           checked="@editorModel.WorkspaceToolAccess.AllowAllStorageCatalogs"
                           @onchange="args => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.StorageAllowAll, args.Value is true))"
                           data-testid="agents-catalog-storage-all" />
                    Allow all storage catalogs
                </label>
            </Stack>
            <p class="mt-3 text-sm leading-6 text-slate-600">
                @State.DescribeStorageScope(editorModel)
            </p>
        </div>
        <div class="cda-admin-subpanel md:col-span-2">
            @StorageSelection
        </div>
    </Grid>
</FormSection>

@code {
    [Parameter, EditorRequired] public AgentEditorAccessState State { get; set; } = default!;
    [Parameter] public RenderFragment? ExternalRoots { get; set; }
    [Parameter] public RenderFragment? StorageSelection { get; set; }
}

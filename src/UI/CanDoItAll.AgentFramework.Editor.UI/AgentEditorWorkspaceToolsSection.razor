@{ var editorModel = State.Draft; }
<FormSection Title="Workspace Tools" Description="These settings decide whether the current agent receives native workspace file tools, external workspace roots, and storage-driver tools.">
    <Grid Gap="LayoutGap.Large" ColumnsMd="3" data-testid="agents-catalog-workspace-tools">
        <div class="app-admin-subpanel">
            <label class="cda-form-field__label" for="agents-catalog-workspace-profile">Access profile</label>
            <select id="agents-catalog-workspace-profile"
                    class="form-input ui-input ui-input--outlined mt-2"
                    value="@editorModel.WorkspaceToolAccess.Profile"
                    @onchange="args => State.ChangeProfileAsync(args.Value)"
                    data-testid="agents-catalog-workspace-profile">
                @foreach (var profile in State.WorkspaceToolProfileOptions) {
                    <option value="@profile">@State.FormatWorkspaceToolProfile(profile)</option>
                }
            </select>
            <p class="mt-3 text-sm leading-6 text-chrome-600">
                @State.DescribeWorkspaceExecutionScope(editorModel)
            </p>
        </div>
        <div class="app-admin-subpanel md:col-span-2">
            <TextBlock TextStyle="TextStyle.EyebrowCaption" Class="mb-2">Execution tools</TextBlock>
            <Grid Gap="LayoutGap.Small" ColumnsMd="2">
                <CheckboxOption TValue="bool"
                                Value="@editorModel.WorkspaceToolAccess.CanRunValidationCommands"
                                ValueChanged="value => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.WorkspaceValidationCommands, value))"
                                data-testid="agents-catalog-workspace-validation">
                    Can run build, test, and app commands
                </CheckboxOption>
                <CheckboxOption TValue="bool"
                                @key="@($"scripts-{State.WorkspaceRiskInputVersion}")"
                                Value="@editorModel.WorkspaceToolAccess.CanRunLocalScripts"
                                Disabled="@State.ConfirmingWorkspaceRisk"
                                ValueChanged="value => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.WorkspaceLocalScripts, value))"
                                data-testid="agents-catalog-workspace-scripts">
                    Can run local scripts
                </CheckboxOption>
                <CheckboxOption TValue="bool"
                                @key="@($"environment-{State.WorkspaceRiskInputVersion}")"
                                Value="@editorModel.WorkspaceToolAccess.CanScriptsReadEnvironment"
                                Disabled="@(State.ConfirmingWorkspaceRisk || !editorModel.WorkspaceToolAccess.CanRunLocalScripts)"
                                ValueChanged="value => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.ScriptsReadEnvironment, value))"
                                data-testid="agents-catalog-workspace-scripts-environment">
                    Scripts may read environment variables
                </CheckboxOption>
                <CheckboxOption TValue="bool"
                                Value="@editorModel.WorkspaceToolAccess.CanScaffoldProjects"
                                ValueChanged="value => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.WorkspaceScaffoldProjects, value))"
                                data-testid="agents-catalog-workspace-scaffold">
                    Can scaffold projects
                </CheckboxOption>
                <CheckboxOption TValue="bool"
                                Value="@editorModel.WorkspaceToolAccess.CanManageWorkspacePaths"
                                ValueChanged="value => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.WorkspaceManagePaths, value))"
                                data-testid="agents-catalog-workspace-manage-paths">
                    Can move, copy, and delete paths
                </CheckboxOption>
                <CheckboxOption TValue="bool"
                                Value="@editorModel.WorkspaceToolAccess.CanTransformArtifacts"
                                ValueChanged="value => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.WorkspaceTransformArtifacts, value))"
                                data-testid="agents-catalog-workspace-transform">
                    Can transform artifacts
                </CheckboxOption>
            </Grid>
            @if (editorModel.WorkspaceToolAccess.CanRunLocalScripts) {
                <Alert AlertStyle="AlertStyle.Warning" class="mt-3" data-testid="agents-catalog-workspace-scripts-warning">
                    <p class="font-semibold">Local scripts are enabled</p>
                    <p class="mt-1">Scripts run with your account's rights and are not sandboxed. They are inspected before they run, and runs need approval unless auto-approval is on.</p>
                    @if (editorModel.WorkspaceToolAccess.CanScriptsReadEnvironment) {
                        <p class="mt-1" data-testid="agents-catalog-workspace-scripts-environment-warning">Scripts may also read every environment variable passed to them, including operator proxy settings.</p>
                    }
                    else {
                        <p class="mt-1">Scripts that read environment variables beyond PATH, TEMP and HOME, or list all variables, are blocked until "Scripts may read environment variables" is enabled.</p>
                    }
                </Alert>
            }
        </div>
        <div class="app-admin-subpanel">
            <TextBlock TextStyle="TextStyle.EyebrowCaption" Class="mb-2">File access</TextBlock>
            <Stack GapScale="LayoutGap.Small">
                <CheckboxOption TValue="bool"
                                Value="@editorModel.WorkspaceToolAccess.CanReadFiles"
                                ValueChanged="value => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.WorkspaceFileRead, value))"
                                data-testid="agents-catalog-workspace-read">
                    Can browse and read files
                </CheckboxOption>
                <CheckboxOption TValue="bool"
                                Value="@editorModel.WorkspaceToolAccess.CanWriteFiles"
                                ValueChanged="value => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.WorkspaceFileWrite, value))"
                                data-testid="agents-catalog-workspace-write">
                    Can write files
                </CheckboxOption>
            </Stack>
            <p class="mt-3 text-sm leading-6 text-chrome-600">
                @State.DescribeWorkspaceFileScope(editorModel)
            </p>
        </div>
        <div class="app-admin-subpanel md:col-span-2">
            @ExternalRoots
        </div>
        <div class="app-admin-subpanel">
            <TextBlock TextStyle="TextStyle.EyebrowCaption" Class="mb-2">Storage access</TextBlock>
            <Stack GapScale="LayoutGap.Small">
                <CheckboxOption TValue="bool"
                                Value="@editorModel.WorkspaceToolAccess.CanReadStorage"
                                ValueChanged="value => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.StorageRead, value))"
                                data-testid="agents-catalog-storage-read">
                    Can read storage driver catalogs
                </CheckboxOption>
                <CheckboxOption TValue="bool"
                                Value="@editorModel.WorkspaceToolAccess.CanWriteStorage"
                                ValueChanged="value => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.StorageWrite, value))"
                                data-testid="agents-catalog-storage-write">
                    Can write storage driver objects
                </CheckboxOption>
                <CheckboxOption TValue="bool"
                                Value="@editorModel.WorkspaceToolAccess.AllowAllStorageCatalogs"
                                ValueChanged="value => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.StorageAllowAll, value))"
                                data-testid="agents-catalog-storage-all">
                    Allow all storage catalogs
                </CheckboxOption>
            </Stack>
            <p class="mt-3 text-sm leading-6 text-chrome-600">
                @State.DescribeStorageScope(editorModel)
            </p>
        </div>
        <div class="app-admin-subpanel md:col-span-2">
            @StorageSelection
        </div>
    </Grid>
</FormSection>

@code {
    [Parameter, EditorRequired] public AgentEditorAccessState State { get; set; } = default!;
    [Parameter] public RenderFragment? ExternalRoots { get; set; }
    [Parameter] public RenderFragment? StorageSelection { get; set; }
}

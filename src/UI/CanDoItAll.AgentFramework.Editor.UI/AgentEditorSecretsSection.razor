@{ var editorModel = State.Draft; }
<FormSection Title="Secrets" Description="Grant only the stored secrets this agent may request during explicit runtime actions. Values are not stored in the agent definition.">
    <Grid Gap="LayoutGap.Large" ColumnsMd="3" data-testid="agents-catalog-secrets">
        <div class="cda-admin-subpanel">
            <p class="cda-field-label mb-2">Allowed secrets</p>
            <p class="text-sm leading-6 text-slate-600">
                @State.DescribeSecretScope(editorModel)
            </p>
        </div>
        <div class="cda-admin-subpanel md:col-span-2">
            @if (State.SecretsLoading && !State.SecretsLoaded) {
                <div class="cda-admin-empty">
                    Loading stored secrets...
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(State.SecretsError)) {
                <div class="cda-admin-empty text-rose-700">
                    @State.SecretsError
                    <Button Text="Retry secret list" Type="button" Disabled="State.SecretsLoading"
                        Click="() => State.Changed.InvokeAsync(new AgentEditorAccessIntent.RetrySecrets())" data-testid="agents-catalog-secret-retry" />
                </div>
            }
            else if (State.Secrets.Count == 0) {
                <div class="cda-admin-empty">
                    No stored secrets exist yet.
                </div>
            }
            else {
                <div class="max-h-64 overflow-y-auto rounded-2xl border border-slate-200 bg-white p-4"
                     data-testid="agents-catalog-secret-list">
                    <Stack GapScale="LayoutGap.Small">
                        @foreach (var secret in State.Secrets) {
                            <label class="cda-inline-option cda-inline-option--muted">
                                <input type="checkbox"
                                       data-secret-id="@secret.Id"
                                       checked="@State.HasAllowedSecret(secret.Id)"
                                       @onchange="args => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Secret(secret, args.Value is true))" />
                                @secret.Name
                                <span class="text-slate-500">(@secret.KindLabel)</span>
                            </label>
                        }
                    </Stack>
                </div>
            }
        </div>
    </Grid>
    @foreach (var selected in editorModel.AllowedSecretReferences.Where(reference => !State.Secrets.Any(secret => secret.Id == reference.SecretId))) {
        <SurfaceCard Soft="true" data-testid="agents-catalog-secret-missing">
            <TextBlock Value="@selected.NameSnapshot" />
            <TextBlock Value="@selected.SecretId.ToString()" />
            <TextBlock Value="@selected.Purpose" />
            <TextBlock Value="Reference unavailable; the saved selection is retained." />
            <Button Text="Remove selection" Type="button" Click="() => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Secret(new(selected.SecretId, selected.NameSnapshot, string.Empty), false))" />
        </SurfaceCard>
    }
</FormSection>

@code {
    [Parameter, EditorRequired] public AgentEditorAccessState State { get; set; } = default!;
}

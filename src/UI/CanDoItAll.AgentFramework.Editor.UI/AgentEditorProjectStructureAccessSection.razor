@{ var editorModel = State.Draft; }
<FormSection Title="Project Structure Access" Description="Project reads, project creation, subproject creation, non-task structure changes, task-only changes, and unrestricted changes are separate permissions. Advanced plan and cost analysis additionally requires its assigned planning skill and tool capability.">
    <Grid Gap="LayoutGap.Large" ColumnsMd="3" data-testid="agents-catalog-project-structure-access">
        <div class="app-admin-subpanel">
            <TextBlock TextStyle="TextStyle.EyebrowCaption" Class="mb-2">Access mode</TextBlock>
            <Stack GapScale="LayoutGap.Small">
                <CheckboxOption TValue="bool"
                                Value="@editorModel.ProjectStructureAccess.CanRead"
                                ValueChanged="value => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.ProjectStructureRead, value))"
                                data-testid="agents-catalog-project-structure-read">
                    Can read project structure
                </CheckboxOption>
                <CheckboxOption TValue="bool"
                                Value="@editorModel.ProjectStructureAccess.CanCreateProjects"
                                ValueChanged="value => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.ProjectCreation, value))"
                                data-testid="agents-catalog-project-create">
                    Can create standalone projects
                </CheckboxOption>
                <CheckboxOption TValue="bool"
                                Value="@editorModel.ProjectStructureAccess.CanCreateSubprojects"
                                ValueChanged="value => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.SubprojectCreation, value))"
                                data-testid="agents-catalog-subproject-create">
                    Can create subprojects under allowed projects
                </CheckboxOption>
                <CheckboxOption TValue="bool"
                                Value="@(editorModel.ProjectStructureAccess.CanWrite || editorModel.ProjectStructureAccess.CanWriteNonTaskStructure)"
                                Disabled="@editorModel.ProjectStructureAccess.CanWrite"
                                ValueChanged="value => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.ProjectStructureNonTaskWrite, value))"
                                data-testid="agents-catalog-project-structure-non-task-write">
                    Can write project structure except tasks
                </CheckboxOption>
                <CheckboxOption TValue="bool"
                                Value="@(editorModel.ProjectStructureAccess.CanWrite || editorModel.ProjectStructureAccess.CanWriteTasks)"
                                Disabled="@editorModel.ProjectStructureAccess.CanWrite"
                                ValueChanged="value => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.ProjectStructureTaskWrite, value))"
                                data-testid="agents-catalog-project-structure-task-write">
                    Can write project tasks
                </CheckboxOption>
                <CheckboxOption TValue="bool"
                                Value="@editorModel.ProjectStructureAccess.CanWrite"
                                ValueChanged="value => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.ProjectStructureWrite, value))"
                                data-testid="agents-catalog-project-structure-write">
                    Can write entire project structure (includes tasks)
                </CheckboxOption>
                <CheckboxOption TValue="bool"
                                Value="@editorModel.ProjectStructureAccess.AllowAllProjects"
                                ValueChanged="value => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.ProjectStructureAllowAll, value))"
                                data-testid="agents-catalog-project-structure-all">
                    Allow all current and future projects
                </CheckboxOption>
            </Stack>
        </div>
        <div class="app-admin-subpanel md:col-span-2">
            <Split Breakpoint="LayoutBreakpoint.Md"
                   Gap="LayoutGap.Medium"
                   AlignItems="AlignItems.Center"
                   JustifyContent="JustifyContent.SpaceBetween"
                   Wrap="FlexWrap.Wrap">
                <div>
                    <TextBlock TextStyle="TextStyle.EyebrowCaption" Class="mb-1">Allowed projects</TextBlock>
                    <p class="text-sm leading-6 text-chrome-600">
                        @State.DescribeProjectStructureScope(editorModel)
                    </p>
                </div>
                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                    <Button Text="Select all"
                            Tone="ButtonTone.Default"
                            Size="ButtonSize.Small"
                            Click="() => State.Changed.InvokeAsync(new AgentEditorAccessIntent.SelectAllProjects())"
                            Disabled="@(!State.ProjectsLoaded || State.ProjectsLoading || !string.IsNullOrWhiteSpace(State.ProjectsError) || editorModel.ProjectStructureAccess.AllowAllProjects)" />
                    <Button Text="Clear"
                            Tone="ButtonTone.Default"
                            Size="ButtonSize.Small"
                            Click="() => State.Changed.InvokeAsync(new AgentEditorAccessIntent.ClearProjects())"
                            Disabled="@(!State.ProjectsLoaded || State.ProjectsLoading || !string.IsNullOrWhiteSpace(State.ProjectsError) || editorModel.ProjectStructureAccess.AllowAllProjects)" />
                </Cluster>
            </Split>

            @if (editorModel.ProjectStructureAccess.AllowAllProjects) {
                <div class="mt-3 app-admin-empty">
                    This agent can access all current and future projects. Turn off the all-projects option to manage a specific allowlist.
                </div>
            }
            else if (!State.ProjectsRequested) {
                <div class="mt-3 app-admin-empty">
                    Load the project list only when you need to inspect or change the access scope.
                </div>
                <Cluster Gap="LayoutGap.Small"
                         Wrap="FlexWrap.Wrap"
                         Class="mt-3">
                    <Button Text="Load project list"
                            Tone="ButtonTone.Default"
                            Size="ButtonSize.Small"
                            Click="() => State.Changed.InvokeAsync(new AgentEditorAccessIntent.LoadProjects())"
                            Disabled="@State.ProjectsLoading"
                            IsBusy="@State.ProjectsLoading"
                            data-testid="agents-catalog-project-structure-load" />
                </Cluster>
            }
            else if (!State.ProjectsLoaded &&
                     string.IsNullOrWhiteSpace(State.ProjectsError)) {
                <div class="mt-3 app-admin-empty">
                    Loading projects that can be granted to this agent...
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(State.ProjectsError)) {
                <div class="mt-3 app-admin-empty text-[var(--tone-danger-soft-fg)]">
                    @State.ProjectsError
                </div>
                <Cluster Gap="LayoutGap.Small"
                         Wrap="FlexWrap.Wrap"
                         Class="mt-3">
                    <Button Text="Retry project list"
                            Tone="ButtonTone.Default"
                            Size="ButtonSize.Small"
                            Click="() => State.Changed.InvokeAsync(new AgentEditorAccessIntent.LoadProjects())"
                            Disabled="@State.ProjectsLoading"
                            IsBusy="@State.ProjectsLoading" />
                </Cluster>
            }
            else if (State.Projects.Count == 0) {
                <div class="mt-3 app-admin-empty">
                    No projects exist yet. Create a project before granting project-structure access.
                </div>
            }
            else {
                <div class="mt-3 max-h-64 overflow-y-auto rounded-2xl border border-chrome-200 bg-[var(--tone-surface)] p-4"
                     data-testid="agents-catalog-project-structure-projects">
                    <Stack GapScale="LayoutGap.Small">
                        @foreach (var project in State.Projects) {
                            <CheckboxOption TValue="bool" Muted="true"
                                            data-project-id="@project.Id"
                                            Value="@State.HasProjectStructureProjectAccess(project.Id)"
                                            ValueChanged="value => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Project(project.Id, value))">
                                @project.Name
                            </CheckboxOption>
                        }
                    </Stack>
                </div>
            }
        </div>
    </Grid>
    @foreach (var selected in editorModel.ProjectStructureAccess.AllowedProjectIds.Where(id => !State.Projects.Any(project => project.Id == id))) {
        <SurfaceCard Soft="true" data-testid="agents-catalog-project-missing">
            <TextBlock Value="@selected.ToString()" />
            <TextBlock Value="Project reference unavailable; the saved selection is retained." />
            <Button Text="Remove selection" Type="button" Click="() => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Project(selected, false))" />
        </SurfaceCard>
    }
</FormSection>

@code {
    [Parameter, EditorRequired] public AgentEditorAccessState State { get; set; } = default!;
}

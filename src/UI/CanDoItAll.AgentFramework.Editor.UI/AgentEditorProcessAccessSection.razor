@{ var editorModel = State.Draft; }
<FormSection Title="Process Access" Description="Internal agents always carry the process-module tool family. These settings decide whether the current agent can read or mutate process data and which process definitions it may touch.">
    <Grid Gap="LayoutGap.Large" ColumnsMd="3" data-testid="agents-catalog-process-access">
        <div class="app-admin-subpanel">
            <TextBlock TextStyle="TextStyle.EyebrowCaption" Class="mb-2">Access mode</TextBlock>
            <Stack GapScale="LayoutGap.Small">
                <CheckboxOption TValue="bool"
                                Value="@editorModel.ProcessAccess.CanRead"
                                ValueChanged="value => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.ProcessRead, value))"
                                data-testid="agents-catalog-process-read">
                    Can read processes
                </CheckboxOption>
                <CheckboxOption TValue="bool"
                                Value="@editorModel.ProcessAccess.CanWrite"
                                ValueChanged="value => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.ProcessWrite, value))"
                                data-testid="agents-catalog-process-write">
                    Can write processes
                </CheckboxOption>
                <CheckboxOption TValue="bool"
                                Value="@editorModel.ProcessAccess.AllowAllDefinitions"
                                ValueChanged="value => State.Changed.InvokeAsync(new AgentEditorAccessIntent.Flag(AgentEditorAccessFlag.ProcessAllowAll, value))"
                                data-testid="agents-catalog-process-all">
                    Allow all current and future processes
                </CheckboxOption>
            </Stack>
        </div>
        <div class="app-admin-subpanel md:col-span-2">
            <TextBlock TextStyle="TextStyle.EyebrowCaption" Class="mb-1">Allowed processes</TextBlock>
            <p class="text-sm leading-6 text-chrome-600">
                @State.DescribeProcessScope(editorModel)
            </p>
            <div class="mt-3 app-admin-empty">
                Process definition selection is unavailable while the Process module is rebuilt. Existing stored access metadata is preserved.
            </div>
        </div>
    </Grid>
    @foreach (var selected in editorModel.ProcessAccess.AllowedDefinitionIds.Distinct()) {
        <TextBlock Value="@selected.ToString()" data-testid="agents-catalog-process-retained-id" />
    }
</FormSection>

@code {
    [Parameter, EditorRequired] public AgentEditorAccessState State { get; set; } = default!;
}

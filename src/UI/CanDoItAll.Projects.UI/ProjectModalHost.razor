@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using CanDoItAll.Modules.Projects
@using CanDoItAll.SharedKernel
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (IsOpen) {
    <div class="projects-modal-host">
        <EditForm EditContext="Draft.EditContext" OnSubmit="HandleSaveAsync" id="@formId" novalidate>
            <Dialog IsOpen="true" Class="projects-modal-host__dialog"
                    Eyebrow="@(IsEditorMode ? "Project editor" : "Project details")"
                    Title="@(IsEditorMode ? (Editor.Id.HasValue ? Editor.Name : "New project") : (ActiveProjectSummary?.Name ?? Editor.Name))"
                    Subtitle="Inspect the project or shape its next steps."
                    Size="ModalSize.Wide" ShowCloseButton="false"
                    TestId="@(IsEditorMode ? "projects-editor-modal" : "projects-detail-modal")" OnClose="Close">
                <HeaderActions>
                    <Cluster Wrap="FlexWrap.Wrap"
                             Gap="LayoutGap.Small"
                             Class="projects-modal-host__header-actions">
                        <HelpPopover AriaLabel="Show project editor help"
                                     Title="Show project editor help"
                                     Heading="Project editor"
                                     Body="Use the editor when you need to shape phases, stack decisions, or starter objects in depth while the projects board stays focused on scanning cards and routing into dedicated workbench tabs."
                                     Tip="The overview modal is still the faster path when you only need to inspect the project and open dashboard, structure, or calendar." />
                        @if (IsEditorMode && Editor.Id.HasValue) {
                            <Button ButtonStyle="ButtonStyle.Light"
                                    Text="Back to details"
                                    Click="SwitchToOverview" />
                        }

                        <button type="button"
                                class="projects-modal-host__close"
                                data-testid="project-modal-close-button"
                                aria-label="Close"
                                title="Close"
                                @onclick="HandleCloseAsync">
                            <Icon Name="close" />
                        </button>
                    </Cluster>
                </HeaderActions>
                <ChildContent>
                    <section hidden="@(!IsEditorMode)" aria-label="Project editor">
                        <ValidationSummary />
                        <Stack GapScale="LayoutGap.Large">
                            <Split Breakpoint="LayoutBreakpoint.Xl"
                                   Gap="LayoutGap.Large"
                                   AlignItems="AlignItems.Center"
                                   JustifyContent="JustifyContent.SpaceBetween">
                                <SecondaryTabs Items="WizardTabs"
                                               SelectedKey="@WizardStep.ToString()"
                                               SelectedKeyChanged="WizardTabChanged" />

                                <Cluster>
                                    <StatusBadge Tone="@ProjectsPresentation.GetStatusTone(Editor.Status)" Text="@Editor.Status.ToString()" />
                                    <StatusBadge Tone="neutral" Text="@($"{Editor.Phases.Count} phase(s)")" />
                                    <StatusBadge Tone="info" Text="@($"{StarterObjects.Count} starter object(s)")" />
                                </Cluster>
                            </Split>

                            <Cluster Gap="LayoutGap.Small"
                                     Wrap="FlexWrap.Wrap">
                                <span class="cda-shell-pill cda-shell-pill--info">@($"Step {WizardStep + 1} / {WizardSteps.Count}: {WizardSteps[WizardStep]}")</span>
                                <span class="cda-shell-pill cda-shell-pill--neutral">@($"Current phase: {(string.IsNullOrWhiteSpace(Editor.CurrentPhase) ? "Unset" : Editor.CurrentPhase)}")</span>
                                <span class="cda-shell-pill cda-shell-pill--neutral">@($"Target: {ProjectsPresentation.FormatDate(Editor.TargetDateUtc)}")</span>
                                <span class="cda-shell-pill cda-shell-pill--info">@($"{MeaningfulOptions.Count} stack decision(s)")</span>
                                @if (ActiveProjectSummary is not null && !string.IsNullOrWhiteSpace(ActiveProjectSummary.PrimaryCustomerName)) {
                                    <span class="cda-shell-pill cda-shell-pill--info">@($"Customer: {ActiveProjectSummary.PrimaryCustomerName}")</span>
                                }
                                @if (ActiveProjectSummary is not null && !string.IsNullOrWhiteSpace(ActiveProjectSummary.PrimaryDeliveryUnitName)) {
                                    <span class="cda-shell-pill cda-shell-pill--neutral">@($"Delivery unit: {ActiveProjectSummary.PrimaryDeliveryUnitName}")</span>
                                }
                                @if (ActiveProjectSummary is not null && !string.IsNullOrWhiteSpace(ActiveProjectSummary.PrimaryOwnerName)) {
                                    <span class="cda-shell-pill cda-shell-pill--warning">@($"Owner: {ActiveProjectSummary.PrimaryOwnerName}")</span>
                                }
                            </Cluster>
                            <section hidden="@(WizardStep != 0)" data-wizard-step="0">
                                <FormSection Title="Identity"
                                             Description="Frame the project clearly before moving into phases and downstream workbench actions.">
                                    <ChildContent>
                                        <Grid Gap="LayoutGap.Large"
                                              ColumnsLg="2">
                                            <FormField Text="Name">
                                                <InputText @bind-Value="Editor.Name" @oninput="@((ChangeEventArgs args) => ChangeText(Editor, nameof(Editor.Name), value => Editor.Name = value, args))" class="cda-input" data-testid="project-name-input" />
                                            </FormField>
                                            <FormField Text="Current phase">
                                                <InputText @bind-Value="Editor.CurrentPhase" @oninput="@((ChangeEventArgs args) => ChangeText(Editor, nameof(Editor.CurrentPhase), value => Editor.CurrentPhase = value, args))"
                                                           class="cda-input"
                                                           data-testid="project-phase-input" />
                                            </FormField>
                                        </Grid>

                                        <Grid Gap="LayoutGap.Large"
                                              ColumnsLg="2">
                                            <FormField Text="Status">
                                                <InputSelect @bind-Value="Editor.Status" class="cda-input">
                                                    @foreach (var status in Enum.GetValues<ProjectStatus>()) {
                                                        <option value="@status">@status</option>
                                                    }
                                                </InputSelect>
                                            </FormField>
                                            <FormField Text="Target date">
                                                <InputDate data-testid="project-target-date" @bind-Value="Editor.TargetDateUtc" class="cda-input" />
                                            </FormField>
                                        </Grid>

                                        <FormField Text="Description">
                                            <InputTextArea @bind-Value="Editor.Description" @oninput="@((ChangeEventArgs args) => ChangeText(Editor, nameof(Editor.Description), value => Editor.Description = value, args))" class="cda-input cda-input--textarea min-h-28" />
                                        </FormField>

                                        <FormField Text="Objective">
                                            <InputTextArea @bind-Value="Editor.Objective" @oninput="@((ChangeEventArgs args) => ChangeText(Editor, nameof(Editor.Objective), value => Editor.Objective = value, args))" class="cda-input cda-input--textarea min-h-28" />
                                        </FormField>
                                    </ChildContent>
                                </FormSection>
                            </section>
                            <section hidden="@(WizardStep != 1)" data-wizard-step="1">
                                <FormSection Title="Dates and phases"
                                         Description="Keep phase planning explicit so the project calendar and workbench stay aligned.">
                                    <Actions>
                                        <Button ButtonStyle="ButtonStyle.Light"
                                                Text="Add phase"
                                                Click="AddPhase" />
                                    </Actions>
                                    <ChildContent>
                                        @if (Editor.Phases.Count == 0) {
                                            <EmptyState Eyebrow="No phases"
                                                        Title="Add the first phase"
                                                        Description="Phases become the backbone for structure, validation, and calendar work.">
                                                <Actions>
                                                    <Button Text="Add phase" Click="AddPhase" />
                                                </Actions>
                                            </EmptyState>
                                        } else {
                                            <Stack GapScale="LayoutGap.Large">
                                                @foreach (var phase in Editor.Phases) {
                                                    <PanelCard @key="phase" data-testid="project-phase-row">
                                                        <Grid Gap="LayoutGap.Medium"
                                                              ColumnsXl="5">
                                                            <InputText @bind-Value="phase.Name" @oninput="@((ChangeEventArgs args) => ChangeText(phase, nameof(phase.Name), value => phase.Name = value, args))" class="cda-input xl:col-span-2" />
                                                            <InputSelect @bind-Value="phase.Status" class="cda-input">
                                                                @foreach (var status in Enum.GetValues<ProjectPhaseStatus>()) {
                                                                    <option value="@status">@status</option>
                                                                }
                                                            </InputSelect>
                                                            <InputDate @bind-Value="phase.StartDateUtc" class="cda-input" />
                                                            <InputDate @bind-Value="phase.EndDateUtc" class="cda-input" />
                                                            <InputTextArea @bind-Value="phase.Goal" @oninput="@((ChangeEventArgs args) => ChangeText(phase, nameof(phase.Goal), value => phase.Goal = value, args))" class="cda-input cda-input--textarea min-h-20 xl:col-span-4" />
                                                            <Button ButtonStyle="ButtonStyle.Danger"
                                                                    Text="Remove"
                                                                    Size="ButtonSize.Small"
                                                                    Click="@(() => RemovePhase.InvokeAsync(phase))" />
                                                        </Grid>
                                                    </PanelCard>
                                                }
                                            </Stack>
                                        }
                                    </ChildContent>
                                </FormSection>
                            </section>
                            <section hidden="@(WizardStep != 2)" data-wizard-step="2">
                                <FormSection Title="Stack profile"
                                             Description="Capture the main platform decisions once so downstream prompts and validations inherit the same context.">
                                    <ChildContent>
                                        <Grid Gap="LayoutGap.Large"
                                              ColumnsLg="2">
                                            @foreach (var option in Editor.Options.OrderBy(item => item.Category)) {
                                                <PanelCard @key="option" data-testid="@($"project-option-{option.Category}")">
                                                    <div class="mb-3 rounded-xl bg-slate-50 px-3 py-2 text-sm font-semibold text-slate-700">@option.Category</div>
                                                    <Grid Gap="LayoutGap.Medium">
                                                        <InputText @bind-Value="option.OptionName" @oninput="@((ChangeEventArgs args) => ChangeText(option, nameof(option.OptionName), value => option.OptionName = value, args))" class="cda-input" />
                                                        <InputText @bind-Value="option.Notes" @oninput="@((ChangeEventArgs args) => ChangeText(option, nameof(option.Notes), value => option.Notes = value, args))" class="cda-input" />
                                                    </Grid>
                                                </PanelCard>
                                            }
                                        </Grid>
                                    </ChildContent>
                                </FormSection>
                            </section>
                            <section hidden="@(WizardStep != 3)" data-wizard-step="3">
                                <FormSection Title="Linked object planning"
                                             Description="Capture the first notes, milestones, repositories, or links that should appear when the structure workbench opens.">
                                    <Actions>
                                        <Button ButtonStyle="ButtonStyle.Light"
                                                Text="Add planned object"
                                                Click="AddStarterObject" />
                                    </Actions>
                                    <ChildContent>
                                        @if (StarterObjects.Count == 0) {
                                            <EmptyState Eyebrow="No starter objects"
                                                        Title="Seed the first artifacts"
                                                        Description="Add the initial objects you expect to create right after the project workspace is saved.">
                                                <Actions>
                                                    <Button Text="Add planned object" Click="AddStarterObject" />
                                                </Actions>
                                            </EmptyState>
                                        } else {
                                            <Stack GapScale="LayoutGap.Large">
                                                @foreach (var starter in StarterObjects) {
                                                    <PanelCard @key="starter">
                                                        @if (starter.IsSeeded) {
                                                            <TextBlock Value="This object was created. Later planning edits here are local; open Structure to edit the created object." />
                                                        }
                                                        <Grid Gap="LayoutGap.Medium"
                                                              ColumnsXl="4">
                                                            <InputSelect @bind-Value="starter.ObjectType" class="cda-input">
                                                                @foreach (var kind in StarterObjectKinds) {
                                                                    <option value="@kind">@kind</option>
                                                                }
                                                            </InputSelect>
                                                            <InputText data-testid="project-starter-title" @bind-Value="starter.Title" @oninput="@((ChangeEventArgs args) => ChangeText(starter, nameof(starter.Title), value => starter.Title = value, args))" class="cda-input" />
                                                            <InputText @bind-Value="starter.Subtitle" @oninput="@((ChangeEventArgs args) => ChangeText(starter, nameof(starter.Subtitle), value => starter.Subtitle = value, args))" class="cda-input" />
                                                            <Button ButtonStyle="ButtonStyle.Danger"
                                                                    Text="Remove"
                                                                    Size="ButtonSize.Small"
                                                                    Click="@(() => RemoveStarterObject.InvokeAsync(starter))" />
                                                        </Grid>
                                                    </PanelCard>
                                                }
                                            </Stack>
                                        }
                                    </ChildContent>
                                </FormSection>
                            </section>
                            <section hidden="@(WizardStep != 4)" data-wizard-step="4">
                                <FormSection Title="Review"
                                            Description="Confirm the project shape before opening the next workbench surface.">
                                    <ChildContent>
                                        <Grid Gap="LayoutGap.Large"
                                              ColumnTemplateXl="minmax(0,1.15fr) minmax(18rem,0.85fr)">
                                            <PanelCard>
                                                <p class="cda-eyebrow cda-eyebrow--tight">Project summary</p>
                                                <p class="mt-2 text-lg font-semibold text-slate-950">@(string.IsNullOrWhiteSpace(Editor.Name) ? "Unnamed project" : Editor.Name)</p>
                                                <p class="mt-2 text-sm leading-6 text-slate-600">@(string.IsNullOrWhiteSpace(Editor.Description) ? "No description captured yet." : Editor.Description)</p>
                                            </PanelCard>

                                            <div class="cda-panel-card border-sky-200 bg-sky-50/80 text-sm leading-6 text-sky-900">
                                                Saving keeps the card list current, preserves the modal context, and lets the user open structure or calendar tabs only when they actually need a larger work surface.
                                            </div>
                                        </Grid>

                                        <CompactStatStrip>
                                            <CompactStat Label="status" Value="@Editor.Status.ToString()" TooltipText="Current project status." Tone="@ProjectsPresentation.GetStatusTone(Editor.Status)" />
                                            <CompactStat Label="phases" Value="@Editor.Phases.Count.ToString()" TooltipText="Phases currently defined for this project." Tone="info" />
                                            <CompactStat Label="starter objects" Value="@StarterObjects.Count.ToString()" TooltipText="Starter objects that will be created with the project." Tone="success" />
                                        </CompactStatStrip>
                                    </ChildContent>
                                </FormSection>
                            </section>
                        </Stack>
                    </section>
                    <section hidden="@IsEditorMode" aria-label="Project overview">
                        <Stack GapScale="LayoutGap.Large">
                            <Cluster Gap="LayoutGap.Small"
                                     Wrap="FlexWrap.Wrap">
                                <span class="cda-shell-pill cda-shell-pill--info">@($"Current phase: {(string.IsNullOrWhiteSpace(Editor.CurrentPhase) ? "Unset" : Editor.CurrentPhase)}")</span>
                                <span class="cda-shell-pill cda-shell-pill--neutral">@($"Target: {ProjectsPresentation.FormatDate(Editor.TargetDateUtc)}")</span>
                                <span class="cda-shell-pill cda-shell-pill--neutral">@($"Updated: {ProjectsPresentation.FormatTimestamp(LastUpdatedAtUtc)}")</span>
                                <span class="cda-shell-pill cda-shell-pill--warning">@($"{MeaningfulOptions.Count} stack decision(s)")</span>
                                @if (ActiveProjectSummary is not null && !string.IsNullOrWhiteSpace(ActiveProjectSummary.PrimaryCustomerName)) {
                                    <span class="cda-shell-pill cda-shell-pill--info">@($"Customer: {ActiveProjectSummary.PrimaryCustomerName}")</span>
                                }
                                @if (ActiveProjectSummary is not null && !string.IsNullOrWhiteSpace(ActiveProjectSummary.PrimaryDeliveryUnitName)) {
                                    <span class="cda-shell-pill cda-shell-pill--neutral">@($"Delivery unit: {ActiveProjectSummary.PrimaryDeliveryUnitName}")</span>
                                }
                                @if (ActiveProjectSummary is not null && !string.IsNullOrWhiteSpace(ActiveProjectSummary.PrimaryOwnerName)) {
                                    <span class="cda-shell-pill cda-shell-pill--warning">@($"Owner: {ActiveProjectSummary.PrimaryOwnerName}")</span>
                                }
                            </Cluster>

                            <p class="text-sm leading-6 text-slate-600">
                                This header uses the saved project name. Use Edit name and details when you want to rename the project.
                            </p>

                            <Grid Gap="LayoutGap.Large"
                                  ColumnTemplateXl="minmax(0,1.15fr) minmax(18rem,0.85fr)">
                                <SurfaceCard>
                                    <p class="cda-eyebrow">Description</p>
                                    <p class="mt-3 text-sm leading-6 text-slate-700">@(string.IsNullOrWhiteSpace(Editor.Description) ? "No description has been captured for this project yet." : Editor.Description)</p>

                                    <p class="mt-6 cda-eyebrow">Objective</p>
                                    <p class="mt-3 text-sm leading-6 text-slate-700">@(string.IsNullOrWhiteSpace(Editor.Objective) ? "No explicit objective has been recorded yet." : Editor.Objective)</p>
                                </SurfaceCard>

                                <SurfaceCard Soft="true">
                                    <p class="cda-eyebrow">Next actions</p>
                                    <Grid Gap="LayoutGap.Medium"
                                          Class="mt-4">
                                        <Button Class="w-full"
                                                Text="Edit name and details"
                                                Click="SwitchToEditor" />
                                        <Button ButtonStyle="ButtonStyle.Light"
                                                Class="w-full"
                                                Text="Open dashboard tab"
                                                Click="OpenProjectDashboard" />
                                        <Button ButtonStyle="ButtonStyle.Light"
                                                Class="w-full"
                                                Text="Open structure"
                                                Disabled="@(!Editor.Id.HasValue)"
                                                Click="HandleOpenStructureAsync" />
                                        <Button ButtonStyle="ButtonStyle.Light"
                                                Class="w-full"
                                                Text="Open processes"
                                                Disabled="@(!Editor.Id.HasValue)"
                                                Click="HandleOpenProcessesAsync" />
                                        <Button ButtonStyle="ButtonStyle.Light"
                                                Class="w-full"
                                                Text="Open calendar"
                                                Disabled="@(!Editor.Id.HasValue)"
                                                Click="HandleOpenCalendarAsync" />
                                    </Grid>
                                </SurfaceCard>
                            </Grid>

                            <SurfaceCard>
                                <Split Breakpoint="LayoutBreakpoint.Md"
                                       Gap="LayoutGap.Medium"
                                       AlignItems="AlignItems.Center"
                                       JustifyContent="JustifyContent.SpaceBetween">
                                    <div>
                                        <p class="cda-eyebrow">Phase plan</p>
                                        <h3 class="mt-1 text-lg font-semibold text-slate-950">Delivery sequence</h3>
                                    </div>
                                    <StatusBadge Tone="neutral" Text="@($"{Editor.Phases.Count} phase(s)")" />
                                </Split>

                                @if (Editor.Phases.Count == 0) {
                                    <p class="mt-4 text-sm leading-6 text-slate-600">No phase plan exists yet. Use the editor to map the first delivery stages before opening structure or calendar tabs.</p>
                                } else {
                                    <Grid Gap="LayoutGap.Medium"
                                          ColumnsLg="2"
                                          Class="mt-4">
                                        @foreach (var phase in Editor.Phases.OrderBy(ProjectsPresentation.GetPhaseOrderKey).ThenBy(item => item.Name)) {
                                            <PanelCard @key="phase" Soft="true">
                                                <Split Breakpoint="LayoutBreakpoint.None"
                                                       Gap="LayoutGap.Medium"
                                                       AlignItems="AlignItems.Start"
                                                       JustifyContent="JustifyContent.SpaceBetween"
                                                       Wrap="FlexWrap.Wrap">
                                                    <div class="min-w-0">
                                                        <p class="text-sm font-semibold text-slate-950">@phase.Name</p>
                                                        <p class="mt-1 cda-eyebrow cda-eyebrow--tight">@phase.Status</p>
                                                    </div>
                                                    <StatusBadge Tone="@ProjectsPresentation.GetPhaseStatusTone(phase.Status)" Text="@phase.Status.ToString()" />
                                                </Split>
                                                <p class="mt-3 text-sm leading-6 text-slate-600">@(string.IsNullOrWhiteSpace(phase.Goal) ? "No goal has been captured for this phase yet." : phase.Goal)</p>
                                                <p class="mt-3 text-xs font-medium text-slate-500">@($"{ProjectsPresentation.FormatDate(phase.StartDateUtc)} to {ProjectsPresentation.FormatDate(phase.EndDateUtc)}")</p>
                                            </PanelCard>
                                        }
                                    </Grid>
                                }
                            </SurfaceCard>

                            <SurfaceCard>
                                <Split Breakpoint="LayoutBreakpoint.Md"
                                       Gap="LayoutGap.Small"
                                       AlignItems="AlignItems.Center"
                                       JustifyContent="JustifyContent.SpaceBetween">
                                    <div>
                                        <p class="cda-eyebrow">Stack profile</p>
                                        <h3 class="mt-1 text-lg font-semibold text-slate-950">Captured platform choices</h3>
                                    </div>
                                    <StatusBadge Tone="warning" Text="@($"{MeaningfulOptions.Count} filled")" />
                                </Split>

                                @if (MeaningfulOptions.Count == 0) {
                                    <p class="mt-4 text-sm leading-6 text-slate-600">No stack profile has been captured yet. The editor can record platform, storage, testing, deployment, and external dependency choices.</p>
                                } else {
                                    <Grid Gap="LayoutGap.Medium"
                                          ColumnsLg="2"
                                          Class="mt-4">
                                        @foreach (var option in MeaningfulOptions.OrderBy(item => item.Category).ThenBy(item => item.OptionName)) {
                                            <PanelCard @key="option" Soft="true">
                                                <p class="cda-eyebrow cda-eyebrow--tight">@option.Category</p>
                                                <p class="mt-2 text-sm font-semibold text-slate-950">@(string.IsNullOrWhiteSpace(option.OptionName) ? "Not specified" : option.OptionName)</p>
                                                <p class="mt-2 text-sm leading-6 text-slate-600">@(string.IsNullOrWhiteSpace(option.Notes) ? "No notes recorded." : option.Notes)</p>
                                            </PanelCard>
                                        }
                                    </Grid>
                                }
                            </SurfaceCard>
                        </Stack>
                    </section>
                </ChildContent>
                <Footer>
                    <section hidden="@(!IsEditorMode)">
                        <Split Breakpoint="LayoutBreakpoint.Xl"
                               Gap="LayoutGap.Large"
                               AlignItems="AlignItems.Center"
                               JustifyContent="JustifyContent.SpaceBetween">
                            <Stack GapScale="LayoutGap.Tiny">
                                <p class="cda-eyebrow">Project save state</p>
                                <p class="text-sm @(IsErrorMessage ? "text-rose-700" : "text-slate-600")">@(string.IsNullOrWhiteSpace(Message) ? "Save keeps the grid in sync without leaving the page." : Message)</p>
                            </Stack>

                            <Cluster>
                                <Button ButtonStyle="ButtonStyle.Light"
                                        Text="Back"
                                        Disabled="@(WizardStep == 0)"
                                        Click="PreviousStep" />
                                <Button ButtonStyle="ButtonStyle.Light"
                                        Text="Next"
                                        Disabled="@(WizardStep == WizardSteps.Count - 1)"
                                        Click="NextStep" />
                                <Button Type="submit"
                                        Text="Save project"
                                        Click="@(() => openAfterSubmit = false)"
                                        Disabled="@(!Draft.CanMutate)" data-testid="project-save-button" />
                                <Button Type="submit" ButtonStyle="ButtonStyle.Info"
                                        Text="Save and open structure" Disabled="@(!Draft.CanMutate)" data-testid="project-save-open-button"
                                        Click="@(() => openAfterSubmit = true)" />
                                @if (Editor.Id.HasValue) {
                                    <Button ButtonStyle="ButtonStyle.Light"
                                            Text="Open dashboard tab"
                                            Click="OpenProjectDashboard" />
                                    <Button ButtonStyle="ButtonStyle.Light"
                                            Text="Open processes"
                                            Click="OpenProcesses" />
                                    <Button ButtonStyle="ButtonStyle.Danger"
                                            Text="Delete"
                                            Click="Delete"
                                            Disabled="@(!Draft.CanMutate)" data-testid="project-delete-button" />
                                }
                            </Cluster>
                        </Split>
                    </section>
                    <section hidden="@IsEditorMode">
                        <Split Breakpoint="LayoutBreakpoint.Xl"
                               Gap="LayoutGap.Large"
                               AlignItems="AlignItems.Center"
                               JustifyContent="JustifyContent.SpaceBetween">
                            <Stack GapScale="LayoutGap.Tiny">
                                <p class="cda-eyebrow">Project dashboard</p>
                                <p class="text-sm text-slate-600">Use the modal to inspect and decide. Use tabs only when you want the project overview or a deeper work surface to stay open alongside other work.</p>
                            </Stack>

                            <Cluster>
                                <Button ButtonStyle="ButtonStyle.Light"
                                        Text="Edit project"
                                        Click="SwitchToEditor" />
                                <Button Text="Open dashboard tab"
                                        Click="OpenProjectDashboard" />
                            </Cluster>
                        </Split>
                    </section>
                </Footer>
            </Dialog>
        </EditForm>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public bool IsEditorMode { get; set; }

    [Parameter, EditorRequired]
    public ProjectEditorDraft Draft { get; set; } = default!;

    public ProjectEditorModel Editor => Draft.Model;

    public IList<StarterObjectDraft> StarterObjects => Draft.StarterObjects;

    [Parameter, EditorRequired]
    public IReadOnlyList<ProjectObjectType> StarterObjectKinds { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<ProjectSummary> ProjectSummaries { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<string> WizardSteps { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<SecondaryTabItem> WizardTabs { get; set; } = default!;

    [Parameter]
    public int WizardStep { get; set; }

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public bool IsErrorMessage { get; set; }

    [Parameter]
    public EventCallback Close { get; set; }

    [Parameter]
    public EventCallback SwitchToOverview { get; set; }

    [Parameter]
    public EventCallback SwitchToEditor { get; set; }

    [Parameter]
    public EventCallback<string> WizardTabChanged { get; set; }

    [Parameter]
    public EventCallback AddPhase { get; set; }

    [Parameter]
    public EventCallback<ProjectPhaseEditorModel> RemovePhase { get; set; }

    [Parameter]
    public EventCallback AddStarterObject { get; set; }

    [Parameter]
    public EventCallback<StarterObjectDraft> RemoveStarterObject { get; set; }

    [Parameter]
    public EventCallback PreviousStep { get; set; }

    [Parameter]
    public EventCallback NextStep { get; set; }

    [Parameter]
    public EventCallback<ProjectEditorSubmission> Save { get; set; }

    [Parameter]
    public EventCallback<ProjectEditorSubmission> SaveAndOpenStructure { get; set; }

    [Parameter]
    public EventCallback Delete { get; set; }

    [Parameter]
    public EventCallback OpenProjectDashboard { get; set; }

    [Parameter]
    public EventCallback OpenProcesses { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenStructure { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenCalendar { get; set; }

    private IReadOnlyList<ProjectOptionEditorModel> MeaningfulOptions => Editor.Options
        .Where(option => !string.IsNullOrWhiteSpace(option.OptionName) || !string.IsNullOrWhiteSpace(option.Notes))
        .ToList();

    private DateTimeOffset? LastUpdatedAtUtc => Editor.Id.HasValue
        ? ProjectSummaries.FirstOrDefault(project => project.Id == Editor.Id.Value)?.UpdatedAtUtc
        : null;

    private ProjectSummary? ActiveProjectSummary => Editor.Id.HasValue
        ? ProjectSummaries.FirstOrDefault(project => project.Id == Editor.Id.Value)
        : null;

    private bool openAfterSubmit;
    private bool validating;
    private bool retired;
    private bool focusInvalid;
    private readonly string formId = $"project-editor-{Guid.NewGuid():N}";
    private Task<IJSObjectReference>? moduleLoad;

    private async Task HandleSaveAsync() {
        bool open = openAfterSubmit;
        openAfterSubmit = false;
        if (validating || retired || !Draft.CanMutate || !Draft.Validate()) {
            return;
        }
        validating = true;
        var submitted = Draft.Capture();
        try {
            moduleLoad ??= JS.InvokeAsync<IJSObjectReference>("import", "./_content/CanDoItAll.Projects.UI/project-editor.js").AsTask();
            var module = await moduleLoad;
            var validity = await module.InvokeAsync<ProjectFormValidity>("inspect", formId);
            if (retired) {
                return;
            }
            if (!validity.IsValid) {
                Draft.Message = validity.Message ?? "Complete the invalid date before saving.";
                Draft.IsError = true;
                focusInvalid = true;
                if (validity.Step is { } step) {
                    await WizardTabChanged.InvokeAsync(step.ToString(System.Globalization.CultureInfo.InvariantCulture));
                }
                return;
            }
            if (open) {
                await SaveAndOpenStructure.InvokeAsync(submitted);
            } else {
                await Save.InvokeAsync(submitted);
            }
        } catch (JSException) {
            Draft.Message = "Unable to validate the current form. Close and reopen the editor before saving.";
            Draft.IsError = true;
        } finally {
            validating = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (focusInvalid && moduleLoad is not null && !retired) {
            focusInvalid = false;
            await (await moduleLoad).InvokeVoidAsync("focusInvalid", formId);
        }
    }

    public async ValueTask DisposeAsync() {
        retired = true;
        if (moduleLoad is not null) {
            try {
                await (await moduleLoad).DisposeAsync();
            } catch (JSDisconnectedException) {
            }
        }
    }

    private void ChangeText(object model, string field, Action<string> update, ChangeEventArgs args) {
        update(args.Value?.ToString() ?? string.Empty);
        Draft.EditContext.NotifyFieldChanged(new(model, field));
    }

    private Task HandleOpenStructureAsync()
        => Editor.Id.HasValue
            ? OpenStructure.InvokeAsync(Editor.Id.Value)
            : Task.CompletedTask;

    private Task HandleOpenProcessesAsync()
        => Editor.Id.HasValue
            ? OpenProcesses.InvokeAsync()
            : Task.CompletedTask;

    private Task HandleOpenCalendarAsync()
        => Editor.Id.HasValue
            ? OpenCalendar.InvokeAsync(Editor.Id.Value)
            : Task.CompletedTask;

    private Task HandleCloseAsync()
        => Close.InvokeAsync();
}

@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common

<FormSection Title="Deletion and hierarchy operations" Description="Retained operations keep their original targets. Checking an outcome never submits a new change.">
    <Actions>
        <Button Text="Refresh retained operations" ButtonStyle="ButtonStyle.Light" Disabled="@Loading" Click="Refresh" data-testid="project-lifecycle-refresh" />
    </Actions>
    <ChildContent>
        <Stack GapScale="LayoutGap.Small" data-testid="project-lifecycle-pending">
            @if (Error is not null) {
                <Alert AlertStyle="AlertStyle.Warning"><TextBlock Value="@Error" /></Alert>
            }
            @foreach (var item in Items) {
                <Cluster Wrap="FlexWrap.Wrap" @key="item.Operation">
                    <TextBlock Value="@($"{Label(item.Kind)} · {item.Operation.Id:D}")" />
                    <Button Text="Review operation" ButtonStyle="ButtonStyle.Light" Disabled="@Loading"
                            Click="@(() => Open.InvokeAsync(item.Operation))" data-testid="project-lifecycle-open" />
                </Cluster>
            }
            @if (HasMore) {
                <Button Text="Show more retained operations" ButtonStyle="ButtonStyle.Light" Click="ShowMore" />
            }
            @if (View is { } view) {
                <Alert AlertStyle="AlertStyle.Info" data-testid="project-lifecycle-recovery">
                    <Stack GapScale="LayoutGap.Small">
                        <TextBlock Value="@view.Message" />
                        <TextBlock TextStyle="TextStyle.Caption" Value="@($"Operation reference: {view.Operation.Id:D}")" />
                        <Cluster Wrap="FlexWrap.Wrap">
                            <Button Text="Check original outcome" ButtonStyle="ButtonStyle.Light" Disabled="@view.Busy"
                                    Click="@(() => Send(ProjectLifecyclePendingAction.Check))" data-testid="project-lifecycle-check" />
                            <Button Text="Retry this exact operation" ButtonStyle="ButtonStyle.Light" Disabled="@(view.Busy || !view.CanRetry)"
                                    Click="@(() => Send(ProjectLifecyclePendingAction.RetryOriginal))" data-testid="project-lifecycle-retry" />
                            <Button Text="Apply accepted deletion to original editor" Disabled="@(view.Busy || !view.CanApply)"
                                    Click="@(() => Send(ProjectLifecyclePendingAction.ApplyAccepted))" data-testid="project-lifecycle-apply" />
                            <Button Text="Cancel undispatched operation" ButtonStyle="ButtonStyle.Light" Disabled="@(view.Busy || !view.CanCancel)"
                                    Click="@(() => Send(ProjectLifecyclePendingAction.CancelPrepared))" data-testid="project-lifecycle-cancel" />
                            <Button Text="Finish resolved recovery" ButtonStyle="ButtonStyle.Light" Disabled="@(view.Busy || !view.CanClear)"
                                    Click="@(() => Send(ProjectLifecyclePendingAction.ClearResolved))" data-testid="project-lifecycle-clear" />
                        </Cluster>
                    </Stack>
                </Alert>
            }
        </Stack>
    </ChildContent>
</FormSection>

@code {
    [Parameter] public IReadOnlyList<ProjectLifecyclePendingMetadata> Items { get; set; } = [];
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool HasMore { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public ProjectLifecyclePendingView? View { get; set; }
    [Parameter] public EventCallback Refresh { get; set; }
    [Parameter] public EventCallback ShowMore { get; set; }
    [Parameter] public EventCallback<ProjectLifecycleOperation> Open { get; set; }
    [Parameter] public EventCallback<ProjectLifecyclePendingIntent> Action { get; set; }

    private Task Send(ProjectLifecyclePendingAction action) => Action.InvokeAsync(new(View!.Operation, action));

    private static string Label(ProjectLifecycleCommandKind kind) => kind switch {
        ProjectLifecycleCommandKind.Delete => "Project deletion",
        ProjectLifecycleCommandKind.EnsureLink => "Hierarchy link",
        ProjectLifecycleCommandKind.RemoveLink => "Hierarchy unlink",
        ProjectLifecycleCommandKind.ReconnectLink => "Hierarchy move",
        _ => "Unsupported retained operation"
    };
}

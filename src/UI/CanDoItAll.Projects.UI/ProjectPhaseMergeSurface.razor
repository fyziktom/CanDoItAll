@using CanDoItAll.Editing
@using CanDoItAll.Editing.UI
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using System.Globalization

<FormSection Title="@Row.Label" Description="Phase rows are matched by their saved identity. Removal versus an edit needs an explicit choice.">
    @if (Row.Fields is { } fields) {
        <MergeFieldView TValue="string" Label="Phase name" Field="fields.Name" Format="Text" ShowUnchanged="ShowUnchanged" Changed="Changed">
            <ResultEditor Context="value">
                <NativeValueInput TValue="string" Value="@value" ValueChanged="@(value => Set(fields.Name, value))" ValueExpression="@(() => fields.Name.Local)" class="form-input ui-input ui-input--outlined" aria-label="Merged phase name" />
            </ResultEditor>
        </MergeFieldView>
        <MergeFieldView TValue="string" Label="Phase goal" Field="fields.Goal" Format="Text" ShowUnchanged="ShowUnchanged" Changed="Changed">
            <ResultEditor Context="value">
                <NativeValueInput TValue="string" Multiline="true" Value="@value" ValueChanged="@(value => Set(fields.Goal, value))" ValueExpression="@(() => fields.Goal.Local)" class="form-input ui-input ui-input--outlined ui-input--textarea" aria-label="Merged phase goal" />
            </ResultEditor>
        </MergeFieldView>
        <MergeFieldView TValue="ProjectPhaseStatus" Label="Phase status" Field="fields.Status" Format="@(value => value.ToString())" ShowUnchanged="ShowUnchanged" Changed="Changed" />
        <MergeFieldView TValue="ProjectPhaseDates" Label="Phase dates" Field="fields.Dates" Format="Dates" ShowUnchanged="ShowUnchanged" Changed="Changed">
            <ResultEditor Context="value">
                <Grid ColumnsLg="2" Gap="LayoutGap.Small">
                    <FormField Text="Result start">
                        <NativeValueInput TValue="DateTime?" Value="value.Start" ValueChanged="@(date => Set(fields.Dates, value with { Start = date }))" ValueExpression="@(() => fields.Dates.Local.Start)"
                                          PendingChanged="@(pending => ResultPending.InvokeAsync(new(new(ProjectMergeInputField.PhaseStart, Row.Key), pending)))" class="form-input ui-input ui-input--outlined" aria-label="Merged phase start" />
                    </FormField>
                    <FormField Text="Result end">
                        <NativeValueInput TValue="DateTime?" Value="value.End" ValueChanged="@(date => Set(fields.Dates, value with { End = date }))" ValueExpression="@(() => fields.Dates.Local.End)"
                                          PendingChanged="@(pending => ResultPending.InvokeAsync(new(new(ProjectMergeInputField.PhaseEnd, Row.Key), pending)))" class="form-input ui-input ui-input--outlined" aria-label="Merged phase end" />
                    </FormField>
                </Grid>
            </ResultEditor>
        </MergeFieldView>
    } else {
        @if (Row.RecreatesRemovedRow) {
            <SmallText Text="This saved phase was removed. Keeping your row adds a new draft phase; its retired identity is not reused." />
        }
        <MergeFieldView TValue="MergeEntry<ProjectPhaseValues>" Label="Phase membership and values" Field="Row.Row" Format="FormatRow" Changed="Changed" />
    }
</FormSection>

@code {
    [Parameter, EditorRequired] public ProjectPhaseReview Row { get; set; } = default!;
    [Parameter] public bool ShowUnchanged { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback<ProjectMergePendingInput> ResultPending { get; set; }
    private static string Text(string value) => value;
    private static string Date(DateTime? value) => value?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "Not set";
    private static string Dates(ProjectPhaseDates value) => $"Start: {Date(value.Start)}; end: {Date(value.End)}";
    private static string FormatRow(MergeEntry<ProjectPhaseValues> row) => !row.Exists ? "Removed" :
        $"{row.Value!.Name}\n{row.Value.Status}\n{Dates(row.Value.Dates)}\n{row.Value.Goal}";

    private async Task Set<T>(MergeField<T> field, T value) {
        field.SetResult(value);
        await Changed.InvokeAsync();
    }
}

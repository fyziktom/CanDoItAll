@using CanDoItAll.Editing
@using CanDoItAll.Editing.UI
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common

<FormSection Title="@Row.Label" Description="Options are matched by their saved identity; the owner sorts them by category.">
    @if (Row.Fields is { } fields) {
        <MergeFieldView TValue="ProjectOptionCategory" Label="Option category" Field="fields.Category" Format="@(value => value.ToString())" ShowUnchanged="ShowUnchanged" Changed="Changed" />
        <MergeFieldView TValue="string" Label="Option name" Field="fields.Name" Format="Text" ShowUnchanged="ShowUnchanged" Changed="Changed">
            <ResultEditor Context="value">
                <NativeValueInput TValue="string" Value="@value" ValueChanged="@(value => Set(fields.Name, value))" ValueExpression="@(() => fields.Name.Local)" class="cda-input" aria-label="Merged option name" />
            </ResultEditor>
        </MergeFieldView>
        <MergeFieldView TValue="string" Label="Option notes" Field="fields.Notes" Format="Text" ShowUnchanged="ShowUnchanged" Changed="Changed">
            <ResultEditor Context="value">
                <NativeValueInput TValue="string" Multiline="true" Value="@value" ValueChanged="@(value => Set(fields.Notes, value))" ValueExpression="@(() => fields.Notes.Local)" class="cda-input cda-input--textarea" aria-label="Merged option notes" />
            </ResultEditor>
        </MergeFieldView>
    } else {
        @if (Row.RecreatesRemovedRow) {
            <SmallText Text="This saved option was removed. Keeping your row adds a new draft option; its retired identity is not reused." />
        }
        <MergeFieldView TValue="MergeEntry<ProjectOptionValues>" Label="Option membership and values" Field="Row.Row" Format="FormatRow" Changed="Changed" />
    }
</FormSection>

@code {
    [Parameter, EditorRequired] public ProjectOptionReview Row { get; set; } = default!;
    [Parameter] public bool ShowUnchanged { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    private static string Text(string value) => value;
    private static string FormatRow(MergeEntry<ProjectOptionValues> row) => !row.Exists ? "Removed" :
        $"{row.Value!.Category}: {row.Value.Name}\n{row.Value.Notes}";

    private async Task Set<T>(MergeField<T> field, T value) {
        field.SetResult(value);
        await Changed.InvokeAsync();
    }
}

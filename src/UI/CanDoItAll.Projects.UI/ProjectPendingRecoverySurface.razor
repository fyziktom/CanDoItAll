@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common

@if (View is { } view) {
    <Alert AlertStyle="AlertStyle.Info" data-testid="project-pending-recovery">
        <Stack GapScale="LayoutGap.Small">
            <TextBlock Value="@view.Status" />
            <TextBlock TextStyle="TextStyle.Caption" Value="@($"Save reference: {view.Operation.Id:D}")" />
            @if (view.HadStarterPlan) {
                <TextBlock Value="Definition recovery does not repeat starter-object creation. Inspect Structure for their outcome. Only the frozen definition is recoverable after restart; later typing and raw starter plans are not stored." />
            }
            <Cluster Wrap="FlexWrap.Wrap">
                <Button Text="Check saved outcome" ButtonStyle="ButtonStyle.Light" Disabled="@view.Busy"
                        Click="@(() => Send(ProjectPendingEditorAction.Check))" data-testid="project-pending-check" />
                <Button Text="Retry this exact save" ButtonStyle="ButtonStyle.Light" Disabled="@(view.Busy || !view.CanRetry)"
                        Click="@(() => Send(ProjectPendingEditorAction.Retry))" data-testid="project-pending-retry" />
                <Button Text="Apply accepted save to this draft" Disabled="@(view.Busy || !view.CanApply)"
                        Click="@(() => Send(ProjectPendingEditorAction.ApplyAccepted))" data-testid="project-pending-apply" />
                <Button Text="Cancel undispatched save" ButtonStyle="ButtonStyle.Light" Disabled="@(view.Busy || !view.CanCancel)"
                        Click="@(() => Send(ProjectPendingEditorAction.CancelPrepared))" data-testid="project-pending-cancel" />
                <Button Text="Finish resolved recovery" ButtonStyle="ButtonStyle.Light" Disabled="@(view.Busy || !view.CanClear)"
                        Click="@(() => Send(ProjectPendingEditorAction.ClearResolved))" data-testid="project-pending-finish" />
                <Button Text="Read current definition separately" ButtonStyle="ButtonStyle.Light" Disabled="@(view.Busy || !view.CanReadCurrent)"
                        Click="@(() => Send(ProjectPendingEditorAction.ReadCurrent))" data-testid="project-pending-current" />
            </Cluster>
        </Stack>
    </Alert>
}

@code {
    [Parameter] public ProjectPendingEditorView? View { get; set; }
    [Parameter] public EventCallback<ProjectPendingEditorIntent> Action { get; set; }
    private Task Send(ProjectPendingEditorAction action) => Action.InvokeAsync(new(View!.Operation, action));
}

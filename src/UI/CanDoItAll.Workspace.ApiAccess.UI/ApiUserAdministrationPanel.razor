@implements IDisposable

<Stack GapScale="LayoutGap.Medium" data-testid="api-users-panel">
    <Alert AlertStyle="AlertStyle.Info">Configured administrator: @Controller.Configuration.AdministratorName. Its credentials are deployment-owned. Change Api:BootstrapAdmin:PasswordHash and restart to reset it.</Alert>
    <Cluster Gap="LayoutGap.Small">
        <TextBox @bind-Value="Controller.Page.DesiredSearch" Immediate="true" Placeholder="Search API users" aria-label="Search API users" @onkeydown="SearchKeyAsync" data-testid="api-users-search" />
        <Button Text="Search" Click="Controller.Page.SearchAsync" ButtonStyle="ButtonStyle.Light" data-testid="api-users-search-submit" />
        <Button Text="Create user" Icon="person_add" Click="Controller.Create" data-testid="api-user-create" />
        <Button Text="Refresh" Icon="refresh" Click="Controller.Page.RefreshAsync" ButtonStyle="ButtonStyle.Light" data-testid="api-users-refresh" />
    </Cluster>
    @if (Controller.Outcome is { } outcome) {
        <Alert AlertStyle="@(outcome.IsCommitted ? AlertStyle.Success : AlertStyle.Warning)" data-testid="api-users-message">
            @ApiOutcomeText.Describe(outcome)
            @if (outcome.Identity is { } id) {
                <p>@(outcome.IsCommitted ? "Confirmed identity:" : "Original target or candidate:") @id @(outcome.Version is { } version ? $"· Version {version}" : string.Empty)</p>
            }
            @if (outcome.State == ApiWriteState.Unknown && outcome.Identity.HasValue) {
                <Button Text="Observe exact account" Click="Controller.ObserveOutcomeAsync" ButtonStyle="ButtonStyle.Light" />
            }
        </Alert>
    }
    @if (Controller.ObservationMessage is { } observation) {
        <Alert AlertStyle="AlertStyle.Info">
            @observation
            @if (Controller.Observation is { } observed) {
                <Button Text="Open current account" Click="() => Controller.OpenAsync(observed.Id, ApiWriteAction.UpdateAccount)" ButtonStyle="ButtonStyle.Light" />
            }
        </Alert>
    }
    @if (Controller.Page.Error is { } error) {
        <Alert AlertStyle="AlertStyle.Danger" data-testid="api-users-error">@error</Alert>
    }
    @if (Controller.Page.IsStale) {
        <Alert AlertStyle="AlertStyle.Warning" data-testid="api-users-stale">Retained rows are from search “@Controller.Page.AcceptedQuery!.Search”, page @(Controller.Page.AcceptedQuery.Offset / ApiPageQuery.PageSize + 1). Opening an account reads its exact current version.</Alert>
    }
    @if (Controller.Page.Page is { } page) {
        <DataGrid TItem="ApiAccountMetadata" Data="page.Items" Loading="Controller.Page.IsLoading" Caption="API users" EmptyText="No API users match this accepted search." data-testid="api-users-table">
            <Columns>
                <DataGridColumn TItem="ApiAccountMetadata" Title="User">
                    <Template Context="user"><strong>@user.UserName</strong><TextBlock Value="@user.DisplayName" /></Template>
                </DataGridColumn>
                <DataGridColumn TItem="ApiAccountMetadata" Title="Status">
                    <Template Context="user"><StatusBadge Text="@(user.Enabled ? "Enabled" : "Disabled")" Tone="@(user.Enabled ? "success" : "warning")" /></Template>
                </DataGridColumn>
                <DataGridColumn TItem="ApiAccountMetadata" Title="Capabilities">
                    <Template Context="user">@(user.Scopes.Length == 0 ? "No business permissions" : string.Join(", ", user.Scopes))</Template>
                </DataGridColumn>
                <DataGridColumn TItem="ApiAccountMetadata" Title="Actions">
                    <Template Context="user"><Cluster Gap="LayoutGap.Tiny">
                        <Button Text="Edit" Size="ButtonSize.Small" Click="() => Controller.OpenAsync(user.Id, ApiWriteAction.UpdateAccount)" data-testid="api-user-edit" />
                        <Button Text="Reset password" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="() => Controller.OpenAsync(user.Id, ApiWriteAction.ResetPassword)" data-testid="api-user-reset" />
                        <Button Text="Delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Click="() => Controller.OpenAsync(user.Id, ApiWriteAction.DeleteAccount)" data-testid="api-user-delete" />
                    </Cluster></Template>
                </DataGridColumn>
            </Columns>
        </DataGrid>
        <Cluster JustifyContent="JustifyContent.SpaceBetween">
            <span data-testid="api-users-page">@(page.TotalCount) users · Page @(Controller.Page.AcceptedQuery!.Offset / ApiPageQuery.PageSize + 1) · Search “@Controller.Page.AcceptedQuery.Search”</span>
            <Cluster Gap="LayoutGap.Tiny">
                <Button Text="Previous" Disabled="@(!Controller.Page.CanPrevious)" Click="Controller.Page.PreviousAsync" ButtonStyle="ButtonStyle.Light" />
                <Button Text="Next" Disabled="@(!Controller.Page.CanNext)" Click="Controller.Page.NextAsync" ButtonStyle="ButtonStyle.Light" />
            </Cluster>
        </Cluster>
    } else {
        <EmptyState Title="@(Controller.Page.IsLoading ? "Loading API users" : "API users unavailable")" Description="No account list has been accepted. Use Refresh to retry." />
    }
    @if (Controller.EditorLoading) {
        <EmptyState Title="Loading the exact account" Description="The editor opens after its current identity and version are known." />
    } else if (Controller.Editor is null && Controller.EditorError is { } editorLoadError) {
        <Alert AlertStyle="AlertStyle.Danger" data-testid="api-user-editor-error">@editorLoadError</Alert>
    }
</Stack>
@if (Controller.Editor is { } editor) {
    <Dialog @key="editor.Origin" IsOpen="true" Title="@Title(editor.Action)" Size="@(editor.Action == ApiWriteAction.DeleteAccount ? ModalSize.Compact : ModalSize.Medium)"
            OnClose="() => Controller.Close(editor.Origin)" TestId="api-user-dialog">
        <ChildContent>
            <EditForm EditContext="editor.Form" OnSubmit="() => Controller.SaveAsync(editor.Origin)">
                <Stack GapScale="LayoutGap.Medium">
                    <Alert AlertStyle="AlertStyle.Warning">Saving changes, resetting a password or deleting this user invalidates its existing sessions.</Alert>
                    @if (editor.Id is { } id) {
                        <p class="cda-body-muted break-all" data-testid="api-user-identity">@id · Version @editor.Version</p>
                    }
                    @if (editor.EditsProfile) {
                        <FormField Text="Username"><TextBox @bind-Value="editor.UserName" Immediate="true" maxlength="64" aria-label="Username" data-testid="api-user-name" /></FormField>
                        <FormField Text="Display name"><TextBox @bind-Value="editor.DisplayName" Immediate="true" maxlength="128" aria-label="User display name" data-testid="api-user-display-name" /></FormField>
                        <FormField Text="Enabled"><CheckBox TValue="bool" @bind-Value="editor.Enabled" data-testid="api-user-enabled" /></FormField>
                        <FormField Text="Business capabilities"><Stack GapScale="LayoutGap.Small">
                            <TextBlock Value="@(string.IsNullOrEmpty(editor.ScopeText) ? "No business permissions" : editor.ScopeText)" />
                            <Button Text="Choose capabilities" Icon="checklist" Click="() => OpenScopes(editor)" data-testid="api-user-scopes" />
                        </Stack></FormField>
                    }
                    @if (editor.NeedsPassword) {
                        <FormField Text="New password (12–256 characters)">
                            <Password @key="editor.Origin" @bind-Value="editor.Password" @oninput="args => editor.Password = args.Value?.ToString() ?? string.Empty"
                                      maxlength="256" autocomplete="new-password" aria-label="New password" data-testid="api-user-password" />
                        </FormField>
                    }
                    @if (editor.Action == ApiWriteAction.DeleteAccount) {
                        <TextBlock Value="@($"Delete {editor.UserName}? This cannot be undone.")" />
                    }
                    @if (Controller.EditorError is { } editorError) {
                        <Alert AlertStyle="AlertStyle.Danger" data-testid="api-user-editor-error">@editorError</Alert>
                    }
                </Stack>
            </EditForm>
        </ChildContent>
        <Footer><Cluster Gap="LayoutGap.Small" JustifyContent="JustifyContent.End">
            <Button Text="Cancel" Click="() => Controller.Close(editor.Origin)" ButtonStyle="ButtonStyle.Light" />
            <Button Text="@(editor.Action == ApiWriteAction.DeleteAccount ? "Delete user" : editor.Action == ApiWriteAction.ResetPassword ? "Reset password" : "Save user")"
                    Click="() => Controller.SaveAsync(editor.Origin)" Disabled="@(!Controller.CanSave)" IsBusy="editor.Pending" data-testid="api-user-save" />
        </Cluster></Footer>
    </Dialog>
    @if (ReferenceEquals(scopeEditor, editor) && scopeOrigin is { } scope) {
        <ApiScopePickerDialog @key="scope" Value="@scopeValue" Definitions="Controller.Configuration.Scopes" ForUser="true"
                              Confirmed="value => ApplyScopes(scope, value)" OnClose="() => CloseScopes(scope)" />
    }
}

@code {
    [Parameter, EditorRequired] public ApiAccountController Controller { get; set; } = default!;
    private ApiAccountController? subscribed;
    private ApiAccountDraft? scopeEditor;
    private Guid? scopeOrigin;
    private long scopeRevision;
    private string scopeValue = string.Empty;
    private bool disposed;
    protected override void OnParametersSet() {
        if (!ReferenceEquals(subscribed, Controller)) {
            Unsubscribe();
            subscribed = Controller;
            subscribed.Changed += Changed;
        }
    }
    private static string Title(ApiWriteAction action) => action switch {
        ApiWriteAction.CreateAccount => "Create API user",
        ApiWriteAction.UpdateAccount => "Edit API user",
        ApiWriteAction.ResetPassword => "Reset API user password",
        _ => "Delete API user"
    };
    private Task SearchKeyAsync(KeyboardEventArgs args) => args.Key == "Enter" ? Controller.Page.SearchAsync() : Task.CompletedTask;
    private void OpenScopes(ApiAccountDraft editor) {
        scopeEditor = editor;
        scopeOrigin = Guid.NewGuid();
        scopeRevision = editor.Revision;
        scopeValue = editor.ScopeText;
    }
    private void ApplyScopes(Guid origin, string value) {
        if (!disposed && scopeOrigin == origin && ReferenceEquals(scopeEditor, Controller.Editor) && scopeEditor?.Revision == scopeRevision) {
            scopeEditor.ScopeText = value;
            CloseScopes(origin);
        }
    }
    private void CloseScopes(Guid origin) {
        if (scopeOrigin == origin) {
            scopeOrigin = null;
            scopeEditor = null;
        }
    }
    private void Changed() => _ = InvokeAsync(() => {
        if (!disposed) {
            if (!ReferenceEquals(scopeEditor, Controller.Editor)) {
                scopeEditor = null;
                scopeOrigin = null;
            }
            StateHasChanged();
        }
    });
    private void Unsubscribe() {
        if (subscribed is not null) {
            subscribed.Changed -= Changed;
        }
        scopeEditor = null;
        scopeOrigin = null;
    }
    public void Dispose() {
        disposed = true;
        Unsubscribe();
    }
}

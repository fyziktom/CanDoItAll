@namespace CanDoItAll.Configuration.UI
@using CanDoItAll.SharedKernel.Configuration
@using Microsoft.AspNetCore.Components

@if (Schema.Fields.Count == 0) {
    <p class="cda-body-muted" data-testid="@($"{TestIdPrefix}-empty")">No configuration fields are defined.</p>
} else {
    <div class="grid grid-cols-1 gap-3 lg:grid-cols-2" data-testid="@TestIdPrefix">
        @foreach (var field in Schema.Fields) {
            <div @key="field.Key">
                <ConnectorConfigFieldEditor Field="field" State="State" Draft="Draft" Secrets="Secrets"
                                            TestId="@($"{TestIdPrefix}-{field.Key}")" StateChanged="StateChanged" />
                @foreach (var issue in Validation?.Issues.Where(issue => string.Equals(issue.FieldKey, field.Key, StringComparison.OrdinalIgnoreCase)) ?? []) {
                    <p class="workflow-canvas-error">@issue.Message</p>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public ConfigurationSchema Schema { get; set; } = default!;
    [Parameter, EditorRequired] public ConfigurationState State { get; set; } = default!;
    [Parameter] public ConfigurationInputDraft? Draft { get; set; }
    [Parameter] public IReadOnlyList<ConfigurationSecretOption> Secrets { get; set; } = [];
    [Parameter] public ConfigurationValidationResult? Validation { get; set; }
    [Parameter] public EventCallback<ConfigurationState> StateChanged { get; set; }
    [Parameter] public string TestIdPrefix { get; set; } = "configuration-field";
}

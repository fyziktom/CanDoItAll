@namespace CanDoItAll.Plugins.UI
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using CanDoItAll.Modules.Plugins
@using CanDoItAll.Plugins.Abstractions
@using CanDoItAll.SharedKernel.Configuration
@using Microsoft.AspNetCore.Components

@if (!Settings.ConnectionDescriptors.Any(item => item.AuthKind == PluginConnectionAuthKind.OAuth2))
{
    <EmptyState Eyebrow="Connections"
                Title="No OAuth connections"
                Description="This plugin does not expose OAuth-based connections." />
}
else
{
    <Stack GapScale="LayoutGap.Medium">
        @foreach (var connectionDescriptor in Settings.ConnectionDescriptors.Where(item => item.AuthKind == PluginConnectionAuthKind.OAuth2))
        {
            var editor = Workspace.View.Editor(Plugin.PluginId, connectionDescriptor);
            var oauthStatus = Workspace.View.OAuthStatus(editor);
            var canStartOAuth = Workspace.View.Settings.IsCurrent && Workspace.View.OAuth.IsCurrent && !editor.PreventsReplay && PluginsPageHelpers.CanStartOAuth(Plugin, Settings, connectionDescriptor, editor, ConnectionSettingsValidator);
            @if (editor.Operation is { } operation) {
                <p role="status">@operation.Status: @operation.Message</p>
                @if (operation.OAuthProgress is { } progress) {
                    <p>Connection @progress.ConnectionId: @progress.Stage. The provider callback confirms account connection.</p>
                }
            }
            <div class="grid gap-3 rounded-lg border border-[var(--cda-border-subtle)] bg-[var(--cda-surface-muted)] p-3 md:grid-cols-[minmax(0,1fr)_auto]">
                <Stack GapScale="LayoutGap.Tiny">
                    <Cluster Gap="LayoutGap.Small">
                        <StatusBadge Tone="@PluginsPageHelpers.ResolveOAuthTone(oauthStatus?.Status)" Text="@(oauthStatus?.Status.ToString() ?? (Workspace.View.OAuth.IsCurrent ? "NotConnected" : "Unknown"))" />
                        <StatusBadge Tone="neutral" Text="@connectionDescriptor.Key.Value" />
                    </Cluster>
                    <span class="text-sm font-medium text-[var(--cda-text)]">@connectionDescriptor.DisplayName</span>
                    <span class="text-sm text-[var(--cda-text-muted)]">@connectionDescriptor.Description</span>
                    @if (oauthStatus is not null && oauthStatus.GrantedScopes.Count > 0)
                    {
                        <span class="text-xs text-[var(--cda-text-muted)]">@string.Join(", ", oauthStatus.GrantedScopes)</span>
                    }
                    @if (oauthStatus is not null && !string.IsNullOrWhiteSpace(oauthStatus.LastErrorDescription))
                    {
                        <span class="text-sm text-[var(--cda-danger)]">Authorization failed. Review the connection settings and retry explicitly.</span>
                    }
                    @if (!canStartOAuth)
                    {
                        <span class="text-sm text-[var(--cda-warning)]">@PluginsPageHelpers.ResolveOAuthActionHint(Plugin, Settings, connectionDescriptor, editor, ConnectionSettingsValidator)</span>
                    }
                </Stack>
                <Cluster Gap="LayoutGap.Tiny" Class="self-start">
                    <Button Text="@PluginsPageHelpers.ResolveOAuthActionText(oauthStatus?.Status)"
                            Icon="login"
                            ButtonStyle="ButtonStyle.Primary"
                            Size="ButtonSize.Small"
                            data-testid="@PluginsPageHelpers.BuildOAuthLoginTestId(Plugin.PluginId, connectionDescriptor)"
                            Disabled="@(!canStartOAuth)"
                            IsBusy="@Workspace.View.IsBusy(new PluginOperationTarget.Connection(editor.Origin))"
                            Click="@(() => Workspace.StartOAuthAsync(editor))" />
                    <Button Text="Disconnect"
                            Icon="link_off"
                            ButtonStyle="ButtonStyle.Warning"
                            Variant="Variant.Outlined"
                            Size="ButtonSize.Small"
                            Disabled="@(editor.ConnectionId is null || editor.PreventsReplay || !Workspace.View.OAuth.IsCurrent || oauthStatus?.Status != PluginOAuthConnectionStatusKind.Connected)"
                            IsBusy="@Workspace.View.IsBusy(new PluginOperationTarget.Connection(editor.Origin))"
                            Click="@(() => Workspace.DisconnectOAuthAsync(editor))" />
                </Cluster>
            </div>
        }
    </Stack>
}

@code {
    private static readonly ConfigurationSchemaValidator ConnectionSettingsValidator = new();
    [Parameter, EditorRequired] public PluginCatalogItem Plugin { get; set; } = default!;
    [Parameter, EditorRequired] public PluginSettingsDetail Settings { get; set; } = default!;
    [Parameter, EditorRequired] public IPluginsWorkspace Workspace { get; set; } = default!;
}

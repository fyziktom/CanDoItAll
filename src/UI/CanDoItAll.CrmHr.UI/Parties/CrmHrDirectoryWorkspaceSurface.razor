@namespace CanDoItAll.CrmHr.UI.Parties
@inherits CrmHrWorkspaceSurface<ICrmHrDirectoryWorkspaceView>
@implements IAsyncDisposable

<NativeFormInspector @ref="browserInput" FormId="@FormId" PanelsSelector="[data-testid='crmhr-directory-tabs'] .cad-tabs__panels" />
<PageScaffold MaxWidthClass="max-w-full">
    <Header>
        <PageHeader Eyebrow="CRM / HR"
                    Title="Party directory"
                    Description="Create and maintain shared party records for people, organizations, delivery units, and AI agents before downstream CRM or HR workflows branch into specialized screens."
                    Compact="true">
            <Stats>
                <CompactStat Label="directory"
                             Value="Server-paged"
                             TooltipText="Directory records are queried in bounded pages." />
                <CompactStat Label="search"
                             Value="Name + tags"
                             TooltipText="Search and tag filters execute at the data source."
                             Tone="info" />
                <CompactStat Label="scope"
                             Value="4 party types"
                             TooltipText="People, organizations, organization units, and AI agents share this directory."
                             Tone="success" />
                <CompactStat Label="sensitive"
                             Value="Masked"
                             TooltipText="Sensitive summaries and tags stay out of list projections."
                             Tone="warning" />
            </Stats>
            <Actions>
                <PageHeaderActionButton Icon="import_export"
                                        Label="CSV tools"
                                        TooltipText="Import or export directory records as CSV."
                                        Click="View.OpenImportExportDialog"
                                        data-testid="crmhr-directory-import-export-button" />
                <PageHeaderActionButton Icon="person_add"
                                        Label="New party"
                                        TooltipText="Create a new shared party record."
                                        Tone="ButtonTone.Primary"
                                        Click="View.CreateNewAsync"
                                        data-testid="crmhr-directory-new-button" />
            </Actions>
        </PageHeader>
    </Header>

    <ChildContent>
        <Stack GapScale="LayoutGap.Medium">
            @SecondaryNavigation

            <SurfaceCard data-testid="crmhr-directory-catalog">
                <Stack GapScale="LayoutGap.Medium">
                    <ListPanelHeader Title="Directory records"
                                     Description="Search and page through shared people, organizations, delivery units, and AI agents. Open a card to view or edit the complete record."
                                     Count="Server-paged" />
                    <PartyRecordBrowser RefreshVersion="View.DirectoryBrowserVersion"
                                        SelectedPartyId="@View.Editor.Id"
                                        SelectionChanged="View.SelectPartyAsync"
                                        Query="@View.CatalogQuery"
                                        QueryChanged="View.HandleCatalogQueryChangedAsync"
                                        IncludeArchived="true"
                                        PageSize="18"
                                        ResultsScrollMode="PagedRecordResultsScrollMode.Bounded"
                                        GridMode="PagedRecordGridMode.BoundedCatalog"
                                        SearchPlaceholder="Search name, code, summary, or tags"
                                        OptionTestId="crmhr-directory-item"
                                        DataTestId="crmhr-directory" />
                </Stack>
            </SurfaceCard>

            @if (View.IsEditorDialogOpen)
            {
                <Dialog IsOpen="true"
                        Eyebrow="Party directory"
                        Title="@View.EditorTitle"
                        Subtitle="Shared identity, contact, privacy, activity, and relationship record."
                        Size="ModalSize.Full"
                        DenseChrome="true"
                        CloseOnBackdrop="false"
                        TestId="crmhr-directory-record-dialog"
                        OnClose="View.CloseEditorDialogAsync">
                    <ChildContent>
                    <Split Gap="LayoutGap.Medium">
                        <Stack GapScale="LayoutGap.Tiny">
                            <TextBlock TextStyle="TextStyle.EyebrowCaption">Party editor</TextBlock>
                            <h2 class="cda-text-block cda-text-block--h4">@View.EditorTitle</h2>
                            <TextBlock TextStyle="TextStyle.Muted" Class="leading-5">Shared identity and stewardship record.</TextBlock>
                            @if (View.Editor.PartyType == PartyType.Person && View.Editor.Id.HasValue)
                            {
                                @if (View.CurrentPrimaryAffiliation is { } primaryAffiliation)
                                {
                                    <TooltipTarget Text="@View.OtherCurrentAffiliationsTooltip"
                                                   Position="TooltipPosition.Bottom"
                                                   Duration="@((TimeSpan?)null)"
                                                   TestId="crmhr-directory-primary-affiliation-tooltip">
                                        <p class="text-sm font-medium text-chrome-700"
                                           data-testid="crmhr-directory-primary-affiliation">
                                            @CrmHrDirectoryWorkspacePresentation.FormatAffiliation(primaryAffiliation)
                                        </p>
                                    </TooltipTarget>
                                }
                                else
                                {
                                    <p class="text-sm font-medium text-chrome-600"
                                       data-testid="crmhr-directory-primary-affiliation">
                                        No current organization affiliation
                                    </p>
                                }
                            }
                        </Stack>
                        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                            <StatusBadge Tone="@CrmHrDirectoryWorkspacePresentation.ResolveStatusTone(View.Editor.LifecycleStatus)" Text="@View.Editor.LifecycleStatus.ToString()" />
                            <StatusBadge Tone="neutral" Text="@View.Editor.PartyType.ToString()" />
                            @if (View.Editor.IsSensitive)
                            {
                                <StatusBadge Tone="warning" Text="Sensitive" />
                            }
                        </Cluster>
                    </Split>

                    @EditingStatus
                    <EditForm id="crmhr-directory-record-form"
                              EditContext="@PartyContext()"
                              OnValidSubmit="HandleValidSubmitAsync">
                        <Stack Class="min-h-full" GapScale="LayoutGap.Large">
                            <ValidationSummary />
                            <Tabs SelectedIndex="@View.SelectedEditorTabIndex"
                                  SelectedIndexChanged="View.HandleEditorTabChangedAsync"
                                  RenderMode="TabRenderMode.Client"
                                  Density="TabsDensity.Compact"
                                  OverflowMode="TabsOverflowMode.Wrap"
                                  AriaLabel="Party editor sections"
                                  data-testid="crmhr-directory-tabs">
                                <TabsItem Text="Profile"
                                          Icon="badge"
                                          data-testid="crmhr-directory-tab-profile">
                                    <Stack GapScale="LayoutGap.XLarge">
                            <FormSection Title="Identity"
                                         Description="Capture the durable identity fields that let one record participate in CRM, HR, recruiting, and AI-agent flows.">
                                <Grid Gap="LayoutGap.Large" ColumnsMd="3">
                                    <FormField Text="Type">
                                        <SelectInput @bind-Value="View.Editor.PartyType"
                                                     data-testid="crmhr-party-type">
                                            @foreach (var partyType in Enum.GetValues<PartyType>())
                                            {
                                                <option value="@partyType">@partyType</option>
                                            }
                                        </SelectInput>
                                    </FormField>
                                    <FormField Text="Status">
                                        <SelectInput @bind-Value="View.Editor.LifecycleStatus"
                                                     data-testid="crmhr-party-status">
                                            @foreach (var lifecycleStatus in Enum.GetValues<PartyLifecycleStatus>())
                                            {
                                                <option value="@lifecycleStatus">@lifecycleStatus</option>
                                            }
                                        </SelectInput>
                                    </FormField>
                                    <FormField Text="External code">
                                        <NativeValueInput aria-label="External code" TValue="string" @bind-Value="View.Editor.ExternalCode"
                                                   class="form-input ui-input ui-input--outlined"
                                                   data-testid="crmhr-party-external-code" />
                                    </FormField>
                                </Grid>

                                <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                    <FormField Text="Display name">
                                        <NativeValueInput aria-label="Display name" TValue="string" @bind-Value="View.Editor.DisplayName"
                                                   class="form-input ui-input ui-input--outlined"
                                                   data-testid="crmhr-party-display-name" />
                                    </FormField>
                                    <FormField Text="Preferred name">
                                        <NativeValueInput aria-label="Preferred name" TValue="string" @bind-Value="View.Editor.PreferredName"
                                                   class="form-input ui-input ui-input--outlined"
                                                   data-testid="crmhr-party-preferred-name" />
                                    </FormField>
                                </Grid>

                                <FormField Text="Legal name">
                                    <NativeValueInput aria-label="Legal name" TValue="string" @bind-Value="View.Editor.LegalName"
                                               class="form-input ui-input ui-input--outlined"
                                               data-testid="crmhr-party-legal-name" />
                                </FormField>
                            </FormSection>

                            <FormSection Title="Classification and contact"
                                         Description="Keep role, tags, and direct contact details near the core identity so CRM, HR, and recruiting flows all start from the same party record.">
                                <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                    <FormField Text="Primary role">
                                        <SelectInput @bind-Value="View.Editor.PrimaryRoleKindText"
                                                     data-testid="crmhr-party-role">
                                            <option value="">No primary role yet</option>
                                            @foreach (var roleKind in Enum.GetValues<PartyRoleKind>())
                                            {
                                                <option value="@roleKind.ToString()">@roleKind</option>
                                            }
                                        </SelectInput>
                                    </FormField>
                                    <div>
                                        <label class="cda-form-field__label">Tags</label>
                                        <TagEditor @ref="tags" Value="@View.Editor.Tags"
                                                   ValueChanged="HandleTagsChangedAsync"
                                                   PendingInput="@PendingTagInput"
                                                   PendingInputChanged="PendingTagInputChanged"
                                                   Placeholder="Add customer, priority, or region tags"
                                                   MaxTags="20"
                                                   TestId="crmhr-party-tags-editor"
                                                   InputTestId="crmhr-party-tags" />
                                    </div>
                                </Grid>

                                <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                    <FormField Text="Primary email">
                                        <NativeValueInput aria-label="Primary email" TValue="string" @bind-Value="View.Editor.PrimaryEmail"
                                                   class="form-input ui-input ui-input--outlined"
                                                   data-testid="crmhr-party-email" />
                                    </FormField>
                                    <FormField Text="Primary phone">
                                        <NativeValueInput aria-label="Primary phone" TValue="string" @bind-Value="View.Editor.PrimaryPhone"
                                                   class="form-input ui-input ui-input--outlined"
                                                   data-testid="crmhr-party-phone" />
                                    </FormField>
                                </Grid>

                                <Stack GapScale="LayoutGap.Medium" Class="mt-5">
                                    <Split Gap="LayoutGap.Medium"
                                           AlignItems="AlignItems.Center"
                                           JustifyContent="JustifyContent.SpaceBetween">
                                        <div>
                                            <TextBlock TextStyle="TextStyle.EyebrowCaption">Additional role assignments</TextBlock>
                                            <p class="mt-1 text-sm leading-6 text-chrome-600">Keep more than one business role on the same party instead of creating duplicate directory records.</p>
                                        </div>
                                        <Button Text="Add role"
                                                Tone="ButtonTone.Default"
                                                Size="ButtonSize.Small"
                                                Click="View.AddAdditionalRole"
                                                data-testid="crmhr-party-role-add" />
                                    </Split>

                                    @if (View.Editor.AdditionalRoles.Count == 0)
                                    {
                                        <div class="rounded-[1.25rem] border border-dashed border-chrome-300 bg-chrome-50/70 px-4 py-4 text-sm leading-6 text-chrome-600">
                                            No secondary roles defined yet.
                                        </div>
                                    }
                                    else
                                    {
                                        @for (var index = 0; index < View.Editor.AdditionalRoles.Count; index++)
                                        {
                                            // The markup below renders inside component child content after the loop has moved on: it uses these
                                            // per-row copies, never the shared loop variable.
                                            var rowIndex = index;
                                            var role = View.Editor.AdditionalRoles[index];
                                            <PanelCard @key="role" Soft="true">
                                                <Grid Gap="LayoutGap.Medium" ColumnsLg="4">
                                                    <FormField Text="Role kind">
                                                        <SelectInput @bind-Value="role.RoleKind"
                                                                     data-testid="@($"crmhr-party-extra-role-kind-{rowIndex}")">
                                                            @foreach (var roleKind in Enum.GetValues<PartyRoleKind>())
                                                            {
                                                                <option value="@roleKind">@roleKind</option>
                                                            }
                                                        </SelectInput>
                                                    </FormField>
                                                    <div class="lg:col-span-2">
                                                        <FormField Text="Role title">
                                                            <NativeValueInput aria-label="Role title" TValue="string" @bind-Value="role.Title"
                                                                       class="form-input ui-input ui-input--outlined"
                                                                       data-testid="@($"crmhr-party-extra-role-title-{rowIndex}")" />
                                                        </FormField>
                                                    </div>
                                                    <div class="flex items-end justify-end">
                                                        <Button Text="Remove"
                                                                Tone="ButtonTone.Danger"
                                                                Size="ButtonSize.Small"
                                                                Click="@(() => View.RemoveAdditionalRole(role))"
                                                                data-testid="@($"crmhr-party-extra-role-remove-{rowIndex}")" />
                                                    </div>
                                                </Grid>

                                                <Grid Gap="LayoutGap.Medium" ColumnsLg="3" Class="mt-4">
                                                    <div>
                                                        <label class="cda-form-field__label">Valid from</label>
                                                        <InputDate @bind-Value="role.ValidFromUtc"
                                                                   @oninput="@(() => ReportPendingDate(new(role, nameof(PartyRoleAssignmentEditorModel.ValidFromUtc))))"
                                                                   class="form-input ui-input ui-input--outlined"
                                                                   data-testid="@($"crmhr-party-extra-role-start-{rowIndex}")" />
                                                    </div>
                                                    <div>
                                                        <label class="cda-form-field__label">Valid to</label>
                                                        <InputDate @bind-Value="role.ValidToUtc"
                                                                   @oninput="@(() => ReportPendingDate(new(role, nameof(PartyRoleAssignmentEditorModel.ValidToUtc))))"
                                                                   class="form-input ui-input ui-input--outlined"
                                                                   data-testid="@($"crmhr-party-extra-role-end-{rowIndex}")" />
                                                    </div>
                                                    <FormField Text="Notes">
                                                        <NativeValueInput aria-label="Notes" TValue="string" @bind-Value="role.Notes"
                                                                   class="form-input ui-input ui-input--outlined"
                                                                   data-testid="@($"crmhr-party-extra-role-notes-{rowIndex}")" />
                                                    </FormField>
                                                </Grid>
                                            </PanelCard>
                                        }
                                    }
                                </Stack>

                                <FormField Text="Summary">
                                    <NativeValueInput aria-label="Summary" TValue="string" Multiline="true" @bind-Value="View.Editor.Summary"
                                                   class="form-input ui-input ui-input--outlined ui-input--textarea min-h-24"
                                                   data-testid="crmhr-party-summary" />
                                </FormField>
                            </FormSection>
                                    </Stack>
                                </TabsItem>

                                <TabsItem Text="Contacts"
                                          Icon="contacts"
                                          data-testid="crmhr-directory-tab-contacts">
                                    <FormSection Title="Contact methods and addresses"
                                                 Description="Keep secondary contact methods and structured addresses on the shared party record so downstream screens do not need their own copies.">
                                        <Stack GapScale="LayoutGap.XLarge">
                                            <PartyContactMethodsEditor ContactPoints="View.Editor.AdditionalContactPoints" PendingChanged="ChildInputChanged" />
                                            <PartyAddressesEditor Addresses="View.Editor.Addresses" />
                                        </Stack>

                                        <Grid Gap="LayoutGap.Large" ColumnsMd="3" Class="mt-5">
                                            <FormField Text="Region">
                                                <NativeValueInput aria-label="Region" TValue="string" @bind-Value="View.Editor.Region"
                                                           class="form-input ui-input ui-input--outlined"
                                                           data-testid="crmhr-party-region" />
                                            </FormField>
                                            <FormField Text="Country code">
                                                <NativeValueInput aria-label="Country code" TValue="string" @bind-Value="View.Editor.CountryCode"
                                                           class="form-input ui-input ui-input--outlined"
                                                           data-testid="crmhr-party-country" />
                                            </FormField>
                                            <FormField Text="Time zone">
                                                <NativeValueInput aria-label="Time zone" TValue="string" @bind-Value="View.Editor.TimeZone"
                                                           class="form-input ui-input ui-input--outlined"
                                                           data-testid="crmhr-party-timezone" />
                                            </FormField>
                                        </Grid>
                                    </FormSection>
                                </TabsItem>

                                <TabsItem Text="Privacy"
                                          Icon="shield_lock"
                                          data-testid="crmhr-directory-tab-handling">
                            <FormSection Title="Privacy and notes"
                                         Description="Keep sensitivity, operational context, and confidential notes together so downstream CRM-HR flows do not overexpose private detail.">
                                @if (View.Editor.Id.HasValue)
                                {
                                    <SensitiveDataCallout IsSensitive="View.Editor.IsSensitive"
                                                         LastChangedBy="@View.Editor.LastChangedBy"
                                                         UpdatedAtUtc="View.Editor.UpdatedAtUtc"
                                                         DataTestId="crmhr-directory-sensitive-callout" />
                                }

                                <label class="ui-checkbox-option">
                                    <InputCheckbox class="form-checkbox ui-checkbox ui-checkbox--outlined" @bind-Value="View.Editor.IsSensitive"
                                                   data-testid="crmhr-party-sensitive" />
                                    Mark as sensitive
                                </label>

                                <FormField Text="Operational notes">
                                    <NativeValueInput aria-label="Operational notes" TValue="string" Multiline="true" @bind-Value="View.Editor.Notes"
                                                   class="form-input ui-input ui-input--outlined ui-input--textarea min-h-28"
                                                   data-testid="crmhr-party-notes" />
                                </FormField>

                                <div class="rounded-[1.25rem] border border-chrome-200 bg-chrome-50/80 px-4 py-4"
                                     data-testid="crmhr-confidential-notes-panel">
                                    <Split Gap="LayoutGap.Medium"
                                           AlignItems="AlignItems.Start"
                                           JustifyContent="JustifyContent.SpaceBetween">
                                        <div class="min-w-0">
                                            <TextBlock TextStyle="TextStyle.EyebrowCaption">Confidential notes</TextBlock>
                                            <h3 class="mt-1 text-lg font-semibold text-chrome-950">HR-only and sensitive note stream</h3>
                                            <p class="mt-3 text-sm leading-6 text-chrome-600">
                                                Keep high-sensitivity notes separate from broad operational context so downstream CRM-HR screens do not overexpose private detail.
                                            </p>
                                        </div>
                                        <Button Text="Add confidential note"
                                                Tone="ButtonTone.Default"
                                                Size="ButtonSize.Small"
                                                Type="button"
                                                Disabled="@(!View.Editor.IsSensitive)"
                                                Click="View.AddConfidentialNote"
                                                data-testid="crmhr-confidential-note-add" />
                                    </Split>

                                    @if (!View.Editor.IsSensitive)
                                    {
                                        <div class="mt-4 rounded-[1rem] border border-[var(--tone-warning-soft-border)] bg-[var(--tone-warning-soft-bg)] px-4 py-3 text-sm leading-6 text-[var(--tone-warning-soft-fg)]">
                                            Mark this record as sensitive before storing confidential notes.
                                        </div>
                                    }
                                    else if (View.Editor.ConfidentialNotes.Count == 0)
                                    {
                                        <div class="mt-4 rounded-[1rem] border border-dashed border-chrome-300 bg-[var(--tone-surface)] px-4 py-4 text-sm leading-6 text-chrome-600">
                                            No confidential notes stored yet.
                                        </div>
                                    }
                                    else
                                    {
                                        <Stack GapScale="LayoutGap.Medium" Class="mt-4">
                                            @for (var index = 0; index < View.Editor.ConfidentialNotes.Count; index++)
                                            {
                                                // The markup below renders inside component child content after the loop has moved on: it uses these
                                                // per-row copies, never the shared loop variable.
                                                var rowIndex = index;
                                                var note = View.Editor.ConfidentialNotes[index];
                                                <div @key="note" class="rounded-[1rem] border border-chrome-200 bg-[var(--tone-surface)] px-4 py-4"
                                                     data-testid="crmhr-confidential-note-item">
                                                    <Grid Gap="LayoutGap.Medium" ColumnsMd="4">
                                                        <FormField Text="Category">
                                                            <SelectInput @bind-Value="note.Category"
                                                                         data-testid="@($"crmhr-confidential-note-category-{rowIndex}")">
                                                                @foreach (var category in CrmHrDirectoryWorkspacePresentation.ConfidentialNoteCategories)
                                                                {
                                                                    <option value="@category">@category</option>
                                                                }
                                                            </SelectInput>
                                                        </FormField>
                                                        <div class="md:col-span-2">
                                                            <p class="text-xs uppercase tracking-[0.18em] text-[var(--tone-text-muted)]">Stewardship</p>
                                                            <p class="mt-1 text-sm leading-6 text-chrome-700">
                                                                Created @CrmHrDirectoryWorkspacePresentation.FormatMoment(note.CreatedAtUtc) by @CrmHrDirectoryWorkspacePresentation.FormatActor(note.CreatedBy)
                                                            </p>
                                                            <p class="text-sm leading-6 text-chrome-600">
                                                                Updated @CrmHrDirectoryWorkspacePresentation.FormatMoment(note.UpdatedAtUtc)
                                                            </p>
                                                        </div>
                                                        <div class="flex items-start justify-end">
                                                            <Button Text="Remove"
                                                                    Tone="ButtonTone.Danger"
                                                                    Size="ButtonSize.Small"
                                                                    Type="button"
                                                                    Click="@(() => View.RemoveConfidentialNote(note))"
                                                                    data-testid="@($"crmhr-confidential-note-remove-{rowIndex}")" />
                                                        </div>
                                                    </Grid>

                                                    <div class="mt-4">
                                                        <FormField Text="Confidential note">
                                                            <NativeValueInput aria-label="Confidential note" TValue="string" Multiline="true" @bind-Value="note.NoteText"
                                                                           class="form-input ui-input ui-input--outlined ui-input--textarea min-h-24"
                                                                           data-testid="@($"crmhr-confidential-note-text-{rowIndex}")" />
                                                        </FormField>
                                                    </div>
                                                </div>
                                            }
                                        </Stack>
                                    }
                                </div>

                            </FormSection>
                                </TabsItem>

                                <TabsItem Text="Activity"
                                          Icon="history"
                                          Disabled="@(!View.Editor.Id.HasValue)"
                                          data-testid="crmhr-directory-tab-activity">
                                    @if (View.PartyActivityPresentation is { IsLoading: true, Accepted: null })
                                    {
                                        <LoadingState Eyebrow="Party activity"
                                                      Title="Loading activity and assignments"
                                                      Description="Only this tab's timeline and project links are being loaded." />
                                    }
                                    else if (View.PartyActivityFailureMessage is { } activityFailure)
                                    {
                                        <SurfaceCard Soft="true" data-testid="crmhr-directory-activity-error">
                                            <TextBlock TextStyle="TextStyle.EyebrowCaption" Class="text-[var(--tone-danger-soft-fg)]">Activity unavailable</TextBlock>
                                            <p class="mt-2 text-sm leading-6 text-chrome-700">@activityFailure</p>
                                            <Button Text="Retry"
                                                    Icon="refresh"
                                                    Tone="ButtonTone.Default"
                                                    Size="ButtonSize.Small"
                                                    Class="mt-4"
                                                    Click="View.RetryActivityLoadAsync" />
                                        </SurfaceCard>
                                    }
                                    else
                                    {
                            <FormSection Title="Activity and project context"
                                         Description="Review the selected party's interaction history and project links without crowding the editable record fields.">
                                <Stack GapScale="LayoutGap.XLarge">
                                    @ActivityTimeline

                                    <SurfaceCard>
                                        <TextBlock TextStyle="TextStyle.EyebrowCaption">Project assignments</TextBlock>
                                        <h3 class="mt-1 text-lg font-semibold text-chrome-950">Assignments and delivery context</h3>
                                        <p class="mt-3 text-sm leading-6 text-chrome-600">
                                            Project-party links stay visible here so staffing, ownership, and stakeholder context do not require a separate workbench pass.
                                        </p>

                                        @if (View.IsProjectAssignmentsLoading)
                                        {
                                            <div class="mt-5">
                                                <LoadingState Eyebrow="Project assignments"
                                                              Title="Loading assignment page"
                                                              Description="Loading only the requested assignment page for this party." />
                                            </div>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(View.ProjectAssignmentsLoadError))
                                        {
                                            <SurfaceCard Soft="true" Class="mt-5">
                                                <TextBlock TextStyle="TextStyle.EyebrowCaption" Class="text-[var(--tone-danger-soft-fg)]">Project assignments unavailable</TextBlock>
                                                <h4 class="mt-1 text-base font-semibold text-chrome-950">Assignment history could not be loaded</h4>
                                                <p class="mt-2 text-sm leading-6 text-chrome-700">Retry to load the requested assignment page for this party.</p>
                                                <Button Text="Retry"
                                                        Icon="refresh"
                                                        Tone="ButtonTone.Default"
                                                        Size="ButtonSize.Small"
                                                        Class="mt-4"
                                                        Click="View.RetryProjectAssignmentsLoadAsync" />
                                            </SurfaceCard>
                                        }
                                        else if (View.ProjectAssignmentsPage.Items.Count == 0)
                                        {
                                            <div class="mt-5">
                                                <EmptyState Eyebrow="No assignments"
                                                            Title="This party is not linked to a project yet"
                                                            Description="Project, staffing, and stakeholder assignments will appear here after they are saved from project-aware flows." />
                                            </div>
                                        }
                                        else
                                        {
                                            <Stack GapScale="LayoutGap.Small" Class="mt-5">
                                                @foreach (var assignment in View.ProjectAssignmentsPage.Items)
                                                {
                                                    <div class="rounded-[1.25rem] border border-chrome-200 bg-chrome-50/80 px-4 py-4"
                                                         data-testid="crmhr-party-assignment-item">
                                                        <Split Gap="LayoutGap.Medium">
                                                            <div class="min-w-0">
                                                                <p class="text-sm font-semibold text-chrome-950">@assignment.ProjectName</p>
                                                                <p class="mt-2 text-xs uppercase tracking-[0.18em] text-[var(--tone-text-muted)]">@assignment.AssignmentKind / @assignment.NodeKey</p>
                                                                <p class="mt-2 text-xs text-[var(--tone-text-muted)]">@CrmHrDirectoryWorkspacePresentation.BuildAssignmentSchedule(assignment)</p>
                                                                @if (!string.IsNullOrWhiteSpace(assignment.Notes))
                                                                {
                                                                    <p class="mt-3 text-sm leading-6 text-chrome-600">@assignment.Notes</p>
                                                                }
                                                            </div>
                                                            <Cluster Gap="LayoutGap.Small">
                                                                @if (assignment.IsPrimary)
                                                                {
                                                                    <StatusBadge Tone="success" Text="Primary" />
                                                                }
                                                                @if (assignment.AllocationPercent.HasValue)
                                                                {
                                                                    <StatusBadge Tone="info" Text="@($"{assignment.AllocationPercent.Value:0.##}%")" />
                                                                }
                                                            </Cluster>
                                                        </Split>
                                                    </div>
                                                }
                                            </Stack>
                                        }

                                        <Split Breakpoint="LayoutBreakpoint.None"
                                               Gap="LayoutGap.Small"
                                               AlignItems="AlignItems.Center"
                                               JustifyContent="JustifyContent.SpaceBetween"
                                               Wrap="FlexWrap.Wrap"
                                               Class="mt-5"
                                               data-testid="crmhr-party-assignments-pager">
                                            <StatusBadge Tone="neutral" Text="@View.ProjectAssignmentsPageText" />
                                            <Cluster Gap="LayoutGap.Small">
                                                <Button Text="Previous"
                                                        Icon="chevron_left"
                                                        Tone="ButtonTone.Default"
                                                        Size="ButtonSize.Small"
                                                        Disabled="@(!View.CanMoveProjectAssignmentsPrevious)"
                                                        Click="@(() => View.HandleProjectAssignmentsPageRequestedAsync(View.ProjectAssignmentsPage.PageIndex - 1))"
                                                        data-testid="crmhr-party-assignments-previous" />
                                                <Button Text="Next"
                                                        Icon="chevron_right"
                                                        Tone="ButtonTone.Default"
                                                        Size="ButtonSize.Small"
                                                        Disabled="@(!View.CanMoveProjectAssignmentsNext)"
                                                        Click="@(() => View.HandleProjectAssignmentsPageRequestedAsync(View.ProjectAssignmentsPage.PageIndex + 1))"
                                                        data-testid="crmhr-party-assignments-next" />
                                            </Cluster>
                                        </Split>
                                    </SurfaceCard>
                                </Stack>
                            </FormSection>
                                    }
                                </TabsItem>

                                <TabsItem Text="Relations"
                                          Icon="account_tree"
                                          Disabled="@(!View.Editor.Id.HasValue)"
                                          data-testid="crmhr-directory-tab-relationships">
                                    @if (View.Editor.PartyType == PartyType.Person) {
                                        <FormSection Title="Organization affiliations" Description="Keep audited company affiliations with their effective dates and primary role.">
                                            <PartyAffiliationsEditor CurrentPersonPartyId="View.Editor.Id"
                                                Affiliations="View.AffiliationEditors" AffiliationsChanged="View.HandleAffiliationsChangedAsync"
                                                OwnerRevision="@AffiliationRevision" InputChanged="AffiliationInputChanged" PendingInputChanged="AffiliationPendingChanged"
                                                PartyDisplayNames="View.AffiliationPartyDisplayNames" />
                                        </FormSection>
                                    }
                                    @if (View.IsRelationshipsLoading)
                                    {
                                        <LoadingState Eyebrow="Party relationships"
                                                      Title="Loading relationships and duplicate candidates"
                                                      Description="Only this tab's stewardship data is being loaded." />
                                    }
                                    else if (!string.IsNullOrWhiteSpace(View.RelationshipsLoadError))
                                    {
                                        <SurfaceCard Soft="true" data-testid="crmhr-directory-relationships-error">
                                            <TextBlock TextStyle="TextStyle.EyebrowCaption" Class="text-[var(--tone-danger-soft-fg)]">Relationship data unavailable</TextBlock>
                                            <p class="mt-2 text-sm leading-6 text-chrome-700">@View.RelationshipsLoadError</p>
                                            <Button Text="Retry"
                                                    Icon="refresh"
                                                    Tone="ButtonTone.Default"
                                                    Size="ButtonSize.Small"
                                                    Class="mt-4"
                                                    Click="View.RetryRelationshipsLoadAsync" />
                                        </SurfaceCard>
                                    }
                            <FormSection Title="Relationships and duplicate stewardship"
                                         Description="Model org structure and safe deduplication here so downstream CRM, workforce, recruiting, and assignment flows inherit trusted references.">
                                <Stack GapScale="LayoutGap.XLarge">
                                    <PartyRelationshipsEditor CurrentPartyId="View.Editor.Id"
                                                             Relationships="View.Relationships" RelationshipsChanged="View.HandleRelationshipsChangedAsync"
                                                             OwnerRevision="RelationshipRevision" InputChanged="RelationshipInputChanged" PendingInputChanged="RelationshipPendingChanged"
                                                             Disabled="@(View.IsRelationshipsLoading || !string.IsNullOrWhiteSpace(View.RelationshipsLoadError))" />

                                    @if (!View.IsRelationshipsLoading && string.IsNullOrWhiteSpace(View.RelationshipsLoadError)) {
                                    @if (!View.Editor.Id.HasValue)
                                    {
                                        <div class="rounded-[1.25rem] border border-dashed border-chrome-300 bg-chrome-50/70 px-4 py-4 text-sm leading-6 text-chrome-600">
                                            Save the party first to evaluate duplicate candidates against persisted directory records.
                                        </div>
                                    }
                                    else
                                    {
                                        <Stack GapScale="LayoutGap.Medium">
                                            <Split Gap="LayoutGap.Medium"
                                                   AlignItems="AlignItems.Center"
                                                   JustifyContent="JustifyContent.SpaceBetween">
                                                <div>
                                                    <TextBlock TextStyle="TextStyle.EyebrowCaption">Potential duplicates</TextBlock>
                                                    <p class="mt-1 text-sm leading-6 text-chrome-600">Candidates are ranked by external code, normalized names, and contact value overlap.</p>
                                                </div>
                                                <StatusBadge Tone="@(View.DuplicateCandidates.Count == 0 ? "success" : "warning")"
                                                             Text="@(View.DuplicateCandidates.Count == 0 ? "No duplicates" : $"{View.DuplicateCandidates.Count} candidate(s)")" />
                                            </Split>

                                            @if (View.DuplicateCandidates.Count == 0)
                                            {
                                                <div class="rounded-[1.25rem] border border-dashed border-chrome-300 bg-chrome-50/70 px-4 py-4 text-sm leading-6 text-chrome-600">
                                                    No duplicate candidates are currently detected for this party.
                                                </div>
                                            }
                                            else
                                            {
                                                @foreach (var candidate in View.DuplicateCandidates)
                                                {
                                                    <PanelCard Soft="true">
                                                        <Split Gap="LayoutGap.Medium"
                                                               AlignItems="AlignItems.Start"
                                                               JustifyContent="JustifyContent.SpaceBetween">
                                                            <div class="min-w-0">
                                                                <p class="text-sm font-semibold text-chrome-950">@candidate.DisplayName</p>
                                                                <p class="mt-1 text-xs uppercase tracking-[0.18em] text-[var(--tone-text-muted)]">@candidate.PartyType / @candidate.LifecycleStatus</p>
                                                                @if (!string.IsNullOrWhiteSpace(candidate.Summary))
                                                                {
                                                                    <p class="mt-3 text-sm leading-6 text-chrome-700">@candidate.Summary</p>
                                                                }
                                                                <p class="mt-3 text-sm leading-6 text-chrome-700">Reasons: @string.Join(", ", candidate.MatchReasons)</p>
                                                            </div>
                                                            <Button Text="Merge into current party"
                                                                    Tone="ButtonTone.Warning"
                                                                    Size="ButtonSize.Small"
                                                                    Click="@(() => View.OpenMergeDialogAsync(candidate))"
                                                                    data-testid="@($"crmhr-merge-open-{candidate.Id:N}")" />
                                                        </Split>
                                                    </PanelCard>
                                                }
                                            }
                                        </Stack>
                                    }
                                    }
                                </Stack>
                            </FormSection>
                                </TabsItem>
                            </Tabs>

                        </Stack>
                    </EditForm>
                    @EditorOverlays
                    </ChildContent>
                    <Footer>
                        <Split Breakpoint="LayoutBreakpoint.None"
                               Gap="LayoutGap.Medium"
                               AlignItems="AlignItems.Center"
                               JustifyContent="JustifyContent.SpaceBetween"
                               Wrap="FlexWrap.Wrap">
                            <SmallText Text="Changes remain local until Save party succeeds." />
                            <Cluster Gap="LayoutGap.Small">
                                <Button Text="Close"
                                        Tone="ButtonTone.Default"
                                        Click="View.CloseEditorDialogAsync"
                                        data-testid="crmhr-directory-record-close" />
                                <Button Text="Save party"
                                        Disabled="@SaveDisabled"
                                        Click="SaveFromFooterAsync"
                                        data-testid="crmhr-party-save-button" />
                            </Cluster>
                        </Split>
                    </Footer>
                </Dialog>
            }

            <PartyMergeDialog @key="View.Merge.Opening" Presentation="@View.Merge"
                              Candidate="@View.MergeCandidate"
                              Refresh="View.RefreshMergePreviewAsync"
                              NoteStatusChanged="View.HandleMergeNoteStatusChanged"
                              Overlays="@MergeOverlays"
                              OnClose="View.HandleMergeCloseAsync"
                              OnConfirm="View.HandleMergeConfirmAsync" />

            @if (View.IsImportExportDialogOpen)
            {
                <Dialog IsOpen="true"
                        Eyebrow="Party directory"
                        Title="Import and export"
                        Subtitle="Export the full directory on demand or validate CSV rows before importing them."
                        Size="ModalSize.Wide"
                        DenseChrome="true"
                        TestId="crmhr-directory-import-export-dialog"
                        OnClose="View.CloseImportExportDialogAsync">
                    <ChildContent>
                        <PartyImportExportActions ExportScope="PartyCsvExportScope.EntireDirectory"
                                                  ExportCsv="View.ExportPartyCsvAsync"
                                                  PreviewImport="View.PreviewPartyImportAsync"
                                                  ApplyImport="View.ApplyPartyImportAsync"
                                                  StatusChanged="View.HandleImportStatusChanged"
                                                  ImportApplied="View.HandleImportAppliedAsync" />
                        @ImportOverlays
                    </ChildContent>
                </Dialog>
            }

        </Stack>
    </ChildContent>
</PageScaffold>

@code {
    private const string FormId = "crmhr-directory-record-form";
    private EditContext? editorContext;
    private EditContext? observedContext;
    private NativeFormInspector browserInput = default!;
    private TagEditor? tags;
    private bool focusInvalid;
    private bool disposed;

    [Parameter] public RenderFragment? EditingStatus { get; set; }
    [Parameter] public RenderFragment? EditorOverlays { get; set; }
    [Parameter] public RenderFragment? ImportOverlays { get; set; }
    [Parameter] public RenderFragment? MergeOverlays { get; set; }
    [Parameter] public bool SaveDisabled { get; set; }
    [Parameter] public EventCallback DirtyChanged { get; set; }
    [Parameter] public EventCallback<PartyEditorInputChange> InputChanged { get; set; }
    [Parameter] public EventCallback<bool> ValidationChanged { get; set; }
    [Parameter] public long AffiliationRevision { get; set; }
    [Parameter] public EventCallback<AffiliationInput> AffiliationInputChanged { get; set; }
    [Parameter] public EventCallback<bool> AffiliationPendingChanged { get; set; }
    [Parameter] public long RelationshipRevision { get; set; }
    [Parameter] public EventCallback<RelationshipInput> RelationshipInputChanged { get; set; }
    [Parameter] public EventCallback<bool> RelationshipPendingChanged { get; set; }
    [Parameter] public EventCallback<bool> ChildInputChanged { get; set; }
    [Parameter] public string PendingTagInput { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> PendingTagInputChanged { get; set; }
    [Parameter] public RenderFragment? ActivityTimeline { get; set; }

    private EditContext PartyContext() {
        var current = ContextFor(ref editorContext, View.Editor);
        if (!ReferenceEquals(current, observedContext)) {
            UnsubscribeContext();
            observedContext = current;
            observedContext.OnFieldChanged += OnPartyFieldChanged;
            observedContext.OnValidationStateChanged += OnValidationChanged;
        }
        return current;
    }

    private void OnPartyFieldChanged(object? sender, FieldChangedEventArgs args) {
        if (PartyEditorFieldKey.From(args.FieldIdentifier, View.Editor) is { } key) {
            _ = InputChanged.InvokeAsync(new(key));
        } else {
            _ = DirtyChanged.InvokeAsync();
        }
    }

    private void OnValidationChanged(object? sender, ValidationStateChangedEventArgs args) =>
        _ = ValidationChanged.InvokeAsync(observedContext?.GetValidationMessages().Any() == true);

    private Task ReportPendingDate(FieldIdentifier field) => PartyEditorFieldKey.From(field, View.Editor) is { } key
        ? InputChanged.InvokeAsync(new(key, PendingDateInput: true))
        : throw new InvalidOperationException("The Party date control has no field identity.");

    private async Task HandleTagsChangedAsync(IReadOnlyList<string> values) {
        View.Editor.Tags = values;
        await InputChanged.InvokeAsync(new(new(PartyEditableField.Tags)));
    }

    private Task HandleValidSubmitAsync() => tags?.IsInputFocused == true ? Task.CompletedTask : View.SaveAsync();
    private Task SaveFromFooterAsync() => SubmitAsync(editorContext, View.SaveAsync);

    public async Task<bool> ValidateInputsAsync() {
        var context = editorContext ?? throw new InvalidOperationException("Open the Party form before inspecting its input.");
        var draft = View.Editor;
        var validity = await browserInput.InspectAsync();
        if (disposed || !ReferenceEquals(draft, View.Editor)) {
            return false;
        }
        var valid = context.Validate() && validity.IsValid;
        if (!valid) {
            if (validity.SectionIndex is int section && section != View.SelectedEditorTabIndex) {
                await View.HandleEditorTabChangedAsync(section);
            }
            focusInvalid = true;
            StateHasChanged();
        }
        return valid;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (focusInvalid && !disposed) {
            focusInvalid = false;
            await browserInput.FocusInvalidAsync();
        }
    }

    private void UnsubscribeContext() {
        if (observedContext is not null) {
            observedContext.OnFieldChanged -= OnPartyFieldChanged;
            observedContext.OnValidationStateChanged -= OnValidationChanged;
        }
    }

    public ValueTask DisposeAsync() {
        disposed = true;
        UnsubscribeContext();
        return ValueTask.CompletedTask;
    }
}

@inject IPartyRecordQueryService PartyRecordQueryService
@implements IDisposable

<fieldset disabled="@Disabled" class="min-w-0 w-full">
<Stack GapScale="LayoutGap.Medium">
    <Split Gap="LayoutGap.Medium"
           AlignItems="AlignItems.Center"
           JustifyContent="JustifyContent.SpaceBetween">
        <div>
            <p class="cda-eyebrow">Relationships and org structure</p>
            <p class="mt-1 text-sm leading-6 text-slate-600">Model parent-child, reporting, membership, and partner links without losing the shared party identity.</p>
        </div>
        <Button Text="Add relationship"
                ButtonStyle="ButtonStyle.Light"
                Size="ButtonSize.Small"
                Click="AddRelationshipAsync"
                Disabled="@(!CurrentPartyId.HasValue)"
                data-testid="crmhr-relationship-add" />
    </Split>

    @if (!CurrentPartyId.HasValue)
    {
        <div class="rounded-[1.25rem] border border-dashed border-slate-300 bg-slate-50/70 px-4 py-4 text-sm leading-6 text-slate-600">
            Save the party first, then add relationships to other saved parties.
        </div>
    }
    else if (edits.Count == 0)
    {
        <div class="rounded-[1.25rem] border border-dashed border-slate-300 bg-slate-50/70 px-4 py-4 text-sm leading-6 text-slate-600">
            No relationships defined yet.
        </div>
    }
    else
    {
        @foreach (var row in edits.Select((item, index) => (Item: item, Index: index)))
        {
            var item = row.Item;
            var rowIndex = row.Index;
            <PanelCard @key="item" Soft="true">
                <Grid Gap="LayoutGap.Medium" ColumnsLg="4">
                    <div>
                        <label class="cda-field-label">Direction</label>
                        <InputSelect TValue="bool"
                                     Value="@item.IsOutgoing"
                                     ValueChanged="@((bool value) => UpdateDirectionAsync(item, value))"
                                     ValueExpression="@(() => item.IsOutgoing)"
                                     class="cda-input"
                                     data-testid="@($"crmhr-relationship-direction-{rowIndex}")">
                            <option value="true">This party points to related party</option>
                            <option value="false">Related party points to this party</option>
                        </InputSelect>
                    </div>
                    <div>
                        <label class="cda-field-label">Relationship</label>
                        <InputSelect TValue="PartyRelationshipKind" Value="@item.RelationshipKind"
                                     ValueChanged="@((PartyRelationshipKind value) => UpdateKindAsync(item, value))"
                                     ValueExpression="@(() => item.RelationshipKind)"
                                     class="cda-input"
                                     data-testid="@($"crmhr-relationship-kind-{rowIndex}")">
                            @foreach (var relationshipKind in Enum.GetValues<PartyRelationshipKind>())
                            {
                                <option value="@relationshipKind">@relationshipKind</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="lg:col-span-2">
                        <label class="cda-field-label">Related party</label>
                        <Split Breakpoint="LayoutBreakpoint.None"
                               Gap="LayoutGap.Small"
                               AlignItems="AlignItems.Center"
                               JustifyContent="JustifyContent.SpaceBetween">
                            <p class="min-w-0 truncate text-sm text-slate-700"
                               data-testid="@($"crmhr-relationship-party-name-{rowIndex}")">
                                @ResolveRelatedPartyLabel(item)
                            </p>
                            <Button Text="Choose party"
                                    Icon="search"
                                    ButtonStyle="ButtonStyle.Light"
                                    Size="ButtonSize.Small"
                                    Click="@(() => OpenRelatedPartyPickerAsync(item))"
                                    data-testid="@($"crmhr-relationship-party-{rowIndex}")" />
                        </Split>
                    </div>
                </Grid>

                <Grid Gap="LayoutGap.Medium" ColumnsLg="3" Class="mt-4">
                    <div>
                        <label class="cda-field-label">Start date</label>
                        <InputDate TValue="DateTimeOffset?" Value="@item.StartDateUtc"
                                   @oninput="@(() => ReportPendingDateAsync(item, RelationshipField.Start))"
                                   ValueChanged="@((DateTimeOffset? value) => UpdateStartAsync(item, value))"
                                   ValueExpression="@(() => item.StartDateUtc)"
                                   class="cda-input"
                                   data-testid="@($"crmhr-relationship-start-{rowIndex}")" />
                    </div>
                    <div>
                        <label class="cda-field-label">End date</label>
                        <InputDate TValue="DateTimeOffset?" Value="@item.EndDateUtc"
                                   @oninput="@(() => ReportPendingDateAsync(item, RelationshipField.End))"
                                   ValueChanged="@((DateTimeOffset? value) => UpdateEndAsync(item, value))"
                                   ValueExpression="@(() => item.EndDateUtc)"
                                   class="cda-input"
                                   data-testid="@($"crmhr-relationship-end-{rowIndex}")" />
                    </div>
                    <label class="cda-inline-option">
                        <InputCheckbox Value="@item.IsPrimary"
                                       ValueChanged="@((bool value) => UpdatePrimaryAsync(item, value))"
                                       ValueExpression="@(() => item.IsPrimary)"
                                       data-testid="@($"crmhr-relationship-primary-{rowIndex}")" />
                        Primary relationship
                    </label>
                </Grid>

                <Grid Gap="LayoutGap.Medium" ColumnsLg="2" Class="mt-4">
                    <div>
                        <label class="cda-field-label">Notes</label>
                        <NativeValueInput TValue="string" Multiline="true" Value="@item.Notes"
                                   ValueChanged="@((string? value) => UpdateNotesAsync(item, value))"
                                   ValueExpression="@(() => item.Notes)"
                                   rows="3"
                                   class="cda-input"
                                   data-testid="@($"crmhr-relationship-notes-{rowIndex}")" />
                    </div>
                    <div class="flex items-end justify-end">
                        <Button Text="Remove"
                                ButtonStyle="ButtonStyle.Danger"
                                Size="ButtonSize.Small"
                                Click="@(() => RemoveRelationshipAsync(item))"
                                data-testid="@($"crmhr-relationship-remove-{rowIndex}")" />
                    </div>
                </Grid>
            </PanelCard>
        }
    }
</Stack>
</fieldset>

<PartyRecordPickerDialog IsOpen="@(pickerTarget is not null)"
                         SelectedPartyId="@SelectedRelatedPartyId"
                         ExcludedPartyId="@CurrentPartyId"
                         SelectionConfirmed="SelectRelatedPartyAsync"
                         OnClose="CloseRelatedPartyPickerAsync"
                         Eyebrow="Party relationship"
                         Title="Choose a related party"
                         Subtitle="Search the full directory by name, code, summary, tags, or party type."
                         DataTestId="crmhr-relationship-picker" />

@code {
    private readonly List<PartyRelationshipEditorModel> edits = [];
    private IReadOnlyList<PartyRelationshipEditorModel>? configured;
    private long configuredRevision;
    private Guid? configuredPartyId;
    private PartyRelationshipEditorModel? pickerTarget;
    private bool newPickerTarget;
    private long pickerGeneration;
    private bool disposed;
    [Parameter] public Guid? CurrentPartyId { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<PartyRelationshipEditorModel> Relationships { get; set; } = [];
    [Parameter] public EventCallback<IReadOnlyList<PartyRelationshipEditorModel>> RelationshipsChanged { get; set; }
    [Parameter] public long OwnerRevision { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<RelationshipInput> InputChanged { get; set; }
    [Parameter] public EventCallback<bool> PendingInputChanged { get; set; }
    [CascadingParameter] private EditContext? FormContext { get; set; }
    private Guid? SelectedRelatedPartyId => pickerTarget?.RelatedPartyId is Guid id && id != Guid.Empty ? id : null;

    protected override void OnParametersSet() {
        if (ReferenceEquals(configured, Relationships) && configuredRevision == OwnerRevision && configuredPartyId == CurrentPartyId) {
            return;
        }
        var changedParty = configuredPartyId != CurrentPartyId;
        RelationshipValues.Adopt(edits, Relationships);
        configured = Relationships;
        configuredRevision = OwnerRevision;
        configuredPartyId = CurrentPartyId;
        if (pickerTarget is not null && (changedParty || !edits.Contains(pickerTarget))) {
            pickerTarget = null;
            newPickerTarget = false;
            pickerGeneration++;
        }
    }
    private async Task AddRelationshipAsync() {
        if (CurrentPartyId is null) {
            return;
        }
        var row = new PartyRelationshipEditorModel { Id = Guid.NewGuid() };
        edits.Add(row);
        pickerTarget = row;
        newPickerTarget = true;
        pickerGeneration++;
        await PendingInputChanged.InvokeAsync(true);
        await PublishAsync();
    }
    private async Task RemoveRelationshipAsync(PartyRelationshipEditorModel row) {
        edits.Remove(row);
        if (ReferenceEquals(pickerTarget, row)) {
            pickerTarget = null;
            newPickerTarget = false;
            pickerGeneration++;
            await PendingInputChanged.InvokeAsync(false);
        }
        await PublishAsync();
    }
    private async Task OpenRelatedPartyPickerAsync(PartyRelationshipEditorModel row) {
        pickerTarget = row;
        newPickerTarget = false;
        pickerGeneration++;
        await PendingInputChanged.InvokeAsync(true);
    }
    private async Task SelectRelatedPartyAsync(Guid partyId) {
        if (pickerTarget is not { } row) {
            return;
        }
        var generation = pickerGeneration;
        var target = CurrentPartyId;
        var selected = await PartyRecordQueryService.GetAsync(partyId, includeArchived: true);
        if (disposed || generation != pickerGeneration || target != CurrentPartyId || !ReferenceEquals(row, pickerTarget)) {
            return;
        }
        if (selected is null) {
            throw new InvalidOperationException($"Selected related party '{partyId}' no longer exists.");
        }
        row.RelatedPartyId = partyId;
        row.RelatedPartyDisplayName = selected.DisplayName;
        row.RelatedPartyType = selected.PartyType;
        pickerTarget = null;
        newPickerTarget = false;
        pickerGeneration++;
        await PendingInputChanged.InvokeAsync(false);
        await PublishInputAsync(row, RelationshipField.Party);
    }
    private async Task CloseRelatedPartyPickerAsync() {
        if (newPickerTarget && pickerTarget is { RelatedPartyId: var id } && id == Guid.Empty) {
            edits.Remove(pickerTarget);
            await PublishAsync();
        }
        pickerTarget = null;
        newPickerTarget = false;
        pickerGeneration++;
        await PendingInputChanged.InvokeAsync(false);
    }
    private Task PublishAsync() => RelationshipsChanged.InvokeAsync(RelationshipValues.Snapshot(edits));
    private async Task PublishInputAsync(PartyRelationshipEditorModel row, RelationshipField field) {
        await InputChanged.InvokeAsync(new(row.Id!.Value, field));
        await PublishAsync();
    }
    private Task ReportPendingDateAsync(PartyRelationshipEditorModel row, RelationshipField field) => InputChanged.InvokeAsync(new(row.Id!.Value, field, PendingDate: true));
    private Task UpdateDirectionAsync(PartyRelationshipEditorModel row, bool value) {
        row.IsOutgoing = value;
        return PublishInputAsync(row, RelationshipField.Direction);
    }
    private Task UpdateKindAsync(PartyRelationshipEditorModel row, PartyRelationshipKind value) {
        row.RelationshipKind = value;
        return PublishInputAsync(row, RelationshipField.Kind);
    }
    private Task UpdatePrimaryAsync(PartyRelationshipEditorModel row, bool value) {
        row.IsPrimary = value;
        return PublishInputAsync(row, RelationshipField.Primary);
    }
    private Task UpdateStartAsync(PartyRelationshipEditorModel row, DateTimeOffset? value) {
        row.StartDateUtc = value;
        return PublishInputAsync(row, RelationshipField.Start);
    }
    private Task UpdateEndAsync(PartyRelationshipEditorModel row, DateTimeOffset? value) {
        row.EndDateUtc = value;
        return PublishInputAsync(row, RelationshipField.End);
    }
    private Task UpdateNotesAsync(PartyRelationshipEditorModel row, string? value) {
        row.Notes = value ?? string.Empty;

        return PublishInputAsync(row, RelationshipField.Notes);
    }
    private static string ResolveRelatedPartyLabel(PartyRelationshipEditorModel row) => row.RelatedPartyId == Guid.Empty ? "No party selected" :
        string.IsNullOrWhiteSpace(row.RelatedPartyDisplayName) ? row.RelatedPartyId.ToString("D") :
            row.RelatedPartyType is { } type ? $"{row.RelatedPartyDisplayName} ({type})" : row.RelatedPartyDisplayName;
    public void Dispose() {
        disposed = true;
        pickerGeneration++;
    }
}

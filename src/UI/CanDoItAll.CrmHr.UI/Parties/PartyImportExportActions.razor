@using CanDoItAll.SharedKernel
@implements IDisposable

<Stack GapScale="LayoutGap.Large">
    <Split Gap="LayoutGap.Large"
           AlignItems="AlignItems.Start"
           JustifyContent="JustifyContent.SpaceBetween">
        <Stack GapScale="LayoutGap.Small">
            <TextBlock TextStyle="TextStyle.EyebrowCaption">Bulk import and export</TextBlock>
            <h2 class="text-lg font-semibold text-chrome-950">CSV stewardship tools</h2>
            <p class="text-sm leading-6 text-chrome-600">
                @ExportDescription
            </p>
        </Stack>
        <Cluster Gap="LayoutGap.Small">
            <Button Text="Refresh export"
                    Tone="ButtonTone.Default"
                    Size="ButtonSize.Small"
                    Click="RefreshExportAsync"
                    data-testid="crmhr-export-refresh" />
            <Button Text="Preview import"
                    Tone="ButtonTone.Info"
                    Size="ButtonSize.Small"
                    Click="PreviewImportAsync"
                    Disabled="@(phase is PartyImportPhase.Applying or PartyImportPhase.Previewing)"
                    data-testid="crmhr-import-preview-button" />
            <Button Text="Apply import"
                    Tone="ButtonTone.Success"
                    Size="ButtonSize.Small"
                    Click="ApplyImportAsync"
                    Disabled="@(phase != PartyImportPhase.Editing || preview is null || preview.ReadyRowCount == 0)"
                    data-testid="crmhr-import-apply-button" />
        </Cluster>
    </Split>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div>
            <StatusBadge Tone="@statusTone" Text="@statusMessage" />
        </div>
    }
    @if (exportError is not null) {
        <Alert AlertStyle="AlertStyle.Warning"><TextBlock Value="@exportError" /></Alert>
    }

    <Grid Gap="LayoutGap.Large" ColumnsLg="2">
        <FormField Text="Export preview">
            <TextAreaInput Value="@exportText" ReadOnly="true" Class="min-h-40" data-testid="crmhr-export-textarea" />
        </FormField>
        <FormField Text="Import CSV">
            <TextAreaInput Value="@importText" ValueChanged="SetImportTextAsync" Immediate="true" Class="min-h-40"
                      Placeholder="DisplayName,PartyType,LifecycleStatus,ExternalCode,..." data-testid="crmhr-import-textarea" />
        </FormField>
    </Grid>

    @if (preview is not null)
    {
        <Stack GapScale="LayoutGap.Medium">
            <TextBlock TextStyle="TextStyle.EyebrowCaption">Import preview</TextBlock>
            <p class="text-sm leading-6 text-chrome-600">@($"{preview.ReadyRowCount} ready row(s), {preview.BlockingRowCount} blocking row(s).")</p>

            @foreach (var row in preview.Rows)
            {
                <div class="rounded-[1.25rem] border border-chrome-200 bg-white px-4 py-4" data-testid="crmhr-import-row">
                    <Split Gap="LayoutGap.Small"
                           AlignItems="AlignItems.Start"
                           JustifyContent="JustifyContent.SpaceBetween">
                        <div class="min-w-0">
                            <p class="text-sm font-semibold text-chrome-950">Row @row.RowNumber: @row.Party.DisplayName</p>
                            <p class="mt-1 text-xs uppercase tracking-[0.18em] text-chrome-500">@row.Party.PartyType / @row.Party.LifecycleStatus</p>
                            @if (row.Messages.Count > 0)
                            {
                                <p class="mt-2 text-sm leading-6 text-rose-700">@string.Join(" ", row.Messages)</p>
                            }
                            @if (row.DuplicateCandidates.Count > 0)
                            {
                                <p class="mt-2 text-sm leading-6 text-amber-700">Duplicates: @string.Join(", ", row.DuplicateCandidates.Select(item => item.DisplayName))</p>
                            }
                        </div>
                        <StatusBadge Tone="@(row.CanImport ? "success" : "warning")"
                                     Text="@(row.CanImport ? "Ready" : "Blocked")" />
                    </Split>
                </div>
            }
        </Stack>
    }
</Stack>

@code {
    private PartyCsvImportPreviewModel? preview;
    private string exportText = string.Empty;
    private string importText = string.Empty;
    private string? statusMessage;
    private string statusTone = "neutral";
    private string? exportError;
    private PartyImportPhase phase;
    private long inputRevision;
    private long previewGeneration;
    private bool disposed;

    // The stewardship effects belong to the host: the renderer never reaches the directory owner itself.
    [Parameter, EditorRequired]
    public Func<PartyCsvExportScope, IReadOnlyList<Guid>, Task<string>> ExportCsv { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<string, Task<Result<PartyCsvImportPreviewModel>>> PreviewImport { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<IReadOnlyList<PartyCsvImportPreviewRowModel>, Task<Result<int>>> ApplyImport { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<Guid> ExportPartyIds { get; set; } = [];

    [Parameter]
    public PartyCsvExportScope ExportScope { get; set; } = PartyCsvExportScope.SelectedParties;

    [Parameter]
    public EventCallback ImportApplied { get; set; }

    [Parameter]
    public EventCallback<PartyImportStatus> StatusChanged { get; set; }

    private Task ReportAsync() => disposed ? Task.CompletedTask :
        StatusChanged.InvokeAsync(new(inputRevision, !string.IsNullOrWhiteSpace(importText), phase));

    private async Task SetImportTextAsync(string? value) {
        value ??= string.Empty;
        if (value == importText || disposed) {
            return;
        }
        importText = value;
        inputRevision++;
        previewGeneration++;
        preview = null;
        if (phase == PartyImportPhase.Previewing) {
            phase = PartyImportPhase.Editing;
        }
        statusMessage = phase switch {
            PartyImportPhase.Applying => "Import is running. Your later CSV input will be retained.",
            PartyImportPhase.Unknown => "The earlier import result is unknown. Your CSV is retained; preview it to check current records before another apply.",
            _ => "CSV changed. Preview it before applying."
        };
        statusTone = phase == PartyImportPhase.Unknown ? "warning" : "info";
        await ReportAsync();
    }

    private Task RefreshExportAsync() => ReadExportAsync(showStatus: true);

    private async Task ReadExportAsync(bool showStatus) {
        try {
            var content = await ExportCsv(ExportScope, ExportPartyIds);
            if (disposed) {
                return;
            }
            exportText = content;
            exportError = null;
            if (showStatus) {
                statusMessage = ExportScope == PartyCsvExportScope.EntireDirectory
                    ? "Directory export refreshed."
                    : $"Export refreshed for {ExportPartyIds.Count} party row(s).";
                statusTone = "info";
            }
        } catch (Exception) {
            if (!disposed) {
                exportError = "The export could not be read. Refresh the export to try again.";
            }
        }
    }

    private string ExportDescription => ExportScope == PartyCsvExportScope.EntireDirectory
        ? "Export the full party directory, or paste CSV rows for preview-first import with explicit validation and duplicate warnings."
        : "Export the selected party records, or paste CSV rows for preview-first import with explicit validation and duplicate warnings.";

    private async Task PreviewImportAsync() {
        if (phase is PartyImportPhase.Applying or PartyImportPhase.Previewing || disposed) {
            return;
        }
        var generation = ++previewGeneration;
        var revision = inputRevision;
        var csv = importText;
        phase = PartyImportPhase.Previewing;
        await ReportAsync();
        try {
            var result = await PreviewImport(csv);
            if (disposed || generation != previewGeneration || revision != inputRevision) {
                return;
            }
            preview = result.IsSuccess ? result.Value : null;
            statusMessage = preview is null ? string.Join(" ", result.Errors.Select(item => item.Message))
                : $"Preview prepared for {preview.Rows.Count} row(s).";
            statusTone = preview is null ? "danger" : "info";
        } catch (Exception) {
            if (!disposed && generation == previewGeneration) {
                preview = null;
                statusMessage = "The import preview could not be read. Your CSV input is retained.";
                statusTone = "danger";
            }
        } finally {
            if (!disposed && generation == previewGeneration) {
                phase = PartyImportPhase.Editing;
                await ReportAsync();
            }
        }
    }

    private async Task ApplyImportAsync() {
        if (preview is null || phase != PartyImportPhase.Editing || disposed) {
            return;
        }
        var rows = preview.Rows;
        var submittedRevision = inputRevision;
        phase = PartyImportPhase.Applying;
        await ReportAsync();
        Result<int> result;
        try {
            result = await ApplyImport(rows);
        } catch (Exception) {
            if (!disposed) {
                phase = PartyImportPhase.Unknown;
                preview = null;
                statusMessage = "The import result could not be confirmed. Your CSV is retained. Preview it again to check current directory records before any new apply.";
                statusTone = "warning";
                await ReportAsync();
            }
            return;
        }
        if (disposed) {
            return;
        }
        phase = PartyImportPhase.Editing;
        preview = null;
        if (result.IsFailure) {
            statusMessage = string.Join(" ", result.Errors.Select(item => item.Message));
            statusTone = "danger";
            await ReportAsync();
            return;
        }
        var laterInput = submittedRevision != inputRevision;
        if (!laterInput) {
            importText = string.Empty;
            inputRevision++;
        }
        statusMessage = laterInput
            ? $"Imported {result.Value} party row(s). Your later CSV input is retained; preview it before applying."
            : $"Imported {result.Value} party row(s).";
        statusTone = "success";
        await ReportAsync();
        await ReadExportAsync(showStatus: false);
        if (!disposed) {
            await ImportApplied.InvokeAsync();
        }
    }

    public void Dispose() {
        disposed = true;
        previewGeneration++;
    }
}

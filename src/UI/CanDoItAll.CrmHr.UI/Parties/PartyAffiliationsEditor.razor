@inject IPartyRecordQueryService PartyRecordQueryService
@implements IDisposable

<Stack GapScale="LayoutGap.Medium"
       AlignItems="AlignItems.Stretch"
       data-testid="crmhr-affiliations-editor">
    <Split Gap="LayoutGap.Medium"
           AlignItems="AlignItems.Center"
           JustifyContent="JustifyContent.SpaceBetween">
        <div>
            <TextBlock TextStyle="TextStyle.EyebrowCaption">Organization affiliations</TextBlock>
            <p class="mt-1 text-sm leading-6 text-chrome-600">
                Record each company relationship separately. Selecting a primary affiliation clears the previous primary. End-date saved history; only unsaved rows can be removed.
            </p>
        </div>
        <Button Text="Add affiliation"
                Icon="add"
                Tone="ButtonTone.Default"
                Size="ButtonSize.Small"
                Disabled="@(!CurrentPersonPartyId.HasValue)"
                Click="AddAffiliationAsync"
                data-testid="crmhr-affiliation-add" />
    </Split>

    @if (!CurrentPersonPartyId.HasValue)
    {
        <div class="rounded-[1.25rem] border border-dashed border-chrome-300 bg-chrome-50/70 px-4 py-4 text-sm leading-6 text-chrome-600">
            Save the person first, then add organization affiliations.
        </div>
    }
    else if (edits.Count == 0)
    {
        <div class="rounded-[1.25rem] border border-dashed border-chrome-300 bg-chrome-50/70 px-4 py-4 text-sm leading-6 text-chrome-600"
             data-testid="crmhr-affiliations-empty">
            No organization affiliations are recorded. A person without a staffable affiliation appears as an external contact in Workforce.
        </div>
    }
    else
    {
        @foreach (var row in edits.Select((item, index) => (Item: item, Index: index)))
        {
            var item = row.Item;
            var rowIndex = row.Index;
            <PanelCard @key="item" Soft="true" data-testid="@($"crmhr-affiliation-row-{rowIndex}")">
                <Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch">
                    <Split Gap="LayoutGap.Small"
                           AlignItems="AlignItems.Center"
                           JustifyContent="JustifyContent.SpaceBetween">
                        <div class="min-w-0">
                            <p class="text-sm font-semibold text-chrome-950"
                               data-testid="@($"crmhr-affiliation-company-name-{rowIndex}")">
                                @ResolvePartyName(item.OrganizationPartyId, "No company selected")
                            </p>
                            <p class="mt-1 text-xs uppercase tracking-[0.18em] text-[var(--tone-text-muted)]">
                                @FormatAffiliationKind(item.AffiliationKind)
                            </p>
                        </div>
                        @if (item.IsPrimary)
                        {
                            <StatusBadge Tone="info" Text="Primary" />
                        }
                    </Split>

                    <Grid Gap="LayoutGap.Medium" ColumnsLg="3">
                        <div>
                            <label class="cda-form-field__label">Company</label>
                            <Button Text="Choose company"
                                    Icon="business"
                                    Tone="ButtonTone.Default"
                                    Size="ButtonSize.Small"
                                    Click="@(() => OpenPicker(item, AffiliationPartyField.Organization))"
                                    data-testid="@($"crmhr-affiliation-company-{rowIndex}")" />
                        </div>
                        <FormField Text="Affiliation kind">
                            <SelectInput TValue="PartyOrganizationAffiliationKind"
                                         Value="@item.AffiliationKind"
                                         ValueChanged="@((PartyOrganizationAffiliationKind value) => UpdateKindAsync(item, value))"
                                         ValueExpression="@(() => item.AffiliationKind)"
                                         class="form-input ui-input ui-input--outlined"
                                         data-testid="@($"crmhr-affiliation-kind-{rowIndex}")">
                                @foreach (var kind in Enum.GetValues<PartyOrganizationAffiliationKind>())
                                {
                                    <option value="@kind">@FormatAffiliationKind(kind)</option>
                                }
                            </SelectInput>
                        </FormField>
                        <FormField Text="Job title">
                            <NativeValueInput aria-label="Job title" TValue="string" Value="@item.JobTitle"
                                       ValueChanged="@((string? value) => UpdateJobTitleAsync(item, value))"
                                       ValueExpression="@(() => item.JobTitle)"
                                       class="form-input ui-input ui-input--outlined"
                                       data-testid="@($"crmhr-affiliation-title-{rowIndex}")" />
                        </FormField>
                    </Grid>

                    <Grid Gap="LayoutGap.Medium" ColumnsLg="3">
                        <FormField Text="Employee / engagement code">
                            <NativeValueInput aria-label="Employee / engagement code" TValue="string" Value="@item.EmployeeCode"
                                       ValueChanged="@((string? value) => UpdateEmployeeCodeAsync(item, value))"
                                       ValueExpression="@(() => item.EmployeeCode)"
                                       class="form-input ui-input ui-input--outlined"
                                       data-testid="@($"crmhr-affiliation-code-{rowIndex}")" />
                        </FormField>
                        <div>
                            <label class="cda-form-field__label">Valid from</label>
                            <InputDate TValue="DateOnly?"
                                       Value="@item.ValidFrom"
                                       @oninput="@(() => ReportPendingDateAsync(item, AffiliationField.Start))"
                                       ValueChanged="@((DateOnly? value) => UpdateValidFromAsync(item, value))"
                                       ValueExpression="@(() => item.ValidFrom)"
                                       class="form-input ui-input ui-input--outlined"
                                       data-testid="@($"crmhr-affiliation-start-{rowIndex}")" />
                        </div>
                        <div>
                            <label class="cda-form-field__label">Valid to</label>
                            <InputDate TValue="DateOnly?"
                                       Value="@item.ValidTo"
                                       @oninput="@(() => ReportPendingDateAsync(item, AffiliationField.End))"
                                       ValueChanged="@((DateOnly? value) => UpdateValidToAsync(item, value))"
                                       ValueExpression="@(() => item.ValidTo)"
                                       class="form-input ui-input ui-input--outlined"
                                       data-testid="@($"crmhr-affiliation-end-{rowIndex}")" />
                        </div>
                    </Grid>

                    <Grid Gap="LayoutGap.Medium" ColumnsLg="2">
                        <SurfaceCard Soft="true">
                            <Split Breakpoint="LayoutBreakpoint.None"
                                   Gap="LayoutGap.Small"
                                   AlignItems="AlignItems.Center"
                                   JustifyContent="JustifyContent.SpaceBetween">
                                <div class="min-w-0">
                                    <TextBlock TextStyle="TextStyle.EyebrowCaption">Organization unit</TextBlock>
                                    <p class="truncate text-sm text-chrome-700"
                                       data-testid="@($"crmhr-affiliation-unit-name-{rowIndex}")">
                                        @ResolveOptionalPartyName(item.OrganizationUnitPartyId)
                                    </p>
                                </div>
                                <Cluster Gap="LayoutGap.XSmall">
                                    @if (item.OrganizationUnitPartyId.HasValue)
                                    {
                                        <Button Text="Clear"
                                                Tone="ButtonTone.Default"
                                                Variant="Variant.Text"
                                                Size="ButtonSize.Small"
                                                Click="@(() => ClearUnitAsync(item))"
                                                data-testid="@($"crmhr-affiliation-unit-clear-{rowIndex}")" />
                                    }
                                    <Button Text="Choose"
                                            Icon="account_tree"
                                            Tone="ButtonTone.Default"
                                            Size="ButtonSize.Small"
                                            Click="@(() => OpenPicker(item, AffiliationPartyField.OrganizationUnit))"
                                            data-testid="@($"crmhr-affiliation-unit-{rowIndex}")" />
                                </Cluster>
                            </Split>
                        </SurfaceCard>

                        <SurfaceCard Soft="true">
                            <Split Breakpoint="LayoutBreakpoint.None"
                                   Gap="LayoutGap.Small"
                                   AlignItems="AlignItems.Center"
                                   JustifyContent="JustifyContent.SpaceBetween">
                                <div class="min-w-0">
                                    <TextBlock TextStyle="TextStyle.EyebrowCaption">Manager</TextBlock>
                                    <p class="truncate text-sm text-chrome-700"
                                       data-testid="@($"crmhr-affiliation-manager-name-{rowIndex}")">
                                        @ResolveOptionalPartyName(item.ManagerPartyId)
                                    </p>
                                </div>
                                <Cluster Gap="LayoutGap.XSmall">
                                    @if (item.ManagerPartyId.HasValue)
                                    {
                                        <Button Text="Clear"
                                                Tone="ButtonTone.Default"
                                                Variant="Variant.Text"
                                                Size="ButtonSize.Small"
                                                Click="@(() => ClearManagerAsync(item))"
                                                data-testid="@($"crmhr-affiliation-manager-clear-{rowIndex}")" />
                                    }
                                    <Button Text="Choose"
                                            Icon="supervisor_account"
                                            Tone="ButtonTone.Default"
                                            Size="ButtonSize.Small"
                                            Click="@(() => OpenPicker(item, AffiliationPartyField.Manager))"
                                            data-testid="@($"crmhr-affiliation-manager-{rowIndex}")" />
                                </Cluster>
                            </Split>
                        </SurfaceCard>
                    </Grid>

                    <Grid Gap="LayoutGap.Medium" ColumnsLg="2">
                        <FormField Text="Notes">
                            <NativeValueInput aria-label="Notes" TValue="string" Multiline="true" Value="@item.Notes"
                                           ValueChanged="@((string? value) => UpdateNotesAsync(item, value))"
                                           ValueExpression="@(() => item.Notes)"
                                           class="form-input ui-input ui-input--outlined min-h-24"
                                           data-testid="@($"crmhr-affiliation-notes-{rowIndex}")" />
                        </FormField>
                        <div class="flex items-end justify-between gap-3">
                            <label class="ui-checkbox-option">
                                <InputCheckbox class="form-checkbox ui-checkbox ui-checkbox--outlined" Value="@item.IsPrimary"
                                               ValueChanged="@((bool value) => UpdatePrimaryAsync(item, value))"
                                               ValueExpression="@(() => item.IsPrimary)"
                                               data-testid="@($"crmhr-affiliation-primary-{rowIndex}")" />
                                Primary affiliation
                            </label>
                            <Button Text="Remove"
                                    Tone="ButtonTone.Danger"
                                    Size="ButtonSize.Small"
                                    Disabled="@(item.Id.HasValue && !item.IsNew)"
                                    Click="@(() => RemoveAffiliationAsync(item))"
                                    data-testid="@($"crmhr-affiliation-remove-{rowIndex}")" />
                        </div>
                    </Grid>
                </Stack>
            </PanelCard>
        }
    }
</Stack>

<PartyRecordPickerDialog IsOpen="@(pickerTarget is not null)"
                         SelectedPartyId="@PickerSelectedPartyId"
                         AllowedScope="@PickerScope"
                         InitialScope="@PickerScope"
                         ExcludedPartyId="@CurrentPersonPartyId"
                         SelectionConfirmed="SelectPartyAsync"
                         OnClose="ClosePickerAsync"
                         Eyebrow="Organization affiliation"
                         Title="@PickerTitle"
                         Subtitle="@PickerSubtitle"
                         DataTestId="crmhr-affiliation-picker" />

@code {
    private readonly Dictionary<Guid, string> partyNames = [];
    private List<PartyOrganizationAffiliationEditorModel> edits = [];
    private IReadOnlyList<PartyOrganizationAffiliationEditorModel>? configuredAffiliations;
    private IReadOnlyList<PartyOrganizationAffiliationEditorModel>? lastPublishedAffiliations;
    private PartyOrganizationAffiliationEditorModel? pickerTarget;
    private AffiliationPartyField pickerField;
    private bool isNewPickerTarget;
    private long configuredOwnerRevision;
    private long pickerGeneration;
    private bool disposed;

    [Parameter]
    public Guid? CurrentPersonPartyId { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<PartyOrganizationAffiliationEditorModel> Affiliations { get; set; } = [];

    [Parameter]
    public EventCallback<IReadOnlyList<PartyOrganizationAffiliationEditorModel>> AffiliationsChanged { get; set; }

    [Parameter] public long OwnerRevision { get; set; }
    [Parameter] public EventCallback<AffiliationInput> InputChanged { get; set; }
    [Parameter] public EventCallback<bool> PendingInputChanged { get; set; }
    [CascadingParameter] private EditContext? FormContext { get; set; }

    [Parameter]
    public IReadOnlyDictionary<Guid, string> PartyDisplayNames { get; set; } =
        new Dictionary<Guid, string>();

    private PartyRecordScope PickerScope => pickerField switch
    {
        AffiliationPartyField.Organization => PartyRecordScope.Organizations,
        AffiliationPartyField.OrganizationUnit => PartyRecordScope.OrganizationUnits,
        AffiliationPartyField.Manager => PartyRecordScope.People,
        _ => PartyRecordScope.All
    };

    private Guid? PickerSelectedPartyId => pickerTarget is null
        ? null
        : pickerField switch
        {
            AffiliationPartyField.Organization => AsOptionalId(pickerTarget.OrganizationPartyId),
            AffiliationPartyField.OrganizationUnit => pickerTarget.OrganizationUnitPartyId,
            AffiliationPartyField.Manager => pickerTarget.ManagerPartyId,
            _ => null
        };

    private string PickerTitle => pickerField switch
    {
        AffiliationPartyField.Organization => "Choose a company",
        AffiliationPartyField.OrganizationUnit => "Choose an organization unit",
        AffiliationPartyField.Manager => "Choose a manager",
        _ => "Choose a party"
    };

    private string PickerSubtitle => pickerField switch
    {
        AffiliationPartyField.Organization => "Select the organization for this affiliation.",
        AffiliationPartyField.OrganizationUnit => "Optionally select a unit within the organization.",
        AffiliationPartyField.Manager => "Optionally select the person's manager for this affiliation.",
        _ => "Search the directory."
    };

    protected override void OnParametersSet()
    {
        foreach (var pair in PartyDisplayNames)
        {
            partyNames[pair.Key] = pair.Value;
        }

        if (configuredAffiliations is not null && configuredOwnerRevision != OwnerRevision) {
            AffiliationValues.Adopt(edits, Affiliations);
            configuredAffiliations = Affiliations;
            configuredOwnerRevision = OwnerRevision;
            lastPublishedAffiliations = null;
            if (pickerTarget is not null && !edits.Contains(pickerTarget)) {
                pickerTarget = null;
                pickerGeneration++;
            }
            return;
        }
        configuredOwnerRevision = OwnerRevision;

        if (ReferenceEquals(Affiliations, configuredAffiliations) ||
            IsPublishedSnapshot(Affiliations))
        {
            configuredAffiliations = Affiliations;
            return;
        }

        edits = Affiliations.Select(Clone).ToList();
        configuredAffiliations = Affiliations;
        lastPublishedAffiliations = null;
        pickerTarget = null;
        isNewPickerTarget = false;
        pickerGeneration++;
    }

    private async Task AddAffiliationAsync()
    {
        if (CurrentPersonPartyId is not Guid personPartyId)
        {
            return;
        }

        var affiliation = new PartyOrganizationAffiliationEditorModel
        {
            Id = Guid.NewGuid(),
            IsNew = true,
            PersonPartyId = personPartyId,
            AffiliationKind = PartyOrganizationAffiliationKind.ExternalContact,
            IsPrimary = edits.Count == 0
        };
        edits.Add(affiliation);
        pickerTarget = affiliation;
        pickerField = AffiliationPartyField.Organization;
        isNewPickerTarget = true;
        pickerGeneration++;
        await PendingInputChanged.InvokeAsync(true);
        await PublishAsync();
    }

    private async Task RemoveAffiliationAsync(PartyOrganizationAffiliationEditorModel affiliation)
    {
        edits.Remove(affiliation);
        if (ReferenceEquals(pickerTarget, affiliation))
        {
            pickerTarget = null;
            isNewPickerTarget = false;
        }

        await PublishAsync();
    }

    private async Task OpenPicker(
        PartyOrganizationAffiliationEditorModel affiliation,
        AffiliationPartyField field)
    {
        pickerTarget = affiliation;
        pickerField = field;
        isNewPickerTarget = false;
        pickerGeneration++;
        await PendingInputChanged.InvokeAsync(true);
    }

    private async Task SelectPartyAsync(Guid partyId)
    {
        if (pickerTarget is null)
        {
            return;
        }

        var target = pickerTarget;
        var generation = pickerGeneration;
        var selectedParty = await PartyRecordQueryService.GetAsync(
            partyId,
            includeArchived: false);
        if (disposed || generation != pickerGeneration || !ReferenceEquals(target, pickerTarget)) {
            return;
        }
        if (selectedParty is null || !IsExpectedPartyType(selectedParty.PartyType))
        {
            throw new InvalidOperationException(
                $"Selected affiliation party '{partyId}' is unavailable or has the wrong party type.");
        }

        partyNames[partyId] = selectedParty.DisplayName;
        switch (pickerField)
        {
            case AffiliationPartyField.Organization:
                pickerTarget.OrganizationPartyId = partyId;
                break;
            case AffiliationPartyField.OrganizationUnit:
                pickerTarget.OrganizationUnitPartyId = partyId;
                break;
            case AffiliationPartyField.Manager:
                pickerTarget.ManagerPartyId = partyId;
                break;
            default:
                throw new InvalidOperationException("No affiliation party field is selected.");
        }

        var changedField = pickerField switch {
            AffiliationPartyField.Organization => AffiliationField.Organization,
            AffiliationPartyField.OrganizationUnit => AffiliationField.Unit,
            AffiliationPartyField.Manager => AffiliationField.Manager,
            _ => throw new InvalidOperationException("An affiliation picker field is required.")
        };
        pickerTarget = null;
        isNewPickerTarget = false;
        pickerGeneration++;
        await PendingInputChanged.InvokeAsync(false);
        await PublishInputAsync(target, changedField);
    }

    private async Task ClosePickerAsync()
    {
        if (isNewPickerTarget &&
            pickerTarget is { OrganizationPartyId: var organizationPartyId } &&
            organizationPartyId == Guid.Empty)
        {
            edits.Remove(pickerTarget);
            await PublishAsync();
        }

        pickerTarget = null;
        isNewPickerTarget = false;
        pickerGeneration++;
        await PendingInputChanged.InvokeAsync(false);
    }

    private bool IsExpectedPartyType(PartyType partyType)
    {
        return pickerField switch
        {
            AffiliationPartyField.Organization => partyType == PartyType.Organization,
            AffiliationPartyField.OrganizationUnit => partyType == PartyType.OrganizationUnit,
            AffiliationPartyField.Manager => partyType == PartyType.Person,
            _ => false
        };
    }

    private async Task UpdatePrimaryAsync(
        PartyOrganizationAffiliationEditorModel affiliation,
        bool value)
    {
        if (value)
        {
            foreach (var item in edits)
            {
                item.IsPrimary = ReferenceEquals(item, affiliation);
                await ReportInputAsync(item, AffiliationField.Primary);
            }
        }
        else
        {
            affiliation.IsPrimary = false;
            await ReportInputAsync(affiliation, AffiliationField.Primary);
        }

        await PublishAsync();
    }

    private async Task UpdateKindAsync(
        PartyOrganizationAffiliationEditorModel affiliation,
        PartyOrganizationAffiliationKind value)
    {
        affiliation.AffiliationKind = value;
        await PublishInputAsync(affiliation, AffiliationField.Kind);
    }

    private async Task UpdateJobTitleAsync(
        PartyOrganizationAffiliationEditorModel affiliation,
        string? value)
    {
        affiliation.JobTitle = value ?? string.Empty;

        await PublishInputAsync(affiliation, AffiliationField.Title);
    }

    private async Task UpdateEmployeeCodeAsync(
        PartyOrganizationAffiliationEditorModel affiliation,
        string? value)
    {
        affiliation.EmployeeCode = value ?? string.Empty;

        await PublishInputAsync(affiliation, AffiliationField.EmployeeCode);
    }

    private async Task UpdateValidFromAsync(
        PartyOrganizationAffiliationEditorModel affiliation,
        DateOnly? value)
    {
        affiliation.ValidFrom = value;
        await PublishInputAsync(affiliation, AffiliationField.Start);
    }

    private async Task UpdateValidToAsync(
        PartyOrganizationAffiliationEditorModel affiliation,
        DateOnly? value)
    {
        affiliation.ValidTo = value;
        await PublishInputAsync(affiliation, AffiliationField.End);
    }

    private async Task UpdateNotesAsync(
        PartyOrganizationAffiliationEditorModel affiliation,
        string? value)
    {
        affiliation.Notes = value ?? string.Empty;

        await PublishInputAsync(affiliation, AffiliationField.Notes);
    }

    private async Task ClearUnitAsync(PartyOrganizationAffiliationEditorModel affiliation)
    {
        affiliation.OrganizationUnitPartyId = null;
        await PublishInputAsync(affiliation, AffiliationField.Unit);
    }

    private async Task ClearManagerAsync(PartyOrganizationAffiliationEditorModel affiliation)
    {
        affiliation.ManagerPartyId = null;
        await PublishInputAsync(affiliation, AffiliationField.Manager);
    }

    private Task ReportInputAsync(PartyOrganizationAffiliationEditorModel row, AffiliationField field, bool pendingDate = false) {
        if (!InputChanged.HasDelegate) {
            return Task.CompletedTask;
        }
        return InputChanged.InvokeAsync(new(row.Id ?? throw new InvalidOperationException("An observed affiliation row needs an identity."), field, pendingDate));
    }

    private Task ReportPendingDateAsync(PartyOrganizationAffiliationEditorModel row, AffiliationField field) => ReportInputAsync(row, field, pendingDate: true);

    private async Task PublishInputAsync(PartyOrganizationAffiliationEditorModel row, AffiliationField field) {
        await ReportInputAsync(row, field);
        await PublishAsync();
    }

    private async Task PublishAsync()
    {
        var snapshot = edits.Select(Clone).ToList();
        lastPublishedAffiliations = snapshot;
        await AffiliationsChanged.InvokeAsync(snapshot);
    }

    private bool IsPublishedSnapshot(
        IReadOnlyList<PartyOrganizationAffiliationEditorModel> affiliations)
    {
        return lastPublishedAffiliations is not null &&
               affiliations.Count == lastPublishedAffiliations.Count &&
               affiliations
                   .Zip(lastPublishedAffiliations)
                   .All(pair => ReferenceEquals(pair.First, pair.Second));
    }

    private string ResolvePartyName(Guid partyId, string emptyLabel)
    {
        if (partyId == Guid.Empty)
        {
            return emptyLabel;
        }

        return partyNames.GetValueOrDefault(partyId) ?? partyId.ToString("D");
    }

    private string ResolveOptionalPartyName(Guid? partyId)
        => partyId.HasValue
            ? ResolvePartyName(partyId.Value, "Not selected")
            : "Not selected";

    private static Guid? AsOptionalId(Guid partyId)
        => partyId == Guid.Empty ? null : partyId;

    private static string FormatAffiliationKind(PartyOrganizationAffiliationKind kind)
        => kind == PartyOrganizationAffiliationKind.ExternalContact
            ? "External contact"
            : kind.ToString();

    private static PartyOrganizationAffiliationEditorModel Clone(
        PartyOrganizationAffiliationEditorModel affiliation)
        => affiliation.Snapshot();

    private enum AffiliationPartyField
    {
        Organization,
        OrganizationUnit,
        Manager
    }

    public void Dispose() {
        disposed = true;
        pickerGeneration++;
    }
}

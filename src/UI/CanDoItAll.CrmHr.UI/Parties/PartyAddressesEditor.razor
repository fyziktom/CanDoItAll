@using Microsoft.AspNetCore.Components.Forms
<Stack GapScale="LayoutGap.Medium">
    <Split Gap="LayoutGap.Medium"
           AlignItems="AlignItems.Center"
           JustifyContent="JustifyContent.SpaceBetween">
        <div>
            <TextBlock TextStyle="TextStyle.EyebrowCaption">Addresses</TextBlock>
            <p class="mt-1 text-sm leading-6 text-chrome-600">Capture legal, billing, shipping, or work addresses without creating duplicate parties.</p>
        </div>
        <Button Text="Add address"
                Tone="ButtonTone.Default"
                Size="ButtonSize.Small"
                Click="AddAddress"
                data-testid="crmhr-address-add" />
    </Split>

    @if (Addresses.Count == 0)
    {
        <div class="rounded-[1.25rem] border border-dashed border-chrome-300 bg-chrome-50/70 px-4 py-4 text-sm leading-6 text-chrome-600">
            No addresses saved yet.
        </div>
    }
    else
    {
        @foreach (var row in Addresses.Select((item, index) => (Item: item, Index: index)))
        {
            var item = row.Item;
            var rowIndex = row.Index;
            <PanelCard @key="item" Soft="true">
                <Grid Gap="LayoutGap.Medium" ColumnsLg="4">
                    <FormField Text="Type">
                        <NativeValueInput aria-label="Type" TValue="string" @bind-Value="item.AddressType"
                                   class="form-input ui-input ui-input--outlined"
                                   data-testid="@($"crmhr-address-type-{rowIndex}")" />
                    </FormField>
                    <div class="lg:col-span-2">
                        <FormField Text="Line 1">
                            <NativeValueInput aria-label="Line 1" TValue="string" @bind-Value="item.Line1"
                                       class="form-input ui-input ui-input--outlined"
                                       data-testid="@($"crmhr-address-line1-{rowIndex}")" />
                        </FormField>
                    </div>
                    <div class="flex items-end">
                        <Button Text="Remove"
                                Tone="ButtonTone.Danger"
                                Size="ButtonSize.Small"
                                Click="@(() => RemoveAddress(item))"
                                data-testid="@($"crmhr-address-remove-{rowIndex}")" />
                    </div>
                </Grid>

                <Grid Gap="LayoutGap.Medium" ColumnsLg="4" Class="mt-4">
                    <FormField Text="Line 2">
                        <NativeValueInput aria-label="Line 2" TValue="string" @bind-Value="item.Line2"
                                   class="form-input ui-input ui-input--outlined"
                                   data-testid="@($"crmhr-address-line2-{rowIndex}")" />
                    </FormField>
                    <FormField Text="City">
                        <NativeValueInput aria-label="City" TValue="string" @bind-Value="item.City"
                                   class="form-input ui-input ui-input--outlined"
                                   data-testid="@($"crmhr-address-city-{rowIndex}")" />
                    </FormField>
                    <FormField Text="Region">
                        <NativeValueInput aria-label="Region" TValue="string" @bind-Value="item.Region"
                                   class="form-input ui-input ui-input--outlined"
                                   data-testid="@($"crmhr-address-region-{rowIndex}")" />
                    </FormField>
                    <FormField Text="Postal code">
                        <NativeValueInput aria-label="Postal code" TValue="string" @bind-Value="item.PostalCode"
                                   class="form-input ui-input ui-input--outlined"
                                   data-testid="@($"crmhr-address-postal-{rowIndex}")" />
                    </FormField>
                </Grid>

                <Grid Gap="LayoutGap.Medium" ColumnsLg="2" Class="mt-4">
                    <FormField Text="Country code">
                        <NativeValueInput aria-label="Country code" TValue="string" @bind-Value="item.CountryCode"
                                   class="form-input ui-input ui-input--outlined"
                                   data-testid="@($"crmhr-address-country-{rowIndex}")" />
                    </FormField>
                    <label class="ui-checkbox-option">
                        <InputCheckbox class="form-checkbox ui-checkbox ui-checkbox--outlined" @bind-Value="item.IsPrimary"
                                       data-testid="@($"crmhr-address-primary-{rowIndex}")" />
                        Primary address
                    </label>
                </Grid>
            </PanelCard>
        }
    }
</Stack>

@code {
    [CascadingParameter] private EditContext? CurrentEditContext { get; set; }
    [Parameter, EditorRequired]
    public IList<PartyAddressEditorModel> Addresses { get; set; } = default!;

    private void AddAddress()
    {
        Addresses.Add(new PartyAddressEditorModel
        {
            Id = Guid.NewGuid(),
            AddressType = "Work"
        });
    }

    private void RemoveAddress(PartyAddressEditorModel address)
    {
        Addresses.Remove(address);
    }
}

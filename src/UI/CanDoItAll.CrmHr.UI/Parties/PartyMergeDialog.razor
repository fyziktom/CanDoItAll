@using CanDoItAll.Modules.Projects

@if (Presentation.IsOpen && Candidate is not null) {
    <Dialog IsOpen="true" Title="Merge duplicate party" Eyebrow="CRM / HR"
            Subtitle="Review the current surviving record, duplicate and related records before merging."
            Size="ModalSize.Medium" DenseChrome="true" CloseOnBackdrop="false"
            TestId="crmhr-merge-dialog" OnClose="HandleCloseAsync">
        <ChildContent>
            <Stack GapScale="LayoutGap.Large">
                @if (Presentation.Message is { } message) {
                    <Alert AlertStyle="@(Presentation.IsAccepted ? AlertStyle.Success : AlertStyle.Warning)" data-testid="crmhr-merge-status">
                        <TextBlock Value="@message" />
                    </Alert>
                }
                @if (Presentation.Phase == PartyMergePhase.Reading) {
                    <LoadingState Title="Reading the current merge preview" Description="Your note stays in this dialog." />
                } else if (Presentation.Preview is { } preview) {
                    <Grid ColumnsMd="2" Gap="LayoutGap.Medium">
                        <SurfaceCard Soft="true">
                            <Stack GapScale="LayoutGap.Small">
                                <TextBlock Value="Surviving record" TextStyle="TextStyle.Note" />
                                <TextBlock Value="@preview.Retained.DisplayName" TextStyle="TextStyle.Subtitle2" />
                                <StatusBadge Text="@preview.Retained.PartyType.ToString()" Tone="neutral" />
                            </Stack>
                        </SurfaceCard>
                        <SurfaceCard Soft="true">
                            <Stack GapScale="LayoutGap.Small">
                                <TextBlock Value="Duplicate to remove" TextStyle="TextStyle.Note" />
                                <TextBlock Value="@preview.Duplicate.DisplayName" TextStyle="TextStyle.Subtitle2" />
                                <StatusBadge Text="@preview.Duplicate.PartyType.ToString()" Tone="warning" />
                            </Stack>
                        </SurfaceCard>
                    </Grid>
                    <TextBlock Value="@($"Includes {RelatedRecordCount} related saved records. Changes after this preview require another preview.")" />
                }
                <FormField Text="@(Presentation.IsAccepted ? "Local note" : "Merge note")">
                    <TextAreaInput Value="@mergeReason" ValueChanged="HandleNoteAsync" Immediate="true"
                              Rows="4" maxlength="4000" data-testid="crmhr-merge-reason" />
                </FormField>
                @if (Presentation.IsAccepted) {
                    <Alert AlertStyle="AlertStyle.Info">
                        <TextBlock Value="The merge is saved. Later note changes remain local; copy them before closing." />
                    </Alert>
                }
                @Overlays
            </Stack>
        </ChildContent>
        <Footer>
            <Stack GapScale="LayoutGap.Medium">
                <TextBlock Value="Merge removes the duplicate after its related records are consolidated." TextStyle="TextStyle.Note" />
                <Cluster Gap="LayoutGap.Small">
                    <Button Text="Close" Tone="ButtonTone.Default" Disabled="@(Presentation.IsBusy || Presentation.IsUnknown)"
                            Click="HandleCloseAsync" data-testid="crmhr-merge-close" />
                    @if (!Presentation.IsAccepted) {
                        <Button Text="Refresh preview" Tone="ButtonTone.Default" Disabled="Presentation.IsBusy"
                                Click="Refresh" data-testid="crmhr-merge-refresh" />
                        <Button Text="Merge duplicate" Tone="ButtonTone.Warning" Disabled="@(!Presentation.CanConfirm)"
                                Click="HandleConfirmAsync" data-testid="crmhr-merge-confirm" />
                    }
                </Cluster>
            </Stack>
        </Footer>
    </Dialog>
}

@code {
    private string mergeReason = string.Empty;
    private long noteRevision;

    [Parameter, EditorRequired] public PartyMergePresentation Presentation { get; set; } = new(0, PartyMergePhase.Closed, null, null);
    [Parameter] public PartyDuplicateCandidateModel? Candidate { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnConfirm { get; set; }
    [Parameter] public EventCallback Refresh { get; set; }
    [Parameter] public EventCallback<PartyMergeNoteStatus> NoteStatusChanged { get; set; }
    [Parameter] public RenderFragment? Overlays { get; set; }

    private int RelatedRecordCount => Presentation.Preview is { } preview
        ? Math.Max(0, preview.Original.Rows.Length - 2) + preview.Original.Work.Rows.Count(row => row.Member == ProjectWorkPartyMergeMember.Assignment)
        : 0;

    private async Task HandleNoteAsync(string? value) {
        value ??= string.Empty;
        if (value == mergeReason) {
            return;
        }
        mergeReason = value;
        await NoteStatusChanged.InvokeAsync(new(++noteRevision, !string.IsNullOrWhiteSpace(value)));
    }

    private Task HandleCloseAsync() => Presentation.IsBusy || Presentation.IsUnknown ? Task.CompletedTask : OnClose.InvokeAsync();
    private Task HandleConfirmAsync() => Presentation.CanConfirm ? OnConfirm.InvokeAsync(mergeReason.Trim()) : Task.CompletedTask;
}

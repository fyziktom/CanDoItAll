@using CanDoItAll.Editing
@implements IDisposable
@using Microsoft.AspNetCore.Components.Forms

<FormSection Title="Skills and certifications"
             Description="Maintain searchable skill coverage, proficiency, and qualification notes on the shared workforce party instead of hiding staffing fit in free text.">
    <Grid Gap="LayoutGap.Large" ColumnsLg="2">
        <SurfaceCard>
            <EditForm EditContext="skillContext" OnValidSubmit="SubmitSkillAsync" data-testid="crmhr-skill-form">
            @Editing
            @if (pending.Count > 0) {
                <Alert AlertStyle="AlertStyle.Warning"><TextBlock Value="Complete the date or number input before saving. Your raw input is retained." /></Alert>
            }
            <TextBlock TextStyle="TextStyle.EyebrowCaption">Skill assignment</TextBlock>
            <h3 class="mt-1 text-lg font-semibold text-chrome-950">Attach a skill to this profile</h3>
            <p class="mt-2 text-sm leading-6 text-chrome-600">
                Proficiency and certification details are included in workforce search so staffing can find the right people or units quickly.
            </p>

            @if (SkillCatalog.Count == 0)
            {
                <div class="mt-4 rounded-[1.2rem] border border-[var(--tone-warning-soft-border)] bg-[var(--tone-warning-soft-bg)] px-4 py-4 text-sm text-[var(--tone-warning-soft-fg)]">
                    Create at least one skill definition before attaching skills to the workforce profile.
                </div>
            }
            else
            {
                <Grid Gap="LayoutGap.Medium" ColumnsMd="2" Class="mt-4">
                    <FormField Text="Skill">
                        <SelectInput TValue="Guid" Value="SkillDraft.SkillId" ValueChanged="SelectSkillAsync" ValueExpression="@(() => SkillDraft.SkillId)"
                                     class="form-input ui-input ui-input--outlined"
                                     data-testid="crmhr-skill-skill-id">
                            <option value="@Guid.Empty">Choose a skill</option>
                            @foreach (var skill in SkillCatalog.OrderBy(item => item.Category).ThenBy(item => item.Name))
                            {
                                <option value="@skill.Id">@skill.Name (@skill.Category)</option>
                            }
                        </SelectInput>
                    </FormField>
                    <FormField Text="Proficiency">
                        <SelectInput @bind-Value="SkillDraft.Proficiency" @bind-Value:after="@(() => SkillParsedAsync(WorkforceSkillField.Proficiency))"
                                     class="form-input ui-input ui-input--outlined"
                                     data-testid="crmhr-skill-proficiency">
                            @foreach (var proficiency in Enum.GetValues<SkillProficiencyLevel>())
                            {
                                <option value="@proficiency">@proficiency</option>
                            }
                        </SelectInput>
                    </FormField>
                </Grid>

                <Grid Gap="LayoutGap.Medium" ColumnsMd="3" Class="mt-4">
                    <FormField Text="Years">
                        <NativeValueInput TValue="int" DisplayName="Years of experience" @bind-Value="SkillDraft.YearsExperience"
                                     class="form-input ui-input ui-input--outlined"
                                     data-testid="crmhr-skill-years" PendingChanged="@(pending => SkillValueInputAsync(WorkforceSkillField.Years, pending))" />
                    </FormField>
                    <FormField Text="Certification">
                        <NativeValueInput TValue="string" @bind-Value="SkillDraft.CertificationStatus" PendingChanged="@(_ => SkillTextAsync(WorkforceSkillField.Certification))"
                                   class="form-input ui-input ui-input--outlined"
                                   data-testid="crmhr-skill-certification" />
                    </FormField>
                    <FormField Text="Last validated">
                        <NativeValueInput TValue="DateOnly?" DisplayName="Last validated" @bind-Value="SkillDraft.LastValidatedOn"
                                   class="form-input ui-input ui-input--outlined"
                                   data-testid="crmhr-skill-validated-on" PendingChanged="@(pending => SkillValueInputAsync(WorkforceSkillField.Validated, pending))" />
                    </FormField>
                </Grid>

                <div class="mt-4">
                    <FormField Text="Notes">
                        <NativeValueInput TValue="string" Multiline="true" @bind-Value="SkillDraft.Notes" PendingChanged="@(_ => SkillTextAsync(WorkforceSkillField.Notes))"
                                       class="form-input ui-input ui-input--outlined ui-input--textarea min-h-[7rem]"
                                       data-testid="crmhr-skill-notes" />
                    </FormField>
                </div>

                <Cluster Gap="LayoutGap.Small" Class="mt-4">
                    <Button Text="Save skill"
                            Click="SubmitSkillAsync" Disabled="SkillSaveDisabled"
                            data-testid="crmhr-skill-save-button" />
                </Cluster>
            }
            </EditForm>
        </SurfaceCard>

        <SurfaceCard Soft="true">
            <EditForm EditContext="definitionContext" OnValidSubmit="SubmitDefinitionAsync" data-testid="crmhr-skill-definition-form">
            <TextBlock TextStyle="TextStyle.EyebrowCaption">Skill dictionary</TextBlock>
            <h3 class="mt-1 text-lg font-semibold text-chrome-950">Add a reusable skill definition</h3>
            <p class="mt-2 text-sm leading-6 text-chrome-600">
                Keep the catalog small and intentional so staffing search stays strongly typed and consistent across workforce and project routes.
            </p>

            <Grid Gap="LayoutGap.Medium" ColumnsMd="2" Class="mt-4">
                <FormField Text="Skill name">
                    <NativeValueInput TValue="string" @bind-Value="SkillDefinitionDraft.Name" PendingChanged="@(_ => DefinitionTextAsync(WorkforceDefinitionField.Name))"
                               class="form-input ui-input ui-input--outlined"
                               data-testid="crmhr-skill-definition-name" />
                </FormField>
                <FormField Text="Category">
                    <NativeValueInput TValue="string" @bind-Value="SkillDefinitionDraft.Category" PendingChanged="@(_ => DefinitionTextAsync(WorkforceDefinitionField.Category))"
                               class="form-input ui-input ui-input--outlined"
                               data-testid="crmhr-skill-definition-category" />
                </FormField>
            </Grid>

            <div class="mt-4">
                <FormField Text="Description">
                    <NativeValueInput TValue="string" Multiline="true" @bind-Value="SkillDefinitionDraft.Description" PendingChanged="@(_ => DefinitionTextAsync(WorkforceDefinitionField.Description))"
                                   class="form-input ui-input ui-input--outlined ui-input--textarea min-h-[7rem]"
                                   data-testid="crmhr-skill-definition-description" />
                </FormField>
            </div>

            <label class="mt-4 inline-flex items-center gap-2 text-sm text-chrome-700">
                <InputCheckbox @bind-Value="SkillDefinitionDraft.IsActive" @bind-Value:after="@(() => DefinitionInputChanged.InvokeAsync(new(WorkforceDefinitionField.Active)))"
                               data-testid="crmhr-skill-definition-active" />
                <span>Active skill</span>
            </label>

            <Cluster Gap="LayoutGap.Small" Class="mt-4">
                <Button Text="Save skill definition"
                        Click="SubmitDefinitionAsync" Disabled="DefinitionSaveDisabled"
                        data-testid="crmhr-skill-definition-save-button" />
            </Cluster>
            </EditForm>
        </SurfaceCard>
    </Grid>

    <div class="mt-6">
        <Split Gap="LayoutGap.Medium"
               AlignItems="AlignItems.Center"
               JustifyContent="JustifyContent.SpaceBetween">
            <div>
                <TextBlock TextStyle="TextStyle.EyebrowCaption">Current coverage</TextBlock>
                <h3 class="mt-1 text-lg font-semibold text-chrome-950">@Skills.Count skill record(s)</h3>
            </div>
        </Split>

        @if (Skills.Count == 0)
        {
            <div class="mt-4">
                <EmptyState Eyebrow="No skills yet"
                            Title="Attach the first skill"
                            Description="Skill records start driving staffing search as soon as this profile gets at least one catalog-backed skill." />
            </div>
        }
        else
        {
            <Stack GapScale="LayoutGap.Medium" Class="mt-4">
                @foreach (var skill in Skills)
                {
                    <PanelCard data-testid="crmhr-skill-item">
                        <Split Gap="LayoutGap.Medium"
                               AlignItems="AlignItems.Start"
                               JustifyContent="JustifyContent.SpaceBetween">
                            <div class="min-w-0 space-y-1">
                                <p class="text-base font-semibold text-chrome-950">@skill.SkillName</p>
                                <p class="text-sm text-chrome-600">@BuildMeta(skill)</p>
                                @if (!string.IsNullOrWhiteSpace(skill.Notes))
                                {
                                    <p class="text-sm leading-6 text-chrome-600">@skill.Notes</p>
                                }
                            </div>
                            <Cluster Gap="LayoutGap.Small">
                                <StatusBadge Tone="@ResolveProficiencyTone(skill.Proficiency)"
                                             Text="@skill.Proficiency.ToString()" />
                                <Button Text="Delete"
                                        Tone="ButtonTone.Danger"
                                        Size="ButtonSize.Small"
                                        Click="@(() => DeletePartySkill.InvokeAsync(skill.Id))" Disabled="WritesDisabled"
                                        data-testid="crmhr-skill-delete-button" />
                            </Cluster>
                        </Split>
                    </PanelCard>
                }
            </Stack>
        }
    </div>
</FormSection>

@code {
    private bool disposed;
    private EditContext skillContext = default!;
    private EditContext definitionContext = default!;
    private readonly HashSet<WorkforceSkillField> pending = [];
    [Parameter] public RenderFragment? Editing { get; set; }
    [Parameter] public bool WritesDisabled { get; set; }
    [Parameter] public bool SkillSaveDisabled { get; set; }
    [Parameter] public bool DefinitionSaveDisabled { get; set; }
    [Parameter] public EventCallback<Guid> SkillSelected { get; set; }
    [Parameter] public EventCallback<RecordInput<WorkforceSkillField>> SkillInputChanged { get; set; }
    [Parameter] public EventCallback<RecordInput<WorkforceDefinitionField>> DefinitionInputChanged { get; set; }
    protected override void OnParametersSet() {
        if (skillContext is null || !ReferenceEquals(skillContext.Model, SkillDraft)) {
            skillContext = new(SkillDraft);
            pending.Clear();
        }
        if (definitionContext is null || !ReferenceEquals(definitionContext.Model, SkillDefinitionDraft)) {
            definitionContext = new(SkillDefinitionDraft);
        }
    }
    private Task SelectSkillAsync(Guid id) => disposed ? Task.CompletedTask : SkillSelected.InvokeAsync(id);
    private Task SubmitSkillAsync() => disposed || WritesDisabled || SkillSaveDisabled || pending.Count > 0 || !skillContext.Validate()
        ? Task.CompletedTask : SavePartySkill.InvokeAsync();
    private Task SubmitDefinitionAsync() => disposed || WritesDisabled || DefinitionSaveDisabled || !definitionContext.Validate()
        ? Task.CompletedTask : SaveSkillDefinition.InvokeAsync();
    private Task SkillTextAsync(WorkforceSkillField field) {
        if (disposed) {
            return Task.CompletedTask;
        }

        return SkillInputChanged.InvokeAsync(new(field));
    }
    private Task DefinitionTextAsync(WorkforceDefinitionField field) {
        if (disposed) {
            return Task.CompletedTask;
        }

        return DefinitionInputChanged.InvokeAsync(new(field));
    }
    private Task SkillValueInputAsync(WorkforceSkillField field, bool isPending) {
        if (disposed) {
            return Task.CompletedTask;
        }
        if (isPending) {
            pending.Add(field);
        } else {
            pending.Remove(field);
        }
        return SkillInputChanged.InvokeAsync(new(field, isPending));
    }
    private Task SkillParsedAsync(WorkforceSkillField field) => SkillValueInputAsync(field, false);
    public void Dispose() => disposed = true;

    [Parameter]
    public IReadOnlyList<SkillCatalogItemModel> SkillCatalog { get; set; } = [];

    [Parameter]
    public IReadOnlyList<PartySkillItemModel> Skills { get; set; } = [];

    [Parameter]
    public PartySkillEditorModel SkillDraft { get; set; } = new();

    [Parameter]
    public SkillDefinitionEditorModel SkillDefinitionDraft { get; set; } = new();

    [Parameter]
    public EventCallback SavePartySkill { get; set; }

    [Parameter]
    public EventCallback SaveSkillDefinition { get; set; }

    [Parameter]
    public EventCallback<Guid> DeletePartySkill { get; set; }

    private static string BuildMeta(PartySkillItemModel skill)
    {
        var parts = new List<string>
        {
            skill.SkillCategory
        };

        if (skill.YearsExperience > 0)
        {
            parts.Add($"{skill.YearsExperience}y experience");
        }

        if (!string.IsNullOrWhiteSpace(skill.CertificationStatus))
        {
            parts.Add(skill.CertificationStatus);
        }

        if (skill.LastValidatedOn.HasValue)
        {
            parts.Add($"Validated {skill.LastValidatedOn.Value:yyyy-MM-dd}");
        }

        return string.Join(" / ", parts);
    }

    private static string ResolveProficiencyTone(SkillProficiencyLevel proficiency)
    {
        return proficiency switch
        {
            SkillProficiencyLevel.Expert => "success",
            SkillProficiencyLevel.Strong => "primary",
            SkillProficiencyLevel.Working => "info",
            _ => "warning"
        };
    }
}

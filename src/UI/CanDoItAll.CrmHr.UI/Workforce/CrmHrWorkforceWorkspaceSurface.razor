@using CanDoItAll.Editing
@namespace CanDoItAll.CrmHr.UI.Workforce
@inherits CrmHrWorkspaceSurface<ICrmHrWorkforceWorkspaceView>

<PageScaffold MaxWidthClass="max-w-full"
              FillHeight="true">
    <Header>
        <PageHeader Eyebrow="CRM / HR"
                    Title="Workforce workspace"
                    Description="Keep worker identity, delivery-unit structure, manager lines, and commercial staffing metadata on the shared party model instead of splitting people ops and delivery records."
                    Compact="true">
            <Actions>
                <PageHeaderActionButton Icon="asset"
                                        Label="Open directory"
                                        TooltipText="Open the shared party directory."
                                        Click="View.OpenDirectory" />
            </Actions>
        </PageHeader>
    </Header>

    <ChildContent>
        <Stack GapScale="LayoutGap.Medium"
               FillHeight="true"
               Class="min-h-0 flex-1 overflow-hidden">
            @SecondaryNavigation

            <SurfaceCard Class="flex min-h-0 flex-1 flex-col overflow-hidden"
                         data-testid="crmhr-workforce-catalog">
                <Stack GapScale="LayoutGap.Medium"
                       AlignItems="AlignItems.Stretch"
                       FillHeight="true"
                       Class="min-h-0 flex-1 overflow-hidden">
                    <ListPanelHeader Title="Workforce records"
                                     Description="Search and page through workers and delivery units. Open a card to manage its profile, skills, allocations, and history."
                                     Count="Server-paged">
                        <Actions>
                            <Button Text="New delivery unit"
                                    Icon="add"
                                    Size="ButtonSize.Small"
                                    Disabled="@View.IsDeliveryUnitSaving"
                                    IsBusy="@View.IsDeliveryUnitSaving"
                                    Click="View.OpenDeliveryUnitDialog"
                                    data-testid="crmhr-workforce-new-delivery-unit" />
                        </Actions>
                    </ListPanelHeader>
                    <WorkforceRecordBrowser RefreshVersion="@(View.WorkforceBrowserVersion + CatalogRefreshVersion)"
                                            SelectedPartyId="View.SelectedWorkspace?.PartyId"
                                            SelectionChanged="View.SelectPartyAsync"
                                            Query="@View.CatalogQuery"
                                            QueryChanged="View.HandleCatalogQueryChangedAsync"
                                            LoadFailed="View.HandleWorkforceBrowserLoadFailedAsync"
                                            PageSize="12"
                                            ResultsScrollMode="PagedRecordResultsScrollMode.Bounded"
                                            GridMode="PagedRecordGridMode.BoundedCatalog"
                                            FillHeight="true"
                                            SearchPlaceholder="Search workforce name, summary, organization, or title"
                                            DataTestId="crmhr-workforce"
                                            OptionTestId="crmhr-workforce-item" />
                </Stack>
            </SurfaceCard>

            @if (View.IsRecordDialogOpen && View.SelectedWorkspace is { } workspaceModel)
            {
                <Dialog IsOpen="true"
                        Eyebrow="Workforce record"
                        Title="@workspaceModel.DisplayName"
                        Subtitle="Profile, skills, allocation-driven availability, and workforce history."
                        Size="ModalSize.Full"
                        DenseChrome="true"
                        CloseOnBackdrop="false"
                        TestId="crmhr-workforce-record-dialog"
                        OnClose="View.CloseRecordDialogAsync">
                    <ChildContent>
                        @RecordUpdates
                        <SurfaceCard Soft="true">
                            <Split Gap="LayoutGap.Medium"
                                   Wrap="FlexWrap.Wrap">
                                <div class="min-w-0">
                                    <TextBlock TextStyle="TextStyle.EyebrowCaption">Selected workforce record</TextBlock>
                                    <h2 class="mt-1 text-lg font-semibold text-chrome-950">@workspaceModel.DisplayName</h2>
                                    @if (!string.IsNullOrWhiteSpace(workspaceModel.Summary))
                                    {
                                        <p class="mt-1 line-clamp-2 text-sm leading-6 text-chrome-600">@workspaceModel.Summary</p>
                                    }
                                    <p class="mt-2 text-sm font-medium text-chrome-700"
                                       data-testid="crmhr-workforce-availability-message">
                                        @View.SelectedAvailabilityMessage
                                    </p>
                                </div>
                                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                    <StatusBadge Tone="@View.SelectedClassificationTone"
                                                 Text="@View.SelectedClassificationLabel"
                                                 data-testid="crmhr-workforce-classification" />
                                    <StatusBadge Tone="@CrmHrWorkforceWorkspacePresentation.ResolveLifecycleTone(workspaceModel.LifecycleStatus)"
                                                 Text="@workspaceModel.LifecycleStatus.ToString()"
                                                 data-testid="crmhr-workforce-lifecycle" />
                                    @if (workspaceModel.Profile.Id.HasValue)
                                    {
                                        <StatusBadge Tone="@CrmHrWorkforceWorkspacePresentation.ResolveStatusTone(View.ProfileEditor.Status)"
                                                     Text="@View.ProfileEditor.Status" />
                                    }
                                    @if (View.SelectedAvailabilityState is { } availabilityState)
                                    {
                                        <StatusBadge Tone="@CrmHrWorkforceWorkspacePresentation.ResolveAvailabilityTone(availabilityState)"
                                                     Text="@availabilityState.ToString()" />
                                    }
                                </Cluster>
                            </Split>
                        </SurfaceCard>

                        @if (View.SelectedIsExternalContactWithoutProfile && !View.IsProfileCreationRequested)
                        {
                            <SurfaceCard Soft="true" data-testid="crmhr-workforce-no-staffable-profile">
                                <Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Start">
                                    <div>
                                        <TextBlock TextStyle="TextStyle.EyebrowCaption">External contact</TextBlock>
                                        <h3 class="mt-1 text-lg font-semibold text-chrome-950">No staffable profile</h3>
                                        <p class="mt-2 text-sm leading-6 text-chrome-700">
                                            This person can participate in project work, but has no employee, contractor, or freelancer profile. Creating staffing, rate, skill, or capacity data is a deliberate action.
                                        </p>
                                    </div>
                                    <Button Text="Create staffable profile"
                                            Icon="person_add"
                                            Tone="ButtonTone.Warning"
                                            Click="View.RequestProfileCreation"
                                            data-testid="crmhr-workforce-create-profile" />
                                </Stack>
                            </SurfaceCard>
                        }
                        else
                        {
                        <Tabs SelectedIndex="@View.SelectedDetailTabIndex"
                              SelectedIndexChanged="View.HandleDetailTabChangedAsync"
                              RenderMode="TabRenderMode.Client"
                              Density="TabsDensity.Compact"
                              OverflowMode="TabsOverflowMode.Wrap"
                              AriaLabel="Workforce record sections"
                              data-testid="crmhr-workforce-tabs">
                            <TabsItem Text="Overview"
                                      Icon="dashboard"
                                      data-testid="crmhr-workforce-tab-overview">
                                <Stack GapScale="LayoutGap.Medium"
                                       AlignItems="AlignItems.Stretch">
                                    <SensitiveDataCallout IsSensitive="workspaceModel.IsSensitive"
                                                         LastChangedBy="@workspaceModel.LastChangedBy"
                                                         UpdatedAtUtc="workspaceModel.UpdatedAtUtc"
                                                         DataTestId="crmhr-workforce-sensitive-callout"
                                                         StandardDescription="Use this summary before staffing or line-management changes so ownership and broad visibility stay explicit."
                                                         SensitiveDescription="Sensitive workforce records stay out of global search while still preserving assignment, manager, and capacity context for trusted operators." />

                                    <Grid Gap="LayoutGap.Medium" ColumnsMd="4">
                                        <SurfaceCard Soft="true">
                                            <TextBlock TextStyle="TextStyle.EyebrowCaption">Home unit</TextBlock>
                                            <p class="mt-1 text-sm font-medium text-chrome-950"
                                               data-testid="crmhr-workforce-summary-home-unit">@CrmHrWorkforceWorkspacePresentation.FormatValue(workspaceModel.HomeUnitName)</p>
                                        </SurfaceCard>
                                        <SurfaceCard Soft="true">
                                            <TextBlock TextStyle="TextStyle.EyebrowCaption">Manager</TextBlock>
                                            <p class="mt-1 text-sm font-medium text-chrome-950"
                                               data-testid="crmhr-workforce-summary-manager">@CrmHrWorkforceWorkspacePresentation.FormatValue(workspaceModel.ManagerName)</p>
                                        </SurfaceCard>
                                        <SurfaceCard Soft="true">
                                            <TextBlock TextStyle="TextStyle.EyebrowCaption">Primary email</TextBlock>
                                            <p class="mt-1 text-sm font-medium text-chrome-950">@CrmHrWorkforceWorkspacePresentation.FormatValue(workspaceModel.PrimaryEmail)</p>
                                        </SurfaceCard>
                                        <SurfaceCard Soft="true">
                                            <TextBlock TextStyle="TextStyle.EyebrowCaption">Primary phone</TextBlock>
                                            <p class="mt-1 text-sm font-medium text-chrome-950">@CrmHrWorkforceWorkspacePresentation.FormatValue(workspaceModel.PrimaryPhone)</p>
                                        </SurfaceCard>
                                        <SurfaceCard Soft="true">
                                            <TextBlock TextStyle="TextStyle.EyebrowCaption">Available now</TextBlock>
                                            <p class="mt-1 text-sm font-medium text-chrome-950"
                                               data-testid="crmhr-workforce-summary-available">@CrmHrWorkforceWorkspacePresentation.FormatOptionalPercent(View.SelectedAvailablePercent)</p>
                                        </SurfaceCard>
                                        <SurfaceCard Soft="true">
                                            <TextBlock TextStyle="TextStyle.EyebrowCaption">Next availability</TextBlock>
                                            <p class="mt-1 text-sm font-medium text-chrome-950"
                                               data-testid="crmhr-workforce-summary-next-availability">@(View.HasSelectedAvailabilityDetails ? CrmHrWorkforceWorkspacePresentation.FormatDate(View.SelectedNextAvailabilityOn) : "Not loaded")</p>
                                        </SurfaceCard>
                                        <SurfaceCard Soft="true">
                                            <TextBlock TextStyle="TextStyle.EyebrowCaption">Contract end</TextBlock>
                                            <p class="mt-1 text-sm font-medium text-chrome-950">@CrmHrWorkforceWorkspacePresentation.FormatDate(workspaceModel.Profile.EndDate)</p>
                                        </SurfaceCard>
                                        <SurfaceCard Soft="true">
                                            <TextBlock TextStyle="TextStyle.EyebrowCaption">Searchable skills</TextBlock>
                                            <p class="mt-1 text-sm font-medium text-chrome-950">@CrmHrWorkforceWorkspacePresentation.FormatValue(CrmHrWorkforceWorkspacePresentation.BuildSkillCoverage(workspaceModel.Skills))</p>
                                        </SurfaceCard>
                                    </Grid>
                                </Stack>
                            </TabsItem>

                            <TabsItem Text="Profile"
                                      Icon="badge"
                                      data-testid="crmhr-workforce-tab-profile">
                                <WorkforceProfileForm @key="View.ProfileEditor" @ref="profileForm" Model="View.ProfileEditor"
                                                      WorkforceKinds="View.AvailableWorkforceKinds" Submit="SaveProfileAsync"
                                                      InputChanged="ProfileInputChanged" PickerChanged="ProfilePickerChanged">
                                    <Editing>@ProfileEditing</Editing>
                                </WorkforceProfileForm>
                            </TabsItem>

                            <TabsItem Text="Skills"
                                      Icon="psychology"
                                      BadgeText="@workspaceModel.Skills.Count.ToString()"
                                      data-testid="crmhr-workforce-tab-skills">
                                <SkillMatrixPanel @key="View.SkillEditor" SkillCatalog="workspaceModel.SkillCatalog"
                                                  SkillSelected="SkillSelected" SkillInputChanged="SkillInputChanged" DefinitionInputChanged="DefinitionInputChanged" Editing="SkillEditing"
                                                  WritesDisabled="RecordWritesDisabled" SkillSaveDisabled="SkillSaveDisabled" DefinitionSaveDisabled="DefinitionSaveDisabled"
                                                  Skills="workspaceModel.Skills"
                                                  SkillDraft="View.SkillEditor"
                                                  SkillDefinitionDraft="View.SkillDefinitionEditor"
                                                  SavePartySkill="View.SavePartySkillAsync"
                                                  SaveSkillDefinition="View.SaveSkillDefinitionAsync"
                                                  DeletePartySkill="View.DeletePartySkillAsync" />
                            </TabsItem>

                            <TabsItem Text="Allocations"
                                      Icon="view_timeline"
                                      BadgeText="@View.AllocationBadgeText"
                                      data-testid="crmhr-workforce-tab-allocations">
                                <div data-testid="crmhr-workforce-allocations-panel">
                                    @if (View.IsCapacityWorkspaceLoading && View.CapacityWorkspace is null)
                                    {
                                        <SurfaceCard Soft="true"
                                                     data-testid="crmhr-workforce-allocations-loading">
                                            <TextBlock TextStyle="TextStyle.EyebrowCaption">Loading allocation workspace</TextBlock>
                                            <p class="mt-2 text-sm leading-6 text-chrome-600">
                                                Reading capacity blocks, project assignments, and the allocation timeline for this record.
                                            </p>
                                        </SurfaceCard>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(View.CapacityWorkspaceError) && View.CapacityWorkspace is null)
                                    {
                                        <SurfaceCard Soft="true"
                                                     data-testid="crmhr-workforce-allocations-error">
                                            <TextBlock TextStyle="TextStyle.EyebrowCaption" Class="text-rose-700">Allocation workspace unavailable</TextBlock>
                                            <p class="mt-2 text-sm leading-6 text-chrome-700">@View.CapacityWorkspaceError</p>
                                            <Button Text="Retry"
                                                    Icon="refresh"
                                                    Tone="ButtonTone.Default"
                                                    Size="ButtonSize.Small"
                                                    Class="mt-4"
                                                    Click="View.RetryCapacityWorkspaceAsync" />
                                        </SurfaceCard>
                                    }
                                    else if (View.CapacityWorkspace is { } loadedCapacityWorkspace)
                                    {
                                        @if (!string.IsNullOrWhiteSpace(View.CapacityWorkspaceError)) {
                                            <Alert AlertStyle="AlertStyle.Warning"><TextBlock Value="@View.CapacityWorkspaceError" /><Button Text="Retry capacity refresh" Click="View.RetryCapacityWorkspaceAsync" /></Alert>
                                        }
                                        <CapacityTimelinePanel @key="View.CapacityBlockEditor" CapacitySummary="loadedCapacityWorkspace.CapacitySummary"
                                                               InputChanged="CapacityInputChanged" WritesDisabled="RecordWritesDisabled" SaveDisabled="CapacitySaveDisabled"
                                                               CapacityBlocks="loadedCapacityWorkspace.CapacityBlocks"
                                                               ProjectAllocations="loadedCapacityWorkspace.ProjectAllocations"
                                                               CapacityBlockDraft="View.CapacityBlockEditor"
                                                               SaveCapacityBlock="View.SaveCapacityBlockAsync"
                                                               DeleteCapacityBlock="View.DeleteCapacityBlockAsync"
                                                               OpenProject="View.OpenProjectAsync" />
                                    }
                                </div>
                            </TabsItem>

                            <TabsItem Text="History"
                                      Icon="history"
                                      BadgeText="@View.WorkforceHistoryPresentation.Accepted?.TotalCount.ToString()"
                                      data-testid="crmhr-workforce-tab-history">
                                <div data-testid="crmhr-workforce-timeline">
                                    @if (View.WorkforceHistoryFailureMessage is { } historyFailure)
                                    {
                                        <SurfaceCard Soft="true" data-testid="crmhr-workforce-history-error">
                                            <TextBlock TextStyle="TextStyle.EyebrowCaption" Class="text-rose-700">History unavailable</TextBlock>
                                            <p class="mt-2 text-sm leading-6 text-chrome-700">@historyFailure</p>
                                            <Button Text="Retry"
                                                    Icon="refresh"
                                                    Tone="ButtonTone.Default"
                                                    Size="ButtonSize.Small"
                                                    Class="mt-4"
                                                    Click="View.RetryHistoryAsync" />
                                        </SurfaceCard>
                                    }
                                    else
                                    {
                                        @ActivityTimeline
                                    }
                                </div>
                            </TabsItem>
                        </Tabs>
                        }
                    </ChildContent>
                    <Footer>
                        <Split Breakpoint="LayoutBreakpoint.None"
                               Gap="LayoutGap.Medium"
                               AlignItems="AlignItems.Center"
                               JustifyContent="JustifyContent.SpaceBetween"
                               Wrap="FlexWrap.Wrap">
                            <Button Text="Open directory record"
                                    Tone="ButtonTone.Default"
                                    Click="View.OpenDirectory" />
                            <Cluster Gap="LayoutGap.Small">
                                <Button Text="Close"
                                        Tone="ButtonTone.Default"
                                        Click="View.CloseRecordDialogAsync"
                                        data-testid="crmhr-workforce-record-close" />
                                @if (View.SelectedDetailTabIndex == CrmHrWorkforceWorkspacePresentation.ProfileTabIndex)
                                {
                                    <Button Text="Save workforce profile"
                                            Click="SaveProfileFromFooterAsync"
                                            Disabled="@(ProfileSaveDisabled || profileForm is null)"
                                            data-testid="crmhr-workforce-save-button" />
                                }
                            </Cluster>
                        </Split>
                    </Footer>
                </Dialog>
            }

            @if (View.IsDeliveryUnitDialogOpen)
            {
                var deliveryDraft = View.DeliveryUnitEditor;
                <Dialog IsOpen="true"
                        Eyebrow="Workforce"
                        Title="New delivery unit"
                        Subtitle="Create an organization unit with delivery semantics without displacing the workforce list."
                        Size="ModalSize.Compact"
                        DenseChrome="true"
                        ShowCloseButton="@(!View.IsDeliveryUnitSaving)"
                        CloseOnBackdrop="@(!View.IsDeliveryUnitSaving)"
                        TestId="crmhr-workforce-delivery-unit-dialog"
                        OnClose="View.CloseDeliveryUnitDialogAsync">
                    <ChildContent>
                        @DeliveryEditing
                        <EditForm @key="deliveryDraft" Model="deliveryDraft" OnValidSubmit="SubmitDeliveryAsync" data-testid="crmhr-delivery-unit-form">
                            <Stack GapScale="LayoutGap.Medium">
                                <Grid Gap="LayoutGap.Medium" ColumnsMd="2">
                                    <FormField Text="Unit name">
                                        <NativeValueInput TValue="string" @bind-Value="deliveryDraft.DisplayName" PendingChanged="@(_ => DeliveryTextAsync(deliveryDraft, CanDoItAll.CrmHr.UI.Parties.PartyEditableField.DisplayName))"
                                                   class="form-input ui-input ui-input--outlined"
                                                   data-testid="crmhr-delivery-unit-name" />
                                    </FormField>
                                    <FormField Text="External code">
                                        <NativeValueInput TValue="string" @bind-Value="deliveryDraft.ExternalCode" PendingChanged="@(_ => DeliveryTextAsync(deliveryDraft, CanDoItAll.CrmHr.UI.Parties.PartyEditableField.ExternalCode))"
                                                   class="form-input ui-input ui-input--outlined"
                                                   data-testid="crmhr-delivery-unit-code" />
                                    </FormField>
                                </Grid>

                                <FormField Text="Summary">
                                    <NativeValueInput TValue="string" Multiline="true" @bind-Value="deliveryDraft.Summary" PendingChanged="@(_ => DeliveryTextAsync(deliveryDraft, CanDoItAll.CrmHr.UI.Parties.PartyEditableField.Summary))"
                                                   class="form-input ui-input ui-input--outlined ui-input--textarea min-h-[7rem]"
                                                   data-testid="crmhr-delivery-unit-summary" />
                                </FormField>

                                <Cluster Gap="LayoutGap.Small" JustifyContent="JustifyContent.End">
                                    <Button Text="Cancel"
                                            Tone="ButtonTone.Default"
                                            Disabled="@View.IsDeliveryUnitSaving"
                                            Click="View.CloseDeliveryUnitDialogAsync" />
                                    <Button Text="@(deliveryDraft.Id.HasValue ? "Save delivery unit" : "Create delivery unit")"
                                            Type="submit"
                                            Disabled="@(View.IsDeliveryUnitSaving || DeliverySaveDisabled)"
                                            IsBusy="@View.IsDeliveryUnitSaving"
                                            data-testid="crmhr-delivery-unit-save-button" />
                                </Cluster>
                            </Stack>
                        </EditForm>
                    </ChildContent>
                </Dialog>
            }

        </Stack>
    </ChildContent>
</PageScaffold>

@code {
    [Parameter] public long CatalogRefreshVersion { get; set; }
    [Parameter] public RenderFragment? SkillEditing { get; set; }
    [Parameter] public RenderFragment? DeliveryEditing { get; set; }
    [Parameter] public bool DeliverySaveDisabled { get; set; }
    [Parameter] public EventCallback<CanDoItAll.CrmHr.UI.Parties.PartyEditableField> DeliveryInputChanged { get; set; }
    private Task SubmitDeliveryAsync(EditContext context) => View.IsDeliveryUnitDialogOpen && ReferenceEquals(context.Model, View.DeliveryUnitEditor) && !DeliverySaveDisabled
        ? View.CreateDeliveryUnitAsync() : Task.CompletedTask;
    private Task DeliveryTextAsync(CanDoItAll.CrmHr.UI.Parties.PartyEditorViewModel model, CanDoItAll.CrmHr.UI.Parties.PartyEditableField field) {
        if (!View.IsDeliveryUnitDialogOpen || !ReferenceEquals(model, View.DeliveryUnitEditor)) {
            return Task.CompletedTask;
        }

        return DeliveryInputChanged.InvokeAsync(field);
    }

    [Parameter] public EventCallback<Guid> SkillSelected { get; set; }
    [Parameter] public EventCallback<RecordInput<WorkforceSkillField>> SkillInputChanged { get; set; }
    [Parameter] public EventCallback<RecordInput<WorkforceDefinitionField>> DefinitionInputChanged { get; set; }
    [Parameter] public EventCallback<RecordInput<WorkforceCapacityField>> CapacityInputChanged { get; set; }
    [Parameter] public bool RecordWritesDisabled { get; set; }
    [Parameter] public bool SkillSaveDisabled { get; set; }
    [Parameter] public bool DefinitionSaveDisabled { get; set; }
    [Parameter] public bool CapacitySaveDisabled { get; set; }

    [Parameter] public RenderFragment? RecordUpdates { get; set; }
    private WorkforceProfileForm? profileForm;
    [Parameter] public RenderFragment? ProfileEditing { get; set; }
    [Parameter] public bool ProfileSaveDisabled { get; set; }
    [Parameter] public EventCallback<WorkforceProfileInput> ProfileInputChanged { get; set; }
    [Parameter] public EventCallback<bool> ProfilePickerChanged { get; set; }

    // The footer button sits outside the form element: it validates the same form before the host saves.
    private Task SaveProfileFromFooterAsync() => profileForm?.SubmitAsync() ?? Task.CompletedTask;

    private Task SaveProfileAsync(WorkforceProfileEditorModel model) => ReferenceEquals(model, View.ProfileEditor)
        ? View.SaveWorkforceProfileAsync() : Task.CompletedTask;

    // Host-owned region: the host composes its adapter here.
    [Parameter]
    public RenderFragment? ActivityTimeline { get; set; }
}

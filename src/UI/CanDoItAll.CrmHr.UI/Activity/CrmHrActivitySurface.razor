@* The activity history timeline: one page record and its host's wording in, a page request out. Loading, failure
   and the read itself belong to the host; the surface shows the page it is given. *@
<div data-testid="@DataTestId"
     data-page-index="@Page.PageIndex"
     data-total-pages="@Page.TotalPages"
     data-loading="@(IsLoading ? "true" : "false")">
    <SurfaceCard>
        <p class="cda-eyebrow">@Copy.Eyebrow</p>
        <h3 class="mt-1 text-lg font-semibold text-slate-950">@Copy.Title</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">
            @Copy.Description
        </p>

        <Cluster Gap="LayoutGap.Small" Class="mt-4" data-testid="@($"{DataTestId}-totals")">
            <StatusBadge Tone="neutral" Text="@CrmHrActivityText.FormatActivities(Page.TotalCount)" />
            <StatusBadge Tone="info" Text="@CrmHrActivityText.FormatNextActions(Page.ActionCount)" />
            @if (Page.OverdueActionCount > 0)
            {
                <StatusBadge Tone="danger" Text="@CrmHrActivityText.FormatOverdue(Page.OverdueActionCount)" data-testid="@($"{DataTestId}-overdue-total")" />
            }
        </Cluster>

        @if (IsLoading)
        {
            <div class="mt-5" data-testid="@($"{DataTestId}-loading")">
                <LoadingState Eyebrow="@Copy.Eyebrow"
                              Title="Loading history"
                              Description="Loading only the requested activity page." />
            </div>
        }
        else if (Page.Items.Count == 0)
        {
            <div class="mt-5" data-testid="@($"{DataTestId}-empty")">
                <EmptyState Eyebrow="@Copy.EmptyEyebrow"
                            Title="@Copy.EmptyTitle"
                            Description="@Copy.EmptyDescription" />
            </div>
        }
        else
        {
            <Stack GapScale="LayoutGap.Small" Class="mt-5">
                @foreach (var item in Page.Items)
                {
                    <div class="max-w-full rounded-[1.25rem] border border-slate-200 bg-slate-50/80 px-4 py-4"
                         data-testid="@($"{DataTestId}-item")"
                         data-kind="@item.Kind"
                         data-overdue="@(item.IsOverdue ? "true" : "false")">
                        <Split Gap="LayoutGap.Medium">
                            <div class="min-w-0">
                                <p class="break-words text-sm font-semibold text-slate-950">@item.Title</p>
                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <p class="mt-2 break-words text-sm leading-6 text-slate-600">@item.Description</p>
                                }
                                <p class="mt-2 break-words text-xs uppercase tracking-[0.18em] text-slate-500">@item.Meta</p>
                            </div>
                            <Cluster Gap="LayoutGap.Small">
                                <StatusBadge Tone="@CrmHrActivityText.ToneToken(item.Tone)" Text="@item.Kind" NoWrap="true" />
                                @if (item.IsOverdue)
                                {
                                    <StatusBadge Tone="danger" Text="@CrmHrActivityText.OverdueLabel" NoWrap="true" />
                                }
                                <StatusBadge Tone="neutral" Text="@CrmHrActivityText.FormatTimestamp(item.OccurredAtUtc)" NoWrap="true" />
                            </Cluster>
                        </Split>
                    </div>
                }
            </Stack>
        }

        <Split Breakpoint="LayoutBreakpoint.None"
               Gap="LayoutGap.Small"
               AlignItems="AlignItems.Center"
               JustifyContent="JustifyContent.SpaceBetween"
               Wrap="FlexWrap.Wrap"
               Class="mt-5"
               data-testid="@($"{DataTestId}-pager")">
            <StatusBadge Tone="neutral" Text="@CrmHrActivityText.FormatPage(Page)" />
            <Cluster Gap="LayoutGap.Small">
                <Button Text="Previous"
                        Icon="chevron_left"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Disabled="@(!CanMovePrevious)"
                        Click="@(() => RequestPageAsync(Page.PageIndex - 1))"
                        data-testid="@($"{DataTestId}-previous")" />
                <Button Text="Next"
                        Icon="chevron_right"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Disabled="@(!CanMoveNext)"
                        Click="@(() => RequestPageAsync(Page.PageIndex + 1))"
                        data-testid="@($"{DataTestId}-next")" />
            </Cluster>
        </Split>
    </SurfaceCard>
</div>

@code {
    [Parameter, EditorRequired]
    public CrmHrActivityPage Page { get; set; } = CrmHrActivityPage.Empty();

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public CrmHrActivityCopy Copy { get; set; } = CrmHrActivityCopy.Default;

    // Prefix of every test identifier in this timeline, so several timelines can coexist on one page.
    [Parameter]
    public string DataTestId { get; set; } = "crmhr-timeline";

    [Parameter]
    public EventCallback<CrmHrActivityIntent> Intent { get; set; }

    private bool CanMovePrevious => !IsLoading && Page.PageIndex > 0;

    private bool CanMoveNext =>
        !IsLoading &&
        Page.TotalPages > 0 &&
        Page.PageIndex + 1 < Page.TotalPages;

    private Task RequestPageAsync(int pageIndex)
        => pageIndex < 0 || pageIndex >= Page.TotalPages
            ? Task.CompletedTask
            : Intent.InvokeAsync(new CrmHrActivityIntent.RequestPage(pageIndex));
}

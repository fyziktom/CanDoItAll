@namespace CanDoItAll.CrmHr.UI.Recruiting
@inherits CrmHrWorkspaceSurface<IAgentRecruitingEvidenceView>

<FormSection Title="Assessment evidence"
             Icon="fact_check"
             Description="Use append-only agent work, workflow, and process evidence to classify the candidate, request training, and recheck without changing application stage or activating the agent.">
    @if (!View.CandidateAgentId.HasValue)
    {
        <EmptyState Eyebrow="Technical candidate required"
                    Title="No bound AgentFramework candidate"
                    Description="Select a bound AI-agent party to use agent work, workflow, or process evidence. Human interviews remain available on the Interviews tab." />
    }
    else if (View.IsLoading)
    {
        <LoadingState Eyebrow="Assessment evidence"
                      Title="Loading candidate readiness"
                      Description="The current technical configuration and append-only assessment history are being loaded." />
    }
    else if (!string.IsNullOrWhiteSpace(View.LoadError))
    {
        <Alert AlertStyle="AlertStyle.Danger">
            <Stack GapScale="LayoutGap.Small" AlignItems="AlignItems.Stretch">
                <TextBlock TextStyle="TextStyle.Body2" Value="@View.LoadError" />
                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                    <Button Text="Retry"
                            Tone="ButtonTone.Default"
                            Size="ButtonSize.Small"
                            Click="View.ReloadAsync"
                            data-testid="crmhr-assessment-retry" />
                </Cluster>
            </Stack>
        </Alert>
    }
    else if (View.Candidate is null || View.Readiness is null)
    {
        <EmptyState Eyebrow="Candidate unavailable"
                    Title="The technical agent could not be resolved"
                    Description="Refresh the CRM-HR agent projection and confirm that the party is still bound to a workspace agent." />
    }
    else
    {
        <Stack GapScale="LayoutGap.Large" AlignItems="AlignItems.Stretch">
            <Split Breakpoint="LayoutBreakpoint.None"
                   Gap="LayoutGap.Medium"
                   AlignItems="AlignItems.Center"
                   JustifyContent="JustifyContent.SpaceBetween"
                   Wrap="FlexWrap.Wrap">
                <div class="min-w-0">
                    <TextBlock TextStyle="TextStyle.EyebrowCaption">Current technical candidate</TextBlock>
                    <h3 class="mt-1 text-lg font-semibold text-chrome-950">@View.Candidate.Name</h3>
                    <p class="mt-1 text-sm text-chrome-600">@AgentRecruitingEvidencePresentation.FormatValue(View.Candidate.RoleTitle) / configuration @View.Readiness.CurrentConfigurationVersion</p>
                </div>
                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                    <Button Text="New assessment"
                            Icon="add_task"
                            Click="View.OpenCreateDialog"
                            data-testid="crmhr-assessment-create" />
                    <Button Text="Attach result"
                            Icon="attach_file"
                            Tone="ButtonTone.Default"
                            Disabled="@(View.Interviews.Count == 0)"
                            Click="View.OpenAttachDialog"
                            data-testid="crmhr-assessment-attach" />
                    <Button Text="Refresh"
                            Icon="refresh"
                            Tone="ButtonTone.Default"
                            Click="View.ReloadAsync"
                            data-testid="crmhr-assessment-refresh" />
                </Cluster>
            </Split>

            <CompactStatStrip>
                <CompactStat Label="readiness"
                             Value="@AgentRecruitingEvidencePresentation.FormatReadiness(View.Readiness.Status)"
                             TooltipText="Derived from the latest current-version attempt, complete evidence, and a qualifying human review."
                             Tone="@AgentRecruitingEvidencePresentation.ResolveReadinessTone(View.Readiness.Status)" />
                <CompactStat Label="assessments"
                             Value="@View.Interviews.Count.ToString()"
                             TooltipText="Assessments correlated to this recruitment application." />
                <CompactStat Label="attempts"
                             Value="@View.AttemptCount.ToString()"
                             TooltipText="Append-only agent, workflow, or process result attachments."
                             Tone="info" />
                <CompactStat Label="latest score"
                             Value="@View.FormatLatestScore()"
                             TooltipText="Latest recorded automated score; it is evidence, not the HR decision." />
                <CompactStat Label="next step"
                             Value="@View.FormatLatestNextStep()"
                             TooltipText="Latest typed recommendation. A person must authorize the actual decision."
                             Tone="@AgentRecruitingEvidencePresentation.ResolveNextStepTone(View.LatestAnalysis?.ProposedNextStep)" />
            </CompactStatStrip>

            <Alert AlertStyle="AlertStyle.Info">
                Automated analysis and readiness are evidence only. They never change recruitment stage, convert a workforce profile, or activate the technical agent.
            </Alert>

            <Grid Gap="LayoutGap.Large"
                  ColumnTemplateXl="minmax(0,1.65fr) minmax(20rem,0.75fr)">
                <SurfaceCard>
                    <Split Breakpoint="LayoutBreakpoint.None"
                           Gap="LayoutGap.Small"
                           AlignItems="AlignItems.Center"
                           JustifyContent="JustifyContent.SpaceBetween"
                           Wrap="FlexWrap.Wrap">
                        <div>
                            <TextBlock TextStyle="TextStyle.EyebrowCaption">Assessment cycles</TextBlock>
                            <h3 class="mt-1 text-lg font-semibold text-chrome-950">@View.Interviews.Count assessment(s)</h3>
                        </div>
                        <StatusBadge Tone="neutral" Text="Append-only evidence" />
                    </Split>

                    @if (View.Interviews.Count == 0)
                    {
                        <div class="mt-4">
                            <EmptyState Eyebrow="No assessment evidence"
                                        Title="Create the first assessment"
                                        Description="Define the purpose, then attach a terminal agent work, workflow, or process result. Missing hashes or evaluator provenance remain explicitly incomplete." />
                        </div>
                    }
                    else
                    {
                        <Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch" Class="mt-4">
                            @foreach (var interview in View.Interviews)
                            {
                                <PanelCard @key="interview.Id"
                                           data-testid="crmhr-assessment-cycle">
                                    <Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch">
                                        <Split Breakpoint="LayoutBreakpoint.None"
                                               Gap="LayoutGap.Small"
                                               AlignItems="AlignItems.Start"
                                               JustifyContent="JustifyContent.SpaceBetween"
                                               Wrap="FlexWrap.Wrap">
                                            <div class="min-w-0">
                                                <p class="text-base font-semibold text-chrome-950">@interview.Purpose</p>
                                                <p class="mt-1 text-sm text-chrome-600">
                                                    @interview.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm") /
                                                    configuration @interview.CandidateConfigurationVersion
                                                </p>
                                            </div>
                                            <Cluster Gap="LayoutGap.XSmall" Wrap="FlexWrap.Wrap">
                                                <StatusBadge Tone="info" Text="@($"{interview.Attempts.Count} attempt(s)")" />
                                                <StatusBadge Tone="neutral" Text="@($"{interview.Reviews.Count} review(s)")" />
                                            </Cluster>
                                        </Split>

                                        @if (interview.Attempts.Count == 0)
                                        {
                                            <Alert AlertStyle="AlertStyle.Warning">
                                                This assessment has no attached result yet.
                                            </Alert>
                                        }
                                        else
                                        {
                                            @foreach (var attempt in interview.Attempts.OrderByDescending(item => item.Sequence))
                                            {
                                                var latestReview = AgentRecruitingEvidencePresentation.ResolveLatestReview(interview, attempt.Id);
                                                <SurfaceCard Soft="true"
                                                             @key="attempt.Id"
                                                             data-testid="crmhr-assessment-attempt">
                                                    <Stack GapScale="LayoutGap.Small" AlignItems="AlignItems.Stretch">
                                                        <Split Breakpoint="LayoutBreakpoint.None"
                                                               Gap="LayoutGap.Small"
                                                               AlignItems="AlignItems.Center"
                                                               JustifyContent="JustifyContent.SpaceBetween"
                                                               Wrap="FlexWrap.Wrap">
                                                            <Cluster Gap="LayoutGap.XSmall" Wrap="FlexWrap.Wrap">
                                                                <StatusBadge Tone="primary" Text="@($"Attempt {attempt.Sequence}")" />
                                                                <StatusBadge Tone="neutral" Text="@AgentRecruitingEvidencePresentation.FormatTargetKind(attempt.Target.Kind)" />
                                                                <StatusBadge Tone="@AgentRecruitingEvidencePresentation.ResolveCompletenessTone(attempt.Completeness)"
                                                                             Text="@AgentRecruitingEvidencePresentation.FormatCompleteness(attempt.Completeness)" />
                                                                @if (attempt.Analysis is { } attemptAnalysis)
                                                                {
                                                                    <StatusBadge Tone="@AgentRecruitingEvidencePresentation.ResolveClassificationTone(attemptAnalysis.Classification)"
                                                                                 Text="@AgentRecruitingEvidencePresentation.FormatClassification(attemptAnalysis.Classification)" />
                                                                }
                                                            </Cluster>
                                                            <SmallText Text="@attempt.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")" />
                                                        </Split>

                                                        <Grid Gap="LayoutGap.Small" ColumnsMd="4">
                                                            <CompactStat Label="target"
                                                                         Value="@attempt.Target.Id.ToString("D")"
                                                                         TooltipText="Canonical execution target ID." />
                                                            <CompactStat Label="score"
                                                                         Value="@(attempt.AutomatedEvaluation?.Score?.ToString("0.#") ?? "Not scored")"
                                                                         TooltipText="Automated evaluation score." />
                                                            <CompactStat Label="review"
                                                                         Value="@(latestReview is null ? "Pending" : latestReview.Decision.ToString())"
                                                                         TooltipText="Latest human review for this attempt." />
                                                            <CompactStat Label="next"
                                                                         Value="@(attempt.Analysis is null ? "Not proposed" : AgentRecruitingEvidencePresentation.FormatNextStep(attempt.Analysis.ProposedNextStep))"
                                                                         TooltipText="Recorded recommendation only." />
                                                        </Grid>

                                                        @if (attempt.Analysis is { } analysis)
                                                        {
                                                            <p class="text-sm leading-6 text-chrome-700">@analysis.Summary</p>
                                                            <Cluster Gap="LayoutGap.XSmall" Wrap="FlexWrap.Wrap">
                                                                @foreach (var strength in analysis.Strengths.Take(3))
                                                                {
                                                                    <StatusBadge Tone="success" Text="@strength" />
                                                                }
                                                                @foreach (var gap in analysis.Gaps.Take(3))
                                                                {
                                                                    <StatusBadge Tone="warning" Text="@gap" />
                                                                }
                                                            </Cluster>
                                                        }

                                                        @if (attempt.MissingEvidence.Count > 0)
                                                        {
                                                            <Alert AlertStyle="AlertStyle.Warning">
                                                                Missing evidence: @string.Join(", ", attempt.MissingEvidence).
                                                            </Alert>
                                                        }

                                                        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                                            @if (latestReview is null)
                                                            {
                                                                <StatusBadge Tone="warning"
                                                                             Text="Protected human review required" />
                                                            }
                                                            @if (attempt.Analysis?.ProposedNextStep == AgentRecruitingProposedNextStep.AssignTraining)
                                                            {
                                                                <Button Text="Create training task"
                                                                        Tone="ButtonTone.Default"
                                                                        Size="ButtonSize.Small"
                                                                        Click="@(() => View.RequestTraining.InvokeAsync(
                                                                            new RecruitmentTrainingRequest(
                                                                                interview.Id,
                                                                                attempt.Id,
                                                                                attempt.Analysis.Classification,
                                                                                attempt.Analysis.Gaps)))"
                                                                        data-testid="crmhr-assessment-training" />
                                                            }
                                                            @if (attempt.Analysis?.ProposedNextStep is
                                                                AgentRecruitingProposedNextStep.Reassess or
                                                                AgentRecruitingProposedNextStep.AssignTraining)
                                                            {
                                                                <Button Text="Start recheck"
                                                                        Tone="ButtonTone.Default"
                                                                        Size="ButtonSize.Small"
                                                                        Click="@(() => View.OpenRecheckDialog(interview, attempt))"
                                                                        data-testid="crmhr-assessment-recheck" />
                                                            }
                                                        </Cluster>
                                                        @if (latestReview is null)
                                                        {
                                                            <SmallText Text="Human decisions are accepted only through the authenticated recruiting API; this page cannot self-assert reviewer identity or authorization." />
                                                        }
                                                    </Stack>
                                                </SurfaceCard>
                                            }
                                        }
                                    </Stack>
                                </PanelCard>
                            }
                        </Stack>
                    }
                </SurfaceCard>

                <Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch">
                    <SurfaceCard Soft="true">
                        <TextBlock TextStyle="TextStyle.EyebrowCaption">Current readiness</TextBlock>
                        <h3 class="mt-1 text-lg font-semibold text-chrome-950">@AgentRecruitingEvidencePresentation.FormatReadiness(View.Readiness.Status)</h3>
                        <Stack GapScale="LayoutGap.Small" AlignItems="AlignItems.Stretch" Class="mt-4">
                            @foreach (var reason in View.Readiness.Reasons)
                            {
                                <p class="text-sm leading-6 text-chrome-700">@reason</p>
                            }
                        </Stack>
                    </SurfaceCard>

                    <SurfaceCard Soft="true">
                        <TextBlock TextStyle="TextStyle.EyebrowCaption">Authority boundary</TextBlock>
                        <h3 class="mt-1 text-lg font-semibold text-chrome-950">Separate activation required</h3>
                        <p class="mt-3 text-sm leading-6 text-chrome-600">
                            Even a ready assessment leaves the agent lifecycle unchanged. Activation remains a separately authorized AgentFramework command.
                        </p>
                        <StatusBadge Tone="warning"
                                     Text="Never activates automatically"
                                     Class="mt-3" />
                    </SurfaceCard>
                </Stack>
            </Grid>
        </Stack>
    }
</FormSection>

@if (View.IsCreateDialogOpen && View.Candidate is not null)
{
    <Dialog IsOpen="true"
            Eyebrow="Recruiting assessment"
            Title="New assessment"
            Subtitle="Create an application-correlated, configuration-fenced evidence cycle."
            Size="ModalSize.Medium"
            DenseChrome="true"
            CloseOnBackdrop="false"
            TestId="crmhr-assessment-create-dialog"
            OnClose="View.CloseCreateDialog">
        <ChildContent>
            <FormStack>
                <FormField Text="Candidate">
                    <TextInput @bind-Value="View.CreateCandidateName" disabled />
                </FormField>
                <FormField Text="Purpose">
                    <TextAreaInput @bind-Value="View.CreatePurpose"
                                   class="form-input ui-input ui-input--outlined ui-input--textarea min-h-[7rem]"
                                   data-testid="crmhr-assessment-purpose" />
                </FormField>
                <Alert AlertStyle="AlertStyle.Info">
                    This assessment is pinned to configuration @View.CandidateConfigurationVersion. Changing the agent later makes old evidence historical rather than silently current.
                </Alert>
            </FormStack>
        </ChildContent>
        <Footer>
            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                <Button Text="Cancel"
                        Tone="ButtonTone.Default"
                        Click="View.CloseCreateDialog" />
                <Button Text="Create assessment"
                        Disabled="@View.IsSaving"
                        Click="View.CreateAssessmentAsync"
                        data-testid="crmhr-assessment-create-save" />
            </Cluster>
        </Footer>
    </Dialog>
}

@if (View.IsAttachDialogOpen && View.Candidate is not null)
{
    <Dialog IsOpen="true"
            Eyebrow="Assessment evidence"
            Title="Attach and classify result"
            Subtitle="Associate one terminal execution target and record a typed recommendation. Missing technical provenance remains incomplete."
            Size="ModalSize.Wide"
            DenseChrome="true"
            CloseOnBackdrop="false"
            TestId="crmhr-assessment-attach-dialog"
            OnClose="View.CloseAttachDialog">
        <ChildContent>
            <Stack GapScale="LayoutGap.Large" AlignItems="AlignItems.Stretch">
                <Grid Gap="LayoutGap.Medium" ColumnsMd="3">
                    <FormField Text="Assessment">
                        <SelectInput @bind-Value="View.AttemptDraft.InterviewId"
                                     data-testid="crmhr-assessment-interview">
                            @foreach (var interview in View.Interviews)
                            {
                                <option value="@interview.Id">@interview.Purpose</option>
                            }
                        </SelectInput>
                    </FormField>
                    <FormField Text="Target kind">
                        <SelectInput @bind-Value="View.AttemptDraft.TargetKind"
                                     data-testid="crmhr-assessment-target-kind">
                            @foreach (var targetKind in Enum.GetValues<AgentRecruitingTargetKind>())
                            {
                                <option value="@targetKind">@AgentRecruitingEvidencePresentation.FormatTargetKind(targetKind)</option>
                            }
                        </SelectInput>
                    </FormField>
                    <FormField Text="Target run ID">
                        <TextInput @bind-Value="View.AttemptDraft.TargetId"
                                   placeholder="00000000-0000-0000-0000-000000000000"
                                   data-testid="crmhr-assessment-target-id" />
                    </FormField>
                </Grid>

                <Grid Gap="LayoutGap.Medium" ColumnsMd="3">
                    <FormField Text="Challenge key">
                        <TextInput @bind-Value="View.AttemptDraft.ChallengeKey"
                                   data-testid="crmhr-assessment-challenge-key" />
                    </FormField>
                    <FormField Text="Challenge version">
                        <TextInput @bind-Value="View.AttemptDraft.ChallengeVersion"
                                   data-testid="crmhr-assessment-challenge-version" />
                    </FormField>
                    <FormField Text="Rubric version">
                        <TextInput @bind-Value="View.AttemptDraft.RubricVersion"
                                   data-testid="crmhr-assessment-rubric-version" />
                    </FormField>
                </Grid>

                <SurfaceCard Soft="true">
                    <TextBlock TextStyle="TextStyle.EyebrowCaption">Typed analysis</TextBlock>
                    <Grid Gap="LayoutGap.Medium" ColumnsMd="3" Class="mt-4">
                        <FormField Text="Classification">
                            <SelectInput @bind-Value="View.AttemptDraft.Classification"
                                         data-testid="crmhr-assessment-classification">
                                @foreach (var classification in Enum.GetValues<AgentRecruitingAssessmentClassification>())
                                {
                                    <option value="@classification">@AgentRecruitingEvidencePresentation.FormatClassification(classification)</option>
                                }
                            </SelectInput>
                        </FormField>
                        <FormField Text="Confidence (0-1)">
                            <NumberInput @bind-Value="View.AttemptDraft.Confidence"
                                         min="0"
                                         max="1"
                                         step="0.01"
                                         data-testid="crmhr-assessment-confidence" />
                        </FormField>
                        <FormField Text="Proposed next step">
                            <SelectInput @bind-Value="View.AttemptDraft.ProposedNextStep"
                                         data-testid="crmhr-assessment-next-step">
                                @foreach (var nextStep in Enum.GetValues<AgentRecruitingProposedNextStep>())
                                {
                                    <option value="@nextStep">@AgentRecruitingEvidencePresentation.FormatNextStep(nextStep)</option>
                                }
                            </SelectInput>
                        </FormField>
                    </Grid>
                    <FormField Text="Analysis summary" Class="mt-4">
                        <TextAreaInput @bind-Value="View.AttemptDraft.AnalysisSummary"
                                       class="form-input ui-input ui-input--outlined ui-input--textarea min-h-[6rem]"
                                       data-testid="crmhr-assessment-analysis-summary" />
                    </FormField>
                    <Grid Gap="LayoutGap.Medium" ColumnsMd="2" Class="mt-4">
                        <FormField Text="Strengths (one per line)">
                            <TextAreaInput @bind-Value="View.AttemptDraft.Strengths"
                                           class="form-input ui-input ui-input--outlined ui-input--textarea min-h-[6rem]"
                                           data-testid="crmhr-assessment-strengths" />
                        </FormField>
                        <FormField Text="Gaps (one per line)">
                            <TextAreaInput @bind-Value="View.AttemptDraft.Gaps"
                                           class="form-input ui-input ui-input--outlined ui-input--textarea min-h-[6rem]"
                                           data-testid="crmhr-assessment-gaps" />
                        </FormField>
                    </Grid>
                </SurfaceCard>

                <SurfaceCard Soft="true">
                    <TextBlock TextStyle="TextStyle.EyebrowCaption">Automated evaluator provenance</TextBlock>
                    <Grid Gap="LayoutGap.Medium" ColumnsMd="4" Class="mt-4">
                        <FormField Text="Decision">
                            <SelectInput @bind-Value="View.AttemptDraft.AutomatedDecision">
                                @foreach (var decision in Enum.GetValues<AgentRecruitingAutomatedDecision>())
                                {
                                    <option value="@decision">@decision</option>
                                }
                            </SelectInput>
                        </FormField>
                        <FormField Text="Score (0-100)">
                            <NumberInput @bind-Value="View.AttemptDraft.Score"
                                         min="0"
                                         max="100" />
                        </FormField>
                        <FormField Text="Evaluator agent">
                            <SelectInput @bind-Value="View.AttemptDraft.EvaluatorAgentId">
                                <option value="">Not supplied</option>
                                @foreach (var option in View.EvaluatorAgents)
                                {
                                    <option value="@option.Id">@option.Name</option>
                                }
                            </SelectInput>
                        </FormField>
                        <FormField Text="Provider">
                            <SelectInput @bind-Value="View.AttemptDraft.ProviderProfileId">
                                <option value="">Not supplied</option>
                                @foreach (var provider in View.Providers)
                                {
                                    <option value="@provider.Id">@provider.Name</option>
                                }
                            </SelectInput>
                        </FormField>
                    </Grid>
                    <FormField Text="Model" Class="mt-4">
                        <TextInput @bind-Value="View.AttemptDraft.Model"
                                   placeholder="Evaluator model name" />
                    </FormField>
                </SurfaceCard>

                <SurfaceCard Soft="true">
                    <TextBlock TextStyle="TextStyle.EyebrowCaption">Evidence integrity</TextBlock>
                    <p class="mt-2 text-sm leading-6 text-chrome-600">
                        Hashes and structured-output provenance are optional for attachment, but readiness stays incomplete until all required evidence is present.
                    </p>
                    <Grid Gap="LayoutGap.Medium" ColumnsMd="2" Class="mt-4">
                        <FormField Text="Input SHA-256">
                            <TextInput @bind-Value="View.AttemptDraft.InputHash" />
                        </FormField>
                        <FormField Text="Output SHA-256">
                            <TextInput @bind-Value="View.AttemptDraft.OutputHash" />
                        </FormField>
                        <FormField Text="Structured output contract">
                            <TextInput @bind-Value="View.AttemptDraft.StructuredOutputContractKey" />
                        </FormField>
                        <FormField Text="Schema SHA-256">
                            <TextInput @bind-Value="View.AttemptDraft.StructuredOutputSchemaHash" />
                        </FormField>
                    </Grid>
                </SurfaceCard>
            </Stack>
        </ChildContent>
        <Footer>
            <Split Breakpoint="LayoutBreakpoint.None"
                   Gap="LayoutGap.Small"
                   AlignItems="AlignItems.Center"
                   JustifyContent="JustifyContent.SpaceBetween"
                   Wrap="FlexWrap.Wrap">
                <SmallText Text="The target is validated in the current workspace before the append succeeds." />
                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                    <Button Text="Cancel"
                            Tone="ButtonTone.Default"
                            Click="View.CloseAttachDialog" />
                    <Button Text="Attach result"
                            Disabled="@View.IsSaving"
                            Click="View.AttachResultAsync"
                            data-testid="crmhr-assessment-attach-save" />
                </Cluster>
            </Split>
        </Footer>
    </Dialog>
}

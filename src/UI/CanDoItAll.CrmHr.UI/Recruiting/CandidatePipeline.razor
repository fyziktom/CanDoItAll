@implements IDisposable
@using CanDoItAll.Editing

@Editing
<EditForm EditContext="context" OnValidSubmit="SubmitAsync" data-testid="crmhr-recruiting-application-form">
<ValidationSummary />
<FormSection Title="Candidate pipeline"
             Icon="person_search"
             Description="Keep candidate identity in the shared registry, move stage explicitly, and preserve stage evidence without splitting recruiting into a disconnected tool.">
    <Grid Gap="LayoutGap.Large"
          ColumnTemplateXl="minmax(0,1.65fr) minmax(18rem,0.75fr)">
        <SurfaceCard>
            <p class="cda-eyebrow">Application editor</p>
            <h3 class="mt-1 text-lg font-semibold text-slate-950">Candidate and stage</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
                Select an existing person or bound AI agent, or create a new human candidate inline, then keep role, ownership, stage, and decision on the same record.
            </p>

            <Tabs RenderMode="TabRenderMode.Client" Variant="TabsVariant.ModalCompact"
                  BorderMode="TabsBorderMode.Soft"
                  Tone="TabsTone.Success"
                  OverflowMode="TabsOverflowMode.Wrap"
                  AriaLabel="Candidate pipeline editor sections"
                  Class="mt-4"
                  data-testid="crmhr-recruiting-application-tabs">
                <TabItems>
                    <TabsItem Text="Candidate"
                              Icon="person"
                              data-testid="crmhr-recruiting-application-tab-candidate">
                        <Stack GapScale="LayoutGap.Medium"
                               AlignItems="AlignItems.Stretch">
                            <Grid Gap="LayoutGap.Medium"
                                  ColumnsMd="2">
                                @if (Draft.Id.HasValue && !RetainedCandidateInput) {
                                    <FormField Text="Candidate"><TextBlock Value="@Draft.CandidateName" /><SmallText Text="Existing candidate details are managed in Directory." /></FormField>
                                } else {
                                <PartyPicker Label="Candidate"
                                             TestIdPrefix="crmhr-recruiting-candidate-party"
                                             PendingChanged="@(pending => ReportAsync(RecruitmentApplicationField.CandidateParty, pending))"
                                             AllowedScope="@(PartyRecordScope.People | PartyRecordScope.AiAgents)"
                                             InitialScope="@(PartyRecordScope.People | PartyRecordScope.AiAgents)"
                                             SelectedPartyId="@Draft.PartyId"
                                             SelectedPartyIdChanged="SetCandidatePartyAsync" />
                                }
                                <FormField Text="Desired role">
                                    <NativeValueInput TValue="string" @bind-Value="Draft.DesiredRole" PendingChanged="@(_ => TextAsync(RecruitmentApplicationField.DesiredRole))"
                                               class="cda-input"
                                               data-testid="crmhr-recruiting-role" />
                                </FormField>
                            </Grid>

                            <Grid Gap="LayoutGap.Medium"
                                  ColumnsMd="2"
                                  ColumnsLg="3">
                                <FormField Text="New candidate name">
                                    <NativeValueInput TValue="string" @bind-Value="Draft.CandidateName" PendingChanged="@(_ => TextAsync(RecruitmentApplicationField.CandidateName))" disabled="@(Draft.Id.HasValue && !RetainedCandidateInput)"
                                               class="cda-input"
                                               data-testid="crmhr-recruiting-candidate-name" />
                                </FormField>
                                <FormField Text="Email">
                                    <NativeValueInput TValue="string" @bind-Value="Draft.CandidateEmail" PendingChanged="@(_ => TextAsync(RecruitmentApplicationField.CandidateEmail))" disabled="@(Draft.Id.HasValue && !RetainedCandidateInput)"
                                               class="cda-input"
                                               data-testid="crmhr-recruiting-candidate-email" />
                                </FormField>
                                <FormField Text="Phone">
                                    <NativeValueInput TValue="string" @bind-Value="Draft.CandidatePhone" PendingChanged="@(_ => TextAsync(RecruitmentApplicationField.CandidatePhone))" disabled="@(Draft.Id.HasValue && !RetainedCandidateInput)"
                                               class="cda-input"
                                               data-testid="crmhr-recruiting-candidate-phone" />
                                </FormField>
                            </Grid>

                            <FormField Text="Candidate summary">
                                <NativeValueInput TValue="string" Multiline="true" @bind-Value="Draft.CandidateSummary" PendingChanged="@(_ => TextAsync(RecruitmentApplicationField.CandidateSummary))" disabled="@(Draft.Id.HasValue && !RetainedCandidateInput)"
                                               class="cda-input cda-input--textarea"
                                               data-testid="crmhr-recruiting-candidate-summary" />
                            </FormField>
                        </Stack>
                    </TabsItem>

                    <TabsItem Text="Stage"
                              Icon="phase"
                              data-testid="crmhr-recruiting-application-tab-stage">
                        <Stack GapScale="LayoutGap.Medium"
                               AlignItems="AlignItems.Stretch">
                            <Grid Gap="LayoutGap.Medium" ColumnsMd="2">
                                <FormField Text="Stage">
                                    <InputSelect @bind-Value="Draft.Stage" @bind-Value:after="@(() => ReportAsync(RecruitmentApplicationField.Stage))"
                                                 class="cda-input"
                                                 data-testid="crmhr-recruiting-stage">
                                        @foreach (var stage in Enum.GetValues<RecruitmentStage>()) {
                                            <option value="@stage">@stage</option>
                                        }
                                    </InputSelect>
                                </FormField>
                                <FormField Text="Decision">
                                    <InputSelect @bind-Value="Draft.Decision" @bind-Value:after="@(() => ReportAsync(RecruitmentApplicationField.Decision))"
                                                 class="cda-input"
                                                 data-testid="crmhr-recruiting-decision">
                                        @foreach (var decision in Enum.GetValues<RecruitmentDecision>()) {
                                            <option value="@decision">@decision</option>
                                        }
                                    </InputSelect>
                                </FormField>
                                <FormField Text="Available from">
                                    <NativeValueInput TValue="DateOnly?" DisplayName="Available from" @bind-Value="Draft.AvailableFrom" PendingChanged="@(pending => ReportAsync(RecruitmentApplicationField.AvailableFrom, pending))"
                                               class="cda-input"
                                               data-testid="crmhr-recruiting-available-from" />
                                </FormField>
                                <FormField Text="Source">
                                    <NativeValueInput TValue="string" @bind-Value="Draft.Source" PendingChanged="@(_ => TextAsync(RecruitmentApplicationField.Source))"
                                               class="cda-input"
                                               data-testid="crmhr-recruiting-source" />
                                </FormField>
                            </Grid>
                        </Stack>
                    </TabsItem>

                    <TabsItem Text="Ownership"
                              Icon="manage_accounts"
                              data-testid="crmhr-recruiting-application-tab-ownership">
                        <Stack GapScale="LayoutGap.Medium"
                               AlignItems="AlignItems.Stretch">
                            <Grid Gap="LayoutGap.Medium"
                                  ColumnsMd="2"
                                  ColumnsLg="3">
                                <PartyPicker Label="Recruiter"
                                             TestIdPrefix="crmhr-recruiting-recruiter"
                                             PendingChanged="@(pending => ReportAsync(RecruitmentApplicationField.Recruiter, pending))"
                                             AllowedScope="PartyRecordScope.People"
                                             InitialScope="PartyRecordScope.People"
                                             SelectedPartyId="@Draft.RecruiterPartyId"
                                             SelectedPartyIdChanged="SetRecruiterPartyAsync" />
                                <PartyPicker Label="Hiring manager"
                                             TestIdPrefix="crmhr-recruiting-hiring-manager"
                                             PendingChanged="@(pending => ReportAsync(RecruitmentApplicationField.HiringManager, pending))"
                                             AllowedScope="PartyRecordScope.People"
                                             InitialScope="PartyRecordScope.People"
                                             SelectedPartyId="@Draft.HiringManagerPartyId"
                                             SelectedPartyIdChanged="SetHiringManagerPartyAsync" />
                                <PartyPicker Label="Target unit"
                                             TestIdPrefix="crmhr-recruiting-target-unit"
                                             PendingChanged="@(pending => ReportAsync(RecruitmentApplicationField.TargetUnit, pending))"
                                             AllowedScope="@(PartyRecordScope.Organizations | PartyRecordScope.OrganizationUnits)"
                                             InitialScope="@(PartyRecordScope.Organizations | PartyRecordScope.OrganizationUnits)"
                                             SelectedPartyId="@Draft.TargetUnitPartyId"
                                             SelectedPartyIdChanged="SetTargetUnitPartyAsync" />
                            </Grid>
                        </Stack>
                    </TabsItem>

                    <TabsItem Text="Notes"
                              Icon="note"
                              data-testid="crmhr-recruiting-application-tab-notes">
                        <Stack GapScale="LayoutGap.Medium"
                               AlignItems="AlignItems.Stretch">
                            <FormField Text="Stage note">
                                <NativeValueInput TValue="string" Multiline="true" @bind-Value="Draft.StageNotes" PendingChanged="@(_ => TextAsync(RecruitmentApplicationField.StageNotes))"
                                               class="cda-input cda-input--textarea"
                                               data-testid="crmhr-recruiting-stage-notes" />
                            </FormField>

                            <FormField Text="Notes">
                                <NativeValueInput TValue="string" Multiline="true" @bind-Value="Draft.Notes" PendingChanged="@(_ => TextAsync(RecruitmentApplicationField.Notes))"
                                               class="cda-input cda-input--textarea"
                                               data-testid="crmhr-recruiting-notes" />
                            </FormField>
                        </Stack>
                    </TabsItem>
                </TabItems>
            </Tabs>

            <Cluster Gap="LayoutGap.Small"
                     Wrap="FlexWrap.Wrap"
                     Class="mt-4">
                <Button Text="Save application"
                        Icon="save"
                        Type="submit" Disabled="@SaveDisabled"
                        data-testid="crmhr-recruiting-save-button" />
                <Button Text="Reset"
                        Icon="restart_alt"
                        ButtonStyle="ButtonStyle.Light"
                        Click="ResetApplication" Disabled="@WritesDisabled"
                        data-testid="crmhr-recruiting-reset-button" />
            </Cluster>
        </SurfaceCard>

        <SurfaceCard Soft="true">
            <Split Gap="LayoutGap.Medium"
                   AlignItems="AlignItems.Center"
                   JustifyContent="JustifyContent.SpaceBetween"
                   Wrap="FlexWrap.Wrap">
                <div>
                    <p class="cda-eyebrow">Stage history</p>
                    <h3 class="mt-1 text-lg font-semibold text-slate-950">@StageHistory.Count update(s)</h3>
                </div>
                @if (HasWorkforceProfile) {
                    <StatusBadge Tone="success"
                                 Text="Workforce profile exists" />
                }
            </Split>

            @if (StageHistory.Count == 0) {
                <div class="mt-4">
                    <EmptyState Eyebrow="No stage updates"
                                Title="Save the application first"
                                Description="Recruitment creation and every stage transition appear here after the application has been saved." />
                </div>
            }
            else {
                <Stack GapScale="LayoutGap.Medium" Class="mt-4">
                    @foreach (var item in StageHistory) {
                        <PanelCard data-testid="crmhr-recruiting-stage-history-item">
                            <Split Gap="LayoutGap.Medium"
                                   AlignItems="AlignItems.Start"
                                   JustifyContent="JustifyContent.SpaceBetween"
                                   Wrap="FlexWrap.Wrap">
                                <div class="min-w-0 space-y-1">
                                    <p class="text-base font-semibold text-slate-950">@item.Summary</p>
                                    <p class="text-sm text-slate-600">@item.ChangedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm") / @item.ChangedBy</p>
                                    @if (!string.IsNullOrWhiteSpace(item.Notes)) {
                                        <p class="text-sm leading-6 text-slate-600">@item.Notes</p>
                                    }
                                </div>
                                <StatusBadge Tone="@ResolveStageTone(item.Stage)"
                                             Text="@item.Stage.ToString()" />
                            </Split>
                        </PanelCard>
                    }
                </Stack>
            }
        </SurfaceCard>
    </Grid>
</FormSection>
</EditForm>

@code {
    private bool disposed;
    private EditContext context = default!;
    private readonly HashSet<RecruitmentApplicationField> pending = [];
    [Parameter] public RenderFragment? Editing { get; set; }
    [Parameter] public bool SaveDisabled { get; set; }
    [Parameter] public bool RetainedCandidateInput { get; set; }
    [Parameter] public bool WritesDisabled { get; set; }
    [Parameter] public EventCallback<RecordInput<RecruitmentApplicationField>> InputChanged { get; set; }
    protected override void OnInitialized() => context = new(Draft);
    protected override void OnParametersSet() {
        if (!ReferenceEquals(context.Model, Draft)) {
            throw new InvalidOperationException("A different recruitment draft requires a new form lifetime.");
        }
    }
    public Task SubmitAsync() => disposed || SaveDisabled || pending.Count > 0 || !context.Validate() ? Task.CompletedTask : SaveApplication.InvokeAsync();
    private Task TextAsync(RecruitmentApplicationField field) {
        if (disposed) {
            return Task.CompletedTask;
        }

        return ReportAsync(field);
    }
    private Task ReportAsync(RecruitmentApplicationField field, bool incomplete = false) {
        if (disposed) {
            return Task.CompletedTask;
        }
        if (incomplete) {
            pending.Add(field);
        } else {
            pending.Remove(field);
        }
        return InputChanged.InvokeAsync(new(field, incomplete));
    }
    public void Dispose() => disposed = true;

    [Parameter]
    public RecruitmentApplicationEditorModel Draft { get; set; } = new();

    [Parameter]
    public IReadOnlyList<RecruitmentStageHistoryItemModel> StageHistory { get; set; } = [];

    [Parameter]
    public bool HasWorkforceProfile { get; set; }

    [Parameter]
    public EventCallback SaveApplication { get; set; }

    [Parameter]
    public EventCallback ResetApplication { get; set; }

    private Task SetCandidatePartyAsync(Guid? partyId) {
        if (disposed) {
            return Task.CompletedTask;
        }
        Draft.PartyId = partyId;
        context.NotifyFieldChanged(new(Draft, nameof(Draft.PartyId)));
        return InputChanged.InvokeAsync(new(RecruitmentApplicationField.CandidateParty, pending.Contains(RecruitmentApplicationField.CandidateParty)));
    }

    private Task SetRecruiterPartyAsync(Guid? partyId) {
        if (disposed) {
            return Task.CompletedTask;
        }
        Draft.RecruiterPartyId = partyId;
        context.NotifyFieldChanged(new(Draft, nameof(Draft.RecruiterPartyId)));
        return InputChanged.InvokeAsync(new(RecruitmentApplicationField.Recruiter, pending.Contains(RecruitmentApplicationField.Recruiter)));
    }

    private Task SetHiringManagerPartyAsync(Guid? partyId) {
        if (disposed) {
            return Task.CompletedTask;
        }
        Draft.HiringManagerPartyId = partyId;
        context.NotifyFieldChanged(new(Draft, nameof(Draft.HiringManagerPartyId)));
        return InputChanged.InvokeAsync(new(RecruitmentApplicationField.HiringManager, pending.Contains(RecruitmentApplicationField.HiringManager)));
    }

    private Task SetTargetUnitPartyAsync(Guid? partyId) {
        if (disposed) {
            return Task.CompletedTask;
        }
        Draft.TargetUnitPartyId = partyId;
        context.NotifyFieldChanged(new(Draft, nameof(Draft.TargetUnitPartyId)));
        return InputChanged.InvokeAsync(new(RecruitmentApplicationField.TargetUnit, pending.Contains(RecruitmentApplicationField.TargetUnit)));
    }

    private static string ResolveStageTone(RecruitmentStage stage) {
        return stage switch {
            RecruitmentStage.Hired => "success",
            RecruitmentStage.Offer => "primary",
            RecruitmentStage.Interviewing => "info",
            RecruitmentStage.Rejected => "danger",
            RecruitmentStage.Withdrawn => "warning",
            _ => "base"
        };
    }
}

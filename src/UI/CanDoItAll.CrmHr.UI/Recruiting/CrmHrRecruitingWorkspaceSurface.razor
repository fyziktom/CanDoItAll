@using CanDoItAll.Editing
@namespace CanDoItAll.CrmHr.UI.Recruiting
@inherits CrmHrWorkspaceSurface<ICrmHrRecruitingWorkspaceView>

<PageScaffold MaxWidthClass="max-w-full">
    <Header>
        <PageHeader Eyebrow="CRM / HR"
                    Title="Recruiting workspace"
                    Description="Recruit people and AI agents through interviews, execution evidence, typed analysis, training, rechecks, and an explicitly authorized handoff."
                    Compact="true">
            <Stats>
                <CompactStat Label="applications"
                             Value="@View.ApplicationSummary.TotalCount.ToString()"
                             TooltipText="Candidate pipelines tracked on the shared registry." />
                <CompactStat Label="interviewing"
                             Value="@View.ApplicationSummary.InterviewingCount.ToString()"
                             TooltipText="Candidates currently in interview loops."
                             Tone="info" />
                <CompactStat Label="offer or hired"
                             Value="@View.ApplicationSummary.OfferOrHiredCount.ToString()"
                             TooltipText="Applications close enough to require controlled handoff."
                             Tone="success" />
                <CompactStat Label="open tasks"
                             Value="@(View.CurrentWorkspace?.LifecycleTasks.Count(item => item.Status is not LifecycleTaskStatus.Completed and not LifecycleTaskStatus.Cancelled).ToString() ?? "0")"
                             TooltipText="Selected candidate training, onboarding, or offboarding actions."
                             Tone="warning" />
            </Stats>
            <Actions>
                @if (View.SelectedPartyId.HasValue)
                {
                    <PageHeaderActionButton Icon="groups"
                                            Label="Open workforce"
                                            TooltipText="Open the linked workforce profile."
                                            Click="View.OpenWorkforceAsync"
                                            data-testid="crmhr-recruiting-open-workforce" />
                }
            </Actions>
        </PageHeader>
    </Header>

    <ChildContent>
        <Stack GapScale="LayoutGap.Medium">
            @SecondaryNavigation

            <SurfaceCard data-testid="crmhr-recruiting-catalog">
                <Stack GapScale="LayoutGap.Medium">
                    <ListPanelHeader Title="Recruitment applications"
                                     Description="Search and page through candidate pipelines. Open a card to manage the complete recruitment record."
                                     Count="Server-paged">
                        <Actions>
                            <Button Text="New application"
                                    ButtonStyle="ButtonStyle.Light"
                                    Size="ButtonSize.Small"
                                    Click="View.CreateNewApplicationAsync"
                                    data-testid="crmhr-recruiting-new-button" />
                        </Actions>
                    </ListPanelHeader>

                    <PagedRecordBrowser RefreshVersion="@(View.ApplicationBrowserRevision + CatalogRefreshVersion)"
                                        TKey="Guid"
                                        TFilter="RecruitmentApplicationScope"
                                        Loader="View.LoadApplicationPageAsync"
                                        InitialFilter="RecruitmentApplicationScope.All"
                                        FilterOptions="@CrmHrRecruitingWorkspacePresentation.ApplicationScopeOptions"
                                        ShowTagFilter="false"
                                        Selection="@View.ApplicationSelection"
                                        SelectionChanged="View.SelectApplicationAsync"
                                        Query="@View.CatalogQuery"
                                        QueryChanged="View.HandleCatalogQueryChangedAsync"
                                        LoadFailed="View.HandleApplicationPageLoadFailed"
                                        MaximumSearchLength="RecruitmentApplicationQueryLimits.MaximumSearchLength"
                                        PageSize="@RecruitmentApplicationQueryLimits.DefaultPageSize"
                                        ResultsScrollMode="PagedRecordResultsScrollMode.Bounded"
                                        GridMode="PagedRecordGridMode.BoundedCatalog"
                                        SearchPlaceholder="Search candidate, role, recruiter, manager, source, or public email"
                                        FilterAriaLabel="Recruitment stage"
                                        LoadingEyebrow="Recruiting"
                                        LoadingTitle="Loading applications"
                                        EmptyEyebrow="No recruitment applications"
                                        EmptyTitle="No applications match"
                                        EmptyDescription="Change the search or stage, or create the first candidate."
                                        DataTestId="crmhr-recruiting-applications" />
                </Stack>
            </SurfaceCard>

            @if (View.IsRecruitmentDialogOpen && View.CurrentWorkspace is { } recruitmentWorkspace)
            {
                <Dialog IsOpen="true"
                        Eyebrow="Recruitment record"
                        Title="@View.RecruitmentDialogTitle"
                        Subtitle="Application, interviews, assessment evidence, development, and controlled conversion."
                        Size="ModalSize.Full"
                        DenseChrome="true"
                        CloseOnBackdrop="false"
                        TestId="crmhr-recruiting-record-dialog"
                        OnClose="View.CloseRecruitmentDialogAsync">
                    <ChildContent>
                    @RecordUpdates
                    @if (recruitmentWorkspace.HasSelectedApplication)
                    {
                        <SurfaceCard>
                            <Split Gap="LayoutGap.Medium"
                                   AlignItems="AlignItems.Start"
                                   JustifyContent="JustifyContent.SpaceBetween"
                                   Wrap="FlexWrap.Wrap">
                                <div class="min-w-0">
                                    <p class="cda-eyebrow">Candidate summary</p>
                                    <h2 class="mt-1 text-lg font-semibold text-slate-950">@recruitmentWorkspace.CandidateDisplayName</h2>
                                    @if (!string.IsNullOrWhiteSpace(recruitmentWorkspace.CandidateSummary))
                                    {
                                        <p class="mt-3 text-sm leading-6 text-slate-600">@recruitmentWorkspace.CandidateSummary</p>
                                    }
                                </div>
                                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                    @if (recruitmentWorkspace.CandidatePartyType is { } candidatePartyType)
                                    {
                                        <StatusBadge Tone="neutral" Text="@CrmHrRecruitingWorkspacePresentation.FormatCandidateType(candidatePartyType)" />
                                    }
                                    @if (recruitmentWorkspace.CandidatePartyType == PartyType.AiAgent)
                                    {
                                        <StatusBadge Tone="@CrmHrRecruitingWorkspacePresentation.ResolveBindingTone(recruitmentWorkspace.CandidateBindingStatus)"
                                                     Text="@CrmHrRecruitingWorkspacePresentation.FormatBinding(recruitmentWorkspace.CandidateBindingStatus)" />
                                    }
                                    <StatusBadge Tone="@CrmHrRecruitingWorkspacePresentation.ResolveStageTone(recruitmentWorkspace.Application.Stage)" Text="@recruitmentWorkspace.Application.Stage.ToString()" />
                                    <StatusBadge Tone="@CrmHrRecruitingWorkspacePresentation.ResolveDecisionTone(recruitmentWorkspace.Application.Decision)" Text="@recruitmentWorkspace.Application.Decision.ToString()" />
                                </Cluster>
                            </Split>

                            <CompactStatStrip Class="mt-5">
                                <CompactStat Label="email"
                                             Value="@CrmHrRecruitingWorkspacePresentation.FormatValue(recruitmentWorkspace.CandidatePrimaryEmail)"
                                             TooltipText="Candidate primary email." />
                                <CompactStat Label="phone"
                                             Value="@CrmHrRecruitingWorkspacePresentation.FormatValue(recruitmentWorkspace.CandidatePrimaryPhone)"
                                             TooltipText="Candidate primary phone." />
                                <CompactStat Label="recruiter"
                                             Value="@CrmHrRecruitingWorkspacePresentation.FormatValue(recruitmentWorkspace.RecruiterDisplayName)"
                                             TooltipText="Recruiter responsible for this application." />
                                <CompactStat Label="hiring manager"
                                             Value="@CrmHrRecruitingWorkspacePresentation.FormatValue(recruitmentWorkspace.HiringManagerDisplayName)"
                                             TooltipText="Hiring manager responsible for the decision." />
                            </CompactStatStrip>
                        </SurfaceCard>
                    }
                    else
                    {
                        <SurfaceCard Soft="true">
                            <p class="cda-eyebrow">Recruiting workspace ready</p>
                            <h2 class="mt-1 text-lg font-semibold text-slate-950">Create or choose a candidate pipeline</h2>
                            <p class="mt-3 text-sm leading-6 text-slate-600">Candidate setup, interviews, lifecycle tasks, and workforce conversion all stay on this route once the first application is saved.</p>
                        </SurfaceCard>
                    }

                        <Tabs SelectedIndex="@View.SelectedRecruitingTabIndex"
                              SelectedIndexChanged="View.HandleRecruitingTabChangedAsync"
                              RenderMode="TabRenderMode.Client"
                              Variant="TabsVariant.WorkspaceSecondary"
                              BorderMode="TabsBorderMode.Soft"
                              OverflowMode="TabsOverflowMode.Wrap"
                              AriaLabel="Recruitment record sections"
                              data-testid="crmhr-recruiting-tabs">
                            <TabsItem Text="Application"
                                      Icon="person_search"
                                      data-testid="crmhr-recruiting-tab-application">
                            <CandidatePipeline @key="View.ApplicationEditor" Draft="View.ApplicationEditor" Editing="ApplicationEditing"
                                               InputChanged="ApplicationInputChanged" SaveDisabled="ApplicationSaveDisabled" RetainedCandidateInput="RetainedCandidateInput" WritesDisabled="WritesDisabled"
                                               StageHistory="recruitmentWorkspace.StageHistory"
                                               HasWorkforceProfile="recruitmentWorkspace.HasWorkforceProfile"
                                               SaveApplication="View.SaveApplicationAsync"
                                               ResetApplication="View.ResetApplicationAsync" />
                            </TabsItem>

                            @if (recruitmentWorkspace.HasSelectedApplication)
                            {
                            <TabsItem Text="Interviews"
                                      Icon="event"
                                      data-testid="crmhr-recruiting-tab-interviews">
                            <InterviewSchedulePanel @key="View.InterviewEditor" Draft="View.InterviewEditor"
                                                    InputChanged="InterviewInputChanged" SaveDisabled="InterviewSaveDisabled" WritesDisabled="WritesDisabled"
                                                    Interviews="recruitmentWorkspace.Interviews"
                                                    SaveInterview="View.SaveInterviewAsync"
                                                    ResetInterview="View.ResetInterviewAsync"
                                                    DeleteInterview="View.DeleteInterviewAsync" />
                            </TabsItem>

                            <TabsItem Text="Assessments"
                                      Icon="fact_check"
                                      data-testid="crmhr-recruiting-tab-assessments">
                            @AgentEvidence
                            </TabsItem>

                            <TabsItem Text="Development"
                                      Icon="school"
                                      data-testid="crmhr-recruiting-tab-development">
                            @SupportEditing
                            <OnboardingChecklistPanel DatabaseProfileId="View.DatabaseProfileId"
                                                      TaskInputChanged="TaskInputChanged" SupportInputChanged="SupportInputChanged"
                                                      TaskSaveDisabled="TaskSaveDisabled" SupportSaveDisabled="SupportSaveDisabled" WritesDisabled="WritesDisabled" SupportDraft="View.SupportEditor"
                                                      CurrentAssignments="recruitmentWorkspace.SupportAssignments"
                                                      TaskDraft="View.TaskEditor"
                                                      Tasks="recruitmentWorkspace.LifecycleTasks"
                                                      SaveSupportAssignments="View.SaveSupportAssignmentsAsync"
                                                      SaveTask="View.SaveTaskAsync"
                                                      ResetTask="View.ResetTaskAsync"
                                                      DeleteTask="View.DeleteTaskAsync" />
                            </TabsItem>

                            <TabsItem Text="Conversion"
                                      Icon="group_add"
                                      data-testid="crmhr-recruiting-tab-conversion">
                            <RecruitmentConversionForm @key="View.ConversionEditor" Draft="View.ConversionEditor" CandidatePartyId="View.SelectedPartyId"
                                HasWorkforceProfile="recruitmentWorkspace.HasWorkforceProfile" EligibilityError="View.ConversionEligibilityError" SaveDisabled="ConversionSaveDisabled"
                                Save="View.ConvertCandidateAsync" OpenWorkforce="View.OpenWorkforceAsync" InputChanged="ConversionInputChanged" Editing="ConversionEditing" />
                            </TabsItem>
                            }
                        </Tabs>
                    </ChildContent>
                    <Footer>
                        <Split Breakpoint="LayoutBreakpoint.None"
                               Gap="LayoutGap.Medium"
                               AlignItems="AlignItems.Center"
                               JustifyContent="JustifyContent.SpaceBetween"
                               Wrap="FlexWrap.Wrap">
                            <SmallText Text="Automated evidence never changes stage, converts workforce, or activates an agent." />
                            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                @if (View.SelectedPartyId.HasValue)
                                {
                                    <Button Text="Open workforce"
                                            ButtonStyle="ButtonStyle.Light"
                                            Click="View.OpenWorkforceAsync" />
                                }
                                <Button Text="Close"
                                        ButtonStyle="ButtonStyle.Light"
                                        Click="View.CloseRecruitmentDialogAsync"
                                        data-testid="crmhr-recruiting-record-close" />
                            </Cluster>
                        </Split>
                    </Footer>
                </Dialog>
            }
        </Stack>
    </ChildContent>
</PageScaffold>

@code {
    [Parameter] public long CatalogRefreshVersion { get; set; }
    [Parameter] public RenderFragment? RecordUpdates { get; set; }
    [Parameter] public RenderFragment? ApplicationEditing { get; set; }
    [Parameter] public RenderFragment? ConversionEditing { get; set; }
    [Parameter] public RenderFragment? SupportEditing { get; set; }
    [Parameter] public bool WritesDisabled { get; set; }
    [Parameter] public bool ApplicationSaveDisabled { get; set; }
    [Parameter] public bool RetainedCandidateInput { get; set; }
    [Parameter] public bool InterviewSaveDisabled { get; set; }
    [Parameter] public bool TaskSaveDisabled { get; set; }
    [Parameter] public bool SupportSaveDisabled { get; set; }
    [Parameter] public bool ConversionSaveDisabled { get; set; }
    [Parameter] public EventCallback<RecordInput<RecruitmentApplicationField>> ApplicationInputChanged { get; set; }
    [Parameter] public EventCallback<RecordInput<RecruitmentInterviewField>> InterviewInputChanged { get; set; }
    [Parameter] public EventCallback<RecordInput<RecruitmentTaskField>> TaskInputChanged { get; set; }
    [Parameter] public EventCallback<RecordInput<RecruitmentSupportField>> SupportInputChanged { get; set; }
    [Parameter] public EventCallback<RecordInput<RecruitmentConversionField>> ConversionInputChanged { get; set; }
    // Host-owned region: the host composes its adapter here.
    [Parameter]
    public RenderFragment? AgentEvidence { get; set; }
}

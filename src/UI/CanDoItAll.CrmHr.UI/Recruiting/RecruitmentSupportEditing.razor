@using CanDoItAll.Editing
@using CanDoItAll.Editing.UI

@if (State.IsOutdated) {
    <Alert AlertStyle="AlertStyle.Warning"><TextBlock Value="The saved support values changed. Review the current values before replacing them." /><Button Text="Review support changes" Tone="ButtonTone.Default" Click="ReviewRequested" data-testid="crmhr-recruiting-support-review-open" /></Alert>
}
@if (State.CanUndo) {
    <Button Text="Undo support merge" Tone="ButtonTone.Default" Click="UndoRequested" />
}
<Dialog IsOpen="@(State.Review is not null)" Title="Review support changes" Size="ModalSize.Full" DenseChrome="true" CloseOnBackdrop="false" OnClose="Cancelled" TestId="crmhr-recruiting-support-review-dialog">
    <ChildContent>
        @if (State.Review is { } review) {
            <Stack GapScale="LayoutGap.Medium" Stretch="true">
                <Alert AlertStyle="AlertStyle.Info"><TextBlock Value="Compare the original values, your draft and the current saved values. Apply changes only your draft. Save remains a separate action." /></Alert>
                @if (State.IsStale || State.State.IsUnknown || State.State.HasPendingInput) {
                    <Alert AlertStyle="AlertStyle.Warning"><TextBlock Value="Refresh a stale comparison and complete pending input before applying. A comparison does not resolve an unknown save outcome." /></Alert>
                }
                <Button Text="@(showUnchanged ? "Show changed fields" : "Show all fields")" Tone="ButtonTone.Default" Click="@(() => showUnchanged = !showUnchanged)" />
                <MergeFieldView TValue="Guid?" Label="Manager" Field="review.Manager" Format="PartyName" ShowUnchanged="showUnchanged" Changed="Changed" />
                <MergeFieldView TValue="Guid?" Label="Buddy" Field="review.Buddy" Format="PartyName" ShowUnchanged="showUnchanged" Changed="Changed" />
                <MergeFieldView TValue="Guid?" Label="Mentor" Field="review.Mentor" Format="PartyName" ShowUnchanged="showUnchanged" Changed="Changed" />
            </Stack>
        }
    </ChildContent>
    <Footer>
        <Cluster Gap="LayoutGap.Small" JustifyContent="JustifyContent.SpaceBetween">
            <Button Text="Cancel review" Tone="ButtonTone.Default" Click="Cancelled" />
            <Cluster Gap="LayoutGap.Small">
                <Button Text="Refresh comparison" Tone="ButtonTone.Default" Disabled="Reading" Click="ReviewRequested" data-testid="crmhr-recruiting-support-review-refresh" />
                <Button Text="Apply to my draft" Disabled="@(Reading || !State.CanApply)" Click="ApplyRequested" data-testid="crmhr-recruiting-support-review-apply" />
            </Cluster>
        </Cluster>
    </Footer>
</Dialog>

@code {
    private bool showUnchanged;
    [Parameter, EditorRequired] public RecruitmentReplacementReview<RecruitmentSupportAssignmentsEditorModel, RecruitmentSupportField, RecruitmentSupportReview> State { get; set; } = default!;
    [Parameter] public bool Reading { get; set; }
    [Parameter] public Func<Guid?, string> PartyName { get; set; } = _ => "Referenced party";
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback ReviewRequested { get; set; }
    [Parameter] public EventCallback ApplyRequested { get; set; }
    [Parameter] public EventCallback UndoRequested { get; set; }
    [Parameter] public EventCallback Cancelled { get; set; }
}

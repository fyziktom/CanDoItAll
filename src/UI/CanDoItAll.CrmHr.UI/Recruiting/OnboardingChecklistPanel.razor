@implements IDisposable
@using CanDoItAll.Editing

<FormSection Title="Development, lifecycle tasks, and support"
             Description="Keep assessment training, onboarding, and offboarding work owned, due-dated, and visible with manager, buddy, and mentor assignments.">
    @if (SupportDraft.PartyId == Guid.Empty) {
        <EmptyState Eyebrow="No candidate selected"
                    Title="Choose or create an application first"
                    Description="Support assignments and lifecycle tasks become available after the recruitment application has been created." />
    }
    else {
        <Grid Gap="LayoutGap.Large" ColumnsLg="2">
            <SurfaceCard>
                <EditForm @key="SupportDraft" EditContext="supportContext" OnValidSubmit="SubmitSupportAsync" data-testid="crmhr-recruiting-support-form">
                <ValidationSummary />
                <p class="cda-eyebrow">Support network</p>
                <h3 class="mt-1 text-lg font-semibold text-slate-950">Manager, buddy, and mentor</h3>

                <Grid Gap="LayoutGap.Medium" ColumnsMd="3" Class="mt-4">
                    <PartyPicker Label="Manager"
                                 TestIdPrefix="crmhr-recruiting-support-manager" PendingChanged="@(pending => SupportInputAsync(RecruitmentSupportField.Manager, pending))"
                                 AllowedScope="PartyRecordScope.People"
                                 InitialScope="PartyRecordScope.People"
                                 ExcludedPartyId="@SupportDraft.PartyId"
                                 SelectedPartyId="@SupportDraft.ManagerPartyId"
                                 SelectedPartyIdChanged="SetManagerPartyAsync" />
                    <PartyPicker Label="Buddy"
                                 TestIdPrefix="crmhr-recruiting-support-buddy" PendingChanged="@(pending => SupportInputAsync(RecruitmentSupportField.Buddy, pending))"
                                 AllowedScope="PartyRecordScope.People"
                                 InitialScope="PartyRecordScope.People"
                                 ExcludedPartyId="@SupportDraft.PartyId"
                                 SelectedPartyId="@SupportDraft.BuddyPartyId"
                                 SelectedPartyIdChanged="SetBuddyPartyAsync" />
                    <PartyPicker Label="Mentor"
                                 TestIdPrefix="crmhr-recruiting-support-mentor" PendingChanged="@(pending => SupportInputAsync(RecruitmentSupportField.Mentor, pending))"
                                 AllowedScope="PartyRecordScope.People"
                                 InitialScope="PartyRecordScope.People"
                                 ExcludedPartyId="@SupportDraft.PartyId"
                                 SelectedPartyId="@SupportDraft.MentorPartyId"
                                 SelectedPartyIdChanged="SetMentorPartyAsync" />
                </Grid>

                <Cluster Gap="LayoutGap.Small" Class="mt-4">
                    <Button Text="Save support roles"
                            Type="submit" Disabled="@SupportSaveDisabled"
                            data-testid="crmhr-recruiting-support-save-button" />
                </Cluster>

                <div class="mt-5">
                    <p class="cda-eyebrow">Current assignments</p>
                    <Cluster Gap="LayoutGap.Small" Class="mt-2">
                        <StatusBadge Tone="primary"
                                     Text="@BuildSupportBadge("Manager", CurrentAssignments.ManagerName)" />
                        <StatusBadge Tone="info"
                                     Text="@BuildSupportBadge("Buddy", CurrentAssignments.BuddyName)" />
                        <StatusBadge Tone="success"
                                     Text="@BuildSupportBadge("Mentor", CurrentAssignments.MentorName)" />
                    </Cluster>
                </div>
                </EditForm>
            </SurfaceCard>

            <SurfaceCard Soft="true">
                <EditForm @key="TaskDraft" EditContext="taskContext" OnValidSubmit="SubmitTaskAsync" data-testid="crmhr-recruiting-task-form">
                <ValidationSummary />
                <p class="cda-eyebrow">Checklist item</p>
                <h3 class="mt-1 text-lg font-semibold text-slate-950">Training or lifecycle task</h3>

                <Grid Gap="LayoutGap.Medium" ColumnsMd="2" Class="mt-4">
                    <FormField Text="Task kind">
                        <InputSelect @bind-Value="TaskDraft.TaskKind" @bind-Value:after="@(() => TaskInputAsync(RecruitmentTaskField.Kind))"
                                     class="cda-input"
                                     data-testid="crmhr-recruiting-task-kind">
                            @foreach (var taskKind in Enum.GetValues<LifecycleTaskKind>()) {
                                <option value="@taskKind">@taskKind</option>
                            }
                        </InputSelect>
                    </FormField>
                    <FormField Text="Status">
                        <InputSelect @bind-Value="TaskDraft.Status" @bind-Value:after="@(() => TaskInputAsync(RecruitmentTaskField.Status))"
                                     class="cda-input"
                                     data-testid="crmhr-recruiting-task-status">
                            @foreach (var status in Enum.GetValues<LifecycleTaskStatus>()) {
                                <option value="@status">@status</option>
                            }
                        </InputSelect>
                    </FormField>
                </Grid>

                <Grid Gap="LayoutGap.Medium" ColumnsMd="2" Class="mt-4">
                    <FormField Text="Title">
                        <NativeValueInput TValue="string" @bind-Value="TaskDraft.Title" PendingChanged="@(_ => TaskTextAsync(RecruitmentTaskField.Title))"
                                   class="cda-input"
                                   data-testid="crmhr-recruiting-task-title" />
                    </FormField>
                    <PartyPicker Label="Owner"
                                 TestIdPrefix="crmhr-recruiting-task-owner" PendingChanged="@(pending => TaskInputAsync(RecruitmentTaskField.Owner, pending))"
                                 AllowedScope="PartyRecordScope.People"
                                 InitialScope="PartyRecordScope.People"
                                 ExcludedPartyId="@SupportDraft.PartyId"
                                 SelectedPartyId="@TaskDraft.OwnerPartyId"
                                 SelectedPartyIdChanged="SetTaskOwnerPartyAsync" />
                </Grid>

                <Grid Gap="LayoutGap.Medium" ColumnsMd="2" Class="mt-4">
                    <FormField Text="Due date">
                        <NativeValueInput TValue="DateOnly?" DisplayName="Task due date" @bind-Value="TaskDraft.DueDate" PendingChanged="@(pending => TaskInputAsync(RecruitmentTaskField.DueDate, pending))"
                                   class="cda-input"
                                   data-testid="crmhr-recruiting-task-due-date" />
                    </FormField>
                    <ProjectPicker Label="Related project"
                                   TestIdPrefix="crmhr-recruiting-task-project"
                                   SelectedProjectId="@TaskDraft.RelatedProjectId"
                                   SelectedProjectIdChanged="SetRelatedProjectAsync" DatabaseProfileId="DatabaseProfileId"
                                   SelectedAdmission="TaskDraft.RelatedProjectAdmission" SelectedAdmissionChanged="SetRelatedAdmissionAsync" PendingChanged="@(pending => TaskInputAsync(RecruitmentTaskField.Project, pending))" />
                </Grid>

                <div class="mt-4">
                    <FormField Text="Notes">
                        <NativeValueInput TValue="string" Multiline="true" @bind-Value="TaskDraft.Notes" PendingChanged="@(_ => TaskTextAsync(RecruitmentTaskField.Notes))"
                                       class="cda-input cda-input--textarea min-h-[7rem]"
                                       data-testid="crmhr-recruiting-task-notes" />
                    </FormField>
                </div>

                <Cluster Gap="LayoutGap.Small" Class="mt-4">
                    <Button Text="Save task"
                            Type="submit" Disabled="@TaskSaveDisabled"
                            data-testid="crmhr-recruiting-task-save-button" />
                    <Button Text="Reset"
                            ButtonStyle="ButtonStyle.Light"
                            Click="ResetTask" Disabled="@WritesDisabled"
                            data-testid="crmhr-recruiting-task-reset-button" />
                </Cluster>
                </EditForm>
            </SurfaceCard>
        </Grid>

        <SurfaceCard Soft="true" Class="mt-6">
            <p class="cda-eyebrow">Lifecycle board</p>
            <h3 class="mt-1 text-lg font-semibold text-slate-950">@Tasks.Count task(s)</h3>

            @if (Tasks.Count == 0) {
                <div class="mt-4">
                    <EmptyState Eyebrow="No development tasks"
                                Title="Create the first task"
                                Description="Assessment training, equipment, access, onboarding, and offboarding follow-up appear here with ownership and due dates." />
                </div>
            }
            else {
                <Stack GapScale="LayoutGap.Medium" Class="mt-4">
                    @foreach (var item in Tasks) {
                        <PanelCard data-testid="crmhr-recruiting-task-item">
                            <Split Gap="LayoutGap.Medium"
                                   AlignItems="AlignItems.Start"
                                   JustifyContent="JustifyContent.SpaceBetween">
                                <div class="min-w-0 space-y-1">
                                    <p class="text-base font-semibold text-slate-950">@item.Title</p>
                                    <p class="text-sm text-slate-600">@BuildTaskMeta(item)</p>
                                    @if (!string.IsNullOrWhiteSpace(item.Notes)) {
                                        <p class="text-sm leading-6 text-slate-600">@item.Notes</p>
                                    }
                                </div>
                                <Cluster Gap="LayoutGap.Small">
                                    <StatusBadge Tone="@ResolveTaskTone(item)"
                                                 Text="@item.Status.ToString()" />
                                    <Button Text="Delete"
                                            ButtonStyle="ButtonStyle.Danger"
                                            Size="ButtonSize.Small"
                                            Click="@(() => DeleteTask.InvokeAsync(item))" Disabled="@WritesDisabled"
                                            data-testid="crmhr-recruiting-task-delete-button" />
                                </Cluster>
                            </Split>
                        </PanelCard>
                    }
                </Stack>
            }
        </SurfaceCard>
    }
</FormSection>

@code {
    private bool disposed;
    private EditContext supportContext = default!;
    private EditContext taskContext = default!;
    private readonly HashSet<RecruitmentSupportField> supportPending = [];
    private readonly HashSet<RecruitmentTaskField> taskPending = [];
    [Parameter] public Guid DatabaseProfileId { get; set; }
    [Parameter] public bool SupportSaveDisabled { get; set; }
    [Parameter] public bool TaskSaveDisabled { get; set; }
    [Parameter] public bool WritesDisabled { get; set; }
    [Parameter] public EventCallback<RecordInput<RecruitmentSupportField>> SupportInputChanged { get; set; }
    [Parameter] public EventCallback<RecordInput<RecruitmentTaskField>> TaskInputChanged { get; set; }
    protected override void OnInitialized() {
        supportContext = new(SupportDraft);
        taskContext = new(TaskDraft);
    }
    protected override void OnParametersSet() {
        if (!ReferenceEquals(supportContext.Model, SupportDraft)) {
            supportContext = new(SupportDraft);
            supportPending.Clear();
        }
        if (!ReferenceEquals(taskContext.Model, TaskDraft)) {
            taskContext = new(TaskDraft);
            taskPending.Clear();
        }
    }
    public Task SubmitTaskAsync() => disposed || TaskSaveDisabled || taskPending.Count > 0 || !taskContext.Validate() ? Task.CompletedTask : SaveTask.InvokeAsync();
    public Task SubmitSupportAsync() => disposed || SupportSaveDisabled || supportPending.Count > 0 || !supportContext.Validate() ? Task.CompletedTask : SaveSupportAssignments.InvokeAsync();
    private Task TaskTextAsync(RecruitmentTaskField field) {
        if (disposed) {
            return Task.CompletedTask;
        }

        return TaskInputAsync(field);
    }
    private Task TaskInputAsync(RecruitmentTaskField field, bool incomplete = false) {
        if (disposed) {
            return Task.CompletedTask;
        }
        if (incomplete) {
            taskPending.Add(field);
        } else {
            taskPending.Remove(field);
        }
        return TaskInputChanged.InvokeAsync(new(field, incomplete));
    }
    private Task SupportInputAsync(RecruitmentSupportField field, bool incomplete = false) {
        if (disposed) {
            return Task.CompletedTask;
        }
        if (incomplete) {
            supportPending.Add(field);
        } else {
            supportPending.Remove(field);
        }
        return SupportInputChanged.InvokeAsync(new(field, incomplete));
    }
    private Task SetRelatedAdmissionAsync(ProjectWriteAdmission? admission) {
        if (disposed) {
            return Task.CompletedTask;
        }
        TaskDraft.RelatedProjectAdmission = admission;
        return TaskInputChanged.InvokeAsync(new(RecruitmentTaskField.Project, taskPending.Contains(RecruitmentTaskField.Project)));
    }
    public void Dispose() => disposed = true;

    [Parameter]
    public RecruitmentSupportAssignmentsEditorModel SupportDraft { get; set; } = new();

    [Parameter]
    public RecruitmentSupportAssignmentsModel CurrentAssignments { get; set; } = new(Guid.Empty, null, string.Empty, null, string.Empty, null, string.Empty);

    [Parameter]
    public LifecycleTaskEditorModel TaskDraft { get; set; } = new();

    [Parameter]
    public IReadOnlyList<LifecycleTaskItemModel> Tasks { get; set; } = [];

    [Parameter]
    public EventCallback SaveSupportAssignments { get; set; }

    [Parameter]
    public EventCallback SaveTask { get; set; }

    [Parameter]
    public EventCallback ResetTask { get; set; }

    [Parameter]
    public EventCallback<LifecycleTaskItemModel> DeleteTask { get; set; }

    private Task SetManagerPartyAsync(Guid? id) {
        if (disposed) {
            return Task.CompletedTask;
        }
        SupportDraft.ManagerPartyId = id;
        supportContext.NotifyFieldChanged(new(SupportDraft, nameof(SupportDraft.ManagerPartyId)));
        return SupportInputChanged.InvokeAsync(new(RecruitmentSupportField.Manager, supportPending.Contains(RecruitmentSupportField.Manager)));
    }

    private Task SetBuddyPartyAsync(Guid? id) {
        if (disposed) {
            return Task.CompletedTask;
        }
        SupportDraft.BuddyPartyId = id;
        supportContext.NotifyFieldChanged(new(SupportDraft, nameof(SupportDraft.BuddyPartyId)));
        return SupportInputChanged.InvokeAsync(new(RecruitmentSupportField.Buddy, supportPending.Contains(RecruitmentSupportField.Buddy)));
    }

    private Task SetMentorPartyAsync(Guid? id) {
        if (disposed) {
            return Task.CompletedTask;
        }
        SupportDraft.MentorPartyId = id;
        supportContext.NotifyFieldChanged(new(SupportDraft, nameof(SupportDraft.MentorPartyId)));
        return SupportInputChanged.InvokeAsync(new(RecruitmentSupportField.Mentor, supportPending.Contains(RecruitmentSupportField.Mentor)));
    }

    private Task SetTaskOwnerPartyAsync(Guid? id) {
        if (disposed) {
            return Task.CompletedTask;
        }
        TaskDraft.OwnerPartyId = id;
        taskContext.NotifyFieldChanged(new(TaskDraft, nameof(TaskDraft.OwnerPartyId)));
        return TaskInputChanged.InvokeAsync(new(RecruitmentTaskField.Owner, taskPending.Contains(RecruitmentTaskField.Owner)));
    }

    private Task SetRelatedProjectAsync(Guid? id) {
        if (disposed) {
            return Task.CompletedTask;
        }
        TaskDraft.RelatedProjectId = id;
        TaskDraft.RelatedProjectAdmission = null;
        taskContext.NotifyFieldChanged(new(TaskDraft, nameof(TaskDraft.RelatedProjectId)));
        return TaskInputChanged.InvokeAsync(new(RecruitmentTaskField.Project, taskPending.Contains(RecruitmentTaskField.Project)));
    }

    private static string BuildSupportBadge(string label, string value) {
        return string.IsNullOrWhiteSpace(value)
            ? $"{label}: Unassigned"
            : $"{label}: {value}";
    }

    private static string BuildTaskMeta(LifecycleTaskItemModel item) {
        var parts = new List<string> {
            item.TaskKind.ToString()
        };

        if (!string.IsNullOrWhiteSpace(item.OwnerName)) {
            parts.Add(item.OwnerName);
        }

        if (item.DueDate.HasValue) {
            parts.Add(item.DueDate.Value.ToString("yyyy-MM-dd"));
        }

        if (!string.IsNullOrWhiteSpace(item.RelatedProjectName)) {
            parts.Add(item.RelatedProjectName);
        }

        return string.Join(" / ", parts);
    }

    private static string ResolveTaskTone(LifecycleTaskItemModel item) {
        if (item.IsOverdue) {
            return "danger";
        }

        return item.Status switch {
            LifecycleTaskStatus.Completed => "success",
            LifecycleTaskStatus.InProgress => "primary",
            LifecycleTaskStatus.Cancelled => "base",
            _ => "warning"
        };
    }
}

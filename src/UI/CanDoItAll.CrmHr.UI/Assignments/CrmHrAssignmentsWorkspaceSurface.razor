@namespace CanDoItAll.CrmHr.UI.Assignments
@inherits CrmHrWorkspaceSurface<ICrmHrAssignmentsWorkspaceView>

<PageScaffold MaxWidthClass="max-w-full">
    <Header>
        <PageHeader Eyebrow="CRM / HR"
                    Title="Assignments workspace"
                    Description="Keep commercial, staffing, and project allocations aligned with the live project portfolio."
                    Compact="true">
            <Stats>
                <CompactStat Label="projects"
                             Value="@View.ProjectCount.ToString()"
                             TooltipText="Projects currently available for CRM-HR relationship binding." />
                <CompactStat Label="open requests"
                             Value="@View.StaffingDashboard.OpenRequestCount.ToString()"
                             TooltipText="Open staffing demand across the CRM-HR module."
                             Tone="info" />
                <CompactStat Label="open demand"
                             Value="@($"{View.StaffingDashboard.OpenDemandPercent:0.##}%")"
                             TooltipText="Requested allocation still flowing through open staffing requests."
                             Tone="warning" />
                <CompactStat Label="bench"
                             Value="@View.StaffingDashboard.BenchCount.ToString()"
                             TooltipText="Profiles currently available for staffing."
                             Tone="success" />
                <CompactStat Label="overallocated"
                             Value="@View.StaffingDashboard.OverallocatedCount.ToString()"
                             TooltipText="Profiles already exceeding available capacity."
                             Tone="danger" />
            </Stats>
        </PageHeader>
    </Header>

    <ChildContent>
        <Stack GapScale="LayoutGap.Medium">
            @SecondaryNavigation

            @if (View.RecordsChanged || View.EditingRequiresAttention) {
                <Alert AlertStyle="@(View.EditingRequiresAttention ? AlertStyle.Warning : AlertStyle.Info)" data-testid="crmhr-assignments-editing-status">
                    <Stack GapScale="LayoutGap.Small">
                        <TextBlock Value="@(View.RecordsChanged ? "Project assignments changed. Refresh the saved records; open drafts are retained." : View.EditingMessage)" />
                        <Button Text="Refresh saved records" ButtonStyle="ButtonStyle.Light" Click="View.RefreshRecordsAsync" data-testid="crmhr-assignments-refresh-records" />
                        <AssignmentUnknownRecovery IsUnknown="View.HasUnknownOperation" CanDiscard="View.CanDiscardReviewedUnknown"
                            Refresh="View.RefreshRecordsAsync" Discard="View.DiscardReviewedUnknownAsync" />
                    </Stack>
                </Alert>
            }

            <AssignmentsProjectContextBar SelectedProject="View.SelectedProject"
                                          SelectedProjectId="View.SelectedProjectId"
                                          SelectedProjectIdChanged="View.HandleProjectChanged"
                                          ProjectLoadFailed="View.HandleProjectPickerLoadFailed"
                                          AssignmentCount="View.AssignmentCounts.TotalCount"
                                          AllocationCount="View.AssignmentCounts.AllocationCount"
                                          StaffingRequestCount="View.StaffingRequestCount"
                                          OpenStructure="View.OpenStructure"
                                          OpenGantt="View.OpenGantt" />

            <Tabs @key="View.WorkspaceTabsKey"
                  SelectedIndex="@((int)View.SelectedWorkspaceTab)"
                  SelectedIndexChanged="View.HandleWorkspaceTabChangedAsync"
                  RenderMode="TabRenderMode.Client"
                  Variant="TabsVariant.WorkspaceSecondary"
                  BorderMode="TabsBorderMode.Soft"
                  OverflowMode="TabsOverflowMode.Wrap"
                  AriaLabel="Project assignment workflows"
                  data-testid="crmhr-assignments-workspace-tabs">
                <TabsItem Text="Resource schedule"
                          Icon="view_timeline"
                          BadgeText="@View.AssignmentCounts.ScheduledCount.ToString()"
                          data-testid="crmhr-assignments-tab-schedule">
                    @if (View.IsLoading(AssignmentSelectionData.ScheduleAssignments))
                    {
                        <LoadingState Eyebrow="Resource schedule"
                                      Title="Loading the bounded schedule window"
                                      Description="Only the current project's dated allocation view is being loaded." />
                    }
                    else if (View.HasDisplayed(AssignmentSelectionData.ScheduleAssignments))
                    {
                        <ProjectAssignmentResourceGanttPanel ProjectName="@(View.SelectedProject?.Name ?? string.Empty)"
                                                             Assignments="View.ScheduleAssignments"
                                                             TotalCount="View.ScheduleAssignmentTotalCount" />
                    }
                </TabsItem>

                <TabsItem Text="Relationships"
                          Icon="hub"
                          BadgeText="@View.AssignmentCounts.TotalCount.ToString()"
                          data-testid="crmhr-assignments-tab-relationships">
                    @if (View.IsLoading(AssignmentSelectionData.RelationshipAssignments))
                    {
                        <LoadingState Eyebrow="Project relationships"
                                      Title="Loading relationship records"
                                      Description="The selected relationship page is being loaded from the server." />
                    }
                    else if (View.HasDisplayed(AssignmentSelectionData.RelationshipAssignments))
                    {
                        <ProjectPartyAssignmentPanel Recovery="@(RecoveryActions("crmhr-assignment", AssignmentEditorKind.Relationship))" SaveDisabled="View.RelationshipSaveDisabled" WritesDisabled="View.WritesDisabled" StatusMessage="@View.EditingMessage"
                                                     HasChanges="@(() => View.RelationshipDirty)" RequestDiscard="@(() => View.RequestDiscardAsync(AssignmentEditorKind.Relationship))"
                                                     InputChanged="View.AssignmentInputChangedAsync" ReviewPrimary="View.ReviewRelationshipPrimaryAsync" ProjectName="@(View.SelectedProject?.Name ?? string.Empty)"
                                                     CanCreate="@(View.SelectedProjectId.HasValue && !View.IsProjectContextLoading)"
                                                     Draft="View.DraftAssignment"
                                                     Assignments="View.RelationshipAssignments"
                                                     PageIndex="View.RelationshipAssignmentPageIndex"
                                                     PageSize="CrmHrAssignmentsWorkspacePresentation.AssignmentPageSize"
                                                     TotalCount="View.RelationshipAssignmentTotalCount"
                                                     SearchText="@View.RelationshipAssignmentSearchText"
                                                     SearchTextChanged="View.HandleRelationshipSearchTextChangedAsync"
                                                     RoleFilter="View.RelationshipAssignmentRoleFilter"
                                                     RoleFilterChanged="View.HandleRelationshipRoleFilterChangedAsync"
                                                     PageChanged="View.HandleRelationshipPageChangedAsync"
                                                     PrepareCreate="View.PrepareRelationshipCreateAsync"
                                                     SaveDraft="View.SaveDraftAsync"
                                                     ResetDraft="View.ResetDraftAsync"
                                                     DeleteAssignment="View.DeleteAssignmentAsync"
                                                     LoadTaskDetails="View.LoadTaskDetailsAsync"
                                                     OpenStructure="View.OpenSelectedProjectStructure"
                                                     OpenGantt="View.OpenSelectedProjectGantt" />
                    }
                </TabsItem>

                <TabsItem Text="Staffing requests"
                          Icon="person_search"
                          BadgeText="@View.StaffingRequestBadgeText"
                          data-testid="crmhr-assignments-tab-staffing">
                    @if (View.IsLoading(AssignmentSelectionData.StaffingRequests))
                    {
                        <LoadingState Eyebrow="Staffing requests"
                                      Title="Loading project demand"
                                      Description="Only this tab's staffing records are being loaded." />
                    }
                    else if (View.HasDisplayed(AssignmentSelectionData.StaffingRequests))
                    {
                        <StaffingRequestEditor Recovery="@(RecoveryActions("crmhr-staffing-request", AssignmentEditorKind.Staffing))" SaveDisabled="View.StaffingSaveDisabled" WritesDisabled="View.WritesDisabled" StatusMessage="@View.EditingMessage"
                                                     HasChanges="@(() => View.StaffingDirty)" RequestDiscard="@(() => View.RequestDiscardAsync(AssignmentEditorKind.Staffing))"
                                                     InputChanged="View.StaffingInputChangedAsync" ProjectName="@(View.SelectedProject?.Name ?? string.Empty)"
                                               CanCreate="@(View.SelectedProjectId.HasValue && !View.IsProjectContextLoading)"
                                               Draft="View.StaffingRequestDraft"
                                               SkillCatalog="View.SkillCatalog"
                                               RefreshSkills="View.RefreshSkillCatalogAsync"
                                               RefreshSkillsDisabled="@View.IsLoading(AssignmentSelectionData.SkillCatalog)"
                                               Requests="View.StaffingRequests"
                                               PageIndex="View.StaffingRequestPageIndex"
                                               PageSize="CrmHrAssignmentsWorkspacePresentation.StaffingPageSize"
                                               TotalCount="View.StaffingRequestTotalCount"
                                               SearchText="@View.StaffingRequestSearchText"
                                               SearchTextChanged="View.HandleStaffingRequestSearchTextChangedAsync"
                                               StatusFilter="View.StaffingRequestStatusFilter"
                                               StatusFilterChanged="View.HandleStaffingRequestStatusFilterChangedAsync"
                                               PageChanged="View.HandleStaffingRequestPageChangedAsync"
                                               PrepareCreate="View.PrepareStaffingCreateAsync"
                                               SaveRequest="View.SaveStaffingRequestAsync"
                                               ResetRequest="View.ResetStaffingRequestAsync"
                                               DeleteRequest="View.DeleteStaffingRequestAsync" />
                    }
                </TabsItem>

                <TabsItem Text="Allocations"
                          Icon="groups"
                          BadgeText="@View.AssignmentCounts.AllocationCount.ToString()"
                          data-testid="crmhr-assignments-tab-allocations">
                    @if (View.IsLoading(AssignmentSelectionData.AllocationAssignments))
                    {
                        <LoadingState Eyebrow="Project allocations"
                                      Title="Loading allocation records"
                                      Description="The selected allocation page is being loaded from the server." />
                    }
                    else if (View.HasDisplayed(AssignmentSelectionData.AllocationAssignments))
                    {
                        <ProjectAllocationEditor Recovery="@(RecoveryActions("crmhr-allocation", AssignmentEditorKind.Allocation))" SaveDisabled="View.AllocationSaveDisabled" WritesDisabled="View.WritesDisabled" StatusMessage="@View.EditingMessage"
                                                     HasChanges="@(() => View.AllocationDirty)" RequestDiscard="@(() => View.RequestDiscardAsync(AssignmentEditorKind.Allocation))"
                                                     InputChanged="View.AllocationInputChangedAsync" ReviewPrimary="View.ReviewAllocationPrimaryAsync" Draft="View.AllocationDraft"
                                                 ProjectName="@(View.SelectedProject?.Name ?? string.Empty)"
                                                 CanCreate="@(View.SelectedProjectId.HasValue && !View.IsProjectContextLoading)"
                                                 Allocations="View.AllocationAssignments"
                                                 PageIndex="View.AllocationAssignmentPageIndex"
                                                 PageSize="CrmHrAssignmentsWorkspacePresentation.AssignmentPageSize"
                                                 TotalCount="View.AllocationAssignmentTotalCount"
                                                 SearchText="@View.AllocationAssignmentSearchText"
                                                 SearchTextChanged="View.HandleAllocationSearchTextChangedAsync"
                                                 RoleFilter="View.AllocationAssignmentRoleFilter"
                                                 RoleFilterChanged="View.HandleAllocationRoleFilterChangedAsync"
                                                 PageChanged="View.HandleAllocationPageChangedAsync"
                                                 SkillCatalog="View.SkillCatalog"
                                                 Candidates="View.StaffingCandidates"
                                                 CandidatePageIndex="View.StaffingCandidatePageIndex"
                                                 CandidatePageSize="CrmHrAssignmentsWorkspacePresentation.StaffingPageSize"
                                                 CandidateTotalCount="View.StaffingCandidateTotalCount"
                                                 CandidatePageChanged="View.HandleCandidatePageChangedAsync"
                                                 CandidateSearchText="@View.CandidateSearchText"
                                                 CandidateSearchTextChanged="View.HandleCandidateSearchTextChanged"
                                                 CandidateSkillFilter="View.CandidateSkillFilter"
                                                 CandidateSkillFilterChanged="View.HandleCandidateSkillFilterChanged"
                                                 CandidateAvailabilityFilter="View.CandidateAvailabilityFilter"
                                                 CandidateAvailabilityFilterChanged="View.HandleCandidateAvailabilityFilterChanged"
                                                 SearchCandidates="View.SearchCandidatesAsync"
                                                 ResetCandidateFilters="View.ResetCandidateFiltersAsync"
                                                 PrepareCreate="View.PrepareAllocationCreateAsync"
                                                 SaveAllocation="View.SaveAllocationAsync"
                                                 ResetAllocation="View.ResetAllocationAsync"
                                                 DeleteAllocation="View.DeleteAllocationAsync"
                                                 LoadTaskDetails="View.LoadTaskDetailsAsync"
                                                 OpenStructure="View.OpenSelectedProjectStructure"
                                                 OpenGantt="View.OpenSelectedProjectGantt" />
                    }
                </TabsItem>
            </Tabs>
        </Stack>
    </ChildContent>
</PageScaffold>
<AssignmentReviewDialog Disabled="View.WritesDisabled" Cancelled="View.RequestRender" State="View.Comparisons" Skills="View.SkillCatalog" Apply="View.ApplyComparisonAsync" Refresh="@(() => View.Comparisons.Editor is { } editor ? View.CompareAsync(editor) : Task.CompletedTask)" />

@code {
    private RenderFragment RecoveryActions(string prefix, AssignmentEditorKind editor) => @<Stack GapScale="LayoutGap.Small">
        <AssignmentUnknownRecovery IsUnknown="View.HasUnknownOperation" CanDiscard="View.CanDiscardReviewedUnknown"
            Refresh="View.RefreshRecordsAsync" Discard="View.DiscardReviewedUnknownAsync" TestIdPrefix="@prefix" />
        @if (editor == AssignmentEditorKind.Staffing ? View.StaffingRequestDraft.Id.HasValue :
            editor == AssignmentEditorKind.Relationship ? View.DraftAssignment.AssignmentId.HasValue : View.AllocationDraft.AssignmentId.HasValue) {
            <Cluster Gap="LayoutGap.Small">
                <Button Text="Compare saved changes" ButtonStyle="ButtonStyle.Light" Disabled="@(View.WritesDisabled || View.Comparisons.Reading)"
                    Click="@(() => View.CompareAsync(editor))" data-testid="@($"{prefix}-compare")" />
                @if (View.Comparisons.CanUndoFor(editor)) {
                    <Button Text="Undo applied comparison" ButtonStyle="ButtonStyle.Light" Click="View.UndoComparisonAsync" data-testid="@($"{prefix}-undo-comparison")" />
                }
            </Cluster>
        }
    </Stack>;
}

@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Modules.Projects

<Stack GapScale="LayoutGap.Medium">
    <SurfaceCard Soft="true">
        <Stack GapScale="LayoutGap.Small">
            <Split Breakpoint="LayoutBreakpoint.None"
                   Gap="LayoutGap.Small"
                   AlignItems="AlignItems.Center"
                   JustifyContent="JustifyContent.SpaceBetween"
                   Wrap="FlexWrap.Wrap">
                <div class="min-w-0">
                    <TextBlock TextStyle="TextStyle.EyebrowCaption">Project demand</TextBlock>
                    <h3 class="mt-1 truncate text-lg font-semibold text-chrome-950">Staffing requests</h3>
                    <SmallText Text="@ProjectContextText" />
                </div>
                <TooltipTarget Text="@CreateTooltipText"
                               Position="TooltipPosition.Bottom"
                               TestId="crmhr-staffing-request-create-tooltip">
                    <Button Class="ui-button--quick"
                            Icon="add"
                            Size="ButtonSize.Small"
                            Disabled="@(!CanOpenCreate)"
                            IsBusy="@isPreparingCreate"
                            aria-label="Create staffing request"
                            data-testid="crmhr-staffing-request-create-button"
                            Click="OpenCreateAsync" />
                </TooltipTarget>
            </Split>

            <CompactFilterBar ResultText="@($"{TotalCount} matching request(s)")">
                <input value="@SearchText"
                       @oninput="HandleSearchInputAsync"
                       class="form-input ui-input ui-input--outlined ui-input--density-compact h-10 min-w-[16rem] flex-1"
                       style="width: auto; flex: 1 1 24rem;"
                       placeholder="Search title, role, project, requester, unit, skill, or notes"
                       aria-label="Search staffing requests"
                       data-testid="crmhr-staffing-request-search" />
                <SelectInput TValue="StaffingRequestStatus?"
                             Value="@StatusFilter"
                             ValueChanged="HandleStatusFilterChangedAsync"
                             ValueExpression="@(() => StatusFilter)"
                             class="form-input ui-input ui-input--outlined ui-input--density-compact h-10 min-w-[12rem]"
                             style="width: 12rem; flex: 0 1 12rem;"
                             aria-label="Filter staffing requests by status"
                             data-testid="crmhr-staffing-request-status-filter">
                    <option value="">All statuses</option>
                    @foreach (var status in Enum.GetValues<StaffingRequestStatus>())
                    {
                        <option value="@status">@status</option>
                    }
                </SelectInput>
            </CompactFilterBar>
        </Stack>
    </SurfaceCard>

    @if (Requests.Count == 0)
    {
        <EmptyState Eyebrow="@EmptyStateEyebrow"
                    Title="@EmptyStateTitle"
                    Description="@EmptyStateDescription" />
    }
    else
    {
        <Grid Gap="LayoutGap.Medium"
              ColumnTemplate="repeat(auto-fill,minmax(min(100%,20rem),30rem))"
              data-testid="crmhr-staffing-request-grid">
            @foreach (var request in Requests)
            {
                <PanelCard Class="h-full"
                           data-testid="crmhr-staffing-request-item">
                    <Stack GapScale="LayoutGap.Small" Class="h-full">
                        <Split Breakpoint="LayoutBreakpoint.None"
                               Gap="LayoutGap.Small"
                               AlignItems="AlignItems.Start"
                               JustifyContent="JustifyContent.SpaceBetween">
                            <div class="min-w-0">
                                <TextBlock TextStyle="TextStyle.EyebrowCaption">Project</TextBlock>
                                <p class="truncate text-xs font-semibold text-chrome-600">@ResolveProjectName(request)</p>
                                <h3 class="mt-2 line-clamp-2 text-base font-semibold text-chrome-950">@request.Title</h3>
                            </div>
                            <StatusBadge Tone="@ResolveStatusTone(request.Status)"
                                         Text="@request.Status.ToString()" />
                        </Split>

                        <p class="text-sm leading-5 text-chrome-600">@BuildMeta(request)</p>

                        @if (request.NeededSkills.Count > 0)
                        {
                            <Cluster Gap="LayoutGap.XSmall" Wrap="FlexWrap.Wrap">
                                @foreach (var skill in request.NeededSkills.Take(3))
                                {
                                    <StatusBadge Tone="info" Text="@skill.Name" />
                                }
                                @if (request.NeededSkills.Count > 3)
                                {
                                    <StatusBadge Tone="neutral"
                                                 Text="@($"+{request.NeededSkills.Count - 3}")" />
                                }
                            </Cluster>
                        }

                        @if (!string.IsNullOrWhiteSpace(request.Notes))
                        {
                            <p class="line-clamp-2 text-sm leading-5 text-chrome-600">@request.Notes</p>
                        }

                        <CardActions Secondary="true" Class="mt-auto pt-3">
                            <StatusBadge Tone="neutral"
                                         Text="@($"{request.AllocationPercent:0.##}% allocation")" />
                            <Cluster Gap="LayoutGap.XSmall" Wrap="FlexWrap.NoWrap">
                                <TooltipTarget Text="Show staffing request details"
                                               Position="TooltipPosition.Bottom">
                                    <Button Tone="ButtonTone.Default"
                                            Size="ButtonSize.Small"
                                            Class="ui-button--quick"
                                            Icon="visibility"
                                            aria-label="Show staffing request details"
                                            data-testid="crmhr-staffing-request-details-button"
                                            Click="@(() => ShowDetails(request))" />
                                </TooltipTarget>
                                <TooltipTarget Text="Delete this staffing request"
                                               Position="TooltipPosition.Bottom">
                                    <Button Tone="ButtonTone.Danger"
                                            Size="ButtonSize.Small"
                                            Class="ui-button--quick"
                                            Icon="delete"
                                            aria-label="Delete staffing request"
                                            data-testid="crmhr-staffing-request-delete-button"
                                            Disabled="WritesDisabled" Click="@(() => DeleteRequest.InvokeAsync(request))" />
                                </TooltipTarget>
                            </Cluster>
                        </CardActions>
                    </Stack>
                </PanelCard>
            }
        </Grid>

        <Split Breakpoint="LayoutBreakpoint.None"
               Gap="LayoutGap.Small"
               AlignItems="AlignItems.Center"
               JustifyContent="JustifyContent.SpaceBetween"
               Wrap="FlexWrap.Wrap">
            <StatusBadge Tone="neutral"
                         Text="@PageText" />
            <Cluster Gap="LayoutGap.Small">
                <Button Text="Previous"
                        Icon="chevron_left"
                        Tone="ButtonTone.Default"
                        Size="ButtonSize.Small"
                        Disabled="@(PageIndex <= 0)"
                        Click="@(() => PageChanged.InvokeAsync(PageIndex - 1))"
                        data-testid="crmhr-staffing-request-previous" />
                <Button Text="Next"
                        Icon="chevron_right"
                        Tone="ButtonTone.Default"
                        Size="ButtonSize.Small"
                        Disabled="@(PageIndex + 1 >= TotalPages)"
                        Click="@(() => PageChanged.InvokeAsync(PageIndex + 1))"
                        data-testid="crmhr-staffing-request-next" />
            </Cluster>
        </Split>
    }
</Stack>

@if (isEditorOpen)
{
    <Dialog IsOpen="true"
            Eyebrow="Staffing request"
            Title="@(Draft.Id.HasValue ? "Edit saved staffing request" : "Open a staffing request")"
            Subtitle="@ProjectName"
            Size="ModalSize.Wide"
            DenseChrome="true"
            TestId="crmhr-staffing-request-dialog"
            OnClose="CloseEditorAsync">
        <ChildContent>
            <EditForm @key="Draft" EditContext="context" OnValidSubmit="HandleSaveAsync">
            <ValidationSummary />
            @if (StatusMessage is not null) {
                <Alert AlertStyle="AlertStyle.Info" data-testid="crmhr-editor-status">@StatusMessage</Alert>
            }
            @Recovery


            <Stack GapScale="LayoutGap.Medium">
                <SmallText Text="Requests stay scoped to the selected project so demand and project allocations remain traceable to the same portfolio record." />

                <Grid Gap="LayoutGap.Medium" ColumnsMd="2">
                    <FormField Text="Request title">
                        <NativeValueInput TValue="string" @bind-Value="Draft.Title" PendingChanged="@(_ => TextAsync(StaffingField.Title))"
                                   class="form-input ui-input ui-input--outlined"
                                   data-testid="crmhr-staffing-request-title" />
                    </FormField>
                    <FormField Text="Needed role">
                        <NativeValueInput TValue="string" @bind-Value="Draft.NeededRole" PendingChanged="@(_ => TextAsync(StaffingField.Role))"
                                   class="form-input ui-input ui-input--outlined"
                                   data-testid="crmhr-staffing-request-role" />
                    </FormField>
                </Grid>

                <Grid Gap="LayoutGap.Medium" ColumnsMd="4">
                    <FormField Text="Allocation %">
                        <NativeValueInput DisplayName="allocation percentage" TValue="decimal" @bind-Value="Draft.AllocationPercent" PendingChanged="@(value => ReportAsync(StaffingField.Allocation, value))"
                                     class="form-input ui-input ui-input--outlined"
                                     data-testid="crmhr-staffing-request-allocation" />
                    </FormField>
                    <FormField Text="Starts on">
                        <NativeValueInput DisplayName="start date" TValue="DateOnly?" @bind-Value="Draft.StartDate" PendingChanged="@(value => ReportAsync(StaffingField.Start, value))"
                                   class="form-input ui-input ui-input--outlined"
                                   data-testid="crmhr-staffing-request-start-date" />
                    </FormField>
                    <FormField Text="Ends on">
                        <NativeValueInput DisplayName="end date" TValue="DateOnly?" @bind-Value="Draft.EndDate" PendingChanged="@(value => ReportAsync(StaffingField.End, value))"
                                   class="form-input ui-input ui-input--outlined"
                                   data-testid="crmhr-staffing-request-end-date" />
                    </FormField>
                    <FormField Text="Status">
                        <SelectInput @bind-Value="Draft.Status" @bind-Value:after="@(() => ReportAsync(StaffingField.Status))"
                                     class="form-input ui-input ui-input--outlined"
                                     data-testid="crmhr-staffing-request-status">
                            @foreach (var status in Enum.GetValues<StaffingRequestStatus>())
                            {
                                <option value="@status">@status</option>
                            }
                        </SelectInput>
                    </FormField>
                </Grid>

                <Grid Gap="LayoutGap.Medium" ColumnsMd="2">
                    <PartyPicker Label="Requested by"
                                 TestIdPrefix="crmhr-staffing-request-requested-by"
                                 SelectedPartyId="Draft.RequestedByPartyId"
                                 SelectedPartyIdChanged="HandleRequestedByChanged" PendingChanged="@(value => ReportAsync(StaffingField.Requester, value))" />
                    <PartyPicker Label="Delivery unit"
                                 TestIdPrefix="crmhr-staffing-request-delivery-unit"
                                 AllowedScope="PartyRecordScope.OrganizationUnits"
                                 InitialScope="PartyRecordScope.OrganizationUnits"
                                 SelectedPartyId="Draft.DeliveryUnitPartyId"
                                 SelectedPartyIdChanged="HandleDeliveryUnitChanged" PendingChanged="@(value => ReportAsync(StaffingField.DeliveryUnit, value))" />
                </Grid>

                <Stack GapScale="LayoutGap.Small">
                    <Cluster Gap="LayoutGap.Small" JustifyContent="JustifyContent.SpaceBetween">
                        <TextBlock Value="Needed skills" TextStyle="TextStyle.Subtitle2" />
                        <Button Text="Refresh skill choices" Size="ButtonSize.Small" Tone="ButtonTone.Default"
                            Disabled="@(WritesDisabled || isSaving || RefreshSkillsDisabled)" Click="RefreshSkills"
                            data-testid="crmhr-staffing-request-refresh-skills" />
                    </Cluster>
                    @if (!SkillCatalog.Any(skill => skill.IsActive)) {
                        <Alert AlertStyle="AlertStyle.Warning" Class="mt-2">
                            Add skills on the workforce page or refresh these choices after another editor updates them.
                        </Alert>
                    }
                    else {
                        <Grid Gap="LayoutGap.Small" ColumnsMd="2" Class="mt-2">
                            @foreach (var skill in SkillCatalog.Where(item => item.IsActive).OrderBy(item => item.Category).ThenBy(item => item.Name)) {
                                <label class="rounded-[1rem] border border-chrome-200 bg-chrome-50/80 px-3 py-3 text-sm text-chrome-700">
                                    <input type="checkbox"
                                           checked="@Draft.SkillIds.Contains(skill.Id)"
                                           data-testid="crmhr-staffing-request-skill"
                                           @onchange="args => ToggleSkill(skill.Id, args)" />
                                    <span class="ml-2 font-medium text-chrome-900">@skill.Name</span>
                                    @if (!string.IsNullOrWhiteSpace(skill.Category))
                                    {
                                        <span class="ml-2 text-chrome-500">@skill.Category</span>
                                    }
                                </label>
                            }
                        </Grid>
                    }
                    @foreach (var id in Draft.SkillIds.Except(SkillCatalog.Where(skill => skill.IsActive).Select(skill => skill.Id))) {
                        <SurfaceCard Soft="true" data-testid="crmhr-staffing-request-unavailable-skill">
                            <Split Gap="LayoutGap.Small" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                                <TextBlock Value="@($"Unavailable skill ({id.ToString("N")[..8]})")" />
                                <Button Text="Remove unavailable skill" Tone="ButtonTone.Default" Size="ButtonSize.Small"
                                    Disabled="@(WritesDisabled || isSaving)" Click="@(() => RemoveUnavailableSkillAsync(id))"
                                    data-testid="crmhr-staffing-request-remove-unavailable-skill" />
                            </Split>
                        </SurfaceCard>
                    }
                </Stack>

                <FormField Text="Notes">
                    <NativeValueInput TValue="string" Multiline="true" @bind-Value="Draft.Notes" PendingChanged="@(_ => TextAsync(StaffingField.Notes))"
                                   class="form-input ui-input ui-input--outlined ui-input--textarea min-h-[7rem]"
                                   data-testid="crmhr-staffing-request-notes" />
                </FormField>
            </Stack>
        </EditForm>
        </ChildContent>
        <Footer>
            <Cluster Gap="LayoutGap.Small" JustifyContent="JustifyContent.End">
                <Button Text="Reset"
                        Tone="ButtonTone.Default"
                        Disabled="@(isSaving || WritesDisabled)"
                        Click="ResetEditorAsync"
                        data-testid="crmhr-staffing-request-reset-button" />
                <Button Text="@(Draft.Id.HasValue ? "Save changes" : "Save staffing request")"
                        Icon="save"
                        Disabled="@(isSaving || SaveDisabled || pending.Count > 0)"
                        IsBusy="@isSaving"
                        Click="HandleSaveAsync"
                        data-testid="crmhr-staffing-request-save-button" />
            </Cluster>
        </Footer>
    </Dialog>
}

@if (selectedRequest is not null)
{
    <Dialog IsOpen="true"
            Eyebrow="Staffing request"
            Title="@selectedRequest.Title"
            Subtitle="@ResolveProjectName(selectedRequest)"
            Size="ModalSize.Medium"
            DenseChrome="true"
            TestId="crmhr-staffing-request-details-dialog"
            OnClose="CloseDetailsAsync">
        <HeaderActions>
            <StatusBadge Tone="@ResolveStatusTone(selectedRequest.Status)"
                         Text="@selectedRequest.Status.ToString()" />
        </HeaderActions>
        <ChildContent>
            <Stack GapScale="LayoutGap.Medium">
                <Grid Gap="LayoutGap.Medium" ColumnsMd="3">
                    <SurfaceCard Soft="true">
                        <TextBlock TextStyle="TextStyle.EyebrowCaption">Needed role</TextBlock>
                        <p class="mt-1 text-sm font-semibold text-chrome-950">@FormatValue(selectedRequest.NeededRole)</p>
                    </SurfaceCard>
                    <SurfaceCard Soft="true">
                        <TextBlock TextStyle="TextStyle.EyebrowCaption">Allocation</TextBlock>
                        <p class="mt-1 text-sm font-semibold text-chrome-950">@($"{selectedRequest.AllocationPercent:0.##}%")</p>
                    </SurfaceCard>
                    <SurfaceCard Soft="true">
                        <TextBlock TextStyle="TextStyle.EyebrowCaption">Period</TextBlock>
                        <p class="mt-1 text-sm font-semibold text-chrome-950">@BuildPeriod(selectedRequest)</p>
                    </SurfaceCard>
                </Grid>

                <Grid Gap="LayoutGap.Medium" ColumnsMd="2">
                    <SurfaceCard Soft="true">
                        <TextBlock TextStyle="TextStyle.EyebrowCaption">Requested by</TextBlock>
                        <p class="mt-1 text-sm font-semibold text-chrome-950">@FormatValue(selectedRequest.RequestedByName)</p>
                    </SurfaceCard>
                    <SurfaceCard Soft="true">
                        <TextBlock TextStyle="TextStyle.EyebrowCaption">Delivery unit</TextBlock>
                        <p class="mt-1 text-sm font-semibold text-chrome-950">@FormatValue(selectedRequest.DeliveryUnitName)</p>
                    </SurfaceCard>
                </Grid>

                <SurfaceCard Soft="true">
                    <TextBlock TextStyle="TextStyle.EyebrowCaption">Needed skills</TextBlock>
                    @if (selectedRequest.NeededSkills.Count == 0)
                    {
                        <SmallText Text="No skills were specified." Class="mt-2" />
                    }
                    else
                    {
                        <Cluster Gap="LayoutGap.XSmall" Wrap="FlexWrap.Wrap" Class="mt-2">
                            @foreach (var skill in selectedRequest.NeededSkills)
                            {
                                <StatusBadge Tone="info" Text="@skill.Name" />
                            }
                        </Cluster>
                    }
                </SurfaceCard>

                @if (!string.IsNullOrWhiteSpace(selectedRequest.Notes))
                {
                    <SurfaceCard Soft="true">
                        <TextBlock TextStyle="TextStyle.EyebrowCaption">Notes</TextBlock>
                        <p class="mt-2 text-sm leading-6 text-chrome-700">@selectedRequest.Notes</p>
                    </SurfaceCard>
                }
            </Stack>
        </ChildContent>
        <Footer>
            <Cluster JustifyContent="JustifyContent.End">
                <Button Text="Close"
                        Tone="ButtonTone.Default"
                        Click="CloseDetailsAsync" />
            </Cluster>
        </Footer>
    </Dialog>
}

@code {
    protected override void OnParametersSet() {
        if (context is null || !ReferenceEquals(context.Model, Draft)) {
            context = new(Draft);
            pending.Clear();
        }
    }

    private EditContext context = default!;
    private readonly HashSet<StaffingField> pending = [];
    [Parameter] public bool SaveDisabled { get; set; }
    [Parameter] public bool WritesDisabled { get; set; }
    [Parameter] public string? StatusMessage { get; set; }
    [Parameter] public RenderFragment? Recovery { get; set; }
    [Parameter, EditorRequired] public Func<bool> HasChanges { get; set; } = default!;
    [Parameter, EditorRequired] public Func<Task<bool>> RequestDiscard { get; set; } = default!;
    [Parameter] public EventCallback<CanDoItAll.Editing.RecordInput<StaffingField>> InputChanged { get; set; }
    private Task TextAsync(StaffingField field) {


        return ReportAsync(field);
    }
    private Task ReportAsync(StaffingField field, bool incomplete = false) {
        if (incomplete) {
            pending.Add(field);
        } else {
            pending.Remove(field);
        }
        return InputChanged.InvokeAsync(new(field, incomplete));
    }
    private async Task ResetEditorAsync() {
        if (!WritesDisabled && !isSaving && (!HasChanges() || await RequestDiscard())) {
            await ResetRequest.InvokeAsync();
        }
    }

    [Parameter, EditorRequired]
    public string ProjectName { get; set; } = string.Empty;

    [Parameter]
    public bool CanCreate { get; set; } = true;

    [Parameter]
    public StaffingRequestEditorModel Draft { get; set; } = new();

    [Parameter]
    public IReadOnlyList<SkillCatalogItemModel> SkillCatalog { get; set; } = [];
    [Parameter] public EventCallback RefreshSkills { get; set; }
    [Parameter] public bool RefreshSkillsDisabled { get; set; }

    [Parameter]
    public IReadOnlyList<StaffingRequestItemModel> Requests { get; set; } = [];

    [Parameter]
    public int PageIndex { get; set; }

    [Parameter]
    public int PageSize { get; set; } = StaffingQueryLimits.DefaultPageSize;

    [Parameter]
    public int TotalCount { get; set; }

    [Parameter]
    public string SearchText { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> SearchTextChanged { get; set; }

    [Parameter]
    public StaffingRequestStatus? StatusFilter { get; set; }

    [Parameter]
    public EventCallback<StaffingRequestStatus?> StatusFilterChanged { get; set; }

    [Parameter]
    public EventCallback<int> PageChanged { get; set; }

    [Parameter, EditorRequired]
    public Func<Task<bool>> PrepareCreate { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<Task<bool>> SaveRequest { get; set; } = default!;

    [Parameter]
    public EventCallback ResetRequest { get; set; }

    [Parameter]
    public EventCallback<StaffingRequestItemModel> DeleteRequest { get; set; }

    private StaffingRequestItemModel? selectedRequest;
    private bool isEditorOpen;
    private bool isPreparingCreate;
    private bool isSaving;

    private bool CanOpenCreate => CanCreate
        && !string.IsNullOrWhiteSpace(ProjectName)
        && !isPreparingCreate;

    private string ProjectContextText => string.IsNullOrWhiteSpace(ProjectName)
        ? "Choose a project to create and review staffing demand."
        : $"{ProjectName} · {TotalCount} request(s)";

    private int TotalPages => TotalCount == 0
        ? 0
        : (int)Math.Ceiling(TotalCount / (double)PageSize);

    private string PageText => TotalPages == 0
        ? "No pages"
        : $"Page {PageIndex + 1:N0} of {TotalPages:N0} · {TotalCount:N0} request(s)";

    private string CreateTooltipText => CanCreate && !string.IsNullOrWhiteSpace(ProjectName)
        ? "Create a staffing request"
        : "Choose a project before creating a staffing request";

    private string EmptyStateEyebrow => string.IsNullOrWhiteSpace(ProjectName)
        ? "No project selected"
        : !HasActiveFilters
            ? "No staffing requests"
            : "No matching requests";

    private string EmptyStateTitle => string.IsNullOrWhiteSpace(ProjectName)
        ? "Choose a project to review demand"
        : !HasActiveFilters
            ? "Capture the first request"
            : "Adjust the staffing filters";

    private string EmptyStateDescription => string.IsNullOrWhiteSpace(ProjectName)
        ? "The project selector remains available above the workspace tabs."
        : !HasActiveFilters
            ? "Open requests appear here once the selected project starts requesting staffing."
            : "No staffing requests match the current search text and status.";

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(SearchText) ||
        StatusFilter.HasValue;

    private Task HandleSearchInputAsync(ChangeEventArgs args)
    {
        return SearchTextChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    }

    private Task HandleStatusFilterChangedAsync(StaffingRequestStatus? status)
    {
        return StatusFilterChanged.InvokeAsync(status);
    }

    private async Task HandleRequestedByChanged(Guid? partyId)
    {
        Draft.RequestedByPartyId = partyId;
        context.NotifyFieldChanged(new(Draft, nameof(Draft.RequestedByPartyId)));
        await ReportAsync(StaffingField.Requester, pending.Contains(StaffingField.Requester));
    }

    private async Task HandleDeliveryUnitChanged(Guid? partyId)
    {
        Draft.DeliveryUnitPartyId = partyId;
        context.NotifyFieldChanged(new(Draft, nameof(Draft.DeliveryUnitPartyId)));
        await ReportAsync(StaffingField.DeliveryUnit, pending.Contains(StaffingField.DeliveryUnit));
    }

    private async Task OpenCreateAsync()
    {
        if (!CanOpenCreate)
        {
            return;
        }

        isPreparingCreate = true;
        try
        {
            if (await PrepareCreate())
            {
                isEditorOpen = true;
            }
        }
        finally
        {
            isPreparingCreate = false;
        }
    }

    private async Task CloseEditorAsync() {
        if (isSaving) {
            return;
        }
        if (HasChanges()) {
            if (!await RequestDiscard()) {
                return;
            }
            await ResetRequest.InvokeAsync();
        }
        isEditorOpen = false;
    }

    private async Task HandleSaveAsync()
    {
        if (isSaving || SaveDisabled || pending.Count > 0 || !context.Validate())
        {
            return;
        }

        isSaving = true;
        try
        {
            if (await SaveRequest() && !HasChanges() && pending.Count == 0)
            {
                isEditorOpen = false;
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ShowDetails(StaffingRequestItemModel request)
    {
        selectedRequest = request;
    }

    private Task CloseDetailsAsync()
    {
        selectedRequest = null;
        return Task.CompletedTask;
    }

    private async Task ToggleSkill(Guid skillId, ChangeEventArgs args) {
        var selected = bool.TryParse(args.Value?.ToString(), out var value) && value;
        if (selected && !Draft.SkillIds.Contains(skillId)) {
            Draft.SkillIds.Add(skillId);
        } else if (!selected) {
            Draft.SkillIds.Remove(skillId);
        }
        await ReportAsync(StaffingField.Skills);
    }
    private Task RemoveUnavailableSkillAsync(Guid skillId) => Draft.SkillIds.Remove(skillId)
        ? ReportAsync(StaffingField.Skills) : Task.CompletedTask;

    private static string BuildMeta(StaffingRequestItemModel request)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(request.NeededRole))
        {
            parts.Add(request.NeededRole);
        }

        if (request.StartDate.HasValue || request.EndDate.HasValue)
        {
            parts.Add(BuildPeriod(request));
        }

        if (!string.IsNullOrWhiteSpace(request.RequestedByName))
        {
            parts.Add($"Requested by {request.RequestedByName}");
        }

        if (!string.IsNullOrWhiteSpace(request.DeliveryUnitName))
        {
            parts.Add($"Delivery unit {request.DeliveryUnitName}");
        }

        return parts.Count == 0 ? "No request metadata" : string.Join(" · ", parts);
    }

    private static string BuildPeriod(StaffingRequestItemModel request)
    {
        return $"{FormatDate(request.StartDate)} → {FormatDate(request.EndDate)}";
    }

    private string ResolveProjectName(StaffingRequestItemModel request)
    {
        if (!string.IsNullOrWhiteSpace(request.ProjectName))
        {
            return request.ProjectName;
        }

        return string.IsNullOrWhiteSpace(ProjectName) ? "Unassigned project" : ProjectName;
    }

    private static string ResolveStatusTone(StaffingRequestStatus status)
    {
        return status switch
        {
            StaffingRequestStatus.Confirmed => "success",
            StaffingRequestStatus.Open => "primary",
            StaffingRequestStatus.Proposed => "info",
            StaffingRequestStatus.Cancelled => "danger",
            StaffingRequestStatus.Closed => "base",
            _ => "warning"
        };
    }

    private static string FormatValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Not set" : value;
    }

    private static string FormatDate(DateOnly? value)
    {
        return value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "Open";
    }
}

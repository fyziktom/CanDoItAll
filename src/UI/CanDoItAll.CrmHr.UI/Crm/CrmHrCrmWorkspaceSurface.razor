@namespace CanDoItAll.CrmHr.UI.Crm
@inherits CrmHrWorkspaceSurface<ICrmHrCrmWorkspaceView>

<PageScaffold MaxWidthClass="max-w-full">
    <Header>
        <PageHeader Eyebrow="CRM / HR"
                    Title="CRM workspace"
                    Description="Review shared customer, partner, and vendor accounts, keep company connections explicit, and log follow-ups before they disappear into side channels."
                    Compact="true">
            <Stats>
                <CompactStat Label="accounts"
                             Value="@View.AccountCount.ToString()"
                             TooltipText="Active organization records in the shared directory." />
                <CompactStat Label="selection"
                             Value="@(View.SelectedAccount is null ? "None" : "Active")"
                             TooltipText="Current account workspace selection."
                             Tone="info" />
            </Stats>
            <Actions>
                <PageHeaderActionButton Icon="smart_toy"
                                        Label="Agent chats"
                                        TooltipText="Open the global agent catalog with the current CRM selection as context."
                                        Tone="ButtonTone.Primary"
                                        Click="View.OpenAgentChats"
                                        data-testid="crmhr-crm-agent-chats" />
                <PageHeaderActionButton Icon="asset"
                                        Label="Open directory"
                                        TooltipText="Open the shared party directory."
                                        Click="View.OpenDirectory" />
            </Actions>
        </PageHeader>
    </Header>

    <ChildContent>
        <Stack GapScale="LayoutGap.Medium" @oninput="DirtyChanged" @onchange="DirtyChanged">
            @SecondaryNavigation

            <SurfaceCard data-testid="crmhr-crm-catalog">
                <Stack GapScale="LayoutGap.Medium">
                    <ListPanelHeader Title="Accounts"
                                     Description="Search and page through customer, partner, and vendor organizations. Open a card to manage the complete CRM workspace."
                                     Count="Server-paged" />
                    <PartyRecordBrowser RefreshVersion="@CatalogRefreshVersion" AllowedScope="PartyRecordScope.Organizations"
                                        InitialScope="PartyRecordScope.Organizations"
                                        SelectedPartyId="View.SelectedAccount?.AccountPartyId"
                                        SelectionChanged="View.SelectAccountAsync"
                                        Query="@View.CatalogQuery"
                                        QueryChanged="View.HandleCatalogQueryChangedAsync"
                                        LoadFailed="View.HandleAccountBrowserLoadFailedAsync"
                                        PageSize="12"
                                        ResultsScrollMode="PagedRecordResultsScrollMode.Bounded"
                                        GridMode="PagedRecordGridMode.BoundedCatalog"
                                        SearchPlaceholder="Search account name, code, summary, or tag"
                                        DataTestId="crmhr-account"
                                        OptionTestId="crmhr-account-item" />
                </Stack>
            </SurfaceCard>

            @if (View.IsAccountDialogOpen && View.SelectedAccount is not null)
            {
                <Dialog IsOpen="true"
                        Eyebrow="CRM account"
                        Title="@View.SelectedAccount.DisplayName"
                        Subtitle="Relationship profile, financials, connected records, interactions, and opportunities."
                        Size="ModalSize.Full"
                        DenseChrome="true"
                        CloseOnBackdrop="false"
                        TestId="crmhr-crm-record-dialog"
                        OnClose="View.CloseAccountDialogAsync">
                    <ChildContent>
                        @AccountSummary
                        @ProfileEditing
                        @EditorOverlays

                        <Tabs SelectedIndex="@View.SelectedCrmRecordTabIndex"
                              SelectedIndexChanged="View.HandleCrmRecordTabChanged"
                              RenderMode="TabRenderMode.Server"
                              Density="TabsDensity.Compact"
                              BorderMode="TabsBorderMode.Soft"
                              OverflowMode="TabsOverflowMode.Wrap"
                              AriaLabel="CRM account sections"
                              data-testid="crmhr-crm-tabs">
                            <TabItems>
                                <TabsItem Text="Overview"
                                          Icon="dashboard"
                                          data-testid="crmhr-crm-tab-overview">
                            <EditForm EditContext="ProfileContext()" OnValidSubmit="View.SaveAccountProfileAsync">
                                <FormSection Title="Relationship profile"
                                             Description="Keep prospect conversion, commercial context, and timing risk on the same account record instead of scattering it across notes.">
                                    <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                        <FormField Text="Relationship stage">
                                            <SelectInput @bind-Value="View.ProfileEditor.RelationshipStage"
                                                         @bind-Value:after="@(() => ProfileInputChanged.InvokeAsync(AccountProfileField.RelationshipStage))"
                                                         class="form-input ui-input ui-input--outlined"
                                                         data-testid="crmhr-account-stage">
                                                @foreach (var stage in Enum.GetValues<CrmAccountRelationshipStage>())
                                                {
                                                    <option value="@stage">@stage</option>
                                                }
                                            </SelectInput>
                                        </FormField>
                                        <div class="rounded-[1.25rem] border border-chrome-200 bg-chrome-50/80 px-4 py-4">
                                            <TextBlock TextStyle="TextStyle.EyebrowCaption">Current scope</TextBlock>
                                            <p class="mt-2 text-sm leading-6 text-chrome-700">
                                                Account context, connected people, follow-up history, opportunity progression, and recognized sold value stay grounded on the shared party record.
                                            </p>
                                        </div>
                                    </Grid>

                                    <Grid Gap="LayoutGap.Large" ColumnsMd="3" Class="mt-5">
                                        <FormField Text="Commercial notes">
                                            <NativeValueInput aria-label="Commercial notes" TValue="string" Multiline="true" @bind-Value="View.ProfileEditor.CommercialNotes" PendingChanged="@(_ => SetProfileTextAsync(AccountProfileField.CommercialNotes))"
                                                           class="form-input ui-input ui-input--outlined ui-input--textarea min-h-[9rem]"
                                                           data-testid="crmhr-account-commercial-notes" />
                                        </FormField>
                                        <FormField Text="Constraints">
                                            <NativeValueInput aria-label="Constraints" TValue="string" Multiline="true" @bind-Value="View.ProfileEditor.ConstraintNotes" PendingChanged="@(_ => SetProfileTextAsync(AccountProfileField.ConstraintNotes))"
                                                           class="form-input ui-input ui-input--outlined ui-input--textarea min-h-[9rem]"
                                                           data-testid="crmhr-account-constraints" />
                                        </FormField>
                                        <FormField Text="Timing risks">
                                            <NativeValueInput aria-label="Timing risks" TValue="string" Multiline="true" @bind-Value="View.ProfileEditor.TimingRiskNotes" PendingChanged="@(_ => SetProfileTextAsync(AccountProfileField.TimingRiskNotes))"
                                                           class="form-input ui-input ui-input--outlined ui-input--textarea min-h-[9rem]"
                                                           data-testid="crmhr-account-timing-risks" />
                                        </FormField>
                                    </Grid>

                                    <Cluster Gap="LayoutGap.Small" Class="mt-5">
                                        <Button Text="Save CRM profile"
                                                Disabled="@ProfileSaveDisabled"
                                                data-testid="crmhr-account-save-button"
                                                Type="submit" />
                                        <Button Text="Open directory record"
                                                Tone="ButtonTone.Default"
                                                Click="View.OpenDirectory" />
                                    </Cluster>
                                </FormSection>
                            </EditForm>
                                </TabsItem>

                                <TabsItem Text="Financials"
                                          Icon="monitoring"
                                          data-testid="crmhr-crm-tab-financials">
                                    @Financials
                                </TabsItem>

                                <TabsItem Text="Connected records"
                                          Icon="hub"
                                          data-testid="crmhr-crm-tab-connections">
                            @if (ConnectionsValidationMessage is not null) {
                                <Alert AlertStyle="AlertStyle.Warning" data-testid="crmhr-connections-validation"><TextBlock Value="@ConnectionsValidationMessage" /></Alert>
                            }
                            @if (ConnectionsMessage is not null) {
                                <Alert AlertStyle="ConnectionsMessageStyle" data-testid="crmhr-connections-outcome"><TextBlock Value="@ConnectionsMessage" /></Alert>
                            }
                            @ConnectionsEditing
                            <EditForm EditContext="ConnectionsContext()" OnValidSubmit="View.SaveConnectedRecordsAsync" data-testid="crmhr-connections-form">
                            <FormSection Title="Connected records"
                                         Description="Connect the people and other directory records you communicate or cooperate with at this company, then optionally scope each connection to related projects.">
                                <Split Gap="LayoutGap.Medium"
                                       AlignItems="AlignItems.Center"
                                       JustifyContent="JustifyContent.SpaceBetween">
                                    <div>
                                        <TextBlock TextStyle="TextStyle.EyebrowCaption">Company relationship map</TextBlock>
                                        <p class="mt-1 text-sm leading-6 text-chrome-600">Use typed relationship roles for employees, contacts, sponsors, partners, and delivery participants. Project links are optional.</p>
                                    </div>
                                    <Button Text="Add connection"
                                            Tone="ButtonTone.Default"
                                            Size="ButtonSize.Small"
                                            Click="View.AddConnectedRecord"
                                            data-testid="crmhr-connection-add" />
                                </Split>

                                @if (View.ConnectedRecordEditors.Count == 0)
                                {
                                    <div class="mt-5 rounded-[1.25rem] border border-dashed border-chrome-300 bg-chrome-50/70 px-4 py-4 text-sm leading-6 text-chrome-600">
                                        No connected records saved yet. Add a person or another directory record associated with this company.
                                    </div>
                                }
                                else
                                {
                                    <Stack GapScale="LayoutGap.Medium"
                                           AlignItems="AlignItems.Stretch"
                                           Class="mt-5">
                                        @for (var index = 0; index < View.ConnectedRecordEditors.Count; index++)
                                        {
                                            var rowIndex = index;
                                            var connection = View.ConnectedRecordEditors[index];
                                            <PanelCard @key="connection" Soft="true">
                                                <Grid Gap="LayoutGap.Medium" ColumnsLg="4">
                                                    <div class="lg:col-span-2">
                                                        <label class="cda-form-field__label">Connected directory record</label>
                                                        <SurfaceCard Soft="true">
                                                            <Split Breakpoint="LayoutBreakpoint.None"
                                                                   Gap="LayoutGap.Medium"
                                                                   AlignItems="AlignItems.Center"
                                                                   JustifyContent="JustifyContent.SpaceBetween"
                                                                   Wrap="FlexWrap.Wrap">
                                                                <TextBlock TextStyle="TextStyle.Note"
                                                                           Value="@View.ResolveConnectionPartyLabel(connection.RelatedPartyId)" />
                                                                <Cluster Gap="LayoutGap.Small">
                                                                    @if (connection.RelatedPartyId != Guid.Empty)
                                                                    {
                                                                        <Button Text="Clear"
                                                                                Tone="ButtonTone.Default"
                                                                                Size="ButtonSize.Small"
                                                                            Click="@(() => ConnectionAction(connection, View.ClearConnectionParty))"
                                                                                data-testid="@($"crmhr-connection-party-clear-{rowIndex}")" />
                                                                    }
                                                                    <Button Text="Choose record"
                                                                            Icon="search"
                                                                            Size="ButtonSize.Small"
                                                                            Click="@(() => ConnectionAction(connection, View.OpenConnectionPartyPicker))"
                                                                            data-testid="@($"crmhr-connection-party-{rowIndex}")" />
                                                                </Cluster>
                                                            </Split>
                                                        </SurfaceCard>
                                                    </div>
                                                    <FormField Text="Relationship role">
                                                        <SelectInput @bind-Value="connection.Role"
                                                                     @bind-Value:after="@(() => ConnectionsInputChanged.InvokeAsync(new(connection, ConnectionField.Role)))"
                                                                     class="form-input ui-input ui-input--outlined"
                                                                     data-testid="@($"crmhr-connection-role-{rowIndex}")">
                                                            @foreach (var role in Enum.GetValues<CrmAccountConnectionRole>())
                                                            {
                                                                <option value="@role">@CrmHrCrmWorkspacePresentation.FormatConnectionRole(role)</option>
                                                            }
                                                        </SelectInput>
                                                    </FormField>
                                                    <div class="flex items-end justify-end">
                                                        <Button Text="Remove"
                                                                Tone="ButtonTone.Danger"
                                                                Size="ButtonSize.Small"
                                                                Click="@(() => ConnectionAction(connection, View.RemoveConnectedRecord))"
                                                                data-testid="@($"crmhr-connection-remove-{rowIndex}")" />
                                                    </div>
                                                </Grid>

                                                <div class="mt-4">
                                                    <ProjectMultiPicker SelectedProjectIds="@connection.ProjectIds"
                                                                        SelectedProjectIdsChanged="@(projectIds => SelectConnectionProjectsAsync(connection, projectIds))"
                                                                        PendingChanged="ConnectionsPickerChanged"
                                                                        TestIdPrefix="@($"crmhr-connection-projects-{rowIndex}")" />
                                                </div>

                                                <Grid Gap="LayoutGap.Medium" ColumnsLg="3" Class="mt-4">
                                                    <div class="lg:col-span-2">
                                                        <FormField Text="Relationship notes">
                                                            <NativeValueInput aria-label="Relationship notes" TValue="string" @bind-Value="connection.Notes" PendingChanged="@(_ => SetConnectionNotesAsync(connection))"
                                                                       class="form-input ui-input ui-input--outlined"
                                                                       data-testid="@($"crmhr-connection-notes-{rowIndex}")" />
                                                        </FormField>
                                                    </div>
                                                    <div class="flex items-end gap-3">
                                                        <InputCheckbox @bind-Value="connection.IsPrimary"
                                                                       @bind-Value:after="@(() => ConnectionsInputChanged.InvokeAsync(new(connection, ConnectionField.Primary)))"
                                                                       data-testid="@($"crmhr-connection-primary-{rowIndex}")" />
                                                        <label class="text-sm text-chrome-700">Primary for this role</label>
                                                    </div>
                                                </Grid>
                                            </PanelCard>
                                        }
                                    </Stack>
                                }

                                <Cluster Gap="LayoutGap.Small" Class="mt-5">
                                    <Button Text="Save connected records"
                                            Type="submit" Disabled="ConnectionsSaveDisabled"
                                            data-testid="crmhr-connection-save-button" />
                                </Cluster>
                            </FormSection>
                            </EditForm>
                                </TabsItem>

                                <TabsItem Text="Interactions"
                                          Icon="forum"
                                          data-testid="crmhr-crm-tab-interactions">
                                    <Stack GapScale="LayoutGap.Large">
                            <Grid Gap="LayoutGap.Large" ColumnsLg="2">
                                @if (View.AccountActivityFailureMessage is { } accountActivityFailure)
                                {
                                    <SurfaceCard Soft="true" data-testid="crmhr-account-activity-error">
                                        <TextBlock TextStyle="TextStyle.EyebrowCaption" Class="text-[var(--tone-danger-soft-fg)]">Account activity unavailable</TextBlock>
                                        <p class="mt-2 text-sm leading-6 text-chrome-700">@accountActivityFailure</p>
                                        <Button Text="Retry"
                                                Icon="refresh"
                                                Tone="ButtonTone.Default"
                                                Size="ButtonSize.Small"
                                                Class="mt-4"
                                                Click="View.RetryAccountActivityAsync" />
                                    </SurfaceCard>
                                }
                                else
                                {
                                    @ActivityTimeline
                                }

                                <SurfaceCard Soft="true">
                                    <TextBlock TextStyle="TextStyle.EyebrowCaption">Next actions</TextBlock>
                                    <h3 class="mt-1 text-lg font-semibold text-chrome-950">Follow-up pressure</h3>
                                    <p class="mt-4 text-sm leading-6 text-chrome-600">
                                        Counts cover the complete account history while the timeline renders only the active page.
                                    </p>
                                    <Cluster Gap="LayoutGap.Small" Class="mt-4">
                                        @if (View.AccountActivityPresentation.Accepted is { } acceptedActivity)
                                        {
                                            <StatusBadge Tone="info"
                                                         Text="@($"{acceptedActivity.ActionCount:N0} open follow-ups")"
                                                         data-testid="crmhr-account-action-count" />
                                            <StatusBadge Tone="@(acceptedActivity.OverdueActionCount > 0 ? "danger" : "success")"
                                                         Text="@($"{acceptedActivity.OverdueActionCount:N0} overdue")"
                                                         data-testid="crmhr-account-overdue-count" />
                                        }
                                        else
                                        {
                                            @* Nothing accepted for this account yet: no count is claimed and no tone reassures. *@
                                            <StatusBadge Tone="neutral"
                                                         Text="@(View.AccountActivityPresentation.IsLoading ? "Follow-up counts load with the history" : "Follow-up counts unavailable")"
                                                         data-testid="crmhr-account-activity-counts-unavailable" />
                                        }
                                    </Cluster>
                                </SurfaceCard>
                            </Grid>

                            <InteractionJournalEditor @key="View.InteractionEditor" Model="View.InteractionEditor" SelectedOpportunity="View.SelectedOpportunity"
                                ParticipantOptions="View.ParticipantOptions" OwnerOptions="View.SelectedAccount.ConnectedParties"
                                InputChanged="InteractionInputChanged" Submit="View.SaveInteractionAsync" Message="@InteractionMessage" Disabled="InteractionSaveDisabled"
                                Unknown="InteractionOutcomeUnknown" PartyLabel="View.ResolveConnectionPartyLabel" />
                                    </Stack>
                                </TabsItem>

                                <TabsItem Text="Opportunities"
                                          Icon="trending_up"
                                          data-testid="crmhr-crm-tab-opportunities">
                                    <OpportunityPipeline AccountPartyId="View.SelectedAccount.AccountPartyId"
                                                         SelectedOpportunityId="View.SelectedOpportunityId"
                                                         RefreshVersion="View.OpportunityPipelineRefreshVersion"
                                                         AddOpportunity="View.OpenOpportunityCreateDialog"
                                                         SelectOpportunity="View.SelectOpportunityAsync"
                                                         AdvanceOpportunityStage="View.AdvanceOpportunityStageAsync"
                                                         LoadFailed="View.HandleOpportunityPipelineLoadFailedAsync" />
                                </TabsItem>
                            </TabItems>
                        </Tabs>

                        @* The account record owns its opportunity and connection overlays. Rendered inside it they open above it even
                           when one render opens both (a deep link, a board card), and they close with the record. *@
                        <OpportunityCreateDialog IsOpen="@View.IsOpportunityCreateDialogOpen"
                            Opening="OpportunityOpening" SaveDisabled="OpportunitySaveDisabled" Editing="OpportunityEditing"
                            InputChanged="OpportunityInputChanged" PickerChanged="OpportunityPickerChanged" ProjectSelected="OpportunityProjectSelected"
                                                 InitialModel="View.OpportunityEditor"
                                                 AccountDisplayName="@(View.SelectedAccount?.DisplayName ?? string.Empty)"
                                                 RelationshipStageLabel="@View.ProfileEditor.RelationshipStage.ToString()"
                                                 IsBusy="View.IsOpportunityBusy"
                                                 Message="@(View.IsOpportunityCreateDialogOpen ? View.Message : null)"
                                                 Save="View.SaveOpportunityAsync"
                                                 Close="View.CloseOpportunityCreateDialogAsync"
                                                 LoadFailed="View.HandleOpportunityPickerLoadFailedAsync" />

                        <OpportunityDetailDialog IsOpen="@View.IsOpportunityDetailDialogOpen"
                                                 Opportunity="View.SelectedOpportunity"
                                                 Close="View.CloseOpportunityDetailDialogAsync"
                                                 Edit="View.OpenOpportunityEditDialog"
                                                 Convert="View.OpenConversionDialogAsync"
                                                 OpenLinkedProject="View.OpenLinkedProjectAsync" />

                        <OpportunityEditDialog IsOpen="@View.IsOpportunityEditDialogOpen"
                            Opening="OpportunityOpening" SaveDisabled="OpportunitySaveDisabled" Editing="OpportunityEditing"
                            InputChanged="OpportunityInputChanged" PickerChanged="OpportunityPickerChanged" ProjectSelected="OpportunityProjectSelected" Model="View.OpportunityEditor"
                                               Opportunity="View.SelectedOpportunity"
                                               IsBusy="View.IsOpportunityBusy"
                                               Message="@(View.IsOpportunityEditDialogOpen ? View.Message : null)"
                                               Save="View.SaveOpportunityAsync"
                                               Close="View.CloseOpportunityEditDialogAsync"
                                               LoadFailed="View.HandleOpportunityPickerLoadFailedAsync" />

                        <OpportunityConversionDialog @key="ConversionOpening" IsOpen="@View.IsOpportunityConversionDialogOpen"
                                                     Opening="ConversionOpening" SaveDisabled="ConversionSaveDisabled"
                                                     InputChanged="ConversionInputChanged" PickerChanged="ConversionPickerChanged"
                                                     ProjectSelected="ConversionProjectSelected"
                                                     Editing="ConversionEditing"
                                                     DatabaseProfileId="@View.ProjectDatabaseProfileId"
                                                     Opportunity="ConversionBasis"
                                                     Model="View.OpportunityConversionEditor"
                                                     IsBusy="View.IsOpportunityConversionBusy"
                                                     Message="@(View.IsOpportunityConversionDialogOpen ? View.Message : null)"
                                                     Close="View.CloseOpportunityConversionDialogAsync"
                                                     Save="View.SaveOpportunityConversionAsync"
                                                     LoadFailed="View.HandleOpportunityPickerLoadFailedAsync" />

                        <PartyRecordPickerDialog IsOpen="@View.ConnectionPartyPickerIndex.HasValue"
                                                 SelectedPartyId="@View.SelectedConnectionPartyId"
                                                 ExcludedPartyId="View.SelectedAccount?.AccountPartyId"
                                                 SelectionConfirmed="View.ConfirmConnectionPartyAsync"
                                                 OnClose="View.CloseConnectionPartyPickerAsync"
                                                 LoadFailed="View.HandleOpportunityPickerLoadFailedAsync"
                                                 Eyebrow="Connected records"
                                                 Title="Choose a directory record"
                                                 Subtitle="Search people, organizations, units, and AI agents that have a relationship with this company."
                                                 DataTestId="crmhr-connection-party-picker" />
                    </ChildContent>
                    <Footer>
                        <Split Breakpoint="LayoutBreakpoint.None"
                               Gap="LayoutGap.Medium"
                               AlignItems="AlignItems.Center"
                               JustifyContent="JustifyContent.SpaceBetween"
                               Wrap="FlexWrap.Wrap">
                            <Button Text="Open directory record"
                                    Tone="ButtonTone.Default"
                                    Click="View.OpenDirectory" />
                            <Button Text="Close"
                                    Tone="ButtonTone.Default"
                                    Click="View.CloseAccountDialogAsync"
                                    data-testid="crmhr-crm-record-close" />
                        </Split>
                    </Footer>
                </Dialog>
            }
        </Stack>
    </ChildContent>
</PageScaffold>

@code {
    private EditContext? profileContext;
    private EditContext? connectionsContext;
    [Parameter] public EventCallback<ConnectionFieldInput> ConnectionsInputChanged { get; set; }
    [Parameter] public EventCallback<ConnectionProjectSelection> ConnectionsProjectSelected { get; set; }
    [Parameter] public EventCallback<bool> ConnectionsPickerChanged { get; set; }
    [Parameter] public RenderFragment? ConnectionsEditing { get; set; }
    [Parameter] public string? ConnectionsValidationMessage { get; set; }
    [Parameter] public string? ConnectionsMessage { get; set; }
    [Parameter] public AlertStyle ConnectionsMessageStyle { get; set; } = AlertStyle.Info;
    [Parameter] public bool ConnectionsSaveDisabled { get; set; }
    [Parameter] public EventCallback InteractionInputChanged { get; set; }
    [Parameter] public string? InteractionMessage { get; set; }
    [Parameter] public bool InteractionSaveDisabled { get; set; }
    [Parameter] public bool InteractionOutcomeUnknown { get; set; }
    [Parameter] public RenderFragment? OpportunityEditing { get; set; }
    [Parameter] public long OpportunityOpening { get; set; }
    [Parameter] public bool OpportunitySaveDisabled { get; set; }
    [Parameter] public long ConversionOpening { get; set; }
    [Parameter] public bool ConversionSaveDisabled { get; set; }
    [Parameter] public EventCallback ConversionInputChanged { get; set; }
    [Parameter] public EventCallback<bool> ConversionPickerChanged { get; set; }
    [Parameter] public EventCallback<ProjectRecordPickerSelection> ConversionProjectSelected { get; set; }
    [Parameter] public RenderFragment? ConversionEditing { get; set; }
    [Parameter] public CrmOpportunityDetailModel? ConversionBasis { get; set; }
    [Parameter] public EventCallback<OpportunityInput> OpportunityInputChanged { get; set; }
    [Parameter] public EventCallback<bool> OpportunityPickerChanged { get; set; }
    [Parameter] public EventCallback<Guid> OpportunityProjectSelected { get; set; }
    [Parameter] public long CatalogRefreshVersion { get; set; }
    [Parameter] public bool ProfileSaveDisabled { get; set; }
    [Parameter] public RenderFragment? ProfileEditing { get; set; }
    [Parameter] public RenderFragment? EditorOverlays { get; set; }
    [Parameter] public EventCallback<AccountProfileField> ProfileInputChanged { get; set; }
    [Parameter] public EventCallback DirtyChanged { get; set; }
    private EditContext ProfileContext() => ContextFor(ref profileContext, View.ProfileEditor);
    private EditContext ConnectionsContext() => ContextFor(ref connectionsContext, View.ConnectedRecordEditors);

    private Task SetConnectionNotesAsync(CrmAccountConnectionEditorModel row) {
        if (!View.ConnectedRecordEditors.Contains(row)) {
            return Task.CompletedTask;
        }

        return ConnectionsInputChanged.InvokeAsync(new(row, ConnectionField.Notes));
    }

    private void ConnectionAction(CrmAccountConnectionEditorModel row, Action<int> action) {
        var index = View.ConnectedRecordEditors.IndexOf(row);
        if (index >= 0) {
            action(index);
        }
    }

    private Task SelectConnectionProjectsAsync(CrmAccountConnectionEditorModel row, IReadOnlyList<Guid> ids) {
        var index = View.ConnectedRecordEditors.IndexOf(row);
        return index < 0 ? Task.CompletedTask : ConnectionsProjectSelected.HasDelegate
            ? ConnectionsProjectSelected.InvokeAsync(new(row, ids)) : View.UpdateConnectedRecordProjects(index, ids);
    }

    private Task SetProfileTextAsync(AccountProfileField field) => ProfileInputChanged.InvokeAsync(field);
    // Host-owned region: the host composes its adapter here.
    [Parameter]
    public RenderFragment? AccountSummary { get; set; }

    // Host-owned region: the host composes its adapter here.
    [Parameter]
    public RenderFragment? Financials { get; set; }

    // Host-owned region: the host composes its adapter here.
    [Parameter]
    public RenderFragment? ActivityTimeline { get; set; }
}

@using CanDoItAll.Modules.Projects
@implements IDisposable

@if (IsOpen && Opportunity is not null)
{
    <Dialog IsOpen="true"
            Title="Convert won opportunity"
            Eyebrow="CRM / HR"
            Subtitle="Create a project or attach an existing Projects-owned record while preserving the opportunity handoff."
            Size="ModalSize.Wide"
            DenseChrome="true"
            CloseOnBackdrop="false"
            TestId="crmhr-opportunity-conversion-dialog"
            OnClose="HandleCloseAsync">
        <ChildContent>
            <EditForm EditContext="context" OnSubmit="@(_ => HandleSaveAsync())" id="crmhr-opportunity-conversion-form">
            <Stack GapScale="LayoutGap.Large" AlignItems="AlignItems.Stretch">
                @if (Editing is null && !string.IsNullOrWhiteSpace(Message))
                {
                    <PanelCard Soft="true"
                               data-testid="crmhr-opportunity-conversion-message">
                        <TextBlock TextStyle="TextStyle.Body1"
                                   Value="@Message" />
                    </PanelCard>
                }

                @Editing

                <Grid Gap="LayoutGap.Large"
                      ColumnsLg="2">
                    <FormSection Title="Opportunity"
                                 Description="The won opportunity remains the durable CRM record.">
                        <ChildContent>
                            <Stack GapScale="LayoutGap.Small">
                                <TextBlock TextStyle="TextStyle.Subtitle2"
                                           Value="@Opportunity.Title" />
                                <SmallText Text="@($"{Opportunity.AccountDisplayName} · {Opportunity.OpportunitySource} · {Opportunity.Stage}")" />
                                @if (!string.IsNullOrWhiteSpace(Opportunity.Summary))
                                {
                                    <TextBlock TextStyle="TextStyle.Body1"
                                               Value="@Opportunity.Summary" />
                                }
                                <StatusBadge Tone="success"
                                             Text="@ResolveValueLabel(Opportunity)" />
                            </Stack>
                        </ChildContent>
                    </FormSection>

                    <FormSection Title="Project target"
                                 Description="Choose an existing project with a paged query or create a new delivery record.">
                        <ChildContent>
                            <Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch" Class="w-full">
                                <label class="flex items-center gap-3 text-sm font-medium text-slate-700">
                                    <InputCheckbox @bind-Value="draft.LinkExistingProject" @bind-Value:after="InputChanged.InvokeAsync"
                                                   data-testid="crmhr-opportunity-conversion-link-existing" />
                                    <span>Link an existing project</span>
                                </label>

                                @if (draft.LinkExistingProject)
                                {
                                    <PanelCard Soft="true">
                                        <Split Breakpoint="LayoutBreakpoint.None"
                                               Gap="LayoutGap.Medium"
                                               AlignItems="AlignItems.Center"
                                               JustifyContent="JustifyContent.SpaceBetween"
                                               Wrap="FlexWrap.Wrap">
                                            <Stack GapScale="LayoutGap.XSmall">
                                                <SmallText Text="Existing project" />
                                                <TextBlock TextStyle="TextStyle.Subtitle2"
                                                           Value="@ResolveExistingProjectLabel()" />
                                            </Stack>
                                            <Cluster Gap="LayoutGap.Small">
                                                @if (draft.ExistingProjectId.HasValue)
                                                {
                                                    <Button Text="Clear"
                                                            ButtonStyle="ButtonStyle.Light"
                                                            Size="ButtonSize.Small"
                                                            Click="ClearExistingProject"
                                                            data-testid="crmhr-opportunity-conversion-project-clear" />
                                                }
                                                <Button Text="Select project"
                                                        Icon="folder_open"
                                                        ButtonStyle="ButtonStyle.Light"
                                                        Size="ButtonSize.Small"
                                                        Click="OpenProjectPicker"
                                                        data-testid="crmhr-opportunity-conversion-project" />
                                            </Cluster>
                                        </Split>
                                    </PanelCard>
                                }
                                else
                                {
                                    <Stack GapScale="LayoutGap.XSmall" AlignItems="AlignItems.Stretch">
                                        <label class="cda-field-label">Project name</label>
                                        <NativeValueInput TValue="string" @bind-Value="draft.ProjectName" @bind-Value:after="InputChanged.InvokeAsync" PendingChanged="@(_ => SetTextAsync())"
                                                   class="cda-input w-full"
                                                   data-testid="crmhr-opportunity-conversion-name" />
                                    </Stack>
                                    <Stack GapScale="LayoutGap.XSmall" AlignItems="AlignItems.Stretch">
                                        <label class="cda-field-label">Description</label>
                                        <NativeValueInput TValue="string" Multiline="true" @bind-Value="draft.ProjectDescription" @bind-Value:after="InputChanged.InvokeAsync" PendingChanged="@(_ => SetTextAsync())"
                                                       class="cda-input cda-input--textarea w-full min-h-[7rem]"
                                                       data-testid="crmhr-opportunity-conversion-description" />
                                    </Stack>
                                    <Stack GapScale="LayoutGap.XSmall" AlignItems="AlignItems.Stretch">
                                        <label class="cda-field-label">Objective</label>
                                        <NativeValueInput TValue="string" Multiline="true" @bind-Value="draft.ProjectObjective" @bind-Value:after="InputChanged.InvokeAsync" PendingChanged="@(_ => SetTextAsync())"
                                                       class="cda-input cda-input--textarea w-full min-h-[7rem]"
                                                       data-testid="crmhr-opportunity-conversion-objective" />
                                    </Stack>
                                    <Stack GapScale="LayoutGap.XSmall" AlignItems="AlignItems.Stretch">
                                        <label class="cda-field-label">Current phase</label>
                                        <NativeValueInput TValue="string" @bind-Value="draft.CurrentPhase" @bind-Value:after="InputChanged.InvokeAsync" PendingChanged="@(_ => SetTextAsync())"
                                                   class="cda-input w-full"
                                                   data-testid="crmhr-opportunity-conversion-phase" />
                                    </Stack>
                                }
                            </Stack>
                        </ChildContent>
                    </FormSection>
                </Grid>

                <FormSection Title="Projected party handoff"
                             Description="These CRM relationships are carried into project assignments.">
                    <ChildContent>
                        <Cluster Gap="LayoutGap.Small"
                                 Wrap="FlexWrap.Wrap">
                            <StatusBadge Tone="neutral"
                                         Text="@($"Customer: {Opportunity.AccountDisplayName}")" />
                            <StatusBadge Tone="neutral"
                                         Text="@($"Owner: {Opportunity.OwnerDisplayName}")" />
                            @if (!string.IsNullOrWhiteSpace(Opportunity.DeliveryUnitDisplayName))
                            {
                                <StatusBadge Tone="neutral"
                                             Text="@($"Delivery: {Opportunity.DeliveryUnitDisplayName}")" />
                            }
                            @foreach (var party in Opportunity.Parties)
                            {
                                <StatusBadge Tone="neutral"
                                             Text="@($"{party.Role}: {party.DisplayName}")" />
                            }
                        </Cluster>
                    </ChildContent>
                </FormSection>
            </Stack>
            </EditForm>
        </ChildContent>
        <Footer>
            <Split Breakpoint="LayoutBreakpoint.None"
                   Gap="LayoutGap.Medium"
                   AlignItems="AlignItems.Center"
                   JustifyContent="JustifyContent.SpaceBetween"
                   Wrap="FlexWrap.Wrap">
                <SmallText Text="The opportunity remains in CRM history after project handoff." />
                <Cluster Gap="LayoutGap.Small">
                    <Button Text="Cancel"
                            ButtonStyle="ButtonStyle.Light"
                            Disabled="IsBusy"
                            Click="HandleCloseAsync"
                            data-testid="crmhr-opportunity-conversion-cancel" />
                    <Button Text="Save conversion"
                            ButtonStyle="ButtonStyle.Info"
                            Disabled="@(IsBusy || SaveDisabled || isProjectPickerOpen)"
                            IsBusy="IsBusy"
                            Click="HandleSaveAsync"
                            data-testid="crmhr-opportunity-conversion-save" />
                </Cluster>
            </Split>
        </Footer>
    </Dialog>
}

<ProjectRecordPickerDialog IsOpen="isProjectPickerOpen"
                           SelectedProjectId="draft.ExistingProjectId"
                           SelectedProjectLifetimeId="draft.ExpectedProjectAdmission?.LifetimeId"
                           InitialScope="ProjectRecordScope.Open"
                           SnapshotConfirmed="HandleProjectSelectedAsync"
                           OnClose="CloseProjectPickerAsync"
                           LoadFailed="LoadFailed"
                           Title="Choose an existing project"
                           Subtitle="Search and page through Projects-owned records."
                           DataTestId="crmhr-opportunity-conversion-project-picker" />

@code {
    private CrmOpportunityConversionEditorModel draft => Model;
    private EditContext context = default!;
    private CrmOpportunityConversionEditorModel? configuredModel;
    private long configuredOpening = -1;
    private long pickerOpening = -1;
    private bool disposed;
    private bool isProjectPickerOpen;
    [Parameter] public long Opening { get; set; }
    [Parameter] public bool SaveDisabled { get; set; }
    [Parameter] public EventCallback InputChanged { get; set; }
    [Parameter] public EventCallback<bool> PickerChanged { get; set; }
    [Parameter] public EventCallback<ProjectRecordPickerSelection> ProjectSelected { get; set; }
    [Parameter] public RenderFragment? Editing { get; set; }

    [Parameter]
    public bool IsOpen { get; set; }

    // The database profile the host's project admissions belong to; the dialog binds a picked project row and its
    // lifetime to it and never resolves the profile itself.
    [Parameter, EditorRequired]
    public Guid DatabaseProfileId { get; set; }

    [Parameter]
    public CrmOpportunityDetailModel? Opportunity { get; set; }

    [Parameter, EditorRequired]
    public CrmOpportunityConversionEditorModel Model { get; set; } = new();

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public EventCallback Close { get; set; }

    [Parameter]
    public EventCallback<CrmOpportunityConversionEditorModel> Save { get; set; }

    [Parameter]
    public EventCallback<Exception> LoadFailed { get; set; }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(configuredModel, Model) || configuredOpening != Opening) {
            configuredModel = Model;
            configuredOpening = Opening;
            context = new(Model);
            isProjectPickerOpen = false;
            pickerOpening = -1;
        }
    }

    private string ResolveExistingProjectLabel()
    {
        if (!draft.ExistingProjectId.HasValue)
        {
            return "No project selected";
        }

        return Opportunity?.LinkedProjectId == draft.ExistingProjectId &&
               !string.IsNullOrWhiteSpace(Opportunity.LinkedProjectName)
            ? Opportunity.LinkedProjectName
            : "Project selected";
    }

    private async Task OpenProjectPicker()
    {
        if (disposed) {
            return;
        }
        pickerOpening = Opening;
        isProjectPickerOpen = true;
        await PickerChanged.InvokeAsync(true);
    }

    private async Task ClearExistingProject()
    {
        draft.ExistingProjectId = null;
        draft.ExpectedProjectAdmission = null;
        draft.ExpectedProjectBasis = null;
        await InputChanged.InvokeAsync();
    }

    private async Task CloseProjectPickerAsync()
    {
        isProjectPickerOpen = false;
        pickerOpening = -1;
        await PickerChanged.InvokeAsync(false);
    }

    private async Task HandleProjectSelectedAsync(ProjectRecordPickerSelection selection)
    {
        if (disposed || !isProjectPickerOpen || pickerOpening != Opening) {
            return;
        }
        draft.ExistingProjectId = selection.ProjectId;
        draft.ExpectedProjectAdmission = new CanDoItAll.Modules.Projects.ProjectWriteAdmission(
            DatabaseProfileId, selection.ProjectId, selection.LifetimeId
                ?? throw new InvalidOperationException("The selected project row has no lifetime binding."));
        draft.ExpectedProjectBasis = null;
        await InputChanged.InvokeAsync();
        await ProjectSelected.InvokeAsync(selection);
        if (!disposed) {
            await CloseProjectPickerAsync();
        }
    }

    private async Task HandleCloseAsync()
    {
        if (disposed) {
            return;
        }
        await Close.InvokeAsync();
    }

    private Task HandleSaveAsync()
    {
        return disposed || IsBusy || SaveDisabled || isProjectPickerOpen ? Task.CompletedTask : Save.InvokeAsync(draft);
    }

    private async Task SetTextAsync() {
        if (disposed) {
            return;
        }

        await InputChanged.InvokeAsync();
    }

    public void Dispose() => disposed = true;

    private static string ResolveValueLabel(CrmOpportunityDetailModel opportunity)
    {
        if (!opportunity.Amount.HasValue)
        {
            return "Value not set";
        }

        var currencyCode = string.IsNullOrWhiteSpace(opportunity.CurrencyCode)
            ? "Currency missing"
            : opportunity.CurrencyCode.Trim().ToUpperInvariant();
        return $"{currencyCode} {opportunity.Amount.Value:N2}";
    }
}

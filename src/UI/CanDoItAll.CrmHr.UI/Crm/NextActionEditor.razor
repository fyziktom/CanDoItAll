<FormSection Title="Next action"
             Description="Capture the follow-up commitment explicitly so overdue work is visible on the CRM surface instead of hiding in notes.">
    <Grid Gap="LayoutGap.Large" ColumnsMd="2">
        <FormField Text="Next action">
            <NativeValueInput aria-label="Next action" TValue="string" @bind-Value="Model.NextActionText" PendingChanged="@(_ => SetTextAsync())"
                       class="form-input ui-input ui-input--outlined"
                       data-testid="crmhr-next-action-text" />
        </FormField>
        <FormField Text="Owner">
            <SelectInput @bind-Value="Model.NextActionOwnerPartyId"
                         data-testid="crmhr-next-action-owner">
                <option value="">Select owner</option>
                @foreach (var option in OwnerOptions)
                {
                    <option value="@option.Id">@option.DisplayName (@option.PartyType)</option>
                }
                @if (Model.NextActionOwnerPartyId is Guid retained && !OwnerOptions.Any(option => option.Id == retained)) {
                    <option value="@retained">@(SelectedOwnerLabel ?? $"Previously selected owner ({retained:D})")</option>
                }
            </SelectInput>
        </FormField>
    </Grid>

    <div class="mt-5 max-w-sm">
        <label class="cda-form-field__label">Due on</label>
        <InputDate @bind-Value="Model.NextActionDueOn"
                   class="form-input ui-input ui-input--outlined"
                   data-testid="crmhr-next-action-due-on" />
    </div>
</FormSection>

@code {
    [Parameter, EditorRequired]
    public CrmInteractionEditorModel Model { get; set; } = new();

    [Parameter]
    public IReadOnlyList<PartyOptionModel> OwnerOptions { get; set; } = [];
    [Parameter] public string? SelectedOwnerLabel { get; set; }
    [Parameter] public EventCallback InputChanged { get; set; }
    [CascadingParameter] private EditContext? Context { get; set; }

    private Task SetTextAsync() => InputChanged.InvokeAsync();
}

@if (IsOpen && Opportunity is not null)
{
    <Dialog IsOpen="true"
            Eyebrow="Opportunity"
            Title="Edit opportunity"
            Subtitle="@($"{Opportunity.AccountDisplayName} · {Opportunity.Title}")"
            Size="ModalSize.Wide"
            DenseChrome="true"
            CloseOnBackdrop="false"
            TestId="crmhr-opportunity-edit-dialog"
            OnClose="HandleCloseAsync">
        <ChildContent>
            <Stack GapScale="LayoutGap.Medium">
                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <PanelCard Soft="true"
                               data-testid="crmhr-opportunity-edit-message">
                        <TextBlock TextStyle="TextStyle.Body1"
                                   Value="@Message" />
                    </PanelCard>
                }

                @Editing
                <OpportunityEditorForm @key="Opening" Model="Model" Source="Opportunity" FormId="crmhr-opportunity-edit-form"
                    AccountDisplayName="@Opportunity.AccountDisplayName" RelationshipStageLabel="@Model.RelationshipStage" Save="Save"
                    InputChanged="InputChanged" PickerChanged="PickerChanged" ProjectSelected="ProjectSelected" LoadFailed="LoadFailed" />
            </Stack>
        </ChildContent>
        <Footer>
            <Split Breakpoint="LayoutBreakpoint.None"
                   Gap="LayoutGap.Medium"
                   AlignItems="AlignItems.Center"
                   JustifyContent="JustifyContent.SpaceBetween"
                   Wrap="FlexWrap.Wrap">
                <SmallText Text="Changes are isolated until Save opportunity succeeds." />
                <Cluster Gap="LayoutGap.Small">
                    <Button Text="Cancel"
                            Tone="ButtonTone.Default"
                            Disabled="IsBusy"
                            Click="HandleCloseAsync"
                            data-testid="crmhr-opportunity-edit-cancel" />
                    <Button Text="Save opportunity"
                            Type="submit"
                            form="crmhr-opportunity-edit-form"
                            Disabled="@(IsBusy || SaveDisabled)"
                            IsBusy="IsBusy"
                            data-testid="crmhr-opportunity-save-button" />
                </Cluster>
            </Split>
        </Footer>
    </Dialog>
}

@code {
    [Parameter, EditorRequired] public CrmOpportunityEditorModel Model { get; set; } = default!;
    [Parameter] public long Opening { get; set; }
    [Parameter] public bool SaveDisabled { get; set; }
    [Parameter] public RenderFragment? Editing { get; set; }
    [Parameter] public EventCallback<OpportunityInput> InputChanged { get; set; }
    [Parameter] public EventCallback<bool> PickerChanged { get; set; }
    [Parameter] public EventCallback<Guid> ProjectSelected { get; set; }

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public CrmOpportunityDetailModel? Opportunity { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public EventCallback<CrmOpportunityEditorModel> Save { get; set; }

    [Parameter]
    public EventCallback Close { get; set; }

    [Parameter]
    public EventCallback<Exception> LoadFailed { get; set; }

    private Task HandleCloseAsync() => Close.InvokeAsync();
}

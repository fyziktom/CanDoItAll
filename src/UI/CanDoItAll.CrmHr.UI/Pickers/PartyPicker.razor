@inject IPartyRecordQueryService PartyRecordQueryService

<Stack GapScale="LayoutGap.Medium">
    <FormField Text="@Label">
        <SurfaceCard Soft="true">
            <Split Breakpoint="LayoutBreakpoint.None"
                   Gap="LayoutGap.Medium"
                   AlignItems="AlignItems.Center"
                   JustifyContent="JustifyContent.SpaceBetween"
                   Wrap="FlexWrap.Wrap">
                <div class="min-w-0">
                    <TextBlock TextStyle="TextStyle.Subtitle2"
                               Value="@SelectedPartyLabel" />
                    <TextBlock TextStyle="TextStyle.Note"
                               Value="@SelectedPartyDescription" />
                </div>
                <Cluster Gap="LayoutGap.Small">
                    @if (EffectiveSelectedPartyId.HasValue)
                    {
                        <Button Text="Clear"
                                ButtonStyle="ButtonStyle.Light"
                                Size="ButtonSize.Small"
                                Click="ClearSelectionAsync"
                                data-testid="@($"{TestIdPrefix}-clear")" />
                    }
                    <Button Text="Choose party"
                            Icon="search"
                            Size="ButtonSize.Small"
                            Click="OpenPicker"
                            data-testid="@($"{TestIdPrefix}-select")" />
                </Cluster>
            </Split>
        </SurfaceCard>
    </FormField>

    @if (ResolvedSelectedParty is not null)
    {
        <PanelCard data-testid="@($"{TestIdPrefix}-summary")">
            <div class="space-y-1 text-sm text-slate-600">
                <p class="font-semibold text-slate-900">@ResolvedSelectedParty.DisplayName</p>
                @if (ResolvedSelectedParty.IsSensitive)
                {
                    <p class="text-amber-700">Sensitive handling enabled for this party.</p>
                }
            </div>
        </PanelCard>
    }
</Stack>

<PartyRecordPickerDialog IsOpen="@isPickerOpen"
                         SelectedPartyId="@EffectiveSelectedPartyId"
                         AllowedScope="@AllowedScope"
                         InitialScope="@InitialScope"
                         ExcludedPartyId="@EffectiveExcludedPartyId"
                         SelectionConfirmed="ConfirmSelectionAsync"
                         OnClose="ClosePickerAsync"
                         Title="@($"Choose {Label.ToLowerInvariant()}")"
                         Subtitle="Search and page through the shared party directory."
                         DataTestId="@($"{TestIdPrefix}-dialog")" />

@code {
    private bool isPickerOpen;
    private ResolvedParty? resolvedSelectedParty;
    private Guid? resolvedPartyId;
    private long resolveGeneration;

    [Parameter]
    public string Label { get; set; } = "Party";

    [Parameter]
    public string TestIdPrefix { get; set; } = "project-party-picker";

    [Parameter]
    public PartyRecordScope AllowedScope { get; set; } = PartyRecordScope.All;

    [Parameter]
    public PartyRecordScope InitialScope { get; set; } = PartyRecordScope.All;

    [Parameter]
    public Guid? ExcludedPartyId { get; set; }

    [Parameter]
    public Guid? SelectedPartyId { get; set; }

    [Parameter]
    public EventCallback<Guid?> SelectedPartyIdChanged { get; set; }

    private ResolvedParty? ResolvedSelectedParty => resolvedSelectedParty;

    private Guid? EffectiveSelectedPartyId => SelectedPartyId is { } partyId && partyId != Guid.Empty
        ? partyId
        : null;

    private Guid? EffectiveExcludedPartyId => ExcludedPartyId is { } partyId && partyId != Guid.Empty
        ? partyId
        : null;

    private string SelectedPartyLabel => ResolvedSelectedParty?.DisplayName
        ?? (EffectiveSelectedPartyId.HasValue ? "Selected directory party" : "No party selected");

    private string SelectedPartyDescription => ResolvedSelectedParty is null
        ? EffectiveSelectedPartyId.HasValue
            ? "The selected party remains linked even when it is outside the current project option set."
            : "Choose from the server-paged shared directory."
        : ResolvedSelectedParty.PartyTypeLabel;

    protected override async Task OnParametersSetAsync()
    {
        var selectedPartyId = EffectiveSelectedPartyId;
        if (resolvedPartyId == selectedPartyId)
        {
            return;
        }

        resolvedPartyId = selectedPartyId;
        var generation = ++resolveGeneration;
        if (!selectedPartyId.HasValue)
        {
            resolvedSelectedParty = null;
            return;
        }

        var party = await PartyRecordQueryService.GetAsync(selectedPartyId.Value);
        if (generation != resolveGeneration ||
            resolvedPartyId != EffectiveSelectedPartyId)
        {
            return;
        }

        resolvedSelectedParty = party is null
            ? null
            : new ResolvedParty(party.DisplayName, party.PartyType.ToString(), party.IsSensitive);
    }

    private void OpenPicker()
    {
        isPickerOpen = true;
    }

    private Task ClosePickerAsync()
    {
        isPickerOpen = false;
        return Task.CompletedTask;
    }

    private async Task ConfirmSelectionAsync(Guid partyId)
    {
        isPickerOpen = false;
        await SelectedPartyIdChanged.InvokeAsync(partyId);
    }

    private Task ClearSelectionAsync()
    {
        return SelectedPartyIdChanged.InvokeAsync(null);
    }

    // What the picker shows about the resolved selection: the owner's display name, its party type and the
    // sensitive-handling flag.
    private sealed record ResolvedParty(string DisplayName, string PartyTypeLabel, bool IsSensitive);
}

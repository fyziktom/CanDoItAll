@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Modules.Projects
@implements IDisposable
@inject IProjectRecordQueryService ProjectRecordQueryService

<FormField Text="@Label">
    <SurfaceCard Soft="true">
        <Split Breakpoint="LayoutBreakpoint.None"
               Gap="LayoutGap.Medium"
               AlignItems="AlignItems.Center"
               JustifyContent="JustifyContent.SpaceBetween"
               Wrap="FlexWrap.Wrap">
            <div class="min-w-0">
                <TextBlock TextStyle="TextStyle.Subtitle2"
                           Value="@SelectedProjectLabel" />
                <TextBlock TextStyle="TextStyle.Note"
                           Value="@SelectedProjectDescription" />
            </div>
            <Cluster Gap="LayoutGap.Small">
                @if (EffectiveSelectedProjectId.HasValue)
                {
                    <Button Text="Clear"
                            Tone="ButtonTone.Default"
                            Size="ButtonSize.Small"
                            Click="ClearSelectionAsync"
                            data-testid="@($"{TestIdPrefix}-clear")" />
                }
                <Button Text="Choose project"
                        Icon="search"
                        Size="ButtonSize.Small"
                        Click="OpenPicker"
                        data-testid="@($"{TestIdPrefix}-select")" />
            </Cluster>
        </Split>
    </SurfaceCard>
</FormField>

<ProjectRecordPickerDialog IsOpen="@isPickerOpen"
                           SelectedProjectId="@EffectiveSelectedProjectId"
                           SelectedProjectLifetimeId="@SelectedAdmission?.LifetimeId"
                           InitialScope="ProjectRecordScope.All"
                           SelectionConfirmed="IdConfirmation"
                           SnapshotConfirmed="SnapshotConfirmation"
                           OnClose="ClosePickerAsync"
                           Title="@($"Choose {Label.ToLowerInvariant()}")"
                           Subtitle="Search and page through project records."
                           DataTestId="@($"{TestIdPrefix}-dialog")" />

@code {
    private bool isPickerOpen;
    private ProjectRecordQueryItem? resolvedSelectedProject;
    private Guid? resolvedProjectId;
    private long resolveGeneration;
    private long pickerGeneration;
    private Guid pickerDatabaseProfileId;
    private bool disposed;
    [Parameter] public Guid DatabaseProfileId { get; set; }
    [Parameter] public ProjectWriteAdmission? SelectedAdmission { get; set; }
    [Parameter] public EventCallback<ProjectWriteAdmission?> SelectedAdmissionChanged { get; set; }
    [Parameter] public EventCallback<bool> PendingChanged { get; set; }
    private EventCallback<Guid> IdConfirmation => SelectedAdmissionChanged.HasDelegate ? default
        : EventCallback.Factory.Create<Guid>(this, ConfirmSelectionAsync);
    private EventCallback<ProjectRecordPickerSelection> SnapshotConfirmation => SelectedAdmissionChanged.HasDelegate
        ? EventCallback.Factory.Create<ProjectRecordPickerSelection>(this, ConfirmSnapshotAsync) : default;

    [Parameter]
    public string Label { get; set; } = "Project";

    [Parameter]
    public string TestIdPrefix { get; set; } = "crmhr-project-picker";

    [Parameter]
    public Guid? SelectedProjectId { get; set; }

    [Parameter]
    public EventCallback<Guid?> SelectedProjectIdChanged { get; set; }

    private Guid? EffectiveSelectedProjectId => SelectedProjectId is { } projectId && projectId != Guid.Empty
        ? projectId
        : null;

    private string SelectedProjectLabel => resolvedSelectedProject?.Name
        ?? (EffectiveSelectedProjectId.HasValue ? "Selected project" : "No project selected");

    private string SelectedProjectDescription => resolvedSelectedProject is null
        ? EffectiveSelectedProjectId.HasValue
            ? "The selected project remains linked while its display record is unavailable."
            : "Choose from the server-paged project catalog."
        : string.IsNullOrWhiteSpace(resolvedSelectedProject.CurrentPhase)
            ? resolvedSelectedProject.Status.ToString()
            : $"{resolvedSelectedProject.Status} / {resolvedSelectedProject.CurrentPhase}";

    protected override async Task OnParametersSetAsync()
    {
        var selectedProjectId = EffectiveSelectedProjectId;
        if (resolvedProjectId == selectedProjectId)
        {
            return;
        }

        resolvedProjectId = selectedProjectId;
        var generation = ++resolveGeneration;
        if (!selectedProjectId.HasValue)
        {
            resolvedSelectedProject = null;
            return;
        }

        var project = await ProjectRecordQueryService.GetAsync(selectedProjectId.Value);
        if (disposed || generation != resolveGeneration ||
            resolvedProjectId != EffectiveSelectedProjectId)
        {
            return;
        }

        resolvedSelectedProject = project;
    }

    private async Task OpenPicker() {
        if (disposed) {
            return;
        }
        pickerGeneration++;
        pickerDatabaseProfileId = DatabaseProfileId;
        isPickerOpen = true;
        await PendingChanged.InvokeAsync(true);
    }

    private async Task ClosePickerAsync() {
        if (disposed) {
            return;
        }
        pickerGeneration++;
        isPickerOpen = false;
        await PendingChanged.InvokeAsync(false);
    }

    private async Task ConfirmSelectionAsync(Guid projectId) {
        if (disposed || !isPickerOpen) {
            return;
        }
        await SelectedProjectIdChanged.InvokeAsync(projectId);
        await ClosePickerAsync();
    }

    private async Task ConfirmSnapshotAsync(ProjectRecordPickerSelection selection) {
        if (disposed || !isPickerOpen || pickerDatabaseProfileId != DatabaseProfileId) {
            return;
        }
        var opening = pickerGeneration;
        var admission = new ProjectWriteAdmission(pickerDatabaseProfileId, selection.ProjectId,
            selection.LifetimeId ?? throw new InvalidOperationException("Choose a displayed project with its current lifetime."));
        await SelectedProjectIdChanged.InvokeAsync(selection.ProjectId);
        if (disposed || opening != pickerGeneration || pickerDatabaseProfileId != DatabaseProfileId) {
            return;
        }
        await SelectedAdmissionChanged.InvokeAsync(admission);
        await ClosePickerAsync();
    }

    private async Task ClearSelectionAsync() {
        if (disposed) {
            return;
        }
        var opening = ++pickerGeneration;
        var profile = DatabaseProfileId;
        await PendingChanged.InvokeAsync(true);
        try {
            if (disposed || opening != pickerGeneration || profile != DatabaseProfileId) {
                return;
            }
            await SelectedProjectIdChanged.InvokeAsync(null);
            if (disposed || opening != pickerGeneration || profile != DatabaseProfileId) {
                return;
            }
            await SelectedAdmissionChanged.InvokeAsync(null);
        } finally {
            if (!disposed && opening == pickerGeneration && profile == DatabaseProfileId) {
                await PendingChanged.InvokeAsync(false);
            }
        }
    }
    public void Dispose() {
        disposed = true;
        resolveGeneration++;
        pickerGeneration++;
    }
}

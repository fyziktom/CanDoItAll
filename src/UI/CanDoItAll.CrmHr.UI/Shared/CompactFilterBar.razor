@using CanDoItAll.Components.BaseLib

<div class="w-full rounded-[1.2rem] border border-slate-200 bg-slate-50/90 px-3.5 py-2.5"
     @attributes="AdditionalAttributes">
    <Split Breakpoint="LayoutBreakpoint.None"
           Gap="LayoutGap.Small"
           AlignItems="AlignItems.Center"
           JustifyContent="JustifyContent.SpaceBetween"
           Wrap="FlexWrap.Wrap">
        <Cluster Gap="LayoutGap.Small"
                 Wrap="FlexWrap.Wrap"
                 style="min-width: 0; flex: 1 1 48rem;">
            @ChildContent
        </Cluster>

        @if (Actions is not null || !string.IsNullOrWhiteSpace(ResultText)) {
            <Cluster Gap="LayoutGap.Small"
                     Wrap="FlexWrap.NoWrap"
                     Class="ml-auto text-[11px] font-medium text-slate-500">
                @if (!string.IsNullOrWhiteSpace(ResultText)) {
                    <span>@ResultText</span>
                }

                @Actions
            </Cluster>
        }
    </Split>
</div>

@code {
    [Parameter]
    public string? ResultText { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}

@implements IDisposable
@using static CanDoItAll.Workspace.DataSources.UI.DataSourcesText

<Cluster Gap="LayoutGap.Small" data-testid="database-profile-controls" data-interactive="@(interactive ? "true" : "false")">
    <Button Text="Refresh profiles and runtime" Click="Session.RefreshAsync" data-testid="database-profile-refresh" />
    <Button Text="Refresh selected schema" Click="Session.RefreshSelectedSchemaAsync" data-testid="database-profile-refresh-schema" />
</Cluster>
@foreach (var error in new[] { Session.ListError, Session.RuntimeError, Session.EditorError }.Where(value => value is not null)) {
    <Alert AlertStyle="AlertStyle.Warning" data-testid="database-profile-read-error">@error</Alert>
}
@if (Session.EditorLoading) {
    <Alert AlertStyle="AlertStyle.Info">Loading the exact profile. Editing is unavailable until acquisition completes.</Alert>
}
<DataSourceReceipts Operations="Session.Operations" />
<ListDetailShell ListPaneWidth="27rem">
    <ListHeader>
        <ListPanelHeader Title="Data sources"
                         Description="Database profiles drive the runtime workspace, managed files, and workbench isolation. Save the profile first, then create or test the actual database."
                         Count="@($"{Session.FilteredProfiles.Count} profile(s)")">
            <Filters>
                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                    <Button Text="PostgreSQL"
                            Class="shrink-0 whitespace-nowrap"
                            ButtonStyle="ButtonStyle.Light"
                            Size="ButtonSize.Small"
                            Disabled="@Session.IsLocked"
                            Click="Session.NewProfile"
                            data-testid="database-profile-new-postgres" />
                </Cluster>
                <FilterBar ResultText="@($"{Session.FilteredProfiles.Count} matching profile(s)")">
                    <input @bind="Session.Search"
                           @bind:event="oninput"
                           class="cda-input min-w-[14rem] flex-1"
                           placeholder="Search data sources"
                           data-testid="database-profile-search" />
                    <Button Text="Reset"
                            ButtonStyle="ButtonStyle.Light"
                            Size="ButtonSize.Small"
                            Click="ResetSearch" />
                </FilterBar>
            </Filters>
        </ListPanelHeader>
    </ListHeader>

    <ListContent>
        @if (Session.CurrentSelection is not null) {
            <div class="mb-4 rounded-[1.5rem] border border-slate-200 bg-slate-50/90 p-4"
                 data-testid="database-data-sources-summary">
                <Split Breakpoint="LayoutBreakpoint.None"
                       Gap="LayoutGap.Medium"
                       AlignItems="AlignItems.Start"
                       JustifyContent="JustifyContent.SpaceBetween"
                       Wrap="FlexWrap.Wrap">
                    <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
                        <p class="cda-eyebrow">Current runtime selection</p>
                        <p class="text-base font-semibold text-slate-950">@Session.CurrentSelection.DisplayName</p>
                        <p class="text-sm leading-6 text-slate-600">@Session.CurrentSelection.Descriptor</p>
                        @if (Session.CurrentSelection.HasPendingRestartActivation) {
                            <p class="text-sm leading-6 text-amber-700">
                                Pending restart: @Session.CurrentSelection.PendingRestartDisplayName (@Session.CurrentSelection.PendingRestartDescriptor)
                            </p>
                        }
                    </Stack>

                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                        <StatusBadge Tone="info" Text="@DescribeProvider(Session.CurrentSelection.ProviderKind)" />
                        <StatusBadge Tone="neutral" Text="@DescribeSource(Session.CurrentSelection.ProviderKind)" />
                        @if (Session.CurrentSelection.IsRuntimeLocked) {
                            <StatusBadge Tone="warning" Text="Config lock" />
                        }
                    </Cluster>
                </Split>

                <p class="mt-3 text-xs text-slate-500">Workspace root: @Session.CurrentSelection.WorkspaceRoot</p>
                <p class="mt-1 text-xs text-slate-500">Selection source: @DescribeResolutionSource(Session.CurrentSelection.ResolutionSource)</p>
            </div>
        }

        @if (Session.IsLocked) {
            <div class="mb-4 rounded-[1.4rem] border border-amber-300 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-950"
                 data-testid="database-data-sources-locked-message">
                This session is running under an explicit startup database override. Profile management stays read-only here so the UI does not pretend it can switch away from configuration-owned state.
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Session.Message)) {
            <Alert AlertStyle="@ResolveMessageAlertStyle(MessageTone)"
                   Variant="Variant.Outlined"
                   data-testid="database-profile-operation-message">
                @Session.Message
            </Alert>
        }

        @if (Session.FilteredProfiles.Count == 0 && Session.ListError is null) {
            <EmptyState Eyebrow="No saved profiles"
                        Title="Start with a PostgreSQL profile"
                        Description="Save a PostgreSQL profile for runtime activation." />
        }
        else {
            <Stack GapScale="LayoutGap.Medium" data-testid="database-profile-list">
                @foreach (var profile in Session.FilteredProfiles) {
                    <SelectionListItem Title="@profile.DisplayName"
                                       Eyebrow="@DescribeProvider(profile.ProviderKind)"
                                       Meta="@DescribeSource(profile.ProviderKind)"
                                       Summary="@BuildProfileSummary(profile)"
                                       DataTestId="@($"database-profile-row-{profile.Id:N}")"
                                       IsSelected="@(Session.Draft.Id == profile.Id)"
                                       OnSelect="@(() => SelectProfileAsync(profile.Id))">
                        <Status>
                            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                @if (profile.IsActive) {
                                    <StatusBadge Tone="success" Text="Running now" />
                                }

                                @if (profile.IsPendingRestartActivation) {
                                    <StatusBadge Tone="warning" Text="Pending restart" />
                                }

                                @if (profile.IsRuntimeLocked) {
                                    <StatusBadge Tone="warning" Text="Locked" />
                                }

                                @if (TryGetSchemaHealth(profile.Id) is { } rowSchemaHealth) {
                                    <StatusBadge Tone="@DescribeSchemaTone(rowSchemaHealth)" Text="@DescribeSchemaStatus(rowSchemaHealth)" />
                                }

                                <StatusBadge Tone="neutral" Text="@DescribeSource(profile.ProviderKind)" />
                            </Cluster>
                        </Status>
                    </SelectionListItem>
                }
            </Stack>
        }
    </ListContent>

    <DetailHeader>
        <Stack GapScale="LayoutGap.Tiny">
            <p class="cda-eyebrow">Data source editor</p>
            <h2 class="cda-title-xl">@(Session.Draft.Id.HasValue ? Session.Draft.DisplayName : "New data source")</h2>
            <p class="cda-body-muted">@DescribeEditorLead(Session.Draft)</p>
        </Stack>
    </DetailHeader>

    <DetailContent>
        <EditForm @key="Session.EditContext" EditContext="Session.EditContext" OnValidSubmit="Session.SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <fieldset disabled="@(Session.IsLocked || Session.EditorLoading || Session.EditorError is not null)" class="contents">
                <Stack Class="min-h-full" GapScale="LayoutGap.XXLarge">
                    @if (Session.SelectedSchemaHealth is { RequiresAction: true } selectedSchemaHealth) {
                        <Alert AlertStyle="@ResolveSchemaAlertStyle(selectedSchemaHealth)"
                               Variant="Variant.Outlined"
                               data-testid="database-profile-schema-alert">
                            <Split Breakpoint="LayoutBreakpoint.None"
                                   Gap="LayoutGap.Medium"
                                   AlignItems="AlignItems.Start"
                                   JustifyContent="JustifyContent.SpaceBetween"
                                   Wrap="FlexWrap.Wrap">
                                <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
                                    <p class="font-semibold">Database schema needs attention</p>
                                    <p>@selectedSchemaHealth.Summary</p>
                                    @if (HasSchemaDetails(selectedSchemaHealth)) {
                                        <p class="text-xs opacity-80">@DescribeSchemaDetails(selectedSchemaHealth)</p>
                                    }
                                </Stack>

                                @if (selectedSchemaHealth.CanApplySchema) {
                                    <Button Text="Apply current schema"
                                            Icon="database"
                                            ButtonStyle="ButtonStyle.Warning"
                                            Size="ButtonSize.Small"
                                            Disabled="@(!Session.CanMutate || Session.IsLocked || Session.Operations.IsBusy)"
                                            IsBusy="@(Session.Operations.IsBusy)"
                                            Click="ApplySchema"
                                            data-testid="database-profile-apply-schema" />
                                }
                            </Split>
                        </Alert>
                    }

                    <FormSection Title="Profile identity"
                                 Description="Choose a clear name and workspace root for this PostgreSQL runtime profile.">
                        <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                            <div>
                                <label class="cda-field-label">Profile name</label>
                                <InputText @bind-Value="Session.Draft.DisplayName"
                                           class="cda-input"
                                           data-testid="database-profile-name" />
                            </div>

                            <div>
                                <label class="cda-field-label">Workspace root</label>
                                <InputText @bind-Value="Session.Draft.WorkspaceRoot"
                                           class="cda-input"
                                           data-testid="database-profile-workspace-root" />
                            </div>
                        </Grid>

                        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                            <StatusBadge Tone="info" Text="@DescribeProvider(Session.Draft.ProviderKind)" />
                            <StatusBadge Tone="neutral" Text="@DescribeSource(Session.Draft.ProviderKind)" />
                            @if (Session.Draft.Id.HasValue && Session.IsActive) {
                                <StatusBadge Tone="success" Text="Running now" />
                            }
                            @if (Session.Draft.Id.HasValue && Session.IsPending) {
                                <StatusBadge Tone="warning" Text="Pending restart" />
                            }
                        </Cluster>
                    </FormSection>

                    @if (Session.Draft.ProviderKind == DataSourceProvider.PostgreSql) {
                        <FormSection Title="PostgreSQL connection"
                                     Description="Save the profile first, then use Test connection to verify the target database or Create empty to provision it before activation.">
                            <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                <div>
                                    <label class="cda-field-label">Host</label>
                                    <InputText @bind-Value="Session.Draft.PostgresHost"
                                               class="cda-input"
                                               data-testid="database-profile-postgres-host" />
                                </div>

                                <div>
                                    <label class="cda-field-label">Port</label>
                                    <InputNumber @bind-Value="Session.Draft.PostgresPort"
                                                 class="cda-input"
                                                 data-testid="database-profile-postgres-port" />
                                </div>
                            </Grid>

                            <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                <div>
                                    <label class="cda-field-label">Database</label>
                                    <InputText @bind-Value="Session.Draft.PostgresDatabaseName"
                                               class="cda-input"
                                               data-testid="database-profile-postgres-database" />
                                </div>

                                <div>
                                    <label class="cda-field-label">Admin database</label>
                                    <InputText @bind-Value="Session.Draft.PostgresAdminDatabaseName"
                                               class="cda-input"
                                               data-testid="database-profile-postgres-admin-database" />
                                </div>
                            </Grid>

                            <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                <div>
                                    <label class="cda-field-label">Username</label>
                                    <InputText @bind-Value="Session.Draft.PostgresUsername"
                                               class="cda-input"
                                               data-testid="database-profile-postgres-user" />
                                </div>

                                <div>
                                    <label class="cda-field-label">Password</label>
                                    <InputText @bind-Value="Session.Password"
                                               type="password"
                                               class="cda-input"
                                               data-testid="database-profile-postgres-password" />
                                    <p class="text-xs text-slate-500">Leave blank to retain the saved password. Existing values are never loaded into this field.</p>
                                </div>
                            </Grid>

                            <label class="cda-inline-option">
                                <InputCheckbox @bind-Value="Session.Draft.PostgresTrustServerCertificate"
                                               data-testid="database-profile-postgres-trust-server-certificate" />
                                Trust server certificate
                            </label>
                        </FormSection>
                    }
                    else {
                        <FormSection Title="In-memory runtime"
                                     Description="This runtime is available only for explicit overrides and test harnesses. Persisted data source management stays PostgreSQL-focused.">
                            <Alert AlertStyle="AlertStyle.Info" Variant="Variant.Outlined">
                                The current runtime does not expose editable persisted connection settings in this panel.
                            </Alert>
                        </FormSection>
                    }

                    @if (!Session.Draft.Id.HasValue) {
                        <div class="rounded-[1.25rem] border border-slate-200 bg-slate-50 px-4 py-3 text-sm leading-6 text-slate-700">
                            Save the profile before testing a PostgreSQL connection, creating an empty database, or activating this data source.
                        </div>
                    }

                    <StickyActionFooter StatusLabel="Data sources"
                                        StatusTone="success">
                        <PrimaryActions>
                            <Cluster Wrap="FlexWrap.Wrap" JustifyContent="JustifyContent.End" Class="w-full">
                            <Button Text="Reset draft"
                                    ButtonStyle="ButtonStyle.Light"
                                    Disabled="@(!Session.CanMutate || Session.IsLocked)"
                                    Click="Session.ResetAsync"
                                    data-testid="database-profile-reset" />
                            @if (Session.Draft.Id.HasValue && IsPostgres) {
                                <Button Text="Test connection"
                                        ButtonStyle="ButtonStyle.Info"
                                        Disabled="@(!Session.CanMutate || Session.IsLocked)"
                                        Click="TestConnection"
                                        data-testid="database-profile-test-connection" />
                            }
                            @if (Session.Draft.Id.HasValue && IsPostgres) {
                                <Button Text="Create empty"
                                        ButtonStyle="ButtonStyle.Info"
                                        Disabled="@(!Session.CanMutate || Session.IsLocked)"
                                        Click="CreateEmpty"
                                        data-testid="database-profile-create-empty" />
                            }
                            @if (Session.Draft.Id.HasValue) {
                                <Button Text="Transfer settings"
                                        ButtonStyle="ButtonStyle.Light"
                                        Disabled="@(!Session.CanMutate || Session.IsLocked)"
                                        Click="@(() => Session.OpenTransferAsync(Session.Draft.Id.Value))"
                                        data-testid="database-profile-transfer-settings" />
                            }
                            <Button Text="Save data source"
                                    Type="submit"
                                    Disabled="@(!Session.CanMutate || Session.IsLocked)"
                                    data-testid="database-profile-save" />
                            @if (Session.Draft.Id.HasValue) {
                                <Button Text="@ResolveActivationButtonText()"
                                        ButtonStyle="ButtonStyle.Warning"
                                        Disabled="@(!Session.CanMutate || Session.IsActive || Session.IsPending || Session.SelectedSchemaHealth?.Status != SchemaStatus.Current)"
                                        Click="Activate"
                                        data-testid="database-profile-activate" />
                            }
                            @if (Session.Draft.Id.HasValue) {
                                <Button Text="Delete"
                                        ButtonStyle="ButtonStyle.Danger"
                                        Disabled="@(!Session.CanDelete)"
                                        Click="Delete"
                                        data-testid="database-profile-delete" />
                            }
                            </Cluster>
                        </PrimaryActions>
                    </StickyActionFooter>
                </Stack>
            </fieldset>
        </EditForm>
    </DetailContent>
</ListDetailShell>


@if (Session.Transfer is { } transfer) {
    <DataSourceTransferDialog @key="transfer" Session="transfer" Operations="Session.Operations" OnClose="Session.CloseTransfer" />
}

@code {
    [Parameter, EditorRequired] public DataSourcesSession Session { get; set; } = null!;
    private DataSourcesSession? attached;
    private bool disposed;
    private bool IsPostgres => Session.Draft.ProviderKind == DataSourceProvider.PostgreSql;
    private bool interactive;
    private string MessageTone => Session.Operations.Receipts.LastOrDefault()?.Result?.Outcome == DataSourceOutcome.Confirmed ? "success" : "warning";
    protected override void OnAfterRender(bool firstRender) {
        if (firstRender) {
            interactive = true;
            StateHasChanged();
        }
    }
    protected override void OnParametersSet() {
        if (ReferenceEquals(attached, Session)) {
            return;
        }
        if (attached is not null) {
            attached.Changed -= Refresh;
        }
        attached = Session;
        attached.Changed += Refresh;
    }
    private void Refresh() {
        if (!disposed) {
            _ = InvokeAsync(StateHasChanged);
        }
    }
    private void ResetSearch() => Session.Search = string.Empty;
    private Task SelectProfileAsync(Guid id) => Session.SelectAsync(id);
    private Task TestConnection() => Session.ExecuteAsync(DataSourceAction.TestConnection);
    private Task CreateEmpty() => Session.ExecuteAsync(DataSourceAction.CreateEmpty);
    private Task ApplySchema() => Session.ExecuteAsync(DataSourceAction.ApplySchema);
    private Task Activate() => Session.ExecuteAsync(DataSourceAction.ActivateForRestart);
    private Task Delete() => Session.ExecuteAsync(DataSourceAction.Delete);
    private SchemaHealth? TryGetSchemaHealth(Guid id) => Session.SelectedSchemaHealth?.ProfileId == id ? Session.SelectedSchemaHealth : null;
    private string ResolveActivationButtonText() => Session.IsActive ? "Running now" : Session.IsPending ? "Pending restart" : "Activate for restart";
    public void Dispose() {
        disposed = true;
        if (attached is not null) {
            attached.Changed -= Refresh;
        }
    }
}

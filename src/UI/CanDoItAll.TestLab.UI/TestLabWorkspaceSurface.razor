@using CanDoItAll.Editing
@using CanDoItAll.Editing.UI

@{
    var origin = View.State.Draft;
    var editor = origin?.Model ?? empty;
    var originVersion = origin?.TargetVersion ?? 0;
    var visiblePlans = View.State.VisiblePlans;
    RenderFragment runActions = @<Button Text="Add run" Tone="ButtonTone.Default" Size="ButtonSize.Small" Click="@(() => Edit(origin!, originVersion, () => editor.Runs.Add(new())))" />;
    RenderFragment evidenceActions = @<Button Text="Add evidence" Tone="ButtonTone.Default" Size="ButtonSize.Small" Click="@(() => Edit(origin!, originVersion, () => editor.Evidence.Add(new())))" />;
    RenderFragment caseActions = @<Button Text="Add case" Tone="ButtonTone.Default" Size="ButtonSize.Small" Click="@(() => Edit(origin!, originVersion, () => editor.Cases.Add(new())))" />;
}

<PageScaffold MaxWidthClass="max-w-full" data-testid="testlab-workspace" data-interactive="@Interactive.ToString().ToLowerInvariant()" data-section="@View.State.Section">
    <Header>
        <PageHeader Eyebrow="Test Lab"
                    Title="Tests, evidence, and execution results"
                    Description="Track planned coverage, linked cases, evidence artifacts, and the latest execution results for each phase."
                    Compact="true">
            <Stats>
                <CompactStat Label="plans" Value="@View.State.Plans.Count.ToString()" TooltipText="Persisted test plans." />
                <CompactStat Label="visible" Value="@visiblePlans.Count.ToString()" TooltipText="Plans matching the current filters." Tone="info" />
                <CompactStat Label="cases" Value="@View.State.Plans.Sum(item => item.CaseCount).ToString()" TooltipText="Tracked test cases across all plans." />
                <CompactStat Label="evidence" Value="@View.State.Plans.Sum(item => item.EvidenceCount).ToString()" TooltipText="Linked evidence records across all plans." />
            </Stats>
            <Actions>
                <PageHeaderActionButton Icon="add"
                                        Label="New test plan"
                                        TooltipText="Create a new test plan."
                                        Tone="ButtonTone.Primary"
                                        Click="View.NewAsync" />
            </Actions>
        </PageHeader>
    </Header>

    <ChildContent>
        <ListDetailShell ListPaneWidth="25rem">
            <ListHeader>
                <ListPanelHeader Title="Test plans"
                                 Description="Select a plan to continue editing it, or start a new plan with structured sections."
                                 Count="@($"{visiblePlans.Count} plan(s)")">
                    <Filters>
                        <FilterBar ResultText="@($"{visiblePlans.Count} matching plan(s)")">
                            <TextInput Value="@View.State.Filter.Search" ValueChanged="@(value => View.ApplyFilter(View.State.Filter with { Search = value ?? string.Empty }))" Immediate="true" Placeholder="Search test plans" data-testid="testlab-search" />
                            <SelectInput @bind-Value:get="View.State.Filter.ProjectId" @bind-Value:set="value => View.ApplyFilter(View.State.Filter with { ProjectId = value })" class="form-input ui-input ui-input--outlined" data-testid="testlab-project-filter">
                                <option value="">All projects</option>
                                @foreach (var project in View.State.Projects.OrderBy(item => item.Name)) {
                                    <option value="@project.Id.ToString()">@project.Name</option>
                                }
                            </SelectInput>
                            <SelectInput @bind-Value:get="View.State.Filter.Phase" @bind-Value:set="value => View.ApplyFilter(View.State.Filter with { Phase = value ?? string.Empty })" class="form-input ui-input ui-input--outlined" data-testid="testlab-phase-filter">
                                <option value="">All phases</option>
                                @foreach (var phase in View.State.Plans.Select(item => item.Phase).Where(item => !string.IsNullOrWhiteSpace(item)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(item => item)) {
                                    <option value="@phase">@phase</option>
                                }
                            </SelectInput>
                            <SelectInput @bind-Value:get="View.State.Filter.Result" @bind-Value:set="value => View.ApplyFilter(View.State.Filter with { Result = value })" class="form-input ui-input ui-input--outlined" data-testid="testlab-result-filter">
                                <option value="">All latest results</option>
                                @foreach (var status in Enum.GetValues<TestCaseStatus>()) {
                                    <option value="@status.ToString()">@status</option>
                                }
                            </SelectInput>
                            <Button Text="Reset" Tone="ButtonTone.Default" Size="ButtonSize.Small" Click="@(() => View.ApplyFilter(new()))" />
                        </FilterBar>
                    </Filters>
                </ListPanelHeader>
            </ListHeader>

            <ListContent>
                <p role="status" data-testid="testlab-list-state">@ListStatus</p>
                <Button Text="Retry refresh" Tone="ButtonTone.Default" Size="ButtonSize.Small" Click="View.RetryAsync" data-testid="testlab-retry" />
                @if (View.State.PlanOffset > 0 || View.State.HasMorePlans) {
                    <Cluster Gap="LayoutGap.Small" data-testid="testlab-plan-pagination">
                        <Button Text="Previous plans" Tone="ButtonTone.Default" Size="ButtonSize.Small"
                                Disabled="@(View.State.PlanOffset == 0 || View.State.PlansRead == TestLabReadState.Loading)" Click="@(() => View.MovePlanPageAsync(false))" />
                        <TextBlock Value="@($"Page {View.State.PlanOffset / TestLabPlanPage.Size + 1}")" />
                        <Button Text="Next plans" Tone="ButtonTone.Default" Size="ButtonSize.Small"
                                Disabled="@(!View.State.HasMorePlans || View.State.PlansRead == TestLabReadState.Loading)" Click="@(() => View.MovePlanPageAsync(true))" />
                    </Cluster>
                }
                @if (visiblePlans.Count == 0 && View.State.PlansRead is TestLabReadState.Ready or TestLabReadState.Empty or TestLabReadState.Stale) {
                    <EmptyState Eyebrow="No plans"
                                Title="@(View.State.PlansRead == TestLabReadState.Empty ? "Create the first test plan" : "No matching plans")"
                                Description="Plans appear here after they have been saved with coverage, evidence, and run data.">
                        <Actions>
                            <Button Text="New test plan" Click="View.NewAsync" />
                        </Actions>
                    </EmptyState>
                } else {
                    <Stack GapScale="LayoutGap.Medium">
                        @foreach (var plan in visiblePlans) {
                            <SelectionListItem Title="@plan.Title"
                                               Eyebrow="@plan.Phase"
                                               Meta="@BuildPlanMeta(plan)"
                                               Summary="@BuildPlanSummary(plan)"
                                               IsSelected="@(editor.Id == plan.Id)"
                                               OnSelect="@(() => View.SelectAsync(plan.Id))">
                                <Status>
                                    <StatusBadge Tone="@ResolveStatusTone(plan.LatestResult)" Text="@(plan.LatestResult?.ToString() ?? "No run")" />
                                </Status>
                            </SelectionListItem>
                        }
                    </Stack>
                }
            </ListContent>

            <DetailHeader>
                <Stack GapScale="LayoutGap.Medium">
                    <Split Gap="LayoutGap.Medium">
                        <Stack GapScale="LayoutGap.Tiny">
                            <TextBlock TextStyle="TextStyle.EyebrowCaption">Plan editor</TextBlock>
                            <h2 class="text-xl font-semibold text-chrome-950">@(origin is null ? "No selected plan" : string.IsNullOrWhiteSpace(editor.Title) ? "New test plan" : editor.Title)</h2>
                            <p class="text-sm leading-6 text-chrome-600">Coverage, cases, evidence, and run history stay in one detail pane with predictable sections.</p>
                        </Stack>
                        <Cluster Gap="LayoutGap.Small">
                            <StatusBadge Tone="info" Text="@($"{editor.Cases.Count} case(s)")" />
                            <StatusBadge Tone="neutral" Text="@($"{editor.Evidence.Count} evidence")" />
                            <StatusBadge Tone="@ResolveStatusTone(LatestRunResult)" Text="@(LatestRunResult?.ToString() ?? "No run")" />
                        </Cluster>
                    </Split>

                    <SecondaryTabs Items="DetailTabs" SelectedKey="@View.State.Section.ToString()" SelectedKeyChanged="HandleDetailTabChanged" />
                </Stack>
            </DetailHeader>

            <DetailContent>
                <p role="status" data-testid="testlab-editor-state">@EditorStatus</p>
                @if (origin is not null) {
                @if (origin.SaveState == TestLabSaveState.Conflict) {
                    <Button Text="Compare changes" Tone="ButtonTone.Default" IsBusy="@origin.IsComparing"
                            Click="@(() => View.CompareChangesAsync(origin))" data-testid="testlab-compare-changes" />
                }
                @if (origin.Comparison is { } comparison) {
                    <SurfaceCard Soft="true" data-testid="testlab-plan-comparison">
                        <Stack GapScale="LayoutGap.Small">
                            <TextBlock Value="Review the current plan and apply your choices to the draft. Save separately when ready." />
                            <Stack GapScale="LayoutGap.Small" Style="max-height:28rem;overflow:auto">
                                <MergeFieldView Label="Title" Field="@comparison.Title" Format="@(value => value)" ShowUnchanged="false" Changed="StateHasChanged" />
                                <MergeFieldView Label="Phase" Field="@comparison.Phase" Format="@(value => value)" ShowUnchanged="false" Changed="StateHasChanged" />
                                <MergeFieldView Label="Coverage" Field="@comparison.Coverage" Format="@(value => value)" ShowUnchanged="false" Changed="StateHasChanged" />
                                <MergeFieldView Label="Playwright specification" Field="@comparison.Spec" Format="@(value => value)" ShowUnchanged="false" Changed="StateHasChanged" />
                                <MergeFieldView Label="Project and responsible party" Field="@comparison.Project" Format="FormatProject" ShowUnchanged="false" Changed="StateHasChanged" />
                                @foreach (var row in comparison.Cases.Where(row => row.Field.LocalChanged || row.Field.CurrentChanged)) {
                                    <MergeFieldView @key="(TestLabSection.Cases, row.Key)" Label="Test case" Field="@row.Field" Format="FormatCase" ShowUnchanged="false" Changed="StateHasChanged" />
                                }
                                @foreach (var row in comparison.Evidence.Where(row => row.Field.LocalChanged || row.Field.CurrentChanged)) {
                                    <MergeFieldView @key="(TestLabSection.Evidence, row.Key)" Label="Evidence" Field="@row.Field" Format="FormatEvidence" ShowUnchanged="false" Changed="StateHasChanged" />
                                }
                                @foreach (var row in comparison.Runs.Where(row => row.Field.LocalChanged || row.Field.CurrentChanged)) {
                                    <MergeFieldView @key="(TestLabSection.Runs, row.Key)" Label="Recorded result" Field="@row.Field" Format="FormatRun" ShowUnchanged="false" Changed="StateHasChanged" />
                                }
                            </Stack>
                            <Button Text="Apply choices to form" Disabled="@(!comparison.IsResolved || comparison.Revision != origin.Revision)"
                                    Click="@(() => View.ApplyComparisonAsync(origin, comparison))" data-testid="testlab-apply-comparison" />
                        </Stack>
                    </SurfaceCard>
                }
                <EditForm @key="origin" EditContext="origin.Context" OnValidSubmit="@(() => View.SaveAsync(origin, originVersion))">
                    <fieldset disabled="@(!Interactive)" class="min-w-0 border-0 p-0 m-0">
                    <ValidationSummary />
                    <Stack Class="min-h-full" GapScale="LayoutGap.XXLarge">
                        @if (View.State.Section == TestLabSection.Overview) {
                            <FormSection Title="Plan overview" Description="Anchor the plan to the correct project and phase before editing cases and evidence.">
                                <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                    <div>
                                        <FormField Text="Project">
                                            <SelectInput Value="editor.ProjectId" ValueExpression="@(() => editor.ProjectId)" ValueChanged="@((Guid? value) => View.ChangeProjectAsync(origin, value, originVersion))" class="form-input ui-input ui-input--outlined" data-testid="testlab-project-select">
                                                <option value="">None</option>
                                                @if (editor.ProjectId is { } unavailableProject && !View.State.Projects.Any(item => item.Id == unavailableProject)) {
                                                    <option value="@unavailableProject">Unavailable project; select explicitly to rebind</option>
                                                }
                                                @foreach (var project in View.State.Projects) {
                                                    <option value="@project.Id">@(editor.ProjectId == project.Id && editor.ExpectedProjectAdmission != project.Admission ? "Unavailable historical project" : project.Name)</option>
                                                }
                                            </SelectInput>
                                        </FormField>
                                        @if (View.State.Projects.Any(item => item.Id == editor.ProjectId && item.Admission != editor.ExpectedProjectAdmission)) {
                                            <Button Text="Use current project" Tone="ButtonTone.Default" Click="@(() => View.ChangeProjectAsync(origin, editor.ProjectId, originVersion))" />
                                        }
                                    </div>
                                    <div>
                                        <FormField Text="Phase">
                                            <TextInput @bind-Value:get="editor.Phase" @bind-Value:set="value => Edit(origin, originVersion, () => editor.Phase = value)" class="form-input ui-input ui-input--outlined" data-testid="testlab-plan-phase" @oninput="@(args => Input(origin, originVersion, editor, nameof(editor.Phase), value => editor.Phase = value, args))" />
                                        </FormField>
                                    </div>
                                </Grid>

                                <div class="max-w-xl">
                                    <label class="cda-form-field__label">Responsible party</label>
                                    <p role="status" data-testid="testlab-references-state">@ReferenceStatus</p>
                                    <SelectInput Value="editor.ResponsiblePartyId" ValueExpression="@(() => editor.ResponsiblePartyId)" ValueChanged="@((Guid? value) => View.ChangePartyAsync(origin, value, originVersion))" class="form-input ui-input ui-input--outlined" data-testid="testlab-responsible-party-select">
                                        <option value="">None</option>
                                        @if (editor.ResponsiblePartyId is { } unavailableParty && View.State.Parties.All(item => item.PartyId != unavailableParty)) {
                                            <option value="@unavailableParty">Unavailable responsible party</option>
                                        }
                                        @foreach (var option in View.State.Parties) {
                                            <option value="@option.PartyId">@option.DisplayName</option>
                                        }
                                    </SelectInput>
                                </div>

                                <FormField Text="Title">
                                    <TextInput @bind-Value:get="editor.Title" @bind-Value:set="value => Edit(origin, originVersion, () => editor.Title = value)" class="form-input ui-input ui-input--outlined" data-testid="testlab-title-input" @oninput="@(args => Input(origin, originVersion, editor, nameof(editor.Title), value => editor.Title = value, args))" />
                                </FormField>

                                <FormField Text="Coverage goal">
                                    <TextAreaInput @bind-Value:get="editor.CoverageGoal" @bind-Value:set="value => Edit(origin, originVersion, () => editor.CoverageGoal = value)" class="form-input ui-input ui-input--outlined ui-input--textarea min-h-24" data-testid="testlab-plan-coveragegoal" @oninput="@(args => Input(origin, originVersion, editor, nameof(editor.CoverageGoal), value => editor.CoverageGoal = value, args))" />
                                </FormField>

                                <FormField Text="Playwright spec path">
                                    <TextInput @bind-Value:get="editor.PlaywrightSpecPath" @bind-Value:set="value => Edit(origin, originVersion, () => editor.PlaywrightSpecPath = value)" class="form-input ui-input ui-input--outlined" data-testid="testlab-plan-playwrightspecpath" @oninput="@(args => Input(origin, originVersion, editor, nameof(editor.PlaywrightSpecPath), value => editor.PlaywrightSpecPath = value, args))" />
                                </FormField>
                            </FormSection>
                        } else if (View.State.Section == TestLabSection.Cases) {
                            <FormSection Title="Test cases" Description="Track which scenarios are planned, implemented, blocked, or already passing."
                                         Actions="caseActions">
                                @if (editor.Cases.Count == 0) {
                                    <EmptyState Eyebrow="No cases"
                                                Title="Add the first case"
                                                Description="Use cases to capture the stories or features the plan needs to cover." />
                                } else {
                                    <Stack GapScale="LayoutGap.Medium">
                                        @foreach (var testCase in editor.Cases) {
                                            <Grid @key="testCase" Gap="LayoutGap.Medium" ColumnsMd="4" Class="cda-panel-card">
                                                <TextInput @bind-Value:get="testCase.Name" @bind-Value:set="value => Edit(origin, originVersion, () => testCase.Name = value)" class="form-input ui-input ui-input--outlined" data-testid="testlab-case-name" @oninput="@(args => Input(origin, originVersion, testCase, nameof(testCase.Name), value => testCase.Name = value, args))" />
                                                <TextInput @bind-Value:get="testCase.StoryOrFeature" @bind-Value:set="value => Edit(origin, originVersion, () => testCase.StoryOrFeature = value)" class="form-input ui-input ui-input--outlined" data-testid="testlab-case-storyorfeature" @oninput="@(args => Input(origin, originVersion, testCase, nameof(testCase.StoryOrFeature), value => testCase.StoryOrFeature = value, args))" />
                                                <SelectInput @bind-Value:get="testCase.Status" @bind-Value:set="value => Edit(origin, originVersion, () => testCase.Status = value)" class="form-input ui-input ui-input--outlined" data-testid="testlab-case-status">
                                                    @foreach (var status in Enum.GetValues<TestCaseStatus>()) {
                                                        <option value="@status">@status</option>
                                                    }
                                                </SelectInput>
                                                <TextInput @bind-Value:get="testCase.Notes" @bind-Value:set="value => Edit(origin, originVersion, () => testCase.Notes = value)" class="form-input ui-input ui-input--outlined" data-testid="testlab-case-notes" @oninput="@(args => Input(origin, originVersion, testCase, nameof(testCase.Notes), value => testCase.Notes = value, args))" />
                                            <Button Text="Remove case" Tone="ButtonTone.Default" Click="@(() => Edit(origin, originVersion, () => editor.Cases.Remove(testCase)))" />
                                            </Grid>
                                        }
                                    </Stack>
                                }
                            </FormSection>
                        } else if (View.State.Section == TestLabSection.Evidence) {
                            <FormSection Title="Evidence" Description="Store screenshot paths, artifact references, and notes alongside the plan."
                                         Actions="evidenceActions">
                                @if (editor.Evidence.Count == 0) {
                                    <EmptyState Eyebrow="No evidence"
                                                Title="Add the first evidence record"
                                                Description="Evidence records keep screenshots, logs, or other artifacts tied to the plan." />
                                } else {
                                    <Stack GapScale="LayoutGap.Medium">
                                        @foreach (var evidence in editor.Evidence) {
                                            <Grid @key="evidence" Gap="LayoutGap.Medium" ColumnsMd="4" Class="cda-panel-card">
                                                <TextInput @bind-Value:get="evidence.EvidenceLabel" @bind-Value:set="value => Edit(origin, originVersion, () => evidence.EvidenceLabel = value)" class="form-input ui-input ui-input--outlined" data-testid="testlab-evidence-evidencelabel" @oninput="@(args => Input(origin, originVersion, evidence, nameof(evidence.EvidenceLabel), value => evidence.EvidenceLabel = value, args))" />
                                                <TextInput @bind-Value:get="evidence.ArtifactPath" @bind-Value:set="value => Edit(origin, originVersion, () => evidence.ArtifactPath = value)" class="form-input ui-input ui-input--outlined" data-testid="testlab-evidence-artifactpath" @oninput="@(args => Input(origin, originVersion, evidence, nameof(evidence.ArtifactPath), value => evidence.ArtifactPath = value, args))" />
                                                <TextInput @bind-Value:get="evidence.EvidenceKind" @bind-Value:set="value => Edit(origin, originVersion, () => evidence.EvidenceKind = value)" class="form-input ui-input ui-input--outlined" data-testid="testlab-evidence-evidencekind" @oninput="@(args => Input(origin, originVersion, evidence, nameof(evidence.EvidenceKind), value => evidence.EvidenceKind = value, args))" />
                                                <TextInput @bind-Value:get="evidence.Notes" @bind-Value:set="value => Edit(origin, originVersion, () => evidence.Notes = value)" class="form-input ui-input ui-input--outlined" data-testid="testlab-evidence-notes" @oninput="@(args => Input(origin, originVersion, evidence, nameof(evidence.Notes), value => evidence.Notes = value, args))" />
                                            <Button Text="Remove evidence" Tone="ButtonTone.Default" Click="@(() => Edit(origin, originVersion, () => editor.Evidence.Remove(evidence)))" />
                                            </Grid>
                                        }
                                    </Stack>
                                }
                            </FormSection>
                        } else {
                            <FormSection Title="Execution runs" Description="Keep the latest run results and notes inside the same plan instead of a separate tracker."
                                         Actions="runActions">
                                @if (editor.Runs.Count == 0) {
                                    <EmptyState Eyebrow="No runs"
                                                Title="Record the first run"
                                                Description="Run history appears here after at least one execution record has been added." />
                                } else {
                                    <Stack GapScale="LayoutGap.Medium">
                                        @foreach (var run in editor.Runs) {
                                            <Grid @key="run" Gap="LayoutGap.Medium" ColumnsMd="2" Class="cda-panel-card">
                                                <TextInput Value="@origin.Timestamp(run)" ValueChanged="@(value => Edit(origin, originVersion, () => origin.InputTimestamp(run, value)))" Immediate="true" aria-label="Executed at (ISO 8601)" data-testid="testlab-run-timestamp" />
                                                <TextInput @bind-Value:get="run.Runner" @bind-Value:set="value => Edit(origin, originVersion, () => run.Runner = value)" class="form-input ui-input ui-input--outlined" data-testid="testlab-run-runner" @oninput="@(args => Input(origin, originVersion, run, nameof(run.Runner), value => run.Runner = value, args))" />
                                                <SelectInput @bind-Value:get="run.Result" @bind-Value:set="value => Edit(origin, originVersion, () => run.Result = value)" class="form-input ui-input ui-input--outlined" data-testid="testlab-run-result">
                                                    @foreach (var status in Enum.GetValues<TestCaseStatus>()) {
                                                        <option value="@status">@status</option>
                                                    }
                                                </SelectInput>
                                                <TextInput @bind-Value:get="run.Summary" @bind-Value:set="value => Edit(origin, originVersion, () => run.Summary = value)" class="form-input ui-input ui-input--outlined" data-testid="testlab-run-summary" @oninput="@(args => Input(origin, originVersion, run, nameof(run.Summary), value => run.Summary = value, args))" />
                                            <Button Text="Remove run" Tone="ButtonTone.Default" Click="@(() => Edit(origin, originVersion, () => editor.Runs.Remove(run)))" />
                                            </Grid>
                                        }
                                    </Stack>
                                }
                            </FormSection>
                        }

                        <StickyActionFooter StatusLabel="Plan save state">
                            <SecondaryActions>
                                <p role="status" data-testid="testlab-save-state" data-state="@origin.SaveState" data-plan-id="@origin.Model.Id">@origin.Message</p>
                                <Button Text="Reset" Tone="ButtonTone.Default" Click="View.NewAsync" />
                            </SecondaryActions>
                            <PrimaryActions>
                                <Button Text="Save plan" Type="submit" data-testid="testlab-save-button" Disabled="@(!origin.CanSave || !Interactive)" />
                            </PrimaryActions>
                        </StickyActionFooter>
                    </Stack>
                    </fieldset>
                </EditForm>
                }
            </DetailContent>
        </ListDetailShell>
    </ChildContent>
</PageScaffold>

@code {
    [Parameter, EditorRequired] public ITestLabWorkspaceView View { get; set; } = default!;
    [Parameter] public bool Interactive { get; set; } = true;
    private readonly TestPlanEditorModel empty = new();
    private TestPlanEditorModel Editor => View.State.Draft?.Model ?? empty;
    private IReadOnlyList<SecondaryTabItem> DetailTabs => [
        new(nameof(TestLabSection.Overview), "Overview"),
        new(nameof(TestLabSection.Cases), "Cases", Editor.Cases.Count.ToString()),
        new(nameof(TestLabSection.Evidence), "Evidence", Editor.Evidence.Count.ToString()),
        new(nameof(TestLabSection.Runs), "Runs", Editor.Runs.Count.ToString())
    ];
    private TestCaseStatus? LatestRunResult => Editor.Runs.OrderByDescending(run => run.ExecutedAtUtc).FirstOrDefault()?.Result;
    private void HandleDetailTabChanged(string key) => View.SelectSection(Enum.Parse<TestLabSection>(key));
    private string BuildPlanMeta(TestPlanSummary plan) => $"{View.State.ProjectName(plan)} / {plan.CaseCount} case(s) / {plan.EvidenceCount} evidence item(s)";
    private static string BuildPlanSummary(TestPlanSummary plan) => $"Updated {plan.UpdatedAtUtc.LocalDateTime:g}";
    private string ListStatus => View.State.PlansRead switch {
        TestLabReadState.Loading => "Loading plans...",
        TestLabReadState.Unavailable => "Plans unavailable. Retry refresh.",
        TestLabReadState.Stale => "Refresh failed. Previously loaded plans are shown.",
        TestLabReadState.Empty => "No saved plans.",
        _ => $"{View.State.VisiblePlans.Count} matching plans"
    };
    private string EditorStatus => View.State.EditorRead switch {
        TestLabReadState.Loading => "Loading plan...",
        TestLabReadState.Missing => "Requested plan was not found. Select another plan or start a new draft.",
        TestLabReadState.Unavailable => "Plan unavailable. Retry refresh.",
        TestLabReadState.Stale => "Saved plan refresh is incomplete. Your draft is retained.",
        _ => string.Empty
    };
    private string ReferenceStatus => string.Join(" ", new[] {
        ReferenceMessage(View.State.ProjectsRead, "Project choices"),
        ReferenceMessage(View.State.PartiesRead, "Responsible parties")
    }.Where(message => message.Length > 0));
    private static string ReferenceMessage(TestLabReadState state, string label) => state switch {
        TestLabReadState.Loading => $"{label} are loading...",
        TestLabReadState.Unavailable => $"{label} are unavailable. Retry refresh.",
        TestLabReadState.Stale => $"{label} could not be refreshed. Previously loaded choices are shown.",
        _ => string.Empty
    };
    private void Input(TestLabDraft origin, long version, object model, string field, Action<string> assign, ChangeEventArgs args) {
        if (ReferenceEquals(View.State.Draft, origin) && origin.TargetVersion == version) {
            origin.Input(model, field, assign, args.Value?.ToString());
        }
    }
    private void Edit(TestLabDraft origin, long version, Action edit) {
        if (ReferenceEquals(View.State.Draft, origin) && origin.TargetVersion == version) {
            edit();
            origin.Edited();
        }
    }
    private string FormatProject(TestLabPlanComparison.ProjectValue value) {
        var project = View.State.Projects.FirstOrDefault(item => item.Id == value.Id)?.Name ?? value.Id?.ToString("D") ?? "Global plan";
        var party = View.State.Parties.FirstOrDefault(item => item.PartyId == value.PartyId)?.DisplayName ?? value.PartyId?.ToString("D") ?? "No responsible party";
        return $"{project}\n{party}";
    }
    private static string FormatCase(MergeEntry<TestLabPlanComparison.CaseValue> entry)
        => entry.Value is { } value ? $"{value.Name} · {value.Status}\n{value.Feature}\n{value.Notes}" : "Absent";
    private static string FormatEvidence(MergeEntry<TestLabPlanComparison.EvidenceValue> entry)
        => entry.Value is { } value ? $"{value.Label} · {value.Kind}\n{value.Path}\n{value.Notes}" : "Absent";
    private static string FormatRun(MergeEntry<TestLabPlanComparison.RunValue> entry)
        => entry.Value is { } value ? $"{value.Runner} · {value.Result}\n{value.RawTime ?? value.ExecutedAt.ToString("O")}\n{value.Summary}" : "Absent";
    private static string ResolveStatusTone(TestCaseStatus? status) => status switch {
        TestCaseStatus.Passed => "success",
        TestCaseStatus.Failed => "danger",
        TestCaseStatus.Blocked => "warning",
        TestCaseStatus.Implemented => "info",

@{
    var editor = View.Editor;
    var providerModel = editor.Model;
    var target = new ProviderEditorTarget(View.State.ProviderId, View.Activation, View.Editor.Context);
    var slot = new ProviderHostSlotContext(target, View.State.Section, View.SourceManaged);
}
<ListDetailShell ListPaneWidth="25rem"
                 data-testid="agents-provider-profiles-panel" data-editor-activation="@target.Activation">
    <ListHeader>
        <ListPanelHeader Title="Provider profiles" Dense="true">
            <Actions>
                <Cluster Wrap="FlexWrap.NoWrap" Gap="LayoutGap.Tiny">
                    <Button Icon="add" title="New provider" aria-label="New provider"
                            Tone="ButtonTone.Default" Size="ButtonSize.Small"
                            Click="@(() => ResetProviderAsync(target))" data-testid="providers-new" />
                    <Button Icon="refresh" title="Refresh providers" aria-label="Refresh providers"
                            Tone="ButtonTone.Default" Size="ButtonSize.Small"
                            Click="LoadAsync" data-testid="providers-refresh" />
                    <Button Icon="hub" title="Shared provider connections" aria-label="Shared provider connections"
                            Tone="ButtonTone.Default" Size="ButtonSize.Small"
                            Click="@(() => sharedConnectionsOpen = true)" data-testid="providers-connections" />
                </Cluster>
            </Actions>
            <Filters>
                <Cluster Wrap="FlexWrap.NoWrap" Gap="LayoutGap.Tiny" data-testid="providers-filter">
                    <TextInput Immediate="true" @bind-Value="providerSearch"
                           class="form-input ui-input ui-input--outlined min-w-0 flex-1" placeholder="Search providers"
                           aria-label="Search providers" data-testid="providers-search" />
                    <Button Icon="filter_alt_off" title="Reset filter" aria-label="Reset provider filter"
                            Tone="ButtonTone.Default" Size="ButtonSize.Small"
                            Click="ResetProviderSearch" data-testid="providers-search-reset" />
                    <span class="shrink-0 text-xs text-[var(--tone-text-muted)]" data-testid="providers-filter-count"
                          aria-label="Provider results">@FilteredProviders.Count / @providers.Count</span>
                </Cluster>
            </Filters>
        </ListPanelHeader>
    </ListHeader>

    <ListContent>
        @if (isLoading) {
            <EmptyState Eyebrow="Loading"
                        Title="Loading provider catalog"
                        Description="AgentFramework is reading persisted and seeded provider profiles." />
        } else if (FilteredProviders.Count == 0) {
            <EmptyState Eyebrow="No providers"
                        Title="No provider profiles match the current filter"
                        Description="Clear the search filter or create a provider profile." />
        } else {
            <TreeView Items="@ProviderTreeNodes"
                      Style="TreeViewStyle.Workbench"
                      AriaLabel="Provider profiles grouped by tag"
                      EmptyText="No provider profiles are available."
                      OnSelect="HandleProviderTreeSelectAsync"
                      OnToggle="HandleProviderTreeToggleAsync"
                      data-testid="providers-tree" />
        }
    </ListContent>

    <DetailHeader>
        <Stack GapScale="LayoutGap.Tiny">
            <TextBlock TextStyle="TextStyle.EyebrowCaption">Provider editor</TextBlock>
            <h2 class="cda-text-block cda-text-block--h4">@(View.State.ProviderId.HasValue
                ? View.CanEdit ? providerModel.Name : SelectedProvider?.Name ?? "Unavailable provider"
                : "New provider profile")</h2>
            <TextBlock TextStyle="TextStyle.Muted" Class="leading-5">@ResolveSelectedProviderStatus()</TextBlock>
        </Stack>
    </DetailHeader>

    <DetailContent>
        @if (View.CatalogChanged) {
            <Alert AlertStyle="AlertStyle.Info" data-testid="providers-catalog-changed">The provider catalog changed. Refresh providers to update the list; the open draft stays available.</Alert>
        }
        @if (View.NeedsComparison) {
            <Alert AlertStyle="AlertStyle.Warning" data-testid="providers-changed">
                The saved provider changed. Your draft is retained; compare before another write.
                <Button Text="Compare provider" Disabled="@(isBusy || View.IsWriteUnconfirmed)" Click="@(() => View.ExecuteAsync(new(target, ProviderEditorAction.Compare)))" data-testid="providers-compare" />
            </Alert>
        }
        @if (View.Comparison is { } review) {
            <Stack GapScale="LayoutGap.Small">
                <ProviderComparisonSurface Review="review" Changed="StateHasChanged" />
                <Cluster Gap="LayoutGap.Small">
                    <Button Text="Apply locally" Disabled="@(!review.CanApply || isBusy)" Click="@(() => View.ExecuteAsync(new(target, ProviderEditorAction.ApplyComparison)))" data-testid="providers-comparison-apply" />
                    <Button Text="Cancel comparison" Tone="ButtonTone.Default" Click="@(() => View.ExecuteAsync(new(target, ProviderEditorAction.CancelComparison)))" data-testid="providers-comparison-cancel" />
                </Cluster>
            </Stack>
        }
        @if (View.CanReviewCurrent) {
            <Alert AlertStyle="AlertStyle.Warning">
                The exact accepted version is unavailable. Read the current saved version and explicitly review it before continuing with this draft. This does not establish the earlier write's outcome.
                <Button Text="Review current saved version" Disabled="@isBusy" Click="@(() => View.ExecuteAsync(new(target, ProviderEditorAction.ReviewCurrent)))" data-testid="providers-review-current" />
            </Alert>
        }
        @if (View.RecoveryReview is { } recoveryReview) {
            <ProviderRecoveryReviewSurface Review="recoveryReview" Changed="StateHasChanged" />
            <Cluster Gap="LayoutGap.Small">
                <Button Text="Keep draft against reviewed version" Disabled="@(isBusy || !recoveryReview.CanApply)" Click="@(() => View.ExecuteAsync(new(target, ProviderEditorAction.ApplyCurrentReview)))" data-testid="providers-recovery-apply" />
                <Button Text="Cancel review" Tone="ButtonTone.Default" Click="@(() => View.ExecuteAsync(new(target, ProviderEditorAction.CancelComparison)))" />
            </Cluster>
        }
        @if (View.HasPendingReconciliation) {
            <Alert AlertStyle="AlertStyle.Warning" data-testid="providers-reconciliation-pending">
                The provider change is saved. Reconcile its current state before another write.
                <Button Text="Reconcile saved change" Icon="refresh" Disabled="@isBusy"
                        Click="@(() => View.ExecuteAsync(new(target, ProviderEditorAction.Reconcile)))" data-testid="providers-reconcile" />
            </Alert>
        }
        @if (View.IsWriteUnconfirmed) {
            <Alert AlertStyle="AlertStyle.Danger" data-testid="providers-write-unconfirmed">
                The write outcome is unconfirmed. Verify this exact provider attempt before another write.
                <Button Text="Verify provider write" Icon="refresh" Disabled="@isBusy"
                        Click="@(() => View.ExecuteAsync(new(target, ProviderEditorAction.Verify)))" data-testid="providers-verify" />
                @if (View.CanAcknowledgeDiagnostic) {
                    <TextBlock Value="Only diagnostic metadata was requested. You can read current metadata and keep this outcome unconfirmed while continuing with your draft. This does not repeat the diagnostic or adopt another configuration version." />
                    <Button Text="Read metadata and continue with draft" Disabled="@isBusy"
                            Click="@(() => View.ExecuteAsync(new(target, ProviderEditorAction.AcknowledgeDiagnostic)))" data-testid="providers-acknowledge-diagnostic" />
                }
            </Alert>
        }
        @if (View.HasVerifiedRetry) {
            <Alert AlertStyle="AlertStyle.Warning" data-testid="providers-verified-absent">
                The write was not committed. A controlled retry retains the same identity and submission.
                <Button Text="Retry verified write" Disabled="@isBusy" Click="@(() => View.ExecuteAsync(new(target, ProviderEditorAction.RetryVerified)))" data-testid="providers-retry-verified" />
            </Alert>
        }
        @if (View.MetadataWarning is { } metadataWarning) {
            <Alert AlertStyle="AlertStyle.Warning" data-testid="providers-metadata-warning">@metadataWarning</Alert>
        }
        @if (View.Error is { } error) {
            <Stack GapScale="LayoutGap.Medium" data-testid="providers-load-failed">
                <Alert AlertStyle="AlertStyle.Danger">@error</Alert>
                <Button Text="Retry" Icon="refresh" Click="LoadAsync" data-testid="providers-load-retry" />
            </Stack>
        } else if (!View.CanEdit) {
            <Stack data-testid="providers-editor-loading">
                <EmptyState Title="Loading provider editor" Description="Reading the selected provider profile." />
            </Stack>
        } else {
            @if (View.SecretMetadataError is { } secretError) {
                <Alert AlertStyle="AlertStyle.Warning" data-testid="providers-secret-warning">
                    Secret metadata could not be loaded: @secretError. Saved references are retained.
                </Alert>
            }
                <div class="agent-provider-editor-tabs-shell">
                    <Tabs @key="(target.ProviderId, target.Activation)" SelectedIndex="@providerEditorTabIndex"
                          SelectedIndexChanged="@(index => SelectSection(target, index))"
                          RenderMode="TabRenderMode.Client"
                          Density="TabsDensity.Compact"
                          OverflowMode="TabsOverflowMode.Wrap"
                          Class="agent-provider-editor-tabs"
                          AriaLabel="Provider editor tabs"
                          data-testid="provider-editor-tabs">
                        @foreach (var definition in ProviderEditorSections.All) {
                            <TabsItem @key="definition.Section" Text="@definition.Label" Icon="@definition.Icon"
                                      data-testid="@($"provider-editor-tab-{ProviderEditorSections.Token(definition.Section)}")">
                                @switch (definition.Section) {
                                    case ProviderEditorSection.Connection:

                            <ProviderProfileEditorForm Context="providerEditContext" Active="@(View.State.Section == definition.Section)" CanManage="@(!SelectedProviderIsSourceManaged)"
                                                       HasSavedProvider="@providerModel.Id.HasValue" IsBusy="@isBusy" WritesBlocked="@View.WritesBlocked"
                                                       Save="@(() => View.ExecuteAsync(new(target, ProviderEditorAction.Save)))" Clear="@(() => ResetProviderAsync(target))"
                                                       Health="@(() => View.ExecuteAsync(new(target, ProviderEditorAction.Health)))"
                                                       Delete="@(() => View.ExecuteAsync(new(target, ProviderEditorAction.Delete)))">
                            <fieldset disabled="@SelectedProviderIsSourceManaged"
                                      class="agent-provider-readonly-fields">
                            <div class="agent-provider-connection-tab">
                                <FormSection Title="Identity" Description="Provider identity, endpoint, model, and grouping tags. Tags drive the tree and future capability search.">
                                <Grid Gap="LayoutGap.Large" ColumnsMd="2" ColumnsXl="4">
                                    <FormField Text="Name">
                                        <TextInput Immediate="true" @bind-Value:get="providerModel.Name" @bind-Value:set="@(value => SetField(target, editor, nameof(providerModel.Name), value, accepted => providerModel.Name = accepted))"
                                                   class="form-input ui-input ui-input--outlined"
                                                   data-testid="providers-name-input" />
                                    </FormField>
                                    <FormField Text="Default model">
                                        <TextInput Immediate="true" Value="@ProviderDefaultModelText" ValueChanged="@(value => SetField(target, editor, nameof(providerModel.DefaultModel), value, accepted => providerModel.DefaultModel = accepted ?? string.Empty))"
                                                   class="form-input ui-input ui-input--outlined"
                                                   data-testid="providers-model-input" />
                                    </FormField>
                                    <FormField Text="Provider kind">
                                        <SelectInput TValue="ProviderKind" Value="@providerModel.Kind"
                                                     ValueChanged="@(value => ChangeProviderKind(target, value))"
                                                     ValueExpression="@(() => providerModel.Kind)"
                                                     class="form-input ui-input ui-input--outlined"
                                                     data-testid="providers-kind-select">
                                            @foreach (var kind in Enum.GetValues<ProviderKind>()) {
                                                <option value="@kind">@kind</option>
                                            }
                                        </SelectInput>
                                    </FormField>
                                    <FormField Text="Purpose">
                                        <SelectInput @bind-Value:get="providerModel.Purpose" @bind-Value:set="@(value => SetField(target, editor, nameof(providerModel.Purpose), value, accepted => providerModel.Purpose = accepted))"
                                                     class="form-input ui-input ui-input--outlined"
                                                     data-testid="providers-purpose-select">
                                            @foreach (var purpose in Enum.GetValues<ProviderProfilePurpose>()) {
                                                <option value="@purpose">@purpose</option>
                                            }
                                        </SelectInput>
                                    </FormField>
                                </Grid>

                                <FormField Text="Base URL">
                                    <TextInput Immediate="true" @bind-Value:get="providerModel.BaseUrl" @bind-Value:set="@(value => SetField(target, editor, nameof(providerModel.BaseUrl), value, accepted => providerModel.BaseUrl = accepted))"
                                               class="form-input ui-input ui-input--outlined"
                                               data-testid="providers-base-url-input" />
                                </FormField>

                                <div>
                                    <FormField Text="API key secret">
                                        <SelectInput @bind-Value:get="providerModel.ApiKeyEnvironmentVariable" @bind-Value:set="@(value => SetField(target, editor, nameof(providerModel.ApiKeyEnvironmentVariable), value, accepted => providerModel.ApiKeyEnvironmentVariable = accepted))"
                                                     class="form-input ui-input ui-input--outlined"
                                                     data-testid="providers-api-key-input">
                                            <option value="">None</option>
                                            @if (HasUnlistedSecretReference) {
                                                <option value="@providerModel.ApiKeyEnvironmentVariable">@(View.SecretMetadataError is null ? "Unavailable saved secret" : "Unverified saved secret")</option>
                                            }
                                            @foreach (var secret in secrets) {
                                                <option value="@secret.Reference">@secret.Name</option>
                                            }
                                        </SelectInput>
                                    </FormField>
                                    @if (HasUnlistedSecretReference) {
                                        <TextBlock TextStyle="TextStyle.Muted" Class="leading-5 mt-1">@(View.SecretMetadataError is null ? "The saved secret reference is no longer available in the vault. Select another secret before saving." : "Secret metadata is unavailable. The saved reference has not been verified and is retained.")</TextBlock>
                                    } else if (secrets.Count == 0 && View.SecretMetadataError is null) {
                                        <TextBlock TextStyle="TextStyle.Muted" Class="leading-5 mt-1">Add an API key in Settings → Secrets, then refresh this provider list.</TextBlock>
                                    }
                                </div>

                                <TagEditor Value="@providerTagValues"
                                           PendingInput="@editor.PendingTag" PendingInputChanged="@(value => SetPendingTag(target, editor, value))"
                                           onkeydown="if (event.key === 'Enter' &amp;&amp; event.target instanceof HTMLInputElement) event.preventDefault();"
                                           ValueChanged="@(value => ChangeProviderTags(target, value))"
                                           Suggestions="@AvailableProviderTags"
                                           Placeholder="Add provider tag"
                                           Hint="Use tags such as openai, ollama, local, cloud, chat, image, or fallback."
                                           MaxTags="12"
                                           TestId="providers-tags"
                                           InputTestId="providers-tags-input" />
                                </FormSection>
                            </div>
                            </fieldset>
                            </ProviderProfileEditorForm>

                                        break;
                                    case ProviderEditorSection.Prices:

                            <ProviderProfileEditorForm Context="providerEditContext" Active="@(View.State.Section == definition.Section)" CanManage="@(!SelectedProviderIsSourceManaged)"
                                                       HasSavedProvider="@providerModel.Id.HasValue" IsBusy="@isBusy" WritesBlocked="@View.WritesBlocked"
                                                       Save="@(() => View.ExecuteAsync(new(target, ProviderEditorAction.Save)))" Clear="@(() => ResetProviderAsync(target))"
                                                       Health="@(() => View.ExecuteAsync(new(target, ProviderEditorAction.Health)))"
                                                       Delete="@(() => View.ExecuteAsync(new(target, ProviderEditorAction.Delete)))">
                            <fieldset disabled="@SelectedProviderIsSourceManaged"
                                      class="agent-provider-readonly-fields">
                            <div class="agent-provider-prices-tab">
                                <ProviderModelPricingEditor @key="providerModel" Model="providerModel"
                                                            ModelNames="@providerModel.SuggestedModels"
                                                            SourceManaged="@SelectedProviderIsSourceManaged"
                                                            Provider="@SelectedProvider"
                                                            PricingKind="@providerModel.Kind"
                                                            DefaultModel="@providerModel.DefaultModel"
                                                            OnRefreshPrices="@(() => View.ExecuteAsync(new(target, ProviderEditorAction.DiscoverModels)))" />
                            </div>
                            </fieldset>
                            </ProviderProfileEditorForm>

                                        break;
                                    case ProviderEditorSection.Runtime:

                            <ProviderProfileEditorForm Context="providerEditContext" Active="@(View.State.Section == definition.Section)" CanManage="@(!SelectedProviderIsSourceManaged)"
                                                       HasSavedProvider="@providerModel.Id.HasValue" IsBusy="@isBusy" WritesBlocked="@View.WritesBlocked"
                                                       Save="@(() => View.ExecuteAsync(new(target, ProviderEditorAction.Save)))" Clear="@(() => ResetProviderAsync(target))"
                                                       Health="@(() => View.ExecuteAsync(new(target, ProviderEditorAction.Health)))"
                                                       Delete="@(() => View.ExecuteAsync(new(target, ProviderEditorAction.Delete)))">
                            <fieldset disabled="@SelectedProviderIsSourceManaged"
                                      class="agent-provider-readonly-fields">
                            <div class="agent-provider-runtime-tab">
                                <FormSection Title="Runtime behavior" Description="Keep transport and advertised runtime capabilities explicit.">
                                    <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                        <FormField Text="Transport">
                                            <SelectInput @bind-Value:get="providerModel.Transport" @bind-Value:set="@(value => SetField(target, editor, nameof(providerModel.Transport), value, accepted => providerModel.Transport = accepted))"
                                                         class="form-input ui-input ui-input--outlined"
                                                         data-testid="providers-transport-select">
                                                @foreach (var transport in Enum.GetValues<ProviderTransportKind>()) {
                                                    <option value="@transport">@transport</option>
                                                }
                                            </SelectInput>
                                        </FormField>
                                        <FormField Text="Suggested models">
                                            <TextAreaInput Immediate="true" Value="@suggestedModelsText" ValueChanged="@(value => ChangeSuggestedModels(target, value))"
                                                      class="form-input ui-input ui-input--outlined min-h-[7rem]"
                                                      data-testid="providers-suggested-models"></TextAreaInput>
                                        </FormField>
                                    </Grid>

                                    <Grid Gap="LayoutGap.Medium" ColumnsMd="2" ColumnsXl="3">
                                        <label class="ui-checkbox-option"><InputCheckbox class="form-checkbox ui-checkbox ui-checkbox--outlined" @bind-Value:get="providerModel.IsEnabled" @bind-Value:set="@(value => SetField(target, editor, nameof(providerModel.IsEnabled), value, accepted => providerModel.IsEnabled = accepted))" /> Enabled</label>
                                        <label class="ui-checkbox-option"><InputCheckbox class="form-checkbox ui-checkbox ui-checkbox--outlined" @bind-Value:get="providerModel.SupportsStreaming" @bind-Value:set="@(value => SetField(target, editor, nameof(providerModel.SupportsStreaming), value, accepted => providerModel.SupportsStreaming = accepted))" /> Streaming</label>
                                        <label class="ui-checkbox-option"><InputCheckbox class="form-checkbox ui-checkbox ui-checkbox--outlined" @bind-Value:get="providerModel.SupportsTools" @bind-Value:set="@(value => SetField(target, editor, nameof(providerModel.SupportsTools), value, accepted => providerModel.SupportsTools = accepted))" /> Tool calling</label>
                                        <label class="ui-checkbox-option"><InputCheckbox class="form-checkbox ui-checkbox ui-checkbox--outlined" @bind-Value:get="providerModel.PreferFrameworkManagedChatHistory" @bind-Value:set="@(value => SetField(target, editor, nameof(providerModel.PreferFrameworkManagedChatHistory), value, accepted => providerModel.PreferFrameworkManagedChatHistory = accepted))" /> Framework-managed history</label>
                                        <label class="ui-checkbox-option"><InputCheckbox class="form-checkbox ui-checkbox ui-checkbox--outlined" @bind-Value:get="providerModel.SupportsBackgroundResponses" @bind-Value:set="@(value => SetField(target, editor, nameof(providerModel.SupportsBackgroundResponses), value, accepted => providerModel.SupportsBackgroundResponses = accepted))" /> Background responses</label>
                                    </Grid>
                                </FormSection>

                                <FormSection Title="Configuration and notes" Description="Advanced provider metadata. Keep JSON valid and explicit.">
                                    <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                        <FormField Text="Configuration JSON">
                                            <TextAreaInput Immediate="true" @bind-Value:get="providerModel.ConfigurationJson" @bind-Value:set="@(value => SetField(target, editor, nameof(providerModel.ConfigurationJson), value, accepted => providerModel.ConfigurationJson = accepted))"
                                                           class="form-input ui-input ui-input--outlined min-h-[12rem] font-mono text-xs"
                                                           data-testid="providers-config-json" />
                                        </FormField>
                                        <FormField Text="Notes">
                                            <TextAreaInput Immediate="true" @bind-Value:get="providerModel.Notes" @bind-Value:set="@(value => SetField(target, editor, nameof(providerModel.Notes), value, accepted => providerModel.Notes = accepted))"
                                                           class="form-input ui-input ui-input--outlined min-h-[12rem]"
                                                           data-testid="providers-notes" />
                                        </FormField>
                                    </Grid>
                                </FormSection>
                            </div>
                            </fieldset>
                            </ProviderProfileEditorForm>

                                        break;
                                    case ProviderEditorSection.Thinking:

                            <ProviderProfileEditorForm Context="providerEditContext" Active="@(View.State.Section == definition.Section)" CanManage="@(!SelectedProviderIsSourceManaged)"
                                                       HasSavedProvider="@providerModel.Id.HasValue" IsBusy="@isBusy" WritesBlocked="@View.WritesBlocked"
                                                       Save="@(() => View.ExecuteAsync(new(target, ProviderEditorAction.Save)))" Clear="@(() => ResetProviderAsync(target))"
                                                       Health="@(() => View.ExecuteAsync(new(target, ProviderEditorAction.Health)))"
                                                       Delete="@(() => View.ExecuteAsync(new(target, ProviderEditorAction.Delete)))">
                            <ProviderThinkingSurface @key="providerModel" Model="providerModel" Provider="SelectedProvider" Draft="View.Editor">
                                <SourceRefresh>@SourceRefreshSlot?.Invoke(slot with { Section = ProviderEditorSection.Thinking })</SourceRefresh>
                            </ProviderThinkingSurface>
                            </ProviderProfileEditorForm>

                                        break;
                                    case ProviderEditorSection.Sharing:

                            @if (View.State.SharingActivated || View.State.Section == ProviderEditorSection.Sharing) {
                                @SharingSlot?.Invoke(slot)
                            }

                                        break;
                                    case ProviderEditorSection.History:

                            @if (View.State.Section == ProviderEditorSection.History) {
                                @HistorySlot?.Invoke(slot)
                            }

                                        break;
                                }
                            </TabsItem>
                        }
                    </Tabs>
                </div>

        }
    </DetailContent>
</ListDetailShell>

@if (sharedConnectionsOpen) {
    @ConnectionsSlot?.Invoke(slot)
}

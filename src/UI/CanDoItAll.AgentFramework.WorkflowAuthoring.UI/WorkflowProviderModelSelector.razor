<ConversationProviderModelSelector Provider="@Presentation" Value="@Value" ValueChanged="ValueChanged"
                                   UseEmptyValueForProviderDefault="UseEmptyValueForProviderDefault"
                                   Disabled="Disabled" TestId="@TestId" ChoiceTestId="@ChoiceTestId"
                                   OverrideTestId="@OverrideTestId" CustomModelTestId="@CustomModelTestId" />

@code {
    [Parameter] public WorkflowProviderOption? WorkflowProvider { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public bool UseEmptyValueForProviderDefault { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? TestId { get; set; }
    [Parameter] public string? ChoiceTestId { get; set; }
    [Parameter] public string? OverrideTestId { get; set; }
    [Parameter] public string? CustomModelTestId { get; set; }

    private ConversationProviderOption? Presentation => WorkflowProvider is { } provider
        ? new(new(provider.ProviderProfileId.ToString("D")), provider.Name, provider.IsEnabled,
            provider.DefaultModel, provider.ModelOptions) {
            ModelDisplayNames = System.Collections.Immutable.ImmutableDictionary.CreateRange(
                StringComparer.Ordinal, provider.ModelCatalog.Select(model => KeyValuePair.Create(model.Id, model.DisplayName))),
            AllowsModelOverride = !provider.IsSourceManaged
        }
        : null;
}

<Stack GapScale="LayoutGap.Large" data-testid="prompt-compatibility-warning-dialog">
    <Alert AlertStyle="@SummaryAlertStyle" Variant="Variant.Outlined">
        @if (Presentation.CanUse)
        {
            <TextBlock Value="The selected prompt is not declared as fully compatible with this context." />
        }
        else
        {
            <TextBlock Value="The selected prompt cannot be inserted in this context." />
        }
    </Alert>

    <SurfaceCard Soft="true">
        <Stack GapScale="LayoutGap.Small">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="@Presentation.Title" />
            <TextBlock Value="@Presentation.Summary" />
            <Cluster Gap="LayoutGap.Tiny" Wrap="FlexWrap.Wrap">
                <StatusBadge Tone="accent" Text="@PromptGalleryText.FormatKind(Presentation.Kind)" />
                @if (Presentation.VersionNumber.HasValue)
                {
                    <StatusBadge Tone="neutral" Text="@($"Version {Presentation.VersionNumber.Value}")" />
                }
                else
                {
                    <StatusBadge Tone="info" Text="Draft" />
                }
            </Cluster>
        </Stack>
    </SurfaceCard>

    <Stack GapScale="LayoutGap.Small">
        @foreach (var issue in Presentation.VisibleIssues)
        {
            <Alert AlertStyle="@IssueStyle(issue)" Variant="Variant.Outlined">
                <Stack GapScale="LayoutGap.Tiny">
                    <TextBlock Value="@issue.Message" />
                    <Cluster Gap="LayoutGap.Small">
                        <StatusBadge Tone="@IssueTone(issue)" Text="@issue.Severity.ToString()" />
                        <StatusBadge Tone="neutral" Text="@PromptGalleryText.FormatIssueCode(issue.Code)" />
                        @if (issue.IsSuppressible)
                        {
                            <StatusBadge Tone="info" Text="Can be suppressed for this item" />
                        }
                    </Cluster>
                </Stack>
            </Alert>
        }
    </Stack>

    <Cluster Gap="LayoutGap.Small" JustifyContent="JustifyContent.End" Wrap="FlexWrap.Wrap">
        <Button Text="Cancel"
                Icon="close"
                ButtonStyle="ButtonStyle.Light"
                Variant="Variant.Outlined"
                Click="@(() => DecideAsync(PromptCompatibilityWarningDecision.Cancel))"
                data-testid="prompt-compatibility-cancel" />
        @if (Presentation.CanUse)
        {
            <Button Text="Insert anyway"
                    Icon="add_circle"
                    ButtonStyle="ButtonStyle.Warning"
                    Click="@(() => DecideAsync(PromptCompatibilityWarningDecision.InsertAnyway))"
                    data-testid="prompt-compatibility-insert" />
            @if (Presentation.CanSuppressAll)
            {
                <Button Text="Insert anyway and do not display on this item anymore"
                        Icon="notifications_off"
                        ButtonStyle="ButtonStyle.Warning"
                        Variant="Variant.Outlined"
                        Click="@(() => DecideAsync(PromptCompatibilityWarningDecision.InsertAndSuppress))"
                        data-testid="prompt-compatibility-insert-suppress" />
            }
        }
    </Cluster>
</Stack>

@code {
    [Parameter, EditorRequired]
    public PromptCompatibilityWarningPresentation Presentation { get; set; } = default!;

    [Parameter]
    public EventCallback<PromptCompatibilityWarningDecision> Decision { get; set; }

    private AlertStyle SummaryAlertStyle
        => Presentation.CanUse ? AlertStyle.Warning : AlertStyle.Danger;

    private Task DecideAsync(PromptCompatibilityWarningDecision decision)
        => Decision.InvokeAsync(decision);

    private static AlertStyle IssueStyle(PromptCompatibilityIssue issue)
        => issue.Severity == PromptCompatibilitySeverity.Error ? AlertStyle.Danger : AlertStyle.Warning;

    private static string IssueTone(PromptCompatibilityIssue issue)
        => issue.Severity == PromptCompatibilitySeverity.Error ? "danger" : "warning";
}

@using CanDoItAll.Modules.Security
@using Microsoft.AspNetCore.Components.Forms
@namespace CanDoItAll.Workbench.Operators.UI.Secrets
@{
    var state = State;
}

<CanvasOverlayDialog AriaLabel="Select stored secret for project structure" Kicker="Secret reference"
                     Title="@(state.IsEdit ? "Edit secret reference" : "Add secret reference")"
                     Summary="Select metadata for an existing secret or create a vault record. The project stores only a reference."
                     DialogClass="operators-secret-dialog" FillBody="true" Close="Close">
    <Actions>
        <Button Text="Close" Icon="close" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Click="Close" />
    </Actions>
    <Body>
        <div class="operator-secret-layout">
        <EditForm @key="state.OpeningId" EditContext="@state.EditContext" OnSubmit="@(() => UseAsync(state))" class="operator-secret-form">
            <Stack GapScale="LayoutGap.Large" AlignItems="AlignItems.Stretch" Class="operator-secret-body" data-testid="project-structure-secret-dialog">
                @if (state.IsLoading) {
                    <TextBlock Value="Loading secret metadata..." />
                }
                @if (!string.IsNullOrEmpty(state.Message)) {
                    <Alert AlertStyle="AlertStyle.Warning">@state.Message</Alert>
                }
                @if (state.VaultWarning is { } warning) {
                    <Alert AlertStyle="AlertStyle.Warning">@warning</Alert>
                }
                @if (state.Receipt is { } receipt) {
                    <Alert AlertStyle="AlertStyle.Info" data-testid="project-structure-secret-receipt">
                        @receipt.Message
                        @if (receipt.SecretId is { } id) {
                            <TextBlock Value="@($"Secret {id:D}")" />
                        }
                        @if (receipt.NodeId is { } node) {
                            <TextBlock Value="@($"Reference {node}")" />
                        }
                    </Alert>
                }
                <Grid Gap="LayoutGap.Medium" ColumnsMd="2">
                    <FormField Text="Stored secret">
                        <select class="cda-input" value="@state.Draft.SelectedId?.ToString("D")" @onchange="@(args => Select(state, args))"
                                disabled="@Disabled(state)" data-testid="project-structure-secret-select">
                            <option value="">Select stored secret</option>
                            @if (state.Draft.SelectedId is { } missing && state.Items.All(item => item.Id != missing)) {
                                <option value="@missing.ToString("D")" disabled>Unavailable saved secret (@missing.ToString("D"))</option>
                            }
                            @foreach (var item in Choices(state)) {
                                <option value="@item.Id.ToString("D")">@item.Name (@item.Kind)</option>
                            }
                        </select>
                    </FormField>
                    <FormField Text="Search stored secrets">
                        <TextBox Value="@state.Draft.Search" ValueChanged="@(value => Change(state, nameof(state.Draft.Search), () => state.Draft.Search = value ?? string.Empty))" Immediate="true" Disabled="@Disabled(state)" data-testid="project-structure-secret-search" />
                    </FormField>
                </Grid>
                @if (!state.IsLoading && !state.IsUnavailable && state.Items.Count == 0) {
                    <Alert AlertStyle="AlertStyle.Info">No stored secrets are available. Create a new secret below.</Alert>
                } else if (!state.IsLoading && state.Draft.SelectedId is { } selected && state.Items.All(item => item.Id != selected)) {
                    <Alert AlertStyle="AlertStyle.Warning">The saved identity is unavailable. It has not been replaced or resolved by name.</Alert>
                } else if (!state.IsLoading && !state.IsUnavailable && !Choices(state).Any()) {
                    <Alert AlertStyle="AlertStyle.Info">No metadata matches the search.</Alert>
                }
                <Grid Gap="LayoutGap.Medium" ColumnsMd="2">
                    <FormField Text="Purpose"><TextBox Value="@state.Draft.Purpose" ValueChanged="@(value => Change(state, nameof(state.Draft.Purpose), () => state.Draft.Purpose = value ?? string.Empty))" Immediate="true" Disabled="@Disabled(state)" data-testid="project-structure-secret-purpose" /></FormField>
                    <FormField Text="Reference note"><TextBox Value="@state.Draft.Note" ValueChanged="@(value => Change(state, nameof(state.Draft.Note), () => state.Draft.Note = value ?? string.Empty))" Immediate="true" Disabled="@Disabled(state)" data-testid="project-structure-secret-external-reference" /></FormField>
                </Grid>
                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                    <CopyButton Value="@Selected(state)?.Name" Text="Copy selected name" Size="CopyButtonSize.Small" Disabled="@(Selected(state) is null)" />
                </Cluster>
                <FormSection Title="Create new secret" Icon="shield" Description="Vault creation and the project reference are separate commits. A saved vault object is retained if the reference cannot finish.">
                    <Grid Gap="LayoutGap.Medium" ColumnsMd="2">
                        <FormField Text="Name"><TextBox Value="@state.Draft.Create.Name" ValueChanged="@(value => Change(state, nameof(state.Draft.Create), () => state.Draft.Create.Name = value ?? string.Empty))" Immediate="true" Disabled="@Disabled(state)" data-testid="project-structure-secret-create-name" /></FormField>
                        <FormField Text="Kind">
                            <InputSelect @bind-Value="state.Draft.Create.Kind" class="cda-input" disabled="@Disabled(state)">
                                @foreach (var kind in Enum.GetValues<SecretKind>()) {
                                    <option value="@kind">@kind</option>
                                }
                            </InputSelect>
                        </FormField>
                    </Grid>
                    <FormField Text="Value">
                        <SecretField @key="state.OpeningId" Value="@state.Draft.Create.SecretValue" ValueChanged="@(value => ValueInput(state, new ChangeEventArgs { Value = value }))" SecretName="@state.Draft.Create.Name"
                                     ShowNameCopy="true" ShowValueCopy="true" RevealDurationSeconds="30" Disabled="@Disabled(state)"
                                     @oninput="@(args => ValueInput(state, args))" data-testid="project-structure-secret-create-value" />
                    </FormField>
                    <FormField Text="Purpose"><TextBox Value="@state.Draft.Create.RotationNote" ValueChanged="@(value => Change(state, nameof(state.Draft.Create), () => state.Draft.Create.RotationNote = value))" Immediate="true" Disabled="@Disabled(state)" /></FormField>
                </FormSection>
            </Stack>
            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap" Class="operator-secret-footer" data-testid="operator-secret-footer">
                <Button Text="@(state.IsEdit ? "Save selected secret" : "Use selected secret")" Icon="shield" ButtonStyle="ButtonStyle.Info"
                        Click="@(() => UseAsync(state))" Disabled="@(Disabled(state) || Selected(state) is null)" IsBusy="@state.IsBusy" data-testid="project-structure-secret-use-selected" />
                <Button Text="Create and use" Icon="save" ButtonStyle="ButtonStyle.Info"
                        Click="@(() => CreateAsync(state))" Disabled="@Disabled(state)" IsBusy="@state.IsBusy" data-testid="project-structure-secret-create-use" />
                <Button Text="Retry metadata read" Icon="refresh" Click="@(() => RetryAsync(state))"
                        Disabled="@(state.IsBusy || ReferenceEquals(submitting, state) || state.IsRetired)" data-testid="project-structure-secret-retry" />
                @if (state.CanFinishReference) {
                    <Button Text="Finish original reference" Icon="link" Click="@(() => FinishAsync(state))"
                            Disabled="@(state.IsBusy || ReferenceEquals(submitting, state) || state.IsRetired)" data-testid="project-structure-secret-finish" />
                }
            </Cluster>
        </EditForm>
        </div>
    </Body>
</CanvasOverlayDialog>

@code {
    [Parameter, EditorRequired] public SecretReferenceState State { get; set; } = default!;
    [Parameter, EditorRequired] public Func<SecretReferenceInput, Task> Use { get; set; } = default!;
    [Parameter, EditorRequired] public Func<SecretReferenceInput, SecretEditorModel, Task> Create { get; set; } = default!;
    [Parameter, EditorRequired] public Func<Task> Retry { get; set; } = default!;
    [Parameter, EditorRequired] public Func<Task> Finish { get; set; } = default!;
    [Parameter] public EventCallback Close { get; set; }
    private SecretReferenceState? submitting;
    private bool Disabled(SecretReferenceState state) => !ReferenceEquals(State, state) || ReferenceEquals(submitting, state) || !state.CanEdit;
    private static SecretListItem? Selected(SecretReferenceState state) => state.Items.FirstOrDefault(item => item.Id == state.Draft.SelectedId);
    private IEnumerable<SecretListItem> Choices(SecretReferenceState state) => state.Items.Where(item => item.Id == state.Draft.SelectedId || string.IsNullOrWhiteSpace(state.Draft.Search) ||
        item.Name.Contains(state.Draft.Search.Trim(), StringComparison.OrdinalIgnoreCase) || item.Scope.Contains(state.Draft.Search.Trim(), StringComparison.OrdinalIgnoreCase) ||
        item.Kind.ToString().Contains(state.Draft.Search.Trim(), StringComparison.OrdinalIgnoreCase)).OrderBy(item => item.Name, StringComparer.OrdinalIgnoreCase);
    private void Select(SecretReferenceState state, ChangeEventArgs args) {
        if (!Disabled(state)) {
            state.Draft.SelectedId = Guid.TryParse(args.Value?.ToString(), out var id) && id != Guid.Empty ? id : null;
        }
    }
    private void ValueInput(SecretReferenceState state, ChangeEventArgs args) {
        Change(state, nameof(state.Draft.Create), () => state.Draft.Create.SecretValue = args.Value?.ToString() ?? string.Empty);
    }
    private void Change(SecretReferenceState state, string field, Action change) {
        if (Disabled(state)) {
            return;
        }
        change();
        state.EditContext.NotifyFieldChanged(new(state.Draft, field));
    }
    private Task UseAsync(SecretReferenceState state) {
        var callback = Use;
        return Disabled(state) || Selected(state) is null ? Task.CompletedTask : DispatchAsync(state, () => callback(state.Draft.Capture()));
    }
    private async Task CreateAsync(SecretReferenceState state) {
        if (Disabled(state)) {
            return;
        }
        var callback = Create;
        var input = state.Draft.Capture();
        var model = state.Draft.Create.Copy();
        try {
            await DispatchAsync(state, () => callback(input, model));
        } finally {
            model.SecretValue = string.Empty;
        }
    }
    private Task RetryAsync(SecretReferenceState state) => DispatchAsync(state, Retry);
    private Task FinishAsync(SecretReferenceState state) => state.CanFinishReference ? DispatchAsync(state, Finish) : Task.CompletedTask;
    private async Task DispatchAsync(SecretReferenceState state, Func<Task> callback) {
        if (!ReferenceEquals(State, state) || ReferenceEquals(submitting, state) || state.IsBusy || state.IsRetired) {
            return;
        }
        submitting = state;
        try {
            await callback();
        } catch {
            state.RequiresObservation = true;
            state.Message = "The result is unconfirmed. Observe the original operation before another write.";
            state.Draft.Create.SecretValue = string.Empty;
        } finally {
            if (ReferenceEquals(submitting, state)) {
                submitting = null;
            }
        }
    }
}

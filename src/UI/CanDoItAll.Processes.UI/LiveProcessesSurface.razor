    private static RenderFragment RenderCurrentStep(ProcessRuntimeCurrentStepProjection step) => @<SurfaceCard Soft="true"
                                                                                                  data-testid="live-processes-current-step">
        <Split Gap="LayoutGap.Small">
            <Stack GapScale="LayoutGap.Tiny">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Current step" />
                <h2 class="text-base font-semibold text-slate-900">@step.StepKey</h2>
            </Stack>
            <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                <StatusBadge Tone="info" Text="@step.StepStatus" />
                @if (step.IsLeaseExpired) {
                    <StatusBadge Tone="warning" Text="Lease expired" />
                } else if (step.IsWorking) {
                    <StatusBadge Tone="success" Text="Working" />
                }
            </Cluster>
        </Split>
        <p class="mt-3 text-sm leading-6 text-slate-700">@step.Summary</p>
        @if (step.Diagnostics.Count > 0) {
            <Stack GapScale="LayoutGap.XSmall" Class="mt-4">
                @foreach (var diagnostic in step.Diagnostics) {
                    <div class="live-processes-event-row">
                        <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                            <StatusBadge Tone="warning" Text="@diagnostic.Code" />
                            <StatusBadge Tone="neutral" Text="@diagnostic.Category" />
                        </Cluster>
                        <p class="mt-2 text-sm leading-6 text-slate-700">@diagnostic.SafeSummary</p>
                        @if (diagnostic.OperatorDetails is { } details) {
                            <Cluster Gap="LayoutGap.XSmall" Class="mt-2 flex-wrap">
                                <StatusBadge Tone="info" Text="@details.GateId" />
                                @if (!string.IsNullOrWhiteSpace(details.BranchOutcomeKey)) {
                                    <StatusBadge Tone="neutral" Text="@details.BranchOutcomeKey" />
                                }
                                @if (!string.IsNullOrWhiteSpace(details.RouteTargetBranchOutcomeKey)) {
                                    <StatusBadge Tone="warning" Text="@details.RouteTargetBranchOutcomeKey" />
                                }
                                @if (details.FailedCriteriaIds.Count > 0) {
                                    <StatusBadge Tone="warning" Text="@string.Join(", ", details.FailedCriteriaIds)" />
                                }
                                @if (details.ReceiptRuleIds.Count > 0) {
                                    <StatusBadge Tone="neutral" Text="@string.Join(", ", details.ReceiptRuleIds)" />
                                }
                            </Cluster>
                            <p class="mt-2 text-sm leading-6 text-slate-700">@details.NextAction</p>
                        }
                    </div>
                }
            </Stack>
        }
    </SurfaceCard>;



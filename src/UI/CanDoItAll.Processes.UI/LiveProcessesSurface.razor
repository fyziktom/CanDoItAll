@using static CanDoItAll.Processes.UI.ProcessRuntimeDisplay
@namespace CanDoItAll.Processes.UI
@using CanDoItAll.Processes.Abstractions
@inject TooltipService TooltipService
<PageScaffold FillHeight="true"
              MaxWidthClass="max-w-full"
              Class="live-processes-page"
              data-testid="live-processes-page">
    <Header>
        <Toolbar Class="live-processes-command-strip"
                 data-testid="live-processes-command-strip">
            <ToolbarRow Class="live-processes-command-strip__row">
                <CompactStatStrip Class="min-w-0">
                    <p class="cda-eyebrow whitespace-nowrap">Processes</p>
                    <h1 class="live-processes-title">@Session.PageTitleText</h1>
                    <CompactStat Tone="info"
                                 Text="@FormatCount(Session.Shell?.LiveRuns.ActiveRunCount ?? 0, "active", "active")"
                                 TooltipText="Process runs currently active in the live projection." />
                    <CompactStat Tone="warning"
                                 Text="@FormatCount(Session.Shell?.LiveRuns.AttentionRunCount ?? 0, "attention", "attention")"
                                 TooltipText="Process runs currently needing operator attention." />
                    <CompactStat Tone="danger"
                                 Text="@FormatCount(Session.Shell?.LiveRuns.FailedRunCount ?? 0, "failed", "failed")"
                                 TooltipText="Process runs currently failed in the live projection." />
                    <CompactStat Tone="@Session.ProjectionTone"
                                 Text="@Session.ProjectionStatusText"
                                 TooltipText="@Session.ProjectionTooltip" />
                    @if (Session.HiddenRelatedRunCount > 0) {
                        <CompactStat Tone="neutral"
                                     Text="@FormatCount(Session.HiddenRelatedRunCount, "hidden", "hidden")"
                                     TooltipText="Hidden runs stay hidden in this browser on every live process page until they need attention again. Use the eye button to show them."
                                     data-testid="live-processes-hidden-count" />
                    }
                </CompactStatStrip>

                <ToolbarActions Class="live-processes-command-strip__actions">
                    @if (Session.HiddenRelatedRunCount > 0) {
                        <PageHeaderActionButton Icon="visibility"
                                                Label="@($"Show {Session.HiddenRelatedRunCount} hidden")"
                                                TooltipText="Show all hidden runs again."
                                                Disabled="@Session.IsLoading"
                                                Click="Session.ShowHiddenRunGroupsAsync"
                                                data-testid="live-processes-show-hidden-runs" />
                    }
                    <PageHeaderActionButton Icon="refresh"
                                            Label="Refresh"
                                            TooltipText="Refresh the live process projection."
                                            Disabled="@Session.IsLoading"
                                            IsBusy="@Session.IsLoading"
                                            Click="Session.ForceRefreshAsync"
                                            data-testid="live-processes-refresh-button" />
                    <PageHeaderActionButton Icon="account_tree"
                                            Label="Definitions"
                                            TooltipText="Open the process definitions workspace."
                                            Disabled="@Session.IsLoading"
                                            Click="Session.OpenDefinitionsAsync"
                                            data-testid="live-processes-open-definitions" />
                </ToolbarActions>
            </ToolbarRow>
        </Toolbar>
    </Header>

    <ChildContent>
        <Stack GapScale="LayoutGap.Medium"
               Class="live-processes-dashboard min-h-0 flex-1"
               data-testid="live-processes-dashboard">
            @if (!string.IsNullOrWhiteSpace(Session.ErrorMessage)) {
                <div class="live-processes-alert"
                     role="alert"
                     data-testid="live-processes-error">
                    <Icon Name="error" />
                    <span>@Session.ErrorMessage</span>
                </div>
            } else if (!string.IsNullOrWhiteSpace(Session.OperatorActionError)) {
                <div class="live-processes-alert"
                     role="alert"
                     data-testid="live-processes-operator-action-error">
                    <Icon Name="error" />
                    <span>@Session.OperatorActionError</span>
                </div>
            } else if (!string.IsNullOrWhiteSpace(Session.OperatorActionMessage)) {
                <div class="live-processes-alert live-processes-alert--success"
                     role="status"
                     data-testid="live-processes-operator-action-message">
                    <Icon Name="check_circle" />
                    <span>@Session.OperatorActionMessage</span>
                </div>
            } else if (Session.IsMockProjection) {
                <div class="live-processes-alert live-processes-alert--mock"
                     role="status"
                     data-testid="live-processes-mock-notification">
                    <Icon Name="science" />
                    <span>Mock projection scenario is active. Runtime actions are simulated for UX tuning.</span>
                </div>
            } else if (Session.LaunchStarted && (Session.Shell is null || !Session.Shell.Runtime.Runs.Any(run => run.RunId.Value == Session.RunIdQuery))) {
                <div class="live-processes-alert live-processes-alert--success"
                     role="status"
                     data-testid="live-processes-started-notification">
                    <Icon Name="check_circle" />
                    <span>Launch accepted. Waiting for the run projection.</span>
                </div>
            }

            @if (Session.IsLoading && Session.Shell is null) {
                <LoadingState Eyebrow="Live processes"
                              Title="Loading process projection"
                              Description="Collecting the current live run projection through the process application boundary." />
            } else if (Session.Shell is not null) {
                <div class="live-processes-summary"
                     data-testid="live-processes-summary">
                    <CompactStatStrip>
                        <CompactStat Label="definitions"
                                     Value="@Session.DefinitionCountText"
                                     TooltipText="@Session.Shell.DefinitionCatalog.Summary"
                                     Tone="info" />
                        <CompactStat Label="active"
                                     Value="@Session.Shell.LiveRuns.ActiveRunCount.ToString("N0", CultureInfo.CurrentCulture)"
                                     TooltipText="Active process runs in this scope."
                                     Tone="success" />
                        <CompactStat Label="attention"
                                     Value="@Session.Shell.LiveRuns.AttentionRunCount.ToString("N0", CultureInfo.CurrentCulture)"
                                     TooltipText="Runs that need operator attention."
                                     Tone="warning" />
                        <CompactStat Label="failed"
                                     Value="@Session.Shell.LiveRuns.FailedRunCount.ToString("N0", CultureInfo.CurrentCulture)"
                                     TooltipText="Failed runs in this scope."
                                     Tone="danger" />
                        <CompactStat Label="last event"
                                     Value="@Session.LastEventText"
                                     TooltipText="Most recent live-run event observed by the projection." />
                        <CompactStat Label="backlog"
                                     Value="@Session.Shell.Refresh.BacklogEventCount.ToString("N0", CultureInfo.CurrentCulture)"
                                     TooltipText="@Session.Shell.Refresh.Summary"
                                     Tone="@Session.ProjectionTone" />
                    </CompactStatStrip>
                </div>

                <div class="live-processes-tabs-frame"
                     data-testid="live-processes-tabs-frame">
                    <Tabs SelectedIndex="@Session.SelectedTabIndex"
                          SelectedIndexChanged="Session.HandleTabChangedAsync"
                          Variant="TabsVariant.WorkspacePrimary"
                          RenderMode="TabRenderMode.Client"
                          OverflowMode="TabsOverflowMode.Auto"
                          PanelOverflowMode="TabsPanelOverflowMode.Auto"
                          FillHeight="true"
                          Class="live-processes-tabs"
                          data-testid="live-processes-tabs">
                        <TabsItem Text="Activity"
                                  Icon="monitoring"
                                  BadgeText="@Session.Shell.LiveRuns.ActiveRunCount.ToString(CultureInfo.InvariantCulture)">
                            @RenderActivityTab()
                        </TabsItem>

                    <TabsItem Text="Agents"
                              Icon="smart_toy"
                              BadgeText="@CountWorkingAgents(Session.Shell.Runtime.ActiveAgents).ToString(CultureInfo.InvariantCulture)">
                        @RenderAgentsTab()
                    </TabsItem>

                        <TabsItem Text="Graphs"
                                  Icon="bar_chart">
                            @RenderGraphsTab()
                        </TabsItem>

                        <TabsItem Text="Tool history"
                                  Icon="analytics"
                                  BadgeText="@Session.Shell.Refresh.BacklogEventCount.ToString(CultureInfo.InvariantCulture)">
                            @RenderToolAnalyticsTab()
                        </TabsItem>
                    </Tabs>
                </div>
            }
        </Stack>
    </ChildContent>
</PageScaffold>

@if (Session.RunDetailDialogOpen && Session.RunDetailSnapshot is not null) {
    <Dialog IsOpen="true"
            Eyebrow="Live process"
            Title="@BuildRunTitle(Session.RunDetailSnapshot)"
            Subtitle="@BuildRunSubtitle(Session.RunDetailSnapshot)"
            Size="ModalSize.Full"
            DenseChrome="true"
            TestId="live-processes-run-detail-dialog"
            OnClose="Session.CloseRunDetailDialogAsync">
        <ChildContent>
            @RenderRunDetailDialog(Session.RunDetailSnapshot)
        </ChildContent>
        <Footer>
            <Cluster JustifyContent="JustifyContent.End" Gap="LayoutGap.Small">
                @if (!Session.IsMockProjection) {
                    @CancellationContent
                }
                <Button Icon="folder"
                        Text="Files"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        data-testid="live-processes-run-files"
                        Click="@(() => Session.OpenRunFilesAsync(Session.RunDetailSnapshot.RunId.Value))" />
                <Button Text="Close"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Click="Session.CloseRunDetailDialogAsync" />
            </Cluster>
        </Footer>
    </Dialog>
}


@if (Session.AgentDetailDialogOpen && Session.AgentDetailAgent is not null) {
    <Dialog IsOpen="true"
            Eyebrow="Active agent"
            Title="@ResolveAgentDisplayName(Session.AgentDetailAgent)"
            Subtitle="@BuildAgentDetailSubtitle(Session.AgentDetailAgent)"
            Size="ModalSize.Wide"
            DenseChrome="true"
            TestId="live-processes-agent-detail-dialog"
            OnClose="Session.CloseAgentDetailDialogAsync">
        <ChildContent>
            @RenderAgentDetailDialog(Session.AgentDetailAgent)
        </ChildContent>
        <Footer>
            <Cluster JustifyContent="JustifyContent.End" Gap="LayoutGap.Small">
                <Button Icon="open_in_new"
                        Text="Process"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Click="@(() => Session.OpenProcessControlAsync(Session.AgentDetailAgent.RunId))" />
                <Button Text="Close"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Click="Session.CloseAgentDetailDialogAsync" />
            </Cluster>
        </Footer>
    </Dialog>
}


@code {
    [Parameter, EditorRequired] public ILiveProcessesSession Session { get; set; } = default!;
    [Parameter] public RenderFragment? CancellationContent { get; set; }

    private static readonly ProcessRuntimeHistoryWindow[] RuntimeHistoryWindowOptions =
    [
        ProcessRuntimeHistoryWindow.LiveHour,
        ProcessRuntimeHistoryWindow.OneDay,
        ProcessRuntimeHistoryWindow.SevenDays,
        ProcessRuntimeHistoryWindow.ThirtyDays
    ];


    private static readonly ProcessProjectedRunStatus[] StatusFilterOptions =
    [
        ProcessProjectedRunStatus.Active,
        ProcessProjectedRunStatus.NeedsAttention,
        ProcessProjectedRunStatus.Failed,
        ProcessProjectedRunStatus.Completed,
        ProcessProjectedRunStatus.Cancelled
    ];


    private const int ProcessNameDisplayLength = 34;

    private const string ProcessManagerDisplayName = "Process manager";

    private const string UnassignedAgentDisplayName = "Unassigned";

    private static readonly CdaChartOptions RuntimeActivityChartOptions = new() {
        Type = CdaChartType.Area,
        XAxisType = CdaChartAxisType.DateTime,
        YAxisTitle = "Events",
        TooltipPrecision = 0,
        ValuePrecision = 0,
        FillOpacity = 0.22,
        LegendPosition = CdaChartLegendPosition.Bottom,
        Palette = ["#2563eb", "#7c3aed", "#0891b2"]
    };


    private static readonly CdaChartOptions RuntimeToolUsageChartOptions = new() {
        Type = CdaChartType.Bar,
        XAxisType = CdaChartAxisType.Category,
        YAxisTitle = "Calls",
        TooltipPrecision = 0,
        ValuePrecision = 0,
        ShowToolbar = false,
        EnableZoom = false,
        RotateXAxisLabels = false,
        LegendPosition = CdaChartLegendPosition.Bottom,
        Palette = ["#f59e0b"]
    };


    private RenderFragment RenderActivityTab() => @<Stack GapScale="LayoutGap.Medium"
                                                          data-testid="live-processes-activity">
        @RenderRuntimeToolbar("live-processes-runtime-toolbar")
        <Grid Gap="LayoutGap.Medium"
              ColumnTemplateXl="minmax(0,1.65fr) minmax(26rem,0.7fr)"
              Class="live-processes-activity-workspace">
            <Stack GapScale="LayoutGap.Medium"
                   Class="live-processes-activity-main">
                @RenderAttentionPanel()
                @RenderActivityCards()
            </Stack>
            <Stack GapScale="LayoutGap.Medium"
                   Class="live-processes-activity-rail">
                @RenderRunCards()
                @RenderEventLedger()
            </Stack>
        </Grid>
    </Stack>;


    private RenderFragment RenderAgentsTab() => @<Stack GapScale="LayoutGap.Medium"
                                                        data-testid="live-processes-agents">
        <SurfaceCard Soft="true">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Manager context" />
            <h2 class="text-base font-semibold text-slate-900">@Session.Shell!.AgentEntry.Label</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">@Session.Shell.AgentEntry.ContextKey</p>
            <p class="mt-2 text-sm leading-6 text-slate-600">@Session.Shell.Runtime.AttentionSummary</p>
            <Cluster Gap="LayoutGap.Small"
                     Class="mt-4 flex-wrap">
                <StatusBadge Tone="@(Session.Shell.AgentEntry.IsAvailable ? "success" : "warning")"
                             Text="@(Session.Shell.AgentEntry.IsAvailable ? "Available" : "Unavailable")" />
                <StatusBadge Tone="info" Text="@FormatCount(CountWorkingAgents(Session.VisibleActiveAgents), "working agent", "working agents")" />
                @if (CountStaleAgentClaims(Session.VisibleActiveAgents) > 0) {
                    <StatusBadge Tone="warning" Text="@FormatCount(CountStaleAgentClaims(Session.VisibleActiveAgents), "stale claim", "stale claims")" />
                }
                @if (!string.IsNullOrWhiteSpace(Session.Shell.AgentEntry.DisabledReason)) {
                    <StatusBadge Tone="warning" Text="@Session.Shell.AgentEntry.DisabledReason" />
                }
            </Cluster>
        </SurfaceCard>
        @RenderActiveAgentGrid(Session.VisibleActiveAgents, "live-processes-active-agents")
    </Stack>;


    private RenderFragment RenderGraphsTab() => @<Stack GapScale="LayoutGap.Medium"
                                                        data-testid="live-processes-graphs">
        @RenderRuntimeToolbar("live-processes-graphs-toolbar")
        <Grid Gap="LayoutGap.Medium" ColumnsLg="5">
            @RenderMetricCard("Events", Session.Shell!.Runtime.Stats.EventCount.ToString(CultureInfo.InvariantCulture), "info", "Runtime events in the selected history window.")
            @RenderMetricCard("Manager", Session.Shell.Runtime.Stats.ManagerEventCount.ToString(CultureInfo.InvariantCulture), "warning", "Manager signals and escalations.")
            @RenderMetricCard("Tool usage", Session.Shell.Runtime.Stats.ToolCallCount.ToString(CultureInfo.InvariantCulture), "neutral", "Runtime activity grouped by event/tool category.")
            @RenderMetricCard("Cost", Session.FormatCurrency(ResolveRuntimeCost(Session.Shell.Runtime.Stats)), ResolveRuntimeCost(Session.Shell.Runtime.Stats) > 0 ? "success" : "neutral", "Actual or estimated provider cost in the selected history window.")
            @RenderMetricCard("Time", FormatDuration(Session.Shell.Runtime.Stats.DurationMs), "info", "Observed runtime span in the selected history window.")
        </Grid>
        <Grid Gap="LayoutGap.Medium"
              ColumnTemplateXl="minmax(0,1fr) minmax(0,1fr)">
            <CdaChart Title="Selected history"
                      Description="Events, manager signals, and tool activity."
                      Series="@RuntimeActivitySeries"
                      Options="@RuntimeActivityChartOptions"
                      Height="320"
                      EmptyText="No runtime events match the selected filters." />
            <CdaChart Title="Process cost over time"
                      Description="Actual provider cost when known, otherwise estimate, filtered by the selected history window."
                      Series="@RuntimeCostSeries"
                      Options="@Session.RuntimeCostChartOptions"
                      Height="320"
                      EmptyText="No provider cost telemetry is present in this scope." />
            <CdaChart Title="Tool usage"
                      Description="Most active event/tool categories."
                      Series="@RuntimeToolUsageSeries"
                      Options="@RuntimeToolUsageChartOptions"
                      Height="320"
                      EmptyText="No runtime tool activity is present in this scope." />
        </Grid>
    </Stack>;


    private RenderFragment RenderToolAnalyticsTab() => @<Stack GapScale="LayoutGap.Medium"
                                                               data-testid="live-processes-tool-analytics">
        @RenderRuntimeToolbar("live-processes-tool-history-toolbar")
        <Grid Gap="LayoutGap.Medium"
              ColumnTemplateXl="minmax(0,1.2fr) minmax(22rem,0.8fr)">
            <div class="live-processes-tool-chart"
                 data-testid="live-processes-tool-history-chart">
                <CdaChart Title="Tool history"
                          Description="Runtime tool activity grouped by tool or event family."
                          Series="@RuntimeToolUsageSeries"
                          Options="@RuntimeToolUsageChartOptions"
                          Height="300"
                          EmptyText="No runtime tool activity is present in this scope." />
            </div>
            @RenderToolFamilyCards()
        </Grid>
        <Grid Gap="LayoutGap.Medium"
              ColumnTemplateXl="minmax(0,1.05fr) minmax(0,0.95fr)">
            @RenderToolUsageLedger()
            @RenderEventLedger()
        </Grid>
    </Stack>;


    private IReadOnlyList<CdaChartSeries> RuntimeActivitySeries {
        get {
            var points = Session.Shell?.Runtime.MetricPoints ?? [];
            if (points.Count == 0) {
                return [];
            }

            return
            [
                new CdaChartSeries {
                    Name = "Events",
                    Type = CdaChartType.Area,
                    Color = "#2563eb",
                    Points = points.Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, item.EventCount)).ToArray()
                },
                new CdaChartSeries {
                    Name = "Manager signals",
                    Type = CdaChartType.Line,
                    Color = "#7c3aed",
                    Points = points.Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, item.ManagerEventCount)).ToArray()
                },
                new CdaChartSeries {
                    Name = "Tool activity",
                    Type = CdaChartType.Line,
                    Color = "#0891b2",
                    Points = points.Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, item.ToolCallCount)).ToArray()
                }
            ];
        }
    }


    private IReadOnlyList<CdaChartSeries> RuntimeToolUsageSeries {
        get {
            var toolUsage = Session.Shell?.Runtime.ToolUsage.Take(15).ToArray() ?? [];
            if (toolUsage.Length == 0) {
                return [];
            }

            return
            [
                new CdaChartSeries {
                    Name = "Calls",
                    Type = CdaChartType.Bar,
                    Color = "#f59e0b",
                    Points = toolUsage.Select(item => new CdaChartPoint(TrimLabel(item.ToolName, 26), item.CallCount)).ToArray()
                }
            ];
        }
    }


    private IReadOnlyList<CdaChartSeries> RuntimeCostSeries {
        get {
            var points = Session.Shell?.Runtime.MetricPoints ?? [];
            if (points.Count == 0) {
                return [];
            }

            return
            [
                new CdaChartSeries {
                    Name = "Cost",
                    Type = CdaChartType.Area,
                    Color = "#dc2626",
                    Points = points.Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, item.ActualCost > 0 ? item.ActualCost : item.EstimatedCost)).ToArray()
                }
            ];
        }
    }


    private RenderFragment RenderRuntimeToolbar(string testId) => @<SurfaceCard Soft="true"
                                                                                Class="live-processes-filter-strip"
                                                                                data-testid="@testId">
        <Grid Gap="LayoutGap.Medium"
              ColumnTemplateXl="minmax(14rem,0.55fr) minmax(14rem,0.55fr) minmax(16rem,1fr) auto"
              AlignItems="AlignItems.End">
            <Stack GapScale="LayoutGap.Tiny">
                <label class="text-xs font-semibold text-slate-500" for="@($"{testId}-window")">History</label>
                <select id="@($"{testId}-window")"
                        class="cda-input"
                        value="@Session.RuntimeHistoryWindow"
                        @onchange="Session.ChangeRuntimeHistoryWindowAsync"
                        data-testid="live-processes-history-window">
                    @foreach (var option in RuntimeHistoryWindowOptions) {
                        <option value="@option">@FormatHistoryWindow(option)</option>
                    }
                </select>
            </Stack>
            <Stack GapScale="LayoutGap.Tiny">
                <label class="text-xs font-semibold text-slate-500" for="@($"{testId}-status")">Status</label>
                <select id="@($"{testId}-status")"
                        class="cda-input"
                        value="@Session.StatusFilterValue"
                        @onchange="Session.ChangeStatusFilterAsync"
                        data-testid="live-processes-status-filter">
                    <option value="">All statuses</option>
                    @foreach (var option in StatusFilterOptions) {
                        <option value="@option">@option.ToString()</option>
                    }
                </select>
            </Stack>
            <Stack GapScale="LayoutGap.Tiny">
                <label class="text-xs font-semibold text-slate-500" for="@($"{testId}-run")">Run</label>
                <select id="@($"{testId}-run")"
                        class="cda-input"
                        value="@Session.RuntimeRunSelectValue"
                        @onchange="Session.SelectRuntimeRunAsync"
                        data-testid="live-processes-run-filter">
                    @RenderRuntimeRunOptions()
                </select>
            </Stack>
            <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap justify-end">
                <Button Icon="chevron_left"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        title="Previous event page"
                        aria-label="Previous event page"
                        Disabled="@(Session.RuntimeEventPage == 0 || Session.IsLoading)"
                        Click="Session.PreviousRuntimeEventPageAsync"
                        data-testid="live-processes-events-prev" />
                <StatusBadge Tone="neutral" Text="@($"Page {Session.RuntimeEventPage + 1}")" />
                <Button Icon="chevron_right"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        title="Next event page"
                        aria-label="Next event page"
                        Disabled="@(!Session.Shell!.Runtime.HasMoreEvents || Session.IsLoading)"
                        Click="Session.NextRuntimeEventPageAsync"
                        data-testid="live-processes-events-next" />
            </Cluster>
        </Grid>
    </SurfaceCard>;


    private RenderFragment RenderAttentionPanel() => @<section class="live-processes-attention-panel"
                                                               data-testid="live-processes-attention-panel">
        @if (Session.AttentionRuns.Count > 0) {
            <Split Gap="LayoutGap.Small">
                <Stack GapScale="LayoutGap.Tiny">
                    <TextBlock TextStyle="TextStyle.Eyebrow" Value="Needs attention" />
                    <h2 class="text-base font-semibold text-slate-900">@FormatCount(Session.AttentionRuns.Count, "run needs operator action", "runs need operator action")</h2>
                </Stack>
                <span title="Runs that need operator action stay listed until they are resolved, cancelled or hidden, even when they are older than the selected window."
                      data-testid="live-processes-attention-window">
                    <StatusBadge Tone="warning" Text="@FormatHistoryWindow(Session.Shell!.Runtime.HistoryWindow)" />
                </span>
            </Split>
            <Grid Gap="LayoutGap.Medium"
                  ColumnsXl="2"
                  Columns2Xl="2">
                @foreach (var run in Session.AttentionRuns) {
                    var action = Session.ResolvePrimaryOperatorAction(run);
                    var projectDisplayText = ResolveProjectDisplayText(run);
                    <article class="live-processes-attention-card" data-testid="live-processes-attention-card">
                        <div class="live-processes-attention-card__body">
                            <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                                <StatusBadge Tone="@ResolveRunStatusTone(run.Status)" Text="@run.Status.ToString()" />
                                @if (run.IsSubprocess) {
                                    <StatusBadge Tone="accent"
                                                 Text="Subprocess escalation"
                                                 data-testid="live-processes-attention-subprocess-escalation-badge" />
                                }
                                @if (!string.IsNullOrWhiteSpace(projectDisplayText)) {
                                    <StatusBadge Tone="info"
                                                 Text="@projectDisplayText"
                                                 data-testid="live-processes-attention-project-badge" />
                                }
                                @if (run.Incidents.Count > 0) {
                                    <StatusBadge Tone="warning" Text="@FormatCount(run.Incidents.Count, "incident", "incidents")" />
                                }
                                @if (Session.ResolveManagerMessages(run.RunId).Count > 0) {
                                    <StatusBadge Tone="info" Text="@FormatCount(Session.ResolveManagerMessages(run.RunId).Count, "manager message", "manager messages")" />
                                }
                                <StatusBadge Tone="neutral"
                                             Text="@run.LastEventAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)"
                                             data-testid="live-processes-attention-run-date" />
                            </Cluster>
                            <h3 class="live-processes-attention-card__title">@RenderRunTitleContent(run)</h3>
                            <p class="live-processes-attention-card__summary">@Session.BuildAttentionSummary(run)</p>
                            @if (action is not null) {
                                <div class="live-processes-attention-card__decision"
                                     data-testid="live-processes-attention-decision">
                                    <Icon Name="priority_high" />
                                    <p>@FirstNonEmpty(action.RequiredOperatorDecision, action.Summary)</p>
                                </div>
                            }
                        </div>
                        <Cluster Gap="LayoutGap.XSmall" Class="live-processes-attention-card__actions">
                            @if (action is not null) {
                                <Button Icon="replay"
                                        Text="@action.Label"
                                        ButtonStyle="ButtonStyle.Primary"
                                        Size="ButtonSize.Small"
                                        Disabled="@Session.IsOperatorActionBusy(action)"
                                        IsBusy="@Session.IsOperatorActionBusy(action)"
                                        Click="@(() => Session.OpenRunDetailDialogAsync(run))"
                                        data-testid="live-processes-request-rework" />
                            }
                            <Button Icon="info"
                                    Text="Details"
                                    ButtonStyle="ButtonStyle.Light"
                                    Size="ButtonSize.Small"
                                    Click="@(() => Session.OpenRunDetailDialogAsync(run))"
                                    data-testid="live-processes-attention-open-details" />
                            <Button Icon="forum"
                                    ButtonStyle="ButtonStyle.Light"
                                    Size="ButtonSize.Small"
                                    title="Open process control"
                                    aria-label="Open process control"
                                    Click="@(() => Session.OpenProcessControlAsync(run.RunId.Value))" />
                            <Button Icon="visibility_off"
                                    Text="Hide run"
                                    ButtonStyle="ButtonStyle.Light"
                                    Size="ButtonSize.Small"
                                    title="Hide this run group until it needs attention again"
                                    aria-label="Hide this run group"
                                    Click="@(() => Session.HideRunGroupAsync(run))"
                                    data-testid="live-processes-hide-run-group" />
                        </Cluster>
                    </article>
                }
            </Grid>
        }
    </section>;


    private RenderFragment RenderRuntimeRunOptions() => @<text>
        @if (Session.SelectableRuns.Count == 0) {
            <option value="">No runtime runs</option>
        } else {
            <option value="">All runs</option>
            @foreach (var run in Session.SelectableRuns) {
                <option value="@run.RunId.Value.ToString("D")">@BuildRunOptionText(run)</option>
            }
        }
    </text>;


    private RenderFragment RenderActivityCards() => @<section class="live-processes-activity-strip"
                                                              data-testid="live-processes-activity-cards">
        <Split Gap="LayoutGap.Small">
            <Stack GapScale="LayoutGap.Tiny">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Current window" />
                <h2 class="text-base font-semibold text-slate-900">@Session.Shell!.Runtime.Summary</h2>
            </Stack>
            <StatusBadge Tone="info" Text="@FormatHistoryWindow(Session.Shell!.Runtime.HistoryWindow)" />
        </Split>
        @if (Session.ActivityCardRuns.Count == 0) {
            <EmptyState Eyebrow="Live processes"
                        Title="No active or attention cards"
                        Description="No active, blocked, failed, or incident-bearing runs match this window." />
        } else {
            <Grid Gap="LayoutGap.Medium"
                  ColumnsXl="3"
                  Columns2Xl="3">
                @foreach (var run in Session.ActivityCardRuns) {
                    @RenderActivityCard(run)
                }
            </Grid>
        }
    </section>;


    private RenderFragment RenderActivityCard(ProcessLiveProcessSnapshot run) => @<article class="@ResolveActivityCardClass(run)"
                                                                                          data-testid="live-processes-activity-card">
        @{
            var progress = BuildRunProgress(run);
            var activeAgents = Session.ResolveActiveAgents(run.RunId.Value);
            var primaryAgent = Session.ResolvePrimaryAgent(activeAgents);
            var assignedAgentName = ResolveActivityAssignedAgentName(run, primaryAgent);
            var projectDisplayText = ResolveProjectDisplayText(run);
            var action = Session.ResolvePrimaryOperatorAction(run);
        }
        <div class="live-processes-activity-card__body">
            <Split Gap="LayoutGap.Small">
                <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                    <StatusBadge Tone="@ResolveRunStatusTone(run.Status)" Text="@run.Status.ToString()" />
                    @if (run.IsSubprocess) {
                        <StatusBadge Tone="accent"
                                     Text="Subprocess"
                                     data-testid="live-processes-run-subprocess-badge" />
                    }
                    @if (run.Incidents.Count > 0) {
                        <StatusBadge Tone="warning" Text="@FormatCount(run.Incidents.Count, "incident", "incidents")" />
                    }
                    @if (CountWorkingAgents(activeAgents) > 0) {
                        <StatusBadge Tone="info" Text="@FormatCount(CountWorkingAgents(activeAgents), "agent", "agents")" />
                    }
                    @if (CountStaleAgentClaims(activeAgents) > 0) {
                        <StatusBadge Tone="warning" Text="@FormatCount(CountStaleAgentClaims(activeAgents), "stale claim", "stale claims")" />
                    }
                    @if (run.WaitingOnChildRuns.Count > 0) {
                        <StatusBadge Tone="info" Text="@FormatCount(run.WaitingOnChildRuns.Count, "child wait", "child waits")" />
                    }
                </Cluster>
                <span class="live-processes-activity-card__percent">@($"{progress.Percent}%")</span>
            </Split>
            <h3 class="live-processes-activity-card__title">@RenderRunTitleContent(run)</h3>
            <div class="live-processes-activity-card__fields">
                <span>
                    <Icon Name="route" />
                    <span class="live-processes-activity-card__field-body">
                        <strong>Current step</strong>
                        <span>@Session.ResolveCurrentStepText(run)</span>
                    </span>
                </span>
                @if (!string.IsNullOrWhiteSpace(projectDisplayText)) {
                    <span>
                        <Icon Name="account_tree" />
                        <span class="live-processes-activity-card__field-body">
                            <strong>Project</strong>
                            <span title="@projectDisplayText"
                                  data-testid="live-processes-run-project-name">@projectDisplayText</span>
                        </span>
                    </span>
                }
                <span>
                    <Icon Name="person" />
                    <span class="live-processes-activity-card__field-body">
                        <strong>Assigned agent</strong>
                        <span data-testid="live-processes-run-agent-name">@assignedAgentName</span>
                    </span>
                </span>
            </div>
            <p class="live-processes-activity-card__summary">@Session.BuildRunCardSummary(run)</p>
            <div class="live-processes-run-progress"
                 data-testid="live-processes-run-progress"
                 title="@progress.Tooltip">
                <span class="live-processes-run-progress__label">@progress.Label</span>
                <span class="live-processes-run-progress__value">@($"{progress.Percent}%")</span>
                <ProgressBar Value="@progress.Percent" Max="100" Unit="%" />
            </div>
            <div class="live-processes-activity-card__metrics">
                <span>@FormatDuration(run.LastEventAtUtc - run.FirstEventAtUtc)</span>
                <span>@FormatCount(run.RecentEvents.Count, "event", "events")</span>
                <span>@FormatCount(activeAgents.Count, "agent", "agents")</span>
            </div>
            <p class="live-processes-activity-card__time">@run.LastEventAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)</p>
        </div>
        <Cluster Gap="LayoutGap.XSmall" Class="live-processes-activity-card__actions">
            @if (action is not null) {
                <Button Icon="replay"
                        Text="@action.Label"
                        ButtonStyle="ButtonStyle.Primary"
                        Size="ButtonSize.Small"
                        title="@action.Label"
                        aria-label="@action.Label"
                        Disabled="@Session.IsOperatorActionBusy(action)"
                        IsBusy="@Session.IsOperatorActionBusy(action)"
                        Click="@(() => Session.OpenRunDetailDialogAsync(run))"
                        data-testid="live-processes-activity-request-rework" />
            }
            <Button Icon="open_in_new"
                    Text="Details"
                    ButtonStyle="ButtonStyle.Light"
                    Size="ButtonSize.Small"
                    title="Open run details"
                    aria-label="Open run details"
                    Click="@(() => Session.OpenRunDetailDialogAsync(run))" />
            <Button Icon="forum"
                    Text="Control"
                    ButtonStyle="ButtonStyle.Light"
                    Size="ButtonSize.Small"
                    title="Open process control"
                    aria-label="Open process control"
                    Click="@(() => Session.OpenProcessControlAsync(run.RunId.Value))" />
            <Button Icon="visibility_off"
                    Text="Hide run"
                    ButtonStyle="ButtonStyle.Light"
                    Size="ButtonSize.Small"
                    title="Hide this run group until it needs attention again"
                    aria-label="Hide this run group"
                    Click="@(() => Session.HideRunGroupAsync(run))"
                    data-testid="live-processes-hide-run-group" />
        </Cluster>
    </article>;


    private RenderFragment RenderRunCards() => @<Stack GapScale="LayoutGap.Small"
                                                       data-testid="live-processes-run-cards">
        @if (Session.VisibleRuns.Count == 0) {
            <EmptyState Eyebrow="Live processes"
                        Title="No process cards match the filters"
                        Description="Widen the history window or clear the status filter." />
        } else {
            @foreach (var run in Session.VisibleRuns) {
                var progress = BuildRunProgress(run);
                <article class="live-processes-run-card @(run.RunId.Value == Session.SelectedRuntimeRunId ? "live-processes-run-card--selected" : string.Empty)"
                         data-testid="live-processes-run-card">
                    <button type="button"
                            class="live-processes-run-card__body"
                            @onclick="@(() => Session.SelectRuntimeRunAsync(run.RunId.Value))">
                        <span class="live-processes-run-card__header">
                            <span class="live-processes-run-card__title">@RenderRunTitleContent(run)</span>
                            <StatusBadge Tone="@ResolveRunStatusTone(run.Status)" Text="@run.Status.ToString()" />
                        </span>
                        <span class="live-processes-run-card__summary">@Session.BuildRunCardSummary(run)</span>
                        <span class="live-processes-run-card__progress"
                              title="@progress.Tooltip">
                            <span class="live-processes-run-card__progress-label">@progress.Label</span>
                            <ProgressBar Value="@progress.Percent" Max="100" Unit="%" />
                        </span>
                        <span class="live-processes-run-card__badges">
                            <StatusBadge Tone="neutral" Text="@($"{run.RecentEvents.Count} recent")" />
                            <StatusBadge Tone="warning" Text="@($"{run.Incidents.Count} incident(s)")" />
                            @if (run.OperatorActions.Count > 0) {
                                <StatusBadge Tone="warning" Text="@FormatCount(run.OperatorActions.Count, "action", "actions")" />
                            }
                            @if (run.WaitingOnChildRuns.Count > 0) {
                                <StatusBadge Tone="info" Text="@FormatCount(run.WaitingOnChildRuns.Count, "child wait", "child waits")" />
                            }
                            <StatusBadge Tone="info" Text="@run.LastEventAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)" />
                        </span>
                    </button>
                    <Stack GapScale="LayoutGap.XSmall"
                           Class="live-processes-run-card__actions">
                        <Button Icon="open_in_new"
                                ButtonStyle="ButtonStyle.Light"
                                Size="ButtonSize.Small"
                                Class="cda-button--quick live-processes-run-card__open"
                                title="Open run details"
                                aria-label="Open run details"
                                Click="@(() => Session.OpenRunDetailDialogAsync(run))"
                                data-testid="live-processes-run-open-details" />
                        <Button Icon="visibility_off"
                                ButtonStyle="ButtonStyle.Light"
                                Size="ButtonSize.Small"
                                Class="cda-button--quick live-processes-run-card__open"
                                title="Hide this run group until it needs attention again"
                                aria-label="Hide this run group"
                                Click="@(() => Session.HideRunGroupAsync(run))"
                                data-testid="live-processes-hide-run-group" />
                    </Stack>
                </article>
            }
        }
    </Stack>;


    private RenderFragment RenderActiveAgentGrid(
        IReadOnlyList<ProcessRuntimeActiveAgentProjection> agents,
        string testId) => @<section class="live-processes-agent-section"
                                    data-testid="@testId">
        @if (agents.Count == 0) {
            <EmptyState Eyebrow="Active agents"
                        Title="No agents are currently claimed"
                        Description="A claimed or running process step will appear here with its run, role, and lease." />
        } else {
            <div class="live-processes-agent-grid">
                @foreach (var agent in agents) {
                    @RenderActiveAgentCard(agent)
                }
            </div>
        }
    </section>;


    private RenderFragment RenderActiveAgentCard(ProcessRuntimeActiveAgentProjection agent) => @<article class="live-processes-agent-card"
                                                                                                         data-testid="live-processes-active-agent-card">
        <div class="live-processes-agent-card__header">
            <div class="live-processes-agent-card__avatar-row">
                <Avatar Alt="@ResolveAgentDisplayName(agent)"
                        ImageUrl="@agent.AgentAvatarImageUrl"
                        FallbackText="@ResolveAgentInitials(agent)"
                        DefaultImageSeed="@ResolveAgentAvatarSeed(agent)"
                        Size="AvatarSize.Large"
                        Shape="AvatarShape.Rounded" />
                <div class="live-processes-agent-card__identity">
                    <span class="live-processes-agent-card__name">@ResolveAgentDisplayName(agent)</span>
                    <span class="live-processes-agent-card__role">@agent.RoleKey</span>
                </div>
            </div>
            <StatusBadge Tone="@Session.ResolveAgentStatusTone(agent)" Text="@ResolveAgentStatusText(agent)" />
        </div>
        <p class="live-processes-agent-card__summary">@ResolveAgentCardSummary(agent)</p>
        <Cluster Gap="LayoutGap.XSmall" Class="live-processes-agent-card__badges flex-wrap">
            <StatusBadge Tone="neutral" Text="@agent.RunLabel" />
            <StatusBadge Tone="info" Text="@agent.StepKey" />
            <StatusBadge Tone="@ResolveObservationTone(agent)" Text="@ResolveObservationLabel(agent)" />
            @if (agent.ExecutionRunId.HasValue) {
                <StatusBadge Tone="neutral" Text="@($"run {agent.ExecutionRunId.Value.ToString("N")[..8]}")" />
            }
            @if (agent.ClaimedAtUtc.HasValue) {
                <StatusBadge Tone="neutral" Text="@($"claimed {agent.ClaimedAtUtc.Value.LocalDateTime:g}")" />
            }
            @if (agent.LeaseExpiresAtUtc.HasValue) {
                <StatusBadge Tone="warning" Text="@($"lease {agent.LeaseExpiresAtUtc.Value.LocalDateTime:g}")" />
            }
        </Cluster>
        <Cluster Gap="LayoutGap.XSmall" Class="live-processes-agent-card__actions">
            <Button Icon="info"
                    Text="Details"
                    ButtonStyle="ButtonStyle.Light"
                    Size="ButtonSize.Small"
                    title="Open active agent details"
                    aria-label="Open active agent details"
                    Click="@(() => Session.OpenAgentDetailDialogAsync(agent))"
                    data-testid="live-processes-agent-open-details" />
            <Button Icon="open_in_new"
                    ButtonStyle="ButtonStyle.Light"
                    Size="ButtonSize.Small"
                    Class="live-processes-agent-card__open"
                    title="Open process control"
                    aria-label="Open process control"
                    Click="@(() => Session.OpenProcessControlAsync(agent.RunId))" />
        </Cluster>
    </article>;


    private RenderFragment RenderEventLedger() => @<SurfaceCard Soft="true"
                                                                data-testid="live-processes-event-ledger">
        <Split Gap="LayoutGap.Small">
            <Stack GapScale="LayoutGap.Tiny">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="History" />
                <h2 class="text-base font-semibold text-slate-900">@($"{Session.Shell!.Runtime.Events.Count} event(s)")</h2>
            </Stack>
            <StatusBadge Tone="neutral" Text="@FormatHistoryWindow(Session.Shell!.Runtime.HistoryWindow)" />
        </Split>
        @if (Session.Shell!.Runtime.Events.Count == 0) {
            <p class="mt-3 text-sm leading-6 text-slate-500">No runtime events match the selected history filters.</p>
        } else {
            <Stack GapScale="LayoutGap.Small" Class="mt-4">
                @foreach (var runtimeEvent in Session.Shell.Runtime.Events) {
                    <div class="live-processes-event-row" data-testid="live-processes-event-row">
                        <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                            @RenderEventRunTitleContent(runtimeEvent)
                            <StatusBadge Tone="@ResolveEventTone(runtimeEvent)" Text="@runtimeEvent.EventType" />
                            <StatusBadge Tone="neutral" Text="@runtimeEvent.Sensitivity.ToString()" />
                            <span class="text-xs text-slate-500">@runtimeEvent.OccurredAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)</span>
                        </Cluster>
                        <p class="mt-2 text-sm leading-6 text-slate-700">@runtimeEvent.Summary</p>
                    </div>
                }
            </Stack>
        }
    </SurfaceCard>;


    private RenderFragment RenderToolFamilyCards() => @<SurfaceCard Soft="true"
                                                                    data-testid="live-processes-tool-family-summary">
        @{
            var toolFamilies = Session.ToolFamilySummaries;
        }
        <Split Gap="LayoutGap.Small">
            <Stack GapScale="LayoutGap.Tiny">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Tool types" />
                <h2 class="text-base font-semibold text-slate-900">@FormatCount(toolFamilies.Count, "family", "families")</h2>
            </Stack>
            <StatusBadge Tone="info" Text="@FormatCount(Session.Shell!.Runtime.Stats.ToolCallCount, "call", "calls")" />
        </Split>
        @if (toolFamilies.Count == 0) {
            <p class="mt-3 text-sm leading-6 text-slate-500">No tool families are present in this history window.</p>
        } else {
            <Grid Gap="LayoutGap.Small"
                  ColumnsXl="2"
                  Columns2Xl="2"
                  Class="mt-4">
                @foreach (var family in toolFamilies) {
                    var peakCalls = Math.Max(1, toolFamilies.Max(item => item.CallCount));
                    var percent = Math.Clamp((int)Math.Round(family.CallCount * 100d / peakCalls, MidpointRounding.AwayFromZero), 6, 100);
                    <article class="live-processes-tool-family-card @family.CssClass"
                             data-testid="live-processes-tool-family-card">
                        <span class="live-processes-tool-family-card__icon">
                            <Icon Name="@family.Icon" />
                        </span>
                        <span class="live-processes-tool-family-card__body">
                            <span class="live-processes-tool-family-card__title">@family.Label</span>
                            <span class="live-processes-tool-family-card__summary">
                                @FormatCount(family.CallCount, "call", "calls") across @FormatCount(family.ToolCount, "tool", "tools")
                            </span>
                            <ProgressBar Value="@percent" Max="100" Unit="%" />
                        </span>
                        <StatusBadge Tone="@family.Tone" Text="@family.LastUsedAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)" />
                    </article>
                }
            </Grid>
        }
    </SurfaceCard>;


    private RenderFragment RenderToolUsageLedger() => @<SurfaceCard Soft="true"
                                                                    data-testid="live-processes-tool-ledger">
        <Split Gap="LayoutGap.Small">
            <Stack GapScale="LayoutGap.Tiny">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Tool cards" />
                <h2 class="text-base font-semibold text-slate-900">@FormatCount(Session.Shell!.Runtime.ToolUsage.Count, "tool", "tools")</h2>
            </Stack>
            <StatusBadge Tone="neutral" Text="@FormatHistoryWindow(Session.Shell!.Runtime.HistoryWindow)" />
        </Split>
        @if (Session.Shell!.Runtime.ToolUsage.Count == 0) {
            <p class="mt-3 text-sm leading-6 text-slate-500">No runtime tool usage is present in this history window.</p>
        } else {
            <Grid Gap="LayoutGap.Small"
                  ColumnsXl="2"
                  Columns2Xl="2"
                  Class="mt-4">
                @foreach (var tool in Session.Shell.Runtime.ToolUsage) {
                    var family = ResolveToolFamilySummary(tool);
                    <article class="live-processes-tool-card @family.CssClass"
                             data-testid="live-processes-tool-card">
                        <div class="live-processes-tool-card__header">
                            <span class="live-processes-tool-card__icon">
                                <Icon Name="@family.Icon" />
                            </span>
                            <div class="live-processes-tool-card__identity">
                                <p class="live-processes-tool-card__name">@tool.ToolName</p>
                                <p class="live-processes-tool-card__summary">@tool.Summary</p>
                            </div>
                            <StatusBadge Tone="@family.Tone" Text="@family.Label" />
                        </div>
                        <div class="live-processes-tool-card__meta">
                            <span>@FormatCount(tool.CallCount, "call", "calls")</span>
                            <span>@tool.LastUsedAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)</span>
                        </div>
                    </article>
                }
            </Grid>
        }
    </SurfaceCard>;


    private RenderFragment RenderRunDetailDialog(ProcessLiveProcessSnapshot run) => @<Stack GapScale="LayoutGap.Medium"
                                                                                           data-testid="live-processes-run-detail-dialog-content">
        @{
            var progress = BuildRunProgress(run);
            var activeAgents = Session.ResolveActiveAgents(run.RunId.Value);
            var managerSummary = Session.ResolveManagerSummary(run);
        }
        <SurfaceCard Soft="true"
                     Class="@($"live-processes-run-detail-hero {progress.CssClass}")"
                     data-testid="live-processes-run-detail-hero">
            <Grid Gap="LayoutGap.Medium"
                  ColumnTemplateXl="minmax(0,1.35fr) minmax(20rem,0.65fr)"
                  ColumnTemplate2Xl="minmax(0,1.35fr) minmax(20rem,0.65fr)">
                <div class="live-processes-run-detail-hero__main">
                    <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                        <StatusBadge Tone="@ResolveRunStatusTone(run.Status)" Text="@run.Status.ToString()" />
                        <StatusBadge Tone="@progress.Tone" Text="@progress.Label" />
                        @if (run.OperatorActions.Count > 0) {
                            <StatusBadge Tone="warning" Text="@FormatCount(run.OperatorActions.Count, "operator action", "operator actions")" />
                        }
                        @if (run.WaitingOnChildRuns.Count > 0) {
                            <StatusBadge Tone="info" Text="@FormatCount(run.WaitingOnChildRuns.Count, "child wait", "child waits")" />
                        }
                    </Cluster>
                    <h2>@RenderRunTitleContent(run)</h2>
                    <p>@Session.BuildRunCardSummary(run)</p>
                    <div class="live-processes-run-progress live-processes-run-progress--detail"
                         title="@progress.Tooltip">
                        <span class="live-processes-run-progress__label">@progress.Label</span>
                        <span class="live-processes-run-progress__value">@($"{progress.Percent}%")</span>
                        <ProgressBar Value="@progress.Percent" Max="100" Unit="%" />
                    </div>
                </div>
                <div class="live-processes-run-detail-hero__aside"
                     data-testid="live-processes-run-detail-manager-summary">
                    <TextBlock TextStyle="TextStyle.Eyebrow" Value="Manager summary" />
                    <p>@managerSummary</p>
                    @if (Session.ResolvePrimaryOperatorAction(run) is { } primaryAction) {
                        <div class="live-processes-run-detail-decision"
                             data-testid="live-processes-run-detail-decision">
                            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Operator decision" />
                            <p>@FirstNonEmpty(primaryAction.RequiredOperatorDecision, primaryAction.Summary)</p>
                            <TextArea Value="@Session.GetOperatorActionNote(primaryAction)"
                                      Change="@((string? value) => Session.SetOperatorActionNote(primaryAction, value))"
                                      Rows="4"
                                      Placeholder="Optional note for the manager or next agent"
                                      class="live-processes-operator-action-row__note"
                                      data-testid="live-processes-dialog-operator-note" />
                            <Cluster Gap="LayoutGap.Small" Class="live-processes-run-detail-decision__actions">
                                <Button Icon="replay"
                                        Text="@primaryAction.Label"
                                        ButtonStyle="ButtonStyle.Primary"
                                        Size="ButtonSize.Small"
                                        Disabled="@Session.IsOperatorActionBusy(primaryAction)"
                                        IsBusy="@Session.IsOperatorActionBusy(primaryAction)"
                                        Click="@(() => Session.ExecuteOperatorActionAsync(primaryAction))"
                                        data-testid="live-processes-dialog-request-rework" />
                                <Button Icon="science"
                                        Text="Run tests"
                                        ButtonStyle="ButtonStyle.Light"
                                        Size="ButtonSize.Small"
                                        Click="@(() => Session.OpenProcessControlAsync(primaryAction.RunId))" />
                            </Cluster>
                        </div>
                    }
                    <div class="live-processes-run-detail-hero__metrics">
                        <span>@FormatDuration(run.LastEventAtUtc - run.FirstEventAtUtc)</span>
                        <span>@FormatCount(run.RecentEvents.Count, "event", "events")</span>
                        <span>@FormatCount(activeAgents.Count, "agent", "agents")</span>
                    </div>
                </div>
            </Grid>
        </SurfaceCard>
        <CompactStatStrip>
            <CompactStat Tone="@ResolveRunStatusTone(run.Status)" Text="@run.Status.ToString()" TooltipText="Projected run status." />
            <CompactStat Tone="neutral" Text="@($"{run.RecentEvents.Count} recent")" TooltipText="Recent events kept in the live run snapshot." />
            <CompactStat Tone="warning" Text="@($"{run.Incidents.Count} incident(s)")" TooltipText="Manager incidents projected for this run." />
            <CompactStat Tone="info" Text="@FormatCount(CountWorkingAgents(activeAgents), "agent", "agents")" TooltipText="Agents currently claimed or running on this run with a valid lease." />
            @if (CountStaleAgentClaims(activeAgents) > 0) {
                <CompactStat Tone="warning" Text="@FormatCount(CountStaleAgentClaims(activeAgents), "stale claim", "stale claims")" TooltipText="Claimed or running steps whose dispatch lease has expired." />
            }
            @if (run.WaitingOnChildRuns.Count > 0) {
                <CompactStat Tone="info" Text="@FormatCount(run.WaitingOnChildRuns.Count, "child wait", "child waits")" TooltipText="Parent steps waiting on active child process runs." />
            }
            @if (run.CurrentStep is not null) {
                <CompactStat Tone="neutral" Text="@run.CurrentStep.StepKey" TooltipText="@run.CurrentStep.Summary" />
            }
            <CompactStat Tone="info" Text="@run.LastEventAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)" TooltipText="Latest runtime event time." />
        </CompactStatStrip>
        @if (run.OperatorActions.Count > 1) {
            @RenderOperatorActions(run)
        }
        @RenderActiveAgentGrid(activeAgents, "live-processes-run-detail-active-agents")
        @if (run.CurrentStep is not null) {
            @RenderCurrentStep(run.CurrentStep)
        }
        @if (run.WaitingOnChildRuns.Count > 0) {
            @RenderChildRunWaits(run)
        }
        <Grid Gap="LayoutGap.Medium" ColumnTemplateXl="repeat(3,minmax(0,1fr))">
            <SurfaceCard Soft="true">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Recent events" />
                @foreach (var runtimeEvent in run.RecentEvents.OrderByDescending(item => item.OccurredAtUtc)) {
                    <div class="live-processes-event-row">
                        <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                            @RenderRunTitleContent(run)
                            <StatusBadge Tone="@ResolveRunStatusTone(run.Status)" Text="@runtimeEvent.EventType" />
                            <span class="text-xs text-slate-500">@runtimeEvent.OccurredAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)</span>
                        </Cluster>
                        <p class="mt-2 text-sm leading-6 text-slate-600">@runtimeEvent.Summary</p>
                    </div>
                }
            </SurfaceCard>
            <SurfaceCard Soft="true">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Incidents" />
                @if (run.Incidents.Count == 0) {
                    <p class="mt-3 text-sm leading-6 text-slate-500">No incidents are attached to this run.</p>
                } else {
                    @foreach (var incident in run.Incidents.OrderByDescending(item => item.RaisedAtUtc)) {
                        <div class="live-processes-event-row">
                            <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                                <StatusBadge Tone="warning" Text="@incident.Severity" />
                                <StatusBadge Tone="neutral" Text="@incident.Status" />
                            </Cluster>
                            <p class="mt-2 text-sm font-semibold text-slate-900">@incident.Classification</p>
                            <p class="mt-1 text-sm leading-6 text-slate-600">@incident.SafeSummary</p>
                            <p class="mt-1 text-xs text-slate-500">@incident.DiagnosticReference</p>
                        </div>
                    }
                }
            </SurfaceCard>
            <SurfaceCard Soft="true">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Manager messages" />
                @if (Session.ResolveManagerMessages(run.RunId).Count == 0) {
                    <p class="mt-3 text-sm leading-6 text-slate-500">No manager messages are attached to this run.</p>
                } else {
                    @foreach (var message in Session.ResolveManagerMessages(run.RunId)) {
                        <div class="live-processes-event-row">
                            <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                                <StatusBadge Tone="@ResolveManagerMessageTone(message)" Text="@message.Kind" />
                                <span class="text-xs text-slate-500">@message.CreatedAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)</span>
                            </Cluster>
                            <p class="mt-2 text-sm leading-6 text-slate-600">@message.Summary</p>
                            @if (!string.IsNullOrWhiteSpace(message.RestrictedDiagnosticReference)) {
                                <p class="mt-1 text-xs text-slate-500">@message.RestrictedDiagnosticReference</p>
                            }
                        </div>
                    }
                }
            </SurfaceCard>
        </Grid>
    </Stack>;



@namespace CanDoItAll.Processes.UI
<PageScaffold FillHeight="true"
              MaxWidthClass="max-w-full"
              Class="processes-page-scaffold"
              data-interactive="@interactive.ToString().ToLowerInvariant()"
              data-testid="processes-page-scaffold">
    <Header>
        <Toolbar Class="processes-command-strip"
                 data-testid="processes-command-strip">
            <ToolbarRow Class="processes-command-strip__row">
                <CompactStatStrip Class="min-w-0">
                    <p class="cda-eyebrow whitespace-nowrap">@Session.ScopeEyebrow</p>
                    <CompactStat Tone="info"
                                 Text="@($"{Session.DefinitionTotalText} definition(s)")"
                                 TooltipText="@Session.DefinitionTooltip" />
                    <CompactStat Tone="success"
                                 Text="@($"{Session.LiveRunActiveText} active")"
                                 TooltipText="@Session.LiveRunTooltip" />
                    <CompactStat Tone="warning"
                                 Text="@($"{Session.LiveRunAttentionText} attention")"
                                 TooltipText="Runs projected as needing operator attention." />
                    <CompactStat Tone="@Session.ProjectionTone"
                                 Text="@Session.ProjectionStatusText"
                                 TooltipText="@Session.ProjectionTooltip" />
                </CompactStatStrip>

                <ToolbarActions Class="processes-command-strip__actions">
                    @if (Session.Shell is null) {
                        <PageHeaderActionButton Icon="refresh"
                                                Label="Refresh"
                                                TooltipText="Refresh process shell projections."
                                                Disabled="@Session.IsBusy"
                                                IsBusy="@Session.IsBusy"
                                                Click="Session.RefreshAsync"
                                                data-testid="processes-refresh" />
                        <PageHeaderActionButton Icon="smart_toy"
                                                Label="Agent context"
                                                TooltipText="@Session.AgentContextTooltip"
                                                Disabled="@Session.AgentContextDisabled"
                                                Click="Session.OpenAgentContext"
                                                data-testid="processes-agent-context" />
                    } else {
                        @foreach (var command in Session.Shell.Commands) {
                            <PageHeaderActionButton Icon="@command.Icon"
                                                    Label="@(command.Kind == ProcessWorkspaceCommandKind.LaunchRun && Session.CanStartAnotherLaunch ? "Launch another run" : command.Text)"
                                                    TooltipText="@(command.Kind == ProcessWorkspaceCommandKind.LaunchRun && Session.CanStartAnotherLaunch ? "Start a separate process launch and keep the accepted run." : command.DisabledReason ?? command.Text)"
                                                    Disabled="@(!command.IsEnabled)"
                                                    Click="@(() => Session.ExecuteCommandAsync(command))"
                                                    data-testid="@BuildCommandTestId(command.Kind)" />
                        }
                    }
                </ToolbarActions>
            </ToolbarRow>
        </Toolbar>
    </Header>

    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(Session.ErrorMessage)) {
            <SurfaceCard Soft="true" data-testid="processes-shell-error">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Action required" />
                <h2 class="text-base font-semibold text-rose-900">Process shell projection failed</h2>
                <p class="mt-2 text-sm leading-6 text-rose-700">@Session.ErrorMessage</p>
                @if (Session.CanRecoverAuthoring) {
                    <Button Text="Check authoring status" Click="Session.RecoverAuthoringAsync" data-testid="processes-authoring-recover" />
                }
                @if (Session.CanRetryOriginalAuthoring) {
                    <Button Text="Retry original command" Click="Session.RetryOriginalAuthoringAsync" data-testid="processes-authoring-retry" />
                }
                @if (Session.PendingLaunchStorageKey is not null) {
                    <Button Text="Launch another run" Disabled="@Session.IsBusy" Click="Session.StartNewProcessLaunchAsync"
                            data-testid="processes-launch-new-intent" />
                    <TextBlock TextStyle="TextStyle.Note" Value="This starts a separate launch and keeps any earlier accepted run." />
                }
            </SurfaceCard>
        }

        @if (Session.Shell is null) {
            <SurfaceCard data-testid="processes-shell-loading">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Loading" />
                <h2 class="text-base font-semibold text-slate-900">Refreshing process workspace</h2>
            </SurfaceCard>
        } else {
            <Stack GapScale="LayoutGap.Medium"
                   Class="processes-workspace-root min-h-0 flex-1"
                   data-testid="processes-shell">
                @if (!string.IsNullOrWhiteSpace(Session.AgentContextNotice)) {
                    <p class="text-xs font-semibold text-slate-500" data-testid="processes-agent-context-notice">@Session.AgentContextNotice</p>
                }

                <ListDetailShell ListPaneWidth="28rem"
                                 Dense="true"
                                 ListPaneClass="h-full min-h-0"
                                 DetailPaneClass="h-full min-h-0"
                                 data-testid="processes-workspace-list-detail">
                    <ListHeader>
                        <ListPanelHeader Title="Process definitions"
                                         Description=""
                                         Dense="true"
                                         HelpText="Browse process contracts, filter the library, and keep selection synchronized with the detail workspace."
                                         Count="@($"{Session.DefinitionCatalog.Items.Count} definition(s)")">
                            <Filters>
                                <FilterBar>
                                    <input class="cda-input min-w-[16rem] flex-1"
                                           value="@Session.PendingSearchText"
                                           @oninput="Session.UpdateDefinitionSearchText"
                                           placeholder="Search definitions"
                                           aria-label="Search process definitions"
                                           data-testid="processes-definition-search" />
                                    <Button Icon="search"
                                            Class="cda-button--quick"
                                            ButtonStyle="ButtonStyle.Light"
                                            Size="ButtonSize.Small"
                                            title="Search definitions"
                                            aria-label="Search definitions"
                                            Disabled="@Session.IsBusy"
                                            Click="Session.ApplyDefinitionSearchAsync"
                                            data-testid="processes-definition-search-submit" />
                                    <Button Icon="close"
                                            Class="cda-button--quick"
                                            ButtonStyle="ButtonStyle.Light"
                                            Size="ButtonSize.Small"
                                            title="Clear search"
                                            aria-label="Clear search"
                                            Disabled="@Session.IsBusy"
                                            Click="Session.ClearDefinitionSearchAsync"
                                            data-testid="processes-definition-search-clear" />
                                </FilterBar>
                            </Filters>
                        </ListPanelHeader>
                    </ListHeader>

                    <ListContent>
                        @RenderDefinitionListPane()
                    </ListContent>

                    <DetailHeader>
                        @RenderDefinitionIdentityHeader()
                    </DetailHeader>

                    <DetailContent>
                        <Tabs SelectedIndex="@Session.ActiveDetailTabIndex"
                              SelectedIndexChanged="Session.HandleDetailTabChangedAsync"
                              RenderMode="TabRenderMode.Server"
                              Variant="TabsVariant.WorkspaceSecondary"
                              BorderMode="TabsBorderMode.Soft"
                              OverflowMode="TabsOverflowMode.Auto"
                              PanelOverflowMode="TabsPanelOverflowMode.Auto"
                              FillHeight="true"
                              Class="h-full min-h-0 w-full min-w-0"
                              AriaLabel="Process workspace detail panels"
                              data-testid="processes-detail-tabs">
                            @foreach (var tab in Session.DetailTabs) {
                                <TabsItem Text="@tab.Text"
                                          Icon="@tab.Icon"
                                          BadgeText="@tab.BadgeText"
                                          data-testid="@BuildDetailTabTestId(tab.Key)">
                                    @RenderDetailTab(tab)
                                </TabsItem>
                            }
                        </Tabs>
                    </DetailContent>
                </ListDetailShell>
            </Stack>
        }
    </ChildContent>
</PageScaffold>

@if (Session.RunDetailDialogOpen && Session.RunDetailSnapshot is not null) {
    <Dialog IsOpen="true"
            Eyebrow="Process run"
            Title="@BuildRunTitle(Session.RunDetailSnapshot)"
            Subtitle="@BuildRunSubtitle(Session.RunDetailSnapshot)"
            Size="ModalSize.Full"
            DenseChrome="true"
            TestId="processes-run-detail-dialog"
            OnClose="Session.CloseRunDetailDialogAsync">
        <ChildContent>
            @RenderRunDetailDialog(Session.RunDetailSnapshot)
        </ChildContent>
        <Footer>
            <Cluster JustifyContent="JustifyContent.End">
                <Button Text="Close"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Click="Session.CloseRunDetailDialogAsync" />
            </Cluster>
        </Footer>
    </Dialog>
}

@if (Session.EventDetailDialogOpen && Session.EventDetail is not null) {
    <Dialog IsOpen="true"
            Eyebrow="Runtime event"
            Title="@Session.EventDetail.EventType"
            Subtitle="@Session.EventDetail.OccurredAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)"
            Size="ModalSize.Wide"
            DenseChrome="true"
            TestId="processes-runtime-event-detail-dialog"
            OnClose="Session.CloseEventDetailDialogAsync">
        <ChildContent>
            @RenderEventDetailDialog(Session.EventDetail)
        </ChildContent>
        <Footer>
            <Cluster JustifyContent="JustifyContent.End">
                <Button Text="Close"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Click="Session.CloseEventDetailDialogAsync" />
            </Cluster>
        </Footer>
    </Dialog>
}


@code {
    private bool interactive;

    protected override void OnAfterRender(bool firstRender) {
        if (firstRender) {
            interactive = true;
            StateHasChanged();
        }
    }

    [Parameter, EditorRequired] public IProcessWorkspaceSession Session { get; set; } = default!;
    [Parameter] public CanDoItAll.AgentFramework.UI.Chat.ChatWorkspaceBinding? ManagerChat { get; set; }

    private const string AllDefinitionsTreeNodeId = "processes:scope:all";

    private const string ScopeTreeNodePrefix = "processes:scope:";

    private const string DefinitionTreeNodePrefix = "processes:definition:";

    private const decimal RuntimeUsageTokenThousandsDivisor = 1_000m;

    private const decimal RuntimeUsageCostUsdMultiplier = 1_000m;


    private readonly HashSet<string> expandedDefinitionTreeNodeIds =
    [
        BuildScopeTreeNodeId(ProcessDefinitionCatalogScopeKind.Global),
        BuildScopeTreeNodeId(ProcessDefinitionCatalogScopeKind.Project)
    ];


    private static readonly ProcessDefinitionCriticalityLevel[] CriticalityOptions =
    [
        ProcessDefinitionCriticalityLevel.Low,
        ProcessDefinitionCriticalityLevel.Standard,
        ProcessDefinitionCriticalityLevel.High,
        ProcessDefinitionCriticalityLevel.MissionCritical
    ];


    private static readonly ProcessDefinitionAutonomyLevel[] AutonomyOptions =
    [
        ProcessDefinitionAutonomyLevel.Manual,
        ProcessDefinitionAutonomyLevel.Assisted,
        ProcessDefinitionAutonomyLevel.Guarded,
        ProcessDefinitionAutonomyLevel.Delegated
    ];


    private static readonly ProcessDefinitionOperatingModeKind[] OperatingModeOptions =
    [
        ProcessDefinitionOperatingModeKind.Manual,
        ProcessDefinitionOperatingModeKind.AssistedExecution,
        ProcessDefinitionOperatingModeKind.GovernedLive
    ];


    private static readonly ProcessRuntimeHistoryWindow[] RuntimeHistoryWindowOptions =
    [
        ProcessRuntimeHistoryWindow.LiveHour,
        ProcessRuntimeHistoryWindow.OneDay,
        ProcessRuntimeHistoryWindow.SevenDays,
        ProcessRuntimeHistoryWindow.ThirtyDays
    ];


    private RenderFragment RenderDetailTab(ProcessWorkspaceDetailTabDescriptor tab) => @<div class="processes-detail-tab-panel"
                                                                                         data-testid="@BuildDetailPanelTestId(tab.Key)">
        @switch (tab.Key) {
            case ProcessWorkspaceDetailTabKey.Definition:
                @RenderDefinitionBasicsTab()
                break;
            case ProcessWorkspaceDetailTabKey.Roles:
                @RenderRolesTab()
                break;
            case ProcessWorkspaceDetailTabKey.Steps:
                @RenderStepsTab()
                break;
            case ProcessWorkspaceDetailTabKey.Runs:
                @RenderRunsTab()
                break;
            case ProcessWorkspaceDetailTabKey.Graphs:
                @RenderGraphsTab()
                break;
            case ProcessWorkspaceDetailTabKey.Analytics:
                @RenderAnalyticsTab()
                break;
            case ProcessWorkspaceDetailTabKey.Exchange:
                @RenderExchangeTab()
                break;
            case ProcessWorkspaceDetailTabKey.ManagerChat:
                @RenderManagerChatTab()
                break;
        }
    </div>;


    private RenderFragment RenderDefinitionListPane() => @<Stack GapScale="LayoutGap.Medium"
                                                                 Class="h-full min-h-0 overflow-y-auto pr-1"
                                                                 data-testid="processes-definition-list-scroll">
        @if (!string.IsNullOrWhiteSpace(Session.CatalogCommandNotice)) {
            <p class="text-xs font-semibold text-slate-500" data-testid="processes-feed-defaults-receipt">@Session.CatalogCommandNotice</p>
        }

        <TreeView Items="@ProcessDefinitionTreeNodes"
                  Style="TreeViewStyle.Workbench"
                  AriaLabel="Process definitions by scope"
                  EmptyText="No process definitions match the current filters."
                  OnSelect="HandleDefinitionTreeSelectAsync"
                  OnToggle="HandleDefinitionTreeToggleAsync"
                  data-testid="processes-definition-tree" />

        @if (Session.DefinitionCatalog.Items.Count == 0) {
            <EmptyState Eyebrow="No matches"
                        Title="No definitions match the current search"
                        Description="Clear the search or use a broader definition term." />
        }
    </Stack>;


    private RenderFragment RenderDefinitionIdentityHeader() => @<SurfaceCard Class="processes-workspace-identity">
        <Split Breakpoint="LayoutBreakpoint.None"
               AlignItems="AlignItems.Center"
               Gap="LayoutGap.Small"
               Wrap="FlexWrap.Wrap">
            <Cluster Gap="LayoutGap.Small"
                     Wrap="FlexWrap.NoWrap"
                     Class="processes-workspace-identity__copy">
                <p class="cda-eyebrow">Process</p>
                <h2 class="processes-workspace-identity__title">@(Session.DefinitionCatalog.SelectedItem?.Name ?? Session.HeaderTitle)</h2>
            </Cluster>
            <CompactStatStrip Class="processes-workspace-identity__badges">
                @if (Session.DefinitionCatalog.SelectedItem is { } selected) {
                    <CompactStat Tone="@ResolveDefinitionTone(selected.Status)"
                                 Text="@selected.Status.ToString()"
                                 TooltipText="@($"Definition status: {selected.Status}.")" />
                    <CompactStat Tone="neutral"
                                 Text="@selected.Criticality"
                                 TooltipText="Definition criticality." />
                    <CompactStat Tone="info"
                                 Text="@selected.OperatingMode"
                                 TooltipText="Definition operating mode." />
                    @if (selected.CompatibilityIssueCount > 0) {
                        <CompactStat Tone="warning"
                                     Text="@($"{selected.CompatibilityIssueCount} review")"
                                     TooltipText="Template compatibility issues for the selected definition." />
                    }
                } else {
                    <CompactStat Tone="neutral"
                                 Text="No selection"
                                 TooltipText="Select a process definition from the list." />
                }
            </CompactStatStrip>
        </Split>
    </SurfaceCard>;


    private IReadOnlyList<TreeViewNode> ProcessDefinitionTreeNodes {
        get {
            var globalItems = Session.DefinitionCatalog.Items
                .Where(item => item.ScopeKind == ProcessDefinitionCatalogScopeKind.Global)
                .OrderBy(item => item.Name, StringComparer.OrdinalIgnoreCase)
                .Select(BuildDefinitionTreeNode)
                .ToList();
            var projectItems = Session.DefinitionCatalog.Items
                .Where(item => item.ScopeKind == ProcessDefinitionCatalogScopeKind.Project)
                .OrderBy(item => item.Name, StringComparer.OrdinalIgnoreCase)
                .Select(BuildDefinitionTreeNode)
                .ToList();

            return
            [
                new TreeViewNode {
                    Id = AllDefinitionsTreeNodeId,
                    Text = "All definitions",
                    Icon = ResolveScopeIcon(ProcessDefinitionCatalogScopeKind.All),
                    Tooltip = "Show all visible process definitions.",
                    BadgeText = Session.DefinitionCatalog.ScopeGroups.FirstOrDefault(group => group.ScopeKind == ProcessDefinitionCatalogScopeKind.All)?.Count.ToString(CultureInfo.InvariantCulture) ?? Session.DefinitionCatalog.Items.Count.ToString(CultureInfo.InvariantCulture),
                    IsSelected = Session.SelectedDefinitionScope == ProcessDefinitionCatalogScopeKind.All && Session.DefinitionCatalog.SelectedDefinitionKey is null,
                    DataTestId = BuildScopeTestId(ProcessDefinitionCatalogScopeKind.All)
                },
                BuildScopeTreeNode(ProcessDefinitionCatalogScopeKind.Global, "Global defaults", globalItems),
                BuildScopeTreeNode(ProcessDefinitionCatalogScopeKind.Project, "Project definitions", projectItems)
            ];
        }
    }


    private TreeViewNode BuildScopeTreeNode(
        ProcessDefinitionCatalogScopeKind scopeKind,
        string fallbackLabel,
        IReadOnlyList<TreeViewNode> children) {
        var group = Session.DefinitionCatalog.ScopeGroups.FirstOrDefault(item => item.ScopeKind == scopeKind);
        var nodeId = BuildScopeTreeNodeId(scopeKind);
        return new TreeViewNode {
            Id = nodeId,
            Text = group?.Label ?? fallbackLabel,
            Icon = ResolveScopeIcon(scopeKind),
            Tooltip = group?.Description ?? fallbackLabel,
            BadgeText = (group?.Count ?? children.Count).ToString(CultureInfo.InvariantCulture),
            IsExpanded = expandedDefinitionTreeNodeIds.Contains(nodeId),
            IsSelected = Session.SelectedDefinitionScope == scopeKind && Session.DefinitionCatalog.SelectedDefinitionKey is null,
            DataTestId = BuildScopeTestId(scopeKind),
            ChildrenDataTestId = $"{BuildScopeTestId(scopeKind)}-children",
            Children = children
        };
    }


    private TreeViewNode BuildDefinitionTreeNode(ProcessDefinitionCatalogItemProjection item)
        => new() {
            Id = BuildDefinitionTreeNodeId(item.Key),
            Text = item.Name,
            Icon = ResolveDefinitionIcon(item.Status),
            Tooltip = item.Summary,
            BadgeText = item.Status.ToString(),
            IsSelected = item.Key == Session.DefinitionCatalog.SelectedDefinitionKey,
            DataTestId = BuildDefinitionItemTestId(item.Key)
        };


    private async Task HandleDefinitionTreeSelectAsync(string nodeId) {
        if (string.Equals(nodeId, AllDefinitionsTreeNodeId, StringComparison.Ordinal)) {
            await Session.SelectDefinitionScopeAsync(ProcessDefinitionCatalogScopeKind.All);
            return;
        }

        if (nodeId.StartsWith(ScopeTreeNodePrefix, StringComparison.Ordinal)) {
            var scopeValue = nodeId[ScopeTreeNodePrefix.Length..];
            if (Enum.TryParse<ProcessDefinitionCatalogScopeKind>(scopeValue, ignoreCase: false, out var scopeKind)) {
                await Session.SelectDefinitionScopeAsync(scopeKind);
            }

            return;
        }

        if (nodeId.StartsWith(DefinitionTreeNodePrefix, StringComparison.Ordinal)) {
            await Session.SelectDefinitionAsync(new ProcessDefinitionCatalogItemKey(nodeId[DefinitionTreeNodePrefix.Length..]));
        }
    }


    private Task HandleDefinitionTreeToggleAsync(string nodeId) {
        if (!expandedDefinitionTreeNodeIds.Add(nodeId)) {
            expandedDefinitionTreeNodeIds.Remove(nodeId);
        }

        return Task.CompletedTask;
    }


    private RenderFragment RenderDefinitionBasicsTab() => @<div data-testid="processes-definition-basics-tab">
        @if (Session.DefinitionCatalog.SelectedEditor is null) {
            <EmptyState Eyebrow="No definition selected"
                        Title="Select a process definition"
                        Description="The definition editor opens after a process is selected from the tree." />
        } else {
            @RenderDefinitionEditor(Session.DefinitionCatalog.SelectedEditor)
        }
    </div>;


    private RenderFragment RenderRolesTab() => @<div data-testid="processes-definition-roles-tab">
        @if (Session.DefinitionCatalog.SelectedEditor?.RoleEditor is null) {
            <EmptyState Eyebrow="Roles"
                        Title="No role projection is available"
                        Description="Select a definition with role projections before editing role requirements." />
        } else {
            <ProcessDefinitionRoleEditorPanel State="@Session.RoleEditorState" RoleEditor="Session.DefinitionCatalog.SelectedEditor.RoleEditor"
                                              Scope="Session.ResolveScope()"
                                              Disabled="@Session.IsBusy"
                                              ExecuteCommand="Session.ExecuteDefinitionRoleEditorCommandAsync" />
        }
    </div>;


    private RenderFragment RenderStepsTab() => @<Stack GapScale="LayoutGap.Large"
                                                       Class="processes-definition-steps-tab"
                                                       data-testid="processes-definition-steps-tab">
        @if (Session.DefinitionCatalog.SelectedEditor?.Canvas is null &&
             Session.DefinitionCatalog.SelectedEditor?.StepEditor is null) {
            <EmptyState Eyebrow="Steps"
                        Title="No step projection is available"
                        Description="Select a definition with canvas and step projections before editing the workflow graph." />
        } else {
            @if (Session.DefinitionCatalog.SelectedEditor.Canvas is not null) {
                <ProcessDefinitionCanvasPanel Canvas="Session.DefinitionCatalog.SelectedEditor.Canvas"
                                              Scope="Session.ResolveScope()"
                                              Disabled="@Session.IsBusy"
                                              ExecuteCommand="Session.ExecuteDefinitionCanvasCommandAsync" />
            }

            @if (Session.DefinitionCatalog.SelectedEditor.StepEditor is not null) {
                <ProcessDefinitionStepEditorPanel State="@Session.StepEditorState" StepEditor="Session.DefinitionCatalog.SelectedEditor.StepEditor"
                                                  Scope="Session.ResolveScope()"
                                                  Disabled="@Session.IsBusy"
                                                  ExecuteCommand="Session.ExecuteDefinitionStepEditorCommandAsync" />
            }
        }
    </Stack>;


    private RenderFragment RenderExchangeTab() => @<div data-testid="processes-definition-exchange-tab">
        @if (Session.DefinitionCatalog.SelectedEditor?.TemplateCatalog is null) {
            <EmptyState Eyebrow="Exchange"
                        Title="No template projection is available"
                        Description="Template compatibility, import, and version preview open after a definition is selected." />
        } else {
            <ProcessTemplateLibraryPanel TemplateCatalog="Session.DefinitionCatalog.SelectedEditor.TemplateCatalog"
                                         State="Session.TemplateBrowserState"
                                         Scope="Session.ResolveScope()"
                                         Disabled="@Session.IsBusy"
                                         QueryChanged="Session.ApplyTemplateCatalogQueryAsync"
                                         ExecuteImport="Session.ExecuteTemplateImportCommandAsync" />
        }
    </div>;


    private RenderFragment RenderRunsTab() => @<Stack GapScale="LayoutGap.Large"
                                                      Class="processes-runs-tab-shell"
                                                      data-testid="processes-runs-tab-shell">
        @RenderRuntimeToolbar("processes-runs-runtime-toolbar")

        <SurfaceCard Soft="true"
                     data-testid="processes-selected-run-summary">
            <Split Gap="LayoutGap.Medium"
                   Wrap="FlexWrap.Wrap">
                <Stack GapScale="LayoutGap.Tiny">
                    <TextBlock TextStyle="TextStyle.Eyebrow" Value="Run focus" />
                    <h3 class="text-base font-semibold text-slate-900">@SelectedRunTitle</h3>
                    <p class="text-sm leading-6 text-slate-600">@Session.CurrentShell.Runtime.AttentionSummary</p>
                </Stack>
                <CompactStatStrip>
                    <CompactStat Tone="success"
                                 Text="@($"{Session.CurrentShell.Runtime.Stats.ActiveRunCount} active")"
                                 TooltipText="Active process runs in the selected window." />
                    <CompactStat Tone="warning"
                                 Text="@($"{Session.CurrentShell.Runtime.Stats.AttentionRunCount} attention")"
                                 TooltipText="Runs that need operator review." />
                    <CompactStat Tone="danger"
                                 Text="@($"{Session.CurrentShell.Runtime.Stats.FailedRunCount} failed")"
                                 TooltipText="Failed runs in the selected window." />
                    <CompactStat Tone="@Session.ProjectionTone"
                                 Text="@Session.ProjectionStatusText"
                                 TooltipText="@Session.ProjectionTooltip" />
                </CompactStatStrip>
            </Split>
        </SurfaceCard>

        <Tabs SelectedIndex="@Session.SelectedRunViewIndex"
              SelectedIndexChanged="Session.HandleSelectedRunViewChangedAsync"
              Variant="TabsVariant.WorkspaceSecondary"
              BorderMode="TabsBorderMode.Soft"
              OverflowMode="TabsOverflowMode.Auto"
              PanelOverflowMode="TabsPanelOverflowMode.Auto"
              Class="w-full min-w-0"
              AriaLabel="Process runs workspace sections"
              data-testid="processes-runs-tabs">
            <TabsItem Text="Launch" Icon="rocket_launch">
                @RenderLaunchSection()
            </TabsItem>
            <TabsItem Text="Activity" Icon="monitoring">
                @RenderRuntimeActivitySection()
            </TabsItem>
            <TabsItem Text="Control" Icon="rule">
                @RenderRuntimeControlSection()
            </TabsItem>
            <TabsItem Text="Execution" Icon="terminal">
                @RenderRuntimeExecutionSection()
            </TabsItem>
            <TabsItem Text="Graphs" Icon="bar_chart">
                <div data-testid="processes-selected-run-graphs-tab">
                    @RenderGraphMetricGrid("Selected run graph projection")
                </div>
            </TabsItem>
            <TabsItem Text="Coordination" Icon="hub">
                @RenderRuntimeCoordinationSection()
            </TabsItem>
            <TabsItem Text="Evidence" Icon="inventory_2">
                @RenderRuntimeEvidenceSection()
            </TabsItem>
        </Tabs>
    </Stack>;


    private RenderFragment RenderGraphsTab() => @<Stack GapScale="LayoutGap.Medium"
                                                        data-testid="processes-process-graphs-tab">
        @if (Session.ProcessGraphsHistoryLoaded) {
            @RenderRuntimeToolbar("processes-process-graphs-toolbar")
            @RenderGraphMetricGrid("Process run history graph projection")
        } else {
            @RenderGraphHistoryLoadGate()
        }
    </Stack>;


    private RenderFragment RenderAnalyticsTab() => @<Stack GapScale="LayoutGap.Medium"
                                                           data-testid="processes-analytics-tab">
        <Grid Gap="LayoutGap.Medium" ColumnsLg="4">
            @RenderMetricCard("Readiness", Session.DefinitionCatalog.SelectedEditor?.Simulation.IsReadyForSimulation == true ? "Ready" : "Review", Session.DefinitionCatalog.SelectedEditor?.Simulation.IsReadyForSimulation == true ? "success" : "warning", "Simulation readiness from the selected definition projection.")
            @RenderMetricCard("Compatibility", Session.DefinitionCatalog.TemplateCompatibilityIssueCount.ToString(CultureInfo.InvariantCulture), Session.DefinitionCatalog.TemplateCompatibilityIssueCount > 0 ? "warning" : "success", "Template compatibility issues for the current catalog.")
            @RenderMetricCard("Runtime events", Session.CurrentShell.Runtime.Stats.EventCount.ToString(CultureInfo.InvariantCulture), "info", "Paged runtime history events in the selected window.")
            @RenderMetricCard("Projection backlog", Session.CurrentShell.Refresh.BacklogEventCount.ToString(CultureInfo.InvariantCulture), Session.ProjectionTone, Session.CurrentShell.Refresh.Summary)
        </Grid>

        <Grid Gap="LayoutGap.Medium"
              ColumnTemplateXl="minmax(0,1.2fr) minmax(0,0.8fr)"
              data-testid="processes-runtime-analytics-ledger">
            @RenderRuntimeEventLedger("processes-analytics-event-ledger")
            @RenderToolUsageLedger("processes-analytics-tool-usage")
        </Grid>
    </Stack>;


    private RenderFragment RenderManagerChatTab() => @<Grid Gap="LayoutGap.Medium"
                                                            ColumnTemplateXl="minmax(16rem,0.35fr) minmax(0,1.65fr)"
                                                            Class="h-full min-h-0 w-full"
                                                            data-testid="processes-manager-chat-tab">
        <SurfaceCard Soft="true"
                     Class="h-full min-h-0"
                     data-testid="processes-manager-chat-context">
            <Stack GapScale="LayoutGap.Medium">
                <Stack GapScale="LayoutGap.Tiny">
                    <TextBlock TextStyle="TextStyle.Eyebrow" Value="Process manager" />
                    <h3 class="text-base font-semibold text-slate-900">@Session.ManagerChatManagerLabel</h3>
                    <p class="text-sm leading-6 text-slate-600">@Session.CurrentShell.AgentEntry.ContextKey</p>
                </Stack>

                <Stack GapScale="LayoutGap.Small">
                    <label class="text-xs font-semibold text-slate-500" for="processes-manager-chat-history-window">History length</label>
                    <select id="processes-manager-chat-history-window"
                            class="cda-input"
                            value="@Session.ManagerChatHistoryWindow"
                            @onchange="Session.ChangeManagerChatHistoryWindowAsync"
                            data-testid="processes-manager-chat-history-window">
                        @foreach (var option in RuntimeHistoryWindowOptions) {
                            <option value="@option">@FormatHistoryWindow(option)</option>
                        }
                    </select>

                    <label class="text-xs font-semibold text-slate-500" for="processes-manager-chat-run-select">Run</label>
                    <select id="processes-manager-chat-run-select"
                            class="cda-input"
                            value="@RuntimeRunSelectValue"
                            @onchange="Session.SelectRuntimeRunAsync"
                            data-testid="processes-manager-chat-run-select">
                        @RenderRuntimeRunOptions()
                    </select>

                    <label class="text-xs font-semibold text-slate-500" for="processes-manager-chat-agent-select">Manager agent</label>
                    <select id="processes-manager-chat-agent-select"
                            class="cda-input"
                            value="@Session.ManagerChatAgentSelectValue"
                            @onchange="Session.SelectManagerChatAgentAsync"
                            disabled="@(Session.ManagerChatAgents.Count == 0)"
                            data-testid="processes-manager-chat-agent-select">
                        @foreach (var agent in Session.ManagerChatAgents) {
                            <option value="@agent.Id.ToString("D")">@agent.Name</option>
                        }
                    </select>
                </Stack>

                <Cluster Gap="LayoutGap.XSmall"
                         Class="flex-wrap">
                    <StatusBadge Tone="@(Session.CurrentShell.AgentEntry.IsAvailable ? "success" : "warning")"
                                 Text="@(Session.CurrentShell.AgentEntry.IsAvailable ? "Available" : "Unavailable")" />
                    <StatusBadge Tone="neutral" Text="@Session.CurrentShell.AgentEntry.Kind.ToString()" />
                    <StatusBadge Tone="info" Text="@SelectedRunTitle" />
                </Cluster>

                <Button Text="Reload"
                        Icon="refresh"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Class="w-full justify-start"
                        Disabled="@Session.ManagerChatReloadDisabled"
                        IsBusy="@Session.ManagerChatIsLoading"
                        Click="Session.ReloadManagerChatAsync"
                        data-testid="processes-manager-chat-reload" />
                <Button Text="Open agent context"
                        Icon="smart_toy"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Class="w-full justify-start"
                        Disabled="@Session.AgentContextDisabled"
                        Click="Session.OpenAgentContext"
                        data-testid="processes-manager-chat-open-agent-context" />
            </Stack>
        </SurfaceCard>

        <div class="h-full min-h-0" data-testid="processes-manager-chat-workspace">
            @if (Session.ManagerChatIsLoading) {
                <LoadingState Eyebrow="Manager chat"
                              Title="Loading manager workspace"
                              Description="Resolving the selected run and manager agent thread." />
            } else if (!string.IsNullOrWhiteSpace(Session.ManagerChatErrorMessage)) {
                <EmptyState Eyebrow="Manager chat unavailable"
                            Title="Manager chat cannot be opened"
                            Description="@Session.ManagerChatErrorMessage" />
            } else if (!Session.HasManagerChatAgent) {
                <EmptyState Eyebrow="Manager chat"
                            Title="No manager agent is available"
                            Description="Create or enable a process manager agent before starting a run-scoped conversation." />
            } else {
                @if (ManagerChat is not null) {
                    <ProcessManagerChatSurface Binding="ManagerChat" />
                }
            }
        </div>
    </Grid>;


    private RenderFragment RenderGraphMetricGrid(string title) => @<Stack GapScale="LayoutGap.Medium"
                                                                          data-testid="processes-graph-metric-grid">
        <Grid Gap="LayoutGap.Medium" ColumnsLg="4">
            @RenderMetricCard("Cost", Session.FormatCurrency(Session.CurrentShell.Runtime.Stats.ActualCost), Session.CurrentShell.Runtime.Stats.ActualCost > 0 ? "success" : "neutral", $"{title}: actual cost projected from runtime usage data when provider metrics are linked.")
            @RenderMetricCard("Tokens", FormatTokenCount(ResolveRuntimeTotalTokens(Session.CurrentShell.Runtime.Stats)), ResolveRuntimeTotalTokens(Session.CurrentShell.Runtime.Stats) > 0 ? "info" : "neutral", "Provider-reported total tokens for the selected history scope, including hidden reasoning tokens when reported.")
            @RenderMetricCard("Time", FormatDuration(Session.CurrentShell.Runtime.Stats.DurationMs), Session.CurrentShell.Runtime.Stats.DurationMs > 0 ? "info" : "neutral", "Observed runtime span in the selected history page.")
            @RenderMetricCard("Tool usage", Session.CurrentShell.Runtime.Stats.ToolCallCount.ToString(CultureInfo.InvariantCulture), Session.CurrentShell.Runtime.Stats.ToolCallCount > 0 ? "warning" : "neutral", "Runtime dispatch, step, and manager events grouped as tool/activity usage.")
        </Grid>

        <Grid Gap="LayoutGap.Medium"
              ColumnTemplateXl="minmax(0,1fr) minmax(0,1fr)"
              Class="w-full">
            <CdaChart Title="Runtime activity"
                      Description="Events, manager signals, and grouped tool activity."
                      Series="@RuntimeActivitySeries"
                      Options="@RuntimeActivityChartOptions"
                      Height="320"
                      EmptyText="No runtime events match the selected history window." />
            <CdaChart Title="Token and cost telemetry"
                      Description="Provider usage appears when linked runtime metrics are projected."
                      Series="@RuntimeUsageSeries"
                      Options="@RuntimeUsageChartOptions"
                      Height="320"
                      EmptyText="No provider usage metrics are linked to this process run yet." />
            <CdaChart Title="Tool usage"
                      Description="Most active runtime event/tool categories."
                      Series="@RuntimeToolUsageSeries"
                      Options="@RuntimeToolUsageChartOptions"
                      Height="320"
                      EmptyText="No runtime tool activity is present in this scope." />
        </Grid>
    </Stack>;


    private static readonly CdaChartOptions RuntimeActivityChartOptions = new() {
        Type = CdaChartType.Area,
        XAxisType = CdaChartAxisType.DateTime,
        YAxisTitle = "Events",
        TooltipPrecision = 0,
        ValuePrecision = 0,
        FillOpacity = 0.22,
        LegendPosition = CdaChartLegendPosition.Bottom,
        Palette = ["#2563eb", "#7c3aed", "#0891b2"]
    };


    private static readonly CdaChartOptions RuntimeUsageChartOptions = new() {
        Type = CdaChartType.Bar,
        XAxisType = CdaChartAxisType.DateTime,
        YAxisTitle = "k tokens / min / USD x1k",
        TooltipPrecision = 2,
        ValuePrecision = 2,
        ShowToolbar = false,
        EnableZoom = false,
        LegendPosition = CdaChartLegendPosition.Bottom,
        Palette = ["#16a34a", "#d97706", "#dc2626"]
    };


    private static readonly CdaChartOptions RuntimeToolUsageChartOptions = new() {
        Type = CdaChartType.Bar,
        XAxisType = CdaChartAxisType.Category,
        YAxisTitle = "Calls",
        TooltipPrecision = 0,
        ValuePrecision = 0,
        ShowToolbar = false,
        EnableZoom = false,
        RotateXAxisLabels = false,
        LegendPosition = CdaChartLegendPosition.Bottom,
        Palette = ["#f59e0b"]
    };


    private IReadOnlyList<CdaChartSeries> RuntimeActivitySeries {
        get {
            var points = Session.CurrentShell.Runtime.MetricPoints;
            if (points.Count == 0) {
                return [];
            }

            return
            [
                new CdaChartSeries {
                    Name = "Runtime events",
                    Type = CdaChartType.Area,
                    Color = "#2563eb",
                    Points = points.Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, item.EventCount)).ToArray()
                },
                new CdaChartSeries {
                    Name = "Manager signals",
                    Type = CdaChartType.Line,
                    Color = "#7c3aed",
                    Points = points.Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, item.ManagerEventCount)).ToArray()
                },
                new CdaChartSeries {
                    Name = "Tool activity",
                    Type = CdaChartType.Line,
                    Color = "#0891b2",
                    Points = points.Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, item.ToolCallCount)).ToArray()
                }
            ];
        }
    }


    private IReadOnlyList<CdaChartSeries> RuntimeUsageSeries {
        get {
            var points = Session.CurrentShell.Runtime.MetricPoints;
            if (points.Count == 0) {
                return [];
            }

            return
            [
                new CdaChartSeries {
                    Name = "Tokens (k)",
                    Type = CdaChartType.Bar,
                    Color = "#16a34a",
                    Points = points.Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, ScaleRuntimeTokensToThousands(item))).ToArray()
                },
                new CdaChartSeries {
                    Name = "Minutes",
                    Type = CdaChartType.Line,
                    Color = "#d97706",
                    Points = points.Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, ScaleRuntimeDurationToMinutes(item))).ToArray()
                },
                new CdaChartSeries {
                    Name = "Cost (USD x1k)",
                    Type = CdaChartType.Line,
                    Color = "#dc2626",
                    Points = points.Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, ScaleRuntimeCostByUsdMultiplier(item))).ToArray()
                }
            ];
        }
    }


    private IReadOnlyList<CdaChartSeries> RuntimeToolUsageSeries {
        get {
            var toolUsage = Session.CurrentShell.Runtime.ToolUsage.Take(15).ToArray();
            if (toolUsage.Length == 0) {
                return [];
            }

            return
            [
                new CdaChartSeries {
                    Name = "Calls",
                    Type = CdaChartType.Bar,
                    Color = "#f59e0b",
                    Points = toolUsage.Select(item => new CdaChartPoint(TrimLabel(item.ToolName, 26), item.CallCount)).ToArray()
                }
            ];
        }
    }


    private string SelectedRunTitle
        => Session.CurrentShell.Runtime.SelectedRun is { } selectedRun
            ? BuildRunTitle(selectedRun)
            : Session.CurrentShell.Runtime.Runs.Count == 0
                ? "No runtime run selected"
                : "Select a runtime run";


    private string RuntimeRunSelectValue => (Session.SelectedRuntimeRunId ?? Session.CurrentShell.Runtime.SelectedRunId)?.ToString("D") ?? string.Empty;


    private RenderFragment RenderGraphHistoryLoadGate() => @<SurfaceCard Soft="true"
                                                                         Class="processes-graphs-load-gate"
                                                                         data-testid="processes-process-graphs-load-gate">
        <Grid Gap="LayoutGap.Medium"
              ColumnTemplateXl="minmax(14rem,0.6fr) minmax(16rem,1fr) auto"
              AlignItems="AlignItems.End">
            <Stack GapScale="LayoutGap.Tiny">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="History on demand" />
                <label class="text-xs font-semibold text-slate-500" for="processes-process-graphs-load-window">History window</label>
                <select id="processes-process-graphs-load-window"

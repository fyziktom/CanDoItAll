                                <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                                    <StatusBadge Tone="neutral" Text="@wait.ParentStepKey" />
                                    <StatusBadge Tone="info" Text="@($"child {wait.ChildRunId.ToString("N")[..8]}")" />

                <label class="text-xs font-semibold text-slate-500" for="processes-definition-constitution-input">Constitution rule</label>
                <textarea id="processes-definition-constitution-input"
                          class="min-h-9 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm"
                          value="@Session.DefinitionDraft.ConstitutionRuleSummary"
                          @oninput="args => Session.DefinitionDraft.ConstitutionRuleSummary = ReadChangeValue(args)"
                          data-testid="processes-definition-editor-constitution"></textarea>
                <label class="text-xs font-semibold text-slate-500" for="processes-definition-operating-summary-input">Operating mode summary</label>
                <textarea id="processes-definition-operating-summary-input"
                          class="min-h-9 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm"
                          value="@Session.DefinitionDraft.OperatingModeSummary"
                          @oninput="args => Session.DefinitionDraft.OperatingModeSummary = ReadChangeValue(args)"
                          data-testid="processes-definition-editor-operating-summary"></textarea>
            </Stack>

            <Stack GapScale="LayoutGap.Small" data-testid="processes-definition-editor-simulation">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Simulation" />
                <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                    <StatusBadge Tone="info" Text="@($"{Session.DefinitionDraft.StepCount} step(s)")" />
                    <StatusBadge Tone="neutral" Text="@($"{Session.DefinitionDraft.RequiredArtifactExpectationCount} required artifact(s)")" />
                </Cluster>
                <label class="text-xs font-semibold text-slate-500" for="processes-definition-simulation-input">Simulation readiness</label>
                <textarea id="processes-definition-simulation-input"
                          class="min-h-9 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm"
                          value="@Session.DefinitionDraft.SimulationReadinessSummary"
                          @oninput="args => Session.DefinitionDraft.SimulationReadinessSummary = ReadChangeValue(args)"
                          data-testid="processes-definition-editor-simulation-readiness"></textarea>

                <div class="rounded-md border border-slate-200 bg-slate-50 p-3" data-testid="processes-definition-lint-panel">
                    <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                        <StatusBadge Tone="@ResolveEditorLintTone(editor.Lint)" Text="@ResolveEditorLintText(editor.Lint)" />
                    </Cluster>
                    @if (!editor.Lint.HasWarningsOrErrors) {
                        <p class="mt-2 text-sm leading-6 text-slate-600">No blocking lint issues.</p>
                    } else {
                        @foreach (var issue in editor.Lint.Issues) {
                            <div class="mt-3 border-t border-slate-200 pt-3">
                                <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                                    <StatusBadge Tone="@ResolveLintIssueTone(issue.Severity)" Text="@issue.Severity.ToString()" />
                                    <span class="text-xs font-semibold text-slate-500">@issue.Section.ToString()</span>
                                    <span class="text-xs text-slate-500">@issue.Code</span>
                                </Cluster>
                                <p class="mt-2 text-sm leading-6 text-slate-700">@issue.Message</p>
                                <p class="text-xs leading-5 text-slate-500">@issue.Suggestion</p>
                            </div>
                        }
                    }
                </div>
            </Stack>
        </Grid>

        <Cluster Gap="LayoutGap.Small" Class="mt-5 flex-wrap justify-end">
            @foreach (var command in editor.Commands) {
                <Button Text="@command.Text"
                        Icon="@command.Icon"
                        ButtonStyle="@ResolveDefinitionEditorCommandButtonStyle(command.Kind)"
                        Size="ButtonSize.Small"
                        Disabled="@(!command.IsEnabled || Session.IsBusy)"
                        IsBusy="@Session.IsBusy"
                        Click="@(() => Session.ExecuteDefinitionEditorCommandAsync(command.Kind))"
                        title="@command.DisabledReason"
                        data-testid="@BuildDefinitionEditorCommandTestId(command.Kind)" />
            }
        </Cluster>
    </div>;


    private static string ReadChangeValue(ChangeEventArgs args)
        => args.Value?.ToString() ?? string.Empty;


    private static ProcessDefinitionCriticalityLevel ParseCriticality(ChangeEventArgs args)
        => Enum.TryParse<ProcessDefinitionCriticalityLevel>(ReadChangeValue(args), out var parsed)
            ? parsed
            : ProcessDefinitionCriticalityLevel.Standard;


    private static ProcessDefinitionAutonomyLevel ParseAutonomy(ChangeEventArgs args)
        => Enum.TryParse<ProcessDefinitionAutonomyLevel>(ReadChangeValue(args), out var parsed)
            ? parsed
            : ProcessDefinitionAutonomyLevel.Assisted;


    private static ProcessDefinitionOperatingModeKind ParseOperatingMode(ChangeEventArgs args)
        => Enum.TryParse<ProcessDefinitionOperatingModeKind>(ReadChangeValue(args), out var parsed)
            ? parsed
            : ProcessDefinitionOperatingModeKind.AssistedExecution;


    private static string ResolveScopeIcon(ProcessDefinitionCatalogScopeKind scopeKind)
        => scopeKind switch {
            ProcessDefinitionCatalogScopeKind.All => "select_all",
            ProcessDefinitionCatalogScopeKind.Global => "public",
            ProcessDefinitionCatalogScopeKind.Project => "folder",
            _ => "account_tree"
        };


    private static string ResolveDefinitionIcon(ProcessDefinitionCatalogItemStatus status)
        => status switch {
            ProcessDefinitionCatalogItemStatus.Published => "verified",
            ProcessDefinitionCatalogItemStatus.Draft => "edit_note",
            ProcessDefinitionCatalogItemStatus.RequiresReview => "report",
            ProcessDefinitionCatalogItemStatus.TemplateDefault => "account_tree",
            _ => "account_tree"
        };


    private static string ResolveDefinitionTone(ProcessDefinitionCatalogItemStatus status)
        => status switch {
            ProcessDefinitionCatalogItemStatus.TemplateDefault => "info",
            ProcessDefinitionCatalogItemStatus.Published => "success",
            ProcessDefinitionCatalogItemStatus.Draft => "neutral",
            ProcessDefinitionCatalogItemStatus.RequiresReview => "warning",
            _ => "neutral"
        };


    private static string ResolveEditorStatusTone(ProcessDefinitionAuthoringStatus status)
        => status switch {
            ProcessDefinitionAuthoringStatus.TemplateDefault => "info",
            ProcessDefinitionAuthoringStatus.Draft => "neutral",
            ProcessDefinitionAuthoringStatus.Published => "success",
            ProcessDefinitionAuthoringStatus.Archived => "warning",
            _ => "neutral"
        };


    private static string ResolveEditorLintTone(ProcessDefinitionEditorLintProjection lint) {
        if (lint.HasBlockingIssues) {
            return "danger";
        }

        return lint.HasWarningsOrErrors ? "warning" : "success";
    }


    private static string ResolveEditorLintText(ProcessDefinitionEditorLintProjection lint) {
        if (lint.HasBlockingIssues) {
            return $"{lint.Issues.Count(issue => issue.Severity == ProcessDefinitionEditorLintSeverity.Error)} blocking";
        }

        return lint.HasWarningsOrErrors ? $"{lint.Issues.Count} lint issue(s)" : "Lint clear";
    }


    private static string ResolveLintIssueTone(ProcessDefinitionEditorLintSeverity severity)
        => severity switch {
            ProcessDefinitionEditorLintSeverity.Error => "danger",
            ProcessDefinitionEditorLintSeverity.Warning => "warning",
            ProcessDefinitionEditorLintSeverity.Info => "info",
            _ => "neutral"
        };


    private static ButtonStyle ResolveDefinitionEditorCommandButtonStyle(ProcessDefinitionEditorCommandKind kind)
        => kind switch {
            ProcessDefinitionEditorCommandKind.SaveDraft => ButtonStyle.Primary,
            ProcessDefinitionEditorCommandKind.Publish => ButtonStyle.Success,
            ProcessDefinitionEditorCommandKind.Archive => ButtonStyle.Light,
            ProcessDefinitionEditorCommandKind.Delete => ButtonStyle.Danger,
            _ => ButtonStyle.Light
        };


    private static string BuildScopeTestId(ProcessDefinitionCatalogScopeKind kind)
        => $"processes-definition-scope-{kind.ToString().ToLowerInvariant()}";


    private static string BuildScopeTreeNodeId(ProcessDefinitionCatalogScopeKind kind)
        => $"{ScopeTreeNodePrefix}{kind}";


    private static string BuildDefinitionTreeNodeId(ProcessDefinitionCatalogItemKey key)
        => $"{DefinitionTreeNodePrefix}{key.Value}";


    private static string BuildDefinitionItemTestId(ProcessDefinitionCatalogItemKey key) {
        var normalized = new string(key.Value
            .Select(character => char.IsLetterOrDigit(character) ? char.ToLowerInvariant(character) : '-')
            .ToArray());
        return $"processes-definition-{normalized}";
    }


    private static string BuildCommandTestId(ProcessWorkspaceCommandKind kind)
        => kind switch {
            ProcessWorkspaceCommandKind.RefreshProjections => "processes-refresh",
            ProcessWorkspaceCommandKind.OpenAgentContext => "processes-agent-context",
            ProcessWorkspaceCommandKind.FeedDefaults => "processes-feed-defaults",
            ProcessWorkspaceCommandKind.OpenLiveDashboard => "processes-open-live-dashboard",
            _ => $"processes-command-{kind.ToString().ToLowerInvariant()}"
        };


    private static string BuildDefinitionEditorCommandTestId(ProcessDefinitionEditorCommandKind kind)
        => kind switch {
            ProcessDefinitionEditorCommandKind.SaveDraft => "processes-definition-save",
            ProcessDefinitionEditorCommandKind.Publish => "processes-definition-publish",
            ProcessDefinitionEditorCommandKind.Archive => "processes-definition-archive",
            ProcessDefinitionEditorCommandKind.Delete => "processes-definition-delete",
            _ => $"processes-definition-command-{kind.ToString().ToLowerInvariant()}"
        };


    private static string BuildDetailTabTestId(ProcessWorkspaceDetailTabKey key)
        => key == ProcessWorkspaceDetailTabKey.Definition
            ? "processes-tab-definitions"
            : $"processes-detail-tab-{NormalizeDetailTabKey(key)}";


    private static string BuildDetailPanelTestId(ProcessWorkspaceDetailTabKey key)
        => key == ProcessWorkspaceDetailTabKey.Definition
            ? "processes-tab-panel-definitions"
            : $"processes-detail-panel-{NormalizeDetailTabKey(key)}";


    private static string NormalizeDetailTabKey(ProcessWorkspaceDetailTabKey key)
        => key.ToString().ToLowerInvariant().Replace("managerchat", "manager-chat", StringComparison.Ordinal);

}

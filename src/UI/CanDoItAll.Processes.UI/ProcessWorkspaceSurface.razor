    private RenderFragment RenderRuntimeRunOptions() => @<text>
        @if (Session.CurrentShell.Runtime.Runs.Count == 0) {
            <option value="">No runtime runs</option>
        } else {
            <option value="">All runs</option>
            @foreach (var run in Session.CurrentShell.Runtime.Runs) {
                <option value="@run.RunId.Value.ToString("D")">@BuildRunOptionText(run)</option>
            }
        }
    </text>;


    private RenderFragment RenderLaunchSection() => @<Grid Gap="LayoutGap.Medium"
                                                           ColumnsLg="2"
                                                           data-testid="processes-run-launch-section">
        <SurfaceCard Soft="true">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Launch planning" />
            <h3 class="text-base font-semibold text-slate-900">@(Session.DefinitionCatalog.SelectedItem?.Name ?? "Select a definition")</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">@(Session.DefinitionCatalog.SelectedItem?.ExecutableSource switch {
                ProcessDefinitionExecutableSource.GlobalPublication => "Launch uses the published global definition.",
                ProcessDefinitionExecutableSource.ProjectPublication => "Launch uses the published project definition.",
                ProcessDefinitionExecutableSource.TemplateDefault => "Launch uses the inherited template default.",
                _ => "This definition is unavailable for new launches."
            })</p>
            <Cluster Gap="LayoutGap.XSmall" Class="mt-4 flex-wrap">
                <StatusBadge Tone="info" Text="@ResolveHistoryWindowText(Session.CurrentShell.Runtime.HistoryWindow)" />
                <StatusBadge Tone="@ResolveEditorStatusTone(Session.DefinitionCatalog.SelectedEditor?.Status ?? ProcessDefinitionAuthoringStatus.TemplateDefault)" Text="@(Session.DefinitionCatalog.SelectedEditor?.Status.ToString() ?? "No definition")" />
            </Cluster>
            <Button Text="Launch"
                    Icon="rocket_launch"
                    ButtonStyle="ButtonStyle.Success"
                    Size="ButtonSize.Small"
                    Class="mt-4"
                    Disabled="@(Session.IsBusy || Session.DefinitionCatalog.SelectedItem?.CanLaunch != true)"
                    IsBusy="@Session.IsBusy"
                    Click="Session.LaunchSelectedDefinitionAsync"
                    data-testid="processes-runs-launch-selected-definition" />
        </SurfaceCard>
        @RenderRunList("processes-run-launch-run-list")
    </Grid>;


    private RenderFragment RenderRuntimeActivitySection() => @<Grid Gap="LayoutGap.Medium"
                                                                    ColumnTemplateXl="minmax(0,0.9fr) minmax(0,1.1fr)"
                                                                    data-testid="processes-run-activity">
        @RenderRunList("processes-run-activity-list")
        @RenderRuntimeEventLedger("processes-run-activity-events")
    </Grid>;


    private RenderFragment RenderRuntimeControlSection() => @<Grid Gap="LayoutGap.Medium"
                                                                   ColumnTemplateXl="minmax(0,0.8fr) minmax(0,1.2fr)"
                                                                   data-testid="processes-operator-control-section">
        <SurfaceCard Soft="true">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Manager resolution" />
            <h3 class="text-base font-semibold text-slate-900">@Session.CurrentShell.Runtime.AttentionSummary</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">Manager incidents, recovery denials, branch rejections, and loop-budget escalations are projected from runtime events.</p>
        </SurfaceCard>
        @RenderIncidentLedger("processes-run-control-incidents")
    </Grid>;


    private RenderFragment RenderRuntimeExecutionSection() => @<Grid Gap="LayoutGap.Medium"
                                                                     ColumnTemplateXl="minmax(0,1fr) minmax(0,1fr)"
                                                                     data-testid="processes-runtime-host-readback">
        <SurfaceCard Soft="true">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Selected run" />
            <h3 class="text-base font-semibold text-slate-900">@SelectedRunTitle</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">@Session.CurrentShell.Runtime.Summary</p>
            <Cluster Gap="LayoutGap.XSmall" Class="mt-4 flex-wrap">
                @if (Session.CurrentShell.Runtime.SelectedRun is { } selectedRun) {
                    <StatusBadge Tone="@ResolveRunStatusTone(selectedRun.Status)" Text="@selectedRun.Status.ToString()" />
                    <StatusBadge Tone="neutral" Text="@($"first {selectedRun.FirstEventAtUtc.LocalDateTime:g}")" />
                    <StatusBadge Tone="info" Text="@($"latest {selectedRun.LastEventAtUtc.LocalDateTime:g}")" />
                }
                <StatusBadge Tone="neutral" Text="@($"{Session.CurrentShell.Runtime.Events.Count} event(s)")" />
            </Cluster>
        </SurfaceCard>
        @RenderRuntimeEventLedger("processes-run-execution-events")
    </Grid>;


    private RenderFragment RenderRuntimeCoordinationSection() => @<Grid Gap="LayoutGap.Medium"
                                                                        ColumnTemplateXl="minmax(0,0.9fr) minmax(0,1.1fr)"
                                                                        data-testid="processes-run-coordination">
        <SurfaceCard Soft="true">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Assignments and messaging" />
            <h3 class="text-base font-semibold text-slate-900">@($"{Session.CurrentShell.Runtime.ManagerMessages.Count} manager message(s)")</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">Manager messages are filtered to the selected run and history window.</p>
            <Button Text="Open manager chat"
                    Icon="forum"
                    ButtonStyle="ButtonStyle.Light"
                    Size="ButtonSize.Small"
                    Class="mt-4"
                    Click="Session.OpenManagerChatTabAsync"
                    data-testid="processes-run-open-manager-chat" />
        </SurfaceCard>
        @RenderManagerMessageLedger("processes-run-manager-messages")
    </Grid>;


    private RenderFragment RenderRuntimeEvidenceSection() => @<Grid Gap="LayoutGap.Medium"
                                                                    ColumnTemplateXl="minmax(0,0.8fr) minmax(0,1.2fr)"
                                                                    data-testid="processes-run-evidence">
        <SurfaceCard Soft="true">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Evidence" />
            <h3 class="text-base font-semibold text-slate-900">@($"{Session.CurrentShell.Runtime.Events.Count} event(s) on page")</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">Runtime evidence is shown as event history, incidents, diagnostic references, and manager decisions until artifact-map projections contain concrete artifact rows.</p>
        </SurfaceCard>
        @RenderRuntimeEventLedger("processes-run-evidence-events")
    </Grid>;


    private RenderFragment RenderRunList(string testId) => @<Stack GapScale="LayoutGap.Small"
                                                                    data-testid="@testId">
        @if (Session.CurrentShell.Runtime.Runs.Count == 0) {
            <EmptyState Eyebrow="Runtime runs"
                        Title="No runs in the selected window"
                        Description="Launch a process or widen the history window." />
        } else {
            @foreach (var run in Session.CurrentShell.Runtime.Runs) {
                <article class="processes-runtime-run-card @(run.RunId.Value == (Session.SelectedRuntimeRunId ?? Session.CurrentShell.Runtime.SelectedRunId) ? "processes-runtime-run-card--selected" : string.Empty)"
                         data-testid="processes-runtime-run-card">
                    <button type="button"
                            class="processes-runtime-run-card__body"
                            @onclick="@(() => Session.SelectRuntimeRunAsync(run.RunId.Value))">
                        <span class="processes-runtime-run-card__header">
                            <span class="processes-runtime-run-card__title">@BuildRunTitle(run)</span>
                            <StatusBadge Tone="@ResolveRunStatusTone(run.Status)" Text="@run.Status.ToString()" />
                        </span>
                        <span class="processes-runtime-run-card__summary">@BuildRunCardSummary(run)</span>
                        <span class="processes-runtime-run-card__badges">
                            <StatusBadge Tone="neutral" Text="@($"{run.RecentEvents.Count} recent")" />
                            <StatusBadge Tone="warning" Text="@($"{run.Incidents.Count} incident(s)")" />
                            @if (run.WaitingOnChildRuns.Count > 0) {
                                <StatusBadge Tone="info" Text="@FormatCount(run.WaitingOnChildRuns.Count, "child wait", "child waits")" />
                            }
                            <StatusBadge Tone="info" Text="@run.LastEventAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)" />
                        </span>
                    </button>
                    <Button Icon="open_in_new"
                            ButtonStyle="ButtonStyle.Light"
                            Size="ButtonSize.Small"
                            Class="cda-button--quick processes-runtime-run-card__open"
                            title="Open run details"
                            aria-label="Open run details"
                            Click="@(() => Session.OpenRunDetailDialogAsync(run))"
                            data-testid="processes-runtime-run-open-details" />
                </article>
            }
        }
    </Stack>;


    private RenderFragment RenderRuntimeEventLedger(string testId) => @<SurfaceCard Soft="true"
                                                                                    data-testid="@testId">
        <Split Gap="LayoutGap.Small">
            <Stack GapScale="LayoutGap.Tiny">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Runtime timeline" />
                <h3 class="text-base font-semibold text-slate-900">@($"{Session.CurrentShell.Runtime.Events.Count} event(s)")</h3>
            </Stack>
            <StatusBadge Tone="neutral" Text="@ResolveHistoryWindowText(Session.CurrentShell.Runtime.HistoryWindow)" />
        </Split>
        @if (Session.CurrentShell.Runtime.Events.Count == 0) {
            <p class="mt-3 text-sm leading-6 text-slate-500">No runtime events match this filter.</p>
        } else {
            <Stack GapScale="LayoutGap.Small" Class="mt-4">
                @foreach (var runtimeEvent in Session.CurrentShell.Runtime.Events) {
                    <button type="button"
                            class="processes-runtime-event-row"
                            @onclick="@(() => Session.OpenEventDetailDialogAsync(runtimeEvent))"
                            data-testid="processes-runtime-event-row">
                        <span>
                            <span class="processes-runtime-event-row__title">@runtimeEvent.EventType</span>
                            <span class="processes-runtime-event-row__summary">@runtimeEvent.Summary</span>
                        </span>
                        <span class="processes-runtime-event-row__meta">
                            <StatusBadge Tone="@ResolveEventTone(runtimeEvent)" Text="@runtimeEvent.Sensitivity.ToString()" />
                            <span>@runtimeEvent.OccurredAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)</span>
                        </span>
                    </button>
                }
            </Stack>
        }
    </SurfaceCard>;


    private RenderFragment RenderIncidentLedger(string testId) => @<SurfaceCard Soft="true"
                                                                                data-testid="@testId">
        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Incidents" />
        @if (Session.CurrentShell.Runtime.Incidents.Count == 0) {
            <p class="mt-3 text-sm leading-6 text-slate-500">No manager incidents are open in this projection window.</p>
        } else {
            <Stack GapScale="LayoutGap.Small" Class="mt-4">
                @foreach (var incident in Session.CurrentShell.Runtime.Incidents) {
                    <div class="processes-runtime-ledger-row" data-testid="processes-runtime-incident-row">
                        <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                            <StatusBadge Tone="warning" Text="@incident.Severity" />
                            <StatusBadge Tone="neutral" Text="@incident.Status" />
                            <span class="text-xs text-slate-500">@incident.RaisedAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)</span>
                        </Cluster>
                        <p class="mt-2 text-sm font-semibold text-slate-900">@incident.Classification</p>
                        <p class="mt-1 text-sm leading-6 text-slate-600">@incident.SafeSummary</p>
                        <p class="mt-1 text-xs text-slate-500">@incident.DiagnosticReference</p>
                    </div>
                }
            </Stack>
        }
    </SurfaceCard>;


    private RenderFragment RenderManagerMessageLedger(string testId) => @<SurfaceCard Soft="true"
                                                                                      data-testid="@testId">
        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Manager messages" />
        @if (Session.CurrentShell.Runtime.ManagerMessages.Count == 0) {
            <p class="mt-3 text-sm leading-6 text-slate-500">No manager messages match the selected run and history window.</p>
        } else {
            <Stack GapScale="LayoutGap.Small" Class="mt-4">
                @foreach (var message in Session.CurrentShell.Runtime.ManagerMessages) {
                    <div class="processes-runtime-ledger-row" data-testid="processes-runtime-manager-message-row">

@namespace CanDoItAll.Processes.UI
@if (State.NumericInputError is { } numericError) {
    <Alert AlertStyle="AlertStyle.Warning" data-testid="processes-role-numeric-error">@numericError</Alert>
}

@if (State.HasConflict) {
    <Alert AlertStyle="AlertStyle.Warning" data-testid="processes-role-draft-conflict">A newer saved version is available. Your local edits and original version are retained.</Alert>
}
@if (State.IsDirty) {
    <Button Text="Discard edits" Disabled="@Disabled" Click="State.Discard" data-testid="processes-role-discard" />
}
@using CanDoItAll.Processes.Projections

<div class="mt-6 border-t border-slate-200 pt-5" data-testid="processes-definition-role-editor">
    <Split Gap="LayoutGap.Small">
        <Stack GapScale="LayoutGap.Tiny">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Roles" />
            <h3 class="text-sm font-semibold text-slate-900">Role responsibilities</h3>
        </Stack>
        <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
            <StatusBadge Tone="info" Text="@($"{State.RoleEditor.Roles.Count} role(s)")" />
            <StatusBadge Tone="@ProcessRoleEditorState.ResolveLintTone(State.RoleEditor.Lint)" Text="@ProcessRoleEditorState.ResolveLintText(State.RoleEditor.Lint)" />
            @foreach (var command in State.RoleEditor.Commands.Where(command => command.Kind == ProcessDefinitionRoleCommandKind.AddRole && !State.RoleDetailDialogOpen)) {
                <Button Text="@command.Text"
                        Icon="@command.Icon"
                        ButtonStyle="@ProcessRoleEditorState.ResolveCommandButtonStyle(command.Kind)"
                        Size="ButtonSize.Small"
                        Disabled="@(!command.IsEnabled || State.Disabled)"
                        IsBusy="@State.Disabled"
                        Click="@(() => State.ExecuteAsync(command.Kind))"
                        title="@command.DisabledReason"
                        data-testid="@ProcessRoleEditorState.BuildRoleCommandTestId(command.Kind)" />
            }
        </Cluster>
    </Split>

    @if (!string.IsNullOrWhiteSpace(State.CommandNotice) || State.RoleEditor.LastCommandReceipt is not null) {
        <p class="mt-3 text-xs font-semibold text-slate-500" data-testid="processes-role-editor-receipt">
            @(State.RoleEditor.LastCommandReceipt is null ? State.CommandNotice : $"{State.RoleEditor.LastCommandReceipt.Status}: {State.RoleEditor.LastCommandReceipt.Summary}")
        </p>
    }

    <div class="process-role-card-grid mt-5" data-testid="processes-role-card-grid">
        @if (State.RoleEditor.Roles.Count == 0) {
            <EmptyState Eyebrow="No roles"
                        Title="No roles are defined"
                        Description="Add a role from a template before editing step bindings." />
        } else {
            @foreach (var role in State.RoleEditor.Roles) {
                <article class="process-role-card"
                         data-testid="processes-role-card">
                    <div class="process-role-card__identity">
                        <span class="process-role-card__icon" aria-hidden="true">
                            <Icon Name="badge" />
                        </span>
                        <h4 class="process-role-card__title">@role.DisplayName</h4>
                        <p class="process-role-card__summary">@role.Summary</p>
                    </div>
                    <Cluster Gap="LayoutGap.XSmall" Class="process-role-card__badges">
                        <StatusBadge Tone="neutral" Text="@role.Draft.PreferredExecutorKind.ToString()" />
                        <StatusBadge Tone="info" Text="@($"{role.StepBindingCount} binding(s)")" />
                        @if (role.Draft.IsRequired) {
                            <StatusBadge Tone="success" Text="Required" />
                        }
                    </Cluster>
                    <Button Text="Details"
                            Icon="open_in_new"
                            Size="ButtonSize.Small"
                            ButtonStyle="ButtonStyle.Light"
                            Class="process-role-card__details"
                            Click="@(() => State.OpenRoleDetailsAsync(role.RoleKey))"
                            data-testid="@ProcessRoleEditorState.BuildRoleItemTestId(role.RoleKey)" />
                </article>
            }
        }
    </div>

    @if (State.RoleEditor.Lint.HasWarningsOrErrors) {
        <div class="mt-5 rounded-md border border-slate-200 bg-slate-50 p-3" data-testid="processes-role-lint-panel">
            @foreach (var issue in State.RoleEditor.Lint.Issues) {
                <div class="border-t border-slate-200 py-3 first:border-t-0 first:pt-0 last:pb-0">
                    <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                        <StatusBadge Tone="@ProcessRoleEditorState.ResolveLintIssueTone(issue.Severity)" Text="@issue.Severity.ToString()" />
                        <span class="text-xs font-semibold text-slate-500">@issue.Section.ToString()</span>
                        <span class="text-xs text-slate-500">@issue.Code</span>
                    </Cluster>
                    <p class="mt-2 text-sm leading-6 text-slate-700">@issue.Message</p>
                    <p class="text-xs leading-5 text-slate-500">@issue.Suggestion</p>
                </div>
            }
        </div>
    }

</div>

@if (State.RoleDetailDialogOpen && State.ActiveDialogRole is { } activeRole) {
    <Dialog IsOpen="true"
            Eyebrow="Role details"
            Title="@activeRole.DisplayName"
            Subtitle="@activeRole.Summary"
            Size="ModalSize.Wide"
            DenseChrome="true"
            TestId="processes-role-details-dialog"
            OnClose="State.CloseRoleDetailsAsync">
        <ChildContent>
            <Stack GapScale="LayoutGap.Medium" data-testid="processes-role-editor-form">
                <div class="process-role-dialog-hero">
                    <span class="process-role-dialog-hero__icon" aria-hidden="true">
                        <Icon Name="badge" />
                    </span>
                    <h3>@activeRole.DisplayName</h3>
                    <Cluster Gap="LayoutGap.XSmall" Class="justify-center flex-wrap">
                        <StatusBadge Tone="neutral" Text="@activeRole.Draft.PreferredExecutorKind.ToString()" />
                        <StatusBadge Tone="info" Text="@($"{activeRole.StepBindingCount} binding(s)")" />
                        <StatusBadge Tone="@ProcessRoleEditorState.ResolveOverrideTone(State.RoleOverrideStatus)" Text="@State.RoleOverrideStatus.ToString()" />
                    </Cluster>
                </div>

                <Grid Gap="LayoutGap.Medium" ColumnTemplateLg="minmax(0,1fr) minmax(0,1fr)">
                    <Stack GapScale="LayoutGap.Small" Class="process-role-dialog-section">
                        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Identity and staffing" />
                        <label class="text-xs font-semibold text-slate-500" for="processes-role-display-name-input">Display name</label>
                        <input id="processes-role-display-name-input"
                               class="cda-input"
                               value="@State.RoleDisplayName"
                               @oninput="args => State.RoleDisplayName = ProcessRoleEditorState.ReadChangeValue(args)"
                               data-testid="processes-role-display-name" />

                        <label class="text-xs font-semibold text-slate-500" for="processes-role-purpose-input">Purpose</label>
                        <textarea id="processes-role-purpose-input"
                                  class="cda-input cda-input--textarea process-role-dialog-textarea"
                                  value="@State.RolePurpose"
                                  @oninput="args => State.RolePurpose = ProcessRoleEditorState.ReadChangeValue(args)"
                                  data-testid="processes-role-purpose"></textarea>

                        <label class="text-xs font-semibold text-slate-500" for="processes-role-staffing-input">Staffing intent</label>
                        <textarea id="processes-role-staffing-input"
                                  class="cda-input cda-input--textarea process-role-dialog-textarea"
                                  value="@State.RoleStaffingIntent"
                                  @oninput="args => State.RoleStaffingIntent = ProcessRoleEditorState.ReadChangeValue(args)"
                                  data-testid="processes-role-staffing-intent"></textarea>

                        <Grid Gap="LayoutGap.Small" ColumnsMd="2">
                            <Stack GapScale="LayoutGap.Tiny">
                                <label class="text-xs font-semibold text-slate-500" for="processes-role-executor-kind-input">Executor kind</label>
                                <select id="processes-role-executor-kind-input"
                                        class="cda-input"
                                        value="@State.RoleExecutorKind"
                                        @onchange="State.UpdateRoleExecutorKind"
                                        data-testid="processes-role-executor-kind">
                                    @foreach (var option in ProcessRoleEditorState.ExecutorKindOptions) {
                                        <option value="@option">@option.ToString()</option>
                                    }
                                </select>
                            </Stack>
                            <Stack GapScale="LayoutGap.Tiny">
                                <label class="text-xs font-semibold text-slate-500" for="processes-role-project-assignment-input">Project role</label>
                                <select id="processes-role-project-assignment-input"
                                        class="cda-input"
                                        value="@State.RoleProjectAssignment"
                                        @onchange="args => State.RoleProjectAssignment = ProcessRoleEditorState.ParseProjectAssignment(args)"
                                        data-testid="processes-role-project-assignment">
                                    @foreach (var option in ProcessRoleEditorState.ProjectAssignmentOptions) {
                                        <option value="@option">@option.ToString()</option>
                                    }
                                </select>
                            </Stack>
                        </Grid>

                        @if (State.RoleExecutorKind == ProcessDefinitionRoleExecutorKind.Workflow) {
                            <Stack GapScale="LayoutGap.Small" data-testid="processes-role-workflow-binding">
                                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Workflow binding" />
                                <TextBlock TextStyle="TextStyle.Body2"
                                           Value="Choose one workflow definition. Leave the version empty to use that workflow's latest active version, or enter an exact saved version." />
                                <Grid Gap="LayoutGap.Small" ColumnTemplateLg="minmax(0,1fr) minmax(0,1fr)">
                                    <FormField Text="Workflow definition id">
                                        <TextBox Value="@State.RoleWorkflowDefinitionIdInput"
                                                 ValueChanged="State.UpdateWorkflowDefinitionId"
                                                 aria-invalid="@(State.RoleWorkflowDefinitionIdError is not null)"
                                                 data-testid="processes-role-workflow-id" />
                                        @if (State.RoleWorkflowDefinitionIdError is not null) {
                                            <TextBlock TextStyle="TextStyle.Note"
                                                       Value="@State.RoleWorkflowDefinitionIdError"
                                                       Class="font-semibold text-red-700"
                                                       role="alert"
                                                       data-testid="processes-role-workflow-id-error" />
                                        }
                                    </FormField>
                                    <FormField Text="Exact version id (optional)">
                                        <TextBox Value="@State.RoleWorkflowVersionIdInput"
                                                 ValueChanged="State.UpdateWorkflowVersionId"
                                                 aria-invalid="@(State.RoleWorkflowVersionIdError is not null)"
                                                 data-testid="processes-role-workflow-version-id" />
                                        @if (State.RoleWorkflowVersionIdError is not null) {
                                            <TextBlock TextStyle="TextStyle.Note"
                                                       Value="@State.RoleWorkflowVersionIdError"
                                                       Class="font-semibold text-red-700"
                                                       role="alert"
                                                       data-testid="processes-role-workflow-version-id-error" />
                                        }
                                    </FormField>
                                </Grid>
                            </Stack>
                        }

                        <label class="text-xs font-semibold text-slate-500" for="processes-role-allocation-input">Default allocation percent</label>
                        <input id="processes-role-allocation-input"
                               type="number"
                               min="0"
                               max="100"
                               class="cda-input"
                               value="@State.RoleDefaultAllocationPercentInput"
                               @oninput="args => State.RoleDefaultAllocationPercentInput = ProcessRoleEditorState.ReadChangeValue(args)"
                               data-testid="processes-role-allocation" />

                        <Cluster Gap="LayoutGap.Medium" Class="flex-wrap">
                            <label class="inline-flex items-center gap-2 text-sm text-slate-700">
                                <input type="checkbox"
                                       checked="@State.RoleIsRequired"
                                       @onchange="args => State.RoleIsRequired = ProcessRoleEditorState.ParseBool(args)"
                                       data-testid="processes-role-required" />
                                Required
                            </label>
                            <label class="inline-flex items-center gap-2 text-sm text-slate-700">
                                <input type="checkbox"
                                       checked="@State.RoleAllowsFallback"
                                       @onchange="args => State.RoleAllowsFallback = ProcessRoleEditorState.ParseBool(args)"
                                       data-testid="processes-role-fallback" />
                                Fallback
                            </label>
                            <label class="inline-flex items-center gap-2 text-sm text-slate-700">
                                <input type="checkbox"
                                       checked="@State.RoleRequiresApproval"
                                       @onchange="args => State.RoleRequiresApproval = ProcessRoleEditorState.ParseBool(args)"
                                       data-testid="processes-role-approval" />
                                Approval
                            </label>
                        </Cluster>
                    </Stack>

                    <Stack GapScale="LayoutGap.Small" Class="process-role-dialog-section" data-testid="processes-role-template-and-bindings">
                        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Template and bindings" />
                        <label class="text-xs font-semibold text-slate-500" for="processes-role-template-action-input">Apply template</label>
                        <select id="processes-role-template-action-input"
                                class="cda-input"
                                value="@State.SelectedTemplateActionKey"
                                @onchange="args => State.SelectedTemplateActionKey = ProcessRoleEditorState.ReadChangeValue(args)"
                                data-testid="processes-role-template-action">
                            @foreach (var template in State.RoleEditor.TemplateActions) {
                                <option value="@template.ActionKey.Value">@template.Label</option>
                            }
                        </select>

                        <label class="text-xs font-semibold text-slate-500" for="processes-role-template-source-input">Template source</label>
                        <input id="processes-role-template-source-input"
                               class="cda-input"
                               value="@State.RoleTemplateSourceKey"
                               @oninput="args => State.RoleTemplateSourceKey = ProcessRoleEditorState.ReadChangeValue(args)"
                               data-testid="processes-role-template-source" />

                        <label class="text-xs font-semibold text-slate-500" for="processes-role-template-snapshot-input">Template snapshot</label>
                        <input id="processes-role-template-snapshot-input"
                               class="cda-input"
                               value="@State.RoleTemplateSnapshotName"
                               @oninput="args => State.RoleTemplateSnapshotName = ProcessRoleEditorState.ReadChangeValue(args)"
                               data-testid="processes-role-template-snapshot" />

                        <label class="text-xs font-semibold text-slate-500" for="processes-role-snapshot-summary-input">Snapshot summary</label>
                        <textarea id="processes-role-snapshot-summary-input"
                                  class="cda-input cda-input--textarea process-role-dialog-textarea"
                                  value="@State.RoleSnapshotSummary"
                                  @oninput="args => State.RoleSnapshotSummary = ProcessRoleEditorState.ReadChangeValue(args)"
                                  data-testid="processes-role-snapshot-summary"></textarea>

                        <div class="process-role-bindings" data-testid="processes-role-step-bindings">
                            <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                                <StatusBadge Tone="neutral" Text="@($"{State.RoleEditor.StepRoleBindings.Count(binding => binding.RoleKey == State.SelectedRoleKey)} step binding(s)")" />
                                <StatusBadge Tone="@ProcessRoleEditorState.ResolveOverrideTone(State.RoleOverrideStatus)" Text="@State.RoleOverrideStatus.ToString()" />
                            </Cluster>
                            @foreach (var binding in State.RoleEditor.StepRoleBindings.Where(binding => binding.RoleKey == State.SelectedRoleKey).Take(4)) {
                                <div class="process-role-bindings__row">
                                    <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                                        <StatusBadge Tone="neutral" Text="@binding.ResponsibilityKind.ToString()" />
                                        <span class="text-xs font-semibold text-slate-500">@binding.StepTitle</span>
                                        <span class="text-xs text-slate-500">fallback @binding.FallbackOrder</span>
                                    </Cluster>
                                    <p class="mt-2 text-xs leading-5 text-slate-500">@binding.RebindPolicySummary</p>
                                </div>
                            }
                        </div>
                    </Stack>
                </Grid>
            </Stack>
        </ChildContent>
        <Footer>
            <Cluster Gap="LayoutGap.Small" Class="flex-wrap justify-end">
                @foreach (var command in State.RoleEditor.Commands) {
                    <Button Text="@command.Text"
                            Icon="@command.Icon"
                            ButtonStyle="@ProcessRoleEditorState.ResolveCommandButtonStyle(command.Kind)"
                            Size="ButtonSize.Small"
                            Disabled="@State.IsCommandDisabled(command)"
                            IsBusy="@State.Disabled"
                            Click="@(() => State.ExecuteAsync(command.Kind))"
                            title="@State.ResolveCommandDisabledReason(command)"
                            data-testid="@ProcessRoleEditorState.BuildRoleCommandTestId(command.Kind)" />
                }
                <Button Text="Close"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Click="State.CloseRoleDetailsAsync" />
            </Cluster>
        </Footer>
    </Dialog>
}


@code {
    [Parameter, EditorRequired] public ProcessDefinitionRoleEditorProjection RoleEditor { get; set; } = default!;
    [Parameter, EditorRequired] public ProcessWorkspaceShellScope Scope { get; set; } = default!;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<ProcessDefinitionRoleEditorCommand> ExecuteCommand { get; set; }
    [Parameter] public ProcessRoleEditorState State { get; set; } = new();

    protected override void OnParametersSet() {
        State.RoleEditor = RoleEditor;
        State.Scope = Scope;
        State.Disabled = Disabled;
        State.ExecuteCommand = ExecuteCommand;
        State.Observe();
    }
}

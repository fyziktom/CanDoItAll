@namespace CanDoItAll.Workbench.Insights.UI
@using System.Globalization
@implements IDisposable

@{
    var view = Session;
    var query = view.Query;
    var page = view.Page;
    var isLoading = view.IsLoading;
    var loadError = view.Error;
    var canMovePrevious = view.CanMovePrevious;
    var canMoveNext = view.CanMoveNext;
    var pageDescription = page is null ? "No accepted page" : page.TotalCount == 0 ? "No results"
        : $"Page {page.PageIndex + 1:N0} · showing {page.Items.Count:N0} of {page.TotalCount:N0}";
}
<Dialog IsOpen="true"
        Eyebrow="Manager Summary"
        Title="Project activity"
        Subtitle="Filtered totals cover every matching run. Page payloads load only while this dialog is open."
        Size="ModalSize.Wide"
        DenseChrome="true"
        TestId="manager-summary-activity-dialog"
        OnClose="Closed">
    <ChildContent>
        <Stack GapScale="LayoutGap.Large">
            <Grid Gap="LayoutGap.Medium"
                  ColumnTemplateMd="repeat(2,minmax(0,1fr))"
                  ColumnTemplateXl="repeat(4,minmax(0,1fr))"
                  AlignItems="AlignItems.End">
                <Stack GapScale="LayoutGap.Tiny">
                    <TextBlock TextStyle="TextStyle.Caption" Value="Activity type" />
                    <InputSelect TValue="ProjectManagerActivityKind"
                                 Value="@query.Kind"
                                 ValueExpression="@(() => query.Kind)"
                                 ValueChanged="@(value => view.SetKindAsync(query, value))"
                                 class="cda-input"
                                 disabled="@isLoading"
                                 data-testid="manager-activity-kind">
                        <option value="@ProjectManagerActivityKind.Conversation">Agents</option>
                        <option value="@ProjectManagerActivityKind.SimpleChat">Simple chats</option>
                        <option value="@ProjectManagerActivityKind.Workflow">Workflows</option>
                        <option value="@ProjectManagerActivityKind.Process">Processes</option>
                    </InputSelect>
                </Stack>
                <Stack GapScale="LayoutGap.Tiny">
                    <TextBlock TextStyle="TextStyle.Caption" Value="Outcome" />
                    <InputSelect TValue="ProjectManagerActivityStatusFilter"
                                 Value="@query.Status"
                                 ValueExpression="@(() => query.Status)"
                                 ValueChanged="@(value => view.SetStatusAsync(query, value))"
                                 class="cda-input"
                                 disabled="@isLoading"
                                 data-testid="manager-activity-status">
                        <option value="@ProjectManagerActivityStatusFilter.All">All outcomes</option>
                        <option value="@ProjectManagerActivityStatusFilter.Active">Active</option>
                        <option value="@ProjectManagerActivityStatusFilter.Succeeded">Succeeded</option>
                        <option value="@ProjectManagerActivityStatusFilter.Failed">Failed</option>
                        <option value="@ProjectManagerActivityStatusFilter.Cancelled">Cancelled</option>
                    </InputSelect>
                </Stack>
                <MetricCard Label="Matching runs"
                            Value="@(page is null ? "—" : FormatCount(page.TotalCount))" />
                <MetricCard Label="Total length"
                            Value="@(page is null ? "—" : FormatDuration(page.TotalDurationMilliseconds))" />
            </Grid>

            <Grid Gap="LayoutGap.Medium"
                  ColumnTemplateMd="repeat(3,minmax(0,1fr))">
                <MetricCard Label="Known cost"
                            Value="@(page is null ? "—" : FormatUsd(page.Totals.HistoricalKnownUsd))" />
                <MetricCard Label="Recorded estimate"
                            Value="@(page is null ? "—" : FormatUsd(page.Totals.HistoricalEstimatedUsd))" />
                <MetricCard Label="Unknown-cost runs"
                            Value="@(page is null ? "—" : FormatCount(page.Totals.UnknownHistoricalCostCount))" />
            </Grid>

            @if (page is not null && (isLoading || loadError is not null)) {
                <StatusBadge Tone="warning" Text="Last accepted page totals shown" />
            }

            @if (isLoading)
            {
                <Stack data-testid="manager-activity-loading">
                    <LoadingState Eyebrow="Project activity"
                                  Title="Loading filtered activity"
                                  Description="Reading the selected reporting projection and filtered totals." />
                </Stack>
            }
            else if (!string.IsNullOrWhiteSpace(loadError))
            {
                <Alert AlertStyle="AlertStyle.Danger"
                       Variant="Variant.Outlined"
                       data-testid="manager-activity-error">
                    <Cluster JustifyContent="JustifyContent.SpaceBetween"
                             AlignItems="AlignItems.Center"
                             Gap="LayoutGap.Medium">
                        <TextBlock Value="@loadError" />
                        <Button Text="Retry"
                                Icon="refresh"
                                Variant="Variant.Outlined"
                                Click="@(() => view.LoadAsync())" />
                    </Cluster>
                </Alert>
            }
            else if (page is null || page.Items.Count == 0)
            {
                <EmptyState Eyebrow="Project activity"
                            Title="No matching runs"
                            Description="Try a different activity type, outcome, or Manager Summary time window." />
            }
            else
            {
                <SurfaceCard Soft="true">
                    <DataGrid TItem="ProjectManagerActivity"
                              Data="@(page.Items)"
                              AllowPaging="false"
                              data-testid="manager-activity-list">
                        <Columns>
                            <DataGridColumn TItem="ProjectManagerActivity" Title="Activity">
                                <Template Context="activity">
                                    <Stack GapScale="LayoutGap.Tiny"
                                           Class="project-manager-activity__identity">
                                        <TextBlock TextStyle="TextStyle.Subtitle2"
                                                   Value="@activity.Title" />
                                        <span class="project-manager-activity__summary"
                                              title="@activity.Summary">@activity.Summary</span>
                                    </Stack>
                                </Template>
                            </DataGridColumn>
                            <DataGridColumn TItem="ProjectManagerActivity" Title="Type">
                                <Template Context="activity">
                                    <StatusBadge Tone="neutral"
                                                 Text="@FormatActivityKind(activity.Kind)"
                                                 NoWrap="true" />
                                </Template>
                            </DataGridColumn>
                            <DataGridColumn TItem="ProjectManagerActivity" Title="Activity time">
                                <Template Context="activity">
                                    <span class="project-manager-activity__nowrap">
                                        @activity.ActivityAtUtc.LocalDateTime.ToString("g")
                                    </span>
                                </Template>
                            </DataGridColumn>
                            <DataGridColumn TItem="ProjectManagerActivity" Title="Length">
                                <Template Context="activity">
                                    <span class="project-manager-activity__nowrap">
                                        @FormatDuration(activity.DurationMilliseconds)
                                    </span>
                                </Template>
                            </DataGridColumn>
                            <DataGridColumn TItem="ProjectManagerActivity" Title="Cost">
                                <Template Context="activity">
                                    <span class="project-manager-activity__nowrap"
                                          title="@FormatActivityCostDetail(activity)">
                                        @FormatActivityCost(activity)
                                    </span>
                                </Template>
                            </DataGridColumn>
                            <DataGridColumn TItem="ProjectManagerActivity" Title="Status">
                                <Template Context="activity">
                                    <StatusBadge Tone="@ResolveActivityTone(activity.Status)"
                                                 Text="@FormatActivityStatus(activity.Status)"
                                                 NoWrap="true" />
                                </Template>
                            </DataGridColumn>
                        </Columns>
                    </DataGrid>
                </SurfaceCard>
            }

            <Cluster JustifyContent="JustifyContent.SpaceBetween"
                     AlignItems="AlignItems.Center"
                     Gap="LayoutGap.Medium"
                     Wrap="FlexWrap.Wrap">
                <TextBlock TextStyle="TextStyle.Caption"
                           Value="@pageDescription" />
                <Cluster Gap="LayoutGap.Small">
                    <Button Text="Previous"
                            Icon="chevron_left"
                            Variant="Variant.Outlined"
                            Disabled="@(!canMovePrevious || isLoading)"
                            Click="@(() => view.PreviousAsync(query))"
                            data-testid="manager-activity-previous" />
                    <Button Text="Next"
                            Icon="chevron_right"
                            Variant="Variant.Outlined"
                            Disabled="@(!canMoveNext || isLoading)"
                            Click="@(() => view.NextAsync(query))"
                            data-testid="manager-activity-next" />
                </Cluster>
            </Cluster>
        </Stack>
    </ChildContent>
</Dialog>

@code {
    [Parameter, EditorRequired] public ManagerActivitySession Session { get; set; } = default!;
    [Parameter] public EventCallback Closed { get; set; }
    private ManagerActivitySession? subscribed;
    private bool disposed;
    protected override void OnParametersSet() {
        if (ReferenceEquals(Session, subscribed)) {
            return;
        }
        if (subscribed is not null) {
            subscribed.Changed -= Refresh;
        }
        subscribed = Session;
        subscribed.Changed += Refresh;
    }

    private void Refresh() => _ = InvokeAsync(() => {
        if (!disposed) {
            StateHasChanged();
        }
    });

    public void Dispose() {
        disposed = true;
        if (subscribed is not null) {
            subscribed.Changed -= Refresh;
        }
    }

    private static string FormatCount(int value)
        => value.ToString("N0", CultureInfo.CurrentCulture);

    private static string FormatUsd(decimal value)
        => value.ToString("C4", CultureInfo.GetCultureInfo("en-US"));

    private static string FormatDuration(long milliseconds)
    {
        if (milliseconds <= 0)
        {
            return "0m";
        }

        var duration = TimeSpan.FromMilliseconds(milliseconds);
        if (duration.TotalDays >= 1)
        {
            return $"{(int)duration.TotalDays:N0}d {duration.Hours:N0}h";
        }

        if (duration.TotalHours >= 1)
        {
            return $"{(int)duration.TotalHours:N0}h {duration.Minutes:N0}m";
        }

        return $"{Math.Max(1, (int)duration.TotalMinutes):N0}m";
    }

    private static string FormatActivityCost(ProjectManagerActivity activity)
    {
        if (activity.KnownCostUsd > 0)
        {
            return FormatUsd(activity.KnownCostUsd);
        }

        if (activity.EstimatedCostUsd > 0)
        {
            return $"Est. {FormatUsd(activity.EstimatedCostUsd)}";
        }

        return activity.HasUnknownCost
            ? "Unknown"
            : FormatUsd(0m);
    }

    private static string FormatActivityCostDetail(ProjectManagerActivity activity)
        => activity.HasUnknownCost
            ? $"{FormatActivityCost(activity)} · pricing incomplete"
            : activity.EstimatedCostUsd > 0
                ? $"{FormatActivityCost(activity)} · recorded estimate {FormatUsd(activity.EstimatedCostUsd)}"
                : FormatActivityCost(activity);

    private static string FormatActivityKind(ProjectManagerActivityKind kind)
        => kind switch
        {
            ProjectManagerActivityKind.Conversation => "Agent",
            ProjectManagerActivityKind.SimpleChat => "Simple chat",
            ProjectManagerActivityKind.Workflow => "Workflow",
            ProjectManagerActivityKind.Process => "Process",
            _ => throw new ArgumentOutOfRangeException(nameof(kind), kind, "Unsupported manager activity kind.")
        };

    private static string FormatActivityStatus(ProjectManagerActivityStatus status)
        => status switch
        {
            ProjectManagerActivityStatus.Active => "Active",
            ProjectManagerActivityStatus.Waiting => "Waiting",
            ProjectManagerActivityStatus.Succeeded => "Succeeded",
            ProjectManagerActivityStatus.Failed => "Failed",
            ProjectManagerActivityStatus.Cancelled => "Cancelled",
            ProjectManagerActivityStatus.Blocked => "Blocked",
            ProjectManagerActivityStatus.Escalated => "Escalated",
            ProjectManagerActivityStatus.Unknown => "Unknown",
            _ => throw new ArgumentOutOfRangeException(nameof(status), status, "Unsupported manager activity status.")
        };

    private static string ResolveActivityTone(ProjectManagerActivityStatus status)
        => status switch
        {
            ProjectManagerActivityStatus.Succeeded => "success",
            ProjectManagerActivityStatus.Failed => "danger",
            ProjectManagerActivityStatus.Cancelled => "neutral",
            ProjectManagerActivityStatus.Blocked => "warning",
            ProjectManagerActivityStatus.Escalated => "warning",
            ProjectManagerActivityStatus.Waiting => "warning",
            ProjectManagerActivityStatus.Active => "info",
            ProjectManagerActivityStatus.Unknown => "neutral",
            _ => throw new ArgumentOutOfRangeException(nameof(status), status, "Unsupported manager activity status.")
        };
}

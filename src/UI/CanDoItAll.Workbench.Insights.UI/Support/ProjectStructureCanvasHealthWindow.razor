@namespace CanDoItAll.Modules.Workbench.Pages
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.CanvasLib
@using CanDoItAll.Modules.Workbench.CanvasAdapters

<div class="workbench-insights-health">
@{
    var origin = Origin;
    var summary = SummaryState;
    var canValidate = CanValidateSelected;
    var targets = SelectedNodeIds.ToArray();
    var windowReceiver = StateChanged;
    var actionReceiver = ValidateSelected;
}
<CanvasFloatingWindow WindowId="@WindowId"
                      TestId="@TestId"
                      AriaLabel="@AriaLabel"
                      Kicker="Canvas health"
                      Title="Canvas health"
                      Summary="Validation pressure stays in the canvas now, but the toolbar safe zone remains clear."
                      DefaultPlacement="top-left"
                      DefaultWidth="320"
                      DefaultHeight="326"
                      MinWidth="280"
                      MinHeight="220"
                      State="@State"
                      StateChanged="@(state => windowReceiver.InvokeAsync(new InsightsWindowIntent(origin, InsightsWindow.Health, state)))">
    <Stack GapScale="LayoutGap.Medium"
           Class="project-structure-validation-overlay"
           aria-label="Project structure validation overlay"
           data-testid="project-structure-validation-overlay">
        <Stack GapScale="LayoutGap.Tiny"
               Class="project-structure-validation-overlay__header">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Project validation overlay" />
            <TextBlock TextStyle="TextStyle.H5" Value="Canvas health" Class="cw-panel-title" />
            <TextBlock TextStyle="TextStyle.Note"
                       Value="Surface dependency and review issues directly in the structure canvas without blocking the toolbar."
                       Class="cw-panel-copy" />
        </Stack>

        <CompactStatStrip Class="project-structure-validation-overlay__metrics">
            <CompactStat Label="blocked" Value="@summary.BlockedCount.ToString()" TooltipText="Blocked project structure issues." Tone="danger" />
            <CompactStat Label="review" Value="@summary.ReviewCount.ToString()" TooltipText="Project structure issues needing review." Tone="warning" />
            <CompactStat Label="priority" Value="@summary.PriorityCount.ToString()" TooltipText="Priority project structure issues." Tone="info" />
            <CompactStat Label="selected issues" Value="@summary.SelectedIssueCount.ToString()" TooltipText="Issues linked to the current selection." />
        </CompactStatStrip>

        @if (summary.SpotlightNodes.Count > 0)
        {
            <PanelCard Class="project-structure-validation-overlay__spotlight">
                <Stack GapScale="LayoutGap.Tiny">
                    <TextBlock TextStyle="TextStyle.Eyebrow" Value="Spotlight" />
                    <Stack GapScale="LayoutGap.Tiny">
                        @foreach (var nodeTitle in summary.SpotlightNodes)
                        {
                            <TextBlock TextStyle="TextStyle.Note" Value="@nodeTitle" />
                        }
                    </Stack>
                </Stack>
            </PanelCard>
        }

        @if (canValidate)
        {
            <Cluster Class="project-structure-validation-overlay__actions">
                <Button Text="Validate selected"
                        ButtonStyle="ButtonStyle.Info"
                        Click="@(() => actionReceiver.InvokeAsync(new InsightsValidateIntent(origin, targets)))" />
            </Cluster>
        }
    </Stack>
</CanvasFloatingWindow>

</div>

@code {
    [Parameter, EditorRequired] public InsightsOrigin Origin { get; set; }
    [Parameter] public IReadOnlyList<string> SelectedNodeIds { get; set; } = [];

    [Parameter, EditorRequired]
    public string WindowId { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string TestId { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string AriaLabel { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public CanvasWorkbenchWindowState State { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback<InsightsWindowIntent> StateChanged { get; set; }

    [Parameter, EditorRequired]
    public ProjectStructureValidationOverlaySummary SummaryState { get; set; } = default!;

    [Parameter]
    public bool CanValidateSelected { get; set; }

    [Parameter]
    public EventCallback<InsightsValidateIntent> ValidateSelected { get; set; }
}

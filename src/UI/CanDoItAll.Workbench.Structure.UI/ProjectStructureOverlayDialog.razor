@namespace CanDoItAll.Modules.Workbench.Pages
@using CanDoItAll.Components.CanvasLib

<CanvasOverlayDialog AriaLabel="@AriaLabel" Kicker="@Kicker" Title="@Title" Summary="@Summary"
                     CanvasScoped="CanvasScoped" FullScreen="FullScreen" CanMaximize="CanMaximize" DialogClass="@DialogClass"
                     BodyClass="@BodyClass" FillBody="FillBody" DataTestId="@DataTestId" Actions="Actions" Body="Body" Close="Close"
                     SizeToggleTestId="project-structure-dialog-size-toggle" />

@code {
    [Parameter, EditorRequired]
    public string AriaLabel { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Kicker { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Summary { get; set; } = string.Empty;

    [Parameter]
    public bool CanvasScoped { get; set; }

    [Parameter]
    public bool FullScreen { get; set; }

    [Parameter]
    public bool CanMaximize { get; set; }

    [Parameter]
    public string DialogClass { get; set; } = string.Empty;

    [Parameter]
    public string BodyClass { get; set; } = string.Empty;

    [Parameter]
    public bool FillBody { get; set; }

    [Parameter]
    public string DataTestId { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public RenderFragment? Body { get; set; }

    [Parameter]
    public EventCallback Close { get; set; }

}

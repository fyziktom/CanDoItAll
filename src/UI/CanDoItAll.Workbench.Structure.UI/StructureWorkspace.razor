@namespace CanDoItAll.Workbench.Structure.UI
@{
    var shell = Presentation;
}
<div class="project-structure-page @(SelectedView == 1 ? "project-structure-page--planning" : null)" data-testid="structure-workspace" data-context-id="@shell.ContextId">
    @if (shell.UnavailableTitle is not null) {
        <PageScaffold>
            <Header><PageHeader Eyebrow="Workbench" Title="Project structure unavailable" Description="The requested project is not available in the active database profile." /></Header>
            <ChildContent><EmptyState Eyebrow="Switched profile" Title="@shell.UnavailableTitle" Description="@shell.UnavailableDescription">
                <Actions><Button Text="Open projects" Click="@(() => Dispatch.InvokeAsync(new StructureToolbarIntent(shell.ContextId, StructureToolbarCommand.Projects)))" /></Actions>
            </EmptyState></ChildContent>
        </PageScaffold>
    } else if (shell.Error is not null) {
        <EmptyState Eyebrow="Structure" Title="Unable to load project structure" Description="@shell.Error">
            <Actions><Button Text="Retry" data-testid="structure-load-retry" Click="@(() => Dispatch.InvokeAsync(new StructureToolbarIntent(shell.ContextId, StructureToolbarCommand.Retry)))" /></Actions>
        </EmptyState>
    } else if (shell.Canvas is not { } canvasSurface) {
        <CanvasWorkbenchStage Eyebrow="" Title="" Description=""><Canvas><SkeletonStateOverlay Snapshot="@shell.Loading" /></Canvas></CanvasWorkbenchStage>
    } else {
        <Stack Gap="1.5rem" Class="project-structure-page__stack">
            <Tabs @key="shell.ContextId" SelectedIndex="SelectedView" SelectedIndexChanged="@(value => Dispatch.InvokeAsync(new StructureViewIntent(shell.ContextId, value)))"
                  FillHeight="@(SelectedView == 1)" PanelOverflowMode="@(SelectedView == 1 ? TabsPanelOverflowMode.Hidden : TabsPanelOverflowMode.Visible)"
                  AriaLabel="Project structure views" Density="TabsDensity.Compact" RenderMode="TabRenderMode.Client">
                <TabsItem Text="Canvas" Icon="account_tree">
        @{
            var view = shell;
        }
        <CanvasWorkbenchStage Eyebrow=""
                              Title=""
                              Description="">
            <Canvas>
                <CanvasWorkbench @key="view.ContextId" Surface="canvasSurface"
                                 @ref="canvas"
                                 RequiresComposerAcknowledgement="true"
                                 SelectionChanged="@(value => Dispatch.InvokeAsync(new StructureSelectionIntent(view.ContextId, value)))"
                                 NodesMoved="@(value => Dispatch.InvokeAsync(new StructureNodesMovedIntent(view.ContextId, value)))"
                                 ContextActionRequested="@(value => Dispatch.InvokeAsync(new StructureContextIntent(view.ContextId, value)))"
                                 CreateActionInvoked="@(value => Dispatch.InvokeAsync(new StructureCreateIntent(view.ContextId, value)))"
                                 ComposerOpened="@(value => Dispatch.InvokeAsync(new StructureComposerOpenedIntent(view.ContextId, value)))"
                                 ComposerClosed="@(value => Dispatch.InvokeAsync(new StructureComposerClosedIntent(view.ContextId, value)))"
                                 ComposerComparisonRequested="@(value => Dispatch.InvokeAsync(new StructureComposerComparisonIntent(view.ContextId, value)))"
                                 ConfirmComposerClose="ConfirmComposerClose"
                                 NodeEdited="@(value => Dispatch.InvokeAsync(new StructureNoteEditIntent(view.ContextId, value)))"
                                 NodeOpened="@(value => Dispatch.InvokeAsync(new StructureOpenIntent(view.ContextId, value)))"
                                 StateChanged="@(value => Dispatch.InvokeAsync(new StructureStateIntent(view.ContextId, value)))"
                                 ClipboardRequested="@(value => Dispatch.InvokeAsync(new StructureClipboardIntent(view.ContextId, value)))">
                    <ToolbarLeftContent>
                        <ProjectStructureToolbarActions SelectionWindowVisible="@view.Toolbar.SelectionVisible"
                                                       HealthWindowVisible="@view.Toolbar.HealthVisible"
                                                       ToolboxWindowVisible="@view.Toolbox.State.IsVisible"
                                                       ObjectIndexWindowVisible="@view.Toolbar.ObjectIndexVisible"
                                                       FileBrowserWindowVisible="@view.Toolbar.FilesVisible"
                                                       SignalsWindowVisible="@view.Toolbar.SignalsVisible"
                                                       AgentWindowVisible="@view.Toolbar.AgentsVisible"
                                                       GanttViewVisible="@(SelectedView == 1)"
                                                       ActiveTool="@view.Toolbar.Mode"
                                                       CanUseDependencyTool="@view.Toolbar.CanConnect"
                                                       CanRecomposeSelectedBranch="@view.Toolbar.CanRecompose"
                                                       IsSubtreeRecompositionInProgress="@view.Toolbar.IsRecomposing"
                                                       SelectToolClicked="@(() => Dispatch.InvokeAsync(new StructureToolbarIntent(view.ContextId, StructureToolbarCommand.Select)))"
                                                       DependencyToolClicked="@(() => Dispatch.InvokeAsync(new StructureToolbarIntent(view.ContextId, StructureToolbarCommand.Dependency)))"
                                                       DeleteToolClicked="@(() => Dispatch.InvokeAsync(new StructureToolbarIntent(view.ContextId, StructureToolbarCommand.Delete)))"
                                                       ToggleSelectionWindow="@(() => Dispatch.InvokeAsync(new StructureToolbarIntent(view.ContextId, StructureToolbarCommand.Inspector)))"
                                                       ToggleHealthWindow="@(() => Dispatch.InvokeAsync(new StructureToolbarIntent(view.ContextId, StructureToolbarCommand.Health)))"
                                                       ToggleToolboxWindow="@(() => Dispatch.InvokeAsync(new StructureToolbarIntent(view.ContextId, StructureToolbarCommand.Toolbox)))"
                                                       ToggleObjectIndexWindow="@(() => Dispatch.InvokeAsync(new StructureToolbarIntent(view.ContextId, StructureToolbarCommand.ObjectIndex)))"
                                                       OpenFileBrowserWindow="@(() => Dispatch.InvokeAsync(new StructureToolbarIntent(view.ContextId, StructureToolbarCommand.Files)))"
                                                       ToggleSignalsWindow="@(() => Dispatch.InvokeAsync(new StructureToolbarIntent(view.ContextId, StructureToolbarCommand.Signals)))"
                                                       ToggleAgentWindow="@(() => Dispatch.InvokeAsync(new StructureToolbarIntent(view.ContextId, StructureToolbarCommand.Agents)))"
                                                       OpenGanttView="@(() => Dispatch.InvokeAsync(new StructureToolbarIntent(view.ContextId, StructureToolbarCommand.Gantt)))"
                                                       RecomposeBranch="@(() => Dispatch.InvokeAsync(new StructureToolbarIntent(view.ContextId, StructureToolbarCommand.Recompose)))" />
                        <div class="project-structure-toolbar-stats"
                             data-testid="project-structure-canvas-loaded">
                            <StatusBadge Tone="info" Text="@($"Nodes {canvasSurface.Nodes.Count}")" />
                            <StatusBadge Tone="neutral" Text="@($"Selection {view.SelectionCount}")" />
                        </div>
                        @ToolbarSupplement
                    </ToolbarLeftContent>
                    <OverlayContent>
                        @if (!string.IsNullOrWhiteSpace(EditorMessage)) {
                            <PanelCard Class="project-structure-node-editor-status" role="status" aria-live="polite"
                                       data-testid="structure-node-compare-status">
                                <Stack GapScale="LayoutGap.Small">
                                    <TextBlock Value="@EditorMessage" TextStyle="TextStyle.Caption" />
                                    @EditorActions
                                </Stack>
                            </PanelCard>
                        }
                        @if (view.ShowFeedback &&
                            !string.IsNullOrWhiteSpace(view.Feedback))
                        {
                            <PanelCard Class="project-structure-inline-feedback project-structure-clipboard-feedback"
                                       role="status"
                                       aria-live="polite"
                                       data-testid="project-structure-clipboard-feedback"
                                       data-tone="@view.FeedbackTone">
                                <Stack GapScale="LayoutGap.Small">
                                    <TextBlock Value="@view.Feedback" />
                                    @if (view.HasPendingCleanup)
                                    {
                                        <Button Tone="ButtonTone.Default"
                                                Text="Retry cleanup"
                                                Disabled="@view.IsRetryingCleanup"
                                                data-testid="project-structure-deletion-retry"
                                                Click="@(() => Dispatch.InvokeAsync(new StructureToolbarIntent(view.ContextId, StructureToolbarCommand.RetryCleanup)))" />
                                    }
                                </Stack>
                            </PanelCard>
                        }
                        @if (view.Toolbox.State.IsVisible)
                        {
                            <ProjectStructureToolboxWindow WindowId="@view.Toolbox.WindowId"
                                                           TestId="project-structure-toolbox-window"
                                                           AriaLabel="Project structure standard blocks toolbox"
                                                           Kicker="Standard Blocks Toolbox"
                                                           Title=""
                                                           Summary=""
                                                           State="@view.Toolbox.State"
                                                           StateChanged="@(value => Dispatch.InvokeAsync(new StructureToolboxWindowIntent(view.ContextId, value)))"
                                                           Groups="@view.Toolbox.Groups"
                                                           SearchText="@view.Toolbox.Search"
                                                           SearchTextChanged="@(value => Dispatch.InvokeAsync(new StructureToolboxSearchIntent(view.ContextId, value ?? string.Empty)))"
                                                           SourceLabel="@view.Toolbox.SourceLabel"
                                                           DefaultWidth="@view.Toolbox.DefaultWidth"
                                                           OnToggleGroup="@(value => Dispatch.InvokeAsync(new StructureToolboxGroupIntent(view.ContextId, value)))"
                                                           OnOpenAction="@(value => Dispatch.InvokeAsync(new StructureToolboxActionIntent(view.ContextId, value)))" />
                        }
                        @SupportWindows
                        <StructureStructuralDialogs Presentation="Dialogs" Dispatch="DialogIntent" />
                        @DeferredDialogs

                    </OverlayContent>
                </CanvasWorkbench>
            </Canvas>
        </CanvasWorkbenchStage>
                </TabsItem>
                <TabsItem Text="Gantt" Icon="view_timeline">@if (planningVisited) { @Planning }</TabsItem>
                <TabsItem Text="Manager Summary" Icon="monitoring">@if (insightsVisited) { @Insights }</TabsItem>
            </Tabs>
        </Stack>
    }
</div>

@code {
    [Parameter, EditorRequired] public StructurePresentation Presentation { get; set; } = default!;
    [Parameter] public int SelectedView { get; set; }
    [Parameter] public EventCallback<StructureIntent> Dispatch { get; set; }
    [Parameter] public RenderFragment? Planning { get; set; }
    [Parameter] public RenderFragment? Insights { get; set; }
    [Parameter] public RenderFragment? SupportWindows { get; set; }
    [Parameter] public RenderFragment? ToolbarSupplement { get; set; }
    [Parameter] public string? EditorMessage { get; set; }
    [Parameter] public RenderFragment? EditorActions { get; set; }
    [Parameter] public StructureDialogsPresentation Dialogs { get; set; } = new();
    [Parameter] public EventCallback<StructureDialogIntent> DialogIntent { get; set; }
    [Parameter] public RenderFragment? DeferredDialogs { get; set; }
    [Parameter] public Func<CanvasWorkbenchComposerCloseRequest, Task<bool>>? ConfirmComposerClose { get; set; }

    private CanvasWorkbench? canvas;
    private Guid? mountedContext;
    private bool planningVisited;
    private bool insightsVisited;

    protected override void OnParametersSet() {
        if (mountedContext != Presentation.ContextId) {
            mountedContext = Presentation.ContextId;
            planningVisited = false;
            insightsVisited = false;
        }
        planningVisited |= SelectedView == 1;
        insightsVisited |= SelectedView == 2;
    }

    public Task OpenCreateDialogAsync(CanvasWorkbenchAction action, CanvasWorkbenchCreateActionRequest request)
        => (canvas ?? throw new InvalidOperationException("The Structure canvas is not mounted.")).OpenCreateDialogAsync(action, request);

    public Task AcknowledgeComposerAsync(Guid contextId, CanvasWorkbenchComposerResult result)
        => Presentation.ContextId == contextId && canvas is not null
            ? canvas.AcknowledgeComposerAsync(result) : Task.CompletedTask;

    public Task SelectNodesAsync(IReadOnlyList<string> nodeIds, string? primaryNodeId = null)
        => canvas?.SelectNodesAsync(nodeIds, primaryNodeId) ?? Task.CompletedTask;

    public Task<CanvasWorkbenchComposerDraft?> ReadComposerDraftAsync(Guid contextId)
        => Presentation.ContextId == contextId && canvas is not null
            ? canvas.ReadComposerDraftAsync() : Task.FromResult<CanvasWorkbenchComposerDraft?>(null);

    public Task<CanvasWorkbenchComposerCloseRequest?> ReadComposerCloseRequestAsync(Guid contextId)
        => Presentation.ContextId == contextId && canvas is not null
            ? canvas.ReadComposerCloseRequestAsync() : Task.FromResult<CanvasWorkbenchComposerCloseRequest?>(null);

    public Task<CanvasWorkbenchComposerApplyResult> ApplyComposerDraftAsync(Guid contextId, CanvasWorkbenchComposerApplyRequest request)
        => Presentation.ContextId == contextId && canvas is not null
            ? canvas.ApplyComposerDraftAsync(request) : Task.FromResult(new CanvasWorkbenchComposerApplyResult(CanvasWorkbenchComposerApplyStatus.Retired, 0));

    public Task<IReadOnlyList<string>> GetSelectedNodeIdsAsync()
        => canvas?.GetSelectedNodeIdsAsync() ?? Task.FromResult<IReadOnlyList<string>>([]);

    public Task<string?> CaptureImageAsync()
        => (canvas ?? throw new InvalidOperationException("The Structure canvas is not mounted.")).CaptureImageAsync();
}

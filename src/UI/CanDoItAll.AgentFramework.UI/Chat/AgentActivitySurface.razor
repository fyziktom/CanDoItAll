<Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap" role="status" aria-live="polite" aria-atomic="true"
         data-testid="agent-execution-activity-status" data-activity-operation-id="@State.OperationId.ToString()">
    <StatusBadge Tone="@State.Tone" Text="@State.Label" data-testid="agent-execution-activity-phase" />
    @if (State.HasSequenceGap) {
        <StatusBadge Tone="warning" Text="Earlier updates skipped" data-testid="agent-execution-activity-gap" />
    }
    <TextBlock TextStyle="TextStyle.Caption" Value="@State.Message" data-testid="agent-execution-activity-message" />
</Cluster>

@code {
    [Parameter, EditorRequired] public AgentActivityState State { get; set; } = default!;
}

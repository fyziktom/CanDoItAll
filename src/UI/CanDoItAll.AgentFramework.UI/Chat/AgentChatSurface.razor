@namespace CanDoItAll.AgentFramework.UI.Chat
@if (Navigation is null) {
    <ChatWorkspaceSurface Presentation="@Presentation" Intent="@Intent" HeaderActions="@HeaderActions"
                          ComposerActions="@ComposerActions" ActivityContent="@ActivityContent" AttachmentPicker="@AttachmentPicker" />
} else {


<div class="@(Navigation.Focused ? "agents-chat-panel-shell agents-chat-panel-shell--focused-floating" : "agents-chat-panel-shell")"
     data-testid="agents-chat-panel">
<Stack GapScale="LayoutGap.Large"
       AlignItems="AlignItems.Stretch"
       Class="flex-1 min-h-0 w-full">
    @if (Navigation.IsLoading) {
        <StatusBadge Tone="info" Text="Loading agent workspace" />
    }
    <Grid Gap="LayoutGap.Large"
          Class="agents-chat-grid flex-1 min-h-0 overflow-hidden"
          ColumnTemplateXl="@(Navigation.Focused ? "minmax(0,1fr)" : "minmax(18rem,0.58fr) minmax(0,1.8fr)")">
        @if (!Navigation.Focused) {
        <WorkspacePanel Class="agents-chat-left-rail h-full min-h-0 overflow-hidden">
            <div class="border-b border-slate-200 pb-4">
                <Stack GapScale="LayoutGap.Small" AlignItems="AlignItems.Stretch">
                    <div>
                        <Cluster Gap="LayoutGap.Small"
                                 Wrap="FlexWrap.NoWrap">
                            <TextBlock TextStyle="TextStyle.Subtitle2" Value="Agent threads" />
                            <HelpPopover RootClass="pf-help-popover inline-flex items-center"
                                         ToggleClass="pf-help-popover__toggle pf-help-popover__toggle--compact"
                                         OpenOnHover="true"
                                         AriaLabel="Show agent thread help"
                                         Title="Show agent thread help"
                                         Heading="Agent threads"
                                         Body="@AgentThreadsHelpText" />
                        </Cluster>
                        @if (Navigation.Agent is not null) {
                            <div class="agents-chat-agent-context mt-2"
                                 data-testid="agent-thread-selected-agent">
                                <Avatar Alt="@Navigation.Agent.Name"
                                        ImageUrl="@Navigation.Agent.AvatarImageUrl"
                                        FallbackText="@Navigation.Agent.Initials"
                                        DefaultImageSeed="@Navigation.Agent.Name"
                                        Size="AvatarSize.Small"
                                        Shape="AvatarShape.Rounded" />
                                <span class="min-w-0 truncate text-xs font-semibold text-slate-700">Selected agent: @Navigation.Agent.Name</span>
                            </div>
                        }
                    </div>
                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                        <Button Icon="cloud_sync"
                                Text="Switch Agent"
                                ButtonStyle="ButtonStyle.Light"
                                Size="ButtonSize.Small"
                                Disabled="@(Navigation.IsBusy || !Navigation.HasAgents)"
                                Click="(() => NavigateAsync(AgentChatNavigationAction.SwitchAgent))"
                                data-testid="agent-switch-button" />
                        <Button Text="Refresh"
                                ButtonStyle="ButtonStyle.Light"
                                Size="ButtonSize.Small"
                                Disabled="@Navigation.IsBusy"
                                Click="(() => NavigateAsync(AgentChatNavigationAction.Refresh))" />
                        <Button Text="New thread"
                                Size="ButtonSize.Small"
                                Disabled="@(Navigation.IsBusy || Navigation.Agent?.Id is null)"
                                Click="(() => NavigateAsync(AgentChatNavigationAction.NewThread))" />
                    </Cluster>
                </Stack>
            </div>

            <div class="agents-chat-left-scroll mt-4 min-h-0 flex-1 overflow-y-auto pr-1"
                 style="scrollbar-gutter:stable;">
                @if (!Navigation.HasAgents && !Navigation.IsLoading) {
                    <EmptyState Eyebrow="No agents"
                                Title="Create a technical agent first"
                                Description="Chat is only available after a technical agent exists and is bound to a provider." />
                } else {
                    <ConversationThreadRail @key="Navigation.Agent?.Id"
                                            Threads="@Navigation.Threads"
                                            Text="@ThreadRailText"
                                            Selected="HandleThreadSelectedAsync" />
                }
            </div>
        </WorkspacePanel>
        }

        @if (!string.IsNullOrWhiteSpace(Navigation.ErrorMessage)) {
            <EmptyState Eyebrow="Agent unavailable"
                        Title="Unable to open chat"
                        Description="@Navigation.ErrorMessage" />
        } else {
        <ChatWorkspaceSurface Presentation="@Presentation" Intent="@Intent" HeaderActions="@HeaderActions"
                              ComposerActions="@ComposerActions" ActivityContent="@ActivityContent" AttachmentPicker="@AttachmentPicker" />
        }
    </Grid>
</Stack>
</div>

}

@code {
    private const string AgentThreadsHelpText = "Search and select threads for the active technical agent. Use Switch Agent when you need another agent's thread list.";
    private static readonly ConversationThreadRailText ThreadRailText = new(EmptyText: "The selected agent does not have a thread yet.");
    [Parameter, EditorRequired] public ChatWorkspacePresentation Presentation { get; set; } = new();
    [Parameter] public EventCallback<ChatWorkspaceIntent> Intent { get; set; }
    [Parameter] public AgentChatNavigationPresentation? Navigation { get; set; }
    [Parameter] public EventCallback<AgentChatNavigationIntent> NavigationIntent { get; set; }
    [Parameter] public RenderFragment? HeaderActions { get; set; }
    [Parameter] public RenderFragment? ComposerActions { get; set; }
    [Parameter] public RenderFragment? ActivityContent { get; set; }
    [Parameter] public RenderFragment? AttachmentPicker { get; set; }

    private Task NavigateAsync(AgentChatNavigationAction action, Guid? sessionId = null)
        => Navigation is null ? Task.CompletedTask : NavigationIntent.InvokeAsync(new(Navigation.Generation, action, sessionId));
    private Task HandleThreadSelectedAsync(ConversationPresentationKey key)
        => Guid.TryParse(key.Value, out var id) ? NavigateAsync(AgentChatNavigationAction.SelectThread, id) : Task.CompletedTask;
}

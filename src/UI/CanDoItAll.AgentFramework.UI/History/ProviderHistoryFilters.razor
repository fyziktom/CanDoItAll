@using CanDoItAll.AgentFramework.ProviderHistory
<FormStack>
    <FormRow Split="true">
        <FormField Text="Time range">
            <SelectInput TValue="ProviderHistoryRange"
                      @bind-Value="Draft.Range" @bind-Value:after="OnChangedAsync" aria-label="Time range" data-testid="history-range">
    @foreach (var option in Ranges) {
        <option value="@option.Value">@option.Text</option>
    }
</SelectInput>
        </FormField>
        <FormField Text="Exact model identity">
            <TextInput @bind-Value="Draft.Model" @bind-Value:after="OnChangedAsync" Placeholder="All models"
                     aria-label="Exact model identity" data-testid="history-model" />
        </FormField>
    </FormRow>
    @if (Draft.Range == ProviderHistoryRange.Custom) {
        <FormRow Split="true">
            <FormField Text="From (UTC, inclusive)">
                <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="Draft.FromUtc" @bind-Value:after="OnChangedAsync"
                           class="form-input ui-input ui-input--outlined" aria-label="From UTC" data-testid="history-from" />
            </FormField>
            <FormField Text="To (UTC, exclusive)">
                <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="Draft.ToUtc" @bind-Value:after="OnChangedAsync"
                           class="form-input ui-input ui-input--outlined" aria-label="To UTC" data-testid="history-to" />
            </FormField>
        </FormRow>
    }
    <FormRow Split="true">
        <FormField Text="Outcome">
            <SelectInput TValue="HistoryOutcome?"
                      @bind-Value="Draft.Outcome" @bind-Value:after="OnChangedAsync" aria-label="Outcome" data-testid="history-outcome">
    <option value="">All outcomes</option>
    @foreach (var option in Outcomes) {
        <option value="@option">@option</option>
    }
</SelectInput>
        </FormField>
        <FormField Text="Managed credential ID">
            <TextInput @bind-Value="Draft.CredentialId" @bind-Value:after="OnChangedAsync" Placeholder="All credentials (ID, never the API key)"
                     aria-label="Managed credential ID" data-testid="history-credential" />
        </FormField>
    </FormRow>
    @if (AllowProvider) {
        <FormField Text="Provider ID">
            <TextInput @bind-Value="Draft.ProviderId" @bind-Value:after="OnChangedAsync" Placeholder="All authorized providers"
                     aria-label="Provider ID" data-testid="history-provider" />
        </FormField>
    }
    <Button Text="@(advanced ? "Fewer filters" : "More filters")" Tone="ButtonTone.Default"
            Click="@(() => advanced = !advanced)" aria-expanded="@advanced" data-testid="history-more-filters" />
    <FormStack hidden="@(!advanced)" Style="@(advanced ? null : "display:none")" data-testid="history-advanced-filters">
        <FormRow Split="true">
            <FormField Text="Workload">
                <SelectInput TValue="HistoryWorkload?"
                          @bind-Value="Draft.Workload" @bind-Value:after="OnChangedAsync" aria-label="Workload">
    <option value="">All workloads</option>
    @foreach (var option in Workloads) {
        <option value="@option">@option</option>
    }
</SelectInput>
            </FormField>
            <FormField Text="Operation">
                <SelectInput TValue="HistoryOperation?"
                          @bind-Value="Draft.Operation" @bind-Value:after="OnChangedAsync" aria-label="Operation">
    <option value="">All operations</option>
    @foreach (var option in Operations) {
        <option value="@option">@option</option>
    }
</SelectInput>
            </FormField>
        </FormRow>
        <FormRow Split="true">
            <FormField Text="Price evidence">
                <SelectInput TValue="HistoryPriceState?"
                          @bind-Value="Draft.PriceState" @bind-Value:after="OnChangedAsync" aria-label="Price evidence">
    <option value="">All price states</option>
    @foreach (var option in Prices) {
        <option value="@option">@option</option>
    }
</SelectInput>
            </FormField>
            <FormField Text="Rows per page (1–200)">
                <NumberInput @bind-Value="Draft.PageSize" @bind-Value:after="OnChangedAsync"
                             aria-label="Rows per page" data-testid="history-page-size" />
            </FormField>
        </FormRow>
        <FormRow Split="true">
            <FormField Text="Subject">
                <TextInput @bind-Value="Draft.Subject" @bind-Value:after="OnChangedAsync" aria-label="Subject" />
            </FormField>
            <FormField Text="Issuer">
                <TextInput @bind-Value="Draft.Issuer" @bind-Value:after="OnChangedAsync" aria-label="Issuer" />
            </FormField>
        </FormRow>
        <FormRow Split="true">
            <FormField Text="Request ID">
                <TextInput @bind-Value="Draft.RequestId" @bind-Value:after="OnChangedAsync" aria-label="Request ID" />
            </FormField>
            <FormField Text="Attempt ID">
                <TextInput @bind-Value="Draft.AttemptId" @bind-Value:after="OnChangedAsync" aria-label="Attempt ID" />
            </FormField>
        </FormRow>
        <FormRow Split="true">
            <FormField Text="External reference type">
                <TextInput @bind-Value="Draft.ExternalReferenceType" @bind-Value:after="OnChangedAsync"
                         Placeholder="For example project or erp.company-project"
                         aria-label="External reference type" data-testid="history-external-reference-type" />
            </FormField>
            <FormField Text="External reference value">
                <TextInput @bind-Value="Draft.ExternalReferenceValue" @bind-Value:after="OnChangedAsync"
                         Placeholder="Exact third-party identifier"
                         aria-label="External reference value" data-testid="history-external-reference-value" />
            </FormField>
        </FormRow>
        <FormField Text="Correlation ID">
            <TextInput @bind-Value="Draft.CorrelationId" @bind-Value:after="OnChangedAsync" aria-label="Correlation ID" />
        </FormField>
    </FormStack>
</FormStack>

@code {
    [Parameter, EditorRequired] public ProviderHistoryFilterDraft Draft { get; set; } = default!;
    [Parameter] public bool AllowProvider { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    private bool advanced;
    private sealed record RangeOption(ProviderHistoryRange Value, string Text);
    private static readonly RangeOption[] Ranges = [
        new(ProviderHistoryRange.Last24Hours, "Last 24 hours"),
        new(ProviderHistoryRange.Last7Days, "Last 7 days"),
        new(ProviderHistoryRange.Custom, "Custom")
    ];
    private static readonly HistoryOutcome[] Outcomes = Enum.GetValues<HistoryOutcome>();
    private static readonly HistoryWorkload[] Workloads = Enum.GetValues<HistoryWorkload>();
    private static readonly HistoryOperation[] Operations = Enum.GetValues<HistoryOperation>();
    private static readonly HistoryPriceState[] Prices = Enum.GetValues<HistoryPriceState>();
    private Task OnChangedAsync() => Changed.InvokeAsync();
}

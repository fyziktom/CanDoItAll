@namespace CanDoItAll.AgentFramework.UI.Overview

<div class="agents-overview-scope">
<Stack GapScale="LayoutGap.Medium"
       Class="agents-overview-dashboard"
       data-testid="agents-overview-dashboard">
    @if (State.HeaderWarning is not null) {
        <Alert AlertStyle="AlertStyle.Warning" data-testid="agents-overview-header-partial">
            @State.HeaderWarning
            <Button Text="Retry header" Icon="refresh" Size="ButtonSize.Small" Disabled="@State.HeaderLoading" Click="RetryHeaderAsync" />
        </Alert>
    }
    @if (hasOverviewLoadError && hasOverviewLoaded) {
        <Alert AlertStyle="AlertStyle.Warning" data-testid="agents-overview-stale">
            Showing the previously accepted agent summary. @overviewLoadError
        </Alert>
    } else if (hasOverviewLoadError) {
        <SurfaceCard Soft="true" data-testid="agents-overview-load-error">
            <p class="cda-eyebrow">Overview unavailable</p>
            <h2 class="mt-1 text-base font-semibold text-slate-950">Agent runtime summary could not be loaded</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">@overviewLoadError</p>
        </SurfaceCard>
    }

    <SurfaceCard Soft="true" data-testid="agents-overview-usage-scope">
        <Cluster JustifyContent="JustifyContent.SpaceBetween"
                 AlignItems="AlignItems.Center"
                 Gap="LayoutGap.Medium"
                 Wrap="FlexWrap.Wrap">
            <Stack Gap="0.2rem">
                <p class="cda-eyebrow">Usage scope</p>
                <span class="text-sm text-slate-600">Catalog and live runtime counts stay workspace-wide. Usage, tokens, cost, rankings, charts, and dialogs use @UsageCaption.</span>
                <span class="text-xs text-slate-500">Last 3m means the previous three calendar months. Longer periods may take longer.</span>
            </Stack>
            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                <Cluster role="group" aria-label="Usage workload">
                <SecondaryTabs Items="UsageScopeTabs"
                               SelectedKey="@UsageScopeKey"
                               SelectedKeyChanged="HandleUsageScopeChangedAsync" />
                </Cluster>
                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap" role="group" aria-label="Usage period" data-testid="agents-overview-period">
                    @foreach (var period in Enum.GetValues<ProviderUsagePeriod>()) {
                        <Button Text="@period.Label()"
                                Size="ButtonSize.Small"
                                Variant="@(period == State.DesiredPeriod ? Variant.Filled : Variant.Outlined)"
                                aria-pressed="@(period == State.DesiredPeriod ? "true" : "false")"
                                data-testid="@($"agents-overview-period-{period.ToWireValue()}")"
                                Click="@(() => SelectPeriodAsync(period))" />
                    }
                </Cluster>
                <Button Icon="refresh"
                        Size="ButtonSize.Small"
                        ButtonStyle="ButtonStyle.Light"
                        Variant="Variant.Outlined"
                        title="Refresh agent summary"
                        aria-label="Retry or refresh agent summary"
                        Disabled="@State.OverviewLoading"
                        Click="RetryOverviewAsync"
                        data-testid="agents-overview-retry" />
                <Button Icon="sync"
                        Size="ButtonSize.Small"
                        ButtonStyle="ButtonStyle.Light"
                        Variant="Variant.Outlined"
                        title="Refresh selected workload and period"
                        aria-label="Retry or refresh selected workload and period"
                        Disabled="@isUsageLoading"
                        Click="RetryUsageAsync"
                        data-testid="agents-overview-usage-retry" />
            </Cluster>
        </Cluster>
    </SurfaceCard>

    @if (State.HasUsage && State.AcceptedQuery is { } accepted) {
        <p class="text-xs text-slate-500" data-testid="agents-overview-window">
            @UsageCaption · @accepted.Window.FromUtc.ToString("u") ≤ usage &lt; @accepted.Window.ToUtc.ToString("u") · Generated @State.GeneratedAtUtc?.ToString("u")
        </p>
    }

    @if (usageLoadError is not null) {
        <Alert AlertStyle="AlertStyle.Warning"
               data-testid="@(hasUsageLoaded ? "agents-overview-usage-stale" : "agents-overview-usage-error")">
            @(hasUsageLoaded ? "Showing previously accepted usage for this workload and period." : "Usage is unavailable for the selected workload and period.") @usageLoadError
        </Alert>
    }
    @if (HasUsagePartial) {
        <Alert AlertStyle="AlertStyle.Warning" data-testid="agents-overview-usage-partial">
            @UsageCaption: some usage evidence is unavailable or still indexing. Displayed totals are partial.
            @if (State.UsageSources.Contains(ProviderUsageSourceState.Indexing)) {
                <span>Agent usage needs the usage-index maintenance command before complete results are available.</span>
            }
        </Alert>
    }

    <div class="agents-overview-stat-strip w-full"
         data-testid="agents-overview-metrics">
        @foreach (var metric in OverviewMetricBadges)
        {
            <div class="@ResolveOverviewMetricBadgeClass(metric.Tone)"
                 title="@metric.TooltipText"
                 data-testid="@metric.TestId">
                <span class="agents-overview-stat-badge__icon" aria-hidden="true">
                    <Icon Name="@metric.Icon" />
                </span>
                <span class="agents-overview-stat-badge__body">
                    <span class="agents-overview-stat-badge__label">@metric.Label</span>
                    <strong class="agents-overview-stat-badge__value">@metric.Value</strong>
                </span>
            </div>
        }
    </div>

    <Grid Gap="LayoutGap.Large"
          Class="agents-overview-main-grid"
          ColumnTemplateLg="repeat(2,minmax(0,1fr))"
          ColumnTemplate2Xl="minmax(20rem,0.95fr) minmax(0,1.1fr) minmax(16rem,0.72fr) minmax(20rem,0.95fr)">
        <SurfaceCard Soft="true"
                     Class="agents-overview-main-card agents-overview-list-card"
                     data-testid="agents-overview-top-consumers">
            <Cluster JustifyContent="JustifyContent.SpaceBetween"
                     AlignItems="AlignItems.Start"
                     Gap="LayoutGap.Medium"
                     Wrap="FlexWrap.Wrap">
                <Stack Gap="0.25rem">
                    <p class="cda-eyebrow">Most used consumers</p>
                    <h2 class="text-base font-semibold text-slate-950">Top 5 @UsageScopeLabel by execution count</h2>
                </Stack>
                <StatusBadge Tone="info"
                             Text="@(hasUsageLoaded ? $"{TopUsageConsumers.Count} ranked" : isUsageLoading ? "Loading" : "Unavailable")" />
            </Cluster>

            <ProviderUsageConsumerList IsLoading="@(isUsageLoading && !hasUsageLoaded)"
                                       IsUnavailable="@(!hasUsageLoaded && !isUsageLoading)"
                                       Rows="@TopUsageConsumers"
                                       AvatarImageUrls="@OverviewConsumerAvatarImageUrls"
                                       TestId="agents-overview-top-consumers-list"
                                       EmptyDescription="@($"No consumer usage in {UsageCaption}.")" />
        </SurfaceCard>

        <Stack GapScale="LayoutGap.Medium"
               Class="agents-overview-main-card agents-overview-chart-shell"
               data-testid="agents-overview-provider-bar">
            <CdaChart Title="Usage per provider"
                      Description="@($"Provider usage observations for {UsageCaption}.")"
                      Series="@ProviderUsageBarSeries"
                      Options="@ProviderUsageBarChartOptions"
                      Height="310"
                      class="agents-overview-chart-card box-border h-full w-full min-w-0 max-w-full overflow-hidden"
                      EmptyText="@UsageChartEmptyText" />
        </Stack>

        <Stack GapScale="LayoutGap.Medium"
               Class="agents-overview-main-card agents-overview-chart-shell"
               data-testid="agents-overview-provider-distribution">
            <CdaChart Title="Provider distribution"
                      Description="@($"Share of provider usage observations for {UsageCaption}.")"
                      Series="@ProviderUsageDistributionSeries"
                      Options="@ProviderUsageDistributionChartOptions"
                      Height="310"
                      class="agents-overview-chart-card box-border h-full w-full min-w-0 max-w-full overflow-hidden"
                      EmptyText="@UsageChartEmptyText" />
        </Stack>

        <SurfaceCard Soft="true"
                     Class="agents-overview-main-card agents-overview-list-card"
                     data-testid="agents-overview-failing-consumers">
            <Cluster JustifyContent="JustifyContent.SpaceBetween"
                     AlignItems="AlignItems.Start"
                     Gap="LayoutGap.Medium"
                     Wrap="FlexWrap.Wrap">
                <Stack Gap="0.25rem">
                    <p class="cda-eyebrow">Most failing consumers</p>
                    <h2 class="text-base font-semibold text-slate-950">Top 5 @UsageScopeLabel by failed executions</h2>
                </Stack>
                <StatusBadge Tone="danger"
                             Text="@(hasUsageLoaded ? $"{TopFailingConsumers.Count} flagged" : isUsageLoading ? "Loading" : "Unavailable")" />
            </Cluster>

            <ProviderUsageConsumerList IsLoading="@(isUsageLoading && !hasUsageLoaded)"
                                       IsUnavailable="@(!hasUsageLoaded && !isUsageLoading)"
                                       Rows="@TopFailingConsumers"
                                       AvatarImageUrls="@OverviewConsumerAvatarImageUrls"
                                       ShowFailureRank="true"
                                       TestId="agents-overview-failing-consumers-list"
                                       EmptyDescription="No failed Agent or Simple Chat executions exist in the selected scope." />
        </SurfaceCard>
    </Grid>

    <Grid Gap="LayoutGap.Medium"
          Class="agents-overview-secondary-grid"
          ColumnTemplateLg="minmax(0,1fr) minmax(20rem,0.55fr)">
        <SurfaceCard Soft="true"
                     Class="agents-overview-secondary-card"
                     data-testid="agents-overview-team-shortcuts">
            <Cluster JustifyContent="JustifyContent.SpaceBetween"
                     AlignItems="AlignItems.Start"
                     Gap="LayoutGap.Medium"
                     Wrap="FlexWrap.Wrap">
                <Stack Gap="0.35rem">
                    <p class="cda-eyebrow">Teams</p>
                </Stack>
                <StatusBadge Tone="info"
                             Text="@(hasOverviewLoaded ? $"{State.Teams.Length} team(s)" : State.OverviewLoading ? "Loading" : "Unavailable")" />
            </Cluster>

            @if (!hasOverviewLoaded) {
                <EmptyState Eyebrow="@(State.OverviewLoading ? "Loading" : "Unavailable")"
                            Title="@(State.OverviewLoading ? "Teams are loading" : "Team shortcuts are unavailable")"
                            Description="Team shortcuts appear after the catalog snapshot is available." />
            }
            else if (State.Teams.Length == 0)
            {
                <EmptyState Eyebrow="No teams"
                            Title="No teams are defined"
                            Description="Create teams on the Agents tab to enable one-click filtered shortcuts." />
            }
            else
            {
                <Grid Gap="LayoutGap.Small"
                      ColumnsSm="2"
                      ColumnsLg="3"
                      ColumnsXl="6"
                      Class="mt-2"
                      data-testid="agents-overview-team-shortcuts-grid">
                    @foreach (var team in State.Teams.Take(6))
                    {
                        <button type="button"
                                class="agents-overview-team-shortcut"
                                title="@team.Name"
                                @onclick="@(() => OpenAgentsForTeamAsync(team.TeamId))"
                                data-testid="agents-overview-team-shortcut">
                            <Icon Name="@team.Icon" Class="text-2xl" />
                            <span class="agents-overview-team-shortcut__name">@team.Name</span>
                            <span class="agents-overview-team-shortcut__count">@($"{team.AgentCount} agent(s)")</span>
                        </button>
                    }
                </Grid>
            }
        </SurfaceCard>

        <SurfaceCard Soft="true"
                     Class="agents-overview-secondary-card"
                     data-testid="agents-overview-demand-details">
            <Stack GapScale="LayoutGap.Small">
                <Stack Gap="0.25rem">
                    <p class="cda-eyebrow">Load on demand</p>
                    <h2 class="text-base font-semibold text-slate-950">Deeper usage views stay out of default load</h2>
                </Stack>
                <Cluster Gap="LayoutGap.Small"
                         Wrap="FlexWrap.Wrap">
                    <Button Text="Consumers"
                            Icon="analytics"
                            Size="ButtonSize.Small"
                            ButtonStyle="ButtonStyle.Light"
                            Variant="Variant.Outlined"
                            title="Open Agent and Simple Chat consumer usage details"
                            Disabled="@(!State.CanOpen(AgentsOverviewDetail.Consumers))"
                            Click="@(() => OpenDetailAsync(AgentsOverviewDetail.Consumers))"
                            data-testid="agents-overview-open-agent-usage" />
                    <Button Text="Providers"
                            Icon="bar_chart"
                            Size="ButtonSize.Small"
                            ButtonStyle="ButtonStyle.Light"
                            Variant="Variant.Outlined"
                            title="Open provider usage details"
                            Disabled="@(!State.CanOpen(AgentsOverviewDetail.Providers))"
                            Click="@(() => OpenDetailAsync(AgentsOverviewDetail.Providers))"
                            data-testid="agents-overview-open-provider-usage" />
                    <Button Text="Models"
                            Icon="query_stats"
                            Size="ButtonSize.Small"
                            ButtonStyle="ButtonStyle.Light"
                            Variant="Variant.Outlined"
                            title="Open model usage details"
                            Disabled="@(!State.CanOpen(AgentsOverviewDetail.Models))"
                            Click="@(() => OpenDetailAsync(AgentsOverviewDetail.Models))"
                            data-testid="agents-overview-open-model-usage" />
                </Cluster>
            </Stack>
        </SurfaceCard>
    </Grid>
</Stack>
</div>

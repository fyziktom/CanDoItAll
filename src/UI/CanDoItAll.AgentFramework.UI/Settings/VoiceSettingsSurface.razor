@namespace CanDoItAll.AgentFramework.UI.Settings
@if (Presentation.ProvidersUnavailable) {
    <Alert AlertStyle="AlertStyle.Warning" data-testid="agents-voice-provider-warning">@Presentation.ProviderError</Alert>
}
@if (Presentation.Source is null) {
    <StatusBadge Tone="@Presentation.StatusTone" Text="@Presentation.StatusText" />
    @if (!Presentation.IsBusy) {
        <Button Text="Reload settings" Click="ReloadAsync" />
    }
} else {
    <fieldset disabled="@Presentation.IsBusy" class="min-w-0">
<Grid Gap="LayoutGap.Large"
      ColumnsLg="2"
      data-testid="agents-voice-settings">
    <SurfaceCard>
        <TextBlock TextStyle="TextStyle.Eyebrow" Value="General voice" />
        <h2 class="mt-1 text-lg font-semibold text-slate-950">Speech to text</h2>
        <Stack GapScale="LayoutGap.Medium" Class="mt-4">
            <label class="cda-inline-option">
                <InputCheckbox data-testid="agents-voice-stt-enabled" @bind-Value:get="draft.SpeechEnabled" @bind-Value:set="(bool value) => draft = draft with { SpeechEnabled = value }" />
                <span>Enable speech input</span>
            </label>
            <label class="cda-field">
                <span class="cda-field-label">Driver</span>
                <InputSelect @bind-Value:get="draft.SpeechDriver" @bind-Value:set="(AgentVoiceDriverKind value) => draft = draft with { SpeechDriver = value }" class="cda-input">
                    <option value="@AgentVoiceDriverKind.OpenAi">OpenAI</option>
                </InputSelect>
            </label>
            <label class="cda-field">
                <span class="cda-field-label">Provider</span>
                <InputSelect data-testid="agents-voice-stt-provider" @bind-Value:get="draft.SpeechProviderId" @bind-Value:set="(Guid? value) => draft = draft with { SpeechProviderId = value }" class="cda-input">
                    <option value="">Select provider</option>
                    @if (Presentation.ProvidersUnavailable && draft.SpeechProviderId is { } speechProvider) {
                        <option value="@speechProvider.ToString("D")">Existing provider (catalog unavailable)</option>
                    }
                    @foreach (var provider in Presentation.Providers) {
                        <option value="@provider.Id.ToString("D")">@provider.Name (@provider.DefaultModel)</option>
                    }
                </InputSelect>
            </label>
            <label class="cda-field">
                <span class="cda-field-label">Model</span>
                <InputText @bind-Value:get="draft.SpeechModel" @bind-Value:set="(string value) => draft = draft with { SpeechModel = value }" class="cda-input" data-testid="agents-voice-stt-model" />
            </label>
            <label class="cda-field">
                <span class="cda-field-label">Language</span>
                <InputText @bind-Value:get="draft.Language" @bind-Value:set="(string value) => draft = draft with { Language = value }" class="cda-input" data-testid="agents-voice-stt-language" />
            </label>
            <label class="cda-field">
                <span class="cda-field-label">Prompt</span>
                <InputTextArea @bind-Value:get="draft.Prompt" @bind-Value:set="(string value) => draft = draft with { Prompt = value }"
                               class="cda-input cda-input--textarea"
                               data-testid="agents-voice-stt-prompt" />
            </label>
        </Stack>
    </SurfaceCard>

    <SurfaceCard>
        <TextBlock TextStyle="TextStyle.Eyebrow" Value="General voice" />
        <h2 class="mt-1 text-lg font-semibold text-slate-950">Text to speech</h2>
        <Stack GapScale="LayoutGap.Medium" Class="mt-4">
            <label class="cda-inline-option">
                <InputCheckbox data-testid="agents-voice-tts-enabled" @bind-Value:get="draft.SynthesisEnabled" @bind-Value:set="(bool value) => draft = draft with { SynthesisEnabled = value }" />
                <span>Enable spoken responses</span>
            </label>
            <label class="cda-field">
                <span class="cda-field-label">Driver</span>
                <InputSelect @bind-Value:get="draft.SynthesisDriver" @bind-Value:set="(AgentVoiceDriverKind value) => draft = draft with { SynthesisDriver = value }" class="cda-input">
                    <option value="@AgentVoiceDriverKind.OpenAi">OpenAI</option>
                </InputSelect>
            </label>
            <label class="cda-field">
                <span class="cda-field-label">Provider</span>
                <InputSelect data-testid="agents-voice-tts-provider" @bind-Value:get="draft.SynthesisProviderId" @bind-Value:set="(Guid? value) => draft = draft with { SynthesisProviderId = value }" class="cda-input">
                    <option value="">Select provider</option>
                    @if (Presentation.ProvidersUnavailable && draft.SynthesisProviderId is { } synthesisProvider) {
                        <option value="@synthesisProvider.ToString("D")">Existing provider (catalog unavailable)</option>
                    }
                    @foreach (var provider in Presentation.Providers) {
                        <option value="@provider.Id.ToString("D")">@provider.Name (@provider.DefaultModel)</option>
                    }
                </InputSelect>
            </label>
            <Grid Gap="LayoutGap.Medium" ColumnsMd="2">
                <label class="cda-field">
                    <span class="cda-field-label">Model</span>
                    <InputText @bind-Value:get="draft.SynthesisModel" @bind-Value:set="(string value) => draft = draft with { SynthesisModel = value }" class="cda-input" data-testid="agents-voice-tts-model" />
                </label>
                <label class="cda-field">
                    <span class="cda-field-label">Voice</span>
                    <InputSelect @bind-Value:get="draft.VoiceId" @bind-Value:set="(string value) => draft = draft with { VoiceId = value }" class="cda-input" data-testid="agents-voice-default-voice">
                        @foreach (var voiceId in AgentVoiceDefaults.OpenAiVoiceIds) {
                            <option value="@voiceId">@voiceId</option>
                        }
                    </InputSelect>
                </label>
            </Grid>
            <label class="cda-field">
                <span class="cda-field-label">Output format</span>
                <InputSelect data-testid="agents-voice-format" @bind-Value:get="draft.ResponseFormat" @bind-Value:set="(string value) => draft = draft with { ResponseFormat = value }" class="cda-input">
                    @foreach (var format in AgentVoiceDefaults.ResponseFormats) {
                        <option value="@format">@format</option>
                    }
                </InputSelect>
            </label>
            <label class="cda-field">
                <span class="cda-field-label">Sample text</span>
                <InputTextArea @bind-Value:get="draft.SampleText" @bind-Value:set="(string value) => draft = draft with { SampleText = value }"
                               class="cda-input cda-input--textarea"
                               data-testid="agents-voice-sample-text" />
            </label>
            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                <Button Text="Save voice settings"
                        Icon="save"
                        Disabled="@Presentation.IsBusy"
                        IsBusy="@Presentation.IsBusy"
                        Click="SaveAsync"
                        data-testid="agents-voice-save" />
                <Button Text="Play sample"
                        Icon="volume_up"
                        ButtonStyle="ButtonStyle.Light"
                        Disabled="@Presentation.IsBusy"
                        IsBusy="@Presentation.IsPlaying"
                        Click="PlaySampleAsync"
                        data-testid="agents-voice-play-sample" />
                <StatusBadge Tone="@Presentation.StatusTone" Text="@Presentation.StatusText" />
            </Cluster>
            <TextBlock TextStyle="TextStyle.Caption" Value="@draft.DisclosureText" />
        </Stack>
    </SurfaceCard>
</Grid>
    </fieldset>
}

@code {
    [Parameter, EditorRequired] public VoiceSettingsPresentation Presentation { get; set; } = new();
    [Parameter] public EventCallback<VoiceSettingsIntent> Intent { get; set; }
    private VoiceSettingsValues draft = new();
    private VoiceSettingsValues? accepted;
    protected override void OnParametersSet() {
        if (!ReferenceEquals(accepted, Presentation.Source)) {
            accepted = Presentation.Source;
            draft = accepted ?? new();
        }
    }
    private Task SaveAsync() => Intent.InvokeAsync(new(Presentation.Generation, VoiceSettingsAction.Save, draft));
    private Task ReloadAsync() => Intent.InvokeAsync(new(Presentation.Generation, VoiceSettingsAction.Reload));
    private Task PlaySampleAsync() => Intent.InvokeAsync(new(Presentation.Generation, VoiceSettingsAction.PlaySample, draft));
}

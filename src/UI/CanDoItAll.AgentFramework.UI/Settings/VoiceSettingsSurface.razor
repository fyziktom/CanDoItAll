@namespace CanDoItAll.AgentFramework.UI.Settings
@if (Presentation.ProvidersUnavailable) {
    <Alert AlertStyle="AlertStyle.Warning" data-testid="agents-voice-provider-warning">@Presentation.ProviderError</Alert>
}
@if (Presentation.Editor.UpdatesAvailable || Presentation.Editor.NeedsReview || Presentation.Editor.OutcomeUnknown) {
    <Alert AlertStyle="AlertStyle.Warning" data-testid="agents-voice-settings-conflict">Saved settings may have changed. Compare current settings; your local draft is retained.</Alert>
}
@if (Presentation.Source is null) {
    <StatusBadge Tone="@Presentation.StatusTone" Text="@Presentation.StatusText" />
    @if (!Presentation.IsBusy) {
        <Button Text="Reload settings" Click="ReloadAsync" />
    }
} else {
    <fieldset disabled="@(Presentation.Status == VoiceSettingsStatus.AccessChanged)" class="min-w-0">
<Grid Gap="LayoutGap.Large"
      ColumnsLg="2"
      data-testid="agents-voice-settings">
    <SurfaceCard>
        <TextBlock TextStyle="TextStyle.Eyebrow" Value="General voice" />
        <h2 class="mt-1 text-lg font-semibold text-chrome-950">Speech to text</h2>
        <Stack GapScale="LayoutGap.Medium" Class="mt-4">
            <label class="ui-checkbox-option">
                <InputCheckbox class="form-checkbox ui-checkbox ui-checkbox--outlined" data-testid="agents-voice-stt-enabled" @bind-Value:get="draft.SpeechEnabled" @bind-Value:set="(bool value) => draft = draft with { SpeechEnabled = value }" />
                <span>Enable speech input</span>
            </label>
            <FormField Text="Driver">
                <SelectInput @bind-Value:get="draft.SpeechDriver" @bind-Value:set="(AgentVoiceDriverKind value) => draft = draft with { SpeechDriver = value }" class="form-input ui-input ui-input--outlined">
                    <option value="@AgentVoiceDriverKind.OpenAi">OpenAI</option>
                </SelectInput>
            </FormField>
            <FormField Text="Provider">
                <SelectInput data-testid="agents-voice-stt-provider" @bind-Value:get="draft.SpeechProviderId" @bind-Value:set="(Guid? value) => draft = draft with { SpeechProviderId = value }" class="form-input ui-input ui-input--outlined">
                    <option value="">Select provider</option>
                    @if (draft.SpeechProviderId is { } speechProvider && !Presentation.Providers.Any(provider => provider.Id == speechProvider)) {
                        <option value="@speechProvider.ToString("D")">Existing provider (unavailable in current catalog)</option>
                    }
                    @foreach (var provider in Presentation.Providers) {
                        <option value="@provider.Id.ToString("D")">@provider.Name (@provider.DefaultModel)</option>
                    }
                </SelectInput>
            </FormField>
            <FormField Text="Model">
                <TextInput @bind-Value:get="draft.SpeechModel" @bind-Value:set="(string value) => draft = draft with { SpeechModel = value }" class="form-input ui-input ui-input--outlined" data-testid="agents-voice-stt-model" />
            </FormField>
            <FormField Text="Language">
                <TextInput @bind-Value:get="draft.Language" @bind-Value:set="(string value) => draft = draft with { Language = value }" class="form-input ui-input ui-input--outlined" data-testid="agents-voice-stt-language" />
            </FormField>
            <FormField Text="Prompt" Class="w-full">
                <TextAreaInput Value="@draft.Prompt" ValueChanged="@(value => draft = draft with { Prompt = value ?? string.Empty })"
                          Rows="6" Class="w-full" data-testid="agents-voice-stt-prompt" />
            </FormField>
        </Stack>
    </SurfaceCard>

    <SurfaceCard>
        <TextBlock TextStyle="TextStyle.Eyebrow" Value="General voice" />
        <h2 class="mt-1 text-lg font-semibold text-chrome-950">Text to speech</h2>
        <Stack GapScale="LayoutGap.Medium" Class="mt-4">
            <label class="ui-checkbox-option">
                <InputCheckbox class="form-checkbox ui-checkbox ui-checkbox--outlined" data-testid="agents-voice-tts-enabled" @bind-Value:get="draft.SynthesisEnabled" @bind-Value:set="(bool value) => draft = draft with { SynthesisEnabled = value }" />
                <span>Enable spoken responses</span>
            </label>
            <FormField Text="Driver">
                <SelectInput @bind-Value:get="draft.SynthesisDriver" @bind-Value:set="(AgentVoiceDriverKind value) => draft = draft with { SynthesisDriver = value }" class="form-input ui-input ui-input--outlined">
                    <option value="@AgentVoiceDriverKind.OpenAi">OpenAI</option>
                </SelectInput>
            </FormField>
            <FormField Text="Provider">
                <SelectInput data-testid="agents-voice-tts-provider" @bind-Value:get="draft.SynthesisProviderId" @bind-Value:set="(Guid? value) => draft = draft with { SynthesisProviderId = value }" class="form-input ui-input ui-input--outlined">
                    <option value="">Select provider</option>
                    @if (draft.SynthesisProviderId is { } synthesisProvider && !Presentation.Providers.Any(provider => provider.Id == synthesisProvider)) {
                        <option value="@synthesisProvider.ToString("D")">Existing provider (unavailable in current catalog)</option>
                    }
                    @foreach (var provider in Presentation.Providers) {
                        <option value="@provider.Id.ToString("D")">@provider.Name (@provider.DefaultModel)</option>
                    }
                </SelectInput>
            </FormField>
            <Grid Gap="LayoutGap.Medium" ColumnsMd="2">
                <FormField Text="Model">
                    <TextInput @bind-Value:get="draft.SynthesisModel" @bind-Value:set="(string value) => draft = draft with { SynthesisModel = value }" class="form-input ui-input ui-input--outlined" data-testid="agents-voice-tts-model" />
                </FormField>
                <FormField Text="Voice">
                    <SelectInput @bind-Value:get="draft.VoiceId" @bind-Value:set="(string value) => draft = draft with { VoiceId = value }" class="form-input ui-input ui-input--outlined" data-testid="agents-voice-default-voice">
                        @foreach (var voiceId in AgentVoiceDefaults.OpenAiVoiceIds) {
                            <option value="@voiceId">@voiceId</option>
                        }
                    </SelectInput>
                </FormField>
            </Grid>
            <FormField Text="Output format">
                <SelectInput data-testid="agents-voice-format" @bind-Value:get="draft.ResponseFormat" @bind-Value:set="(string value) => draft = draft with { ResponseFormat = value }" class="form-input ui-input ui-input--outlined">
                    @foreach (var format in AgentVoiceDefaults.ResponseFormats) {
                        <option value="@format">@format</option>
                    }
                </SelectInput>
            </FormField>
            <FormField Text="Sample text" Class="w-full">
                <TextAreaInput Value="@draft.SampleText" ValueChanged="@(value => draft = draft with { SampleText = value ?? string.Empty })"
                          Rows="4" Class="w-full" data-testid="agents-voice-sample-text" />
            </FormField>
            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                <Button Text="Save voice settings"
                        Icon="save"
                        Disabled="@(Presentation.IsBusy || Presentation.Editor.NeedsReview || Presentation.Editor.OutcomeUnknown)"
                        IsBusy="@Presentation.IsBusy"
                        Click="SaveAsync"
                        data-testid="agents-voice-save" />
                <Button Text="Play sample"
                        Icon="volume_up"
                        Tone="ButtonTone.Default"
                        Disabled="@(Presentation.IsBusy || Presentation.Editor.NeedsReview || Presentation.Editor.OutcomeUnknown)"
                        IsBusy="@Presentation.IsPlaying"
                        Click="PlaySampleAsync"
                        data-testid="agents-voice-play-sample" />
                <Button Text="Compare current settings" Tone="ButtonTone.Default" Disabled="@Presentation.IsBusy" Click="ReloadAsync" data-testid="agents-voice-compare" />
                @if (Presentation.Editor.CanUndo) {
                    <Button Text="Undo local review" Tone="ButtonTone.Default" Disabled="@Presentation.IsBusy" Click="UndoAsync" />
                }
                <StatusBadge Tone="@Presentation.StatusTone" Text="@Presentation.StatusText" />
            </Cluster>
            <TextBlock TextStyle="TextStyle.Caption" Value="@draft.DisclosureText" />
        </Stack>
    </SurfaceCard>
</Grid>
    </fieldset>
    <SettingsComparisonSurface Editor="Presentation.Editor" Changed="DraftChanged" />
}

@code {
    [Parameter, EditorRequired] public VoiceSettingsPresentation Presentation { get; set; } = new();
    [Parameter] public EventCallback<VoiceSettingsIntent> Intent { get; set; }
    [Parameter] public EventCallback DraftChanged { get; set; }
    private VoiceSettingsValues draft {
        get => Presentation.Editor.Draft;
        set {
            Presentation.Editor.Input(value);
            _ = DraftChanged.InvokeAsync();
        }
    }
    protected override void OnParametersSet() {
        if (Presentation.Editor.Original is null && Presentation.Source is { } source) {
            Presentation.Editor.Open(source);
        }
    }
    private VoiceSettingsValues Submission => draft with { UpdatedAtUtc = Presentation.Editor.Original!.UpdatedAtUtc };
    private Task SaveAsync() => Intent.InvokeAsync(new(Presentation.Generation, VoiceSettingsAction.Save, Submission));
    private Task ReloadAsync() => Intent.InvokeAsync(new(Presentation.Generation, VoiceSettingsAction.Compare));
    private Task PlaySampleAsync() => Intent.InvokeAsync(new(Presentation.Generation, VoiceSettingsAction.PlaySample, Submission));
    private async Task UndoAsync() {
        Presentation.Editor.Undo();
        await DraftChanged.InvokeAsync();
    }
}

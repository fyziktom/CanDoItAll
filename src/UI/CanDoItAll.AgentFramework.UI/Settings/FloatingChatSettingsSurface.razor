@namespace CanDoItAll.AgentFramework.UI.Settings
@if (Presentation.Source is null) {
    <StatusBadge Tone="@Presentation.StatusTone" Text="@Presentation.StatusText" />
    @if (!Presentation.IsBusy) {
        <Button Text="Reload settings" Click="CompareAsync" />
    }
} else {
    <Stack GapScale="LayoutGap.Medium" data-testid="floating-agent-chat-settings">
        @if (Presentation.Editor.UpdatesAvailable || Presentation.Editor.NeedsReview || Presentation.Editor.OutcomeUnknown) {
            <Alert AlertStyle="AlertStyle.Warning">Saved information may have changed. Compare current settings; your local entries stay in this editor.</Alert>
        }
        @if (invalid) {
            <Alert AlertStyle="AlertStyle.Danger">Enter whole numbers within the displayed limits. Your unfinished entries are retained.</Alert>
        }
        <Grid Gap="LayoutGap.Large" ColumnsLg="2">
            <SurfaceCard>
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Active chat lifecycle" />
                <FormStack>
                    <FormField Text="Hidden chat retention (minutes)">
                        <TextBox Value="@draft.Retention" ValueChanged="@(value => draft = draft with { Retention = value ?? string.Empty })" Immediate="true" inputmode="numeric" data-testid="floating-agent-chat-retention" />
                    </FormField>
                    <FormField Text="Maximum active chats">
                        <TextBox Value="@draft.ActiveLimit" ValueChanged="@(value => draft = draft with { ActiveLimit = value ?? string.Empty })" Immediate="true" inputmode="numeric" data-testid="floating-agent-chat-maximum-active" />
                    </FormField>
                    <SmallText Text="@($"Retention: 1–{Presentation.Limits!.MaximumRetentionMinutes} minutes. Active chats: 1–{Presentation.Limits.MaximumActiveChats}.")" />
                </FormStack>
            </SurfaceCard>
            <SurfaceCard>
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Prepared activation stock" />
                <FormStack>
                    <Alert AlertStyle="AlertStyle.Info">Preparation caches immutable agent activation metadata only. Live runtime agents, credentials, tool clients, and execution sessions remain per-run and are never pooled.</Alert>
                    <FormField Text="Maximum prepared agents">
                        <TextBox Value="@draft.PreparedLimit" ValueChanged="@(value => draft = draft with { PreparedLimit = value ?? string.Empty })" Immediate="true" inputmode="numeric" data-testid="floating-agent-chat-maximum-prepared" />
                    </FormField>
                    <SmallText Text="@($"Use 0 to disable background preparation. Maximum: {Presentation.Limits!.MaximumPreparedAgents}.")" />
                    <FormField Text="Adapt preparation to recent usage">
                        <CheckBox TValue="bool" Value="@draft.Adaptive" ValueChanged="@(value => draft = draft with { Adaptive = value })" data-testid="floating-agent-chat-adaptive" />
                    </FormField>
                    <FormField Text="Prepared metadata idle retention (minutes)">
                        <TextBox Value="@draft.PreparedRetention" ValueChanged="@(value => draft = draft with { PreparedRetention = value ?? string.Empty })" Immediate="true" inputmode="numeric" data-testid="floating-agent-chat-prepared-retention" />
                    </FormField>
                </FormStack>
            </SurfaceCard>
        </Grid>
        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
            <Button Text="Save floating chat settings" Icon="save" Disabled="@(Presentation.IsBusy || Presentation.Editor.NeedsReview || Presentation.Editor.OutcomeUnknown || Presentation.Status == FloatingChatSettingsStatus.AccessChanged)" IsBusy="@Presentation.IsBusy" Click="SaveAsync" data-testid="floating-agent-chat-settings-save" />
            <Button Text="Compare current settings" ButtonStyle="ButtonStyle.Light" Disabled="@Presentation.IsBusy" Click="CompareAsync" data-testid="floating-agent-chat-settings-compare" />
            @if (Presentation.Editor.CanUndo) {
                <Button Text="Undo local review" ButtonStyle="ButtonStyle.Light" Disabled="@Presentation.IsBusy" Click="UndoAsync" />
            }
            <StatusBadge Tone="@Presentation.StatusTone" Text="@Presentation.StatusText" />
        </Cluster>
        <SettingsComparisonSurface Editor="Presentation.Editor" Changed="DraftChanged" />
    </Stack>
}

@code {
    [Parameter, EditorRequired] public FloatingChatSettingsPresentation Presentation { get; set; } = new();
    [Parameter] public EventCallback<FloatingChatSettingsIntent> Intent { get; set; }
    [Parameter] public EventCallback DraftChanged { get; set; }
    private bool invalid;
    private FloatingChatSettingsInput draft {
        get => Presentation.Editor.Draft;
        set {
            Presentation.Editor.Input(value);
            _ = DraftChanged.InvokeAsync();
        }
    }
    protected override void OnParametersSet() {
        if (Presentation.Editor.Original is null && Presentation.Source is { } source) {
            Presentation.Editor.Open(FloatingChatSettingsInput.From(source));
        }
    }
    private Task SaveAsync() {
        var values = draft.Parse(Presentation.Editor.Original!.UpdatedAtUtc, Presentation.Limits!);
        invalid = values is null;
        return values is null ? Task.CompletedTask : Intent.InvokeAsync(new(Presentation.Generation, FloatingChatSettingsAction.Save, values));
    }
    private Task CompareAsync() => Intent.InvokeAsync(new(Presentation.Generation, FloatingChatSettingsAction.Compare));
    private async Task UndoAsync() {
        Presentation.Editor.Undo();
        await DraftChanged.InvokeAsync();
    }
}

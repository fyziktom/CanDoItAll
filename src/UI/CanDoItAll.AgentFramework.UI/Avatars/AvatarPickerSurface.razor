@implements IDisposable

<Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
    <Button Text="Choose avatar"
            Icon="face"
            ButtonStyle="ButtonStyle.Light"
            Size="ButtonSize.Small"
            Click="OpenAsync"
            Disabled="@(Disabled || Busy)"
            data-testid="@($"{TestIdPrefix}-open")" />
    <Button Text="Use default"
            Icon="restart_alt"
            ButtonStyle="ButtonStyle.Light"
            Size="ButtonSize.Small"
            Disabled="@(Disabled || Busy || string.IsNullOrWhiteSpace(Value))"
            Click="ClearAsync"
            data-testid="@($"{TestIdPrefix}-clear")" />
</Cluster>

@if (isOpen) {
    <Dialog IsOpen="true"
            Eyebrow="@($"{EntityKind} identity")"
            Title="Choose avatar"
            Subtitle="@AvatarAltText"
            Size="ModalSize.Wide"
            DenseChrome="true"
            TestId="@($"{TestIdPrefix}-dialog")"
            OnClose="CloseAsync">
        <ChildContent>
            <Stack GapScale="LayoutGap.Medium" Class="avatar-picker__body">
                <SurfaceCard Soft="true">
                    <Stack Orientation="Orientation.Horizontal"
                           AlignItems="AlignItems.Center"
                           GapScale="LayoutGap.Medium">
                        <Avatar Alt="@AvatarAltText"
                                ImageUrl="@Value"
                                FallbackText="@FallbackText"
                                DefaultImageSeed="@AvatarSeed"
                                Size="AvatarSize.Large"
                                Shape="AvatarShape.Rounded" />
                        <Stack GapScale="LayoutGap.XSmall">
                            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Current avatar" />
                            <strong>@SelectionText</strong>
                            <small class="text-sm text-slate-600">Avatar changes are saved with the definition.</small>
                        </Stack>
                    </Stack>
                </SurfaceCard>

                <SurfaceCard Soft="true">
                    <Grid Gap="LayoutGap.Medium" ColumnsMd="2">
                        <div>
                            <label class="cda-field-label" for="@UploadInputId">Custom image</label>
                            <InputFile id="@UploadInputId"
                                       class="cda-input"
                                       accept="image/png,image/jpeg,image/webp,image/gif"
                                       OnChange="LoadCustomAvatarAsync"
                                       disabled="@(Disabled || Busy)"
                                       data-testid="@($"{TestIdPrefix}-upload")" />
                            @if (!string.IsNullOrWhiteSpace(customAvatarFileName)) {
                                <p class="mt-2 break-all text-sm text-slate-600" data-testid="@($"{TestIdPrefix}-upload-file")">@customAvatarFileName</p>
                            }
                        </div>
                        <Stack GapScale="LayoutGap.XSmall" AlignItems="AlignItems.Start">
                            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Custom avatar" />
                            <p class="text-sm leading-6 text-slate-600">PNG, JPEG, WebP, or GIF. Max 128 KB.</p>
                            @if (isUploadBusy) {
                                <StatusBadge Tone="info" Text="Loading" />
                            } else if (IsCustomAvatar) {
                                <StatusBadge Tone="success" Text="Loaded" />
                            }
                        </Stack>
                    </Grid>
                </SurfaceCard>

                <SurfaceCard Soft="true" data-testid="@($"{TestIdPrefix}-ai")">
                    <Stack GapScale="LayoutGap.Small">
                        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Create with AI" />
                        @if (generationSource is not null) {
                            <TextBlock TextStyle="TextStyle.Body2"
                                       Value="@($"Uses the image provider '{generationSource.ProviderName}' and model '{generationSource.Model}'.")" />
                            <FormField Text="Creative direction">
                                <TextArea Value="@generationPrompt"
                                          ValueChanged="@(value => generationPrompt = value ?? string.Empty)"
                                          Size="TextAreaSize.Compact"
                                          Immediate="true"
                                          Disabled="@(Disabled || Busy)"
                                          maxlength="2000"
                                          data-testid="@($"{TestIdPrefix}-ai-prompt")" />
                            </FormField>
                            <Cluster JustifyContent="JustifyContent.End" Gap="LayoutGap.Small">
                                <Button Text="Create avatar with AI"
                                        Icon="auto_awesome"
                                        ButtonStyle="ButtonStyle.Primary"
                                        Size="ButtonSize.Small"
                                        IsBusy="@isGenerationBusy"
                                        Disabled="@(Disabled || Busy || string.IsNullOrWhiteSpace(generationPrompt))"
                                        Click="GenerateAsync"
                                        data-testid="@($"{TestIdPrefix}-ai-generate")" />
                            </Cluster>
                        } else {
                            <Alert AlertStyle="AlertStyle.Warning" data-testid="@($"{TestIdPrefix}-ai-unavailable")">
                                No default image provider is set. Configure and enable an image-generation provider before creating an avatar with AI.
                            </Alert>
                        }

                        @if (!string.IsNullOrWhiteSpace(generationErrorMessage)) {
                            <Alert AlertStyle="AlertStyle.Danger" data-testid="@($"{TestIdPrefix}-ai-error")">
                                @generationErrorMessage
                            </Alert>
                        }
                    </Stack>
                </SurfaceCard>

                <Grid Gap="LayoutGap.Medium"
                      ColumnTemplate="repeat(4,minmax(0,1fr))"
                      data-testid="@($"{TestIdPrefix}-options")">
                    @foreach (var option in AgentAvatarImageCatalog.BundledAvatarUrls.Select((url, index) => new { Url = url, Number = index + 1 })) {
                        <button type="button"
                                class="@ResolveOptionClass(option.Url)"
                                disabled="@(Disabled || Busy)"
                                @onclick="@(() => SelectAsync(option.Url))"
                                data-testid="@($"{TestIdPrefix}-option-{option.Number}")">
                            <Avatar Alt="@($"Avatar {option.Number}")"
                                    ImageUrl="@option.Url"
                                    FallbackText="@option.Number.ToString()"
                                    UseDefaultImageWhenMissing="false"
                                    Size="AvatarSize.Large"
                                    Shape="AvatarShape.Rounded" />
                            <span>Avatar @option.Number</span>
                            @if (IsSelected(option.Url)) {
                                <StatusBadge Tone="success" Text="Selected" />
                            }
                        </button>
                    }
                </Grid>
            </Stack>
        </ChildContent>
        <Footer>
            <Cluster JustifyContent="JustifyContent.End" Gap="LayoutGap.Small">
                <Button Text="Close"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Click="CloseAsync"
                        data-testid="@($"{TestIdPrefix}-close")" />
            </Cluster>
        </Footer>
    </Dialog>
}

@code {
    [Parameter, EditorRequired] public AvatarPickerOperations Operations { get; set; } = default!;
    [Parameter] public EventCallback<AvatarPickerNotice> Notice { get; set; }
    [Parameter] public CancellationToken OwnerLifetime { get; set; }

    private readonly CancellationTokenSource lifetime = new();
    private CancellationTokenSource pickerLifetime = new();
    private long pickerGeneration;
    private bool disposed;
    private AvatarGenerationSource? generationSource;
    private string customAvatarFileName = string.Empty;
    private string generationPrompt = string.Empty;
    private string? generationErrorMessage;
    private bool isOpen;
    private bool isOpening;
    private bool isUploadBusy;
    private bool isGenerationBusy;
    private bool Busy => isOpening || isUploadBusy || isGenerationBusy;

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public string EntityName { get; set; } = string.Empty;

    [Parameter]
    public string EntityDescription { get; set; } = string.Empty;

    [Parameter]
    public string EntityKind { get; set; } = "Agent";

    [Parameter]
    public string? DefaultImageSeed { get; set; }

    [Parameter]
    public AvatarGenerationSource? GenerationSource { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string TestIdPrefix { get; set; } = "avatar-picker";

    private readonly string uploadIdentity = Guid.NewGuid().ToString("N");
    private string UploadInputId => $"{TestIdPrefix}-upload-{uploadIdentity}";

    private string AvatarSeed => FirstNonEmpty(DefaultImageSeed, EntityName, EntityDescription, $"{EntityKind} avatar");

    private string AvatarAltText => FirstNonEmpty(EntityName, EntityDescription, $"{EntityKind} avatar");

    private string FallbackText => string.Concat(AvatarSeed
        .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Take(2)
        .Select(part => char.ToUpperInvariant(part[0])));

    private bool IsCustomAvatar => Value.StartsWith("data:image/", StringComparison.OrdinalIgnoreCase);

    private string SelectionText => string.IsNullOrWhiteSpace(Value)
        ? "Default generated avatar"
        : AgentAvatarImageCatalog.IsBundledAvatarUrl(Value)
            ? "Bundled avatar selected"
            : IsCustomAvatar
                ? "Custom avatar loaded"
                : "Custom avatar selected";


    private async Task OpenAsync() {
        if (disposed || Disabled || Busy || OwnerLifetime.IsCancellationRequested) {
            return;
        }
        var generation = pickerGeneration;
        var operations = Operations;
        var notice = Notice;
        using var request = CreateRequest();
        isOpening = true;
        generationPrompt = string.IsNullOrWhiteSpace(generationPrompt) ? BuildDefaultPrompt() : generationPrompt;
        generationErrorMessage = null;
        try {
            var source = GenerationSource ?? await operations.ReadSource(request.Token);
            if (IsCurrent(generation, request)) {
                generationSource = source;
                isOpen = true;
            }
        } catch (Exception) when (!IsCurrent(generation, request)) {
        } catch (Exception) {
            await notice.InvokeAsync(new(AvatarPickerNoticeKind.Unavailable, "Avatar options could not be loaded. Retry when the provider is available."));
        } finally {
            if (IsCurrent(generation, request)) {
                isOpening = false;
            }
        }
    }

    private Task CloseAsync() {
        var previous = pickerLifetime;
        pickerLifetime = new();
        pickerGeneration++;
        previous.Cancel();
        previous.Dispose();
        isOpen = false;
        isOpening = false;
        isUploadBusy = false;
        isGenerationBusy = false;
        return Task.CompletedTask;
    }

    private Task ClearAsync() => SelectAsync(string.Empty);

    private async Task SelectAsync(string value) {
        if (disposed || Disabled || Busy || OwnerLifetime.IsCancellationRequested) {
            return;
        }
        var changed = ValueChanged;
        customAvatarFileName = string.Empty;
        generationErrorMessage = null;
        await changed.InvokeAsync(value.Trim());
    }

    private async Task LoadCustomAvatarAsync(InputFileChangeEventArgs args) {
        if (disposed || Disabled || Busy || !isOpen || OwnerLifetime.IsCancellationRequested) {
            return;
        }
        var generation = pickerGeneration;
        var changed = ValueChanged;
        var notice = Notice;
        var operations = Operations;
        var entityKind = EntityKind;
        using var request = CreateRequest();
        customAvatarFileName = args.File.Name;
        isUploadBusy = true;
        try {
            var value = await operations.Upload(args.File, request.Token);
            if (!IsCurrent(generation, request)) {
                return;
            }
            await changed.InvokeAsync(value);
            if (IsCurrent(generation, request)) {
                generationErrorMessage = null;
                await notice.InvokeAsync(new(AvatarPickerNoticeKind.Uploaded, $"Save the {entityKind.ToLowerInvariant()} to persist the loaded avatar."));
            }
        } catch (Exception) when (!IsCurrent(generation, request)) {
        } catch (Exception) {
            customAvatarFileName = string.Empty;
            await notice.InvokeAsync(new(AvatarPickerNoticeKind.UploadFailed, "The avatar could not be loaded. Choose a supported PNG, JPEG, WebP, or GIF image within the upload limit."));
        } finally {
            if (IsCurrent(generation, request)) {
                isUploadBusy = false;
            }
        }
    }

    private async Task GenerateAsync() {
        if (disposed || Disabled || Busy || !isOpen || generationSource is null || OwnerLifetime.IsCancellationRequested) {
            return;
        }
        var generation = pickerGeneration;
        var changed = ValueChanged;
        var notice = Notice;
        var operations = Operations;
        var entityKind = EntityKind;
        var submission = new AvatarGenerationRequest(generationSource, generationPrompt);
        using var request = CreateRequest();
        isGenerationBusy = true;
        generationErrorMessage = null;
        try {
            var result = await operations.Generate(submission, request.Token);
            if (!IsCurrent(generation, request)) {
                return;
            }
            customAvatarFileName = string.Empty;
            await changed.InvokeAsync(result.AvatarDataUrl);
            if (IsCurrent(generation, request)) {
                await notice.InvokeAsync(new(AvatarPickerNoticeKind.Generated, $"Save the {entityKind.ToLowerInvariant()} to persist the generated avatar."));
            }
        } catch (Exception) when (!IsCurrent(generation, request)) {
        } catch (Exception) {
            generationErrorMessage = "The avatar could not be generated. Review the image provider configuration before trying again.";
            await notice.InvokeAsync(new(AvatarPickerNoticeKind.GenerationFailed, generationErrorMessage));
        } finally {
            if (IsCurrent(generation, request)) {
                isGenerationBusy = false;
            }
        }
    }

    private CancellationTokenSource CreateRequest()
        => CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token, pickerLifetime.Token, OwnerLifetime);

    private bool IsCurrent(long generation, CancellationTokenSource request)
        => !disposed && generation == pickerGeneration && !request.IsCancellationRequested;

    private bool IsSelected(string avatarImageUrl)
        => string.Equals(Value?.Trim(), avatarImageUrl.Trim(), StringComparison.OrdinalIgnoreCase);

    private string ResolveOptionClass(string avatarImageUrl)
        => IsSelected(avatarImageUrl)
            ? "avatar-picker__option avatar-picker__option--selected"
            : "avatar-picker__option";

    private string BuildDefaultPrompt() {
        var name = FirstNonEmpty(EntityName, $"this {EntityKind.ToLowerInvariant()}");
        var description = string.IsNullOrWhiteSpace(EntityDescription)
            ? string.Empty
            : $", described as {EntityDescription.Trim()}";
        return $"A distinctive, friendly illustrated avatar for {name}{description}, in a clean modern professional style.";
    }

    private static string FirstNonEmpty(params string?[] values)
        => values.First(value => !string.IsNullOrWhiteSpace(value))!.Trim();

    public void Dispose() {
        if (disposed) {
            return;
        }
        disposed = true;
        pickerGeneration++;
        lifetime.Cancel();
        pickerLifetime.Cancel();
        lifetime.Dispose();
        pickerLifetime.Dispose();
    }
}

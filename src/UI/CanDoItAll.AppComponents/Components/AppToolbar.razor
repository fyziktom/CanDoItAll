@namespace CanDoItAll.AppComponents
@implements IDisposable
@inject AppToolbarState ToolbarState
@using CanDoItAll.SharedKernel
@inject IUserUiPreferencesState Preferences

<div class="@CssClassBuilder.Join("app-toolbar", Class)" role="banner">
    <nav class="app-toolbar__crumbs" aria-label="Breadcrumb">
        <h1 class="app-toolbar__crumb focus:outline-none" tabindex="-1">@PageText</h1>
        @if (!string.IsNullOrWhiteSpace(ContextText))
        {
            <span aria-hidden="true">&gt;</span>
            <span class="app-toolbar__crumb app-toolbar__crumb--tab">@ContextText</span>
        }
        @if (!string.IsNullOrWhiteSpace(ToolbarState.TabText))
        {
            <span aria-hidden="true">&gt;</span>
            <span class="app-toolbar__crumb app-toolbar__crumb--tab">@ToolbarState.TabText</span>
        }
    </nav>

    <div class="app-toolbar__actions">
        @ToolbarState.ActionsContent

        @if (ToolbarState.StatsContent is not null)
        {
            <PageHeaderActionButton Icon="bar_chart" Label="Toggle page statistics"
                    Variant="Variant.Outlined"
                    Size="ButtonSize.Small"
                    aria-pressed="@(ToolbarState.StatsVisible ? "true" : "false")"
                    Click="@(() => ToolbarState.SetStatsVisibleAsync(!ToolbarState.StatsVisible))" />
        }

        @if (ToolbarState.HelpContent is not null)
        {
            <PageHeaderActionButton Icon="help" Label="Toggle page help"
                    Variant="Variant.Outlined"
                    Size="ButtonSize.Small"
                    aria-pressed="@(ToolbarState.HelpVisible ? "true" : "false")"
                    Click="@(() => ToolbarState.SetHelpVisibleAsync(!ToolbarState.HelpVisible))" />
        }

        <PageHeaderActionButton Label="Toggle color theme" Icon="@(IsDark ? "dark_mode" : "light_mode")"
                Variant="Variant.Outlined"
                Size="ButtonSize.Small"
                aria-pressed="@(IsDark ? "true" : "false")"
                Disabled="@(!Preferences.CanEdit)"
                Click="ToggleThemeAsync" />
    </div>
</div>

@code {
    /// <summary>The current page's side-nav label, e.g. "Agents". Supplied by the shell (<c>MainLayout</c>), not the page.</summary>
    [Parameter, EditorRequired]
    public string PageText { get; set; } = string.Empty;

    /// <summary>The current project's name, shown as the breadcrumb segment between <see cref="PageText"/> and the per-page tab text. Supplied by the shell (<c>MainLayout</c>), empty outside project-scoped routes.</summary>
    [Parameter]
    public string? ContextText { get; set; }

    /// <summary>Extra CSS class merged onto the root element, e.g. the shell's breakout modifier for standard (padded) shell mode.</summary>
    [Parameter]
    public string? Class { get; set; }

    private bool IsDark => Preferences.Current.Theme == UiThemeMode.Dark;

    protected override void OnInitialized()
    {
        ToolbarState.Changed += HandleChanged;
        Preferences.Changed += HandleChanged;
    }

    private void HandleChanged() => InvokeAsync(StateHasChanged);

    private Task ToggleThemeAsync()
        => Preferences.UpdateAsync(new(Theme: IsDark ? UiThemeMode.Light : UiThemeMode.Dark));

    public void Dispose()
    {
        ToolbarState.Changed -= HandleChanged;
        Preferences.Changed -= HandleChanged;
    }
}

@namespace CanDoItAll.AppComponents
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.SharedKernel
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<div @ref="stripElement" class="app-tab-strip @(Compact ? string.Empty : "app-tab-strip--standard")">
    <Split Breakpoint="LayoutBreakpoint.Xl"
           Gap="LayoutGap.Small"
           AlignItems="AlignItems.Center"
           JustifyContent="JustifyContent.SpaceBetween"
           Class="app-tab-strip__main-row"
           data-testid="app-tab-strip-main-row">
        <Cluster Gap="LayoutGap.XSmall"
                 Class="app-tab-strip__tabs min-w-0"
                 Wrap="FlexWrap.NoWrap"
                 role="tablist"
                 aria-label="Open workspace tabs">
            @foreach (var tab in InlineTabs)
            {
                @RenderTab(tab)
            }
        </Cluster>

        <Cluster Gap="LayoutGap.XSmall"
                 Wrap="FlexWrap.NoWrap"
                 Class="app-tab-strip__controls flex-shrink-0"
                 data-testid="app-tab-strip-controls">
            @if (Items.Count > 1 || RecentTabs.Count > 0)
            {
                <input @bind="searchText"
                       @bind:event="oninput"
                       placeholder="Search tabs"
                       aria-label="Search open and recently closed tabs"
                       class="app-tab-search" />
            }

            @if (Items.Count > 1)
            {
                <details class="group app-tab-menu">
                    <summary class="app-tab-menu__summary">
                        All tabs (@Items.Count)
                    </summary>
                    <div class="app-tab-menu__panel app-tab-menu__panel--wide">
                        <div class="app-tab-menu__list">
                            @foreach (var tab in FilteredTabs)
                            {
                                <button type="button"
                                        class="app-tab-menu__item"
                                        @onclick="() => SelectFromMenuAsync(tab.TabId)">
                                    <span class="min-w-0">
                                        <span class="block truncate font-semibold text-chrome-900">@tab.Title</span>
                                        <span class="block truncate text-xs text-[var(--tone-text-muted)]">@tab.TabGroup / @tab.Route</span>
                                    </span>
                                    @if (tab.IsSleeping)
                                    {
                                        <span class="app-tab-menu__badge" aria-hidden="true"><Icon Name="bedtime" /></span>
                                    }
                                </button>
                            }
                        </div>
                    </div>
                </details>
            }

            @if (RecentTabs.Count > 0)
            {
                <details class="group app-tab-menu">
                    <summary class="app-tab-menu__summary"
                             data-testid="recent-tabs-menu-trigger">
                        Reopen (@RecentTabs.Count)
                    </summary>
                    <Stack GapScale="LayoutGap.Small"
                           Class="app-tab-menu__panel app-tab-menu__panel--compact app-tab-menu__panel--recent"
                           data-testid="recent-tabs-menu-panel">
                        <Cluster Gap="LayoutGap.Small"
                                 Wrap="FlexWrap.NoWrap"
                                 AlignItems="AlignItems.Center"
                                 JustifyContent="JustifyContent.SpaceBetween"
                                 Class="app-tab-recent-header">
                            <Stack GapScale="LayoutGap.XSmall" Class="min-w-0">
                                <p class="text-sm font-semibold text-chrome-900">Recently closed</p>
                                <p class="truncate text-xs text-[var(--tone-text-muted)]">
                                    Stored in this browser · latest @WorkbenchTabHistoryPolicy.RecentTabCapacity kept
                                </p>
                            </Stack>
                            <Button Text="Clear all"
                                    Icon="delete_sweep"
                                    Tone="ButtonTone.Default"
                                    Variant="Variant.Text"
                                    Size="ButtonSize.Small"
                                    Class="flex-shrink-0"
                                    Click="@(() => ClearRecent.InvokeAsync())"
                                    data-testid="clear-recent-tabs" />
                        </Cluster>
                        <div class="app-tab-menu__list">
                            @if (FilteredRecentTabs.Count == 0)
                            {
                                <p class="rounded-xl border border-dashed border-chrome-200 px-3 py-4 text-center text-sm text-[var(--tone-text-muted)]">
                                    No recently closed tabs match your search.
                                </p>
                            }
                            else
                            {
                                @foreach (var recent in FilteredRecentTabs)
                                {
                                    <button type="button"
                                            class="app-tab-menu__item"
                                            title="Reopen recent tab"
                                            @onclick="() => ReopenRecent.InvokeAsync(recent.TabId)">
                                        <span class="min-w-0">
                                            <span class="block truncate font-semibold text-chrome-900">@recent.Title</span>
                                            <span class="block truncate text-xs text-[var(--tone-text-muted)]">@recent.TabGroup / @recent.Route</span>
                                        </span>
                                        <span class="text-chrome-500" aria-hidden="true"><Icon Name="restore" /></span>
                                    </button>
                                }
                            }
                        </div>
                    </Stack>
                </details>
            }
        </Cluster>
    </Split>

    <ContextMenu IsOpen="@(MenuTab is not null)"
                 X="@menuX"
                 Y="@menuY"
                 Heading="@MenuTab?.Title"
                 AriaLabel="Workspace tab actions"
                 Items="@TabMenuItems"
                 ItemSelected="HandleTabCommandAsync"
                 OnClose="CloseTabMenu"
                 Style="background:var(--tone-surface);border-color:var(--tone-border-soft)"
                 TestId="workspace-tab-actions-menu" />

    @if (ShowActiveSummary && ActiveTab is not null)
    {
        <div class="app-tab-summary">
            <Cluster Gap="LayoutGap.XSmall" Class="min-w-0">
                <p class="text-xs font-semibold text-chrome-900">@ActiveTab.Title</p>
                <span class="app-tab-summary-chip">@ActiveTab.TabGroup</span>
                @if (!string.IsNullOrWhiteSpace(ActiveTab.ProjectName))
                {
                    <span class="app-tab-summary-chip app-tab-summary-chip--info">@ActiveTab.ProjectName</span>
                }
                <span class="truncate text-[10px] text-[var(--tone-text-muted)]">@ActiveTab.Route</span>
            </Cluster>

            <Cluster Wrap="FlexWrap.NoWrap"
                     Gap="LayoutGap.XSmall"
                     Class="flex-shrink-0">
                <button type="button"
                        class="app-tab-summary-action"
                        title="Close other tabs"
                        @onclick="() => CloseOthers.InvokeAsync(ActiveTab.TabId)">
                    Close others
                </button>
                <button type="button"
                        class="app-tab-summary-action"
                        title="Close tabs to the right"
                        @onclick="() => CloseRight.InvokeAsync(ActiveTab.TabId)">
                    Close right
                </button>
            </Cluster>
        </div>
    }
</div>

@code {
    private string searchText = string.Empty;
    private ElementReference stripElement;
    private IJSObjectReference? module;
    private string? revealedTabId;
    private (string Id, string Title)[] revealedTabs = [];
    private string? menuTabId;
    private double menuX;
    private double menuY;

    private enum TabCommand {
        MoveLeft,
        MoveRight,
        TogglePin,
        ToggleSleep,
        CloseOthers,
        CloseRight
    }

    protected override void OnParametersSet() {
        if (menuTabId is not null && MenuTab is null) {
            CloseTabMenu();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (module is null && firstRender) {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/CanDoItAll.AppComponents/js/appTabStrip.js");
            if (module is not null) {
                await module.InvokeVoidAsync("observe", stripElement);
                StateHasChanged();
            }
        }
        var visibleTabs = FilteredTabs.Select(tab => (tab.TabId, tab.Title)).ToArray();
        if (module is not null && (!string.Equals(revealedTabId, ActiveTabId, StringComparison.Ordinal) || !revealedTabs.SequenceEqual(visibleTabs))) {
            revealedTabId = ActiveTabId;
            revealedTabs = visibleTabs;
            await module.InvokeVoidAsync("revealActive", stripElement);
        }
    }

    public async ValueTask DisposeAsync() {
        if (module is null) {
            return;
        }
        try {
            await module.InvokeVoidAsync("dispose", stripElement);
            await module.DisposeAsync();
        } catch (JSDisconnectedException) {
        }
    }

    private async Task SelectFromMenuAsync(string tabId) {
        if (module is not null) {
            await module.InvokeVoidAsync("closeMenus", stripElement);
        }
        await Activate.InvokeAsync(tabId);
    }

    private async Task OpenTabMenuAsync(string tabId) {
        if (module is null || !Items.Any(tab => string.Equals(tab.TabId, tabId, StringComparison.Ordinal))) {
            return;
        }
        var position = await module.InvokeAsync<double[]?>("getMenuPosition", stripElement, tabId);
        if (!Items.Any(tab => string.Equals(tab.TabId, tabId, StringComparison.Ordinal))) {
            return;
        }
        if (position is not { Length: 2 }) {
            throw new InvalidOperationException("The workspace tab action trigger is unavailable.");
        }
        menuX = position[0];
        menuY = position[1];
        menuTabId = tabId;
    }

    private void CloseTabMenu() => menuTabId = null;

    private WorkbenchTabState? MenuTab => Items.FirstOrDefault(tab => string.Equals(tab.TabId, menuTabId, StringComparison.Ordinal));

    private IReadOnlyList<ContextMenuItem> TabMenuItems => MenuTab is { } tab
        ? [
            new() { Id = nameof(TabCommand.MoveLeft), Text = "Move left", Icon = "chevron_left", Disabled = Items[0].TabId == tab.TabId },
            new() { Id = nameof(TabCommand.MoveRight), Text = "Move right", Icon = "chevron_right", Disabled = Items[^1].TabId == tab.TabId },
            new() { Id = nameof(TabCommand.TogglePin), Text = tab.IsPinned ? "Unpin tab" : "Pin tab", Icon = "push_pin" },
            new() { Id = nameof(TabCommand.ToggleSleep), Text = tab.IsSleeping ? "Wake tab" : "Sleep tab", Icon = "bedtime", Disabled = !tab.CanSleep || (IsActive(tab) && !tab.IsSleeping) },
            new() { Id = nameof(TabCommand.CloseOthers), Text = "Close other tabs", Icon = "close", SeparatorBefore = true },
            new() { Id = nameof(TabCommand.CloseRight), Text = "Close tabs to the right", Icon = "chevron_right" }
        ]
        : [];

    private Task HandleTabCommandAsync(string command) {
        var tab = MenuTab;
        CloseTabMenu();
        if (tab is null) {
            return Task.CompletedTask;
        }
        return command switch {
            nameof(TabCommand.MoveLeft) => MoveLeft.InvokeAsync(tab.TabId),
            nameof(TabCommand.MoveRight) => MoveRight.InvokeAsync(tab.TabId),
            nameof(TabCommand.TogglePin) => TogglePin.InvokeAsync(tab.TabId),
            nameof(TabCommand.ToggleSleep) => ToggleSleep.InvokeAsync(tab.TabId),
            nameof(TabCommand.CloseOthers) => CloseOthers.InvokeAsync(tab.TabId),
            nameof(TabCommand.CloseRight) => CloseRight.InvokeAsync(tab.TabId),
            _ => throw new ArgumentOutOfRangeException(nameof(command), command, "Unknown workspace tab command.")
        };
    }

    [Parameter]
    public IReadOnlyList<WorkbenchTabState> Items { get; set; } = [];

    [Parameter]
    public IReadOnlyList<WorkbenchTabState> RecentTabs { get; set; } = [];

    [Parameter]
    public string? ActiveTabId { get; set; }

    [Parameter]
    public bool ShowActiveSummary { get; set; } = true;

    [Parameter]
    public bool Compact { get; set; }

    [Parameter]
    public EventCallback<string> Activate { get; set; }

    [Parameter]
    public EventCallback<string> Close { get; set; }

    [Parameter]
    public EventCallback<string> MoveLeft { get; set; }

    [Parameter]
    public EventCallback<string> MoveRight { get; set; }

    [Parameter]
    public EventCallback<string> TogglePin { get; set; }

    [Parameter]
    public EventCallback<string> ToggleSleep { get; set; }

    [Parameter]
    public EventCallback<string> CloseOthers { get; set; }

    [Parameter]
    public EventCallback<string> CloseRight { get; set; }

    [Parameter]
    public EventCallback<string> CloseBackground { get; set; }

    [Parameter]
    public EventCallback<string> ReopenRecent { get; set; }

    [Parameter]
    public EventCallback ClearRecent { get; set; }

    private WorkbenchTabState? ActiveTab => Items.FirstOrDefault(tab => string.Equals(tab.TabId, ActiveTabId, StringComparison.Ordinal));

    private IReadOnlyList<WorkbenchTabState> FilteredTabs
        => string.IsNullOrWhiteSpace(searchText)
            ? Items
            : Items.Where(tab =>
                    tab.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    tab.Route.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(tab.ProjectName, searchText, StringComparison.OrdinalIgnoreCase))
                .ToList();

    private IReadOnlyList<WorkbenchTabState> InlineTabs => FilteredTabs;


    private IReadOnlyList<WorkbenchTabState> FilteredRecentTabs
        => string.IsNullOrWhiteSpace(searchText)
            ? RecentTabs
            : RecentTabs.Where(tab =>
                    tab.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    tab.Route.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                .ToList();

    private RenderFragment RenderTab(WorkbenchTabState tab) => @<div @key="tab.TabId" data-tab-id="@tab.TabId" class="app-inline-tab @(IsActive(tab) ? "app-inline-tab--active" : "app-inline-tab--inactive")">
        <button type="button"
                role="tab"
                aria-selected="@(IsActive(tab) ? "true" : "false")"
                aria-current="@(IsActive(tab) ? "page" : null)"
                class="app-inline-tab__activate"
                title="@tab.Title"
                @onclick="() => Activate.InvokeAsync(tab.TabId)">
            <span class="min-w-0 flex-1 truncate font-medium">@tab.Title</span>
            @if (tab.IsDirty)
            {
                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-amber-400"></span>
            }
            @if (tab.IsPinned)
            {
                <span class="shrink-0 text-sky-400" aria-hidden="true"><Icon Name="push_pin" /></span>
            }
            @if (tab.IsSleeping)
            {
                <span class="app-inline-tab__sleep-state shrink-0 text-chrome-500" title="Sleeping"><Icon Name="bedtime" /><span class="sr-only">Sleeping</span></span>
            }
        </button>

        <div class="app-inline-tab__actions">
            <button type="button"
                    class="app-inline-tab__action app-inline-tab__menu-trigger"
                    title="Tab actions"
                    aria-label="@($"Tab actions for {tab.Title}")"
                    aria-haspopup="menu"
                    aria-expanded="@(menuTabId == tab.TabId ? "true" : "false")"
                    disabled="@(module is null)"
                    @onclick="() => OpenTabMenuAsync(tab.TabId)">
                <Icon Name="more_horiz" />
            </button>
            @if (tab.CanClose)
            {
                <button type="button" class="app-inline-tab__action" title="Close tab" aria-label="@($"Close {tab.Title}")" @onclick="() => Close.InvokeAsync(tab.TabId)"><Icon Name="close" /></button>
            }
        </div>
    </div>;

    private bool IsActive(WorkbenchTabState tab)
        => string.Equals(tab.TabId, ActiveTabId, StringComparison.Ordinal);
}

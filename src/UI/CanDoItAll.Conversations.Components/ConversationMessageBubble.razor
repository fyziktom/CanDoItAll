@using CanDoItAll.Conversations.Components.Presentation

<div class="flex @(IsUserMessage ? "justify-end" : "justify-start")"
     data-testid="conversation-message">
    <div class="flex max-w-[44rem] flex-col gap-2 @(IsUserMessage ? "items-end" : "items-start")">
        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
            @if (!IsUserMessage && Message.Avatar is not null)
            {
                <Avatar Alt="@Message.Avatar.Alt"
                        ImageUrl="@Message.Avatar.ImageUrl"
                        FallbackText="@Message.Avatar.FallbackText"
                        DefaultImageSeed="@Message.Avatar.Seed"
                        Size="AvatarSize.Small"
                        Shape="AvatarShape.Rounded" />
            }

            <StatusBadge Tone="@PresentationToneResolver.Resolve(Message.RoleTone)"
                         Text="@Message.RoleLabel" />
            @if (Message.State == ConversationMessageState.Pending)
            {
                <StatusBadge Tone="neutral" Text="Sending..." />
            }
            <TextBlock TextStyle="TextStyle.Caption" Value="@Message.CreatedAtDisplay" />
        </Cluster>

        <div class="@ResolveBubbleClass()">
            @if (IsUserMessage)
            {
                <p class="text-sm leading-6">@Message.Content</p>
                @if (!string.IsNullOrWhiteSpace(Message.HiddenContext))
                {
                    <details class="chat-message-context chat-message-context--user"
                             data-testid="@(Message.State == ConversationMessageState.Pending ? "chat-pending-hidden-context" : "chat-message-hidden-context")">
                        <summary>...more</summary>
                        <pre>@Message.HiddenContext</pre>
                    </details>
                }
            }
            else
            {
                <ConversationMarkdownRenderer Markdown="@Message.Content"
                                              Class="text-sm leading-6" />
            }

            @if (Message.State == ConversationMessageState.Normal)
            {
                <div class="chat-message-footer">
                    <span class="chat-message-footer-meta">
                        @if (Message.TokenEstimate > 0)
                        {
                            <span class="text-xs @(IsUserMessage ? "text-white/70" : "text-slate-400")">~@Message.TokenEstimate tokens</span>
                        }
                    </span>

                    <CopyButton Value="@Message.CopyValue"
                                Disabled="@string.IsNullOrWhiteSpace(Message.CopyValue)"
                                DisplayMode="CopyButtonDisplayMode.IconOnly"
                                Size="CopyButtonSize.ExtraSmall"
                                AriaLabel="@Message.CopyAriaLabel"
                                Class="@(IsUserMessage ? "chat-message-copy chat-message-copy--user" : "chat-message-copy")" />
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ConversationMessagePresentation Message { get; set; } = default!;

    private bool IsUserMessage => Message.Role == ConversationMessageRole.User;

    private string ResolveBubbleClass()
    {
        if (Message.State == ConversationMessageState.Pending)
        {
            return "rounded-[1.4rem] border border-slate-900 bg-slate-900 px-4 py-3.5 text-white shadow-sm opacity-90";
        }

        return CssClassBuilder.Join(
            "chat-message-bubble rounded-[1.4rem] border px-4 py-3.5 shadow-sm",
            IsUserMessage
                ? "border-slate-900 bg-slate-900 text-white"
                : "border-slate-200 bg-slate-50 text-slate-700");
    }
}

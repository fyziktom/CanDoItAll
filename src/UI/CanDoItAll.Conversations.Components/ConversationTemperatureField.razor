<FormField Text="@Label" Class="@Class" data-testid="@TestId">
    <Numeric TValue="double?"
             Value="@Value"
             ValueChanged="ValueChanged"
             Min="@Minimum"
             Max="@Maximum"
             Step="@Step"
             Disabled="@Disabled"
             data-testid="@InputTestId" />
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="mt-2 text-sm leading-6 text-slate-600">@Description</p>
    }
    @if (Validation is not null)
    {
        @Validation
    }
</FormField>

@code {
    [Parameter]
    public double? Value { get; set; }

    [Parameter]
    public EventCallback<double?> ValueChanged { get; set; }

    [Parameter]
    public double Minimum { get; set; }

    [Parameter]
    public double Maximum { get; set; } = 2d;

    [Parameter]
    public double Step { get; set; } = 0.1d;

    [Parameter]
    public string Label { get; set; } = "Temperature";

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? Validation { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter]
    public string? InputTestId { get; set; }
}

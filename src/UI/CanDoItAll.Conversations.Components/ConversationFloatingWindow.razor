@using Microsoft.AspNetCore.Components.Sections
@using CanDoItAll.Conversations.Components.Presentation

<div class="conversation-floating-window" hidden="@(!State.IsVisible)">
    <CascadingValue Value="headerSlots" IsFixed="true">
        <OverlayWindow WindowId="@WindowId"
                       TestId="@TestId"
                       AriaLabel="@AriaLabel"
                       Kicker="@Kicker"
                       Title="@Title"
                       Summary="@Summary"
                       BodyClass="conversation-floating-window__body"
                       KeepContentMountedWhenMinimized="true"
                       DefaultPlacement="@DefaultPlacement"
                       DefaultWidth="@DefaultWidth"
                       DefaultHeight="@DefaultHeight"
                       MinWidth="@MinWidth"
                       MinHeight="@MinHeight"
                       MaxWidth="@MaxWidth"
                       MaxHeight="@MaxHeight"
                       State="@State"
                       StateChanged="@StateChanged">
            <HeaderLeading>
                @if (Avatar is not null) {
                    <Avatar Alt="@Avatar.Alt" ImageUrl="@Avatar.ImageUrl" FallbackText="@Avatar.FallbackText"
                            DefaultImageSeed="@Avatar.Seed" Size="AvatarSize.Small" Shape="AvatarShape.Rounded" />
                }
            </HeaderLeading>
            <HeaderStatus><SectionOutlet SectionId="headerSlots.Status" /></HeaderStatus>
            <ChildContent>@ChildContent</ChildContent>
        </OverlayWindow>
    </CascadingValue>
</div>

@code {
    private readonly ConversationWindowHeaderSlots headerSlots = new();

    [Parameter]
    public ConversationAvatarPresentation? Avatar { get; set; }

    [Parameter, EditorRequired]
    public string WindowId { get; set; } = string.Empty;

    [Parameter]
    public string? TestId { get; set; }

    [Parameter, EditorRequired]
    public string AriaLabel { get; set; } = string.Empty;

    [Parameter]
    public string? Kicker { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Summary { get; set; }

    [Parameter]
    public string DefaultPlacement { get; set; } = "top-right";

    [Parameter]
    public double DefaultWidth { get; set; } = 560;

    [Parameter]
    public double DefaultHeight { get; set; } = 720;

    [Parameter]
    public double MinWidth { get; set; } = 360;

    [Parameter]
    public double MinHeight { get; set; } = 420;

    [Parameter]
    public double MaxWidth { get; set; } = 900;

    [Parameter]
    public double MaxHeight { get; set; } = 900;

    [Parameter, EditorRequired]
    public OverlayWindowState State { get; set; } = new();

    [Parameter]
    public EventCallback<OverlayWindowState> StateChanged { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;
}

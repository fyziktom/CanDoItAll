@typeparam TValue
@using CanDoItAll.Conversations.Components.Presentation
@{
    var presentation = Presentation;
    var changed = ValueChanged;
}
<FormField Text="Thinking effort">
    <Stack GapScale="LayoutGap.Small">
        <DropDown TValue="string"
                  Data="@presentation.Options"
                  TextProperty="@nameof(ConversationThinkingEffortOption<TValue>.Text)"
                  ValueProperty="@nameof(ConversationThinkingEffortOption<TValue>.ChoiceValue)"
                  Value="@presentation.SelectedChoiceValue"
                  ValueChanged="choice => SelectAsync(presentation, changed, choice)"
                  Disabled="@(Disabled || presentation.IsDisabled)"
                  data-testid="@TestId" />
        <Alert AlertStyle="@presentation.SupportStyle" Variant="Variant.Outlined" data-testid="@SupportTestId">
            @presentation.SupportMessage
        </Alert>
    </Stack>
</FormField>

@code {
    [Parameter, EditorRequired]
    public ConversationThinkingEffortPresentation<TValue> Presentation { get; set; } = default!;
    [Parameter]
    public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter]
    public bool Disabled { get; set; }
    [Parameter]
    public string? TestId { get; set; }
    [Parameter]
    public string? SupportTestId { get; set; }

    private static Task SelectAsync(ConversationThinkingEffortPresentation<TValue> presentation, EventCallback<TValue> changed, string? choice) {
        var option = presentation.Options.FirstOrDefault(item => string.Equals(item.ChoiceValue, choice, StringComparison.Ordinal))
            ?? throw new InvalidOperationException("The thinking-effort choice is not in the presented options.");
        return changed.InvokeAsync(option.Value);
    }
}

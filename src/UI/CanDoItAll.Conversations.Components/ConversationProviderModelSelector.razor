@using CanDoItAll.Conversations.Components.Presentation

<div class="@Class" data-testid="@TestId">
    <FormField Text="@Label">
        <Stack GapScale="LayoutGap.Small">
            <DropDown TValue="ProviderModelSelectorOption"
                      Data="@modelChoices"
                      TextProperty="@nameof(ProviderModelSelectorOption.Text)"
                      Value="@selectedChoice"
                      ValueChanged="HandleChoiceChangedAsync"
                      Disabled="@(Disabled || isOverrideEnabled)"
                      data-testid="@ChoiceTestId" />

            <label class="cda-inline-option">
                <CheckBox TValue="bool"
                          Value="@isOverrideEnabled"
                          ValueChanged="HandleOverrideChangedAsync"
                          Disabled="@Disabled"
                          aria-label="Override model name"
                          data-testid="@OverrideTestId" />
                <span>Override model name</span>
            </label>

            @if (isOverrideEnabled)
            {
                <TextBox Value="@customModelName"
                         ValueChanged="HandleCustomModelChangedAsync"
                         Immediate="true"
                         Disabled="@Disabled"
                         Placeholder="@CustomModelPlaceholder"
                         data-testid="@CustomModelTestId" />
            }
        </Stack>
    </FormField>
</div>

@code {
    private readonly List<ProviderModelSelectorOption> modelChoices = [];
    private ProviderModelSelectorOption? selectedChoice;
    private string customModelName = string.Empty;
    private string? previousProviderFingerprint;
    private string? previousValue;
    private bool hasSyncedParameters;
    private bool suppressNextParameterSync;
    private bool isOverrideEnabled;

    [Parameter]
    public ConversationProviderOption? Provider { get; set; }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<string?> Change { get; set; }

    [Parameter]
    public bool UseEmptyValueForProviderDefault { get; set; } = true;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string Label { get; set; } = "Model";

    [Parameter]
    public string CustomModelPlaceholder { get; set; } = "Enter model name";

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter]
    public string? ChoiceTestId { get; set; }

    [Parameter]
    public string? OverrideTestId { get; set; }

    [Parameter]
    public string? CustomModelTestId { get; set; }

    protected override void OnParametersSet()
    {
        RebuildModelChoices();

        var providerFingerprint = ResolveProviderFingerprint();
        var currentValue = NormalizeModel(Value);
        var providerChanged = !string.Equals(previousProviderFingerprint, providerFingerprint, StringComparison.Ordinal);
        var valueChangedExternally = !suppressNextParameterSync &&
                                     !string.Equals(previousValue, currentValue, StringComparison.Ordinal);

        if (!hasSyncedParameters || providerChanged || valueChangedExternally)
        {
            ApplyExternalValue(currentValue);
        }

        previousProviderFingerprint = providerFingerprint;
        previousValue = currentValue;
        hasSyncedParameters = true;
        suppressNextParameterSync = false;
    }

    public static string NormalizeProviderDefaultModel(string? value)
        => NormalizeModel(value);

    private void RebuildModelChoices()
    {
        var providerDefault = ResolveProviderDefaultModel();
        var defaultLabel = string.IsNullOrWhiteSpace(providerDefault)
            ? "Provider default"
            : $"Provider default ({providerDefault})";

        modelChoices.Clear();
        modelChoices.Add(new ProviderModelSelectorOption(
            ProviderModelChoiceKind.ProviderDefault,
            string.Empty,
            defaultLabel));

        foreach (var option in ResolveModelOptions())
        {
            if (!string.IsNullOrWhiteSpace(providerDefault) &&
                string.Equals(option, providerDefault, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            modelChoices.Add(new ProviderModelSelectorOption(
                ProviderModelChoiceKind.SuggestedModel,
                option,
                option));
        }
    }

    private IReadOnlyList<string> ResolveModelOptions()
    {
        return Provider?.SuggestedModels
            .Where(model => !string.IsNullOrWhiteSpace(model))
            .Select(model => model.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList() ?? [];
    }

    private void ApplyExternalValue(string currentValue)
    {
        if (TryResolveKnownChoice(currentValue, out var choice))
        {
            selectedChoice = choice;
            isOverrideEnabled = false;
            customModelName = string.IsNullOrWhiteSpace(currentValue)
                ? ResolveProviderDefaultModel()
                : currentValue;
            return;
        }

        selectedChoice = modelChoices[0];
        isOverrideEnabled = true;
        customModelName = currentValue;
    }

    private bool TryResolveKnownChoice(
        string currentValue,
        out ProviderModelSelectorOption choice)
    {
        if (string.IsNullOrWhiteSpace(currentValue) ||
            !UseEmptyValueForProviderDefault && IsProviderDefaultModel(currentValue))
        {
            choice = modelChoices[0];
            return true;
        }

        var modelChoice = modelChoices.FirstOrDefault(option =>
            option.Kind == ProviderModelChoiceKind.SuggestedModel &&
            string.Equals(option.Model, currentValue, StringComparison.OrdinalIgnoreCase));
        if (modelChoice is not null)
        {
            choice = modelChoice;
            return true;
        }

        choice = modelChoices[0];
        return false;
    }

    private bool IsProviderDefaultModel(string value)
    {
        var providerDefault = ResolveProviderDefaultModel();
        return !string.IsNullOrWhiteSpace(providerDefault) &&
               string.Equals(value.Trim(), providerDefault, StringComparison.OrdinalIgnoreCase);
    }

    private async Task HandleChoiceChangedAsync(ProviderModelSelectorOption? choice)
    {
        selectedChoice = choice ?? modelChoices[0];
        isOverrideEnabled = false;
        var nextValue = selectedChoice.Kind == ProviderModelChoiceKind.ProviderDefault
            ? ResolveProviderDefaultEmittedValue()
            : selectedChoice.Model;
        customModelName = string.IsNullOrWhiteSpace(nextValue)
            ? ResolveProviderDefaultModel()
            : nextValue;

        await EmitValueAsync(nextValue);
    }

    private async Task HandleOverrideChangedAsync(bool value)
    {
        isOverrideEnabled = value;
        if (isOverrideEnabled)
        {
            if (string.IsNullOrWhiteSpace(customModelName))
            {
                customModelName = ResolveSelectedModelName();
            }

            await EmitValueAsync(customModelName);
            return;
        }

        selectedChoice = modelChoices[0];
        var nextValue = ResolveProviderDefaultEmittedValue();
        customModelName = ResolveProviderDefaultModel();
        await EmitValueAsync(nextValue);
    }

    private async Task HandleCustomModelChangedAsync(string? value)
    {
        customModelName = NormalizeModel(value);
        await EmitValueAsync(customModelName);
    }

    private async Task EmitValueAsync(string? value)
    {
        var normalizedValue = NormalizeModel(value);
        suppressNextParameterSync = true;
        previousValue = normalizedValue;
        await ValueChanged.InvokeAsync(normalizedValue);
        await Change.InvokeAsync(normalizedValue);
    }

    private string ResolveSelectedModelName()
    {
        return selectedChoice is { Kind: ProviderModelChoiceKind.SuggestedModel }
            ? selectedChoice.Model
            : ResolveProviderDefaultModel();
    }

    private string ResolveProviderDefaultEmittedValue()
        => UseEmptyValueForProviderDefault ? string.Empty : ResolveProviderDefaultModel();

    private string ResolveProviderDefaultModel()
        => NormalizeModel(Provider?.DefaultModel);

    private string ResolveProviderFingerprint()
    {
        var modelOptions = string.Join('\u001f', ResolveModelOptions());
        return string.Join(
            "|",
            Provider?.Key.Value ?? string.Empty,
            Provider?.Name ?? string.Empty,
            ResolveProviderDefaultModel(),
            modelOptions);
    }

    private static string NormalizeModel(string? value)
        => string.IsNullOrWhiteSpace(value) ? string.Empty : value.Trim();

    private enum ProviderModelChoiceKind
    {
        ProviderDefault,
        SuggestedModel
    }

    private sealed record ProviderModelSelectorOption(
        ProviderModelChoiceKind Kind,
        string Model,
        string Text);
}

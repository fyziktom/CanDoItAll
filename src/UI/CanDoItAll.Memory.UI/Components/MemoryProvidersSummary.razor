@namespace CanDoItAll.Modules.Memory.Components

<Cluster Gap="LayoutGap.Small"
         Wrap="FlexWrap.Wrap"
         Class="memory-ui-summary"
         data-testid="memory-ui-summary">
    <SummaryTile Label="Providers"
                 Value="@Format(Snapshot?.ProviderCount)"
                 HelperText="Registered generic memory provider profiles."
                 Tone="info"
                 Badge="true"
                 Compact="true"
                 ShowHelperTextAsTooltip="true" />
    <SummaryTile Label="Enabled"
                 Value="@Format(Snapshot?.EnabledProviderCount)"
                 HelperText="Provider profiles enabled for selection."
                 Tone="success"
                 Badge="true"
                 Compact="true"
                 ShowHelperTextAsTooltip="true" />
    <SummaryTile Label="Healthy"
                 Value="@Format(Snapshot?.HealthyProviderCount)"
                 HelperText="Provider profiles reporting healthy status."
                 Tone="@(Snapshot?.HealthyProviderCount > 0 ? "success" : "secondary")"
                 Badge="true"
                 Compact="true"
                 ShowHelperTextAsTooltip="true" />
    <SummaryTile Label="Provider UI"
                 Value="@Format(Snapshot?.UiSurfaceCount)"
                 HelperText="Optional provider-specific UI surfaces declared by provider manifests."
                 Tone="secondary"
                 Badge="true"
                 Compact="true"
                 ShowHelperTextAsTooltip="true" />
</Cluster>

@code {
    [Parameter]
    public MemoryProviderManagementSnapshot? Snapshot { get; set; }

    private static string Format(int? value) => value?.ToString() ?? "-";
}

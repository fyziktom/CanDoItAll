@namespace CanDoItAll.Modules.Memory.Components

<FormSection Title="Submit feedback" Description="Correlate an outcome with the delivered context pack.">
    <Grid Gap="LayoutGap.Large" ColumnTemplate="repeat(auto-fit,minmax(14rem,1fr))">
        <FormField Text="Outcome">
            <SelectInput TValue="MemoryFeedbackOutcome"
                      Value="@Editor.Outcome"
                      ValueChanged="@(value => Editor.Outcome = value)"
                      data-testid="memory-ui-feedback-outcome">
    @foreach (var option in Outcomes) {
        <option value="@option">@option</option>
    }
</SelectInput>
        </FormField>
        <FormField Text="Stage">
            <SelectInput TValue="MemoryFeedbackStage"
                      Value="@Editor.Stage"
                      ValueChanged="@(value => Editor.Stage = value)"
                      data-testid="memory-ui-feedback-stage">
    @foreach (var option in Stages) {
        <option value="@option">@option</option>
    }
</SelectInput>
        </FormField>
    </Grid>
    <FormField Text="Comment">
        <TextAreaInput Immediate="true" Value="@Editor.Comment"
                  ValueChanged="@(value => Editor.Comment = value)"
                  Rows="4"
                  data-testid="memory-ui-feedback-comment" />
    </FormField>
    <Button Text="Submit feedback"
            Icon="rate_review"
            Tone="ButtonTone.Primary"
            Size="ButtonSize.Small"
            Click="OnSubmit"
            Disabled="@(IsBusy || string.IsNullOrWhiteSpace(Editor.ContextPackId))"
            IsBusy="@IsBusy"
            data-testid="memory-ui-feedback-submit" />
</FormSection>

@code {
    private static readonly MemoryFeedbackOutcome[] Outcomes = Enum.GetValues<MemoryFeedbackOutcome>();
    private static readonly MemoryFeedbackStage[] Stages = Enum.GetValues<MemoryFeedbackStage>();

    [Parameter, EditorRequired]
    public MemoryFeedbackEditorModel Editor { get; set; } = new();

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public EventCallback OnSubmit { get; set; }
}

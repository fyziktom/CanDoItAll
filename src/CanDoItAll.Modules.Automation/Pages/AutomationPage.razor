@page "/automation"
@* codex-capsule
kind: page
name: AutomationPage
summary: Displays background job history and operational status for asynchronous work.
owns: background-job-list
deps: AutomationWorkspaceService
risks: hidden-job-failure, stale-status
tests: component:AutomationPageTests, e2e:automation-smoke
*@
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Infrastructure.BackgroundJobs
@inject AutomationWorkspaceService AutomationWorkspaceService

<PageTitle>Automation</PageTitle>

<PageScaffold>
    <Header>
        <PageHeader Eyebrow="Automation"
                    Title="Background jobs and operational work"
                    Description="Inspect queued, running, and completed jobs so long-running work stays visible instead of disappearing behind buttons." />
    </Header>

    <ChildContent>
        <SummaryTiles>
            <SummaryTile Label="Jobs" Value="@jobs.Count.ToString()" HelperText="Tracked asynchronous tasks in the workspace." />
            <SummaryTile Label="Running" Value="@jobs.Count(job => job.State == BackgroundJobState.Running).ToString()" HelperText="Work currently in progress." Tone="info" />
            <SummaryTile Label="Failed" Value="@jobs.Count(job => job.State == BackgroundJobState.Failed).ToString()" HelperText="Operational issues that need attention." Tone="warning" />
            <SummaryTile Label="Succeeded" Value="@jobs.Count(job => job.State == BackgroundJobState.Succeeded).ToString()" HelperText="Completed jobs with no action required." Tone="success" />
        </SummaryTiles>

        <SectionCard Title="Background jobs" Description="The tracker records prompt sends, exports, and other operational tasks with correlation ids and outcomes.">
            <FilterBar ResultText="@($"{FilteredJobs.Count} job(s)")">
                <InputSelect @bind-Value="stateFilter" class="cda-input">
                    <option value="">All states</option>
                    @foreach (var state in Enum.GetValues<BackgroundJobState>())
                    {
                        <option value="@state.ToString()">@state</option>
                    }
                </InputSelect>
                <InputSelect @bind-Value="jobTypeFilter" class="cda-input">
                    <option value="">All job types</option>
                    @foreach (var jobType in jobs.Select(job => job.JobType).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(item => item))
                    {
                        <option value="@jobType">@jobType</option>
                    }
                </InputSelect>
                <Button ButtonStyle="ButtonStyle.Light" Text="Reset" Size="ButtonSize.Small" Click="ResetFilters" />
            </FilterBar>

            @if (FilteredJobs.Count == 0)
            {
                <div class="mt-4">
                    <EmptyState Eyebrow="No jobs"
                                Title="No background jobs match the current view"
                                Description="Clear the filters or wait for new automation work to be recorded." />
                </div>
            }
            else
            {
                <div class="mt-4 cda-stack-3">
                    @foreach (var job in FilteredJobs)
                    {
                        <div class="cda-panel-card--soft">
                            <div class="flex flex-wrap items-start justify-between gap-3">
                                <div>
                                    <p class="text-sm font-semibold text-slate-900">@job.Description</p>
                                    <p class="mt-1 text-xs text-slate-500">@job.JobType / @job.CorrelationId</p>
                                </div>
                                <StatusBadge Tone="@ResolveTone(job.State)" Text="@job.State.ToString()" />
                            </div>
                            @if (!string.IsNullOrWhiteSpace(job.ErrorSummary))
                            {
                                <p class="mt-3 text-sm leading-6 text-rose-700">@job.ErrorSummary</p>
                            }
                            <p class="mt-3 text-xs text-slate-500">Created @job.CreatedAtUtc.LocalDateTime:g / Updated @job.UpdatedAtUtc.LocalDateTime:g</p>
                        </div>
                    }
                </div>
            }
        </SectionCard>
    </ChildContent>
</PageScaffold>

@code {
    private IReadOnlyList<BackgroundJobSummary> jobs = [];
    private string stateFilter = string.Empty;
    private string jobTypeFilter = string.Empty;

    private IReadOnlyList<BackgroundJobSummary> FilteredJobs => jobs
        .Where(job =>
            (string.IsNullOrWhiteSpace(stateFilter) || string.Equals(job.State.ToString(), stateFilter, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(jobTypeFilter) || string.Equals(job.JobType, jobTypeFilter, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(job => job.UpdatedAtUtc)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        jobs = await AutomationWorkspaceService.ListJobsAsync();
    }

    private void ResetFilters()
    {
        stateFilter = string.Empty;
        jobTypeFilter = string.Empty;
    }

    private static string ResolveTone(BackgroundJobState state) => state switch
    {
        BackgroundJobState.Succeeded => "success",
        BackgroundJobState.Running => "info",
        BackgroundJobState.Failed => "danger",
        BackgroundJobState.Cancelled => "warning",
        _ => "neutral"
    };
}



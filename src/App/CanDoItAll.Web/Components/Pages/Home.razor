@page "/"
@page "/dashboard"
@implements IAsyncDisposable
@using CanDoItAll.Web.Dashboard
@using CanDoItAll.Application.UI.Dashboard

<PageTitle>Dashboard</PageTitle>
<DashboardSurface View="@Presentation" Refresh="RefreshAsync" ActivityChanged="SelectActivity" />

@code {
    private static readonly TimeSpan MaximumCountdownUpdateInterval = TimeSpan.FromMinutes(1);

    private readonly CancellationTokenSource lifetimeCancellation = new();
    private DashboardSnapshotRead? snapshotRead;
    private DateTimeOffset? nextAutomaticRefreshAtUtc;
    private Task? automaticRefreshTask;
    private string? loadErrorMessage;
    private bool isInitialLoading = true;
    private bool isRefreshing;
    private bool isDisposed;
    private DashboardActivityTab selectedActivity;

    [Inject]
    private DashboardSnapshotService DashboardSnapshots { get; set; } = null!;

    [Inject]
    private TimeProvider TimeProvider { get; set; } = null!;

    [Inject]
    private ILogger<Home> Logger { get; set; } = null!;

    private DashboardSnapshotData? SnapshotData => snapshotRead?.Snapshot.Data;

    private DashboardPresentation Presentation => new(snapshotRead, TimeProvider.GetUtcNow(),
        nextAutomaticRefreshAtUtc, loadErrorMessage, isInitialLoading, isRefreshing, selectedActivity);

    private void SelectActivity(DashboardActivityTab activity) => selectedActivity = activity;

    protected override async Task OnInitializedAsync() {
        await LoadSnapshotAsync(
            DashboardSnapshotRefreshMode.UseCached,
            lifetimeCancellation.Token);

        if (!isDisposed) {
            automaticRefreshTask = RunAutomaticRefreshLoopAsync(lifetimeCancellation.Token);
        }
    }

    private Task RefreshAsync() {
        return isDisposed
            ? Task.CompletedTask
            : LoadSnapshotAsync(
                DashboardSnapshotRefreshMode.Force,
                lifetimeCancellation.Token);
    }

    private async Task LoadSnapshotAsync(
        DashboardSnapshotRefreshMode refreshMode,
        CancellationToken cancellationToken) {
        if (isRefreshing) {
            return;
        }

        isRefreshing = true;
        if (SnapshotData is null) {
            isInitialLoading = true;
        }

        try {
            var read = await DashboardSnapshots.GetAsync(refreshMode, cancellationToken);
            if (isDisposed || cancellationToken.IsCancellationRequested) {
                return;
            }
            snapshotRead = read;
            nextAutomaticRefreshAtUtc = read.NextAutomaticRefreshAtUtc;
            loadErrorMessage = null;
        } catch (DashboardSnapshotUnavailableException exception) {
            nextAutomaticRefreshAtUtc = exception.NextAutomaticRefreshAtUtc;
            loadErrorMessage = "No successful dashboard snapshot is available yet. Retry now or wait for the scheduled automatic retry.";
            Logger.LogWarning(
                exception,
                "Dashboard snapshot is unavailable after {RefreshMode}. Automatic retry is scheduled for {NextAutomaticRefreshAtUtc}.",
                refreshMode,
                exception.NextAutomaticRefreshAtUtc);
        } catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) {
        } catch (Exception exception) {
            loadErrorMessage = SnapshotData is null
                ? "Dashboard data could not be loaded. Retry when the active database profile is available."
                : "The latest refresh failed. The last successful snapshot remains visible.";
            Logger.LogError(
                exception,
                "Dashboard snapshot {RefreshMode} failed. Existing snapshot available: {HasSnapshot}.",
                refreshMode,
                SnapshotData is not null);
        } finally {
            isRefreshing = false;
            isInitialLoading = false;
        }
    }

    private async Task RunAutomaticRefreshLoopAsync(CancellationToken cancellationToken) {
        try {
            while (!cancellationToken.IsCancellationRequested) {
                var delay = ResolveNextWakeDelay();
                await Task.Delay(delay, TimeProvider, cancellationToken);

                await InvokeAsync(async () => {
                    if (IsAutomaticRefreshDue() && !isRefreshing) {
                        await LoadSnapshotAsync(
                            DashboardSnapshotRefreshMode.UseCached,
                            cancellationToken);
                    }

                    StateHasChanged();
                });
            }
        } catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) {
        } catch (Exception exception) {
            Logger.LogError(
                exception,
                "Dashboard automatic refresh loop stopped unexpectedly.");
        }
    }

    private TimeSpan ResolveNextWakeDelay() {
        if (isRefreshing) {
            return MaximumCountdownUpdateInterval;
        }

        if (!nextAutomaticRefreshAtUtc.HasValue) {
            return Timeout.InfiniteTimeSpan;
        }

        var remaining = nextAutomaticRefreshAtUtc.Value - TimeProvider.GetUtcNow();
        if (remaining <= TimeSpan.Zero) {
            return MaximumCountdownUpdateInterval;
        }

        return remaining < MaximumCountdownUpdateInterval
            ? remaining
            : MaximumCountdownUpdateInterval;
    }

    private bool IsAutomaticRefreshDue() {
        return nextAutomaticRefreshAtUtc.HasValue &&
            TimeProvider.GetUtcNow() >= nextAutomaticRefreshAtUtc.Value;
    }

    public async ValueTask DisposeAsync() {
        if (isDisposed) {
            return;
        }

        isDisposed = true;
        await lifetimeCancellation.CancelAsync();
        if (automaticRefreshTask is not null) {
            try {
                await automaticRefreshTask;
            } catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested) {
            }
        }

        lifetimeCancellation.Dispose();
    }
}

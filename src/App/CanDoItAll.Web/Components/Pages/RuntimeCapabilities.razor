@page "/settings/runtime-capabilities"
@using CanDoItAll.Composition
@using CanDoItAll.Application.UI.Runtime
@using CanDoItAll.Web.RuntimeCapabilities
@inject IHostCapabilitySnapshotProvider SnapshotProvider

<PageTitle>Runtime capabilities</PageTitle>
<RuntimeCapabilitiesSurface View="@Presentation" Refresh="Refresh" />

@code {
    private RuntimeCapabilitiesPresentation Presentation { get; set; } = null!;

    protected override void OnInitialized() => Refresh();

    private void Refresh() => Presentation = RuntimeCapabilitiesPresentationMapper.Map(SnapshotProvider.GetSnapshot());
}

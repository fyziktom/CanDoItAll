@using CanDoItAll.Application.UI.Profiles
@using CanDoItAll.Application.UI.Shell
@inherits LayoutComponentBase
@implements IDisposable
@using CanDoItAll.AppComponents
@using CanDoItAll.AgentFramework.Core
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using CanDoItAll.Infrastructure.ControlPlane
@using CanDoItAll.Infrastructure.Persistence
@using CanDoItAll.Conversations.Shell
@using CanDoItAll.Modules.Collaboration
@using CanDoItAll.Modules.AgentFramework.Pages.Components
@using CanDoItAll.Modules.Projects
@using CanDoItAll.Modules.Workbench
@using CanDoItAll.Modules.Workbench.Components
@using CanDoItAll.Modules.Workspace
@using CanDoItAll.SharedKernel
@using CanDoItAll.Web.Composition
@inject NavigationManager Navigation
@inject WorkbenchStateService Workbench
@inject IDatabaseSwitchNotificationService DatabaseSwitchNotificationService
@inject CollaborationService CollaborationService
@inject DatabaseProfileWorkspaceService DatabaseProfileWorkspaceService
@inject ProjectsService ProjectsService
@inject IConversationShellLauncher ConversationShellLauncher
@inject IJSRuntime JS

<AppShell NavigationItems="@NavigationItems"
          Mode="ShellMode"
          ShowRightRail="false"
          ShowTabSummary="@(ShellMode == AppShellMode.FocusWorkbench)"
          Workspaces="workspaces"
          ActiveWorkspaceId="@activeWorkspaceId"
          CurrentRoute="@CurrentRouteBase"
          Tabs="Workbench.Tabs"
          RecentTabs="Workbench.RecentTabs"
          OpenedProjects="OpenedProjectTabs"
          OpenedSessions="OpenedPromptTabs"
          ActiveTabId="@Workbench.ActiveTabId"
          ProjectContextTitle="@ActiveProjectTitle"
          PhaseContextTitle="@ActivePhaseTitle"
          SelectWorkspace="HandleSelectWorkspaceAsync"
          Navigate="HandleNavigateAsync"
          OpenWorkbenchItem="HandleOpenWorkbenchItemAsync"
          SelectTab="HandleSelectTabAsync"
          CloseTab="HandleCloseTabAsync"
          MoveLeft="HandleMoveLeftAsync"
          MoveRight="HandleMoveRightAsync"
          ToggleTabPin="HandleTogglePinAsync"
          ToggleTabSleep="HandleToggleSleepAsync"
          CloseOtherTabs="HandleCloseOthersAsync"
          CloseTabsToRight="HandleCloseRightAsync"
          CloseBackgroundTabs="HandleCloseBackgroundAsync"
          ReopenRecentTab="HandleReopenRecentAsync"
          ClearRecentTabs="HandleClearRecentTabsAsync">
    <BottomUtilities>
        <ShellUtilitiesSurface View="@UtilitiesPresentation"
                               OpenConversations="OpenFloatingConversations"
                               OpenSettings="OpenSettingsFromShellAsync"
                               OpenRuntimeCapabilities="OpenRuntimeCapabilitiesFromShellAsync"
                               OpenDatabaseDialog="OpenDatabaseDialogAsync"
                               ActivateProfile="SwitchDatabaseProfileFromFlyoutAsync" />
    </BottomUtilities>
    <TopBar>
        @if (layoutInitializationFailed) {
            <Alert AlertStyle="AlertStyle.Warning" Variant="Variant.Outlined" data-testid="layout-initialization-failure">
                <Stack GapScale="LayoutGap.Small">
                    <TextBlock Value="Workspace browser state could not be restored or saved. Retry when browser storage is available." />
                    <Button Text="Retry workspace" Icon="refresh" Click="RetryLayoutInitializationAsync"
                            Disabled="layoutInitializationBusy" data-testid="layout-initialization-retry" />
                </Stack>
            </Alert>
        }
        <ShellStatusBar DatabaseSwitchAlert="@databaseSwitchAlert"
                          ActiveWorkspaceTitle="@ActiveWorkspaceTitle"
                          ActiveNavigationTitle="@ActiveNavigation.Title"
                          ShellMode="@ShellMode"
                          ActiveProjectTitle="@ActiveProjectTitle"
                          CurrentRouteDisplay="@CurrentRouteDisplay"
                          ActivePhaseTitle="@ActivePhaseTitle"
                          OpenedItemCount="@(OpenedProjectTabs.Count + OpenedPromptTabs.Count)"
                          TabCount="@Workbench.Tabs.Count" />
    </TopBar>
    <Body>
        <Notification Position="NotificationPosition.BottomCenter" />
        @if (databaseDialogStartupMode && databaseDialogOpen) {
            <EmptyState Eyebrow="Database startup"
                        Title="Continue with the active database to load the workspace"
                        Description="The routed page stays paused until the startup database profile is confirmed, so module dashboards do not initialize against a false zero-state." />
        } else {
            @Body
        }
    </Body>
</AppShell>

<WorkspaceAgentChatContextProvider />
<ConversationShellHost />
<DialogHost />
<Tooltip />

<DatabaseProfileDialogSurface View="@DatabaseDialogPresentation"
                              SelectDatabaseProfile="SelectDatabaseProfileAsync"
                              ContinueWithCurrentDatabase="CloseDatabaseDialogAsync"
                              CloseDatabaseDialog="CloseDatabaseDialogAsync"
                              OpenDatabaseSettings="OpenDatabaseSettingsAsync"
                              SwitchDatabaseProfile="SwitchDatabaseProfileAsync" />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss" aria-label="Dismiss">
        <Icon Name="close" />
    </span>
</div>

@code {
    private void OpenFloatingConversations()
        => ConversationShellLauncher.ShowCatalog();
}

@inherits LayoutComponentBase
@implements IDisposable
@using CanDoItAll.AppComponents
@using CanDoItAll.AgentFramework.Core
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using CanDoItAll.Infrastructure.ControlPlane
@using CanDoItAll.Infrastructure.Persistence
@using CanDoItAll.Conversations.Shell
@using CanDoItAll.Modules.Collaboration
@using CanDoItAll.Modules.AgentFramework.Pages.Components
@using CanDoItAll.Modules.Projects
@using CanDoItAll.Modules.Workbench
@using CanDoItAll.Modules.Workbench.Components
@using CanDoItAll.Modules.Workspace
@using CanDoItAll.SharedKernel
@using CanDoItAll.Web.Composition
@inject NavigationManager Navigation
@inject WorkbenchStateService Workbench
@inject IDatabaseSwitchNotificationService DatabaseSwitchNotificationService
@inject CollaborationService CollaborationService
@inject DatabaseProfileWorkspaceService DatabaseProfileWorkspaceService
@inject ProjectsService ProjectsService
@inject IConversationShellLauncher ConversationShellLauncher
@inject IJSRuntime JS
@inject AppThemeState ThemeState
@inject AppToolbarState ToolbarState

<AppShell NavigationItems="@NavigationItems"
          Mode="ShellMode"
          ShowRightRail="false"
          ShowTabSummary="@(ShellMode == AppShellMode.FocusWorkbench)"
          Workspaces="workspaces"
          ActiveWorkspaceId="@activeWorkspaceId"
          CurrentRoute="@CurrentRouteBase"
          Tabs="Workbench.Tabs"
          RecentTabs="Workbench.RecentTabs"
          OpenedProjects="OpenedProjectTabs"
          OpenedSessions="OpenedPromptTabs"
          ActiveTabId="@Workbench.ActiveTabId"
          ProjectContextTitle="@ActiveProjectTitle"
          PhaseContextTitle="@ActivePhaseTitle"
          SelectWorkspace="HandleSelectWorkspaceAsync"
          Navigate="HandleNavigateAsync"
          OpenWorkbenchItem="HandleOpenWorkbenchItemAsync"
          SelectTab="HandleSelectTabAsync"
          CloseTab="HandleCloseTabAsync"
          MoveLeft="HandleMoveLeftAsync"
          MoveRight="HandleMoveRightAsync"
          ToggleTabPin="HandleTogglePinAsync"
          ToggleTabSleep="HandleToggleSleepAsync"
          CloseOtherTabs="HandleCloseOthersAsync"
          CloseTabsToRight="HandleCloseRightAsync"
          CloseBackgroundTabs="HandleCloseBackgroundAsync"
          ReopenRecentTab="HandleReopenRecentAsync"
          ClearRecentTabs="HandleClearRecentTabsAsync">
    <BottomUtilities>
        <div class="app-shell-utility-stack">
            <TooltipTarget Position="TooltipPosition.Right"
                           Delay="@ShellMenuTooltipDelay"
                           TriggerClass="w-full"
                           Text="Open floating conversations"
                           TestId="shell-agent-chats-tooltip">
                <ChildContent>
                    <button type="button"
                            class="app-shell-utility-button"
                            data-testid="shell-agent-chats-action"
                            @onclick="OpenFloatingConversations">
                        <span class="app-shell-utility-icon" aria-hidden="true"><Icon Name="smart_toy" /></span>
                        <span class="app-shell-utility-label">Chats</span>
                    </button>
                </ChildContent>
            </TooltipTarget>

            <TooltipTarget Position="TooltipPosition.Right"
                           Delay="@ShellMenuTooltipDelay"
                           TriggerClass="w-full"
                           Text="Open workspace settings"
                           TestId="shell-settings-tooltip">
                <ChildContent>
                    <button type="button"
                            class="app-shell-utility-button"
                            data-testid="shell-settings-action"
                            @onclick="OpenSettingsFromShellAsync">
                        <span class="app-shell-utility-icon" aria-hidden="true"><Icon Name="settings" /></span>
                        <span class="app-shell-utility-label">Settings</span>
                    </button>
                </ChildContent>
            </TooltipTarget>

            <TooltipTarget Position="TooltipPosition.Right"
                           Delay="@ShellMenuTooltipDelay"
                           TriggerClass="w-full"
                           Text="Inspect runtime capabilities and readiness"
                           TestId="shell-runtime-capabilities-tooltip">
                <ChildContent>
                    <button type="button"
                            class="app-shell-utility-button"
                            data-testid="shell-runtime-capabilities-action"
                            @onclick="OpenRuntimeCapabilitiesFromShellAsync">
                        <span class="app-shell-utility-icon" aria-hidden="true"><Icon Name="health_and_safety" /></span>
                        <span class="app-shell-utility-label">Runtime capabilities</span>
                    </button>
                </ChildContent>
            </TooltipTarget>

            @{
                var safeDatabaseDetails = BuildSafeDatabaseDetails(databaseSelection, currentDatabaseEditor);
                var recentDatabaseProfiles = RecentDatabaseProfiles;
            }
            <div class="app-shell-db-flyout-anchor"
                 data-testid="database-shell-flyout-anchor">
                <button type="button"
                        class="app-shell-utility-button app-shell-utility-button--database"
                        disabled="@databaseDialogBusy"
                        aria-haspopup="dialog"
                        data-testid="database-shell-action"
                        @onclick="OpenDatabaseDialogAsync">
                    <span class="app-shell-utility-icon" aria-hidden="true"><Icon Name="database" /></span>
                    <span class="app-shell-utility-label">Switch Database</span>
                </button>

                <section class="app-shell-db-flyout"
                         aria-label="Switch database"
                         data-testid="database-shell-flyout">
                    <span class="app-shell-db-flyout__arrow" aria-hidden="true"></span>
                    <Stack GapScale="LayoutGap.Medium"
                           Class="app-shell-db-flyout-card"
                           data-testid="database-shell-flyout-card">
                        <Cluster Gap="LayoutGap.Small"
                                 Wrap="FlexWrap.NoWrap"
                                 AlignItems="AlignItems.Center">
                            <span class="app-shell-db-flyout__icon" aria-hidden="true"><Icon Name="database" /></span>
                            <h2 class="app-shell-db-flyout__heading">Switch Database</h2>
                        </Cluster>

                        <Stack GapScale="LayoutGap.Small"
                               Class="app-shell-db-flyout__section">
                            <p class="app-shell-db-flyout__section-title">Current Database</p>
                            <Cluster Gap="LayoutGap.Small"
                                     Wrap="FlexWrap.NoWrap"
                                     AlignItems="AlignItems.Center"
                                     Class="w-full">
                                <span class="app-shell-db-flyout__status-dot" aria-hidden="true"></span>
                                <span class="app-shell-db-flyout__current-name">@(databaseSelection?.DisplayName ?? "Loading runtime profile")</span>
                                <StatusBadge Tone="success" Text="Active" />
                            </Cluster>

                            <div class="app-shell-db-flyout__facts">
                                <div class="app-shell-db-flyout__fact">
                                    <span>Server</span>
                                    <strong>@safeDatabaseDetails.Server</strong>
                                    <CopyButton Value="@safeDatabaseDetails.Server"
                                                DisplayMode="CopyButtonDisplayMode.IconOnly"
                                                Size="CopyButtonSize.ExtraSmall"
                                                AriaLabel="Copy safe database server"
                                                data-testid="database-shell-copy-server" />
                                </div>
                                <div class="app-shell-db-flyout__fact">
                                    <span>Database</span>
                                    <strong>@safeDatabaseDetails.Database</strong>
                                    <CopyButton Value="@safeDatabaseDetails.Database"
                                                DisplayMode="CopyButtonDisplayMode.IconOnly"
                                                Size="CopyButtonSize.ExtraSmall"
                                                AriaLabel="Copy safe database name"
                                                data-testid="database-shell-copy-database" />
                                </div>
                                <div class="app-shell-db-flyout__fact">
                                    <span>User</span>
                                    <strong>@safeDatabaseDetails.User</strong>
                                    <CopyButton Value="@safeDatabaseDetails.User"
                                                DisplayMode="CopyButtonDisplayMode.IconOnly"
                                                Size="CopyButtonSize.ExtraSmall"
                                                AriaLabel="Copy safe database user"
                                                data-testid="database-shell-copy-user" />
                                </div>
                            </div>

                            <CopyButton Value="@BuildSafeDatabaseSummary(databaseSelection, currentDatabaseEditor)"
                                        Text="Copy safe summary"
                                        DisplayMode="CopyButtonDisplayMode.TextWithIcon"
                                        Size="CopyButtonSize.Small"
                                        Tone="ButtonTone.Info"
                                        Variant="Variant.Outlined"
                                        Class="app-shell-db-flyout__copy"
                                        AriaLabel="Copy safe database summary"
                                        data-testid="database-shell-copy-summary" />
                        </Stack>

                        <Stack GapScale="LayoutGap.Small"
                               Class="app-shell-db-flyout__section">
                            <p class="app-shell-db-flyout__section-title">Recent Databases</p>
                            @if (recentDatabaseProfiles.Count == 0)
                            {
                                <p class="app-shell-db-flyout__empty">No recent databases yet.</p>
                            }
                            else
                            {
                                <div class="app-shell-db-flyout__recent-list">
                                    @foreach (var profile in recentDatabaseProfiles)
                                    {
                                        <button type="button"
                                                class="app-shell-db-flyout__recent-button"
                                                disabled="@(databaseDialogBusy || !CanManageDatabases)"
                                                data-testid="@($"database-shell-recent-profile-{profile.Id:N}")"
                                                @onclick="@(() => SwitchDatabaseProfileFromFlyoutAsync(profile.Id))">
                                            <span>@profile.DisplayName</span>
                                            <Icon Name="chevron_right" />
                                        </button>
                                    }
                                </div>
                            }
                        </Stack>

                        <Button Text="Open database dialog..."
                                Tone="ButtonTone.Info"
                                Variant="Variant.Text"
                                Size="ButtonSize.Small"
                                Disabled="@databaseDialogBusy"
                                Class="app-shell-db-flyout__dialog-button"
                                Click="OpenDatabaseDialogAsync"
                                data-testid="database-shell-open-dialog" />
                    </Stack>
                </section>
            </div>
        </div>
    </BottomUtilities>
    <TopBar>
        <MainLayoutTopBar DatabaseSwitchAlert="@databaseSwitchAlert"
                          ActiveWorkspaceTitle="@ActiveWorkspaceTitle"
                          ActiveNavigationTitle="@ActiveNavigation.Title"
                          ShellMode="@ShellMode"
                          ActiveProjectTitle="@ActiveProjectTitle"
                          CurrentRouteDisplay="@CurrentRouteDisplay"
                          ActivePhaseTitle="@ActivePhaseTitle"
                          OpenedItemCount="@(OpenedProjectTabs.Count + OpenedPromptTabs.Count)"
                          TabCount="@Workbench.Tabs.Count" />
    </TopBar>
    <Body>
        <Notification Position="NotificationPosition.BottomCenter" />
        <AppToolbar PageText="@ActiveNavigation.Title" />
        @if (ToolbarState.StatsContent is not null && ToolbarState.StatsVisible)
        {
            <div class="app-stats-row">
                <CompactStatStrip>@ToolbarState.StatsContent</CompactStatStrip>
                <button type="button"
                        class="app-stats-row__close"
                        aria-label="Hide stats"
                        title="Hide stats"
                        @onclick:stopPropagation="true"
                        @onclick="@(() => ToolbarState.SetStatsVisibleAsync(false))">
                    <Icon Name="close" />
                </button>
            </div>
        }
        <div class="@(ShellMode == AppShellMode.StandardPage ? "app-page-content" : null)">
            @if (ToolbarState.HelpContent is not null)
            {
                <HelpCard Visible="@ToolbarState.HelpVisible"
                          VisibleChanged="@(value => ToolbarState.SetHelpVisibleAsync(value))"
                          Heading="@ToolbarState.HelpHeading"
                          Icon="help"
                          Class="help-card">
                    @ToolbarState.HelpContent
                </HelpCard>
            }
            @if (databaseDialogStartupMode && databaseDialogOpen)
            {
                <EmptyState Eyebrow="Database startup"
                            Title="Continue with the active database to load the workspace"
                            Description="The routed page stays paused until the startup database profile is confirmed, so module dashboards do not initialize against a false zero-state." />
            }
            else
            {
                <div class="app-page-body">
                    @Body
                </div>
            }
        </div>
    </Body>
</AppShell>

<WorkspaceAgentChatContextProvider />
<ConversationShellHost />
<DialogHost />
<Tooltip />

<MainLayoutDatabaseDialog IsOpen="@databaseDialogOpen"
                          IsStartupMode="@databaseDialogStartupMode"
                          DatabaseSelection="@databaseSelection"
                          DatabaseProfileMessage="@databaseProfileMessage"
                          DatabaseMessageClass="@ResolveDatabaseMessageClass()"
                          DatabaseProfiles="@databaseProfiles"
                          SelectedDatabaseProfileId="@selectedDatabaseProfileId"
                          DatabaseDialogBusy="@databaseDialogBusy"
                          CanManageDatabases="@CanManageDatabases"
                          SelectedDialogProfileIsActive="@SelectedDialogProfileIsActive"
                          SelectedDialogProfileIsPendingRestart="@SelectedDialogProfileIsPendingRestart"
                          CanSwitchSelectedProfile="@CanSwitchSelectedProfile"
                          DescribeDatabaseProvider="DescribeDatabaseProvider"
                          DescribeDatabaseSource="DescribeDatabaseSource"
                          DescribeResolutionSource="DescribeResolutionSource"
                          SelectDatabaseProfile="SelectDatabaseProfileAsync"
                          ContinueWithCurrentDatabase="ContinueWithCurrentDatabaseAsync"
                          CloseDatabaseDialog="CloseDatabaseDialogAsync"
                          OpenDatabaseSettings="OpenDatabaseSettingsAsync"
                          SwitchDatabaseProfile="SwitchDatabaseProfileAsync" />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss" aria-label="Dismiss">
        <Icon Name="close" />
    </span>
</div>

@code {
    private void OpenFloatingConversations()
        => ConversationShellLauncher.ShowCatalog();
}

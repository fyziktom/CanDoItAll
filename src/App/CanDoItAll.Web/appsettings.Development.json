{
  "DevelopmentManager": {
    "TuningModeEnabled": true,
    "ReviewBeforeSend": true,
    "ManagerBaseUrl": "http://127.0.0.1:6407"
  },
  "SecretVault": {
    "Provider": "DataProtectionFile",
    "AllowInsecureDevelopmentProviders": true
  },
  "DataProtection": {
    "KeyProtection": {
      "Provider": "UnprotectedDevelopment"
    }
  },
  "AgentFramework": {
    "ProcessMockAgents": {
      "Enabled": false
    }
  },
  "Database": {
    "Provider": "PostgreSql",
    "ConnectionString": "Host=127.0.0.1;Port=5432;Database=candoitall_development;Username=candoitall;Password=candoitall;Include Error Detail=true",
    "EnableEntityFrameworkConsoleLogging": false
  },
  "Workflows": {
    "ExampleSeed": {
      "Enabled": true,
      "SeedSampleWorkspaceFiles": true
    }
  },
  "Processes": {
    "Runtime": {
      "RequirePostgreSqlForAgentAutomation": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}

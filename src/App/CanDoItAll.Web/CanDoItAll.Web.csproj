  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\CanDoItAll.Composition\RuntimeDeploymentSupport.json"
             Link="runtime-support.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\Templates\**\*"
             Exclude="..\..\..\Templates\**\*.razor"
             Link="Templates\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\..\Templates\**\*.razor"
          Link="Templates\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>


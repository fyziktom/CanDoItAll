@namespace CanDoItAll.Modules.Workbench.Pages
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Modules.Workbench
@using CanDoItAll.SharedKernel

<Stack GapScale="LayoutGap.Large"
       Class="w-full">
    <PanelCard Class="w-full project-structure-support-card project-structure-support-card--outline"
               data-testid="project-structure-outline-panel">
        <Stack GapScale="LayoutGap.Small"
               Class="w-full">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Outline" />
            <TextBlock TextStyle="TextStyle.H5" Value="Project object index" Class="cw-panel-title" />
            <TreeView Items="@OutlineNodes"
                      AriaLabel="Project object index"
                      Class="w-full"
                      OnSelect="OnSelectNode"
                      OnToggle="HandleIgnoredToggleAsync"
                      OnContextMenu="HandleNodeContextMenuAsync" />
        </Stack>
    </PanelCard>

    <PanelCard Class="w-full project-structure-support-card project-structure-support-card--health">
        <Stack GapScale="LayoutGap.Small"
               Class="w-full">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Canvas coverage" />
            <TextBlock TextStyle="TextStyle.H5" Value="Graph health" Class="cw-panel-title" />
            <CompactStatStrip>
                <CompactStat Label="nodes" Value="@TotalNodes.ToString()" TooltipText="Total nodes on the project structure canvas." Tone="info" />
                <CompactStat Label="links" Value="@TotalLinks.ToString()" TooltipText="Total links on the project structure canvas." Tone="success" />
                <CompactStat Label="selected" Value="@SelectedCount.ToString()" TooltipText="Currently selected canvas nodes." />
            </CompactStatStrip>
            <TextBlock TextStyle="TextStyle.Note"
                       Value="Cross-links, grouped create menus, media uploads, and typed child creation remain intact on the shared canvas substrate."
                       Class="cw-panel-copy" />
        </Stack>
    </PanelCard>
</Stack>

@if (outlineContextMenu is not null)
{
    <button type="button"
            class="project-structure-outline-context-menu__scrim"
            aria-label="Close outline context menu"
            @onclick="CloseOutlineContextMenu" />
    <div class="project-structure-outline-context-menu"
         data-testid="project-structure-outline-context-menu"
         style="@BuildOutlineContextMenuStyle(outlineContextMenu)">
        <div class="project-structure-outline-context-menu__header">
            <span class="project-structure-outline-context-menu__eyebrow">Node actions</span>
            <strong class="project-structure-outline-context-menu__title">@outlineContextMenu.NodeTitle</strong>
        </div>
        <div class="project-structure-outline-context-menu__actions">
            @foreach (var action in outlineContextMenu.Actions)
            {
                <button type="button"
                        class="project-structure-outline-context-menu__action"
                        data-tone="@action.Tone"
                        data-testid="@($"project-structure-outline-context-action-{BuildActionTestId(action.ActionId)}")"
                        @onclick="@(() => ExecuteOutlineContextActionAsync(action.ActionId))">
                    <Icon Name="@action.Icon" />
                    <span>@action.Label</span>
                </button>
            }
        </div>
    </div>
}

@code {
    private sealed record OutlineContextMenuState(
        string NodeId,
        string NodeTitle,
        double ClientX,
        double ClientY,
        IReadOnlyList<ProjectStructureSupportPanelContextAction> Actions);

    [Parameter, EditorRequired]
    public IReadOnlyList<ProjectStructureNode> Nodes { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<string> SelectedNodeIds { get; set; } = [];

    [Parameter]
    public EventCallback<string> OnSelectNode { get; set; }

    [Parameter]
    public Func<ProjectStructureNode, IReadOnlyList<ProjectStructureSupportPanelContextAction>> ResolveContextActions { get; set; }
        = _ => [];

    [Parameter]
    public EventCallback<ProjectStructureSupportPanelContextActionRequest> OnExecuteNodeContextAction { get; set; }

    private int TotalNodes => Nodes.Count;

    private int TotalLinks { get; set; }

    private int SelectedCount => SelectedNodeIds.Count;

    private OutlineContextMenuState? outlineContextMenu;

    [Parameter]
    public int LinkCount
    {
        get => TotalLinks;
        set => TotalLinks = value;
    }

    private IReadOnlyList<TreeViewNode> OutlineNodes
        => Nodes
            .Select(node => new TreeViewNode
            {
                Id = node.Id,
                Text = node.Title,
                Icon = ResolveOutlineIcon(node),
                Tooltip = $"{ProjectStructureCanvasCatalog.ResolveNodeLabel(node)} - {node.Status}",
                IsSelected = SelectedNodeIds.Contains(node.Id, StringComparer.Ordinal),
                BadgeText = node.Status,
                DataTestId = BuildOutlineNodeTestId(node.Id)
            })
            .ToList();

    private Task HandleIgnoredToggleAsync(string _)
        => Task.CompletedTask;

    private async Task HandleNodeContextMenuAsync(TreeViewNodeContextMenuRequest request)
    {
        var node = Nodes.FirstOrDefault(candidate => string.Equals(candidate.Id, request.NodeId, StringComparison.Ordinal));
        if (node is null)
        {
            outlineContextMenu = null;
            return;
        }

        var actions = ResolveContextActions(node)
            .Where(action => !string.IsNullOrWhiteSpace(action.ActionId) && !string.IsNullOrWhiteSpace(action.Label))
            .ToList();
        if (actions.Count == 0)
        {
            outlineContextMenu = null;
            return;
        }

        outlineContextMenu = new OutlineContextMenuState(
            node.Id,
            node.Title,
            request.ClientX,
            request.ClientY,
            actions);
        await OnSelectNode.InvokeAsync(node.Id);
    }

    private void CloseOutlineContextMenu()
        => outlineContextMenu = null;

    private async Task ExecuteOutlineContextActionAsync(string actionId)
    {
        if (outlineContextMenu is null || string.IsNullOrWhiteSpace(actionId))
        {
            return;
        }

        var request = new ProjectStructureSupportPanelContextActionRequest(outlineContextMenu.NodeId, actionId);
        outlineContextMenu = null;
        await OnExecuteNodeContextAction.InvokeAsync(request);
    }

    private static string BuildOutlineContextMenuStyle(OutlineContextMenuState state)
        => $"left:min(max(0.75rem, {Math.Round(state.ClientX)}px), calc(100vw - 21rem));top:min(max(0.75rem, {Math.Round(state.ClientY)}px), calc(100vh - 24rem));max-height:min(24rem, calc(100vh - 1.5rem));";

    private static string BuildActionTestId(string actionId)
    {
        var sanitized = string.Concat(
            actionId
                .Trim()
                .ToLowerInvariant()
                .Select(character => char.IsLetterOrDigit(character) ? character : '-'));

        while (sanitized.Contains("--", StringComparison.Ordinal))
        {
            sanitized = sanitized.Replace("--", "-", StringComparison.Ordinal);
        }

        sanitized = sanitized.Trim('-');
        return string.IsNullOrWhiteSpace(sanitized) ? "action" : sanitized;
    }

    private static string ResolveOutlineIcon(ProjectStructureNode node)
    {
        return node.ObjectType switch
        {
            ProjectObjectType.ProjectRoot => "folder",
            ProjectObjectType.Phase => "phase",
            ProjectObjectType.Milestone => "date",
            ProjectObjectType.Decision => "choice",
            ProjectObjectType.ProjectBlock => "block",
            ProjectObjectType.Meeting => "meeting",
            ProjectObjectType.Recording => "recording",
            ProjectObjectType.Transcript => "transcript",
            ProjectObjectType.Participant => "people",
            ProjectObjectType.WorkItem => "task",
            ProjectObjectType.PromptFlow => "flow",
            ProjectObjectType.PromptSession => "session",
            ProjectObjectType.PromptStep => "step",
            ProjectObjectType.Repository => "repo",
            ProjectObjectType.File => ResolveFileIcon(node.ObjectSubtype),
            ProjectObjectType.ImageAsset => "image",
            ProjectObjectType.VideoAsset => "video",
            ProjectObjectType.Link => "link",
            ProjectObjectType.Connector => "plug",
            ProjectObjectType.Script => "draw",
            ProjectObjectType.Environment => "runtime",
            ProjectObjectType.Infrastructure => "infra",
            ProjectObjectType.ValidationRun => "qa",
            ProjectObjectType.TestPlan => "test",
            ProjectObjectType.TestEvidence => "evidence",
            ProjectObjectType.SecretReference => "shield",
            _ => "section"
        };
    }

    private static string ResolveFileIcon(string? objectSubtype)
    {
        return objectSubtype?.Trim().ToLowerInvariant() switch
        {
            "pdf" => "pdf",
            "excel" => "excel",
            "docx" => "docx",
            "markdown" => "markdown",
            "mermaid" => "mermaid",
            "screenshot" => "screenshot",
            "log" => "log",
            "json" => "json",
            "text" => "text",
            "archive" => "archive",
            "audio" => "audio",
            _ => "file"
        };
    }

    private static string BuildOutlineNodeTestId(string nodeId)
    {
        var buffer = new char[nodeId.Length];
        for (var index = 0; index < nodeId.Length; index++)
        {
            var character = nodeId[index];
            buffer[index] = char.IsLetterOrDigit(character)
                ? char.ToLowerInvariant(character)
                : '-';
        }

        return $"project-structure-outline-node-{new string(buffer)}";
    }
}

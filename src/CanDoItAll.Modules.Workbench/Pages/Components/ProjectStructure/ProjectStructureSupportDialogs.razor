@namespace CanDoItAll.Modules.Workbench.Pages
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using CanDoItAll.Components.Mermaid
@using CanDoItAll.Modules.Workspace

@if (SummaryDialog is not null)
{
    <ProjectStructureOverlayDialog AriaLabel="@($"{SummaryDialog.RootTitle} progress summary")"
                                   Kicker="Progress summary"
                                   Title="@SummaryDialog.RootTitle"
                                   Summary="Hierarchy, inline status editing, and exports are generated from the same summary source."
                                   DialogClass="project-structure-summary-dialog"
                                   Close="CloseSummary">
        <Actions>
            <Button Text="Export XLSX"
                    ButtonStyle="ButtonStyle.Info"
                    Click="ExportSummaryWorkbook" />
            <Button Text="Export Gantt"
                    ButtonStyle="ButtonStyle.Primary"
                    Click="ExportSummaryGantt" />
            <Button Text="Close"
                    Variant="Variant.Text"
                    ButtonStyle="ButtonStyle.Base"
                    Click="CloseSummary" />
        </Actions>
        <Body>
            <Stack GapScale="LayoutGap.Large">
                <Grid Columns="3"
                      Gap="LayoutGap.Small">
                    <MetricCard Label="Done" Value="@SummaryDialog.Summary.CompletedCount.ToString()" />
                    <MetricCard Label="Active" Value="@SummaryDialog.Summary.ActiveCount.ToString()" />
                    <MetricCard Label="Blocked" Value="@SummaryDialog.Summary.BlockedCount.ToString()" />
                    <MetricCard Label="Review" Value="@SummaryDialog.Summary.ReviewCount.ToString()" />
                    <MetricCard Label="Undated" Value="@SummaryDialog.Summary.UndatedCount.ToString()" />
                </Grid>

                <Stack GapScale="LayoutGap.Small"
                       Class="project-structure-summary-table">
                    @foreach (var row in SummaryDialog.Summary.Rows)
                    {
                        <Split Breakpoint="LayoutBreakpoint.Lg"
                               Gap="LayoutGap.Small"
                               AlignItems="AlignItems.Start"
                               JustifyContent="JustifyContent.SpaceBetween"
                               Wrap="FlexWrap.Wrap"
                               Class="project-structure-summary-row"
                               Style="@($"--summary-depth:{row.Depth};")">
                            <Stack GapScale="LayoutGap.Tiny"
                                   Class="project-structure-summary-row__node">
                                <TextBlock TextStyle="TextStyle.Subtitle2" Value="@row.Title" />
                                <TextBlock TextStyle="TextStyle.Caption" Value="@row.KindLabel" />
                            </Stack>

                            <Stack GapScale="LayoutGap.Tiny"
                                   Class="project-structure-summary-row__meta">
                                <TextBlock TextStyle="TextStyle.Caption" Value="@row.ProgressLabel" />
                                <TextBlock TextStyle="TextStyle.Caption" Value="@(row.StartUtc?.ToLocalTime().ToString("g") ?? "Undated")" />
                            </Stack>

                            <DropDown TValue="string"
                                      Data="@SummaryStatuses"
                                      Placeholder="Select status"
                                      Value="@row.Status"
                                      Change="@(value => ChangeSummaryStatus.InvokeAsync((row.NodeId, value?.ToString() ?? string.Empty)))"
                                      Class="project-structure-summary-row__select" />
                        </Split>
                    }
                </Stack>
            </Stack>
        </Body>
    </ProjectStructureOverlayDialog>
}

@if (PendingDeletePrompt is not null)
{
    <ProjectStructureOverlayDialog AriaLabel="@($"Delete {PendingDeletePrompt.Title}")"
                                   Kicker="Delete node"
                                   Title="@PendingDeletePrompt.Title"
                                   Summary="@PendingDeletePrompt.ImpactCopy"
                                   DialogClass="project-structure-summary-dialog"
                                   Close="CancelDelete">
        <Actions>
            <Button Text="Delete"
                    ButtonStyle="ButtonStyle.Danger"
                    Click="ConfirmDelete" />
            <Button Text="Cancel"
                    Variant="Variant.Text"
                    ButtonStyle="ButtonStyle.Base"
                    Click="CancelDelete" />
        </Actions>
    </ProjectStructureOverlayDialog>
}

@if (PendingTranscriptAction is not null)
{
    <ProjectStructureOverlayDialog AriaLabel="@($"{ResolveTranscriptActionLabel(PendingTranscriptAction.ActionKind)} confirmation")"
                                   Kicker="LLM confirmation"
                                   Title="@ResolveTranscriptActionLabel(PendingTranscriptAction.ActionKind)"
                                   Summary="This action will send transcript content to an external or local provider. Confirmation and explicit provider selection are required."
                                   DialogClass="project-structure-summary-dialog"
                                   Close="CancelTranscriptAction">
        <Actions>
            <Button Text="Send request"
                    ButtonStyle="ButtonStyle.Info"
                    Click="ExecuteTranscriptAction" />
            <Button Text="Cancel"
                    Variant="Variant.Text"
                    ButtonStyle="ButtonStyle.Base"
                    Click="CancelTranscriptAction" />
        </Actions>
        <Body>
            <Stack GapScale="LayoutGap.Medium">
                <FormField Text="Provider profile">
                    <select class="cw-context-toolbox__search"
                            value="@(PendingTranscriptAction.SelectedProviderId?.ToString() ?? string.Empty)"
                            @onchange="HandleTranscriptProviderChanged">
                        <option value="">Select a provider</option>
                        @foreach (var provider in PendingTranscriptAction.Providers)
                        {
                            <option value="@provider.Id">@($"{provider.Name} ({provider.LegacyProviderKind?.ToString() ?? provider.ConnectorDisplayName})")</option>
                        }
                    </select>
                </FormField>

                @if (!string.IsNullOrWhiteSpace(PendingTranscriptAction.LastProviderName))
                {
                    <PanelCard Class="project-structure-inline-feedback"
                               data-tone="accent">
                        Last provider: @PendingTranscriptAction.LastProviderName
                    </PanelCard>
                }

                @if (!string.IsNullOrWhiteSpace(PendingTranscriptAction.Error))
                {
                    <PanelCard Class="project-structure-inline-feedback"
                               data-tone="warn">
                        @PendingTranscriptAction.Error
                    </PanelCard>
                }
            </Stack>
        </Body>
    </ProjectStructureOverlayDialog>
}

@if (MermaidPreviewNode is not null)
{
    var diagramKind = ProjectObjectMetadataSerializer.DetectMermaidDiagramKind(MermaidPreviewNode.Notes);

    <ProjectStructureOverlayDialog AriaLabel="@($"{MermaidPreviewNode.Title} Mermaid viewer")"
                                   Kicker="Mermaid viewer"
                                   Title="@MermaidPreviewNode.Title"
                                   Summary="@($"Detected diagram type: {diagramKind}")"
                                   DialogClass="project-structure-summary-dialog project-structure-mermaid-dialog"
                                   Close="CloseMermaidViewer">
        <Actions>
            @if (CanEditMermaidNode(MermaidPreviewNode))
            {
                <Button Text="Edit"
                        ButtonStyle="ButtonStyle.Info"
                        Click="@(() => EditMermaidNode.InvokeAsync(MermaidPreviewNode))" />
            }
            <Button Text="Close"
                    Variant="Variant.Text"
                    ButtonStyle="ButtonStyle.Base"
                    Click="CloseMermaidViewer" />
        </Actions>
        <Body>
            <Stack GapScale="LayoutGap.Medium">
                <MermaidDiagram Title="@MermaidPreviewNode.Title"
                                Description="@($"Detected diagram type: {diagramKind}")"
                                Source="@MermaidPreviewNode.Notes"
                                Options="@MermaidViewerOptions"
                                PanZoomEnabled="true"
                                ShowControls="true"
                                Class="project-structure-mermaid-diagram"
                                Style="--cda-mermaid-min-height:28rem; --cda-mermaid-height:min(62dvh, 46rem);"
                                data-testid="project-structure-mermaid-diagram" />

                <details class="project-structure-mermaid-details">
                    <summary>Source</summary>
                    <pre class="pf-components-toolbox__preview-content project-structure-mermaid-source">@MermaidPreviewNode.Notes</pre>
                </details>
            </Stack>
        </Body>
    </ProjectStructureOverlayDialog>
}

@code {
    private static readonly MermaidDiagramOptions MermaidViewerOptions = new()
    {
        SecurityLevel = "loose",
        FlowchartUseMaxWidth = true,
        HtmlLabels = true,
        ArchitectureRandomize = false
    };

    [Parameter]
    public ProjectStructureSummaryDialogState? SummaryDialog { get; set; }

    [Parameter]
    public EventCallback CloseSummary { get; set; }

    [Parameter]
    public EventCallback ExportSummaryWorkbook { get; set; }

    [Parameter]
    public EventCallback ExportSummaryGantt { get; set; }

    [Parameter]
    public EventCallback<(string NodeId, string Status)> ChangeSummaryStatus { get; set; }

    [Parameter]
    public IReadOnlyList<string> SummaryStatuses { get; set; } = [];

    [Parameter]
    public ProjectStructureDeletePrompt? PendingDeletePrompt { get; set; }

    [Parameter]
    public EventCallback ConfirmDelete { get; set; }

    [Parameter]
    public EventCallback CancelDelete { get; set; }

    [Parameter]
    public ProjectStructureTranscriptActionDialogState? PendingTranscriptAction { get; set; }

    [Parameter]
    public EventCallback ExecuteTranscriptAction { get; set; }

    [Parameter]
    public EventCallback CancelTranscriptAction { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> HandleTranscriptProviderChanged { get; set; }

    [Parameter]
    public ProjectStructureNode? MermaidPreviewNode { get; set; }

    [Parameter]
    public EventCallback CloseMermaidViewer { get; set; }

    [Parameter]
    public EventCallback<ProjectStructureNode> EditMermaidNode { get; set; }

    [Parameter, EditorRequired]
    public Func<ProjectStructureNode, bool> CanEditMermaidNode { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<ProjectLlmActionKind, string> ResolveTranscriptActionLabel { get; set; } = default!;
}

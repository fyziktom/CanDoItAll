@namespace CanDoItAll.Modules.Workbench.Pages
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using CanDoItAll.SharedKernel

@if (ProjectHierarchyDialog is not null)
{
    var hierarchyDialog = ProjectHierarchyDialog;

    <ProjectStructureOverlayDialog CanvasScoped="true"
                                   AriaLabel="@hierarchyDialog.Title"
                                   Kicker="Project hierarchy"
                                   Title="@hierarchyDialog.Title"
                                   Summary="@hierarchyDialog.Copy"
                                   DataTestId="project-structure-hierarchy-dialog"
                                   Close="CloseProjectHierarchy">
        <Actions>
            <Button Text="Create new project"
                    Variant="Variant.Text"
                    ButtonStyle="ButtonStyle.Base"
                    data-testid="project-structure-hierarchy-create-project"
                    Click="OpenProjectCreateDialog" />
            <Button Text="Cancel"
                    Variant="Variant.Text"
                    ButtonStyle="ButtonStyle.Base"
                    Click="CloseProjectHierarchy" />
            <Button Text="@hierarchyDialog.SubmitLabel"
                    ButtonStyle="ButtonStyle.Info"
                    data-testid="project-structure-hierarchy-submit"
                    Disabled="@(hierarchyDialog.AvailableProjects.Count == 0)"
                    Click="ExecuteProjectHierarchyCommand" />
        </Actions>
        <Body>
            <Stack GapScale="LayoutGap.Medium">
                @if (!string.IsNullOrWhiteSpace(hierarchyDialog.CurrentParentProjectTitle))
                {
                    <PanelCard>
                        <Stack GapScale="LayoutGap.Tiny">
                            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Current parent" />
                            <TextBlock TextStyle="TextStyle.Note" Value="@hierarchyDialog.CurrentParentProjectTitle" Class="cw-panel-copy" />
                        </Stack>
                    </PanelCard>
                }

                <PanelCard>
                    <Stack GapScale="LayoutGap.Small">
                        <TextBlock TextStyle="TextStyle.Footer" Value="Project" Class="cw-panel-copy" />
                        <select class="cw-context-toolbox__search"
                                data-testid="project-structure-hierarchy-project-select"
                                value="@(hierarchyDialog.SelectedProjectId?.ToString() ?? string.Empty)"
                                @onchange="ProjectHierarchySelectionChanged">
                            <option value="">Select a project</option>
                            @foreach (var projectOption in hierarchyDialog.AvailableProjects)
                            {
                                <option value="@projectOption.Id">@projectOption.Name</option>
                            }
                        </select>
                    </Stack>
                </PanelCard>

                @if (!string.IsNullOrWhiteSpace(hierarchyDialog.Error))
                {
                    <PanelCard Class="project-structure-inline-feedback"
                               data-tone="warn">
                        @hierarchyDialog.Error
                    </PanelCard>
                }
            </Stack>
        </Body>
    </ProjectStructureOverlayDialog>
}

@if (BlockMutationDialog is not null)
{
    var blockDialog = BlockMutationDialog;
    var selectedOption = blockDialog.Options.FirstOrDefault(option => string.Equals(option.ActionId, blockDialog.SelectedActionId, StringComparison.OrdinalIgnoreCase));

    <ProjectStructureOverlayDialog CanvasScoped="true"
                                   AriaLabel="@blockDialog.Title"
                                   Kicker="Block mutation"
                                   Title="@blockDialog.Title"
                                   Summary="@blockDialog.Copy"
                                   DataTestId="project-structure-block-mutation-dialog"
                                   Close="CloseBlockMutation">
        <Actions>
            <Button Text="Cancel"
                    Variant="Variant.Text"
                    ButtonStyle="ButtonStyle.Base"
                    Click="CloseBlockMutation" />
            <Button Text="@blockDialog.SubmitLabel"
                    ButtonStyle="ButtonStyle.Info"
                    data-testid="project-structure-block-mutation-submit"
                    Click="ExecuteBlockMutation" />
        </Actions>
        <Body>
            <Stack GapScale="LayoutGap.Medium">
                <PanelCard>
                    <Stack GapScale="LayoutGap.Small">
                        <TextBlock TextStyle="TextStyle.Footer" Value="@blockDialog.SelectionLabel" Class="cw-panel-copy" />
                        <select class="cw-context-toolbox__search"
                                data-testid="project-structure-block-mutation-select"
                                value="@blockDialog.SelectedActionId"
                                @onchange="BlockMutationSelectionChanged">
                            @foreach (var option in blockDialog.Options)
                            {
                                <option value="@option.ActionId">@option.Label</option>
                            }
                        </select>
                    </Stack>
                </PanelCard>

                @if (selectedOption is not null)
                {
                    <PanelCard>
                        <Stack GapScale="LayoutGap.Tiny">
                            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Selected type" />
                            <TextBlock TextStyle="TextStyle.Subtitle2" Value="@selectedOption.Label" />
                            <TextBlock TextStyle="TextStyle.Note" Value="@selectedOption.Description" Class="cw-panel-copy" />
                        </Stack>
                    </PanelCard>
                }

                @if (!string.IsNullOrWhiteSpace(blockDialog.Error))
                {
                    <PanelCard Class="project-structure-inline-feedback"
                               data-tone="warn">
                        @blockDialog.Error
                    </PanelCard>
                }
            </Stack>
        </Body>
    </ProjectStructureOverlayDialog>
}

@if (SubprojectTransferDialog is not null)
{
    var transferDialog = SubprojectTransferDialog;
    var moveScopeCopy = transferDialog.DescendantCount == 1
        ? "1 descendant will move into the new subproject root."
        : $"{transferDialog.DescendantCount} descendants will move into the new subproject root.";

    <ProjectStructureOverlayDialog CanvasScoped="true"
                                   AriaLabel="@transferDialog.Title"
                                   Kicker="Subproject transfer"
                                   Title="@transferDialog.Title"
                                   Summary="@transferDialog.Copy"
                                   DataTestId="project-structure-subproject-transfer-dialog"
                                   Close="CloseSubprojectTransfer">
        <Actions>
            <Button Text="Cancel"
                    Variant="Variant.Text"
                    ButtonStyle="ButtonStyle.Base"
                    Click="CloseSubprojectTransfer" />
            <Button Text="@transferDialog.SubmitLabel"
                    ButtonStyle="ButtonStyle.Info"
                    data-testid="project-structure-subproject-transfer-submit"
                    Click="ExecuteSubprojectTransfer" />
        </Actions>
        <Body>
            <Stack GapScale="LayoutGap.Medium">
                <PanelCard>
                    <Stack GapScale="LayoutGap.Small">
                        <TextBlock TextStyle="TextStyle.Footer" Value="New subproject name" Class="cw-panel-copy" />
                        <input class="cw-context-toolbox__search"
                               type="text"
                               data-testid="project-structure-subproject-transfer-name"
                               value="@transferDialog.ProjectName"
                               @oninput="SubprojectTransferNameChanged" />
                    </Stack>
                </PanelCard>

                <PanelCard>
                    <Stack GapScale="LayoutGap.Tiny">
                        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Move scope" />
                        <TextBlock TextStyle="TextStyle.Note"
                                   Value="@moveScopeCopy"
                                   Class="cw-panel-copy" />
                    </Stack>
                </PanelCard>

                @if (!string.IsNullOrWhiteSpace(transferDialog.Error))
                {
                    <PanelCard Class="project-structure-inline-feedback"
                               data-tone="warn">
                        @transferDialog.Error
                    </PanelCard>
                }
            </Stack>
        </Body>
    </ProjectStructureOverlayDialog>
}

@if (ProcessLinkDialog is not null)
{
    var processDialog = ProcessLinkDialog;
    var selectedOption = processDialog.SelectedDefinitionId.HasValue
        ? processDialog.Options.FirstOrDefault(option => option.DefinitionId == processDialog.SelectedDefinitionId.Value)
        : null;

    <ProjectStructureOverlayDialog CanvasScoped="true"
                                   AriaLabel="@processDialog.Title"
                                   Kicker="Process link"
                                   Title="@processDialog.Title"
                                   Summary="@processDialog.Copy"
                                   DataTestId="project-structure-process-link-dialog"
                                   Close="CloseProcessLink">
        <Actions>
            <Button Text="Cancel"
                    Variant="Variant.Text"
                    ButtonStyle="ButtonStyle.Base"
                    Click="CloseProcessLink" />
            <Button Text="@processDialog.SubmitLabel"
                    ButtonStyle="ButtonStyle.Info"
                    data-testid="project-structure-process-link-submit"
                    Disabled="@(processDialog.Options.Count == 0)"
                    Click="ExecuteProcessLink" />
        </Actions>
        <Body>
            <Stack GapScale="LayoutGap.Medium">
                <PanelCard>
                    <Stack GapScale="LayoutGap.Small">
                        <TextBlock TextStyle="TextStyle.Footer" Value="Process" Class="cw-panel-copy" />
                        <select class="cw-context-toolbox__search"
                                data-testid="project-structure-process-link-select"
                                value="@(processDialog.SelectedDefinitionId?.ToString() ?? string.Empty)"
                                @onchange="ProcessLinkSelectionChanged">
                            <option value="">Select a process</option>
                            @foreach (var option in processDialog.Options)
                            {
                                <option value="@option.DefinitionId">@option.DisplayName</option>
                            }
                        </select>
                    </Stack>
                </PanelCard>

                @if (selectedOption is not null)
                {
                    <PanelCard>
                        <Stack GapScale="LayoutGap.Tiny">
                            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Selected process" />
                            <TextBlock TextStyle="TextStyle.Subtitle2" Value="@selectedOption.DisplayName" />
                            <TextBlock TextStyle="TextStyle.Note"
                                       Value="@($"{selectedOption.ScopeLabel} scope • {selectedOption.Status}")"
                                       Class="cw-panel-copy" />
                            @if (!selectedOption.HasPublishedVersion)
                            {
                                <TextBlock TextStyle="TextStyle.Note"
                                           Value="This process is not published yet, so execution will fail until a published version exists."
                                           Class="cw-panel-copy" />
                            }
                        </Stack>
                    </PanelCard>
                }

                @if (!string.IsNullOrWhiteSpace(processDialog.Error))
                {
                    <PanelCard Class="project-structure-inline-feedback"
                               data-tone="warn">
                        @processDialog.Error
                    </PanelCard>
                }
            </Stack>
        </Body>
    </ProjectStructureOverlayDialog>
}

@if (QuickActionDialog is not null)
{
    var quickActionDialog = QuickActionDialog;

    <ProjectStructureOverlayDialog CanvasScoped="true"
                                   AriaLabel="@($"{quickActionDialog.Title} quick actions")"
                                   Kicker="Node quick actions"
                                   Title="@quickActionDialog.Title"
                                   Summary="@quickActionDialog.Copy"
                                   DialogClass="project-structure-quick-action-dialog"
                                   BodyClass="project-structure-quick-action-dialog__body"
                                   DataTestId="project-structure-node-quick-actions"
                                   Close="CloseQuickActionDialog">
        <Actions>
            <Pill Tone="PillTone.Info" Text="@quickActionDialog.NodeLabel" />
            <Button Text="Close"
                    Variant="Variant.Text"
                    ButtonStyle="ButtonStyle.Base"
                    Click="CloseQuickActionDialog" />
        </Actions>
        <Body>
            <Grid Columns="2"
                  Gap="LayoutGap.Medium"
                  Class="project-structure-quick-action-grid">
                @foreach (var action in quickActionDialog.Actions)
                {
                    <Button ButtonStyle="@ResolveButtonStyle(action.Tone)"
                            Variant="Variant.Outlined"
                            Class="project-structure-quick-action-card"
                            data-testid="@ResolveQuickActionTestId(action)"
                            Disabled="@action.IsDisabled"
                            Click="@(() => ExecuteQuickAction.InvokeAsync(action))">
                        <Stack GapScale="LayoutGap.Small"
                               Class="items-center text-center">
                            <Icon Name="@action.Icon" />
                            <TextBlock TextStyle="TextStyle.Subtitle2" Value="@action.Label" />
                            <TextBlock TextStyle="TextStyle.Note" Value="@action.Description" />
                        </Stack>
                    </Button>
                }
            </Grid>
        </Body>
    </ProjectStructureOverlayDialog>
}

@if (RenderProcessStartDialog && ProcessStartDialog is not null)
{
    var startDialog = ProcessStartDialog;
    var isStaffingStage = startDialog.Stage == ProjectStructureProcessStartStage.Staffing;
    var processStartCancelKey = $"project-structure-process-start-cancel-{startDialog.Stage}-{startDialog.ConfirmHrManagerMatch}";
    const string processStartKeepManualKey = "project-structure-process-start-keep-manual";
    const string processStartConfirmHrKey = "project-structure-process-start-confirm-hr";
    const string processStartStartKey = "project-structure-process-start-start";
    const string processStartRequestHrKey = "project-structure-process-start-request-hr";
    const string processStartContinueKey = "project-structure-process-start-continue";

    <ProjectStructureOverlayDialog AriaLabel="@startDialog.Title"
                                   Kicker="Process start"
                                   Title="@startDialog.Title"
                                   Summary="@startDialog.Copy"
                                   DialogClass="project-structure-process-start-dialog"
                                   BodyClass="project-structure-process-start-dialog__body"
                                   DataTestId="project-structure-process-start-dialog"
                                   Close="CloseProcessStart">
        <Actions>
            <Button @key="processStartCancelKey"
                    Text="Cancel"
                    Variant="Variant.Text"
                    ButtonStyle="ButtonStyle.Base"
                    Disabled="@startDialog.IsBusy"
                    Click="CloseProcessStart" />
            @if (isStaffingStage)
            {
                if (startDialog.ConfirmHrManagerMatch)
                {
                    <Button @key="processStartKeepManualKey"
                            Text="Keep manual matching"
                            Variant="Variant.Text"
                            ButtonStyle="ButtonStyle.Base"
                            Disabled="@startDialog.IsBusy"
                            data-testid="project-structure-process-start-cancel-hr-match"
                            Click="CancelHrManagerMatch" />
                    <Button @key="processStartConfirmHrKey"
                            Text="Confirm HR match"
                            ButtonStyle="ButtonStyle.Info"
                            IsBusy="@startDialog.IsBusy"
                            data-testid="project-structure-process-start-confirm-hr-match"
                            Click="ExecuteHrManagerMatch" />
                }
                else
                {
                    <Button @key="processStartStartKey"
                            Text="@startDialog.SubmitLabel"
                            ButtonStyle="ButtonStyle.Warning"
                            Disabled="@(!startDialog.CanStart || startDialog.IsBusy)"
                            IsBusy="@startDialog.IsBusy"
                            data-testid="project-structure-process-start-start"
                            Click="ExecuteProcessStart" />
                    <Button @key="processStartRequestHrKey"
                            Text="Use HR manager suggestions"
                            Variant="Variant.Text"
                            ButtonStyle="ButtonStyle.Base"
                            Disabled="@startDialog.IsBusy"
                            data-testid="project-structure-process-start-request-hr-match"
                            Click="RequestHrManagerMatch" />
                }
            }
            else
            {
                <Button @key="processStartContinueKey"
                        Text="@startDialog.SubmitLabel"
                        ButtonStyle="ButtonStyle.Warning"
                        IsBusy="@startDialog.IsBusy"
                        data-testid="project-structure-process-start-continue"
                        Click="ExecuteProcessStart" />
            }
        </Actions>
        <Body>
            <Stack GapScale="LayoutGap.Medium"
                   Class="project-structure-process-start-dialog__content"
                   Style="min-height:0;overflow:auto;padding-right:0.3rem;">
                <PanelCard>
                    <Stack GapScale="LayoutGap.Tiny">
                        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Execution target" />
                        <TextBlock TextStyle="TextStyle.Subtitle2" Value="@startDialog.TargetNodeTitle" />
                        <TextBlock TextStyle="TextStyle.Note"
                                   Value="@($"Target node id: {startDialog.TargetNodeId}")"
                                   Class="cw-panel-copy" />
                        @if (!string.IsNullOrWhiteSpace(startDialog.ParentNodeId))
                        {
                            <TextBlock TextStyle="TextStyle.Note"
                                       Value="@($"Resolved parent node id: {startDialog.ParentNodeId}")"
                                       Class="cw-panel-copy" />
                        }
                        <TextBlock TextStyle="TextStyle.Note"
                                   Value="@($"Selected process node id: {startDialog.NodeId}")"
                                   Class="cw-panel-copy" />
                        <TextBlock TextStyle="TextStyle.Note"
                                   Value="@($"Project id: {startDialog.ProjectId:D}")"
                                   Class="cw-panel-copy" />
                    </Stack>
                </PanelCard>

                @if (!isStaffingStage)
                {
                    <PanelCard>
                        <Stack GapScale="LayoutGap.Tiny">
                            <TextBlock TextStyle="TextStyle.Eyebrow" Value="What happens next" />
                            <TextBlock TextStyle="TextStyle.Note"
                                       Value="The app will create a launch plan, auto-approve it, provision anything required, and then start the process run with the selected node and parent-node context."
                                       Class="cw-panel-copy" />
                        </Stack>
                    </PanelCard>
                }
                else
                {
                    <PanelCard data-testid="project-structure-process-start-staffing-summary">
                        <Stack GapScale="LayoutGap.Small">
                            <div class="flex flex-wrap items-center gap-2">
                                <Pill Tone="PillTone.Info"
                                      Text="@($"Resolved {startDialog.ResolvedRoleCount} of {startDialog.Roles.Count}")" />
                                <Pill Tone="@(startDialog.RequiredGapCount == 0 ? PillTone.Ok : PillTone.Warn)"
                                      Text="@(startDialog.RequiredGapCount == 0 ? "Ready to start" : $"{startDialog.RequiredGapCount} required role gaps")" />
                                @if (startDialog.LaunchPlanId.HasValue)
                                {
                                    <Pill Tone="PillTone.Neutral"
                                          Text="@($"Launch plan {startDialog.LaunchPlanId.Value:D}")" />
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(startDialog.StatusMessage))
                            {
                                <TextBlock TextStyle="TextStyle.Note"
                                           Value="@startDialog.StatusMessage"
                                           Class="cw-panel-copy" />
                            }
                        </Stack>
                    </PanelCard>

                    <PanelCard>
                        <label class="flex items-start gap-3"
                               data-testid="project-structure-process-start-review-panel">
                            <input type="checkbox"
                                   class="mt-1"
                                   data-testid="project-structure-process-start-review-confirmation"
                                   checked="@startDialog.AssignmentsReviewed"
                                   @onchange="ProcessStartAssignmentsReviewedChanged" />
                            <span class="cw-panel-copy">
                                I reviewed these role assignments and want the process to start with them after every required role is resolved.
                            </span>
                        </label>
                    </PanelCard>

                    @if (startDialog.ConfirmHrManagerMatch)
                    {
                        <PanelCard Class="project-structure-inline-feedback"
                                   data-tone="warn"
                                   data-testid="project-structure-process-start-hr-confirmation">
                            <Stack GapScale="LayoutGap.Small">
                                <TextBlock TextStyle="TextStyle.Subtitle2"
                                           Value="@($"Let {startDialog.HrManagerName} pair the roles?")" />
                                <TextBlock TextStyle="TextStyle.Note"
                                           Value="The HR manager will review the required roles, current project assignments, CRM-HR workforce records, and AI agent catalog facts to propose the best matches. The suggestions will stay visible here so you can review them before the process starts."
                                           Class="cw-panel-copy" />
                            </Stack>
                        </PanelCard>
                    }

                    <div class="space-y-4 project-structure-process-start-dialog__roles"
                         style="min-height:0;"
                         data-testid="project-structure-process-start-staffing-roles">
                        @foreach (var role in startDialog.Roles)
                        {
                            var orderedCandidates = role.Candidates
                                .OrderByDescending(candidate => candidate.IsSelected)
                                .ThenByDescending(candidate => candidate.IsRecommended)
                                .ThenByDescending(candidate => candidate.IsResolvable)
                                .ThenBy(candidate => candidate.DisplayName, StringComparer.OrdinalIgnoreCase)
                                .ToList();

                            <PanelCard data-testid="@($"project-structure-process-start-role-{role.LaunchPlanRoleId:D}")">
                                <Stack GapScale="LayoutGap.Small">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <TextBlock TextStyle="TextStyle.Subtitle2"
                                                   Value="@role.DisplayName" />
                                        <Pill Tone="@(role.IsRequired ? PillTone.Warn : PillTone.Neutral)"
                                              Text="@(role.IsRequired ? "Required" : "Optional")" />
                                        <Pill Tone="@(role.IsResolved ? PillTone.Ok : PillTone.Warn)"
                                              Text="@(role.IsResolved ? "Resolved" : "Needs selection")" />
                                        @if (role.RequiresProvisioning)
                                        {
                                            <Pill Tone="PillTone.Info"
                                                  Text="Provisioning required" />
                                        }
                                    </div>

                                    <TextBlock TextStyle="TextStyle.Note"
                                               Value="@($"{role.PreferredExecutorKind} / {role.SelectionSummary}")"
                                               Class="cw-panel-copy" />
                                    @if (!string.IsNullOrWhiteSpace(role.ReadinessSummary))
                                    {
                                        <TextBlock TextStyle="TextStyle.Note"
                                                   Value="@role.ReadinessSummary"
                                                   Class="cw-panel-copy" />
                                    }

                                    @if (orderedCandidates.Count == 0)
                                    {
                                        <PanelCard Class="project-structure-inline-feedback"
                                                   data-tone="warn">
                                            No staffing candidates are available for this role yet.
                                        </PanelCard>
                                    }
                                    else
                                    {
                                        <div class="space-y-3">
                                            @foreach (var candidate in orderedCandidates)
                                            {
                                                <PanelCard Class="@(candidate.IsSelected ? "ring-2 ring-emerald-400/70" : string.Empty)"
                                                           data-testid="@($"project-structure-process-start-candidate-{role.LaunchPlanRoleId:D}-{candidate.CandidateId:D}")">
                                                    <Stack GapScale="LayoutGap.Small">
                                                        <div class="flex flex-wrap items-start justify-between gap-3">
                                                            <div class="space-y-1">
                                                                <TextBlock TextStyle="TextStyle.Subtitle2"
                                                                           Value="@candidate.DisplayName" />
                                                                <TextBlock TextStyle="TextStyle.Note"
                                                                           Value="@($"{candidate.CandidateKindLabel} / {candidate.ExecutorKind}")"
                                                                           Class="cw-panel-copy" />
                                                            </div>
                                                            <div class="flex flex-wrap items-center gap-2">
                                                                <Pill Tone="PillTone.Neutral"
                                                                      Text="@candidate.ScoreLabel" />
                                                                @if (candidate.IsRecommended)
                                                                {
                                                                    <Pill Tone="PillTone.Info"
                                                                          Text="Recommended" />
                                                                }
                                                                @if (candidate.RequiresProvisioning)
                                                                {
                                                                    <Pill Tone="PillTone.Warn"
                                                                          Text="Provisioning" />
                                                                }
                                                                @if (candidate.IsSelected)
                                                                {
                                                                    <Pill Tone="PillTone.Ok"
                                                                          Text="Selected" />
                                                                }
                                                            </div>
                                                        </div>

                                                        @if (!string.IsNullOrWhiteSpace(candidate.RecommendationSummary))
                                                        {
                                                            <TextBlock TextStyle="TextStyle.Note"
                                                                       Value="@candidate.RecommendationSummary"
                                                                       Class="cw-panel-copy" />
                                                        }

                                                        @if (!string.IsNullOrWhiteSpace(candidate.AvailabilitySummary))
                                                        {
                                                            <TextBlock TextStyle="TextStyle.Note"
                                                                       Value="@candidate.AvailabilitySummary"
                                                                       Class="cw-panel-copy" />
                                                        }

                                                        <div class="flex flex-wrap items-center justify-between gap-3">
                                                            <TextBlock TextStyle="TextStyle.Note"
                                                                       Value="@candidate.SourceRegistryKey"
                                                                       Class="cw-panel-copy" />
                                                            <Button Text="@(candidate.IsSelected ? "Selected" : "Select")"
                                                                    Variant="@(candidate.IsSelected ? Variant.Filled : Variant.Outlined)"
                                                                    ButtonStyle="@(candidate.IsSelected ? ButtonStyle.Success : ButtonStyle.Info)"
                                                                    Disabled="@(!candidate.IsResolvable || startDialog.IsBusy || candidate.IsSelected)"
                                                                    data-testid="@($"project-structure-process-start-select-{role.LaunchPlanRoleId:D}-{candidate.CandidateId:D}")"
                                                                    Click="@(() => SelectProcessStartCandidate.InvokeAsync(new ProjectStructureProcessStartCandidateSelection(role.LaunchPlanRoleId, candidate.CandidateId)))" />
                                                        </div>
                                                    </Stack>
                                                </PanelCard>
                                            }
                                        </div>
                                    }
                                </Stack>
                            </PanelCard>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(startDialog.Error))
                {
                    <PanelCard Class="project-structure-inline-feedback"
                               data-tone="warn">
                        @startDialog.Error
                    </PanelCard>
                }
            </Stack>
        </Body>
    </ProjectStructureOverlayDialog>
}

@if (PreviewNode is not null)
{
    var previewNode = PreviewNode;

    <ProjectStructureOverlayDialog CanvasScoped="true"
                                   AriaLabel="@($"{ResolveAttachmentDisplayName.Invoke(previewNode)} preview")"
                                   Kicker="Canvas preview"
                                   Title="@ResolveAttachmentDisplayName.Invoke(previewNode)"
                                   Summary="@ResolveAttachmentLeadCopy.Invoke(previewNode)"
                                   Close="CloseAttachmentPreview">
        <Actions>
            @if (CanShowLocalOpen.Invoke(previewNode))
            {
                <Button Text="Open in File Explorer"
                        ButtonStyle="ButtonStyle.Primary"
                        Click="@(() => OpenAttachmentLocally.InvokeAsync(previewNode))" />
            }
            <Button Text="Open in new tab"
                    Variant="Variant.Text"
                    ButtonStyle="ButtonStyle.Base"
                    Href="@previewNode.Route"
                    Target="_blank"
                    Rel="noopener noreferrer" />
            <Button Text="Close"
                    Variant="Variant.Text"
                    ButtonStyle="ButtonStyle.Base"
                    Click="CloseAttachmentPreview" />
        </Actions>
        <Body>
            @switch (ResolveAttachmentPreviewKind.Invoke(previewNode))
            {
                case AttachmentPreviewKind.Image:
                    <img class="project-structure-preview-dialog__media"
                         src="@previewNode.Route"
                         alt="@previewNode.Title" />
                    break;
                case AttachmentPreviewKind.Video:
                    <video class="project-structure-preview-dialog__media"
                           controls
                           preload="metadata"
                           src="@previewNode.Route"></video>
                    break;
                case AttachmentPreviewKind.Audio:
                    <audio class="project-structure-audio-preview project-structure-preview-dialog__audio"
                           controls
                           preload="metadata"
                           src="@previewNode.Route"></audio>
                    break;
                case AttachmentPreviewKind.Document:
                    <iframe class="project-structure-preview-dialog__frame"
                            src="@ResolveAttachmentPreviewSource.Invoke(previewNode)"
                            title="@($"{ResolveAttachmentDisplayName.Invoke(previewNode)} dialog preview")"></iframe>
                    break;
            }
        </Body>
    </ProjectStructureOverlayDialog>
}

@code {
    [Parameter]
    public ProjectStructureProjectHierarchyDialogState? ProjectHierarchyDialog { get; set; }

    [Parameter]
    public EventCallback CloseProjectHierarchy { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> ProjectHierarchySelectionChanged { get; set; }

    [Parameter]

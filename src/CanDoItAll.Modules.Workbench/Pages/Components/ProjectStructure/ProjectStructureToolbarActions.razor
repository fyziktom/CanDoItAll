@namespace CanDoItAll.Modules.Workbench.Pages
@using CanDoItAll.Components.BaseLib

<Cluster Gap="LayoutGap.Small"
         Class="project-structure-toolbar-windows">
    <Cluster Gap="LayoutGap.XSmall"
             Class="project-structure-toolbar-tools">
        <Button Text="Select"
                Icon="arrow_selector_tool"
                Variant="Variant.Text"
                ButtonStyle="ButtonStyle.Base"
                Class="@ResolveToolbarButtonCssClass(string.Equals(ActiveTool, SelectTool, StringComparison.Ordinal))"
                data-testid="project-structure-toolbar-tool-select"
                title="Use the normal select and move tool"
                Click="SelectToolClicked" />

        <Button Text="Dependency"
                Icon="start"
                Variant="Variant.Text"
                ButtonStyle="ButtonStyle.Base"
                Class="@ResolveToolbarButtonCssClass(string.Equals(ActiveTool, DependencyTool, StringComparison.Ordinal))"
                data-testid="project-structure-toolbar-tool-dependency"
                title="Click another node to say the selected node depends on it"
                Disabled="@(!CanUseDependencyTool)"
                Click="DependencyToolClicked" />

        <Button Text="Delete"
                Icon="delete"
                Variant="Variant.Text"
                ButtonStyle="ButtonStyle.Base"
                Class="@ResolveToolbarButtonCssClass(string.Equals(ActiveTool, DeleteTool, StringComparison.Ordinal))"
                data-testid="project-structure-toolbar-tool-delete"
                title="Hover a node or dependency and click to delete it"
                Click="DeleteToolClicked" />
    </Cluster>

    <Button Text="Inspector"
            Variant="Variant.Text"
            ButtonStyle="ButtonStyle.Base"
            Class="@ResolveToolbarButtonCssClass(SelectionWindowVisible)"
            title="Show or hide the selection panel"
            Click="ToggleSelectionWindow" />

    <Button Text="Health"
            Variant="Variant.Text"
            ButtonStyle="ButtonStyle.Base"
            Class="@ResolveToolbarButtonCssClass(HealthWindowVisible)"
            title="Show or hide canvas health"
            Click="ToggleHealthWindow" />

    <Button Text="Blocks"
            Variant="Variant.Text"
            ButtonStyle="ButtonStyle.Base"
            Class="@ResolveToolbarButtonCssClass(ToolboxWindowVisible)"
            data-testid="project-structure-toolbox-toggle"
            title="Show or hide the standard blocks toolbox"
            Click="ToggleToolboxWindow" />

    <Button Text="Signals"
            Variant="Variant.Text"
            ButtonStyle="ButtonStyle.Base"
            Class="@ResolveToolbarButtonCssClass(SignalsWindowVisible)"
            data-testid="project-structure-signals-toggle"
            title="Show or hide the node signals toolbox"
            Click="ToggleSignalsWindow" />

    <Button Text="@(IsSubtreeRecompositionInProgress ? "Recomposing" : "Recompose")"
            Variant="Variant.Text"
            ButtonStyle="ButtonStyle.Base"
            Class="cw-toolbar-action"
            data-testid="project-structure-recompose-toolbar-button"
            title="Redistribute descendants under the selected node without changing relationships."
            Disabled="@(!CanRecomposeSelectedBranch)"
            Click="RecomposeBranch" />
</Cluster>

@code {
    private const string SelectTool = "authoring";
    private const string DependencyTool = "dependency";
    private const string DeleteTool = "delete";

    [Parameter]
    public bool SelectionWindowVisible { get; set; }

    [Parameter]
    public bool HealthWindowVisible { get; set; }

    [Parameter]
    public bool ToolboxWindowVisible { get; set; }

    [Parameter]
    public bool SignalsWindowVisible { get; set; }

    [Parameter]
    public string ActiveTool { get; set; } = SelectTool;

    [Parameter]
    public bool CanUseDependencyTool { get; set; }

    [Parameter]
    public bool CanRecomposeSelectedBranch { get; set; }

    [Parameter]
    public bool IsSubtreeRecompositionInProgress { get; set; }

    [Parameter]
    public EventCallback ToggleSelectionWindow { get; set; }

    [Parameter]
    public EventCallback ToggleHealthWindow { get; set; }

    [Parameter]
    public EventCallback ToggleToolboxWindow { get; set; }

    [Parameter]
    public EventCallback ToggleSignalsWindow { get; set; }

    [Parameter]
    public EventCallback SelectToolClicked { get; set; }

    [Parameter]
    public EventCallback DependencyToolClicked { get; set; }

    [Parameter]
    public EventCallback DeleteToolClicked { get; set; }

    [Parameter]
    public EventCallback RecomposeBranch { get; set; }

    private string ResolveToolbarButtonCssClass(bool isActive)
    {
        return isActive
            ? "cw-toolbar-action project-structure-toolbar-toggle is-active"
            : "cw-toolbar-action project-structure-toolbar-toggle";
    }
}

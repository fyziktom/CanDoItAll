@page "/projects/{ProjectId:guid}/structure"
@* codex-capsule
kind: page
name: ProjectStructurePage
summary: Hosts the shared project structure canvas, mirrored inspector, typed graph actions, and supporting outline tools.
owns: shared-structure-canvas, node-outline, mirrored-inspector
deps: ProjectWorkbenchService, NavigationManager
risks: stale-node-selection, invalid-command-routing, overlapping-create-placement
tests: component:ProjectStructurePageTests, e2e:workbench-structure
*@
@using CanDoItAll.ComponentKit.Canvas
@using CanDoItAll.ComponentKit.Components
@using CanDoItAll.SharedKernel
@inject ProjectWorkbenchService ProjectWorkbenchService
@inject NavigationManager Navigation

<PageTitle>Project Structure</PageTitle>

@if (surface is null || canvasSurface is null)
{
    <p class="text-sm text-slate-500">Loading project structure...</p>
}
else
{
    <div class="space-y-6">
        <PageHeader Eyebrow="Workbench"
                    Title="@($"{surface.ProjectName} structure")"
                    Description="Operate the project graph from one shared canvas stage, mirrored inspector, and supporting outline surface." />

        <CanvasWorkbenchStage Eyebrow="Structure canvas"
                              Title="@($"{surface.ProjectName} workbench")"
                              Description="The shared canvas system now owns the same authoring vocabulary, chrome, quick-create flows, and inspector rhythm used across the canvas upgrades."
                              Stats="stageStats">
            <Canvas>
                <CanvasWorkbench Surface="canvasSurface"
                                 @ref="workbenchRef"
                                 SelectionChanged="HandleSelectionChangedAsync"
                                 NodesMoved="HandleNodesMovedAsync"
                                 ContextActionRequested="HandleContextActionAsync"
                                 CreateActionInvoked="HandleCreateActionAsync"
                                 NodeEdited="HandleNodeEditedAsync"
                                 NodeOpened="HandleNodeOpenedAsync"
                                 StateChanged="HandleCanvasStateChangedAsync" />
            </Canvas>
            <Inspector>
                @if (selectedNodes.Count == 0)
                {
                    <div class="cw-empty-state">
                        <p class="cw-panel-kicker">Inspector</p>
                        <h3>Select a project object</h3>
                        <p>Selection drives the mirrored editor surface, typed actions, and adjacent create behavior.</p>
                        <div class="cw-chip-row">
                            <span class="cw-node__chip">Alt + drag</span>
                            <span class="cw-node__chip">Right-click</span>
                            <span class="cw-node__chip">Double-click</span>
                        </div>
                    </div>
                }
                else if (selectedNodes.Count > 1)
                {
                    <div class="space-y-4">
                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Multi-select</p>
                            <h3 class="cw-panel-title">@($"{selectedNodes.Count} nodes selected")</h3>
                            <p class="cw-panel-copy">Batch movement is available on the canvas. The inspector stays readable by showing the current selection set and the bulk-safe actions.</p>
                            <div class="cw-button-row">
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="ClearSelectionAsync">Clear selection</button>
                                <button type="button" class="cw-button" data-tone="accent" @onclick="@(() => SelectNodeAsync(selectedNodes[0].Id))">Focus first</button>
                            </div>
                        </div>

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Selected nodes</p>
                            <div class="cw-list">
                                @foreach (var node in selectedNodes)
                                {
                                    <button type="button" class="cw-list-item" @onclick="@(() => SelectNodeAsync(node.Id))">
                                        <strong>@node.Title</strong>
                                        <span>@node.ObjectType · @node.Status</span>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
                else if (selectedNode is not null)
                {
                    <div class="space-y-4">
                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">@selectedNode.ObjectType</p>
                            <h3 class="cw-panel-title">@selectedNode.Title</h3>
                            <p class="cw-panel-copy">@selectedNode.Subtitle</p>

                            <div class="cw-chip-row">
                                <span class="cw-node__chip tone-accent">@selectedNode.Status</span>
                                @foreach (var badge in selectedNode.Badges)
                                {
                                    <span class="cw-node__chip">@badge</span>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(linkModeSourceId))
                            {
                                <div class="cw-panel-card">
                                    <p class="cw-panel-kicker">Link mode</p>
                                    <p class="cw-panel-copy">Select another node on the canvas or in the outline to create a dependency link from the active source.</p>
                                </div>
                            }

                            <div class="cw-summary-grid">
                                <div class="cw-summary-tile">
                                    <span>Artifact</span>
                                    <strong>@selectedNode.ArtifactKind</strong>
                                </div>
                                <div class="cw-summary-tile">
                                    <span>Kind</span>
                                    <strong>@selectedNode.VisualProfile.AccentBadge</strong>
                                </div>
                                <div class="cw-summary-tile">
                                    <span>Location</span>
                                    <strong>@($"{Math.Round(selectedNode.X)}, {Math.Round(selectedNode.Y)}")</strong>
                                </div>
                            </div>
                        </div>

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Node actions</p>
                            <div class="cw-button-row">
                                @foreach (var command in Enum.GetValues<ProjectStructureCommandKind>())
                                {
                                    <button type="button" class="cw-button" data-tone="primary" @onclick="@(() => ExecuteCommandAsync(command))">@command</button>
                                }
                            </div>
                        </div>

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Create next to source</p>
                            <div class="cw-button-row">
                                @foreach (var action in BuildQuickCreateActions())
                                {
                                    <button type="button"
                                            class="cw-button"
                                            data-tone="@action.Tone"
                                            @onclick="@(() => OpenCreateDialogAsync(ResolveCreatedObjectType(action.ActionId)))">
                                        @action.Label
                                    </button>
                                }
                                <button type="button" class="cw-button" data-tone="warn" @onclick="EnableLinkMode">Link selected</button>
                            </div>
                        </div>
                    </div>
                }
            </Inspector>
            <Supporting>
                <div class="cw-panel-card">
                    <p class="cw-panel-kicker">Outline</p>
                    <h3 class="cw-panel-title">Project object index</h3>
                    <div class="cw-list">
                        @foreach (var node in outlineNodes)
                        {
                            <button type="button"
                                    class="cw-list-item @(selectedNodeIds.Contains(node.Id, StringComparer.Ordinal) ? "is-active" : string.Empty)"
                                    @onclick="@(() => SelectNodeAsync(node.Id))">
                                <strong>@node.Title</strong>
                                <span>@node.ObjectType · @node.Status</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="cw-panel-card">
                    <p class="cw-panel-kicker">Canvas coverage</p>
                    <h3 class="cw-panel-title">Graph health</h3>
                    <div class="cw-summary-grid">
                        <div class="cw-summary-tile">
                            <span>Total nodes</span>
                            <strong>@surface.Nodes.Count</strong>
                        </div>
                        <div class="cw-summary-tile">
                            <span>Total links</span>
                            <strong>@surface.Links.Count</strong>
                        </div>
                        <div class="cw-summary-tile">
                            <span>Selected</span>
                            <strong>@selectedNodeIds.Count</strong>
                        </div>
                    </div>
                    <p class="cw-panel-copy">Cross-links, typed child creation, and workbench command routing remain intact on the shared canvas substrate.</p>
                </div>
            </Supporting>
        </CanvasWorkbenchStage>
    </div>
}

@code {
    private static readonly ProjectObjectType[] CreatableObjectTypes =
    [
        ProjectObjectType.Note,
        ProjectObjectType.Decision,
        ProjectObjectType.Milestone,
        ProjectObjectType.Repository,
        ProjectObjectType.File,
        ProjectObjectType.Link,
        ProjectObjectType.Connector,
        ProjectObjectType.Phase,
        ProjectObjectType.PromptFlow,
        ProjectObjectType.PromptSession,
        ProjectObjectType.PromptStep,
        ProjectObjectType.ValidationRun,
        ProjectObjectType.TestPlan,
        ProjectObjectType.TestEvidence,
        ProjectObjectType.SecretReference
    ];

    [Parameter]
    public Guid ProjectId { get; set; }

    private ProjectStructureSurface? surface;
    private CanvasWorkbenchSurface? canvasSurface;
    private CanvasWorkbench? workbenchRef;
    private List<string> selectedNodeIds = [];
    private string? linkModeSourceId;
    private string? currentViewStateJson;
    private Guid loadedProjectId;

    private IReadOnlyList<CanvasWorkbenchStat> stageStats =>
    [
        new() { Label = "Nodes", Value = surface?.Nodes.Count.ToString() ?? "0", Tone = "neutral" },
        new() { Label = "Links", Value = surface?.Links.Count.ToString() ?? "0", Tone = "accent" },
        new() { Label = "Selection", Value = selectedNodeIds.Count.ToString(), Tone = "mint" }
    ];

    private IReadOnlyList<ProjectStructureNode> outlineNodes =>
        surface?.Nodes
            .OrderBy(node => ResolveOutlineWeight(node.ObjectType))
            .ThenBy(node => node.Title, StringComparer.OrdinalIgnoreCase)
            .ToList() ?? [];

    private IReadOnlyList<ProjectStructureNode> selectedNodes =>
        surface?.Nodes.Where(node => selectedNodeIds.Contains(node.Id, StringComparer.Ordinal)).ToList() ?? [];

    private ProjectStructureNode? selectedNode => selectedNodes.FirstOrDefault();

    protected override async Task OnParametersSetAsync()
    {
        if (loadedProjectId != ProjectId)
        {
            loadedProjectId = ProjectId;
            currentViewStateJson = null;
            selectedNodeIds = [];
            linkModeSourceId = null;
        }

        await ReloadSurfaceAsync();
    }

    private async Task ReloadSurfaceAsync(string? preferredSelectionId = null)
    {
        var reloadedSurface = await ProjectWorkbenchService.GetStructureAsync(ProjectId);
        var uiState = !string.IsNullOrWhiteSpace(currentViewStateJson)
            ? CanvasWorkbenchUiState.Parse(currentViewStateJson)
            : CanvasWorkbenchUiState.Parse(reloadedSurface.ViewStateJson);
        selectedNodeIds = uiState.SelectedNodeIds.Count > 0
            ? uiState.SelectedNodeIds.Where(id => reloadedSurface.Nodes.Any(node => string.Equals(node.Id, id, StringComparison.Ordinal))).ToList()
            : [];

        if (!string.IsNullOrWhiteSpace(preferredSelectionId) &&
            reloadedSurface.Nodes.Any(node => string.Equals(node.Id, preferredSelectionId, StringComparison.Ordinal)))
        {
            selectedNodeIds = [preferredSelectionId];
            uiState.SelectedNodeIds = [preferredSelectionId];
        }
        else if (selectedNodeIds.Count == 0 && reloadedSurface.Nodes.Count > 0)
        {
            selectedNodeIds = [reloadedSurface.Nodes[0].Id];
            uiState.SelectedNodeIds = [reloadedSurface.Nodes[0].Id];
        }

        surface = reloadedSurface with { ViewStateJson = uiState.ToJson() };
        currentViewStateJson = surface.ViewStateJson;
        RefreshCanvasSurface();
    }

    private void RefreshCanvasSurface()
    {
        if (surface is null)
        {
            canvasSurface = null;
            return;
        }

        var uiState = CanvasWorkbenchUiState.Parse(surface.ViewStateJson);
        uiState.SelectedNodeIds = [.. selectedNodeIds];

        canvasSurface = new CanvasWorkbenchSurface
        {
            SurfaceId = $"project-structure:{surface.ProjectId:N}",
            Mode = "authoring",
            UiState = uiState,
            Chrome = new CanvasWorkbenchChrome
            {
                HintText = "Click to select, Alt-drag to marquee, drag to move, and right-click for typed project actions.",
                FocusActionLabel = "Focus root",
                ChildNoteActionId = "add-note",
                SiblingNoteActionId = "add-note",
                InlineNotePlaceholder = "Write note",
                QuickCreateActions = BuildQuickCreateActions().ToList()
            },
            Nodes = surface.Nodes.Select(MapCanvasNode).ToList(),
            Links = surface.Links.Select(link => new CanvasWorkbenchLink
            {
                SourceId = link.SourceId,
                TargetId = link.TargetId,
                Kind = link.Kind.ToString(),
                IsUserAuthored = link.IsUserAuthored
            }).ToList()
        };
    }

    private CanvasWorkbenchNode MapCanvasNode(ProjectStructureNode node)
    {
        var family = ResolveFamily(node.ObjectType);
        var hasChildren = surface?.Nodes.Any(candidate => string.Equals(candidate.ParentId, node.Id, StringComparison.Ordinal)) ?? false;
        var inlineText = string.IsNullOrWhiteSpace(node.Notes) ? node.Title : node.Notes;
        var isInlineTextNode = node.ObjectType == ProjectObjectType.Note && string.IsNullOrWhiteSpace(node.Subtitle);

        return new CanvasWorkbenchNode
        {
            Id = node.Id,
            ParentId = node.ParentId,
            Family = family,
            Kind = ResolveKindLabel(node.ObjectType),
            Icon = node.VisualProfile.Icon,
            Title = node.Title,
            Subtitle = node.Subtitle,
            LeadText = BuildLeadText(node),
            Status = node.Status,
            BranchLabel = node.ObjectType is ProjectObjectType.Phase or ProjectObjectType.PromptSession ? "Branch" : string.Empty,
            AccentColor = node.VisualProfile.AccentColor,
            PaletteKey = ResolvePalette(node.ObjectType),
            DurationLabel = node.Badges.Contains("Scheduled", StringComparer.Ordinal) ? "Scheduled" : string.Empty,
            StatusPill = node.Status,
            IsRequired = node.ObjectType is ProjectObjectType.ProjectRoot or ProjectObjectType.Phase or ProjectObjectType.PromptSession,
            IsCollapsible = hasChildren && family is "root" or "group",
            IsInlineTextNode = isInlineTextNode,
            InlineText = inlineText,
            InlineTextPlaceholder = "Write note",
            X = node.X,
            Y = node.Y,
            Chips = BuildHeaderChips(node),
            FooterChips = BuildFooterChips(node),
            ContextActions = BuildContextActions(node)
        };
    }

    private static string ResolveFamily(ProjectObjectType objectType) => objectType switch
    {
        ProjectObjectType.ProjectRoot => "root",
        ProjectObjectType.Phase or ProjectObjectType.PromptSession or ProjectObjectType.PromptFlow => "group",
        ProjectObjectType.ValidationRun or ProjectObjectType.TestPlan or ProjectObjectType.Decision or ProjectObjectType.SecretReference => "special",
        _ => "item"
    };

    private static string ResolvePalette(ProjectObjectType objectType) => objectType switch
    {
        ProjectObjectType.Repository or ProjectObjectType.File => "sky",
        ProjectObjectType.Link or ProjectObjectType.Connector => "violet",
        ProjectObjectType.Milestone or ProjectObjectType.TestPlan or ProjectObjectType.TestEvidence => "amber",
        ProjectObjectType.ValidationRun or ProjectObjectType.Note => "mint",
        ProjectObjectType.Decision or ProjectObjectType.SecretReference => "rose",
        _ => "neutral"
    };

    private static string ResolveKindLabel(ProjectObjectType objectType) => objectType switch
    {
        ProjectObjectType.ProjectRoot => "project",
        ProjectObjectType.Phase => "phase",
        ProjectObjectType.PromptFlow => "prompt flow",
        ProjectObjectType.PromptSession => "prompt session",
        ProjectObjectType.PromptStep => "prompt step",
        ProjectObjectType.Repository => "repository",
        ProjectObjectType.File => "file",
        ProjectObjectType.Link => "link",
        ProjectObjectType.Connector => "connector",
        ProjectObjectType.ValidationRun => "validation",
        ProjectObjectType.TestPlan => "test plan",
        ProjectObjectType.TestEvidence => "test evidence",
        ProjectObjectType.Milestone => "milestone",
        ProjectObjectType.Decision => "decision",
        ProjectObjectType.SecretReference => "secret",
        _ => objectType.ToString()
    };

    private static string BuildLeadText(ProjectStructureNode node)
        => node.ObjectType == ProjectObjectType.Note
            ? (string.IsNullOrWhiteSpace(node.Notes) ? node.Title : node.Notes)
            : string.IsNullOrWhiteSpace(node.Subtitle)
                ? $"Status: {node.Status}"
                : node.Subtitle;

    private static List<CanvasWorkbenchChip> BuildHeaderChips(ProjectStructureNode node)
        => node.Badges.Select(badge => new CanvasWorkbenchChip { Text = badge, Tone = "accent" }).ToList();

    private static List<CanvasWorkbenchChip> BuildFooterChips(ProjectStructureNode node)
    {
        var chips = new List<CanvasWorkbenchChip>();
        if (!string.IsNullOrWhiteSpace(node.Route))
        {
            chips.Add(new CanvasWorkbenchChip { Text = "Routed", Tone = "neutral" });
        }

        if (node.ArtifactId.HasValue)
        {
            chips.Add(new CanvasWorkbenchChip { Text = "Artifact", Tone = "success" });
        }

        return chips;
    }

    private List<CanvasWorkbenchAction> BuildContextActions(ProjectStructureNode node)
    {
        var actions = new List<CanvasWorkbenchAction>
        {
            new() { ActionId = "open", Label = "Open", Description = "Open the linked artifact or routed workspace.", Icon = "open", Tone = "accent" },
            new() { ActionId = "link", Label = "Link", Description = "Use the selected node as the source for a dependency link.", Icon = "link", Tone = "neutral" },
            new() { ActionId = "validate", Label = "Validate", Description = "Open project validation tooling from this node.", Icon = "qa", Tone = "mint" },
            new() { ActionId = "test", Label = "Test", Description = "Open test planning and evidence flows.", Icon = "test", Tone = "warn" }
        };

        if (node.ObjectType == ProjectObjectType.PromptStep)
        {
            actions.AddRange(
            [
                new CanvasWorkbenchAction { ActionId = "branch", Label = "Branch", Description = "Create a prompt follow-up from this step.", Icon = "fork", Tone = "accent" },
                new CanvasWorkbenchAction { ActionId = "mark-used", Label = "Used", Description = "Mark this prompt step as consumed.", Icon = "use", Tone = "mint" },
                new CanvasWorkbenchAction { ActionId = "skip", Label = "Skip", Description = "Skip the selected prompt step.", Icon = "skip", Tone = "warn" }
            ]);
        }

        actions.AddRange(BuildCreatePalette(node.ObjectType));
        return actions;
    }

    private async Task HandleSelectionChangedAsync(CanvasWorkbenchSelectionChangedEventArgs args)
    {
        if (!string.IsNullOrWhiteSpace(linkModeSourceId) &&
            !string.IsNullOrWhiteSpace(args.PrimaryNodeId) &&
            !string.Equals(linkModeSourceId, args.PrimaryNodeId, StringComparison.Ordinal))
        {
            await ProjectWorkbenchService.LinkObjectsAsync(ProjectId, linkModeSourceId, args.PrimaryNodeId, ProjectObjectLinkKind.DependsOn);
            linkModeSourceId = null;
            await ReloadSurfaceAsync(args.PrimaryNodeId);
            return;
        }

        selectedNodeIds = args.SelectedNodeIds.ToList();
        await PersistSelectionAsync();
    }

    private async Task HandleNodesMovedAsync(CanvasWorkbenchNodesMovedEventArgs args)
    {
        foreach (var position in args.Positions)
        {
            await ProjectWorkbenchService.MoveObjectAsync(ProjectId, position.NodeId, position.X, position.Y);
        }

        await ReloadSurfaceAsync(selectedNodeIds.FirstOrDefault());
    }

    private async Task HandleCanvasStateChangedAsync(string stateJson)
    {
        if (surface is null)
        {
            return;
        }

        var uiState = CanvasWorkbenchUiState.Parse(stateJson);
        selectedNodeIds = uiState.SelectedNodeIds.ToList();
        currentViewStateJson = uiState.ToJson();
        surface = surface with { ViewStateJson = currentViewStateJson };
        RefreshCanvasSurface();
        await ProjectWorkbenchService.SaveViewStateAsync(ProjectId, "structure", currentViewStateJson);
    }

    private Task HandleNodeOpenedAsync(string nodeId)
        => ExecuteCommandAsync(ProjectStructureCommandKind.Open, nodeId);

    private async Task HandleContextActionAsync(CanvasWorkbenchContextActionRequest request)
        => await HandleCanvasActionAsync(request.ActionId, request.NodeId, request.X, request.Y);

    private async Task HandleCreateActionAsync(CanvasWorkbenchCreateActionRequest request)
    {
        if (TryResolveCreatedObjectType(request.ActionId, out var objectType))
        {
            await CreateObjectAsync(objectType, request);
        }
    }

    private async Task HandleNodeEditedAsync(CanvasWorkbenchNodeEditRequest request)
    {
        var targetNode = surface?.Nodes.FirstOrDefault(node => string.Equals(node.Id, request.NodeId, StringComparison.Ordinal));
        if (targetNode is null || targetNode.ObjectType != ProjectObjectType.Note)
        {
            return;
        }

        await ProjectWorkbenchService.UpdateObjectAsync(
            ProjectId,
            targetNode.Id,
            BuildSimpleNoteTitle(request.Notes),
            string.Empty,
            request.Notes);

        await ReloadSurfaceAsync(targetNode.Id);
    }

    private async Task HandleCanvasActionAsync(string actionId, string? nodeId, double x, double y)
    {
        if (TryResolveCreatedObjectType(actionId, out var objectType))
        {
            await CreateObjectAsync(
                objectType,
                new CanvasWorkbenchCreateActionRequest(
                    actionId,
                    nodeId,
                    x,
                    y,
                    nodeId,
                    string.Empty,
                    string.Empty,
                    string.Empty,
                    nodeId is null ? "canvas" : "child",
                    "command"));
            return;
        }

        switch (actionId)
        {
            case "link":
                linkModeSourceId = nodeId;
                break;
            case "branch":
                await ExecuteCommandAsync(ProjectStructureCommandKind.Branch, nodeId);
                break;
            case "mark-used":
                await ExecuteCommandAsync(ProjectStructureCommandKind.MarkUsed, nodeId);
                break;
            case "skip":
                await ExecuteCommandAsync(ProjectStructureCommandKind.Skip, nodeId);
                break;
            case "validate":
                await ExecuteCommandAsync(ProjectStructureCommandKind.Validate, nodeId);
                break;
            case "test":
                await ExecuteCommandAsync(ProjectStructureCommandKind.Test, nodeId);
                break;
            case "open":
                await HandleNodeOpenedAsync(nodeId ?? string.Empty);
                break;
        }
    }

    private async Task ExecuteCommandAsync(ProjectStructureCommandKind commandKind, string? nodeId = null)
    {
        var targetNodeId = nodeId ?? selectedNode?.Id;
        if (string.IsNullOrWhiteSpace(targetNodeId))
        {
            return;
        }

        var artifact = await ProjectWorkbenchService.ExecuteNodeCommandAsync(ProjectId, targetNodeId, commandKind);
        linkModeSourceId = null;
        await ReloadSurfaceAsync(targetNodeId);
        if (artifact is not null)
        {
            Navigation.NavigateTo(artifact.Route);
        }
    }

    private async Task CreateObjectAsync(ProjectObjectType objectType, CanvasWorkbenchCreateActionRequest request)
    {
        var sourceNode = surface?.Nodes.FirstOrDefault(node => string.Equals(node.Id, request.SourceNodeId, StringComparison.Ordinal));
        var parentNodeId = ResolveParentNodeId(sourceNode, request);
        var parentNode = surface?.Nodes.FirstOrDefault(node => string.Equals(node.Id, parentNodeId, StringComparison.Ordinal));
        var placement = ResolveCreatePlacement(sourceNode, parentNode, request);
        var title = ResolveCreatedTitle(objectType, request);
        var subtitle = request.Subtitle?.Trim() ?? string.Empty;
        var notes = ResolveCreatedNotes(objectType, request);

        var created = await ProjectWorkbenchService.CreateObjectAsync(
            ProjectId,
            new ProjectObjectCreateRequest(
                objectType,
                title,
                subtitle,
                notes,
                parentNodeId ?? $"project:{ProjectId}",
                placement.X,
                placement.Y));

        await ReloadSurfaceAsync(created.Id);
    }

    private async Task OpenCreateDialogAsync(ProjectObjectType objectType)
    {
        var action = BuildCreateAction(objectType);
        var sourceNode = selectedNode;
        var request = new CanvasWorkbenchCreateActionRequest(
            action.ActionId,
            sourceNode?.Id,
            sourceNode?.X ?? 0,
            sourceNode?.Y ?? 0,
            sourceNode?.Id,
            string.Empty,
            string.Empty,
            string.Empty,
            sourceNode is null ? "canvas" : "child",
            action.CreateMode);

        if (workbenchRef is not null)
        {
            await workbenchRef.OpenCreateDialogAsync(action, request);
            return;
        }

        await CreateObjectAsync(objectType, request);
    }

    private async Task SelectNodeAsync(string nodeId)
    {
        if (!string.IsNullOrWhiteSpace(linkModeSourceId) &&
            !string.Equals(linkModeSourceId, nodeId, StringComparison.Ordinal))
        {
            await ProjectWorkbenchService.LinkObjectsAsync(ProjectId, linkModeSourceId, nodeId, ProjectObjectLinkKind.DependsOn);
            linkModeSourceId = null;
            await ReloadSurfaceAsync(nodeId);
            return;
        }

        selectedNodeIds = [nodeId];
        await PersistSelectionAsync();
    }

    private async Task ClearSelectionAsync()
    {
        selectedNodeIds.Clear();
        await PersistSelectionAsync();
    }

    private async Task PersistSelectionAsync()
    {
        if (surface is null)
        {
            return;
        }

        var uiState = CanvasWorkbenchUiState.Parse(surface.ViewStateJson);
        uiState.SelectedNodeIds = [.. selectedNodeIds];
        currentViewStateJson = uiState.ToJson();
        surface = surface with { ViewStateJson = currentViewStateJson };
        RefreshCanvasSurface();
        await ProjectWorkbenchService.SaveViewStateAsync(ProjectId, "structure", currentViewStateJson);
    }

    private void EnableLinkMode()
        => linkModeSourceId = selectedNode?.Id;

    private IReadOnlyList<CanvasWorkbenchAction> BuildQuickCreateActions()
        => BuildCreatePalette(selectedNode?.ObjectType);

    private static IReadOnlyList<CanvasWorkbenchAction> BuildCreatePalette(ProjectObjectType? sourceType)
        => CreatableObjectTypes
            .OrderBy(objectType => ResolveCreateWeight(sourceType, objectType))
            .ThenBy(objectType => ResolveCreateSortName(objectType), StringComparer.OrdinalIgnoreCase)
            .Select(BuildCreateAction)
            .ToList();

    private static bool TryResolveCreatedObjectType(string actionId, out ProjectObjectType objectType)
    {
        foreach (var candidate in CreatableObjectTypes)
        {
            if (string.Equals(ResolveCreateActionId(candidate), actionId, StringComparison.Ordinal))
            {
                objectType = candidate;
                return true;
            }
        }

        objectType = default;
        return false;
    }

    private static ProjectObjectType ResolveCreatedObjectType(string actionId)
        => TryResolveCreatedObjectType(actionId, out var objectType)
            ? objectType
            : throw new InvalidOperationException($"Unknown create action '{actionId}'.");

    private (double? X, double? Y) ResolveCreatePlacement(ProjectStructureNode? sourceNode, ProjectStructureNode? parentNode, CanvasWorkbenchCreateActionRequest request)
    {
        if (request.X > 0 && request.Y > 0 && string.Equals(request.PlacementKind, "canvas", StringComparison.OrdinalIgnoreCase))
        {
            return (request.X, request.Y);
        }

        if (string.Equals(request.PlacementKind, "sibling", StringComparison.OrdinalIgnoreCase) && sourceNode is not null)
        {
            var existingSiblings = surface?.Nodes.Count(node => string.Equals(node.ParentId, sourceNode.ParentId, StringComparison.Ordinal)) ?? 0;
            return (
                sourceNode.X + ((existingSiblings % 2) * 24),
                sourceNode.Y + 132);
        }

        var anchorNode = parentNode ?? sourceNode;
        if (anchorNode is null)
        {
            return (request.X, request.Y);
        }

        var existingChildren = surface?.Nodes.Count(node => string.Equals(node.ParentId, anchorNode.Id, StringComparison.Ordinal)) ?? 0;
        var column = existingChildren % 3;
        var row = existingChildren / 3;
        return (
            anchorNode.X + 240 + (column * 46),
            anchorNode.Y - 70 + (row * 118));
    }

    private static string? ResolveParentNodeId(ProjectStructureNode? sourceNode, CanvasWorkbenchCreateActionRequest request)
    {
        if (!string.IsNullOrWhiteSpace(request.ParentNodeId))
        {
            return request.ParentNodeId;
        }

        return string.Equals(request.PlacementKind, "sibling", StringComparison.OrdinalIgnoreCase)
            ? sourceNode?.ParentId
            : sourceNode?.Id;
    }

    private static string ResolveCreatedTitle(ProjectObjectType objectType, CanvasWorkbenchCreateActionRequest request)
        => !string.IsNullOrWhiteSpace(request.Title)
            ? request.Title.Trim()
            : objectType switch
            {
                ProjectObjectType.Note when string.Equals(request.CreateMode, "quick-note", StringComparison.OrdinalIgnoreCase) => BuildSimpleNoteTitle(request.Notes),
                ProjectObjectType.Note => "New note",
                ProjectObjectType.Decision => "New decision",
                ProjectObjectType.Milestone => "New milestone",
                ProjectObjectType.Repository => "New repository",
                ProjectObjectType.File => "New file",
                ProjectObjectType.Link => "New link",
                ProjectObjectType.Connector => "New connector",
                ProjectObjectType.Phase => "New phase",
                ProjectObjectType.PromptFlow => "Prompt flow",
                ProjectObjectType.PromptSession => "Prompt session node",
                ProjectObjectType.PromptStep => "Prompt step",
                ProjectObjectType.ValidationRun => "Validation run",
                ProjectObjectType.TestPlan => "Test plan",
                ProjectObjectType.TestEvidence => "Test evidence",
                ProjectObjectType.SecretReference => "Secret reference",
                _ => objectType.ToString()
            };

    private static string ResolveCreatedNotes(ProjectObjectType objectType, CanvasWorkbenchCreateActionRequest request)
        => !string.IsNullOrWhiteSpace(request.Notes)
            ? request.Notes.Trim()
            : objectType == ProjectObjectType.Note && !string.IsNullOrWhiteSpace(request.Title)
                ? request.Title.Trim()
                : string.Empty;

    private static string BuildSimpleNoteTitle(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return "New note";
        }

        var normalized = text.Trim();
        return normalized.Length <= 64 ? normalized : $"{normalized[..61]}...";
    }


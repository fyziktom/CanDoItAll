@page "/projects/{ProjectId:guid}/structure"
@* codex-capsule
kind: page
name: ProjectStructurePage
summary: Hosts the project structure canvas, outline, graph authoring commands, and typed artifact actions.
owns: structure-canvas, node-outline, node-inspector
deps: ProjectWorkbenchService, NavigationManager
risks: stale-node-selection, invalid-command-routing
tests: component:ProjectStructurePageTests, e2e:workbench-structure
*@
@using CanDoItAll.ComponentKit.Components
@using CanDoItAll.SharedKernel
@inject ProjectWorkbenchService ProjectWorkbenchService
@inject NavigationManager Navigation

<PageTitle>Project Structure</PageTitle>

@if (surface is null)
{
    <p class="text-sm text-slate-500">Loading project structure...</p>
}
else
{
    <div class="space-y-6">
        <PageHeader Eyebrow="Workbench"
                    Title="@($"{surface.ProjectName} structure")"
                    Description="Author the project graph, create new work objects directly on the canvas, and open linked artifacts into the internal workspace." />

        <div class="grid gap-4 xl:grid-cols-[0.95fr_1.05fr]">
            <SectionCard Title="Structure canvas" Description="The JavaScript engine owns rendering, drag, zoom, pan, and context input while .NET keeps graph rules, persistence, and command routing.">
                <ProjectStructureCanvas Surface="surface"
                                        SelectedNodeId="selectedNodeId"
                                        SelectedNodeChanged="HandleSelectedNodeChanged"
                                        NodeMoved="HandleNodeMovedAsync"
                                        ContextActionRequested="HandleContextActionAsync"
                                        OpenNodeRequested="HandleOpenNodeAsync"
                                        ViewStateChanged="HandleViewStateChangedAsync" />
            </SectionCard>

            <div class="space-y-4">
                <SectionCard Title="Outline" Description="The outline mirrors the graph so dense canvases stay navigable and searchable.">
                    <div class="space-y-2">
                        @foreach (var node in surface.Nodes.OrderBy(node => node.ObjectType).ThenBy(node => node.Title))
                        {
                            <button type="button"
                                    class="w-full rounded-2xl border px-3 py-3 text-left text-sm @(selectedNodeId == node.Id ? "border-slate-900 bg-slate-900 text-white" : "border-slate-200 bg-slate-50 text-slate-700")"
                                    @onclick="() => selectedNodeId = node.Id">
                                <span class="block font-semibold">@node.Title</span>
                                <span class="mt-1 block text-xs @(selectedNodeId == node.Id ? "text-slate-200" : "text-slate-500")">@node.ObjectType · @node.Status</span>
                            </button>
                        }
                    </div>
                </SectionCard>

                <SectionCard Title="Inspector" Description="Selected nodes expose one typed action surface no matter where they were opened from.">
                    @if (selectedNode is null)
                    {
                        <p class="text-sm text-slate-500">Select a node to inspect it, create related objects, or open its linked artifact.</p>
                    }
                    else
                    {
                        <div class="space-y-4">
                            <div>
                                <div class="flex flex-wrap items-center gap-2">
                                    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">@selectedNode.ObjectType</p>
                                    @foreach (var badge in selectedNode.Badges)
                                    {
                                        <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.18em]" style="@($"background:{selectedNode.VisualProfile.AccentColor}18;color:{selectedNode.VisualProfile.AccentColor}")">@badge</span>
                                    }
                                </div>
                                <p class="mt-2 text-lg font-semibold text-slate-900">@selectedNode.Title</p>
                                <p class="mt-1 text-sm text-slate-600">@selectedNode.Subtitle</p>
                                <p class="mt-1 text-xs text-slate-500">@selectedNode.Status</p>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(linkModeSourceId))
                            {
                                <div class="rounded-2xl border border-amber-200 bg-amber-50 px-3 py-3 text-sm text-amber-800">
                                    Link mode is active. Select another node on the canvas or in the outline to create a dependency link.
                                </div>
                            }

                            <div class="grid grid-cols-3 gap-3">
                                @foreach (var command in Enum.GetValues<ProjectStructureCommandKind>())
                                {
                                    <button type="button"
                                            class="aspect-square rounded-2xl bg-slate-900 px-2 py-2 text-center text-xs font-semibold text-white [clip-path:polygon(25%_6%,75%_6%,100%_50%,75%_94%,25%_94%,0_50%)]"
                                            @onclick="() => ExecuteCommandAsync(command)">
                                        @command
                                    </button>
                                }
                            </div>

                            <div class="grid grid-cols-2 gap-2">
                                <button type="button" class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700" @onclick="() => CreateRelatedObjectAsync(ProjectObjectType.Note)">Add note</button>
                                <button type="button" class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700" @onclick="() => CreateRelatedObjectAsync(ProjectObjectType.Decision)">Add decision</button>
                                <button type="button" class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700" @onclick="() => CreateRelatedObjectAsync(ProjectObjectType.Milestone)">Add milestone</button>
                                <button type="button" class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700" @onclick="EnableLinkMode">Link selected</button>
                            </div>
                        </div>
                    }
                </SectionCard>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    private ProjectStructureSurface? surface;
    private string? selectedNodeId;
    private string? linkModeSourceId;

    private ProjectStructureNode? selectedNode => surface?.Nodes.FirstOrDefault(node => node.Id == selectedNodeId);

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        surface = await ProjectWorkbenchService.GetStructureAsync(ProjectId);
        selectedNodeId ??= TryReadSelectedNodeId(surface.ViewStateJson) ?? surface.Nodes.FirstOrDefault()?.Id;
    }

    private async Task HandleSelectedNodeChanged(string nodeId)
    {
        if (!string.IsNullOrWhiteSpace(linkModeSourceId) &&
            !string.Equals(linkModeSourceId, nodeId, StringComparison.Ordinal))
        {
            await ProjectWorkbenchService.LinkObjectsAsync(ProjectId, linkModeSourceId, nodeId, ProjectObjectLinkKind.DependsOn);
            linkModeSourceId = null;
            await LoadAsync();
            selectedNodeId = nodeId;
            return;
        }

        selectedNodeId = nodeId;
    }

    private async Task HandleNodeMovedAsync(ProjectNodeMoveRequest moveRequest)
        => await ProjectWorkbenchService.MoveObjectAsync(ProjectId, moveRequest.NodeId, moveRequest.X, moveRequest.Y);

    private async Task HandleContextActionAsync(ProjectCanvasContextActionRequest request)
    {
        switch (request.Action)
        {
            case "add-note":
                await CreateObjectAsync(ProjectObjectType.Note, request.NodeId, request.X, request.Y);
                break;
            case "add-decision":
                await CreateObjectAsync(ProjectObjectType.Decision, request.NodeId, request.X, request.Y);
                break;
            case "add-milestone":
                await CreateObjectAsync(ProjectObjectType.Milestone, request.NodeId, request.X, request.Y);
                break;
            case "add-repository":
                await CreateObjectAsync(ProjectObjectType.Repository, request.NodeId, request.X, request.Y);
                break;
            case "link":
                linkModeSourceId = request.NodeId;
                break;
            case "branch":
                await ExecuteCommandAsync(ProjectStructureCommandKind.Branch, request.NodeId);
                break;
            case "mark-used":
                await ExecuteCommandAsync(ProjectStructureCommandKind.MarkUsed, request.NodeId);
                break;
            case "skip":
                await ExecuteCommandAsync(ProjectStructureCommandKind.Skip, request.NodeId);
                break;
            case "validate":
                await ExecuteCommandAsync(ProjectStructureCommandKind.Validate, request.NodeId);
                break;
            case "test":
                await ExecuteCommandAsync(ProjectStructureCommandKind.Test, request.NodeId);
                break;
            case "open":
                await HandleOpenNodeAsync(request.NodeId ?? selectedNodeId ?? string.Empty);
                break;
        }
    }

    private async Task HandleOpenNodeAsync(string nodeId)
    {
        if (string.IsNullOrWhiteSpace(nodeId))
        {
            return;
        }

        selectedNodeId = nodeId;
        await ExecuteCommandAsync(ProjectStructureCommandKind.Open, nodeId);
    }

    private Task HandleViewStateChangedAsync(string stateJson)
        => ProjectWorkbenchService.SaveViewStateAsync(ProjectId, "structure", stateJson);

    private async Task ExecuteCommandAsync(ProjectStructureCommandKind commandKind, string? nodeId = null)
    {
        var targetNodeId = nodeId ?? selectedNodeId;
        if (string.IsNullOrWhiteSpace(targetNodeId))
        {
            return;
        }

        var artifact = await ProjectWorkbenchService.ExecuteNodeCommandAsync(ProjectId, targetNodeId, commandKind);
        surface = await ProjectWorkbenchService.GetStructureAsync(ProjectId);
        selectedNodeId = targetNodeId;
        linkModeSourceId = null;
        if (artifact is not null)
        {
            Navigation.NavigateTo(artifact.Route);
        }
    }

    private Task CreateRelatedObjectAsync(ProjectObjectType objectType)
        => CreateObjectAsync(objectType, selectedNodeId, null, null);

    private async Task CreateObjectAsync(ProjectObjectType objectType, string? parentNodeKey, double? x, double? y)
    {
        var created = await ProjectWorkbenchService.CreateObjectAsync(
            ProjectId,
            new ProjectObjectCreateRequest(
                objectType,
                objectType switch
                {
                    ProjectObjectType.Note => "New note",
                    ProjectObjectType.Decision => "New decision",
                    ProjectObjectType.Milestone => "New milestone",
                    ProjectObjectType.Repository => "New repository",
                    _ => objectType.ToString()
                },
                parentNodeKey is null ? "Canvas-created object" : $"Related to {selectedNode?.Title ?? "selection"}",
                string.Empty,
                parentNodeKey ?? $"project:{ProjectId}",
                x,
                y));

        surface = await ProjectWorkbenchService.GetStructureAsync(ProjectId);
        selectedNodeId = created.Id;
    }

    private void EnableLinkMode()
        => linkModeSourceId = selectedNodeId;

    private static string? TryReadSelectedNodeId(string? viewStateJson)
    {
        if (string.IsNullOrWhiteSpace(viewStateJson))
        {
            return null;
        }

        const string marker = "\"selectedNodeId\":\"";
        var start = viewStateJson.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        if (start < 0)
        {
            return null;
        }

        start += marker.Length;
        var end = viewStateJson.IndexOf('"', start);
        return end > start ? viewStateJson[start..end] : null;
    }
}

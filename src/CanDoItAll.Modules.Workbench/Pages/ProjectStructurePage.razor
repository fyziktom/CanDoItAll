    private CanvasWorkbenchWindowState ResolveWindowState(string key)
    {
        var uiState = ResolveEditableUiState();
        return uiState.WindowStates.TryGetValue(key, out var state)
            ? CanvasWorkbenchWindowState.Normalize(state)
            : new CanvasWorkbenchWindowState();
    }

    private CanvasWorkbenchWindowState ResolveHealthWindowState()
    {
        var uiState = ResolveEditableUiState();
        if (!uiState.WindowStates.TryGetValue(HealthWindowKey, out var state))
        {
            return CanvasWorkbenchWindowState.Normalize(new CanvasWorkbenchWindowState
            {
                IsVisible = false,
                Left = HealthWindowDefaultLeft
            });
        }

        if (state.HasCustomGeometry)
        {
            return CanvasWorkbenchWindowState.Normalize(state);
        }

        var offsetState = state.Clone();
        offsetState.Left = HealthWindowDefaultLeft;
        return CanvasWorkbenchWindowState.Normalize(offsetState);
    }

    private CanvasWorkbenchWindowState ResolveWindowStateForToggle(string key)
        => key switch
        {
            SelectionWindowKey => ResolveWindowState(key),
            HealthWindowKey => ResolveHealthWindowState(),
            ToolboxWindowKey => ResolveToolboxWindowState(),
            _ => ResolveWindowState(key)
        };

    private Task HandleSelectionWindowStateChangedAsync(CanvasWorkbenchWindowState state)
        => PersistWindowStateAsync(SelectionWindowKey, state);

    private Task HandleHealthWindowStateChangedAsync(CanvasWorkbenchWindowState state)
        => PersistWindowStateAsync(HealthWindowKey, state);

    private async Task ToggleWindowAsync(string key)
    {
        var state = ResolveWindowStateForToggle(key);
        if (!state.IsVisible)
        {
            state.IsVisible = true;
            state.IsMinimized = false;
        }
        else if (state.IsMinimized)
        {
            state.IsMinimized = false;
        }
        else
        {
            state.IsVisible = false;
            state.IsMinimized = false;
        }

        await PersistWindowStateAsync(key, state);
    }

    private async Task PersistWindowStateAsync(string key, CanvasWorkbenchWindowState state)
    {
        var uiState = ResolveEditableUiState();
        uiState.WindowStates[key] = CanvasWorkbenchWindowState.Normalize(state);
        await PersistCanvasUiStateAsync(uiState);
    }


@page "/projects/{ProjectId:guid}/structure"
@* codex-capsule
kind: page
name: ProjectStructurePage
summary: Hosts the shared project structure canvas, mirrored inspector, typed graph actions, and supporting outline tools.
owns: shared-structure-canvas, node-outline, mirrored-inspector
deps: ProjectWorkbenchService, NavigationManager
risks: stale-node-selection, invalid-command-routing, overlapping-create-placement
tests: component:ProjectStructurePageTests, e2e:workbench-structure
*@
@using CanDoItAll.Components.CanvasLib
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Modules.Projects
@using CanDoItAll.Modules.Workbench.CanvasAdapters
@using CanDoItAll.Modules.Workspace
@using CanDoItAll.SharedKernel
@inject ProjectsService ProjectsService
@inject ProjectWorkbenchService ProjectWorkbenchService
@inject IProjectStructureLocalFileOpener LocalFileOpener
@inject IProjectStructureRuntimeLauncher RuntimeLauncher
@inject WorkspaceService WorkspaceService
@inject ProviderExecutionService ProviderExecutionService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Project Structure</PageTitle>

@if (surface is null || canvasSurface is null)
{
    <CanvasWorkbenchStage Eyebrow="Structure canvas"
                          Title="Project structure workbench"
                          Description="Loading the shared canvas shell, mirrored inspector, and typed project graph.">
        <Canvas>
            <SkeletonStateOverlay Snapshot="@LoadingSkeletonSnapshot" />
        </Canvas>
    </CanvasWorkbenchStage>
}
else
{
    <div class="space-y-6 project-structure-page">
        <PageHeader Eyebrow="Workbench"
                    Title="@($"{surface.ProjectName} structure")"
                    Compact="true" />

        <CanvasWorkbenchStage Eyebrow="Structure canvas"
                              Title="@($"{surface.ProjectName} workbench")"
                              Description="The shared canvas system now owns the same authoring vocabulary, chrome, grouped create tooling, and inspector rhythm used across the canvas upgrades."
                              Stats="stageStats">
            <Canvas>
                <CanvasWorkbench Surface="canvasSurface"
                                 @ref="workbenchRef"
                                 SelectionChanged="HandleSelectionChangedAsync"
                                 NodesMoved="HandleNodesMovedAsync"
                                 ContextActionRequested="HandleContextActionAsync"
                                 CreateActionInvoked="HandleCreateActionAsync"
                                 NodeEdited="HandleNodeEditedAsync"
                                 NodeOpened="HandleNodeOpenedAsync"
                                 StateChanged="HandleCanvasStateChangedAsync">
                    <ToolbarLeftContent>
                        <div class="project-structure-toolbar-windows">
                            <button type="button"
                                    class="cw-toolbar-action project-structure-toolbar-toggle @(SelectionWindowState.IsVisible ? "is-active" : string.Empty)"
                                    title="Show or hide the selection panel"
                                    @onclick="@(() => ToggleWindowAsync(SelectionWindowKey))">
                                Inspector
                            </button>
                            <button type="button"
                                    class="cw-toolbar-action project-structure-toolbar-toggle @(HealthWindowState.IsVisible ? "is-active" : string.Empty)"
                                    title="Show or hide canvas health"
                                    @onclick="@(() => ToggleWindowAsync(HealthWindowKey))">
                                Health
                            </button>
                            <button type="button"
                                    class="cw-toolbar-action project-structure-toolbar-toggle @(ToolboxWindowState.IsVisible ? "is-active" : string.Empty)"
                                    data-testid="project-structure-toolbox-toggle"
                                    title="Show or hide the standard blocks toolbox"
                                    @onclick="@(() => ToggleWindowAsync(ToolboxWindowKey))">
                                Blocks
                            </button>
                            <button type="button"
                                    class="cw-toolbar-action"
                                    data-testid="project-structure-recompose-toolbar-button"
                                    title="Redistribute descendants under the selected node without changing relationships."
                                    disabled="@(!CanRecomposeSelectedBranch)"
                                    @onclick="RecomposeSelectedBranchAsync">
                                @(isSubtreeRecompositionInProgress ? "Recomposing" : "Recompose")
                            </button>
                        </div>
                    </ToolbarLeftContent>
                    <OverlayContent>
                        @if (ToolboxWindowState.IsVisible)
                        {
                            <CanvasFloatingWindow WindowId="@ToolboxWindowKey"
                                                  TestId="project-structure-toolbox-window"
                                                  AriaLabel="Project structure standard blocks toolbox"
                                                  Kicker="Standard blocks"
                                                  Title="Project structure toolbox"
                                                  Summary="Search the shared block catalog, drag the window where you need it, and create against the currently selected source."
                                                  BodyClass="project-structure-toolbox-window__body"
                                                  DefaultPlacement="top-left"
                                                  DefaultWidth="@ToolboxWindowDefaultWidth"
                                                  DefaultHeight="420"
                                                  MinWidth="320"
                                                  MinHeight="240"
                                                  MaxWidth="520"
                                                  MaxHeight="520"
                                                  State="@ToolboxWindowState"
                                                  StateChanged="HandleToolboxWindowStateChangedAsync">
                                <section class="cw-context-toolbox project-structure-toolbox"
                                         data-testid="project-structure-standard-blocks-toolbox">
                                    <div class="project-structure-toolbox__meta"
                                         data-testid="project-structure-toolbox-meta">
                                        <span class="cw-context-toolbox__count">@($"{ToolboxCreateGroups.Sum(group => group.Actions.Count)} items")</span>
                                        <span class="cw-node__chip">@ToolboxSourceLabel</span>
                                    </div>

                                    <input class="cw-context-toolbox__search project-structure-toolbox__search"
                                           type="search"
                                           placeholder="Search blocks, files, runtime, or infrastructure"
                                           @bind="structureToolboxSearchText"
                                           @bind:event="oninput" />

                                    <div class="cw-context-toolbox__body project-structure-toolbox__body">
                                        <div class="cw-context-toolbox__sections project-structure-toolbox__sections">
                                            @if (ToolboxCreateGroups.Count == 0)
                                            {
                                                <div class="cw-context-toolbox__empty">
                                                    <strong>No blocks match the current search.</strong>
                                                    <span>Clear the filter to restore the full catalog.</span>
                                                </div>
                                            }
                                            else
                                            {
                                                @foreach (var group in ToolboxCreateGroups)
                                                {
                                                    <section class="cw-context-toolbox__section"
                                                             data-testid="@($"project-structure-toolbox-group-shell-{group.Key}")">
                                                        <button type="button"
                                                                class="cw-context-toolbox__section-summary project-structure-toolbox__section-summary"
                                                                data-testid="@($"project-structure-toolbox-group-{group.Key}")"
                                                                aria-expanded="@(group.IsOpen ? "true" : "false")"
                                                                @onclick="@(() => ExpandToolboxGroup(group.Key))">
                                                            <span class="cw-context-toolbox__section-copy">
                                                                <strong>@group.Label</strong>
                                                                <small>@group.Description</small>
                                                            </span>
                                                            <span class="project-structure-toolbox__section-summary-meta">
                                                                <span class="cw-context-toolbox__section-badge tone-accent">@group.Actions.Count</span>
                                                                <span class="project-structure-toolbox__section-toggle-icon" aria-hidden="true">
                                                                    <Icon Name="@(group.IsOpen ? "expand_less" : "expand_more")" />
                                                                </span>
                                                            </span>
                                                        </button>
                                                        @if (group.IsOpen)
                                                        {
                                                            <div class="cw-context-toolbox__section-body"
                                                                 data-testid="@($"project-structure-toolbox-group-body-{group.Key}")">
                                                                <div class="cw-context-toolbox__item-list">
                                                                    @foreach (var action in group.Actions)
                                                                    {
                                                                        <button type="button"
                                                                                class="cw-context-toolbox__item"
                                                                                data-testid="@($"project-structure-toolbox-{action.ActionId}")"
                                                                                @onclick="@(() => OpenCreateDialogAsync(action))">
                                                                            <span class="cw-context-toolbox__item-icon">
                                                                                <Icon Name="@action.Icon" />
                                                                            </span>
                                                                            <span class="cw-context-toolbox__item-body">
                                                                                <strong>@action.Label</strong>
                                                                                <small>@action.Description</small>
                                                                            </span>
                                                                        </button>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                    </section>
                                                }
                                            }
                                        </div>
                                    </div>
                                </section>
                            </CanvasFloatingWindow>
                        }
                        @if (HealthWindowState.IsVisible)
                        {
                            <CanvasFloatingWindow WindowId="@HealthWindowKey"
                                                  TestId="project-structure-validation-window"
                                                  AriaLabel="Project structure canvas health"
                                                  Kicker="Canvas health"
                                                  Title="Canvas health"
                                                  Summary="Validation pressure stays in the canvas now, but the toolbar safe zone remains clear."
                                                  DefaultPlacement="top-left"
                                                  DefaultWidth="320"
                                                  DefaultHeight="326"
                                                  MinWidth="280"
                                                  MinHeight="220"
                                                  State="@HealthWindowState"
                                                  StateChanged="HandleHealthWindowStateChangedAsync">
                                <section class="project-structure-validation-overlay"
                                         aria-label="Project structure validation overlay"
                                         data-testid="project-structure-validation-overlay">
                                    <div class="project-structure-validation-overlay__header">
                                        <p class="cw-panel-kicker">Project validation overlay</p>
                                        <h3 class="cw-panel-title">Canvas health</h3>
                                        <p class="cw-panel-copy">Surface dependency and review issues directly in the structure canvas without blocking the toolbar.</p>
                                    </div>
                                    <div class="project-structure-validation-overlay__metrics">
                                        <div class="project-structure-validation-overlay__metric" data-validation-metric="blocked">
                                            <span>Blocked</span>
                                            <strong>@canvasValidationOverlay.BlockedCount</strong>
                                        </div>
                                        <div class="project-structure-validation-overlay__metric" data-validation-metric="review">
                                            <span>Review</span>
                                            <strong>@canvasValidationOverlay.ReviewCount</strong>
                                        </div>
                                        <div class="project-structure-validation-overlay__metric" data-validation-metric="priority">
                                            <span>Priority</span>
                                            <strong>@canvasValidationOverlay.PriorityCount</strong>
                                        </div>
                                        <div class="project-structure-validation-overlay__metric" data-validation-metric="selection">
                                            <span>Selected issues</span>
                                            <strong>@canvasValidationOverlay.SelectedIssueCount</strong>
                                        </div>
                                    </div>
                                    @if (canvasValidationOverlay.SpotlightNodes.Count > 0)
                                    {
                                        <div class="project-structure-validation-overlay__spotlight">
                                            <span>Spotlight</span>
                                            <ul>
                                                @foreach (var nodeTitle in canvasValidationOverlay.SpotlightNodes)
                                                {
                                                    <li>@nodeTitle</li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                    @if (selectedNode is not null && canvasValidationOverlay.SelectedIssueCount > 0)
                                    {
                                        <div class="project-structure-validation-overlay__actions">
                                            <button type="button"
                                                    class="cw-button"
                                                    data-tone="accent"
                                                    @onclick="RunSelectedValidationAsync">
                                                Validate selected
                                            </button>
                                        </div>
                                    }
                                </section>
                            </CanvasFloatingWindow>
                        }
                        @if (SelectionWindowState.IsVisible)
                        {
                            <CanvasFloatingWindow WindowId="@SelectionWindowKey"
                                                  TestId="project-structure-selection-window"
                                                  AriaLabel="Project structure selection panel"
                                                  Kicker="Selection panel"
                                                  Title="@SelectionWindowTitle"
                                                  Summary="@SelectionWindowSummary"
                                                  DefaultPlacement="top-right"
                                                  DefaultWidth="360"
                                                  DefaultHeight="360"
                                                  MinWidth="320"
                                                  MinHeight="240"
                                                  MaxWidth="520"
                                                  State="@SelectionWindowState"
                                                  StateChanged="HandleSelectionWindowStateChangedAsync">
                                <ProjectStructureSelectionPanel State="@SelectionPanelState"
                                                               ClearSelectionAsync="ClearSelectionAsync"
                                                               SelectNodeAsync="SelectNodeAsync"
                                                               ApplySelectionStatusAsync="ApplySelectionStatusAsync"
                                                               ApplySelectionProgressAsync="ApplySelectionProgressAsync"
                                                               ApplySelectionMarkerAsync="ApplySelectionMarkerAsync"
                                                               ApplySelectionPriorityAsync="ApplySelectionPriorityAsync"
                                                               SelectionBorderNameChangedAsync="UpdateSelectionBorderNameAsync"
                                                               CreateSelectionBorderAsync="CreateSelectionBorderAsync"
                                                               ClearSelectionBordersAsync="ClearSelectionBordersAsync"
                                                               ExecuteInspectorActionAsync="ExecuteSelectedInspectorActionAsync"
                                                               OpenToolboxAsync="OpenToolboxAsync"
                                                               OpenAttachmentLocallyAsync="OpenSelectedAttachmentLocallyAsync"
                                                               OpenAttachmentPreviewAsync="OpenSelectedAttachmentPreviewAsync"
                                                               OpenMermaidViewerAsync="OpenSelectedMermaidViewerAsync"
                                                               AdvancedDetailsHelpBody="@AdvancedDetailsHelpBody"
                                                               AdvancedDetailsHelpTip="@AdvancedDetailsHelpTip" />
                            </CanvasFloatingWindow>
                        }
                        <ProjectStructureDeferredSurface RenderKey="@CanvasOverlayRenderKey">
                            @if (projectHierarchyDialog is not null)
                            {
                                <div class="project-structure-preview-backdrop project-structure-preview-backdrop--canvas" @onclick="CloseProjectHierarchyDialog">
                                    <div class="project-structure-preview-dialog project-structure-summary-dialog"
                                         role="dialog"
                                         aria-modal="true"
                                         aria-label="@projectHierarchyDialog.Title"
                                         data-testid="project-structure-hierarchy-dialog"
                                         @onclick:stopPropagation="true">
                                        <div class="project-structure-preview-dialog__header">
                                            <div class="project-structure-preview-dialog__copy">
                                                <p class="cw-panel-kicker">Project hierarchy</p>
                                                <h3 class="cw-panel-title">@projectHierarchyDialog.Title</h3>
                                                <p class="cw-panel-copy">@projectHierarchyDialog.Copy</p>
                                            </div>
                                            <div class="project-structure-preview-dialog__actions">
                                                <button type="button"
                                                        class="cw-button"
                                                        data-tone="ghost"
                                                        @onclick="CloseProjectHierarchyDialog">
                                                    Close
                                                </button>
                                            </div>
                                        </div>
                                        <div class="project-structure-preview-dialog__body">
                                            @if (!string.IsNullOrWhiteSpace(projectHierarchyDialog.CurrentParentProjectTitle))
                                            {
                                                <div class="cw-panel-card">
                                                    <p class="cw-panel-kicker">Current parent</p>
                                                    <p class="cw-panel-copy">@projectHierarchyDialog.CurrentParentProjectTitle</p>
                                                </div>
                                            }
                                            <div class="cw-panel-card">
                                                <label class="cw-panel-copy" for="project-structure-hierarchy-project-select">
                                                    Project
                                                </label>
                                                <select id="project-structure-hierarchy-project-select"
                                                        class="cw-context-toolbox__search"
                                                        data-testid="project-structure-hierarchy-project-select"
                                                        value="@(projectHierarchyDialog.SelectedProjectId?.ToString() ?? string.Empty)"
                                                        @onchange="HandleProjectHierarchySelectionChanged">
                                                    <option value="">Select a project</option>
                                                    @foreach (var projectOption in projectHierarchyDialog.AvailableProjects)
                                                    {
                                                        <option value="@projectOption.Id">
                                                            @projectOption.Name
                                                        </option>
                                                    }
                                                </select>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(projectHierarchyDialog.Error))
                                            {
                                                <div class="project-structure-inline-feedback" data-tone="warn">
                                                    @projectHierarchyDialog.Error
                                                </div>
                                            }
                                        </div>
                                        <div class="project-structure-preview-dialog__actions">
                                            <button type="button"
                                                    class="cw-button"
                                                    data-tone="ghost"
                                                    @onclick="CloseProjectHierarchyDialog">
                                                Cancel
                                            </button>
                                            <button type="button"
                                                    class="cw-button"
                                                    data-tone="accent"
                                                    data-testid="project-structure-hierarchy-submit"
                                                    disabled="@(projectHierarchyDialog.AvailableProjects.Count == 0)"
                                                    @onclick="ExecuteProjectHierarchyCommandAsync">
                                                @projectHierarchyDialog.SubmitLabel
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (quickActionDialog is not null)
                            {
                                <div class="project-structure-preview-backdrop project-structure-preview-backdrop--canvas" @onclick="CloseQuickActionDialog">
                                    <div class="project-structure-preview-dialog project-structure-quick-action-dialog"
                                         role="dialog"
                                         aria-modal="true"
                                         aria-label="@($"{quickActionDialog.Title} quick actions")"
                                         data-testid="project-structure-node-quick-actions"
                                         @onclick:stopPropagation="true">
                                        <div class="project-structure-preview-dialog__header">
                                            <div class="project-structure-preview-dialog__copy">
                                                <p class="cw-panel-kicker">Node quick actions</p>
                                                <h3 class="cw-panel-title">@quickActionDialog.Title</h3>
                                                <p class="cw-panel-copy">@quickActionDialog.Copy</p>
                                            </div>

                                            <div class="project-structure-preview-dialog__actions">
                                                <span class="cw-node__chip">@quickActionDialog.NodeLabel</span>
                                                <button type="button" class="cw-button" data-tone="ghost" @onclick="CloseQuickActionDialog">Close</button>
                                            </div>
                                        </div>

                                        <div class="project-structure-preview-dialog__body project-structure-quick-action-dialog__body">
                                            <div class="project-structure-quick-action-grid">
                                                @foreach (var action in new[] { quickActionDialog.EditAction, quickActionDialog.PrimaryAction })
                                                {
                                                    <button type="button"
                                                            class="cw-button project-structure-quick-action-card"
                                                            data-tone="@action.Tone"
                                                            data-testid="@(action.ExecutionKind == ProjectStructureQuickActionExecutionKind.Edit ? "project-structure-quick-action-edit" : "project-structure-quick-action-primary")"
                                                            disabled="@action.IsDisabled"
                                                            @onclick="@(() => ExecuteQuickActionAsync(action))">
                                                        <span class="project-structure-quick-action-card__icon" aria-hidden="true">
                                                            <Icon Name="@action.Icon" />
                                                        </span>
                                                        <strong>@action.Label</strong>
                                                        <small>@action.Description</small>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (previewNode is not null)
                            {
                                <div class="project-structure-preview-backdrop project-structure-preview-backdrop--canvas" @onclick="CloseAttachmentPreview">
                                    <div class="project-structure-preview-dialog"
                                         role="dialog"
                                         aria-modal="true"
                                         aria-label="@($"{ResolveAttachmentDisplayName(previewNode)} preview")"
                                         @onclick:stopPropagation="true">
                                        <div class="project-structure-preview-dialog__header">
                                            <div class="project-structure-preview-dialog__copy">
                                                <p class="cw-panel-kicker">Canvas preview</p>
                                                <h3 class="cw-panel-title">@ResolveAttachmentDisplayName(previewNode)</h3>
                                                <p class="cw-panel-copy">@ResolveAttachmentLeadCopy(previewNode)</p>
                                            </div>

                                            <div class="project-structure-preview-dialog__actions">
                                                @if (CanShowLocalOpen(previewNode))
                                                {
                                                    <button type="button"
                                                            class="cw-button"
                                                            data-tone="primary"
                                                            @onclick="@(() => OpenAttachmentLocallyAsync(previewNode))">
                                                        Open locally
                                                    </button>
                                                }
                                                <a class="cw-button"
                                                   data-tone="ghost"
                                                   href="@previewNode.Route"
                                                   target="_blank"
                                                   rel="noopener noreferrer">
                                                    Open in new tab
                                                </a>
                                                <button type="button" class="cw-button" data-tone="primary" @onclick="CloseAttachmentPreview">Close</button>
                                            </div>
                                        </div>

                                        <div class="project-structure-preview-dialog__body">
                                            @switch (ResolveAttachmentPreviewKind(previewNode))
                                            {
                                                case AttachmentPreviewKind.Image:
                                                    <img class="project-structure-preview-dialog__media"
                                                         src="@previewNode.Route"
                                                         alt="@previewNode.Title" />
                                                    break;
                                                case AttachmentPreviewKind.Video:
                                                    <video class="project-structure-preview-dialog__media"
                                                           controls
                                                           preload="metadata"
                                                           src="@previewNode.Route"></video>
                                                    break;
                                                case AttachmentPreviewKind.Audio:
                                                    <audio class="project-structure-audio-preview project-structure-preview-dialog__audio"
                                                           controls
                                                           preload="metadata"
                                                           src="@previewNode.Route"></audio>
                                                    break;
                                                case AttachmentPreviewKind.Document:
                                                    <iframe class="project-structure-preview-dialog__frame"
                                                            src="@ResolveAttachmentPreviewSource(previewNode)"
                                                            title="@($"{ResolveAttachmentDisplayName(previewNode)} dialog preview")"></iframe>
                                                    break;
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </ProjectStructureDeferredSurface>
                    </OverlayContent>
                </CanvasWorkbench>
            </Canvas>
            <Supporting>
                <div class="cw-panel-card project-structure-support-card project-structure-support-card--outline">
                    <p class="cw-panel-kicker">Outline</p>
                    <h3 class="cw-panel-title">Project object index</h3>
                    <div class="cw-list project-structure-outline-list">
                        @foreach (var node in outlineNodes)
                        {
                            <button type="button"
                                    class="cw-list-item @(selectedNodeIds.Contains(node.Id, StringComparer.Ordinal) ? "is-active" : string.Empty)"
                                    @onclick="@(() => SelectNodeAsync(node.Id))">
                                <strong>@node.Title</strong>
                                <span>@($"{ProjectStructureCanvasCatalog.ResolveNodeLabel(node)} - {node.Status}")</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="cw-panel-card project-structure-support-card project-structure-support-card--health">
                    <p class="cw-panel-kicker">Canvas coverage</p>
                    <h3 class="cw-panel-title">Graph health</h3>
                    <div class="cw-summary-grid">
                        <div class="cw-summary-tile">
                            <span>Total nodes</span>
                            <strong>@surface.Nodes.Count</strong>
                        </div>
                        <div class="cw-summary-tile">
                            <span>Total links</span>
                            <strong>@surface.Links.Count</strong>
                        </div>
                        <div class="cw-summary-tile">
                            <span>Selected</span>
                            <strong>@selectedNodeIds.Count</strong>
                        </div>
                    </div>
                    <p class="cw-panel-copy">Cross-links, grouped create menus, media uploads, and typed child creation remain intact on the shared canvas substrate.</p>
                </div>
            </Supporting>
        </CanvasWorkbenchStage>

    </div>
}

<ProjectStructureDeferredSurface RenderKey="@SupportDialogRenderKey">
    @if (summaryDialog is not null)
    {
        <div class="project-structure-preview-backdrop" @onclick="CloseSummary">
            <div class="project-structure-preview-dialog project-structure-summary-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-label="@($"{summaryDialog.RootTitle} progress summary")"
                 @onclick:stopPropagation="true">
                <div class="project-structure-preview-dialog__header">
                    <div class="project-structure-preview-dialog__copy">
                        <p class="cw-panel-kicker">Progress summary</p>
                        <h3 class="cw-panel-title">@summaryDialog.RootTitle</h3>
                        <p class="cw-panel-copy">Hierarchy, inline status editing, and exports are generated from the same summary source.</p>
                    </div>
                    <div class="project-structure-preview-dialog__actions">
                        <button type="button" class="cw-button" data-tone="accent" @onclick="ExportSummaryWorkbookAsync">Export XLSX</button>
                        <button type="button" class="cw-button" data-tone="primary" @onclick="ExportSummaryGanttAsync">Export Gantt</button>
                        <button type="button" class="cw-button" data-tone="ghost" @onclick="CloseSummary">Close</button>
                    </div>
                </div>

                <div class="project-structure-preview-dialog__body">
                    <div class="cw-summary-grid">
                        <div class="cw-summary-tile">
                            <span>Done</span>
                            <strong>@summaryDialog.Summary.CompletedCount</strong>
                        </div>
                        <div class="cw-summary-tile">
                            <span>Active</span>
                            <strong>@summaryDialog.Summary.ActiveCount</strong>
                        </div>
                        <div class="cw-summary-tile">
                            <span>Blocked</span>
                            <strong>@summaryDialog.Summary.BlockedCount</strong>
                        </div>
                        <div class="cw-summary-tile">
                            <span>Review</span>
                            <strong>@summaryDialog.Summary.ReviewCount</strong>
                        </div>
                        <div class="cw-summary-tile">
                            <span>Undated</span>
                            <strong>@summaryDialog.Summary.UndatedCount</strong>
                        </div>
                    </div>

                    <div class="project-structure-summary-table">
                        @foreach (var row in summaryDialog.Summary.Rows)
                        {
                            <div class="project-structure-summary-row" style="@($"--summary-depth:{row.Depth};")">
                                <div class="project-structure-summary-row__node">
                                    <strong>@row.Title</strong>
                                    <span>@row.KindLabel</span>
                                </div>
                                <div class="project-structure-summary-row__meta">
                                    <span>@row.ProgressLabel</span>
                                    <span>@(row.StartUtc?.ToLocalTime().ToString("g") ?? "Undated")</span>
                                </div>
                                <select class="cw-context-toolbox__search project-structure-summary-row__select"
                                        value="@row.Status"
                                        @onchange="@(args => ChangeSummaryStatusAsync(row.NodeId, args))">
                                    @foreach (var statusOption in SummaryStatusOptions)
                                    {
                                        <option value="@statusOption">@statusOption</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @if (pendingDeletePrompt is not null)
    {
        <div class="project-structure-preview-backdrop" @onclick="CancelDelete">
            <div class="project-structure-preview-dialog project-structure-summary-dialog"
                 role="dialog"
                 aria-modal="true"

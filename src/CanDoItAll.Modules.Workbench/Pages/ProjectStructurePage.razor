    private async Task HandleSelectionChangedAsync(CanvasWorkbenchSelectionChangedEventArgs args)
    {
        if (!string.IsNullOrWhiteSpace(linkModeSourceId) &&
            !string.IsNullOrWhiteSpace(args.PrimaryNodeId) &&
            !string.Equals(linkModeSourceId, args.PrimaryNodeId, StringComparison.Ordinal))
        {
            await ProjectWorkbenchService.LinkObjectsAsync(ProjectId, linkModeSourceId, args.PrimaryNodeId, ProjectObjectLinkKind.DependsOn);
            linkModeSourceId = null;
            await ReloadSurfaceAsync(args.PrimaryNodeId);
            return;
        }

        selectedNodeIds = args.SelectedNodeIds.ToList();
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleNodesMovedAsync(CanvasWorkbenchNodesMovedEventArgs args)
    {
        foreach (var position in args.Positions)
        {
            await ProjectWorkbenchService.MoveObjectAsync(ProjectId, position.NodeId, position.X, position.Y);
        }

        await ReloadSurfaceAsync();

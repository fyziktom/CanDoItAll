    private static int ResolveCreateWeight(ProjectObjectType? sourceType, ProjectObjectType candidate)
    {
        ProjectObjectType[] ordered = sourceType switch
        {
            ProjectObjectType.ProjectRoot or ProjectObjectType.Phase or null =>
            [
                ProjectObjectType.Phase,
                ProjectObjectType.Milestone,
                ProjectObjectType.Note,
                ProjectObjectType.Decision,
                ProjectObjectType.Repository,
                ProjectObjectType.File,
                ProjectObjectType.Link,
                ProjectObjectType.Connector,
                ProjectObjectType.PromptSession,
                ProjectObjectType.PromptFlow,
                ProjectObjectType.PromptStep,
                ProjectObjectType.ValidationRun,
                ProjectObjectType.TestPlan,
                ProjectObjectType.TestEvidence,
                ProjectObjectType.SecretReference
            ],
            ProjectObjectType.PromptFlow or ProjectObjectType.PromptSession or ProjectObjectType.PromptStep =>
            [
                ProjectObjectType.PromptStep,
                ProjectObjectType.Note,
                ProjectObjectType.Decision,
                ProjectObjectType.PromptSession,
                ProjectObjectType.PromptFlow,
                ProjectObjectType.Link,
                ProjectObjectType.File,
                ProjectObjectType.ValidationRun,
                ProjectObjectType.TestPlan,
                ProjectObjectType.TestEvidence,
                ProjectObjectType.Repository,
                ProjectObjectType.Connector,
                ProjectObjectType.Milestone,
                ProjectObjectType.SecretReference,
                ProjectObjectType.Phase
            ],
            ProjectObjectType.Repository or ProjectObjectType.File or ProjectObjectType.Link or ProjectObjectType.Connector or ProjectObjectType.SecretReference =>
            [
                ProjectObjectType.File,
                ProjectObjectType.Link,
                ProjectObjectType.Connector,
                ProjectObjectType.Note,
                ProjectObjectType.Decision,
                ProjectObjectType.Repository,
                ProjectObjectType.SecretReference,
                ProjectObjectType.ValidationRun,
                ProjectObjectType.TestPlan,
                ProjectObjectType.TestEvidence,
                ProjectObjectType.Milestone,
                ProjectObjectType.PromptFlow,
                ProjectObjectType.PromptSession,
                ProjectObjectType.PromptStep,
                ProjectObjectType.Phase
            ],
            ProjectObjectType.ValidationRun or ProjectObjectType.TestPlan or ProjectObjectType.TestEvidence =>
            [
                ProjectObjectType.ValidationRun,
                ProjectObjectType.TestPlan,
                ProjectObjectType.TestEvidence,
                ProjectObjectType.Note,
                ProjectObjectType.Decision,
                ProjectObjectType.Link,
                ProjectObjectType.File,
                ProjectObjectType.Repository,
                ProjectObjectType.Connector,
                ProjectObjectType.SecretReference,
                ProjectObjectType.Milestone,
                ProjectObjectType.PromptFlow,
                ProjectObjectType.PromptSession,
                ProjectObjectType.PromptStep,
                ProjectObjectType.Phase
            ],
            _ =>
            [
                ProjectObjectType.Note,
                ProjectObjectType.Decision,
                ProjectObjectType.Milestone,
                ProjectObjectType.Link,
                ProjectObjectType.File,
                ProjectObjectType.Repository,
                ProjectObjectType.Connector,
                ProjectObjectType.PromptFlow,
                ProjectObjectType.PromptSession,
                ProjectObjectType.PromptStep,
                ProjectObjectType.ValidationRun,
                ProjectObjectType.TestPlan,
                ProjectObjectType.TestEvidence,
                ProjectObjectType.SecretReference,
                ProjectObjectType.Phase
            ]
        };

        var index = Array.IndexOf(ordered, candidate);
        return index >= 0 ? index : 100;
    }


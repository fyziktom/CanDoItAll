    private bool TryPatchSurfaceNodePositions(IReadOnlyCollection<CanvasWorkbenchNodePositionChange> positions)
    {
        if (surface is null || positions.Count == 0)
        {
            return false;
        }

        var positionsByNodeId = positions
            .Where(position => !string.IsNullOrWhiteSpace(position.NodeId))
            .GroupBy(position => position.NodeId, StringComparer.Ordinal)
            .ToDictionary(group => group.Key, group => group.Last(), StringComparer.Ordinal);
        if (positionsByNodeId.Count == 0)
        {
            return false;
        }

        var changed = false;
        var patchedNodes = surface.Nodes
            .Select(node =>
            {
                if (!positionsByNodeId.TryGetValue(node.Id, out var position) ||
                    (Math.Abs(node.X - position.X) < 0.001 && Math.Abs(node.Y - position.Y) < 0.001))
                {
                    return node;
                }

                changed = true;
                return node with
                {
                    X = position.X,
                    Y = position.Y
                };
            })
            .ToList();
        if (!changed)
        {
            return false;
        }

        surface = surface with { Nodes = patchedNodes };

        if (previewNode is not null)
        {
            previewNode = patchedNodes.FirstOrDefault(node => string.Equals(node.Id, previewNode.Id, StringComparison.Ordinal));
        }

        if (mermaidPreviewNode is not null)
        {
            mermaidPreviewNode = patchedNodes.FirstOrDefault(node => string.Equals(node.Id, mermaidPreviewNode.Id, StringComparison.Ordinal));
        }

        RefreshCanvasSurface();
        return true;
    }

    private void ScheduleCanvasViewStatePersistence()
    {
        if (surface is null || string.IsNullOrWhiteSpace(currentViewStateJson))
        {
            CancelPendingCanvasViewStatePersistence();
            return;
        }

        CancelPendingCanvasViewStatePersistence();
        var persistCts = new CancellationTokenSource();
        pendingCanvasViewStatePersistCts = persistCts;
        _ = PersistCanvasViewStateWhenIdleAsync(persistCts, currentViewStateJson);
    }

    private async Task PersistCanvasViewStateWhenIdleAsync(CancellationTokenSource persistCts, string? stateJson)
    {
        try
        {
            await Task.Delay(CanvasViewStatePersistDelayMs, persistCts.Token);
            if (persistCts.IsCancellationRequested || string.IsNullOrWhiteSpace(stateJson))
            {
                return;
            }

            await ProjectWorkbenchService.SaveViewStateAsync(ProjectId, "structure", stateJson);
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            if (ReferenceEquals(pendingCanvasViewStatePersistCts, persistCts))
            {
                pendingCanvasViewStatePersistCts = null;
            }

            persistCts.Dispose();
        }
    }

    private void CancelPendingCanvasViewStatePersistence()
    {
        var persistCts = pendingCanvasViewStatePersistCts;
        pendingCanvasViewStatePersistCts = null;
        if (persistCts is null)
        {
            return;
        }

        persistCts.Cancel();
        persistCts.Dispose();
    }

    private async Task PersistCurrentViewStateAsync()
    {
        CancelPendingCanvasViewStatePersistence();
        if (string.IsNullOrWhiteSpace(currentViewStateJson))
        {
            return;
        }

        await ProjectWorkbenchService.SaveViewStateAsync(ProjectId, "structure", currentViewStateJson);
    }


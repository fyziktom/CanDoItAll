@page "/projects/{ProjectId:guid}/structure"
@* codex-capsule
kind: page
name: ProjectStructurePage
summary: Hosts the shared project structure canvas, mirrored inspector, typed graph actions, and supporting outline tools.
owns: shared-structure-canvas, node-outline, mirrored-inspector
deps: ProjectWorkbenchService, NavigationManager
risks: stale-node-selection, invalid-command-routing, overlapping-create-placement
tests: component:ProjectStructurePageTests, e2e:workbench-structure
*@
@using CanDoItAll.Components.CanvasLib
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Modules.Workbench.CanvasAdapters
@using CanDoItAll.SharedKernel
@inject ProjectWorkbenchService ProjectWorkbenchService
@inject IProjectStructureLocalFileOpener LocalFileOpener
@inject NavigationManager Navigation

<PageTitle>Project Structure</PageTitle>

@if (surface is null || canvasSurface is null)
{
    <CanvasWorkbenchStage Eyebrow="Structure canvas"
                          Title="Project structure workbench"
                          Description="Loading the shared canvas shell, mirrored inspector, and typed project graph.">
        <Canvas>
            <SkeletonStateOverlay Snapshot="@LoadingSkeletonSnapshot" />
        </Canvas>
    </CanvasWorkbenchStage>
}
else
{
    <div class="space-y-6 project-structure-page">
        <PageHeader Eyebrow="Workbench"
                    Title="@($"{surface.ProjectName} structure")"
                    Compact="true" />

        <CanvasWorkbenchStage Eyebrow="Structure canvas"
                              Title="@($"{surface.ProjectName} workbench")"
                              Description="The shared canvas system now owns the same authoring vocabulary, chrome, grouped create tooling, and inspector rhythm used across the canvas upgrades."
                              Stats="stageStats">
            <Canvas>
                <CanvasWorkbench Surface="canvasSurface"
                                 @ref="workbenchRef"
                                 SelectionChanged="HandleSelectionChangedAsync"
                                 NodesMoved="HandleNodesMovedAsync"
                                 ContextActionRequested="HandleContextActionAsync"
                                 CreateActionInvoked="HandleCreateActionAsync"
                                 NodeEdited="HandleNodeEditedAsync"
                                 NodeOpened="HandleNodeOpenedAsync"
                                 StateChanged="HandleCanvasStateChangedAsync">
                    <ToolbarLeftContent>
                        <div class="project-structure-toolbar-windows">
                            <button type="button"
                                    class="cw-toolbar-action project-structure-toolbar-toggle @(SelectionWindowState.IsVisible ? "is-active" : string.Empty)"
                                    title="Show or hide the selection panel"
                                    @onclick="@(() => ToggleWindowAsync(SelectionWindowKey))">
                                Inspector
                            </button>
                            <button type="button"
                                    class="cw-toolbar-action project-structure-toolbar-toggle @(HealthWindowState.IsVisible ? "is-active" : string.Empty)"
                                    title="Show or hide canvas health"
                                    @onclick="@(() => ToggleWindowAsync(HealthWindowKey))">
                                Health
                            </button>
                        </div>
                    </ToolbarLeftContent>
                    <OverlayContent>
                        @if (HealthWindowState.IsVisible)
                        {
                            <CanvasFloatingWindow WindowId="@HealthWindowKey"
                                                  TestId="project-structure-validation-window"
                                                  AriaLabel="Project structure canvas health"
                                                  Kicker="Canvas health"
                                                  Title="Canvas health"
                                                  Summary="Validation pressure stays in the canvas now, but the toolbar safe zone remains clear."
                                                  DefaultPlacement="top-left"
                                                  DefaultWidth="320"
                                                  DefaultHeight="326"
                                                  MinWidth="280"
                                                  MinHeight="220"
                                                  State="@HealthWindowState"
                                                  StateChanged="HandleHealthWindowStateChangedAsync">
                                <section class="project-structure-validation-overlay"
                                         aria-label="Project structure validation overlay"
                                         data-testid="project-structure-validation-overlay">
                                    <div class="project-structure-validation-overlay__header">
                                        <p class="cw-panel-kicker">Project validation overlay</p>
                                        <h3 class="cw-panel-title">Canvas health</h3>
                                        <p class="cw-panel-copy">Surface dependency and review issues directly in the structure canvas without blocking the toolbar.</p>
                                    </div>
                                    <div class="project-structure-validation-overlay__metrics">
                                        <div class="project-structure-validation-overlay__metric" data-validation-metric="blocked">
                                            <span>Blocked</span>
                                            <strong>@canvasValidationOverlay.BlockedCount</strong>
                                        </div>
                                        <div class="project-structure-validation-overlay__metric" data-validation-metric="review">
                                            <span>Review</span>
                                            <strong>@canvasValidationOverlay.ReviewCount</strong>
                                        </div>
                                        <div class="project-structure-validation-overlay__metric" data-validation-metric="priority">
                                            <span>Priority</span>
                                            <strong>@canvasValidationOverlay.PriorityCount</strong>
                                        </div>
                                        <div class="project-structure-validation-overlay__metric" data-validation-metric="selection">
                                            <span>Selected issues</span>
                                            <strong>@canvasValidationOverlay.SelectedIssueCount</strong>
                                        </div>
                                    </div>
                                    @if (canvasValidationOverlay.SpotlightNodes.Count > 0)
                                    {
                                        <div class="project-structure-validation-overlay__spotlight">
                                            <span>Spotlight</span>
                                            <ul>
                                                @foreach (var nodeTitle in canvasValidationOverlay.SpotlightNodes)
                                                {
                                                    <li>@nodeTitle</li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                    @if (selectedNode is not null && canvasValidationOverlay.SelectedIssueCount > 0)
                                    {
                                        <div class="project-structure-validation-overlay__actions">
                                            <button type="button"
                                                    class="cw-button"
                                                    data-tone="accent"
                                                    @onclick="RunSelectedValidationAsync">
                                                Validate selected
                                            </button>
                                        </div>
                                    }
                                </section>
                            </CanvasFloatingWindow>
                        }
                        @if (SelectionWindowState.IsVisible)
                        {
                            <CanvasFloatingWindow WindowId="@SelectionWindowKey"
                                                  TestId="project-structure-selection-window"
                                                  AriaLabel="Project structure selection panel"
                                                  Kicker="Selection panel"
                                                  Title="@SelectionWindowTitle"
                                                  Summary="@SelectionWindowSummary"
                                                  DefaultPlacement="top-right"
                                                  DefaultWidth="420"
                                                  DefaultHeight="640"
                                                  MinWidth="320"
                                                  MinHeight="240"
                                                  MaxWidth="520"
                                                  State="@SelectionWindowState"
                                                  StateChanged="HandleSelectionWindowStateChangedAsync">
                @if (selectedNodes.Count == 0)
                {
                    <div class="cw-empty-state">
                        <p class="cw-panel-kicker">Canvas selection</p>
                        <h3>Select a project object</h3>
                        <p>Pick a node to edit its status, attachments, and next-step actions without leaving the canvas.</p>
                        <div class="cw-chip-row">
                            <span class="cw-node__chip">Click</span>
                            <span class="cw-node__chip">Ctrl + Shift + click</span>
                            <span class="cw-node__chip">Alt + drag</span>
                            <span class="cw-node__chip">Right-click</span>
                        </div>
                    </div>
                }
                else if (selectedNodes.Count > 1)
                {
                    <div class="space-y-4">
                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Multi-select</p>
                            <h3 class="cw-panel-title">@($"{selectedNodes.Count} nodes selected")</h3>
                            <p class="cw-panel-copy">Batch movement stays on the canvas. Shared status, progress, marker, priority, and grouping controls stay here.</p>
                            <div class="cw-button-row">
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="ClearSelectionAsync">Clear selection</button>
                                <button type="button" class="cw-button" data-tone="accent" @onclick="@(() => SelectNodeAsync(selectedNodes[0].Id))">Focus first</button>
                            </div>
                        </div>

                        <div class="cw-panel-card project-structure-batch-card">
                            @if (CanApplySelectionStatus)
                            {
                                <div class="project-structure-action-band">
                                    <span>Status</span>
                                    <div class="cw-button-row">
                                        <button type="button" class="cw-button" data-tone="warn" @onclick='@(() => ApplySelectionStatusAsync("In progress"))'>In progress</button>
                                        <button type="button" class="cw-button" data-tone="mint" @onclick='@(() => ApplySelectionStatusAsync("Done"))'>Done</button>
                                        <button type="button" class="cw-button" data-tone="ghost" @onclick='@(() => ApplySelectionStatusAsync("N/A"))'>N/A</button>
                                    </div>
                                </div>
                            }

                            <div class="project-structure-action-band">
                                <span>Progress</span>
                                <div class="cw-button-row">
                                    <button type="button" class="cw-button" data-tone="ghost" @onclick='@(() => ApplyProgressAsync(selectedNodeIds, "progress", 0))'>0%</button>
                                    <button type="button" class="cw-button" data-tone="ghost" @onclick='@(() => ApplyProgressAsync(selectedNodeIds, "progress", 25))'>25%</button>
                                    <button type="button" class="cw-button" data-tone="ghost" @onclick='@(() => ApplyProgressAsync(selectedNodeIds, "progress", 50))'>50%</button>
                                    <button type="button" class="cw-button" data-tone="mint" @onclick='@(() => ApplyProgressAsync(selectedNodeIds, "progress", 100))'>100%</button>
                                </div>
                            </div>

                            <div class="project-structure-action-band">
                                <span>Marker</span>
                                <div class="cw-button-row">
                                    <button type="button" class="cw-button" data-tone="accent" @onclick='@(() => ApplyMarkerAsync(selectedNodeIds, "question", "sky", "Question"))'>Question</button>
                                    <button type="button" class="cw-button" data-tone="ghost" @onclick='@(() => ApplyMarkerAsync(selectedNodeIds, "idea", "accent", "Idea"))'>Idea</button>
                                    <button type="button" class="cw-button" data-tone="warn" @onclick='@(() => ApplyMarkerAsync(selectedNodeIds, "risk", "danger", "Risk"))'>Risk</button>
                                    <button type="button" class="cw-button" data-tone="mint" @onclick='@(() => ApplyMarkerAsync(selectedNodeIds, string.Empty, string.Empty, string.Empty))'>Clear</button>
                                </div>
                            </div>

                            <div class="project-structure-action-band">
                                <span>Priority</span>
                                <div class="cw-button-row">
                                    <button type="button" class="cw-button" data-tone="warn" @onclick='@(() => ApplyPriorityAsync(selectedNodeIds, 1))'>P1</button>
                                    <button type="button" class="cw-button" data-tone="accent" @onclick='@(() => ApplyPriorityAsync(selectedNodeIds, 2))'>P2</button>
                                    <button type="button" class="cw-button" data-tone="ghost" @onclick='@(() => ApplyPriorityAsync(selectedNodeIds, 3))'>P3</button>
                                    <button type="button" class="cw-button" data-tone="mint" @onclick='@(() => ApplyPriorityAsync(selectedNodeIds, 0))'>Clear</button>
                                </div>
                            </div>

                            <div class="project-structure-action-band">
                                <span>Grouping</span>
                                <div class="cw-button-row">
                                    <button type="button" class="cw-button" data-tone="sky" @onclick="CreateSelectionBorderAsync">Border</button>
                                    <button type="button" class="cw-button" data-tone="ghost" @onclick="ClearSelectionBordersAsync">Clear border</button>
                                </div>
                            </div>
                        </div>

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Selected nodes</p>
                            <div class="cw-list">
                                @foreach (var node in selectedNodes)
                                {
                                    <button type="button" class="cw-list-item" @onclick="@(() => SelectNodeAsync(node.Id))">
                                        <strong>@node.Title</strong>
                                        <span>@($"{ProjectStructureCanvasCatalog.ResolveNodeLabel(node)} - {node.Status}")</span>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
                else if (selectedNode is not null)
                {
                    <div class="space-y-4">
                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">@ProjectStructureCanvasCatalog.ResolveNodeLabel(selectedNode)</p>
                            <h3 class="cw-panel-title">@selectedNode.Title</h3>
                            <p class="cw-panel-copy">@selectedNode.Subtitle</p>

                            <div class="cw-chip-row">
                                <span class="cw-node__chip tone-accent">@selectedNode.Status</span>
                                @foreach (var badge in selectedNode.Badges)
                                {
                                    <span class="cw-node__chip">@badge</span>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(linkModeSourceId))
                            {
                                <div class="cw-panel-card">
                                    <p class="cw-panel-kicker">Connect mode</p>
                                    <p class="cw-panel-copy">Select another node on the canvas or in the outline to create a dependency link from the active source.</p>
                                </div>
                            }

                            <div class="cw-summary-grid">
                                <div class="cw-summary-tile">
                                    <span>Artifact</span>
                                    <strong>@selectedNode.ArtifactKind</strong>
                                </div>
                                <div class="cw-summary-tile">
                                    <span>Kind</span>
                                    <strong>@selectedNode.VisualProfile.AccentBadge</strong>
                                </div>
                                <div class="cw-summary-tile">
                                    <span>Location</span>
                                    <strong>@($"{Math.Round(selectedNode.X)}, {Math.Round(selectedNode.Y)}")</strong>
                                </div>
                                <div class="cw-summary-tile">
                                    <span>Progress</span>
                                    <strong>@ResolveProgressLabel(selectedNode)</strong>
                                </div>
                                <div class="cw-summary-tile">
                                    <span>Priority</span>
                                    <strong>@ResolvePriorityLabel(selectedNode)</strong>
                                </div>
                                <div class="cw-summary-tile">
                                    <span>Marker</span>
                                    <strong>@ResolveMarkerLabel(selectedNode)</strong>
                                </div>
                            </div>
                        </div>

                        @if (HasManagedAttachment(selectedNode))
                        {
                            <div class="cw-panel-card">
                                <p class="cw-panel-kicker">Attachment preview</p>
                                <h3 class="cw-panel-title">@ResolveAttachmentDisplayName(selectedNode)</h3>
                                <p class="cw-panel-copy">@ResolveAttachmentLeadCopy(selectedNode)</p>

                                @switch (ResolveAttachmentPreviewKind(selectedNode))
                                {
                                    case AttachmentPreviewKind.Image:
                                        <img class="cw-media-preview" src="@selectedNode.Route" alt="@selectedNode.Title" />
                                        break;
                                    case AttachmentPreviewKind.Video:
                                        <video class="cw-media-preview" controls preload="metadata" src="@selectedNode.Route"></video>
                                        break;
                                    case AttachmentPreviewKind.Audio:
                                        <audio class="project-structure-audio-preview" controls preload="metadata" src="@selectedNode.Route"></audio>
                                        break;
                                    case AttachmentPreviewKind.Document:
                                        <iframe class="project-structure-document-preview"
                                                src="@ResolveAttachmentPreviewSource(selectedNode)"
                                                title="@($"{ResolveAttachmentDisplayName(selectedNode)} preview")"></iframe>
                                        break;
                                    default:
                                        <div class="project-structure-preview-empty">
                                            <strong>Inline preview is not available for this file type.</strong>
                                            <span>Open the attachment in a new tab when you need the raw browser viewer.</span>
                                        </div>
                                        break;
                                }

                                <div class="cw-chip-row">
                                    @if (!string.IsNullOrWhiteSpace(selectedNode.MediaOriginalFileName))
                                    {
                                        <span class="cw-node__chip">@selectedNode.MediaOriginalFileName</span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(ResolveAttachmentContentType(selectedNode)))
                                    {
                                        <span class="cw-node__chip">@ResolveAttachmentContentType(selectedNode)</span>
                                    }
                                </div>

                                <div class="cw-button-row">
                                    @if (CanShowLocalOpen(selectedNode))
                                    {
                                        <button type="button"
                                                class="cw-button"
                                                data-tone="primary"
                                                @onclick="@(() => OpenAttachmentLocallyAsync(selectedNode))">
                                            Open locally
                                        </button>
                                    }
                                    @if (CanRenderAttachmentPreview(selectedNode))
                                    {
                                        <button type="button"
                                                class="cw-button"
                                                data-tone="accent"
                                                @onclick="@(() => OpenAttachmentPreview(selectedNode))">
                                            Expand preview
                                        </button>
                                    }

                                    <a class="cw-button"
                                       data-tone="ghost"
                                       href="@selectedNode.Route"
                                       target="_blank"
                                       rel="noopener noreferrer">
                                        Open in new tab
                                    </a>
                                </div>

                                @if (IsLocalOpenFeedbackVisible(selectedNode))
                                {
                                    <div class="project-structure-inline-feedback" data-tone="@localOpenFeedbackTone">
                                        @localOpenFeedback
                                    </div>
                                }
                            </div>
                        }

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Node actions</p>
                            <div class="cw-button-row">
                                @foreach (var command in ResolveInspectorCommands(selectedNode))
                                {
                                    <button type="button" class="cw-button" data-tone="primary" @onclick="@(() => ExecuteCommandAsync(command))">@ResolveCommandLabel(command)</button>
                                }
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="EnableLinkMode">Connect selected</button>
                            </div>
                        </div>

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Create next to source</p>
                            <div class="cw-accordion-stack">
                                @foreach (var group in BuildInspectorCreateGroups(selectedNode.ObjectType))
                                {
                                    <details class="cw-accordion" open="@group.IsOpen">
                                        <summary class="cw-accordion__summary">
                                            <span>
                                                <strong>@group.Label</strong>
                                                <small>@group.Description</small>
                                            </span>
                                            <span class="cw-node__chip tone-accent">@($"{group.Actions.Count} tools")</span>
                                        </summary>
                                        <div class="cw-accordion__body">
                                            <div class="cw-button-grid">
                                                @foreach (var action in group.Actions)
                                                {
                                                    <button type="button"
                                                            class="cw-button"
                                                            data-tone="@action.Tone"
                                                            @onclick="@(() => OpenCreateDialogAsync(action))">
                                                        @action.Label
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </details>
                                }
                            </div>
                        </div>
                    </div>
                }
                            </CanvasFloatingWindow>
                        }
                    </OverlayContent>
                </CanvasWorkbench>
            </Canvas>
            <Supporting>
                <div class="cw-panel-card project-structure-support-card project-structure-support-card--outline">
                    <p class="cw-panel-kicker">Outline</p>
                    <h3 class="cw-panel-title">Project object index</h3>
                    <div class="cw-list project-structure-outline-list">
                        @foreach (var node in outlineNodes)
                        {
                            <button type="button"
                                    class="cw-list-item @(selectedNodeIds.Contains(node.Id, StringComparer.Ordinal) ? "is-active" : string.Empty)"
                                    @onclick="@(() => SelectNodeAsync(node.Id))">
                                <strong>@node.Title</strong>
                                <span>@($"{ProjectStructureCanvasCatalog.ResolveNodeLabel(node)} - {node.Status}")</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="cw-panel-card project-structure-support-card project-structure-support-card--health">
                    <p class="cw-panel-kicker">Canvas coverage</p>
                    <h3 class="cw-panel-title">Graph health</h3>
                    <div class="cw-summary-grid">
                        <div class="cw-summary-tile">
                            <span>Total nodes</span>
                            <strong>@surface.Nodes.Count</strong>
                        </div>
                        <div class="cw-summary-tile">
                            <span>Total links</span>
                            <strong>@surface.Links.Count</strong>
                        </div>
                        <div class="cw-summary-tile">
                            <span>Selected</span>
                            <strong>@selectedNodeIds.Count</strong>
                        </div>
                    </div>
                    <p class="cw-panel-copy">Cross-links, grouped create menus, media uploads, and typed child creation remain intact on the shared canvas substrate.</p>
                </div>
            </Supporting>
        </CanvasWorkbenchStage>

        <div class="grid gap-5 xl:grid-cols-2">
            <CanvasBoundaryCard TestHookId="project-structure-action-catalog-adapter"
                                       Label="Project Structure action catalog adapter"
                                       Title="Project Structure actions now flow through a dedicated domain catalog"
                                       Summary="Quick create, node context, group actions, and inspector create groups no longer need to be rebuilt inline in the page."
                                       StatePill="@(selectedNode is null ? "Canvas scope" : "Node scope")"
                                       Metrics="@ActionCatalogMetrics">
                <div class="grid gap-3 md:grid-cols-2">
                    <div class="rounded-[1.4rem] border border-slate-200 bg-white/85 px-4 py-4">
                        <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">Quick create</p>
                        <div class="mt-3 space-y-2">
                            @foreach (var action in ActionCatalogPreviewQuickActions.Take(4))
                            {
                                <div class="rounded-xl bg-slate-50 px-3 py-3 text-sm text-slate-800">@action.Label</div>
                            }
                        </div>
                    </div>
                    <div class="rounded-[1.4rem] border border-slate-200 bg-white/85 px-4 py-4">
                        <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">Context actions</p>
                        <div class="mt-3 space-y-2">
                            @foreach (var action in ActionCatalogPreviewContextActions.Take(4))
                            {
                                <div class="rounded-xl bg-slate-50 px-3 py-3 text-sm text-slate-800">@action.Label</div>
                            }
                        </div>
                    </div>
                </div>
            </CanvasBoundaryCard>

            <CanvasBoundaryCard TestHookId="project-structure-placement-policy"
                                       Label="Project Structure placement policy"
                                       Title="Create placement now normalizes through a dedicated policy"
                                       Summary="Sibling, child, and free-canvas placement resolve through one reusable rule set instead of living inline in create handlers."
                                       StatePill="@PlacementPreviewMode"
                                       Metrics="@PlacementPolicyMetrics">
                <div class="grid gap-3 md:grid-cols-2">
                    <div class="rounded-[1.4rem] border border-slate-200 bg-white/85 px-4 py-4">
                        <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">Resolved parent</p>
                        <p class="mt-2 text-sm text-slate-950">@PlacementPreviewParentLabel</p>
                    </div>
                    <div class="rounded-[1.4rem] border border-slate-200 bg-white/85 px-4 py-4">
                        <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">Resolved coordinates</p>
                        <p class="mt-2 text-sm text-slate-950">@PlacementPreviewCoordinates</p>
                    </div>
                </div>
            </CanvasBoundaryCard>
        </div>
    </div>
}

@if (previewNode is not null)
{
    <div class="project-structure-preview-backdrop" @onclick="CloseAttachmentPreview">
        <div class="project-structure-preview-dialog"
             role="dialog"
             aria-modal="true"
             aria-label="@($"{ResolveAttachmentDisplayName(previewNode)} preview")"
             @onclick:stopPropagation="true">
            <div class="project-structure-preview-dialog__header">
                <div class="project-structure-preview-dialog__copy">
                    <p class="cw-panel-kicker">Canvas preview</p>
                    <h3 class="cw-panel-title">@ResolveAttachmentDisplayName(previewNode)</h3>
                    <p class="cw-panel-copy">@ResolveAttachmentLeadCopy(previewNode)</p>
                </div>

                <div class="project-structure-preview-dialog__actions">
                    @if (CanShowLocalOpen(previewNode))
                    {
                        <button type="button"
                                class="cw-button"
                                data-tone="primary"
                                @onclick="@(() => OpenAttachmentLocallyAsync(previewNode))">
                            Open locally
                        </button>
                    }
                    <a class="cw-button"
                       data-tone="ghost"
                       href="@previewNode.Route"
                       target="_blank"
                       rel="noopener noreferrer">
                        Open in new tab
                    </a>
                    <button type="button" class="cw-button" data-tone="primary" @onclick="CloseAttachmentPreview">Close</button>
                </div>
            </div>

            <div class="project-structure-preview-dialog__body">
                @switch (ResolveAttachmentPreviewKind(previewNode))
                {
                    case AttachmentPreviewKind.Image:
                        <img class="project-structure-preview-dialog__media"
                             src="@previewNode.Route"
                             alt="@previewNode.Title" />
                        break;
                    case AttachmentPreviewKind.Video:
                        <video class="project-structure-preview-dialog__media"
                               controls
                               preload="metadata"
                               src="@previewNode.Route"></video>
                        break;
                    case AttachmentPreviewKind.Audio:
                        <audio class="project-structure-audio-preview project-structure-preview-dialog__audio"
                               controls
                               preload="metadata"
                               src="@previewNode.Route"></audio>
                        break;
                    case AttachmentPreviewKind.Document:
                        <iframe class="project-structure-preview-dialog__frame"
                                src="@ResolveAttachmentPreviewSource(previewNode)"
                                title="@($"{ResolveAttachmentDisplayName(previewNode)} dialog preview")"></iframe>
                        break;
                }
            </div>
        </div>
    </div>
}

@code {
    private const string SelectionWindowKey = "project-structure.selection";
    private const string HealthWindowKey = "project-structure.health";

    [Parameter]
    public Guid ProjectId { get; set; }

    private ProjectStructureSurface? surface;
    private CanvasWorkbenchSurface? canvasSurface;
    private CanvasWorkbench? workbenchRef;

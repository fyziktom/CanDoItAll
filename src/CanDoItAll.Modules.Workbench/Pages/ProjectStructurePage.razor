@page "/projects/{ProjectId:guid}/structure"
@* codex-capsule
kind: page
name: ProjectStructurePage
summary: Hosts the shared project structure canvas, mirrored inspector, typed graph actions, and supporting outline tools.
owns: shared-structure-canvas, node-outline, mirrored-inspector
deps: ProjectWorkbenchService, NavigationManager
risks: stale-node-selection, invalid-command-routing, overlapping-create-placement
tests: component:ProjectStructurePageTests, e2e:workbench-structure
*@
@using CanDoItAll.ComponentKit.Canvas
@using CanDoItAll.ComponentKit.Components
@using CanDoItAll.SharedKernel
@inject ProjectWorkbenchService ProjectWorkbenchService
@inject NavigationManager Navigation

<PageTitle>Project Structure</PageTitle>

@if (surface is null || canvasSurface is null)
{
    <p class="text-sm text-slate-500">Loading project structure...</p>
}
else
{
    <div class="space-y-6">
        <PageHeader Eyebrow="Workbench"
                    Title="@($"{surface.ProjectName} structure")"
                    Description="Operate the project graph from one shared canvas stage, mirrored inspector, and supporting outline surface." />

        <CanvasWorkbenchStage Eyebrow="Structure canvas"
                              Title="@($"{surface.ProjectName} workbench")"
                              Description="The shared canvas system now owns the same authoring vocabulary, chrome, grouped create tooling, and inspector rhythm used across the canvas upgrades."
                              Stats="stageStats">
            <Canvas>
                <CanvasWorkbench Surface="canvasSurface"
                                 @ref="workbenchRef"
                                 SelectionChanged="HandleSelectionChangedAsync"
                                 NodesMoved="HandleNodesMovedAsync"
                                 ContextActionRequested="HandleContextActionAsync"
                                 CreateActionInvoked="HandleCreateActionAsync"
                                 NodeEdited="HandleNodeEditedAsync"
                                 NodeOpened="HandleNodeOpenedAsync"
                                 StateChanged="HandleCanvasStateChangedAsync" />
            </Canvas>
            <Inspector>
                @if (selectedNodes.Count == 0)
                {
                    <div class="cw-empty-state">
                        <p class="cw-panel-kicker">Inspector</p>
                        <h3>Select a project object</h3>
                        <p>Selection drives the mirrored editor surface, typed actions, grouped create tooling, and adjacent create behavior.</p>
                        <div class="cw-chip-row">
                            <span class="cw-node__chip">Alt + drag</span>
                            <span class="cw-node__chip">Ctrl + Shift + click</span>
                            <span class="cw-node__chip">Right-click</span>
                        </div>
                    </div>
                }
                else if (selectedNodes.Count > 1)
                {
                    <div class="space-y-4">
                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Multi-select</p>
                            <h3 class="cw-panel-title">@($"{selectedNodes.Count} nodes selected")</h3>
                            <p class="cw-panel-copy">Batch movement is available on the canvas. The inspector stays readable by showing the current selection set, shared progress controls, and the adaptive border actions.</p>
                            <div class="cw-button-row">
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="ClearSelectionAsync">Clear selection</button>
                                <button type="button" class="cw-button" data-tone="accent" @onclick="@(() => SelectNodeAsync(selectedNodes[0].Id))">Focus first</button>
                                <button type="button" class="cw-button" data-tone="sky" @onclick="CreateSelectionBorderAsync">Border</button>
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="ClearSelectionBordersAsync">Clear border</button>
                                <button type="button" class="cw-button" data-tone="warn" @onclick='@(() => ApplySelectionStatusAsync("In progress"))'>In progress</button>
                                <button type="button" class="cw-button" data-tone="mint" @onclick='@(() => ApplySelectionStatusAsync("Done"))'>Done</button>
                                <button type="button" class="cw-button" data-tone="ghost" @onclick='@(() => ApplySelectionStatusAsync("N/A"))'>N/A</button>
                            </div>
                        </div>

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Selected nodes</p>
                            <div class="cw-list">
                                @foreach (var node in selectedNodes)
                                {
                                    <button type="button" class="cw-list-item" @onclick="@(() => SelectNodeAsync(node.Id))">
                                        <strong>@node.Title</strong>
                                        <span>@($"{ProjectStructureCanvasCatalog.ResolveNodeLabel(node)} - {node.Status}")</span>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
                else if (selectedNode is not null)
                {
                    <div class="space-y-4">
                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">@ProjectStructureCanvasCatalog.ResolveNodeLabel(selectedNode)</p>
                            <h3 class="cw-panel-title">@selectedNode.Title</h3>
                            <p class="cw-panel-copy">@selectedNode.Subtitle</p>

                            <div class="cw-chip-row">
                                <span class="cw-node__chip tone-accent">@selectedNode.Status</span>
                                @foreach (var badge in selectedNode.Badges)
                                {
                                    <span class="cw-node__chip">@badge</span>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(linkModeSourceId))
                            {
                                <div class="cw-panel-card">
                                    <p class="cw-panel-kicker">Connect mode</p>
                                    <p class="cw-panel-copy">Select another node on the canvas or in the outline to create a dependency link from the active source.</p>
                                </div>
                            }

                            <div class="cw-summary-grid">
                                <div class="cw-summary-tile">
                                    <span>Artifact</span>
                                    <strong>@selectedNode.ArtifactKind</strong>
                                </div>
                                <div class="cw-summary-tile">
                                    <span>Kind</span>
                                    <strong>@selectedNode.VisualProfile.AccentBadge</strong>
                                </div>
                                <div class="cw-summary-tile">
                                    <span>Location</span>
                                    <strong>@($"{Math.Round(selectedNode.X)}, {Math.Round(selectedNode.Y)}")</strong>
                                </div>
                            </div>
                        </div>

                        @if (selectedNode.ObjectType is ProjectObjectType.ImageAsset or ProjectObjectType.VideoAsset)
                        {
                            <div class="cw-panel-card">
                                <p class="cw-panel-kicker">Media preview</p>
                                <h3 class="cw-panel-title">Uploaded asset</h3>
                                @if (selectedNode.ObjectType == ProjectObjectType.ImageAsset)
                                {
                                    <img class="cw-media-preview" src="@selectedNode.Route" alt="@selectedNode.Title" />
                                }
                                else
                                {
                                    <video class="cw-media-preview" controls preload="metadata" src="@selectedNode.Route"></video>
                                }

                                <div class="cw-chip-row">
                                    @if (!string.IsNullOrWhiteSpace(selectedNode.MediaOriginalFileName))
                                    {
                                        <span class="cw-node__chip">@selectedNode.MediaOriginalFileName</span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(selectedNode.MediaContentType))
                                    {
                                        <span class="cw-node__chip">@selectedNode.MediaContentType</span>
                                    }
                                </div>
                            </div>
                        }

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Node actions</p>
                            <div class="cw-button-row">
                                @foreach (var command in Enum.GetValues<ProjectStructureCommandKind>())
                                {
                                    <button type="button" class="cw-button" data-tone="primary" @onclick="@(() => ExecuteCommandAsync(command))">@command</button>
                                }
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="EnableLinkMode">Connect selected</button>
                            </div>
                        </div>

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Create next to source</p>
                            <div class="cw-accordion-stack">
                                @foreach (var group in BuildInspectorCreateGroups(selectedNode.ObjectType))
                                {
                                    <details class="cw-accordion" open="@group.IsOpen">
                                        <summary class="cw-accordion__summary">
                                            <span>
                                                <strong>@group.Label</strong>
                                                <small>@group.Description</small>
                                            </span>
                                            <span class="cw-node__chip tone-accent">@($"{group.Actions.Count} tools")</span>
                                        </summary>
                                        <div class="cw-accordion__body">
                                            <div class="cw-button-grid">
                                                @foreach (var action in group.Actions)
                                                {
                                                    <button type="button"
                                                            class="cw-button"
                                                            data-tone="@action.Tone"
                                                            @onclick="@(() => OpenCreateDialogAsync(action))">
                                                        @action.Label
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </details>
                                }
                            </div>
                        </div>
                    </div>
                }
            </Inspector>
            <Supporting>
                <div class="cw-panel-card">
                    <p class="cw-panel-kicker">Outline</p>
                    <h3 class="cw-panel-title">Project object index</h3>
                    <div class="cw-list">
                        @foreach (var node in outlineNodes)
                        {
                            <button type="button"
                                    class="cw-list-item @(selectedNodeIds.Contains(node.Id, StringComparer.Ordinal) ? "is-active" : string.Empty)"
                                    @onclick="@(() => SelectNodeAsync(node.Id))">
                                <strong>@node.Title</strong>
                                <span>@($"{ProjectStructureCanvasCatalog.ResolveNodeLabel(node)} - {node.Status}")</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="cw-panel-card">
                    <p class="cw-panel-kicker">Canvas coverage</p>
                    <h3 class="cw-panel-title">Graph health</h3>
                    <div class="cw-summary-grid">
                        <div class="cw-summary-tile">
                            <span>Total nodes</span>
                            <strong>@surface.Nodes.Count</strong>
                        </div>
                        <div class="cw-summary-tile">
                            <span>Total links</span>
                            <strong>@surface.Links.Count</strong>
                        </div>
                        <div class="cw-summary-tile">
                            <span>Selected</span>
                            <strong>@selectedNodeIds.Count</strong>
                        </div>
                    </div>
                    <p class="cw-panel-copy">Cross-links, grouped create menus, media uploads, and typed child creation remain intact on the shared canvas substrate.</p>
                </div>
            </Supporting>
        </CanvasWorkbenchStage>
    </div>
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    private ProjectStructureSurface? surface;
    private CanvasWorkbenchSurface? canvasSurface;
    private CanvasWorkbench? workbenchRef;
    private List<string> selectedNodeIds = [];
    private string? linkModeSourceId;
    private string? currentViewStateJson;
    private Guid loadedProjectId;

    private IReadOnlyList<CanvasWorkbenchStat> stageStats =>
    [
        new() { Label = "Nodes", Value = surface?.Nodes.Count.ToString() ?? "0", Tone = "neutral" },
        new() { Label = "Links", Value = surface?.Links.Count.ToString() ?? "0", Tone = "accent" },
        new() { Label = "Selection", Value = selectedNodeIds.Count.ToString(), Tone = "mint" }
    ];

    private IReadOnlyList<ProjectStructureNode> outlineNodes =>
        surface?.Nodes
            .OrderBy(node => ResolveOutlineWeight(node.ObjectType))
            .ThenBy(node => node.Title, StringComparer.OrdinalIgnoreCase)
            .ToList() ?? [];

    private IReadOnlyList<ProjectStructureNode> selectedNodes =>
        surface?.Nodes.Where(node => selectedNodeIds.Contains(node.Id, StringComparer.Ordinal)).ToList() ?? [];

    private ProjectStructureNode? selectedNode => selectedNodes.FirstOrDefault();

    protected override async Task OnParametersSetAsync()
    {
        if (loadedProjectId != ProjectId)
        {
            loadedProjectId = ProjectId;
            currentViewStateJson = null;
            selectedNodeIds = [];
            linkModeSourceId = null;
        }

        await ReloadSurfaceAsync();
    }

    private async Task ReloadSurfaceAsync(string? preferredSelectionId = null)
    {
        var reloadedSurface = await ProjectWorkbenchService.GetStructureAsync(ProjectId);
        var uiState = !string.IsNullOrWhiteSpace(currentViewStateJson)
            ? CanvasWorkbenchUiState.Parse(currentViewStateJson)
            : CanvasWorkbenchUiState.Parse(reloadedSurface.ViewStateJson);
        selectedNodeIds = uiState.SelectedNodeIds
            .Where(id => reloadedSurface.Nodes.Any(node => string.Equals(node.Id, id, StringComparison.Ordinal)))
            .ToList();

        if (!string.IsNullOrWhiteSpace(preferredSelectionId) &&
            reloadedSurface.Nodes.Any(node => string.Equals(node.Id, preferredSelectionId, StringComparison.Ordinal)))
        {
            selectedNodeIds = [preferredSelectionId];
        }
        else if (selectedNodeIds.Count == 0)
        {
            var rootNodeId = ResolveRootNodeId(reloadedSurface.Nodes);
            if (!string.IsNullOrWhiteSpace(rootNodeId))
            {
                selectedNodeIds = [rootNodeId];
            }
        }

        uiState.SelectedNodeIds = [.. selectedNodeIds];
        ExpandSelectionAncestors(reloadedSurface.Nodes, uiState, selectedNodeIds);
        surface = reloadedSurface with { ViewStateJson = uiState.ToJson() };
        currentViewStateJson = surface.ViewStateJson;
        RefreshCanvasSurface();
    }

    private void RefreshCanvasSurface()
    {
        if (surface is null)
        {
            canvasSurface = null;
            return;
        }

        var uiState = CanvasWorkbenchUiState.Parse(surface.ViewStateJson);
        uiState.SelectedNodeIds = [.. selectedNodeIds];

        canvasSurface = new CanvasWorkbenchSurface
        {
            SurfaceId = $"project-structure:{surface.ProjectId:N}",
            Mode = "authoring",
            UiState = uiState,
            Chrome = new CanvasWorkbenchChrome
            {
                HintText = "Click to select, Ctrl + Shift + click to multi-select, Alt-drag to marquee, drag to move, and right-click for grouped project actions.",
                FocusActionLabel = "Focus root",
                ChildNoteActionId = "add-note",
                SiblingNoteActionId = "add-note",
                InlineNotePlaceholder = "Write note",
                QuickCreateActions = BuildQuickCreateActions().ToList(),
                GroupContextActions = BuildGroupContextActions().ToList()
            },
            Nodes = surface.Nodes.Select(MapCanvasNode).ToList(),
            Links = surface.Links.Select(link => new CanvasWorkbenchLink
            {
                SourceId = link.SourceId,
                TargetId = link.TargetId,
                Kind = link.Kind.ToString(),
                IsUserAuthored = link.IsUserAuthored
            }).ToList()
        };
    }

    private CanvasWorkbenchNode MapCanvasNode(ProjectStructureNode node)
    {
        var family = ResolveFamily(node.ObjectType);
        var hasChildren = surface?.Nodes.Any(candidate => string.Equals(candidate.ParentId, node.Id, StringComparison.Ordinal)) ?? false;
        var inlineText = string.IsNullOrWhiteSpace(node.Notes) ? node.Title : node.Notes;
        var isInlineTextNode = node.ObjectType == ProjectObjectType.Note && string.IsNullOrWhiteSpace(node.Subtitle);
        var progress = ResolveProgress(node);

        return new CanvasWorkbenchNode
        {
            Id = node.Id,
            ParentId = node.ParentId,
            Family = family,
            Kind = ProjectStructureCanvasCatalog.ResolveNodeLabel(node),
            Icon = node.VisualProfile.Icon,
            Title = node.Title,
            Subtitle = node.Subtitle,
            LeadText = BuildLeadText(node),
            Status = node.Status,
            BranchLabel = node.ObjectType is ProjectObjectType.Phase or ProjectObjectType.PromptSession ? "Branch" : string.Empty,
            AccentColor = node.VisualProfile.AccentColor,
            PaletteKey = ResolvePalette(node),
            DurationLabel = node.Badges.Contains("Scheduled", StringComparer.Ordinal) ? "Scheduled" : string.Empty,
            StatusPill = node.Status,
            ProgressMode = progress.Mode,
            ProgressPercent = progress.Percent,
            IsRequired = node.ObjectType is ProjectObjectType.ProjectRoot or ProjectObjectType.Phase or ProjectObjectType.PromptSession,
            IsCollapsible = hasChildren,
            IsInlineTextNode = isInlineTextNode,
            InlineText = inlineText,
            InlineTextPlaceholder = "Write note",
            X = node.X,
            Y = node.Y,
            Chips = BuildHeaderChips(node),
            FooterChips = BuildFooterChips(node),
            ContextActions = BuildContextActions(node)
        };
    }

    private static string ResolveFamily(ProjectObjectType objectType) => objectType switch
    {
        ProjectObjectType.ProjectRoot => "root",
        ProjectObjectType.Phase or ProjectObjectType.PromptSession or ProjectObjectType.PromptFlow or ProjectObjectType.ProjectBlock => "group",
        ProjectObjectType.ValidationRun or ProjectObjectType.TestPlan or ProjectObjectType.Decision or ProjectObjectType.SecretReference => "special",
        _ => "item"
    };

    private static string ResolvePalette(ProjectStructureNode node) => node.ObjectType switch
    {
        ProjectObjectType.Repository or ProjectObjectType.File => "sky",
        ProjectObjectType.ImageAsset or ProjectObjectType.Decision => "rose",
        ProjectObjectType.VideoAsset or ProjectObjectType.Link or ProjectObjectType.Connector => "violet",
        ProjectObjectType.Milestone or ProjectObjectType.TestPlan or ProjectObjectType.TestEvidence => "amber",
        ProjectObjectType.ValidationRun or ProjectObjectType.Note or ProjectObjectType.ProjectBlock => "mint",
        ProjectObjectType.SecretReference => "rose",
        _ => "neutral"
    };

    private static string BuildLeadText(ProjectStructureNode node)
    {
        if (node.ObjectType == ProjectObjectType.Note)
        {
            return string.IsNullOrWhiteSpace(node.Notes) ? node.Title : node.Notes;
        }

        if (node.ObjectType is ProjectObjectType.ImageAsset or ProjectObjectType.VideoAsset &&
            !string.IsNullOrWhiteSpace(node.MediaOriginalFileName))
        {
            return node.MediaOriginalFileName;
        }

        if (!string.IsNullOrWhiteSpace(node.Notes))
        {
            return node.Notes;
        }

        return string.IsNullOrWhiteSpace(node.Subtitle)
            ? $"Status: {node.Status}"
            : node.Subtitle;
    }

    private static List<CanvasWorkbenchChip> BuildHeaderChips(ProjectStructureNode node)
        => node.Badges.Select(badge => new CanvasWorkbenchChip { Text = badge, Tone = "accent" }).ToList();

    private static List<CanvasWorkbenchChip> BuildFooterChips(ProjectStructureNode node)
    {
        var chips = new List<CanvasWorkbenchChip>();
        if (!string.IsNullOrWhiteSpace(node.Route))
        {
            chips.Add(new CanvasWorkbenchChip { Text = "Routed", Tone = "neutral" });
        }

        if (node.ArtifactId.HasValue)
        {
            chips.Add(new CanvasWorkbenchChip { Text = "Artifact", Tone = "success" });
        }

        if (!string.IsNullOrWhiteSpace(node.MediaOriginalFileName))
        {
            chips.Add(new CanvasWorkbenchChip { Text = "Uploaded", Tone = "accent" });
        }

        return chips;
    }

    private List<CanvasWorkbenchAction> BuildContextActions(ProjectStructureNode node)
    {
        var actions = new List<CanvasWorkbenchAction>
        {
            new() { ActionId = "open", Label = "Open", Description = "Open the linked artifact or routed workspace.", Icon = "open", Tone = "accent" },
            new() { ActionId = "connect", Label = "Connect", Description = "Use the selected node as the source for a dependency link.", Icon = "link", Tone = "neutral" },
            new() { ActionId = "validate", Label = "Validate", Description = "Open project validation tooling from this node.", Icon = "qa", Tone = "mint" },
            new() { ActionId = "test", Label = "Test", Description = "Open test planning and evidence flows.", Icon = "test", Tone = "warn" }
        };

        if (node.ObjectType == ProjectObjectType.PromptStep)
        {
            actions.AddRange(
            [
                new CanvasWorkbenchAction { ActionId = "branch", Label = "Branch", Description = "Create a prompt follow-up from this step.", Icon = "fork", Tone = "accent" },
                new CanvasWorkbenchAction { ActionId = "mark-used", Label = "Used", Description = "Mark this prompt step as consumed.", Icon = "use", Tone = "mint" },
                new CanvasWorkbenchAction { ActionId = "skip", Label = "Skip", Description = "Skip the selected prompt step.", Icon = "skip", Tone = "warn" }
            ]);
        }

        actions.AddRange(ProjectStructureCanvasCatalog.BuildMenuCreateActions(node.ObjectType));
        return actions;
    }

    private static IReadOnlyList<CanvasWorkbenchAction> BuildGroupContextActions()
        =>
        [
            new CanvasWorkbenchAction
            {
                ActionId = "group-frame",
                Label = "Border",
                Description = "Create a living border around the selected branches.",
                Icon = "frame",
                Tone = "sky"
            },
            new CanvasWorkbenchAction
            {
                ActionId = "group-clear-frame",
                Label = "Clear border",
                Description = "Remove borders that currently contain the selected nodes.",
                Icon = "clear",
                Tone = "ghost"
            },
            new CanvasWorkbenchAction
            {
                ActionId = "group-progress",
                Label = "Progress",
                Description = "Update the shared progress marker for the selection.",
                Icon = "progress",
                Tone = "mint",
                Children =
                [
                    new CanvasWorkbenchAction
                    {
                        ActionId = "group-mark-in-progress",
                        Label = "In progress",
                        Description = "Show partial clockwise progress.",
                        Icon = "run",
                        Tone = "warn"
                    },
                    new CanvasWorkbenchAction
                    {
                        ActionId = "group-mark-done",
                        Label = "Done",
                        Description = "Mark the selection complete with the check marker.",
                        Icon = "done",
                        Tone = "mint"
                    },
                    new CanvasWorkbenchAction
                    {
                        ActionId = "group-mark-na",
                        Label = "N/A",
                        Description = "Show the neutral not-applicable state.",
                        Icon = "na",
                        Tone = "ghost"
                    }
                ]
            }
        ];

    private async Task HandleSelectionChangedAsync(CanvasWorkbenchSelectionChangedEventArgs args)
    {
        if (!string.IsNullOrWhiteSpace(linkModeSourceId) &&
            !string.IsNullOrWhiteSpace(args.PrimaryNodeId) &&
            !string.Equals(linkModeSourceId, args.PrimaryNodeId, StringComparison.Ordinal))
        {
            await ProjectWorkbenchService.LinkObjectsAsync(ProjectId, linkModeSourceId, args.PrimaryNodeId, ProjectObjectLinkKind.DependsOn);
            linkModeSourceId = null;
            await ReloadSurfaceAsync(args.PrimaryNodeId);
            return;
        }

        selectedNodeIds = args.SelectedNodeIds.ToList();
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleNodesMovedAsync(CanvasWorkbenchNodesMovedEventArgs args)
    {
        foreach (var position in args.Positions)
        {
            await ProjectWorkbenchService.MoveObjectAsync(ProjectId, position.NodeId, position.X, position.Y);
        }

        await ReloadSurfaceAsync();
    }

    private async Task HandleCanvasStateChangedAsync(string stateJson)
    {
        if (surface is null)
        {
            return;
        }

        var uiState = CanvasWorkbenchUiState.Parse(stateJson);
        selectedNodeIds = uiState.SelectedNodeIds.ToList();
        currentViewStateJson = uiState.ToJson();
        surface = surface with { ViewStateJson = currentViewStateJson };
        RefreshCanvasSurface();
        await ProjectWorkbenchService.SaveViewStateAsync(ProjectId, "structure", currentViewStateJson);
    }

    private Task HandleNodeOpenedAsync(string nodeId)
        => ExecuteCommandAsync(ProjectStructureCommandKind.Open, nodeId);

    private async Task HandleContextActionAsync(CanvasWorkbenchContextActionRequest request)
        => await HandleCanvasActionAsync(request.ActionId, request.NodeId, request.X, request.Y);

    private async Task HandleCreateActionAsync(CanvasWorkbenchCreateActionRequest request)
    {
        if (ProjectStructureCanvasCatalog.TryResolveCreateDefinition(request.ActionId, out var definition))
        {
            await CreateObjectAsync(definition, request);
        }
    }

    private async Task HandleNodeEditedAsync(CanvasWorkbenchNodeEditRequest request)
    {
        var targetNode = surface?.Nodes.FirstOrDefault(node => string.Equals(node.Id, request.NodeId, StringComparison.Ordinal));
        if (targetNode is null || targetNode.ObjectType != ProjectObjectType.Note)
        {
            return;
        }

        await ProjectWorkbenchService.UpdateObjectAsync(
            ProjectId,
            targetNode.Id,
            BuildSimpleNoteTitle(request.Notes),
            string.Empty,
            request.Notes);

        await ReloadSurfaceAsync(targetNode.Id);
    }

    private async Task HandleCanvasActionAsync(string actionId, string? nodeId, double x, double y)
    {
        if (ProjectStructureCanvasCatalog.TryResolveCreateDefinition(actionId, out var definition))
        {
            await CreateObjectAsync(
                definition,
                new CanvasWorkbenchCreateActionRequest(
                    actionId,
                    nodeId,
                    x,
                    y,
                    nodeId,
                    string.Empty,
                    string.Empty,
                    string.Empty,
                    nodeId is null ? "canvas" : "child",
                    "command",
                    definition.ObjectSubtype,
                    null));
            return;
        }

        switch (actionId)
        {
            case "connect":
                linkModeSourceId = nodeId;
                break;
            case "branch":
                await ExecuteCommandAsync(ProjectStructureCommandKind.Branch, nodeId);
                break;
            case "mark-used":
                await ExecuteCommandAsync(ProjectStructureCommandKind.MarkUsed, nodeId);
                break;
            case "skip":
                await ExecuteCommandAsync(ProjectStructureCommandKind.Skip, nodeId);
                break;
            case "validate":
                await ExecuteCommandAsync(ProjectStructureCommandKind.Validate, nodeId);
                break;
            case "test":
                await ExecuteCommandAsync(ProjectStructureCommandKind.Test, nodeId);
                break;
            case "open":
                await HandleNodeOpenedAsync(nodeId ?? string.Empty);
                break;
            case "group-frame":
                await CreateSelectionBorderAsync();
                break;
            case "group-clear-frame":
                await ClearSelectionBordersAsync();
                break;
            case "group-mark-in-progress":
                await ApplySelectionStatusAsync("In progress");
                break;
            case "group-mark-done":
                await ApplySelectionStatusAsync("Done");
                break;
            case "group-mark-na":
                await ApplySelectionStatusAsync("N/A");
                break;
        }
    }

    private async Task ExecuteCommandAsync(ProjectStructureCommandKind commandKind, string? nodeId = null)
    {
        var targetNodeId = nodeId ?? selectedNode?.Id;
        if (string.IsNullOrWhiteSpace(targetNodeId))
        {
            return;
        }

        var artifact = await ProjectWorkbenchService.ExecuteNodeCommandAsync(ProjectId, targetNodeId, commandKind);
        linkModeSourceId = null;
        await ReloadSurfaceAsync(targetNodeId);
        if (artifact is not null)
        {
            Navigation.NavigateTo(artifact.Route);
        }
    }

    private async Task CreateObjectAsync(ProjectStructureCreateLeafDefinition definition, CanvasWorkbenchCreateActionRequest request)
    {
        var sourceNode = surface?.Nodes.FirstOrDefault(node => string.Equals(node.Id, request.SourceNodeId, StringComparison.Ordinal));
        var parentNodeId = ResolveParentNodeId(sourceNode, request);
        var parentNode = surface?.Nodes.FirstOrDefault(node => string.Equals(node.Id, parentNodeId, StringComparison.Ordinal));
        var placement = ResolveCreatePlacement(sourceNode, parentNode, request);
        var title = ResolveCreatedTitle(definition, request);
        var subtitle = request.Subtitle?.Trim() ?? string.Empty;
        var notes = ResolveCreatedNotes(definition, request);
        var media = request.UploadedFile is null
            ? null
            : new ProjectObjectMediaPayload(
                request.UploadedFile.FileName,
                request.UploadedFile.ContentType,
                request.UploadedFile.Base64Data);

        var created = await ProjectWorkbenchService.CreateObjectAsync(
            ProjectId,
            new ProjectObjectCreateRequest(
                definition.ObjectType,
                title,
                subtitle,
                notes,
                parentNodeId ?? $"project:{ProjectId}",
                placement.X,
                placement.Y,
                null,
                null,
                string.IsNullOrWhiteSpace(request.ObjectSubtype) ? definition.ObjectSubtype : request.ObjectSubtype,
                media));

        await ReloadSurfaceAsync(created.Id);
    }

    private async Task OpenCreateDialogAsync(CanvasWorkbenchAction action)
    {
        var sourceNode = selectedNode;
        var request = new CanvasWorkbenchCreateActionRequest(
            action.ActionId,
            sourceNode?.Id,
            sourceNode?.X ?? 0,
            sourceNode?.Y ?? 0,
            sourceNode?.Id,
            string.Empty,
            string.Empty,
            string.Empty,
            sourceNode is null ? "canvas" : "child",
            action.CreateMode,
            action.ObjectSubtype,
            null);

        if (workbenchRef is not null)
        {
            await workbenchRef.OpenCreateDialogAsync(action, request);
            return;
        }

        if (ProjectStructureCanvasCatalog.TryResolveCreateDefinition(action.ActionId, out var definition))
        {
            await CreateObjectAsync(definition, request);
        }
    }

    private async Task SelectNodeAsync(string nodeId)
    {
        if (!string.IsNullOrWhiteSpace(linkModeSourceId) &&
            !string.Equals(linkModeSourceId, nodeId, StringComparison.Ordinal))
        {
            await ProjectWorkbenchService.LinkObjectsAsync(ProjectId, linkModeSourceId, nodeId, ProjectObjectLinkKind.DependsOn);
            linkModeSourceId = null;
            await ReloadSurfaceAsync(nodeId);
            return;
        }

        selectedNodeIds = [nodeId];
        await PersistSelectionAsync();
    }

    private async Task ClearSelectionAsync()
    {
        selectedNodeIds.Clear();
        await PersistSelectionAsync();
    }

    private async Task PersistSelectionAsync()
    {
        if (surface is null)
        {
            return;
        }

        var uiState = CanvasWorkbenchUiState.Parse(surface.ViewStateJson);
        uiState.SelectedNodeIds = [.. selectedNodeIds];
        ExpandSelectionAncestors(surface.Nodes, uiState, selectedNodeIds);
        currentViewStateJson = uiState.ToJson();
        surface = surface with { ViewStateJson = currentViewStateJson };
        RefreshCanvasSurface();
        await ProjectWorkbenchService.SaveViewStateAsync(ProjectId, "structure", currentViewStateJson);
    }

    private void EnableLinkMode()
        => linkModeSourceId = selectedNode?.Id;

    private IReadOnlyList<CanvasWorkbenchAction> BuildQuickCreateActions()
        => ProjectStructureCanvasCatalog.BuildMenuCreateActions(selectedNode?.ObjectType);

    private IReadOnlyList<ProjectStructureInspectorCreateGroup> BuildInspectorCreateGroups(ProjectObjectType? sourceType)
        => ProjectStructureCanvasCatalog.BuildInspectorCreateGroups(sourceType);

    private async Task ApplySelectionStatusAsync(string status)
    {
        var mutableNodeIds = selectedNodes
            .Where(IsCanvasStatusMutable)
            .Select(node => node.Id)
            .Distinct(StringComparer.Ordinal)
            .ToList();
        if (mutableNodeIds.Count == 0)
        {
            return;
        }

        await ProjectWorkbenchService.UpdateObjectStatusesAsync(ProjectId, mutableNodeIds, status);
        await ReloadSurfaceAsync();
    }

    private async Task CreateSelectionBorderAsync()
    {
        if (surface is null || selectedNodeIds.Count < 2)
        {
            return;
        }

        var uiState = ResolveEditableUiState();
        var normalizedSelection = selectedNodeIds
            .Where(id => surface.Nodes.Any(node => string.Equals(node.Id, id, StringComparison.Ordinal)))
            .Distinct(StringComparer.Ordinal)
            .ToList();
        if (normalizedSelection.Count < 2)
        {
            return;
        }

        var frames = uiState.GroupFrames
            .Where(frame => !FrameMatchesSelection(frame, normalizedSelection, surface.Nodes))
            .ToList();
        frames.Add(new CanvasWorkbenchGroupFrame
        {
            Id = $"frame-{Guid.NewGuid():N}",
            Label = BuildSelectionFrameLabel(),
            Tone = "sky",
            AnchorNodeIds = normalizedSelection
        });

        uiState.GroupFrames = frames;
        await PersistCanvasUiStateAsync(uiState);
    }

    private async Task ClearSelectionBordersAsync()
    {
        if (surface is null || selectedNodeIds.Count == 0)
        {
            return;
        }

        var uiState = ResolveEditableUiState();
        var retainedFrames = uiState.GroupFrames
            .Where(frame => !FrameMatchesSelection(frame, selectedNodeIds, surface.Nodes))
            .ToList();
        if (retainedFrames.Count == uiState.GroupFrames.Count)
        {
            return;
        }

        uiState.GroupFrames = retainedFrames;
        await PersistCanvasUiStateAsync(uiState);
    }

    private CanvasWorkbenchUiState ResolveEditableUiState()
        => CanvasWorkbenchUiState.Parse(currentViewStateJson ?? surface?.ViewStateJson);

    private async Task PersistCanvasUiStateAsync(CanvasWorkbenchUiState uiState)
    {
        if (surface is null)
        {
            return;
        }

        uiState.SelectedNodeIds = [.. selectedNodeIds];
        ExpandSelectionAncestors(surface.Nodes, uiState, selectedNodeIds);
        currentViewStateJson = uiState.ToJson();
        surface = surface with { ViewStateJson = currentViewStateJson };
        RefreshCanvasSurface();
        await ProjectWorkbenchService.SaveViewStateAsync(ProjectId, "structure", currentViewStateJson);
        await InvokeAsync(StateHasChanged);
    }

    private (double? X, double? Y) ResolveCreatePlacement(ProjectStructureNode? sourceNode, ProjectStructureNode? parentNode, CanvasWorkbenchCreateActionRequest request)
    {
        if (request.X > 0 && request.Y > 0 && string.Equals(request.PlacementKind, "canvas", StringComparison.OrdinalIgnoreCase))
        {
            return (request.X, request.Y);
        }

        if (string.Equals(request.PlacementKind, "sibling", StringComparison.OrdinalIgnoreCase) && sourceNode is not null)
        {
            var existingSiblings = surface?.Nodes.Count(node => string.Equals(node.ParentId, sourceNode.ParentId, StringComparison.Ordinal)) ?? 0;
            return (
                sourceNode.X + ((existingSiblings % 2) * 24),
                sourceNode.Y + 132);
        }

        var anchorNode = parentNode ?? sourceNode;
        if (anchorNode is null)
        {
            return (request.X, request.Y);
        }

        var existingChildren = surface?.Nodes.Count(node => string.Equals(node.ParentId, anchorNode.Id, StringComparison.Ordinal)) ?? 0;
        var column = existingChildren % 3;
        var row = existingChildren / 3;
        return (
            anchorNode.X + 240 + (column * 46),
            anchorNode.Y - 70 + (row * 118));
    }

    private static string? ResolveParentNodeId(ProjectStructureNode? sourceNode, CanvasWorkbenchCreateActionRequest request)
    {
        if (!string.IsNullOrWhiteSpace(request.ParentNodeId))
        {
            return request.ParentNodeId;
        }

        return string.Equals(request.PlacementKind, "sibling", StringComparison.OrdinalIgnoreCase)
            ? sourceNode?.ParentId
            : sourceNode?.Id;
    }

    private static string ResolveCreatedTitle(ProjectStructureCreateLeafDefinition definition, CanvasWorkbenchCreateActionRequest request)
        => !string.IsNullOrWhiteSpace(request.Title)
            ? request.Title.Trim()
            : definition.ObjectType switch
            {
                ProjectObjectType.Note when string.Equals(request.CreateMode, "quick-note", StringComparison.OrdinalIgnoreCase) => BuildSimpleNoteTitle(request.Notes),
                _ when request.UploadedFile is not null && !string.IsNullOrWhiteSpace(request.UploadedFile.FileName) => System.IO.Path.GetFileNameWithoutExtension(request.UploadedFile.FileName),
                _ => definition.DefaultTitle
            };

    private static string ResolveCreatedNotes(ProjectStructureCreateLeafDefinition definition, CanvasWorkbenchCreateActionRequest request)
        => !string.IsNullOrWhiteSpace(request.Notes)
            ? request.Notes.Trim()
            : definition.ObjectType == ProjectObjectType.Note && !string.IsNullOrWhiteSpace(request.Title)
                ? request.Title.Trim()
                : string.Empty;

    private string BuildSelectionFrameLabel()
        => selectedNodes.Count == 1
            ? selectedNodes[0].Title
            : $"{selectedNodes.Count} nodes";

    private static bool IsCanvasStatusMutable(ProjectStructureNode node)
        => node.Id.StartsWith("custom:", StringComparison.Ordinal);

    private static (string Mode, int Percent) ResolveProgress(ProjectStructureNode node)
    {
        var status = node.Status?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(status) ||
            status.Contains("n/a", StringComparison.OrdinalIgnoreCase) ||
            status.Contains("not applicable", StringComparison.OrdinalIgnoreCase) ||
            status.Contains("skip", StringComparison.OrdinalIgnoreCase))
        {
            return ("na", 0);
        }

        if (status.Contains("done", StringComparison.OrdinalIgnoreCase) ||
            status.Contains("complete", StringComparison.OrdinalIgnoreCase) ||
            status.Contains("approved", StringComparison.OrdinalIgnoreCase) ||
            status.Contains("used", StringComparison.OrdinalIgnoreCase) ||
            status.Contains("ready", StringComparison.OrdinalIgnoreCase) ||
            status.Contains("final", StringComparison.OrdinalIgnoreCase))
        {
            return ("complete", 100);
        }

        if (status.Contains("review", StringComparison.OrdinalIgnoreCase) ||
            status.Contains("validation", StringComparison.OrdinalIgnoreCase) ||
            status.Contains("testing", StringComparison.OrdinalIgnoreCase) ||
            status.Contains("qa", StringComparison.OrdinalIgnoreCase))
        {
            return ("progress", 78);
        }

        if (status.Contains("active", StringComparison.OrdinalIgnoreCase) ||
            status.Contains("in progress", StringComparison.OrdinalIgnoreCase) ||
            status.Contains("running", StringComparison.OrdinalIgnoreCase) ||
            status.Contains("blocked", StringComparison.OrdinalIgnoreCase))
        {
            return ("progress", 62);
        }

        if (status.Contains("planned", StringComparison.OrdinalIgnoreCase) ||
            status.Contains("draft", StringComparison.OrdinalIgnoreCase) ||
            status.Contains("pending", StringComparison.OrdinalIgnoreCase) ||
            status.Contains("queued", StringComparison.OrdinalIgnoreCase))
        {
            return ("progress", 28);
        }

        return ("progress", 48);
    }

    private static string BuildSimpleNoteTitle(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return "New note";
        }

        var normalized = text.Trim();
        return normalized.Length <= 64 ? normalized : $"{normalized[..61]}...";
    }

    private static bool FrameMatchesSelection(CanvasWorkbenchGroupFrame frame, IReadOnlyList<string> selectedIds, IReadOnlyList<ProjectStructureNode> nodes)
    {
        if (selectedIds.Count == 0 || frame.AnchorNodeIds.Count == 0)
        {
            return false;
        }

        var frameMembers = ExpandFrameMembers(frame.AnchorNodeIds, nodes);
        return selectedIds.All(frameMembers.Contains);
    }

    private static HashSet<string> ExpandFrameMembers(IReadOnlyList<string> anchorNodeIds, IReadOnlyList<ProjectStructureNode> nodes)
    {
        var childrenByParent = nodes
            .Where(node => !string.IsNullOrWhiteSpace(node.ParentId))
            .GroupBy(node => node.ParentId!, StringComparer.Ordinal)
            .ToDictionary(group => group.Key, group => group.Select(node => node.Id).ToList(), StringComparer.Ordinal);
        var expanded = new HashSet<string>(StringComparer.Ordinal);
        var queue = new Queue<string>(anchorNodeIds.Where(id => !string.IsNullOrWhiteSpace(id)));

        while (queue.Count > 0)
        {
            var nodeId = queue.Dequeue();
            if (!expanded.Add(nodeId))
            {
                continue;
            }

            if (!childrenByParent.TryGetValue(nodeId, out var children))
            {
                continue;
            }

            foreach (var child in children)
            {
                queue.Enqueue(child);
            }
        }

        return expanded;
    }

    private static int ResolveOutlineWeight(ProjectObjectType objectType) => objectType switch
    {
        ProjectObjectType.ProjectRoot => 0,
        ProjectObjectType.Phase => 1,
        ProjectObjectType.ProjectBlock => 2,
        ProjectObjectType.PromptFlow or ProjectObjectType.PromptSession => 3,
        ProjectObjectType.PromptStep => 4,
        _ => 5
    };

    private static string? ResolveRootNodeId(IReadOnlyList<ProjectStructureNode> nodes)
        => nodes.FirstOrDefault(node => node.ObjectType == ProjectObjectType.ProjectRoot)?.Id
            ?? nodes.FirstOrDefault(node => string.IsNullOrWhiteSpace(node.ParentId))?.Id
            ?? nodes.FirstOrDefault()?.Id;

    private static void ExpandSelectionAncestors(IReadOnlyList<ProjectStructureNode> nodes, CanvasWorkbenchUiState uiState, IReadOnlyList<string> selectedIds)
    {
        if (selectedIds.Count == 0)
        {
            return;
        }

        var collapsedIds = uiState.CollapsedNodeIds.ToHashSet(StringComparer.Ordinal);
        var nodesById = nodes.ToDictionary(node => node.Id, StringComparer.Ordinal);

        foreach (var selectedId in selectedIds)
        {
            if (!nodesById.TryGetValue(selectedId, out var current))
            {
                continue;
            }

            while (!string.IsNullOrWhiteSpace(current.ParentId) &&
                   nodesById.TryGetValue(current.ParentId, out var parent))
            {
                collapsedIds.Remove(parent.Id);
                current = parent;
            }
        }

        uiState.CollapsedNodeIds = [.. collapsedIds];
    }
}

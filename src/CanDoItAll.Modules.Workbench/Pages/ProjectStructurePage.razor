            {
                ProjectObjectType.Note when string.Equals(request.CreateMode, "quick-note", StringComparison.OrdinalIgnoreCase) => BuildSimpleNoteTitle(request.Notes),
                _ when request.UploadedFile is not null && !string.IsNullOrWhiteSpace(request.UploadedFile.FileName) => System.IO.Path.GetFileNameWithoutExtension(request.UploadedFile.FileName),
                _ => definition.DefaultTitle
            };


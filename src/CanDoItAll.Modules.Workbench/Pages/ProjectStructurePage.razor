    @if (mermaidPreviewNode is not null)
    {
        <div class="project-structure-preview-backdrop" @onclick="CloseMermaidViewer">
            <div class="project-structure-preview-dialog project-structure-summary-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-label="@($"{mermaidPreviewNode.Title} Mermaid viewer")"
                 @onclick:stopPropagation="true">
                <div class="project-structure-preview-dialog__header">
                    <div class="project-structure-preview-dialog__copy">
                        <p class="cw-panel-kicker">Mermaid viewer</p>
                        <h3 class="cw-panel-title">@mermaidPreviewNode.Title</h3>
                        <p class="cw-panel-copy">Detected diagram type: @ProjectObjectMetadataSerializer.DetectMermaidDiagramKind(mermaidPreviewNode.Notes)</p>
                    </div>
                    <div class="project-structure-preview-dialog__actions">
                        <button type="button" class="cw-button" data-tone="ghost" @onclick="CloseMermaidViewer">Close</button>
                    </div>
                </div>

                <div class="project-structure-preview-dialog__body">
                    <pre class="pf-components-toolbox__preview-content project-structure-mermaid-source">@mermaidPreviewNode.Notes</pre>
                </div>
            </div>
        </div>
    }
</ProjectStructureDeferredSurface>

@code {
    private const string SelectionWindowKey = "project-structure.selection";
    private const string HealthWindowKey = "project-structure.health";
    private const double ToolboxWindowDefaultWidth = 430;
    private const double DefaultCanvasWindowMargin = 16;
    private const double DefaultCanvasWindowGap = 16;
    private const double HealthWindowDefaultLeft = ToolboxWindowDefaultWidth + DefaultCanvasWindowMargin + DefaultCanvasWindowGap;

    [Parameter]
    public Guid ProjectId { get; set; }

    private ProjectStructureSurface? surface;
    private CanvasWorkbenchSurface? canvasSurface;
    private CanvasWorkbench? workbenchRef;
    private readonly ProjectStructureActionCatalogAdapter actionCatalog = new();
    private readonly ProjectStructureGraphAdapter graphAdapter = new();
    private readonly ProjectStructurePlacementPolicy placementPolicy = new();
    private List<string> selectedNodeIds = [];
    private string? linkModeSourceId;
    private string? currentViewStateJson;
    private const int CanvasViewStatePersistDelayMs = 420;
    private CancellationTokenSource? pendingCanvasViewStatePersistCts;
    private string? pendingClientSelectionId;
    private ProjectStructureNode? previewNode;
    private string? localOpenFeedback;
    private string? localOpenFeedbackNodeId;
    private string localOpenFeedbackTone = "neutral";
    private Guid loadedProjectId;
    private string? pendingWorkbenchSelectionId;

    private IReadOnlyList<CanvasWorkbenchStat> stageStats =>
    [
        new() { Label = "Nodes", Value = surface?.Nodes.Count.ToString() ?? "0", Tone = "neutral" },
        new() { Label = "Links", Value = surface?.Links.Count.ToString() ?? "0", Tone = "accent" },
        new() { Label = "Selection", Value = selectedNodeIds.Count.ToString(), Tone = "mint" }
    ];

    private SkeletonStateOverlaySnapshot LoadingSkeletonSnapshot
        => SkeletonStateOverlayFactory.CreateLoadingSnapshot(
            "Loading project structure",
            "Shared loading chrome keeps the stage, toolbar, and inspector rhythm stable while the canvas model is still being projected.");

    private ProjectStructureValidationOverlaySummary canvasValidationOverlay
        => surface is null
            ? new ProjectStructureValidationOverlaySummary(false, 0, 0, 0, 0, [])
            : ProjectStructureValidationOverlay.BuildSummary(surface, selectedNodeIds);

    private IReadOnlyList<ProjectStructureNode> outlineNodes =>
        surface?.Nodes
            .OrderBy(node => ResolveOutlineWeight(node.ObjectType))
            .ThenBy(node => node.Title, StringComparer.OrdinalIgnoreCase)
            .ToList() ?? [];

    private IReadOnlyList<ProjectStructureNode> selectedNodes =>
        surface?.Nodes.Where(node => selectedNodeIds.Contains(node.Id, StringComparer.Ordinal)).ToList() ?? [];

    private ProjectStructureNode? selectedNode => selectedNodes.FirstOrDefault();
    private CanvasWorkbenchWindowState SelectionWindowState => ResolveWindowState(SelectionWindowKey);
    private CanvasWorkbenchWindowState HealthWindowState => ResolveHealthWindowState();
    private string SelectionWindowTitle
        => selectedNodes.Count switch
        {
            0 => "Selection",
            1 => selectedNode?.Title ?? "Selection",
            _ => $"{selectedNodes.Count} selected"
        };
    private string SelectionWindowSummary
        => selectedNodes.Count switch
        {
            0 => "Keep the next action, attachment preview, and selection guidance inside the canvas.",
            1 => "Inspect the current node, jump into attachments, and create adjacent work without leaving the canvas.",
            _ => "Batch-update shared fields, review the selection set, and keep grouping actions close to the canvas."
        };
    private bool CanApplySelectionStatus => selectedNodes.Count > 0 && selectedNodes.All(IsCanvasStatusMutable);
    private Task RunSelectedValidationAsync()
        => selectedNode is null
            ? Task.CompletedTask
            : ExecuteCommandAsync(ProjectStructureCommandKind.Validate, selectedNode.Id);

    protected override async Task OnParametersSetAsync()
    {
        if (loadedProjectId != ProjectId)
        {
            loadedProjectId = ProjectId;
            currentViewStateJson = null;
            selectedNodeIds = [];
            linkModeSourceId = null;
            pendingClientSelectionId = null;
        }

        await ReloadSurfaceAsync();
    }

    private async Task ReloadSurfaceAsync(string? preferredSelectionId = null)
    {
        CancelPendingCanvasViewStatePersistence();
        pendingWorkbenchSelectionId = null;
        var reloadedSurface = await ProjectWorkbenchService.GetStructureAsync(ProjectId);
        var uiState = NormalizePersistedCanvasUiState(
            !string.IsNullOrWhiteSpace(currentViewStateJson)
                ? CanvasWorkbenchUiState.Parse(currentViewStateJson)
                : CanvasWorkbenchUiState.Parse(reloadedSurface.ViewStateJson));
        if (string.IsNullOrWhiteSpace(currentViewStateJson))
        {
            uiState.ShowMinimap = false;
        }

        if (previewNode is not null)
        {
            previewNode = reloadedSurface.Nodes.FirstOrDefault(node => string.Equals(node.Id, previewNode.Id, StringComparison.Ordinal));
        }

        if (quickActionDialog is not null)
        {
            var dialogNode = reloadedSurface.Nodes.FirstOrDefault(node => string.Equals(node.Id, quickActionDialog.NodeId, StringComparison.Ordinal));
            quickActionDialog = dialogNode is null ? null : BuildQuickActionDialog(dialogNode);
        }

        selectedNodeIds = uiState.SelectedNodeIds
            .Where(id => reloadedSurface.Nodes.Any(node => string.Equals(node.Id, id, StringComparison.Ordinal)))
            .ToList();

        if (!string.IsNullOrWhiteSpace(preferredSelectionId) &&
            reloadedSurface.Nodes.Any(node => string.Equals(node.Id, preferredSelectionId, StringComparison.Ordinal)))
        {
            selectedNodeIds = [preferredSelectionId];
            pendingClientSelectionId = preferredSelectionId;
            pendingWorkbenchSelectionId = preferredSelectionId;
        }
        else if (selectedNodeIds.Count == 0)
        {
            var rootNodeId = ResolveRootNodeId(reloadedSurface.Nodes);
            if (!string.IsNullOrWhiteSpace(rootNodeId))
            {
                selectedNodeIds = [rootNodeId];
            }

            pendingClientSelectionId = null;
        }
        else
        {
            pendingClientSelectionId = null;
        }

        uiState.SelectedNodeIds = [.. selectedNodeIds];
        graphAdapter.ExpandSelectionAncestors(reloadedSurface.Nodes, uiState, selectedNodeIds);
        surface = reloadedSurface with { ViewStateJson = uiState.ToJson() };
        currentViewStateJson = surface.ViewStateJson;
        RefreshCanvasSurface();
    }

    private async Task ApplySurfaceNodeUpdatesAsync(IReadOnlyCollection<ProjectStructureNode> updatedNodes)
    {
        if (surface is null || updatedNodes.Count == 0)
        {
            return;
        }

        var updatedById = updatedNodes
            .Where(node => !string.IsNullOrWhiteSpace(node.Id))
            .GroupBy(node => node.Id, StringComparer.Ordinal)
            .ToDictionary(group => group.Key, group => group.Last(), StringComparer.Ordinal);
        if (updatedById.Count == 0)
        {
            return;
        }

        var patchedNodes = surface.Nodes
            .Select(node => updatedById.TryGetValue(node.Id, out var updated) ? updated : node)
            .ToList();
        surface = surface with { Nodes = patchedNodes };

        var availableNodeIds = patchedNodes
            .Select(node => node.Id)
            .ToHashSet(StringComparer.Ordinal);
        selectedNodeIds = selectedNodeIds
            .Where(availableNodeIds.Contains)
            .ToList();
        pendingClientSelectionId = null;

        if (previewNode is not null)
        {
            previewNode = patchedNodes.FirstOrDefault(node => string.Equals(node.Id, previewNode.Id, StringComparison.Ordinal));
        }

        if (mermaidPreviewNode is not null)
        {
            mermaidPreviewNode = patchedNodes.FirstOrDefault(node => string.Equals(node.Id, mermaidPreviewNode.Id, StringComparison.Ordinal));
        }

        if (quickActionDialog is not null)
        {
            var dialogNode = patchedNodes.FirstOrDefault(node => string.Equals(node.Id, quickActionDialog.NodeId, StringComparison.Ordinal));
            quickActionDialog = dialogNode is null ? null : BuildQuickActionDialog(dialogNode);
        }

        if (summaryDialog is not null)
        {
            var rootNode = patchedNodes.FirstOrDefault(node => string.Equals(node.Id, summaryDialog.RootNodeId, StringComparison.Ordinal));
            summaryDialog = rootNode is null
                ? null
                : summaryDialog with
                {
                    RootTitle = rootNode.Title,
                    Summary = ProjectStructureSummaryBuilder.Build(surface, rootNode)
                };
        }

        RefreshCanvasSurface();
        await InvokeAsync(StateHasChanged);
    }

    private void RefreshCanvasSurface()
    {
        if (surface is null)
        {
            canvasSurface = null;
            return;
        }

        var uiState = NormalizePersistedCanvasUiState(CanvasWorkbenchUiState.Parse(surface.ViewStateJson));
        uiState.SelectedNodeIds = [.. selectedNodeIds];

        canvasSurface = graphAdapter.BuildSurface(
            surface,
            uiState,
            new CanvasWorkbenchChrome
            {
                HintText = "Click to select, Ctrl + Shift + click to multi-select, Alt-drag to marquee, drag to move, and right-click for grouped project actions.",
                FocusActionLabel = "Focus root",
                ChildNoteActionId = "add-note",
                SiblingNoteActionId = "add-note",
                InlineNotePlaceholder = "Write note",
                QuickCreateActions = BuildQuickCreateActions().ToList(),
                GroupContextActions = actionCatalog.BuildGroupContextActions().ToList()
            },
            actionCatalog);
    }

    private async Task HandleSelectionChangedAsync(CanvasWorkbenchSelectionChangedEventArgs args)
    {
        if (!string.IsNullOrWhiteSpace(pendingClientSelectionId) &&
            surface?.Nodes.Any(node => string.Equals(node.Id, pendingClientSelectionId, StringComparison.Ordinal)) == true &&
            args.SelectedNodeIds.Count <= 1 &&
            !args.SelectedNodeIds.Contains(pendingClientSelectionId, StringComparer.Ordinal))
        {
            return;
        }

        pendingWorkbenchSelectionId = null;

        if (!string.IsNullOrWhiteSpace(reconnectNodeId) &&
            !string.IsNullOrWhiteSpace(args.PrimaryNodeId))
        {
            await HandleReconnectSelectionAsync(args.PrimaryNodeId);
            return;
        }

        if (!string.IsNullOrWhiteSpace(linkModeSourceId) &&
            !string.IsNullOrWhiteSpace(args.PrimaryNodeId) &&
            !string.Equals(linkModeSourceId, args.PrimaryNodeId, StringComparison.Ordinal))
        {
            await ProjectWorkbenchService.LinkObjectsAsync(ProjectId, linkModeSourceId, args.PrimaryNodeId, ProjectObjectLinkKind.DependsOn);
            linkModeSourceId = null;
            await ReloadSurfaceAsync(args.PrimaryNodeId);
            return;
        }

        selectedNodeIds = args.SelectedNodeIds.ToList();
        pendingClientSelectionId = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleNodesMovedAsync(CanvasWorkbenchNodesMovedEventArgs args)
    {
        var updatedNodeIds = await ProjectWorkbenchService.MoveObjectsAsync(
            ProjectId,
            args.Positions
                .Select(position => new ProjectNodeMoveRequest(position.NodeId, position.X, position.Y))
                .ToList());
        if (updatedNodeIds.Count == 0)
        {
            return;
        }

        var updatedNodeIdSet = updatedNodeIds.ToHashSet(StringComparer.Ordinal);
        var committedPositions = args.Positions
            .Where(position => updatedNodeIdSet.Contains(position.NodeId))
            .ToList();
        var requiresReload = surface is null ||
            committedPositions.Count != updatedNodeIdSet.Count ||
            committedPositions.Any(position => !surface.Nodes.Any(node => string.Equals(node.Id, position.NodeId, StringComparison.Ordinal)));
        if (requiresReload)
        {
            await ReloadSurfaceAsync();
            return;
        }

        TryPatchSurfaceNodePositions(committedPositions);
        await TryAdoptMovedNodesIntoBordersAsync(new CanvasWorkbenchNodesMovedEventArgs(committedPositions));
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleCanvasStateChangedAsync(string stateJson)
    {
        if (surface is null)
        {
            return;
        }

        var uiState = NormalizePersistedCanvasUiState(CanvasWorkbenchUiState.Parse(stateJson));
        if (!string.IsNullOrWhiteSpace(pendingClientSelectionId) &&
            surface.Nodes.Any(node => string.Equals(node.Id, pendingClientSelectionId, StringComparison.Ordinal)) &&
            uiState.SelectedNodeIds.Count <= 1 &&
            !uiState.SelectedNodeIds.Contains(pendingClientSelectionId, StringComparer.Ordinal))
        {
            return;
        }

        pendingWorkbenchSelectionId = null;

        var normalizedStateJson = uiState.ToJson();
        var persistedStateJson = NormalizePersistedCanvasStateJson(currentViewStateJson ?? surface.ViewStateJson);
        if (string.Equals(persistedStateJson, normalizedStateJson, StringComparison.Ordinal))
        {
            return;
        }

        pendingClientSelectionId = null;
        selectedNodeIds = uiState.SelectedNodeIds.ToList();
        currentViewStateJson = normalizedStateJson;
        surface = surface with { ViewStateJson = currentViewStateJson };
        if (canvasSurface is not null)
        {
            canvasSurface.UiState = uiState;
        }

        ScheduleCanvasViewStatePersistence();
        await InvokeAsync(StateHasChanged);
    }

    private Task HandleNodeOpenedAsync(string nodeId)
    {
        var node = ResolveNode(nodeId);
        if (node?.ProjectRole is ProjectStructureProjectRole.Subproject or
            ProjectStructureProjectRole.ParentProject or
            ProjectStructureProjectRole.AdditionalParentProject)
        {
            return OpenProjectStructureInNewTabAsync(node);
        }

        return ExecuteCommandAsync(ProjectStructureCommandKind.Open, nodeId, allowQuickActionDialog: true);
    }

    private async Task HandleContextActionAsync(CanvasWorkbenchContextActionRequest request)
        => await HandleCanvasActionAsync(request.ActionId, request.NodeId, request.X, request.Y);

    private async Task HandleCreateActionAsync(CanvasWorkbenchCreateActionRequest request)
    {
        if (await TryApplyNodeEditAsync(request))
        {
            return;
        }

        if (ProjectStructureCanvasCatalog.TryResolveCreateDefinition(request.ActionId, out var definition))
        {
            await CreateObjectAsync(definition, request);
        }
    }

    private async Task HandleNodeEditedAsync(CanvasWorkbenchNodeEditRequest request)
    {
        var targetNode = surface?.Nodes.FirstOrDefault(node => string.Equals(node.Id, request.NodeId, StringComparison.Ordinal));
        if (targetNode is null || targetNode.ObjectType != ProjectObjectType.Note)
        {
            return;
        }

        var updatedNode = await ProjectWorkbenchService.UpdateObjectAsync(
            ProjectId,
            targetNode.Id,
            BuildSimpleNoteTitle(request.Notes),
            string.Empty,
            request.Notes);
        await ApplySurfaceNodeUpdatesAsync([updatedNode]);
    }

    private async Task HandleCanvasActionAsync(string actionId, string? nodeId, double x, double y)
    {
        if (ProjectStructureCanvasCatalog.TryResolveCreateDefinition(actionId, out var definition))
        {
            await CreateObjectAsync(
                definition,
                new CanvasWorkbenchCreateActionRequest(
                    actionId,
                    nodeId,
                    x,
                    y,
                    nodeId,
                    string.Empty,
                    string.Empty,
                    string.Empty,
                    nodeId is null ? "canvas" : "child",
                    "command",
                    definition.ObjectSubtype,
                    null));
            return;
        }

        if (actionCatalog.TryResolveProgressAction(actionId, out var progressMode, out var progressPercent))
        {
            await ApplyProgressAsync(ResolveActionTargetNodeIds(nodeId), progressMode, progressPercent);
            return;
        }

        if (actionCatalog.TryResolveMarkerAction(actionId, out var markerIcon, out var markerTone, out var markerLabel))
        {
            await ApplyMarkerAsync(ResolveActionTargetNodeIds(nodeId), markerIcon, markerTone, markerLabel);
            return;
        }

        if (actionCatalog.TryResolvePriorityAction(actionId, out var priority))
        {
            await ApplyPriorityAsync(ResolveActionTargetNodeIds(nodeId), priority);
            return;
        }

        switch (actionId)
        {
            case "summary":
                await OpenSummaryAsync(nodeId);
                break;
            case "project:open-structure":
                if (ResolveNode(nodeId) is { } projectNodeForOpen)
                {
                    await OpenProjectStructureInNewTabAsync(projectNodeForOpen);
                }
                break;
            case "project:add-subproject":
                if (ResolveNode(nodeId) is { } projectNodeForAdd)
                {
                    await OpenAddSubprojectDialogAsync(projectNodeForAdd);
                }
                break;
            case "project:reconnect-subproject":
                if (ResolveNode(nodeId) is { } projectNodeForReconnect)
                {
                    await OpenReconnectSubprojectDialogAsync(projectNodeForReconnect);
                }
                break;
            case "connect":
                linkModeSourceId = nodeId;
                break;
            case "reconnect":
                await BeginReconnectAsync(nodeId);
                break;
            case "disconnect":
                await DisconnectNodeAsync(nodeId);
                break;
            case "branch":
                await ExecuteCommandAsync(ProjectStructureCommandKind.Branch, nodeId);
                break;
            case "mark-used":
                await ExecuteCommandAsync(ProjectStructureCommandKind.MarkUsed, nodeId);
                break;
            case "skip":
                await ExecuteCommandAsync(ProjectStructureCommandKind.Skip, nodeId);
                break;
            case "validate":
                await ExecuteCommandAsync(ProjectStructureCommandKind.Validate, nodeId);
                break;
            case "test":
                await ExecuteCommandAsync(ProjectStructureCommandKind.Test, nodeId);
                break;
            case "open":
                await ExecuteCommandAsync(ProjectStructureCommandKind.Open, nodeId);
                break;
            case "wizard":
                await ExecuteCommandAsync(ProjectStructureCommandKind.Wizard, nodeId);
                break;
            case "transcript:create":
                await CreateTranscriptFromRecordingAsync(ResolveNode(nodeId));
                break;
            case "transcript:summarize":
                await OpenTranscriptActionAsync(ProjectLlmActionKind.Summarize, nodeId);
                break;
            case "transcript:find-my-tasks":
                await OpenTranscriptActionAsync(ProjectLlmActionKind.FindMyTasks, nodeId);
                break;
            case "transcript:find-others-deliveries":
                await OpenTranscriptActionAsync(ProjectLlmActionKind.FindOthersDeliveries, nodeId);
                break;
            case "group-frame":
                await CreateSelectionBorderAsync();
                break;
            case "group-clear-frame":
                await ClearSelectionBordersAsync();
                break;
            case "delete":
                await DeleteNodeAsync(nodeId);
                break;
        }
    }

    private async Task ExecuteCommandAsync(
        ProjectStructureCommandKind commandKind,
        string? nodeId = null,
        bool allowQuickActionDialog = false,
        bool openInNewTab = false)
    {
        var targetNodeId = nodeId ?? selectedNode?.Id;
        if (string.IsNullOrWhiteSpace(targetNodeId))
        {
            return;
        }

        var attachmentNode = surface?.Nodes.FirstOrDefault(node => string.Equals(node.Id, targetNodeId, StringComparison.Ordinal));
        if (commandKind == ProjectStructureCommandKind.Open &&
            attachmentNode is not null &&
            CanRenderAttachmentPreview(attachmentNode))
        {
            CloseQuickActionDialog();
            OpenAttachmentPreview(attachmentNode);
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (allowQuickActionDialog &&
            commandKind == ProjectStructureCommandKind.Open &&
            attachmentNode is not null)
        {
            OpenQuickActionDialog(attachmentNode);
            await InvokeAsync(StateHasChanged);
            return;
        }

        CloseQuickActionDialog();
        var artifact = await ProjectWorkbenchService.ExecuteNodeCommandAsync(ProjectId, targetNodeId, commandKind);
        linkModeSourceId = null;
        await ReloadSurfaceAsync(targetNodeId);
        if (artifact is not null)
        {
            if (openInNewTab)
            {
                await OpenArtifactInNewTabAsync(artifact.Route);
                return;
            }

            Navigation.NavigateTo(artifact.Route);
        }
    }

    private async Task CreateObjectAsync(ProjectStructureCreateLeafDefinition definition, CanvasWorkbenchCreateActionRequest request)
    {
        var sourceNode = surface?.Nodes.FirstOrDefault(node => string.Equals(node.Id, request.SourceNodeId, StringComparison.Ordinal));
        var parentNodeId = ProjectStructurePlacementPolicy.ResolveParentNodeId(sourceNode, request);
        var parentNode = surface?.Nodes.FirstOrDefault(node => string.Equals(node.Id, parentNodeId, StringComparison.Ordinal));
        var placement = placementPolicy.ResolveCreatePlacement(surface?.Nodes ?? [], sourceNode, parentNode, request);
        var prepared = ProjectStructureCreateRequestComposer.Compose(
            definition,
            request with
            {
                Title = ResolveCreatedTitle(definition, request),
                Subtitle = request.Subtitle?.Trim() ?? string.Empty,
                Notes = ResolveCreatedNotes(definition, request)
            },
            parentNodeId ?? $"project:{ProjectId}",
            placement);
        var created = await ProjectWorkbenchService.CreateObjectAsync(ProjectId, prepared.Request);

        foreach (var pendingLink in prepared.PendingLinks)
        {
            await ProjectWorkbenchService.LinkObjectsAsync(ProjectId, created.Id, pendingLink.TargetNodeId, pendingLink.LinkKind);
        }

        await ReloadSurfaceAsync(created.Id);
    }

    private async Task OpenCreateDialogAsync(CanvasWorkbenchAction action)
    {
        var sourceNode = selectedNode;
        var request = new CanvasWorkbenchCreateActionRequest(
            action.ActionId,
            sourceNode?.Id,
            sourceNode?.X ?? 0,
            sourceNode?.Y ?? 0,
            sourceNode?.Id,
            string.Empty,
            string.Empty,
            string.Empty,
            sourceNode is null ? "canvas" : "child",
            action.CreateMode,
            action.ObjectSubtype,
            null);

        if (workbenchRef is not null)
        {
            await workbenchRef.OpenCreateDialogAsync(action, request);
            return;
        }

        if (ProjectStructureCanvasCatalog.TryResolveCreateDefinition(action.ActionId, out var definition))
        {
            await CreateObjectAsync(definition, request);
        }
    }

    private async Task SelectNodeAsync(string nodeId)
    {
        if (!string.IsNullOrWhiteSpace(linkModeSourceId) &&
            !string.Equals(linkModeSourceId, nodeId, StringComparison.Ordinal))
        {
            await ProjectWorkbenchService.LinkObjectsAsync(ProjectId, linkModeSourceId, nodeId, ProjectObjectLinkKind.DependsOn);
            linkModeSourceId = null;
            await ReloadSurfaceAsync(nodeId);
            return;
        }

        selectedNodeIds = [nodeId];
        await PersistSelectionAsync();
    }

    private async Task ClearSelectionAsync()
    {
        selectedNodeIds.Clear();
        await PersistSelectionAsync();
    }

    private static IReadOnlyList<ProjectStructureCommandKind> ResolveInspectorCommands(ProjectStructureNode node)
    {
        var commands = new List<ProjectStructureCommandKind> { ProjectStructureCommandKind.Open };

        if (node.ObjectType == ProjectObjectType.PromptFlow)
        {
            commands.Add(ProjectStructureCommandKind.Wizard);
        }

        if (node.ObjectType == ProjectObjectType.PromptStep)
        {
            commands.AddRange(
            [
                ProjectStructureCommandKind.Branch,
                ProjectStructureCommandKind.MarkUsed,
                ProjectStructureCommandKind.Skip
            ]);
        }

        commands.Add(ProjectStructureCommandKind.Validate);
        commands.Add(ProjectStructureCommandKind.Test);
        return commands;
    }


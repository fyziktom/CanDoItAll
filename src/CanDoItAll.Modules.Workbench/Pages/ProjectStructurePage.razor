    private async Task CreateSelectionBorderAsync()
    {
        if (surface is null || selectedNodeIds.Count < 2)
        {
            return;
        }

        var uiState = ResolveEditableUiState();
        if (!graphAdapter.TryAddSelectionFrame(surface.Nodes, uiState, selectedNodeIds, BuildSelectionFrameLabel()))
        {
            return;
        }

        await PersistCanvasUiStateAsync(uiState);
    }

    private async Task ClearSelectionBordersAsync()
    {
        if (surface is null || selectedNodeIds.Count == 0)
        {
            return;
        }

        var uiState = ResolveEditableUiState();
        if (!graphAdapter.TryClearSelectionFrames(surface.Nodes, uiState, selectedNodeIds))
        {
            return;
        }

        await PersistCanvasUiStateAsync(uiState);
    }

    private CanvasWorkbenchUiState ResolveEditableUiState()
        => CanvasWorkbenchUiState.Parse(currentViewStateJson ?? surface?.ViewStateJson);

    private async Task PersistCanvasUiStateAsync(CanvasWorkbenchUiState uiState)
    {
        if (surface is null)
        {
            return;
        }

        uiState.SelectedNodeIds = [.. selectedNodeIds];
        graphAdapter.ExpandSelectionAncestors(surface.Nodes, uiState, selectedNodeIds);
        currentViewStateJson = uiState.ToJson();
        surface = surface with { ViewStateJson = currentViewStateJson };
        RefreshCanvasSurface();
        await ProjectWorkbenchService.SaveViewStateAsync(ProjectId, "structure", currentViewStateJson);

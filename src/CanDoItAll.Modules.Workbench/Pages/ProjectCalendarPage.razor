@page "/projects/{ProjectId:guid}/calendar"
@* codex-capsule
kind: page
name: ProjectCalendarPage
summary: Hosts the project calendar surface and opens linked artifacts from scheduled events.
owns: project-calendar, selected-event-panel
deps: ProjectWorkbenchService, NavigationManager
risks: stale-event-selection, wrong-artifact-route
tests: component:ProjectCalendarPageTests, e2e:workbench-calendar
*@
@using CanDoItAll.ComponentKit.Components
@inject ProjectWorkbenchService ProjectWorkbenchService
@inject NavigationManager Navigation

<PageTitle>Project Calendar</PageTitle>

@if (surface is null)
{
    <PageScaffold>
        <Header>
            <PageHeader Eyebrow="Workbench"
                        Title="Project calendar"
                        Description="Loading the linked schedule surface." />
        </Header>
        <ChildContent>
            <LoadingState Eyebrow="Loading"
                          Title="Preparing the calendar"
                          Description="The project events surface is restoring the saved view and selection state." />
        </ChildContent>
    </PageScaffold>
}
else
{
    <PageScaffold>
        <Header>
            <PageHeader Eyebrow="Workbench"
                        Title="@($"{surface.ProjectName} calendar")"
                        Description="Review phase windows, validation activity, tests, and custom milestones in one linked schedule surface." />
        </Header>

        <ChildContent>
            <SummaryTiles>
                <SummaryTile Label="Events" Value="@surface.Events.Count.ToString()" HelperText="Scheduled project items on the current calendar surface." />
                <SummaryTile Label="Linked artifacts" Value="@surface.Events.Count(item => !string.IsNullOrWhiteSpace(item.Route)).ToString()" HelperText="Events that can open a related artifact directly." Tone="info" />
                <SummaryTile Label="Selected item" Value="@SelectedEventLabel" HelperText="Current event focus for the detail pane." />
                <SummaryTile Label="Statuses" Value="@surface.Events.Select(item => item.Status).Distinct(StringComparer.OrdinalIgnoreCase).Count().ToString()" HelperText="Distinct status labels in the current schedule." />
            </SummaryTiles>

            <div class="grid gap-5 xl:grid-cols-[1.1fr_0.9fr]">
                <SectionCard Title="Project calendar" Description="The JavaScript calendar wrapper owns rendering while selection, view persistence, and artifact opening stay typed in .NET.">
                    <ProjectEventsCalendar Surface="surface"
                                           SelectedEventId="selectedEventId"
                                           SelectedEventChanged="HandleEventSelected"
                                           OpenEventRequested="HandleOpenEventAsync"
                                           ViewStateChanged="HandleViewStateChangedAsync" />
                </SectionCard>

                <SectionCard Title="Selected event" Description="Calendar items open their linked artifacts inside the internal workbench.">
                    @if (selectedEvent is null)
                    {
                        <EmptyState Eyebrow="No selection"
                                    Title="Choose an event"
                                    Description="Select an event on the calendar to inspect its timing, state, and linked artifact route." />
                    }
                    else
                    {
                        <div class="space-y-4">
                            <div class="space-y-2">
                                <div class="flex flex-wrap items-center gap-2">
                                    <p class="text-lg font-semibold text-slate-950">@selectedEvent.Title</p>
                                    <span class="rounded-full px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.18em]" style="@($"background:{selectedEvent.AccentColor}18;color:{selectedEvent.AccentColor}")">@selectedEvent.ObjectType</span>
                                </div>
                                <p class="text-sm text-slate-600">@selectedEvent.Status</p>
                            </div>

                            <div class="grid gap-3 sm:grid-cols-2">
                                <div class="rounded-[1.2rem] bg-slate-50 px-4 py-3">
                                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Start</p>
                                    <p class="mt-2 text-sm font-semibold text-slate-950">@selectedEvent.StartUtc.LocalDateTime:g</p>
                                </div>
                                <div class="rounded-[1.2rem] bg-slate-50 px-4 py-3">
                                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">End</p>
                                    <p class="mt-2 text-sm font-semibold text-slate-950">@selectedEvent.EndUtc.LocalDateTime:g</p>
                                </div>
                            </div>

                            <div class="rounded-[1.2rem] bg-slate-50 px-4 py-3">
                                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Route</p>
                                <p class="mt-2 break-all text-sm text-slate-700">@selectedEvent.Route</p>
                            </div>

                            <button type="button"
                                    class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white"
                                    @onclick="() => Navigation.NavigateTo(selectedEvent.Route)">
                                Open linked artifact
                            </button>
                        </div>
                    }
                </SectionCard>
            </div>
        </ChildContent>
    </PageScaffold>
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    private ProjectCalendarSurface? surface;
    private Guid? selectedEventId;

    private ProjectCalendarEvent? selectedEvent => surface?.Events.FirstOrDefault(item => item.Id == selectedEventId);
    private string SelectedEventLabel => selectedEvent?.ObjectType.ToString() ?? "None";

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        surface = await ProjectWorkbenchService.GetCalendarAsync(ProjectId);
        selectedEventId ??= TryReadSelectedEventId(surface.ViewStateJson) ?? surface.Events.FirstOrDefault()?.Id;
    }

    private Task HandleEventSelected(Guid eventId)
    {
        selectedEventId = eventId;
        return Task.CompletedTask;
    }

    private Task HandleViewStateChangedAsync(string stateJson)
        => ProjectWorkbenchService.SaveViewStateAsync(ProjectId, "calendar", stateJson);

    private Task HandleOpenEventAsync(Guid eventId)
    {
        var item = surface?.Events.FirstOrDefault(candidate => candidate.Id == eventId);
        if (item is not null)
        {
            Navigation.NavigateTo(item.Route);
        }

        return Task.CompletedTask;
    }

    private static Guid? TryReadSelectedEventId(string? viewStateJson)
    {
        if (string.IsNullOrWhiteSpace(viewStateJson))
        {
            return null;
        }

        const string marker = "\"selectedEventId\":\"";
        var start = viewStateJson.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        if (start < 0)
        {
            return null;
        }

        start += marker.Length;
        var end = viewStateJson.IndexOf('"', start);
        return end > start && Guid.TryParse(viewStateJson[start..end], out var parsed) ? parsed : null;
    }
}

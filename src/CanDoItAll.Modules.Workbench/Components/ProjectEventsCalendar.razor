@attribute [Obsolete("Use CanvasCalendar with ProjectCalendarAdapter instead of ProjectEventsCalendar.")]
@using CanDoItAll.Components.CanvasLib
@using CanDoItAll.Components.BaseLib

@if (canvasSurface is not null)
{
    <CanvasCalendar Surface="canvasSurface"
                    HostClass="min-h-[36rem] overflow-hidden rounded-2xl border border-slate-200 bg-slate-50"
                    SelectionChanged="HandleSelectionChangedAsync"
                    StateChanged="HandleStateChangedAsync" />
}

@code {
    private CanvasCalendarSurface? canvasSurface;

    [Parameter, EditorRequired]
    public ProjectCalendarSurface Surface { get; set; } = default!;

    [Parameter]
    public Guid? SelectedEventId { get; set; }

    [Parameter]
    public EventCallback<Guid> SelectedEventChanged { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenEventRequested { get; set; }

    [Parameter]
    public EventCallback<string> ViewStateChanged { get; set; }

    protected override void OnParametersSet()
    {
        var viewState = ProjectCalendarStateParser.Parse(Surface.ViewStateJson) with { SelectedEventId = SelectedEventId };
        canvasSurface = ProjectCalendarAdapter.BuildSurface(Surface, viewState);
    }

    private Task HandleSelectionChangedAsync(CanvasCalendarSelectionChangedEventArgs args)
    {
        if (Guid.TryParse(args.SelectedEvent?.EventId, out var parsed))
        {
            return SelectedEventChanged.InvokeAsync(parsed);
        }

        return Task.CompletedTask;
    }

    private Task HandleStateChangedAsync(CanvasCalendarStateChangedEventArgs args)
        => ViewStateChanged.InvokeAsync(args.StateJson);
}



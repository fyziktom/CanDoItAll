@implements IAsyncDisposable
@inject IJSRuntime JsRuntime

<div @ref="host" class="min-h-[36rem] overflow-hidden rounded-2xl border border-slate-200 bg-slate-50"></div>

@code {
    private ElementReference host;
    private DotNetObjectReference<ProjectEventsCalendar>? objectReference;
    private bool initialized;

    [Parameter, EditorRequired]
    public ProjectCalendarSurface Surface { get; set; } = default!;

    [Parameter]
    public Guid? SelectedEventId { get; set; }

    [Parameter]
    public EventCallback<Guid> SelectedEventChanged { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenEventRequested { get; set; }

    [Parameter]
    public EventCallback<string> ViewStateChanged { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Surface is null)
        {
            return;
        }

        objectReference ??= DotNetObjectReference.Create(this);
        if (!initialized)
        {
            await JsRuntime.InvokeVoidAsync("CanDoItAll.workbenchCalendar.create", host, objectReference, Surface, SelectedEventId, Surface.ViewStateJson);
            initialized = true;
            return;
        }

        await JsRuntime.InvokeVoidAsync("CanDoItAll.workbenchCalendar.update", host, Surface, SelectedEventId, Surface.ViewStateJson);
    }

    [JSInvokable]
    public Task OnEventSelected(string eventId)
    {
        if (Guid.TryParse(eventId, out var parsed))
        {
            return SelectedEventChanged.InvokeAsync(parsed);
        }

        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnEventOpened(string eventId)
    {
        if (Guid.TryParse(eventId, out var parsed))
        {
            return OpenEventRequested.InvokeAsync(parsed);
        }

        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnViewStateChanged(string stateJson)
        => ViewStateChanged.InvokeAsync(stateJson);

    public async ValueTask DisposeAsync()
    {
        if (initialized)
        {
            await JsRuntime.InvokeVoidAsync("CanDoItAll.workbenchCalendar.dispose", host);
        }

        objectReference?.Dispose();
    }
}

@page "/resources"
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Modules.Projects
@using CanDoItAll.Modules.Security
@inject ResourcesService ResourcesService
@inject ProjectsService ProjectsService
@inject SecretService SecretService

<PageTitle>Resources</PageTitle>

<PageScaffold>
    <Header>
        <PageHeader Eyebrow="Resources"
                    Title="Typed project resources"
                    Description="Register repositories, folders, scripts, links, and secret-backed connectors through one shared registry.">
            <Actions>
                <Button Text="New resource" Click="CreateNewAsync" />
            </Actions>
        </PageHeader>
    </Header>

    <ChildContent>
        <SummaryTiles>
            <SummaryTile Label="Resources" Value="@resources.Count.ToString()" HelperText="Registered resources across all projects." />
            <SummaryTile Label="Visible" Value="@FilteredResources.Count.ToString()" HelperText="Resources matching the current filters." Tone="info" />
            <SummaryTile Label="Projects" Value="@resources.Select(item => item.ProjectId).Distinct().Count().ToString()" HelperText="Projects currently represented in the registry." />
            <SummaryTile Label="Validated" Value="@resources.Count(item => item.ValidationStatus == ResourceValidationStatus.Valid).ToString()" HelperText="Entries already marked valid." Tone="success" />
        </SummaryTiles>

        <ListDetailShell ListPaneWidth="25rem">
            <ListHeader>
                <ListPanelHeader Title="Resource registry"
                                 Description="Select a resource to continue editing it, or start a new typed entry."
                                 Count="@($"{FilteredResources.Count} item(s)")">
                    <Filters>
                        <FilterBar ResultText="@($"{FilteredResources.Count} matching resource(s)")">
                            <input @bind="resourceSearch" @bind:event="oninput" class="cda-input min-w-[14rem] flex-1" placeholder="Search resources" />
                            <InputSelect @bind-Value="projectFilter" class="cda-input">
                                <option value="">All projects</option>
                                @foreach (var project in projects.OrderBy(item => item.Name))
                                {
                                    <option value="@project.Id.ToString()">@project.Name</option>
                                }
                            </InputSelect>
                            <InputSelect @bind-Value="kindFilter" class="cda-input">
                                <option value="">All kinds</option>
                                @foreach (var kind in Enum.GetValues<ResourceKind>())
                                {
                                    <option value="@kind.ToString()">@kind</option>
                                }
                            </InputSelect>
                            <InputSelect @bind-Value="validationFilter" class="cda-input">
                                <option value="">All validation states</option>
                                @foreach (var status in Enum.GetValues<ResourceValidationStatus>())
                                {
                                    <option value="@status.ToString()">@status</option>
                                }
                            </InputSelect>
                            <Button Text="Reset" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="ResetFilters" />
                        </FilterBar>
                    </Filters>
                </ListPanelHeader>
            </ListHeader>

            <ListContent>
                @if (FilteredResources.Count == 0)
                {
                    <EmptyState Eyebrow="No resources"
                                Title="Register the first typed resource"
                                Description="Resources appear here once they have been saved through the shared editor.">
                        <Actions>
                            <Button Text="New resource" Click="CreateNewAsync" />
                        </Actions>
                    </EmptyState>
                }
                else
                {
                    <div class="cda-stack-3">
                        @foreach (var resource in FilteredResources)
                        {
                            <SelectionListItem Title="@resource.Name"
                                               Eyebrow="@resource.ResourceKind.ToString()"
                                               Meta="@BuildResourceMeta(resource)"
                                               Summary="@resource.LocationOrIdentifier"
                                               IsSelected="@(editor.Id == resource.Id)"
                                               OnSelect="@(() => EditAsync(resource.Id))">
                                <Status>
                                    <StatusBadge Tone="@ResolveTone(resource.ValidationStatus)" Text="@resource.ValidationStatus.ToString()" />
                                </Status>
                            </SelectionListItem>
                        }
                    </div>
                }
            </ListContent>

            <DetailHeader>
                <div class="cda-stack-3">
                    <Split Gap="LayoutGap.Medium">
                        <div class="cda-stack-1">
                            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Resource editor</p>
                            <h2 class="text-xl font-semibold text-slate-950">@EditorTitle</h2>
                            <p class="text-sm leading-6 text-slate-600">Keep ownership, connector location, and validation state together in one predictable detail pane.</p>
                        </div>
                        <Cluster Gap="LayoutGap.Small">
                            <StatusBadge Tone="@ResolveTone(editor.ValidationStatus)" Text="@editor.ValidationStatus.ToString()" />
                            <StatusBadge Tone="neutral" Text="@editor.ResourceKind.ToString()" />
                            @if (!string.IsNullOrWhiteSpace(SelectedProjectName))
                            {
                                <StatusBadge Tone="info" Text="@SelectedProjectName" />
                            }
                        </Cluster>
                    </Split>

                    <div class="rounded-[1.35rem] border border-sky-200 bg-sky-50/70 px-4 py-3 text-sm leading-6 text-sky-900">
                        <p class="font-semibold text-sky-950">@Descriptor.DisplayName</p>
                        <p class="mt-1">@Descriptor.Summary</p>
                    </div>
                </div>
            </DetailHeader>

            <DetailContent>
                <EditForm Model="editor" OnValidSubmit="SaveAsync">
                    <Stack Class="min-h-full" Gap="1.5rem">
                        <FormSection Title="Identity and ownership" Description="Link the resource to the correct project and choose its typed shape before editing connector fields.">
                            <div class="cda-form-grid">
                                <div>
                                    <label class="cda-field-label">Project</label>
                                    <InputSelect @bind-Value="editor.ProjectId" class="cda-input" data-testid="resource-project-select">
                                        <option value="">Select a project</option>
                                        @foreach (var project in projects)
                                        {
                                            <option value="@project.Id">@project.Name</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div>
                                    <label class="cda-field-label">Kind</label>
                                    <InputSelect @bind-Value="editor.ResourceKind" class="cda-input" data-testid="resource-kind-select">
                                        @foreach (var kind in Enum.GetValues<ResourceKind>())
                                        {
                                            <option value="@kind">@kind</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>

                            <div class="cda-form-grid">
                                <div>
                                    <label class="cda-field-label">Name</label>
                                    <InputText @bind-Value="editor.Name" class="cda-input" data-testid="resource-name-input" />
                                </div>
                                <div>
                                    <label class="cda-field-label">Linked secret</label>
                                    <InputSelect @bind-Value="editor.LinkedSecretId" class="cda-input">
                                        <option value="">None</option>
                                        @foreach (var secret in secrets)
                                        {
                                            <option value="@secret.Id">@secret.Name</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                        </FormSection>

                        <FormSection Title="Location and connector details" Description="The typed editor only shows the fields that matter for the selected resource kind.">
                            @switch (editor.ResourceKind)
                            {
                                case ResourceKind.Repository:
                                    <div class="cda-form-grid cda-form-grid--triple">
                                        <div class="md:col-span-2">
                                            <label class="cda-field-label">Repository URL</label>
                                            <InputText @bind-Value="editor.RepositoryUrl" class="cda-input" data-testid="resource-primary-input" />
                                        </div>
                                        <div>
                                            <label class="cda-field-label">Default branch</label>
                                            <InputText @bind-Value="editor.DefaultBranch" class="cda-input" />
                                        </div>
                                    </div>
                                    <div>
                                        <label class="cda-field-label">Relative path</label>
                                        <InputText @bind-Value="editor.RelativePath" class="cda-input" />
                                    </div>
                                    break;
                                case ResourceKind.Folder:
                                    <div class="cda-form-grid">
                                        <div>
                                            <label class="cda-field-label">Folder path</label>
                                            <InputText @bind-Value="editor.FolderPath" class="cda-input" data-testid="resource-primary-input" />
                                        </div>
                                        <div>
                                            <label class="cda-field-label">Working directory</label>
                                            <InputText @bind-Value="editor.WorkingDirectory" class="cda-input" />
                                        </div>
                                    </div>
                                    break;
                                case ResourceKind.File:
                                    <div class="cda-form-grid">
                                        <div>
                                            <label class="cda-field-label">File path</label>
                                            <InputText @bind-Value="editor.FilePath" class="cda-input" data-testid="resource-primary-input" />
                                        </div>
                                        <div>
                                            <label class="cda-field-label">Working directory</label>
                                            <InputText @bind-Value="editor.WorkingDirectory" class="cda-input" />
                                        </div>
                                    </div>
                                    break;
                                case ResourceKind.WebLink:
                                    <Grid Gap="LayoutGap.Large">
                                        <div>
                                            <label class="cda-field-label">URL</label>
                                            <InputText @bind-Value="editor.WebUrl" class="cda-input" data-testid="resource-primary-input" />
                                        </div>
                                        <div>
                                            <label class="cda-field-label">Title hint</label>
                                            <InputText @bind-Value="editor.UrlTitleHint" class="cda-input" />
                                        </div>
                                    </Grid>
                                    break;
                                case ResourceKind.Ftp:
                                    <Grid Gap="LayoutGap.Large" ColumnsMd="4">
                                        <div class="md:col-span-2">
                                            <label class="cda-field-label">Host</label>
                                            <InputText @bind-Value="editor.Host" class="cda-input" data-testid="resource-primary-input" />
                                        </div>
                                        <div>
                                            <label class="cda-field-label">Port</label>
                                            <InputNumber @bind-Value="editor.Port" class="cda-input" />
                                        </div>
                                        <div>
                                            <label class="cda-field-label">User</label>
                                            <InputText @bind-Value="editor.UserName" class="cda-input" />
                                        </div>
                                    </Grid>
                                    <div>
                                        <label class="cda-field-label">Remote path</label>
                                        <InputText @bind-Value="editor.RemotePath" class="cda-input" />
                                    </div>
                                    break;
                                case ResourceKind.Ssh:
                                    <Grid Gap="LayoutGap.Large" ColumnsMd="4">
                                        <div class="md:col-span-2">
                                            <label class="cda-field-label">Host</label>
                                            <InputText @bind-Value="editor.Host" class="cda-input" data-testid="resource-primary-input" />
                                        </div>
                                        <div>
                                            <label class="cda-field-label">Port</label>
                                            <InputNumber @bind-Value="editor.Port" class="cda-input" />
                                        </div>
                                        <div>
                                            <label class="cda-field-label">User</label>
                                            <InputText @bind-Value="editor.UserName" class="cda-input" />
                                        </div>
                                    </Grid>
                                    <div>
                                        <label class="cda-field-label">Working directory</label>
                                        <InputText @bind-Value="editor.WorkingDirectory" class="cda-input" />
                                    </div>
                                    break;
                                case ResourceKind.PowerShellScript:
                                    <div class="cda-form-grid">
                                        <div>
                                            <label class="cda-field-label">Script path</label>
                                            <InputText @bind-Value="editor.ScriptPath" class="cda-input" data-testid="resource-primary-input" />
                                        </div>
                                        <div>
                                            <label class="cda-field-label">Working directory</label>
                                            <InputText @bind-Value="editor.WorkingDirectory" class="cda-input" />
                                        </div>
                                    </div>
                                    <div>
                                        <label class="cda-field-label">Arguments</label>
                                        <InputText @bind-Value="editor.ScriptArguments" class="cda-input" />
                                    </div>
                                    break;
                                case ResourceKind.DockerCompose:
                                    <div class="cda-form-grid">
                                        <div>
                                            <label class="cda-field-label">Compose file</label>
                                            <InputText @bind-Value="editor.ComposeFilePath" class="cda-input" data-testid="resource-primary-input" />
                                        </div>
                                        <div>
                                            <label class="cda-field-label">Service name</label>
                                            <InputText @bind-Value="editor.ComposeService" class="cda-input" />
                                        </div>
                                    </div>
                                    break;
                                case ResourceKind.SecretLink:
                                    <div>
                                        <label class="cda-field-label">Secret purpose</label>
                                        <InputText @bind-Value="editor.SecretPurpose" class="cda-input" data-testid="resource-primary-input" />
                                    </div>
                                    break;
                                case ResourceKind.PromptLink:
                                    <div class="cda-form-grid">
                                        <div>
                                            <label class="cda-field-label">Prompt reference</label>
                                            <InputText @bind-Value="editor.PromptReference" class="cda-input" data-testid="resource-primary-input" />
                                        </div>
                                        <div>
                                            <label class="cda-field-label">Prompt title hint</label>
                                            <InputText @bind-Value="editor.PromptTitleHint" class="cda-input" />
                                        </div>
                                    </div>
                                    break;
                            }

                            <div class="rounded-[1.2rem] bg-white px-4 py-3">
                                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Stored identifier preview</p>
                                <p class="mt-2 break-all text-sm text-slate-700">@PreviewLocation</p>
                            </div>
                        </FormSection>

                        <FormSection Title="Metadata and capabilities" Description="Keep validation, sensitivity, and handling flags explicit on every resource record.">
                            <div>
                                <label class="cda-field-label">Description</label>
                                <InputTextArea @bind-Value="editor.Description" class="cda-input cda-input--textarea min-h-24" />
                            </div>

                            <div class="cda-form-grid">
                                <div>
                                    <label class="cda-field-label">Validation</label>
                                    <InputSelect @bind-Value="editor.ValidationStatus" class="cda-input">
                                        @foreach (var status in Enum.GetValues<ResourceValidationStatus>())
                                        {
                                            <option value="@status">@status</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div>
                                    <label class="cda-field-label">Sensitivity</label>
                                    <InputSelect @bind-Value="editor.Sensitivity" class="cda-input">
                                        @foreach (var sensitivity in Enum.GetValues<ResourceSensitivity>())
                                        {
                                            <option value="@sensitivity">@sensitivity</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>

                            <Grid Gap="LayoutGap.Medium" ColumnsMd="2">
                                <label class="cda-inline-option"><InputCheckbox @bind-Value="editor.SupportsPreview" /> Preview capable</label>
                                <label class="cda-inline-option"><InputCheckbox @bind-Value="editor.SupportsIndexing" /> Indexing capable</label>
                            </Grid>
                        </FormSection>

                        <StickyActionFooter StatusLabel="Resource save state" StatusMessage="@message" StatusTone="success">
                            <SecondaryActions>
                                <Button Text="Reset" ButtonStyle="ButtonStyle.Light" Click="CreateNewAsync" />
                            </SecondaryActions>
                            <PrimaryActions>
                                <Button Text="Save resource" Type="submit" data-testid="resource-save-button" />
                            </PrimaryActions>
                            <DangerActions>
                                @if (editor.Id.HasValue)
                                {
                                    <Button Text="Delete" ButtonStyle="ButtonStyle.Danger" Click="DeleteAsync" />
                                }
                            </DangerActions>
                        </StickyActionFooter>
                    </Stack>
                </EditForm>
            </DetailContent>
        </ListDetailShell>
    </ChildContent>
</PageScaffold>

@code {
    [SupplyParameterFromQuery(Name = "resourceId")]
    public Guid? ResourceIdQuery { get; set; }

    [SupplyParameterFromQuery(Name = "projectId")]
    public Guid? ProjectIdQuery { get; set; }

    private IReadOnlyList<ResourceSummary> resources = [];
    private IReadOnlyList<ProjectSummary> projects = [];
    private IReadOnlyList<SecretListItem> secrets = [];
    private ResourceEditorModel editor = new();
    private string? message;
    private string resourceSearch = string.Empty;
    private string projectFilter = string.Empty;
    private string kindFilter = string.Empty;
    private string validationFilter = string.Empty;

    private ResourceDescriptor Descriptor => ResourceDescriptorRegistry.Get(editor.ResourceKind);

    private IReadOnlyList<ResourceSummary> FilteredResources => resources
        .Where(resource =>
            (string.IsNullOrWhiteSpace(resourceSearch) ||
             resource.Name.Contains(resourceSearch, StringComparison.OrdinalIgnoreCase) ||
             resource.ProjectName.Contains(resourceSearch, StringComparison.OrdinalIgnoreCase) ||
             resource.LocationOrIdentifier.Contains(resourceSearch, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(projectFilter) || string.Equals(resource.ProjectId.ToString(), projectFilter, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(kindFilter) || string.Equals(resource.ResourceKind.ToString(), kindFilter, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(validationFilter) || string.Equals(resource.ValidationStatus.ToString(), validationFilter, StringComparison.OrdinalIgnoreCase)))
        .OrderBy(resource => resource.ProjectName)
        .ThenBy(resource => resource.Name)
        .ToList();

    private string PreviewLocation => editor.ResourceKind switch
    {
        ResourceKind.Repository => editor.RepositoryUrl,
        ResourceKind.Folder => editor.FolderPath,
        ResourceKind.File => editor.FilePath,
        ResourceKind.WebLink => editor.WebUrl,
        ResourceKind.Ftp => $"{editor.Host}{(editor.Port.HasValue ? $":{editor.Port.Value}" : string.Empty)}{(string.IsNullOrWhiteSpace(editor.RemotePath) ? string.Empty : $"/{editor.RemotePath.Trim().TrimStart('/')}")}",
        ResourceKind.Ssh => $"{editor.Host}{(editor.Port.HasValue ? $":{editor.Port.Value}" : string.Empty)}{(string.IsNullOrWhiteSpace(editor.WorkingDirectory) ? string.Empty : $"/{editor.WorkingDirectory.Trim().TrimStart('/')}")}",
        ResourceKind.PowerShellScript => editor.ScriptPath,
        ResourceKind.DockerCompose => editor.ComposeFilePath,
        ResourceKind.SecretLink => editor.SecretPurpose,
        ResourceKind.PromptLink => editor.PromptReference,
        _ => editor.LocationOrIdentifier
    };

    private string EditorTitle => editor.Id.HasValue ? editor.Name : "New resource";

    private string? SelectedProjectName => projects.FirstOrDefault(project => project.Id == editor.ProjectId)?.Name;

    protected override async Task OnParametersSetAsync() => await LoadAsync(ResourceIdQuery, ProjectIdQuery);

    private async Task LoadAsync(Guid? resourceId = null, Guid? projectId = null)
    {
        resources = await ResourcesService.ListAsync();
        projects = await ProjectsService.ListAsync();
        secrets = await SecretService.ListForPickerAsync();
        editor = resourceId.HasValue ? await ResourcesService.GetAsync(resourceId.Value) : new ResourceEditorModel { ProjectId = projectId };
    }

    private Task CreateNewAsync()
    {
        editor = new ResourceEditorModel { ProjectId = ProjectIdQuery };
        message = null;
        return Task.CompletedTask;
    }

    private async Task EditAsync(Guid id)
    {
        editor = await ResourcesService.GetAsync(id);
        message = null;
    }

    private async Task SaveAsync()
    {
        var result = await ResourcesService.SaveAsync(editor);
        message = result.IsSuccess ? "Resource saved." : string.Join(" ", result.Errors.Select(error => error.Message));
        resources = await ResourcesService.ListAsync();
        if (result.IsSuccess)
        {
            editor = await ResourcesService.GetAsync(result.Value);
        }
    }

    private async Task DeleteAsync()
    {
        if (!editor.Id.HasValue)
        {
            return;
        }

        await ResourcesService.DeleteAsync(editor.Id.Value);
        await LoadAsync(null, ProjectIdQuery);
        message = "Resource deleted.";
    }

    private void ResetFilters()
    {
        resourceSearch = string.Empty;
        projectFilter = string.Empty;
        kindFilter = string.Empty;
        validationFilter = string.Empty;
    }

    private static string BuildResourceMeta(ResourceSummary resource) => $"{resource.ProjectName} / {resource.ResourceKind}";

    private static string ResolveTone(ResourceValidationStatus status) => status switch
    {
        ResourceValidationStatus.Valid => "success",
        ResourceValidationStatus.Warning => "warning",
        ResourceValidationStatus.Invalid => "danger",
        _ => "neutral"
    };
}



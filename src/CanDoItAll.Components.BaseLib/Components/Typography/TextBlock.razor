@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase
@switch (ResolveTag())
{
    case "h1":
        <h1 @attributes='BuildAttributes(ResolveCssClass())'>@RenderContent()</h1>
        break;
    case "h2":
        <h2 @attributes='BuildAttributes(ResolveCssClass())'>@RenderContent()</h2>
        break;
    case "h3":
        <h3 @attributes='BuildAttributes(ResolveCssClass())'>@RenderContent()</h3>
        break;
    case "h4":
        <h4 @attributes='BuildAttributes(ResolveCssClass())'>@RenderContent()</h4>
        break;
    case "h5":
        <h5 @attributes='BuildAttributes(ResolveCssClass())'>@RenderContent()</h5>
        break;
    case "h6":
        <h6 @attributes='BuildAttributes(ResolveCssClass())'>@RenderContent()</h6>
        break;
    case "span":
        <span @attributes='BuildAttributes(ResolveCssClass())'>@RenderContent()</span>
        break;
    default:
        <p @attributes='BuildAttributes(ResolveCssClass())'>@RenderContent()</p>
        break;
}

@code {
    [Parameter]
    public TextStyle TextStyle { get; set; } = TextStyle.Body1;

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string ResolveTag()
    {
        return TextStyle switch
        {
            TextStyle.H1 => "h1",
            TextStyle.H2 => "h2",
            TextStyle.H3 => "h3",
            TextStyle.H4 => "h4",
            TextStyle.H5 => "h5",
            TextStyle.H6 => "h6",
            TextStyle.Small => "span",
            TextStyle.Mono => "span",
            TextStyle.Footer => "span",
            TextStyle.Caption => "span",
            _ => "p"
        };
    }

    private string ResolveCssClass()
    {
        return TextStyle switch
        {
            TextStyle.H1 => "rz-text cda-text-block cda-text-block--h1",
            TextStyle.H2 => "rz-text cda-text-block cda-text-block--h2",
            TextStyle.H3 => "rz-text cda-text-block cda-text-block--h3",
            TextStyle.H4 => "rz-text cda-text-block cda-text-block--h4",
            TextStyle.H5 => "rz-text cda-text-block cda-text-block--h5",
            TextStyle.H6 => "rz-text cda-text-block cda-text-block--h6",
            TextStyle.Subtitle1 => "rz-text cda-text-block cda-text-block--subtitle1",
            TextStyle.Subtitle2 => "rz-text cda-text-block cda-text-block--subtitle2",
            TextStyle.Small => "rz-text cda-text-block cda-text-block--small",
            TextStyle.Note => "rz-text cda-text-block cda-text-block--note",
            TextStyle.Eyebrow => "rz-text cda-text-block cda-text-block--eyebrow",
            TextStyle.Mono => "rz-text cda-text-block cda-text-block--mono",
            TextStyle.Footer => "rz-text cda-text-block cda-text-block--footer",
            TextStyle.Muted => "rz-text cda-text-block cda-text-block--muted",
            TextStyle.Caption => "rz-text cda-text-block cda-text-block--caption",
            TextStyle.Body2 => "rz-text cda-text-block cda-text-block--body2",
            _ => "rz-text cda-text-block cda-text-block--body1"
        };
    }

    private RenderFragment RenderContent()
    {
        if (ChildContent is not null)
        {
            return ChildContent;
        }

        return builder => builder.AddContent(0, Value);
    }
}








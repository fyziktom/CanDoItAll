@namespace CanDoItAll.Components.BaseLib

@if (ChildContent is null)
{
    <TextBlock Class="@Class" TextStyle="TextStyle.Mono" Value="@Text" />
}
else
{
    <TextBlock Class="@Class" TextStyle="TextStyle.Mono">
        @ChildContent
    </TextBlock>
}

@code {
    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

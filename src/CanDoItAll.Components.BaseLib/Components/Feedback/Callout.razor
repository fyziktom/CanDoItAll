@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<div @attributes='BuildAttributes(ResolveCssClass())'>
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @Text
    }
</div>

@code {
    [Parameter]
    public CalloutTone Tone { get; set; } = CalloutTone.Default;

    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string ResolveCssClass()
    {
        return Tone == CalloutTone.Ok
            ? "rounded-[1.35rem] border border-emerald-200 bg-emerald-50/80 px-4 py-3 text-sm leading-6 text-emerald-900"
            : "rounded-[1.35rem] border border-slate-200 bg-slate-50/80 px-4 py-3 text-sm leading-6 text-slate-700";
    }
}

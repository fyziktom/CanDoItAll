@namespace CanDoItAll.Components.BaseLib
@implements IDisposable

<div class="@RootClass"
     @onmouseenter="HandleMouseEnter"
     @onmouseleave="HandleMouseLeave">
    @if (isOpen)
    {
        <div class="pf-help-popover__scrim" aria-hidden="true" @onclick="CloseAsync"></div>
    }

    <button type="button"
            class="@ToggleClass"
            aria-label="@AriaLabel"
            title="@Title"
            aria-expanded="@isOpen"
            @onclick="ToggleAsync"
            @onblur="HandleBlurAsync"
            @onkeydown="HandleKeyDownAsync">
        <span aria-hidden="true">@Glyph</span>
    </button>

    @if (isOpen)
    {
        <div class="@PanelClass">
            @if (!string.IsNullOrWhiteSpace(Heading))
            {
                <strong>@Heading</strong>
            }

            @if (!string.IsNullOrWhiteSpace(Body))
            {
                <p>@Body</p>
            }

            @if (!string.IsNullOrWhiteSpace(Tip))
            {
                <small>@Tip</small>
            }

            @PanelContent
        </div>
    }
</div>

@code {
    private bool isOpen;
    private bool pointerInside;
    private CancellationTokenSource? closeDelayCts;

    [Parameter]
    public string RootClass { get; set; } = "pf-help-popover";

    [Parameter]
    public string ToggleClass { get; set; } = "pf-help-popover__toggle";

    [Parameter]
    public string PanelClass { get; set; } = "pf-help-popover__panel";

    [Parameter]
    public string Glyph { get; set; } = "?";

    [Parameter]
    public string AriaLabel { get; set; } = "Show help";

    [Parameter]
    public string Title { get; set; } = "Show help";

    [Parameter]
    public string Heading { get; set; } = string.Empty;

    [Parameter]
    public string Body { get; set; } = string.Empty;

    [Parameter]
    public string Tip { get; set; } = string.Empty;

    [Parameter]
    public int CloseDelayMs { get; set; } = 220;

    [Parameter]
    public bool OpenOnHover { get; set; }

    [Parameter]
    public RenderFragment? PanelContent { get; set; }

    private async Task ToggleAsync()
    {
        CancelScheduledClose();
        isOpen = !isOpen;
        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseAsync()
    {
        CancelScheduledClose();
        isOpen = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleMouseEnter()
    {
        pointerInside = true;
        CancelScheduledClose();

        if (!OpenOnHover || isOpen)
        {
            return;
        }

        isOpen = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleMouseLeave()
    {
        pointerInside = false;
        await ScheduleCloseAsync();
    }

    private async Task HandleBlurAsync(FocusEventArgs _)
        => await ScheduleCloseAsync();

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (!string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            return;
        }

        await CloseAsync();
    }

    private async Task ScheduleCloseAsync()
    {
        if (!isOpen)
        {
            return;
        }

        CancelScheduledClose();
        closeDelayCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(CloseDelayMs, closeDelayCts.Token);
            if (!pointerInside)
            {
                isOpen = false;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void CancelScheduledClose()
    {
        closeDelayCts?.Cancel();
        closeDelayCts?.Dispose();
        closeDelayCts = null;
    }

    public void Dispose()
        => CancelScheduledClose();
}



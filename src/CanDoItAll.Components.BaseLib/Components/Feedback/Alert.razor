@namespace CanDoItAll.Components.BaseLib
<div role="alert" @attributes='AdditionalAttributes.WithClass(ResolveCssClass())'>
    @ChildContent
</div>

@code {
    [Parameter]
    public AlertStyle AlertStyle { get; set; } = AlertStyle.Info;

    [Parameter]
    public Variant Variant { get; set; } = Variant.Filled;

    [Parameter]
    public Shade Shade { get; set; } = Shade.Default;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ResolveCssClass()
    {
        var baseCss = "rz-alert rounded-lg border px-4 py-3 text-sm";

        var themeCss = AlertStyle switch
        {
            AlertStyle.Success => "border-emerald-300 bg-emerald-50 text-emerald-900",
            AlertStyle.Warning => "border-amber-300 bg-amber-50 text-amber-900",
            AlertStyle.Danger => "border-red-300 bg-red-50 text-red-900",
            AlertStyle.Light => "border-slate-200 bg-slate-50 text-slate-700",
            AlertStyle.Secondary => "border-fuchsia-300 bg-fuchsia-50 text-fuchsia-900",
            _ => "border-sky-300 bg-sky-50 text-sky-900"
        };

        return $"{baseCss} {themeCss}";
    }
}







@namespace CanDoItAll.Components.BaseLib
<div class="rounded-[1.5rem] border border-slate-200 bg-slate-50/80 px-5 py-8">
    @if (!string.IsNullOrWhiteSpace(Eyebrow))
    {
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">@Eyebrow</p>
    }

    <h3 class="mt-2 text-lg font-semibold text-slate-950">@Title</h3>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="mt-2 text-sm leading-6 text-slate-600">@Description</p>
    }

    <div class="mt-5 space-y-3">
        <div class="h-3 w-32 animate-pulse rounded-full bg-slate-200"></div>
        <div class="h-3 w-full animate-pulse rounded-full bg-slate-200"></div>
        <div class="h-3 w-5/6 animate-pulse rounded-full bg-slate-200"></div>
    </div>
</div>

@code {
    [Parameter]
    public string? Eyebrow { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }
}



@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<div @attributes='BuildAttributes(ResolveCssClass(), ResolveStyle())'>
    @ChildContent
</div>

@code {
    [Parameter]
    public bool FitViewport { get; set; }

    [Parameter]
    public string ViewportOffset { get; set; } = "0px";

    [Parameter]
    public bool LockOverflow { get; set; } = true;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string ResolveCssClass()
        => BuildClass(
            "rz-layout",
            FitViewport ? "min-h-0" : "min-h-dvh");

    private string? ResolveStyle()
    {
        if (!FitViewport)
        {
            return null;
        }

        var overflowStyle = LockOverflow ? "overflow:hidden;" : string.Empty;
        return $"height:calc(100svh - {ViewportOffset});min-height:0;{overflowStyle}";
    }
}







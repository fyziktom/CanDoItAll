@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

@if (Section)
{
    <section @attributes='BuildAttributes("rz-stack flex min-w-0", ResolveStackStyle())'>
        @ChildContent
    </section>
}
else
{
    <div @attributes='BuildAttributes("rz-stack flex min-w-0", ResolveStackStyle())'>
        @ChildContent
    </div>
}

@code {
    [Parameter]
    public Orientation Orientation { get; set; } = Orientation.Vertical;

    [Parameter]
    public AlignItems AlignItems { get; set; } = AlignItems.Start;

    [Parameter]
    public JustifyContent JustifyContent { get; set; } = JustifyContent.Start;

    [Parameter]
    public FlexWrap Wrap { get; set; } = FlexWrap.NoWrap;

    [Parameter]
    public string? Gap { get; set; }

    [Parameter]
    public LayoutGap? GapScale { get; set; }

    [Parameter]
    public bool Section { get; set; }

    [Parameter]
    public bool FillHeight { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string ResolveStackStyle()
    {
        var direction = Orientation == Orientation.Horizontal
            ? "row"
            : "column";

        var align = AlignItems switch
        {
            AlignItems.Center => "center",
            AlignItems.End => "flex-end",
            AlignItems.Stretch => "stretch",
            _ => "flex-start"
        };

        var justify = JustifyContent switch
        {
            JustifyContent.Center => "center",
            JustifyContent.End => "flex-end",
            JustifyContent.SpaceBetween => "space-between",
            JustifyContent.SpaceAround => "space-around",
            _ => "flex-start"
        };

        var wrap = Wrap == FlexWrap.Wrap
            ? "wrap"
            : "nowrap";

        var gap = GapScale.HasValue
            ? LayoutValueResolver.ResolveGap(GapScale.Value)
            : string.IsNullOrWhiteSpace(Gap)
                ? "0"
                : Gap;

        var styles = new List<string>
        {
            "display:flex",
            $"flex-direction:{direction}",
            $"align-items:{align}",
            $"justify-content:{justify}",
            $"flex-wrap:{wrap}",
            $"gap:{gap}"
        };

        if (FillHeight)
        {
            styles.Add("height:100%");
            styles.Add("min-height:0");
        }

        return string.Join(';', styles) + ';';
    }
}







@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<aside @attributes='BuildAttributes(ResolveCssClass(), ResolveStyle())'>
    @ChildContent
</aside>

@code {
    [Parameter]
    public bool FillHeight { get; set; }

    [Parameter]
    public bool Scrollable { get; set; }

    [Parameter]
    public bool Expanded { get; set; } = true;

    [Parameter]
    public EventCallback<bool> ExpandedChanged { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string ResolveCssClass()
        => BuildClass(
            "rz-sidebar",
            Expanded ? null : "hidden",
            FillHeight ? "min-h-0" : null,
            Scrollable ? "overflow-y-auto" : FillHeight ? "overflow-hidden" : null);

    private string? ResolveStyle()
        => FillHeight ? "height:100%;min-height:0;" : null;
}







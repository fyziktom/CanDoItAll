@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<div @attributes='BuildAttributes(ResolveCssClass(), ResolveStyle())'>
    @ChildContent
</div>

@code {
    [Parameter]
    public int? Columns { get; set; }

    [Parameter]
    public int? ColumnsSm { get; set; }

    [Parameter]
    public int? ColumnsMd { get; set; }

    [Parameter]
    public int? ColumnsLg { get; set; }

    [Parameter]
    public int? ColumnsXl { get; set; }

    [Parameter]
    public int? Columns2Xl { get; set; }

    [Parameter]
    public string? ColumnTemplate { get; set; }

    [Parameter]
    public string? ColumnTemplateSm { get; set; }

    [Parameter]
    public string? ColumnTemplateMd { get; set; }

    [Parameter]
    public string? ColumnTemplateLg { get; set; }

    [Parameter]
    public string? ColumnTemplateXl { get; set; }

    [Parameter]
    public string? ColumnTemplate2Xl { get; set; }

    [Parameter]
    public string? Gap { get; set; }

    [Parameter]
    public LayoutGap? GapScale { get; set; }

    [Parameter]
    public LayoutGap? ColumnGap { get; set; }

    [Parameter]
    public LayoutGap? RowGap { get; set; }

    [Parameter]
    public AlignItems AlignItems { get; set; } = AlignItems.Stretch;

    [Parameter]
    public JustifyContent JustifyContent { get; set; } = JustifyContent.Start;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string ResolveCssClass()
    {
        return BuildClass(
            "rz-row min-w-0 [&>*]:min-w-0 [gap:var(--cda-row-gap)] [column-gap:var(--cda-row-column-gap)] [row-gap:var(--cda-row-row-gap)] [align-items:var(--cda-row-align)] [justify-content:var(--cda-row-justify)]",
            "[grid-template-columns:var(--cda-row-columns)]",
            "sm:[grid-template-columns:var(--cda-row-columns-sm)]",
            "md:[grid-template-columns:var(--cda-row-columns-md)]",
            "lg:[grid-template-columns:var(--cda-row-columns-lg)]",
            "xl:[grid-template-columns:var(--cda-row-columns-xl)]",
            "2xl:[grid-template-columns:var(--cda-row-columns-2xl)]");
    }

    private string ResolveStyle()
    {
        var gap = GapScale.HasValue
            ? LayoutValueResolver.ResolveGap(GapScale.Value)
            : string.IsNullOrWhiteSpace(Gap)
                ? "0rem"
                : Gap;

        var columnGap = ColumnGap.HasValue
            ? LayoutValueResolver.ResolveGap(ColumnGap.Value)
            : gap;

        var rowGap = RowGap.HasValue
            ? LayoutValueResolver.ResolveGap(RowGap.Value)
            : gap;

        var styles = new List<string>
        {
            "display:grid",
            "grid-column:1 / -1",
            $"--cda-row-gap:{gap}",
            $"--cda-row-column-gap:{columnGap}",
            $"--cda-row-row-gap:{rowGap}",
            $"--cda-row-align:{LayoutValueResolver.ResolveAlignValue(AlignItems)}",
            $"--cda-row-justify:{LayoutValueResolver.ResolveJustifyValue(JustifyContent)}",
            "--cda-row-default-column-span:var(--cda-grid-default-column-span,12)",
            "--cda-row-columns:var(--cda-grid-columns,repeat(12,minmax(0,1fr)))",
            "--cda-row-columns-sm:var(--cda-grid-columns-sm,var(--cda-row-columns))",
            "--cda-row-columns-md:var(--cda-grid-columns-md,var(--cda-row-columns-sm))",
            "--cda-row-columns-lg:var(--cda-grid-columns-lg,var(--cda-row-columns-md))",
            "--cda-row-columns-xl:var(--cda-grid-columns-xl,var(--cda-row-columns-lg))",
            "--cda-row-columns-2xl:var(--cda-grid-columns-2xl,var(--cda-row-columns-xl))"
        };

        AppendTrackStyle(styles, "--cda-row-columns", Columns, ColumnTemplate);
        AppendTrackStyle(styles, "--cda-row-columns-sm", ColumnsSm, ColumnTemplateSm);
        AppendTrackStyle(styles, "--cda-row-columns-md", ColumnsMd, ColumnTemplateMd);
        AppendTrackStyle(styles, "--cda-row-columns-lg", ColumnsLg, ColumnTemplateLg);
        AppendTrackStyle(styles, "--cda-row-columns-xl", ColumnsXl, ColumnTemplateXl);
        AppendTrackStyle(styles, "--cda-row-columns-2xl", Columns2Xl, ColumnTemplate2Xl);

        return string.Join(';', styles) + ';';
    }

    private static void AppendTrackStyle(ICollection<string> styles, string variableName, int? count, string? template)
    {
        var trackDefinition = ResolveTrackDefinition(count, template);
        if (!string.IsNullOrWhiteSpace(trackDefinition))
        {
            styles.Add($"{variableName}:{trackDefinition}");
        }
    }

    private static string? ResolveTrackDefinition(int? count, string? template)
    {
        if (!string.IsNullOrWhiteSpace(template))
        {
            return template.Trim();
        }

        if (!count.HasValue)
        {
            return null;
        }

        return $"repeat({Math.Clamp(count.Value, 1, 24)},minmax(0,1fr))";
    }
}

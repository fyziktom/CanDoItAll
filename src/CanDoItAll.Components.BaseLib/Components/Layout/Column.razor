@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<div @attributes='BuildAttributes("rz-col min-w-0", ResolveColumnStyle())'>
    @ChildContent
</div>

@code {
    [Parameter]
    public int? Size { get; set; }

    [Parameter]
    public int? SizeSM { get; set; }

    [Parameter]
    public int? SizeMD { get; set; }

    [Parameter]
    public int? SizeLG { get; set; }

    [Parameter]
    public int? SizeXL { get; set; }

    [Parameter]
    public int? Size2XL { get; set; }

    [Parameter]
    public Orientation Orientation { get; set; } = Orientation.Vertical;

    [Parameter]
    public AlignItems AlignItems { get; set; } = AlignItems.Stretch;

    [Parameter]
    public JustifyContent JustifyContent { get; set; } = JustifyContent.Start;

    [Parameter]
    public FlexWrap Wrap { get; set; } = FlexWrap.NoWrap;

    [Parameter]
    public string? Gap { get; set; }

    [Parameter]
    public LayoutGap? GapScale { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string ResolveColumnStyle()
    {
        var direction = Orientation == Orientation.Horizontal
            ? "row"
            : "column";

        var wrap = Wrap == FlexWrap.Wrap
            ? "wrap"
            : "nowrap";

        var gap = GapScale.HasValue
            ? LayoutValueResolver.ResolveGap(GapScale.Value)
            : string.IsNullOrWhiteSpace(Gap)
                ? "0rem"
                : Gap;

        var size = NormalizeNullableSize(Size);
        var sizeSm = NormalizeNullableSize(SizeSM);
        var sizeMd = NormalizeNullableSize(SizeMD);
        var sizeLg = NormalizeNullableSize(SizeLG);
        var sizeXl = NormalizeNullableSize(SizeXL);
        var size2Xl = NormalizeNullableSize(Size2XL);

        var styles = new List<string>
        {
            "display:flex",
            "height:100%",
            $"flex-direction:{direction}",
            $"align-items:{LayoutValueResolver.ResolveAlignValue(AlignItems)}",
            $"justify-content:{LayoutValueResolver.ResolveJustifyValue(JustifyContent)}",
            $"flex-wrap:{wrap}",
            $"gap:{gap}",
            size.HasValue
                ? $"--rz-col-size:{size.Value}"
                : "--rz-col-size:var(--cda-row-default-column-span,12)"
        };

        AppendSizeStyle(styles, "--rz-col-sm-size", sizeSm);
        AppendSizeStyle(styles, "--rz-col-md-size", sizeMd);
        AppendSizeStyle(styles, "--rz-col-lg-size", sizeLg);
        AppendSizeStyle(styles, "--rz-col-xl-size", sizeXl);
        AppendSizeStyle(styles, "--rz-col-2xl-size", size2Xl);

        return string.Join(';', styles) + ';';
    }

    private static int NormalizeSize(int size)
    {
        return Math.Clamp(size, 1, 24);
    }

    private static int? NormalizeNullableSize(int? size)
    {
        return size.HasValue
            ? NormalizeSize(size.Value)
            : null;
    }

    private static void AppendSizeStyle(ICollection<string> styles, string variableName, int? size)
    {
        if (size.HasValue)
        {
            styles.Add($"{variableName}:{size.Value}");
        }
    }
}

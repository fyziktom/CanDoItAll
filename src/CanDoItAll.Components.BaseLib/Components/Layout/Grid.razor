@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

@if (Section)
{
    <section @attributes='BuildAttributes(ResolveCssClass(), ResolveStyle())'>
        @ChildContent
    </section>
}
else
{
    <div @attributes='BuildAttributes(ResolveCssClass(), ResolveStyle())'>
        @ChildContent
    </div>
}

@code {
    [Parameter]
    public int? Columns { get; set; }

    [Parameter]
    public int? ColumnsSm { get; set; }

    [Parameter]
    public int? ColumnsMd { get; set; }

    [Parameter]
    public int? ColumnsLg { get; set; }

    [Parameter]
    public int? ColumnsXl { get; set; }

    [Parameter]
    public int? Columns2Xl { get; set; }

    [Parameter]
    public int? Rows { get; set; }

    [Parameter]
    public int? RowsSm { get; set; }

    [Parameter]
    public int? RowsMd { get; set; }

    [Parameter]
    public int? RowsLg { get; set; }

    [Parameter]
    public int? RowsXl { get; set; }

    [Parameter]
    public int? Rows2Xl { get; set; }

    [Parameter]
    public string? ColumnTemplate { get; set; }

    [Parameter]
    public string? ColumnTemplateSm { get; set; }

    [Parameter]
    public string? ColumnTemplateMd { get; set; }

    [Parameter]
    public string? ColumnTemplateLg { get; set; }

    [Parameter]
    public string? ColumnTemplateXl { get; set; }

    [Parameter]
    public string? ColumnTemplate2Xl { get; set; }

    [Parameter]
    public string? RowTemplate { get; set; }

    [Parameter]
    public string? RowTemplateSm { get; set; }

    [Parameter]
    public string? RowTemplateMd { get; set; }

    [Parameter]
    public string? RowTemplateLg { get; set; }

    [Parameter]
    public string? RowTemplateXl { get; set; }

    [Parameter]
    public string? RowTemplate2Xl { get; set; }

    [Parameter]
    public LayoutGap Gap { get; set; } = LayoutGap.Large;

    [Parameter]
    public LayoutGap? ColumnGap { get; set; }

    [Parameter]
    public LayoutGap? RowGap { get; set; }

    [Parameter]
    public AlignItems AlignItems { get; set; } = AlignItems.Stretch;

    [Parameter]
    public JustifyContent JustifyContent { get; set; } = JustifyContent.Start;

    [Parameter]
    public bool Section { get; set; }

    [Parameter]
    public bool FillHeight { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string ResolveCssClass()
    {
        return BuildClass(
            "min-w-0 w-full max-w-full [&>*]:min-w-0 [gap:var(--cda-grid-gap)] [column-gap:var(--cda-grid-column-gap)] [row-gap:var(--cda-grid-row-gap)] [align-items:var(--cda-grid-align)] [justify-content:var(--cda-grid-justify)]",
            FillHeight ? "min-h-0" : null,
            "[grid-template-columns:var(--cda-grid-columns)]",
            HasResponsiveColumns(ColumnsSm, ColumnTemplateSm) ? "sm:[grid-template-columns:var(--cda-grid-columns-sm)]" : null,
            HasResponsiveColumns(ColumnsMd, ColumnTemplateMd) ? "md:[grid-template-columns:var(--cda-grid-columns-md)]" : null,
            HasResponsiveColumns(ColumnsLg, ColumnTemplateLg) ? "lg:[grid-template-columns:var(--cda-grid-columns-lg)]" : null,
            HasResponsiveColumns(ColumnsXl, ColumnTemplateXl) ? "xl:[grid-template-columns:var(--cda-grid-columns-xl)]" : null,
            HasResponsiveColumns(Columns2Xl, ColumnTemplate2Xl) ? "2xl:[grid-template-columns:var(--cda-grid-columns-2xl)]" : null,
            HasBaseRows() ? "[grid-template-rows:var(--cda-grid-rows)]" : null,
            HasResponsiveRows(RowsSm, RowTemplateSm) ? "sm:[grid-template-rows:var(--cda-grid-rows-sm)]" : null,
            HasResponsiveRows(RowsMd, RowTemplateMd) ? "md:[grid-template-rows:var(--cda-grid-rows-md)]" : null,
            HasResponsiveRows(RowsLg, RowTemplateLg) ? "lg:[grid-template-rows:var(--cda-grid-rows-lg)]" : null,
            HasResponsiveRows(RowsXl, RowTemplateXl) ? "xl:[grid-template-rows:var(--cda-grid-rows-xl)]" : null,
            HasResponsiveRows(Rows2Xl, RowTemplate2Xl) ? "2xl:[grid-template-rows:var(--cda-grid-rows-2xl)]" : null);
    }

    private string? ResolveStyle()
    {
        var columnGap = ColumnGap ?? Gap;
        var rowGap = RowGap ?? Gap;

        var styles = new List<string>
        {
            "display:grid",
            $"--cda-grid-gap:{LayoutValueResolver.ResolveGap(Gap)}",
            $"--cda-grid-column-gap:{LayoutValueResolver.ResolveGap(columnGap)}",
            $"--cda-grid-row-gap:{LayoutValueResolver.ResolveGap(rowGap)}",
            $"--cda-grid-align:{LayoutValueResolver.ResolveAlignValue(AlignItems)}",
            $"--cda-grid-justify:{LayoutValueResolver.ResolveJustifyValue(JustifyContent)}",
            "--cda-grid-default-column-span:1",
            "--cda-grid-columns:minmax(0,1fr)"
        };

        if (FillHeight)
        {
            styles.Add("height:100%");
            styles.Add("min-height:0");
        }

        AppendTrackStyle(styles, "--cda-grid-columns", Columns, ColumnTemplate);
        AppendTrackStyle(styles, "--cda-grid-columns-sm", ColumnsSm, ColumnTemplateSm);
        AppendTrackStyle(styles, "--cda-grid-columns-md", ColumnsMd, ColumnTemplateMd);
        AppendTrackStyle(styles, "--cda-grid-columns-lg", ColumnsLg, ColumnTemplateLg);
        AppendTrackStyle(styles, "--cda-grid-columns-xl", ColumnsXl, ColumnTemplateXl);
        AppendTrackStyle(styles, "--cda-grid-columns-2xl", Columns2Xl, ColumnTemplate2Xl);

        AppendTrackStyle(styles, "--cda-grid-rows", Rows, RowTemplate);
        AppendTrackStyle(styles, "--cda-grid-rows-sm", RowsSm, RowTemplateSm);
        AppendTrackStyle(styles, "--cda-grid-rows-md", RowsMd, RowTemplateMd);
        AppendTrackStyle(styles, "--cda-grid-rows-lg", RowsLg, RowTemplateLg);
        AppendTrackStyle(styles, "--cda-grid-rows-xl", RowsXl, RowTemplateXl);
        AppendTrackStyle(styles, "--cda-grid-rows-2xl", Rows2Xl, RowTemplate2Xl);

        return string.Join(';', styles.Where(static value => !string.IsNullOrWhiteSpace(value))) + ';';
    }

    private bool HasBaseColumns() => HasResponsiveColumns(Columns, ColumnTemplate);

    private bool HasBaseRows() => HasResponsiveRows(Rows, RowTemplate);

    private static bool HasResponsiveColumns(int? columns, string? columnTemplate)
        => columns.HasValue || !string.IsNullOrWhiteSpace(columnTemplate);

    private static bool HasResponsiveRows(int? rows, string? rowTemplate)
        => rows.HasValue || !string.IsNullOrWhiteSpace(rowTemplate);

    private static void AppendTrackStyle(ICollection<string> styles, string variableName, int? count, string? template)
    {
        var trackDefinition = ResolveTrackDefinition(count, template);
        if (!string.IsNullOrWhiteSpace(trackDefinition))
        {
            styles.Add($"{variableName}:{trackDefinition}");
        }
    }

    private static string? ResolveTrackDefinition(int? count, string? template)
    {
        if (!string.IsNullOrWhiteSpace(template))
        {
            return template.Trim();
        }

        if (!count.HasValue)
        {
            return null;
        }

        return $"repeat({Math.Clamp(count.Value, 1, 24)},minmax(0,1fr))";
    }
}

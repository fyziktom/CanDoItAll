@namespace CanDoItAll.Components.BaseLib
<div class="@ResolveContainerClass()">
    @if (Header is not null)
    {
        <Stack GapScale="LayoutGap.Medium"
               Class="w-full">
            @Header
        </Stack>
    }

    @if (Lead is not null)
    {
        <Stack GapScale="LayoutGap.Large"
               Class="w-full">
            @Lead
        </Stack>
    }

    @if (SecondaryRail is not null)
    {
        <Grid Gap="LayoutGap.XXLarge"
              ColumnTemplate2Xl="minmax(0,1fr) 18rem">
            <Stack GapScale="LayoutGap.XXLarge"
                   Class="min-w-0 w-full">
                @ChildContent
            </Stack>

            <Stack Section="true"
                   GapScale="LayoutGap.Large">
                @SecondaryRail
            </Stack>
        </Grid>
    }
    else if (ChildContent is not null)
    {
        <Stack GapScale="LayoutGap.XXLarge"
               Class="w-full">
            @ChildContent
        </Stack>
    }
</div>

@code {
    [Parameter]
    public PageScaffoldMode Mode { get; set; } = PageScaffoldMode.Standard;

    [Parameter]
    public string? MaxWidthClass { get; set; }

    [Parameter]
    public RenderFragment? Header { get; set; }

    [Parameter]
    public RenderFragment? Lead { get; set; }

    [Parameter]
    public RenderFragment? SecondaryRail { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string ResolveContainerClass()
    {
        var maxWidthClass = !string.IsNullOrWhiteSpace(MaxWidthClass)
            ? MaxWidthClass
            : Mode == PageScaffoldMode.FocusWorkbench
                ? "max-w-full"
                : "max-w-[1720px] 2xl:max-w-[1820px]";

        var spacingClass = Mode == PageScaffoldMode.FocusWorkbench ? "gap-3" : "gap-3.5 xl:gap-4";
        return $"mx-auto flex w-full min-w-0 flex-col {spacingClass} {maxWidthClass}";
    }
}



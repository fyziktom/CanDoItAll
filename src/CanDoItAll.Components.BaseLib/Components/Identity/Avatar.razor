@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

@if (!string.IsNullOrWhiteSpace(ResolvedImageUrl))
{
<img src="@ResolvedImageUrl"
alt="@ResolveAltText()"
@attributes='BuildAttributes(ResolveImageCssClass())' />
}
else
{
<span @attributes='BuildAttributes(ResolveFallbackCssClass())'>
@FallbackText
</span>
}

@code {
    [Parameter]
    public string? ImageUrl { get; set; }

    [Parameter]
    public string? Alt { get; set; }

[Parameter]
public string? FallbackText { get; set; }

[Parameter]
public string? DefaultImageSeed { get; set; }

[Parameter]
public bool UseDefaultImageWhenMissing { get; set; } = true;

[Parameter]
public AvatarSize Size { get; set; } = AvatarSize.Medium;

[Parameter]
public AvatarShape Shape { get; set; } = AvatarShape.Circle;

private string? ResolvedImageUrl => AvatarFallbackResolver.ResolveImageUrl(
ImageUrl,
ResolveDefaultImageSeed(),
UseDefaultImageWhenMissing);

private string ResolveAltText()
{
if (!string.IsNullOrWhiteSpace(Alt))
{
return Alt;
}

if (!string.IsNullOrWhiteSpace(FallbackText))
{
return FallbackText;
}

return "Avatar";
}

private string ResolveDefaultImageSeed()
{
if (!string.IsNullOrWhiteSpace(DefaultImageSeed))
{
return DefaultImageSeed;
}

if (!string.IsNullOrWhiteSpace(Alt))
{
return Alt;
}

return FallbackText ?? string.Empty;
}

private string ResolveImageCssClass()
{
return $"{ResolveShapeCssClass()} {ResolveFrameSizeCssClass()} block shrink-0 overflow-hidden border border-slate-200 bg-slate-100 object-cover";
}

private string ResolveFallbackCssClass()
{
return $"{ResolveShapeCssClass()} {ResolveFrameSizeCssClass()} {ResolveTextSizeCssClass()} inline-flex shrink-0 items-center justify-center overflow-hidden border border-slate-200 bg-slate-100 font-semibold uppercase tracking-[0.18em] text-slate-600";
}

private string ResolveFrameSizeCssClass()
{
return Size switch
{
AvatarSize.Small => "h-8 w-8",
AvatarSize.Large => "h-14 w-14",
_ => "h-10 w-10"
};
}

private string ResolveTextSizeCssClass()
{
return Size switch
{
AvatarSize.Small => "text-xs",
AvatarSize.Large => "text-base",
_ => "text-sm"
};
}

private string ResolveShapeCssClass()
{
return Shape == AvatarShape.Rounded
? "rounded-2xl"
: "rounded-full";
}
}

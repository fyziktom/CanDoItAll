@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<a href="@Href"
   target="@Target"
   rel="@Rel"
   @attributes='BuildAttributes("inline-flex items-center gap-2 text-sm font-medium text-sky-700 hover:text-sky-800")'>
    @ChildContent
</a>

@code {
    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public string? Target { get; set; }

    [Parameter]
    public string? Rel { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

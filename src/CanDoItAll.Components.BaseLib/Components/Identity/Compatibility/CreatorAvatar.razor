@namespace CanDoItAll.Components.BaseLib

<Avatar Class="@Class"
ImageUrl="@ImageUrl"
Alt="@Alt"
FallbackText="@FallbackText"
DefaultImageSeed="@DefaultImageSeed"
UseDefaultImageWhenMissing="@UseDefaultImageWhenMissing"
Size="AvatarSize.Medium"
Shape="AvatarShape.Rounded" />

@code {
    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? ImageUrl { get; set; }

    [Parameter]
    public string? Alt { get; set; }

[Parameter]
public string? FallbackText { get; set; }

[Parameter]
public string? DefaultImageSeed { get; set; }

[Parameter]
public bool UseDefaultImageWhenMissing { get; set; } = true;
}

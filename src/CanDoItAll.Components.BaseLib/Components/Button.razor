@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase
@{
    var iconCssClass = ResolveIconCssClass(Icon);
}

@if (IsAnchor)
{
    <a href="@Href"
       target="@Target"
       rel="@Rel"
       aria-disabled="@IsDisabled"
       @attributes="BuildAttributes(ResolveButtonCssClass())"
       @onclick="OnClickAsync">
        @RenderButtonContent(iconCssClass)
    </a>
}
else
{
    <button type="@Type"
            disabled="@IsDisabled"
            @attributes="BuildAttributes(ResolveButtonCssClass())"
            @onclick="OnClickAsync">
        @RenderButtonContent(iconCssClass)
    </button>
}

@code {
    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public ButtonStyle ButtonStyle { get; set; } = ButtonStyle.Primary;

    [Parameter]
    public ButtonSize Size { get; set; } = ButtonSize.Medium;

    [Parameter]
    public Variant Variant { get; set; } = Variant.Filled;

    [Parameter]
    public Shade Shade { get; set; } = Shade.Default;

    [Parameter]
    public ButtonLook Look { get; set; } = ButtonLook.Default;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public EventCallback Click { get; set; }

    [Parameter]
    public string Type { get; set; } = "button";

    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public string? Target { get; set; }

    [Parameter]
    public string? Rel { get; set; }

    private bool IsDisabled => Disabled || IsBusy;

    private bool IsAnchor => !string.IsNullOrWhiteSpace(Href);

    private async Task OnClickAsync()
    {
        if (!IsDisabled)
        {
            await Click.InvokeAsync();
        }
    }

    private static string? ResolveIconCssClass(string? iconToken)
    {
        if (FontAwesomeIconCatalog.TryResolveCssClass(iconToken, out var cssClass))
        {
            return cssClass;
        }

        return null;
    }

    private static string ResolveIconLabel(string? iconToken)
    {
        if (string.IsNullOrWhiteSpace(iconToken))
        {
            return "action";
        }

        return iconToken
            .Replace('_', ' ')
            .Replace('-', ' ');
    }

    private string ResolveButtonCssClass()
    {
        if (Look != ButtonLook.Default)
        {
            return Look switch
            {
                ButtonLook.SheetCard => "zy-card-button",
                ButtonLook.SheetCardGhost => "zy-card-button zy-card-button--ghost",
                ButtonLook.SheetCardWarn => "zy-card-button zy-card-button--warn",
                ButtonLook.Legacy => "btn",
                ButtonLook.LegacyGhost => "btn ghost",
                ButtonLook.LegacyExtraSmall => "btn xs",
                ButtonLook.LegacyExtraSmallGhost => "btn xs ghost",
                ButtonLook.LegacyPrimaryFullWidth => "btn primary w-full",
                _ => string.Empty
            };
        }

        var baseCss = "rz-button inline-flex items-center justify-center gap-2 rounded-md border font-semibold transition disabled:cursor-not-allowed disabled:opacity-50";
        var sizeCss = Size switch
        {
            ButtonSize.Small => "px-2.5 py-1.5 text-xs",
            ButtonSize.Large => "px-4 py-2.5 text-base",
            _ => "px-3.5 py-2 text-sm"
        };

        var styleCss = ResolveStyleCss();
        return $"{baseCss} {sizeCss} {styleCss}";
    }

    private RenderFragment RenderButtonContent(string? iconCssClass)
    {
        return builder =>
        {
            var sequence = 0;

            if (IsBusy)
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "inline-flex h-3 w-3 animate-spin rounded-full border-2 border-current border-r-transparent");
                builder.CloseElement();
            }
            else if (iconCssClass is not null)
            {
                builder.OpenElement(sequence++, "i");
                builder.AddAttribute(sequence++, "class", $"rz-fa-icon {iconCssClass}");
                builder.AddAttribute(sequence++, "aria-hidden", "true");
                builder.CloseElement();
            }
            else if (!string.IsNullOrWhiteSpace(Icon))
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "rz-icon-fallback");
                builder.AddAttribute(sequence++, "title", $"Unknown icon token: {Icon}");
                builder.AddAttribute(sequence++, "aria-hidden", "true");
                builder.AddContent(sequence++, Icon);
                builder.CloseElement();
            }

            if (ChildContent is not null)
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "rz-button-text");
                builder.AddContent(sequence++, ChildContent);
                builder.CloseElement();
                return;
            }

            if (!string.IsNullOrWhiteSpace(Text))
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "rz-button-text");
                builder.AddContent(sequence++, Text);
                builder.CloseElement();
                return;
            }

            if (!string.IsNullOrWhiteSpace(Icon))
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "sr-only");
                builder.AddContent(sequence++, ResolveIconLabel(Icon));
                builder.CloseElement();
            }
        };
    }

    private string ResolveStyleCss()
    {
        return (Variant, ButtonStyle) switch
        {
            (Variant.Text, _) => "border-transparent bg-transparent text-slate-700 hover:bg-slate-100",
            (_, ButtonStyle.Light) => "border-slate-300 bg-slate-100 text-slate-800 hover:bg-slate-200",
            (_, ButtonStyle.Secondary) => "border-fuchsia-300 bg-fuchsia-100 text-fuchsia-800 hover:bg-fuchsia-200",
            (_, ButtonStyle.Success) => "border-emerald-300 bg-emerald-100 text-emerald-800 hover:bg-emerald-200",
            (_, ButtonStyle.Info) => "border-sky-300 bg-sky-100 text-sky-800 hover:bg-sky-200",
            (_, ButtonStyle.Warning) => "border-amber-300 bg-amber-100 text-amber-900 hover:bg-amber-200",
            (_, ButtonStyle.Danger) => "border-red-300 bg-red-100 text-red-800 hover:bg-red-200",
            _ => "border-indigo-300 bg-indigo-100 text-indigo-800 hover:bg-indigo-200"
        };
    }
}








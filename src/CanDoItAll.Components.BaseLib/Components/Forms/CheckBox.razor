@namespace CanDoItAll.Components.BaseLib
@typeparam TValue
@inherits StyledComponentBase

<input type="checkbox"
       @attributes='BuildAttributes(ResolveCssClass())'
       aria-labelledby="@ResolveLabelledBy()"
       name="@Name"
       disabled="@Disabled"
       checked="@ResolveIsChecked()"
       @onchange="OnChangedAsync"
        />

@code {
    [Parameter]
    public TValue? Value { get; set; }

    [Parameter]
    public EventCallback<TValue?> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<TValue?> Change { get; set; }

    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public InputLook Look { get; set; } = InputLook.Default;

    [CascadingParameter(Name = "FormFieldLabelId")]
    public string? FormFieldLabelId { get; set; }

    private bool ResolveIsChecked()
    {
        if (Value is bool boolValue)
        {
            return boolValue;
        }

        if (Value is null)
        {
            return false;
        }

        if (typeof(TValue) == typeof(bool?))
        {
            var nullableValue = (bool?)(object)Value;
            return nullableValue.GetValueOrDefault();
        }

        return false;
    }

    private async Task OnChangedAsync(ChangeEventArgs args)
    {
        var checkedValue = args.Value is bool boolValue && boolValue;
        var converted = ConvertFromBool(checkedValue);
        Value = converted;
        await ValueChanged.InvokeAsync(converted);
        await Change.InvokeAsync(converted);
    }

    private static TValue? ConvertFromBool(bool value)
    {
        if (typeof(TValue) == typeof(bool))
        {
            return (TValue)(object)value;
        }

        if (typeof(TValue) == typeof(bool?))
        {
            bool? nullable = value;
            return (TValue)(object)nullable;
        }

        return default;
    }

    private string ResolveCssClass()
    {
        return Look switch
        {
            InputLook.Plain => string.Empty,
            _ => "rz-checkbox h-4 w-4 rounded border-slate-300 text-indigo-600"
        };
    }

    private string? ResolveLabelledBy()
        => HasExplicitAccessibleName() ? null : FormFieldLabelId;

    private bool HasExplicitAccessibleName()
        => AdditionalAttributes is not null
            && AdditionalAttributes.Keys.Any(key =>
                string.Equals(key, "aria-label", StringComparison.OrdinalIgnoreCase)
                || string.Equals(key, "aria-labelledby", StringComparison.OrdinalIgnoreCase));
}








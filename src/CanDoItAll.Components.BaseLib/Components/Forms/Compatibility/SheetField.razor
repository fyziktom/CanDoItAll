@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

@if (AsLabel)
{
    <label @attributes='BuildAttributes("flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700")'>
        @if (Icon is not null)
        {
            <span class="text-slate-400">@Icon</span>
        }
        @ChildContent
    </label>
}
else
{
    <div @attributes='BuildAttributes("flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700")'>
        @if (Icon is not null)
        {
            <span class="text-slate-400">@Icon</span>
        }
        @ChildContent
    </div>
}

@code {
    [Parameter]
    public bool AsLabel { get; set; } = true;

    [Parameter]
    public RenderFragment? Icon { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

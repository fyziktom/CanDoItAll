@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<label @attributes='BuildAttributes(Compact ? "flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700" : "flex items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700")'>
    @ChildContent
</label>

@code {
    [Parameter]
    public bool Compact { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

@namespace CanDoItAll.Components.BaseLib
@using Microsoft.AspNetCore.Components.Web

<div class="cad-tag-textedit zy-tag-textedit" data-testid="@TestId">
    <div class="cad-tag-textedit__surface zy-tag-textedit__surface @(Disabled ? "is-disabled" : string.Empty)">
        @foreach (var tag in Value)
        {
            <button class="cad-tag-textedit__chip zy-tag-textedit__chip cad-tag-textedit__chip--@GetChipColorIndex(tag) zy-tag-textedit__chip--@GetChipColorIndex(tag)"
                    style="@GetChipStyle(tag)"
                    type="button"
                    @onclick="@(() => RemoveTagAsync(tag))"
                    disabled="@Disabled">
                <span>@tag</span>
                <span class="cad-tag-textedit__chip-x zy-tag-textedit__chip-x" aria-hidden="true"><Icon Name="close" /></span>
            </button>
        }

        <input id="@InputId"
               class="cad-tag-textedit__input zy-tag-textedit__input"
               value="@pendingValue"
               @oninput="HandleInputAsync"
               @onkeydown="HandleKeyDownAsync"
               @onfocus="HandleFocusAsync"
               @onblur="HandleBlurAsync"
               maxlength="@MaxLength"
               placeholder="@Placeholder"
               disabled="@Disabled"
               data-testid="@InputTestId" />
    </div>

    @if (isFocused && MatchingSuggestions.Count > 0)
    {
        <div class="cad-tag-textedit__suggestions zy-tag-textedit__suggestions">
            @foreach (var suggestion in MatchingSuggestions)
            {
                <button class="cad-tag-textedit__suggestion zy-tag-textedit__suggestion cad-tag-textedit__suggestion--@GetChipColorIndex(suggestion) zy-tag-textedit__suggestion--@GetChipColorIndex(suggestion)"
                        style="@GetChipStyle(suggestion)"
                        type="button"
                        @onclick="@(() => AddSuggestedTagAsync(suggestion))"
                        disabled="@Disabled">
                    <span>#@suggestion</span>
                </button>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Hint))
    {
        <div class="cad-tag-textedit__hint zy-tag-textedit__hint">@Hint</div>
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<string> Value { get; set; } = Array.Empty<string>();

    [Parameter]
    public EventCallback<IReadOnlyList<string>> ValueChanged { get; set; }

    [Parameter]
    public IReadOnlyList<string> Suggestions { get; set; } = Array.Empty<string>();

    [Parameter]
    public string Placeholder { get; set; } = "Add tag";

    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public string? InputId { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter]
    public string? InputTestId { get; set; }

    [Parameter]
    public int MaxTags { get; set; } = 12;

    [Parameter]
    public int MaxLength { get; set; } = 48;

    [Parameter]
    public bool SingleTag { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private string pendingValue = string.Empty;
    private bool isFocused;
    private static readonly ChipPaletteEntry[] ChipPalette =
    [
        new("#e0f2fe", "#7dd3fc", "#0c4a6e"),
        new("#fce7f3", "#f9a8d4", "#831843"),
        new("#d1fae5", "#6ee7b7", "#064e3b"),
        new("#fef3c7", "#fcd34d", "#78350f"),
        new("#ede9fe", "#c4b5fd", "#4c1d95"),
        new("#ffedd5", "#fdba74", "#7c2d12"),
        new("#e0e7ff", "#a5b4fc", "#312e81"),
        new("#ccfbf1", "#5eead4", "#134e4a"),
        new("#fce4ec", "#f48fb1", "#880e4f"),
        new("#e8f5e9", "#81c784", "#1b5e20")
    ];

    private static int GetChipColorIndex(string tag)
    {
        var hash = 0;
        foreach (var character in tag)
        {
            hash = (hash << 5) - hash + character;
        }

        return Math.Abs(hash) % 10;
    }

    private static string GetChipStyle(string tag)
    {
        var palette = ChipPalette[GetChipColorIndex(tag)];
        return $"background:{palette.BackgroundColor};border-color:{palette.BorderColor};color:{palette.ForegroundColor};";
    }

    private IReadOnlyList<string> MatchingSuggestions => Suggestions
        .Select(item => TagTextValueNormalizer.Normalize(item, MaxLength))
        .Where(item => item is not null)
        .Cast<string>()
        .Where(item => !Value.Contains(item, StringComparer.Ordinal))
        .Where(item => string.IsNullOrWhiteSpace(pendingValue) || item.Contains(pendingValue.Trim(), StringComparison.OrdinalIgnoreCase))
        .Distinct(StringComparer.Ordinal)
        .Take(8)
        .ToArray();

    protected override async Task OnParametersSetAsync()
    {
        if (SingleTag && Value.Count > 1)
        {
            await UpdateValueAsync([Value[0]]);
        }
    }

    private async Task HandleInputAsync(ChangeEventArgs args)
    {
        pendingValue = args.Value?.ToString() ?? string.Empty;
        if (!pendingValue.Contains(',', StringComparison.Ordinal))
        {
            return;
        }

        var next = Value.ToList();
        var parts = pendingValue.Split(',', StringSplitOptions.None);

        foreach (var value in parts.Take(parts.Length - 1))
        {
            TryAddTag(next, value);
        }

        pendingValue = parts[^1].TrimStart();
        await UpdateValueAsync(next);
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (Disabled)
        {
            return;
        }

        if (args.Key is "Enter" or "Tab" or ",")
        {
            await AddCurrentTagAsync();
            return;
        }

        if (args.Key == "Backspace" && pendingValue.Length == 0 && Value.Count > 0)
        {
            await RemoveTagAsync(Value[^1]);
        }
    }

    private async Task AddSuggestedTagAsync(string value)
    {
        await AddTagAsync(value);
    }

    private void HandleFocusAsync()
    {
        isFocused = true;
    }

    private async Task HandleBlurAsync()
    {
        await Task.Delay(150);
        isFocused = false;
    }

    private async Task AddCurrentTagAsync()
    {
        await AddTagAsync(pendingValue);
    }

    private async Task AddTagAsync(string? value)
    {
        var next = Value.ToList();
        if (TryAddTag(next, value))
        {
            await UpdateValueAsync(next);
        }

        pendingValue = string.Empty;
    }

    private async Task RemoveTagAsync(string value)
    {
        var next = Value
            .Where(item => !string.Equals(item, value, StringComparison.Ordinal))
            .ToArray();

        await UpdateValueAsync(next);
    }

    private bool TryAddTag(List<string> tags, string? value)
    {
        var normalizedTag = TagTextValueNormalizer.Normalize(value, MaxLength);
        if (normalizedTag is null)
        {
            return false;
        }

        if (SingleTag)
        {
            if (tags.Count == 1 && string.Equals(tags[0], normalizedTag, StringComparison.Ordinal))
            {
                return false;
            }

            tags.Clear();
            tags.Add(normalizedTag);
            return true;
        }

        if (tags.Count >= MaxTags || tags.Contains(normalizedTag, StringComparer.Ordinal))
        {
            return false;
        }

        tags.Add(normalizedTag);
        tags.Sort(StringComparer.Ordinal);
        return true;
    }

    private async Task UpdateValueAsync(IReadOnlyList<string> next)
    {
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(next);
        }
    }

    private sealed record ChipPaletteEntry(
        string BackgroundColor,
        string BorderColor,
        string ForegroundColor);
}

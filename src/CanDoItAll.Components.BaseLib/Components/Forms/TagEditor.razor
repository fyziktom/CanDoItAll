@namespace CanDoItAll.Components.BaseLib
@using Microsoft.AspNetCore.Components.Web

<div class="space-y-2" data-testid="@TestId">
    <div class="flex flex-wrap items-center gap-2 rounded-[1.35rem] border border-slate-200 bg-white px-3 py-3 @(Disabled ? "opacity-60" : string.Empty)">
        @foreach (var tag in Value)
        {
            <button class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-medium text-slate-700"
                    type="button"
                    @onclick="@(() => RemoveTagAsync(tag))"
                    disabled="@Disabled">
                <span>@tag</span>
                <span aria-hidden="true">&times;</span>
            </button>
        }

        <input id="@InputId"
               class="min-w-[10rem] flex-1 border-0 bg-transparent p-0 text-sm text-slate-700 outline-none"
               value="@pendingValue"
               @oninput="HandleInputAsync"
               @onkeydown="HandleKeyDownAsync"
               @onfocus="HandleFocusAsync"
               @onblur="HandleBlurAsync"
               maxlength="@MaxLength"
               placeholder="@Placeholder"
               disabled="@Disabled"
               data-testid="@InputTestId" />
    </div>

    @if (isFocused && MatchingSuggestions.Count > 0)
    {
        <div class="flex flex-wrap gap-2">
            @foreach (var suggestion in MatchingSuggestions)
            {
                <button class="rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-600 hover:bg-slate-50"
                        type="button"
                        @onclick="@(() => AddSuggestedTagAsync(suggestion))"
                        disabled="@Disabled">
                    #@suggestion
                </button>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Hint))
    {
        <div class="text-xs leading-5 text-slate-500">@Hint</div>
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<string> Value { get; set; } = Array.Empty<string>();

    [Parameter]
    public EventCallback<IReadOnlyList<string>> ValueChanged { get; set; }

    [Parameter]
    public IReadOnlyList<string> Suggestions { get; set; } = Array.Empty<string>();

    [Parameter]
    public string Placeholder { get; set; } = "Add tag";

    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public string? InputId { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter]
    public string? InputTestId { get; set; }

    [Parameter]
    public int MaxTags { get; set; } = 12;

    [Parameter]
    public int MaxLength { get; set; } = 48;

    [Parameter]
    public bool SingleTag { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private string pendingValue = string.Empty;
    private bool isFocused;

    private IReadOnlyList<string> MatchingSuggestions => Suggestions
        .Select(item => TagTextValueNormalizer.Normalize(item, MaxLength))
        .Where(item => item is not null)
        .Cast<string>()
        .Where(item => !Value.Contains(item, StringComparer.Ordinal))
        .Where(item => string.IsNullOrWhiteSpace(pendingValue) || item.Contains(pendingValue.Trim(), StringComparison.OrdinalIgnoreCase))
        .Distinct(StringComparer.Ordinal)
        .Take(8)
        .ToArray();

    protected override async Task OnParametersSetAsync()
    {
        if (SingleTag && Value.Count > 1)
        {
            await UpdateValueAsync([Value[0]]);
        }
    }

    private async Task HandleInputAsync(ChangeEventArgs args)
    {
        pendingValue = args.Value?.ToString() ?? string.Empty;
        if (!pendingValue.Contains(',', StringComparison.Ordinal))
        {
            return;
        }

        var next = Value.ToList();
        var parts = pendingValue.Split(',', StringSplitOptions.None);

        foreach (var value in parts.Take(parts.Length - 1))
        {
            TryAddTag(next, value);
        }

        pendingValue = parts[^1].TrimStart();
        await UpdateValueAsync(next);
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (Disabled)
        {
            return;
        }

        if (args.Key is "Enter" or "Tab" or ",")
        {
            await AddCurrentTagAsync();
            return;
        }

        if (args.Key == "Backspace" && pendingValue.Length == 0 && Value.Count > 0)
        {
            await RemoveTagAsync(Value[^1]);
        }
    }

    private async Task AddSuggestedTagAsync(string value)
    {
        await AddTagAsync(value);
    }

    private void HandleFocusAsync()
    {
        isFocused = true;
    }

    private async Task HandleBlurAsync()
    {
        await Task.Delay(150);
        isFocused = false;
    }

    private async Task AddCurrentTagAsync()
    {
        await AddTagAsync(pendingValue);
    }

    private async Task AddTagAsync(string? value)
    {
        var next = Value.ToList();
        if (TryAddTag(next, value))
        {
            await UpdateValueAsync(next);
        }

        pendingValue = string.Empty;
    }

    private async Task RemoveTagAsync(string value)
    {
        var next = Value
            .Where(item => !string.Equals(item, value, StringComparison.Ordinal))
            .ToArray();

        await UpdateValueAsync(next);
    }

    private bool TryAddTag(List<string> tags, string? value)
    {
        var normalizedTag = TagTextValueNormalizer.Normalize(value, MaxLength);
        if (normalizedTag is null)
        {
            return false;
        }

        if (SingleTag)
        {
            if (tags.Count == 1 && string.Equals(tags[0], normalizedTag, StringComparison.Ordinal))
            {
                return false;
            }

            tags.Clear();
            tags.Add(normalizedTag);
            return true;
        }

        if (tags.Count >= MaxTags || tags.Contains(normalizedTag, StringComparer.Ordinal))
        {
            return false;
        }

        tags.Add(normalizedTag);
        tags.Sort(StringComparer.Ordinal);
        return true;
    }

    private async Task UpdateValueAsync(IReadOnlyList<string> next)
    {
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(next);
        }
    }
}

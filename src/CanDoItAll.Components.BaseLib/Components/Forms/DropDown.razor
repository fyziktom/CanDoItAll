@namespace CanDoItAll.Components.BaseLib
@typeparam TValue
@inherits StyledComponentBase

<select @attributes='BuildAttributes(ResolveCssClass())'
        aria-labelledby="@ResolveLabelledBy()"
        value="@ResolveSelectedKey()"
        disabled="@Disabled"
        @onchange="OnChangedAsync"
        >
    @if (!string.IsNullOrWhiteSpace(Placeholder) || AllowClear)
    {
        <option value="">@Placeholder</option>
    }
    @foreach (var option in options)
    {
        <option value="@option.Key">@option.Text</option>
    }
</select>

@code {
    private readonly List<DropDownOption<TValue>> options = [];

    [Parameter]
    public System.Collections.IEnumerable? Data { get; set; }

    [Parameter]
    public TValue? Value { get; set; }

    [Parameter]
    public EventCallback<TValue?> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<object?> Change { get; set; }

    [Parameter]
    public string? TextProperty { get; set; }

    [Parameter]
    public string? ValueProperty { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public bool AllowClear { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public InputLook Look { get; set; } = InputLook.Default;

    [CascadingParameter(Name = "FormFieldLabelId")]
    public string? FormFieldLabelId { get; set; }

    protected override void OnParametersSet()
    {
        options.Clear();

        if (Data is null)
        {
            return;
        }

        var index = 0;
        foreach (var item in Data)
        {
            var textValue = ResolveMemberValue(item, TextProperty) ?? item;
            var rawValue = ResolveMemberValue(item, ValueProperty) ?? item;
            if (!TryConvertValue(rawValue, out var converted))
            {
                continue;
            }

            options.Add(new DropDownOption<TValue>(
                Key: index.ToString(System.Globalization.CultureInfo.InvariantCulture),
                Text: textValue?.ToString() ?? string.Empty,
                Value: converted));

            index++;
        }
    }

    private string ResolveSelectedKey()
    {
        for (var index = 0; index < options.Count; index++)
        {
            if (EqualityComparer<TValue?>.Default.Equals(options[index].Value, Value))
            {
                return options[index].Key;
            }
        }

        return string.Empty;
    }

    private async Task OnChangedAsync(ChangeEventArgs args)
    {
        var key = args.Value?.ToString();
        TValue? next = default;

        if (!string.IsNullOrWhiteSpace(key))
        {
            var option = options.FirstOrDefault(current => current.Key == key);
            if (option is not null)
            {
                next = option.Value;
            }
        }

        Value = next;
        await ValueChanged.InvokeAsync(next);
        await Change.InvokeAsync(next);
    }

    private static object? ResolveMemberValue(object? item, string? memberName)
    {
        if (item is null || string.IsNullOrWhiteSpace(memberName))
        {
            return item;
        }

        var property = item.GetType().GetProperty(memberName);
        return property?.GetValue(item);
    }

    private static bool TryConvertValue(object? value, out TValue? converted)
    {
        if (value is null)
        {
            converted = default;
            return true;
        }

        if (value is TValue typed)
        {
            converted = typed;
            return true;
        }

        try
        {
            var targetType = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);
            if (targetType.IsEnum)
            {
                if (value is string stringValue && Enum.TryParse(targetType, stringValue, true, out var enumResult))
                {
                    converted = (TValue?)enumResult;
                    return true;
                }

                var enumObject = Enum.ToObject(targetType, value);
                converted = (TValue?)enumObject;
                return true;
            }

            var convertedValue = Convert.ChangeType(value, targetType, System.Globalization.CultureInfo.InvariantCulture);
            converted = (TValue?)convertedValue;
            return true;
        }
        catch
        {
            converted = default;
            return false;
        }
    }

    private string ResolveCssClass()
    {
        return Look switch
        {
            InputLook.Plain => string.Empty,
            _ => "rz-select w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800"
        };
    }

    private string? ResolveLabelledBy()
        => HasExplicitAccessibleName() ? null : FormFieldLabelId;

    private bool HasExplicitAccessibleName()
        => AdditionalAttributes is not null
            && AdditionalAttributes.Keys.Any(key =>
                string.Equals(key, "aria-label", StringComparison.OrdinalIgnoreCase)
                || string.Equals(key, "aria-labelledby", StringComparison.OrdinalIgnoreCase));
}








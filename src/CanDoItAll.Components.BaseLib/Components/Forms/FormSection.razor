@namespace CanDoItAll.Components.BaseLib
<section class="space-y-4 rounded-[1.5rem] border border-slate-200 bg-slate-50/80 p-5">
    <Split Breakpoint="LayoutBreakpoint.Md"
           Gap="LayoutGap.Medium"
           AlignItems="AlignItems.Start"
           JustifyContent="JustifyContent.SpaceBetween">
        <div class="space-y-1">
            <h2 class="text-base font-semibold text-slate-950">@Title</h2>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p class="text-sm leading-6 text-slate-600">@Description</p>
            }
        </div>

        @if (Actions is not null)
        {
            <Cluster>
                @Actions
            </Cluster>
        }
    </Split>

    <div class="space-y-4">
        @ChildContent
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}



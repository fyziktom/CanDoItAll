@namespace CanDoItAll.Components.BaseLib
<section class="space-y-4 rounded-[1.5rem] border border-slate-200 bg-slate-50/80 p-5">
    <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
        <div class="space-y-1">
            <h2 class="text-base font-semibold text-slate-950">@Title</h2>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p class="text-sm leading-6 text-slate-600">@Description</p>
            }
        </div>

        @if (Actions is not null)
        {
            <div class="flex flex-wrap items-center gap-2">
                @Actions
            </div>
        }
    </div>

    <div class="space-y-4">
        @ChildContent
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}



@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase
@implements IDisposable

<div class="@ResolveRootCssClass()">
    <div class="flex min-w-0 flex-1 items-center gap-2">
        <input type="@(isRevealed ? "text" : "password")"
               @attributes='BuildAttributes(ResolveInputCssClass())'
               value="@Value"
               placeholder="@Placeholder"
               readonly="@ReadOnly"
               disabled="@Disabled"
               autocomplete="@Autocomplete"
               @onchange="OnChangedAsync" />
        @if (EnableTimedReveal)
        {
            <Button Text="@ResolveRevealText()"
                    Icon="@ResolveRevealIcon()"
                    ButtonStyle="ButtonStyle.Light"
                    Size="ButtonSize.Small"
                    Disabled="@Disabled"
                    Click="ToggleRevealAsync" />
        }
    </div>
    @if (ShowValueCopy || ShowNameCopy)
    {
        <Cluster Gap="LayoutGap.Tiny" Wrap="FlexWrap.Wrap" Class="min-w-fit">
            @if (ShowValueCopy)
            {
                <CopyButton Value="@Value"
                            Text="Copy value"
                            AriaLabel="Copy secret value"
                            Size="CopyButtonSize.Small"
                            Disabled="@(Disabled || string.IsNullOrEmpty(Value))" />
            }
            @if (ShowNameCopy)
            {
                <CopyButton Value="@SecretName"
                            Text="Copy name"
                            AriaLabel="Copy secret name"
                            Size="CopyButtonSize.Small"
                            Disabled="@(string.IsNullOrWhiteSpace(SecretName))" />
            }
        </Cluster>
    }
</div>

@code {
    private CancellationTokenSource? revealCts;
    private bool isRevealed;

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<string?> Change { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public string? SecretName { get; set; }

    [Parameter]
    public bool ShowValueCopy { get; set; } = true;

    [Parameter]
    public bool ShowNameCopy { get; set; }

    [Parameter]
    public bool EnableTimedReveal { get; set; } = true;

    [Parameter]
    public int RevealDurationSeconds { get; set; } = 30;

    [Parameter]
    public string Autocomplete { get; set; } = "off";

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public InputLook Look { get; set; } = InputLook.Default;

    private async Task OnChangedAsync(ChangeEventArgs args)
    {
        var next = args.Value?.ToString();
        Value = next;
        await ValueChanged.InvokeAsync(next);
        await Change.InvokeAsync(next);
    }

    private async Task ToggleRevealAsync()
    {
        if (Disabled)
        {
            return;
        }

        if (isRevealed)
        {
            HideValue();
            return;
        }

        await RevealForDurationAsync();
    }

    private async Task RevealForDurationAsync()
    {
        revealCts?.Cancel();
        revealCts?.Dispose();
        revealCts = new CancellationTokenSource();
        isRevealed = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var delay = TimeSpan.FromSeconds(Math.Clamp(RevealDurationSeconds, 1, 300));
            await Task.Delay(delay, revealCts.Token);
            HideValue();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void HideValue()
    {
        revealCts?.Cancel();
        isRevealed = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private string ResolveRevealText()
        => isRevealed ? "Hide" : $"Show for {Math.Clamp(RevealDurationSeconds, 1, 300)}s";

    private string ResolveRevealIcon()
        => isRevealed ? "visibility_off" : "visibility";

    private string ResolveRootCssClass()
        => BuildClass("flex w-full min-w-0 flex-col gap-2 sm:flex-row sm:items-center");

    private string ResolveInputCssClass()
    {
        return Look switch
        {
            InputLook.Plain => string.Empty,
            _ => "rz-input w-full min-w-0 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800"
        };
    }

    public void Dispose()
    {
        revealCts?.Cancel();
        revealCts?.Dispose();
    }
}

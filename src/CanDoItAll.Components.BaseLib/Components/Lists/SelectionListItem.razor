@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<div @attributes='BuildAttributes(ResolveContainerClass())'>
    <Cluster AlignItems="AlignItems.Start"
             Wrap="FlexWrap.NoWrap"
             Gap="@(Dense ? LayoutGap.Small : LayoutGap.Medium)">
        <button type="button"
                class="cda-selection-list-item__button min-w-0 flex-1 text-left"
                data-testid="@DataTestId"
                @onclick="HandleSelectAsync">
            <Split Breakpoint="LayoutBreakpoint.None"
                   Gap="@(Dense ? LayoutGap.Small : LayoutGap.Medium)"
                   AlignItems="AlignItems.Start"
                   JustifyContent="JustifyContent.SpaceBetween"
                   Wrap="FlexWrap.Wrap">
                <Stack GapScale="LayoutGap.Tiny"
                       Class="min-w-0">
                    <Cluster>
                        <p class="cda-selection-list-item__title truncate text-sm font-semibold text-slate-950">@Title</p>
                        @if (!string.IsNullOrWhiteSpace(Eyebrow))
                        {
                            <Pill Tone="PillTone.Label" Text="@Eyebrow" />
                        }
                    </Cluster>

                    @if (!string.IsNullOrWhiteSpace(Meta))
                    {
                        <p class="cda-selection-list-item__meta text-xs text-slate-500">@Meta</p>
                    }
                </Stack>

                @if (Status is not null)
                {
                    <div class="shrink-0">
                        @Status
                    </div>
                }
            </Split>

            @if (!string.IsNullOrWhiteSpace(Summary))
            {
                <p class="@ResolveSummaryClass()">@Summary</p>
            }

            @if (ChildContent is not null)
            {
                <div class="@(Dense ? "mt-2" : "mt-3")">
                    @ChildContent
                </div>
            }
        </button>

        @if (Actions is not null)
        {
            <div class="shrink-0">
                @Actions
            </div>
        }
    </Cluster>
</div>

@code {
    [Parameter]
    public bool IsSelected { get; set; }

    [Parameter]
    public string? Eyebrow { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Meta { get; set; }

    [Parameter]
    public string? Summary { get; set; }

    [Parameter]
    public string? DataTestId { get; set; }

    [Parameter]
    public bool Dense { get; set; }

    [Parameter]
    public RenderFragment? Status { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public EventCallback OnSelect { get; set; }

    private Task HandleSelectAsync() => OnSelect.InvokeAsync();

    private string ResolveContainerClass()
        => IsSelected
            ? (Dense
                ? "cda-selection-list-item rounded-[1.25rem] border border-sky-300 bg-sky-50/80 p-3.5 shadow-sm shadow-sky-100"
                : "cda-selection-list-item rounded-[1.4rem] border border-sky-300 bg-sky-50/80 p-4 shadow-sm shadow-sky-100")
            : (Dense
                ? "cda-selection-list-item rounded-[1.25rem] border border-slate-200 bg-slate-50/90 p-3.5 transition hover:border-slate-300 hover:bg-slate-50"
                : "cda-selection-list-item rounded-[1.4rem] border border-slate-200 bg-slate-50/90 p-4 transition hover:border-slate-300 hover:bg-slate-50");

    private string ResolveSummaryClass()
        => Dense
            ? "cda-selection-list-item__summary mt-2 text-sm leading-5 text-slate-600"
            : "cda-selection-list-item__summary mt-3 text-sm leading-6 text-slate-600";
}



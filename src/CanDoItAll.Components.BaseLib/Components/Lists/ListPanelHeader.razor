@namespace CanDoItAll.Components.BaseLib
<Stack GapScale="LayoutGap.Medium">
    <Split Breakpoint="LayoutBreakpoint.Md"
           Gap="LayoutGap.Small"
           AlignItems="AlignItems.Start"
           JustifyContent="JustifyContent.SpaceBetween">
        <Stack GapScale="LayoutGap.Tiny"
               Class="min-w-0">
            <Cluster>
                <h2 class="text-base font-semibold text-slate-950 xl:text-lg">@Title</h2>
                @if (!string.IsNullOrWhiteSpace(Count))
                {
                    <Pill Tone="PillTone.Label" Text="@Count" />
                }
            </Cluster>

            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p class="max-w-3xl text-sm leading-5 text-slate-600">@Description</p>
            }
        </Stack>

        @if (Actions is not null)
        {
            <Cluster>
                @Actions
            </Cluster>
        }
    </Split>

    @if (Filters is not null)
    {
        <div>
            @Filters
        </div>
    }
</Stack>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? Count { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public RenderFragment? Filters { get; set; }
}



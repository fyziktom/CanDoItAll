@namespace CanDoItAll.Components.BaseLib
<Stack GapScale="@(Dense ? LayoutGap.Small : LayoutGap.Medium)">
    <Split Breakpoint="LayoutBreakpoint.Md"
           Gap="@(Dense ? LayoutGap.Tiny : LayoutGap.Small)"
           AlignItems="AlignItems.Start"
           JustifyContent="JustifyContent.SpaceBetween">
        <Stack GapScale="LayoutGap.Tiny"
               Class="min-w-0">
            <Cluster Gap="LayoutGap.Small"
                     Wrap="FlexWrap.Wrap">
                <div class="inline-flex min-w-0 items-center gap-2">
                    <h2 class="text-base font-semibold text-slate-950 xl:text-lg">@Title</h2>
                    @if (HasHelp)
                    {
                        <HelpPopover RootClass="pf-help-popover inline-flex items-center"
                                     ToggleClass="pf-help-popover__toggle pf-help-popover__toggle--compact"
                                     OpenOnHover="true"
                                     AriaLabel="@ResolvedHelpAriaLabel"
                                     Title="@ResolvedHelpAriaLabel"
                                     Heading="@ResolvedHelpHeading"
                                     Body="@(HelpText!)" />
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(Count))
                {
                    <Pill Tone="PillTone.Label" Text="@Count" />
                }
            </Cluster>

            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p class="max-w-3xl text-sm leading-5 text-slate-600">@Description</p>
            }
        </Stack>

        @if (Actions is not null)
        {
            <Cluster>
                @Actions
            </Cluster>
        }
    </Split>

    @if (Filters is not null)
    {
        <div>
            @Filters
        </div>
    }
</Stack>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? Count { get; set; }

    [Parameter]
    public string? HelpText { get; set; }

    [Parameter]
    public string? HelpHeading { get; set; }

    [Parameter]
    public bool Dense { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public RenderFragment? Filters { get; set; }

    private bool HasHelp => !string.IsNullOrWhiteSpace(HelpText);

    private string ResolvedHelpHeading => string.IsNullOrWhiteSpace(HelpHeading) ? Title : HelpHeading;

    private string ResolvedHelpAriaLabel => $"Show help for {Title}";
}



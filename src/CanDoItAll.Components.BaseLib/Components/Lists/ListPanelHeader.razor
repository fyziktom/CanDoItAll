@namespace CanDoItAll.Components.BaseLib
<div class="space-y-4">
    <Split Breakpoint="LayoutBreakpoint.Lg"
           Gap="LayoutGap.Medium"
           AlignItems="AlignItems.Start"
           JustifyContent="JustifyContent.SpaceBetween">
        <div class="space-y-1">
            <Cluster>
                <h2 class="text-lg font-semibold text-slate-950">@Title</h2>
                @if (!string.IsNullOrWhiteSpace(Count))
                {
                    <Pill Tone="PillTone.Label" Text="@Count" />
                }
            </Cluster>

            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p class="text-sm leading-6 text-slate-600">@Description</p>
            }
        </div>

        @if (Actions is not null)
        {
            <Cluster>
                @Actions
            </Cluster>
        }
    </Split>

    @if (Filters is not null)
    {
        <div>
            @Filters
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? Count { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public RenderFragment? Filters { get; set; }
}



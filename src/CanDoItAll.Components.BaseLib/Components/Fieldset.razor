@namespace CanDoItAll.Components.BaseLib
@if (AllowCollapse)
{
    <details class="rz-fieldset rounded-lg border border-slate-200 bg-white p-3" open>
        <summary title="@CollapseTitle" aria-label="@CollapseAriaLabel" class="cursor-pointer select-none text-sm font-semibold text-slate-700">
            @if (HeaderTemplate is not null)
            {
                @HeaderTemplate
            }
        </summary>
        <div class="mt-3">
            @ChildContent
        </div>
    </details>
}
else
{
    <fieldset class="rz-fieldset rounded-lg border border-slate-200 bg-white p-3">
        @if (HeaderTemplate is not null)
        {
            <legend class="px-1 text-sm font-semibold text-slate-700">@HeaderTemplate</legend>
        }
        @ChildContent
    </fieldset>
}

@code {
    [Parameter]
    public bool AllowCollapse { get; set; }

    [Parameter]
    public string? CollapseAriaLabel { get; set; }

    [Parameter]
    public string? CollapseTitle { get; set; }

    [Parameter]
    public string? ExpandAriaLabel { get; set; }

    [Parameter]
    public string? ExpandTitle { get; set; }

    [Parameter]
    public RenderFragment? HeaderTemplate { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}




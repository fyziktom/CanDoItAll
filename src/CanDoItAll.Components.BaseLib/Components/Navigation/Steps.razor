@namespace CanDoItAll.Components.BaseLib
<CascadingValue Value="this" IsFixed="true">
    <div style="display:none">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
    </div>
</CascadingValue>

@if (items.Count > 0)
{
    var activeItem = items[EffectiveValue];

    <div @attributes='AdditionalAttributes.WithClass("rz-steps flex flex-col gap-4 rounded-[1.75rem] border border-slate-200/80 bg-white/95 p-4 shadow-[0_24px_80px_rgba(15,23,42,0.08)] md:p-5")'>
        <ol class="relative grid items-start gap-x-2 gap-y-3 sm:gap-x-4"
            style="@ResolveStepListStyle()"
            role="list">
            @for (var index = 0; index < items.Count; index++)
            {
                var stepIndex = index;
                var item = items[stepIndex];
                var isActive = stepIndex == EffectiveValue;
                var isCompleted = stepIndex < EffectiveValue;
                var canSelectCurrent = CanSelectStep(stepIndex, item);
                var iconName = ResolveIconName(item.Icon);

                <li class="relative min-w-0">
                    @if (stepIndex > 0)
                    {
                        <span class="pointer-events-none absolute left-0 top-4 h-px w-1/2 @(ResolveConnectorVisibilityCss()) @(ResolveConnectorCss(isCompleted || isActive))"></span>
                    }
                    @if (stepIndex < items.Count - 1)
                    {
                        <span class="pointer-events-none absolute right-0 top-4 h-px w-1/2 @(ResolveConnectorVisibilityCss()) @(ResolveConnectorCss(stepIndex < EffectiveValue))"></span>
                    }

                    <button type="button"
                            disabled="@(!canSelectCurrent || NavigationDisabled)"
                            aria-current="@(isActive ? "step" : null)"
                            class="rz-steps-step-button group relative z-10 flex w-full flex-col items-center gap-2 rounded-[1rem] bg-transparent px-1 py-0.5 text-center shadow-none transition disabled:cursor-not-allowed disabled:opacity-45 @(ResolveStepButtonCss(isActive, isCompleted, item.Disabled))"
                            style="@ResolveStepButtonStyle()"
                            @onclick="() => TrySelectAsync(stepIndex)">
                        <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border text-xs font-semibold shadow-sm @(ResolveStepBadgeCss(isActive, isCompleted, item.Disabled))">
                            @if (isCompleted)
                            {
                                <Icon Name="check" />
                            }
                            else if (iconName is not null)
                            {
                                <span class="rz-icon cda-material-icon material-icons" aria-hidden="true">@iconName</span>
                            }
                            else if (!string.IsNullOrWhiteSpace(item.Icon))
                            {
                                <span class="rz-icon-fallback" title="@($"Unknown icon token: {item.Icon}")" aria-hidden="true">@item.Icon</span>
                            }
                            else
                            {
                                <span>@(index + 1)</span>
                            }
                        </span>

                        <span class="max-w-[7rem] text-[0.8rem] font-semibold leading-4 @(ResolveLabelCss(isActive, isCompleted, item.Disabled))">@item.Text</span>
                    </button>
                </li>
            }
        </ol>

        @if (activeItem.ChildContent is not null)
        {
            <div class="rounded-[1.5rem] border border-slate-200/80 bg-slate-50/70 p-4 shadow-inner shadow-white md:p-5">
                <Stack GapScale="LayoutGap.Large">
                    <Split Breakpoint="LayoutBreakpoint.Lg"
                           Gap="LayoutGap.Medium"
                           AlignItems="AlignItems.Start"
                           JustifyContent="JustifyContent.SpaceBetween"
                           Class="border-b border-slate-200/80 pb-4">
                        <Stack GapScale="LayoutGap.Small"
                               Class="min-w-0">
                            <div class="cda-eyebrow text-violet-700 tracking-[0.26em]">Step @(EffectiveValue + 1) of @items.Count</div>
                            <div class="text-[1.7rem] font-semibold leading-tight text-slate-950">@activeItem.Text</div>
                            @if (!string.IsNullOrWhiteSpace(activeItem.Description))
                            {
                                <p class="max-w-2xl text-sm leading-6 text-slate-600">@activeItem.Description</p>
                            }
                        </Stack>

                        @if (ShouldRenderNavigation(isTop: true))
                        {
                            <Cluster Gap="LayoutGap.Medium" Class="shrink-0">
                                @RenderNavigationButtons(isTop: true)
                            </Cluster>
                        }
                    </Split>

                    @activeItem.ChildContent

                    @if (ShouldRenderNavigation(isTop: false))
                    {
                        <Cluster JustifyContent="JustifyContent.End"
                                 Gap="LayoutGap.Medium"
                                 Class="border-t border-slate-200/80 pt-4">
                            @RenderNavigationButtons(isTop: false)
                        </Cluster>
                    }
                </Stack>
            </div>
        }
    </div>
}

@code {
    private readonly List<StepsItem> items = [];

    [Parameter]
    public int Value { get; set; }

    [Parameter]
    public EventCallback<int> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<int> Change { get; set; }

    [Parameter]
    public Func<int, Task<bool>>? CanChange { get; set; }

    [Parameter]
    public bool CanSelect { get; set; } = true;

    [Parameter]
    public bool Linear { get; set; }

    [Parameter]
    public bool ShowDescriptions { get; set; }

    [Parameter]
    public bool NavigationDisabled { get; set; }

    [Parameter]
    public StepsNavigationPosition NavigationPosition { get; set; } = StepsNavigationPosition.None;

    [Parameter]
    public string PreviousText { get; set; } = "Previous";

    [Parameter]
    public string NextText { get; set; } = "Next";

    [Parameter]
    public string? PreviousButtonTestId { get; set; }

    [Parameter]
    public string? NextButtonTestId { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    internal void RegisterItem(StepsItem item)
    {
        if (!items.Contains(item))
        {
            items.Add(item);
            _ = InvokeAsync(StateHasChanged);
        }
    }

    internal void UnregisterItem(StepsItem item)
    {
        if (items.Remove(item))
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private int EffectiveValue
    {
        get
        {
            if (items.Count == 0)
            {
                return 0;
            }

            return Math.Clamp(Value, 0, items.Count - 1);
        }
    }

    private bool CanMovePrevious => EffectiveValue > 0;
    private bool CanMoveNext => EffectiveValue < items.Count - 1;

    private async Task TrySelectAsync(int index, bool ignoreSelectionGuard = false)
    {
        if (index < 0 || index >= items.Count)
        {
            return;
        }

        if (index == EffectiveValue)
        {
            return;
        }

        if (!ignoreSelectionGuard && !CanSelectStep(index, items[index]))
        {
            return;
        }

        if (CanChange is not null)
        {
            var canChange = await CanChange(index);
            if (!canChange)
            {
                return;
            }
        }

        Value = index;
        await ValueChanged.InvokeAsync(Value);
        await Change.InvokeAsync(Value);
    }

    private Task MovePreviousAsync()
    {
        return TrySelectAsync(EffectiveValue - 1, ignoreSelectionGuard: true);
    }

    private Task MoveNextAsync()
    {
        return TrySelectAsync(EffectiveValue + 1, ignoreSelectionGuard: true);
    }

    private bool CanSelectStep(int index, StepsItem item)
    {
        if (!CanSelect || item.Disabled)
        {
            return false;
        }

        if (!Linear)
        {
            return true;
        }

        return index <= EffectiveValue;
    }

    private bool ShouldRenderNavigation(bool isTop)
    {
        return NavigationPosition switch
        {
            StepsNavigationPosition.Top => isTop,
            StepsNavigationPosition.Bottom => !isTop,
            StepsNavigationPosition.Both => true,
            _ => false
        };
    }

    private string ResolveStepListStyle()
    {
        return items.Count switch
        {
            <= 1 => "grid-template-columns:minmax(0,1fr);",
            _ => "grid-template-columns:repeat(auto-fit,minmax(6.75rem,1fr));"
        };
    }

    private static string ResolveConnectorCss(bool isCompleted)
    {
        return isCompleted ? "bg-violet-500/80" : "bg-slate-200";
    }

    private string ResolveConnectorVisibilityCss()
    {
        return items.Count switch
        {
            <= 1 => "hidden",
            _ => "hidden md:block"
        };
    }

    private static string ResolveStepButtonCss(bool isActive, bool isCompleted, bool isDisabled)
    {
        if (isDisabled)
        {
            return "hover:bg-transparent";
        }

        if (isActive)
        {
            return "scale-[1.01]";
        }

        return isCompleted ? "hover:bg-emerald-50/40" : "hover:bg-slate-100/50";
    }

    private static string ResolveStepBadgeCss(bool isActive, bool isCompleted, bool isDisabled)
    {
        if (isDisabled)
        {
            return "border-slate-200 bg-slate-100 text-slate-400";
        }

        if (isActive)
        {
            return "border-violet-600 bg-violet-600 text-white";
        }

        if (isCompleted)
        {
            return "border-emerald-300 bg-emerald-50 text-emerald-700";
        }

        return "border-slate-200 bg-white text-slate-600";
    }

    private static string ResolveLabelCss(bool isActive, bool isCompleted, bool isDisabled)
    {
        if (isDisabled)
        {
            return "text-slate-400";
        }

        if (isActive)
        {
            return "text-violet-700";
        }

        return isCompleted ? "text-slate-800" : "text-slate-600";
    }

    private static string ResolveNavigationButtonCss(bool isPrimary)
    {
        return isPrimary
            ? "rz-steps-nav-button rz-steps-nav-button--primary inline-flex items-center justify-center rounded-full px-4 py-2 text-sm font-semibold transition disabled:cursor-not-allowed disabled:bg-slate-300"
            : "rz-steps-nav-button rz-steps-nav-button--secondary inline-flex items-center justify-center rounded-full border px-4 py-2 text-sm font-semibold transition disabled:cursor-not-allowed disabled:opacity-50";
    }

    private static string ResolveStepButtonStyle()
    {
        return "min-height:auto;padding:0.125rem 0.25rem;border:0;background:transparent;box-shadow:none;color:inherit;";
    }

    private static string ResolveNavigationButtonStyle(bool isPrimary)
    {
        return isPrimary
            ? "min-height:2.5rem;border:0;background:linear-gradient(135deg,#8b5cf6,#7c3aed);color:#fff;box-shadow:0 12px 24px rgba(124,58,237,0.2);"
            : "min-height:2.5rem;border:1px solid rgba(148,163,184,0.6);background:rgba(255,255,255,0.92);color:rgb(51,65,85);box-shadow:none;";
    }

    private IReadOnlyDictionary<string, object>? ResolveNavigationTestAttributes(string? testId, bool isTop)
    {
        if (string.IsNullOrWhiteSpace(testId))
        {
            return null;
        }

        var shouldApply = NavigationPosition switch
        {
            StepsNavigationPosition.Top => isTop,
            StepsNavigationPosition.Bottom => !isTop,
            StepsNavigationPosition.Both => !isTop,
            _ => false
        };

        if (!shouldApply)
        {
            return null;
        }

        return new Dictionary<string, object>
        {
            ["data-testid"] = testId
        };
    }

    private static string? ResolveIconName(string? iconToken)
    {
        if (MaterialIconCatalog.TryResolveIconName(iconToken, out var iconName))
        {
            return iconName;
        }

        return null;
    }
}

@functions {
    private RenderFragment RenderNavigationButtons(bool isTop) => builder =>
    {
        var sequence = 0;

        if (CanMovePrevious)
        {
            builder.OpenElement(sequence++, "button");
            builder.AddAttribute(sequence++, "type", "button");
            builder.AddAttribute(sequence++, "class", ResolveNavigationButtonCss(isPrimary: false));
            builder.AddAttribute(sequence++, "style", ResolveNavigationButtonStyle(isPrimary: false));
            builder.AddAttribute(sequence++, "disabled", NavigationDisabled);
            builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, MovePreviousAsync));
            var previousAttributes = ResolveNavigationTestAttributes(PreviousButtonTestId, isTop);
            if (previousAttributes is not null)
            {
                builder.AddMultipleAttributes(sequence++, previousAttributes);
            }
            builder.AddContent(sequence++, PreviousText);
            builder.CloseElement();
        }

        if (CanMoveNext)
        {
            builder.OpenElement(sequence++, "button");
            builder.AddAttribute(sequence++, "type", "button");
            builder.AddAttribute(sequence++, "class", ResolveNavigationButtonCss(isPrimary: true));
            builder.AddAttribute(sequence++, "style", ResolveNavigationButtonStyle(isPrimary: true));
            builder.AddAttribute(sequence++, "disabled", NavigationDisabled);
            builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, MoveNextAsync));
            var nextAttributes = ResolveNavigationTestAttributes(NextButtonTestId, isTop);
            if (nextAttributes is not null)
            {
                builder.AddMultipleAttributes(sequence++, nextAttributes);
            }
            builder.AddContent(sequence++, NextText);
            builder.CloseElement();
        }
    };
}



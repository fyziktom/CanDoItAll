@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<div @attributes='BuildAttributes("rounded-[1.2rem] border border-slate-200 bg-slate-50/90 px-3.5 py-2.5")'>
    <Split Breakpoint="LayoutBreakpoint.Lg"
           Gap="LayoutGap.Small"
           AlignItems="AlignItems.Center"
           JustifyContent="JustifyContent.SpaceBetween">
        <Cluster Class="min-w-0 flex-1">
            @ChildContent
        </Cluster>

        @if (Actions is not null || !string.IsNullOrWhiteSpace(ResultText))
        {
            <Cluster Class="text-[11px] font-medium text-slate-500">
                @if (!string.IsNullOrWhiteSpace(ResultText))
                {
                    <span>@ResultText</span>
                }

                @if (Actions is not null)
                {
                    @Actions
                }
            </Cluster>
        }
    </Split>
</div>

@code {
    [Parameter]
    public string? ResultText { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}



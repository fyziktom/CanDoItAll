@namespace CanDoItAll.Components.BaseLib
@using Microsoft.AspNetCore.Components.Web

<li class="cda-treeview__item"
    role="treeitem"
    aria-expanded="@(Node.HasChildren ? Node.IsExpanded.ToString().ToLowerInvariant() : null)"
    aria-selected="@(Node.IsSelectable ? Node.IsSelected.ToString().ToLowerInvariant() : null)"
    style="@($"--cda-treeview-level:{Level};")">
    <div class="cda-treeview__row-shell">
        @if (Node.HasChildren)
        {
            <button type="button"
                    class="cda-treeview__toggle"
                    title="@(Node.IsExpanded ? "Collapse" : "Expand")"
                    aria-label="@(Node.IsExpanded ? $"Collapse {Node.Text}" : $"Expand {Node.Text}")"
                    @onclick="HandleToggleAsync">
                <Icon Name="@(Node.IsExpanded ? "expand_more" : "chevron_right")" />
            </button>
        }
        else
        {
            <span class="cda-treeview__toggle cda-treeview__toggle--placeholder" aria-hidden="true"></span>
        }

        <button type="button"
                class="@ResolveRowCssClass()"
                title="@ResolveTooltip()"
                data-testid="@ResolveDataTestId()"
                disabled="@Node.IsDisabled"
                @onclick="HandleRowClickAsync"
                @onkeydown="HandleRowKeyDownAsync"
                @oncontextmenu="HandleContextMenuAsync"
                @oncontextmenu:preventDefault="true">
            @if (!string.IsNullOrWhiteSpace(Node.Icon))
            {
                <span class="cda-treeview__icon" aria-hidden="true">
                    <Icon Name="@Node.Icon" />
                </span>
            }

            <span class="cda-treeview__text">@Node.Text</span>

            @if (!string.IsNullOrWhiteSpace(Node.BadgeText))
            {
                <span class="cda-treeview__badge">@Node.BadgeText</span>
            }
        </button>
    </div>

    @if (Node.HasChildren && Node.IsExpanded)
    {
        <ul class="cda-treeview__children"
            role="group"
            data-testid="@ResolveChildrenDataTestId()">
            @foreach (var child in Node.Children)
            {
                <TreeViewNodeRow Node="@child"
                                 Level="@(Level + 1)"
                                 Style="@Style"
                                 OnSelect="OnSelect"
                                 OnToggle="OnToggle"
                                 OnContextMenu="OnContextMenu" />
            }
        </ul>
    }
</li>

@code {
    [Parameter, EditorRequired]
    public TreeViewNode Node { get; set; } = default!;

    [Parameter]
    public int Level { get; set; }

    [Parameter]
    public TreeViewStyle Style { get; set; }

    [Parameter]
    public EventCallback<string> OnSelect { get; set; }

    [Parameter]
    public EventCallback<string> OnToggle { get; set; }

    [Parameter]
    public EventCallback<TreeViewNodeContextMenuRequest> OnContextMenu { get; set; }

    private Task HandleToggleAsync()
    {
        if (Node.IsDisabled || !Node.HasChildren)
        {
            return Task.CompletedTask;
        }

        return OnToggle.InvokeAsync(Node.Id);
    }

    private Task HandleRowClickAsync()
    {
        if (Node.IsDisabled)
        {
            return Task.CompletedTask;
        }

        if (Node.HasChildren && !Node.IsSelectable)
        {
            return OnToggle.InvokeAsync(Node.Id);
        }

        return OnSelect.InvokeAsync(Node.Id);
    }

    private Task HandleRowKeyDownAsync(KeyboardEventArgs args)
    {
        if (Node.IsDisabled || !Node.HasChildren)
        {
            return Task.CompletedTask;
        }

        return args.Key switch
        {
            "ArrowRight" when !Node.IsExpanded => OnToggle.InvokeAsync(Node.Id),
            "ArrowLeft" when Node.IsExpanded => OnToggle.InvokeAsync(Node.Id),
            _ => Task.CompletedTask
        };
    }

    private Task HandleContextMenuAsync(MouseEventArgs args)
    {
        if (Node.IsDisabled || !OnContextMenu.HasDelegate)
        {
            return Task.CompletedTask;
        }

        return OnContextMenu.InvokeAsync(new TreeViewNodeContextMenuRequest(
            Node.Id,
            args.ClientX,
            args.ClientY));
    }

    private string ResolveRowCssClass()
    {
        var cssClass = "cda-treeview__row";
        if (Style == TreeViewStyle.Workbench)
        {
            cssClass += " cda-treeview__row--workbench";
        }

        if (Node.IsSelected)
        {
            cssClass += " cda-treeview__row--selected";
        }

        if (Node.HasChildren)
        {
            cssClass += " cda-treeview__row--branch";
        }

        if (Node.IsDisabled)
        {
            cssClass += " cda-treeview__row--disabled";
        }

        return cssClass;
    }

    private string ResolveTooltip()
    {
        return string.IsNullOrWhiteSpace(Node.Tooltip)
            ? Node.Text
            : Node.Tooltip;
    }

    private string? ResolveDataTestId()
    {
        return string.IsNullOrWhiteSpace(Node.DataTestId)
            ? null
            : Node.DataTestId;
    }

    private string? ResolveChildrenDataTestId()
    {
        return string.IsNullOrWhiteSpace(Node.ChildrenDataTestId)
            ? null
            : Node.ChildrenDataTestId;
    }
}

@namespace CanDoItAll.Components.BaseLib
@typeparam TTab

<RibbonTabs TItem="TTab"
            Items="Tabs"
            SelectedItem="ActiveTab"
            SelectedItemChanged="HandleSelectedAsync"
            PanelContent="PanelContent"
            IsCollapsed="IsCollapsed"
            OnToggleCollapsed="OnToggleCollapsed"
            AriaLabel="@AriaLabel"
            RootClass="@RootClass"
            ChromeClass="@ChromeClass"
            ControlsClass="@ControlsClass"
            TabsClass="@TabsClass"
            TabClass="@TabClass"
            ActiveTabClass="@ActiveTabClass"
            ToggleClass="@ToggleClass"
            PanelClass="@PanelClass"
            RootTestId="@RootTestId"
            ToggleTestId="@ToggleTestId"
            PanelTestId="@PanelTestId"
            TabLabel="TabLabel"
            TabTestId="TabTestId"
            ExpandedToggleLabel="@ExpandedToggleLabel"
            CollapsedToggleLabel="@CollapsedToggleLabel" />

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<TTab> Tabs { get; set; } = Array.Empty<TTab>();

    [Parameter, EditorRequired]
    public TTab ActiveTab { get; set; } = default!;

    [Parameter, EditorRequired]
    public RenderFragment<TTab> PanelContent { get; set; } = default!;

    [Parameter]
    public EventCallback<TTab> OnTabSelected { get; set; }

    [Parameter]
    public bool IsCollapsed { get; set; }

    [Parameter]
    public EventCallback OnToggleCollapsed { get; set; }

    [Parameter]
    public string AriaLabel { get; set; } = "Ribbon tools";

    [Parameter]
    public string RootClass { get; set; } = "space-y-3";

    [Parameter]
    public string ChromeClass { get; set; } = string.Empty;

    [Parameter]
    public string ControlsClass { get; set; } = "flex flex-wrap items-center justify-between gap-3 rounded-[1.35rem] border border-slate-200 bg-white p-3";

    [Parameter]
    public string TabsClass { get; set; } = "flex flex-wrap items-center gap-2";

    [Parameter]
    public string TabClass { get; set; } = "rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50";

    [Parameter]
    public string ActiveTabClass { get; set; } = "border-slate-900 bg-slate-900 text-white hover:bg-slate-800";

    [Parameter]
    public string ToggleClass { get; set; } = "rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-slate-600";

    [Parameter]
    public string PanelClass { get; set; } = "rounded-[1.5rem] border border-slate-200 bg-white p-4";

    [Parameter]
    public string? RootTestId { get; set; }

    [Parameter]
    public string? ToggleTestId { get; set; }

    [Parameter]
    public string? PanelTestId { get; set; }

    [Parameter]
    public Func<TTab, string>? TabLabel { get; set; }

    [Parameter]
    public Func<TTab, string>? TabTestId { get; set; }

    [Parameter]
    public string ExpandedToggleLabel { get; set; } = "Collapse";

    [Parameter]
    public string CollapsedToggleLabel { get; set; } = "Expand";

    private Task HandleSelectedAsync(TTab item)
    {
        return OnTabSelected.InvokeAsync(item);
    }
}

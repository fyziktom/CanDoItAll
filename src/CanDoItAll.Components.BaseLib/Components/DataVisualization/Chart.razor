@namespace CanDoItAll.Components.BaseLib
<CascadingValue Value="this" IsFixed="true">
    <div style="display:none">
        @ChildContent
    </div>
</CascadingValue>

<div @attributes='AdditionalAttributes.WithClass("rz-chart rounded-lg border border-slate-200 bg-white p-3")'>
    @if (snapshots.Count == 0)
    {
        <div class="text-sm text-slate-500">No chart data.</div>
    }
    else
    {
        <svg viewBox="0 0 1000 280" class="h-64 w-full">
            @for (var gridIndex = 0; gridIndex <= 4; gridIndex++)
            {
                var y = 20 + gridIndex * 60;
                <line x1="40" y1="@y" x2="980" y2="@y" stroke="#e2e8f0" stroke-width="1" />
            }

            @for (var seriesIndex = 0; seriesIndex < snapshots.Count; seriesIndex++)
            {
                var stroke = ResolveStroke(seriesIndex);
                var points = BuildPolylinePoints(snapshots[seriesIndex].Values);
                if (!string.IsNullOrWhiteSpace(points))
                {
                    <polyline fill="none" stroke="@stroke" stroke-width="2.5" points="@points" />
                }
            }
        </svg>

        <Cluster Gap="LayoutGap.Small"
                 Class="mt-2 text-xs text-slate-600">
            @for (var seriesIndex = 0; seriesIndex < snapshots.Count; seriesIndex++)
            {
                <span class="inline-flex items-center gap-1 rounded border border-slate-200 bg-slate-50 px-2 py-1">
                    <span class="inline-block h-2 w-2 rounded-full" style="background-color:@ResolveStroke(seriesIndex)"></span>
                    @snapshots[seriesIndex].Title
                </span>
            }
        </Cluster>
    }
</div>

@code {
    private readonly List<LineSeries> lineSeries = [];
    private readonly List<ChartSnapshot> snapshots = [];
    private ValueAxis? valueAxis;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    internal void RegisterSeries(LineSeries series)
    {
        if (!lineSeries.Contains(series))
        {
            lineSeries.Add(series);
        }

        RebuildSnapshots();
    }

    internal void UnregisterSeries(LineSeries series)
    {
        if (lineSeries.Remove(series))
        {
            RebuildSnapshots();
        }
    }

    internal void SetValueAxis(ValueAxis? axis)
    {
        valueAxis = axis;
        RebuildSnapshots();
    }

    protected override void OnParametersSet()
    {
        RebuildSnapshots();
    }

    private void RebuildSnapshots()
    {
        snapshots.Clear();

        foreach (var series in lineSeries)
        {
            var values = series.ReadValues();
            if (values.Count == 0)
            {
                continue;
            }

            snapshots.Add(new ChartSnapshot(
                string.IsNullOrWhiteSpace(series.Title) ? "Series" : series.Title,
                values));
        }

    }

    private string BuildPolylinePoints(IReadOnlyList<double> values)
    {
        if (values.Count == 0)
        {
            return string.Empty;
        }

        var min = ResolveMin(values);
        var max = ResolveMax(values);
        var range = Math.Max(0.00001, max - min);

        if (values.Count == 1)
        {
            var y = ConvertValueToY(values[0], min, range);
            return $"510,{y}";
        }

        var step = 940d / (values.Count - 1);
        var points = new List<string>(values.Count);
        for (var index = 0; index < values.Count; index++)
        {
            var x = 40 + index * step;
            var y = ConvertValueToY(values[index], min, range);
            points.Add(string.Create(
                System.Globalization.CultureInfo.InvariantCulture,
                $"{x:F2},{y:F2}"));
        }

        return string.Join(' ', points);
    }

    private double ResolveMin(IReadOnlyList<double> values)
    {
        if (valueAxis?.Min is not null)
        {
            return valueAxis.Min.Value;
        }

        var globalMin = snapshots.SelectMany(snapshot => snapshot.Values).DefaultIfEmpty(0).Min();
        var localMin = values.DefaultIfEmpty(0).Min();
        return Math.Min(globalMin, localMin);
    }

    private double ResolveMax(IReadOnlyList<double> values)
    {
        if (valueAxis?.Max is not null)
        {
            return valueAxis.Max.Value;
        }

        var globalMax = snapshots.SelectMany(snapshot => snapshot.Values).DefaultIfEmpty(1).Max();
        var localMax = values.DefaultIfEmpty(1).Max();
        return Math.Max(globalMax, localMax);
    }

    private static double ConvertValueToY(double value, double min, double range)
    {
        var normalized = (value - min) / range;
        return 260 - normalized * 240;
    }

    private static string ResolveStroke(int index)
    {
        string[] palette = [
            "#4f46e5",
            "#db2777",
            "#0891b2",
            "#16a34a",
            "#b45309"
        ];

        return palette[index % palette.Length];
    }

    private sealed record ChartSnapshot(string Title, IReadOnlyList<double> Values);
}



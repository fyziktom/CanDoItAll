@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

@if (!string.IsNullOrWhiteSpace(Href))
{
    <a href="@Href"
       target="@Target"
       rel="@Rel"
       @attributes='BuildAttributes(ResolveCssClass())'>
        @RenderContent()
    </a>
}
else if (Click.HasDelegate || Button)
{
    <button type="@Type"
            @attributes='BuildAttributes(ResolveCssClass())'
            @onclick="Click">
        @RenderContent()
    </button>
}
else
{
    <span @attributes='BuildAttributes(ResolveCssClass())'>
        @RenderContent()
    </span>
}

@code {
    [Parameter]
    public BadgeTone Tone { get; set; } = BadgeTone.Default;

    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public bool Button { get; set; }

    [Parameter]
    public string Type { get; set; } = "button";

    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public string? Target { get; set; }

    [Parameter]
    public string? Rel { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> Click { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string ResolveCssClass()
    {
        var toneCss = Tone switch
        {
            BadgeTone.Promo => "cda-badge--tone-secondary",
            BadgeTone.Success => "cda-badge--tone-success",
            BadgeTone.Warn => "cda-badge--tone-warning",
            BadgeTone.Accent => "cda-badge--tone-info",
            BadgeTone.Rank => "cda-badge--tone-secondary",
            BadgeTone.Info => "cda-badge--tone-info",
            _ => "cda-badge--tone-base"
        };

        return $"cda-badge {toneCss}";
    }

    private RenderFragment RenderContent()
    {
        if (ChildContent is not null)
        {
            return ChildContent;
        }

        return builder => builder.AddContent(0, Text);
    }
}

@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

@if (AsButton)
{
    <button type="@Type"
            disabled="@Disabled"
            @attributes='BuildAttributes(ResolveCssClass())'
            @onclick="OnClickAsync">
        @RenderContent()
    </button>
}
else if (AsLabel)
{
    <label @attributes='BuildAttributes(ResolveCssClass())'>@RenderContent()</label>
}
else
{
    <span @attributes='BuildAttributes(ResolveCssClass())'>@RenderContent()</span>
}

@code {
    [Parameter]
    public PillTone Tone { get; set; } = PillTone.Default;

    [Parameter]
    public string? Token { get; set; }

    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool AsLabel { get; set; }

    [Parameter]
    public bool AsButton { get; set; }

    [Parameter]
    public string Type { get; set; } = "button";

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback Click { get; set; }

    private async Task OnClickAsync()
    {
        if (!Disabled)
        {
            await Click.InvokeAsync();
        }
    }

    private string ResolveCssClass()
    {
        var toneCss = Tone switch
        {
            PillTone.Neutral => "cda-stat-pill cda-stat-pill--neutral",
            PillTone.Ok => "cda-stat-pill cda-stat-pill--success",
            PillTone.Info => "cda-stat-pill cda-stat-pill--info",
            PillTone.Warn => "cda-stat-pill cda-stat-pill--warning",
            PillTone.Plain => "cda-stat-pill cda-stat-pill--plain",
            PillTone.Label => "cda-stat-pill cda-stat-pill--plain uppercase tracking-[0.18em]",
            _ => "cda-stat-pill cda-stat-pill--neutral"
        };

        return toneCss;
    }

    private RenderFragment RenderContent()
    {
        return builder =>
        {
            var sequence = 0;

            if (!string.IsNullOrWhiteSpace(Token))
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "cda-stat-pill__token");
                builder.AddContent(sequence++, Token);
                builder.CloseElement();
            }

            if (ChildContent is not null)
            {
                builder.OpenElement(sequence++, "span");
                builder.AddContent(sequence++, ChildContent);
                builder.CloseElement();
                return;
            }

            if (!string.IsNullOrWhiteSpace(Text))
            {
                builder.OpenElement(sequence++, "span");
                builder.AddContent(sequence++, Text);
                builder.CloseElement();
            }
        };
    }
}

@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

@if (AsButton)
{
    <button type="@Type"
            disabled="@Disabled"
            @attributes='BuildAttributes(ResolveCssClass())'
            @onclick="OnClickAsync">
        @RenderContent()
    </button>
}
else if (AsLabel)
{
    <label @attributes='BuildAttributes(ResolveCssClass())'>@RenderContent()</label>
}
else
{
    <span @attributes='BuildAttributes(ResolveCssClass())'>@RenderContent()</span>
}

@code {
    [Parameter]
    public PillTone Tone { get; set; } = PillTone.Default;

    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool AsLabel { get; set; }

    [Parameter]
    public bool AsButton { get; set; }

    [Parameter]
    public string Type { get; set; } = "button";

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback Click { get; set; }

    private async Task OnClickAsync()
    {
        if (!Disabled)
        {
            await Click.InvokeAsync();
        }
    }

    private string ResolveCssClass()
    {
        var toneCss = Tone switch
        {
            PillTone.Ok => "border-emerald-200 bg-emerald-50 text-emerald-700",
            PillTone.Warn => "border-amber-200 bg-amber-50 text-amber-800",
            PillTone.Label => "border-slate-200 bg-white text-slate-600 uppercase tracking-[0.18em]",
            _ => "border-slate-200 bg-slate-100 text-slate-700"
        };

        return $"inline-flex items-center rounded-full border px-3 py-1.5 text-xs font-medium {toneCss}";
    }

    private RenderFragment RenderContent()
    {
        if (ChildContent is not null)
        {
            return ChildContent;
        }

        return builder => builder.AddContent(0, Text);
    }
}

@namespace CanDoItAll.Components.BaseLib

<Chip Class="@Class">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @Text
    }
</Chip>

@code {
    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

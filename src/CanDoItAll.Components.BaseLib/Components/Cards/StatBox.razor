@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<article @attributes='BuildAttributes(Simple ? "rounded-[1.2rem] border border-slate-200 bg-white px-4 py-3" : "rounded-[1.35rem] border border-slate-200 bg-white p-4 shadow-sm")'>
    @ChildContent
</article>

@code {
    [Parameter]
    public bool Simple { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

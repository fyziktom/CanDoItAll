@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<div @attributes='BuildAttributes(Packages ? "grid gap-4 md:grid-cols-2 xl:grid-cols-3" : "grid gap-4 md:grid-cols-2 lg:grid-cols-3")'>
    @ChildContent
</div>

@code {
    [Parameter]
    public bool Packages { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

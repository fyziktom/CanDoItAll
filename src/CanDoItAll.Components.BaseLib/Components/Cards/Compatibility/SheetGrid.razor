@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<div @attributes='BuildAttributes(Packages ? "cad-sheet-grid zy-sheet-grid cad-sheet-grid--packages zy-sheet-grid--packages" : "cad-sheet-grid zy-sheet-grid")'>
    @ChildContent
</div>

@code {
    [Parameter]
    public bool Packages { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

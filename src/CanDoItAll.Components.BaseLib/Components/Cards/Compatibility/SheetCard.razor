@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<article @attributes='BuildAttributes(Package ? "rounded-[1.65rem] border border-slate-200 bg-[linear-gradient(180deg,_rgba(248,250,252,0.98),_rgba(255,255,255,0.98))] p-5 shadow-sm" : "rounded-[1.65rem] border border-slate-200 bg-white p-5 shadow-sm")'>
    @ChildContent
</article>

@code {
    [Parameter]
    public bool Package { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<article @attributes='BuildAttributes(Package ? "cad-sheet-card zy-sheet-card cad-sheet-card--package zy-sheet-card--package" : "cad-sheet-card zy-sheet-card")'>

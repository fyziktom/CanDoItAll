@namespace CanDoItAll.Components.BaseLib
<Stack GapScale="LayoutGap.Large"
       Class="h-full rounded-3xl border border-slate-200 bg-white/90 p-5 shadow-sm shadow-slate-200/60">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <Split Breakpoint="LayoutBreakpoint.None"
               Gap="LayoutGap.Medium"
               AlignItems="AlignItems.Start"
               JustifyContent="JustifyContent.SpaceBetween"
               Wrap="FlexWrap.Wrap"
               Class="mb-4">
            <Stack GapScale="LayoutGap.Tiny">
                <h2 class="text-lg font-semibold text-slate-950">@Title</h2>
                @if (!string.IsNullOrWhiteSpace(Description))
                {
                    <p class="text-sm text-slate-600">@Description</p>
                }
            </Stack>

            @if (HeaderActions is not null)
            {
                <Cluster>
                    @HeaderActions
                </Cluster>
            }
        </Split>
    }

    @ChildContent
</Stack>

@code {
    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? HeaderActions { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}



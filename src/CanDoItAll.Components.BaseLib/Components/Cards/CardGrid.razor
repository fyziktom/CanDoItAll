@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<Grid Section="@Section"
      Gap="LayoutGap.Large"
      ColumnsMd="2"
      ColumnsXl="3"
      Class="@Class"
      Style="@Style"
      @attributes="AdditionalAttributes">
    @ChildContent
</Grid>

@code {
    [Parameter]
    public bool Section { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

@if (Section)
{
    <section @attributes='BuildAttributes("grid gap-4 md:grid-cols-2 xl:grid-cols-3")'>
        @ChildContent
    </section>
}
else
{
    <div @attributes='BuildAttributes("grid gap-4 md:grid-cols-2 xl:grid-cols-3")'>
        @ChildContent
    </div>
}

@code {
    [Parameter]
    public bool Section { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

@namespace CanDoItAll.Components.BaseLib

<article class="@ResolveCssClass()"
         style="@ComputedStyle">
    @if (IsWithIcon && !string.IsNullOrWhiteSpace(Icon))
    {
        <span class="cad-stat-card__icon zy-stat-card__icon">
            <Icon Name="@Icon" />
        </span>
    }
    <span class="cad-stat-card__label zy-stat-card__label">@Label</span>
    <strong class="cad-stat-card__value zy-stat-card__value">@Value</strong>
</article>

@code {
    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string Value { get; set; } = "0";

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? Color { get; set; }

    [Parameter]
    public string? TextColor { get; set; }

    [Parameter]
    public string Size { get; set; } = "small";

    [Parameter]
    public bool IsWithIcon { get; set; }

    [Parameter]
    public string? Icon { get; set; }

    private string ResolveCssClass()
    {
        var sizeCss = Size switch
        {
            "large" => "cad-stat-card--lg zy-stat-card--lg",
            "normal" => string.Empty,
            _ => "cad-stat-card--sm zy-stat-card--sm"
        };

        return CssClassBuilder.Join(
            "cad-stat-card zy-stat-card",
            sizeCss,
            CssClass);
    }

    private string? ComputedStyle
    {
        get
        {
            var parts = new List<string>(2);

            if (!string.IsNullOrWhiteSpace(Color))
            {
                parts.Add($"--stat-bg:{Color}");
            }

            if (!string.IsNullOrWhiteSpace(TextColor))
            {
                parts.Add($"--stat-color:{TextColor}");
            }

            return parts.Count > 0
                ? string.Join(';', parts)
                : null;
        }
    }
}

@namespace CanDoItAll.Components.BaseLib
<div class="@ResolveCssClass()">
    <div class="cda-summary-tile__row">
        @if (ShouldRenderHelperTooltip)
        {
            <div class="inline-flex min-w-0 max-w-full flex-nowrap items-center gap-2">
                <p class="cda-eyebrow whitespace-nowrap">@Label</p>
                <HelpPopover RootClass="pf-help-popover inline-flex items-center"
                             ToggleClass="pf-help-popover__toggle pf-help-popover__toggle--compact shrink-0"
                             OpenOnHover="true"
                             AriaLabel="@($"Show help for {Label}")"
                             Title="@($"Show help for {Label}")"
                             Heading="@Label"
                             Body="@(HelperText!)" />
            </div>
        }
        else
        {
            <p class="cda-eyebrow">@Label</p>
        }

        <p class="cda-summary-tile__value">@Value</p>
    </div>

    @if (ShouldRenderInlineHelper)
    {
        <p class="cda-summary-tile__helper">@HelperText</p>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public string? HelperText { get; set; }

    [Parameter]
    public bool ShowHelperTextAsTooltip { get; set; }

    [Parameter]
    public string Tone { get; set; } = "neutral";

    [Parameter]
    public bool Compact { get; set; }

    [Parameter]
    public bool Badge { get; set; }

    private bool HasHelperText => !string.IsNullOrWhiteSpace(HelperText);

    private bool ShouldRenderHelperTooltip => ShowHelperTextAsTooltip && HasHelperText;

    private bool ShouldRenderInlineHelper => HasHelperText && !ShowHelperTextAsTooltip;

    private string ResolveCssClass()
    {
        var toneClass = Tone.ToLowerInvariant() switch
        {
            "success" => "cda-summary-tile--tone-success",
            "accent" => "cda-summary-tile--tone-secondary",
            "secondary" => "cda-summary-tile--tone-secondary",
            "warning" => "cda-summary-tile--tone-warning",
            "danger" => "cda-summary-tile--tone-danger",
            "info" => "cda-summary-tile--tone-info",
            _ => string.Empty
        };

        var compactClass = Compact ? "cda-summary-tile--compact" : string.Empty;
        var badgeClass = Badge ? "cda-summary-tile--badge" : string.Empty;
        return $"cda-summary-tile {toneClass} {compactClass} {badgeClass}".TrimEnd();
    }
}



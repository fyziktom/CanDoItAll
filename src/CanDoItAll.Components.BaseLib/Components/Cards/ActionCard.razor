@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<div @attributes='BuildAttributes(Active ? "rounded-[1.5rem] border border-sky-200 bg-sky-50/70 p-4 shadow-sm shadow-sky-100" : "rounded-[1.5rem] border border-slate-200 bg-white p-4 shadow-sm")'>
    @ChildContent
</div>

@code {
    [Parameter]
    public bool Active { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

@if (Secondary)
{
    <Split Breakpoint="LayoutBreakpoint.None"
           Gap="LayoutGap.Small"
           AlignItems="AlignItems.Center"
           JustifyContent="JustifyContent.SpaceBetween"
           Wrap="FlexWrap.Wrap"
           Class="@BuildClass("border-t border-slate-200 pt-3")"
           Style="@Style"
           @attributes="AdditionalAttributes">
        @ChildContent
    </Split>
}
else
{
    <Cluster Class="@Class"
             Style="@Style"
             @attributes="AdditionalAttributes">
        @ChildContent
    </Cluster>
}

@code {
    [Parameter]
    public bool Secondary { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

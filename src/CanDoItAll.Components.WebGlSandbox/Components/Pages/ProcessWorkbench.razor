@namespace CanDoItAll.Components.WebGlSandbox.Components
@page "/"
@page "/webgl/process-workbench"
@inject NavigationManager NavigationManager
@inject ProcessWebGlSandboxSession Session

<PageTitle>WebGL Process Workbench</PageTitle>

<PageScaffold Mode="PageScaffoldMode.FocusWorkbench"
              FillHeight="true"
              MaxWidthClass="max-w-[1900px]"
              data-testid="webgl-process-workbench-page">
    <Header>
        <div class="webgl-page-hero">
            <div>
                <p class="webgl-page-hero__eyebrow">Concept review surface</p>
                <h1 class="webgl-page-hero__title">Process templates in navigable 3D</h1>
                <p class="webgl-page-hero__summary">The runtime stays universal and JS-owned, while this sandbox owns template switching, in-memory edits, center-lane scene projection, role spread, and proof-friendly 3D navigation.</p>
            </div>

            <div class="webgl-page-hero__meta">
                <StatusBadge Text="@Session.CurrentTemplate.Complexity" Tone="@ResolveComplexityTone(Session.CurrentTemplate.Complexity)" />
                <StatusBadge Text="@ResolveLayoutLabel(Session.LayoutMode)" Tone="neutral" />
                <StatusBadge Text="@($"{Session.NodeSpacingFactor:0.##}x spacing")" Tone="neutral" />
                <StatusBadge Text="@($"{currentSurface.Nodes.Count} nodes")" Tone="info" />
                <StatusBadge Text="@($"{currentSurface.Edges.Count} edges")" Tone="accent" />
            </div>
        </div>
    </Header>

    <Lead>
        <SectionCard Title="Review controls"
                     Description="Representative template selection, 3D view presets, diagnostics, export flow, and sandbox-local editing all stay local to the concept host."
                     HeaderActions="BuildLeadActions">
            <Stack Orientation="Orientation.Horizontal"
                   Wrap="FlexWrap.Wrap"
                   GapScale="LayoutGap.Medium"
                   AlignItems="AlignItems.End">
                <FormField Text="Template" ContainerClass="webgl-control-field">
                    <DropDown TValue="string"
                              Data="@Session.Templates"
                              TextProperty="@nameof(ProcessWebGlTemplateDescriptor.DisplayName)"
                              ValueProperty="@nameof(ProcessWebGlTemplateDescriptor.Key)"
                              Value="@Session.SelectedTemplateKey"
                              ValueChanged="HandleTemplateChangedAsync" />
                </FormField>

                <FormField Text="View preset" ContainerClass="webgl-control-field">
                    <DropDown TValue="string"
                              Data="@ViewPresetOptions"
                              TextProperty="@nameof(ChoiceItem.Label)"
                              ValueProperty="@nameof(ChoiceItem.Value)"
                              Value="@Session.ViewPreset"
                              ValueChanged="HandleViewPresetChangedAsync" />
                </FormField>

                <FormField Text="Layout algorithm" ContainerClass="webgl-control-field">
                    <DropDown TValue="string"
                              Data="@LayoutModeOptions"
                              TextProperty="@nameof(ChoiceItem.Label)"
                              ValueProperty="@nameof(ChoiceItem.Value)"
                              Value="@Session.LayoutMode"
                              ValueChanged="HandleLayoutModeChangedAsync" />
                </FormField>

                <FormField Text="Node spacing" ContainerClass="webgl-control-field">
                    <Stack Orientation="Orientation.Horizontal"
                           Wrap="FlexWrap.Wrap"
                           GapScale="LayoutGap.Small"
                           AlignItems="AlignItems.Center">
                        <Button Text="Tighter"
                                Icon="remove"
                                Click="HandleDecreaseSpacingAsync"
                                data-testid="webgl-sandbox-spacing-decrease" />
                        <Button Text="Wider"
                                Icon="add"
                                Click="HandleIncreaseSpacingAsync"
                                data-testid="webgl-sandbox-spacing-increase" />
                        <StatusBadge Text="@($"{Session.NodeSpacingFactor:0.##}x")" Tone="info" />
                    </Stack>
                </FormField>

                <Button Text="Recompose"
                        Icon="route"
                        Click="HandleRecomposeAsync"
                        data-testid="webgl-sandbox-recompose" />
                <Button Text="Reset edits"
                        Icon="refresh"
                        Click="HandleResetAsync"
                        data-testid="webgl-sandbox-reset" />
                <Button Text="Fit view"
                        Icon="fit_screen"
                        Click="HandleFitViewAsync"
                        data-testid="webgl-sandbox-fit-view" />
                <Button Text="Toggle diagnostics"
                        Icon="monitor_heart"
                        Click="HandleToggleDiagnosticsAsync"
                        data-testid="webgl-sandbox-toggle-diagnostics" />
                <Button Text="Export image"
                        Icon="image"
                        Click="HandleExportAsync"
                        data-testid="webgl-sandbox-export" />
            </Stack>
        </SectionCard>
    </Lead>

    <SecondaryRail>
        <SectionCard Title="Template brief"
                     Description="@Session.CurrentTemplate.Summary">
            <Stack GapScale="LayoutGap.Small">
                <StatusBadge Text="@Session.CurrentTemplate.DisplayName" Tone="info" />
                <StatusBadge Text="@($"{Session.CurrentTemplate.StepCount} steps")" Tone="accent" />
                <p class="webgl-rail-copy">Expanded representative pack: baseline, dense, delivery, AI, and release-control flows are all projected from repository templates instead of demo-only data.</p>
            </Stack>
        </SectionCard>

        <SectionCard Title="Selection"
                     Description="The sandbox inspector stays outside the universal runtime so the component remains reusable.">
            <Stack GapScale="LayoutGap.Small">
                <StatusBadge Text="@SelectedNodeTitle" Tone="info" />
                <p class="webgl-rail-copy">@SelectedNodeSummary</p>
                @if (selectedNode is not null && selectedNode.Anchors.Count > 0)
                {
                    <div class="webgl-chip-cluster">
                        @foreach (var anchor in selectedNode.Anchors.Take(6))
                        {
                            <span class="webgl-chip">@anchor.Label</span>
                        }
                    </div>
                }
            </Stack>
        </SectionCard>

        <SectionCard Title="Semantic connection authoring"
                     Description="The concept proves connect and disconnect flows with process-aware semantics and no persistence.">
            <Stack GapScale="LayoutGap.Medium">
                <FormField Text="Source node">
                    <DropDown TValue="string"
                              Data="@NodeOptions"
                              TextProperty="@nameof(ChoiceItem.Label)"
                              ValueProperty="@nameof(ChoiceItem.Value)"
                              Value="@sourceNodeId"
                              ValueChanged="HandleSourceNodeChangedAsync" />
                </FormField>

                <FormField Text="Source anchor">
                    <DropDown TValue="string"
                              Data="@SourceAnchorOptions"
                              TextProperty="@nameof(ChoiceItem.Label)"
                              ValueProperty="@nameof(ChoiceItem.Value)"
                              Value="@sourceAnchorId"
                              ValueChanged="HandleSourceAnchorChangedAsync" />
                </FormField>

                <FormField Text="Target node">
                    <DropDown TValue="string"
                              Data="@NodeOptions"
                              TextProperty="@nameof(ChoiceItem.Label)"
                              ValueProperty="@nameof(ChoiceItem.Value)"
                              Value="@targetNodeId"
                              ValueChanged="HandleTargetNodeChangedAsync" />
                </FormField>

                <FormField Text="Target anchor">
                    <DropDown TValue="string"
                              Data="@TargetAnchorOptions"
                              TextProperty="@nameof(ChoiceItem.Label)"
                              ValueProperty="@nameof(ChoiceItem.Value)"
                              Value="@targetAnchorId"
                              ValueChanged="HandleTargetAnchorChangedAsync" />
                </FormField>

                <Stack Orientation="Orientation.Horizontal"
                       Wrap="FlexWrap.Wrap"
                       GapScale="LayoutGap.Small">
                    <Button Text="Connect"
                            Icon="add_link"
                            Disabled="@ConnectionButtonDisabled"
                            Click="HandleConnectAsync"
                            data-testid="webgl-sandbox-connect" />
                    <Button Text="Disconnect"
                            Icon="link_off"
                            Disabled="@ConnectionButtonDisabled"
                            Click="HandleDisconnectAsync"
                            data-testid="webgl-sandbox-disconnect" />
                </Stack>
            </Stack>
        </SectionCard>

        <SectionCard Title="Command log"
                     Description="Recent sandbox-only actions prove edits stay isolated and reversible.">
            <Stack GapScale="LayoutGap.Small">
                @foreach (var entry in Session.CommandLog)
                {
                    <div class="webgl-command-entry">
                        <strong>@entry.Title</strong>
                        <span>@entry.Detail</span>
                    </div>
                }
            </Stack>
        </SectionCard>
    </SecondaryRail>

    <ChildContent>
        <SectionCard Title="Process concept stage"
                     Description="JS owns the perspective renderer, orbit navigation, hit-testing, and semantic automation bridge while the sandbox owns route state and in-memory edits.">
            <div class="webgl-stage-frame" data-testid="webgl-sandbox-stage">
                <WebGlWorkbench @ref="workbench"
                                Surface="@currentSurface"
                                SelectionChanged="HandleSelectionChanged"
                                NodesMoved="HandleNodesMoved"
                                ConnectionChangeRequested="HandleConnectionChangeRequested"
                                StateChanged="HandleStateChanged" />
                <div class="webgl-stage-overlay" data-testid="webgl-stage-overlay">
                    <div class="webgl-stage-overlay__card">
                        <p class="webgl-stage-overlay__title">3D navigation</p>
                        <div class="webgl-stage-overlay__group">
                            <span class="webgl-stage-overlay__label">Orbit</span>
                            <Stack Orientation="Orientation.Horizontal"
                                   Wrap="FlexWrap.Wrap"
                                   GapScale="LayoutGap.Small">
                                <Button Text="Left"
                                        Click="HandleOrbitLeftAsync"
                                        data-testid="webgl-stage-orbit-left" />
                                <Button Text="Right"
                                        Click="HandleOrbitRightAsync"
                                        data-testid="webgl-stage-orbit-right" />
                                <Button Text="Up"
                                        Click="HandleOrbitUpAsync"
                                        data-testid="webgl-stage-orbit-up" />
                                <Button Text="Down"
                                        Click="HandleOrbitDownAsync"
                                        data-testid="webgl-stage-orbit-down" />
                            </Stack>
                        </div>
                        <div class="webgl-stage-overlay__group">
                            <span class="webgl-stage-overlay__label">Pan</span>
                            <Stack Orientation="Orientation.Horizontal"
                                   Wrap="FlexWrap.Wrap"
                                   GapScale="LayoutGap.Small">
                                <Button Text="Left"
                                        Click="HandlePanLeftAsync"
                                        data-testid="webgl-stage-pan-left" />
                                <Button Text="Right"
                                        Click="HandlePanRightAsync"
                                        data-testid="webgl-stage-pan-right" />
                                <Button Text="Up"
                                        Click="HandlePanUpAsync"
                                        data-testid="webgl-stage-pan-up" />
                                <Button Text="Down"
                                        Click="HandlePanDownAsync"
                                        data-testid="webgl-stage-pan-down" />
                            </Stack>
                        </div>
                        <div class="webgl-stage-overlay__group">
                            <span class="webgl-stage-overlay__label">Zoom</span>
                            <Stack Orientation="Orientation.Horizontal"
                                   Wrap="FlexWrap.Wrap"
                                   GapScale="LayoutGap.Small">
                                <Button Text="In"
                                        Click="HandleZoomInAsync"
                                        data-testid="webgl-stage-zoom-in" />
                                <Button Text="Out"
                                        Click="HandleZoomOutAsync"
                                        data-testid="webgl-stage-zoom-out" />
                                <Button Text="Reset"
                                        Click="HandleResetCameraAsync"
                                        data-testid="webgl-stage-reset-view" />
                            </Stack>
                        </div>
                        <p class="webgl-stage-overlay__help">Mouse: left orbit, middle drag or wheel zoom, right pan. Arrow keys pan when the scene is focused. Hold Shift and drag a node to move it, and collision protection stops boxes from crossing into each other.</p>
                    </div>
                </div>
            </div>
        </SectionCard>
    </ChildContent>
</PageScaffold>

@code {
    private static readonly IReadOnlyList<ChoiceItem> ViewPresetOptions =
    [
        new("Overview", WebGlWorkbenchViewPresets.Overview),
        new("Roles", WebGlWorkbenchViewPresets.Roles),
        new("Dependencies", WebGlWorkbenchViewPresets.Dependencies),
        new("Branching", WebGlWorkbenchViewPresets.Branching),
        new("Focus", WebGlWorkbenchViewPresets.Focus)
    ];

    private static readonly IReadOnlyList<ChoiceItem> LayoutModeOptions =
    [
        new("Center lane", WebGlWorkbenchLayoutModes.CenterLane),
        new("Alternating arc", WebGlWorkbenchLayoutModes.AlternatingArc),
        new("Layered orbit", WebGlWorkbenchLayoutModes.LayeredOrbit)
    ];

    [SupplyParameterFromQuery(Name = "template")]
    public string? TemplateQuery { get; set; }

    [SupplyParameterFromQuery(Name = "camera")]
    public string? CameraQuery { get; set; }

    [SupplyParameterFromQuery(Name = "view")]
    public string? ViewQuery { get; set; }

    private WebGlWorkbench workbench = default!;
    private WebGlWorkbenchSurface currentSurface = new();
    private string? sourceNodeId;
    private string? sourceAnchorId;
    private string? targetNodeId;
    private string? targetAnchorId;

    private RenderFragment BuildLeadActions => builder =>
    {
        builder.OpenComponent<StatusBadge>(0);
        builder.AddAttribute(1, nameof(StatusBadge.Text), Session.LastExportCharacterCount > 0
            ? $"{Session.LastExportCharacterCount} export chars"
            : "No export yet");
        builder.AddAttribute(2, nameof(StatusBadge.Tone), Session.LastExportCharacterCount > 0 ? "success" : "neutral");
        builder.CloseComponent();
    };

    protected override void OnParametersSet()
    {
        Session.ApplyRouteState(TemplateQuery, CameraQuery, ViewQuery);
        RefreshSurface();
    }

    private IReadOnlyList<ChoiceItem> NodeOptions
        => currentSurface.Nodes
            .Select(node => new ChoiceItem($"{node.Title} ({node.Kind})", node.Id))
            .ToList();

    private IReadOnlyList<ChoiceItem> SourceAnchorOptions => BuildAnchorOptions(sourceNodeId, WebGlWorkbenchAnchorRoles.Output);

    private IReadOnlyList<ChoiceItem> TargetAnchorOptions => BuildAnchorOptions(targetNodeId, WebGlWorkbenchAnchorRoles.Input);

    private WebGlWorkbenchNode? selectedNode
        => currentSurface.Nodes.FirstOrDefault(node =>
            currentSurface.UiState.SelectedNodeIds.Contains(node.Id, StringComparer.Ordinal));

    private string SelectedNodeTitle => selectedNode?.Title ?? "Nothing selected";

    private string SelectedNodeSummary
        => selectedNode is null
            ? "Pick a node in the stage or use the semantic controls to inspect the current selection."
            : string.IsNullOrWhiteSpace(selectedNode.Description)
                ? selectedNode.Subtitle
                : selectedNode.Description;

    private bool ConnectionButtonDisabled
        => string.IsNullOrWhiteSpace(sourceNodeId) ||
            string.IsNullOrWhiteSpace(sourceAnchorId) ||
            string.IsNullOrWhiteSpace(targetNodeId) ||
            string.IsNullOrWhiteSpace(targetAnchorId);

    private async Task HandleTemplateChangedAsync(string? templateKey)
        => await NavigateAsync(templateKey, Session.ProjectionMode, Session.ViewPreset);

    private async Task HandleViewPresetChangedAsync(string? viewPreset)
        => await NavigateAsync(Session.SelectedTemplateKey, Session.ProjectionMode, viewPreset);

    private Task HandleLayoutModeChangedAsync(string? layoutMode)
    {
        Session.Recompose(layoutMode);
        RefreshSurface();
        return Task.CompletedTask;
    }

    private Task HandleSelectionChanged(WebGlSelectionChangedEventArgs args)
    {
        Session.SetSelectedNode(args.PrimaryNodeId);
        RefreshSurface();
        return Task.CompletedTask;
    }

    private Task HandleNodesMoved(WebGlNodeMovedEventArgs args)
    {
        Session.ApplyNodesMoved(args.Positions);
        RefreshSurface();
        return Task.CompletedTask;
    }

    private Task HandleConnectionChangeRequested(WebGlConnectionChangeRequest request)
    {
        Session.ApplyConnectionChange(request);
        RefreshSurface();
        return Task.CompletedTask;
    }

    private Task HandleStateChanged(string stateJson)
    {
        Session.ApplyUiState(WebGlWorkbenchUiState.Parse(stateJson));
        return Task.CompletedTask;
    }

    private async Task HandleResetAsync()
    {
        Session.Reset();
        RefreshSurface();
        await Task.Yield();
        if (workbench is not null)
        {
            await workbench.FitViewToSceneAsync();
        }
    }

    private async Task HandleRecomposeAsync()
    {
        Session.Recompose();
        RefreshSurface();
        await Task.Yield();
        if (workbench is not null)
        {
            await workbench.FitViewToSceneAsync();
        }
    }

    private async Task HandleFitViewAsync()
    {
        if (workbench is not null)
        {
            await workbench.FitViewToSceneAsync();
        }
    }

    private Task HandleDecreaseSpacingAsync()
    {
        Session.AdjustNodeSpacing(-1);
        RefreshSurface();
        return Task.CompletedTask;
    }

    private Task HandleIncreaseSpacingAsync()
    {
        Session.AdjustNodeSpacing(1);
        RefreshSurface();
        return Task.CompletedTask;
    }

    private Task HandleOrbitLeftAsync() => ExecuteWorkbenchActionAsync(() => workbench.OrbitAsync(-0.18d, 0));

    private Task HandleOrbitRightAsync() => ExecuteWorkbenchActionAsync(() => workbench.OrbitAsync(0.18d, 0));

    private Task HandleOrbitUpAsync() => ExecuteWorkbenchActionAsync(() => workbench.OrbitAsync(0, -0.12d));

    private Task HandleOrbitDownAsync() => ExecuteWorkbenchActionAsync(() => workbench.OrbitAsync(0, 0.12d));

    private Task HandlePanLeftAsync() => ExecuteWorkbenchActionAsync(() => workbench.PanAsync(-84d, 0));

    private Task HandlePanRightAsync() => ExecuteWorkbenchActionAsync(() => workbench.PanAsync(84d, 0));

    private Task HandlePanUpAsync() => ExecuteWorkbenchActionAsync(() => workbench.PanAsync(0, 72d));

    private Task HandlePanDownAsync() => ExecuteWorkbenchActionAsync(() => workbench.PanAsync(0, -72d));

    private Task HandleZoomInAsync() => ExecuteWorkbenchActionAsync(() => workbench.ZoomAsync(1.15d));

    private Task HandleZoomOutAsync() => ExecuteWorkbenchActionAsync(() => workbench.ZoomAsync(0.87d));

    private Task HandleResetCameraAsync() => ExecuteWorkbenchActionAsync(() => workbench.ResetCameraAsync());

    private Task HandleToggleDiagnosticsAsync()
    {
        Session.ToggleDiagnostics();
        RefreshSurface();
        return Task.CompletedTask;
    }

    private async Task HandleExportAsync()
    {
        if (workbench is null)
        {
            return;
        }

        var imageLength = await workbench.CaptureImageLengthAsync();
        Session.RecordExport(imageLength);
        RefreshSurface();
    }

    private Task HandleSourceNodeChangedAsync(string? nodeId)
    {
        sourceNodeId = nodeId;
        sourceAnchorId = SourceAnchorOptions.FirstOrDefault()?.Value;
        return Task.CompletedTask;
    }

    private Task HandleSourceAnchorChangedAsync(string? anchorId)
    {
        sourceAnchorId = anchorId;
        return Task.CompletedTask;
    }

    private Task HandleTargetNodeChangedAsync(string? nodeId)
    {
        targetNodeId = nodeId;
        targetAnchorId = TargetAnchorOptions.FirstOrDefault()?.Value;
        return Task.CompletedTask;
    }

    private Task HandleTargetAnchorChangedAsync(string? anchorId)
    {
        targetAnchorId = anchorId;
        return Task.CompletedTask;
    }

    private Task HandleConnectAsync()
    {
        return ApplyConnectionRequestAsync(WebGlWorkbenchConnectionActions.Connect);
    }

    private Task HandleDisconnectAsync()
    {
        return ApplyConnectionRequestAsync(WebGlWorkbenchConnectionActions.Disconnect);
    }

    private Task ApplyConnectionRequestAsync(string actionId)
    {
        var sourceAnchor = ResolveAnchor(sourceNodeId, sourceAnchorId);
        var targetAnchor = ResolveAnchor(targetNodeId, targetAnchorId);
        if (sourceAnchor is null || targetAnchor is null)
        {
            return Task.CompletedTask;
        }

        Session.ApplyConnectionChange(new WebGlConnectionChangeRequest(
            actionId,
            EdgeId: null,
            SourceNodeId: sourceAnchor.NodeId,
            SourceAnchorId: sourceAnchor.Id,
            SourcePortId: sourceAnchor.PortId,
            TargetNodeId: targetAnchor.NodeId,
            TargetAnchorId: targetAnchor.Id,
            TargetPortId: targetAnchor.PortId,
            Kind: ResolveConnectionKind(sourceAnchor),
            CategoryKey: sourceAnchor.CategoryKey));
        RefreshSurface();
        return Task.CompletedTask;
    }

    private async Task NavigateAsync(string? templateKey, string? cameraMode, string? viewPreset)
    {
        var template = string.IsNullOrWhiteSpace(templateKey)
            ? Session.SelectedTemplateKey
            : templateKey;
        var camera = string.IsNullOrWhiteSpace(cameraMode)
            ? Session.ProjectionMode
            : cameraMode;
        var view = string.IsNullOrWhiteSpace(viewPreset)
            ? Session.ViewPreset
            : viewPreset;
        var query = new List<string>
        {
            $"template={Uri.EscapeDataString(template)}"
        };

        if (!string.Equals(camera, WebGlWorkbenchProjectionModes.Perspective, StringComparison.Ordinal))
        {
            query.Add($"camera={Uri.EscapeDataString(camera)}");
        }

        if (!string.Equals(view, WebGlWorkbenchViewPresets.Overview, StringComparison.Ordinal))
        {
            query.Add($"view={Uri.EscapeDataString(view)}");
        }

        NavigationManager.NavigateTo($"/webgl/process-workbench?{string.Join("&", query)}");
        await Task.CompletedTask;
    }

    private void RefreshSurface()
    {
        currentSurface = Session.BuildSurface();
        EnsureConnectionDraft();
    }

    private void EnsureConnectionDraft()
    {
        sourceNodeId = ResolveCurrentChoice(sourceNodeId, NodeOptions);
        targetNodeId = ResolveCurrentChoice(targetNodeId, NodeOptions);

        if (string.IsNullOrWhiteSpace(sourceNodeId) && selectedNode is not null)
        {
            sourceNodeId = selectedNode.Id;
        }

        if (string.IsNullOrWhiteSpace(targetNodeId))
        {
            targetNodeId = currentSurface.Nodes.FirstOrDefault(node => !string.Equals(node.Id, sourceNodeId, StringComparison.Ordinal))?.Id
                ?? currentSurface.Nodes.FirstOrDefault()?.Id;
        }

        sourceAnchorId = ResolveCurrentChoice(sourceAnchorId, SourceAnchorOptions);
        targetAnchorId = ResolveCurrentChoice(targetAnchorId, TargetAnchorOptions);
    }

    private IReadOnlyList<ChoiceItem> BuildAnchorOptions(string? nodeId, string role)
    {
        return currentSurface.Nodes
            .FirstOrDefault(node => string.Equals(node.Id, nodeId, StringComparison.Ordinal))?.Anchors
            .Where(anchor => string.Equals(anchor.Role, role, StringComparison.Ordinal))
            .Select(anchor => new ChoiceItem(anchor.Label, anchor.Id))
            .ToList()
            ?? [];
    }

    private WebGlWorkbenchAnchor? ResolveAnchor(string? nodeId, string? anchorId)
    {
        return currentSurface.Nodes
            .FirstOrDefault(node => string.Equals(node.Id, nodeId, StringComparison.Ordinal))?.Anchors
            .FirstOrDefault(anchor => string.Equals(anchor.Id, anchorId, StringComparison.Ordinal));
    }

    private static string ResolveCurrentChoice(string? currentValue, IReadOnlyList<ChoiceItem> options)
    {
        return options.Any(option => string.Equals(option.Value, currentValue, StringComparison.Ordinal))
            ? currentValue ?? string.Empty
            : options.FirstOrDefault()?.Value ?? string.Empty;
    }

    private static string ResolveConnectionKind(WebGlWorkbenchAnchor sourceAnchor)
    {
        return string.Equals(sourceAnchor.CategoryKey, ProcessCanvasCatalog.ConnectionCategories.Messaging, StringComparison.Ordinal)
            ? "messaging"
            : "flow";
    }

    private Task ExecuteWorkbenchActionAsync(Func<Task> action)
    {
        return workbench is null
            ? Task.CompletedTask
            : action();
    }

    private static string ResolveComplexityTone(string complexity)
    {
        return complexity switch
        {
            "Simple" => "success",
            "Medium" => "info",
            "Complex" => "accent",
            "Dense" => "warning",
            _ => "neutral"
        };
    }

    private static string ResolveLayoutLabel(string layoutMode)
    {
        return WebGlWorkbenchLayoutModes.Normalize(layoutMode) switch
        {
            WebGlWorkbenchLayoutModes.AlternatingArc => "Alternating arc",
            WebGlWorkbenchLayoutModes.LayeredOrbit => "Layered orbit",
            _ => "Center lane"
        };
    }

    private sealed record ChoiceItem(string Label, string Value);
}

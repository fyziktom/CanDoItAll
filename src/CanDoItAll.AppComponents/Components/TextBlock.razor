@namespace CanDoItAll.AppComponents
@switch (ResolveTag())
{
    case "h4":
        <h4 @attributes='AdditionalAttributes.WithClassAndStyle(ResolveCssClass(), Style)'>@RenderContent()</h4>
        break;
    case "h5":
        <h5 @attributes='AdditionalAttributes.WithClassAndStyle(ResolveCssClass(), Style)'>@RenderContent()</h5>
        break;
    case "h6":
        <h6 @attributes='AdditionalAttributes.WithClassAndStyle(ResolveCssClass(), Style)'>@RenderContent()</h6>
        break;
    default:
        <p @attributes='AdditionalAttributes.WithClassAndStyle(ResolveCssClass(), Style)'>@RenderContent()</p>
        break;
}

@code {
    [Parameter]
    public TextStyle TextStyle { get; set; } = TextStyle.Body1;

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public string? Style { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ResolveTag()
    {
        return TextStyle switch
        {
            TextStyle.H4 => "h4",
            TextStyle.H5 => "h5",
            TextStyle.H6 => "h6",
            _ => "p"
        };
    }

    private string ResolveCssClass()
    {
        return TextStyle switch
        {
            TextStyle.H4 => "rz-text text-3xl font-semibold text-slate-900",
            TextStyle.H5 => "rz-text text-2xl font-semibold text-slate-900",
            TextStyle.H6 => "rz-text text-xl font-semibold text-slate-900",
            TextStyle.Subtitle1 => "rz-text text-lg font-semibold text-slate-800",
            TextStyle.Subtitle2 => "rz-text text-base font-semibold text-slate-700",
            TextStyle.Caption => "rz-text text-xs text-slate-500",
            TextStyle.Body2 => "rz-text text-sm text-slate-700",
            _ => "rz-text text-base text-slate-700"
        };
    }

    private RenderFragment RenderContent()
    {
        if (ChildContent is not null)
        {
            return ChildContent;
        }

        return builder => builder.AddContent(0, Value);
    }
}






@page "/activity"
@* codex-capsule
kind: page
name: ActivityPage
summary: Shows the activity timeline and relational search results for recent workspace actions.
owns: activity-timeline, search-results
deps: ActivityService, NavigationManager
risks: empty-search-state, stale-route-links
tests: component:ActivityPageTests, e2e:activity-smoke
*@
@using CanDoItAll.ComponentKit.Components
@using CanDoItAll.Infrastructure.Search
@inject ActivityService ActivityService
@inject NavigationManager Navigation

<PageTitle>Activity</PageTitle>

<div class="space-y-6">
    <PageHeader Eyebrow="Activity"
                Title="Activity timeline and search"
                Description="Review recent actions across projects, prompts, validations, test evidence, and background workflows from one searchable timeline." />

    <div class="grid gap-4 xl:grid-cols-[0.8fr_1.2fr]">
        <SectionCard Title="Search" Description="Cross-entity search is backed by the relational search index and routes back into the internal workbench.">
            <div class="space-y-4">
                <EditForm Model="this" OnSubmit="SearchAsync">
                    <div class="flex gap-2">
                        <InputText @bind-Value="query" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" placeholder="Search projects, prompts, resources, validations, and tests" />
                        <button type="submit" class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white">Search</button>
                    </div>
                </EditForm>

                @if (results.Count == 0)
                {
                    <p class="text-sm text-slate-500">Search the indexed records to jump directly into the workbench.</p>
                }
                else
                {
                    <div class="space-y-2">
                        @foreach (var result in results)
                        {
                            <button type="button"
                                    class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-3 py-3 text-left"
                                    @onclick="() => OpenResult(result)">
                                <span class="block text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">@result.Category</span>
                                <span class="mt-1 block text-sm font-semibold text-slate-900">@result.Title</span>
                                <span class="mt-1 block text-xs text-slate-500">@result.Summary</span>
                            </button>
                        }
                    </div>
                }
            </div>
        </SectionCard>

        <SectionCard Title="Recent timeline" Description="Major module actions are recorded here so the application has a durable operational history.">
            <div class="space-y-3">
                @if (items.Count == 0)
                {
                    <p class="text-sm text-slate-500">No activity recorded yet.</p>
                }
                else
                {
                    @foreach (var item in items)
                    {
                        <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4">
                            <div class="flex flex-wrap items-start justify-between gap-3">
                                <div>
                                    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">@item.Category · @item.Action</p>
                                    <p class="mt-1 text-sm font-semibold text-slate-900">@item.Title</p>
                                </div>
                                <span class="text-xs text-slate-500">@item.CreatedAtUtc.LocalDateTime:g</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <p class="mt-3 text-sm leading-6 text-slate-600">@item.Description</p>
                            }
                            <div class="mt-3 flex items-center justify-between gap-3">
                                <span class="text-xs text-slate-500">Actor: @item.Actor</span>
                                @if (!string.IsNullOrWhiteSpace(item.Route))
                                {
                                    <button type="button" class="text-xs font-semibold text-sky-700" @onclick="() => Navigation.NavigateTo(item.Route!)">Open</button>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </SectionCard>
    </div>
</div>

@code {
    private string query = string.Empty;
    private IReadOnlyList<ActivityTimelineItem> items = [];
    private IReadOnlyList<SearchResult> results = [];

    protected override async Task OnInitializedAsync()
    {
        items = await ActivityService.ListRecentAsync();
    }

    private async Task SearchAsync()
    {
        results = await ActivityService.SearchAsync(query);
    }

    private void OpenResult(SearchResult result)
        => Navigation.NavigateTo(result.Route);
}

@namespace CanDoItAll.Components.Sandbox.Components
@page "/groups/data-display"
@inherits CatalogPageBase
@using CanDoItAll.Components.Common

<PageTitle>Data Display</PageTitle>

<CatalogPageFrame Group="@Group"
                  Scenario="@CurrentScenario"
                  Frame="@CurrentFrame"
                  ExampleCount="@Examples.Count"
                  HeroTitle="Cards, summaries, and rows that keep metadata readable."
                  HeroSummary="The data display page proves that shared cards and list rows can handle denser metadata, longer labels, and empty results without losing hierarchy."
                  DemoTitle="Data display surfaces"
                  DemoSummary="Summary tiles, cards, and selection rows for the current scenario."
                  ScenarioChanged="NavigateScenario"
                  FrameChanged="NavigateFrame">
    <Notes>
        <div class="sandbox-proof-list">
            <p>Dense metadata should still read as grouped information instead of raw text piled into cards.</p>
            <p>Long labels cannot collapse the card rhythm or force awkward truncation everywhere.</p>
            <p>The empty state should feel like part of the shared system, not an afterthought.</p>
        </div>
    </Notes>

    <ChildContent>
        @if (CurrentScenario == SandboxScenarioKey.LoadingState)
        {
            <LoadingState Eyebrow="Data display" Title="Loading summary surface" Description="Cards and list rows keep their structure while the record set and computed metrics load." />
        }
        else if (CurrentScenario == SandboxScenarioKey.EmptyState)
        {
            <EmptyState Eyebrow="Data display" Title="No results" Description="Adjust the current filters or add records before the shared card and list views can render detail." />
        }
        else
        {
            <SectionCard Title="Summary strip" Description="High-signal metrics should lead the page without becoming a dashboard wallpaper.">
                <SummaryTiles>
                    @foreach (var tile in Tiles)
                    {
                        <SummaryTile Label="@tile.Label"
                                     Value="@tile.Value"
                                     HelperText="@tile.HelperText"
                                     Tone="@tile.Tone" />
                    }
                </SummaryTiles>
            </SectionCard>

            <Grid Gap="LayoutGap.Large"
                  ColumnTemplate="repeat(auto-fit,minmax(16rem,1fr))">
                @foreach (var card in Cards)
                {
                    <Card>
                        <div class="space-y-4">
                            <Split Breakpoint="LayoutBreakpoint.None"
                                   Gap="LayoutGap.Medium"
                                   AlignItems="AlignItems.Start"
                                   JustifyContent="JustifyContent.SpaceBetween"
                                   Wrap="FlexWrap.Wrap">
                                <div class="space-y-1">
                                    <TextBlock TextStyle="@(TextStyle.Eyebrow)" Value="@card.Eyebrow" />
                                    <TextBlock TextStyle="@(TextStyle.Subtitle1)" Value="@card.Title" />
                                    <TextBlock TextStyle="@(TextStyle.Body2)" Value="@card.Summary" />
                                </div>
                                <StatusBadge Text="@card.State" Tone="@card.Tone" />
                            </Split>

                            <div class="sandbox-kv-list">
                                @foreach (var fact in card.Facts)
                                {
                                    <div class="sandbox-kv-item">
                                        <strong>@fact.Label</strong>
                                        <span>@fact.Value</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </Card>
                }
            </Grid>

            <SectionCard Title="Selection rows" Description="List-style display surfaces should preserve scanability and action clarity.">
                <div class="sandbox-list">
                    @foreach (var row in Rows)
                    {
                        <SelectionListItem Title="@row.Title"
                                           Eyebrow="@row.Eyebrow"
                                           Meta="@row.Meta"
                                           Summary="@row.Summary">
                            <Status>
                                <StatusBadge Text="@row.State" Tone="@row.Tone" />
                            </Status>
                            <Actions>
                                <Button Text="Open"
                                        ButtonStyle="@(ButtonStyle.Light)"
                                        Variant="@(Variant.Outlined)"
                                        Disabled="@IsDisabled" />
                            </Actions>
                            <ChildContent>
                                <Cluster Gap="LayoutGap.Small">
                                    @foreach (var chip in row.Chips)
                                    {
                                        <StatusBadge Text="@chip.Text" Tone="@chip.Tone" />
                                    }
                                </Cluster>
                            </ChildContent>
                        </SelectionListItem>
                    }
                </div>
            </SectionCard>
        }
    </ChildContent>
</CatalogPageFrame>

@code {
    private static readonly SandboxGroupDefinition Group = SandboxCatalogRegistry.GetGroup(SandboxGroupKey.DataDisplay);
    private static readonly IReadOnlyList<SandboxExampleDefinition> Examples = SandboxCatalogRegistry.GetExamples(SandboxGroupKey.DataDisplay);

    private bool IsDisabled => CurrentScenario == SandboxScenarioKey.DisabledState;

    private IReadOnlyList<SummaryTileModel> Tiles => CurrentScenario switch
    {
        SandboxScenarioKey.DenseContent => DenseTiles,
        SandboxScenarioKey.LongText => LongTiles,
        _ => BaseTiles
    };

    private IReadOnlyList<DisplayCardModel> Cards => CurrentScenario switch
    {
        SandboxScenarioKey.DenseContent => DenseCards,
        SandboxScenarioKey.LongText => LongCards,
        _ => BaseCards
    };

    private IReadOnlyList<DisplayRowModel> Rows => CurrentScenario switch
    {
        SandboxScenarioKey.DenseContent => DenseRows,
        SandboxScenarioKey.LongText => LongRows,
        _ => BaseRows

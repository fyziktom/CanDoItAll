@namespace CanDoItAll.Components.Sandbox.Components
@page "/groups/overlays"
@inherits CatalogPageBase
@inject DialogService DialogService
@inject NotificationService NotificationService

<PageTitle>Overlays</PageTitle>

<CatalogPageFrame Group="@Group"
                  Scenario="@CurrentScenario"
                  Frame="@CurrentFrame"
                  ExampleCount="@Examples.Count"
                  HeroTitle="Contextual overlays that support the page instead of hijacking it."
                  HeroSummary="The overlays page checks sticky actions, contextual help, and host-mounted overlay primitives while preserving the surrounding page context."
                  DemoTitle="Overlay surfaces"
                  DemoSummary="Help popovers, sticky actions, and overlay host treatment for the current scenario."
                  ScenarioChanged="NavigateScenario"
                  FrameChanged="NavigateFrame">
    <Notes>
        <div class="sandbox-proof-list">
            <p>Contextual help should answer a question quickly and then get out of the way.</p>
            <p>Sticky actions should close the workflow without stealing the page hierarchy.</p>
            <p>Overlay hosts should remain a shared concern instead of being reimplemented per page.</p>
        </div>
    </Notes>

    <ChildContent>
        @if (CurrentScenario == SandboxScenarioKey.LoadingState)
        {
            <LoadingState Eyebrow="Overlays" Title="Preparing overlay surfaces" Description="The page keeps context while contextual help, host layers, and sticky actions initialize." />
        }
        else
        {
            <SectionCard Title="Contextual help" Description="Help should be available at the point of confusion without forcing a route change.">
                <Split Breakpoint="LayoutBreakpoint.Md"
                       Gap="LayoutGap.Large"
                       AlignItems="AlignItems.Start"
                       JustifyContent="JustifyContent.SpaceBetween"
                       Class="rounded-[1.5rem] border border-slate-200 bg-slate-50/80 p-5">
                    <div class="space-y-2">
                        <TextBlock TextStyle="@(TextStyle.Subtitle1)" Value="Review decision support" />
                        <TextBlock TextStyle="@(TextStyle.Body2)" Value="@HelpCopy" />
                    </div>

                    <HelpPopover Heading="Review checklist"
                                 Body="@HelpBody"
                                 Tip="@HelpTip">
                        <PanelContent>
                            <div class="sandbox-proof-list">
                                <p>Confirm desktop and mobile evidence.</p>
                                <p>Check empty and dense scenarios before approval.</p>
                                <p>Prefer shared components over one-off markup.</p>
                            </div>
                        </PanelContent>
                    </HelpPopover>
                </Split>
            </SectionCard>

            <SectionCard Title="Overlay services" Description="Programmatic services mount once in the layout and let pages open dialogs, tooltips, and notifications without owning overlay markup.">
                <Grid Gap="LayoutGap.Large"
                      ColumnTemplate="minmax(0,1fr)"
                      ColumnTemplateLg="minmax(0,1.15fr) minmax(16rem,0.85fr)">
                    <Stack GapScale="LayoutGap.Medium">
                        <TextBlock TextStyle="@(TextStyle.Body2)" Value="DialogService examples cover modal sizes, protected backdrop behavior, and close results returned to the caller." />
                        <Cluster Gap="LayoutGap.Small">
                            <Button Text="Compact dialog"
                                    ButtonStyle="@(ButtonStyle.Light)"
                                    Variant="@(Variant.Outlined)"
                                    Click="@(() => OpenSizedDialog(ModalSize.Compact))"
                                    data-testid="open-compact-dialog" />
                            <Button Text="Wide dialog"
                                    ButtonStyle="@(ButtonStyle.Info)"
                                    Variant="@(Variant.Outlined)"
                                    Click="@(() => OpenSizedDialog(ModalSize.Wide))"
                                    data-testid="open-wide-dialog" />
                            <Button Text="Full dialog"
                                    ButtonStyle="@(ButtonStyle.Secondary)"
                                    Variant="@(Variant.Outlined)"
                                    Click="@(() => OpenSizedDialog(ModalSize.Full))"
                                    data-testid="open-full-dialog" />
                            <Button Text="Return object"
                                    Click="@OpenResultDialog"
                                    data-testid="open-result-dialog" />
                            <Button Text="Backdrop locked"
                                    ButtonStyle="@(ButtonStyle.Warning)"
                                    Variant="@(Variant.Outlined)"
                                    Click="@OpenBackdropLockedDialog"
                                    data-testid="open-backdrop-dialog" />
                        </Cluster>

                        <Alert AlertStyle="@(AlertStyle.Info)">
                            <span data-testid="dialog-result">@DialogResultText</span>
                        </Alert>
                    </Stack>

                    <Stack GapScale="LayoutGap.Medium">
                        <TextBlock TextStyle="@(TextStyle.Body2)" Value="TooltipService and NotificationService stay host-mounted so local pages only trigger state." />
                        <Cluster Gap="LayoutGap.Small">
                            <TooltipTarget Text="TooltipService opened this host-mounted tooltip from pointer coordinates."
                                           Position="TooltipPosition.RightTop"
                                           Duration="@((TimeSpan?)null)"
                                           TestId="service-tooltip"
                                           TriggerClass="inline-flex">
                                <span class="inline-flex items-center rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 shadow-sm"
                                      data-testid="tooltip-trigger">
                                    Hover service tooltip
                                </span>
                            </TooltipTarget>

                            <Button Text="Show toast"
                                    ButtonStyle="@(ButtonStyle.Success)"
                                    Variant="@(Variant.Outlined)"
                                    Click="@ShowOverlayToast"
                                    data-testid="show-overlay-toast" />
                        </Cluster>
                    </Stack>
                </Grid>
            </SectionCard>

            <Grid Gap="LayoutGap.Large"
                  ColumnTemplate="repeat(auto-fit,minmax(16rem,1fr))">
                <SectionCard Title="Overlay hosts" Description="Hidden hosts should still be mounted centrally so pages do not create their own overlay plumbing.">
                    <div class="space-y-4">
                        <Alert AlertStyle="@(AlertStyle.Info)">Dialog and tooltip hosts stay mounted as shared infrastructure while individual pages focus on rendering and orchestration.</Alert>
                        <Cluster Gap="LayoutGap.Small">
                            <StatusBadge Text="Dialog host mounted" Tone="success" />
                            <StatusBadge Text="Tooltip host mounted" Tone="success" />
                            <StatusBadge Text="Notification host mounted" Tone="success" />
                            <StatusBadge Text="Page context preserved" Tone="info" />
                        </Cluster>
                    </div>
                </SectionCard>

                <SectionCard Title="Review surface" Description="The surrounding page still needs enough context when overlays are in play.">
                    @if (CurrentScenario == SandboxScenarioKey.EmptyState)
                    {
                        <EmptyState Eyebrow="Overlays" Title="No record selected" Description="Select a request before contextual help, confirmation actions, and sticky approval controls become meaningful." />
                    }
                    else
                    {
                        <div class="space-y-3">
                            <TextBlock TextStyle="@(TextStyle.Subtitle1)" Value="Shared migration approval" />
                            <TextBlock TextStyle="@(TextStyle.Body2)" Value="@SurfaceCopy" />
                            <Cluster Gap="LayoutGap.Small">
                                <StatusBadge Text="Needs review" Tone="warning" />
                                <StatusBadge Text="Help available" Tone="info" />
                                <StatusBadge Text="Shared host" Tone="success" />
                            </Cluster>
                        </div>
                    }
                </SectionCard>
            </Grid>

            <StickyActionFooter StatusLabel="Overlay state"
                                StatusMessage="@FooterMessage"
                                StatusTone="@FooterTone">
                <SecondaryActions>
                    <Button Text="Save draft"
                            ButtonStyle="@(ButtonStyle.Light)"
                            Variant="@(Variant.Outlined)"
                            Disabled="@IsDisabled" />
                </SecondaryActions>
                <PrimaryActions>
                    <Button Text="@PrimaryActionText" Disabled="@IsDisabled" />
                </PrimaryActions>
                <DangerActions>
                    <Button Text="Reject"
                            ButtonStyle="@(ButtonStyle.Danger)"
                            Variant="@(Variant.Text)"
                            Disabled="@IsDisabled" />
                </DangerActions>
            </StickyActionFooter>
        }
    </ChildContent>
</CatalogPageFrame>

@code {
    private static readonly SandboxGroupDefinition Group = SandboxCatalogRegistry.GetGroup(SandboxGroupKey.Overlays);
    private static readonly IReadOnlyList<SandboxExampleDefinition> Examples = SandboxCatalogRegistry.GetExamples(SandboxGroupKey.Overlays);

    private string DialogResultText { get; set; } = "No dialog result returned yet.";

    private bool IsDisabled => CurrentScenario == SandboxScenarioKey.EmptyState || CurrentScenario == SandboxScenarioKey.DisabledState;

    private Task OpenSizedDialog(ModalSize size)
    {
        var label = ResolveSizeLabel(size);
        var slug = ResolveSizeSlug(size);

        _ = DialogService.OpenAsync(
            $"{label} service dialog",
            dialog => @<Stack GapScale="LayoutGap.Medium">
                <TextBlock TextStyle="@(TextStyle.Body2)" Value="@($"This {label.ToLowerInvariant()} modal is opened by DialogService and rendered through the shared DialogHost.")" />
                <Alert AlertStyle="@(AlertStyle.Info)">The modal keeps the existing BaseLib dialog chrome while the service owns result completion.</Alert>
                <Cluster Gap="LayoutGap.Small">
                    <Button Text="Close"
                            ButtonStyle="@(ButtonStyle.Light)"
                            Variant="@(Variant.Outlined)"
                            Click="@(() => CloseDialogWithResult(dialog, $"{label} closed"))"
                            data-testid="close-sized-dialog" />
                </Cluster>
            </Stack>,
            new DialogOptions
            {
                Size = size,
                Subtitle = "Service-driven modal size proof.",
                TestId = $"service-dialog-{slug}"
            });

        return Task.CompletedTask;
    }

    private async Task OpenResultDialog()
    {
        var result = await DialogService.OpenAsync(
            "Return a decision object",
            dialog => @<Stack GapScale="LayoutGap.Medium">
                <TextBlock TextStyle="@(TextStyle.Body2)" Value="Close this dialog with an object so the caller can continue the workflow with typed data." />
                <Cluster Gap="LayoutGap.Small">
                    <Button Text="Return approval"
                            Click="@(() => CloseDialogWithDecision(dialog, ApprovedStatus))"
                            data-testid="return-dialog-object" />
                    <Button Text="Return review"
                            ButtonStyle="@(ButtonStyle.Warning)"
                            Variant="@(Variant.Outlined)"
                            Click="@(() => CloseDialogWithDecision(dialog, ReviewStatus))" />
                </Cluster>
            </Stack>,
            new DialogOptions
            {
                Size = ModalSize.Medium,
                Subtitle = "The awaited service call receives the object supplied by dialog.CloseAsync.",
                TestId = "service-dialog-result"
            });

        DialogResultText = result is DialogDecision decision
            ? $"Dialog returned: {decision.Status} from {decision.Source}"
            : "Dialog returned no object.";
    }

    private Task OpenBackdropLockedDialog()
    {
        _ = DialogService.OpenAsync(
            "Backdrop close disabled",
            dialog => @<Stack GapScale="LayoutGap.Medium">
                <TextBlock TextStyle="@(TextStyle.Body2)" Value="Clicking outside this modal should leave it open. Use the explicit action to close it." />
                <Button Text="Close locked dialog"
                        ButtonStyle="@(ButtonStyle.Warning)"
                        Variant="@(Variant.Outlined)"
                        Click="@(() => CloseDialogWithResult(dialog, LockedCloseResult))"
                        data-testid="close-backdrop-dialog" />
            </Stack>,
            new DialogOptions
            {
                Size = ModalSize.Compact,
                CloseOnBackdrop = false,
                Subtitle = "CloseOnBackdrop is false for this service dialog.",
                TestId = "service-dialog-backdrop-locked"
            });

        return Task.CompletedTask;
    }

    private Task ShowOverlayToast()
    {
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = "Overlay service toast",
            Detail = "NotificationService rendered this bottom-center toast from the shared layout host.",
            Duration = 0,
            Position = NotificationPosition.BottomCenter,
            TestId = "overlay-service-toast"
        });

        return Task.CompletedTask;
    }

    private string HelpCopy => CurrentScenario switch
    {
        SandboxScenarioKey.LongText => "Longer contextual copy should still stay short enough to read quickly and should hand off the full explanation to the popover panel instead of bloating the surrounding page.",
        SandboxScenarioKey.DenseContent => "Dense review surfaces still need nearby help so users do not leave the current flow to answer simple questions.",
        _ => "The page keeps its shape while contextual help answers small questions inline."
    };

    private string HelpBody => CurrentScenario switch
    {
        SandboxScenarioKey.LongText => "Use the popover for concise workflow guidance, escalation rules, and proof requirements that would otherwise crowd the surrounding page.",
        SandboxScenarioKey.DenseContent => "Dense approval surfaces rely on short, well-scoped help to avoid route changes and extra supporting chrome.",
        _ => "Contextual help should clarify the current action without replacing the main page content."
    };

    private string HelpTip => CurrentScenario == SandboxScenarioKey.DenseContent
        ? "Click outside or press Escape to close the help panel."
        : "The panel should feel disposable once the user has their answer.";

    private string SurfaceCopy => CurrentScenario switch
    {
        SandboxScenarioKey.DenseContent => "Dense approval content still leaves room for sticky actions and contextual help without forcing the user to decode overlapping priority signals.",
        SandboxScenarioKey.LongText => "Longer surrounding copy should not hide the sticky action footer or make the contextual help trigger feel disconnected from the content it supports.",
        _ => "A shared overlay system should reinforce the review flow instead of fragmenting it."
    };

    private string FooterMessage => CurrentScenario switch
    {
        SandboxScenarioKey.EmptyState => "Select a request before sticky approval actions become available.",
        SandboxScenarioKey.DisabledState => "Actions are visible but unavailable; the page should still explain what they would do.",
        _ => "Sticky actions should keep the last decision visible without overpowering the page."
    };

    private string FooterTone => CurrentScenario switch
    {
        SandboxScenarioKey.EmptyState => "warning",
        SandboxScenarioKey.DisabledState => "warning",
        _ => "info"
    };

    private string PrimaryActionText => CurrentScenario == SandboxScenarioKey.LongText
        ? "Approve overlay treatment and capture proof"
        : "Approve";

    private const string ApprovedStatus = "Approved";
    private const string ReviewStatus = "Needs review";
    private const string LockedCloseResult = "locked dialog closed";

    private static Task CloseDialogWithResult(DialogReference dialog, object result)
    {
        return dialog.CloseAsync(result);
    }

    private static Task CloseDialogWithDecision(DialogReference dialog, string status)
    {
        return dialog.CloseAsync(new DialogDecision(status, "service-demo"));
    }

    private static string ResolveSizeLabel(ModalSize size)
    {
        return size switch
        {
            ModalSize.Compact => "Compact",
            ModalSize.Wide => "Wide",
            ModalSize.Full => "Full",
            _ => "Medium"
        };
    }

    private static string ResolveSizeSlug(ModalSize size)
    {
        return size switch
        {
            ModalSize.Compact => "compact",
            ModalSize.Wide => "wide",
            ModalSize.Full => "full",
            _ => "medium"
        };
    }

    private sealed record DialogDecision(string Status, string Source);
}

@namespace CanDoItAll.Components.Sandbox.Components
@page "/groups/feedback"
@inherits CatalogPageBase
@inject NotificationService NotificationService

<PageTitle>Feedback</PageTitle>

<CatalogPageFrame Group="@Group"
                  Scenario="@CurrentScenario"
                  Frame="@CurrentFrame"
                  ExampleCount="@Examples.Count"
                  HeroTitle="Feedback surfaces that explain state instead of adding drama."
                  HeroSummary="The feedback page tests alerts, badges, notifications, loading, and empty states under realistic operational copy."
                  DemoTitle="Feedback surfaces"
                  DemoSummary="Status, loading, empty, and notification behavior for the current scenario."
                  ScenarioChanged="NavigateScenario"
                  FrameChanged="NavigateFrame">
    <Notes>
        <div class="sandbox-proof-list">
            <p>Severity should be obvious without overwhelming the rest of the page.</p>
            <p>Notifications need actionable language, not vague celebration or alarm.</p>
            <p>Empty and loading states still need a clear next step.</p>
        </div>
    </Notes>

    <ChildContent>
        @if (CurrentScenario == SandboxScenarioKey.EmptyState)
        {
            <EmptyState Eyebrow="Feedback" Title="No incidents this hour" Description="No active warnings or evidence requests are waiting on the sandbox owner." />
        }
        else if (CurrentScenario == SandboxScenarioKey.LoadingState)
        {
            <LoadingState Eyebrow="Feedback" Title="Refreshing health snapshot" Description="The status summary remains calm while probes and examples refresh." />
        }
        else
        {
            <SectionCard Title="Alert stack" Description="Operational feedback should stay readable in sequence.">
                <div class="space-y-3">
                    <Alert AlertStyle="@(AlertStyle.Info)">The sandbox route loaded the shared assets and the page scaffold is ready for proof review.</Alert>
                    <Alert AlertStyle="@(AlertStyle.Warning)">Dense scenarios still need a screenshot review before the migration can be accepted.</Alert>
                    @if (CurrentScenario == SandboxScenarioKey.LongText)
                    {
                        <Alert AlertStyle="@(AlertStyle.Danger)">Longer explanatory alerts should still remain readable without forcing the user to decode an oversized block of red text or lose the rest of the page hierarchy.</Alert>
                    }
                    else
                    {
                        <Alert AlertStyle="@(AlertStyle.Success)">The happy-path pass is stable enough to move on to dense and empty-state proof.</Alert>
                    }
                </div>
            </SectionCard>

            <div class="sandbox-demo-grid sandbox-demo-grid--two">
                <SectionCard Title="Status and summaries" Description="Small status surfaces should still scan well next to denser content.">
                    <div class="space-y-4">
                        <div class="flex flex-wrap gap-2">
                            <StatusBadge Text="Healthy" Tone="success" />
                            <StatusBadge Text="Waiting proof" Tone="warning" />
                            <StatusBadge Text="Blocked" Tone="danger" />
                            <StatusBadge Text="Info" Tone="info" />
                        </div>

                        <SummaryTiles>
                            <SummaryTile Label="Checks" Value="18" HelperText="Total review questions in the screenshot pass." Tone="info" />
                            <SummaryTile Label="Warnings" Value="2" HelperText="Dense and mobile variants still need a closer look." Tone="warning" />
                            <SummaryTile Label="Ready" Value="5" HelperText="Routes already verified for desktop and mobile." Tone="success" />
                        </SummaryTiles>
                    </div>
                </SectionCard>

                <SectionCard Title="Notifications" Description="Toasts should be short, specific, and easy to dismiss mentally.">
                    <div class="space-y-4">
                        <TextBlock TextStyle="@(TextStyle.Body2)" Value="Use the buttons below to verify informational, success, and warning notification copy." />
                        <div class="flex flex-wrap gap-3">
                            <Button Text="Info toast" ButtonStyle="@(ButtonStyle.Light)" Variant="@(Variant.Outlined)" Click="@SendInfoToast" />
                            <Button Text="Success toast" Click="@SendSuccessToast" />
                            <Button Text="Warning toast" ButtonStyle="@(ButtonStyle.Warning)" Variant="@(Variant.Outlined)" Click="@SendWarningToast" />
                        </div>
                    </div>
                </SectionCard>
            </div>
        }
    </ChildContent>
</CatalogPageFrame>

@code {
    private static readonly SandboxGroupDefinition Group = SandboxCatalogRegistry.GetGroup(SandboxGroupKey.Feedback);
    private static readonly IReadOnlyList<SandboxExampleDefinition> Examples = SandboxCatalogRegistry.GetExamples(SandboxGroupKey.Feedback);

    private Task SendInfoToast()
    {
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Info,
            Summary = "Sandbox refreshed",
            Detail = "The current group examples have been reloaded for review."
        });

        return Task.CompletedTask;
    }

    private Task SendSuccessToast()
    {
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = "Screenshot saved",
            Detail = "The desktop proof image is ready for validation."
        });

        return Task.CompletedTask;
    }

    private Task SendWarningToast()
    {
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Warning,
            Summary = "Review needed",
            Detail = "The mobile proof still has a spacing concern to resolve."
        });

        return Task.CompletedTask;
    }
}

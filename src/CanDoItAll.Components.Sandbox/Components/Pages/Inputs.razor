@namespace CanDoItAll.Components.Sandbox.Components
@page "/groups/inputs"
@inherits CatalogPageBase
@using CanDoItAll.Components.Common
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Inputs</PageTitle>

<CatalogPageFrame Group="@Group"
                  Scenario="@CurrentScenario"
                  Frame="@CurrentFrame"
                  ExampleCount="@Examples.Count"
                  HeroTitle="Explicit field state, predictable form rhythm, and fast review."
                  HeroSummary="The inputs page proves that shared field components stay understandable with realistic content, disabled states, long text, and mobile stacking."
                  DemoTitle="Input surfaces"
                  DemoSummary="A shared intake form under the current scenario."
                  ScenarioChanged="NavigateScenario"
                  FrameChanged="NavigateFrame">
    <Notes>
        <div class="sandbox-proof-list">
            <p>Keep labels, helper copy, and field spacing legible before validation or decoration is added.</p>
            <p>Dense mode should stack more data, not shrink the affordances into noise.</p>
            <p>Disabled mode still needs to explain what the user is looking at.</p>
        </div>
    </Notes>

    <ChildContent>
        @if (CurrentScenario == SandboxScenarioKey.LoadingState)
        {
            <LoadingState Eyebrow="Inputs" Title="Loading intake draft" Description="Field surfaces stay oriented while the draft and validation metadata load." />
        }
        else if (CurrentScenario == SandboxScenarioKey.EmptyState)
        {
            <EmptyState Eyebrow="Inputs" Title="No draft selected" Description="Choose or create a draft before editing title, status, due dates, and reviewer settings." />
        }
        else
        {
            <FormSection Title="Review intake" Description="A realistic form with text, numeric, selection, and boolean inputs.">
                <Grid Gap="LayoutGap.Large"
                      ColumnTemplate="repeat(auto-fit,minmax(16rem,1fr))">
                    <FormField Text="Title">
                        <TextBox Value="@FormState.Title"
                                 ValueChanged="HandleTitleChanged"
                                 Placeholder="@TitlePlaceholder"
                                 Disabled="@IsDisabled" />
                    </FormField>

                    <FormField Text="Owner">
                        <TextBox Value="@FormState.Owner"
                                 ValueChanged="HandleOwnerChanged"
                                 Placeholder="Owner or reviewer"
                                 Disabled="@IsDisabled" />
                    </FormField>

                    <FormField Text="Status">
                        <DropDown TValue="string"
                                  Data="@StatusOptions"
                                  TextProperty="@nameof(SelectOption.Text)"
                                  ValueProperty="@nameof(SelectOption.Value)"
                                  Value="@FormState.Status"
                                  ValueChanged="HandleStatusChanged"
                                  Placeholder="Select status"
                                  Disabled="@IsDisabled" />
                    </FormField>

                    <FormField Text="Confidence">
                        <Numeric TValue="int"
                                 Value="@FormState.Confidence"
                                 ValueChanged="HandleConfidenceChanged"
                                 Min="0"
                                 Max="100"
                                 Step="5"
                                 Disabled="@IsDisabled" />
                    </FormField>

                    <FormField Text="Password">
                        <Password Value="@FormState.Secret"
                                  ValueChanged="HandleSecretChanged"
                                  Placeholder="Shared secret"
                                  Disabled="@IsDisabled" />
                    </FormField>

                    <FormField Text="Timed secret">
                        <SecretField Value="@FormState.Secret"
                                     ValueChanged="HandleSecretChanged"
                                     SecretName="sandbox-api-key"
                                     ShowNameCopy="true"
                                     ShowValueCopy="true"
                                     RevealDurationSeconds="30"
                                     Placeholder="Managed secret"
                                     Disabled="@IsDisabled"
                                     data-testid="sandbox-secret-field" />
                    </FormField>

                    <FormField Text="Reminders">
                        <Split Breakpoint="LayoutBreakpoint.None"
                               Gap="LayoutGap.Medium"
                               AlignItems="AlignItems.Center"
                               JustifyContent="JustifyContent.SpaceBetween"
                               Class="rounded-[1rem] border border-slate-200 bg-white px-4 py-3">
                            <div class="space-y-1">
                                <TextBlock TextStyle="@(TextStyle.Subtitle2)" Value="Send daily reminders" />
                                <TextBlock TextStyle="@(TextStyle.Caption)" Value="Keep reviewers aligned before the approval window closes." />
                            </div>
                            <Switch Value="@FormState.RemindersEnabled"
                                    ValueChanged="HandleReminderChanged"
                                    Disabled="@IsDisabled" />
                        </Split>
                    </FormField>
                </Grid>
            </FormSection>

            <SectionCard Title="Inline editable values" Description="Editable switches a displayed property into a shared BaseLib input, then saves the value back to the source item.">
                <Stack GapScale="LayoutGap.Large" data-testid="sandbox-editable-values">
                    <Grid Gap="LayoutGap.Large"
                          ColumnTemplate="repeat(auto-fit,minmax(14rem,1fr))">
                        <FormField Text="Title">
                            <Editable TItem="EditableReviewItem"
                                      Item="@EditableState"
                                      ItemChanged="HandleEditableChanged"
                                      ParameterName="@nameof(EditableReviewItem.Title)"
                                      Placeholder="Review title"
                                      Disabled="@IsDisabled"
                                      data-testid="editable-title" />
                        </FormField>

                        <FormField Text="Confidence">
                            <Editable TItem="EditableReviewItem"
                                      Item="@EditableState"
                                      ItemChanged="HandleEditableChanged"
                                      ParameterName="@nameof(EditableReviewItem.Confidence)"
                                      Extension="%"
                                      Disabled="@IsDisabled"
                                      data-testid="editable-confidence" />
                        </FormField>

                        <FormField Text="Effort">
                            <Editable TItem="EditableReviewItem"
                                      Item="@EditableState"
                                      ItemChanged="HandleEditableChanged"
                                      ParameterName="@nameof(EditableReviewItem.EffortHours)"
                                      Format="0.0"
                                      Extension=" h"
                                      Disabled="@IsDisabled"
                                      data-testid="editable-effort" />
                        </FormField>

                        <FormField Text="Approval">
                            <Editable TItem="EditableReviewItem"
                                      Item="@EditableState"
                                      ItemChanged="HandleEditableChanged"
                                      ParameterName="@nameof(EditableReviewItem.RequiresApproval)"
                                      TrueText="Approval required"
                                      FalseText="Self review"
                                      Disabled="@IsDisabled"
                                      data-testid="editable-approval" />
                        </FormField>
                    </Grid>

                    <Alert AlertStyle="@(AlertStyle.Info)">
                        Latest editable state: @EditableSummary. Saves: @editableSaveCount.
                    </Alert>
                </Stack>
            </SectionCard>

            <SectionCard Title="Notes and toggles" Description="Longer text and binary settings should remain stable when the surface gets denser.">
                <div class="space-y-4">
                    <FormField Text="Notes">
                        <TextArea Value="@FormState.Notes"
                                  ValueChanged="HandleNotesChanged"
                                  Rows="@(CurrentScenario == SandboxScenarioKey.DenseContent ? 5 : 7)"
                                  Placeholder="@NotesPlaceholder"
                                  Disabled="@IsDisabled" />
                    </FormField>

                    <Grid Gap="LayoutGap.Large"
                          ColumnTemplate="repeat(auto-fit,minmax(16rem,1fr))">
                        <div class="rounded-[1rem] border border-slate-200 bg-white px-4 py-3">
                            <Cluster AlignItems="AlignItems.Start"
                                     Wrap="FlexWrap.NoWrap"
                                     Gap="LayoutGap.Medium">
                                <CheckBox TValue="bool" Value="@FormState.RequiresApproval" ValueChanged="HandleApprovalChanged" Disabled="@IsDisabled" />
                                <div class="space-y-1">
                                    <TextBlock TextStyle="@(TextStyle.Subtitle2)" Value="Requires approval" />
                                    <TextBlock TextStyle="@(TextStyle.Caption)" Value="Gate release until the designated reviewer signs off." />
                                </div>
                            </Cluster>
                        </div>

                        <div class="rounded-[1rem] border border-slate-200 bg-white px-4 py-3">
                            <Cluster AlignItems="AlignItems.Start"
                                     Wrap="FlexWrap.NoWrap"
                                     Gap="LayoutGap.Medium">
                                <CheckBox TValue="bool" Value="@FormState.PublishExternally" ValueChanged="HandlePublishChanged" Disabled="@IsDisabled" />
                                <div class="space-y-1">
                                    <TextBlock TextStyle="@(TextStyle.Subtitle2)" Value="Publish externally" />
                                    <TextBlock TextStyle="@(TextStyle.Caption)" Value="Expose the final draft to downstream reporting and partner tooling." />
                                </div>
                            </Cluster>
                        </div>
                    </Grid>
                </div>
            </SectionCard>

            <SectionCard Title="File upload"
                         Description="The picker stays native while drag and drop route through the same shared change callback.">
                <Grid Gap="LayoutGap.Large"
                      Columns="1"
                      ColumnsLg="2">
                    <div class="space-y-4">
                        <FileUpload PrimaryText="@UploadPrimaryText"
                                    SecondaryText="@UploadSecondaryText"
                                    ButtonText="@UploadButtonText"
                                    Accept=".musicxml,.xml,text/xml,application/xml"
                                    Disabled="@IsDisabled"
                                    Change="HandleUploadChanged"
                                    RootTestHookId="sandbox-inputs-file-upload"
                                    DropZoneTestHookId="sandbox-inputs-file-upload-zone"
                                    ButtonTestHookId="sandbox-inputs-file-upload-button"
                                    InputTestHookId="sandbox-inputs-file-upload-input" />

                        <div class="flex flex-wrap gap-2" data-testid="sandbox-inputs-file-upload-modes">
                            <StatusBadge Text="Native picker" Tone="info" />
                            <StatusBadge Text="Drag and drop" Tone="success" />
                            <StatusBadge Text="@(IsDisabled ? "Disabled state" : "Live state")"
                                         Tone="@(IsDisabled ? "neutral" : "warning")" />
                        </div>
                    </div>

                    <div class="space-y-4" data-testid="sandbox-inputs-file-upload-summary">
                        <SummaryTiles>
                            <SummaryTile Label="Selections"
                                         Value="@uploadSelectionCount.ToString()"
                                         HelperText="How many successful file selections reached the shared callback."
                                         Tone="info" />
                            <SummaryTile Label="Files"
                                         Value="@uploadedFileCount.ToString()"
                                         HelperText="Current file count in the latest selection."
                                         Tone="success" />
                            <SummaryTile Label="Payload"
                                         Value="@UploadedTotalSizeLabel"
                                         HelperText="Combined size of the latest accepted files."
                                         Tone="warning" />
                        </SummaryTiles>

                        <div class="rounded-[1rem] border border-slate-200 bg-white px-4 py-4">
                            <div class="space-y-1">
                                <TextBlock TextStyle="@(TextStyle.Subtitle2)" Value="Latest selection" />
                                <TextBlock TextStyle="@(TextStyle.Caption)"
                                           Value="Use this panel to confirm that browse and drop both resolve through the same stable callback." />
                            </div>

                            @if (uploadedFileNames.Count == 0)
                            {
                                <p class="mt-3 text-sm leading-6 text-slate-500">No files selected yet.</p>
                            }
                            else
                            {
                                <ul class="mt-3 space-y-2 text-sm text-slate-700" data-testid="sandbox-inputs-file-upload-files">
                                    @foreach (var fileName in uploadedFileNames)
                                    {
                                        <li class="rounded-[0.85rem] bg-slate-50 px-3 py-2">@fileName</li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </Grid>
            </SectionCard>
        }
    </ChildContent>
</CatalogPageFrame>

@code {
    private static readonly SandboxGroupDefinition Group = SandboxCatalogRegistry.GetGroup(SandboxGroupKey.Inputs);
    private static readonly IReadOnlyList<SandboxExampleDefinition> Examples = SandboxCatalogRegistry.GetExamples(SandboxGroupKey.Inputs);
    private static readonly IReadOnlyList<SelectOption> StatusOptions =
    [
        new("Draft", "Draft"),
        new("Review", "Review"),
        new("Blocked", "Blocked"),
        new("Approved", "Approved")
    ];

    private int uploadSelectionCount;
    private int uploadedFileCount;
    private long uploadedTotalSizeBytes;
    private IReadOnlyList<string> uploadedFileNames = [];
    private SandboxScenarioKey editableStateScenario = SandboxScenarioKey.HappyPath;
    private EditableReviewItem EditableState = CreateEditableState(SandboxScenarioKey.HappyPath);
    private int editableSaveCount;

    private InputFormState FormState => CurrentScenario switch
    {
        SandboxScenarioKey.DenseContent => new(
            "Quarterly migration review",
            "Architecture steward",
            "Review",
            85,
            "dense-secret",
            true,
            true,
            false,
            "Carry audit notes, dependent packages, and release guardrails through a tighter review lane so the screen proves it can hold more context without collapsing."),
        SandboxScenarioKey.LongText => new(
            "Quarterly migration review with extended ownership and escalation notes for all teams involved",
            "Platform architecture review board",
            "Review",
            90,
            "long-secret",
            true,
            true,
            false,
            "This scenario intentionally uses a longer note so the textarea, labels, and spacing show whether the shared field components can tolerate more editorial copy without turning the page into an unreadable wall of text."),
        _ => new(
            "Component validation pass",
            "Design systems owner",
            "Draft",
            70,
            "secret-token",
            true,
            false,
            true,
            "Capture enough context for the reviewer to understand the request without reading surrounding application code.")
    };

    private bool IsDisabled => CurrentScenario == SandboxScenarioKey.DisabledState;

    private string TitlePlaceholder => CurrentScenario == SandboxScenarioKey.LongText
        ? "Long titles should wrap predictably and still read well."
        : "Short, clear summary";

    private string NotesPlaceholder => CurrentScenario == SandboxScenarioKey.DenseContent
        ? "Dense scenario notes stay compact but legible."
        : "Explain context, risk, and reviewer expectations.";

    private string UploadPrimaryText => CurrentScenario switch
    {
        SandboxScenarioKey.LongText => "Drag and drop a longer MusicXML review package without losing the reading rhythm of the surface.",
        SandboxScenarioKey.DenseContent => "Drag and drop the current MusicXML intake package.",
        SandboxScenarioKey.DisabledState => "Uploads are currently locked for this scenario.",
        _ => "Drag and drop MusicXML"
    };

    private string UploadSecondaryText => CurrentScenario switch
    {
        SandboxScenarioKey.LongText => "or browse for a plain `.musicxml` / `.xml` source while keeping the helper copy, button, and drop state aligned.",
        SandboxScenarioKey.DisabledState => "Browsing and drag and drop are disabled here so the component can prove its inactive state.",
        _ => "or browse for a plain `.musicxml` / `.xml` source."
    };

    private string UploadButtonText => CurrentScenario == SandboxScenarioKey.DisabledState
        ? "Upload locked"
        : "Choose MusicXML";

    private string UploadedTotalSizeLabel => uploadedTotalSizeBytes == 0
        ? "0 B"
        : FormatBytes(uploadedTotalSizeBytes);

    private string EditableSummary
        => $"{EditableState.Title} | {EditableState.Confidence}% | {EditableState.EffortHours:0.0} h | {(EditableState.RequiresApproval ? "approval" : "self-review")}";

    protected override void OnParametersSet()
    {
        if (editableStateScenario != CurrentScenario)
        {
            editableStateScenario = CurrentScenario;
            EditableState = CreateEditableState(CurrentScenario);
            editableSaveCount = 0;
        }
    }

    private Task HandleTitleChanged(string? value)
    {
        return Task.CompletedTask;
    }

    private Task HandleOwnerChanged(string? value)
    {
        return Task.CompletedTask;
    }

    private Task HandleStatusChanged(string? value)
    {
        return Task.CompletedTask;
    }

    private Task HandleConfidenceChanged(int value)
    {
        return Task.CompletedTask;
    }

    private Task HandleSecretChanged(string? value)
    {
        return Task.CompletedTask;
    }

    private Task HandleReminderChanged(bool value)
    {
        return Task.CompletedTask;
    }

    private Task HandleNotesChanged(string? value)
    {
        return Task.CompletedTask;
    }

    private Task HandleApprovalChanged(bool value)
    {
        return Task.CompletedTask;
    }

    private Task HandlePublishChanged(bool value)
    {
        return Task.CompletedTask;
    }

    private Task HandleEditableChanged(EditableReviewItem item)
    {
        EditableState = item;
        editableSaveCount++;
        return Task.CompletedTask;
    }

    private Task HandleUploadChanged(InputFileChangeEventArgs args)
    {
        var files = args.GetMultipleFiles(10);
        uploadSelectionCount++;
        uploadedFileCount = files.Count;
        uploadedTotalSizeBytes = files.Sum(file => file.Size);
        uploadedFileNames = files
            .Select(file => $"{file.Name} ({FormatBytes(file.Size)})")
            .ToArray();
        return Task.CompletedTask;
    }

    private static string FormatBytes(long bytes)
    {
        string[] suffixes = ["B", "KB", "MB", "GB"];
        double value = bytes;
        var suffixIndex = 0;

        while (value >= 1024d && suffixIndex < suffixes.Length - 1)
        {
            value /= 1024d;
            suffixIndex++;
        }

        return suffixIndex == 0
            ? $"{value:0} {suffixes[suffixIndex]}"
            : $"{value:0.0} {suffixes[suffixIndex]}";
    }

    private static EditableReviewItem CreateEditableState(SandboxScenarioKey scenario)
    {
        return scenario switch
        {
            SandboxScenarioKey.DenseContent => new()
            {
                Title = "Migration gate review",
                Confidence = 88,
                EffortHours = 12.5,
                RequiresApproval = true
            },
            SandboxScenarioKey.LongText => new()
            {
                Title = "Quarterly migration review with extended ownership and escalation notes",
                Confidence = 91,
                EffortHours = 18.75,
                RequiresApproval = true
            },
            SandboxScenarioKey.DisabledState => new()
            {
                Title = "Locked review item",
                Confidence = 64,
                EffortHours = 4.0,
                RequiresApproval = false
            },
            _ => new()
            {
                Title = "Component validation pass",
                Confidence = 70,
                EffortHours = 6.5,
                RequiresApproval = true
            }
        };
    }

    private sealed record SelectOption(string Text, string Value);

    private sealed record InputFormState(
        string Title,
        string Owner,
        string Status,
        int Confidence,
        string Secret,
        bool RemindersEnabled,
        bool RequiresApproval,
        bool PublishExternally,
        string Notes);

    private sealed class EditableReviewItem
    {
        public string Title { get; set; } = string.Empty;

        public int Confidence { get; set; }

        public double EffortHours { get; set; }

        public bool RequiresApproval { get; set; }
    }
}

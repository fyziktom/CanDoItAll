@namespace CanDoItAll.Components.Sandbox.Components
@inject NavigationManager NavigationManager
@inherits LayoutComponentBase
@implements IDisposable

<ThemeHost ThemeKey="@themeState.ThemeKey">
    <CascadingValue Value="@themeState">
        <div class="sandbox-layout">
            <div class="sandbox-layout__backdrop" aria-hidden="true"></div>
            <div class="sandbox-layout__shell">
                <aside class="sandbox-sidebar">
                    <a class="sandbox-brand" href="/">
                        <span class="sandbox-brand__eyebrow">CanDoItAll</span>
                        <span class="sandbox-brand__title">Components Sandbox</span>
                    </a>

                    <p class="sandbox-brand__summary">A calm validation lab for shared surfaces, typed canvas contracts, and future MCP examples.</p>

                    <nav class="sandbox-nav" aria-label="Component groups">
                        @foreach (var group in SandboxCatalogRegistry.Groups)
                        {
                            <a href="@group.Route"
                               class="sandbox-nav__link @(IsActive(group) ? "is-active" : string.Empty)">
                                <span class="sandbox-nav__title">@group.Title</span>
                                <span class="sandbox-nav__meta">@string.Join(" / ", group.FocusAreas.Take(3))</span>
                            </a>
                        }
                    </nav>

                    <SectionCard Title="Validation Gate" Description="Each page needs happy, dense, and empty proof before sign-off.">
                        <div class="space-y-2">
                            @foreach (var question in SandboxCatalogRegistry.ValidationQuestions.Take(4))
                            {
                                <p class="cda-body-muted">@question</p>
                            }
                        </div>
                    </SectionCard>
                </aside>

                <main class="sandbox-main">
                    <DialogHost />
                    <Tooltip />
                    <Notification />
                    @Body
                </main>
            </div>
        </div>
    </CascadingValue>
</ThemeHost>

@code {
    private readonly SandboxThemeState themeState = new();

    protected override void OnInitialized()
    {
        themeState.Changed += HandleThemeChanged;
    }

    private bool IsActive(SandboxGroupDefinition group)
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var currentPath = relativePath.Split('?', 2, StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
        if (string.IsNullOrWhiteSpace(currentPath))
        {
            return string.Equals(group.Route, "/", StringComparison.OrdinalIgnoreCase);
        }

        return string.Equals($"/{currentPath.TrimStart('/')}", group.Route, StringComparison.OrdinalIgnoreCase);
    }

    private void HandleThemeChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        themeState.Changed -= HandleThemeChanged;
    }
}

@page "/agents"

<PageTitle>Agents</PageTitle>

<PageScaffold>
    <Header>
        <PageHeader Eyebrow="AgentFramework"
                    Title="Integrated technical agent runtime"
                    Description="This shell owns the technical runtime, durable execution evidence, provider diagnostics, and scenario proof. CRM-HR stays canonical for business resources, while Processes and Collaboration stay canonical for launch, run, and approval governance.">
            <Actions>
                <Button Text="Open CRM / HR agents"
                        Click="OpenCrmHrAgents"
                        data-testid="agents-shell-open-crmhr" />
                <Button Text="Open processes"
                        ButtonStyle="ButtonStyle.Light"
                        Click="OpenProcesses"
                        data-testid="agents-shell-open-processes" />
            </Actions>
        </PageHeader>
    </Header>

    <Lead>
        <SummaryTiles>
            <SummaryTile Label="Technical agents"
                         Value="@technicalAgentCount.ToString()"
                         HelperText="Organization-scoped technical runtime records."
                         Tone="info" />
            <SummaryTile Label="Providers"
                         Value="@providerCount.ToString()"
                         HelperText="Workspace-owned providers executed through AgentFramework."
                         Tone="success" />
            <SummaryTile Label="Bound resources"
                         Value="@boundResourceCount.ToString()"
                         HelperText="CRM-HR AI resources already bound to a technical agent."
                         Tone="warning" />
            <SummaryTile Label="Capabilities"
                         Value="@capabilityCount.ToString()"
                         HelperText="Reusable skills, MCP servers, and other runtime capabilities."
                         Tone="mint" />
            <SummaryTile Label="Active runs"
                         Value="@activeRunCount.ToString()"
                         HelperText="Durable technical executions still in progress."
                         Tone="info" />
            <SummaryTile Label="Failed runs"
                         Value="@failedRunCount.ToString()"
                         HelperText="Recent execution failures that still need governance attention."
                         Tone="danger" />
        </SummaryTiles>

        <div data-testid="agents-shell-tabs">
            <SecondaryTabs Items="Tabs"
                           SelectedKey="@selectedTab"
                           SelectedKeyChanged="HandleTabChangedAsync" />
        </div>
    </Lead>

    <ChildContent>
        @if (string.Equals(selectedTab, "providers", StringComparison.Ordinal))
        {
            <ProviderManagementPanel />
        }
        else if (string.Equals(selectedTab, "agents", StringComparison.Ordinal))
        {
            <AgentCatalogPanel RequestedAgentId="@RequestedAgentId" />
        }
        else if (string.Equals(selectedTab, "chat", StringComparison.Ordinal))
        {
            <AgentChatPanel PreferredAgentId="@RequestedAgentId" />
        }
        else if (string.Equals(selectedTab, "capabilities", StringComparison.Ordinal))
        {
            <AgentCapabilitiesPanel PreferredAgentId="@RequestedAgentId" />
        }
        else if (string.Equals(selectedTab, "governance", StringComparison.Ordinal))
        {
            <AgentGovernancePanel PreferredAgentId="@RequestedAgentId" />
        }
        else if (string.Equals(selectedTab, "scenarios", StringComparison.Ordinal))
        {
            <ScenarioHarnessPanel />
        }
        else if (string.Equals(selectedTab, "diagnostics", StringComparison.Ordinal))
        {
            <AgentDiagnosticsPanel />
        }
        else
        {
            <Grid Gap="LayoutGap.Large" ColumnsLg="3">
                <SurfaceCard>
                    <p class="cda-eyebrow">Canonical boundary</p>
                    <h2 class="mt-1 text-lg font-semibold text-slate-950">One technical runtime, no duplicated ownership</h2>
                    <p class="mt-3 text-sm leading-6 text-slate-600">
                        Workspace and Security still own provider master data and secrets. CRM-HR still owns AI resource parties. This shell owns the technical runtime catalog and the execution path that actually talks to providers.
                    </p>
                    <Cluster Gap="LayoutGap.Small"
                             Wrap="FlexWrap.Wrap"
                             Class="mt-4">
                        <StatusBadge Tone="info" Text="@dashboard.ToolExecutionBoundary.Mode" />
                        <StatusBadge Tone="neutral" Text="@(dashboard.ToolExecutionBoundary.IsEnforcedByHost ? "Host enforced" : "Host reported")" />
                    </Cluster>
                    <p class="mt-3 text-xs uppercase tracking-[0.18em] text-slate-500">@dashboard.ToolExecutionBoundary.HostLabel</p>
                </SurfaceCard>

                <SurfaceCard Soft="true">
                    <p class="cda-eyebrow">Run governance</p>
                    <h2 class="mt-1 text-lg font-semibold text-slate-950">Process launch and runtime evidence stay durable</h2>
                    <p class="mt-3 text-sm leading-6 text-slate-600">
                        Approved process launches dispatch technical execution through a single AgentFramework boundary. Approvals, checkpoints, receipts, artifacts, and failures remain queryable instead of disappearing into transient logs.
                    </p>
                    <Cluster Gap="LayoutGap.Small"
                             Wrap="FlexWrap.Wrap"
                             Class="mt-4">
                        <Button Text="Open governance"
                                ButtonStyle="ButtonStyle.Light"
                                Click="@(async () => await HandleTabChangedAsync("governance"))" />
                        <Button Text="Open scenarios"
                                ButtonStyle="ButtonStyle.Light"
                                Click="@(async () => await HandleTabChangedAsync("scenarios"))"
                                data-testid="agents-shell-open-scenarios" />
                    </Cluster>
                </SurfaceCard>

                <SurfaceCard Soft="true">
                    <p class="cda-eyebrow">Cross-module flow</p>
                    <h2 class="mt-1 text-lg font-semibold text-slate-950">Business resources, launch staffing, and technical execution are connected</h2>
                    <p class="mt-3 text-sm leading-6 text-slate-600">
                        CRM-HR binds business-facing AI resources to technical agents. Processes selects those resources through launch planning, approval, and provisioning. This shell exposes the runtime and proof surfaces behind that business flow.
                    </p>
                    <Cluster Gap="LayoutGap.Small"
                             Wrap="FlexWrap.Wrap"
                             Class="mt-4">
                        <Button Text="Open chat"
                                ButtonStyle="ButtonStyle.Light"
                                Click="@(async () => await HandleTabChangedAsync("chat"))" />
                        <Button Text="Open capabilities"
                                ButtonStyle="ButtonStyle.Light"
                                Click="@(async () => await HandleTabChangedAsync("capabilities"))" />
                    </Cluster>
                </SurfaceCard>
            </Grid>
        }
    </ChildContent>
</PageScaffold>

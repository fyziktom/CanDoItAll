@page "/agents"

<PageTitle>Agents</PageTitle>

<PageScaffold MaxWidthClass="max-w-full">
    <Header>
        <PageHeader Eyebrow="AgentFramework"
                    Title="Integrated technical agent runtime"
                    Description="@AgentFrameworkShellHelpText"
                    Compact="true">
            <Stats>
                <CompactStat Label="technical agents"
                             Value="@ResolveSummaryValue(technicalAgentCount)"
                             TooltipText="Organization-scoped technical runtime records."
                             Tone="info" />
                <CompactStat Label="providers"
                             Value="@ResolveSummaryValue(providerCount)"
                             TooltipText="Workspace-owned providers executed through AgentFramework."
                             Tone="success" />
                <CompactStat Label="bound resources"
                             Value="@ResolveSummaryValue(boundResourceCount)"
                             TooltipText="CRM-HR AI resources already bound to a technical agent."
                             Tone="warning" />
                <CompactStat Label="capabilities"
                             Value="@ResolveSummaryValue(capabilityCount)"
                             TooltipText="Reusable skills, MCP servers, and other runtime capabilities."
                             Tone="accent" />
                <CompactStat Label="active runs"
                             Value="@ResolveSummaryValue(activeRunCount)"
                             TooltipText="Durable technical executions still in progress."
                             Tone="info" />
                <CompactStat Label="failed runs"
                             Value="@ResolveSummaryValue(failedRunCount)"
                             TooltipText="Recent execution failures that still need governance attention."
                             Tone="danger" />
            </Stats>
            <Actions>
                <HelpPopover RootClass="pf-help-popover inline-flex items-center"
                             ToggleClass="pf-help-popover__toggle pf-help-popover__toggle--compact"
                             OpenOnHover="true"
                             AriaLabel="Show AgentFramework shell help"
                             Title="Show AgentFramework shell help"
                             Heading="AgentFramework shell"
                             Body="@AgentFrameworkShellHelpText" />
                <PageHeaderActionButton Icon="cloud_sync"
                                        Label="Feed defaults"
                                        TooltipText="Feed default technical agents and providers."
                                        Click="FeedDefaultsAsync"
                                        Disabled="@isFeedingDefaults"
                                        IsBusy="@isFeedingDefaults"
                                        data-testid="agents-shell-feed-defaults" />
                <PageHeaderActionButton Icon="groups"
                                        Label="Open CRM / HR agents"
                                        TooltipText="Open CRM-HR agent projections."
                                        ButtonStyle="ButtonStyle.Primary"
                                        Click="OpenCrmHrAgents"
                                        data-testid="agents-shell-open-crmhr" />
                <PageHeaderActionButton Icon="flow"
                                        Label="Open workflows"
                                        TooltipText="Open AgentFramework workflows."
                                        Click="OpenWorkflows"
                                        data-testid="agents-shell-open-workflows" />
                <PageHeaderActionButton Icon="flow"
                                        Label="Open processes"
                                        TooltipText="Open the processes workspace."
                                        Click="OpenProcesses"
                                        data-testid="agents-shell-open-processes" />
            </Actions>
        </PageHeader>
    </Header>

    <Lead>
        <div data-testid="agents-shell-tabs">
            <SecondaryTabs Items="Tabs"
                           SelectedKey="@selectedTab"
                           SelectedKeyChanged="HandleTabChangedAsync" />
        </div>
    </Lead>

    <ChildContent>
        @if (string.Equals(selectedTab, "providers", StringComparison.Ordinal))
        {
            <AgentProviderProfilesPanel />
        }
        else if (string.Equals(selectedTab, "voice", StringComparison.Ordinal))
        {
            <AgentVoiceSettingsPanel />
        }
        else if (string.Equals(selectedTab, "agents", StringComparison.Ordinal))
        {
            <AgentCatalogPanel RequestedAgentId="@effectiveRequestedAgentId"
                               RequestedTeamId="@effectiveRequestedTeamId"
                               SkipCatalogRepair="true" />
        }
        else if (string.Equals(selectedTab, "chat", StringComparison.Ordinal))
        {
            <AgentChatPanel PreferredAgentId="@effectiveRequestedAgentId" />
        }
        else if (string.Equals(selectedTab, "capabilities", StringComparison.Ordinal))
        {
            <AgentCapabilitiesPanel PreferredAgentId="@effectiveRequestedAgentId" />
        }
        else if (string.Equals(selectedTab, "governance", StringComparison.Ordinal))
        {
            <AgentGovernancePanel PreferredAgentId="@effectiveRequestedAgentId" />
        }
        else if (string.Equals(selectedTab, "scenarios", StringComparison.Ordinal))
        {
            <ScenarioHarnessPanel />
        }
        else if (string.Equals(selectedTab, "diagnostics", StringComparison.Ordinal))
        {
            <AgentDiagnosticsPanel />
        }
        else
        {
            <Stack GapScale="LayoutGap.Large"
                   data-testid="agents-overview-dashboard">
                @if (hasOverviewLoadError)
                {
                    <SurfaceCard Soft="true"
                                 data-testid="agents-overview-load-error">
                        <p class="cda-eyebrow">Overview unavailable</p>
                        <h2 class="mt-1 text-base font-semibold text-slate-950">Agent runtime summary could not be refreshed</h2>
                        <p class="mt-2 text-sm leading-6 text-slate-600">@overviewLoadError</p>
                    </SurfaceCard>
                }

                <Grid Gap="LayoutGap.Medium"
                      ColumnTemplate="repeat(auto-fit,minmax(9.5rem,1fr))"
                      data-testid="agents-overview-metrics">
                    <MetricCard Label="Agents"
                                Value="@ResolveOverviewValue(overview.Totals.AgentCount)"
                                data-testid="agents-overview-metric-agents" />
                    <MetricCard Label="Teams"
                                Value="@ResolveOverviewValue(overview.Totals.TeamCount)"
                                data-testid="agents-overview-metric-teams" />
                    <MetricCard Label="Providers"
                                Value="@ResolveOverviewValue(overview.Totals.ProviderCount)"
                                data-testid="agents-overview-metric-providers" />
                    <MetricCard Label="Capabilities"
                                Value="@ResolveOverviewValue(overview.Totals.CapabilityCount)"
                                data-testid="agents-overview-metric-capabilities" />
                    <MetricCard Label="Sessions"
                                Value="@ResolveOverviewValue(overview.Totals.SessionCount)"
                                data-testid="agents-overview-metric-sessions" />
                    <MetricCard Label="Usage observations"
                                Value="@ResolveOverviewValue(overview.Totals.UsageObservationCount)"
                                data-testid="agents-overview-metric-usage" />
                    <MetricCard Label="Tokens"
                                Value="@ResolveOverviewTokens(overview.Totals.TotalTokens)"
                                data-testid="agents-overview-metric-tokens" />
                    <MetricCard Label="Known cost"
                                Value="@ResolveOverviewCost(overview.Totals.KnownCostUsd)"
                                data-testid="agents-overview-metric-cost" />
                </Grid>

                <Grid Gap="LayoutGap.Large"
                      ColumnTemplateLg="repeat(2,minmax(0,1fr))"
                      ColumnTemplateXl="minmax(20rem,0.95fr) minmax(0,1.1fr) minmax(16rem,0.72fr) minmax(20rem,0.95fr)">
                    <SurfaceCard Soft="true"
                                 data-testid="agents-overview-top-agents">
                        <Cluster JustifyContent="JustifyContent.SpaceBetween"
                                 AlignItems="AlignItems.Start"
                                 Gap="LayoutGap.Medium"
                                 Wrap="FlexWrap.Wrap">
                            <Stack Gap="0.25rem">
                                <p class="cda-eyebrow">Most used agents</p>
                                <h2 class="text-base font-semibold text-slate-950">Top 5 by execution count</h2>
                            </Stack>
                            <StatusBadge Tone="info"
                                         Text="@(isLoaded ? $"{overview.TopAgents.Count} ranked" : "Loading")" />
                        </Cluster>

                        <AgentOverviewUsageList IsLoaded="@isLoaded"
                                                Rows="@overview.TopAgents"
                                                TestId="agents-overview-top-agents-list"
                                                EmptyDescription="Run an agent or process-backed execution to populate top-agent usage." />
                    </SurfaceCard>

                    <Stack GapScale="LayoutGap.Medium"
                           data-testid="agents-overview-provider-bar">
                        <CdaChart Title="Usage per provider"
                                  Description="Provider usage observations captured from technical executions."
                                  Series="@ProviderUsageBarSeries"
                                  Options="@ProviderUsageBarChartOptions"
                                  Height="300"
                                  class="box-border w-full max-w-full min-w-0 overflow-hidden"
                                  EmptyText="No provider usage has been recorded." />
                    </Stack>

                    <Stack GapScale="LayoutGap.Medium"
                           data-testid="agents-overview-provider-distribution">
                        <CdaChart Title="Provider distribution"
                                  Description="Share of total provider usage observations across the current workspace."
                                  Series="@ProviderUsageDistributionSeries"
                                  Options="@ProviderUsageDistributionChartOptions"
                                  Height="300"
                                  class="box-border w-full max-w-full min-w-0 overflow-hidden"
                                  EmptyText="Provider distribution is not available yet." />
                    </Stack>

                    <SurfaceCard Soft="true"
                                 data-testid="agents-overview-failing-agents">
                        <Cluster JustifyContent="JustifyContent.SpaceBetween"
                                 AlignItems="AlignItems.Start"
                                 Gap="LayoutGap.Medium"
                                 Wrap="FlexWrap.Wrap">
                            <Stack Gap="0.25rem">
                                <p class="cda-eyebrow">Most failing agents</p>
                                <h2 class="text-base font-semibold text-slate-950">Top 5 by failed runs</h2>
                            </Stack>
                            <StatusBadge Tone="danger"
                                         Text="@(isLoaded ? $"{overview.TopFailingAgents.Count} flagged" : "Loading")" />
                        </Cluster>

                        <AgentOverviewUsageList IsLoaded="@isLoaded"
                                                Rows="@overview.TopFailingAgents"
                                                ShowFailureRank="true"
                                                TestId="agents-overview-failing-agents-list"
                                                LoadingTitle="Failure ranking is loading"
                                                EmptyEyebrow="No failures"
                                                EmptyTitle="No failing agents are ranked"
                                                EmptyDescription="Recent failed executions will appear here without opening the full usage dialog." />
                    </SurfaceCard>
                </Grid>

                <Grid Gap="LayoutGap.Large"
                      ColumnTemplateLg="minmax(0,1fr) minmax(20rem,0.55fr)">
                    <SurfaceCard Soft="true"
                                 data-testid="agents-overview-team-shortcuts">
                        <Cluster JustifyContent="JustifyContent.SpaceBetween"
                                 AlignItems="AlignItems.Start"
                                 Gap="LayoutGap.Medium"
                                 Wrap="FlexWrap.Wrap">
                            <Stack Gap="0.35rem">
                                <p class="cda-eyebrow">Teams</p>
                                <h2 class="text-base font-semibold text-slate-950">Open a team-filtered agent view</h2>
                            </Stack>
                            <StatusBadge Tone="info"
                                         Text="@(isLoaded ? $"{overview.TeamShortcuts.Count} team(s)" : "Loading")" />
                        </Cluster>

                        @if (!isLoaded)
                        {
                            <EmptyState Eyebrow="Loading"
                                        Title="Teams are loading"
                                        Description="Team shortcuts appear after the catalog snapshot is available." />
                        }
                        else if (overview.TeamShortcuts.Count == 0)
                        {
                            <EmptyState Eyebrow="No teams"
                                        Title="No teams are defined"
                                        Description="Create teams on the Agents tab to enable one-click filtered shortcuts." />
                        }
                        else
                        {
                            <Grid Gap="LayoutGap.Small"
                                  ColumnsSm="2"
                                  ColumnsLg="3"
                                  ColumnsXl="6"
                                  Class="mt-4"
                                  data-testid="agents-overview-team-shortcuts-grid">
                                @foreach (var team in overview.TeamShortcuts.Take(6))
                                {
                                    <button type="button"
                                            class="flex aspect-square min-w-0 flex-col items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-2 text-center text-slate-700 shadow-sm transition hover:border-sky-300 hover:bg-sky-50 hover:text-sky-700"
                                            title="@team.Name"
                                            @onclick="@(() => OpenAgentsForTeamAsync(team.TeamId))"
                                            data-testid="agents-overview-team-shortcut">
                                        <span class="material-icons text-2xl" aria-hidden="true">@team.Icon</span>
                                        <span class="max-w-full truncate text-xs font-bold">@team.Name</span>
                                        <span class="text-[0.68rem] font-semibold text-slate-500">@($"{team.AgentCount} agent(s)")</span>
                                    </button>
                                }
                            </Grid>
                        }
                    </SurfaceCard>

                    <SurfaceCard Soft="true"
                                 data-testid="agents-overview-demand-details">
                        <Stack GapScale="LayoutGap.Medium">
                            <Stack Gap="0.25rem">
                                <p class="cda-eyebrow">Load on demand</p>
                                <h2 class="text-base font-semibold text-slate-950">Deeper usage views stay out of default load</h2>
                            </Stack>
                            <Cluster Gap="LayoutGap.Small"
                                     Wrap="FlexWrap.Wrap">
                                <Button Text="Agent usage"
                                        Icon="analytics"
                                        ButtonStyle="ButtonStyle.Light"
                                        Variant="Variant.Outlined"
                                        Click="OpenAgentUsageDialogAsync"
                                        data-testid="agents-overview-open-agent-usage" />
                                <Button Text="Provider usage"
                                        Icon="bar_chart"
                                        ButtonStyle="ButtonStyle.Light"
                                        Variant="Variant.Outlined"
                                        Click="OpenProviderUsageDialogAsync"
                                        data-testid="agents-overview-open-provider-usage" />
                                <Button Text="Model usage"
                                        Icon="query_stats"
                                        ButtonStyle="ButtonStyle.Light"
                                        Variant="Variant.Outlined"
                                        Click="OpenModelUsageDialogAsync"
                                        data-testid="agents-overview-open-model-usage" />
                            </Cluster>
                        </Stack>
                    </SurfaceCard>
                </Grid>
            </Stack>
        }
    </ChildContent>
</PageScaffold>

@if (isLoading)
{
    <SurfaceCard Soft="true" data-testid="agents-details-loading">
        <p class="cda-eyebrow">Loading agent</p>
        <h3 class="mt-1 text-lg font-semibold text-slate-950">Preparing technical editor</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">
            AgentFramework is loading the selected technical record and runtime catalogs.
        </p>
    </SurfaceCard>
}
else
{
    <EditForm Model="editorModel" OnValidSubmit="SaveAgentAsync">
        <Stack Class="agent-details-dialog min-h-0" GapScale="LayoutGap.Large">
            @if (linkedPartyId.HasValue)
            {
                <Alert AlertStyle="AlertStyle.Info">
                    <p class="font-semibold">Bound CRM-HR resource</p>
                    <p class="mt-1">This technical agent is linked to business resource <a class="text-slate-900 underline" href="@($"/crm-hr/agents?partyId={linkedPartyId.Value:D}")">/crm-hr/agents</a>.</p>
                </Alert>
            }

            <Tabs data-testid="agents-details-tabs"
                  SelectedIndex="@selectedTabIndex"
                  SelectedIndexChanged="HandleSelectedTabIndexChanged"
                  Variant="@(TabsVariant.ModalCompact)"
                  BorderMode="@(TabsBorderMode.Soft)"
                  Tone="@(TabsTone.Info)"
                  OverflowMode="@(TabsOverflowMode.Scroll)"
                  PanelOverflowMode="@(TabsPanelOverflowMode.Auto)"
                  FillHeight="true"
                  Class="agent-details-dialog__tabs w-full min-w-0 flex-1 min-h-0"
                  AriaLabel="Agent details sections">
                <TabItems>
                    <TabsItem Text="Identity">
                        <FormSection Title="Identity" Description="Keep the technical identity explicit and strongly typed. Business metadata stays in CRM-HR; runtime behavior lives here.">
                            <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                <div>
                                    <label class="cda-field-label">Name</label>
                                    <InputText @bind-Value="editorModel.Name" class="cda-input" data-testid="agents-catalog-name" />
                                </div>
                                <div>
                                    <label class="cda-field-label">Role title</label>
                                    <InputText @bind-Value="editorModel.RoleTitle" class="cda-input" data-testid="agents-catalog-role" />
                                </div>
                            </Grid>

                            <div class="agent-details-dialog__full-field">
                                <label class="cda-field-label">Summary</label>
                                <InputTextArea @bind-Value="editorModel.Summary"
                                               class="cda-input cda-input--textarea agent-details-dialog__summary-textarea"
                                               data-testid="agents-catalog-summary" />
                            </div>

                            <div class="agent-details-dialog__full-field">
                                <label class="cda-field-label">Instructions</label>
                                <InputTextArea @bind-Value="editorModel.Instructions"
                                               class="cda-input cda-input--textarea agent-details-dialog__instructions-textarea"
                                               data-testid="agents-catalog-instructions" />
                            </div>
                        </FormSection>
                    </TabsItem>

                    <TabsItem Text="Runtime">
                        <FormSection Title="Runtime" Description="Pick the provider and model that the imported AgentFramework runtime will actually execute.">
                            <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                <div>
                                    <label class="cda-field-label">Provider</label>
                                    <InputSelect @bind-Value="editorModel.ProviderProfileId"
                                                 class="cda-input"
                                                 disabled="@(!areProvidersLoaded && string.IsNullOrWhiteSpace(providerLoadErrorMessage))"
                                                 data-testid="agents-catalog-provider">
                                        <option value="">None</option>
                                        @foreach (var provider in providers)
                                        {
                                            <option value="@provider.Id">@provider.Name</option>
                                        }
                                    </InputSelect>
                                    @if (!areProvidersLoaded &&
                                         string.IsNullOrWhiteSpace(providerLoadErrorMessage))
                                    {
                                        <p class="mt-2 text-sm leading-6 text-slate-500">Loading providers for runtime binding...</p>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(providerLoadErrorMessage))
                                    {
                                        <p class="mt-2 text-sm leading-6 text-rose-700">@providerLoadErrorMessage</p>
                                    }
                                </div>
                                <div>
                                    <label class="cda-field-label">Model</label>
                                    <InputText @bind-Value="editorModel.Model" class="cda-input" data-testid="agents-catalog-model" />
                                </div>
                            </Grid>

                            <Grid Gap="LayoutGap.Large" ColumnsMd="3">
                                <div>
                                    <label class="cda-field-label">Status</label>
                                    <InputSelect @bind-Value="editorModel.Status" class="cda-input">
                                        @foreach (var status in Enum.GetValues<AgentLifecycleStatus>())
                                        {
                                            <option value="@status">@status</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div>
                                    <label class="cda-field-label">Workload</label>
                                    <InputSelect @bind-Value="editorModel.Workload" class="cda-input">
                                        @foreach (var workload in Enum.GetValues<AgentWorkloadKind>())
                                        {
                                            <option value="@workload">@workload</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div>
                                    <label class="cda-field-label">Chat history</label>
                                    <InputSelect @bind-Value="editorModel.ChatHistoryMode" class="cda-input">
                                        @foreach (var mode in Enum.GetValues<AgentChatHistoryMode>())
                                        {
                                            <option value="@mode">@mode</option>
                                        }
                                    </InputSelect>
                                </div>
                            </Grid>

                            @if (SelectedRuntimeProvider is { } runtimeProvider)
                            {
                                <Alert AlertStyle="AlertStyle.Info">
                                    <p class="font-semibold">Runtime parameter policy</p>
                                    <p class="mt-1">@DescribeRuntimeParameterPolicy(runtimeProvider)</p>
                                </Alert>
                            }
                        </FormSection>
                    </TabsItem>

                    <TabsItem Text="Project Structure Access">
                        <FormSection Title="Project Structure Access" Description="Internal agents always carry the project-structure tool family. These settings decide whether the current agent can read or mutate project data and which projects it may touch.">
                            <Grid Gap="LayoutGap.Large" ColumnsMd="3" data-testid="agents-catalog-project-structure-access">
                                <div class="cda-admin-subpanel">
                                    <p class="cda-field-label mb-2">Access mode</p>
                                    <Stack GapScale="LayoutGap.Small">
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.ProjectStructureAccess.CanRead"
                                                   @onchange="args => ToggleProjectStructureRead(args.Value)"
                                                   data-testid="agents-catalog-project-structure-read" />
                                            Can read project structure
                                        </label>
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.ProjectStructureAccess.CanWrite"
                                                   @onchange="args => ToggleProjectStructureWrite(args.Value)"
                                                   data-testid="agents-catalog-project-structure-write" />
                                            Can write project structure
                                        </label>
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.ProjectStructureAccess.AllowAllProjects"
                                                   @onchange="args => ToggleProjectStructureAllowAll(args.Value)"
                                                   data-testid="agents-catalog-project-structure-all" />
                                            Allow all current and future projects
                                        </label>
                                    </Stack>
                                </div>
                                <div class="cda-admin-subpanel md:col-span-2">
                                    <Split Breakpoint="LayoutBreakpoint.Md"
                                           Gap="LayoutGap.Medium"
                                           AlignItems="AlignItems.Center"
                                           JustifyContent="JustifyContent.SpaceBetween"
                                           Wrap="FlexWrap.Wrap">
                                        <div>
                                            <p class="cda-field-label mb-1">Allowed projects</p>
                                            <p class="text-sm leading-6 text-slate-600">
                                                @DescribeProjectStructureScope(editorModel)
                                            </p>
                                        </div>
                                        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                            <Button Text="Select all"
                                                    ButtonStyle="ButtonStyle.Light"
                                                    Size="ButtonSize.Small"
                                                    Click="SelectAllProjectStructureProjects"
                                                    Disabled="@(!areProjectStructureProjectsLoaded || isLoadingProjectStructureProjects || !string.IsNullOrWhiteSpace(projectStructureProjectsErrorMessage) || editorModel.ProjectStructureAccess.AllowAllProjects)" />
                                            <Button Text="Clear"
                                                    ButtonStyle="ButtonStyle.Light"
                                                    Size="ButtonSize.Small"
                                                    Click="ClearProjectStructureProjects"
                                                    Disabled="@(!areProjectStructureProjectsLoaded || isLoadingProjectStructureProjects || !string.IsNullOrWhiteSpace(projectStructureProjectsErrorMessage) || editorModel.ProjectStructureAccess.AllowAllProjects)" />
                                        </Cluster>
                                    </Split>

                                    @if (editorModel.ProjectStructureAccess.AllowAllProjects)
                                    {
                                        <div class="mt-3 cda-admin-empty">
                                            This agent can access all current and future projects. Turn off the all-projects option to manage a specific allowlist.
                                        </div>
                                    }
                                    else if (!projectStructureProjectsRequested)
                                    {
                                        <div class="mt-3 cda-admin-empty">
                                            Load the project list only when you need to inspect or change the access scope.
                                        </div>
                                        <Cluster Gap="LayoutGap.Small"
                                                 Wrap="FlexWrap.Wrap"
                                                 Class="mt-3">
                                            <Button Text="Load project list"
                                                    ButtonStyle="ButtonStyle.Light"
                                                    Size="ButtonSize.Small"
                                                    Click="RequestProjectStructureProjectsAsync"
                                                    Disabled="@isLoadingProjectStructureProjects"
                                                    IsBusy="@isLoadingProjectStructureProjects"
                                                    data-testid="agents-catalog-project-structure-load" />
                                        </Cluster>
                                    }
                                    else if (!areProjectStructureProjectsLoaded &&
                                             string.IsNullOrWhiteSpace(projectStructureProjectsErrorMessage))
                                    {
                                        <div class="mt-3 cda-admin-empty">
                                            Loading projects that can be granted to this agent...
                                        </div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(projectStructureProjectsErrorMessage))
                                    {
                                        <div class="mt-3 cda-admin-empty text-rose-700">
                                            @projectStructureProjectsErrorMessage
                                        </div>
                                        <Cluster Gap="LayoutGap.Small"
                                                 Wrap="FlexWrap.Wrap"
                                                 Class="mt-3">
                                            <Button Text="Retry project list"
                                                    ButtonStyle="ButtonStyle.Light"
                                                    Size="ButtonSize.Small"
                                                    Click="RequestProjectStructureProjectsAsync"
                                                    Disabled="@isLoadingProjectStructureProjects"
                                                    IsBusy="@isLoadingProjectStructureProjects" />
                                        </Cluster>
                                    }
                                    else if (projectStructureProjects.Count == 0)
                                    {
                                        <div class="mt-3 cda-admin-empty">
                                            No projects exist yet. Create a project before granting project-structure access.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mt-3 max-h-64 overflow-y-auto rounded-2xl border border-slate-200 bg-white p-4"
                                             data-testid="agents-catalog-project-structure-projects">
                                            <Stack GapScale="LayoutGap.Small">
                                                @foreach (var project in projectStructureProjects)
                                                {
                                                    <label class="cda-inline-option cda-inline-option--muted">
                                                        <input type="checkbox"
                                                               checked="@HasProjectStructureProjectAccess(project.Id)"
                                                               @onchange="args => ToggleProjectStructureProject(project.Id, args.Value)" />
                                                        @project.Name
                                                    </label>
                                                }
                                            </Stack>
                                        </div>
                                    }
                                </div>
                            </Grid>
                        </FormSection>
                    </TabsItem>

                    <TabsItem Text="Workspace Tools">
                        <FormSection Title="Workspace Tools" Description="These settings decide whether the current agent receives native workspace file tools, external workspace roots, and storage-driver tools.">
                            <Grid Gap="LayoutGap.Large" ColumnsMd="3" data-testid="agents-catalog-workspace-tools">
                                <div class="cda-admin-subpanel">
                                    <p class="cda-field-label mb-2">File access</p>
                                    <Stack GapScale="LayoutGap.Small">
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.WorkspaceToolAccess.CanReadFiles"
                                                   @onchange="args => ToggleWorkspaceFileRead(args.Value)"
                                                   data-testid="agents-catalog-workspace-read" />
                                            Can browse and read files
                                        </label>
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.WorkspaceToolAccess.CanWriteFiles"
                                                   @onchange="args => ToggleWorkspaceFileWrite(args.Value)"
                                                   data-testid="agents-catalog-workspace-write" />
                                            Can write files and run build tools
                                        </label>
                                    </Stack>
                                    <p class="mt-3 text-sm leading-6 text-slate-600">
                                        @DescribeWorkspaceFileScope(editorModel)
                                    </p>
                                </div>
                                <div class="cda-admin-subpanel md:col-span-2">
                                    <label class="cda-field-label">External workspace roots</label>
                                    <InputTextArea @bind-Value="externalWorkspaceRootsText"
                                                   class="cda-input cda-input--textarea mt-2 min-h-28"
                                                   placeholder="C:\repositories\OtherRepo&#10;external-target/D/work/repos/demo"
                                                   data-testid="agents-catalog-workspace-external-roots" />
                                    <p class="mt-2 text-sm leading-6 text-slate-600">
                                        Add persistent roots here when needed. Absolute folders mentioned in a prompt are also grounded for that run when file tools are enabled.
                                    </p>
                                </div>
                                <div class="cda-admin-subpanel">
                                    <p class="cda-field-label mb-2">Storage access</p>
                                    <Stack GapScale="LayoutGap.Small">
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.WorkspaceToolAccess.CanReadStorage"
                                                   @onchange="args => ToggleStorageRead(args.Value)"
                                                   data-testid="agents-catalog-storage-read" />
                                            Can read storage driver catalogs
                                        </label>
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.WorkspaceToolAccess.CanWriteStorage"
                                                   @onchange="args => ToggleStorageWrite(args.Value)"
                                                   data-testid="agents-catalog-storage-write" />
                                            Can write storage driver objects
                                        </label>
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.WorkspaceToolAccess.AllowAllStorageCatalogs"
                                                   @onchange="args => ToggleStorageAllowAll(args.Value)"
                                                   data-testid="agents-catalog-storage-all" />
                                            Allow all storage catalogs
                                        </label>
                                    </Stack>
                                    <p class="mt-3 text-sm leading-6 text-slate-600">
                                        @DescribeStorageScope(editorModel)
                                    </p>
                                </div>
                                <div class="cda-admin-subpanel md:col-span-2">
                                    <label class="cda-field-label">Allowed storage catalog IDs</label>
                                    <InputTextArea @bind-Value="allowedStorageCatalogIdsText"
                                                   class="cda-input cda-input--textarea mt-2 min-h-28"
                                                   disabled="@editorModel.WorkspaceToolAccess.AllowAllStorageCatalogs"
                                                   placeholder="00000000-0000-0000-0000-000000000000"
                                                   data-testid="agents-catalog-storage-ids" />
                                    <p class="mt-2 text-sm leading-6 text-slate-600">
                                        Use one catalog ID per line when the all-storage option is off. Write permission is still blocked for read-only catalogs.
                                    </p>
                                </div>
                            </Grid>
                        </FormSection>
                    </TabsItem>

                    <TabsItem Text="Secrets">
                        <FormSection Title="Secrets" Description="Grant only the stored secrets this agent may request during explicit runtime actions. Values are not stored in the agent definition.">
                            <Grid Gap="LayoutGap.Large" ColumnsMd="3" data-testid="agents-catalog-secrets">
                                <div class="cda-admin-subpanel">
                                    <p class="cda-field-label mb-2">Allowed secrets</p>
                                    <p class="text-sm leading-6 text-slate-600">
                                        @DescribeSecretScope(editorModel)
                                    </p>
                                </div>
                                <div class="cda-admin-subpanel md:col-span-2">
                                    @if (isLoadingSecrets && !areSecretsLoaded)
                                    {
                                        <div class="cda-admin-empty">
                                            Loading stored secrets...
                                        </div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(secretsErrorMessage))
                                    {
                                        <div class="cda-admin-empty text-rose-700">
                                            @secretsErrorMessage
                                        </div>
                                    }
                                    else if (secrets.Count == 0)
                                    {
                                        <div class="cda-admin-empty">
                                            No stored secrets exist yet.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="max-h-64 overflow-y-auto rounded-2xl border border-slate-200 bg-white p-4"
                                             data-testid="agents-catalog-secret-list">
                                            <Stack GapScale="LayoutGap.Small">
                                                @foreach (var secret in secrets)
                                                {
                                                    <label class="cda-inline-option cda-inline-option--muted">
                                                        <input type="checkbox"
                                                               checked="@HasAllowedSecret(secret.Id)"
                                                               @onchange="args => ToggleAllowedSecret(secret, args.Value)" />
                                                        @secret.Name
                                                        <span class="text-slate-500">(@secret.Kind)</span>
                                                    </label>
                                                }
                                            </Stack>
                                        </div>
                                    }
                                </div>
                            </Grid>
                        </FormSection>
                    </TabsItem>

                    <TabsItem Text="Process Access">
                        <FormSection Title="Process Access" Description="Internal agents always carry the process-module tool family. These settings decide whether the current agent can read or mutate process data and which process definitions it may touch.">
                            <Grid Gap="LayoutGap.Large" ColumnsMd="3" data-testid="agents-catalog-process-access">
                                <div class="cda-admin-subpanel">
                                    <p class="cda-field-label mb-2">Access mode</p>
                                    <Stack GapScale="LayoutGap.Small">
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.ProcessAccess.CanRead"
                                                   @onchange="args => ToggleProcessRead(args.Value)"
                                                   data-testid="agents-catalog-process-read" />
                                            Can read processes
                                        </label>
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.ProcessAccess.CanWrite"
                                                   @onchange="args => ToggleProcessWrite(args.Value)"
                                                   data-testid="agents-catalog-process-write" />
                                            Can write processes
                                        </label>
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.ProcessAccess.AllowAllDefinitions"
                                                   @onchange="args => ToggleProcessAllowAll(args.Value)"
                                                   data-testid="agents-catalog-process-all" />
                                            Allow all current and future processes
                                        </label>
                                    </Stack>
                                </div>
                                <div class="cda-admin-subpanel md:col-span-2">
                                    <Split Breakpoint="LayoutBreakpoint.Md"
                                           Gap="LayoutGap.Medium"
                                           AlignItems="AlignItems.Center"
                                           JustifyContent="JustifyContent.SpaceBetween"
                                           Wrap="FlexWrap.Wrap">
                                        <div>
                                            <p class="cda-field-label mb-1">Allowed processes</p>
                                            <p class="text-sm leading-6 text-slate-600">
                                                @DescribeProcessScope(editorModel)
                                            </p>
                                        </div>
                                        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                            <Button Text="Select all"
                                                    ButtonStyle="ButtonStyle.Light"
                                                    Size="ButtonSize.Small"
                                                    Click="SelectAllProcesses"
                                                    Disabled="@(!areProcessDefinitionsLoaded || isLoadingProcessDefinitions || !string.IsNullOrWhiteSpace(processDefinitionsErrorMessage) || editorModel.ProcessAccess.AllowAllDefinitions)" />
                                            <Button Text="Clear"
                                                    ButtonStyle="ButtonStyle.Light"
                                                    Size="ButtonSize.Small"
                                                    Click="ClearProcesses"
                                                    Disabled="@(!areProcessDefinitionsLoaded || isLoadingProcessDefinitions || !string.IsNullOrWhiteSpace(processDefinitionsErrorMessage) || editorModel.ProcessAccess.AllowAllDefinitions)" />
                                        </Cluster>
                                    </Split>

                                    @if (editorModel.ProcessAccess.AllowAllDefinitions)
                                    {
                                        <div class="mt-3 cda-admin-empty">
                                            This agent can access all current and future processes. Turn off the all-processes option to manage a specific allowlist.
                                        </div>
                                    }
                                    else if (!processDefinitionsRequested)
                                    {
                                        <div class="mt-3 cda-admin-empty">
                                            Load the process list only when you need to inspect or change the access scope.
                                        </div>
                                        <Cluster Gap="LayoutGap.Small"
                                                 Wrap="FlexWrap.Wrap"
                                                 Class="mt-3">
                                            <Button Text="Load process list"
                                                    ButtonStyle="ButtonStyle.Light"
                                                    Size="ButtonSize.Small"
                                                    Click="RequestProcessDefinitionsAsync"
                                                    Disabled="@isLoadingProcessDefinitions"
                                                    IsBusy="@isLoadingProcessDefinitions"
                                                    data-testid="agents-catalog-process-load" />
                                        </Cluster>
                                    }
                                    else if (!areProcessDefinitionsLoaded &&
                                             string.IsNullOrWhiteSpace(processDefinitionsErrorMessage))
                                    {
                                        <div class="mt-3 cda-admin-empty">
                                            Loading process definitions that can be granted to this agent...
                                        </div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(processDefinitionsErrorMessage))
                                    {
                                        <div class="mt-3 cda-admin-empty text-rose-700">
                                            @processDefinitionsErrorMessage
                                        </div>
                                        <Cluster Gap="LayoutGap.Small"
                                                 Wrap="FlexWrap.Wrap"
                                                 Class="mt-3">
                                            <Button Text="Retry process list"
                                                    ButtonStyle="ButtonStyle.Light"
                                                    Size="ButtonSize.Small"
                                                    Click="RequestProcessDefinitionsAsync"
                                                    Disabled="@isLoadingProcessDefinitions"
                                                    IsBusy="@isLoadingProcessDefinitions" />
                                        </Cluster>
                                    }
                                    else if (processDefinitions.Count == 0)
                                    {
                                        <div class="mt-3 cda-admin-empty">
                                            No process definitions exist yet. Create a process before granting process access.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mt-3 max-h-64 overflow-y-auto rounded-2xl border border-slate-200 bg-white p-4"
                                             data-testid="agents-catalog-processes">
                                            <Stack GapScale="LayoutGap.Small">
                                                @foreach (var definition in processDefinitions)
                                                {
                                                    <label class="cda-inline-option cda-inline-option--muted">
                                                        <input type="checkbox"
                                                               checked="@HasProcessAccess(definition.Id)"
                                                               @onchange="args => ToggleProcess(definition.Id, args.Value)" />
                                                        @definition.Name
                                                        @if (!string.IsNullOrWhiteSpace(definition.ProjectName))
                                                        {
                                                            <span class="text-slate-500">(@definition.ProjectName)</span>
                                                        }
                                                    </label>
                                                }
                                            </Stack>
                                        </div>
                                    }
                                </div>
                            </Grid>
                        </FormSection>
                    </TabsItem>

                    <TabsItem Text="Skills and MCP">
                        <FormSection Title="Skills and MCP" Description="Attach cataloged skills and MCP servers to this agent, or create a compact capability entry and assign it immediately.">
                            <div data-testid="agents-details-capability-summary">
                                <SummaryTiles GapScale="LayoutGap.Small"
                                              ColumnsMd="4">
                                    <SummaryTile Label="Attached"
                                                 Value="@editorModel.SelectedCapabilityIds.Count.ToString()"
                                                 HelperText="Capabilities currently assigned to this agent."
                                                 Tone="info"
                                                 Badge="true"
                                                 Compact="true" />
                                    <SummaryTile Label="Skills"
                                                 Value="@capabilities.Count(item => item.Kind == CapabilityKind.Skill).ToString()"
                                                 HelperText="Prompt and workflow skills in the catalog."
                                                 Tone="success"
                                                 Badge="true"
                                                 Compact="true" />
                                    <SummaryTile Label="MCP servers"
                                                 Value="@capabilities.Count(item => item.Kind == CapabilityKind.McpServer).ToString()"
                                                 HelperText="MCP tool surfaces in the catalog."
                                                 Tone="warning"
                                                 Badge="true"
                                                 Compact="true" />
                                    <SummaryTile Label="Verified"
                                                 Value="@capabilities.Count(item => item.ProofStatus == CapabilityProofStatus.Verified).ToString()"
                                                 HelperText="Capabilities with successful proof status."
                                                 Tone="mint"
                                                 Badge="true"
                                                 Compact="true" />
                                </SummaryTiles>
                            </div>

                            <div class="agent-details-dialog__new-capability"
                                 data-testid="agents-details-new-capability">
                                <Grid Gap="LayoutGap.Medium" ColumnsLg="4">
                                    <div>
                                        <label class="cda-field-label">Kind</label>
                                        <InputSelect @bind-Value="newCapabilityKind" class="cda-input">
                                            <option value="@CapabilityKind.Skill">Skill</option>
                                            <option value="@CapabilityKind.McpServer">MCP server</option>
                                        </InputSelect>
                                    </div>
                                    <div>
                                        <label class="cda-field-label">Name</label>
                                        <InputText @bind-Value="newCapabilityName" class="cda-input" data-testid="agents-details-new-capability-name" />
                                    </div>
                                    <div class="lg:col-span-2">
                                        <label class="cda-field-label">Endpoint or path</label>
                                        <InputText @bind-Value="newCapabilityEndpointOrPath" class="cda-input" data-testid="agents-details-new-capability-path" />
                                    </div>
                                </Grid>
                                <div class="mt-3">
                                    <label class="cda-field-label">Description</label>
                                    <InputTextArea @bind-Value="newCapabilityDescription"
                                                   class="cda-input cda-input--textarea min-h-20"
                                                   data-testid="agents-details-new-capability-description" />
                                </div>
                                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap" Class="mt-3">
                                    <Button Text="Create and assign"
                                            ButtonStyle="ButtonStyle.Light"
                                            Disabled="@isBusy"
                                            IsBusy="@isBusy"
                                            Click="CreateAndAssignCapabilityAsync"
                                            data-testid="agents-details-create-capability" />
                                </Cluster>
                            </div>

                            @if (AssignableCapabilities.Count == 0)
                            {
                                <EmptyState Eyebrow="No capabilities"
                                            Title="No skills or MCP servers are cataloged yet"
                                            Description="Create a compact capability entry above, or add capabilities from the dedicated Capabilities tab." />
                            }
                            else
                            {
                                <Stack GapScale="LayoutGap.Medium" data-testid="agents-details-capability-list">
                                    @foreach (var capability in AssignableCapabilities)
                                    {
                                        var isAttached = IsCapabilityAttached(capability.Id);
                                        <SurfaceCard Soft="true">
                                            <Split Gap="LayoutGap.Medium">
                                                <div class="min-w-0">
                                                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                                        <StatusBadge Tone="info" Text="@ResolveCapabilityKindLabel(capability.Kind)" />
                                                        <StatusBadge Tone="@ResolveProofTone(capability.ProofStatus)"
                                                                     Text="@ResolveProofLabel(capability.ProofStatus)" />
                                                        <StatusBadge Tone="@(isAttached ? "success" : "neutral")"
                                                                     Text="@(isAttached ? "Attached" : "Available")" />
                                                    </Cluster>
                                                    <h3 class="mt-3 text-lg font-semibold text-slate-950">@capability.Name</h3>
                                                    @if (!string.IsNullOrWhiteSpace(capability.Description))
                                                    {
                                                        <p class="mt-2 text-sm leading-6 text-slate-600">@capability.Description</p>
                                                    }
                                                    <p class="mt-3 text-xs uppercase tracking-[0.18em] text-slate-500">Path or endpoint</p>
                                                    <p class="mt-2 text-sm leading-6 text-slate-700"
                                                       style="overflow-wrap:anywhere;">@ResolveEndpointSummary(capability)</p>
                                                </div>
                                                <Stack GapScale="LayoutGap.Small">
                                                    <Button Text="@(isAttached ? "Remove" : "Assign")"
                                                            ButtonStyle="@(isAttached ? ButtonStyle.Light : ButtonStyle.Primary)"
                                                            Disabled="@isBusy"
                                                            Click="@(async () => await ToggleCapabilityAsync(capability.Id))"
                                                            data-testid="agents-details-toggle-capability" />
                                                    <Button Text="Verify"
                                                            ButtonStyle="ButtonStyle.Light"
                                                            Disabled="@(!isAttached || isBusy || !editorModel.Id.HasValue)"
                                                            Click="@(async () => await VerifyCapabilityAsync(capability.Id))" />
                                                </Stack>
                                            </Split>
                                        </SurfaceCard>
                                    }
                                </Stack>
                            }
                        </FormSection>
                    </TabsItem>

                    <TabsItem Text="Tags">
                        <FormSection Title="Tags" Description="Tags keep ownership and routing visible without introducing a second registry.">
                            <TagEditor Value="@tagValues"
                                       ValueChanged="HandleTagsChangedAsync"
                                       Suggestions="@VisibleTagSuggestions"
                                       Placeholder="Add agent tag"
                                       Hint="Use Enter or comma to add tags. Favorites are managed with the star action in Switch Agent."
                                       MaxTags="12"
                                       TestId="agents-catalog-tags"
                                       InputTestId="agents-catalog-tags-input" />
                        </FormSection>
                    </TabsItem>
                </TabItems>
            </Tabs>

            <StickyActionFooter StatusLabel="Technical agents">
                <SecondaryActions>
                    <Button Text="Clear" ButtonStyle="ButtonStyle.Light" Click="ResetAgentAsync" />
                </SecondaryActions>
                <PrimaryActions>
                    <Button Text="Save agent" Type="submit" Disabled="@isBusy" IsBusy="@isBusy" data-testid="agents-catalog-save" />
                </PrimaryActions>
                <DangerActions>
                    @if (editorModel.Id.HasValue)
                    {
                        <Button Text="Delete" ButtonStyle="ButtonStyle.Danger" Disabled="@isBusy" Click="DeleteAgentAsync" />
                    }
                </DangerActions>
            </StickyActionFooter>
        </Stack>
    </EditForm>
}

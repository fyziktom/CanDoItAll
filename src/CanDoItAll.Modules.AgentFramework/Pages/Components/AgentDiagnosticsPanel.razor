<Stack GapScale="LayoutGap.Large"
       data-testid="agents-diagnostics-panel">
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <SurfaceCard Soft="true">
            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                <StatusBadge Tone="@messageTone" Text="@messageLabel" />
                <TextBlock TextStyle="TextStyle.Body2" Value="@message" />
            </Cluster>
        </SurfaceCard>
    }

    <Split Gap="LayoutGap.Small">
        <div>
            <TextBlock TextStyle="TextStyle.Subtitle2" Value="Runtime diagnostics" />
            <TextBlock TextStyle="TextStyle.Body2" Value="This surface summarizes the integrated runtime health, execution boundary, and recent failures without dropping back to sandbox-only terminology." />
        </div>
        <Button Text="Refresh"
                ButtonStyle="ButtonStyle.Light"
                Size="ButtonSize.Small"
                Disabled="@isBusy"
                Click="RefreshAsync" />
    </Split>

    <SummaryTiles GapScale="LayoutGap.Small"
                  ColumnsMd="4">
        <SummaryTile Label="Agents"
                     Value="@dashboard.AgentCount.ToString()"
                     HelperText="@($"{dashboard.TemplateCount} template(s)")"
                     Tone="info"
                     Badge="true"
                     Compact="true" />
        <SummaryTile Label="Providers"
                     Value="@dashboard.ProviderCount.ToString()"
                     HelperText="Integrated provider runtime views."
                     Tone="success"
                     Badge="true"
                     Compact="true" />
        <SummaryTile Label="Capabilities"
                     Value="@dashboard.CapabilityCount.ToString()"
                     HelperText="Skills, MCP servers, and other attached runtime surfaces."
                     Tone="warning"
                     Badge="true"
                     Compact="true" />
        <SummaryTile Label="Runs"
                     Value="@($"{dashboard.ActiveRuns} / {dashboard.FailedRuns}")"
                     HelperText="Active / failed execution runs."
                     Tone="danger"
                     Badge="true"
                     Compact="true" />
    </SummaryTiles>

    <Grid Gap="LayoutGap.Large"
          ColumnTemplateXl="minmax(0,1fr) minmax(0,1fr)">
        <SurfaceCard>
            <p class="cda-eyebrow">Execution boundary</p>
            <h3 class="mt-1 text-lg font-semibold text-slate-950">@dashboard.ToolExecutionBoundary.HostLabel</h3>
            <Stack GapScale="LayoutGap.Small" Class="mt-4">
                <SelectionListItem Title="Mode"
                                   Eyebrow="Boundary"
                                   Summary="@dashboard.ToolExecutionBoundary.Mode" />
                <SelectionListItem Title="Filesystem"
                                   Eyebrow="Scope"
                                   Summary="@dashboard.ToolExecutionBoundary.FilesystemScope" />
                <SelectionListItem Title="Network"
                                   Eyebrow="Scope"
                                   Summary="@dashboard.ToolExecutionBoundary.NetworkScope" />
                <SelectionListItem Title="Credentials"
                                   Eyebrow="Scope"
                                   Summary="@dashboard.ToolExecutionBoundary.CredentialScope" />
            </Stack>
            <p class="mt-4 text-sm leading-6 text-slate-600">@dashboard.ToolExecutionBoundary.Notes</p>
        </SurfaceCard>

        <SurfaceCard Soft="true">
            <p class="cda-eyebrow">Recent failures</p>
            @if (recentFailures.Count == 0)
            {
                <p class="mt-3 text-sm leading-6 text-slate-600">No failed execution runs are currently visible in the latest diagnostics window.</p>
            }
            else
            {
                <Stack GapScale="LayoutGap.Small" Class="mt-3">
                    @foreach (var run in recentFailures)
                    {
                        <SelectionListItem Title="@run.Title"
                                           Eyebrow="@ResolveRunOwner(run)"
                                           Meta="@run.UpdatedAtUtc.LocalDateTime.ToString("g")"
                                           Summary="@run.ResultSummary">
                            <Status>
                                <StatusBadge Tone="danger"
                                             Text="@((run.Outcome ?? RunOutcome.Failed).ToString())" />
                            </Status>
                        </SelectionListItem>
                    }
                </Stack>
            }
        </SurfaceCard>
    </Grid>

    <SurfaceCard Soft="true">
        <p class="cda-eyebrow">Recent execution activity</p>
        @if (recentRuns.Count == 0)
        {
            <p class="mt-3 text-sm leading-6 text-slate-600">No execution runs have been recorded yet.</p>
        }
        else
        {
            <Stack GapScale="LayoutGap.Small" Class="mt-3">
                @foreach (var run in recentRuns)
                {
                    <SelectionListItem Title="@run.Title"
                                       Eyebrow="@ResolveRunOwner(run)"
                                       Meta="@run.UpdatedAtUtc.LocalDateTime.ToString("g")"
                                       Summary="@ResolveRunSummary(run)">
                        <Status>
                            <Cluster Gap="LayoutGap.Small">
                                <StatusBadge Tone="@ResolveRunTone(run)"
                                             Text="@run.State.ToString()" />
                                @if (run.Outcome.HasValue)
                                {
                                    <StatusBadge Tone="neutral" Text="@run.Outcome.Value.ToString()" />
                                }
                            </Cluster>
                        </Status>
                    </SelectionListItem>
                }
            </Stack>
        }
    </SurfaceCard>
</Stack>

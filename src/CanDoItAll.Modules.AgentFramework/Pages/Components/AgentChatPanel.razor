<div class="agents-chat-panel-shell"
     data-testid="agents-chat-panel">
<Stack GapScale="LayoutGap.Large"
       AlignItems="AlignItems.Stretch"
       Class="flex-1 min-h-0 w-full">
    <Grid Gap="LayoutGap.Large"
          Class="agents-chat-grid flex-1 min-h-0 overflow-hidden"
          ColumnTemplateXl="minmax(18rem,0.58fr) minmax(0,1.8fr)">
        <WorkspacePanel Class="agents-chat-left-rail h-full min-h-0 overflow-hidden">
            <div class="border-b border-slate-200 pb-4">
                <Split Gap="LayoutGap.Small">
                    <div>
                        <Cluster Gap="LayoutGap.Small"
                                 Wrap="FlexWrap.NoWrap">
                            <TextBlock TextStyle="TextStyle.Subtitle2" Value="Agent threads" />
                            <HelpPopover RootClass="pf-help-popover inline-flex items-center"
                                         ToggleClass="pf-help-popover__toggle pf-help-popover__toggle--compact"
                                         OpenOnHover="true"
                                         AriaLabel="Show agent thread help"
                                         Title="Show agent thread help"
                                         Heading="Agent threads"
                                         Body="@AgentThreadsHelpText" />
                        </Cluster>
                        @if (selectedAgent is not null)
                        {
                            <div class="agents-chat-agent-context mt-2"
                                 data-testid="agent-thread-selected-agent">
                                <Avatar Alt="@selectedAgent.Name"
                                        ImageUrl="@selectedAgent.AvatarImageUrl"
                                        FallbackText="@ResolveAgentInitials(selectedAgent)"
                                        DefaultImageSeed="@selectedAgent.Name"
                                        Size="AvatarSize.Small"
                                        Shape="AvatarShape.Rounded" />
                                <span class="min-w-0 truncate text-xs font-semibold text-slate-700">Selected agent: @selectedAgent.Name</span>
                            </div>
                        }
                    </div>
                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                        <Button Icon="cloud_sync"
                                Text="Switch Agent"
                                ButtonStyle="ButtonStyle.Light"
                                Size="ButtonSize.Small"
                                Disabled="@(isBusy || agents.Count == 0)"
                                Click="OpenAgentSwitchDialogAsync"
                                data-testid="agent-switch-button" />
                        <Button Text="Refresh"
                                ButtonStyle="ButtonStyle.Light"
                                Size="ButtonSize.Small"
                                Disabled="@isBusy"
                                Click="RefreshAsync" />
                        <Button Text="New thread"
                                Size="ButtonSize.Small"
                                Disabled="@(isBusy || selectedAgentId is null)"
                                Click="CreateThreadAsync" />
                    </Cluster>
                </Split>
            </div>

            <div class="agents-chat-left-scroll mt-4 min-h-0 flex-1 overflow-y-auto pr-1"
                 style="scrollbar-gutter:stable;">
                @if (agents.Count == 0)
                {
                    <EmptyState Eyebrow="No agents"
                                Title="Create a technical agent first"
                                Description="Chat is only available after a technical agent exists and is bound to a provider." />
                }
                else
                {
                    <Stack GapScale="LayoutGap.Medium">
                        <TextBox Value="@threadSearchText"
                                 ValueChanged="HandleThreadSearchChangedAsync"
                                 Placeholder="Search threads"
                                 Immediate="true"
                                 Class="agents-chat-thread-search"
                                 aria-label="Search agent threads"
                                 data-testid="agent-thread-search" />

                        <SurfaceCard Soft="true">
                            <Stack GapScale="LayoutGap.Small">
                                <Split Gap="LayoutGap.Small">
                                    <TextBlock TextStyle="TextStyle.Eyebrow" Value="Threads" />
                                    @if (workspace is not null)
                                    {
                                        <StatusBadge Tone="info" Text="@($"{FilteredSessions.Count} of {workspace.Sessions.Count}")" />
                                    }
                                </Split>

                                @if (FilteredSessions.Count > 0)
                                {
                                    @foreach (var session in FilteredSessions)
                                    {
                                        <button type="button"
                                                class="agents-chat-thread-card @(selectedSessionId == session.Id ? "agents-chat-thread-card--selected" : string.Empty)"
                                                @onclick="@(() => SelectSessionAsync(session.Id))"
                                                data-testid="agent-thread-card">
                                            <span class="agents-chat-thread-card__header">
                                                <span class="agents-chat-thread-card__title">@session.Title</span>
                                                <span class="agents-chat-thread-card__date">@FormatThreadUpdatedAt(session)</span>
                                            </span>

                                            <span class="agents-chat-thread-card__meta">@BuildSessionMeta(session)</span>

                                            <TooltipTarget Text="@BuildThreadTooltipText(session)"
                                                           Position="TooltipPosition.RightTop"
                                                           TriggerClass="agents-chat-thread-card__preview-trigger"
                                                           TestId="agent-thread-preview-tooltip">
                                                <span class="agents-chat-thread-card__preview">@BuildThreadCardPreview(session)</span>
                                            </TooltipTarget>

                                            @if (session.PendingApprovalCount > 0 || session.AutoApprovePendingToolCalls)
                                            {
                                                <span class="agents-chat-thread-card__badges">
                                                    @if (session.PendingApprovalCount > 0)
                                                    {
                                                        <StatusBadge Tone="warning"
                                                                     Text="@($"{session.PendingApprovalCount} approval(s)")" />
                                                    }
                                                    @if (session.AutoApprovePendingToolCalls)
                                                    {
                                                        <StatusBadge Tone="success" Text="Auto approve" />
                                                    }
                                                </span>
                                            }
                                        </button>
                                    }
                                }
                                else
                                {
                                    <TextBlock TextStyle="TextStyle.Body2" Value="@ResolveEmptyThreadText()" />
                                }
                            </Stack>
                        </SurfaceCard>
                    </Stack>
                }
            </div>
        </WorkspacePanel>

        <ChatWorkspacePanel Agent="@selectedAgent"
                            Session="@workspace?.SelectedSession"
                            ActiveRun="@workspace?.SelectedRun"
                            ExecutionLog="@executionLog"
                            DraftPrompt="@draftPrompt"
                            DraftPromptChanged="HandleDraftPromptChangedAsync"
                            IsBusy="@isBusy"
                            ComposerKey="@composerKey"
                            RunStateText="@runStateText"
                            RunStateTone="@runStateTone"
                            PendingUserPrompt="@pendingUserPrompt"
                            DraftAttachmentPaths="@draftAttachmentPaths"
                            SendRequested="SendMessageAsync"
                            ApprovalDecisionRequested="HandleApprovalDecisionAsync"
                            ApprovalDecisionForConversationRequested="ApproveConversationAsync"
                            AttachmentRequested="StageAttachmentsAsync"
                            SessionTitleChanged="HandleSessionTitleChangedAsync">
            <HeaderActions>
                <Button Icon="runtime"
                        Text="Runtime details"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Disabled="@(!CanOpenRuntimeDetails)"
                        Click="OpenRuntimeDetailsDialogAsync"
                        data-testid="agents-chat-open-runtime-details" />
            </HeaderActions>
        </ChatWorkspacePanel>
    </Grid>
</Stack>
</div>

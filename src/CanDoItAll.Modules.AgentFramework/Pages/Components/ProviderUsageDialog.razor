@inject IAgentFrameworkWorkspaceService WorkspaceService

@if (isLoading)
{
    <LoadingState Eyebrow="Provider usage"
                  Title="Loading provider usage"
                  Description="Reading provider-level usage aggregates for this workspace." />
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <EmptyState Eyebrow="Usage unavailable"
                Title="Provider usage could not be loaded"
                Description="@loadError" />
}
else
{
    <Stack GapScale="LayoutGap.Large"
           data-testid="provider-usage-dialog">
        <Grid Gap="LayoutGap.Medium"
              ColumnTemplate="repeat(auto-fit,minmax(9rem,1fr))">
            <MetricCard Label="Providers" Value="@AgentUsageDisplay.FormatCount(snapshot.Providers.Count)" />
            <MetricCard Label="Usage observations" Value="@AgentUsageDisplay.FormatCount(snapshot.Totals.UsageObservationCount)" />
            <MetricCard Label="Unknown observations" Value="@AgentUsageDisplay.FormatCount(snapshot.Totals.UnknownUsageObservationCount)" />
            <MetricCard Label="Tokens" Value="@AgentUsageDisplay.FormatTokens(snapshot.Totals.TotalTokens)" />
            <MetricCard Label="Known cost" Value="@AgentUsageDisplay.FormatCost(snapshot.Totals.KnownCostUsd)" />
            <MetricCard Label="Failed runs" Value="@AgentUsageDisplay.FormatCount(snapshot.Providers.Sum(item => item.FailedRunCount))" />
        </Grid>

        <Grid Gap="LayoutGap.Large"
              ColumnsLg="2">
            <CdaChart Title="Provider usage"
                      Description="Provider usage observations captured from technical executions."
                      Series="@ProviderUsageBarSeries"
                      Options="@ProviderUsageBarChartOptions"
                      Height="320"
                      EmptyText="No provider usage has been recorded." />
            <CdaChart Title="Provider share"
                      Description="Distribution across total provider usage observations in this workspace."
                      Series="@ProviderUsageDonutSeries"
                      Options="@ProviderUsageDonutChartOptions"
                      Height="320"
                      EmptyText="Provider share is not available yet." />
        </Grid>

        <SurfaceCard Soft="true">
            @if (snapshot.Providers.Count == 0)
            {
                <EmptyState Eyebrow="No usage"
                            Title="No provider usage rows"
                            Description="Provider usage rows appear after executions report usage observations." />
            }
            else
            {
                <DataGrid TItem="ProviderOverviewUsageRow"
                          Data="@ProviderRows"
                          AllowPaging="true"
                          PageSize="10"
                          data-testid="provider-usage-dialog-grid">
                    <Columns>
                        <DataGridColumn TItem="ProviderOverviewUsageRow" Title="Provider">
                            <Template Context="provider">
                                <Stack Gap="0.15rem">
                                    <span class="font-medium text-slate-950">@provider.ProviderName</span>
                                    <span class="text-xs text-slate-500">@provider.ProviderKind</span>
                                </Stack>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="ProviderOverviewUsageRow" Title="Share">
                            <Template Context="provider">
                                <span>@AgentUsageDisplay.FormatUsageShare(AgentUsageDisplay.ResolveProviderUsageValue(provider), TotalProviderUsage)</span>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="ProviderOverviewUsageRow" Title="Observations">
                            <Template Context="provider">
                                <span>@AgentUsageDisplay.FormatCount(provider.UsageObservationCount)</span>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="ProviderOverviewUsageRow" Title="Unknown">
                            <Template Context="provider">
                                <span>@AgentUsageDisplay.FormatCount(provider.UnknownUsageObservationCount)</span>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="ProviderOverviewUsageRow" Title="Tokens">
                            <Template Context="provider">
                                <span>@AgentUsageDisplay.FormatTokens(provider.TotalTokens)</span>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="ProviderOverviewUsageRow" Title="Known cost">
                            <Template Context="provider">
                                <span>@AgentUsageDisplay.FormatCost(provider.KnownCostUsd)</span>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="ProviderOverviewUsageRow" Title="Failed">
                            <Template Context="provider">
                                <StatusBadge Tone="@(provider.FailedRunCount > 0 ? "danger" : "success")"
                                             Text="@AgentUsageDisplay.FormatCount(provider.FailedRunCount)"
                                             NoWrap="true" />
                            </Template>
                        </DataGridColumn>
                    </Columns>
                </DataGrid>
            }
        </SurfaceCard>

        <Cluster JustifyContent="JustifyContent.End">
            <Button Text="Close"
                    Icon="close"
                    Variant="Variant.Outlined"
                    Click="CloseAsync" />
        </Cluster>
    </Stack>
}

@code {
    private static readonly CdaChartOptions ProviderUsageBarChartOptions = new()
    {
        Type = CdaChartType.Bar,
        XAxisType = CdaChartAxisType.Category,
        Unit = "observations",
        YAxisTitle = "Usage observations",
        ShowToolbar = false,
        EnableZoom = false,
        ShowLegend = false,
        ValuePrecision = 0,
        TooltipPrecision = 0,
        Palette = CdaChartPalette.Calm
    };

    private static readonly CdaChartOptions ProviderUsageDonutChartOptions = new()
    {
        Type = CdaChartType.Donut,
        XAxisType = CdaChartAxisType.Category,
        Unit = "observations",
        ShowToolbar = false,
        EnableZoom = false,
        ShowLegend = true,
        ShowDataLabels = true,
        ValuePrecision = 0,
        TooltipPrecision = 0,
        LegendPosition = CdaChartLegendPosition.Bottom,
        Palette = CdaChartPalette.Energetic
    };

    [CascadingParameter]
    public DialogReference? DialogReference { get; set; }

    private ProviderUsageDetailSnapshot snapshot = ProviderUsageDetailSnapshot.Empty;
    private bool isLoading = true;
    private string? loadError;

    private IReadOnlyList<ProviderOverviewUsageRow> ProviderRows =>
        snapshot.Providers
            .OrderByDescending(AgentUsageDisplay.ResolveProviderUsageValue)
            .ThenBy(item => item.ProviderName, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private decimal TotalProviderUsage => ProviderRows.Sum(AgentUsageDisplay.ResolveProviderUsageValue);

    private IReadOnlyList<CdaChartSeries> ProviderUsageBarSeries => BuildProviderUsageSeries(CdaChartType.Bar, "Provider usage");

    private IReadOnlyList<CdaChartSeries> ProviderUsageDonutSeries => BuildProviderUsageSeries(CdaChartType.Donut, "Provider share");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            snapshot = await WorkspaceService.GetProviderUsageDetailsAsync();
        }
        catch (Exception exception)
        {
            loadError = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private IReadOnlyList<CdaChartSeries> BuildProviderUsageSeries(CdaChartType chartType, string name)
    {
        if (ProviderRows.Count == 0)
        {
            return [];
        }

        return
        [
            new CdaChartSeries
            {
                Name = name,
                Type = chartType,
                Points = ProviderRows
                    .Take(12)
                    .Select(item => new CdaChartPoint(
                        AgentUsageDisplay.TrimLabel(item.ProviderName, 22),
                        AgentUsageDisplay.ResolveProviderUsageValue(item)))
                    .ToArray()
            }
        ];
    }

    private Task CloseAsync()
        => DialogReference?.CloseAsync() ?? Task.CompletedTask;
}

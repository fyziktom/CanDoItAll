<Stack Class="agent-catalog-panel" GapScale="LayoutGap.Large">
    <div class="agent-catalog-panel__hero">
        <Split Breakpoint="LayoutBreakpoint.Md"
               Gap="LayoutGap.Large"
               AlignItems="AlignItems.Start"
               JustifyContent="JustifyContent.SpaceBetween"
               Wrap="FlexWrap.Wrap">
            <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
                <p class="cda-eyebrow">Technical agents</p>
                <h2 class="cda-title-xl">Agent cards</h2>
                <p class="cda-body-muted">
                    This catalog is the canonical technical AI runtime registry. Double-click an agent card to edit runtime settings, access, skills, and MCP servers.
                </p>
            </Stack>
            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                <StatusBadge Tone="info" Text="@(isLoading ? "Loading..." : $"{FilteredAgents.Count} of {agents.Count} agent(s)")" />
                <Button Text="New agent"
                        ButtonStyle="ButtonStyle.Light"
                        Click="OpenNewAgentDialogAsync"
                        data-testid="agents-catalog-new" />
            </Cluster>
        </Split>

        <FilterBar ResultText="@(isLoading ? "Loading technical catalog..." : $"{FilteredAgents.Count} matching agent(s)")">
            <input @bind="agentSearch"
                   @bind:event="oninput"
                   class="cda-input min-w-[14rem] flex-1"
                   placeholder="Search agents"
                   data-testid="agents-catalog-search" />
            <Button Text="Reset" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="ResetAgentSearch" />
        </FilterBar>
    </div>

    @if (isLoading)
    {
        <SurfaceCard Soft="true">
            <p class="cda-eyebrow">Loading catalog</p>
            <h3 class="mt-1 text-lg font-semibold text-slate-950">Loading technical agents</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">
                AgentFramework is loading the technical runtime catalog before the roster is rendered.
            </p>
        </SurfaceCard>
    }
    else if (FilteredAgents.Count == 0)
    {
        <EmptyState Eyebrow="No technical agents"
                    Title="Create the first technical agent"
                    Description="Technical agents define runtime prompts, provider bindings, and tool-ready execution policy." />
    }
    else
    {
        <Grid Gap="LayoutGap.Medium"
              ColumnTemplate="repeat(auto-fit,minmax(17rem,1fr))"
              Class="agent-catalog-panel__grid"
              data-testid="agents-catalog-card-grid">
            @foreach (var agent in FilteredAgents)
            {
                <AgentSelectionCard Agent="@agent"
                                    IsSelected="@(selectedAgentId == agent.Id)"
                                    SelectedLabel="Selected"
                                    ShowChatHistory="true"
                                    ShowDetailsTooltip="true"
                                    ShellTestId="agents-catalog-card-shell"
                                    SelectTestId="agents-catalog-card"
                                    OnSelect="@(() => SelectAgent(agent.Id))"
                                    OnDoubleClick="@(() => QueueAgentDetailsDialogAsync(agent.Id))" />
            }
        </Grid>
    }
</Stack>

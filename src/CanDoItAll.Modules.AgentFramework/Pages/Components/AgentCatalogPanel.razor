<ListDetailShell ListPaneWidth="25rem">
    <ListHeader>
        <ListPanelHeader Title="Technical agents" Description="This catalog is the canonical technical AI runtime registry. CRM-HR binds business resources to these records instead of storing a second technical profile." Count="@(isLoading ? "Loading..." : $"{FilteredAgents.Count} agent(s)")">
            <Actions>
                <Button Text="New agent" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="ResetAgentAsync" />
            </Actions>
            <Filters>
                <FilterBar ResultText="@(isLoading ? "Loading technical catalog..." : $"{FilteredAgents.Count} matching agent(s)")">
                    <input @bind="agentSearch" @bind:event="oninput" class="cda-input min-w-[14rem] flex-1" placeholder="Search agents" />
                    <Button Text="Reset" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="ResetAgentSearch" />
                </FilterBar>
            </Filters>
        </ListPanelHeader>
    </ListHeader>

    <ListContent>
        @if (isLoading)
        {
            <SurfaceCard Soft="true">
                <p class="cda-eyebrow">Loading catalog</p>
                <h3 class="mt-1 text-lg font-semibold text-slate-950">Loading technical agents</h3>
                <p class="mt-3 text-sm leading-6 text-slate-600">
                    AgentFramework is loading the technical runtime catalog before the roster is rendered.
                </p>
            </SurfaceCard>
        }
        else if (FilteredAgents.Count == 0)
        {
            <EmptyState Eyebrow="No technical agents" Title="Create the first technical agent" Description="Technical agents define runtime prompts, provider bindings, and tool-ready execution policy." />
        }
        else
        {
            <Stack GapScale="LayoutGap.Medium">
                @foreach (var agent in FilteredAgents)
                {
                    <SelectionListItem Title="@agent.Name"
                                       Eyebrow="@agent.RoleTitle"
                                       Meta="@ResolveProviderLabel(agent)"
                                       Summary="@agent.Summary"
                                       IsSelected="@(editorModel.Id == agent.Id)"
                                       OnSelect="@(() => EditAgentAsync(agent.Id))">
                        <Status>
                            <StatusBadge Tone="@ResolveStatusTone(agent.Status)" Text="@agent.Status.ToString()" />
                        </Status>
                    </SelectionListItem>
                }
            </Stack>
        }
    </ListContent>

    <DetailHeader>
        <Stack GapScale="LayoutGap.Tiny">
            <p class="cda-eyebrow">Technical editor</p>
            <h2 class="cda-title-xl">@(editorModel.Id.HasValue ? editorModel.Name : "New technical agent")</h2>
            <p class="cda-body-muted">Use this surface for runtime prompts, provider selection, and the technical record that CRM-HR binds to.</p>
        </Stack>
    </DetailHeader>

    <DetailContent>
        <EditForm Model="editorModel" OnValidSubmit="SaveAgentAsync">
            <Stack Class="min-h-full" GapScale="LayoutGap.XXLarge">
                @if (linkedPartyId.HasValue)
                {
                    <Alert AlertStyle="AlertStyle.Info">
                        <p class="font-semibold">Bound CRM-HR resource</p>
                        <p class="mt-1">This technical agent is linked to business resource <a class="text-slate-900 underline" href="@($"/crm-hr/agents?partyId={linkedPartyId.Value:D}")">/crm-hr/agents</a>.</p>
                    </Alert>
                }

                <FormSection Title="Identity" Description="Keep the technical identity explicit and strongly typed. Business metadata stays in CRM-HR; runtime behavior lives here.">
                    <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                        <div>
                            <label class="cda-field-label">Name</label>
                            <InputText @bind-Value="editorModel.Name" class="cda-input" data-testid="agents-catalog-name" />
                        </div>
                        <div>
                            <label class="cda-field-label">Role title</label>
                            <InputText @bind-Value="editorModel.RoleTitle" class="cda-input" data-testid="agents-catalog-role" />
                        </div>
                    </Grid>
                    <div>
                        <label class="cda-field-label">Summary</label>
                        <InputTextArea @bind-Value="editorModel.Summary" class="cda-input cda-input--textarea min-h-24" data-testid="agents-catalog-summary" />
                    </div>
                    <div>
                        <label class="cda-field-label">Instructions</label>
                        <InputTextArea @bind-Value="editorModel.Instructions" class="cda-input cda-input--textarea min-h-48" data-testid="agents-catalog-instructions" />
                    </div>
                </FormSection>

                <FormSection Title="Runtime" Description="Pick the provider and model that the imported AgentFramework runtime will actually execute.">
                    <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                        <div>
                            <label class="cda-field-label">Provider</label>
                            <InputSelect @bind-Value="editorModel.ProviderProfileId"
                                         class="cda-input"
                                         disabled="@(!areProvidersLoaded && string.IsNullOrWhiteSpace(providerLoadErrorMessage))"
                                         data-testid="agents-catalog-provider">
                                <option value="">None</option>
                                @foreach (var provider in providers)
                                {
                                    <option value="@provider.Id">@provider.Name</option>
                                }
                            </InputSelect>
                            @if (!areProvidersLoaded &&
                                 string.IsNullOrWhiteSpace(providerLoadErrorMessage))
                            {
                                <p class="mt-2 text-sm leading-6 text-slate-500">Loading providers for runtime binding...</p>
                            }
                            else if (!string.IsNullOrWhiteSpace(providerLoadErrorMessage))
                            {
                                <p class="mt-2 text-sm leading-6 text-rose-700">@providerLoadErrorMessage</p>
                            }
                        </div>
                        <div>
                            <label class="cda-field-label">Model</label>
                            <InputText @bind-Value="editorModel.Model" class="cda-input" data-testid="agents-catalog-model" />
                        </div>
                    </Grid>
                    <Grid Gap="LayoutGap.Large" ColumnsMd="3">
                        <div>
                            <label class="cda-field-label">Status</label>
                            <InputSelect @bind-Value="editorModel.Status" class="cda-input">
                                @foreach (var status in Enum.GetValues<AgentLifecycleStatus>())
                                {
                                    <option value="@status">@status</option>
                                }
                            </InputSelect>
                        </div>
                        <div>
                            <label class="cda-field-label">Workload</label>
                            <InputSelect @bind-Value="editorModel.Workload" class="cda-input">
                                @foreach (var workload in Enum.GetValues<AgentWorkloadKind>())
                                {
                                    <option value="@workload">@workload</option>
                                }
                            </InputSelect>
                        </div>
                        <div>
                            <label class="cda-field-label">Chat history</label>
                            <InputSelect @bind-Value="editorModel.ChatHistoryMode" class="cda-input">
                                @foreach (var mode in Enum.GetValues<AgentChatHistoryMode>())
                                {
                                    <option value="@mode">@mode</option>
                                }
                            </InputSelect>
                        </div>
                    </Grid>
                </FormSection>

                <FormSection Title="Project Structure Access" Description="Internal agents always carry the project-structure tool family. These settings decide whether the current agent can read or mutate project data and which projects it may touch.">
                    <Grid Gap="LayoutGap.Large" ColumnsMd="3" data-testid="agents-catalog-project-structure-access">
                        <div class="cda-admin-subpanel">
                            <p class="cda-field-label mb-2">Access mode</p>
                            <Stack GapScale="LayoutGap.Small">
                                <label class="cda-inline-option">
                                    <input type="checkbox"
                                           checked="@editorModel.ProjectStructureAccess.CanRead"
                                           @onchange="args => ToggleProjectStructureRead(args.Value)"
                                           data-testid="agents-catalog-project-structure-read" />
                                    Can read project structure
                                </label>
                                <label class="cda-inline-option">
                                    <input type="checkbox"
                                           checked="@editorModel.ProjectStructureAccess.CanWrite"
                                           @onchange="args => ToggleProjectStructureWrite(args.Value)"
                                           data-testid="agents-catalog-project-structure-write" />
                                    Can write project structure
                                </label>
                            </Stack>
                        </div>
                        <div class="cda-admin-subpanel md:col-span-2">
                            <Split Breakpoint="LayoutBreakpoint.Md"
                                   Gap="LayoutGap.Medium"
                                   AlignItems="AlignItems.Center"
                                   JustifyContent="JustifyContent.SpaceBetween"
                                   Wrap="FlexWrap.Wrap">
                                <div>
                                    <p class="cda-field-label mb-1">Allowed projects</p>
                                    <p class="text-sm leading-6 text-slate-600">
                                        @CountAllowedProjectStructureProjects(editorModel) selected
                                    </p>
                                </div>
                                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                    <Button Text="Select all"
                                            ButtonStyle="ButtonStyle.Light"
                                            Size="ButtonSize.Small"
                                            Click="SelectAllProjectStructureProjects"
                                            Disabled="@(!areProjectStructureProjectsLoaded || isLoadingProjectStructureProjects || !string.IsNullOrWhiteSpace(projectStructureProjectsErrorMessage))" />
                                    <Button Text="Clear"
                                            ButtonStyle="ButtonStyle.Light"
                                            Size="ButtonSize.Small"
                                            Click="ClearProjectStructureProjects"
                                            Disabled="@(!areProjectStructureProjectsLoaded || isLoadingProjectStructureProjects || !string.IsNullOrWhiteSpace(projectStructureProjectsErrorMessage))" />
                                </Cluster>
                            </Split>

                            @if (!projectStructureProjectsRequested)
                            {
                                <div class="mt-3 cda-admin-empty">
                                    Load the project list only when you need to inspect or change the access scope.
                                </div>
                                <Cluster Gap="LayoutGap.Small"
                                         Wrap="FlexWrap.Wrap"
                                         Class="mt-3">
                                    <Button Text="Load project list"
                                            ButtonStyle="ButtonStyle.Light"
                                            Size="ButtonSize.Small"
                                            Click="RequestProjectStructureProjectsAsync"
                                            Disabled="@isLoadingProjectStructureProjects"
                                            IsBusy="@isLoadingProjectStructureProjects"
                                            data-testid="agents-catalog-project-structure-load" />
                                </Cluster>
                            }
                            else if (!areProjectStructureProjectsLoaded &&
                                     string.IsNullOrWhiteSpace(projectStructureProjectsErrorMessage))
                            {
                                <div class="mt-3 cda-admin-empty">
                                    Loading projects that can be granted to this agent...
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(projectStructureProjectsErrorMessage))
                            {
                                <div class="mt-3 cda-admin-empty text-rose-700">
                                    @projectStructureProjectsErrorMessage
                                </div>
                                <Cluster Gap="LayoutGap.Small"
                                         Wrap="FlexWrap.Wrap"
                                         Class="mt-3">
                                    <Button Text="Retry project list"
                                            ButtonStyle="ButtonStyle.Light"
                                            Size="ButtonSize.Small"
                                            Click="RequestProjectStructureProjectsAsync"
                                            Disabled="@isLoadingProjectStructureProjects"
                                            IsBusy="@isLoadingProjectStructureProjects" />
                                </Cluster>
                            }
                            else if (projectStructureProjects.Count == 0)
                            {
                                <div class="mt-3 cda-admin-empty">
                                    No projects exist yet. Create a project before granting project-structure access.
                                </div>
                            }
                            else
                            {
                                <div class="mt-3 max-h-64 overflow-y-auto rounded-2xl border border-slate-200 bg-white p-4"
                                     data-testid="agents-catalog-project-structure-projects">
                                    <Stack GapScale="LayoutGap.Small">
                                        @foreach (var project in projectStructureProjects)
                                        {
                                            <label class="cda-inline-option cda-inline-option--muted">
                                                <input type="checkbox"
                                                       checked="@HasProjectStructureProjectAccess(project.Id)"
                                                       @onchange="args => ToggleProjectStructureProject(project.Id, args.Value)" />
                                                @project.Name
                                            </label>
                                        }
                                    </Stack>
                                </div>
                            }
                        </div>
                    </Grid>
                </FormSection>

                <FormSection Title="Process Access" Description="Internal agents always carry the process-module tool family. These settings decide whether the current agent can read or mutate process data and which process definitions it may touch.">
                    <Grid Gap="LayoutGap.Large" ColumnsMd="3" data-testid="agents-catalog-process-access">
                        <div class="cda-admin-subpanel">
                            <p class="cda-field-label mb-2">Access mode</p>
                            <Stack GapScale="LayoutGap.Small">
                                <label class="cda-inline-option">
                                    <input type="checkbox"
                                           checked="@editorModel.ProcessAccess.CanRead"
                                           @onchange="args => ToggleProcessRead(args.Value)"
                                           data-testid="agents-catalog-process-read" />
                                    Can read processes
                                </label>
                                <label class="cda-inline-option">
                                    <input type="checkbox"
                                           checked="@editorModel.ProcessAccess.CanWrite"
                                           @onchange="args => ToggleProcessWrite(args.Value)"
                                           data-testid="agents-catalog-process-write" />
                                    Can write processes
                                </label>
                            </Stack>
                        </div>
                        <div class="cda-admin-subpanel md:col-span-2">
                            <Split Breakpoint="LayoutBreakpoint.Md"
                                   Gap="LayoutGap.Medium"
                                   AlignItems="AlignItems.Center"
                                   JustifyContent="JustifyContent.SpaceBetween"
                                   Wrap="FlexWrap.Wrap">
                                <div>
                                    <p class="cda-field-label mb-1">Allowed processes</p>
                                    <p class="text-sm leading-6 text-slate-600">
                                        @CountAllowedProcesses(editorModel) selected
                                    </p>
                                </div>
                                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                    <Button Text="Select all"
                                            ButtonStyle="ButtonStyle.Light"
                                            Size="ButtonSize.Small"
                                            Click="SelectAllProcesses"
                                            Disabled="@(!areProcessDefinitionsLoaded || isLoadingProcessDefinitions || !string.IsNullOrWhiteSpace(processDefinitionsErrorMessage))" />
                                    <Button Text="Clear"
                                            ButtonStyle="ButtonStyle.Light"
                                            Size="ButtonSize.Small"
                                            Click="ClearProcesses"
                                            Disabled="@(!areProcessDefinitionsLoaded || isLoadingProcessDefinitions || !string.IsNullOrWhiteSpace(processDefinitionsErrorMessage))" />
                                </Cluster>
                            </Split>

                            @if (!processDefinitionsRequested)
                            {
                                <div class="mt-3 cda-admin-empty">
                                    Load the process list only when you need to inspect or change the access scope.
                                </div>
                                <Cluster Gap="LayoutGap.Small"
                                         Wrap="FlexWrap.Wrap"
                                         Class="mt-3">
                                    <Button Text="Load process list"
                                            ButtonStyle="ButtonStyle.Light"
                                            Size="ButtonSize.Small"
                                            Click="RequestProcessDefinitionsAsync"
                                            Disabled="@isLoadingProcessDefinitions"
                                            IsBusy="@isLoadingProcessDefinitions"
                                            data-testid="agents-catalog-process-load" />
                                </Cluster>
                            }
                            else if (!areProcessDefinitionsLoaded &&
                                     string.IsNullOrWhiteSpace(processDefinitionsErrorMessage))
                            {
                                <div class="mt-3 cda-admin-empty">
                                    Loading process definitions that can be granted to this agent...
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(processDefinitionsErrorMessage))
                            {
                                <div class="mt-3 cda-admin-empty text-rose-700">
                                    @processDefinitionsErrorMessage
                                </div>
                                <Cluster Gap="LayoutGap.Small"
                                         Wrap="FlexWrap.Wrap"
                                         Class="mt-3">
                                    <Button Text="Retry process list"
                                            ButtonStyle="ButtonStyle.Light"
                                            Size="ButtonSize.Small"
                                            Click="RequestProcessDefinitionsAsync"
                                            Disabled="@isLoadingProcessDefinitions"
                                            IsBusy="@isLoadingProcessDefinitions" />
                                </Cluster>
                            }
                            else if (processDefinitions.Count == 0)
                            {
                                <div class="mt-3 cda-admin-empty">
                                    No process definitions exist yet. Create a process before granting process access.
                                </div>
                            }
                            else
                            {
                                <div class="mt-3 max-h-64 overflow-y-auto rounded-2xl border border-slate-200 bg-white p-4"
                                     data-testid="agents-catalog-processes">
                                    <Stack GapScale="LayoutGap.Small">
                                        @foreach (var definition in processDefinitions)
                                        {
                                            <label class="cda-inline-option cda-inline-option--muted">
                                                <input type="checkbox"
                                                       checked="@HasProcessAccess(definition.Id)"
                                                       @onchange="args => ToggleProcess(definition.Id, args.Value)" />
                                                @definition.Name
                                                @if (!string.IsNullOrWhiteSpace(definition.ProjectName))
                                                {
                                                    <span class="text-slate-500">(@definition.ProjectName)</span>
                                                }
                                            </label>
                                        }
                                    </Stack>
                                </div>
                            }
                        </div>
                    </Grid>
                </FormSection>

                <FormSection Title="Tags" Description="Tags keep ownership and routing visible without introducing a second registry.">
                    <div>
                        <label class="cda-field-label">Comma-separated tags</label>
                        <InputTextArea @bind-Value="tagText" class="cda-input cda-input--textarea min-h-20" />
                    </div>
                </FormSection>

                <StickyActionFooter StatusLabel="Technical agents" StatusMessage="@message" StatusTone="success">
                    <SecondaryActions>
                        <Button Text="Clear" ButtonStyle="ButtonStyle.Light" Click="ResetAgentAsync" />
                    </SecondaryActions>
                    <PrimaryActions>
                        <Button Text="Save agent" Type="submit" data-testid="agents-catalog-save" />
                    </PrimaryActions>
                    <DangerActions>
                        @if (editorModel.Id.HasValue)
                        {
                            <Button Text="Delete" ButtonStyle="ButtonStyle.Danger" Click="DeleteAgentAsync" />
                        }
                    </DangerActions>
                </StickyActionFooter>
            </Stack>
        </EditForm>
    </DetailContent>
</ListDetailShell>

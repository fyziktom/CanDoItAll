@using CanDoItAll.Modules.AgentFramework.Hosting

<Stack GapScale="LayoutGap.Large" Class="flex-1 min-h-0">
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <SurfaceCard Soft="true">
            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                <StatusBadge Tone="@messageTone" Text="@ResolveMessageLabel()" />
                <TextBlock TextStyle="TextStyle.Body2" Value="@message" />
            </Cluster>
        </SurfaceCard>
    }

    <Grid Gap="LayoutGap.Large"
          Class="flex-1 min-h-0 overflow-hidden"
          ColumnTemplateXl="minmax(19rem,0.8fr) minmax(0,1.4fr)">
        <WorkspacePanel Class="h-full min-h-0 overflow-hidden">
            <div class="flex items-start justify-between gap-3 border-b border-slate-200 pb-4">
                <div>
                    <TextBlock TextStyle="TextStyle.Subtitle2" Value="Scenario matrix" />
                    <TextBlock TextStyle="TextStyle.Body2" Value="SC03 and SC04 run directly here. The process-centric closure scenario stays guided so the proof remains honest." />
                </div>
                <StatusBadge Tone="info" Text="@($"{Definitions.Count} scenarios")" />
            </div>

            <div class="mt-4 min-h-0 flex-1 overflow-y-auto pr-1" style="scrollbar-gutter:stable;">
                <Stack GapScale="LayoutGap.Small">
                    @foreach (var definition in Definitions)
                    {
                        var isSelected = string.Equals(selectedScenarioId, definition.Id, StringComparison.OrdinalIgnoreCase);
                        var snapshot = TryGetSnapshot(definition.Id);
                        <button type="button"
                                class="block w-full rounded-[1.4rem] text-left transition focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-300 focus-visible:ring-offset-2"
                                @onclick="@(async () => await SelectScenarioAsync(definition.Id))"
                                data-testid="@($"scenario-card-{definition.Id.ToLowerInvariant()}")">
                            <ActionCard Active="@isSelected">
                                <Stack GapScale="LayoutGap.Small">
                                    <div class="flex items-start justify-between gap-3">
                                        <div class="min-w-0">
                                            <p class="text-sm font-semibold text-slate-950">@definition.Id - @definition.Title</p>
                                            <p class="mt-1 text-sm leading-6 text-slate-600">@definition.Summary</p>
                                        </div>
                                        <StatusBadge Tone="@(definition.Mode == ScenarioAutomationMode.Automated ? "success" : "warning")"
                                                     Text="@(definition.Mode == ScenarioAutomationMode.Automated ? "Automated" : "Guided")" />
                                    </div>

                                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                        @foreach (var tag in definition.CoverageTags)
                                        {
                                            <StatusBadge Tone="neutral" Text="@tag" />
                                        }
                                    </Cluster>

                                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                        <StatusBadge Tone="@ResolveScenarioStatusTone(snapshot)" Text="@ResolveScenarioStatus(snapshot)" />
                                        @if (snapshot?.LatestRun is { } latestRun)
                                        {
                                            <StatusBadge Tone="info" Text="@latestRun.UpdatedAtUtc.LocalDateTime.ToString("g")" />
                                        }
                                    </Cluster>
                                </Stack>
                            </ActionCard>
                        </button>
                    }
                </Stack>
            </div>
        </WorkspacePanel>

        <WorkspacePanel Tone="WorkspacePanelTone.Ghost" Class="h-full min-h-0 overflow-hidden">
            @if (SelectedDefinition is null)
            {
                <EmptyState Eyebrow="No scenario"
                            Title="Select a scenario from the left rail"
                            Description="The evidence panel shows the latest run, approvals, receipts, artifacts, and checkpoints for the selected scenario." />
            }
            else
            {
                var snapshot = SelectedSnapshot;
                <Stack GapScale="LayoutGap.Large" Class="h-full min-h-0">
                    <div class="border-b border-slate-200 pb-4">
                        <div class="flex flex-wrap items-start justify-between gap-3">
                            <div>
                                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                    <StatusBadge Tone="primary" Text="@($"{SelectedDefinition.Id} selected")" />
                                    <StatusBadge Tone="@(SelectedDefinition.Mode == ScenarioAutomationMode.Automated ? "success" : "warning")"
                                                 Text="@(SelectedDefinition.Mode == ScenarioAutomationMode.Automated ? "Automated harness" : "Guided proof")" />
                                    @if (snapshot?.LatestRun is { } latestRun)
                                    {
                                        <StatusBadge Tone="@ResolveScenarioStatusTone(snapshot)" Text="@snapshot!.LatestStatusLabel" />
                                        <StatusBadge Tone="neutral" Text="@latestRun.Id.ToString("N")" />
                                    }
                                </Cluster>
                                <TextBlock TextStyle="TextStyle.Body2" Value="@SelectedDefinition.EvidenceNote" />
                            </div>

                            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                <Button Text="Refresh evidence"
                                        ButtonStyle="ButtonStyle.Light"
                                        Disabled="@isBusy"
                                        Click="RefreshScenarioAsync"
                                        data-testid="scenario-refresh-button" />
                                @if (SelectedDefinition.Mode == ScenarioAutomationMode.Automated)
                                {
                                    <Button Text="Run scenario"
                                            Disabled="@isBusy"
                                            IsBusy="@isBusy"
                                            Click="RunSelectedScenarioAsync"
                                            data-testid="@($"run-scenario-{SelectedDefinition.Id.ToLowerInvariant()}")" />
                                }
                            </Cluster>
                        </div>
                    </div>

                    <Tabs data-testid="scenario-harness-tabs"
                          SelectedIndex="@selectedTabIndex"
                          SelectedIndexChanged="HandleSelectedTabIndexChanged"
                          Variant="@(TabsVariant.WorkspaceSecondary)"
                          BorderMode="@(TabsBorderMode.Soft)"
                          Tone="@(TabsTone.Secondary)"
                          OverflowMode="@(TabsOverflowMode.Scroll)"
                          PanelOverflowMode="@(TabsPanelOverflowMode.Auto)"
                          FillHeight="true"
                          Class="w-full min-w-0 flex-1 min-h-0"
                          AriaLabel="Scenario harness sections">
                        <TabItems>
                            <TabsItem Text="Run">
                                <Stack GapScale="LayoutGap.Large">
                                    <SurfaceCard Soft="true">
                                        <Stack GapScale="LayoutGap.Small">
                                            <TextBlock TextStyle="TextStyle.Subtitle2" Value="@SelectedDefinition.Title" />
                                            <TextBlock TextStyle="TextStyle.Body2" Value="@SelectedDefinition.Prompt" />
                                            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                                @if (SelectedDefinition.Mode == ScenarioAutomationMode.Automated)
                                                {
                                                    @if (snapshot?.HasPendingApprovals == true)
                                                    {
                                                        <Button Text="Approve"
                                                                Disabled="@isBusy"
                                                                IsBusy="@isBusy"
                                                                Click="ApproveSelectedScenarioAsync"
                                                                data-testid="@($"approve-scenario-{SelectedDefinition.Id.ToLowerInvariant()}")" />
                                                        <Button Text="Reject"
                                                                ButtonStyle="ButtonStyle.Light"
                                                                Disabled="@isBusy"
                                                                Click="RejectSelectedScenarioAsync"
                                                                data-testid="@($"reject-scenario-{SelectedDefinition.Id.ToLowerInvariant()}")" />
                                                    }
                                                    else
                                                    {
                                                        <TextBlock TextStyle="TextStyle.Body2" Value="Run the scenario to refresh its latest evidence pack." />
                                                    }
                                                }
                                                else
                                                {
                                                    <StatusBadge Tone="warning" Text="Guided proof only" />
                                                }
                                            </Cluster>
                                        </Stack>
                                    </SurfaceCard>

                                    <Grid Gap="LayoutGap.Large" ColumnTemplateXl="repeat(2,minmax(0,1fr))">
                                        <SurfaceCard Soft="true" data-testid="scenario-run-summary">
                                            <Stack GapScale="LayoutGap.Small">
                                                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Latest run" />
                                                @if (snapshot?.LatestRun is { } run)
                                                {
                                                    <TextBlock TextStyle="TextStyle.Body2" Value="@($"State: {snapshot.LatestStatusLabel}")" />
                                                    <TextBlock TextStyle="TextStyle.Body2" Value="@($"Updated: {run.UpdatedAtUtc.LocalDateTime:g}")" />
                                                    <TextBlock TextStyle="TextStyle.Body2" Value="@($"Receipts: {snapshot.LatestDetail?.ToolReceipts.Count ?? 0}")" />
                                                    <TextBlock TextStyle="TextStyle.Body2" Value="@($"Artifacts: {snapshot.LatestDetail?.Artifacts.Count ?? 0}")" />
                                                    <TextBlock TextStyle="TextStyle.Body2" Value="@($"Checkpoints: {snapshot.LatestDetail?.Checkpoints.Count ?? 0}")" />
                                                }
                                                else
                                                {
                                                    <TextBlock TextStyle="TextStyle.Body2" Value="No execution run has been recorded yet for this scenario." />
                                                }
                                            </Stack>
                                        </SurfaceCard>

                                        <SurfaceCard Soft="true">
                                            <Stack GapScale="LayoutGap.Small">
                                                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Assets and route" />
                                                @foreach (var asset in SelectedDefinition.AssetPaths)
                                                {
                                                    <TextBlock TextStyle="TextStyle.Body2" Value="@asset" />
                                                }
                                                @if (SelectedDefinition.Id is "SC09" or "SC11")
                                                {
                                                    <TextBlock TextStyle="TextStyle.Body2" Value="Execute this scenario from `/processes` and preserve the route screenshots in the execution report." />
                                                }
                                            </Stack>
                                        </SurfaceCard>
                                    </Grid>
                                </Stack>
                            </TabsItem>

                            <TabsItem Text="Response">
                                <SurfaceCard Soft="true" data-testid="scenario-response-panel">
                                    @if (string.IsNullOrWhiteSpace(snapshot?.ResponsePreview))
                                    {
                                        <EmptyState Eyebrow="No response"
                                                    Title="Run the scenario to populate its response artifact"
                                                    Description="The harness saves a response markdown file that the integrated shell can read back here." />
                                    }
                                    else
                                    {
                                        <div class="max-h-[34rem] overflow-auto rounded-[1rem] border border-slate-200 bg-slate-950 px-4 py-3 text-sm leading-6 text-slate-100"
                                             style="white-space:pre-wrap;">@snapshot!.ResponsePreview</div>
                                    }
                                </SurfaceCard>
                            </TabsItem>

                            <TabsItem Text="Evidence">
                                <Grid Gap="LayoutGap.Large" ColumnTemplateXl="repeat(2,minmax(0,1fr))">
                                    <SurfaceCard Soft="true" data-testid="scenario-receipt-list">
                                        <Stack GapScale="LayoutGap.Small">
                                            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Tool receipts" />
                                            @if (snapshot?.LatestDetail?.ToolReceipts.Count > 0)
                                            {
                                                @foreach (var receipt in snapshot.LatestDetail.ToolReceipts.OrderByDescending(item => item.CompletedAtUtc))
                                                {
                                                    <SelectionListItem Title="@receipt.ToolName"
                                                                       Eyebrow="@receipt.ToolFamily"
                                                                       Meta="@receipt.CompletedAtUtc.LocalDateTime.ToString("g")"
                                                                       Summary="@($"{receipt.RiskClass} / {receipt.ExitSummary}")" />
                                                }
                                            }
                                            else
                                            {
                                                <TextBlock TextStyle="TextStyle.Body2" Value="No receipts recorded yet." />
                                            }
                                        </Stack>
                                    </SurfaceCard>

                                    <SurfaceCard Soft="true" data-testid="scenario-artifact-list">
                                        <Stack GapScale="LayoutGap.Small">
                                            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Artifacts" />
                                            @if (snapshot?.LatestDetail?.Artifacts.Count > 0)
                                            {
                                                @foreach (var artifact in snapshot.LatestDetail.Artifacts.OrderBy(item => item.RelativePath, StringComparer.OrdinalIgnoreCase))
                                                {
                                                    <SelectionListItem Title="@artifact.DisplayName"
                                                                       Eyebrow="@artifact.ArtifactKind"
                                                                       Meta="@artifact.CreatedAtUtc.LocalDateTime.ToString("g")"
                                                                       Summary="@artifact.RelativePath" />
                                                }
                                            }
                                            else
                                            {
                                                <TextBlock TextStyle="TextStyle.Body2" Value="No artifacts recorded yet." />
                                            }
                                        </Stack>
                                    </SurfaceCard>
                                </Grid>
                            </TabsItem>

                            <TabsItem Text="Approvals & Checkpoints">
                                <Grid Gap="LayoutGap.Large" ColumnTemplateXl="repeat(2,minmax(0,1fr))">
                                    <SurfaceCard Soft="true" data-testid="scenario-approval-list">
                                        <Stack GapScale="LayoutGap.Small">
                                            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Approvals" />
                                            @if (snapshot?.LatestDetail?.Approvals.Count > 0)
                                            {
                                                @foreach (var approval in snapshot.LatestDetail.Approvals.OrderByDescending(item => item.RequestedAtUtc))
                                                {
                                                    <SelectionListItem Title="@approval.ToolName"
                                                                       Eyebrow="@approval.Status.ToString()"
                                                                       Meta="@approval.RequestedAtUtc.LocalDateTime.ToString("g")"
                                                                       Summary="@approval.Details" />
                                                }
                                            }
                                            else
                                            {
                                                <TextBlock TextStyle="TextStyle.Body2" Value="No approvals recorded yet." />
                                            }
                                        </Stack>
                                    </SurfaceCard>

                                    <SurfaceCard Soft="true" data-testid="scenario-checkpoint-list">
                                        <Stack GapScale="LayoutGap.Small">
                                            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Workflow checkpoints" />
                                            @if (snapshot?.LatestDetail?.Checkpoints.Count > 0)
                                            {
                                                @foreach (var checkpoint in snapshot.LatestDetail.Checkpoints.OrderByDescending(item => item.CapturedAtUtc))
                                                {
                                                    <SelectionListItem Title="@checkpoint.WorkflowCheckpointId"
                                                                       Eyebrow="@checkpoint.CheckpointKind"
                                                                       Meta="@checkpoint.CapturedAtUtc.LocalDateTime.ToString("g")"
                                                                       Summary="@($"Pending approvals: {string.Join(", ", checkpoint.PendingApprovalIds)}")" />
                                                }
                                            }
                                            else
                                            {
                                                <TextBlock TextStyle="TextStyle.Body2" Value="No checkpoints recorded yet." />
                                            }
                                        </Stack>
                                    </SurfaceCard>
                                </Grid>
                            </TabsItem>
                        </TabItems>
                    </Tabs>
                </Stack>
            }
        </WorkspacePanel>
    </Grid>
</Stack>

@namespace CanDoItAll.Modules.Workbench
@using CanDoItAll.Tools.Documents
@using Microsoft.Extensions.Logging
@implements IFileInteractionRendererComponent
@implements IDisposable
@inject ISpreadsheetWorkbookContentPreviewService Spreadsheets
@inject ILogger<WorkbenchSpreadsheetFileView> Logger

@if (previewUnavailable)
{
    <Alert AlertStyle="AlertStyle.Warning"
           Variant="Variant.Outlined"
           data-testid="workbench-spreadsheet-preview-unavailable">
        <Stack GapScale="LayoutGap.Small">
            <TextBlock TextStyle="TextStyle.Subtitle2"
                       Value="Workbook preview is unavailable." />
            <TextBlock TextStyle="TextStyle.Note"
                       Value="The workbook could not be opened inside the bounded, read-only preview. Its stored asset was not changed." />
        </Stack>
    </Alert>
}
else if (preview is not null)
{
    <Stack GapScale="LayoutGap.Medium"
           Style="min-width:0;max-height:100%;overflow:auto;"
           data-testid="workbench-spreadsheet-preview">
        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
            <StatusBadge Tone="info"
                         Text="@($"{preview.TotalWorksheetCount:N0} worksheet(s)")" />
            <StatusBadge Tone="neutral"
                         Text="@($"Preview limit {MaximumPreviewRows} rows × {MaximumPreviewColumns} columns")" />
            @if (preview.IsTruncated)
            {
                <StatusBadge Tone="warning" Text="Bounded preview" />
            }
        </Cluster>

        @foreach (SpreadsheetWorksheetPreview worksheet in preview.Worksheets)
        {
            IReadOnlyList<SpreadsheetPreviewRow> rows = CreateRows(worksheet);
            int columnCount = ResolveColumnCount(worksheet);
            bool cellsTruncated = HasTruncatedCells(worksheet);

            <SurfaceCard Soft="true"
                         Style="min-width:0;overflow:auto;"
                         data-testid="workbench-spreadsheet-worksheet">
                <Stack GapScale="LayoutGap.Small">
                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                        <TextBlock TextStyle="TextStyle.Subtitle2" Value="@worksheet.Name" />
                        <StatusBadge Tone="neutral"
                                     Text="@(string.IsNullOrWhiteSpace(worksheet.UsedRangeAddress)
                                         ? "Empty worksheet"
                                         : worksheet.UsedRangeAddress)" />
                        <StatusBadge Tone="neutral"
                                     Text="@($"{worksheet.UsedRowCount:N0} rows × {worksheet.UsedColumnCount:N0} columns")" />
                        @if (worksheet.IsTruncated)
                        {
                            <StatusBadge Tone="warning" Text="Rows or columns truncated" />
                        }
                        @if (cellsTruncated)
                        {
                            <StatusBadge Tone="warning"
                                         Text="Long cell text truncated" />
                        }
                    </Cluster>

                    @if (rows.Count == 0)
                    {
                        <EmptyState Eyebrow="Worksheet"
                                    Title="No populated cells"
                                    Description="This worksheet has no used range." />
                    }
                    else
                    {
                        <DataGrid TItem="SpreadsheetPreviewRow"
                                  Data="@rows"
                                  AllowPaging="false"
                                  data-testid="workbench-spreadsheet-grid">
                            <Columns>
                                <DataGridColumn TItem="SpreadsheetPreviewRow" Title="Row">
                                    <Template Context="row">
                                        <TextBlock TextStyle="TextStyle.Caption"
                                                   Value="@row.Number.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                    </Template>
                                </DataGridColumn>
                                @for (var columnIndex = 0; columnIndex < columnCount; columnIndex++)
                                {
                                    int capturedColumnIndex = columnIndex;
                                    <DataGridColumn TItem="SpreadsheetPreviewRow"
                                                    Title="@FormatColumnName(capturedColumnIndex)">
                                        <Template Context="row">
                                            <TextBlock Value="@ReadCell(row, capturedColumnIndex)"
                                                       Class="whitespace-pre-wrap break-words" />
                                        </Template>
                                    </DataGridColumn>
                                }
                            </Columns>
                        </DataGrid>
                    }
                </Stack>
            </SurfaceCard>
        }
    </Stack>
}

@code {
    private const int MaximumPreviewWorksheets = 3;
    private const int MaximumPreviewRows = 20;
    private const int MaximumPreviewColumns = 12;
    private const int MaximumDisplayedCellCharacters = 512;

    [Parameter, EditorRequired]
    public FileInteractionRenderContext Context { get; set; } = default!;

    private SpreadsheetPreviewIdentity? activeIdentity;
    private SpreadsheetWorkbookContentPreviewResult? preview;
    private bool previewUnavailable;
    private CancellationTokenSource? previewCancellation;
    private long previewGeneration;

    protected override async Task OnParametersSetAsync()
    {
        string workbookName = Context.Request.FileName;
        FileReference file = Context.Request.File;
        string contentRevision = Context.Request.ContentRevision?.ToString() ?? string.Empty;
        long editRevision = Context.EditRevision;
        ReadOnlyMemory<byte> content = Context.Content;
        string contentHash = Convert.ToHexString(
            System.Security.Cryptography.SHA256.HashData(content.Span));
        var identity = new SpreadsheetPreviewIdentity(
            workbookName,
            file.ToString() ?? string.Empty,
            contentRevision,
            editRevision,
            contentHash);
        if (identity == activeIdentity)
        {
            return;
        }

        activeIdentity = identity;
        preview = null;
        previewUnavailable = false;
        long generation = Interlocked.Increment(ref previewGeneration);
        previewCancellation?.Cancel();
        previewCancellation?.Dispose();
        previewCancellation = new CancellationTokenSource();
        CancellationToken cancellationToken = previewCancellation.Token;

        try
        {
            SpreadsheetWorkbookContentPreviewResult loadedPreview = await Task.Run(
                () => Spreadsheets.PreviewWorkbook(new SpreadsheetWorkbookContentPreviewRequest(
                    workbookName,
                    content,
                    MaximumPreviewWorksheets,
                    MaximumPreviewRows,
                    MaximumPreviewColumns)),
                cancellationToken);
            if (generation == Volatile.Read(ref previewGeneration) && !cancellationToken.IsCancellationRequested)
            {
                preview = loadedPreview;
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (InvalidDataException exception)
        {
            if (generation != Volatile.Read(ref previewGeneration))
            {
                return;
            }

            previewUnavailable = true;
            Logger.LogWarning(
                "Workbook preview rejected for a {ContentLength} byte asset with {ExceptionType}.",
                content.Length,
                exception.GetType().Name);
        }
    }

    private static IReadOnlyList<SpreadsheetPreviewRow> CreateRows(
        SpreadsheetWorksheetPreview worksheet)
        => worksheet.Values
            .Select((values, index) => new SpreadsheetPreviewRow(index + 1, values))
            .ToArray();

    private static int ResolveColumnCount(SpreadsheetWorksheetPreview worksheet)
        => worksheet.Values.Count == 0
            ? 0
            : worksheet.Values.Max(row => row.Count);

    private static string ReadCell(SpreadsheetPreviewRow row, int columnIndex)
    {
        if (columnIndex >= row.Values.Count)
        {
            return string.Empty;
        }

        string value = row.Values[columnIndex];
        return value.Length <= MaximumDisplayedCellCharacters
            ? value
            : $"{value[..MaximumDisplayedCellCharacters]}…";
    }

    private static bool HasTruncatedCells(SpreadsheetWorksheetPreview worksheet)
        => worksheet.Values.Any(row =>
            row.Any(value => value.Length > MaximumDisplayedCellCharacters));

    private static string FormatColumnName(int zeroBasedIndex)
    {
        var columnName = string.Empty;
        for (var value = zeroBasedIndex + 1; value > 0; value = (value - 1) / 26)
        {
            columnName = (char)('A' + ((value - 1) % 26)) + columnName;
        }

        return columnName;
    }

    private sealed record SpreadsheetPreviewRow(
        int Number,
        IReadOnlyList<string> Values);

    private sealed record SpreadsheetPreviewIdentity(
        string FileName,
        string FileReference,
        string ContentRevision,
        long EditRevision,
        string ContentHash);

    public void Dispose()
    {
        Interlocked.Increment(ref previewGeneration);
        previewCancellation?.Cancel();
        previewCancellation?.Dispose();
        previewCancellation = null;
    }
}

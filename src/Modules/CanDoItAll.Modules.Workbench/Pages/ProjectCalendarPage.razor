@page "/projects/{ProjectId:guid}/calendar"
@using CanDoItAll.AgentFramework.Models
@using CanDoItAll.Modules.Workbench.Pages.Components.ProjectStructure
@using CanDoItAll.Modules.Workbench.ProjectStructure
@using CanDoItAll.Workbench.Planning.UI

<PageTitle>Project Calendar</PageTitle>
@{
    var origin = presentation.Origin;
}
<ProjectStructureAgentChatContextProvider ProjectId="@ProjectId"
                                          ProjectName="@(surface?.ProjectName ?? "Requested project")"
                                          ActiveView="ProjectStructureAgentChatView.Calendar"
                                          CalendarSurface="@surface"
                                          SelectedEntityReferences="@SelectedAgentContextEntities"
                                          ContextNavigationIdentity="@AgentChatNavigationFence"
                                          ContextAccessState="@agentChatContextAccessState"
                                          RefreshRequested="@(notification => HandleAgentExecutionCompletedAsync(notification, origin))" />
<PlanningCalendarSurface Presentation="@presentation"
                         SelectionChanged="HandleSelectionAsync"
                         StateChanged="HandleStateAsync"
                         OpenRequested="HandleOpenAsync"
                         RetryRequested="HandleRetryAsync"
                         ProjectsRequested="HandleProjectsAsync" />

@namespace CanDoItAll.Modules.Workbench.Pages
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.CanvasLib
@using CanDoItAll.Modules.Workbench.CanvasAdapters

<CanvasFloatingWindow WindowId="@WindowId"
                      TestId="@TestId"
                      AriaLabel="@AriaLabel"
                      Kicker="Canvas health"
                      Title="Canvas health"
                      Summary="Validation pressure stays in the canvas now, but the toolbar safe zone remains clear."
                      DefaultPlacement="top-left"
                      DefaultWidth="320"
                      DefaultHeight="326"
                      MinWidth="280"
                      MinHeight="220"
                      State="@State"
                      StateChanged="StateChanged">
    <Stack GapScale="LayoutGap.Medium"
           Class="project-structure-validation-overlay"
           aria-label="Project structure validation overlay"
           data-testid="project-structure-validation-overlay">
        <Stack GapScale="LayoutGap.Tiny"
               Class="project-structure-validation-overlay__header">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Project validation overlay" />
            <TextBlock TextStyle="TextStyle.H5" Value="Canvas health" Class="cw-panel-title" />
            <TextBlock TextStyle="TextStyle.Note"
                       Value="Surface dependency and review issues directly in the structure canvas without blocking the toolbar."
                       Class="cw-panel-copy" />
        </Stack>

        <CompactStatStrip Class="project-structure-validation-overlay__metrics">
            <CompactStat Label="blocked" Value="@SummaryState.BlockedCount.ToString()" TooltipText="Blocked project structure issues." Tone="danger" />
            <CompactStat Label="review" Value="@SummaryState.ReviewCount.ToString()" TooltipText="Project structure issues needing review." Tone="warning" />
            <CompactStat Label="priority" Value="@SummaryState.PriorityCount.ToString()" TooltipText="Priority project structure issues." Tone="info" />
            <CompactStat Label="selected issues" Value="@SummaryState.SelectedIssueCount.ToString()" TooltipText="Issues linked to the current selection." />
        </CompactStatStrip>

        @if (SummaryState.SpotlightNodes.Count > 0)
        {
            <PanelCard Class="project-structure-validation-overlay__spotlight">
                <Stack GapScale="LayoutGap.Tiny">
                    <TextBlock TextStyle="TextStyle.Eyebrow" Value="Spotlight" />
                    <Stack GapScale="LayoutGap.Tiny">
                        @foreach (var nodeTitle in SummaryState.SpotlightNodes)
                        {
                            <TextBlock TextStyle="TextStyle.Note" Value="@nodeTitle" />
                        }
                    </Stack>
                </Stack>
            </PanelCard>
        }

        @if (CanValidateSelected)
        {
            <Cluster Class="project-structure-validation-overlay__actions">
                <Button Text="Validate selected"
                        Tone="ButtonTone.Info"
                        Click="ValidateSelected" />
            </Cluster>
        }
    </Stack>
</CanvasFloatingWindow>

@code {
    [Parameter, EditorRequired]
    public string WindowId { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string TestId { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string AriaLabel { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public CanvasWorkbenchWindowState State { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback<CanvasWorkbenchWindowState> StateChanged { get; set; }

    [Parameter, EditorRequired]
    public ProjectStructureValidationOverlaySummary SummaryState { get; set; } = default!;

    [Parameter]
    public bool CanValidateSelected { get; set; }

    [Parameter]
    public EventCallback ValidateSelected { get; set; }
}

@namespace CanDoItAll.Modules.Workbench.Pages

<ProjectStructureOverlayDialog CanvasScoped="true"
                               CanMaximize="true"
                               AriaLabel="@($"{State.Title} web preview")"
                               Kicker="@State.SourceLabel"
                               Title="@State.Title"
                               Summary="@State.Url.AbsoluteUri"
                               BodyClass="project-structure-web-preview-dialog__body"
                               FillBody="true"
                               DataTestId="project-structure-web-preview-dialog"
                               Close="Close">
    <Actions>
        <Button Text="Open in browser"
                Icon="open_in_new"
                Tone="ButtonTone.Primary"
                Href="@State.Url.AbsoluteUri"
                Target="_blank"
                Rel="noopener noreferrer"
                data-testid="project-structure-web-preview-open-browser" />
        <Button Text="Close"
                Variant="Variant.Text"
                Tone="ButtonTone.Default"
                Click="Close" />
    </Actions>
    <Body>
        <Stack GapScale="LayoutGap.Medium"
               FillHeight="true"
               AlignItems="AlignItems.Stretch"
               Class="min-h-0"
               Style="width:100%;height:100%;min-height:0;overflow:hidden;">
            @if (!string.IsNullOrWhiteSpace(State.Notes))
            {
                <PanelCard Soft="true"
                           Style="flex:0 1 auto;max-height:min(12rem,35%);min-height:0;overflow:auto;box-sizing:border-box;"
                           data-testid="project-structure-web-preview-notes">
                    <Stack GapScale="LayoutGap.Tiny">
                        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Notes" />
                        <TextBlock TextStyle="TextStyle.Note"
                                   Value="@State.Notes"
                                   Class="whitespace-pre-wrap break-words" />
                    </Stack>
                </PanelCard>
            }

            <EmbeddedBrowser Source="@State.Url"
                             Title="@($"Web preview for {State.Title}")"
                             CanEmbed="@State.CanEmbed"
                             EmbedUnavailableReason="@State.EmbedUnavailableReason"
                             Class="min-h-0 flex-1"
                             DataTestId="project-structure-web-preview-frame" />
        </Stack>
    </Body>
</ProjectStructureOverlayDialog>

@code {
    [Parameter, EditorRequired]
    public ProjectStructureWebPreviewDialogState State { get; set; } = default!;

    [Parameter]
    public EventCallback Close { get; set; }

}

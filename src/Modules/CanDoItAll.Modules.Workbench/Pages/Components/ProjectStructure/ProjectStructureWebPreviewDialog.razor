@namespace CanDoItAll.Modules.Workbench.Pages
@using CanDoItAll.Workbench.Operators.UI.Runtime
@{
    var state = State;
    var stop = StopRuntime;
    var close = Close;
}
<OperatorWebPreview @key="state.OpeningId" View="@(new OperatorWebPreviewView(state.OpeningId, state.Title, state.SourceLabel,
    state.Url, state.Notes, state.CanEmbed, state.EmbedUnavailableReason, state.CanStopRuntime,
    state.RuntimeStopError, state.IsBusy, state.RuntimeIdentity is { } identity ? $"Owned process {identity.ProcessId}, started {identity.StartedAtUtc:u}" : null))"
    Stop="@(() => stop.InvokeAsync(state.NodeId))" Close="close" />

@code {
    [Parameter, EditorRequired] public ProjectStructureWebPreviewDialogState State { get; set; } = default!;
    [Parameter] public EventCallback Close { get; set; }
    [Parameter] public EventCallback<string> StopRuntime { get; set; }
}

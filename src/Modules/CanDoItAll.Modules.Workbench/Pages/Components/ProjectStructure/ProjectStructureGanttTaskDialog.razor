@implements IDisposable
@namespace CanDoItAll.Modules.Workbench.Pages
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.CanvasLib
@using CanDoItAll.Workbench.Planning.UI
@{
    var reference = DialogReference;
    var openingKey = (ProjectId, QuoteContext, EditModel?.TaskId);
    Func<bool> isCurrent = () => !disposed && openingKey == (ProjectId, QuoteContext, EditModel?.TaskId) && ReferenceEquals(reference, DialogReference);
    var create = CreateSubmitted;
    var edit = EditSubmitted;
    var model = EditModel is { } source ? new PlanningGanttTaskEditModel(source.TaskId, source.Title,
        source.StartUtc, source.EndUtc, source.ProgressPercent, source.Estimate, source.Assignee,
        source.ScheduleReadOnly, source.CanChangeDirectAssignee, source.Execution) : null;
}
<PlanningGanttTaskEditor @key="openingKey" @ref="editor" ProjectId="ProjectId" QuoteContext="QuoteContext"
                        DefaultStartUtc="DefaultStartUtc" DefaultEndUtc="DefaultEndUtc" DefaultEstimate="DefaultEstimate"
                        DefaultCurrencyCode="@DefaultCurrencyCode" EditModel="model" AfterTaskNodeId="@AfterTaskNodeId"
                        ResourceOptions="ResourceOptions" ResourceWarnings="ResourceWarnings" QuoteResolver="QuoteResolver"
                        ComparisonOwner="ComparisonOwner"
                        CreateSubmitted="@(draft => SubmitCreateAsync(draft, create, reference, isCurrent))"
                        EditSubmitted="@(draft => SubmitAsync(draft, edit, reference, isCurrent))"
                        Cancelled="@(() => isCurrent() ? CloseAsync(reference) : Task.CompletedTask)" Readback="Readback" />

@code {
    private bool disposed;
    private readonly ProjectTaskDialogCloseOwner closeOwner = new();
    private PlanningGanttTaskEditor? editor;

    protected override void OnAfterRender(bool firstRender) => closeOwner.Attach(DialogReference,
        () => editor?.ReadCloseRequest(), () => editor?.ConfirmLeaveAsync() ?? Task.FromResult(false));

    public void Dispose() {
        disposed = true;
        closeOwner.Dispose();
    }
    private const decimal DefaultDurationHours = 8m;
    [CascadingParameter] public DialogReference? DialogReference { get; set; }
    [Parameter] public Func<Task<PlanningTaskSaveResult>>? Readback { get; set; }
    [Parameter] public IPlanningTaskComparisonOwner? ComparisonOwner { get; set; }
    [Parameter, EditorRequired]
    public DateTimeOffset DefaultStartUtc { get; set; }

    [Parameter, EditorRequired]
    public Guid ProjectId { get; set; }

    [Parameter]
    public ProjectTaskQuoteContext QuoteContext { get; set; } = new(Guid.Empty, Guid.Empty, Guid.NewGuid());

    [Parameter, EditorRequired]
    public DateTimeOffset DefaultEndUtc { get; set; }

    [Parameter]
    public ProjectTaskEstimate DefaultEstimate { get; set; } = new(
        DefaultDurationHours,
        ProjectWorkItemEffortUnit.Hours,
        null,
        string.Empty);

    [Parameter]
    public string DefaultCurrencyCode { get; set; } = "USD";

    [Parameter]
    public ProjectStructureGanttTaskEditModel? EditModel { get; set; }

    [Parameter]
    public string? AfterTaskNodeId { get; set; }

    [Parameter]
    public IReadOnlyList<ProjectStructureTaskResourceOption> ResourceOptions { get; set; } = [];

    [Parameter]
    public IReadOnlyList<string> ResourceWarnings { get; set; } = [];

    [Parameter]
    public Func<ProjectStructureTaskResourceCostRequest, CancellationToken, Task<ProjectStructureTaskResourceCostQuote>>? QuoteResolver { get; set; }

    [Parameter] public Func<ProjectStructureTaskCreateRequest, Task<PlanningTaskSaveResult>>? CreateSubmitted { get; set; }
    [Parameter] public Func<ProjectStructureTaskEditDialogResult, Task<PlanningTaskSaveResult>>? EditSubmitted { get; set; }

    private Task<PlanningTaskSaveResult> SubmitCreateAsync(PlanningGanttTaskCreate draft,
        Func<ProjectStructureTaskCreateRequest, Task<PlanningTaskSaveResult>>? submit, DialogReference? reference, Func<bool> isCurrent)
        => SubmitAsync(new ProjectStructureTaskCreateRequest(draft.Title, draft.StartUtc, draft.EndUtc,
            draft.AfterTaskNodeId, draft.Resource, draft.Estimate), submit, reference, isCurrent);

    private async Task<PlanningTaskSaveResult> SubmitAsync<T>(T draft, Func<T, Task<PlanningTaskSaveResult>>? submit,
        DialogReference? reference, Func<bool> isCurrent) {
        if (!isCurrent() || reference?.Result.IsCompleted == true) {
            return new(PlanningTaskSaveStatus.Rejected, "This editor opening is no longer current.", [], [], [], true);
        }
        if (reference is null) {
            return new(PlanningTaskSaveStatus.Rejected, "This task editor requires its original dialog reference.", [], [], []);
        }
        var submitted = editor?.ReadCloseRequest();
        var result = submit is null ? new PlanningTaskSaveResult(PlanningTaskSaveStatus.Rejected,
            "This task editor is not connected to a save owner.", [], [], []) : await submit(draft);
        if (result.ShouldClose) {
            if (!isCurrent() || !await closeOwner.CloseAcceptedAsync(reference, submitted, draft!)) {
                return result with { RequiresReadback = true,
                    Message = $"{result.Message} The current draft is retained. Review the original save outcome before another write." };
            }
        }
        return result;
    }

    private static Task CloseAsync(DialogReference? reference) => reference?.CloseAsync() ?? Task.CompletedTask;
}

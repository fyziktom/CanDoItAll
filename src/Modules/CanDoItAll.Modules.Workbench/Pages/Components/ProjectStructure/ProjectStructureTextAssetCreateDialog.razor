@namespace CanDoItAll.Modules.Workbench.Pages
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.CanvasLib
@using CanDoItAll.Workbench.Content.UI
@inject ProjectAssetCreationService AssetCreationService

<ContentTextForm OpeningId="openingId" Definition="contentDefinition" InitialDraft="initialDraft"
                 Submit="submit" Completed="complete" Cancelled="cancel" CancellationToken="CancellationToken" />

@code {
    private Guid openingId;
    private ProjectStructureTextAssetDialogDefinition? boundDefinition;
    private CanvasWorkbenchCreateActionRequest? boundRequest;
    private ContentTextDefinition contentDefinition = default!;
    private ContentTextInitialDraft initialDraft = default!;
    private Func<ContentTextSubmission, CancellationToken, Task<ContentTextOutcome>> submit = default!;
    private Func<ContentTextOutcome, Task> complete = default!;
    private Func<Task> cancel = default!;

    [CascadingParameter] public DialogReference? DialogReference { get; set; }
    [Parameter, EditorRequired] public CanvasWorkbenchCreateActionRequest CreateRequest { get; set; } = default!;
    [Parameter, EditorRequired] public ProjectStructureTextAssetDialogDefinition Definition { get; set; } = default!;
    [Parameter] public Func<ProjectStructureTextAssetDialogResult, Task>? PersistSubmissionAsync { get; set; }
    [Parameter] public Func<ProjectStructureTextAssetDialogResult, Task<ContentTextOutcome>>? PersistOutcomeAsync { get; set; }
    [Parameter] public CancellationToken CancellationToken { get; set; }

    protected override void OnParametersSet() {
        if (ReferenceEquals(boundRequest, CreateRequest) && ReferenceEquals(boundDefinition, Definition)) {
            return;
        }
        var receiver = DialogReference ?? throw new InvalidOperationException("Text asset creation requires its original dialog reference.");
        var original = CreateRequest;
        var definition = Definition;
        var persist = PersistSubmissionAsync;
        var persistOutcome = PersistOutcomeAsync;
        boundRequest = original;
        boundDefinition = definition;
        openingId = Guid.NewGuid();
        var kind = definition.FileSubtype switch {
            ProjectFileSubtype.Text => ContentTextKind.Text,
            ProjectFileSubtype.Json => ContentTextKind.Json,
            ProjectFileSubtype.Markdown => ContentTextKind.Markdown,
            ProjectFileSubtype.Mermaid => ContentTextKind.Mermaid,
            ProjectFileSubtype.Log => ContentTextKind.Log,
            _ => throw new ArgumentOutOfRangeException(nameof(Definition), "A supported text format is required.")
        };
        contentDefinition = new(kind, definition.Label, definition.TitleLabel, definition.TitlePlaceholder,
            definition.SubtitleLabel, definition.SubtitlePlaceholder, definition.NotesLabel, definition.NotesPlaceholder,
            definition.FileNamePlaceholder, definition.ContentPlaceholder, definition.AcceptedFileTypes,
            definition.FilePrompt, definition.SubmitLabel, ProjectAssetCreationLimits.MaximumEditableTextBytes);
        initialDraft = new(original.Title ?? string.Empty, original.Subtitle ?? string.Empty, original.Notes ?? string.Empty);
        ProjectStructureTextAssetDialogResult? accepted = null;
        submit = async (submission, cancellationToken) => {
            try {
                var media = submission.Source switch {
                    ContentTextSource.CreateNew => await AssetCreationService.CreateTextAsync(definition.FileSubtype, submission.FileName,
                        submission.Content, cancellationToken),
                    ContentTextSource.UploadExisting when submission.Upload is { } upload => AssetCreationService.AdaptTextUpload(
                        definition.FileSubtype, upload.FileName, upload.ContentType, upload.Bytes, cancellationToken),
                    _ => throw new InvalidDataException("Choose an existing file to upload.")
                };
                var result = new ProjectStructureTextAssetDialogResult(original with {
                    Title = submission.Title, Subtitle = submission.Subtitle, Notes = submission.Notes, UploadedFile = null
                }, media);
                ContentTextOutcome outcome;
                if (persistOutcome is not null) {
                    outcome = await persistOutcome(result);
                } else {
                    if (persist is not null) {
                        await persist(result);
                    }
                    outcome = new(ContentTextOutcomeKind.Prepared, persist is null ? "File content prepared." : "Submission accepted by its native owner.");
                }
                if (outcome.IsAccepted) {
                    accepted = result;
                }
                return outcome;
            } catch (ProjectAssetCreationException exception) {
                return new(ContentTextOutcomeKind.Rejected, exception.Message);
            } catch (ProjectStructureTextAssetSubmissionException exception) {
                return new(exception.RequiresObservation ? ContentTextOutcomeKind.Unconfirmed : ContentTextOutcomeKind.Rejected, exception.Message);
            }
        };
        complete = _ => receiver.CloseAsync(accepted ?? throw new InvalidOperationException("No accepted text submission is available."));
        cancel = () => receiver.CloseAsync();
    }
}

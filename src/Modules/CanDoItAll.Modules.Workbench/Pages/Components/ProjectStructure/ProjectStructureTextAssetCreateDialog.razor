@namespace CanDoItAll.Modules.Workbench.Pages
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.CanvasLib
@using Microsoft.Extensions.Logging
@inject DialogService DialogService
@inject ProjectAssetCreationService AssetCreationService
@inject ILogger<ProjectStructureTextAssetCreateDialog> Logger

<Stack GapScale="LayoutGap.Large"
       AlignItems="AlignItems.Stretch"
       data-testid="project-structure-text-asset-create-content">
    <Alert AlertStyle="AlertStyle.Info"
           Variant="Variant.Outlined">
        Create a new stored file from text, or attach an existing file. Both paths use the configured project storage and the same FileTools authorization flow.
    </Alert>

    <FormField Text="Content source">
        <Cluster Gap="LayoutGap.Small"
                 Wrap="FlexWrap.Wrap">
            <Button Text="Create new"
                    Icon="note_add"
                    ButtonStyle="@(sourceMode == ProjectAssetSourceMode.CreateNew ? ButtonStyle.Info : ButtonStyle.Base)"
                    Variant="Variant.Outlined"
                    aria-pressed="@(sourceMode == ProjectAssetSourceMode.CreateNew)"
                    data-testid="project-structure-text-asset-source-create"
                    Click="SelectCreateNew" />
            <Button Text="Upload existing"
                    Icon="upload_file"
                    ButtonStyle="@(sourceMode == ProjectAssetSourceMode.UploadExisting ? ButtonStyle.Info : ButtonStyle.Base)"
                    Variant="Variant.Outlined"
                    aria-pressed="@(sourceMode == ProjectAssetSourceMode.UploadExisting)"
                    data-testid="project-structure-text-asset-source-upload"
                    Click="SelectUploadExisting" />
        </Cluster>
    </FormField>

    <Grid ColumnTemplate="repeat(2,minmax(0,1fr))"
          Gap="LayoutGap.Medium">
        <FormField Text="@Definition.TitleLabel">
            <TextBox Value="@title"
                     ValueChanged="HandleTitleChangedAsync"
                     Placeholder="@Definition.TitlePlaceholder"
                     Immediate="true"
                     data-testid="project-structure-text-asset-title" />
        </FormField>

        <FormField Text="@Definition.SubtitleLabel">
            <TextBox Value="@subtitle"
                     ValueChanged="HandleSubtitleChangedAsync"
                     Placeholder="@Definition.SubtitlePlaceholder"
                     Immediate="true"
                     data-testid="project-structure-text-asset-subtitle" />
        </FormField>
    </Grid>

    @if (sourceMode == ProjectAssetSourceMode.CreateNew)
    {
        <FormField Text="File name">
            <TextBox Value="@fileName"
                     ValueChanged="HandleFileNameChangedAsync"
                     Placeholder="@Definition.FileNamePlaceholder"
                     Immediate="true"
                     data-testid="project-structure-text-asset-file-name" />
        </FormField>

        <FormField Text="File content">
            <TextArea Value="@content"
                      ValueChanged="HandleContentChangedAsync"
                      Placeholder="@Definition.ContentPlaceholder"
                      Rows="14"
                      Immediate="true"
                      data-testid="project-structure-text-asset-content" />
        </FormField>
    }
    else
    {
        <FileUpload PrimaryText="@Definition.FilePrompt"
                    SecondaryText="The selected file remains subject to the project asset size and storage policies."
                    ButtonText="Choose file"
                    Accept="@Definition.AcceptedFileTypes"
                    Compact="true"
                    Change="HandleFileChangedAsync"
                    RootTestHookId="project-structure-text-asset-upload"
                    InputTestHookId="project-structure-text-asset-upload-input" />

        @if (uploadedFile is not null)
        {
            <Alert AlertStyle="AlertStyle.Info"
                   Variant="Variant.Outlined"
                   data-testid="project-structure-text-asset-upload-selection">
                Selected @uploadedFile.Name (@FormatFileSize(uploadedFile.Size)).
            </Alert>
        }
    }

    <FormField Text="@Definition.NotesLabel">
        <TextArea Value="@notes"
                  ValueChanged="HandleNotesChangedAsync"
                  Placeholder="@Definition.NotesPlaceholder"
                  Rows="3"
                  Immediate="true"
                  data-testid="project-structure-text-asset-notes" />
    </FormField>

    @if (!string.IsNullOrWhiteSpace(validationError))
    {
        <Alert AlertStyle="AlertStyle.Danger"
               data-testid="project-structure-text-asset-validation-error">
            @validationError
        </Alert>
    }

    <Cluster Gap="LayoutGap.Small"
             JustifyContent="JustifyContent.End">
        <Button Text="Cancel"
                Variant="Variant.Outlined"
                ButtonStyle="ButtonStyle.Base"
                Disabled="@isSubmitting"
                data-testid="project-structure-text-asset-cancel"
                Click="CancelAsync" />
        <Button Text="@Definition.SubmitLabel"
                Icon="@(sourceMode == ProjectAssetSourceMode.CreateNew ? "note_add" : "upload_file")"
                ButtonStyle="ButtonStyle.Info"
                Disabled="@SubmitDisabled"
                IsBusy="@isSubmitting"
                data-testid="project-structure-text-asset-submit"
                Click="SubmitAsync" />
    </Cluster>
</Stack>

@code {
    private ProjectAssetSourceMode sourceMode = ProjectAssetSourceMode.CreateNew;
    private string title = string.Empty;
    private string subtitle = string.Empty;
    private string notes = string.Empty;
    private string fileName = string.Empty;
    private string content = string.Empty;
    private IBrowserFile? uploadedFile;
    private string validationError = string.Empty;
    private bool initialized;
    private bool isSubmitting;

    [CascadingParameter]
    public DialogReference? DialogReference { get; set; }

    [Parameter, EditorRequired]
    public CanvasWorkbenchCreateActionRequest CreateRequest { get; set; } = default!;

    [Parameter, EditorRequired]
    public ProjectStructureTextAssetDialogDefinition Definition { get; set; } = default!;

    [Parameter]
    public Func<ProjectStructureTextAssetDialogResult, Task>? PersistSubmissionAsync { get; set; }

    [Parameter]
    public CancellationToken CancellationToken { get; set; }

    private bool SubmitDisabled
        => isSubmitting ||
            sourceMode == ProjectAssetSourceMode.UploadExisting && uploadedFile is null;

    protected override void OnParametersSet()
    {
        if (initialized)
        {
            return;
        }

        initialized = true;
        title = CreateRequest.Title ?? string.Empty;
        subtitle = CreateRequest.Subtitle ?? string.Empty;
        notes = CreateRequest.Notes ?? string.Empty;
        fileName = Definition.FileNamePlaceholder;
    }

    private void SelectCreateNew()
    {
        sourceMode = ProjectAssetSourceMode.CreateNew;
        validationError = string.Empty;
    }

    private void SelectUploadExisting()
    {
        sourceMode = ProjectAssetSourceMode.UploadExisting;
        validationError = string.Empty;
    }

    private Task HandleTitleChangedAsync(string? value)
    {
        title = value ?? string.Empty;
        validationError = string.Empty;
        return Task.CompletedTask;
    }

    private Task HandleSubtitleChangedAsync(string? value)
    {
        subtitle = value ?? string.Empty;
        validationError = string.Empty;
        return Task.CompletedTask;
    }

    private Task HandleNotesChangedAsync(string? value)
    {
        notes = value ?? string.Empty;
        validationError = string.Empty;
        return Task.CompletedTask;
    }

    private Task HandleFileNameChangedAsync(string? value)
    {
        fileName = value ?? string.Empty;
        validationError = string.Empty;
        return Task.CompletedTask;
    }

    private Task HandleContentChangedAsync(string? value)
    {
        content = value ?? string.Empty;
        validationError = string.Empty;
        return Task.CompletedTask;
    }

    private Task HandleFileChangedAsync(InputFileChangeEventArgs args)
    {
        uploadedFile = args.File;
        validationError = string.Empty;
        if (string.IsNullOrWhiteSpace(title))
        {
            title = Path.GetFileNameWithoutExtension(uploadedFile.Name);
        }

        return Task.CompletedTask;
    }

    private async Task SubmitAsync()
    {
        if (isSubmitting)
        {
            return;
        }

        string normalizedTitle = title.Trim();
        if (normalizedTitle.Length == 0)
        {
            validationError = "A file title is required.";
            return;
        }

        if (normalizedTitle.Length > 200)
        {
            validationError = "The file title cannot exceed 200 characters.";
            return;
        }

        if (subtitle.Trim().Length > 240)
        {
            validationError = "The folder or context cannot exceed 240 characters.";
            return;
        }

        isSubmitting = true;
        validationError = string.Empty;
        try
        {
            ProjectObjectMediaPayload media = sourceMode switch
            {
                ProjectAssetSourceMode.CreateNew => await AssetCreationService.CreateTextAsync(
                    Definition.FileSubtype,
                    fileName,
                    content,
                    CancellationToken),
                ProjectAssetSourceMode.UploadExisting => await CreateUploadPayloadAsync(),
                _ => throw new ArgumentOutOfRangeException(nameof(sourceMode))
            };
            var result = new ProjectStructureTextAssetDialogResult(
                CreateRequest with
                {
                    Title = normalizedTitle,
                    Subtitle = subtitle.Trim(),
                    Notes = notes.Trim(),
                    UploadedFile = null
                },
                media);

            if (PersistSubmissionAsync is not null)
            {
                await PersistSubmissionAsync(result);
            }

            if (DialogReference is null)
            {
                await DialogService.CloseAsync(result);
                return;
            }

            await DialogReference.CloseAsync(result);
        }
        catch (ProjectAssetCreationException exception)
        {
            validationError = exception.Message;
        }
        catch (ProjectStructureTextAssetSubmissionException exception)
        {
            validationError = exception.Message;
        }
        catch (OperationCanceledException) when (CancellationToken.IsCancellationRequested)
        {
        }
        catch (IOException exception)
        {
            Logger.LogWarning(
                exception,
                "Project text asset upload could not be read. Subtype={Subtype} Extension={Extension}.",
                Definition.FileSubtype,
                Path.GetExtension(uploadedFile?.Name ?? string.Empty));
            validationError = "The selected file could not be read.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async ValueTask<ProjectObjectMediaPayload> CreateUploadPayloadAsync()
    {
        if (uploadedFile is null)
        {
            throw new ProjectAssetCreationException(
                ProjectAssetCreationErrorCode.InvalidContent,
                "Choose an existing file to upload.");
        }

        if (uploadedFile.Size > ProjectAssetCreationLimits.MaximumEditableTextBytes)
        {
            throw new ProjectAssetCreationException(
                ProjectAssetCreationErrorCode.ContentTooLarge,
                $"Text assets are limited to {ProjectAssetCreationLimits.MaximumEditableTextBytes / (1024 * 1024)} MiB.");
        }

        await using Stream source = uploadedFile.OpenReadStream(
            ProjectAssetCreationLimits.MaximumEditableTextBytes,
            CancellationToken);
        using var destination = new MemoryStream((int)uploadedFile.Size);
        await source.CopyToAsync(destination, CancellationToken);
        return AssetCreationService.AdaptTextUpload(
            Definition.FileSubtype,
            uploadedFile.Name,
            uploadedFile.ContentType,
            destination.ToArray(),
            CancellationToken);
    }

    private Task CancelAsync()
        => DialogReference is null
            ? DialogService.CloseAsync()
            : DialogReference.CloseAsync();

    private static string FormatFileSize(long bytes)
        => bytes >= 1024 * 1024
            ? $"{bytes / (1024d * 1024d):0.##} MiB"
            : $"{Math.Max(1, bytes / 1024d):0.##} KiB";
}

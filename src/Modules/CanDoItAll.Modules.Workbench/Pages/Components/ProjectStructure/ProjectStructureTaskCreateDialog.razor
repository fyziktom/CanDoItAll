@implements IDisposable
@namespace CanDoItAll.Modules.Workbench.Pages
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.CanvasLib
@using CanDoItAll.Workbench.Planning.UI
@using CanDoItAll.Infrastructure.Configuration
@inject ICurrencyFormatter CurrencyFormatter
@{
    var reference = DialogReference;
    var openingKey = (ProjectId, QuoteContext, CreateRequest.SourceNodeId, IsEditMode);
    Func<bool> isCurrent = () => !disposed && openingKey == (ProjectId, QuoteContext, CreateRequest.SourceNodeId, IsEditMode) && ReferenceEquals(reference, DialogReference);
    var submit = Submitted;
}
<PlanningStructureTaskEditor @key="openingKey" ProjectId="ProjectId" QuoteContext="QuoteContext" CreateRequest="CreateRequest"
                            IsEditMode="IsEditMode" InitialAssignee="InitialAssignee" InitialExecution="InitialExecution"
                            CanChangeDirectAssignee="CanChangeDirectAssignee" RepositoryOptions="RepositoryOptions"
                            ResourceOptions="ResourceOptions" ResourceWarnings="ResourceWarnings" QuoteResolver="QuoteResolver"
                            DefaultCurrencyCode="@CurrencyFormatter.CurrencyCode" Readback="Readback"
                            Submitted="@(draft => SubmitAsync(draft, submit, reference, isCurrent))"
                            Cancelled="@(() => isCurrent() ? CloseAsync(reference) : Task.CompletedTask)" />

@code {
    private bool disposed;
    public void Dispose() => disposed = true;
    [CascadingParameter] public DialogReference? DialogReference { get; set; }
    [Parameter] public Func<Task<PlanningTaskSaveResult>>? Readback { get; set; }
    [Parameter, EditorRequired]
    public CanvasWorkbenchCreateActionRequest CreateRequest { get; set; } = default!;

    [Parameter, EditorRequired]
    public Guid ProjectId { get; set; }

    [Parameter]
    public ProjectTaskQuoteContext QuoteContext { get; set; } = new(Guid.Empty, Guid.Empty, Guid.NewGuid());

    [Parameter]
    public bool IsEditMode { get; set; }

    [Parameter]
    public ProjectStructureTaskResourceSelection? InitialAssignee { get; set; }

    [Parameter]
    public ProjectTaskExecutionSnapshot InitialExecution { get; set; } =
        ProjectTaskExecutionSnapshot.Unknown;

    [Parameter]
    public bool CanChangeDirectAssignee { get; set; } = true;

    [Parameter]
    public IReadOnlyList<CanvasWorkbenchInputOption> RepositoryOptions { get; set; } = [];

    [Parameter]
    public IReadOnlyList<ProjectStructureTaskResourceOption> ResourceOptions { get; set; } = [];

    [Parameter]
    public IReadOnlyList<string> ResourceWarnings { get; set; } = [];

    [Parameter]
    public Func<ProjectStructureTaskResourceCostRequest, CancellationToken, Task<ProjectStructureTaskResourceCostQuote>>? QuoteResolver { get; set; }

    [Parameter] public Func<ProjectStructureTaskDialogResult, Task<PlanningTaskSaveResult>>? Submitted { get; set; }

    private async Task<PlanningTaskSaveResult> SubmitAsync<T>(T draft, Func<T, Task<PlanningTaskSaveResult>>? submit,
        DialogReference? reference, Func<bool> isCurrent) {
        if (!isCurrent() || reference?.Result.IsCompleted == true) {
            return new(PlanningTaskSaveStatus.Rejected, "This editor opening is no longer current.", [], [], [], true);
        }
        if (reference is null) {
            return new(PlanningTaskSaveStatus.Rejected, "This task editor requires its original dialog reference.", [], [], []);
        }
        var result = submit is null ? PlanningTaskSaveResult.Accepted : await submit(draft);
        if (result.ShouldClose) {
            await reference.CloseAsync(draft);
        }
        return result;
    }

    private static Task CloseAsync(DialogReference? reference) => reference?.CloseAsync() ?? Task.CompletedTask;
}

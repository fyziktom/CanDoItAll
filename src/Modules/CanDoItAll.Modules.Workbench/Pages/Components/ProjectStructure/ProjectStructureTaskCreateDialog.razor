@namespace CanDoItAll.Modules.Workbench.Pages
@using System.Globalization
@using CanDoItAll.AppComponents
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.CanvasLib
@using CanDoItAll.Infrastructure.Configuration
@inject DialogService DialogService
@inject ICurrencyFormatter CurrencyFormatter

<Stack GapScale="LayoutGap.Large"
       AlignItems="AlignItems.Stretch"
       Class="project-structure-task-create-dialog"
       data-testid="project-structure-task-create-content">
    @if (AssigneeWarnings.Count > 0)
    {
        <Alert AlertStyle="AlertStyle.Warning"
               data-testid="project-structure-task-create-assignee-warning">
            @string.Join(" ", AssigneeWarnings)
        </Alert>
    }

    <Grid ColumnTemplate="repeat(2,minmax(0,1fr))"
          Gap="LayoutGap.Medium"
          Class="project-structure-task-create-dialog__grid">
        <FormField Text="Task title"
                   Class="project-structure-task-create-dialog__wide-field">
            <TextBox Value="@title"
                     ValueChanged="HandleTitleChangedAsync"
                     Placeholder="Describe the task"
                     Immediate="true"
                     data-testid="project-structure-task-create-title" />
        </FormField>

        <FormField Text="Status lane">
            <TextBox Value="@subtitle"
                     ValueChanged="HandleSubtitleChangedAsync"
                     Placeholder="Sprint, phase, or owner"
                     Immediate="true"
                     data-testid="project-structure-task-create-subtitle" />
        </FormField>

        <FormField Text="Due (UTC)">
            <input type="datetime-local"
                   class="cda-input"
                   value="@FormatDateTimeLocal(dueUtc)"
                   aria-label="Task due date in UTC"
                   data-testid="project-structure-task-create-due"
                   @onchange="HandleDueChanged" />
        </FormField>

        <FormField Text="Repository">
            <DropDown TValue="string"
                      Data="@RepositoryOptions"
                      TextProperty="Label"
                      ValueProperty="Value"
                      Value="@repositoryNodeId"
                      ValueChanged="HandleRepositoryChangedAsync"
                      Placeholder="Optional repository"
                      AllowClear="true"
                      data-testid="project-structure-task-create-repository" />
        </FormField>

        <FormField Text="Notes"
                   Class="project-structure-task-create-dialog__wide-field">
            <TextArea Value="@notes"
                      ValueChanged="HandleNotesChangedAsync"
                      Placeholder="Definition of done or context"
                      Rows="4"
                      Immediate="true"
                      data-testid="project-structure-task-create-notes" />
        </FormField>
    </Grid>

    <ProjectStructureTaskEstimateEditor @ref="estimateEditor"
                                        Value="@estimate"
                                        ValueChanged="HandleEstimateChangedAsync"
                                        DefaultCurrencyCode="@CurrencyFormatter.CurrencyCode"
                                        DataTestId="project-structure-task-create-estimate" />

    <Stack GapScale="LayoutGap.Small"
           AlignItems="AlignItems.Stretch">
        <Cluster Gap="LayoutGap.Small"
                 AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.SpaceBetween"
                 Wrap="FlexWrap.Wrap">
            <Stack GapScale="LayoutGap.XSmall">
                <TextBlock TextStyle="TextStyle.Subtitle2"
                           Value="Optional person or agent" />
                <TextBlock TextStyle="TextStyle.Note"
                           Value="The selected CRM person or synchronized AI agent is assigned directly to this task. No child node is created." />
            </Stack>
            @if (selectedAssignee is not null)
            {
                <Button Text="Clear selection"
                        Icon="close"
                        Size="ButtonSize.Small"
                        Variant="Variant.Text"
                        ButtonStyle="ButtonStyle.Base"
                        data-testid="project-structure-task-create-assignee-clear"
                        Click="ClearAssignee" />
            }
        </Cluster>

        <ProjectStructureTaskResourcePicker Options="@AssigneeOptions"
                                            SelectedResource="@selectedAssignee"
                                            SelectionChanged="SelectAssigneeAsync"
                                            AllowedKinds="@DirectAssigneeKinds"
                                            SearchPlaceholder="Search CRM people and synchronized agents"
                                            EmptyEyebrow="No assignees"
                                            EmptyTitle="No people or agents match the current filters"
                                            EmptyDescription="Change the resource-type filters, clear the search, or save without an assignee."
                                            OptionTestIdPrefix="project-structure-task-create-assignee"
                                            DataTestId="project-structure-task-create-assignee-picker" />

        <ProjectStructureTaskResourceCostEstimator @ref="costEstimator"
                                                   ProjectId="@ProjectId"
                                                   SelectedResource="@selectedAssignee"
                                                   Estimate="@estimate"
                                                   EstimateChanged="HandleEstimateChangedAsync"
                                                   QuoteResolver="@QuoteResolver"
                                                   DataTestId="project-structure-task-create-resource-cost" />
    </Stack>

    @if (!string.IsNullOrWhiteSpace(validationError))
    {
        <Alert AlertStyle="AlertStyle.Danger"
               data-testid="project-structure-task-create-validation-error">
            @validationError
        </Alert>
    }

    <Cluster Gap="LayoutGap.Small"
             JustifyContent="JustifyContent.End">
        <Button Text="Cancel"
                Variant="Variant.Outlined"
                ButtonStyle="ButtonStyle.Base"
                data-testid="project-structure-task-create-cancel"
                Click="CancelAsync" />
        <Button Text="@(IsEditMode ? "Save task" : "Create task")"
                Icon="@(IsEditMode ? "save" : "add_task")"
                ButtonStyle="ButtonStyle.Info"
                data-testid="project-structure-task-create-submit"
                Click="SubmitAsync" />
    </Cluster>
</Stack>

@code {
    private const string DateTimeLocalFormat = "yyyy-MM-ddTHH:mm";
    private const string TaskSubtype = "task";
    private static readonly IReadOnlySet<ProjectStructureTaskResourceKind> DirectAssigneeKinds =
        new HashSet<ProjectStructureTaskResourceKind>
        {
            ProjectStructureTaskResourceKind.Person,
            ProjectStructureTaskResourceKind.Agent
        };
    private static readonly HashSet<string> ControlledInputKeys = new(StringComparer.OrdinalIgnoreCase)
    {
        "workItemKind",
        "assigneeRef",
        "dueUtc",
        "repositoryRef",
        ProjectTaskEstimateInputKeys.ExpectedEffortValue,
        ProjectTaskEstimateInputKeys.ExpectedEffortUnit,
        ProjectTaskEstimateInputKeys.ExpectedCostAmount,
        ProjectTaskEstimateInputKeys.ExpectedCostCurrencyCode
    };

    private bool initialized;
    private string title = string.Empty;
    private string subtitle = string.Empty;
    private string notes = string.Empty;
    private DateTimeOffset? dueUtc;
    private string? repositoryNodeId;
    private ProjectStructureTaskResourceSelection? selectedAssignee;
    private ProjectTaskEstimate estimate = ProjectTaskEstimate.Empty();
    private ProjectStructureTaskEstimateEditor? estimateEditor;
    private ProjectStructureTaskResourceCostEstimator? costEstimator;
    private string validationError = string.Empty;

    [CascadingParameter]
    public DialogReference? DialogReference { get; set; }

    [Parameter, EditorRequired]
    public CanvasWorkbenchCreateActionRequest CreateRequest { get; set; } = default!;

    [Parameter, EditorRequired]
    public Guid ProjectId { get; set; }

    [Parameter]
    public bool IsEditMode { get; set; }

    [Parameter]
    public ProjectStructureTaskResourceSelection? InitialAssignee { get; set; }

    [Parameter]
    public IReadOnlyList<CanvasWorkbenchInputOption> RepositoryOptions { get; set; } = [];

    [Parameter]
    public IReadOnlyList<ProjectStructureTaskResourceOption> AssigneeOptions { get; set; } = [];

    [Parameter]
    public IReadOnlyList<string> AssigneeWarnings { get; set; } = [];

    [Parameter]
    public Func<ProjectStructureTaskResourceCostRequest, CancellationToken, Task<ProjectStructureTaskResourceCostQuote>>? QuoteResolver { get; set; }

    protected override void OnParametersSet()
    {
        if (initialized)
        {
            return;
        }

        initialized = true;
        title = CreateRequest.Title ?? string.Empty;
        subtitle = CreateRequest.Subtitle ?? string.Empty;
        notes = CreateRequest.Notes ?? string.Empty;
        selectedAssignee = InitialAssignee;
        var inputValues = CreateRequest.InputValues ?? [];
        estimate = ResolveEstimate(inputValues);
        repositoryNodeId = inputValues
            .LastOrDefault(value => string.Equals(value.Key, "repositoryRef", StringComparison.OrdinalIgnoreCase))
            ?.Value;
        var dueValue = inputValues
            .LastOrDefault(value => string.Equals(value.Key, "dueUtc", StringComparison.OrdinalIgnoreCase))
            ?.Value;
        if (TryParseUtc(dueValue, out var parsedDue))
        {
            dueUtc = parsedDue;
        }
    }

    private Task HandleTitleChangedAsync(string? value)
    {
        title = value ?? string.Empty;
        validationError = string.Empty;
        return Task.CompletedTask;
    }

    private Task HandleSubtitleChangedAsync(string? value)
    {
        subtitle = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task HandleNotesChangedAsync(string? value)
    {
        notes = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task HandleRepositoryChangedAsync(string? value)
    {
        repositoryNodeId = string.IsNullOrWhiteSpace(value) ? null : value;
        return Task.CompletedTask;
    }

    private void HandleDueChanged(ChangeEventArgs args)
    {
        var text = Convert.ToString(args.Value, CultureInfo.InvariantCulture);
        if (string.IsNullOrWhiteSpace(text))
        {
            dueUtc = null;
            validationError = string.Empty;
            return;
        }

        if (!TryParseUtc(text, out var parsedDue))
        {
            validationError = "Enter a valid UTC due date and time.";
            return;
        }

        dueUtc = parsedDue;
        validationError = string.Empty;
    }

    private async Task SelectAssigneeAsync(ProjectStructureTaskResourceSelection selection)
    {
        selectedAssignee = selection;
        if (costEstimator is not null)
        {
            await costEstimator.EstimateSelectedAsync(selection, estimate);
        }
    }

    private void ClearAssignee()
    {
        selectedAssignee = null;
    }

    private Task HandleEstimateChangedAsync(ProjectTaskEstimate value)
    {
        estimate = value;
        validationError = string.Empty;
        return Task.CompletedTask;
    }

    private async Task SubmitAsync()
    {
        var normalizedTitle = title.Trim();
        if (normalizedTitle.Length == 0)
        {
            validationError = "Task title is required.";
            return;
        }

        if (normalizedTitle.Length > 200)
        {
            validationError = "Task title cannot exceed 200 characters.";
            return;
        }

        if (estimateEditor is null)
        {
            validationError = "Task estimate details are not ready.";
            return;
        }

        if (!estimateEditor.TryGetValue(out estimate, out var estimateError))
        {
            validationError = estimateError;
            return;
        }

        var inputValues = (CreateRequest.InputValues ?? [])
            .Where(value => !ControlledInputKeys.Contains(value.Key))
            .Select(value => new CanvasWorkbenchInputValue
            {
                Key = value.Key,
                Value = value.Value
            })
            .ToList();
        inputValues.Add(new CanvasWorkbenchInputValue
        {
            Key = "workItemKind",
            Value = "task"
        });
        AddInputValue(inputValues, "dueUtc", dueUtc?.ToString("O", CultureInfo.InvariantCulture));
        AddInputValue(inputValues, "repositoryRef", repositoryNodeId);
        AddEstimateInputValues(inputValues, estimate);

        var result = new ProjectStructureTaskDialogResult(
            CreateRequest with
            {
                Title = normalizedTitle,
                Subtitle = subtitle.Trim(),
                Notes = notes.Trim(),
                CreateMode = ProjectStructureTaskActionIds.CreateMode,
                ObjectSubtype = TaskSubtype,
                InputValues = inputValues
            },
            selectedAssignee);
        if (DialogReference is null)
        {
            await DialogService.CloseAsync(result);
            return;
        }

        await DialogReference.CloseAsync(result);
    }

    private Task CancelAsync()
        => DialogReference is null
            ? DialogService.CloseAsync()
            : DialogReference.CloseAsync();

    private static void AddInputValue(List<CanvasWorkbenchInputValue> values, string key, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        values.Add(new CanvasWorkbenchInputValue
        {
            Key = key,
            Value = value
        });
    }

    private static void AddEstimateInputValues(
        List<CanvasWorkbenchInputValue> values,
        ProjectTaskEstimate value)
    {
        var effortValue = ProjectTaskEstimatePolicy.ToInputValue(value);
        AddInputValue(
            values,
            ProjectTaskEstimateInputKeys.ExpectedEffortValue,
            effortValue?.ToString("0.####", CultureInfo.InvariantCulture));
        AddInputValue(
            values,
            ProjectTaskEstimateInputKeys.ExpectedEffortUnit,
            ToCamelCaseToken(value.ExpectedEffortUnit));
        AddInputValue(
            values,
            ProjectTaskEstimateInputKeys.ExpectedCostAmount,
            value.ExpectedCostAmount?.ToString("0.####", CultureInfo.InvariantCulture));
        AddInputValue(
            values,
            ProjectTaskEstimateInputKeys.ExpectedCostCurrencyCode,
            value.ExpectedCostAmount.HasValue ? value.ExpectedCostCurrencyCode : null);
    }

    private ProjectTaskEstimate ResolveEstimate(IReadOnlyList<CanvasWorkbenchInputValue> inputValues)
    {
        var values = inputValues
            .Where(value => !string.IsNullOrWhiteSpace(value.Key))
            .GroupBy(value => value.Key, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(
                group => group.Key,
                group => group.Last().Value?.Trim() ?? string.Empty,
                StringComparer.OrdinalIgnoreCase);
        try
        {
            var unit = ParseEffortUnit(values);
            var effortValue = values.ContainsKey(ProjectTaskEstimateInputKeys.ExpectedEffortValue)
                ? ParseOptionalDecimal(values, ProjectTaskEstimateInputKeys.ExpectedEffortValue, "Expected task effort")
                : 8m;
            var costAmount = ParseOptionalDecimal(
                values,
                ProjectTaskEstimateInputKeys.ExpectedCostAmount,
                "Expected task cost");
            var currencyCode = values.TryGetValue(ProjectTaskEstimateInputKeys.ExpectedCostCurrencyCode, out var currency)
                ? currency
                : CurrencyFormatter.CurrencyCode;
            return ProjectTaskEstimatePolicy.Create(
                effortValue,
                unit,
                costAmount,
                costAmount.HasValue ? currencyCode : string.Empty);
        }
        catch (InvalidOperationException exception)
        {
            validationError = exception.Message;
            return ProjectTaskEstimate.Empty(CurrencyFormatter.CurrencyCode);
        }
    }

    private static ProjectWorkItemEffortUnit ParseEffortUnit(IReadOnlyDictionary<string, string> values)
    {
        if (!values.TryGetValue(ProjectTaskEstimateInputKeys.ExpectedEffortUnit, out var value) ||
            string.IsNullOrWhiteSpace(value))
        {
            return ProjectWorkItemEffortUnit.Hours;
        }

        if (Enum.TryParse<ProjectWorkItemEffortUnit>(value, true, out var parsed) && Enum.IsDefined(parsed))
        {
            return parsed;
        }

        throw new InvalidOperationException("Expected task effort unit is invalid.");
    }

    private static decimal? ParseOptionalDecimal(
        IReadOnlyDictionary<string, string> values,
        string key,
        string fieldLabel)
    {
        if (!values.TryGetValue(key, out var text) || string.IsNullOrWhiteSpace(text))
        {
            return null;
        }

        if (decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out var parsed))
        {
            return parsed;
        }

        throw new InvalidOperationException($"{fieldLabel} must be a number.");
    }

    private static string ToCamelCaseToken(ProjectWorkItemEffortUnit value)
    {
        var token = value.ToString();
        return char.ToLowerInvariant(token[0]) + token[1..];
    }

    private static string FormatDateTimeLocal(DateTimeOffset? value)
        => value?.ToUniversalTime().ToString(DateTimeLocalFormat, CultureInfo.InvariantCulture) ?? string.Empty;

    private static bool TryParseUtc(string? value, out DateTimeOffset result)
    {
        if (DateTimeOffset.TryParse(
                value,
                CultureInfo.InvariantCulture,
                DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal,
                out var parsed))
        {
            result = parsed.ToUniversalTime();
            return true;
        }

        result = default;
        return false;
    }

}

@namespace CanDoItAll.Modules.Workbench.Pages
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using CanDoItAll.Components.Mermaid
@using CanDoItAll.Modules.Workbench
@using CanDoItAll.Modules.Workspace

@using CanDoItAll.Workbench.Content.UI.Analysis

@if (SummaryDialog is { } summary) {
    var close = CloseSummary;
    var workbook = ExportSummaryWorkbook;
    var gantt = ExportSummaryGantt;
    var change = ChangeSummaryStatus;
    <ContentProgressSummaryDialog State="@ProjectSummary(summary)"
        Actions="@(new((node, status) => change.InvokeAsync((node, status)), () => workbook.InvokeAsync(), () => gantt.InvokeAsync(), () => close.InvokeAsync()))" />
}

@if (PendingDeletePrompt is { } deletePrompt)
{
    var confirmDelete = ConfirmDelete;
    var cancelDelete = CancelDelete;
    <ProjectStructureOverlayDialog AriaLabel="@ResolveDeletePromptAriaLabel(deletePrompt)"
                                   Kicker="@(deletePrompt.IsBulk ? "Delete selection" : "Delete node")"
                                   Title="@deletePrompt.Title"
                                   Summary="@deletePrompt.ImpactCopy"
                                   DialogClass="project-structure-summary-dialog"
                                   Close="@(() => cancelDelete.InvokeAsync(deletePrompt))">
        <Body>
            @if (!string.IsNullOrWhiteSpace(DeleteFailure)) {
                <Alert AlertStyle="AlertStyle.Warning" data-testid="project-structure-delete-failure">@DeleteFailure</Alert>
            }
        </Body>
        <Actions>
            @if (deletePrompt.ManagedAttachmentCount > 0)
            {
                var deletesMultipleNodes = deletePrompt.IsBulk || deletePrompt.DescendantCount > 0;
                <Button Text="@(deletesMultipleNodes ? "Delete nodes only" : "Delete node only")"
                        ButtonStyle="ButtonStyle.Base"
                        Click="@(() => confirmDelete.InvokeAsync(new ProjectStructureDeleteConfirmation(deletePrompt, ProjectStructureManagedStorageDisposition.RetainManagedFiles)))" />
                <Button Text="@(deletesMultipleNodes
                    ? "Delete nodes and files"
                    : deletePrompt.ManagedAttachmentCount > 1
                        ? "Delete node and files"
                        : "Delete node and file")"
                        ButtonStyle="ButtonStyle.Danger"
                        Click="@(() => confirmDelete.InvokeAsync(new ProjectStructureDeleteConfirmation(deletePrompt, ProjectStructureManagedStorageDisposition.DeleteOwnedManagedFiles)))" />
            }
            else
            {
                <Button Text="@(deletePrompt.IsBulk ? "Delete selected" : "Delete")"
                        ButtonStyle="ButtonStyle.Danger"
                        Click="@(() => confirmDelete.InvokeAsync(new ProjectStructureDeleteConfirmation(deletePrompt, ProjectStructureManagedStorageDisposition.DeleteOwnedManagedFiles)))" />
            }
            <Button Text="Cancel"
                    Variant="Variant.Text"
                    ButtonStyle="ButtonStyle.Base"
                    Click="@(() => cancelDelete.InvokeAsync(deletePrompt))" />
        </Actions>
    </ProjectStructureOverlayDialog>
}

@if (PendingTranscriptAction is { } transcript) {
    var select = HandleTranscriptProviderChanged;
    var submit = ExecuteTranscriptAction;
    var close = CancelTranscriptAction;
    <ContentTranscriptDialog State="@ProjectTranscript(transcript)"
        Actions="@(new(id => select.InvokeAsync(new ChangeEventArgs { Value = id?.ToString() }), () => submit.InvokeAsync(), () => close.InvokeAsync()))" />
}

@if (MermaidPreviewNode is { } mermaid) {
    var edit = EditMermaidNode;
    var close = CloseMermaidViewer;
    <ContentLegacyMermaidDialog State="@(new(mermaid.Title, mermaid.Notes, ProjectObjectMetadataSerializer.DetectMermaidDiagramKind(mermaid.Notes).ToString(), CanEditMermaidNode(mermaid)) { OpeningId = MermaidOpeningId })"
        Edit="@(() => edit.InvokeAsync(mermaid))" Close="@(() => close.InvokeAsync())" />
}

@code {
    private ContentProgressSummary ProjectSummary(ProjectStructureSummaryDialogState state)
        => new(state.OpeningId, state.RootTitle, state.Summary.Rows.Select(row => new ContentProgressRow(row.NodeId,
            row.Title, row.KindLabel, row.Status, row.ProgressLabel, row.Depth,
            row.StartUtc is { } start ? TimeZoneInfo.ConvertTime(start, state.DisplayTimeZone).ToString("g") : "Undated",
            row.EndUtc is { } end ? TimeZoneInfo.ConvertTime(end, state.DisplayTimeZone).ToString("g") : string.Empty)).ToArray(),
            SummaryStatuses, state.Summary.CompletedCount, state.Summary.ActiveCount, state.Summary.BlockedCount,
            state.Summary.ReviewCount, state.Summary.UndatedCount, state.IsBusy, state.RequiresObservation, state.Message);

    private static ContentTranscriptConfirmation ProjectTranscript(ProjectStructureTranscriptActionDialogState state)
        => new(state.OpeningId, state.NodeTitle, state.ActionKind switch {
            ProjectLlmActionKind.Summarize => ContentTranscriptAction.Summarize,
            ProjectLlmActionKind.FindMyTasks => ContentTranscriptAction.FindMyTasks,
            ProjectLlmActionKind.FindOthersDeliveries => ContentTranscriptAction.FindOthersDeliveries,
            _ => throw new InvalidOperationException("Unknown transcript action.")
        }, state.Providers.Select(provider => new ContentProviderOption(provider.Id, provider.Name)).ToArray(),
            state.SelectedProviderId, state.LastProviderName, state.Phase, state.Error);

    [Parameter]
    public ProjectStructureSummaryDialogState? SummaryDialog { get; set; }

    [Parameter]
    public EventCallback CloseSummary { get; set; }

    [Parameter]
    public EventCallback ExportSummaryWorkbook { get; set; }

    [Parameter]
    public EventCallback ExportSummaryGantt { get; set; }

    [Parameter]
    public EventCallback<(string NodeId, string Status)> ChangeSummaryStatus { get; set; }

    [Parameter]
    public IReadOnlyList<string> SummaryStatuses { get; set; } = [];

    [Parameter]
    public ProjectStructureDeletePrompt? PendingDeletePrompt { get; set; }

    [Parameter]
    public string? DeleteFailure { get; set; }

    [Parameter]
    public EventCallback<ProjectStructureDeleteConfirmation> ConfirmDelete { get; set; }

    [Parameter]
    public EventCallback<ProjectStructureDeletePrompt> CancelDelete { get; set; }

    [Parameter]
    public ProjectStructureTranscriptActionDialogState? PendingTranscriptAction { get; set; }

    [Parameter]
    public EventCallback ExecuteTranscriptAction { get; set; }

    [Parameter]
    public EventCallback CancelTranscriptAction { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> HandleTranscriptProviderChanged { get; set; }

    [Parameter]
    public ProjectStructureNode? MermaidPreviewNode { get; set; }

    [Parameter]
    public Guid MermaidOpeningId { get; set; }

    [Parameter]
    public EventCallback CloseMermaidViewer { get; set; }

    [Parameter]
    public EventCallback<ProjectStructureNode> EditMermaidNode { get; set; }

    [Parameter, EditorRequired]
    public Func<ProjectStructureNode, bool> CanEditMermaidNode { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<ProjectLlmActionKind, string> ResolveTranscriptActionLabel { get; set; } = default!;

    private static string ResolveDeletePromptAriaLabel(ProjectStructureDeletePrompt prompt)
        => prompt.IsBulk
            ? $"Delete {prompt.NodeIds.Count} selected nodes"
            : $"Delete {prompt.Title}";
}

@using CanDoItAll.Modules.Projects
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Logging
@inject ProjectStructureChangeFeed Feed
@inject ProjectStructureChangeSession Session
@inject ILogger<ProjectStructureChangeObserver> Logger
@implements IAsyncDisposable

@code {
    [Parameter, EditorRequired] public ProjectStructureChangeInbox Inbox { get; set; } = default!;
    [Parameter] public ProjectWriteAdmission? Admission { get; set; }
    [Parameter] public ProjectStructureChangeCursor? InitialCursor { get; set; }
    [Parameter] public IReadOnlyCollection<Guid> ProjectIds { get; set; } = [];
    [Parameter] public Func<ProjectStructureChange, bool>? CanAutoRefresh { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    [CascadingParameter] public Task<AuthenticationState>? Authentication { get; set; }

    private CancellationTokenSource? lifetime;
    private Task observation = Task.CompletedTask;
    private Task stopping = Task.CompletedTask;
    private long observationGeneration;
    private bool disposed;
    private Guid[] observedProjects = [];
    private Task<AuthenticationState>? observedAuthentication;

    protected override async Task OnParametersSetAsync() {
        if (disposed || !RendererInfo.IsInteractive) {
            return;
        }
        var projects = Admission is { } target ? ProjectIds.Append(target.ProjectId).Distinct().Order().ToArray() : [];
        var identityChanged = Inbox.Admission != Admission || !ReferenceEquals(observedAuthentication, Authentication);
        if (!identityChanged && observedProjects.SequenceEqual(projects)) {
            return;
        }
        var generation = ++observationGeneration;
        var admission = Admission;
        var authentication = Authentication;
        var initialCursor = InitialCursor;
        observedProjects = projects;
        observedAuthentication = authentication;
        await StopAsync();
        if (disposed || generation != observationGeneration) {
            return;
        }
        if (identityChanged) {
            Inbox.Reset(admission, initialCursor);
        }
        if (admission is not { } targetAdmission) {
            return;
        }
        if (authentication is not null) {
            var actor = await authentication;
            if (disposed || generation != observationGeneration) {
                return;
            }
            Session.Actor = actor.User.Identity?.Name ?? "Another editor";
        }
        lifetime = new();
        var contextId = Inbox.ContextId;
        observation = ObserveAsync(targetAdmission, projects, contextId, lifetime.Token);
    }

    private async Task ObserveAsync(ProjectWriteAdmission admission, Guid[] projects, Guid contextId, CancellationToken cancellationToken) {
        try {
            while (!cancellationToken.IsCancellationRequested) {
                var batch = Feed.Read(admission.DatabaseProfileId, projects, Inbox.Cursor);
                await InvokeAsync(async () => {
                    if (contextId != Inbox.ContextId || cancellationToken.IsCancellationRequested) {
                        return;
                    }
                    Inbox.Receive(batch, Session.Id, CanAutoRefresh);
                    if (batch.Changes.Count > 0 || batch.RequiresRefresh) {
                        await Changed.InvokeAsync();
                    }
                }).WaitAsync(cancellationToken);
                await Feed.WaitAsync(batch.Cursor, cancellationToken);
            }
        } catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) {
        } catch (Exception exception) {
            Logger.LogWarning(exception, "Project structure change observation failed for project {ProjectId}.", admission.ProjectId);
            await InvokeAsync(async () => {
                if (contextId == Inbox.ContextId && !cancellationToken.IsCancellationRequested) {
                    Inbox.FailRefresh("Live updates are unavailable. Refresh the structure or reopen the project to reconnect.");
                    await Changed.InvokeAsync();
                }
            }).WaitAsync(cancellationToken);
        }
    }

    private Task StopAsync() {
        if (lifetime is not { } ownedLifetime) {
            return stopping;
        }
        lifetime = null;
        var pending = observation;
        observation = Task.CompletedTask;
        return stopping = StopObservationAsync(ownedLifetime, pending);
    }

    private static async Task StopObservationAsync(CancellationTokenSource ownedLifetime, Task pending) {
        await ownedLifetime.CancelAsync();
        try {
            await pending;
        } catch (OperationCanceledException) when (ownedLifetime.IsCancellationRequested) {
        } finally {
            ownedLifetime.Dispose();
        }
    }

    public ValueTask DisposeAsync() {
        disposed = true;
        observationGeneration++;
        return new(StopAsync());
    }
}

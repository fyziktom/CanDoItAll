@namespace CanDoItAll.Modules.Workbench.Pages
@using CanDoItAll.Workbench.Operators.UI.Runtime
@inject DialogService DialogService
@{
    var reference = DialogReference;
}
<OperatorRuntimeApproval DisplayName="@DisplayName" Review="@Review"
    Decide="@(approved => reference is null ? DialogService.CloseAsync(approved) : reference.CloseAsync(approved))" />

@code {
    [CascadingParameter] public DialogReference? DialogReference { get; set; }
    [Parameter, EditorRequired] public string DisplayName { get; set; } = string.Empty;
    [Parameter] public string Review { get; set; } = string.Empty;
}

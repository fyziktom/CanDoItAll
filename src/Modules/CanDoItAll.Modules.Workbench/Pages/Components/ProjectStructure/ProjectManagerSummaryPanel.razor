@using Microsoft.AspNetCore.Components.Authorization
@using CanDoItAll.Infrastructure.ControlPlane
@using CanDoItAll.Infrastructure.Persistence
@using CanDoItAll.Modules.Projects
@using CanDoItAll.Workbench.Insights.UI
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject ProjectManagerSummaryScopeResolver ScopeResolver
@inject ProjectManagerSummaryQueryService SummaryQueryService
@inject ProjectManagerSummaryStateStore StateStore
@inject ProjectWriteAdmissionService Admissions
@inject IDatabaseProfileRuntimeAccessor Runtime
@inject IDatabaseSwitchNotificationService DatabaseChanges
@inject ILogger<ProjectManagerSummarySource> Logger

@if (session is not null) {
    <CanDoItAll.Workbench.Insights.UI.ProjectManagerSummaryPanel @key="session" Session="session" />
}

@code {
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter] public ProjectWriteAdmission? ExpectedProjectAdmission { get; set; }
    [CascadingParameter] public Task<AuthenticationState>? AuthenticationState { get; set; }
    private ManagerSummarySession? session;
    private (Guid Project, Guid Profile, ProjectWriteAdmission? Admission, string Actor)? applied;
    private Task<AuthenticationState>? appliedAuthentication;
    private Guid origin;
    private long parameterGeneration;
    private bool disposed;

    protected override void OnInitialized() => DatabaseChanges.Changed += OnDatabaseChanged;

    protected override async Task OnParametersSetAsync() {
        var request = ++parameterGeneration;
        var projectId = ProjectId;
        var admission = ExpectedProjectAdmission;
        var authentication = AuthenticationState;
        if (applied?.Project != projectId || applied?.Admission != admission || !ReferenceEquals(appliedAuthentication, authentication)) {
            Retire();
        }
        var actor = authentication is null ? null : (await authentication).User;
        if (disposed || request != parameterGeneration) {
            return;
        }
        var stamp = ProjectManagerSummarySource.ActorStamp(actor);
        var retained = StateStore.GetOrCreate(projectId);
        var context = (projectId, retained.ProfileId, admission, stamp);
        if (context == applied && session is not null) {
            return;
        }
        Retire();
        var captured = origin;
        applied = context;
        appliedAuthentication = authentication;
        var source = new ProjectManagerSummarySource(projectId, admission, stamp, retained,
            ScopeResolver, SummaryQueryService, Admissions, Runtime, () => !disposed && origin == captured, Logger);
        session = new(source, retained.Options, source.Restore());
    }

    private void Retire() {
        origin = Guid.NewGuid();
        session?.Dispose();
        session = null;
    }

    private void OnDatabaseChanged(object? sender, DatabaseProfileChangedNotification notification) {
        if (!disposed && applied?.Profile != Runtime.ResolveCurrentProfile().Profile.Id) {
            Retire();
            _ = InvokeAsync(async () => {
                await OnParametersSetAsync();
                if (!disposed) {
                    StateHasChanged();
                }
            });
        }
    }

    public void Dispose() {
        disposed = true;
        parameterGeneration++;
        DatabaseChanges.Changed -= OnDatabaseChanged;
        Retire();
    }
}

@namespace CanDoItAll.Modules.Workbench.Pages
@using CanDoItAll.Workbench.Content.UI
@implements IDisposable
@inject FileInteractionComponentComposition InteractionComposition

@if (opening is not null) {
    <ContentFileInteractionDialog Opening="opening" />
}

@code {
    [Parameter, EditorRequired] public ProjectStructureNode Node { get; set; } = default!;
    [Parameter] public ProjectStructureKnownFileInteraction? Interaction { get; set; }
    [Parameter] public EventCallback Close { get; set; }
    [Parameter] public EventCallback<ProjectStructureNode> OpenLocally { get; set; }
    [Parameter] public EventCallback<ProjectStructureNode> OpenInPreferredApplication { get; set; }
    [Parameter] public EventCallback<ProjectStructureNode> EditNode { get; set; }
    [Parameter, EditorRequired] public Func<ProjectStructureNode, bool> CanShowLocalOpen { get; set; } = default!;
    [Parameter, EditorRequired] public Func<ProjectStructureNode, bool> CanOpenInPreferredApplication { get; set; } = default!;
    [Parameter, EditorRequired] public Func<ProjectStructureNode, bool> CanEditNode { get; set; } = default!;
    private ProjectStructureKnownFileInteraction? capturedInteraction;
    private ProjectStructureNode? capturedNode;
    private ContentFileInteractionOpening? opening;
    private bool disposed;

    protected override void OnParametersSet() {
        if (opening is not null && ReferenceEquals(capturedInteraction, Interaction) &&
            capturedNode?.Id == Node.Id && capturedNode.RecordId == Node.RecordId) {
            return;
        }
        var node = Node;
        var interaction = Interaction;
        var closed = Close;
        var edit = EditNode;
        var local = OpenLocally;
        var preferred = OpenInPreferredApplication;
        capturedInteraction = interaction;
        capturedNode = node;
        ContentFileInteractionOpening? receiver = null;
        bool IsCurrent() => !disposed && ReferenceEquals(opening, receiver) && ReferenceEquals(capturedInteraction, interaction);
        Task InvokeAsync(EventCallback<ProjectStructureNode> callback) => IsCurrent() ? callback.InvokeAsync(node) : Task.CompletedTask;
        receiver = new() {
            Title = ProjectStructureNodeHelpers.ResolveAttachmentDisplayName(node),
            Notice = interaction?.HostNotice ?? ProjectStructureNodeHelpers.ResolveAttachmentLeadCopy(node),
            Request = interaction?.Request,
            ContentSource = interaction?.Session.ContentSource,
            Composition = InteractionComposition,
            MaximumContentBytes = ProjectStructureFileInteractionPolicy.MaximumContentBytes,
            ChangeMode = interaction is null ? null : mode => {
                if (!IsCurrent()) {
                    throw new InvalidOperationException("The original file interaction has retired.");
                }
                return interaction.WithMode(mode);
            },
            Save = interaction?.CanEdit != true ? null : args => IsCurrent()
                ? interaction.SaveAsync(args) : Task.FromException(new InvalidOperationException("The original file interaction has retired.")),
            ReadNotes = async cancellationToken => interaction is null ? null
                : await ProjectStructureAttachmentNotesResolver.ResolveSupplementalNotesAsync(node, interaction, cancellationToken),
            Close = EventCallback.Factory.Create(this, () => IsCurrent() ? closed.InvokeAsync() : Task.CompletedTask),
            EditDetails = CanEditNode(node) ? EventCallback.Factory.Create(this, () => InvokeAsync(edit)) : default,
            OpenPreferred = CanOpenInPreferredApplication(node) ? EventCallback.Factory.Create(this, () => InvokeAsync(preferred)) : default,
            ShowInFolder = CanShowLocalOpen(node) ? EventCallback.Factory.Create(this, () => InvokeAsync(local)) : default
        };
        opening = receiver;
    }

    public void Dispose() => disposed = true;
}

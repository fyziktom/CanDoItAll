@namespace CanDoItAll.Modules.Workbench.Pages
@using CanDoItAll.Workbench.Planning.UI
@{
    var agentsCallback = OpenAgentCatalog;
}
<PlanningGanttSurface Presentation="@BuildPresentation()" DependencyIdFactory="CreateDependencyId"
                      ToolbarSupplement="@ToolbarSupplement" OverlayContent="@OverlayContent"
                      TitleChanged="@(intent => AcceptAsync(intent.Origin, () => ApplyTitleAsync(intent.Value)))"
                      ScheduleChanged="@(intent => AcceptAsync(intent.Origin, () => ApplyScheduleAsync(intent.Value)))"
                      DependencyChanged="@(intent => AcceptAsync(intent.Origin, () => ApplyDependencyAsync(intent.Value)))"
                      TaskInserted="@(intent => AcceptAsync(intent.Origin, () => ApplyInsertionAsync(intent.Value)))"
                      TimelineOpened="@(intent => AcceptAsync(intent.Origin, () => OpenTimelineTaskDialogAsync(intent.Value)))"
                      TaskOpened="@(intent => AcceptAsync(intent.Origin, () => OpenTaskDetailsDialogAsync(intent.Value)))"
                      OrderChanged="@(intent => AcceptAsync(intent.Origin, () => ApplyTaskOrderAsync(intent.Value)))"
                      AddRequested="@(intent => AcceptAsync(intent.Origin, OpenGeneralTaskDialogAsync))"
                      ExportRequested="@(intent => AcceptAsync(intent.Origin, OpenMermaidPreviewAsync))"
                      PreviewClosed="@(intent => AcceptAsync(intent.Origin, CloseMermaidPreviewAsync))"
                      ReloadRequested="@(intent => AcceptAsync(intent.Origin, ReloadScheduleAsync))"
                      AgentsRequested="@(intent => AcceptAsync(intent.Origin, () => agentsCallback.InvokeAsync()))" />

@using CanDoItAll.Workbench.Execution.UI.Workflows
@using CanDoItAll.Workbench.Execution.UI.Processes
@namespace CanDoItAll.Modules.Workbench.Pages
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using CanDoItAll.AgentFramework.Models
@using CanDoItAll.SharedKernel

@if (ProcessLinkDialog is { } processLink) {
    var close = CloseProcessLink;
    var select = ProcessLinkSelectionChanged;
    var submit = ExecuteProcessLink;
    <ProcessLinkDialog @key="processLink.DialogId" View="@ProjectStructureProcessPresentation.Link(processLink)"
        Actions="@(new(id => select.InvokeAsync(id), () => submit.InvokeAsync(), () => close.InvokeAsync()))" />
}

@if (WorkflowAddDialog is { } workflowAdd) {
    var select = WorkflowAddSelectionChanged;
    var subtree = WorkflowAddIncludeParentSubtreeChanged;
    var assets = WorkflowAddIncludeAssetsChanged;
    var manual = WorkflowAddManualInputChanged;
    var kind = WorkflowAddSourceKindChanged;
    var key = WorkflowAddSourceKeyChanged;
    var label = WorkflowAddSourceLabelChanged;
    var value = WorkflowAddSourceValueChanged;
    var submit = ExecuteWorkflowAdd;
    var close = CloseWorkflowAdd;
    <WorkflowAddDialog @key="workflowAdd.OpeningId" View="@ProjectStructureWorkflowPresentation.Add(workflowAdd)"
        Actions="@(new(select.InvokeAsync,
            enabled => subtree.InvokeAsync(new ChangeEventArgs { Value = enabled }),
            enabled => assets.InvokeAsync(new ChangeEventArgs { Value = enabled }),
            text => manual.InvokeAsync(new ChangeEventArgs { Value = text }),
            selected => kind.InvokeAsync(new ChangeEventArgs { Value = ProjectStructureWorkflowPresentation.SourceKind(selected).ToString() }),
            text => key.InvokeAsync(new ChangeEventArgs { Value = text }),
            text => label.InvokeAsync(new ChangeEventArgs { Value = text }),
            text => value.InvokeAsync(new ChangeEventArgs { Value = text }), submit.InvokeAsync, close.InvokeAsync))" />
}

@if (WorkflowStartDialog is { } workflowStart) {
    var simulation = WorkflowStartSimulationChanged;
    var submit = ExecuteWorkflowStart;
    var close = CloseWorkflowStart;
    <WorkflowStartDialog @key="workflowStart.OpeningId" View="@ProjectStructureWorkflowPresentation.Start(workflowStart)"
        Actions="@(new(change => simulation.InvokeAsync(new ProjectStructureWorkflowStartSimulationChange(change.NodeId.Value, change.IsEnabled)),
            submit.InvokeAsync, close.InvokeAsync))" />
}

@if (QuickActionDialog is { } quick) {
    var dispatch = ExecuteQuickAction;
    var close = CloseQuickActionDialog;
    var actions = quick.Actions.ToArray();
    <CanDoItAll.Workbench.Operators.UI.Runtime.OperatorQuickActions @key="quick.OpeningId"
        View="@(new(quick.OpeningId, quick.Title, quick.NodeLabel, quick.Copy, quick.Notes,
            actions.Select((action, index) => ToOperatorAction(action, index)).ToArray()))"
        Execute="@(index => dispatch.InvokeAsync(actions[index]))" Close="close" />
}

@if (WebPreviewDialog is not null) {
    <ProjectStructureWebPreviewDialog State="WebPreviewDialog"
                                      StopRuntime="StopWebPreviewRuntime"
                                      Close="CloseWebPreviewDialog" />
}

@if (RenderProcessStartDialog && ProcessStartDialog is { } startDialog) {
    if (startDialog.Stage == ProjectStructureProcessStartStage.Staffing) {
        <ProjectStructureProcessAssignmentDialog @key="startDialog.DialogId" Dialog="@startDialog"
            Close="CloseProcessStart" ReviewAndStartProcess="ReviewAndStartProcess"
            PrepareAnotherProcessLaunch="PrepareAnotherProcessLaunch" RequestHrManagerMatch="RequestHrManagerMatch"
            CancelHrManagerMatch="CancelHrManagerMatch" ExecuteHrManagerMatch="ExecuteHrManagerMatch"
            SelectProcessStartCandidate="SelectProcessStartCandidate" AssignProcessStartAgent="AssignProcessStartAgent" />
    } else {
        var close = CloseProcessStart;
        var submit = ExecuteProcessStart;
        var prepare = PrepareAnotherProcessLaunch;
        <ProcessStartDialog @key="startDialog.DialogId" View="@ProjectStructureProcessPresentation.Start(startDialog)"
            Actions="@(new(() => submit.InvokeAsync(), () => prepare.InvokeAsync(), () => close.InvokeAsync()))" />
    }
}

@if (PreviewNode is not null) {
    <ProjectStructureAttachmentPreviewDialog Node="PreviewNode"
                                             Interaction="PreviewInteraction"
                                             Close="CloseAttachmentPreview"
                                             OpenLocally="OpenAttachmentLocally"
                                             OpenInPreferredApplication="OpenAttachmentInPreferredApplication"
                                             EditNode="EditPreviewNode"
                                             CanShowLocalOpen="CanShowLocalOpen"
                                             CanOpenInPreferredApplication="CanOpenInPreferredApplication"
                                             CanEditNode="CanEditPreviewNode" />
}

@code {
    [Parameter]
    public ProjectStructureProcessLinkDialogState? ProcessLinkDialog { get; set; }

    [Parameter]
    public EventCallback CloseProcessLink { get; set; }

    [Parameter]
    public EventCallback<Guid> ProcessLinkSelectionChanged { get; set; }

    [Parameter]
    public EventCallback ExecuteProcessLink { get; set; }

    [Parameter]
    public ProjectStructureWorkflowAddDialogState? WorkflowAddDialog { get; set; }

    [Parameter]
    public EventCallback CloseWorkflowAdd { get; set; }

    [Parameter]
    public EventCallback<WorkflowId> WorkflowAddSelectionChanged { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> WorkflowAddIncludeParentSubtreeChanged { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> WorkflowAddIncludeAssetsChanged { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> WorkflowAddManualInputChanged { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> WorkflowAddSourceKindChanged { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> WorkflowAddSourceKeyChanged { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> WorkflowAddSourceLabelChanged { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> WorkflowAddSourceValueChanged { get; set; }

    [Parameter]
    public EventCallback ExecuteWorkflowAdd { get; set; }

    [Parameter]
    public ProjectStructureWorkflowStartDialogState? WorkflowStartDialog { get; set; }

    [Parameter]
    public EventCallback CloseWorkflowStart { get; set; }

    [Parameter]
    public EventCallback<ProjectStructureWorkflowStartSimulationChange> WorkflowStartSimulationChanged { get; set; }

    [Parameter]
    public EventCallback ExecuteWorkflowStart { get; set; }

    [Parameter]
    public bool RenderProcessStartDialog { get; set; } = true;

    [Parameter]
    public ProjectStructureProcessStartDialogState? ProcessStartDialog { get; set; }

    [Parameter]
    public EventCallback CloseProcessStart { get; set; }

    [Parameter]
    public EventCallback ExecuteProcessStart { get; set; }

    [Parameter]
    public EventCallback ReviewAndStartProcess { get; set; }

    [Parameter]
    public EventCallback PrepareAnotherProcessLaunch { get; set; }

    [Parameter]
    public EventCallback<ProjectStructureProcessStartCandidateSelection> SelectProcessStartCandidate { get; set; }

    [Parameter]
    public EventCallback<Guid> AssignProcessStartAgent { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> ProcessStartAssignmentsReviewedChanged { get; set; }

    [Parameter]
    public EventCallback RequestHrManagerMatch { get; set; }

    [Parameter]
    public EventCallback CancelHrManagerMatch { get; set; }

    [Parameter]
    public EventCallback ExecuteHrManagerMatch { get; set; }

    [Parameter]
    public ProjectStructureQuickActionDialogState? QuickActionDialog { get; set; }

    [Parameter]
    public EventCallback CloseQuickActionDialog { get; set; }

    [Parameter]
    public EventCallback<ProjectStructureQuickActionButton> ExecuteQuickAction { get; set; }

    [Parameter]
    public ProjectStructureWebPreviewDialogState? WebPreviewDialog { get; set; }

    [Parameter]
    public EventCallback CloseWebPreviewDialog { get; set; }

    [Parameter]
    public EventCallback<string> StopWebPreviewRuntime { get; set; }

    [Parameter]
    public ProjectStructureNode? PreviewNode { get; set; }

    [Parameter]
    public ProjectStructureKnownFileInteraction? PreviewInteraction { get; set; }

    [Parameter]
    public EventCallback CloseAttachmentPreview { get; set; }

    [Parameter]
    public EventCallback<ProjectStructureNode> OpenAttachmentLocally { get; set; }

    [Parameter]
    public EventCallback<ProjectStructureNode> OpenAttachmentInPreferredApplication { get; set; }

    [Parameter]
    public EventCallback<ProjectStructureNode> EditPreviewNode { get; set; }

    [Parameter, EditorRequired]
    public Func<ProjectStructureNode, bool> CanShowLocalOpen { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<ProjectStructureNode, bool> CanOpenInPreferredApplication { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<ProjectStructureNode, bool> CanEditPreviewNode { get; set; } = default!;

    private static CanDoItAll.Workbench.Operators.UI.Runtime.OperatorQuickAction ToOperatorAction(ProjectStructureQuickActionButton action, int index)
        => new(index, action.Label, action.Description, action.Icon, action.Tone switch {
            "danger" => CanDoItAll.Workbench.Operators.UI.Runtime.OperatorActionTone.Danger,
            "warn" => CanDoItAll.Workbench.Operators.UI.Runtime.OperatorActionTone.Warning,
            "mint" => CanDoItAll.Workbench.Operators.UI.Runtime.OperatorActionTone.Success,
            "sky" => CanDoItAll.Workbench.Operators.UI.Runtime.OperatorActionTone.Information,
            _ => CanDoItAll.Workbench.Operators.UI.Runtime.OperatorActionTone.Primary
        }, action.ExecutionKind == ProjectStructureQuickActionExecutionKind.Edit
            ? "project-structure-quick-action-edit"
            : $"project-structure-quick-action-{NormalizeTestIdToken(action.ActionId)}", action.IsDisabled);

    private static string NormalizeTestIdToken(string value)
        => string.IsNullOrWhiteSpace(value)
            ? "primary"
            : value.Trim().ToLowerInvariant().Replace(':', '-');

}

@namespace CanDoItAll.Modules.Workbench.Pages
@using CanDoItAll.Workbench.Content.UI
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject ProjectStructureFileActionCoordinator Coordinator
@inject IFileToolsBrowseItemActionService ItemActionService
@inject FileInteractionComponentComposition InteractionComposition
@inject ILogger<ProjectStructureFileBrowserWindow> Logger
@inject IJSRuntime JSRuntime

@{
    var renderedOpening = Opening;
    var stateReceiver = StateChanged;
}
<ContentFileCollectionWindow WindowId="@WindowId" WindowState="State"
                             StateChanged="@(state => ChangeWindowStateAsync(renderedOpening, stateReceiver, state))" State="BuildView()" />

@code {
    private readonly HashSet<BrowserOperation> pending = [];
    private readonly HashSet<(Guid Opening, FileBrowserItemKey Item, FileToolsHostAction Action)> pendingActions = [];
    private readonly HashSet<(Guid Opening, FileBrowserItemKey Item, FileToolsHostAction Action)> unconfirmedActions = [];
    private ProjectStructureFileCollectionOpening? activeOpening;
    private ProjectStructureFileBrowserWorkspace? workspace;
    private ProjectStructureKnownFileInteraction? interaction;
    private FileBrowserItemKey? interactionItemKey;
    private IFileBrowserHostActionCatalog? hostActionCatalog;
    private FileToolsHostActionRunner? actionRunner;
    private BrowserOperation? operation;
    private FileBrowserSnapshot? snapshot;
    private string? openError;
    private string? activationError;
    private string? actionFeedback;
    private bool includeSubprojects = true;
    private bool isLoading;
    private bool disposed;

    [Parameter, EditorRequired] public string WindowId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public ProjectStructureFileCollectionOpening Opening { get; set; } = default!;
    [Parameter, EditorRequired] public CanvasWorkbenchWindowState State { get; set; } = default!;
    [Parameter] public EventCallback<CanvasWorkbenchWindowState> StateChanged { get; set; }
    [Parameter] public bool CanOpenRootInExplorer { get; set; }
    [Parameter] public EventCallback OpenRootInExplorer { get; set; }
    [Parameter] public EventCallback<ProjectStructureFileActionOutcome> ActionCompleted { get; set; }
    public ProjectStructureFileCollectionRequest Request => Opening.Request;

    protected override async Task OnParametersSetAsync() {
        ArgumentException.ThrowIfNullOrWhiteSpace(WindowId);
        ArgumentNullException.ThrowIfNull(Opening);
        if (ReferenceEquals(activeOpening, Opening)) {
            return;
        }
        activeOpening = Opening;
        unconfirmedActions.Clear();
        includeSubprojects = true;
        await OpenAsync(Opening);
    }

    private bool IsCurrent(ProjectStructureFileCollectionOpening opening)
        => !disposed && ReferenceEquals(activeOpening, opening) && ReferenceEquals(Opening, opening);

    private bool IsCurrent(BrowserOperation candidate)
        => IsCurrent(candidate.Opening) && ReferenceEquals(operation, candidate) && !candidate.Token.IsCancellationRequested;

    private Task ChangeWindowStateAsync(ProjectStructureFileCollectionOpening origin, EventCallback<CanvasWorkbenchWindowState> receiver, CanvasWorkbenchWindowState state)
        => IsCurrent(origin) ? receiver.InvokeAsync(state) : Task.CompletedTask;

    private ContentFileCollectionState BuildView() {
        var origin = Opening;
        var currentWorkspace = workspace;
        var currentInteraction = interaction;
        var itemKey = interactionItemKey;
        var openRoot = OpenRootInExplorer;
        return new() {
            OpeningId = origin.Id,
            Title = origin.Request.DisplayName,
            Summary = currentInteraction is not null ? "Authorized read-only file" : currentWorkspace is null
                ? "Compact collection browser" : $"{currentWorkspace.SourceCount} source(s) · revision {currentWorkspace.Revision[..12]}",
            SourceStatus = currentInteraction is not null ? "File open" : snapshot?.Search is { } search
                ? $"{snapshot.Items.Count} visible · {search.ScannedItems} inspected"
                : currentWorkspace is null ? "Resolving" : $"{currentWorkspace.SourceCount} source(s)",
            IsProjectCollection = origin.Request is ProjectStructureProjectFileCollectionRequest,
            IncludeSubprojects = includeSubprojects,
            IsLoading = isLoading,
            OpenError = openError,
            ActivationError = activationError,
            ActionFeedback = actionFeedback,
            Retry = EventCallback.Factory.Create(this, () => OpenAsync(origin)),
            Back = EventCallback.Factory.Create(this, () => CloseInteractionAsync(origin, currentInteraction)),
            IncludeSubprojectsChanged = EventCallback.Factory.Create<bool>(this, value => ChangeSubprojectsAsync(origin, value)),
            OpenRoot = CanOpenRootInExplorer ? EventCallback.Factory.Create(this, () => OpenRootAsync(origin, openRoot)) : default,
            Browse = currentWorkspace is null || hostActionCatalog is null ? null : new(currentWorkspace.Browser, hostActionCatalog,
                EventCallback.Factory.Create<FileBrowserSnapshot>(this, value => SnapshotChanged(origin, currentWorkspace, value)),
                EventCallback.Factory.Create<FileBrowserItemInvokedEventArgs>(this, value => ActivateAsync(origin, currentWorkspace, value)),
                EventCallback.Factory.Create<FileBrowserItemActionEventArgs>(this, value => ActionRequestedAsync(origin, currentWorkspace, value))),
            Preview = currentInteraction is null ? null : new(currentInteraction.Request, currentInteraction.Session.ContentSource,
                InteractionComposition, ProjectStructureFileInteractionPolicy.MaximumContentBytes,
                currentWorkspace is not null && itemKey is { } key && SupportsLocalOpen(currentWorkspace, key.SourceId)
                    ? EventCallback.Factory.Create<FileInteractionRequest>(this, value =>
                        ReferenceEquals(interaction, currentInteraction) && value.File == currentInteraction.Request.File
                            ? ExecuteFileActionAsync(origin, currentWorkspace, key, FileToolsHostAction.OpenInPreferredApplication)
                            : Task.CompletedTask) : default)
        };
    }

    private async Task OpenRootAsync(ProjectStructureFileCollectionOpening origin, EventCallback receiver) {
        if (!IsCurrent(origin)) {
            return;
        }
        await origin.EnsureCurrentAsync(CancellationToken.None);
        if (IsCurrent(origin)) {
            await receiver.InvokeAsync();
        }
    }

    private async Task ChangeSubprojectsAsync(ProjectStructureFileCollectionOpening origin, bool value) {
        if (!IsCurrent(origin) || includeSubprojects == value) {
            return;
        }
        includeSubprojects = value;
        await OpenAsync(origin);
    }

    private async Task OpenAsync(ProjectStructureFileCollectionOpening origin) {
        if (!IsCurrent(origin)) {
            return;
        }
        var current = BeginOperation(origin);
        var requestedSubprojects = includeSubprojects;
        isLoading = true;
        openError = null;
        activationError = null;
        actionFeedback = null;
        snapshot = null;
        ProjectStructureFileBrowserWorkspace? opened = null;
        try {
            await DisposeRuntimeAsync();
            await origin.EnsureCurrentAsync(current.Token);
            if (!IsCurrent(current)) {
                return;
            }
            opened = await Coordinator.OpenAsync(origin.Request, requestedSubprojects, current.Token);
            await origin.EnsureCurrentAsync(current.Token);
            if (!IsCurrent(current)) {
                return;
            }
            var accepted = opened;
            workspace = accepted;
            hostActionCatalog = new DefaultFileToolsHostActionCatalog(
                sourceId => new(accepted.SupportsLocalOpen(sourceId), accepted.SupportsDownload(sourceId)),
                ItemActionService.IsLocalLaunchAvailable, ProjectStructureFileBrowserHostActions.GetAdditionalActionsAsync);
            snapshot = accepted.Browser.Snapshot;
            opened = null;
        } catch (OperationCanceledException) when (current.Token.IsCancellationRequested) {
        } catch (Exception exception) {
            Logger.LogWarning(exception, "File collection opening failed. OpeningId={OpeningId} RequestIdentity={RequestIdentity}.", origin.Id, origin.Request.Identity);
            if (IsCurrent(current)) {
                openError = SafeMessage(exception, "Unable to open Project Structure files.");
            }
        } finally {
            if (IsCurrent(current)) {
                isLoading = false;
            }
            try {
                if (opened is not null) {
                    await opened.DisposeAsync();
                }
            } finally {
                Complete(current);
            }
        }
    }

    private Task ActivateAsync(ProjectStructureFileCollectionOpening origin, ProjectStructureFileBrowserWorkspace target, FileBrowserItemInvokedEventArgs args) {
        if (!IsCurrent(origin) || !ReferenceEquals(workspace, target) || args.Item.IsContainer) {
            return Task.CompletedTask;
        }
        return args.Kind is FileBrowserInvocationKind.PointerDoubleClick or FileBrowserInvocationKind.Keyboard &&
            !FileInteractionDefaultActivationPolicy.ShouldOpenInternally(args.Item, InteractionComposition.Core) && SupportsLocalOpen(target, args.Item.Key.SourceId)
                ? ExecuteFileActionAsync(origin, target, args.Item.Key, FileToolsHostAction.OpenInPreferredApplication)
                : PreviewAsync(origin, target, args.Item.Key);
    }

    private async Task PreviewAsync(ProjectStructureFileCollectionOpening origin, ProjectStructureFileBrowserWorkspace target, FileBrowserItemKey itemKey) {
        if (!IsCurrent(origin) || !ReferenceEquals(workspace, target)) {
            return;
        }
        var current = BeginOperation(origin);
        activationError = null;
        actionFeedback = null;
        var previous = DetachInteraction();
        ProjectStructureKnownFileInteraction? activated = null;
        try {
            if (previous is not null) {
                await previous.DisposeAsync();
            }
            await origin.EnsureCurrentAsync(current.Token);
            if (!IsCurrent(current) || !ReferenceEquals(workspace, target)) {
                return;
            }
            activated = await Coordinator.ActivateAsync(target, itemKey, current.Token);
            await origin.EnsureCurrentAsync(current.Token);
            if (!IsCurrent(current) || !ReferenceEquals(workspace, target)) {
                return;
            }
            interaction = activated;
            interactionItemKey = itemKey;
            activated = null;
        } catch (OperationCanceledException) when (current.Token.IsCancellationRequested) {
        } catch (Exception exception) {
            Logger.LogWarning(exception, "File activation failed. OpeningId={OpeningId} RequestIdentity={RequestIdentity}.", origin.Id, origin.Request.Identity);
            if (IsCurrent(current)) {
                activationError = SafeMessage(exception, "Unable to open the selected file.");
            }
        } finally {
            try {
                if (activated is not null) {
                    await activated.DisposeAsync();
                }
            } finally {
                Complete(current);
            }
        }
    }

    private async Task CloseInteractionAsync(ProjectStructureFileCollectionOpening origin, ProjectStructureKnownFileInteraction? expected) {
        if (!IsCurrent(origin) || !ReferenceEquals(interaction, expected)) {
            return;
        }
        operation?.Cancel();
        operation = null;
        var previous = DetachInteraction();
        if (previous is not null) {
            await previous.DisposeAsync();
        }
    }

    private Task ActionRequestedAsync(ProjectStructureFileCollectionOpening origin, ProjectStructureFileBrowserWorkspace target, FileBrowserItemActionEventArgs args) {
        if (!IsCurrent(origin) || !ReferenceEquals(workspace, target) || args.Origin != FileBrowserActionOrigin.Host) {
            return Task.CompletedTask;
        }
        return args.ActionId switch {
            FileBrowserActionIds.Open => ExecuteFileActionAsync(origin, target, args.Item.Key, FileToolsHostAction.OpenInPreferredApplication),
            ProjectStructureFileBrowserActionIds.Preview => PreviewAsync(origin, target, args.Item.Key),
            FileToolsBrowseHostActionIds.OpenContainingFolder => ExecuteFileActionAsync(origin, target, args.Item.Key, FileToolsHostAction.OpenContainingFolder),
            FileBrowserActionIds.Download => ExecuteFileActionAsync(origin, target, args.Item.Key, FileToolsHostAction.Download),
            _ => Task.FromException(new InvalidOperationException("The selected file action is not supported by this host."))
        };
    }

    private async Task ExecuteFileActionAsync(ProjectStructureFileCollectionOpening origin, ProjectStructureFileBrowserWorkspace target,
        FileBrowserItemKey itemKey, FileToolsHostAction action) {
        if (!IsCurrent(origin) || !ReferenceEquals(workspace, target)) {
            return;
        }
        var attempt = (origin.Id, itemKey, action);
        if (unconfirmedActions.Contains(attempt)) {
            activationError = "Observe the original unconfirmed file action before opening a new interaction.";
            return;
        }
        if (!pendingActions.Add(attempt)) {
            return;
        }
        var current = BeginOperation(origin);
        var completed = ActionCompleted;
        var dispatched = false;
        ProjectStructureFileActionOutcome? outcome = null;
        activationError = null;
        actionFeedback = null;
        try {
            await origin.EnsureCurrentAsync(current.Token);
            if (!IsCurrent(current) || !ReferenceEquals(workspace, target)) {
                return;
            }
            var runner = actionRunner ??= new FileToolsHostActionRunner(JSRuntime);
            dispatched = true;
            var result = await runner.ExecuteAsync(action,
                (localAction, cancellationToken) => Coordinator.LaunchAsync(target, itemKey, localAction, cancellationToken),
                cancellationToken => Coordinator.AuthorizeDownloadAsync(target, itemKey, cancellationToken), current.Token);
            outcome = new(origin.Id, origin.Request, itemKey, action,
                result.IsSuccess ? ProjectStructureFileActionOutcomeKind.Accepted : ProjectStructureFileActionOutcomeKind.Rejected, result.Message);
            await completed.InvokeAsync(outcome);
            if (IsCurrent(current)) {
                actionFeedback = result.IsSuccess ? result.Message : null;
                activationError = result.IsSuccess ? null : result.Message;
            }
        } catch (Exception exception) {
            if (dispatched && outcome is null) {
                unconfirmedActions.Add(attempt);
                await completed.InvokeAsync(new(origin.Id, origin.Request, itemKey, action, ProjectStructureFileActionOutcomeKind.Unconfirmed,
                    "The file action is unconfirmed. Observe the original target before repeating it."));
            }
            Logger.LogWarning("Authorized file action failed. OpeningId={OpeningId} RequestIdentity={RequestIdentity} Action={Action} Dispatched={Dispatched} FailureType={FailureType}.",
                origin.Id, origin.Request.Identity, action, dispatched, exception.GetType().Name);
            if (IsCurrent(current)) {
                activationError = outcome is not null ? $"{outcome.Message} The outcome could not be published to the current view."
                    : dispatched ? "The file action is unconfirmed. Observe the original target before repeating it."
                    : SafeMessage(exception, "Unable to authorize the selected file action.");
            }
        } finally {
            pendingActions.Remove(attempt);
            Complete(current);
        }
    }

    private void SnapshotChanged(ProjectStructureFileCollectionOpening origin, ProjectStructureFileBrowserWorkspace target, FileBrowserSnapshot value) {
        if (!IsCurrent(origin) || !ReferenceEquals(workspace, target)) {
            return;
        }
        snapshot = value;
        if (value.Search is { } search && !value.IsBusy) {
            Logger.LogInformation("File search completed. OpeningId={OpeningId} Revision={Revision} Returned={Returned} Inspected={Inspected} RetainedBytes={RetainedBytes} Partial={Partial}.",
                origin.Id, target.Revision, value.Items.Count, search.ScannedItems, search.RetainedBytes, search.IsPartial);
        }
    }

    private BrowserOperation BeginOperation(ProjectStructureFileCollectionOpening origin) {
        operation?.Cancel();
        var next = new BrowserOperation(origin);
        operation = next;
        pending.Add(next);
        return next;
    }

    private void Complete(BrowserOperation current) {
        pending.Remove(current);
        if (ReferenceEquals(operation, current)) {
            operation = null;
        }
        current.Complete();
    }

    private ProjectStructureKnownFileInteraction? DetachInteraction() {
        var previous = interaction;
        interaction = null;
        interactionItemKey = null;
        return previous;
    }

    private async ValueTask DisposeRuntimeAsync() {
        var previousInteraction = DetachInteraction();
        var previousWorkspace = workspace;
        workspace = null;
        hostActionCatalog = null;
        try {
            if (previousInteraction is not null) {
                await previousInteraction.DisposeAsync();
            }
        } finally {
            if (previousWorkspace is not null) {
                await previousWorkspace.DisposeAsync();
            }
        }
    }

    private static string SafeMessage(Exception exception, string fallback) => exception switch {
        FileBrowserProviderException provider => provider.Error.Message,
        FileAccessDeniedException denied => denied.Message,
        _ => fallback
    };

    private bool SupportsLocalOpen(ProjectStructureFileBrowserWorkspace target, FileBrowserSourceId sourceId)
        => ItemActionService.IsLocalLaunchAvailable && target.SupportsLocalOpen(sourceId);

    public async ValueTask DisposeAsync() {
        if (disposed) {
            return;
        }
        disposed = true;
        activeOpening = null;
        var operations = pending.ToArray();
        foreach (var current in operations) {
            current.Cancel();
        }
        await DisposeRuntimeAsync();
        await Task.WhenAll(operations.Select(current => current.Completion.Task));
        var runner = actionRunner;
        actionRunner = null;
        if (runner is not null) {
            await runner.DisposeAsync();
        }
    }

    private sealed class BrowserOperation {
        private readonly CancellationTokenSource cancellation = new();
        private int completed;
        public BrowserOperation(ProjectStructureFileCollectionOpening opening) {
            Opening = opening;
            Token = cancellation.Token;
        }
        public ProjectStructureFileCollectionOpening Opening { get; }
        public CancellationToken Token { get; }
        public TaskCompletionSource Completion { get; } = new(TaskCreationOptions.RunContinuationsAsynchronously);
        public void Cancel() {
            if (Volatile.Read(ref completed) != 0) {
                return;
            }
            try {
                cancellation.Cancel();
            } catch (ObjectDisposedException) when (Volatile.Read(ref completed) != 0) {
            }
        }
        public void Complete() {
            Volatile.Write(ref completed, 1);
            cancellation.Dispose();
            Completion.TrySetResult();
        }
    }
}

@namespace CanDoItAll.Modules.Workbench.Pages
@using CanDoItAll.Workbench.Execution.UI.Processes

<ProcessAssignmentDialog @key="Dialog.DialogId" Dialog="@ProjectStructureProcessPresentation.Start(Dialog)"
    Close="Close" ReviewAndStartProcess="ReviewAndStartProcess" PrepareAnotherProcessLaunch="PrepareAnotherProcessLaunch"
    RequestHrManagerMatch="RequestHrManagerMatch" CancelHrManagerMatch="CancelHrManagerMatch"
    ExecuteHrManagerMatch="ExecuteHrManagerMatch" SelectProcessStartCandidate="SelectProcessStartCandidate"
    AssignProcessStartAgent="AssignProcessStartAgent" />

@code {
    [Parameter, EditorRequired]
    public ProjectStructureProcessStartDialogState Dialog { get; set; } = default!;

    [Parameter]
    public EventCallback Close { get; set; }

    [Parameter]
    public EventCallback ReviewAndStartProcess { get; set; }

    [Parameter]
    public EventCallback PrepareAnotherProcessLaunch { get; set; }

    [Parameter]
    public EventCallback RequestHrManagerMatch { get; set; }

    [Parameter]
    public EventCallback CancelHrManagerMatch { get; set; }

    [Parameter]
    public EventCallback ExecuteHrManagerMatch { get; set; }

    [Parameter]
    public EventCallback<ProjectStructureProcessStartCandidateSelection> SelectProcessStartCandidate { get; set; }

    [Parameter]
    public EventCallback<Guid> AssignProcessStartAgent { get; set; }

}

    private ProjectStructureProcessStartCandidateState? ResolveSelectedCandidate(ProjectStructureProcessStartRoleState role)
        => role.Candidates.FirstOrDefault(candidate => candidate.IsSelected);

    private ProjectStructureProcessStartCandidateState? ResolveCandidateById(
        ProjectStructureProcessStartRoleState role,
        Guid candidateId)
        => role.DirectoryCandidates
            .Concat(role.Candidates)
            .FirstOrDefault(candidate => candidate.CandidateId == candidateId);

    private ProjectStructureProcessStartCandidateState? ResolveSuggestedCandidate(ProjectStructureProcessStartRoleState role)
        => role.Candidates
            .Where(candidate => !candidate.IsSelected && candidate.IsResolvable)
            .OrderByDescending(candidate => candidate.IsRecommended)
            .ThenByDescending(candidate => ResolveScore(candidate))
            .ThenBy(candidate => candidate.DisplayName, StringComparer.OrdinalIgnoreCase)
            .FirstOrDefault();

    private IReadOnlyList<CandidateRankItem> ResolveRankedCandidates(ProjectStructureProcessStartRoleState role)
    {
        var resolvableCandidates = role.Candidates
            .Where(candidate => candidate.IsResolvable)
            .ToList();
        var mainCandidate = ResolveSelectedCandidate(role)
            ?? resolvableCandidates
                .OrderByDescending(ResolveScore)
                .ThenBy(candidate => candidate.DisplayName, StringComparer.OrdinalIgnoreCase)
                .FirstOrDefault();

        var ordered = new List<ProjectStructureProcessStartCandidateState>();
        if (mainCandidate is not null)
        {
            ordered.Add(mainCandidate);
        }

        ordered.AddRange(
            resolvableCandidates
                .Where(candidate => mainCandidate is null || candidate.CandidateId != mainCandidate.CandidateId)
                .OrderByDescending(ResolveScore)
                .ThenBy(candidate => candidate.DisplayName, StringComparer.OrdinalIgnoreCase));

        return ordered
            .Select((candidate, index) => new CandidateRankItem(candidate, index == 0, index + 1))
            .ToList();
    }


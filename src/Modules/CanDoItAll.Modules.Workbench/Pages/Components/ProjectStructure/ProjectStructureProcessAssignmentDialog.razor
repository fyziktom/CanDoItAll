    private int ResolveRoleNumber(ProjectStructureProcessStartRoleState role)
    {
        var index = -1;
        for (var roleIndex = 0; roleIndex < Dialog.Roles.Count; roleIndex++)
        {
            if (Dialog.Roles[roleIndex].LaunchPlanRoleId == role.LaunchPlanRoleId)
            {
                index = roleIndex;
                break;
            }
        }

        return index < 0 ? 0 : index + 1;
    }

    private static decimal ResolveScore(ProjectStructureProcessStartCandidateState candidate)
    {
        if (candidate.MatchScore != 0)
        {
            return candidate.MatchScore;
        }

        var token = candidate.ScoreLabel.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
        return decimal.TryParse(
            token,
            System.Globalization.NumberStyles.Number,
            System.Globalization.CultureInfo.CurrentCulture,
            out var localizedScore)
            ? localizedScore * 10m
            : decimal.TryParse(
                token,
                System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture,
                out var invariantScore)
                ? invariantScore * 10m
                : 0m;
    }

    private static string ResolveRoleIcon(ProjectStructureProcessStartRoleState role)
    {
        if (role.DisplayName.Contains("architect", StringComparison.OrdinalIgnoreCase))
        {
            return "design_services";
        }

        if (role.DisplayName.Contains("review", StringComparison.OrdinalIgnoreCase) ||
            role.DisplayName.Contains("qa", StringComparison.OrdinalIgnoreCase))
        {
            return "fact_check";
        }

        if (role.DisplayName.Contains("strateg", StringComparison.OrdinalIgnoreCase))
        {
            return "campaign";
        }

        return "smart_toy";
    }

    private static string ResolveCandidateSummary(ProjectStructureProcessStartCandidateState candidate)
    {
        if (!string.IsNullOrWhiteSpace(candidate.AgentSummary))
        {
            return TrimReason(candidate.AgentSummary);
        }

        if (!string.IsNullOrWhiteSpace(candidate.RecommendationSummary))
        {
            return TrimReason(candidate.RecommendationSummary);
        }

        if (!string.IsNullOrWhiteSpace(candidate.AvailabilitySummary))
        {
            return TrimReason(candidate.AvailabilitySummary);
        }

        return "Candidate available for this process role.";
    }

    private static string ResolveDetailSummary(SelectedAgentDetail detail)
    {
        if (!string.IsNullOrWhiteSpace(detail.Candidate.AgentSummary))
        {
            return detail.Candidate.AgentSummary;
        }

        if (!string.IsNullOrWhiteSpace(detail.Candidate.RecommendationSummary))
        {
            return detail.Candidate.RecommendationSummary;
        }

        return $"AI agent assigned to {detail.Role.DisplayName}.";
    }

    private static IReadOnlyList<string> BuildReasons(SelectedAgentDetail detail)
    {
        var reasons = new List<string>();
        if (!string.IsNullOrWhiteSpace(detail.Candidate.RecommendationSummary))
        {
            reasons.Add(TrimReason(detail.Candidate.RecommendationSummary));
        }

        if (!string.IsNullOrWhiteSpace(detail.Candidate.AvailabilitySummary))
        {
            reasons.Add(TrimReason(detail.Candidate.AvailabilitySummary));
        }

        if (!string.IsNullOrWhiteSpace(detail.Role.ReadinessSummary))
        {
            reasons.Add(TrimReason(detail.Role.ReadinessSummary));
        }

        return reasons.Count == 0
            ? ["Good fit for this process role"]
            : reasons.Take(3).ToList();
    }

    private static string BuildModelTooltip(ProjectStructureProcessStartCandidateState candidate)
    {
        var provider = string.IsNullOrWhiteSpace(candidate.AgentProviderName)
            ? "Provider not configured"
            : candidate.AgentProviderName.Trim();
        var model = string.IsNullOrWhiteSpace(candidate.AgentModel)
            ? "Model not configured"
            : candidate.AgentModel.Trim();

        return $"{provider} / {model}";
    }

    private static string BuildListTooltip(IReadOnlyList<string> values, string emptyText)
    {
        var names = values
            .Where(item => !string.IsNullOrWhiteSpace(item))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(item => item, StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (names.Count == 0)
        {
            return emptyText;
        }

        var visible = names.Take(10).ToList();
        var suffix = names.Count > visible.Count ? $" (+{names.Count - visible.Count} more)" : string.Empty;
        return string.Join(", ", visible) + suffix;
    }

    private static IReadOnlyList<string> ResolveToolNames(ProjectStructureProcessStartCandidateState candidate)
        => candidate.ToolNames?
            .Where(item => !string.IsNullOrWhiteSpace(item))
            .ToList()
           ?? [];

    private static IReadOnlyList<string> ResolveSkillNames(ProjectStructureProcessStartCandidateState candidate)
        => candidate.SkillNames?
            .Where(item => !string.IsNullOrWhiteSpace(item))

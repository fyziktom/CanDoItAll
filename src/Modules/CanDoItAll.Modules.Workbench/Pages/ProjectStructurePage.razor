                                     ShowValueCopy="true"
                                     RevealDurationSeconds="30"
                                     data-testid="project-structure-secret-create-value" />
                    </div>
                    <div class="mt-3">
                        <label class="cda-field-label">Purpose</label>
                        <InputText @bind-Value="secretReferenceCreateModel.RotationNote" class="ui-input" />
                    </div>
                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap" Class="mt-4">
                        <Button Text="Create and use"
                                Icon="save"
                                Tone="ButtonTone.Info"
                                Disabled="@isSecretReferenceDialogBusy"
                                IsBusy="@isSecretReferenceDialogBusy"
                                Click="CreateAndUseProjectStructureSecretAsync"
                                data-testid="project-structure-secret-create-use" />
                    </Cluster>
                </FormSection>
            </Stack>
        </Body>
    </ProjectStructureOverlayDialog>
}


    private CanvasWorkbenchWindowState ResolveWindowState(string key)
    {
        var uiState = ResolveEditableUiState();
        return uiState.WindowStates.TryGetValue(key, out var state)
            ? CanvasWorkbenchWindowState.Normalize(state)
            : new CanvasWorkbenchWindowState();
    }

    private CanvasWorkbenchWindowState ResolveHealthWindowState()
    {
        var uiState = ResolveEditableUiState();
        if (!uiState.WindowStates.TryGetValue(HealthWindowKey, out var state))
        {
            return CanvasWorkbenchWindowState.Normalize(new CanvasWorkbenchWindowState
            {
                IsVisible = false,
                Left = HealthWindowDefaultLeft
            });
        }

        if (state.HasCustomGeometry)
        {
            return CanvasWorkbenchWindowState.Normalize(state);
        }

        var offsetState = state.Clone();
        offsetState.Left = HealthWindowDefaultLeft;
        return CanvasWorkbenchWindowState.Normalize(offsetState);
    }

    private CanvasWorkbenchWindowState ResolveWindowStateForToggle(string key)
        => key switch
        {
            SelectionWindowKey => ResolveWindowState(key),
            HealthWindowKey => ResolveHealthWindowState(),
            ToolboxWindowKey => ResolveToolboxWindowState(),
            ObjectIndexWindowKey => ResolveObjectIndexWindowState(),
            SignalsWindowKey => ResolveSignalsWindowState(),
            _ => ResolveWindowState(key)
        };

    private async Task ToggleWindowAsync(string key)
    {
        var state = ResolveWindowStateForToggle(key);
        if (!state.IsVisible)
        {
            state.IsVisible = true;
            state.IsMinimized = false;
        }
        else if (state.IsMinimized)
        {
            state.IsMinimized = false;
        }
        else
        {
            state.IsVisible = false;
            state.IsMinimized = false;
        }

        await PersistWindowStateAsync(key, state);
    }

    private async Task PersistWindowStateAsync(string key, CanvasWorkbenchWindowState state)
    {
        var uiState = ResolveEditableUiState();
        uiState.WindowStates[key] = CanvasWorkbenchWindowState.Normalize(state);
        await PersistCanvasUiStateAsync(uiState);
    }

    private static string ResolveCreatedTitle(ProjectStructureCreateLeafDefinition definition, CanvasWorkbenchCreateActionRequest request)
    {
        if (definition.ObjectType == ProjectObjectType.Note &&
            string.Equals(request.CreateMode, "quick-note", StringComparison.OrdinalIgnoreCase))
        {
            return ProjectStructureNodeHelpers.BuildSimpleNoteTitle(
                !string.IsNullOrWhiteSpace(request.Notes) ? request.Notes : request.Title);
        }

        if (!string.IsNullOrWhiteSpace(request.Title))
        {
            return request.Title.Trim();
        }

        return request.UploadedFile is not null && !string.IsNullOrWhiteSpace(request.UploadedFile.FileName)
            ? System.IO.Path.GetFileNameWithoutExtension(request.UploadedFile.FileName)
            : definition.DefaultTitle;
    }

    private static string ResolveCreatedNotes(ProjectStructureCreateLeafDefinition definition, CanvasWorkbenchCreateActionRequest request)
        => !string.IsNullOrWhiteSpace(request.Notes)
            ? request.Notes.Trim()
            : definition.ObjectType == ProjectObjectType.Note && !string.IsNullOrWhiteSpace(request.Title)
                ? request.Title.Trim()
                : string.Empty;

    private string BuildSelectionFrameLabel()
        => !string.IsNullOrWhiteSpace(selectionBorderName)
            ? selectionBorderName.Trim()
            : selectedNodes.Count == 1
                ? selectedNodes[0].Title
                : $"{selectedNodes.Count} nodes";

    private IReadOnlyList<string> ResolveActionTargetNodeIds(string? nodeId)
    {
        if (!string.IsNullOrWhiteSpace(nodeId) &&
            selectedNodeIds.Count > 1 &&
            selectedNodeIds.Contains(nodeId, StringComparer.Ordinal))
        {
            return selectedNodeIds
                .Distinct(StringComparer.Ordinal)
                .ToList();
        }

        if (!string.IsNullOrWhiteSpace(nodeId))
        {
            return [nodeId];
        }

        return selectedNodeIds
            .Distinct(StringComparer.Ordinal)
            .ToList();
    }


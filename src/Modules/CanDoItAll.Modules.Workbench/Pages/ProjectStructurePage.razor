    private async Task OpenSecretReferenceEditDialogAsync(ProjectStructureNode node, ProjectStructureActionContext? capturedContext = null) {
        var context = capturedContext ?? CaptureActionContext();
        if (!IsCurrentAction(context)) {
            return;
        }
        secretReferenceActionContext = context;
        var metadata = ProjectObjectMetadataSerializer.Parse(node.MetadataJson);
        var secretReference = metadata.SecretReference;

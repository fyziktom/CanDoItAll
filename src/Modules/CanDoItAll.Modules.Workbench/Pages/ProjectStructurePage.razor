    private async Task OpenAttachmentLocalActionAsync(ProjectStructureNode node, FileToolsLocalFileAction action) {
        var context = CaptureActionContext();
        var result = await LaunchAttachmentLocalActionAsync(context, node, action);
        if (IsCurrentAction(context)) {
            localOpenFeedbackNodeId = node.Id;
            localOpenFeedback = result.Message;
            localOpenFeedbackTone = result.IsSuccess ? "mint" : "warn";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<ProjectStructureLocalFileOpenResult> LaunchAttachmentLocalActionAsync(
        ProjectStructureActionContext context,
        ProjectStructureNode requestedNode,
        FileToolsLocalFileAction action)
    {
        try
        {
            return await LocalFileActionCoordinator.LaunchAsync(
                context.Admission.ProjectId,
                requestedNode.Id,
                action,
                ensureOrigin: cancellationToken => EnsureFileOriginAsync(context, context.Admission.ProjectId, requestedNode, cancellationToken));
        }
        catch (Exception exception)
        {
            Logger.LogWarning(
                "Project Structure local file action was denied. NodeId={NodeId} Action={Action} FailureType={FailureType}.",
                requestedNode.Id,
                action,
                exception.GetType().Name);
            string message = exception switch
            {
                FileAccessDeniedException deniedException => deniedException.Message,
                FileBrowserProviderException providerException => providerException.Error.Message,
                _ => "The current file authority could not be established."
            };
            return new ProjectStructureLocalFileOpenResult(false, message);
        }
    }


    private ProjectStructureKnownFileInteractionSlot PreviewInteractionSlot
        => previewInteractionSlot ??= new ProjectStructureKnownFileInteractionSlot(
            KnownFileInteractionCoordinator.OpenAsync);

    private ProjectStructureKnownFileInteraction? PreviewInteraction
        => previewInteractionSlot?.Current;

    private async Task OpenAttachmentPreviewAsync(ProjectStructureNode node) {
        if (!ProjectStructureNodeHelpers.CanRenderAttachmentPreview(node)) {
            return;
        }
        var context = CaptureActionContext();
        var opening = new ProjectStructureAuthoringOpening(context, node);
        previewOpening = opening;
        webPreviewDialog = null;
        previewNode = null;
        isOpeningAttachmentPreview = true;
        var slot = PreviewInteractionSlot;
        try {
            var opened = await slot.OpenAsync(cancellationToken => KnownFileInteractionCoordinator.OpenBoundAsync(
                context.Admission.ProjectId, node.Id,
                token => EnsureFileOriginAsync(context, context.Admission.ProjectId, node, token), cancellationToken));
            if (opened is null) {
                return;
            }
            if (!IsCurrentAuthoring(opening, previewOpening)) {
                await slot.CloseIfCurrentAsync(opened);
                return;
            }
            previewNode = node;
        } catch (Exception exception) {
            Logger.LogWarning("Project file interaction failed. ProjectId={ProjectId} NodeId={NodeId} OpeningId={OpeningId} FailureType={FailureType}.",
                context.Admission.ProjectId, node.Id, opening.Id, exception.GetType().Name);
            if (IsCurrentAuthoring(opening, previewOpening)) {
                workflowFeedback = exception switch {
                    FileBrowserProviderException provider => provider.Error.Message,
                    FileAccessDeniedException denied => denied.Message,
                    _ => "Unable to authorize this project asset."
                };
                workflowFeedbackTone = "warn";
            }
        } finally {
            if (ReferenceEquals(previewOpening, opening)) {
                isOpeningAttachmentPreview = false;
            }
        }
    }

    private async Task CloseAttachmentPreviewAsync() {
        previewOpening = null;
        previewNode = null;
        isOpeningAttachmentPreview = false;
        var slot = previewInteractionSlot;
        if (slot is not null) {
            await slot.CloseAsync();
        }
    }

    private async Task EditAttachmentPreviewNodeAsync(ProjectStructureNode node)
    {
        await CloseAttachmentPreviewAsync();
        await OpenEditDialogAsync(node);
    }

    private void DisposeSynchronousState()
    {
        Interlocked.Increment(ref surfaceReloadGeneration);
        CancelPendingCanvasViewStatePersistence();
        CancelRuntimePreviewWait();
        CloseProcessStartDialog();
        CloseProcessLinkDialog();
        foreach (var authority in imageAuthorities.Keys) {
            authority.Revoke();
        }
        deferredCompletionCts.Cancel();
    }

    public async ValueTask DisposeAsync()
    {
        DisposeAgentWindowState();
        DisposeSynchronousState();
        try {
            await Task.WhenAll(authoringOperations.ToArray());
            if (previewInteractionSlot is not null) {
                await previewInteractionSlot.DisposeAsync();
                previewInteractionSlot = null;
            }
        } finally {
            nodeMoveCommitGate.Dispose();
            canvasViewStateCommitGate.Dispose();
            deferredCompletionCts.Dispose();
        }
    }


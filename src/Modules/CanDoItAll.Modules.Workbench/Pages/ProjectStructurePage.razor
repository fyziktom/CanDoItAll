        secretReferenceRequest = null;
        secretReferenceEditNodeId = node.Id;
        secretReferenceSearch = string.Empty;
        secretReferenceDialogError = string.Empty;
        selectedSecretReferenceId = secretReference?.SecretId is { } secretId && secretId != Guid.Empty
            ? secretId.ToString("D") : string.Empty;
        secretReferencePurpose = string.IsNullOrWhiteSpace(secretReference?.Purpose)
            ? string.IsNullOrWhiteSpace(node.Notes) ? "Project structure reference" : node.Notes
            : secretReference.Purpose;
        secretReferenceExternalReference = secretReference?.ExternalReference ?? node.Subtitle ?? string.Empty;
        secretReferenceCreateModel = NewProjectStructureSecretModel();
        var items = await WorkspaceService.ListSecretsAsync();
        if (IsCurrentSecretReferenceDialog(context)) {
            secretReferenceItems = items;
            isSecretReferenceDialogOpen = true;
        }
    }


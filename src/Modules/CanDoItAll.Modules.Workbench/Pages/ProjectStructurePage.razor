    private Task UseSelectedProjectStructureSecretAsync()
    {
        var selectedSecretId = SelectedSecretReferenceGuid;
        var selectedSecret = selectedSecretId.HasValue
            ? secretReferenceItems.FirstOrDefault(secret => secret.Id == selectedSecretId.Value)
            : null;
        if (selectedSecret is null)
        {
            secretReferenceDialogError = "Select a stored secret first.";
            return Task.CompletedTask;
        }

        return SelectProjectStructureSecretAsync(selectedSecret);
    }

    private async Task SelectProjectStructureSecretAsync(SecretListItem secret)
    {
        selectedSecretReferenceId = secret.Id.ToString("D");
        if (isSecretReferenceEditMode)
        {
            await UpdateProjectStructureSecretReferenceAsync(secret);
            return;
        }

        if (!TryResolvePendingSecretCreateRequest(out var definition, out var request))
        {
            return;
        }

        isSecretReferenceDialogBusy = true;
        secretReferenceDialogError = string.Empty;
        try
        {
            var referenceRequest = BuildSecretReferenceCreateRequest(request, secret);
            await CreateObjectAsync(definition, referenceRequest);
            CloseSecretReferenceDialog();
        }
        catch (Exception exception)
        {
            secretReferenceDialogError = exception.Message;
        }
        finally
        {
            isSecretReferenceDialogBusy = false;
        }
    }

    private async Task CreateAndUseProjectStructureSecretAsync()
    {
        ProjectStructureCreateLeafDefinition? pendingDefinition = null;
        CanvasWorkbenchCreateActionRequest? pendingRequest = null;
        if (!isSecretReferenceEditMode)
        {
            if (!TryResolvePendingSecretCreateRequest(out var definition, out var request))
            {
                return;
            }

            pendingDefinition = definition;
            pendingRequest = request;
        }

        if (!isSecretReferenceEditMode &&
            (pendingDefinition is null || pendingRequest is null))
        {
            secretReferenceDialogError = "Secret reference create state is no longer available.";
            return;
        }

        isSecretReferenceDialogBusy = true;
        secretReferenceDialogError = string.Empty;
        try
        {
            var result = await SecretService.SaveAsync(secretReferenceCreateModel);
            if (!result.IsSuccess)
            {
                secretReferenceDialogError = string.Join(" ", result.Errors.Select(error => error.Message));
                return;
            }

            secretReferenceItems = await WorkspaceService.ListSecretsAsync();
            var createdSecret = secretReferenceItems.FirstOrDefault(secret => secret.Id == result.Value);
            if (createdSecret is null)
            {
                secretReferenceDialogError = "The secret was created, but the picker could not reload its catalog entry.";
                return;
            }

            if (isSecretReferenceEditMode)
            {
                selectedSecretReferenceId = createdSecret.Id.ToString("D");
                await UpdateProjectStructureSecretReferenceAsync(createdSecret);
                return;
            }

            var referenceRequest = BuildSecretReferenceCreateRequest(pendingRequest!, createdSecret);
            await CreateObjectAsync(pendingDefinition!, referenceRequest);
            CloseSecretReferenceDialog();
        }
        catch (Exception exception)
        {
            secretReferenceDialogError = exception.Message;
        }
        finally
        {
            isSecretReferenceDialogBusy = false;
        }
    }

    private async Task UpdateProjectStructureSecretReferenceAsync(SecretListItem secret)
    {
        if (string.IsNullOrWhiteSpace(secretReferenceEditNodeId) ||
            surface?.Nodes.FirstOrDefault(node => string.Equals(node.Id, secretReferenceEditNodeId, StringComparison.Ordinal)) is not { } targetNode)
        {
            secretReferenceDialogError = "The secret reference node is no longer selected.";
            return;
        }

        isSecretReferenceDialogBusy = true;
        secretReferenceDialogError = string.Empty;
        try
        {
            var metadata = ProjectObjectMetadataSerializer.Parse(targetNode.MetadataJson);
            metadata.SecretReference = new ProjectSecretReferenceMetadata
            {
                SecretId = secret.Id,
                SecretNameSnapshot = secret.Name,
                Purpose = NormalizeSecretReferencePurpose(),
                ExternalReference = secretReferenceExternalReference.Trim()
            };

            var updated = await ProjectWorkbenchService.UpdateObjectAsync(ProjectId, targetNode.Id, new ProjectObjectEditRequest(
                secret.Name,
                secretReferenceExternalReference.Trim(),
                metadata.SecretReference.Purpose,
                targetNode.StartUtc,
                targetNode.EndUtc,
                ProjectObjectMetadataSerializer.Serialize(metadata),
                targetNode.DurationSeconds,
                targetNode.NodeReferences));
            if (updated is null)
            {
                secretReferenceDialogError = "The selected secret reference node could not be updated.";
                return;
            }

            await ApplySurfaceNodeUpdatesAsync([updated]);
            workflowFeedback = $"{updated.Title} was updated.";
            workflowFeedbackTone = "mint";
            CloseSecretReferenceDialog();
        }
        catch (Exception exception)
        {
            secretReferenceDialogError = exception.Message;
        }
        finally
        {
            isSecretReferenceDialogBusy = false;
        }
    }

    private bool TryResolvePendingSecretCreateRequest(
        out ProjectStructureCreateLeafDefinition definition,
        out CanvasWorkbenchCreateActionRequest request)
    {
        definition = default!;
        request = default!;
        if (secretReferenceAction is null ||
            secretReferenceRequest is null)
        {
            secretReferenceDialogError = "Secret reference create state is no longer available.";
            return false;
        }

        if (!ProjectStructureCanvasCatalog.TryResolveCreateDefinition(secretReferenceAction.ActionId, out definition))
        {
            secretReferenceDialogError = "Secret reference create action is not registered.";
            return false;
        }

        request = secretReferenceRequest;
        return true;
    }

    private CanvasWorkbenchCreateActionRequest BuildSecretReferenceCreateRequest(
        CanvasWorkbenchCreateActionRequest request,
        SecretListItem secret)
    {
        return request with
        {
            Title = secret.Name,
            Subtitle = secretReferenceExternalReference.Trim(),
            Notes = NormalizeSecretReferencePurpose(),
            InputValues =
            [
                new CanvasWorkbenchInputValue
                {
                    Key = "secretId",
                    Value = secret.Id.ToString("D")
                },
                new CanvasWorkbenchInputValue
                {
                    Key = "secretName",
                    Value = secret.Name
                }
            ]
        };
    }

    private string NormalizeSecretReferencePurpose()
        => string.IsNullOrWhiteSpace(secretReferencePurpose)
            ? "Project structure reference"
            : secretReferencePurpose.Trim();

    private static bool IsSecretReferenceCreateRequest(CanvasWorkbenchCreateActionRequest request)
        => IsSecretReferenceCreateAction(request.ActionId) ||
           string.Equals(request.CreateMode, "secret-reference-picker", StringComparison.Ordinal);


    private async Task EnterDependencyModeAsync(string? sourceNodeId = null, ProjectStructureActionContext? capturedContext = null)
    {
        var resolvedSourceNodeId = sourceNodeId ?? selectedNode?.Id;
        if (string.IsNullOrWhiteSpace(resolvedSourceNodeId))
        {
            return;
        }

        var context = capturedContext ?? CaptureActionContext();
        var original = context.Surface.Nodes.FirstOrDefault(node => node.Id == resolvedSourceNodeId);
        if (original is null || !IsCurrentAction(context)) {
            return;
        }
        reconnectNodeId = null;
        dependencyOpening = new(context, original);
        linkModeSourceId = resolvedSourceNodeId;
        await SetCanvasToolModeAsync(CanvasAuthoringMode.Dependency, keepDependencySource: true);
    }

    private async Task<string?> ResolveCurrentSelectedNodeIdAsync()
    {
        if (workbenchRef is not null)
        {
            var liveSelectedNodeIds = (await workbenchRef.GetSelectedNodeIdsAsync())
                .Where(id => !string.IsNullOrWhiteSpace(id))
                .Distinct(StringComparer.Ordinal)
                .ToList();
            if (liveSelectedNodeIds.Count > 0)
            {
                selectedNodeIds = liveSelectedNodeIds;
                return selectedNodeIds[0];
            }
        }

        return selectedNodeIds.FirstOrDefault();
    }

    private Task CreateDependencyAsync(string? sourceNodeId, string? targetNodeId) {
        if (string.IsNullOrWhiteSpace(sourceNodeId) || string.IsNullOrWhiteSpace(targetNodeId) || sourceNodeId == targetNodeId) {
            return Task.CompletedTask;
        }
        var sourceOpening = dependencyOpening?.Node.Id == sourceNodeId ? dependencyOpening : null;
        var context = sourceOpening?.Context ?? CaptureActionContext();
        if (!IsCurrentAction(context)) {
            return Task.CompletedTask;
        }
        var source = sourceOpening?.Node ?? context.Surface.Nodes.FirstOrDefault(node => node.Id == sourceNodeId);
        var target = surface?.Nodes.FirstOrDefault(node => node.Id == targetNodeId);
        return source is null || target is null ? Task.CompletedTask : ExecuteGraphLinkAsync(context,
            new(sourceNodeId, targetNodeId, ProjectObjectLinkKind.DependsOn, true), [source, target], remove: false);
    }


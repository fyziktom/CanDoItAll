@page "/projects/{ProjectId:guid}/structure"
@* codex-capsule
kind: page
name: ProjectStructurePage
summary: Hosts the shared project structure canvas, mirrored inspector, typed graph actions, and supporting outline tools.
owns: shared-structure-canvas, node-outline, mirrored-inspector
deps: ProjectWorkbenchService, NavigationManager
risks: stale-node-selection, invalid-command-routing, overlapping-create-placement
tests: component:ProjectStructurePageTests, e2e:workbench-structure
*@
@using CanDoItAll.Components.CanvasLib
@using CanDoItAll.AgentFramework.Core
@using CanDoItAll.AgentFramework.Models
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using CanDoItAll.Modules.Projects
@using CanDoItAll.Modules.Projects.Pages.Components
@using CanDoItAll.Modules.Security
@using CanDoItAll.Modules.Workbench.CanvasAdapters
@using CanDoItAll.Modules.Workbench.Pages.Components.ProjectStructure
@using CanDoItAll.Modules.Workbench.ProjectStructure
@using CanDoItAll.Modules.Workspace
@using CanDoItAll.Infrastructure.Storage
@using CanDoItAll.SharedKernel
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Logging
@inject ProjectsService ProjectsService
@inject IProjectPartyIntegrationBridge ProjectPartyIntegrationBridge
@inject ProjectWorkbenchService ProjectWorkbenchService
@inject ProjectStructureSubprojectTransferCoordinator SubprojectTransferCoordinator
@inject IProjectWorkbenchSeedService ProjectWorkbenchSeedService
@inject IProjectStructureLocalFileOpener LocalFileOpener
@inject IProjectStructureRuntimeLauncher RuntimeLauncher
@inject DialogService DialogService
@inject ProjectStructureFileActionCoordinator FileActionCoordinator
@inject ProjectStructureKnownFileInteractionCoordinator KnownFileInteractionCoordinator
@inject ProjectStructureLocalFileActionCoordinator LocalFileActionCoordinator
@inject WorkspaceService WorkspaceService
@inject SecretService SecretService
@inject ProviderExecutionService ProviderExecutionService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<ProjectStructurePage> Logger
@inject IFloatingAgentChatCoordinator FloatingAgentChatCoordinator
@implements IAsyncDisposable

<PageTitle>@ProjectStructurePageTitleBuilder.Build(surface?.ProjectName)</PageTitle>

<ProjectStructureAgentChatContextProvider ProjectId="@ProjectId"
                                          ProjectName="@(surface?.ProjectName ?? "Requested project")"
                                          Surface="@surface"
                                          ActiveView="@ActiveAgentChatView"
                                          SelectedNodes="@(surface is not null && structureViewIndex == CanvasViewIndex ? selectedNodes : [])"
                                          GanttObservation="@(structureViewIndex == GanttViewIndex ? ganttObservation : null)"
                                          ContextNavigationIdentity="@AgentChatNavigationFence"
                                          ContextAccessState="@agentChatContextAccessState"
                                          RefreshRequested="HandleAgentExecutionCompletedAsync" />

@if (unavailableState is not null)
{
    <PageScaffold>
        <Header>
            <PageHeader Eyebrow="Workbench"
                        Title="Project structure unavailable"
                        Description="The requested project is not available in the active database profile." />
        </Header>
        <ChildContent>
            <EmptyState Eyebrow="Switched profile"
                        Title="@unavailableState.Title"
                        Description="@unavailableState.Description">
                <Actions>
                    <Button Text="Open projects"
                            Click="OpenUnavailableRouteAsync" />
                </Actions>
            </EmptyState>
        </ChildContent>
    </PageScaffold>
}
else if (surface is null || canvasSurface is null)
{
    <div class="project-structure-page">
        <CanvasWorkbenchStage Eyebrow=""
                              Title=""
                              Description="">
            <Canvas>
                <SkeletonStateOverlay Snapshot="@LoadingSkeletonSnapshot" />
            </Canvas>
        </CanvasWorkbenchStage>
    </div>
}
else
{
    <div class="project-structure-page">
        <Stack Gap="1.5rem"
               Class="project-structure-page__stack">

        <Tabs @bind-SelectedIndex="structureViewIndex"
              AriaLabel="Project structure views"
              RenderMode="TabRenderMode.Server">
            <TabsItem Text="Canvas" Icon="account_tree">
        <CanvasWorkbenchStage Eyebrow=""
                              Title=""
                              Description="">
            <Canvas>
                <CanvasWorkbench Surface="canvasSurface"
                                 @ref="workbenchRef"
                                 SelectionChanged="HandleSelectionChangedAsync"
                                 NodesMoved="HandleNodesMovedAsync"
                                 ContextActionRequested="HandleContextActionAsync"
                                 CreateActionInvoked="HandleCreateActionAsync"
                                 NodeEdited="HandleNodeEditedAsync"
                                 NodeOpened="HandleNodeOpenedAsync"
                                 StateChanged="HandleCanvasStateChangedAsync"
                                 ClipboardRequested="HandleClipboardRequestedAsync">
                    <ToolbarLeftContent>
                        <ProjectStructureToolbarActions SelectionWindowVisible="@SelectionWindowState.IsVisible"
                                                       HealthWindowVisible="@HealthWindowState.IsVisible"
                                                       ToolboxWindowVisible="@ToolboxWindowState.IsVisible"
                                                       ObjectIndexWindowVisible="@ObjectIndexWindowState.IsVisible"
                                                       FileBrowserWindowVisible="@FileBrowserWindowState.IsVisible"
                                                       SignalsWindowVisible="@SignalsWindowState.IsVisible"
                                                       AgentWindowVisible="@FloatingAgentChatCoordinator.Snapshot().IsCatalogVisible"
                                                       GanttViewVisible="@IsGanttViewVisible"
                                                       ActiveTool="@canvasToolMode"
                                                       CanUseDependencyTool="@(selectedNode is not null)"
                                                       CanRecomposeSelectedBranch="@CanRecomposeSelectedBranch"
                                                       IsSubtreeRecompositionInProgress="@isSubtreeRecompositionInProgress"
                                                       SelectToolClicked="SelectCanvasToolAsync"
                                                       DependencyToolClicked="EnableLinkModeAsync"
                                                       DeleteToolClicked="EnableDeleteModeAsync"
                                                       ToggleSelectionWindow="ToggleSelectionWindowAsync"
                                                       ToggleHealthWindow="ToggleHealthWindowAsync"
                                                       ToggleToolboxWindow="ToggleToolboxWindowAsync"
                                                       ToggleObjectIndexWindow="ToggleObjectIndexWindowAsync"
                                                       OpenFileBrowserWindow="OpenProjectFileBrowserAsync"
                                                       ToggleSignalsWindow="ToggleSignalsWindowAsync"
                                                       ToggleAgentWindow="ToggleAgentWindowAsync"
                                                       OpenGanttView="OpenGanttViewAsync"
                                                       RecomposeBranch="RecomposeSelectedBranchAsync" />
                        <div class="project-structure-toolbar-stats"
                             data-testid="project-structure-canvas-loaded">
                            <StatusBadge Tone="info" Text="@($"Nodes {surface.Nodes.Count}")" />
                            <StatusBadge Tone="neutral" Text="@($"Selection {selectedNodeIds.Count}")" />
                        </div>
                    </ToolbarLeftContent>
                    <OverlayContent>
                        @if ((!SelectionWindowState.IsVisible || SelectionWindowState.IsMinimized) &&
                            !string.IsNullOrWhiteSpace(workflowFeedback))
                        {
                            <PanelCard Class="project-structure-inline-feedback project-structure-clipboard-feedback"
                                       role="status"
                                       aria-live="polite"
                                       data-testid="project-structure-clipboard-feedback"
                                       data-tone="@workflowFeedbackTone">
                                <Stack GapScale="LayoutGap.Small">
                                    <TextBlock Value="@workflowFeedback" />
                                    @if (pendingDeletionRecoveries.Count > 0)
                                    {
                                        <Button Tone="ButtonTone.Default"
                                                Text="Retry cleanup"
                                                Disabled="@isRetryingDeletionCleanup"
                                                data-testid="project-structure-deletion-retry"
                                                Click="RetryPendingDeletionCleanupAsync" />
                                    }
                                </Stack>
                            </PanelCard>
                        }
                        @if (ToolboxWindowState.IsVisible)
                        {
                            <ProjectStructureToolboxWindow WindowId="@ToolboxWindowKey"
                                                           TestId="project-structure-toolbox-window"
                                                           AriaLabel="Project structure standard blocks toolbox"
                                                           Kicker="Standard Blocks Toolbox"
                                                           Title=""
                                                           Summary=""
                                                           State="@ToolboxWindowState"
                                                           StateChanged="HandleToolboxWindowStateChangedAsync"
                                                           Groups="@ToolboxCreateGroups"
                                                           SearchText="@structureToolboxSearchText"
                                                           SearchTextChanged="@((string? value) => structureToolboxSearchText = value ?? string.Empty)"
                                                           SourceLabel="@ToolboxSourceLabel"
                                                           DefaultWidth="@ToolboxWindowDefaultWidth"
                                                           OnToggleGroup="ExpandToolboxGroup"
                                                           OnOpenAction="HandleToolboxActionSelectedAsync" />
                        }
                        @if (ObjectIndexWindowState.IsVisible)
                        {
                            <ProjectStructureObjectIndexWindow WindowId="@ObjectIndexWindowKey"
                                                               TestId="project-structure-object-index-window"
                                                               AriaLabel="Project object index"
                                                               Kicker="Object index"
                                                               Title="Project object index"
                                                               Summary="@ObjectIndexWindowSummary"
                                                               State="@ObjectIndexWindowState"
                                                               StateChanged="HandleObjectIndexWindowStateChangedAsync"
                                                               IsLoaded="@IsObjectIndexWindowLoaded"
                                                               Nodes="@ObjectIndexWindowNodes"
                                                               SelectedNodeIds="@selectedNodeIds"
                                                               SearchText="@objectIndexSearchText"
                                                               SearchTextChanged="HandleObjectIndexSearchTextChangedAsync"
                                                               OnSelectNode="SelectNodeAsync"
                                                               ResolveContextActions="ResolveSupportPanelContextActions"
                                                               OnExecuteNodeContextAction="ExecuteOutlineContextActionAsync"
                                                               DefaultWidth="@ObjectIndexWindowDefaultWidth" />
                        }
                        @if (FileBrowserWindowState.IsVisible)
                        {
                            <ProjectStructureFileBrowserWindow WindowId="@FileBrowserWindowKey"
                                                               Request="@CurrentFileBrowserRequest"
                                                               State="@FileBrowserWindowState"
                                                               StateChanged="HandleFileBrowserWindowStateChangedAsync"
                                                               CanOpenRootInExplorer="@CanOpenCurrentFileBrowserNodeInExplorer"
                                                               OpenRootInExplorer="OpenCurrentFileBrowserNodeInExplorerAsync" />
                        }
                        @if (HealthWindowState.IsVisible)
                        {
                            <ProjectStructureCanvasHealthWindow WindowId="@HealthWindowKey"
                                                                TestId="project-structure-validation-window"
                                                                AriaLabel="Project structure canvas health"
                                                                State="@HealthWindowState"
                                                                StateChanged="HandleHealthWindowStateChangedAsync"
                                                                SummaryState="@canvasValidationOverlay"
                                                                CanValidateSelected="false"
                                                                ValidateSelected="RunSelectedValidationAsync" />
                        }
                        @if (SignalsWindowState.IsVisible)
                        {
                            <ProjectStructureSignalsWindow WindowId="@SignalsWindowKey"
                                                           TestId="project-structure-signals-window"
                                                           AriaLabel="Project structure node signals"
                                                           Kicker="Node signals"
                                                           Title="Signals toolbox"
                                                           Summary="Keep markers, progress, and priority close to the current selection without reopening the right-click menu every time."
                                                           State="@SignalsWindowState"
                                                           StateChanged="HandleSignalsWindowStateChangedAsync"
                                                           Sections="@SignalsWindowSections"
                                                           CanApplySignals="@CanApplySignals"
                                                           SelectionLabel="@SignalsSelectionLabel"
                                                           SelectionHint="@SignalsSelectionHint"
                                                           DefaultWidth="@SignalsWindowDefaultWidth"
                                                           OnApplyAction="HandleSignalsToolboxActionAsync" />
                        }
                        @if (SelectionWindowState.IsVisible)
                        {
                            <CanvasFloatingWindow WindowId="@SelectionWindowKey"
                                                  TestId="project-structure-selection-window"
                                                  AriaLabel="Project structure selection panel"
                                                  Kicker="Selection panel"
                                                  Title="@SelectionWindowTitle"
                                                  Summary="@SelectionWindowSummary"
                                                  DefaultPlacement="top-right"
                                                  DefaultWidth="360"
                                                  DefaultHeight="360"
                                                  MinWidth="320"
                                                  MinHeight="240"
                                                  MaxWidth="520"
                                                  State="@SelectionWindowState"
                                                  StateChanged="HandleSelectionWindowStateChangedAsync">
                                <ProjectStructureSelectionPanel State="@SelectionPanelState"
                                                               ClearSelectionAsync="ClearSelectionAsync"
                                                               SelectNodeAsync="SelectNodeAsync"
                                                               ApplySelectionStatusAsync="ApplySelectionStatusAsync"
                                                               ApplySelectionProgressAsync="ApplySelectionProgressAsync"
                                                               ApplySelectionMarkerAsync="ApplySelectionMarkerAsync"
                                                               ApplySelectionPriorityAsync="ApplySelectionPriorityAsync"
                                                               SelectionBorderNameChangedAsync="UpdateSelectionBorderNameAsync"
                                                               CreateSelectionBorderAsync="CreateSelectionBorderAsync"
                                                               ClearSelectionBordersAsync="ClearSelectionBordersAsync"
                                                               ExecuteInspectorActionAsync="ExecuteSelectedInspectorActionAsync"
                                                               OpenToolboxAsync="OpenToolboxAsync"
                                                               OpenAttachmentLocallyAsync="OpenSelectedAttachmentLocallyAsync"
                                                               OpenAttachmentPreviewAsync="OpenSelectedAttachmentPreviewAsync"
                                                               OpenMermaidViewerAsync="OpenSelectedMermaidViewerAsync"
                                                               AdvancedDetailsHelpBody="@AdvancedDetailsHelpBody"
                                                               AdvancedDetailsHelpTip="@AdvancedDetailsHelpTip" />
                            </CanvasFloatingWindow>
                        }
                            <ProjectStructureDeferredSurface RenderKey="@CanvasOverlayRenderKey">
                            <ProjectStructureCanvasDialogs ProjectHierarchyDialog="@projectHierarchyDialog"
                                                           RenderProcessStartDialog="false"
                                                           CloseProjectHierarchy="CloseProjectHierarchyDialog"
                                                           ProjectHierarchySelectionChanged="HandleProjectHierarchySelectionChanged"
                                                           ExecuteProjectHierarchyCommand="ExecuteProjectHierarchyCommandAsync"
                                                           BlockMutationDialog="@blockMutationDialog"
                                                           CloseBlockMutation="CloseBlockMutationDialog"
                                                           BlockMutationSelectionChanged="HandleBlockMutationSelectionChanged"
                                                           ExecuteBlockMutation="ExecuteBlockMutationAsync"
                                                           SubprojectTransferDialog="@subprojectTransferDialog"
                                                           CloseSubprojectTransfer="CloseSubprojectTransferDialog"
                                                           SubprojectTransferNameChanged="HandleSubprojectTransferNameChanged"
                                                           ExecuteSubprojectTransfer="ExecuteSubprojectTransferAsync"
                                                           OpenProjectCreateDialog="OpenProjectCreateDialogAsync"
                                                           ProcessLinkDialog="@processLinkDialog"
                                                           CloseProcessLink="CloseProcessLinkDialog"
                                                           ProcessLinkSelectionChanged="HandleProcessLinkSelectionChanged"
                                                           ExecuteProcessLink="ExecuteProcessLinkAsync"
                                                           WorkflowAddDialog="@workflowAddDialog"
                                                           CloseWorkflowAdd="CloseWorkflowAddDialog"
                                                           WorkflowAddSelectionChanged="HandleWorkflowAddSelectionChanged"
                                                           WorkflowAddIncludeParentSubtreeChanged="HandleWorkflowAddIncludeParentSubtreeChanged"
                                                           WorkflowAddIncludeAssetsChanged="HandleWorkflowAddIncludeAssetsChanged"
                                                           WorkflowAddManualInputChanged="HandleWorkflowAddManualInputChanged"
                                                           WorkflowAddSourceKindChanged="HandleWorkflowAddSourceKindChanged"
                                                           WorkflowAddSourceKeyChanged="HandleWorkflowAddSourceKeyChanged"
                                                           WorkflowAddSourceLabelChanged="HandleWorkflowAddSourceLabelChanged"
                                                           WorkflowAddSourceValueChanged="HandleWorkflowAddSourceValueChanged"
                                                           ExecuteWorkflowAdd="ExecuteWorkflowAddAsync"
                                                           WorkflowStartDialog="@workflowStartDialog"
                                                           CloseWorkflowStart="CloseWorkflowStartDialog"
                                                           WorkflowStartSimulationChanged="HandleWorkflowStartSimulationChanged"
                                                           ExecuteWorkflowStart="ExecuteWorkflowStartAsync"
                                                           ProcessStartDialog="@processStartDialog"
            CloseProcessStart="CloseProcessStartDialog"
            ExecuteProcessStart="ExecuteProcessStartAsync"
            ReviewAndStartProcess="ReviewAndStartProcessAsync"
            SelectProcessStartCandidate="SelectProcessStartCandidateAsync"
            AssignProcessStartAgent="OpenManualProcessStartAgentPickerAsync"
            ProcessStartAssignmentsReviewedChanged="HandleProcessStartAssignmentsReviewedChanged"
            RequestHrManagerMatch="RequestHrManagerMatchAsync"
            CancelHrManagerMatch="CancelHrManagerMatchAsync"
            ExecuteHrManagerMatch="ExecuteHrManagerMatchAsync"
                                                           QuickActionDialog="@quickActionDialog"
                                                           CloseQuickActionDialog="CloseQuickActionDialog"
                                                           ExecuteQuickAction="ExecuteQuickActionAsync"
                                                           WebPreviewDialog="@webPreviewDialog"
                                                           CloseWebPreviewDialog="CloseWebPreviewDialog"
                                                           PreviewNode="@previewNode"
                                                           PreviewInteraction="@PreviewInteraction"
                                                           CloseAttachmentPreview="CloseAttachmentPreviewAsync"
                                                           OpenAttachmentLocally="OpenAttachmentLocallyAsync"
                                                           OpenAttachmentInPreferredApplication="OpenAttachmentInPreferredApplicationAsync"
                                                           EditPreviewNode="EditAttachmentPreviewNodeAsync"
                                                           CanShowLocalOpen="CanShowLocalOpen"
                                                           CanOpenInPreferredApplication="CanOpenInPreferredApplication"
                                                           CanEditPreviewNode="CanEditNode" />
                        </ProjectStructureDeferredSurface>
                    </OverlayContent>
                </CanvasWorkbench>
            </Canvas>
        </CanvasWorkbenchStage>
            </TabsItem>
            <TabsItem Text="Gantt" Icon="view_timeline">
                <ProjectStructureGanttPanel ProjectId="@ProjectId"
                                            Surface="@surface"
                                            OpenAgentCatalog="ToggleAgentWindowAsync"
                                            MutationCommitted="@(() => ReloadSurfaceAsync())"
                                            ObservationChanged="HandleGanttObservationChanged" />
            </TabsItem>
            <TabsItem Text="Manager Summary" Icon="monitoring">
                <ProjectManagerSummaryPanel ProjectId="@ProjectId" />
            </TabsItem>
        </Tabs>

        @if (structureViewIndex == CanvasViewIndex && CanShowPartyEditor)
        {
            <SectionCard Title="@PartyEditorTitle"
                         Description="@PartyEditorDescription">
                <div class="space-y-5"
                     data-testid="project-structure-party-editor">
                    <SurfaceCard Soft="true">
                        <Stack GapScale="LayoutGap.Small">
                            <Cluster>
                                <StatusBadge Tone="@PartyEditorTone"
                                             Text="@PartyEditorStatus" />
                                @if (!string.IsNullOrWhiteSpace(PartyEditorLinkedPartyName))
                                {
                                    <Pill Tone="PillTone.Info"
                                          Text="@PartyEditorLinkedPartyName" />
                                }
                            </Cluster>
                            <p class="text-sm text-slate-600">@PartyEditorLead</p>
                        </Stack>
                    </SurfaceCard>

                    @if (isPartyEditorLoading)
                    {
                        <SurfaceCard Soft="true"
                                     data-testid="project-structure-party-editor-loading">
                            <p class="text-sm text-slate-600">Loading party relationships for the selected node.</p>
                        </SurfaceCard>
                    }
                    else if (!string.IsNullOrWhiteSpace(partyEditor.Message))
                    {
                        <SurfaceCard Soft="true">
                            <p class="text-sm @(partyEditor.MessageTone == "danger" ? "text-rose-700" : "text-slate-700")"
                               data-testid="project-structure-party-editor-message">@partyEditor.Message</p>
                        </SurfaceCard>
                    }

                    @if (isPartyEditorLoading)
                    {
                        <SurfaceCard Soft="true">
                            <p class="text-sm text-slate-600">Preparing the directory linkage controls.</p>
                        </SurfaceCard>
                    }
                    else if (IsParticipantPartyEditor)
                    {
                        <SurfaceCard>
                            <Stack GapScale="LayoutGap.Large">
                                <label class="inline-flex items-center gap-2 text-sm text-slate-700">
                                    <InputCheckbox @bind-Value="partyEditor.KeepProjectLocalOnly"
                                                   data-testid="project-structure-participant-local-only" />
                                    <span>Keep project-local only</span>
                                </label>

                                @if (!partyEditor.KeepProjectLocalOnly)
                                {
                                    <Stack GapScale="LayoutGap.Small">
                                        <TextBlock TextStyle="TextStyle.Footer"
                                                   Value="Existing party" />
                                        <ResourceCardPicker TItem="Guid"
                                                            Options="@ParticipantPartyPickerOptions"
                                                            SelectionChanged="HandleParticipantPartySelectedAsync"
                                                            SearchPlaceholder="Search people, agents, and organizations"
                                                            EmptyTitle="No parties match the current search"
                                                            DataTestId="project-structure-participant-party" />
                                        <Cluster>
                                            <Button Text="Clear selection"
                                                    Variant="Variant.Text"
                                                    Tone="ButtonTone.Default"
                                                    Disabled="@(!partyEditor.SelectedPartyId.HasValue)"
                                                    data-testid="project-structure-participant-party-clear"
                                                    Click="ClearPartySelectionAsync" />
                                        </Cluster>
                                        <TextBlock TextStyle="TextStyle.Note"
                                                   Value="The synced party can drive reusable staffing, AI-agent reuse, and meeting defaults without forcing every participant node into the central directory." />
                                    </Stack>

                                    <SurfaceCard Soft="true">
                                        <Stack GapScale="LayoutGap.Medium">
                                            <div>
                                                <TextBlock TextStyle="TextStyle.EyebrowCaption" Value="Quick create" />
                                                <p class="mt-1 text-sm text-slate-600">Create a directory record from the selected participant node when nothing reusable exists yet.</p>
                                            </div>

                                            <Grid Gap="LayoutGap.Medium"
                                                  ColumnsLg="2">
                                                <FormField Text="Kind">
                                                    <InputSelect @bind-Value="partyEditor.QuickCreate.PartyKind"
                                                                 class="ui-input"
                                                                 data-testid="project-structure-participant-quick-kind">
                                                        @foreach (var kind in Enum.GetValues<ProjectPartyQuickCreateKind>())
                                                        {
                                                            <option value="@kind">@ResolveQuickCreateKindLabel(kind)</option>
                                                        }
                                                    </InputSelect>
                                                </FormField>
                                                <FormField Text="Name">
                                                    <InputText @bind-Value="partyEditor.QuickCreate.DisplayName"
                                                               class="ui-input"
                                                               data-testid="project-structure-participant-quick-name" />
                                                </FormField>
                                            </Grid>

                                            <Grid Gap="LayoutGap.Medium"
                                                  ColumnsLg="2">
                                                <FormField Text="Email">
                                                    <InputText @bind-Value="partyEditor.QuickCreate.Email"
                                                               class="ui-input"
                                                               data-testid="project-structure-participant-quick-email" />
                                                </FormField>
                                                <FormField Text="Phone">
                                                    <InputText @bind-Value="partyEditor.QuickCreate.Phone"
                                                               class="ui-input"
                                                               data-testid="project-structure-participant-quick-phone" />
                                                </FormField>
                                            </Grid>

                                            <FormField Text="Summary">
                                                <TextArea @bind-Value="partyEditor.QuickCreate.Summary"
                                                               Rows="4"
                                                               data-testid="project-structure-participant-quick-summary" />
                                            </FormField>

                                            <Cluster>
                                                <Button Tone="ButtonTone.Default"
                                                        Text="Create party"
                                                        Disabled="@isPartyEditorBusy"
                                                        data-testid="project-structure-participant-quick-create"
                                                        Click="CreateParticipantPartyAsync" />
                                            </Cluster>
                                        </Stack>
                                    </SurfaceCard>
                                }

                                <Cluster>
                                    <Button Text="Save participant sync"
                                            Disabled="@isPartyEditorBusy"
                                            data-testid="project-structure-participant-save"
                                            Click="SaveParticipantPartyAsync" />
                                </Cluster>
                            </Stack>
                        </SurfaceCard>
                    }
                    else if (IsMeetingPartyEditor)
                    {
                        <SurfaceCard>
                            <Stack GapScale="LayoutGap.Large">
                                <Cluster>
                                    <Button Tone="ButtonTone.Default"
                                            Text="Use project defaults"
                                            Disabled="@isPartyEditorBusy"
                                            data-testid="project-structure-meeting-project-defaults"
                                            Click="ApplyMeetingProjectDefaultsAsync" />
                                    <Pill Tone="PillTone.Neutral"
                                          Text="@($"{partyEditor.SelectedMeetingPartyIds.Count} selected")" />
                                </Cluster>

                                <Grid Gap="LayoutGap.Medium"
                                      ColumnsLg="2">
                                    @foreach (var option in partyEditorOptions)
                                    {
                                        <label class="flex items-start gap-3 rounded-[1.25rem] border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700"
                                               data-testid="project-structure-meeting-party-option">
                                            <input type="checkbox"
                                                   checked="@partyEditor.SelectedMeetingPartyIds.Contains(option.PartyId)"
                                                   data-testid="project-structure-meeting-party-checkbox"
                                                   @onchange="args => HandleMeetingPartyChanged(option.PartyId, args)" />
                                            <span>
                                                <span class="block font-semibold text-slate-950">@option.DisplayName</span>
                                                <span class="block">@option.PartyTypeLabel</span>
                                            </span>
                                        </label>
                                    }
                                </Grid>

                                <Cluster>
                                    <Button Text="Save meeting parties"
                                            Disabled="@isPartyEditorBusy"
                                            data-testid="project-structure-meeting-save"
                                            Click="SaveMeetingPartiesAsync" />
                                </Cluster>
                            </Stack>
                        </SurfaceCard>
                    }
                </div>
            </SectionCard>
        }

        </Stack>
    </div>
}

<ProjectStructureDeferredSurface RenderKey="@SupportDialogRenderKey">
    <ProjectStructureSupportDialogs SummaryDialog="@summaryDialog"
                                    CloseSummary="CloseSummary"
                                    ExportSummaryWorkbook="ExportSummaryWorkbookAsync"
                                    ExportSummaryGantt="ExportSummaryGanttAsync"
                                    ChangeSummaryStatus="HandleSummaryStatusChangedAsync"
                                    SummaryStatuses="@SummaryStatusOptions"
                                    PendingDeletePrompt="@pendingDeletePrompt"
                                    ConfirmDelete="ConfirmDeleteAsync"
                                    CancelDelete="CancelDelete"
                                    PendingTranscriptAction="@pendingTranscriptAction"
                                    ExecuteTranscriptAction="ExecuteTranscriptActionAsync"
                                    CancelTranscriptAction="CancelTranscriptAction"
                                    HandleTranscriptProviderChanged="HandleTranscriptProviderChanged"
                                    MermaidPreviewNode="@MermaidViewerNode"
                                    CloseMermaidViewer="CloseMermaidViewer"
                                    EditMermaidNode="EditMermaidPreviewNodeAsync"
                                    CanEditMermaidNode="CanEditNode"
                                    ResolveTranscriptActionLabel="ResolveTranscriptActionLabel" />
</ProjectStructureDeferredSurface>

<ProjectStructureDeferredSurface RenderKey="@CanvasOverlayRenderKey">
    <ProjectStructureCanvasDialogs RenderProcessStartDialog="true"
                                   ProcessStartDialog="@processStartDialog"
                                   CloseProcessStart="CloseProcessStartDialog"
                                   ExecuteProcessStart="ExecuteProcessStartAsync"
                                   ReviewAndStartProcess="ReviewAndStartProcessAsync"
                                   SelectProcessStartCandidate="SelectProcessStartCandidateAsync"
                                   AssignProcessStartAgent="OpenManualProcessStartAgentPickerAsync"
                                   ProcessStartAssignmentsReviewedChanged="HandleProcessStartAssignmentsReviewedChanged"
                                   RequestHrManagerMatch="RequestHrManagerMatchAsync"
                                   CancelHrManagerMatch="CancelHrManagerMatchAsync"
                                   ExecuteHrManagerMatch="ExecuteHrManagerMatchAsync"
                                   EditPreviewNode="EditAttachmentPreviewNodeAsync"
                                   CanShowLocalOpen="CanShowLocalOpen"
                                   CanOpenInPreferredApplication="CanOpenInPreferredApplication"
                                   CanEditPreviewNode="CanEditNode" />
</ProjectStructureDeferredSurface>

@if (isSecretReferenceDialogOpen)
{
    <ProjectStructureOverlayDialog AriaLabel="Select stored secret for project structure"
                                   Kicker="Secret reference"
                                   Title="@SecretReferenceDialogTitle"
                                   Summary="@SecretReferenceDialogSummary"
                                   DialogClass="project-structure-summary-dialog"
                                   Close="CloseSecretReferenceDialog">
        <Actions>
            <Button Text="Close"
                    Icon="close"
                    Variant="Variant.Text"
                    Tone="ButtonTone.Default"
                    Click="CloseSecretReferenceDialog" />
        </Actions>
        <Body>
            <Stack GapScale="LayoutGap.Large"
                   AlignItems="AlignItems.Stretch"
                   data-testid="project-structure-secret-dialog">
                @if (!string.IsNullOrWhiteSpace(secretReferenceDialogError))
                {
                    <Alert AlertStyle="AlertStyle.Warning">
                        <p>@secretReferenceDialogError</p>
                    </Alert>
                }

                <Grid Gap="LayoutGap.Medium" ColumnsMd="2">
                    <FormField Text="Stored secret">
                        <select class="ui-input"
                                value="@selectedSecretReferenceId"
                                @onchange="HandleSelectedSecretReferenceChanged"
                                disabled="@isSecretReferenceDialogBusy"
                                data-testid="project-structure-secret-select">
                            <option value="">Select stored secret</option>
                            @foreach (var secret in SecretReferenceSelectItems)
                            {
                                <option value="@secret.Id.ToString("D")">@secret.Name (@secret.Kind)</option>
                            }
                        </select>
                    </FormField>
                    <FormField Text="Search stored secrets">
                        <input class="ui-input"
                               value="@secretReferenceSearch"
                               @oninput="HandleSecretReferenceSearchChanged"
                               data-testid="project-structure-secret-search" />
                    </FormField>
                </Grid>

                @if (!string.IsNullOrWhiteSpace(SecretReferenceSelectMessage))
                {
                    <Alert AlertStyle="AlertStyle.Info">
                        <p>@SecretReferenceSelectMessage</p>
                    </Alert>
                }

                <Grid Gap="LayoutGap.Medium" ColumnsMd="2">

    private bool TryPatchSurfaceNodePositions(IReadOnlyCollection<CanvasWorkbenchNodePositionChange> positions)
    {
        if (surface is null || positions.Count == 0)
        {
            return false;
        }

        var positionsByNodeId = positions
            .Where(position => !string.IsNullOrWhiteSpace(position.NodeId))
            .GroupBy(position => position.NodeId, StringComparer.Ordinal)
            .ToDictionary(group => group.Key, group => group.Last(), StringComparer.Ordinal);
        if (positionsByNodeId.Count == 0)
        {
            return false;
        }

        var changed = false;
        var patchedNodes = surface.Nodes
            .Select(node =>
            {
                if (!positionsByNodeId.TryGetValue(node.Id, out var position) ||
                    (Math.Abs(node.X - position.X) < 0.001 && Math.Abs(node.Y - position.Y) < 0.001))
                {
                    return node;
                }

                changed = true;
                return node with
                {
                    X = position.X,
                    Y = position.Y
                };
            })
            .ToList();
        if (!changed)
        {
            return false;
        }

        surface = surface with { Nodes = patchedNodes };

        if (previewNode is not null)
        {
            previewNode = patchedNodes.FirstOrDefault(node => string.Equals(node.Id, previewNode.Id, StringComparison.Ordinal));
        }

        if (mermaidPreviewNode is not null)
        {
            mermaidPreviewNode = patchedNodes.FirstOrDefault(node => string.Equals(node.Id, mermaidPreviewNode.Id, StringComparison.Ordinal));
        }

        RefreshCanvasSurface();
        return true;
    }

    private readonly SemaphoreSlim canvasViewStateCommitGate = new(1, 1);

    private void ScheduleCanvasViewStatePersistence() {
        CancelPendingCanvasViewStatePersistence();
        if (surface is null || string.IsNullOrWhiteSpace(currentViewStateJson)) {
            return;
        }
        var context = CaptureActionContext();
        var persistCts = new CancellationTokenSource();
        pendingCanvasViewStatePersistCts = persistCts;
        _ = TrackAuthoringOperationAsync(PersistCanvasViewStateWhenIdleAsync(context, persistCts, currentViewStateJson));
    }

    private async Task PersistCanvasViewStateWhenIdleAsync(ProjectStructureActionContext context, CancellationTokenSource persistCts, string stateJson) {
        try {
            await Task.Delay(CanvasViewStatePersistDelayMs, persistCts.Token);
            await PersistCapturedViewStateAsync(context, stateJson, persistCts.Token);
        } catch (OperationCanceledException) when (persistCts.IsCancellationRequested) {
        } catch (Exception failure) {
            ReportActionFailure(context, failure, "The original canvas state could not be confirmed.");
            await RenderAuthoringOutcomeAsync();
        } finally {
            if (ReferenceEquals(pendingCanvasViewStatePersistCts, persistCts)) {
                pendingCanvasViewStatePersistCts = null;
            }
            persistCts.Dispose();
        }
    }

    private async Task<bool> PersistCapturedViewStateAsync(ProjectStructureActionContext context, string stateJson, CancellationToken cancellationToken = default) {
        await canvasViewStateCommitGate.WaitAsync(cancellationToken);
        try {
            if (!IsCurrentAction(context)) {
                return false;
            }
            cancellationToken.ThrowIfCancellationRequested();
            await ProjectWorkbenchService.SaveViewStateAsync(context.Admission, "structure", stateJson);
            return true;
        } finally {
            canvasViewStateCommitGate.Release();
        }
    }

    private void CancelPendingCanvasViewStatePersistence() {
        var persistCts = pendingCanvasViewStatePersistCts;
        pendingCanvasViewStatePersistCts = null;
        persistCts?.Cancel();
    }

    private Task PersistCurrentViewStateAsync() {
        CancelPendingCanvasViewStatePersistence();
        return string.IsNullOrWhiteSpace(currentViewStateJson) ? Task.CompletedTask :
            TrackAuthoringOperationAsync(PersistCapturedViewStateAsync(CaptureActionContext(), currentViewStateJson));
    }

    private static CanvasWorkbenchUiState NormalizePersistedCanvasUiState(CanvasWorkbenchUiState uiState)
    {
        uiState.ManualPositions = [];
        return uiState;

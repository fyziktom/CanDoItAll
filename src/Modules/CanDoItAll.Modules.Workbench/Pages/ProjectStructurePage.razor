    private Task UseSelectedProjectStructureSecretAsync() {
        var selectedSecretId = SelectedSecretReferenceGuid;
        var selectedSecret = selectedSecretId.HasValue
            ? secretReferenceItems.FirstOrDefault(secret => secret.Id == selectedSecretId.Value) : null;
        if (selectedSecret is null) {
            secretReferenceDialogError = "Select a stored secret first.";
            return Task.CompletedTask;
        }
        return SelectProjectStructureSecretAsync(selectedSecret);
    }

    private sealed record SecretReferenceAction(
        ProjectStructureActionContext Context,
        ProjectStructureNode? EditedNode,
        ProjectStructureCreateLeafDefinition? Definition,
        CanvasWorkbenchCreateActionRequest? Request,
        string Purpose,
        string ExternalReference);

    private SecretReferenceAction CaptureSecretReferenceAction() {
        var context = secretReferenceActionContext
            ?? throw new InvalidOperationException("Reopen the secret reference dialog to capture its original project.");
        ProjectStructureNode? editedNode = null;
        ProjectStructureCreateLeafDefinition? definition = null;
        CanvasWorkbenchCreateActionRequest? request = null;
        if (isSecretReferenceEditMode) {
            editedNode = context.Surface.Nodes.FirstOrDefault(node => string.Equals(node.Id, secretReferenceEditNodeId, StringComparison.Ordinal))
                ?? throw new InvalidOperationException("The original secret reference node is no longer available.");
        } else if (TryResolvePendingSecretCreateRequest(out var resolvedDefinition, out var resolvedRequest)) {
            definition = resolvedDefinition;
            request = resolvedRequest;
        } else {
            throw new InvalidOperationException(secretReferenceDialogError);
        }
        return new(context, editedNode, definition, request,
            NormalizeSecretReferencePurpose(), secretReferenceExternalReference.Trim());
    }

    private bool IsCurrentSecretReferenceDialog(ProjectStructureActionContext context)
        => ReferenceEquals(secretReferenceActionContext, context) && IsCurrentAction(context);

    private void ReportSecretReferenceFailure(SecretReferenceAction action, Exception exception, string? completed) {
        var failureMessage = ReportActionFailure(action.Context, exception, completed);
        if (IsCurrentSecretReferenceDialog(action.Context)) {
            secretReferenceDialogError = failureMessage;
        }
    }

    private async Task SelectProjectStructureSecretAsync(SecretListItem secret) {
        var action = CaptureSecretReferenceAction();
        selectedSecretReferenceId = secret.Id.ToString("D");
        isSecretReferenceDialogBusy = true;
        secretReferenceDialogError = string.Empty;
        ProjectStructureNode? committed = null;
        try {
            await SaveProjectStructureSecretReferenceAsync(action, secret, node => committed = node);
        } catch (Exception exception) {
            ReportSecretReferenceFailure(action, exception, committed is null ? null : $"Secret reference {committed.Title} ({committed.Id}) was saved.");
        } finally {
            if (IsCurrentSecretReferenceDialog(action.Context)) {
                isSecretReferenceDialogBusy = false;
            }
        }
    }

    private async Task CreateAndUseProjectStructureSecretAsync() {
        var action = CaptureSecretReferenceAction();
        var model = new SecretEditorModel {
            Id = secretReferenceCreateModel.Id,
            Name = secretReferenceCreateModel.Name,
            Kind = secretReferenceCreateModel.Kind,
            SecretValue = secretReferenceCreateModel.SecretValue,
            Scope = secretReferenceCreateModel.Scope,
            RotationNote = secretReferenceCreateModel.RotationNote,
            MetadataJson = secretReferenceCreateModel.MetadataJson
        };
        isSecretReferenceDialogBusy = true;
        secretReferenceDialogError = string.Empty;
        Guid? createdSecretId = null;
        ProjectStructureNode? committed = null;
        try {
            var result = await SecretService.SaveAsync(model);
            if (!result.IsSuccess) {
                throw new InvalidOperationException(string.Join(" ", result.Errors.Select(error => error.Message)));
            }
            createdSecretId = result.Value;
            var items = await WorkspaceService.ListSecretsAsync();
            var createdSecret = items.FirstOrDefault(secret => secret.Id == result.Value)
                ?? throw new InvalidOperationException("The picker could not reload the created secret's catalog entry.");
            if (IsCurrentSecretReferenceDialog(action.Context)) {
                secretReferenceItems = items;
                selectedSecretReferenceId = createdSecret.Id.ToString("D");
            }
            await SaveProjectStructureSecretReferenceAsync(action, createdSecret, node => committed = node);
        } catch (Exception exception) {
            var completed = committed is not null ? $"Secret reference {committed.Title} ({committed.Id}) was saved."
                : createdSecretId is { } id ? $"Secret {id:D} was created; completion of its original project reference could not be confirmed."
                : null;
            ReportSecretReferenceFailure(action, exception, completed);
        } finally {
            if (IsCurrentSecretReferenceDialog(action.Context)) {
                isSecretReferenceDialogBusy = false;
            }
        }
    }

    private async Task SaveProjectStructureSecretReferenceAsync(
        SecretReferenceAction action, SecretListItem secret, Action<ProjectStructureNode> onCommitted) {
        ProjectStructureNode updated;
        if (action.EditedNode is { } targetNode) {
            var metadata = ProjectObjectMetadataSerializer.Parse(targetNode.MetadataJson);
            metadata.SecretReference = new ProjectSecretReferenceMetadata {
                SecretId = secret.Id,
                SecretNameSnapshot = secret.Name,
                Purpose = action.Purpose,
                ExternalReference = action.ExternalReference
            };
            updated = await ProjectWorkbenchService.UpdateObjectAsync(
                action.Context.Surface.ProjectId, targetNode.Id,
                new ProjectObjectEditRequest(secret.Name, action.ExternalReference, action.Purpose,
                    targetNode.StartUtc, targetNode.EndUtc, ProjectObjectMetadataSerializer.Serialize(metadata),
                    targetNode.DurationSeconds, targetNode.NodeReferences) { ExpectedProjectAdmission = action.Context.Admission })
                ?? throw new InvalidOperationException("The original secret reference node could not be updated.");
            onCommitted(updated);
            if (IsCurrentAction(action.Context)) {
                await ApplySurfaceNodeUpdatesAsync([updated]);
            }
        } else {
            var request = BuildSecretReferenceCreateRequest(action.Request!, secret, action.Purpose, action.ExternalReference);
            updated = await CreateObjectAsync(action.Definition!, request,
                configureRequest: prepared => prepared with { ExpectedProjectAdmission = action.Context.Admission },
                onNodeCommitted: onCommitted, capturedSurface: action.Context.Surface,
                capturedNavigationRevision: action.Context.NavigationRevision)
                ?? throw new InvalidOperationException("The original secret reference node could not be created.");
        }
        ReportActionResult(action.Context, $"{updated.Title} was {(action.EditedNode is null ? "created" : "updated")}.");
        if (IsCurrentSecretReferenceDialog(action.Context)) {
            CloseSecretReferenceDialog();
        }
    }

    private bool TryResolvePendingSecretCreateRequest(
        out ProjectStructureCreateLeafDefinition definition,
        out CanvasWorkbenchCreateActionRequest request)
    {
        definition = default!;
        request = default!;
        if (secretReferenceAction is null ||
            secretReferenceRequest is null)
        {
            secretReferenceDialogError = "Secret reference create state is no longer available.";
            return false;
        }

        if (!ProjectStructureCanvasCatalog.TryResolveCreateDefinition(secretReferenceAction.ActionId, out definition))
        {
            secretReferenceDialogError = "Secret reference create action is not registered.";
            return false;
        }

        request = secretReferenceRequest;
        return true;
    }

    private static CanvasWorkbenchCreateActionRequest BuildSecretReferenceCreateRequest(
        CanvasWorkbenchCreateActionRequest request,
        SecretListItem secret,
        string purpose,
        string externalReference)
    {
        return request with
        {
            Title = secret.Name,
            Subtitle = externalReference,
            Notes = purpose,
            InputValues =
            [
                new CanvasWorkbenchInputValue
                {
                    Key = "secretId",
                    Value = secret.Id.ToString("D")
                },
                new CanvasWorkbenchInputValue
                {
                    Key = "secretName",
                    Value = secret.Name
                }
            ]
        };
    }

    private string NormalizeSecretReferencePurpose()
        => string.IsNullOrWhiteSpace(secretReferencePurpose)
            ? "Project structure reference"
            : secretReferencePurpose.Trim();

    private static bool IsSecretReferenceCreateRequest(CanvasWorkbenchCreateActionRequest request)
        => IsSecretReferenceCreateAction(request.ActionId) ||
           string.Equals(request.CreateMode, "secret-reference-picker", StringComparison.Ordinal);

    private static SecretEditorModel NewProjectStructureSecretModel()
        => new()
        {
            Kind = SecretKind.Generic,
            Scope = "project-structure",
            MetadataJson = "{}",
            RotationNote = "Project structure reference"
        };

    private async Task SelectNodeAsync(string nodeId)
    {
        if (IsDependencyMode &&
            !string.IsNullOrWhiteSpace(linkModeSourceId) &&
            !string.Equals(linkModeSourceId, nodeId, StringComparison.Ordinal))
        {
            await CreateDependencyAsync(linkModeSourceId, nodeId);
            return;
        }

        selectedNodeIds = [nodeId];

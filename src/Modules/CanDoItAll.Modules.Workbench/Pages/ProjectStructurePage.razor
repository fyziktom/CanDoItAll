@page "/projects/{ProjectId:guid}/structure"
@* codex-capsule
kind: page
name: ProjectStructurePage
summary: Hosts the shared project structure canvas, mirrored inspector, typed graph actions, and supporting outline tools.
owns: shared-structure-canvas, node-outline, mirrored-inspector
deps: ProjectWorkbenchService, NavigationManager
risks: stale-node-selection, invalid-command-routing, overlapping-create-placement
tests: component:ProjectStructurePageTests, e2e:workbench-structure
*@
@using CanDoItAll.Components.CanvasLib
@using CanDoItAll.AgentFramework.Core
@using CanDoItAll.AgentFramework.Models
@using CanDoItAll.AgentFramework.Providers
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using CanDoItAll.Conversations.Shell
@using CanDoItAll.Modules.Projects
@using CanDoItAll.Modules.Projects.Pages.Components
@using CanDoItAll.Modules.Security
@using CanDoItAll.Modules.Workbench.CanvasAdapters
@using CanDoItAll.Modules.Workbench.Pages.Components.ProjectStructure
@using CanDoItAll.Modules.Workbench.ProjectStructure
@using CanDoItAll.Modules.Workspace
@using CanDoItAll.Infrastructure.Storage
@using CanDoItAll.SharedKernel
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Logging
@inject ProjectsService ProjectsService
@inject IProjectPartyIntegrationBridge ProjectPartyIntegrationBridge
@inject ProjectWorkbenchService ProjectWorkbenchService
@inject ProjectStructureSubprojectTransferCoordinator SubprojectTransferCoordinator
@inject IProjectWorkbenchSeedService ProjectWorkbenchSeedService
@inject IProjectStructureLocalFileOpener LocalFileOpener
@inject IProjectStructureRuntimeLauncher RuntimeLauncher
@inject DialogService DialogService
@inject ProjectStructureFileActionCoordinator FileActionCoordinator
@inject ProjectStructureKnownFileInteractionCoordinator KnownFileInteractionCoordinator
@inject ProjectStructureLocalFileActionCoordinator LocalFileActionCoordinator
@inject WorkspaceService WorkspaceService
@inject SecretService SecretService
@inject IProviderRuntimeProfileSource ProviderRuntimeProfileSource
@inject IProviderPromptExecutionService ProviderPromptExecutionService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<ProjectStructurePage> Logger
@inject IConversationShellCoordinator ConversationShellCoordinator
@implements IAsyncDisposable

<PageTitle>@ProjectStructurePageTitleBuilder.Build(surface?.ProjectName)</PageTitle>

<ProjectStructureAgentChatContextProvider ProjectId="@ProjectId"
                                          ProjectName="@(surface?.ProjectName ?? "Requested project")"
                                          Surface="@surface"
                                          ActiveView="@ActiveAgentChatView"
                                          SelectedNodes="@(surface is not null && structureViewIndex == CanvasViewIndex ? selectedNodes : [])"
                                          GanttObservation="@(structureViewIndex == GanttViewIndex ? ganttObservation : null)"
                                          ContextNavigationIdentity="@AgentChatNavigationFence"
                                          ContextAccessState="@agentChatContextAccessState"
                                          RefreshRequested="HandleAgentExecutionCompletedAsync" />

<StructureWorkspace @ref="workbenchRef" @key="StructureContextId" Presentation="@BuildStructurePresentation()" SelectedView="@structureViewIndex" Dispatch="HandleStructureIntentAsync" Dialogs="@BuildStructureDialogs()" DialogIntent="HandleStructureDialogIntentAsync">
    <Planning>
                <ProjectStructureGanttPanel ProjectId="@ProjectId"
                                            Surface="@surface"
                                            OpenAgentCatalog="ToggleAgentWindowAsync"
                                            MutationCommitted="@(() => ReloadSurfaceAsync())"
                                            ObservationChanged="HandleGanttObservationChanged" />
    </Planning>
    <Insights>
                <ProjectManagerSummaryPanel ProjectId="@ProjectId" ExpectedProjectAdmission="@surface?.ExpectedProjectAdmission" />
    </Insights>
    <SupportWindows>
                        @if (ObjectIndexWindowState.IsVisible)
                        {
                            <ProjectStructureObjectIndexWindow WindowId="@ObjectIndexWindowKey"
                                                               TestId="project-structure-object-index-window"
                                                               AriaLabel="Project object index"
                                                               Kicker="Object index"
                                                               Title="Project object index"
                                                               Summary="@ObjectIndexWindowSummary"
                                                               State="@ObjectIndexWindowState"
                                                               Origin="@CurrentInsights.Origin"
                                                               StateChanged="HandleInsightsWindowAsync"
                                                               IsLoaded="@IsObjectIndexWindowLoaded"
                                                               Nodes="@ObjectIndexWindowNodes.Select(PresentOutlineNode).ToArray()"
                                                               SelectedNodeIds="@selectedNodeIds"
                                                               SearchText="@objectIndexSearchText"
                                                               SearchTextChanged="HandleInsightsSearchAsync"
                                                               OnSelectNode="HandleInsightsFocusAsync"
                                                               OpenMenu="OpenInsightsMenuAsync"
                                                               OnExecuteNodeContextAction="ExecuteInsightsMenuAsync"
                                                               DefaultWidth="@ObjectIndexWindowDefaultWidth" />
                        }
                        @if (FileBrowserWindowState.IsVisible)
                        {
                            <ProjectStructureFileBrowserWindow WindowId="@FileBrowserWindowKey"
                                                               Opening="@CurrentFileBrowserOpening"
                                                               ActionCompleted="RecordFileActionOutcome"
                                                               State="@FileBrowserWindowState"
                                                               StateChanged="HandleFileBrowserWindowStateChangedAsync"
                                                               CanOpenRootInExplorer="@CanOpenCurrentFileBrowserNodeInExplorer"
                                                               OpenRootInExplorer="OpenCurrentFileBrowserNodeInExplorerAsync" />
                        }
                        @if (HealthWindowState.IsVisible)
                        {
                            <ProjectStructureCanvasHealthWindow WindowId="@HealthWindowKey"
                                                                TestId="project-structure-validation-window"
                                                                AriaLabel="Project structure canvas health"
                                                                State="@HealthWindowState"
                                                                Origin="@CurrentInsights.Origin"
                                                                SelectedNodeIds="@selectedNodeIds.ToArray()"
                                                                StateChanged="HandleInsightsWindowAsync"
                                                                SummaryState="@canvasValidationOverlay"
                                                                CanValidateSelected="false" />
                        }
                        @if (SignalsWindowState.IsVisible)
                        {
                            <ProjectStructureSignalsWindow WindowId="@SignalsWindowKey"
                                                           TestId="project-structure-signals-window"
                                                           AriaLabel="Project structure node signals"
                                                           Kicker="Node signals"
                                                           Title="Signals toolbox"
                                                           Summary="Keep markers, progress, and priority close to the current selection without reopening the right-click menu every time."
                                                           State="@SignalsWindowState"
                                                           Origin="@CurrentInsights.Origin"
                                                           SelectedNodeIds="@selectedNodeIds.ToArray()"
                                                           StateChanged="HandleInsightsWindowAsync"
                                                           Sections="@CurrentInsights.Signals"
                                                           CanApplySignals="@CanApplySignals"
                                                           SelectionLabel="@SignalsSelectionLabel"
                                                           SelectionHint="@SignalsSelectionHint"
                                                           DefaultWidth="@SignalsWindowDefaultWidth"
                                                           OnApplyAction="HandleInsightsSignalAsync" />
                        }
                        @if (SelectionWindowState.IsVisible)
                        {
                            <CanDoItAll.Workbench.Insights.UI.InsightsSelectionWindow
                                WindowId="@SelectionWindowKey" Origin="@CurrentInsights.Origin"
                                Title="@SelectionWindowTitle" Summary="@SelectionWindowSummary"
                                WindowState="@SelectionWindowState" WindowChanged="HandleInsightsWindowAsync"
                                Selection="@CurrentInsights.Selection" Dispatch="HandleInsightsSelectionAsync"
                                Help="@AdvancedDetailsHelpBody" Tip="@AdvancedDetailsHelpTip" />
                        }

    </SupportWindows>
    <DeferredDialogs>
                            <ProjectStructureDeferredSurface RenderKey="@CanvasOverlayRenderKey">
                            <ProjectStructureCanvasDialogs RenderProcessStartDialog="false"
                                                           ProcessLinkDialog="@processLinkDialog"
                                                           CloseProcessLink="CloseProcessLinkDialog"
                                                           ProcessLinkSelectionChanged="HandleProcessLinkSelectionChanged"
                                                           ExecuteProcessLink="ExecuteProcessLinkAsync"
                                                           WorkflowAddDialog="@workflowAddDialog"
                                                           CloseWorkflowAdd="CloseWorkflowAddDialog"
                                                           WorkflowAddSelectionChanged="HandleWorkflowAddSelectionChanged"
                                                           WorkflowAddIncludeParentSubtreeChanged="HandleWorkflowAddIncludeParentSubtreeChanged"
                                                           WorkflowAddIncludeAssetsChanged="HandleWorkflowAddIncludeAssetsChanged"
                                                           WorkflowAddManualInputChanged="HandleWorkflowAddManualInputChanged"
                                                           WorkflowAddSourceKindChanged="HandleWorkflowAddSourceKindChanged"
                                                           WorkflowAddSourceKeyChanged="HandleWorkflowAddSourceKeyChanged"
                                                           WorkflowAddSourceLabelChanged="HandleWorkflowAddSourceLabelChanged"
                                                           WorkflowAddSourceValueChanged="HandleWorkflowAddSourceValueChanged"
                                                           ExecuteWorkflowAdd="ExecuteWorkflowAddAsync"
                                                           WorkflowStartDialog="@workflowStartDialog"
                                                           CloseWorkflowStart="CloseWorkflowStartDialog"
                                                           WorkflowStartSimulationChanged="HandleWorkflowStartSimulationChanged"
                                                           ExecuteWorkflowStart="ExecuteWorkflowStartAsync"
                                                           ProcessStartDialog="@processStartDialog"
            CloseProcessStart="CloseProcessStartDialog"
            ExecuteProcessStart="ExecuteProcessStartAsync"
            ReviewAndStartProcess="ReviewAndStartProcessAsync"
                                   PrepareAnotherProcessLaunch="PrepareAnotherProcessLaunchAsync"
            SelectProcessStartCandidate="SelectProcessStartCandidateAsync"
            AssignProcessStartAgent="OpenManualProcessStartAgentPickerAsync"
            ProcessStartAssignmentsReviewedChanged="HandleProcessStartAssignmentsReviewedChanged"
            RequestHrManagerMatch="RequestHrManagerMatchAsync"
            CancelHrManagerMatch="CancelHrManagerMatchAsync"
            ExecuteHrManagerMatch="ExecuteHrManagerMatchAsync"
                                                           QuickActionDialog="@quickActionDialog"
                                                           CloseQuickActionDialog="CloseQuickActionDialog"
                                                           ExecuteQuickAction="ExecuteQuickActionAsync"
                                                           WebPreviewDialog="@webPreviewDialog"
                                                           StopWebPreviewRuntime="StopWebPreviewRuntimeAsync"
                                                           CloseWebPreviewDialog="CloseWebPreviewDialog"
                                                           PreviewNode="@previewNode"
                                                           PreviewInteraction="@PreviewInteraction"
                                                           CloseAttachmentPreview="CloseAttachmentPreviewAsync"
                                                           OpenAttachmentLocally="OpenAttachmentLocallyAsync"
                                                           OpenAttachmentInPreferredApplication="OpenAttachmentInPreferredApplicationAsync"
                                                           EditPreviewNode="EditAttachmentPreviewNodeAsync"
                                                           CanShowLocalOpen="CanShowLocalOpen"
                                                           CanOpenInPreferredApplication="CanOpenInPreferredApplication"
                                                           CanEditPreviewNode="CanEditNode" />
                        </ProjectStructureDeferredSurface>
    </DeferredDialogs>
</StructureWorkspace>

@if (surface is not null && canvasSurface is not null && structureViewIndex == CanvasViewIndex && partySession is { } parties) {
    <div class="project-structure-integrations">
        <CanDoItAll.Workbench.Operators.UI.Parties.PartyEditor @key="parties.State.OpeningId" State="@parties.State"
            Create="@(input => TrackAuthoringOperationAsync(parties.CreateAsync(input)))"
            Save="@(selection => TrackAuthoringOperationAsync(parties.SaveAsync(selection)))" Retry="@parties.RetryAsync" />
    </div>
}

@if (imageOpening is { } imageSetup) {
    <CanDoItAll.Workbench.Content.UI.Generation.ContentImageDialog State="@imageSetup.State" CanvasScoped="false"
        InitialDraft="@(new(imageSetup.Request.Title, imageSetup.Request.Subtitle, imageSetup.Request.Notes, null, string.Empty))"
        Submit="@(draft => TrackAuthoringOperationAsync(GenerateImageAsync(imageSetup, draft)))" Close="@(() => CloseImageSetup(imageSetup))" />
}

<ProjectStructureDeferredSurface RenderKey="@SupportDialogRenderKey">
    @{
        var summaryReceiver = summaryOpening;
        var summarySnapshot = summaryDialog;
        var transcriptReceiver = transcriptOpening;
        var transcriptSnapshot = pendingTranscriptAction;
        var mermaidReceiver = mermaidOpening;
    }
    <ProjectStructureSupportDialogs SummaryDialog="@summaryDialog"
                                    CloseSummary="@(() => ChangeAuthoringDialog(summaryReceiver, summaryOpening, CloseSummary))"
                                    ExportSummaryWorkbook="@(() => TrackAuthoringOperationAsync(RunSummaryActionAsync(summaryReceiver, summarySnapshot, ProjectStructureAuthoringOperation.ExportWorkbook)))"
                                    ExportSummaryGantt="@(() => TrackAuthoringOperationAsync(RunSummaryActionAsync(summaryReceiver, summarySnapshot, ProjectStructureAuthoringOperation.ExportGantt)))"
                                    ChangeSummaryStatus="@(value => TrackAuthoringOperationAsync(RunSummaryActionAsync(summaryReceiver, summarySnapshot, ProjectStructureAuthoringOperation.SummaryStatus, value.NodeId, value.Status)))"
                                    SummaryStatuses="@SummaryStatusOptions"
                                    PendingDeletePrompt="@pendingDeletePrompt"
                                    DeleteFailure="@deleteFailure"
                                    ConfirmDelete="ConfirmDeleteAsync"
                                    CancelDelete="CancelDelete"
                                    PendingTranscriptAction="@pendingTranscriptAction"
                                    ExecuteTranscriptAction="@(() => TrackAuthoringOperationAsync(ExecuteTranscriptActionAsync(transcriptReceiver, transcriptSnapshot)))"
                                    CancelTranscriptAction="@(() => ChangeAuthoringDialog(transcriptReceiver, transcriptOpening, CancelTranscriptAction))"
                                    HandleTranscriptProviderChanged="@(value => ChangeAuthoringDialog(transcriptReceiver, transcriptOpening, () => HandleTranscriptProviderChanged(value)))"
                                    MermaidPreviewNode="@MermaidViewerNode"
                                    MermaidOpeningId="@(mermaidOpening?.Id ?? Guid.Empty)"
                                    CloseMermaidViewer="@(() => ChangeAuthoringDialog(mermaidReceiver, mermaidOpening, CloseMermaidViewer))"
                                    EditMermaidNode="@(_ => TrackAuthoringOperationAsync(EditMermaidPreviewNodeAsync(mermaidReceiver)))"
                                    CanEditMermaidNode="CanEditNode"
                                    ResolveTranscriptActionLabel="ResolveTranscriptActionLabel" />
</ProjectStructureDeferredSurface>

<ProjectStructureDeferredSurface RenderKey="@CanvasOverlayRenderKey">
    <ProjectStructureCanvasDialogs RenderProcessStartDialog="true"
                                   ProcessStartDialog="@processStartDialog"
                                   CloseProcessStart="CloseProcessStartDialog"
                                   ExecuteProcessStart="ExecuteProcessStartAsync"
                                   ReviewAndStartProcess="ReviewAndStartProcessAsync"
                                   PrepareAnotherProcessLaunch="PrepareAnotherProcessLaunchAsync"
                                   SelectProcessStartCandidate="SelectProcessStartCandidateAsync"
                                   AssignProcessStartAgent="OpenManualProcessStartAgentPickerAsync"
                                   ProcessStartAssignmentsReviewedChanged="HandleProcessStartAssignmentsReviewedChanged"
                                   RequestHrManagerMatch="RequestHrManagerMatchAsync"
                                   CancelHrManagerMatch="CancelHrManagerMatchAsync"
                                   ExecuteHrManagerMatch="ExecuteHrManagerMatchAsync"
                                   EditPreviewNode="EditAttachmentPreviewNodeAsync"
                                   CanShowLocalOpen="CanShowLocalOpen"
                                   CanOpenInPreferredApplication="CanOpenInPreferredApplication"
                                   CanEditPreviewNode="CanEditNode" />
</ProjectStructureDeferredSurface>

@if (isSecretReferenceDialogOpen)
{
    <ProjectStructureOverlayDialog AriaLabel="Select stored secret for project structure"
                                   Kicker="Secret reference"
                                   Title="@SecretReferenceDialogTitle"
                                   Summary="@SecretReferenceDialogSummary"
                                   DialogClass="project-structure-summary-dialog"
                                   Close="CloseSecretReferenceDialog">
        <Actions>
            <Button Text="Close"
                    Icon="close"
                    Variant="Variant.Text"
                    ButtonStyle="ButtonStyle.Base"
                    Click="CloseSecretReferenceDialog" />
        </Actions>
        <Body>
            <Stack GapScale="LayoutGap.Large"
                   AlignItems="AlignItems.Stretch"
                   data-testid="project-structure-secret-dialog">
                @if (!string.IsNullOrWhiteSpace(secretReferenceDialogError))
                {
                    <Alert AlertStyle="AlertStyle.Warning">
                        <p>@secretReferenceDialogError</p>
                    </Alert>
                }

                <Grid Gap="LayoutGap.Medium" ColumnsMd="2">
                    <FormField Text="Stored secret">
                        <select class="cda-input"
                                value="@selectedSecretReferenceId"
                                @onchange="HandleSelectedSecretReferenceChanged"
                                disabled="@isSecretReferenceDialogBusy"
                                data-testid="project-structure-secret-select">
                            <option value="">Select stored secret</option>
                            @foreach (var secret in SecretReferenceSelectItems)
                            {
                                <option value="@secret.Id.ToString("D")">@secret.Name (@secret.Kind)</option>
                            }
                        </select>
                    </FormField>
                    <FormField Text="Search stored secrets">
                        <input class="cda-input"
                               value="@secretReferenceSearch"
                               @oninput="HandleSecretReferenceSearchChanged"
                               data-testid="project-structure-secret-search" />
                    </FormField>
                </Grid>

                @if (!string.IsNullOrWhiteSpace(SecretReferenceSelectMessage))
                {
                    <Alert AlertStyle="AlertStyle.Info">
                        <p>@SecretReferenceSelectMessage</p>
                    </Alert>
                }

                <Grid Gap="LayoutGap.Medium" ColumnsMd="2">
                    <FormField Text="Purpose">
                        <input class="cda-input"
                               value="@secretReferencePurpose"
                               @oninput="HandleSecretReferencePurposeChanged"
                               data-testid="project-structure-secret-purpose" />
                    </FormField>
                    <FormField Text="Reference note">
                        <input class="cda-input"
                               value="@secretReferenceExternalReference"
                               @oninput="HandleSecretReferenceExternalReferenceChanged"
                               data-testid="project-structure-secret-external-reference" />
                    </FormField>
                </Grid>

                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                    <Button Text="@SecretReferenceUseSelectedButtonText"
                            Icon="shield"
                            ButtonStyle="ButtonStyle.Info"
                            Disabled="@(isSecretReferenceDialogBusy || !SelectedSecretReferenceGuid.HasValue)"
                            IsBusy="@isSecretReferenceDialogBusy"
                            Click="UseSelectedProjectStructureSecretAsync"
                            data-testid="project-structure-secret-use-selected" />
                    <CopyButton Value="@SelectedSecretReferenceName"
                                Text="Copy selected name"
                                Size="CopyButtonSize.Small"
                                Disabled="@string.IsNullOrWhiteSpace(SelectedSecretReferenceName)" />
                    @if (isSecretReferenceEditMode)
                    {
                        <Button Text="Cancel"
                                Icon="close"
                                Variant="Variant.Text"
                                ButtonStyle="ButtonStyle.Base"
                                Disabled="@isSecretReferenceDialogBusy"
                                Click="CloseSecretReferenceDialog" />
                    }
                </Cluster>

                <FormSection Title="Create new secret"
                             Icon="shield"
                             Description="@SecretReferenceCreateSectionDescription">
                    <Grid Gap="LayoutGap.Medium" ColumnsMd="2">
                        <div>
                            <label class="cda-field-label">Name</label>
                            <InputText @bind-Value="secretReferenceCreateModel.Name" class="cda-input" data-testid="project-structure-secret-create-name" />
                        </div>
                        <div>
                            <label class="cda-field-label">Kind</label>
                            <InputSelect @bind-Value="secretReferenceCreateModel.Kind" class="cda-input">
                                @foreach (var kind in Enum.GetValues<SecretKind>())
                                {
                                    <option value="@kind">@kind</option>
                                }
                            </InputSelect>
                        </div>
                    </Grid>
                    <div class="mt-3">
                        <label class="cda-field-label">Value</label>
                        <SecretField @bind-Value="secretReferenceCreateModel.SecretValue"
                                     SecretName="@secretReferenceCreateModel.Name"
                                     ShowNameCopy="true"
                                     ShowValueCopy="true"
                                     RevealDurationSeconds="30"
                                     data-testid="project-structure-secret-create-value" />
                    </div>
                    <div class="mt-3">
                        <label class="cda-field-label">Purpose</label>
                        <InputText @bind-Value="secretReferenceCreateModel.RotationNote" class="cda-input" />
                    </div>
                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap" Class="mt-4">
                        <Button Text="Create and use"
                                Icon="save"
                                ButtonStyle="ButtonStyle.Info"
                                Disabled="@isSecretReferenceDialogBusy"
                                IsBusy="@isSecretReferenceDialogBusy"
                                Click="CreateAndUseProjectStructureSecretAsync"
                                data-testid="project-structure-secret-create-use" />
                    </Cluster>
                </FormSection>
            </Stack>
        </Body>
    </ProjectStructureOverlayDialog>
}

@{
    var creatingOpening = projectCreateOpening;
    var creatingDraft = projectCreateDraft;
}
<ProjectModalHost @key="projectCreateDraft" IsOpen="@showProjectCreateModal"
                  IsEditorMode="true"
                  Draft="@projectCreateDraft"
                  StarterObjectKinds="@ProjectCreateStarterObjectKinds"
                  ProjectSummaries="@projectCreateProjectSummaries"
                  WizardStep="@projectCreateWizardStep"
                  WizardSteps="@ProjectCreateWizardSteps"
                  WizardTabs="@ProjectCreateWizardTabs"
                  Message="@projectCreateMessage"
                  IsErrorMessage="@IsProjectCreateErrorMessage"
                  Close="@(() => CloseProjectCreateDialogAsync(creatingOpening))"
                  SwitchToOverview="IgnoreProjectCreateModeChangeAsync"
                  SwitchToEditor="IgnoreProjectCreateModeChangeAsync"
                  WizardTabChanged="HandleProjectCreateWizardTabChangedAsync"
                  AddPhase="AddProjectCreatePhaseAsync"
                  RemovePhase="RemoveProjectCreatePhaseAsync"
                  AddStarterObject="AddProjectCreateStarterObject"
                  RemoveStarterObject="RemoveProjectCreateStarterObject"
                  PreviousStep="PreviousProjectCreateStep"
                  NextStep="NextProjectCreateStep"
                  Save="@((ProjectEditorSubmission submitted) => DispatchAuthoringDialogAsync(creatingOpening, projectCreateOpening, () => SaveProjectCreateAsync(creatingOpening, creatingDraft, submitted)))"
                  SaveAndOpenStructure="@((ProjectEditorSubmission submitted) => DispatchAuthoringDialogAsync(creatingOpening, projectCreateOpening, () => SaveProjectCreateAsync(creatingOpening, creatingDraft, submitted, true)))"
                  Delete="DeleteProjectCreateAsync"
                  OpenProjectDashboard="OpenProjectCreateDashboardAsync"
                  OpenStructure="OpenStructure"
                  OpenCalendar="OpenCalendar" />

@code {
    private static class CanvasAuthoringMode
    {
        public const string Select = "authoring";
        public const string Dependency = "dependency";
        public const string Delete = "delete";
    }

    private const string SelectionWindowKey = "project-structure.selection";
    private const string HealthWindowKey = "project-structure.health";
    private const double ToolboxWindowDefaultWidth = 430;
    private const double SignalsWindowDefaultWidth = 388;
    private const double ObjectIndexWindowDefaultWidth = 392;
    private const double DefaultCanvasWindowMargin = 16;
    private const double DefaultCanvasWindowGap = 16;
    private const double SignalsWindowDefaultLeft = ToolboxWindowDefaultWidth + DefaultCanvasWindowMargin + DefaultCanvasWindowGap;
    private const double HealthWindowDefaultLeft = SignalsWindowDefaultLeft + SignalsWindowDefaultWidth + DefaultCanvasWindowGap;
    private const int CanvasViewIndex = 0;
    private const int GanttViewIndex = 1;
    private const int ManagerSummaryViewIndex = 2;
    private const string GanttTabQueryValue = "gantt";
    private const string ManagerSummaryTabQueryValue = "manager-summary";

    [Parameter]
    public Guid ProjectId { get; set; }

    [SupplyParameterFromQuery(Name = "tab")]
    public string? RequestedTab { get; set; }

    private ProjectStructureSurface? surface;
    private CanvasWorkbenchSurface? canvasSurface;
    private StructureWorkspace? workbenchRef;
    private int structureViewIndex;
    private AgentContext.ProjectStructureGanttObservation? ganttObservation;

    private void HandleGanttObservationChanged(
        AgentContext.ProjectStructureGanttObservation? observation)
    {
        ganttObservation = observation;
    }
    private StructureViewNavigationIdentity? appliedStructureViewNavigationIdentity;

    private bool IsGanttViewVisible => structureViewIndex == GanttViewIndex;

    private ProjectStructureAgentChatView ActiveAgentChatView
        => structureViewIndex switch
        {
            GanttViewIndex => ProjectStructureAgentChatView.Gantt,
            ManagerSummaryViewIndex => ProjectStructureAgentChatView.ManagerSummary,
            _ => ProjectStructureAgentChatView.Canvas
        };

    private Task OpenGanttViewAsync()
    {
        structureViewIndex = GanttViewIndex;
        return Task.CompletedTask;
    }

    private readonly ProjectStructureActionCatalogAdapter actionCatalog = new();
    private readonly ProjectStructureGraphAdapter graphAdapter = new();
    private readonly ProjectStructurePlacementPolicy placementPolicy = new();
    private List<string> insightSelectedNodeIds = [];
    private List<string> selectedNodeIds {
        get => insightSelectedNodeIds;
        set {
            if (!insightSelectedNodeIds.SequenceEqual(value, StringComparer.Ordinal)) {
                insightsSelectionRevision++;
            }
            insightSelectedNodeIds = value;
        }
    }
    private string canvasToolMode = CanvasAuthoringMode.Select;
    private string? linkModeSourceId;
    private string? currentViewStateJson;
    private const int CanvasViewStatePersistDelayMs = 420;
    private CancellationTokenSource? pendingCanvasViewStatePersistCts;
    private string? pendingClientSelectionId;
    private HashSet<string> pendingClientSelectionPriorIds = new(StringComparer.Ordinal);
    private ProjectStructureNode? previewNode;
    private ProjectStructureKnownFileInteractionSlot? previewInteractionSlot;
    private bool isOpeningAttachmentPreview;
    private string? localOpenFeedback;
    private string? localOpenFeedbackNodeId;
    private string localOpenFeedbackTone = "neutral";
    private Guid loadedProjectId;
    private AgentChatContextAccessState agentChatContextAccessState = AgentChatContextAccessState.Loading;
    private long surfaceReloadGeneration;
    private string? pendingWorkbenchSelectionId;
    private ProjectWorkbenchUnavailableState? unavailableState;
    private readonly SemaphoreSlim nodeMoveCommitGate = new(1, 1);
    private readonly CancellationTokenSource deferredCompletionCts = new();
    private bool isSecretReferenceDialogOpen;
    private bool isSecretReferenceDialogBusy;
    private bool isSecretReferenceEditMode;
    private CanvasWorkbenchAction? secretReferenceAction;
    private CanvasWorkbenchCreateActionRequest? secretReferenceRequest;
    private string? secretReferenceEditNodeId;
    private IReadOnlyList<SecretListItem> secretReferenceItems = [];
    private string secretReferenceSearch = string.Empty;
    private string secretReferenceDialogError = string.Empty;
    private string selectedSecretReferenceId = string.Empty;
    private string secretReferencePurpose = "Project structure reference";
    private string secretReferenceExternalReference = string.Empty;
    private SecretEditorModel secretReferenceCreateModel = NewProjectStructureSecretModel();

    private SkeletonStateOverlaySnapshot LoadingSkeletonSnapshot
        => SkeletonStateOverlayFactory.CreateLoadingSnapshot(
            "Loading project structure",
            "Shared loading chrome keeps the stage, toolbar, and inspector rhythm stable while the canvas model is still being projected.");

    private ProjectStructureValidationOverlaySummary canvasValidationOverlay
        => surface is null
            ? new ProjectStructureValidationOverlaySummary(false, 0, 0, 0, 0, [])
            : ProjectStructureValidationOverlay.BuildSummary(surface, selectedNodeIds);

    private IReadOnlyList<ProjectStructureNode> outlineNodes =>
        surface?.Nodes
            .OrderBy(node => ProjectStructureNodeHelpers.ResolveOutlineWeight(node.ObjectType))
            .ThenBy(node => node.Title, StringComparer.OrdinalIgnoreCase)
            .ToList() ?? [];

    private IReadOnlyList<ProjectStructureNode> selectedNodes =>
        surface?.Nodes.Where(node => selectedNodeIds.Contains(node.Id, StringComparer.Ordinal)).ToList() ?? [];

    private ProjectStructureNode? selectedNode => selectedNodes.FirstOrDefault();
    private IReadOnlyList<SecretListItem> SecretReferenceSelectItems
    {
        get
        {
            var items = secretReferenceItems
                .Where(MatchesSecretReferenceSearch)
                .ToList();
            if (SelectedSecretReferenceItem is { } selectedSecret &&
                items.All(secret => secret.Id != selectedSecret.Id))
            {
                items.Add(selectedSecret);
            }

            return items
                .DistinctBy(secret => secret.Id)
                .OrderBy(secret => secret.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    private Guid? SelectedSecretReferenceGuid
        => Guid.TryParse(selectedSecretReferenceId, out var secretId) && secretId != Guid.Empty
            ? secretId
            : null;

    private SecretListItem? SelectedSecretReferenceItem
        => SelectedSecretReferenceGuid is { } selectedSecretId
            ? secretReferenceItems.FirstOrDefault(secret => secret.Id == selectedSecretId)
            : null;

    private string? SelectedSecretReferenceName => SelectedSecretReferenceItem?.Name;

    private string SecretReferenceSelectMessage
        => secretReferenceItems.Count == 0
            ? "No stored secrets are available in the active database. Create a new secret below."
            : SecretReferenceSelectItems.Count == 0
                ? "No stored secrets match the current search. Clear the search or create a new secret below."
                : string.Empty;

    private bool MatchesSecretReferenceSearch(SecretListItem secret)
    {
        if (string.IsNullOrWhiteSpace(secretReferenceSearch))
        {
            return true;
        }

        var search = secretReferenceSearch.Trim();
        return secret.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
               secret.Scope.Contains(search, StringComparison.OrdinalIgnoreCase) ||
               secret.Kind.ToString().Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private string SecretReferenceDialogTitle
        => isSecretReferenceEditMode ? "Edit secret reference" : "Add secret reference";

    private string SecretReferenceDialogSummary
        => isSecretReferenceEditMode
            ? "Change which stored secret this node references. The node still stores only reference metadata."
            : "Select an existing secret or create one. The node stores only reference metadata.";

    private string SecretReferenceUseSelectedButtonText
        => isSecretReferenceEditMode ? "Save selected secret" : "Use selected secret";

    private string SecretReferenceCreateSectionDescription
        => isSecretReferenceEditMode
            ? "Create the vault record and update this reference node in one step."
            : "Create the vault record and add a reference node in one step.";

    private CanvasWorkbenchWindowState SelectionWindowState => ResolveWindowState(SelectionWindowKey);
    private CanvasWorkbenchWindowState HealthWindowState => ResolveHealthWindowState();
    private string SelectionWindowTitle
        => selectedNodes.Count switch
        {
            0 => "Selection",
            1 => selectedNode?.Title ?? "Selection",
            _ => $"{selectedNodes.Count} selected"
        };
    private string SelectionWindowSummary
        => selectedNodes.Count switch
        {
            0 => "Keep the next action, attachment preview, and selection guidance inside the canvas.",
            1 => "Inspect the current node, jump into attachments, and create adjacent work without leaving the canvas.",
            _ => "Batch-update shared fields, review the selection set, and keep grouping actions close to the canvas."
        };
    private bool CanApplySelectionStatus => selectedNodes.Count > 0 && selectedNodes.All(ProjectStructureNodeHelpers.IsCanvasStatusMutable);
    private AgentChatNavigationIdentity AgentChatNavigationFence
        => AgentChatNavigationIdentity.CreateForLocation(
            Navigation.BaseUri,
            Navigation.Uri);

    protected override async Task OnParametersSetAsync()
    {
        ApplyRequestedStructureView();
        RetireInactiveAuthoring();

        var processNavigation = AgentChatNavigationFence;
        if (loadedProjectId != ProjectId || processDialogNavigationIdentity != processNavigation) {
            processDialogNavigationIdentity = processNavigation;
            CancelRuntimePreviewWait();
            CloseProcessStartDialog();
            CloseProcessLinkDialog();
            actionNavigationRevision++;
            partySession?.Retire();
            partySession = null;
            CloseSummary();
            CancelTranscriptAction();
            CloseSecretReferenceDialog();
            CloseProjectHierarchyDialog();
            CloseBlockMutationDialog();
            CloseSubprojectTransferDialog();
            projectHierarchyDialogBeforeCreate = null;
            projectCreateOpening = null;
            showProjectCreateModal = false;
            await CloseAttachmentPreviewAsync();
        }

        if (loadedProjectId != ProjectId)
        {
            loadedProjectId = ProjectId;
            clipboardState = null;
            currentViewStateJson = null;
            selectedNodeIds = [];
            canvasToolMode = CanvasAuthoringMode.Select;
            linkModeSourceId = null;
            pendingClientSelectionId = null;
            fileBrowserRequest = null;
            webPreviewDialog = null;
            await CloseAttachmentPreviewAsync();
        }

        await ReloadSurfaceAsync();
    }

    private void ApplyRequestedStructureView()
    {
        var navigationIdentity = new StructureViewNavigationIdentity(
            ProjectId,
            ResolveRequestedStructureView(RequestedTab));
        if (appliedStructureViewNavigationIdentity == navigationIdentity)
        {
            return;
        }

        appliedStructureViewNavigationIdentity = navigationIdentity;
        structureViewIndex = navigationIdentity.View switch
        {
            StructureView.Gantt => GanttViewIndex,
            StructureView.ManagerSummary => ManagerSummaryViewIndex,
            _ => CanvasViewIndex
        };
    }

    private static StructureView ResolveRequestedStructureView(string? tab)
        => tab?.Trim() switch
        {
            var value when string.Equals(value, GanttTabQueryValue, StringComparison.OrdinalIgnoreCase) =>
                StructureView.Gantt,
            var value when string.Equals(value, ManagerSummaryTabQueryValue, StringComparison.OrdinalIgnoreCase) =>
                StructureView.ManagerSummary,
            _ => StructureView.Canvas
        };

    private enum StructureView
    {
        Canvas,
        Gantt,
        ManagerSummary
    }

    private readonly record struct StructureViewNavigationIdentity(Guid ProjectId, StructureView View);

    private async Task ReloadSurfaceAsync(string? preferredSelectionId = null, Func<bool>? canPublish = null)
    {
        IReadOnlyList<string>? liveSelectionSnapshot = surface?.ProjectId == ProjectId
            ? selectedNodeIds.ToArray()
            : null;
        var request = new SurfaceReloadRequest(
            ProjectId,
            Interlocked.Increment(ref surfaceReloadGeneration), canPublish);
        if (canPublish is null) {
            agentChatContextAccessState = AgentChatContextAccessState.Loading;
            structureLoadError = null;
        }
        try
        {
            CancelPendingCanvasViewStatePersistence();
            pendingWorkbenchSelectionId = null;
            var loadStructureTask = ProjectWorkbenchService.TryGetStructureAsync(request.ProjectId);
            var loadStorageCatalogTask = WorkspaceService.ListStorageCatalogAsync();
            var loadDeletionRecoveriesTask =
                ProjectWorkbenchService.ListPendingDeletionRecoveriesAsync(request.ProjectId);
            var loadDeletionNoticesTask =
                ProjectWorkbenchService.ListDeletionCompletionNoticesAsync(request.ProjectId);
            await Task.WhenAll(
                loadStructureTask,
                loadStorageCatalogTask,
                loadDeletionRecoveriesTask,
                loadDeletionNoticesTask);
            if (!IsCurrentSurfaceReload(request))
            {
                return;
            }

            var nextStorageCatalog = await loadStorageCatalogTask;
            var nextDeletionRecoveries = await loadDeletionRecoveriesTask;
            var nextDeletionNotices = await loadDeletionNoticesTask;
            pendingDeletionRecoveries.Clear();
            pendingDeletionRecoveries.AddRange(nextDeletionRecoveries);
            deletionCompletionNotices.Clear();
            deletionCompletionNotices.AddRange(
                nextDeletionNotices.Where(notice => notice.Warnings.Count > 0));
            if (pendingDeletionRecoveries.Count > 0 &&
                string.IsNullOrWhiteSpace(workflowFeedback))
            {
                workflowFeedback =
                    $"{pendingDeletionRecoveries.Count} deleted branch cleanup operation(s) remain pending. Retry cleanup by exact durable mutation id.";
                if (deletionCompletionNotices.Count > 0)
                {
                    workflowFeedback =
                        $"{workflowFeedback} {BuildDeletionCompletionNoticeFeedback(deletionCompletionNotices)}";
                }
                workflowFeedbackTone = "warn";
            }
            else if (deletionCompletionNotices.Count > 0 &&
                     string.IsNullOrWhiteSpace(workflowFeedback))
            {
                workflowFeedback = BuildDeletionCompletionNoticeFeedback(
                    deletionCompletionNotices);
                workflowFeedbackTone = "warn";
            }
            var loadResult = await loadStructureTask;
            if (!IsCurrentSurfaceReload(request))
            {
                return;
            }

            if (!loadResult.IsSuccess || loadResult.Surface is null)
            {
                await CloseAttachmentPreviewAsync();
                if (!IsCurrentSurfaceReload(request))
                {
                    return;
                }

                storageCatalog = nextStorageCatalog;
                unavailableState = loadResult.UnavailableState;
                surface = null;
                RetireInactiveAuthoring();
                canvasSurface = null;
                clipboardState = null;
                quickActionDialog = null;
                webPreviewDialog = null;
                currentViewStateJson = null;
                selectedNodeIds = [];
                pendingClientSelectionId = null;
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
                return;
            }

            var reloadedSurface = loadResult.Surface;
            var uiState = NormalizePersistedCanvasUiState(
                !string.IsNullOrWhiteSpace(currentViewStateJson)
                    ? CanvasWorkbenchUiState.Parse(currentViewStateJson)
                    : CanvasWorkbenchUiState.Parse(reloadedSurface.ViewStateJson));
            if (string.IsNullOrWhiteSpace(currentViewStateJson))
            {
                uiState.ShowMinimap = false;
            }

            ProjectStructureNode? reloadedPreview = null;
            if (previewNode is not null)
            {
                reloadedPreview = reloadedSurface.Nodes.FirstOrDefault(
                    node => string.Equals(node.Id, previewNode.Id, StringComparison.Ordinal));
                if (reloadedPreview is null)
                {
                    await CloseAttachmentPreviewAsync();
                    if (!IsCurrentSurfaceReload(request))
                    {
                        return;
                    }
                }
            }

            var nextQuickActionDialog = quickActionDialog is null
                ? null
                : reloadedSurface.Nodes.FirstOrDefault(node =>
                    string.Equals(node.Id, quickActionDialog.NodeId, StringComparison.Ordinal)) is { } dialogNode
                    ? BuildQuickActionDialog(dialogNode)
                    : null;
            var nextWebPreviewDialog = RebuildWebPreviewDialog(reloadedSurface.Nodes);
            var nextSelectedNodeIds = (liveSelectionSnapshot ?? uiState.SelectedNodeIds)
                .Where(id => reloadedSurface.Nodes.Any(node => string.Equals(node.Id, id, StringComparison.Ordinal)))
                .ToList();
            string? nextPendingClientSelectionId;
            string? nextPendingWorkbenchSelectionId = null;

            if (!string.IsNullOrWhiteSpace(preferredSelectionId) &&
                reloadedSurface.Nodes.Any(node => string.Equals(node.Id, preferredSelectionId, StringComparison.Ordinal)))
            {
                nextSelectedNodeIds = [preferredSelectionId];
                nextPendingClientSelectionId = preferredSelectionId;
                nextPendingWorkbenchSelectionId = preferredSelectionId;
            }
            else if (nextSelectedNodeIds.Count == 0)
            {
                var rootNodeId = ProjectStructureNodeHelpers.ResolveRootNodeId(reloadedSurface.Nodes);
                if (!string.IsNullOrWhiteSpace(rootNodeId))
                {
                    nextSelectedNodeIds = [rootNodeId];
                }

                nextPendingClientSelectionId = null;
            }
            else
            {
                nextPendingClientSelectionId = null;
            }

            uiState.SelectedNodeIds = [.. nextSelectedNodeIds];
            graphAdapter.ExpandSelectionAncestors(reloadedSurface.Nodes, uiState, nextSelectedNodeIds);
            var nextSurface = reloadedSurface with { ViewStateJson = uiState.ToJson() };
            if (!IsCurrentSurfaceReload(request))
            {
                return;
            }

            storageCatalog = nextStorageCatalog;
            unavailableState = null;
            previewNode = reloadedPreview;
            quickActionDialog = nextQuickActionDialog;
            webPreviewDialog = nextWebPreviewDialog;
            if (nextPendingClientSelectionId is not null)
            {
                ArmPendingClientSelection(nextPendingClientSelectionId, selectedNodeIds.Concat(liveSelectionSnapshot ?? []));
            }
            else
            {
                pendingClientSelectionId = null;
            }

            selectedNodeIds = nextSelectedNodeIds;
            pendingWorkbenchSelectionId = nextPendingWorkbenchSelectionId;
            surface = nextSurface;
            RetireInactiveAuthoring();
            currentViewStateJson = nextSurface.ViewStateJson;
            RefreshCanvasSurface();
            InvalidateClipboardStateForCurrentSurface();
            await LoadPartyEditorAsync();
            if (IsCurrentSurfaceReload(request))
            {
                agentChatContextAccessState = AgentChatContextAccessState.Ready;
            }
        }
        catch (Exception exception)
        {
            if (!IsCurrentSurfaceReload(request))
            {
                return;
            }

            agentChatContextAccessState = AgentChatContextAccessState.Failed;
            if (canPublish is not null) {
                throw;
            }
            structureLoadError = "The project structure could not be loaded. Retry after the connection or project access is restored.";
            Logger.LogWarning("Structure read failed for project {ProjectId}. FailureType={FailureType}.",
                request.ProjectId, exception.GetType().Name);
        }
    }

    private bool IsCurrentSurfaceReload(SurfaceReloadRequest request)
        => request.ProjectId == ProjectId &&
           request.Generation == Volatile.Read(ref surfaceReloadGeneration) &&
           (request.CanPublish?.Invoke() ?? true);

    private readonly record struct SurfaceReloadRequest(
        Guid ProjectId,
        long Generation,
        Func<bool>? CanPublish = null);

    private Task OpenUnavailableRouteAsync()
    {
        Navigation.NavigateTo(unavailableState?.SafeRoute ?? "/projects");
        return Task.CompletedTask;
    }

    private async Task ApplySurfaceNodeUpdatesAsync(IReadOnlyCollection<ProjectStructureNode> updatedNodes)
    {
        if (surface is null || updatedNodes.Count == 0)
        {
            return;
        }

        var updatedById = updatedNodes
            .Where(node => !string.IsNullOrWhiteSpace(node.Id))
            .GroupBy(node => node.Id, StringComparer.Ordinal)
            .ToDictionary(group => group.Key, group => group.Last(), StringComparer.Ordinal);
        if (updatedById.Count == 0)
        {
            return;
        }

        var patchedNodes = surface.Nodes
            .Select(node => updatedById.TryGetValue(node.Id, out var updated) ? updated : node)
            .ToList();
        surface = surface with { Nodes = patchedNodes };

        var availableNodeIds = patchedNodes
            .Select(node => node.Id)
            .ToHashSet(StringComparer.Ordinal);
        selectedNodeIds = selectedNodeIds
            .Where(availableNodeIds.Contains)
            .ToList();
        pendingClientSelectionId = null;

        if (previewNode is not null)
        {
            previewNode = patchedNodes.FirstOrDefault(node => string.Equals(node.Id, previewNode.Id, StringComparison.Ordinal));
        }

        if (mermaidPreviewNode is not null)
        {
            mermaidPreviewNode = patchedNodes.FirstOrDefault(node => string.Equals(node.Id, mermaidPreviewNode.Id, StringComparison.Ordinal));
        }

        if (quickActionDialog is not null)
        {
            var dialogNode = patchedNodes.FirstOrDefault(node => string.Equals(node.Id, quickActionDialog.NodeId, StringComparison.Ordinal));
            quickActionDialog = dialogNode is null ? null : BuildQuickActionDialog(dialogNode);
        }

        webPreviewDialog = RebuildWebPreviewDialog(patchedNodes);

        if (summaryDialog is not null)
        {
            var rootNode = patchedNodes.FirstOrDefault(node => string.Equals(node.Id, summaryDialog.RootNodeId, StringComparison.Ordinal));
            summaryDialog = rootNode is null
                ? null
                : summaryDialog with
                {
                    RootTitle = rootNode.Title,
                    Summary = ProjectStructureSummaryBuilder.Build(surface, rootNode)
                };
        }

        RefreshCanvasSurface();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ApplyCreatedSurfaceNodeAsync(
        ProjectStructureNode created,
        string? parentNodeId,
        IReadOnlyList<ProjectStructurePendingLink> pendingLinks,
        IReadOnlyList<ProjectNodeMoveRequest> followUpMoves)
    {
        if (surface is null)
        {
            await ReloadSurfaceAsync(created.Id);
            return;
        }

        var moveByNodeId = followUpMoves
            .Where(move => !string.IsNullOrWhiteSpace(move.NodeId))
            .GroupBy(move => move.NodeId, StringComparer.Ordinal)
            .ToDictionary(group => group.Key, group => group.Last(), StringComparer.Ordinal);
        var patchedNodes = surface.Nodes
            .Where(node => !string.Equals(node.Id, created.Id, StringComparison.Ordinal))
            .Select(node => moveByNodeId.TryGetValue(node.Id, out var move)
                ? node with { X = move.X, Y = move.Y }
                : node)
            .Append(created)
            .ToList();
        var patchedLinks = surface.Links.ToList();
        var normalizedParentNodeId = ProjectWorkbenchGraphConventions.NormalizeEditableParentNodeKey(ProjectId, parentNodeId);
        AddSurfaceLink(
            patchedLinks,
            normalizedParentNodeId,
            created.Id,
            ProjectWorkbenchGraphConventions.ResolveHierarchyLinkKind(ProjectId, normalizedParentNodeId),
            isUserAuthored: false);

        foreach (var pendingLink in pendingLinks)
        {
            AddSurfaceLink(
                patchedLinks,
                created.Id,
                pendingLink.TargetNodeId,
                pendingLink.LinkKind,
                isUserAuthored: true);
        }

        ArmPendingClientSelection(created.Id, selectedNodeIds);
        selectedNodeIds = [created.Id];
        pendingWorkbenchSelectionId = created.Id;

        var uiState = NormalizePersistedCanvasUiState(CanvasWorkbenchUiState.Parse(currentViewStateJson ?? surface.ViewStateJson));
        uiState.SelectedNodeIds = [.. selectedNodeIds];
        graphAdapter.ExpandSelectionAncestors(patchedNodes, uiState, selectedNodeIds);
        surface = surface with
        {
            Nodes = patchedNodes,
            Links = patchedLinks,
            ViewStateJson = uiState.ToJson()
        };
        currentViewStateJson = surface.ViewStateJson;
        RefreshCanvasSurface();
        await LoadPartyEditorAsync();
        await InvokeAsync(StateHasChanged);
    }

    private static void AddSurfaceLink(
        List<ProjectStructureLink> links,
        string sourceId,
        string targetId,
        ProjectObjectLinkKind kind,
        bool isUserAuthored)
    {
        if (string.IsNullOrWhiteSpace(sourceId) || string.IsNullOrWhiteSpace(targetId))
        {
            return;
        }

        if (links.Any(link =>
            string.Equals(link.SourceId, sourceId, StringComparison.Ordinal) &&
            string.Equals(link.TargetId, targetId, StringComparison.Ordinal) &&
            link.Kind == kind &&
            link.IsUserAuthored == isUserAuthored))
        {
            return;
        }

        links.Add(new ProjectStructureLink(sourceId, targetId, kind, isUserAuthored));
    }

    private void RefreshCanvasSurface()
    {
        if (surface is null)
        {
            canvasSurface = null;
            return;
        }

        var uiState = NormalizePersistedCanvasUiState(CanvasWorkbenchUiState.Parse(surface.ViewStateJson));
        uiState.SelectedNodeIds = [.. selectedNodeIds];

        canvasSurface = graphAdapter.BuildSurface(
            surface,
            uiState,
            new CanvasWorkbenchChrome
            {
                HintText = ResolveCanvasHintText(),
                FocusActionLabel = "Focus root",
                ChildNoteActionId = "add-note",
                SiblingNoteActionId = "add-note",
                InlineNotePlaceholder = "Write note",
                CollapseOnDoubleClick = false,
                TransformHandles = new CanvasWorkbenchTransformHandleOptions
                {
                    IsEnabled = false
                },
                QuickCreateActions = BuildQuickCreateActions().ToList(),
                GroupContextActions = actionCatalog.BuildGroupContextActions().ToList()
            },
            actionCatalog,
            ResolveRuntimeCapabilitiesForCanvas,
            CanShowLocalOpen,
            CanOpenIpfsNodeInNewTab);
        HydrateCanvasNodeContextActions(canvasSurface);
        canvasSurface.Mode = canvasToolMode;
        canvasSurface.DependencySourceId = linkModeSourceId ?? string.Empty;
    }

    private void HydrateCanvasNodeContextActions(CanvasWorkbenchSurface projectedSurface)
    {
        foreach (var node in projectedSurface.Nodes)
        {
            node.ContextActions = node.ContextActions
                .Select(HydrateCreateAction)
                .ToList();
        }
    }

    private ProjectStructureRuntimeLaunchCapabilities? ResolveRuntimeCapabilitiesForCanvas(ProjectStructureNode node)
    {
        var runtimeLaunch = RuntimeLauncher.Resolve(node);
        return RuntimeLauncher.IsAvailable && runtimeLaunch.IsSuccess
            ? runtimeLaunch.EffectiveCapabilities
            : null;
    }

    private void ArmPendingClientSelection(string nodeId, IEnumerable<string> priorSelectedNodeIds)
    {
        pendingClientSelectionId = nodeId;
        pendingClientSelectionPriorIds = new HashSet<string>(priorSelectedNodeIds, StringComparer.Ordinal);
    }

    // A client dispatch that still carries the selection from before a pending adoption (or no selection) is stale and
    // must not deselect the node the page just created or reloaded. Any other single selection is a deliberate later
    // choice; discarding it would let the canvas re-synchronize back to the pending selection and lose that choice.
    private bool IsStaleClientSelectionForPendingAdoption(IReadOnlyCollection<string> selectedNodeIds)
    {
        if (string.IsNullOrWhiteSpace(pendingClientSelectionId) ||
            surface?.Nodes.Any(node => string.Equals(node.Id, pendingClientSelectionId, StringComparison.Ordinal)) != true ||
            selectedNodeIds.Count > 1 ||
            selectedNodeIds.Contains(pendingClientSelectionId, StringComparer.Ordinal))
        {
            return false;
        }

        return selectedNodeIds.Count == 0 || pendingClientSelectionPriorIds.Contains(selectedNodeIds.First());
    }

    private async Task HandleSelectionChangedAsync(CanvasWorkbenchSelectionChangedEventArgs args)
    {
        if (IsStaleClientSelectionForPendingAdoption(args.SelectedNodeIds))
        {
            return;
        }

        pendingWorkbenchSelectionId = null;

        if (!string.IsNullOrWhiteSpace(reconnectNodeId) &&
            !string.IsNullOrWhiteSpace(args.PrimaryNodeId))
        {
            selectedNodeIds = args.SelectedNodeIds.ToList();
            pendingClientSelectionId = null;
            await HandleReconnectSelectionAsync(args.PrimaryNodeId);
            return;
        }

        selectedNodeIds = args.SelectedNodeIds.ToList();
        pendingClientSelectionId = null;
        var actionContext = CaptureActionContext();
        var selectionRevision = insightsSelectionRevision;
        await RefreshSelectedWorkflowStatusAsync(args.PrimaryNodeId ?? selectedNodeIds.FirstOrDefault());
        if (!IsCurrentAction(actionContext) || insightsSelectionRevision != selectionRevision) {
            return;
        }
        await LoadPartyEditorAsync();
        if (IsCurrentAction(actionContext) && insightsSelectionRevision == selectionRevision) {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleNodesMovedAsync(CanvasWorkbenchNodesMovedEventArgs args) {
        var context = CaptureActionContext();
        var requestedPositions = args.Positions.Select(position => new ProjectNodeMoveRequest(position.NodeId, position.X, position.Y)).ToArray();
        var targets = context.Surface.Nodes.Where(node => requestedPositions.Any(position => position.NodeId == node.Id)).ToArray();
        if (targets.Length == 0) {
            return;
        }
        var opening = new ProjectStructureAuthoringOpening(context, targets[0]);
        var outcome = new ProjectStructureAuthoringOutcome(opening.Id, Guid.NewGuid(), context.Admission,
            ProjectStructureAuthoringOperation.MoveNodes, ProjectStructureAuthoringResultKind.Rejected, "The original movement was rejected.") {
            SourceNodeId = targets[0].Id
        };
        await nodeMoveCommitGate.WaitAsync();
        try {
            if (!IsCurrentAction(context)) {
                return;
            }
            var originalPositions = targets.Select(node => new CanvasWorkbenchNodePositionChange(node.Id, node.X, node.Y)).ToArray();
            TryPatchSurfaceNodePositions(args.Positions);
            IReadOnlyList<string> updatedNodeIds;
            try {
                updatedNodeIds = await ProjectWorkbenchService.MoveObjectsAsync(context.Surface.ProjectId, requestedPositions,
                    expectedProjectAdmission: context.Admission, expectedNodes: targets);
            } catch (Exception failure) {
                if (IsCurrentAction(context)) {
                    TryPatchSurfaceNodePositions(originalPositions);
                }
                RecordAuthoringOutcome(opening, outcome with { Failure = failure,
                    Kind = IsKnownGraphRejection(failure) ? ProjectStructureAuthoringResultKind.Rejected : ProjectStructureAuthoringResultKind.Unconfirmed,
                    Message = IsKnownGraphRejection(failure) ? failure.Message : "The original movement is unconfirmed. Observe the original project before repeating it." });
                return;
            }
            var committed = args.Positions.Where(position => updatedNodeIds.Contains(position.NodeId)).ToArray();
            outcome = outcome with { Kind = ProjectStructureAuthoringResultKind.Committed, NodeIds = updatedNodeIds,
                Positions = requestedPositions.Where(position => updatedNodeIds.Contains(position.NodeId)).ToArray(),
                Message = $"Saved {updatedNodeIds.Count} original node positions." };
            RecordAuthoringOutcome(opening, outcome);
            if (!IsCurrentAction(context)) {
                return;
            }
            TryPatchSurfaceNodePositions(originalPositions.Where(position => !updatedNodeIds.Contains(position.NodeId)).ToArray());
            TryPatchSurfaceNodePositions(committed);
            try {
                await TryAdoptMovedNodesIntoBordersAsync(new(committed));
            } catch (Exception failure) {
                RecordAuthoringOutcome(opening, outcome with { Failure = failure,
                    Kind = ProjectStructureAuthoringResultKind.PartialCommit,
                    Message = "The original positions were saved, but border-state reconciliation failed. Do not repeat the movement." });
            }
        } finally {
            nodeMoveCommitGate.Release();
            await RenderAuthoringOutcomeAsync();
        }
    }

    private async Task HandleCanvasStateChangedAsync(string stateJson)
    {
        if (surface is null)
        {
            return;
        }

        var uiState = NormalizePersistedCanvasUiState(CanvasWorkbenchUiState.Parse(stateJson));
        var ownerUiState = ResolveEditableUiState();
        uiState.WindowStates = ownerUiState.WindowStates;
        uiState.GroupFrames = ownerUiState.GroupFrames;
        if (IsStaleClientSelectionForPendingAdoption(uiState.SelectedNodeIds))
        {
            return;
        }

        pendingWorkbenchSelectionId = null;
        // The client either acknowledged the pending selection or made a deliberate different choice. Release the guard
        // here as well, because a state that already equals the persisted state returns below without reaching the later
        // reset, and an armed guard would reject every later single-node selection.
        pendingClientSelectionId = null;

        var normalizedStateJson = uiState.ToJson();
        var persistedStateJson = NormalizePersistedCanvasStateJson(currentViewStateJson ?? surface.ViewStateJson);
        if (string.Equals(persistedStateJson, normalizedStateJson, StringComparison.Ordinal))
        {
            return;
        }

        pendingClientSelectionId = null;
        selectedNodeIds = uiState.SelectedNodeIds.ToList();
        currentViewStateJson = normalizedStateJson;
        surface = surface with { ViewStateJson = currentViewStateJson };
        if (canvasSurface is not null)
        {
            canvasSurface.UiState = uiState;
        }

        ScheduleCanvasViewStatePersistence();
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleNodeOpenedAsync(string nodeId)
    {
        var node = ResolveNode(nodeId);
        if (node is null)
        {
            return;
        }

        if (CanOpenRelatedProjectStructure(node))
        {
            CloseQuickActionDialog();
            await OpenProjectStructureInNewTabAsync(node);
            return;
        }

        if (ProjectStructureFileActions.CanBrowseFiles(node))
        {
            CloseQuickActionDialog();
            await TryHandleFileBrowserActionAsync(ProjectStructureFileActions.BrowseFilesId, node.Id);
            return;
        }

        if (HasMermaidViewer(node))
        {
            CloseQuickActionDialog();
            await OpenMermaidViewerAsync(node);
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (ProjectStructureNodeActionCapabilityResolver.IsRuntimeCapable(node) && !RuntimeLauncher.IsRunning(node.Id))
        {
            OpenQuickActionDialog(node);
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (ProjectStructureWebLinkResolver.TryResolve(node, out ProjectStructureWebLink? webLink) &&
            webLink is not null)
        {
            CloseQuickActionDialog();
            OpenWebPreviewDialog(node, webLink);
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (ProjectStructureNodeHelpers.CanRenderAttachmentPreview(node))
        {
            CloseQuickActionDialog();
            await OpenAttachmentPreviewAsync(node);
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (CanOfferFileQuickActions(node))
        {
            OpenQuickActionDialog(node);
            await InvokeAsync(StateHasChanged);
            return;
        }

        OpenQuickActionDialog(node);
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleContextActionAsync(CanvasWorkbenchContextActionRequest request)
    {
        switch (request.ActionId)
        {
            case "tool-mode:select":
                await SelectCanvasToolAsync();
                break;
            case "dependency:create":
                await CreateDependencyAsync(request.LinkSourceId, request.NodeId ?? request.LinkTargetId);
                break;
            case "delete-link":
                await DeleteDependencyAsync(request.LinkSourceId, request.LinkTargetId, request.LinkKind);
                break;
            default:
                await HandleCanvasActionAsync(request.ActionId, request.NodeId, request.X, request.Y);
                break;
        }
    }

    private async Task HandleCreateActionAsync(CanvasWorkbenchCreateActionRequest request)
    {
        if (request.ComposerOpeningId.HasValue) {
            await SubmitComposerAsync(request, null);
            return;
        }
        if (TryResolveEditAction(request.ActionId, out _)) {
            return;
        }
        if (IsSecretReferenceCreateRequest(request))
        {
            if (ProjectStructureCanvasCatalog.TryResolveCreateDefinition("add-secret-reference", out var secretDefinition))
            {
                var action = HydrateCreateAction(ProjectStructureCanvasCatalog.BuildComposerAction(secretDefinition));
                await OpenSecretReferenceDialogAsync(action, request with
                {
                    ActionId = secretDefinition.ActionId,
                    CreateMode = action.CreateMode
                });
            }

            return;
        }

        if (IsTaskCreateAction(request.ActionId))
        {
            await OpenTaskCreateDialogAsync(request);
            return;
        }

        if (ProjectStructureCanvasCatalog.TryResolveCreateDefinition(request.ActionId, out var definition))
        {
            if (IsSecretReferenceCreateAction(request.ActionId))
            {
                var action = HydrateCreateAction(ProjectStructureCanvasCatalog.BuildComposerAction(definition));
                await OpenSecretReferenceDialogAsync(action, request);
                return;
            }

            if (ProjectStructureCanvasCatalog.IsTextAssetAuthoringDefinition(definition))
            {
                await CreateTextAssetAsync(definition, request);
                return;
            }

            if (await TryCreateGeneratedImageAssetAsync(definition, request))
            {
                return;
            }

            try
            {
                await CreateObjectAsync(definition, request);
            }
            catch (OperationCanceledException) when (deferredCompletionCts.IsCancellationRequested)
            {
            }
            catch (Exception exception)
            {
                Logger.LogError(
                    exception,
                    "Project structure node creation failed. ProjectId={ProjectId} ActionId={ActionId} ObjectType={ObjectType} HasUpload={HasUpload} EncodedUploadLength={EncodedUploadLength}",
                    ProjectId,
                    request.ActionId,
                    definition.ObjectType,
                    request.UploadedFile is not null,
                    request.UploadedFile?.Base64Data.Length ?? 0);
                NotificationService.Error(
                    "Node could not be created",
                    exception is InvalidDataException or ProjectAssetCreationException or ProjectAssetContentValidationException
                        ? exception.Message
                        : "The node could not be saved. Check the application logs for details.");
            }
        }
    }

    private Task HandleNodeEditedAsync(CanvasWorkbenchNodeEditRequest request)
        => SubmitComposerAsync(null, request);

    private async Task HandleCanvasActionAsync(string actionId, string? nodeId, double x, double y)
    {
        var originalNode = ResolveNode(nodeId);
        var actionContext = CaptureActionContext(actionId, originalNode);
        if (await TryHandleFileBrowserActionAsync(actionId, nodeId))
        {
            return;
        }

        if (await TryHandleCopyActionAsync(actionId, nodeId))
        {
            return;
        }

        if (await TryHandleNodeMutationActionAsync(actionId, nodeId))
        {
            return;
        }

        if (ProjectStructureCanvasCatalog.TryResolveCreateDefinition(actionId, out var definition))
        {
            var request = new CanvasWorkbenchCreateActionRequest(
                actionId,
                nodeId,
                x,
                y,
                nodeId,
                string.Empty,
                string.Empty,
                string.Empty,
                nodeId is null ? "canvas" : "child",
                "command",
                definition.ObjectSubtype,
                null);
            if (IsTaskCreateAction(actionId))
            {
                await OpenTaskCreateDialogAsync(request with
                {
                    CreateMode = ProjectStructureTaskActionIds.CreateMode
                });
                return;
            }

            if (IsSecretReferenceCreateAction(actionId))
            {
                var action = HydrateCreateAction(ProjectStructureCanvasCatalog.BuildComposerAction(definition));
                await OpenSecretReferenceDialogAsync(action, request with
                {
                    CreateMode = action.CreateMode
                }, actionContext);
                return;
            }

            if (ProjectStructureCanvasCatalog.IsTextAssetAuthoringDefinition(definition))
            {
                await CreateTextAssetAsync(definition, request);
                return;
            }

            if (IsGeneratedImageAssetCreateAction(actionId))
            {
                var action = HydrateCreateAction(ProjectStructureCanvasCatalog.BuildComposerAction(definition));
                await OpenCreateDialogAsync(action);
                return;
            }

            await CreateObjectAsync(definition, request);
            return;
        }

        if (actionCatalog.TryResolveProgressAction(actionId, out var progressMode, out var progressPercent))
        {
            await ApplyProgressAsync(ResolveActionTargetNodeIds(nodeId), progressMode, progressPercent);
            return;
        }

        if (actionCatalog.TryResolveMarkerAction(actionId, out var markerIcon, out var markerTone, out var markerLabel))
        {
            await ApplyMarkerAsync(ResolveActionTargetNodeIds(nodeId), markerIcon, markerTone, markerLabel);
            return;
        }

        if (actionCatalog.TryResolvePriorityAction(actionId, out var priority))
        {
            await ApplyPriorityAsync(ResolveActionTargetNodeIds(nodeId), priority);
            return;
        }

        switch (actionId)
        {
            case ProjectStructureActionCatalogAdapter.EditActionId:
                if ((actionContext is null ? ResolveNode(nodeId) : originalNode) is { } editNode) {
                    await OpenEditDialogAsync(editNode, actionContext);
                }
                break;
            case "summary":
                await OpenSummaryAsync(nodeId, actionContext);
                break;
            case "add-process":
                if (ResolveNode(nodeId) is { } processLinkNode)
                {
                    await OpenAddProcessDialogAsync(processLinkNode);
                }
                break;
            case "estimate-process":
                if (ResolveNode(nodeId) is { } processEstimateNode)
                {
                    await OpenEstimateProcessDialogAsync(processEstimateNode);
                }
                break;
            case "start-process":
            case "execute-process":
                if (ResolveNode(nodeId) is { } processDefinitionNode)
                {
                    await OpenStartProcessDialogAsync(processDefinitionNode);
                }
                break;
            case "add-workflow":
                if (ResolveNode(nodeId) is { } workflowParentNode)
                {
                    await OpenAddWorkflowDialogAsync(workflowParentNode);
                }
                break;
            case "start-workflow":
            case "execute-workflow":
                if (ResolveNode(nodeId) is { } workflowDefinitionNode)
                {
                    await OpenStartWorkflowDialogAsync(workflowDefinitionNode);
                }
                break;
            case "project:open-structure":
                if (ResolveNode(nodeId) is { } projectNodeForOpen)
                {
                    await OpenProjectStructureInNewTabAsync(projectNodeForOpen);
                }
                break;
            case "project:add-subproject":
                if (ResolveNode(nodeId) is { } projectNodeForAdd)
                {
                    await OpenAddSubprojectDialogAsync(projectNodeForAdd);
                }
                break;
            case "project:reconnect-subproject":
                if (ResolveNode(nodeId) is { } projectNodeForReconnect)
                {
                    await OpenReconnectSubprojectDialogAsync(projectNodeForReconnect);
                }
                break;
            case "runtime:open":
                if (ResolveNode(nodeId) is { } runtimeNode)
                {
                    await LaunchRuntimeAsync(runtimeNode, ProjectStructureRuntimeLaunchMode.Direct);
                }
                break;
            case "runtime:terminal":
                if (ResolveNode(nodeId) is { } terminalRuntimeNode)
                {
                    await LaunchRuntimeAsync(terminalRuntimeNode, ProjectStructureRuntimeLaunchMode.Terminal);
                }
                break;
            case "runtime:admin":
                if (ResolveNode(nodeId) is { } elevatedRuntimeNode)
                {
                    await LaunchRuntimeAsync(elevatedRuntimeNode, ProjectStructureRuntimeLaunchMode.Elevated);
                }
                break;
            case "runtime:stop":
                if (ResolveNode(nodeId) is { } stopRuntimeNode)
                {
                    await StopRuntimeAsync(stopRuntimeNode);
                }
                break;
            case "open-local":
                if (ResolveNode(nodeId) is { } localFileNode)
                {
                    await OpenAttachmentLocallyAsync(localFileNode);
                }
                break;
            case "open-new-tab":
                if (ResolveNode(nodeId) is { } newTabNode)
                {
                    await OpenArtifactInNewTabAsync(newTabNode.Route);
                }
                break;
            case "connect":
                await EnterDependencyModeAsync(nodeId);
                break;
            case "reconnect":
                await BeginReconnectAsync(nodeId);
                break;
            case "disconnect":
                await DisconnectNodeAsync(nodeId);
                break;
            case "branch":
                await ExecuteCommandAsync(ProjectStructureCommandKind.Branch, nodeId);
                break;
            case "mark-used":
                await ExecuteCommandAsync(ProjectStructureCommandKind.MarkUsed, nodeId);
                break;
            case "skip":
                await ExecuteCommandAsync(ProjectStructureCommandKind.Skip, nodeId);
                break;
            case "test":
                await ExecuteCommandAsync(ProjectStructureCommandKind.Test, nodeId);
                break;
            case "open":
                await ExecuteCommandAsync(ProjectStructureCommandKind.Open, nodeId);
                break;
            case "wizard":
                await ExecuteCommandAsync(ProjectStructureCommandKind.Wizard, nodeId);
                break;
            case "transcript:create":
                await CreateTranscriptFromRecordingAsync(originalNode, actionContext);
                break;
            case "transcript:summarize":
                await OpenTranscriptActionAsync(ProjectLlmActionKind.Summarize, nodeId, actionContext);
                break;
            case "transcript:find-my-tasks":
                await OpenTranscriptActionAsync(ProjectLlmActionKind.FindMyTasks, nodeId, actionContext);
                break;
            case "transcript:find-others-deliveries":
                await OpenTranscriptActionAsync(ProjectLlmActionKind.FindOthersDeliveries, nodeId, actionContext);
                break;
            case "group-frame":
                await CreateSelectionBorderAsync();
                break;
            case "group-clear-frame":
                await ClearSelectionBordersAsync();
                break;
            case "delete":
                var deleteTargetNodeIds = ResolveActionTargetNodeIds(nodeId);
                if (deleteTargetNodeIds.Count > 1)
                {
                    await DeleteNodesAsync(deleteTargetNodeIds);
                }
                else
                {
                    await DeleteNodeAsync(deleteTargetNodeIds.FirstOrDefault() ?? nodeId);
                }

                break;
        }
    }

    private async Task ExecuteCommandAsync(
        ProjectStructureCommandKind commandKind,
        string? nodeId = null,
        bool allowQuickActionDialog = false,
        bool openInNewTab = false,
        ProjectStructureActionContext? capturedContext = null)
    {
        var context = capturedContext ?? CaptureActionContext();
        if (!IsCurrentAction(context)) {
            return;
        }
        var targetNodeId = nodeId ?? selectedNode?.Id;
        if (string.IsNullOrWhiteSpace(targetNodeId))
        {
            return;
        }

        var attachmentNode = context.Surface.Nodes.FirstOrDefault(node => string.Equals(node.Id, targetNodeId, StringComparison.Ordinal));
        if (commandKind == ProjectStructureCommandKind.Open &&
            attachmentNode is not null &&
            ProjectStructureNodeHelpers.CanRenderAttachmentPreview(attachmentNode))
        {
            CloseQuickActionDialog();
            await OpenAttachmentPreviewAsync(attachmentNode);
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (allowQuickActionDialog &&
            commandKind == ProjectStructureCommandKind.Open &&
            attachmentNode is not null)
        {
            OpenQuickActionDialog(attachmentNode);
            await InvokeAsync(StateHasChanged);
            return;
        }

        CloseQuickActionDialog();
        var artifact = await ProjectWorkbenchService.ExecuteNodeCommandAsync(context.Surface.ProjectId, targetNodeId, commandKind,
            mutationOwner: CreateProjectStructureUiAgentContext(context.Surface.ProjectId) with { ExpectedProjectAdmission = context.Admission });
        committedInsightCommands.Enqueue((context.Admission, targetNodeId, commandKind, artifact));
        while (committedInsightCommands.Count > 16) {
            committedInsightCommands.Dequeue();
        }
        if (!IsCurrentAction(context)) {
            return;
        }
        linkModeSourceId = null;
        try {
            await ReloadSurfaceAsync(targetNodeId);
        } catch (Exception exception) {
            ReportActionFailure(context, exception, "The native command completed; reload the view instead of repeating it.");
            return;
        }
        if (!IsCurrentAction(context)) {
            return;
        }
        if (artifact is not null)
        {
            if (openInNewTab)
            {
                await OpenArtifactInNewTabAsync(artifact.Route);
                return;
            }

            Navigation.NavigateTo(artifact.Route);
        }
    }

    private async Task<ProjectStructureNode?> CreateObjectAsync(
        ProjectStructureCreateLeafDefinition definition,
        CanvasWorkbenchCreateActionRequest request,
        Func<ProjectObjectCreateRequest, ProjectObjectCreateRequest>? configureRequest = null,
        CancellationToken cancellationToken = default,
        Action<ProjectStructureNode>? onNodeCommitted = null,
        ProjectStructureSurface? capturedSurface = null,
        long? capturedNavigationRevision = null,
        Func<bool>? canPublish = null)
    {
        var mutationNavigationRevision = capturedNavigationRevision ?? actionNavigationRevision;
        var mutationSurface = capturedSurface ?? surface;
        var mutationProjectId = mutationSurface?.ProjectId ?? ProjectId;
        var sourceNode = mutationSurface?.Nodes.FirstOrDefault(node => string.Equals(node.Id, request.SourceNodeId, StringComparison.Ordinal));
        var parentNodeId = ProjectStructurePlacementPolicy.ResolveParentNodeId(sourceNode, request);
        var parentNode = mutationSurface?.Nodes.FirstOrDefault(node => string.Equals(node.Id, parentNodeId, StringComparison.Ordinal));
        var placementPlan = placementPolicy.ResolveCreatePlacementPlan(mutationSurface?.Nodes ?? [], sourceNode, parentNode, request, definition.ObjectType);
        var prepared = ProjectStructureCreateRequestComposer.Compose(
            definition,
            request with
            {
                Title = ResolveCreatedTitle(definition, request),
                Subtitle = request.Subtitle?.Trim() ?? string.Empty,
                Notes = ResolveCreatedNotes(definition, request)
            },
            parentNodeId ?? $"project:{mutationProjectId}",
            placementPlan.Placement);
        var createRequest = configureRequest?.Invoke(prepared.Request) ?? prepared.Request;
        createRequest = createRequest with {
            ExpectedProjectAdmission = createRequest.ExpectedProjectAdmission ?? mutationSurface?.ExpectedProjectAdmission
                ?? throw new InvalidOperationException("The original project lifetime is unavailable. Reopen this create action.")
        };
        var created = await ProjectWorkbenchService.CreateObjectAsync(
            mutationProjectId,
            createRequest,
            cancellationToken);
        onNodeCommitted?.Invoke(created);

        foreach (var pendingLink in prepared.PendingLinks)
        {
            await ProjectWorkbenchService.LinkObjectsAsync(
                mutationProjectId,
                created.Id,
                pendingLink.TargetNodeId,
                pendingLink.LinkKind,
                cancellationToken, createRequest.ExpectedProjectAdmission, createRequest.ProcessMutationAdmission);
        }

        if (placementPlan.FollowUpMoves.Count > 0)
        {
            await ProjectWorkbenchService.MoveObjectsAsync(
                mutationProjectId,
                placementPlan.FollowUpMoves,
                cancellationToken, createRequest.ExpectedProjectAdmission, createRequest.ProcessMutationAdmission);
        }

        if (actionNavigationRevision == mutationNavigationRevision && ProjectId == mutationProjectId && surface?.ExpectedProjectAdmission == createRequest.ExpectedProjectAdmission && canPublish?.Invoke() != false) {
            await ApplyCreatedSurfaceNodeAsync(created, parentNodeId, prepared.PendingLinks, placementPlan.FollowUpMoves);
        }
        return created;
    }

    private async Task OpenCreateDialogAsync(CanvasWorkbenchAction action)
    {
        var sourceNode = selectedNode;
        var request = new CanvasWorkbenchCreateActionRequest(
            action.ActionId,
            sourceNode?.Id,
            sourceNode?.X ?? 0,
            sourceNode?.Y ?? 0,
            sourceNode?.Id,
            string.Empty,
            string.Empty,
            string.Empty,
            sourceNode is null ? "canvas" : "child",
            action.CreateMode,
            action.ObjectSubtype,
            null);

        if (IsGeneratedImageAssetCreateAction(action.ActionId) && ProjectStructureCanvasCatalog.TryResolveCreateDefinition(action.ActionId, out var imageDefinition)) {
            await TryCreateGeneratedImageAssetAsync(imageDefinition, request);
            return;
        }

        if (IsSecretReferenceCreateAction(action.ActionId))
        {
            await OpenSecretReferenceDialogAsync(action, request);
            return;
        }

        if (IsTaskCreateAction(action.ActionId))
        {
            await OpenTaskCreateDialogAsync(request);
            return;
        }

        if (ProjectStructureCanvasCatalog.TryResolveCreateDefinition(action.ActionId, out var textDefinition) &&
            ProjectStructureCanvasCatalog.IsTextAssetAuthoringDefinition(textDefinition))
        {
            await CreateTextAssetAsync(textDefinition, request);
            return;
        }

        if (workbenchRef is not null)
        {
            await workbenchRef.OpenCreateDialogAsync(action, request);
            return;
        }

        if (ProjectStructureCanvasCatalog.TryResolveCreateDefinition(action.ActionId, out var definition))
        {
            await CreateObjectAsync(definition, request);
        }
    }

    private async Task OpenSecretReferenceDialogAsync(
        CanvasWorkbenchAction action,
        CanvasWorkbenchCreateActionRequest request,
        ProjectStructureActionContext? capturedContext = null) {
        var context = capturedContext ?? CaptureActionContext();
        if (!IsCurrentAction(context)) {
            return;
        }
        secretReferenceActionContext = context;
        isSecretReferenceEditMode = false;
        secretReferenceAction = action;
        secretReferenceRequest = request;
        secretReferenceEditNodeId = null;
        secretReferenceSearch = string.Empty;
        secretReferenceDialogError = string.Empty;
        selectedSecretReferenceId = string.Empty;
        secretReferencePurpose = "Project structure reference";
        secretReferenceExternalReference = string.Empty;
        secretReferenceCreateModel = NewProjectStructureSecretModel();

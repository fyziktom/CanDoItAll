@using CanDoItAll.Components.BaseLib

<section class="cw-panel-card pf-page-tabs">
    <div class="pf-page-tabs__header">
        <div class="pf-page-tabs__copy">
            <p class="cw-panel-kicker">Prompt Factory tabs</p>
            <h3 class="cw-panel-title">@Title</h3>
        </div>
        <p class="cw-panel-copy">@Description</p>
    </div>
    <div class="pf-page-tablist" role="tablist" aria-label="Prompt Factory workspaces">
        @foreach (var item in Items)
        {
            var isSelected = string.Equals(item.Key, SelectedKey, StringComparison.Ordinal);
            <button type="button"
                    id="@($"{item.Key}-tab")"
                    role="tab"
                    aria-selected="@(isSelected ? "true" : "false")"
                    aria-controls="@($"{item.Key}-panel")"
                    class="pf-page-tab @(isSelected ? "is-active" : string.Empty)"
                    @onclick="@(() => SelectedKeyChanged.InvokeAsync(item.Key))">
                <span>@item.Label</span>
                @if (!string.IsNullOrWhiteSpace(item.Count))
                {
                    <span class="pf-page-tab__count">@item.Count</span>
                }
            </button>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<SecondaryTabItem> Items { get; set; } = default!;

    [Parameter, EditorRequired]
    public string SelectedKey { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> SelectedKeyChanged { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Description { get; set; } = string.Empty;
}

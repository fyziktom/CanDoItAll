@using CanDoItAll.Modules.Factory.CanvasAdapters

@if (Overlay.IsVisible)
{
    <section class="pf-recommendation-overlay"
             aria-label="Recommendation overlay"
             data-testid="prompt-factory-recommendation-overlay">
        <div class="pf-recommendation-overlay__header">
            <p class="cw-panel-kicker">@Overlay.Title</p>
            <h3 class="cw-panel-title">Next canvas moves</h3>
            <p class="cw-panel-copy">@Overlay.Description</p>
        </div>
        <div class="pf-recommendation-overlay__list">
            @foreach (var item in Overlay.Items)
            {
                <article class="pf-recommendation-overlay__item"
                         data-recommendation-tone="@item.Tone">
                    <strong>@item.Label</strong>
                    <span>@item.Detail</span>
                </article>
            }
        </div>
        <div class="pf-recommendation-overlay__actions">
            @if (Overlay.CanApplyRecommendations)
            {
                <PromptFactoryActionButton Tone="accent"
                                           Text="Apply recommendations"
                                           Click="ApplyRecommendations" />
            }
            @if (Overlay.CanBuildFlow)
            {
                <PromptFactoryActionButton Tone="ghost"
                                           Text="Build flow"
                                           Click="BuildFlow" />
            }
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired]
    public RecommendationOverlaySummary Overlay { get; set; } = default!;

    [Parameter]
    public EventCallback ApplyRecommendations { get; set; }

    [Parameter]
    public EventCallback BuildFlow { get; set; }
}

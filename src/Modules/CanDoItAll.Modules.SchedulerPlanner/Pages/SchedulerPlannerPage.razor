@page "/scheduler"
@implements IDisposable
@using CanDoItAll.AppComponents
@using CanDoItAll.AgentFramework.Components
@using CanDoItAll.AgentFramework.Core
@using CanDoItAll.AgentFramework.Models
@using CanDoItAll.Modules.SchedulerPlanner.Presentation
@using CanDoItAll.SchedulerPlanner.UI
@inject SchedulerWorkspaceSession Session
@inject IAgentFrameworkWorkspaceService AgentWorkspaceService
@inject IAgentChatLauncher AgentChatLauncher
@inject NotificationService Notifications

<PageTitle>Scheduler</PageTitle>
<AgentChatContextSurfaceProvider Surface="@AgentSurface" ContextAccessState="@AccessState" />
<SchedulerWorkspaceSurface Workspace="workspace">
    <AgentAction>
        <AgentAvatarActionButton AgentName="@(agent?.Name ?? SchedulerAgentIdentity.DefaultDisplayName)"
                                 AvatarImageUrl="@(agent?.AvatarImageUrl ?? SchedulerAgentIdentity.DefaultAvatarImageUrl)" FallbackText="SA"
                                 Label="Open Scheduler Agent" Click="OpenAgentAsync"
                                 Disabled="@(agent is null || openingAgent || AccessState != AgentChatContextAccessState.Ready)"
                                 TestId="scheduler-agent-open" TooltipTestId="scheduler-agent-tooltip" />
    </AgentAction>
</SchedulerWorkspaceSurface>

@code {
    private SchedulerWorkspace workspace = null!;
    private AgentDefinition? agent;
    private bool openingAgent;
    private bool disposed;
    private AgentChatContextAccessState AccessState {
        get {
            if (workspace.Data is null) {
                return workspace.ReadStatus == SchedulerReadStatus.Unavailable ? AgentChatContextAccessState.Failed : AgentChatContextAccessState.Loading;
            }
            var draft = workspace.PickerDraft ?? workspace.EditDraft ?? workspace.NewDraft;
            if (workspace.ReadStatus == SchedulerReadStatus.Loading || workspace.EditorLoading || workspace.DefaultLoading
                || draft.SchemaStatus == SchedulerReadStatus.Loading || draft.Options.Values.Any(option => option.Status == SchedulerReadStatus.Loading)
                || draft.Receipt?.Status == SchedulerMutationStatus.Pending || workspace.PlanReceipts.Values.Any(receipt => receipt.Status == SchedulerMutationStatus.Pending)) {
                return AgentChatContextAccessState.Loading;
            }
            return draft.SchemaStatus == SchedulerReadStatus.Unavailable || draft.Options.Values.Any(option => option.Status == SchedulerReadStatus.Unavailable)
                ? AgentChatContextAccessState.Failed : AgentChatContextAccessState.Ready;
        }
    }
    private SchedulerPlanSummary? SelectedPlan => workspace.DeletePlan
        ?? workspace.Data?.Plans.FirstOrDefault(plan => plan.Id == (workspace.EditingPlanId ?? workspace.SelectedCalendarPlanId));
    private SchedulerDraft? ContextDraft => workspace.PickerDraft ?? (workspace.Tab == SchedulerTab.NewSchedule ? workspace.NewDraft : null);
    private SchedulerTargetOption? SelectedTarget => ContextDraft?.Values is { } values
        ? workspace.Data?.TargetOptions.FirstOrDefault(item => (item.Kind, item.Id, item.VersionId) == (values.TargetKind, values.TargetId, values.TargetVersionId)) : null;
    private AgentChatContextSurface AgentSurface => SchedulerAgentChatContextBuilder.Build(workspace.Tab switch {
        SchedulerTab.Schedules => SchedulerAgentChatView.Schedules,
        SchedulerTab.NewSchedule => SchedulerAgentChatView.NewSchedule,
        _ => SchedulerAgentChatView.Calendar
    }, SelectedPlan, SelectedTarget, workspace.DeletePlan is not null ? "delete-schedule" : workspace.EditDraft is not null ? "edit-schedule" : workspace.PickerDraft is not null ? "target-picker" : null);

    protected override async Task OnInitializedAsync() {
        workspace = new(Session);
        workspace.Changed += Changed;
        await Task.WhenAll(workspace.InitializeAsync(), ResolveAgentAsync());
    }
    private async Task ResolveAgentAsync() {
        try {
            var agents = await AgentWorkspaceService.ListAgentsAsync(includeTemplates: false);
            if (!disposed) {
                agent = agents.SingleOrDefault(SchedulerAgentIdentity.Matches);
            }
        } catch (Exception exception) {
            if (!disposed) {
                Notifications.Warning("Scheduler Agent unavailable", exception.Message);
            }
        }
    }
    private async Task OpenAgentAsync() {
        if (disposed || agent is null || openingAgent || AccessState != AgentChatContextAccessState.Ready) {
            return;
        }
        var generation = workspace.ViewGeneration;
        openingAgent = true;
        try {
            await AgentChatLauncher.StartNewChatAsync(agent.Id);
            if (!disposed && generation == workspace.ViewGeneration) {
                Notifications.Success("Scheduler Agent ready", "Opened a new workflow scheduling chat.");
            }
        } catch (Exception exception) {
            if (!disposed && generation == workspace.ViewGeneration) {
                Notifications.Error("Unable to open Scheduler Agent", exception.Message);
            }
        } finally {
            openingAgent = false;
        }
    }
    private async void Changed() {
        try {
            if (!disposed) {
                await InvokeAsync(StateHasChanged);
            }
        } catch (Exception) when (disposed) {
        } catch (Exception exception) {
            await DispatchExceptionAsync(exception);
        }
    }
    public void Dispose() {
        disposed = true;
        workspace.Changed -= Changed;
        workspace.Dispose();
    }
}

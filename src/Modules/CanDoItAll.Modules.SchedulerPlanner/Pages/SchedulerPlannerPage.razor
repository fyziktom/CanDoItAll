    private static PendingLoad BeginLatestLoad(
        ref long generation,
        ref CancellationTokenSource? activeCancellation)
    {
        var loadGeneration = Interlocked.Increment(ref generation);
        var cancellation = new CancellationTokenSource();
        var supersededCancellation = Interlocked.Exchange(ref activeCancellation, cancellation);
        supersededCancellation?.Cancel();
        return new PendingLoad(loadGeneration, cancellation);
    }

    private static bool IsCurrentLatestLoad(PendingLoad load, ref long generation)
        => !load.Cancellation.IsCancellationRequested &&
           Volatile.Read(ref generation) == load.Generation;

    private static void CompleteLatestLoad(
        PendingLoad load,
        ref long generation,
        ref long completedGeneration,
        ref CancellationTokenSource? activeCancellation)
    {
        if (Volatile.Read(ref generation) == load.Generation)
        {
            Volatile.Write(ref completedGeneration, load.Generation);
        }

        Interlocked.CompareExchange(ref activeCancellation, null, load.Cancellation);
        load.Cancellation.Dispose();
    }

    private static void InvalidateLatestLoad(
        ref long generation,
        ref long completedGeneration,
        ref CancellationTokenSource? activeCancellation)
    {
        var invalidationGeneration = Interlocked.Increment(ref generation);
        Volatile.Write(ref completedGeneration, invalidationGeneration);
        Interlocked.Exchange(ref activeCancellation, null)?.Cancel();
    }

    private static bool HaveSameWorkflowInputValues(
        IReadOnlyDictionary<string, string> expected,
        IReadOnlyDictionary<string, string> actual)
        => expected.Count == actual.Count &&
           expected.All(pair =>
               actual.TryGetValue(pair.Key, out var value) &&
               string.Equals(pair.Value, value, StringComparison.Ordinal));

    private async Task RunUiOperationAsync(
        Func<Task> operation,
        Func<bool>? isCurrent = null,
        CancellationToken cancellationToken = default)
    {
        var operationGeneration = Interlocked.Increment(ref uiOperationGeneration);
        errorMessage = string.Empty;
        try
        {
            await operation();
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            if (Volatile.Read(ref uiOperationGeneration) == operationGeneration &&
                (isCurrent?.Invoke() ?? true))
            {
                errorMessage = exception.Message;
            }
        }
        finally
        {
            if (Volatile.Read(ref uiOperationGeneration) == operationGeneration)
            {
                Volatile.Write(ref completedUiOperationGeneration, operationGeneration);
            }
        }
    }


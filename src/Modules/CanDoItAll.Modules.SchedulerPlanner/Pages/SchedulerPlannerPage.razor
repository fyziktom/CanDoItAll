@page "/scheduler"
@implements IAsyncDisposable
@using System.Globalization
@using System.Text.Json
@using System.Text.Json.Nodes
@using CanDoItAll.AgentFramework.Components
@using CanDoItAll.AgentFramework.Core
@using CanDoItAll.AgentFramework.Models
@using CanDoItAll.AppComponents
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.CanvasLib
@using Microsoft.JSInterop
@inject IJSRuntime JsRuntime
@inject ISchedulerPlannerService SchedulerPlannerService
@inject ICronDescriptionService CronDescriptionService
@inject ISchedulerWorkflowInputSchemaService WorkflowInputSchemaService
@inject ISchedulerWorkflowInputOptionService WorkflowInputOptionService
@inject IAgentFrameworkWorkspaceService AgentWorkspaceService
@inject IAgentChatLauncher AgentChatLauncher
@inject NotificationService Notifications

<PageTitle>Scheduler</PageTitle>

<AgentChatContextSurfaceProvider Surface="@AgentChatSurface"
                                 ContextAccessState="@AgentChatAccessState" />

<PageScaffold MaxWidthClass="max-w-full">
    <Header>
        <PageHeader Eyebrow="Scheduler"
                    Title="Scheduler and planner"
                    Description="Plan workflow and process runs with scheduler-owned Quartz CRON triggers and calendar-backed visibility."
                    Compact="true">
            <Stats>
                <CompactStat Label="schedules" Value="@Plans.Count.ToString()" TooltipText="Saved run plans." Tone="info" />
                <CompactStat Label="enabled" Value="@Plans.Count(item => item.IsEnabled).ToString()" TooltipText="Plans currently projected into the scheduler runtime." Tone="success" />
                <CompactStat Label="next 30 days" Value="@CalendarEventCount.ToString()" TooltipText="Projected calendar events." Tone="accent" />
                <CompactStat Label="failures" Value="@History.Count(item => item.Status == SchedulerPlanRunDispatchStatus.Failed).ToString()" TooltipText="Failed dispatch attempts in the current history view." Tone="warning" />
                <CompactStat Label="no action" Value="@History.Count(item => item.Status == SchedulerPlanRunDispatchStatus.NoMessages).ToString()" TooltipText="No-message polling runs in the current history view." Tone="neutral" />
                <CompactStat Label="waiting" Value="@History.Count(item => item.Status == SchedulerPlanRunDispatchStatus.WaitingForApproval).ToString()" TooltipText="Runs paused for explicit approval." Tone="info" />
            </Stats>
            <Actions>
                <AgentAvatarActionButton AgentName="@SchedulerAgentDisplayName"
                                         AvatarImageUrl="@SchedulerAgentAvatarImageUrl"
                                         FallbackText="SA"
                                         Label="@($"Open {SchedulerAgentDisplayName}")"
                                         Click="OpenSchedulerAgentAsync"
                                         Disabled="@(schedulerAgent is null || isOpeningSchedulerAgent || isBusy || AgentChatAccessState != AgentChatContextAccessState.Ready)"
                                         TestId="scheduler-agent-open"
                                         TooltipTestId="scheduler-agent-tooltip" />
                <PageHeaderActionButton Icon="refresh"
                                        Label="Refresh"
                                        TooltipText="Refresh scheduler plans, history, and projected events."
                                        Disabled="@isBusy"
                                        IsBusy="@isBusy"
                                        Click="RefreshAsync"
                                        data-testid="scheduler-refresh" />
            </Actions>
        </PageHeader>
    </Header>

    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <SurfaceCard Soft="true" data-testid="scheduler-error">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Action required" />
                <h2 class="text-base font-semibold text-rose-900">Scheduler operation failed</h2>
                <p class="mt-2 text-sm leading-6 text-rose-700">@errorMessage</p>
            </SurfaceCard>
        }

        @if (workspace is null)
        {
            <SurfaceCard data-testid="scheduler-loading">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Loading" />
                <h2 class="text-base font-semibold text-slate-900">Refreshing scheduler state</h2>
            </SurfaceCard>
        }
        else
        {
            <Tabs @bind-SelectedIndex="activeTabIndex"
                  RenderMode="TabRenderMode.Server"
                  OverflowMode="TabsOverflowMode.Wrap"
                  AriaLabel="Scheduler planner tabs"
                  data-testid="scheduler-tabs">
                <TabsItem Text="Calendar" Icon="calendar_month" BadgeText="@CalendarEventCount.ToString()" data-testid="scheduler-tab-calendar">
                    <SurfaceCard data-testid="scheduler-calendar-card">
                        <Split Gap="LayoutGap.Small">
                            <div>
                                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Calendar" />
                                <h2 class="text-base font-semibold text-slate-900">Planned and dispatched runs</h2>
                            </div>
                            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                <StatusBadge Tone="info" Text="@($"{CalendarEventCount} event(s)")" />
                                <StatusBadge Tone="neutral" Text="@($"{Plans.Count} schedule(s)")" />
                            </Cluster>
                        </Split>
                        <div class="scheduler-planner-calendar-shell mt-4"
                             @ref="schedulerCalendarElement"
                             data-testid="scheduler-calendar"
                             @ondblclick="HandleCalendarDoubleClickAsync">
                            <CanvasCalendar Surface="@workspace.CalendarSurface"
                                            HostClass="scheduler-planner-calendar-host"
                                            SelectionChanged="HandleCalendarSelectionChangedAsync"
                                            StateChanged="HandleCalendarStateChangedAsync" />
                        </div>
                    </SurfaceCard>
                </TabsItem>

                <TabsItem Text="Schedules" Icon="event_note" BadgeText="@Plans.Count.ToString()" data-testid="scheduler-tab-schedules">
                    <SurfaceCard data-testid="scheduler-plan-list">
                        <div class="scheduler-list-toolbar" data-testid="scheduler-schedules-toolbar">
                            <div>
                                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Schedules" />
                                <h2 class="text-base font-semibold text-slate-900">Saved scheduled runs</h2>
                            </div>
                            <InputText @bind-Value="scheduleSearchText"
                                       class="ui-input scheduler-list-toolbar__search"
                                       placeholder="Search schedules"
                                       data-testid="scheduler-schedules-search" />
                            <select value="@FormatScheduleTargetKindFilter()"
                                    class="ui-input scheduler-list-toolbar__select"
                                    @onchange="HandleScheduleTargetKindFilterChanged"
                                    data-testid="scheduler-schedules-target-kind">
                                <option value="">All targets</option>
                                @foreach (var kind in Enum.GetValues<SchedulerPlanTargetKind>())
                                {
                                    <option value="@kind">@kind</option>
                                }
                            </select>
                            <InputSelect @bind-Value="scheduleStateFilter"
                                         class="ui-input scheduler-list-toolbar__select"
                                         data-testid="scheduler-schedules-state">
                                @foreach (var state in Enum.GetValues<ScheduleStateFilter>())
                                {
                                    <option value="@state">@FormatScheduleStateFilter(state)</option>
                                }
                            </InputSelect>
                            <span class="scheduler-list-toolbar__result">@ScheduleFilterResultText</span>
                            <div class="scheduler-list-toolbar__actions">
                                <Button Text="Clear"
                                        Icon="restart_alt"
                                        Tone="ButtonTone.Default"
                                        Size="ButtonSize.Small"
                                        Disabled="@(!HasScheduleFilters)"
                                        Click="ClearScheduleFilters"
                                        class="scheduler-list-toolbar__button" />
                                <Button Text="New"
                                        Icon="add"
                                        Size="ButtonSize.Small"
                                        Click="OpenNewScheduleTab"
                                        class="scheduler-list-toolbar__button"
                                        data-testid="scheduler-plan-new" />
                            </div>
                        </div>

                        @if (Plans.Count == 0)
                        {
                            <div class="mt-4">
                                <EmptyState Eyebrow="No schedules"
                                            Title="Create the first scheduled run"
                                            Description="Saved plans will appear here after a workflow or process is assigned to a CRON schedule." />
                            </div>
                        }
                        else if (FilteredPlans.Count == 0)
                        {
                            <div class="mt-4">
                                <EmptyState Eyebrow="No matches"
                                            Title="No schedules match the current filters"
                                            Description="Clear search, target, or state filters to review every saved schedule." />
                            </div>
                        }
                        else
                        {
                            <Grid Gap="LayoutGap.Medium"
                                  ColumnTemplate="repeat(auto-fill,minmax(17.5rem,21.5rem))"
                                  Class="scheduler-plan-card-grid mt-4">
                                @foreach (var plan in FilteredPlans)
                                {
                                    <article class="@ResolveScheduleCardClass(plan)" data-testid="scheduler-plan-card">
                                        <Stack GapScale="LayoutGap.Small" AlignItems="AlignItems.Stretch">
                                            <Split Gap="LayoutGap.Small"
                                                   AlignItems="AlignItems.Start"
                                                   JustifyContent="JustifyContent.SpaceBetween"
                                                   Wrap="FlexWrap.Wrap">
                                                <div class="min-w-0">
                                                    <Cluster Gap="LayoutGap.XSmall" Wrap="FlexWrap.Wrap">
                                                        <StatusBadge Tone="@ResolveTargetKindTone(plan.TargetKind)" Text="@plan.TargetKind.ToString()" />
                                                        <StatusBadge Tone="@(plan.IsEnabled ? "success" : "neutral")" Text="@(plan.IsEnabled ? "Enabled" : "Paused")" />
                                                    </Cluster>
                                                    <h3 class="scheduler-plan-card__title">@plan.Name</h3>
                                                    <p class="scheduler-plan-card__target">@plan.TargetName</p>
                                                </div>
                                                <Button Text="Edit"
                                                        Icon="edit"
                                                        Size="ButtonSize.Small"
                                                        Disabled="@isBusy"
                                                        Click="@(() => OpenEditScheduleDialogAsync(plan))"
                                                        class="scheduler-plan-card__edit"
                                                        data-testid="scheduler-plan-edit" />
                                            </Split>

                                            <p class="scheduler-plan-card__cron">@plan.CronDescription</p>

                                            <div class="scheduler-plan-card__meta">
                                                <div>
                                                    <span>Next fire</span>
                                                    <strong>@FormatNextFire(plan.NextPlannedFireAtUtc)</strong>
                                                </div>
                                                <div>
                                                    <span>Time zone</span>
                                                    <strong>@plan.TimeZoneId</strong>
                                                </div>
                                                <div>
                                                    <span>Updated</span>
                                                    <strong>@plan.UpdatedAtUtc.LocalDateTime.ToString("g")</strong>
                                                </div>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(plan.LastError))
                                            {
                                                <p class="scheduler-plan-card__error">@plan.LastError</p>
                                            }

                                            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap" Class="scheduler-plan-card__actions">
                                                <Button Text="@(plan.IsEnabled ? "Pause" : "Resume")"
                                                        Icon="@(plan.IsEnabled ? "pause" : "play_arrow")"
                                                        Tone="ButtonTone.Default"
                                                        Size="ButtonSize.Small"
                                                        Disabled="@isBusy"
                                                        Click="@(() => TogglePlanAsync(plan))" />
                                                <Button Text="Delete"
                                                        Icon="delete"
                                                        Tone="ButtonTone.Danger"
                                                        Size="ButtonSize.Small"
                                                        Disabled="@isBusy"
                                                        Click="@(() => OpenDeleteScheduleDialog(plan))"
                                                        data-testid="scheduler-plan-delete" />
                                            </Cluster>
                                        </Stack>
                                    </article>
                                }
                            </Grid>
                        }
                    </SurfaceCard>
                </TabsItem>

                <TabsItem Text="New schedule" Icon="event_repeat" data-testid="scheduler-tab-new">
                    <Grid Gap="LayoutGap.Large" ColumnTemplateLg="minmax(0,0.9fr) minmax(0,1.1fr)">
                        <SurfaceCard data-testid="scheduler-form">
                            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Setup" />
                            <h2 class="text-base font-semibold text-slate-900">Schedule a workflow or process run</h2>

                            <Stack GapScale="LayoutGap.Medium" Class="mt-4">
                                <label class="block">
                                    <span class="cda-eyebrow">Name</span>
                                    <InputText @bind-Value="editor.Name"
                                               class="ui-input mt-1"
                                               data-testid="scheduler-name" />
                                </label>

                                <div>
                                    <span class="cda-eyebrow">Target</span>
                                    <div class="scheduler-target-summary mt-1" data-testid="scheduler-target-selected">
                                        <div class="min-w-0">
                                            <p class="text-sm font-semibold text-slate-900">@SelectedTargetName</p>
                                            <p class="mt-1 text-xs leading-5 text-slate-500">@SelectedTargetDescription</p>
                                        </div>
                                        <Button Text="Choose"
                                                Icon="switch_account"
                                                Tone="ButtonTone.Default"
                                                Size="ButtonSize.Small"
                                                Click="OpenTargetPicker"
                                                data-testid="scheduler-target-open" />
                                    </div>
                                </div>

                                <label class="block">
                                    <span class="cda-eyebrow">Quartz CRON</span>
                                    <InputText @bind-Value="editor.CronExpression"
                                               class="ui-input mt-1 font-mono"
                                               data-testid="scheduler-cron" />
                                </label>

                                <Cluster Gap="LayoutGap.Small"
                                         Wrap="FlexWrap.Wrap"
                                         data-testid="scheduler-cron-presets">
                                    <Button Text="Every 2 hours"
                                            Icon="schedule"
                                            Tone="ButtonTone.Default"
                                            Size="ButtonSize.Small"
                                            Click="@(() => ApplyCronPreset(SchedulerCronPreset.EveryTwoHours))"
                                            data-testid="scheduler-cron-preset-every-two-hours" />
                                    <Button Text="Weekdays 9 AM"
                                            Icon="work_history"
                                            Tone="ButtonTone.Default"
                                            Size="ButtonSize.Small"
                                            Click="@(() => ApplyCronPreset(SchedulerCronPreset.WeekdaysAtNine))" />
                                    <Button Text="Daily 9 AM"
                                            Icon="today"
                                            Tone="ButtonTone.Default"
                                            Size="ButtonSize.Small"
                                            Click="@(() => ApplyCronPreset(SchedulerCronPreset.DailyAtNine))" />
                                </Cluster>

                                <label class="block">
                                    <span class="cda-eyebrow">Time zone</span>
                                    <InputText @bind-Value="editor.TimeZoneId"
                                               class="ui-input mt-1"
                                               data-testid="scheduler-timezone" />
                                </label>

                                <label class="block">
                                    <span class="cda-eyebrow">Misfire policy</span>
                                    <InputSelect @bind-Value="editor.MisfirePolicy"
                                                 class="ui-input mt-1"
                                                 data-testid="scheduler-misfire">
                                        @foreach (var policy in Enum.GetValues<SchedulerPlanMisfirePolicy>())
                                        {
                                            <option value="@policy">@policy</option>
                                        }
                                    </InputSelect>
                                </label>

                                @if (workflowInputSchema is not null && workflowInputSchema.Parameters.Count > 0)
                                {
                                    <section class="scheduler-workflow-input" data-testid="scheduler-typed-inputs">
                                        <Split Gap="LayoutGap.Small"
                                               AlignItems="AlignItems.Start"
                                               JustifyContent="JustifyContent.SpaceBetween"
                                               Wrap="FlexWrap.Wrap">
                                            <div class="min-w-0">
                                                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Workflow input" />
                                                <h3 class="scheduler-workflow-input__title">@workflowInputSchema.WorkflowName</h3>
                                            </div>
                                            <StatusBadge Tone="info" Text="@($"{workflowInputSchema.Parameters.Count} field(s)")" />
                                        </Split>

                                        @if (!string.IsNullOrWhiteSpace(ResolveWorkflowInputIssue(string.Empty)))
                                        {
                                            <p class="scheduler-workflow-input__issue scheduler-workflow-input__issue--general"
                                               data-testid="scheduler-input-general-error">@ResolveWorkflowInputIssue(string.Empty)</p>
                                        }

                                        <Grid Gap="LayoutGap.Medium"
                                              ColumnsMd="2"
                                              Class="scheduler-workflow-input__grid">
                                            @foreach (var parameter in workflowInputSchema.Parameters)
                                            {
                                                var options = ResolveWorkflowInputOptions(parameter);
                                                var issue = ResolveWorkflowInputIssue(parameter.Key);
                                                var fieldClass = ResolveWorkflowInputFieldClass(parameter);

                                                <label class="@fieldClass" data-testid="@BuildWorkflowInputFieldTestId(parameter)">
                                                    <span class="cda-eyebrow">@parameter.Label</span>
                                                    @if (ShouldRenderSelect(parameter, options))
                                                    {
                                                        <select value="@GetWorkflowInputValue(parameter.Key)"
                                                                class="ui-input mt-1"
                                                                aria-required="@parameter.IsRequired"
                                                                @onchange="@(async args => await HandleWorkflowInputValueChangedAsync(parameter, args.Value?.ToString() ?? string.Empty))"
                                                                data-testid="@BuildWorkflowInputTestId(parameter)">
                                                            <option value="">@ResolveEmptyOptionText(parameter)</option>
                                                            @foreach (var option in options)
                                                            {
                                                                <option value="@option.Value">@option.Label</option>
                                                            }
                                                        </select>
                                                    }
                                                    else if (parameter.Kind is WorkflowInputParameterKind.Integer or WorkflowInputParameterKind.DurationMinutes)
                                                    {
                                                        <input type="number"
                                                               min="@parameter.MinimumValue"
                                                               max="@parameter.MaximumValue"
                                                               value="@GetWorkflowInputValue(parameter.Key)"
                                                               class="ui-input mt-1"
                                                               placeholder="@parameter.Placeholder"
                                                               aria-required="@parameter.IsRequired"
                                                               @oninput="@(async args => await HandleWorkflowInputValueChangedAsync(parameter, args.Value?.ToString() ?? string.Empty))"
                                                               @onchange="@(async args => await HandleWorkflowInputValueChangedAsync(parameter, args.Value?.ToString() ?? string.Empty))"
                                                               data-testid="@BuildWorkflowInputTestId(parameter)" />
                                                    }
                                                    else
                                                    {
                                                        <input type="text"
                                                               list="@BuildWorkflowInputDatalistId(parameter)"
                                                               value="@GetWorkflowInputValue(parameter.Key)"
                                                               class="ui-input mt-1"
                                                               placeholder="@parameter.Placeholder"
                                                               aria-required="@parameter.IsRequired"
                                                               @oninput="@(async args => await HandleWorkflowInputValueChangedAsync(parameter, args.Value?.ToString() ?? string.Empty))"
                                                               @onchange="@(async args => await HandleWorkflowInputValueChangedAsync(parameter, args.Value?.ToString() ?? string.Empty))"
                                                               data-testid="@BuildWorkflowInputTestId(parameter)" />
                                                        @if (options.Count > 0)
                                                        {
                                                            <datalist id="@BuildWorkflowInputDatalistId(parameter)">
                                                                @foreach (var option in options)
                                                                {
                                                                    <option value="@option.Value">@option.Label</option>
                                                                }
                                                            </datalist>
                                                        }
                                                    }

                                                    @if (!string.IsNullOrWhiteSpace(parameter.Description))
                                                    {
                                                        <span class="scheduler-workflow-input__description">@parameter.Description</span>
                                                    }

                                                    @if (!string.IsNullOrWhiteSpace(issue))
                                                    {
                                                        <span class="scheduler-workflow-input__issue" data-testid="@BuildWorkflowInputIssueTestId(parameter)">@issue</span>
                                                    }
                                                </label>
                                            }
                                        </Grid>
                                    </section>
                                }

                                <label class="block">
                                    <span class="cda-eyebrow">Advanced input JSON</span>
                                    <TextArea Value="@editor.InputJson"
                                                   ValueChanged="HandleRawInputJsonChangedAsync"
                                                   Class="mt-1 font-mono"
                                                   data-testid="scheduler-input-json" />
                                </label>

                                <label class="flex items-center gap-2 text-sm text-slate-700">
                                    <InputCheckbox @bind-Value="editor.IsEnabled" />
                                    Enabled after save
                                </label>

                                <Cluster Gap="LayoutGap.Small">
                                    <Button Text="Save schedule"
                                            Icon="save"
                                            Disabled="@isBusy"
                                            IsBusy="@isBusy"
                                            Click="SaveScheduleAsync"
                                            data-testid="scheduler-save" />
                                    <Button Text="Reset"
                                            Icon="restart_alt"
                                            Tone="ButtonTone.Default"
                                            Disabled="@isBusy"
                                            Click="ResetEditorAsync" />
                                </Cluster>
                            </Stack>
                        </SurfaceCard>

                        <SurfaceCard data-testid="scheduler-cron-preview">
                            <TextBlock TextStyle="TextStyle.Eyebrow" Value="CRON description" />
                            <h2 class="text-base font-semibold text-slate-900">@CronPreviewTitle</h2>
                            <p class="mt-3 text-sm leading-6 text-slate-600">@CronPreviewDescription</p>

                            <div class="mt-5 cda-panel-card--soft">
                                <p class="cda-eyebrow">Target summary</p>
                                <p class="mt-1 text-sm font-semibold text-slate-900">@SelectedTargetName</p>
                                <p class="mt-2 text-sm leading-6 text-slate-600">@SelectedTargetDescription</p>
                            </div>
                        </SurfaceCard>
                    </Grid>
                </TabsItem>

                <TabsItem Text="History" Icon="history" BadgeText="@History.Count.ToString()" data-testid="scheduler-tab-history">
                    <SurfaceCard data-testid="scheduler-history">
                        <div class="scheduler-list-toolbar" data-testid="scheduler-history-toolbar">
                            <div>
                                <TextBlock TextStyle="TextStyle.Eyebrow" Value="History" />
                                <h2 class="text-base font-semibold text-slate-900">Dispatched scheduled runs</h2>
                            </div>
                            <InputText @bind-Value="historyQuery.Search"
                                       class="ui-input scheduler-list-toolbar__search"
                                       placeholder="Search history"
                                       data-testid="scheduler-history-search" />
                            <InputSelect @bind-Value="historyQuery.Status"
                                         class="ui-input scheduler-list-toolbar__select"
                                         data-testid="scheduler-history-status">
                                <option value="">All statuses</option>
                                @foreach (var status in Enum.GetValues<SchedulerPlanRunDispatchStatus>())
                                {
                                    <option value="@status">@status</option>
                                }
                            </InputSelect>
                            <InputSelect @bind-Value="historyQuery.TargetKind"
                                         class="ui-input scheduler-list-toolbar__select"
                                         data-testid="scheduler-history-kind">
                                <option value="">All targets</option>
                                @foreach (var kind in Enum.GetValues<SchedulerPlanTargetKind>())
                                {
                                    <option value="@kind">@kind</option>
                                }
                            </InputSelect>
                            <span class="scheduler-list-toolbar__result">@($"{History.Count} run(s)")</span>
                            <div class="scheduler-list-toolbar__actions">
                                <Button Text="Search"
                                        Icon="search"
                                        Tone="ButtonTone.Default"
                                        Size="ButtonSize.Small"
                                        Disabled="@isBusy"
                                        Click="RefreshAsync"
                                        class="scheduler-list-toolbar__button" />
                            </div>
                        </div>

                        @if (History.Count == 0)
                        {
                            <div class="mt-4">
                                <EmptyState Eyebrow="No history"
                                            Title="No scheduled run history"
                                            Description="Triggered runs and dispatch failures appear here after the scheduler fires a schedule." />
                            </div>
                        }
                        else
                        {
                            <div class="mt-4">
                                <DataGrid TItem="SchedulerPlanRunSummary"
                                          Data="@History"
                                          AllowPaging="true"
                                          PageSize="12">
                                    <Columns>
                                        <DataGridColumn TItem="SchedulerPlanRunSummary" Title="Run">
                                            <Template Context="run">
                                                <div>
                                                    <p class="font-semibold text-slate-900">@run.PlanName</p>
                                                    <p class="text-xs text-slate-500">@run.TargetKind / @run.TargetName</p>
                                                </div>
                                            </Template>
                                        </DataGridColumn>
                                        <DataGridColumn TItem="SchedulerPlanRunSummary" Title="Fired">
                                            <Template Context="run">@run.FiredAtUtc.LocalDateTime.ToString("g")</Template>
                                        </DataGridColumn>
                                        <DataGridColumn TItem="SchedulerPlanRunSummary" Title="Status">
                                            <Template Context="run">
                                                <StatusBadge Tone="@ResolveRunTone(run.Status)" Text="@run.Status.ToString()" />
                                            </Template>
                                        </DataGridColumn>
                                        <DataGridColumn TItem="SchedulerPlanRunSummary" Title="Route">
                                            <Template Context="run">
                                                <StatusBadge Tone="@ResolveRouteTone(run)" Text="@FormatRunRoute(run.Route)" />
                                            </Template>
                                        </DataGridColumn>
                                        <DataGridColumn TItem="SchedulerPlanRunSummary" Title="Result">
                                            <Template Context="run">
                                                <div class="space-y-1">
                                                    <span class="text-sm text-slate-600">@ResolveRunResult(run)</span>
                                                    @if (run.RetryCategory != SchedulerPlanRunRetryCategory.None)
                                                    {
                                                        <p class="text-xs font-medium text-slate-500">@FormatRunPolicy(run.RetryCategory)</p>
                                                    }
                                                </div>
                                            </Template>
                                        </DataGridColumn>
                                    </Columns>
                                </DataGrid>
                            </div>
                        }
                    </SurfaceCard>
                </TabsItem>
            </Tabs>

            <Dialog IsOpen="@isTargetPickerOpen"
                    Eyebrow="Target"
                    Title="@TargetPickerDialogTitle"
                    Subtitle="@TargetPickerDialogSubtitle"
                    Size="ModalSize.Wide"
                    DenseChrome="true"
                    TestId="scheduler-target-dialog"
                    OnClose="CloseTargetPickerAsync">
                <Stack GapScale="LayoutGap.Medium"
                       AlignItems="AlignItems.Stretch"
                       Class="scheduler-target-picker">
                    <div class="scheduler-target-picker__filters">
                        <TextBox Value="@targetSearchText"
                                 ValueChanged="HandleTargetSearchChangedAsync"
                                 Placeholder="Search workflows and processes"
                                 Immediate="true"
                                 Class="scheduler-target-picker__search"
                                 aria-label="Search workflows and processes"
                                 data-testid="scheduler-target-search" />

                        <TagEditor Value="@targetTagFilters"
                                   ValueChanged="HandleTargetTagFiltersChangedAsync"
                                   Suggestions="@AvailableTargetTags"
                                   Placeholder="Filter tags"
                                   MaxTags="6"
                                   TestId="scheduler-target-tag-filter"
                                   InputTestId="scheduler-target-tag-filter-input" />

                        <label class="scheduler-target-picker__check">
                            <CheckBox TValue="bool"
                                      @bind-Value="showProcessTargets"
                                      aria-label="Show process targets"
                                      data-testid="scheduler-target-filter-processes" />
                            <span>Processes</span>
                        </label>
                        <label class="scheduler-target-picker__check">
                            <CheckBox TValue="bool"
                                      @bind-Value="showWorkflowTargets"
                                      aria-label="Show workflow targets"
                                      data-testid="scheduler-target-filter-workflows" />
                            <span>Workflows</span>
                        </label>
                    </div>

                    <div class="scheduler-target-picker__summary">
                        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                            <StatusBadge Tone="info" Text="@($"{FilteredTargetOptions.Count} of {TargetOptions.Count} targets")" />
                            @if (targetTagFilters.Count > 0)
                            {
                                <StatusBadge Tone="neutral" Text="@($"{targetTagFilters.Count} tag filter(s)")" />
                            }
                        </Cluster>
                    </div>

                    @if (FilteredTargetOptions.Count == 0)
                    {
                        <EmptyState Eyebrow="No matches"
                                    Title="No targets match the current filters"
                                    Description="Clear the search, tags, or target type filters to show available workflows and processes." />
                    }
                    else
                    {
                        <Grid Gap="LayoutGap.Medium"
                              ColumnTemplate="repeat(auto-fit,minmax(16rem,1fr))"
                              Class="w-full">
                            @foreach (var target in FilteredTargetOptions)
                            {
                                var isSelected = IsTargetSelected(target);

                                <article class="@ResolveTargetCardClass(target)" data-testid="scheduler-target-card-shell">
                                    <button type="button"
                                            class="scheduler-target-card__select"
                                            aria-label="@($"Select {target.Name}")"
                                            @onclick="@(() => SelectTargetAsync(target))"
                                            data-testid="scheduler-target-card">
                                        <Stack GapScale="LayoutGap.Small"
                                               AlignItems="AlignItems.Stretch">
                                            <div class="scheduler-target-card__identity">
                                                <Avatar Alt="@target.Name"
                                                        FallbackText="@ResolveTargetInitials(target)"
                                                        UseDefaultImageWhenMissing="false"
                                                        Size="AvatarSize.Medium"
                                                        Shape="AvatarShape.Rounded" />

                                                <div class="scheduler-target-card__identity-copy">
                                                    <Cluster Gap="LayoutGap.XSmall" Wrap="FlexWrap.Wrap">
                                                        <StatusBadge Tone="@ResolveTargetKindTone(target.Kind)" Text="@target.Kind.ToString()" />
                                                        <StatusBadge Tone="@ResolveTargetStatusTone(target.Status)" Text="@target.Status" />
                                                        @if (isSelected)
                                                        {
                                                            <StatusBadge Tone="info" Text="Selected" />
                                                        }
                                                    </Cluster>

                                                    <p class="scheduler-target-card__name">@target.Name</p>
                                                    <p class="scheduler-target-card__role">@ResolveTargetRole(target)</p>
                                                </div>
                                            </div>

                                            <p class="scheduler-target-card__summary">@ResolveTargetDescription(target)</p>

                                            <Cluster Gap="LayoutGap.XSmall" Wrap="FlexWrap.Wrap">
                                                @foreach (var tag in BuildTargetTags(target).Take(3))
                                                {
                                                    <StatusBadge Tone="neutral" Text="@tag" />
                                                }
                                            </Cluster>
                                        </Stack>
                                    </button>
                                </article>
                            }
                        </Grid>
                    }
                </Stack>
            </Dialog>

            @if (isEditScheduleDialogOpen && editScheduleEditor is not null)
            {
                <Dialog IsOpen="true"
                        Eyebrow="Schedule"
                        Title="Edit schedule"
                        Subtitle="@EditScheduleSubtitle"
                        Size="ModalSize.Wide"
                        DenseChrome="true"
                        TestId="scheduler-edit-dialog"
                        OnClose="CloseEditScheduleDialogAsync">
                    <ChildContent>
                        <Grid Gap="LayoutGap.Large" ColumnTemplateLg="minmax(0,1.25fr) minmax(18rem,0.75fr)">
                            <Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch">
                                <label class="block">
                                    <span class="cda-eyebrow">Name</span>
                                    <InputText @bind-Value="editScheduleEditor.Name"
                                               class="ui-input mt-1"
                                               data-testid="scheduler-edit-name" />
                                </label>

                                <label class="block">
                                    <span class="cda-eyebrow">Description</span>
                                    <TextArea @bind-Value="editScheduleEditor.Description"
                                                   Class="mt-1"
                                                   data-testid="scheduler-edit-description" />
                                </label>

                                <label class="block">
                                    <span class="cda-eyebrow">Quartz CRON</span>
                                    <InputText @bind-Value="editScheduleEditor.CronExpression"
                                               class="ui-input mt-1 font-mono"
                                               data-testid="scheduler-edit-cron" />
                                </label>

                                <Cluster Gap="LayoutGap.Small"
                                         Wrap="FlexWrap.Wrap"
                                         data-testid="scheduler-edit-cron-presets">
                                    <Button Text="Every 2 hours"
                                            Icon="schedule"
                                            Tone="ButtonTone.Default"
                                            Size="ButtonSize.Small"
                                            Click="@(() => ApplyCronPresetToEditor(editScheduleEditor, SchedulerCronPreset.EveryTwoHours))" />
                                    <Button Text="Weekdays 9 AM"
                                            Icon="work_history"
                                            Tone="ButtonTone.Default"
                                            Size="ButtonSize.Small"
                                            Click="@(() => ApplyCronPresetToEditor(editScheduleEditor, SchedulerCronPreset.WeekdaysAtNine))" />
                                    <Button Text="Daily 9 AM"
                                            Icon="today"
                                            Tone="ButtonTone.Default"
                                            Size="ButtonSize.Small"
                                            Click="@(() => ApplyCronPresetToEditor(editScheduleEditor, SchedulerCronPreset.DailyAtNine))" />
                                </Cluster>

                                <Grid Gap="LayoutGap.Medium" ColumnsMd="2">
                                    <label class="block">
                                        <span class="cda-eyebrow">Time zone</span>
                                        <InputText @bind-Value="editScheduleEditor.TimeZoneId"
                                                   class="ui-input mt-1"
                                                   data-testid="scheduler-edit-timezone" />
                                    </label>

                                    <label class="block">
                                        <span class="cda-eyebrow">Misfire policy</span>
                                        <InputSelect @bind-Value="editScheduleEditor.MisfirePolicy"
                                                     class="ui-input mt-1"
                                                     data-testid="scheduler-edit-misfire">
                                            @foreach (var policy in Enum.GetValues<SchedulerPlanMisfirePolicy>())
                                            {
                                                <option value="@policy">@policy</option>
                                            }
                                        </InputSelect>
                                    </label>
                                </Grid>

                                <label class="block">
                                    <span class="cda-eyebrow">Advanced input JSON</span>
                                    <TextArea @bind-Value="editScheduleEditor.InputJson"
                                                   Class="mt-1 font-mono"
                                                   data-testid="scheduler-edit-input-json" />
                                </label>

                                <label class="flex items-center gap-2 text-sm text-slate-700">
                                    <InputCheckbox @bind-Value="editScheduleEditor.IsEnabled" />
                                    Enabled after save
                                </label>
                            </Stack>

                            <aside class="scheduler-edit-context" data-testid="scheduler-edit-context">
                                <Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch">
                                    <div class="scheduler-edit-context__target">
                                        <div class="min-w-0">
                                            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Target" />
                                            <h3>@EditScheduleTargetName</h3>
                                            <p>@EditScheduleTargetDescription</p>
                                        </div>
                                        <Button Text="Change"
                                                Icon="switch_account"
                                                Tone="ButtonTone.Default"
                                                Size="ButtonSize.Small"
                                                Disabled="@isBusy"
                                                Click="OpenEditTargetPicker"
                                                class="scheduler-edit-context__target-action"
                                                data-testid="scheduler-edit-target-open" />
                                    </div>

                                    <div class="scheduler-edit-context__stats">
                                        <div>
                                            <span>State</span>
                                            <StatusBadge Tone="@(editScheduleEditor.IsEnabled ? "success" : "neutral")" Text="@(editScheduleEditor.IsEnabled ? "Enabled" : "Paused")" />
                                        </div>
                                        <div>
                                            <span>Next fire</span>
                                            <strong>@FormatNextFire(selectedPlanForEdit?.NextPlannedFireAtUtc)</strong>
                                        </div>
                                        <div>
                                            <span>Last fired</span>
                                            <strong>@FormatLastFire(selectedPlanForEdit?.LastFiredAtUtc)</strong>
                                        </div>
                                        <div>
                                            <span>Updated</span>
                                            <strong>@FormatUpdatedAt(selectedPlanForEdit?.UpdatedAtUtc)</strong>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(selectedPlanForEdit?.LastError))
                                    {
                                        <p class="scheduler-edit-context__error">@selectedPlanForEdit.LastError</p>
                                    }
                                </Stack>
                            </aside>
                        </Grid>
                    </ChildContent>
                    <Footer>
                        <div class="scheduler-dialog-footer">
                            <div class="scheduler-dialog-footer__start">
                                <Button Text="Delete"
                                        Icon="delete"
                                        Tone="ButtonTone.Danger"
                                        Disabled="@isBusy"
                                        Click="@(() => OpenDeleteScheduleDialog(selectedPlanForEdit))"
                                        data-testid="scheduler-edit-delete" />
                            </div>
                            <div class="scheduler-dialog-footer__actions">
                                <Button Text="Cancel"
                                        Tone="ButtonTone.Default"
                                        Disabled="@isBusy"
                                        Click="CloseEditScheduleDialogAsync"
                                        data-testid="scheduler-edit-cancel" />
                                <Button Text="Save changes"
                                        Icon="save"
                                        Disabled="@isBusy"
                                        IsBusy="@isBusy"
                                        Click="SaveEditScheduleAsync"
                                        data-testid="scheduler-edit-save" />
                            </div>
                        </div>
                    </Footer>
                </Dialog>
            }

            @if (isDeleteScheduleDialogOpen && selectedPlanForDelete is not null)
            {
                <Dialog IsOpen="true"
                        Eyebrow="Danger action"
                        Title="Remove schedule"
                        Subtitle="This will remove the schedule and its future triggers."
                        Size="ModalSize.Compact"
                        DenseChrome="true"
                        TestId="scheduler-delete-dialog"
                        OnClose="CloseDeleteScheduleDialogAsync">
                    <ChildContent>
                        <Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch">
                            <div class="scheduler-delete-summary">
                                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Schedule" />
                                <h3>@selectedPlanForDelete.Name</h3>
                                <p>@selectedPlanForDelete.TargetKind / @selectedPlanForDelete.TargetName</p>
                                <p>@selectedPlanForDelete.CronDescription</p>
                            </div>
                        </Stack>
                    </ChildContent>
                    <Footer>
                        <div class="scheduler-dialog-footer">
                            <p class="text-sm leading-6 text-rose-700">Existing run history is not edited by this action.</p>
                            <div class="scheduler-dialog-footer__actions">
                                <Button Text="Cancel"
                                        Tone="ButtonTone.Default"
                                        Disabled="@isBusy"
                                        Click="CloseDeleteScheduleDialogAsync"
                                        data-testid="scheduler-delete-cancel" />
                                <Button Text="Remove"
                                        Icon="delete"
                                        Tone="ButtonTone.Danger"
                                        Disabled="@isBusy"
                                        IsBusy="@isBusy"
                                        Click="ConfirmDeleteScheduleAsync"
                                        data-testid="scheduler-delete-confirm" />
                            </div>
                        </div>
                    </Footer>
                </Dialog>
            }
        }
    </ChildContent>
</PageScaffold>

@code {
    private const int CalendarTabIndex = 0;
    private const int SchedulesTabIndex = 1;
    private const int NewScheduleTabIndex = 2;
    private const string PlannedCalendarEventPrefix = "planned-";
    private const string SchedulerCalendarInteropModulePath =
        "./_content/CanDoItAll.Modules.SchedulerPlanner/js/schedulerPlannerCalendarInterop.js";

    private SchedulerPlannerWorkspace? workspace;
    private SchedulerPlanEditorModel editor = new();
    private SchedulerPlanEditorModel? editScheduleEditor;
    private SchedulerHistoryQuery historyQuery = new();
    private long uiOperationGeneration;
    private long completedUiOperationGeneration;
    private long editSelectionLoadGeneration;
    private long completedEditSelectionLoadGeneration;
    private CancellationTokenSource? editSelectionLoadCancellation;
    private long workflowInputLoadGeneration;
    private long completedWorkflowInputLoadGeneration;
    private CancellationTokenSource? workflowInputLoadCancellation;
    private long workflowInputOptionsLoadGeneration;
    private long completedWorkflowInputOptionsLoadGeneration;
    private CancellationTokenSource? workflowInputOptionsLoadCancellation;
    private string errorMessage = string.Empty;
    private int activeTabIndex;
    private bool isTargetPickerOpen;
    private bool isEditScheduleDialogOpen;
    private bool isDeleteScheduleDialogOpen;
    private SchedulerPlanSummary? selectedPlanForEdit;
    private SchedulerPlanSummary? selectedPlanForDelete;
    private CanvasCalendarEvent? selectedCalendarEvent;
    private ElementReference schedulerCalendarElement;
    private IJSObjectReference? schedulerCalendarInterop;
    private DotNetObjectReference<SchedulerPlannerPage>? schedulerCalendarReference;
    private bool schedulerCalendarDoubleClickAttached;
    private DateTimeOffset? lastCalendarEventSelectionAtUtc;
    private string? lastCalendarSelectionKey;
    private DateTimeOffset? pendingCalendarDoubleClickAtUtc;
    private string targetSearchText = string.Empty;
    private string scheduleSearchText = string.Empty;
    private IReadOnlyList<string> targetTagFilters = [];
    private bool showProcessTargets = true;
    private bool showWorkflowTargets = true;
    private TargetPickerMode targetPickerMode = TargetPickerMode.NewSchedule;
    private SchedulerPlanTargetKind? scheduleTargetKindFilter;
    private ScheduleStateFilter scheduleStateFilter = ScheduleStateFilter.All;
    private SchedulerWorkflowInputSchema? workflowInputSchema;
    private AgentDefinition? schedulerAgent;
    private bool isOpeningSchedulerAgent;
    private Dictionary<string, string> workflowInputValues = new(StringComparer.Ordinal);
    private Dictionary<string, IReadOnlyList<WorkflowInputParameterOption>> workflowInputOptionsByKey = new(StringComparer.Ordinal);
    private IReadOnlyList<SchedulerWorkflowInputValidationIssue> workflowInputIssues = [];

    private static readonly JsonSerializerOptions WorkflowInputJsonOptions = new(JsonSerializerDefaults.Web)
    {
        WriteIndented = true
    };

    private enum SchedulerCronPreset
    {
        EveryTwoHours,
        WeekdaysAtNine,
        DailyAtNine
    }

    private enum ScheduleStateFilter
    {
        All,
        Enabled,
        Paused
    }

    private enum TargetPickerMode
    {
        NewSchedule,
        EditSchedule
    }

    private readonly record struct PendingLoad(
        long Generation,
        CancellationTokenSource Cancellation);

    private IReadOnlyList<SchedulerPlanSummary> Plans => workspace?.Plans ?? [];

    private string SchedulerAgentDisplayName
        => schedulerAgent?.Name ?? SchedulerAgentIdentity.DefaultDisplayName;

    private string SchedulerAgentAvatarImageUrl
        => schedulerAgent?.AvatarImageUrl ?? SchedulerAgentIdentity.DefaultAvatarImageUrl;

    private bool isBusy
        => Volatile.Read(ref uiOperationGeneration) != Volatile.Read(ref completedUiOperationGeneration);

    private bool IsCurrentContextLoading
        => isBusy ||
           Volatile.Read(ref editSelectionLoadGeneration) != Volatile.Read(ref completedEditSelectionLoadGeneration) ||
           Volatile.Read(ref workflowInputLoadGeneration) != Volatile.Read(ref completedWorkflowInputLoadGeneration) ||
           Volatile.Read(ref workflowInputOptionsLoadGeneration) != Volatile.Read(ref completedWorkflowInputOptionsLoadGeneration);

    private AgentChatContextSurface AgentChatSurface => SchedulerAgentChatContextBuilder.Build(
        activeTabIndex switch
        {
            CalendarTabIndex => SchedulerAgentChatView.Calendar,
            SchedulesTabIndex => SchedulerAgentChatView.Schedules,
            NewScheduleTabIndex => SchedulerAgentChatView.NewSchedule,
            _ => SchedulerAgentChatView.Calendar
        },
        ResolveAgentChatSelectedPlan(),
        ResolveAgentChatSelectedTarget(),
        ResolveAgentChatOverlay());

    private AgentChatContextAccessState AgentChatAccessState
        => workspace is null
            ? IsCurrentContextLoading || string.IsNullOrWhiteSpace(errorMessage)
                ? AgentChatContextAccessState.Loading
                : AgentChatContextAccessState.Failed
            : IsCurrentContextLoading
                ? AgentChatContextAccessState.Loading
                : AgentChatContextAccessState.Ready;

    private IReadOnlyList<SchedulerPlanRunSummary> History => workspace?.History ?? [];

    private IReadOnlyList<SchedulerTargetOption> TargetOptions => workspace?.TargetOptions ?? [];

    private int CalendarEventCount => workspace?.CalendarSurface.Events.Count ?? 0;

    private SchedulerTargetOption? SelectedTarget => ResolveSelectedTarget(editor);

    private SchedulerPlanSummary? ResolveAgentChatSelectedPlan()
    {
        if (isDeleteScheduleDialogOpen && selectedPlanForDelete is not null)
        {
            return selectedPlanForDelete;
        }

        if (isEditScheduleDialogOpen && selectedPlanForEdit is not null)
        {
            return selectedPlanForEdit;
        }

        if (activeTabIndex != CalendarTabIndex ||
            !TryResolvePlanId(selectedCalendarEvent, out var planId))
        {
            return null;
        }

        return Plans.FirstOrDefault(plan => plan.Id == planId);
    }

    private SchedulerTargetOption? ResolveAgentChatSelectedTarget()
    {
        if (isTargetPickerOpen && TargetPickerEditor is not null)
        {
            return ResolveSelectedTarget(TargetPickerEditor);
        }

        return activeTabIndex == NewScheduleTabIndex ? SelectedTarget : null;
    }

    private string? ResolveAgentChatOverlay()
    {
        if (isDeleteScheduleDialogOpen)
        {
            return "delete-schedule";
        }

        if (isEditScheduleDialogOpen)
        {
            return "edit-schedule";
        }

        return isTargetPickerOpen ? "target-picker" : null;
    }

    private string SelectedTargetName => SelectedTarget?.Name ?? "No target selected";

    private string SelectedTargetDescription => SelectedTarget?.Description ?? "Select a workflow or process target before saving the schedule.";

    private IReadOnlyList<SchedulerPlanSummary> FilteredPlans
        => Plans
            .Where(MatchesScheduleSearch)
            .Where(MatchesScheduleTargetKind)
            .Where(MatchesScheduleState)
            .OrderByDescending(item => item.IsEnabled)
            .ThenBy(item => item.NextPlannedFireAtUtc ?? DateTimeOffset.MaxValue)
            .ThenBy(item => item.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private bool HasScheduleFilters
        => !string.IsNullOrWhiteSpace(scheduleSearchText) ||
           scheduleTargetKindFilter.HasValue ||
           scheduleStateFilter != ScheduleStateFilter.All;

    private string ScheduleFilterResultText => $"{FilteredPlans.Count} of {Plans.Count} schedule(s)";

    private SchedulerPlanEditorModel? TargetPickerEditor
        => targetPickerMode == TargetPickerMode.EditSchedule ? editScheduleEditor : editor;

    private SchedulerTargetOption? EditScheduleTarget => editScheduleEditor is null ? null : ResolveSelectedTarget(editScheduleEditor);

    private string EditScheduleSubtitle => editScheduleEditor is null
        ? "Update scheduler details and future triggers."
        : $"{editScheduleEditor.TargetKind} / {EditScheduleTargetName}";

    private string EditScheduleTargetName => EditScheduleTarget?.Name ?? selectedPlanForEdit?.TargetName ?? "Saved target";

    private string EditScheduleTargetDescription => EditScheduleTarget?.Description ?? "This schedule keeps the target saved with the plan.";

    private string TargetPickerDialogTitle => targetPickerMode == TargetPickerMode.EditSchedule
        ? "Change schedule target"
        : "Choose workflow or process";

    private string TargetPickerDialogSubtitle => targetPickerMode == TargetPickerMode.EditSchedule
        ? "Pick the workflow or process this saved schedule should run next."
        : "Select the run target for this scheduler CRON schedule.";

    private string CronPreviewTitle
    {
        get
        {
            try
            {
                return CronDescriptionService.Describe(editor.CronExpression, editor.TimeZoneId);
            }
            catch
            {
                return "CRON expression needs attention";
            }
        }
    }

    private string CronPreviewDescription => "The scheduler will trigger the saved plan using this expression and the selected misfire policy.";

    private IReadOnlyList<string> AvailableTargetTags
        => TargetOptions
            .SelectMany(BuildTargetTags)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(item => item, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private IReadOnlyList<SchedulerTargetOption> FilteredTargetOptions
        => TargetOptions
            .Where(MatchesTargetTypeFilter)
            .Where(MatchesTargetSearch)
            .Where(MatchesTargetTagFilters)
            .OrderBy(item => item.Kind)
            .ThenBy(item => item.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await ResolveSchedulerAgentAsync();
        await RefreshAsync();
        await RunUiOperationAsync(async () =>
        {
            editor = await SchedulerPlannerService.CreateDefaultEditorAsync();
            await LoadWorkflowInputEditorAsync();
        });
    }

    private async Task ResolveSchedulerAgentAsync()
    {
        try
        {
            var agents = await AgentWorkspaceService.ListAgentsAsync(includeTemplates: false);
            schedulerAgent = agents.SingleOrDefault(SchedulerAgentIdentity.Matches);
            if (schedulerAgent is null)
            {
                Notifications.Warning(
                    "Scheduler Agent unavailable",
                    $"The managed agent '{SchedulerAgentIdentity.AgentId:D}' is not available.");
            }
        }
        catch (Exception exception)
        {
            schedulerAgent = null;
            Notifications.Warning("Scheduler Agent unavailable", exception.Message);
        }
    }

    private async Task OpenSchedulerAgentAsync()
    {
        if (schedulerAgent is null ||
            !SchedulerAgentIdentity.Matches(schedulerAgent) ||
            isOpeningSchedulerAgent ||
            isBusy ||
            AgentChatAccessState != AgentChatContextAccessState.Ready)
        {
            return;
        }

        isOpeningSchedulerAgent = true;
        try
        {
            await AgentChatLauncher.StartNewChatAsync(schedulerAgent.Id);
            Notifications.Success("Scheduler Agent ready", "Opened a new workflow scheduling chat.");
        }
        catch (Exception exception)
        {
            Notifications.Error("Unable to open Scheduler Agent", exception.Message);
        }
        finally
        {
            isOpeningSchedulerAgent = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (workspace is null)
        {
            return;
        }

        schedulerCalendarReference ??= DotNetObjectReference.Create(this);
        schedulerCalendarInterop ??= await JsRuntime.InvokeAsync<IJSObjectReference>(
            "import",
            SchedulerCalendarInteropModulePath);

        if (schedulerCalendarInterop is null)
        {
            return;
        }

        await schedulerCalendarInterop.InvokeVoidAsync(
            "attachCalendarDoubleClick",
            schedulerCalendarElement,
            schedulerCalendarReference);
        schedulerCalendarDoubleClickAttached = true;
    }

    private async Task RefreshAsync()
    {
        await RunUiOperationAsync(async () =>
        {
            workspace = await SchedulerPlannerService.GetWorkspaceAsync(historyQuery);
        });
    }

    private async Task SaveScheduleAsync()
    {
        await RunUiOperationAsync(async () =>
        {
            SynchronizeWorkflowInputJson();
            if (!await ValidateWorkflowInputEditorAsync())
            {
                return;
            }

            await SchedulerPlannerService.SavePlanAsync(editor);
            workspace = await SchedulerPlannerService.GetWorkspaceAsync(historyQuery);
            editor = await SchedulerPlannerService.CreateDefaultEditorAsync();
            await LoadWorkflowInputEditorAsync();
            activeTabIndex = SchedulesTabIndex;
        });
    }

    private async Task ResetEditorAsync()
    {
        editor = await SchedulerPlannerService.CreateDefaultEditorAsync();
        await LoadWorkflowInputEditorAsync();
        isTargetPickerOpen = false;
    }

    private async Task TogglePlanAsync(SchedulerPlanSummary plan)
    {
        await RunUiOperationAsync(async () =>
        {
            await SchedulerPlannerService.SetPlanEnabledAsync(plan.Id, !plan.IsEnabled);
            workspace = await SchedulerPlannerService.GetWorkspaceAsync(historyQuery);
            selectedPlanForEdit = selectedPlanForEdit?.Id == plan.Id
                ? Plans.FirstOrDefault(item => item.Id == plan.Id)
                : selectedPlanForEdit;
        });
    }

    private async Task OpenEditScheduleDialogAsync(SchedulerPlanSummary plan)
    {
        var load = BeginEditSelectionLoad();
        selectedPlanForEdit = plan;
        editScheduleEditor = null;
        isEditScheduleDialogOpen = false;
        activeTabIndex = SchedulesTabIndex;

        try
        {
            await RunUiOperationAsync(
                async () =>
                {
                    var loadedEditor = await SchedulerPlannerService.GetPlanEditorAsync(
                        plan.Id,
                        load.Cancellation.Token);
                    if (!IsCurrentEditSelectionLoad(load, plan.Id))
                    {
                        return;
                    }

                    editScheduleEditor = loadedEditor;
                    isEditScheduleDialogOpen = true;
                },
                () => IsCurrentEditSelectionLoad(load, plan.Id),
                load.Cancellation.Token);
        }
        finally
        {
            CompleteEditSelectionLoad(load);
        }
    }

    private Task CloseEditScheduleDialogAsync()
    {
        InvalidateEditSelectionLoad();
        isEditScheduleDialogOpen = false;
        editScheduleEditor = null;
        selectedPlanForEdit = null;
        return Task.CompletedTask;
    }

    private async Task SaveEditScheduleAsync()
    {
        if (editScheduleEditor is null)
        {
            return;
        }

        await RunUiOperationAsync(async () =>
        {
            await SchedulerPlannerService.SavePlanAsync(editScheduleEditor);
            workspace = await SchedulerPlannerService.GetWorkspaceAsync(historyQuery);
            selectedPlanForEdit = editScheduleEditor.Id.HasValue
                ? Plans.FirstOrDefault(item => item.Id == editScheduleEditor.Id.Value)
                : null;
            isEditScheduleDialogOpen = false;
            editScheduleEditor = null;
            selectedPlanForEdit = null;
            activeTabIndex = SchedulesTabIndex;
        });
    }

    private void OpenDeleteScheduleDialog(SchedulerPlanSummary? plan)
    {
        if (plan is null)
        {
            return;
        }

        selectedPlanForDelete = plan;
        isDeleteScheduleDialogOpen = true;
    }

    private Task CloseDeleteScheduleDialogAsync()
    {
        isDeleteScheduleDialogOpen = false;
        selectedPlanForDelete = null;
        return Task.CompletedTask;
    }

    private async Task ConfirmDeleteScheduleAsync()
    {
        if (selectedPlanForDelete is null)
        {
            return;
        }

        var deletedPlanId = selectedPlanForDelete.Id;
        await RunUiOperationAsync(async () =>
        {
            await SchedulerPlannerService.DeletePlanAsync(deletedPlanId);
            workspace = await SchedulerPlannerService.GetWorkspaceAsync(historyQuery);
            if (selectedPlanForEdit?.Id == deletedPlanId)
            {
                isEditScheduleDialogOpen = false;
                editScheduleEditor = null;
                selectedPlanForEdit = null;
            }

            selectedCalendarEvent = null;
            lastCalendarEventSelectionAtUtc = null;
            lastCalendarSelectionKey = null;
            pendingCalendarDoubleClickAtUtc = null;
            isDeleteScheduleDialogOpen = false;
            selectedPlanForDelete = null;
            activeTabIndex = SchedulesTabIndex;
        });
    }

    private async Task HandleCalendarSelectionChangedAsync(CanvasCalendarSelectionChangedEventArgs args)
        => await TrackCalendarSelectedEventAsync(args.SelectedEvent, allowRepeatedSelectionOpen: true);

    private async Task HandleCalendarStateChangedAsync(CanvasCalendarStateChangedEventArgs args)
    {
        if (string.IsNullOrWhiteSpace(args.SelectedEventId))
        {
            return;
        }

        var calendarEvent = workspace?.CalendarSurface.Events.FirstOrDefault(item =>
            string.Equals(item.Id, args.SelectedEventId, StringComparison.Ordinal) ||
            string.Equals(item.EventId, args.SelectedEventId, StringComparison.Ordinal));

        if (calendarEvent is not null)
        {
            await TrackCalendarSelectedEventAsync(calendarEvent, allowRepeatedSelectionOpen: false);
        }
    }

    private async Task TrackCalendarSelectedEventAsync(
        CanvasCalendarEvent? calendarEvent,
        bool allowRepeatedSelectionOpen)
    {
        var now = DateTimeOffset.UtcNow;
        var selectionKey = ResolveCalendarSelectionKey(calendarEvent);
        var isRepeatedEventSelection = selectionKey is not null
            && string.Equals(selectionKey, lastCalendarSelectionKey, StringComparison.Ordinal)
            && lastCalendarEventSelectionAtUtc is DateTimeOffset selectedAt
            && now - selectedAt <= TimeSpan.FromMilliseconds(650);

        selectedCalendarEvent = calendarEvent;
        lastCalendarSelectionKey = selectionKey;
        lastCalendarEventSelectionAtUtc = selectedCalendarEvent is null ? null : now;

        if (selectedCalendarEvent is null || isEditScheduleDialogOpen)
        {
            return;
        }

        if (!IsCalendarDoubleClickPending(now) && !(allowRepeatedSelectionOpen && isRepeatedEventSelection))
        {
            return;
        }

        pendingCalendarDoubleClickAtUtc = null;
        await OpenCalendarEventEditDialogAsync(selectedCalendarEvent);
    }

    private async Task HandleCalendarDoubleClickAsync()
    {
        if (isEditScheduleDialogOpen)
        {
            return;
        }

        var now = DateTimeOffset.UtcNow;
        pendingCalendarDoubleClickAtUtc = now;

        if (!IsRecentCalendarEventSelection(now))
        {
            return;
        }

        pendingCalendarDoubleClickAtUtc = null;
        await OpenCalendarEventEditDialogAsync(selectedCalendarEvent);
    }

    [JSInvokable]
    public Task OnCalendarItemDoubleClickedAsync()
        => HandleCalendarDoubleClickAsync();

    private async Task<bool> OpenCalendarEventEditDialogAsync(CanvasCalendarEvent? calendarEvent)
    {
        if (!TryResolvePlanId(calendarEvent, out var planId))
        {
            return false;
        }

        var plan = Plans.FirstOrDefault(item => item.Id == planId);
        if (plan is null)
        {
            return false;
        }

        await OpenEditScheduleDialogAsync(plan);
        activeTabIndex = CalendarTabIndex;
        return true;
    }

    private bool IsCalendarDoubleClickPending(DateTimeOffset now)
    {
        return pendingCalendarDoubleClickAtUtc is DateTimeOffset requestedAt
            && now - requestedAt <= TimeSpan.FromSeconds(2);
    }

    private bool IsRecentCalendarEventSelection(DateTimeOffset now)
    {
        return selectedCalendarEvent is not null
            && lastCalendarEventSelectionAtUtc is DateTimeOffset selectedAt
            && now - selectedAt <= TimeSpan.FromMilliseconds(750);
    }

    private static string? ResolveCalendarSelectionKey(CanvasCalendarEvent? calendarEvent)
    {
        if (calendarEvent is null)
        {
            return null;
        }

        if (TryResolvePlanId(calendarEvent, out var planId))
        {
            return planId.ToString("D");
        }

        if (!string.IsNullOrWhiteSpace(calendarEvent.Id))
        {
            return calendarEvent.Id;
        }

        return string.IsNullOrWhiteSpace(calendarEvent.EventId) ? null : calendarEvent.EventId;
    }


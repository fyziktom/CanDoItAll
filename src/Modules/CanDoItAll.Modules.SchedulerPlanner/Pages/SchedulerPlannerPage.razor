    private async Task SelectTargetAsync(SchedulerTargetOption target)
    {
        await RunUiOperationAsync(async () =>
        {
            var targetEditor = TargetPickerEditor;
            if (targetEditor is null)
            {
                isTargetPickerOpen = false;
                return;
            }

            var targetChanged = targetEditor.TargetKind != target.Kind ||
                                targetEditor.TargetId != target.Id ||
                                targetEditor.TargetVersionId != target.VersionId;

            targetEditor.TargetKind = target.Kind;
            targetEditor.TargetId = target.Id;
            targetEditor.TargetVersionId = target.VersionId;

            if (targetPickerMode == TargetPickerMode.NewSchedule)
            {
                if (string.IsNullOrWhiteSpace(editor.Name))
                {
                    editor.Name = $"{target.Name} schedule";
                }

                isTargetPickerOpen = false;
                await LoadWorkflowInputEditorAsync();
                return;
            }

            if (targetChanged)
            {
                targetEditor.InputJson = "{}";
            }

            isTargetPickerOpen = false;
        });

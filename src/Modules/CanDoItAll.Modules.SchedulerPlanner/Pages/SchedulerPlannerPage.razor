    private static bool TryResolvePlanId(
        CanvasCalendarEvent? calendarEvent,
        out Guid planId)
    {
        planId = Guid.Empty;
        if (calendarEvent is null)
        {
            return false;
        }

        if (Guid.TryParse(calendarEvent.RepositoryId, out planId))
        {
            return true;
        }

        return TryResolvePlanIdFromCalendarEventId(calendarEvent.Id, out planId) ||
               TryResolvePlanIdFromCalendarEventId(calendarEvent.EventId, out planId);
    }

    private static bool TryResolvePlanIdFromCalendarEventId(
        string? eventId,
        out Guid planId)
    {
        planId = Guid.Empty;
        if (string.IsNullOrWhiteSpace(eventId) ||
            !eventId.StartsWith(PlannedCalendarEventPrefix, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var remaining = eventId[PlannedCalendarEventPrefix.Length..];
        var separatorIndex = remaining.IndexOf('-', StringComparison.Ordinal);
        if (separatorIndex <= 0)
        {
            return false;
        }

        return Guid.TryParseExact(remaining[..separatorIndex], "N", out planId);
    }


        return plan.Name.Contains(query, StringComparison.OrdinalIgnoreCase) ||
               plan.Description.Contains(query, StringComparison.OrdinalIgnoreCase) ||
               plan.TargetName.Contains(query, StringComparison.OrdinalIgnoreCase) ||
               plan.CronExpression.Contains(query, StringComparison.OrdinalIgnoreCase) ||
               plan.CronDescription.Contains(query, StringComparison.OrdinalIgnoreCase) ||
               plan.TimeZoneId.Contains(query, StringComparison.OrdinalIgnoreCase);

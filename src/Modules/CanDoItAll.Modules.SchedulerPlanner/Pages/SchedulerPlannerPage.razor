    private async Task LoadWorkflowInputEditorAsync()
    {
        var load = BeginWorkflowInputLoad();
        InvalidateWorkflowInputOptionsLoad();
        var targetKind = editor.TargetKind;
        var targetId = editor.TargetId;
        var targetVersionId = SelectedTarget?.VersionId ?? editor.TargetVersionId;

        try
        {
            workflowInputSchema = null;
            workflowInputValues = new Dictionary<string, string>(StringComparer.Ordinal);
            workflowInputOptionsByKey = new Dictionary<string, IReadOnlyList<WorkflowInputParameterOption>>(StringComparer.Ordinal);
            workflowInputIssues = [];

            if (targetKind != SchedulerPlanTargetKind.Workflow || targetId == Guid.Empty)
            {
                return;
            }

            var loadedSchema = await WorkflowInputSchemaService.ResolveSchemaAsync(
                new WorkflowId(targetId),
                targetVersionId.HasValue ? new WorkflowVersionId(targetVersionId.Value) : null,
                load.Cancellation.Token);
            if (!IsCurrentWorkflowInputLoad(load, targetKind, targetId, targetVersionId))
            {
                return;
            }

            workflowInputSchema = loadedSchema;
            if (loadedSchema.Parameters.Count == 0)
            {
                return;
            }

            InitializeWorkflowInputValuesFromJson();
            SynchronizeWorkflowInputJson();
            await LoadWorkflowInputOptionsAsync();
        }
        catch (OperationCanceledException) when (load.Cancellation.IsCancellationRequested)
        {
        }
        finally
        {
            CompleteWorkflowInputLoad(load);
        }
    }

    private async Task LoadWorkflowInputOptionsAsync()
    {
        var schema = workflowInputSchema;
        if (schema is null)
        {
            InvalidateWorkflowInputOptionsLoad();
            workflowInputOptionsByKey = new Dictionary<string, IReadOnlyList<WorkflowInputParameterOption>>(StringComparer.Ordinal);
            return;
        }

        var load = BeginWorkflowInputOptionsLoad();
        var targetId = editor.TargetId;
        var targetVersionId = editor.TargetVersionId;
        var values = new Dictionary<string, string>(workflowInputValues, StringComparer.Ordinal);

        try
        {
            var resolved = new Dictionary<string, IReadOnlyList<WorkflowInputParameterOption>>(StringComparer.Ordinal);
            foreach (var parameter in schema.Parameters)
            {
                resolved[parameter.Key] = await WorkflowInputOptionService.ListOptionsAsync(
                    parameter,
                    values,
                    load.Cancellation.Token);
            }

            if (!IsCurrentWorkflowInputOptionsLoad(load, schema, targetId, targetVersionId, values))
            {
                return;
            }

            workflowInputOptionsByKey = resolved;
        }
        catch (OperationCanceledException) when (load.Cancellation.IsCancellationRequested)
        {
        }
        finally
        {
            CompleteWorkflowInputOptionsLoad(load);
        }
    }

    private void InitializeWorkflowInputValuesFromJson()
    {
        if (workflowInputSchema is null)
        {
            return;
        }

        JsonObject root;
        try
        {
            root = ParseWorkflowInputJsonObject();
        }
        catch (JsonException exception)
        {
            workflowInputIssues = [new SchedulerWorkflowInputValidationIssue(string.Empty, $"Workflow input JSON is invalid: {exception.Message}")];
            return;
        }

        var values = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var parameter in workflowInputSchema.Parameters)
        {
            if (TryResolveRootPropertyName(parameter, out var propertyName) &&
                root.TryGetPropertyValue(propertyName, out var value) &&
                value is not null &&
                TryFormatWorkflowInputValue(value, out var text))
            {
                values[parameter.Key] = text;
                continue;
            }

            if (!string.IsNullOrWhiteSpace(parameter.DefaultValue))
            {
                values[parameter.Key] = parameter.DefaultValue.Trim();
            }
        }

        workflowInputValues = values;
    }

    private async Task HandleWorkflowInputValueChangedAsync(
        WorkflowInputParameterDescriptor parameter,
        string value)
    {
        var normalizedValue = value.Trim();
        if (string.IsNullOrWhiteSpace(normalizedValue))
        {
            workflowInputValues.Remove(parameter.Key);
        }
        else
        {
            workflowInputValues[parameter.Key] = normalizedValue;
        }

        RemoveWorkflowInputIssues(parameter.Key);
        ClearDependentWorkflowInputValues(parameter.Key);
        SynchronizeWorkflowInputJson();
        await LoadWorkflowInputOptionsAsync();
    }

    private async Task HandleRawInputJsonChangedAsync(string? value)
    {
        editor.InputJson = string.IsNullOrWhiteSpace(value) ? "{}" : value;
        InitializeWorkflowInputValuesFromJson();
        await LoadWorkflowInputOptionsAsync();
    }

    private async Task<bool> ValidateWorkflowInputEditorAsync()
    {
        if (workflowInputSchema is null || workflowInputSchema.Parameters.Count == 0 || editor.TargetKind != SchedulerPlanTargetKind.Workflow)
        {
            return true;
        }

        var selectedTarget = SelectedTarget;
        var versionId = selectedTarget?.VersionId ?? editor.TargetVersionId;
        var validation = await WorkflowInputSchemaService.ValidateInputAsync(
            new WorkflowId(editor.TargetId),
            versionId.HasValue ? new WorkflowVersionId(versionId.Value) : null,
            editor.InputJson);
        workflowInputIssues = validation.Issues;
        if (!validation.Succeeded)
        {
            errorMessage = "Workflow input needs attention before the schedule can be saved.";
            return false;
        }

        editor.InputJson = validation.NormalizedInputJson;
        InitializeWorkflowInputValuesFromJson();
        return true;
    }

    private void SynchronizeWorkflowInputJson()
    {
        if (workflowInputSchema is null || workflowInputSchema.Parameters.Count == 0)
        {
            return;
        }

        var root = ParseWorkflowInputJsonObjectOrNew();
        foreach (var parameter in workflowInputSchema.Parameters)
        {
            if (!TryResolveRootPropertyName(parameter, out var propertyName))
            {
                continue;
            }

            var value = GetWorkflowInputValue(parameter.Key);
            if (string.IsNullOrWhiteSpace(value) && !string.IsNullOrWhiteSpace(parameter.DefaultValue))
            {
                value = parameter.DefaultValue.Trim();
                workflowInputValues[parameter.Key] = value;
            }

            if (string.IsNullOrWhiteSpace(value))
            {
                root.Remove(propertyName);
                continue;
            }

            root[propertyName] = CreateWorkflowInputJsonValue(parameter, value);
        }

        editor.InputJson = root.ToJsonString(WorkflowInputJsonOptions);
    }

    private JsonObject ParseWorkflowInputJsonObject()
    {
        var parsed = JsonNode.Parse(string.IsNullOrWhiteSpace(editor.InputJson) ? "{}" : editor.InputJson.Trim());
        return parsed as JsonObject
               ?? throw new JsonException("Workflow input must be a JSON object.");
    }

    private JsonObject ParseWorkflowInputJsonObjectOrNew()
    {
        try
        {
            return ParseWorkflowInputJsonObject();
        }
        catch (JsonException)
        {
            return new JsonObject();
        }
    }

    private static JsonNode? CreateWorkflowInputJsonValue(
        WorkflowInputParameterDescriptor parameter,
        string value)
    {
        if (parameter.Kind is WorkflowInputParameterKind.Integer or WorkflowInputParameterKind.DurationMinutes &&
            int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var integerValue))
        {
            return JsonValue.Create(integerValue);
        }

        return JsonValue.Create(value);
    }

    private void ClearDependentWorkflowInputValues(string parameterKey)
    {
        if (workflowInputSchema is null)
        {
            return;
        }

        foreach (var dependent in workflowInputSchema.Parameters
                     .Where(item => string.Equals(item.OptionSource.DependsOnParameterKey, parameterKey, StringComparison.Ordinal)))
        {
            workflowInputValues.Remove(dependent.Key);
            RemoveWorkflowInputIssues(dependent.Key);
        }
    }

    private void RemoveWorkflowInputIssues(string parameterKey)
    {
        workflowInputIssues = workflowInputIssues
            .Where(issue => !string.Equals(issue.ParameterKey, parameterKey, StringComparison.Ordinal))
            .ToArray();
    }

    private IReadOnlyList<WorkflowInputParameterOption> ResolveWorkflowInputOptions(WorkflowInputParameterDescriptor parameter)
        => workflowInputOptionsByKey.TryGetValue(parameter.Key, out var options) ? options : [];

    private string GetWorkflowInputValue(string parameterKey)
        => workflowInputValues.TryGetValue(parameterKey, out var value) ? value : string.Empty;

    private string ResolveWorkflowInputIssue(string parameterKey)
        => workflowInputIssues
            .FirstOrDefault(issue => string.Equals(issue.ParameterKey, parameterKey, StringComparison.Ordinal))
            ?.Message ?? string.Empty;


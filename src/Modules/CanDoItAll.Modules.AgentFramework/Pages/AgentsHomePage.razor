@page "/agents"
@using CanDoItAll.AgentFramework.UI.Shell

<PageTitle>Agents</PageTitle>

<AgentsShellSurface State="ShellPresentation" Intent="HandleShellIntentAsync">
        @if (route.Tab == AgentWorkspaceSection.Providers)
        {
            <AgentProviderProfilesPanel ProviderId="@route.ProviderId"
                                        Section="@route.ProviderSection"
                                        ConnectionsOpen="@route.IsSharedConnectionsOpen"
                                        HistoryLocation="@historyLocation"
                                        ProviderRequested="HandleProviderRequestedAsync"
                                        ProviderPublished="HandleProviderPublishedAsync"
                                        NewDraftRequested="HandleNewProviderDraftRequestedAsync"
                                        SectionRequested="HandleProviderSectionRequestedAsync"
                                        ConnectionsRequested="HandleConnectionsRequestedAsync"
                                        HistoryLocationChanged="HandleHistoryLocationChangedAsync" />
        }
        else if (route.Tab == AgentWorkspaceSection.RequestHistory) {
            <CanDoItAll.Modules.AgentFramework.Pages.Components.History.ProviderRequestHistoryPanel
                Scope="@(new CanDoItAll.AgentFramework.ProviderHistory.HistoryProviderScope.AllAuthorized())"
                Location="@historyLocation"
                LocationChanged="HandleHistoryLocationChangedAsync" />
        }
        else if (route.Tab == AgentWorkspaceSection.Voice)
        {
            <AgentVoiceSettingsPanel />
        }
        else if (route.Tab == AgentWorkspaceSection.FloatingChat)
        {
            <FloatingAgentChatSettingsPanel />
        }
        else if (route.Tab == AgentWorkspaceSection.Agents)
        {
            <AgentCatalogHost @key="catalogScopeVersion" RequestedAgentId="@route.OpenAgentId"
                               RequestedAgentSection="@route.AgentSection"
                               RequestedTeamId="@effectiveRequestedTeamId"
                               AgentOpenRequested="HandleAgentOpenRequestedAsync"
                               AgentSectionChanged="HandleAgentSectionChangedAsync"
                               AgentCloseRequested="HandleAgentCloseRequestedAsync"
                               TeamSelectionRequested="HandleTeamSelectionRequestedAsync"
                               SelectedAgentChanged="HandleCatalogAgentChangedAsync"
                               SelectedTeamChanged="HandleSelectedTeamChangedAsync"
                               ContextAccessStateChanged="HandleSelectionAccessStateChangedAsync"
                               SkipCatalogRepair="true" />
        }
        else if (route.Tab == AgentWorkspaceSection.SimpleChats)
        {
            <SimpleChatsWorkspace View="@simpleChatRouteState.View"
                                  DefinitionId="@simpleChatRouteState.DefinitionId"
                                  ConversationId="@simpleChatRouteState.ConversationId"
                                  RouteStateChanged="HandleSimpleChatRouteStateChangedAsync" />
        }
        else if (route.Tab == AgentWorkspaceSection.Chat)
        {
            <AgentChatPanel PreferredAgentId="@route.AgentId"
                            SelectedAgentChanged="HandlePanelAgentChangedAsync"
                            ContextAccessStateChanged="HandleSelectionAccessStateChangedAsync" />
        }
        else if (route.Tab == AgentWorkspaceSection.Capabilities)
        {
            <AgentCapabilitiesPanel PreferredAgentId="@route.AgentId"
                                    SelectedAgentChanged="HandlePanelAgentChangedAsync"
                                    ContextAccessStateChanged="HandleSelectionAccessStateChangedAsync" />
        }
        else if (route.Tab == AgentWorkspaceSection.Governance)
        {
            <AgentGovernancePanel PreferredAgentId="@route.AgentId"
                                  SelectedAgentChanged="HandlePanelAgentChangedAsync"
                                  ContextAccessStateChanged="HandleSelectionAccessStateChangedAsync" />
        }
        else if (route.Tab == AgentWorkspaceSection.Diagnostics)
        {
            <AgentDiagnosticsPanel />
        }
        else
        {
            <AgentsOverviewSurface State="@OverviewPresentation" Intent="HandleOverviewIntentAsync" />
        }
</AgentsShellSurface>

<AgentChatContextSurfaceProvider Surface="@AgentChatSurface"
                                 ContextNavigationIdentity="@AgentChatNavigationFence"
                                 ContextAccessState="@AgentChatAccessState" />

@using CanDoItAll.AgentFramework.WorkflowAuthoring.UI
@page "/agents/workflows"
@using CanDoItAll.Components.CanvasLib
@using CanDoItAll.AgentFramework.Workflows.UI
@using CanDoItAll.AgentFramework.UI.Chat
<PageTitle>Workflows</PageTitle>
<WorkflowShellSurface Presentation="@ShellPresentation" Catalog="@CatalogPresentation" History="@HistoryPresentation" Intent="HandleIntentAsync">
    <CuratorAction>
<AgentAvatarActionButton AgentName="@WorkflowCuratorDisplayName"
                                         AvatarImageUrl="@WorkflowCuratorAvatarImageUrl"
                                         FallbackText="WC"
                                         Label="@($"Open {WorkflowCuratorDisplayName}")"
                                         Click="OpenWorkflowCuratorAsync"
                                         Disabled="@(workflowCuratorAgent is null || isOpeningWorkflowCurator || isBusy || AgentChatAccessState != AgentChatContextAccessState.Ready)"
                                         TestId="workflows-curator-open"
                                         TooltipTestId="workflows-curator-tooltip" />
    </CuratorAction>
    <Dashboard>

                    <WorkflowOverviewPanel QueryService="OverviewQueryService"
                                           IsActive="@(activeWorkflowTabIndex == DashboardTabIndex)"
                                           RefreshVersion="analyticsRefreshVersion" />

    </Dashboard>
    <Editor>
        @{ var editorOwner = CaptureOwner(); }
<WorkflowCanvasEditor @key="EditorDefinitionKey"
                                              Definition="selectedDefinition"
                                              OwnerToken="editorCancellation.Token"
                                              NewDraftRequested="StartCanvasDraftAsync"
                                              Components="components"
                                              ProviderOptions="providerOptions"
                                              DefinitionSaved="@(definition => Owns(editorOwner) ? HandleCanvasDefinitionSavedAsync(definition) : Task.CompletedTask)"
                                              PreviewRunCompleted="@(run => Owns(editorOwner) ? HandleCanvasPreviewRunCompletedAsync(run) : Task.CompletedTask)"
                                              ComponentLibraryChanged="@(() => Owns(editorOwner) ? RefreshComponentLibraryAsync() : Task.CompletedTask)"
                                              SelectedNodeChanged="@(node => Owns(editorOwner) ? HandleCanvasSelectedNodeChangedAsync(node) : Task.CompletedTask)" />
    </Editor>
    <Analytics>

                    <WorkflowAnalyticsPanel QueryService="AnalyticsQueryService"
                                            Workflows="definitions"
                                            IsActive="@(activeWorkflowTabIndex == AnalyticsTabIndex)"
                                            RefreshVersion="analyticsRefreshVersion" />

    </Analytics>
    <Overlays>
@if (isTemplateCatalogueDialogOpen) {
    <WorkflowTemplateCatalogDialog Presentation="TemplatePresentation" Intent="HandleIntentAsync" Closed="CloseTemplateCatalogueDialog" />
}

            @if (isTemplatePreviewDialogOpen && templatePreviewTemplate is { } currentTemplate && templatePreviewDefinition is { } definition) {
                <WorkflowTemplatePreviewDialog @key="definition" Template="@(new(currentTemplate.Name, currentTemplate.Description))" Definition="definition"
                    Component="templatePreviewComponent" Executors="ExecutorCatalog.ListExecutors()"
                    Error="@templatePreviewErrorMessage" Busy="isBusy" Closed="CloseTemplatePreviewDialog"
                    AddDraft="AddSelectedTemplateToDraftsAsync" />
            }

            @if (isPreviewInputDialogOpen) {
                <WorkflowPreviewInputDialog State="previewInputState" Projects="previewProjectOptions"
                    Error="@previewInputErrorMessage" Busy="isRunningTest" Closed="ClosePreviewInputDialog"
                    Run="StartSelectedWorkflowPreviewFromDialogAsync" TestIdPrefix="workflows-preview" />
            }

            @if (runDetail is { } currentRunDetail) {
                <WorkflowRunDetailDialog Presentation="BuildRunDetailPresentation(currentRunDetail)" Closed="CloseRunDetailDialog" />
            }
            @if (eventDetail is { } currentEventDetail) {
                <WorkflowEventDetailDialog Presentation="BuildEventDetailPresentation(currentEventDetail)" Closed="CloseEventDetailDialog" />
            }
    </Overlays>
</WorkflowShellSurface>
<WorkflowAgentChatContextProvider Surface="@AgentChatSurface"
                                  ContextNavigationIdentity="@AgentChatNavigationFence"
                                  ContextAccessState="@AgentChatAccessState"
                                  RefreshRequested="HandleAgentChatExecutionCompletedAsync" />

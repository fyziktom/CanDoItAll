@using CanDoItAll.Editing
@inject AgentConfigurationChanges ConfigurationChanges
@inject WorkflowChanges WorkflowChanges
@using System.Collections.Immutable
@using CanDoItAll.AgentFramework.UI.Settings
@using Microsoft.JSInterop
@using Microsoft.Extensions.Logging
@inject IAgentVoiceService VoiceService
@inject CanDoItAll.Modules.AgentFramework.ProviderManagement.IProviderRuntimeAdministrationService ProviderRuntimeAdministrationService
@inject NotificationService NotificationService
@inject IJSRuntime JsRuntime
@inject ILogger<AgentVoiceSettingsSession> Logger
@implements IAsyncDisposable

<CanDoItAll.Editing.UI.DraftNavigationGuard EditorName="settings" MustRetain="session.MustRetain" IsBusy="session.Presentation.IsBusy" OutcomeUnknown="session.Presentation.Editor.OutcomeUnknown" />
<VoiceSettingsSurface Presentation="session.Presentation" Intent="HandleIntentAsync" DraftChanged="Refresh" />

@code {
    private const string PlayAudioFunction = "CanDoItAll.agentFramework.voice.playAudioForOwner";
    private const string DisposeAudioFunction = "CanDoItAll.agentFramework.voice.disposeOwner";
    private readonly string audioOwnerId = $"voice-settings-{Guid.NewGuid():N}";
    private bool playbackStarted;
    private AgentVoiceSettingsSession session = default!;
    private bool disposed;
    private AgentSettingsOpening opening = default!;
    protected override async Task OnInitializedAsync() {
        opening = new(ConfigurationChanges, WorkflowChanges, EditingOwner.AgentVoiceSettings, () => !disposed);
        session = new(VoiceService, ReadProvidersAsync, PlayAsync, Logger, opening);
        session.Changed += Refresh;
        if (RendererInfo.IsInteractive) {
            await OpenAsync();
        }
    }
    private async Task<ImmutableArray<VoiceSettingsProvider>> ReadProvidersAsync(CancellationToken cancellationToken) {
        var providers = await ProviderRuntimeAdministrationService.ListProvidersAsync(cancellationToken);
        return [.. providers.Where(IsOpenAiVoiceProvider)
            .OrderByDescending(provider => string.Equals(provider.Name, "OpenAI default", StringComparison.OrdinalIgnoreCase))
            .ThenBy(provider => provider.Name, StringComparer.OrdinalIgnoreCase)
            .Select(provider => new VoiceSettingsProvider(provider.Id, provider.Name, provider.DefaultModel))];
    }
    private async Task PlayAsync(AgentVoiceSynthesisResult result, CancellationToken cancellationToken) {
        if (disposed || cancellationToken.IsCancellationRequested) {
            return;
        }
        playbackStarted = true;
        await JsRuntime.InvokeVoidAsync(PlayAudioFunction, cancellationToken, audioOwnerId, Convert.ToBase64String(result.AudioBytes), result.ContentType);
    }
    private async Task OpenAsync() {
        try {
            await opening.StartAsync(() => InvokeAsync(session.Hint), () => InvokeAsync(session.Retire));
            await session.LoadAsync();
        } catch (Exception failure) when (failure is not OutOfMemoryException) {
            Logger.LogWarning("Settings editor could not open original access ({FailureType}).", failure.GetType().Name);
            session.Retire();
        }
    }
    private async Task HandleIntentAsync(VoiceSettingsIntent intent) {
        if (!session.IsCurrent(intent.Generation) || session.Presentation.IsBusy) {
            return;
        }
        await session.ExecuteAsync(intent);
        if (!session.IsCurrent(intent.Generation)) {
            return;
        }
        if (session.Presentation.Status == VoiceSettingsStatus.Saved) {
            NotificationService.Success("Voice settings saved", "AgentFramework voice settings were saved.");
        } else if (session.Presentation.Status is VoiceSettingsStatus.SavedSynthesisFailed or VoiceSettingsStatus.SavedPlaybackFailed) {
            NotificationService.Warning("Voice settings saved", session.Presentation.StatusText);
        } else if (session.Presentation.Status == VoiceSettingsStatus.Conflict) {
            NotificationService.Warning("Voice settings changed", session.Presentation.StatusText);
        } else if (session.Presentation.Status == VoiceSettingsStatus.SaveFailed) {
            NotificationService.Error("Voice settings", session.Presentation.StatusText);
        }
    }
    internal static string ResolveVoiceProviderIdText(Guid? currentProviderId, IReadOnlyList<ProviderProfile> candidates) {
        ArgumentNullException.ThrowIfNull(candidates);
        return currentProviderId is { } providerId
            ? candidates.Any(provider => provider.Id == providerId) ? providerId.ToString("D") : string.Empty
            : candidates.FirstOrDefault()?.Id.ToString("D") ?? string.Empty;
    }
    internal static bool IsOpenAiVoiceProvider(ProviderProfile provider) => provider.Kind == ProviderKind.OpenAi
        && provider.Purpose == ProviderProfilePurpose.Chat && provider.IsEnabled && ProviderAudioCapabilityPolicy.IsAvailable(provider);
    private void Refresh() {
        if (!disposed) {
            _ = InvokeAsync(StateHasChanged);
        }
    }
    public async ValueTask DisposeAsync() {
        if (disposed) {
            return;
        }
        disposed = true;
        if (session is not null) {
            session.Changed -= Refresh;
            session.Dispose();
        }
        if (opening is not null) {
            await opening.DisposeAsync();
        }
        if (playbackStarted) {
            try {
                await JsRuntime.InvokeVoidAsync(DisposeAudioFunction, audioOwnerId);
            } catch (JSDisconnectedException) {
            } catch (JSException exception) {
                Logger.LogWarning("Voice playback cleanup failed ({FailureType}) for owner {OwnerId}.", exception.GetType().Name, audioOwnerId);
            }
        }
    }
}

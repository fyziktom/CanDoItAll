@using CanDoItAll.AgentFramework.UI.Chat

<AgentFloatingCloseSurface State="state" Intent="DecideAsync" />

@code {
    [Parameter, EditorRequired] public ActiveAgentChat Chat { get; set; } = default!;
    [CascadingParameter] public DialogReference? DialogReference { get; set; }
    private AgentFloatingCloseState state = default!;

    protected override void OnParametersSet() {
        state = new(state?.HandleId == Chat.HandleId ? state.Origin : Guid.NewGuid(), Chat.HandleId,
            Chat.Agent.Name, Chat.CanStop, Chat.RunState == ActiveAgentChatRunState.AwaitingApproval);
    }

    private Task DecideAsync(AgentFloatingCloseIntent intent) {
        if (intent.Origin != state.Origin || intent.HandleId != Chat.HandleId
            || intent.Choice == AgentFloatingCloseChoice.Stop && !Chat.CanStop) {
            return Task.CompletedTask;
        }
        var decision = intent.Choice switch {
            AgentFloatingCloseChoice.Cancel => FloatingAgentChatCloseDecision.Cancel,
            AgentFloatingCloseChoice.KeepActive => FloatingAgentChatCloseDecision.KeepActive,
            AgentFloatingCloseChoice.Stop => FloatingAgentChatCloseDecision.Stop,
            _ => throw new ArgumentOutOfRangeException(nameof(intent))
        };
        return DialogReference?.CloseAsync(decision) ?? Task.CompletedTask;
    }
}

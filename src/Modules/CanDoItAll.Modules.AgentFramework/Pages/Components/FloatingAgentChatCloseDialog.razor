@inject DialogService DialogService

<Stack GapScale="LayoutGap.Medium"
       AlignItems="AlignItems.Stretch"
       data-testid="floating-agent-chat-close-dialog">
    <TextBlock TextStyle="TextStyle.Body1"
               Value="@BuildDescription()" />

    @if (!Chat.CanStop)
    {
        <Alert AlertStyle="AlertStyle.Warning">
            This chat is still working. Keep it active now; it can be stopped after the current model call completes.
        </Alert>
    }
    else if (Chat.RunState == ActiveAgentChatRunState.AwaitingApproval)
    {
        <Alert AlertStyle="AlertStyle.Warning">
            Stopping removes the quick-access handle, but does not reject the durable pending approval. Reopen the saved thread from history to decide it later.
        </Alert>
    }

    <Cluster Gap="LayoutGap.Small"
             Wrap="FlexWrap.Wrap"
             JustifyContent="JustifyContent.End">
        <Button Text="Cancel"
                Tone="ButtonTone.Default"
                Click="CancelAsync"
                data-testid="floating-agent-chat-cancel-close" />
        <Button Text="Keep active"
                Icon="schedule"
                Tone="ButtonTone.Default"
                Click="KeepActiveAsync"
                data-testid="floating-agent-chat-keep-active" />
        <Button Text="Stop chat"
                Icon="stop_circle"
                Tone="ButtonTone.Danger"
                Disabled="@(!Chat.CanStop)"
                Click="StopAsync"
                data-testid="floating-agent-chat-stop" />
    </Cluster>
</Stack>

@code {
    [Parameter, EditorRequired]
    public ActiveAgentChat Chat { get; set; } = default!;

    private string BuildDescription()
        => $"Keep {Chat.Agent.Name}'s chat ready for another action, or stop its active handle now. The saved conversation remains in chat history.";

    private Task CancelAsync()
        => DialogService.CloseAsync(FloatingAgentChatCloseDecision.Cancel);

    private Task KeepActiveAsync()
        => DialogService.CloseAsync(FloatingAgentChatCloseDecision.KeepActive);

    private Task StopAsync()
        => DialogService.CloseAsync(FloatingAgentChatCloseDecision.Stop);
}

@using CanDoItAll.AgentFramework.Models
@using CanDoItAll.Components.BaseLib

<div class="agent-team-members-dialog" data-testid="agents-team-members-dialog">
    <Stack GapScale="LayoutGap.Medium">
        <FilterBar ResultText="@($"{FilteredAgents.Count} of {Agents.Count} agent(s)")">
            <input @bind="searchText"
                   @bind:event="oninput"
                   class="cda-input min-w-[14rem] flex-1"
                   placeholder="Search agents"
                   data-testid="agents-team-members-search" />
            <StatusBadge Tone="info" Text="@($"{selectedAgentIds.Count} selected")" />
        </FilterBar>

        @if (FilteredAgents.Count == 0)
        {
            <EmptyState Eyebrow="No matches"
                        Title="No agents match the current filters"
                        Description="Clear the search filter to choose agents for this team." />
        }
        else
        {
            <Grid Gap="LayoutGap.Medium"
                  ColumnTemplate="repeat(auto-fit,minmax(13rem,1fr))"
                  Class="agent-team-members-dialog__grid">
                @foreach (var agent in FilteredAgents)
                {
                    <AgentSelectionCard Agent="@agent"
                                        IsSelected="@selectedAgentIds.Contains(agent.Id)"
                                        IsPrivateProvider="@PrivateAgentIds.Contains(agent.Id)"
                                        SelectedLabel="In team"
                                        Compact="true"
                                        CenterContent="true"
                                        ShowDetailsTooltip="true"
                                        ShowWorkload="false"
                                        ShowUpdatedAt="false"
                                        ShellTestId="agents-team-member-card-shell"
                                        SelectTestId="agents-team-member-card"
                                        OnSelect="@(() => ToggleAgent(agent.Id))" />
                }
            </Grid>
        }

        <Cluster Gap="LayoutGap.Small" JustifyContent="JustifyContent.End" Wrap="FlexWrap.Wrap">
            <Button Text="Cancel"
                    Icon="close"
                    Variant="Variant.Outlined"
                    Click="CancelAsync" />
            <Button Text="Save membership"
                    Icon="check"
                    Click="ConfirmAsync"
                    data-testid="agents-team-members-confirm" />
        </Cluster>
    </Stack>
</div>

@code {
    [Parameter, EditorRequired]
    public AgentTeamDefinition Team { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<AgentDefinition> Agents { get; set; } = [];

    [Parameter]
    public IReadOnlyCollection<Guid> PrivateAgentIds { get; set; } = [];

    [CascadingParameter]
    public DialogReference? DialogReference { get; set; }

    private readonly HashSet<Guid> selectedAgentIds = [];
    private bool hasInitializedSelection;
    private string searchText = string.Empty;

    private IReadOnlyList<AgentDefinition> FilteredAgents => Agents
        .Where(MatchesSearch)
        .OrderByDescending(item => selectedAgentIds.Contains(item.Id))
        .ThenBy(item => item.Name, StringComparer.OrdinalIgnoreCase)
        .ToList();

    protected override void OnParametersSet()
    {
        if (hasInitializedSelection)
        {
            return;
        }

        selectedAgentIds.Clear();
        foreach (var agentId in Team.AgentIds)
        {
            selectedAgentIds.Add(agentId);
        }

        hasInitializedSelection = true;
    }

    private void ToggleAgent(Guid agentId)
    {
        if (!selectedAgentIds.Add(agentId))
        {
            selectedAgentIds.Remove(agentId);
        }
    }

    private Task ConfirmAsync()
    {
        return DialogReference?.CloseAsync(new AgentTeamMembersDialogResult(
            Team.Id,
            selectedAgentIds
                .OrderBy(item => item)
                .ToList()))
            ?? Task.CompletedTask;
    }

    private Task CancelAsync()
        => DialogReference?.CloseAsync() ?? Task.CompletedTask;

    private bool MatchesSearch(AgentDefinition agent)
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return true;
        }

        var query = searchText.Trim();
        return agent.Name.Contains(query, StringComparison.OrdinalIgnoreCase) ||
               agent.RoleTitle.Contains(query, StringComparison.OrdinalIgnoreCase) ||
               agent.Summary.Contains(query, StringComparison.OrdinalIgnoreCase) ||
               agent.Model.Contains(query, StringComparison.OrdinalIgnoreCase) ||
               agent.Tags.Any(tag => tag.Contains(query, StringComparison.OrdinalIgnoreCase));
    }
}

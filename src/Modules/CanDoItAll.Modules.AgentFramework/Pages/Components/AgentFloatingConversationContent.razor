@using CanDoItAll.AgentFramework.UI.Chat
@using Microsoft.Extensions.Logging
@inject ILogger<AgentFloatingConversationContent> Logger
@using CanDoItAll.AgentFramework.Core
@using CanDoItAll.AgentFramework.Models
@implements IDisposable
@inject IAgentChatContextRegistry ContextRegistry
@inject IAgentConversationContextService ConversationContextService

<AgentConversationContextSurface State="Presentation" Intent="HandleContextIntent">
    @if (Chat.ChatSessionId is { } sessionId) {
        <AgentChatPanel PreferredAgentId="@Chat.Agent.AgentId"
                        PreferredAgent="@PreferredAgent"
                        PreferredSessionId="@sessionId"
                        ActiveChatHandleId="@Chat.HandleId"
                        PersistedActiveChatRunState="@Chat.RunState"
                        DisplayMode="AgentChatPanelDisplayMode.FocusedFloating" />
    } else {
        <LoadingState Title="Preparing chat"
                      Description="Reserving the agent and creating a durable conversation." />
    }
</AgentConversationContextSurface>

@code {
    [Parameter, EditorRequired]
    public ActiveAgentChat Chat { get; set; } = default!;

    [Parameter]
    public AgentDefinition? PreferredAgent { get; set; }

    private AgentChatContextSnapshot? currentContext;
    private Guid activation = Guid.NewGuid();
    private AgentConversationKey? observedKey;
    private bool disposed;

    private AgentConversationKey ConversationKey => Chat.ChatSessionId is { } sessionId
        ? AgentConversationKey.ForSession(sessionId) : AgentConversationKey.ForHandle(Chat.HandleId);

    private AgentConversationContextOrigin CaptureOrigin(AgentConversationContextBinding? binding)
        => new(activation, Chat.HandleId, Chat.ChatSessionId, binding?.ContextEpochId, binding?.Revision);

    private AgentConversationContextState Presentation {
        get {
            var binding = Binding;
            return new(CaptureOrigin(binding), currentContext?.Scope.DisplayName,
                currentContext?.CanRead(Chat.Agent.AgentId) == true,
                binding is { Mode: AgentConversationContextMode.Detached }, ResolveAffinityStatus(binding),
                HasPendingContextChange(binding) ? ResolvePendingContextText() : null);
        }
    }

    protected override void OnParametersSet() {
        if (observedKey != ConversationKey) {
            activation = Guid.NewGuid();
            observedKey = ConversationKey;
        }
    }

    private AgentConversationContextBinding? Binding {
        get {
            var key = Chat.ChatSessionId is { } sessionId
                ? AgentConversationKey.ForSession(sessionId)
                : AgentConversationKey.ForHandle(Chat.HandleId);
            return ConversationContextService.TryGetBinding(key);
        }
    }

    protected override void OnInitialized() {
        ContextRegistry.Changed += HandleChanged;
        ConversationContextService.Changed += HandleChanged;
        currentContext = ContextRegistry.Capture();
    }

    private async void HandleChanged(object? sender, EventArgs eventArgs) {
        try {
            await InvokeAsync(() => {
                if (!disposed) {
                    currentContext = ContextRegistry.Capture();
                    StateHasChanged();
                }
            });
        } catch (Exception exception) {
            if (!disposed) {
                Logger.LogWarning("Floating context refresh failed ({FailureType}); handle {HandleId}.", exception.GetType().Name, Chat.HandleId);
            }
        }
    }

    private static string ResolveAffinityStatus(AgentConversationContextBinding? binding) {
        if (binding is { Mode: AgentConversationContextMode.Detached }) {
            return "Detached from application context";
        }

        if (binding is { IsFollowing: true }) {
            var view = string.IsNullOrWhiteSpace(binding.LastView) ? string.Empty : $" / {binding.LastView}";
            return $"Following: {binding.DisplayName}{view}";
        }

        return "Following: current surface";
    }

    private bool HasPendingContextChange(AgentConversationContextBinding? binding) {
        if (binding is not { IsFollowing: true } ||
            binding.Mode == AgentConversationContextMode.Detached ||
            currentContext is not { } context) {
            return false;
        }

        var currentView = context.Scope.SurfacePosition?.View ?? string.Empty;
        return binding.SourceKind != context.Scope.Source.Kind ||
               binding.SourceId != context.Scope.Source.Id ||
               !string.Equals(binding.LastView, currentView, StringComparison.OrdinalIgnoreCase);
    }

    private string ResolvePendingContextText()
        => currentContext is { } context
            ? $"Next turn: {context.Scope.DisplayName}{(string.IsNullOrWhiteSpace(context.Scope.SurfacePosition?.View) ? string.Empty : $" / {context.Scope.SurfacePosition!.View}")}"
            : "Next turn: no module context";

    private void HandleContextIntent(AgentConversationContextIntent intent) {
        if (disposed || intent.Origin != CaptureOrigin(Binding)) {
            return;
        }
        var key = ConversationKey;
        switch (intent.Mode) {
            case AgentConversationContextMode.FollowCurrentSurface:
                ConversationContextService.FollowCurrentSurface(key);
                break;
            case AgentConversationContextMode.Detached:
                ConversationContextService.Detach(key);
                break;
            default:
                throw new ArgumentOutOfRangeException(nameof(intent));
        }
    }

    public void Dispose() {
        disposed = true;
        ContextRegistry.Changed -= HandleChanged;
        ConversationContextService.Changed -= HandleChanged;
    }
}

@using CanDoItAll.RemoteInstances
@using Microsoft.Extensions.Logging
@inject RemoteWorkflowCatalog Catalog
@inject ILogger<RemoteWorkflowPublicationDialog> Logger
@implements IDisposable

<Dialog IsOpen="true" Title="@($"Share {Selected.Name}")" OnClose="Closed" CloseOnBackdrop="false" TestId="workflows-remote-publication-dialog">
    <ChildContent>
        <TextBlock Value="@(published == true ? "Authorized remote instances can import this workflow." :
            "Share this workflow graph, its input definitions and the instructions of its LLM components.")" />
        @if (error is not null) {
            <Alert AlertStyle="AlertStyle.Warning">@error</Alert>
        }
    </ChildContent>
    <Footer>
        <Cluster Gap="LayoutGap.Small">
            <Button Text="@(published == true ? "Withdraw sharing" : "Publish workflow")" Click="SetAsync" IsBusy="busy"
                    Disabled="@(busy || published is null || published == false && !RemoteWorkflowCatalog.CanShare(Selected.Status))"
                    data-testid="workflows-remote-set-publication" />
            <Button Text="Close" Tone="ButtonTone.Default" Click="@(() => Closed.InvokeAsync())" Disabled="busy" />
        </Cluster>
    </Footer>
</Dialog>

@code {
    [Parameter, EditorRequired] public WorkflowCatalogItem Selected { get; set; } = default!;
    [Parameter, EditorRequired] public Func<bool, CancellationToken, ValueTask> Authorize { get; set; } = default!;
    [Parameter] public EventCallback Closed { get; set; }

    private readonly CancellationTokenSource lifetime = new();
    private bool? published;
    private bool busy;
    private string? error;

    protected override async Task OnInitializedAsync() {
        var token = lifetime.Token;
        try {
            await Authorize(true, token);
            var current = await Catalog.IsPublishedAsync(Selected, token);
            await Authorize(true, token);
            published = current;
        } catch (OperationCanceledException) when (token.IsCancellationRequested) {
        } catch (Exception failure) {
            Report(failure);
        }
    }

    private async Task SetAsync() {
        if (busy || published is not { } wasPublished) {
            return;
        }
        var token = lifetime.Token;
        busy = true;
        error = null;
        try {
            await Catalog.SetPublishedAsync(Selected, !wasPublished, cancellation => Authorize(true, cancellation), token);
            await Closed.InvokeAsync();
        } catch (OperationCanceledException) when (token.IsCancellationRequested) {
        } catch (Exception failure) {
            Report(failure);
        } finally {
            busy = false;
        }
    }

    private void Report(Exception failure) {
        Logger.LogWarning("Workflow sharing for {WorkflowId} could not complete ({FailureType}).", Selected.Id.Value, failure.GetType().Name);
        error = failure switch {
            RemoteInstanceReadException invalid => invalid.Message,
            UnauthorizedAccessException => "Reopen the workflow catalog with current editing access.",
            _ => "Workflow sharing could not be updated. Reopen sharing to check its current state."
        };
    }

    public void Dispose() {
        lifetime.Cancel();
        lifetime.Dispose();
    }
}

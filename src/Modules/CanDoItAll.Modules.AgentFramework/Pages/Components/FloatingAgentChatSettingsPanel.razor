@using CanDoItAll.AgentFramework.UI.Settings
@using Microsoft.Extensions.Logging
@inject IFloatingAgentChatSettingsService SettingsService
@inject IFloatingAgentChatCoordinator Coordinator
@inject NotificationService NotificationService
@inject ILogger<FloatingAgentChatSettingsSession> Logger
@implements IDisposable

<FloatingChatSettingsSurface Presentation="session.Presentation" Intent="HandleIntentAsync" />

@code {
    private FloatingAgentChatSettingsSession session = default!;
    private bool disposed;
    protected override async Task OnInitializedAsync() {
        session = new(SettingsService, Coordinator.ApplySettings, Logger);
        session.Changed += Refresh;
        await session.LoadAsync();
    }
    private async Task HandleIntentAsync(FloatingChatSettingsIntent intent) {
        if (!session.IsCurrent(intent.Generation) || session.Presentation.IsBusy) {
            return;
        }
        await session.ExecuteAsync(intent);
        if (!session.IsCurrent(intent.Generation)) {
            return;
        }
        if (session.Presentation.Status == FloatingChatSettingsStatus.Saved) {
            NotificationService.Success("Floating chat settings saved", "The active lifecycle and preparation budgets were updated.");
        } else if (session.Presentation.Status == FloatingChatSettingsStatus.SavedWithRuntimeWarning) {
            NotificationService.Warning("Floating chat settings saved", session.Presentation.StatusText);
        } else if (session.Presentation.Status is FloatingChatSettingsStatus.SaveFailed or FloatingChatSettingsStatus.ValidationFailed) {
            NotificationService.Error("Floating chat settings", session.Presentation.StatusText);
        }
    }
    private void Refresh() {
        if (!disposed) {
            _ = InvokeAsync(StateHasChanged);
        }
    }
    public void Dispose() {
        disposed = true;
        if (session is not null) {
            session.Changed -= Refresh;
            session.Dispose();
        }
    }
}

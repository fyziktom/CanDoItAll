<Dialog IsOpen="true" Title="Request evidence" Subtitle="Metadata and explicitly requested bounded content."
        Size="ModalSize.Wide" DenseChrome="true" OnClose="CloseAsync" TestId="history-detail-dialog">
    <ChildContent>
        <Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch">
            @if (isLoading) {
                <LoadingState Title="Loading authorized evidence" Description="Close this dialog to cancel." />
            }
            @if (error is not null) {
                <Alert AlertStyle="AlertStyle.Danger" data-testid="history-detail-error">@error</Alert>
            }
            @if (metadata is { } loaded) {
                <ProviderHistoryMetadataView Entry="loaded.Entry" />
                <FormSection Title="Canonical evidence" Description="Existing records retain their own content and retention. The history index does not copy their conversations.">
                    @foreach (var owner in loaded.Owners) {
                        <Cluster Gap="LayoutGap.Small" @key="owner.Source">
                            <span>@owner.Source.Kind · @owner.Source.Owner.Value · @owner.Source.Evidence.Value</span>
                            <StatusBadge Text="@($"{owner.Role} · {owner.State}")" />
                            @if (owner.CanReadContent) {
                                <Button Text="Load linked content" ButtonStyle="ButtonStyle.Light" Disabled="@isLoading"
                                        Click="@(() => LoadContentAsync(owner.Source))" data-testid="history-owner-content" />
                            }
                        </Cluster>
                    }
                    @if (loaded.HasMoreOwners) {
                        <Alert AlertStyle="AlertStyle.Info">Only the first 16 owner references are shown.</Alert>
                    }
                    @if (loaded.Owners.Count == 0) {
                        <span>No canonical owner references are available.</span>
                    }
                </FormSection>
                @if (loaded.Entry.MetadataAuthority == HistoryMetadataAuthority.Standalone) {
                    <Button Text="Load captured content" ButtonStyle="ButtonStyle.Light" Disabled="@isLoading"
                            Click="@(() => LoadContentAsync(null))" data-testid="history-load-content" />
                }
                <p>Content loads on request in a separate read-only dialog. API keys are never included.</p>
            } else if (!isLoading && error is null) {
                <EmptyState Title="Evidence unavailable" Description="This entry is no longer available in the current authorized scope." />
            }
        </Stack>
    </ChildContent>
    <Footer>
        <Button Text="Close" ButtonStyle="ButtonStyle.Light" Click="CloseAsync" data-testid="history-detail-close" />
    </Footer>
</Dialog>

@if (detail is { } content) {
    <ProviderHistoryContentDialog Content="content" OnClose="CloseContent" />
}

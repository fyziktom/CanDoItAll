@using CanDoItAll.AgentFramework.Editor.UI
@using CanDoItAll.Memory.Abstractions
@using CanDoItAll.Memory.Application
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject IMemoryProviderProfileStore ProviderProfileStore
@inject IEnumerable<IMemoryProviderDriver> ProviderDrivers
@inject ILogger<AgentMemorySettingsPanel> Logger

<AgentMemorySection State="state" Retry="LoadProvidersAsync" EntryFormId="@EntryFormId" />

@code {
    [Parameter, EditorRequired] public AgentMemoryAccessSettings Value { get; set; } = new();
    [Parameter] public AgentMemoryEditorState? State { get; set; }
    [Parameter] public CancellationToken OwnerLifetime { get; set; }
    [Parameter] public string EntryFormId { get; set; } = string.Empty;
    private AgentMemoryEditorState state = default!;
    private bool disposed;
    protected override async Task OnParametersSetAsync() {
        var next = State ?? state ?? new(Value);
        if (!ReferenceEquals(state, next)) {
            if (state is not null) {
                state.ProviderReferencesChanged -= RefreshReferences;
            }
            state = next;
            state.ProviderReferencesChanged += RefreshReferences;
        }
        state.UpdateValue(Value);
        if (!state.ProvidersLoaded && !state.ProvidersLoading && string.IsNullOrEmpty(state.ProviderLoadError)) {
            await LoadProvidersAsync();
        }
    }
    private async Task LoadProvidersAsync() {
        var owner = state;
        if (owner.ProvidersLoading || disposed || OwnerLifetime.IsCancellationRequested) {
            return;
        }
        owner.ProvidersLoading = true;
        owner.ProviderLoadError = string.Empty;
        try {
            var driverCounts = ProviderDrivers.GroupBy(driver => driver.DriverKind)
                .ToDictionary(group => group.Key, group => group.Count());
            var profiles = await ProviderProfileStore.ListAsync(OwnerLifetime);
            if ((disposed && State is null) || OwnerLifetime.IsCancellationRequested || !ReferenceEquals(owner, state)) {
                return;
            }
            owner.AvailableProviders = profiles.Where(provider => provider.IsEnabled &&
                    provider.HealthState == MemoryProviderHealthState.Healthy &&
                    driverCounts.GetValueOrDefault(provider.DriverKind) == 1 &&
                    provider.Manifest.Capabilities.Any(capability => capability.Supported && capability.Id == MemoryCapabilityIds.ContextQuerySync))
                .OrderBy(provider => provider.DisplayName, StringComparer.OrdinalIgnoreCase)
                .ThenBy(provider => provider.InstanceId.Value, StringComparer.Ordinal)
                .Select(provider => new AgentMemoryProviderOption(provider.InstanceId, provider.DisplayName)).ToArray();
            owner.ProvidersLoaded = true;
        } catch (OperationCanceledException) when (OwnerLifetime.IsCancellationRequested) {
        } catch (Exception exception) {
            if ((!disposed || State is not null) && !OwnerLifetime.IsCancellationRequested && ReferenceEquals(owner, state)) {
                Logger.LogError("Failed to load enabled memory providers. Exception type: {ExceptionType}.", exception.GetType().Name);
                owner.ProviderLoadError = "Enabled memory providers could not be loaded. Retry without changing the bindings.";
            }
        } finally {
            owner.ProvidersLoading = false;
            owner.NotifyProviderReferencesChanged();
        }
    }
    private void RefreshReferences() {
        if (!disposed) {
            _ = InvokeAsync(StateHasChanged);
        }
    }
    public void Dispose() {
        disposed = true;
        state.ProviderReferencesChanged -= RefreshReferences;
    }
}

<ListDetailShell ListPaneWidth="25rem"
                 data-testid="agents-provider-profiles-panel">
    <ListHeader>
        <ListPanelHeader Title="Provider profiles"
                         Description="AgentFramework provider catalog, including workspace profiles and seeded runtime providers."
                         Count="@($"{FilteredProviders.Count} profile(s)")">
            <Actions>
                <Button Text="New provider"
                        Icon="add"
                        Tone="ButtonTone.Default"
                        Size="ButtonSize.Small"
                        Click="ResetProviderAsync"
                        data-testid="providers-new" />
                <Button Text="Refresh"
                        Icon="refresh"
                        Tone="ButtonTone.Default"
                        Size="ButtonSize.Small"
                        Click="LoadAsync"
                        data-testid="providers-refresh" />
            </Actions>
            <Filters>
                <FilterBar ResultText="@($"{FilteredProviders.Count} of {providers.Count} provider(s)")">
                    <input @bind="providerSearch"
                           @bind:event="oninput"
                           class="ui-input min-w-[14rem] flex-1"
                           placeholder="Search providers"
                           data-testid="providers-search" />
                    <Button Text="Reset"
                            Tone="ButtonTone.Default"
                            Size="ButtonSize.Small"
                            Click="ResetProviderSearch" />
                </FilterBar>
            </Filters>
        </ListPanelHeader>
    </ListHeader>

    <ListContent>
        @if (isLoading)
        {
            <EmptyState Eyebrow="Loading"
                        Title="Loading provider catalog"
                        Description="AgentFramework is reading workspace-backed and seeded provider profiles." />
        }
        else if (FilteredProviders.Count == 0)
        {
            <EmptyState Eyebrow="No providers"
                        Title="No provider profiles match the current filter"
                        Description="Clear the search filter or create a provider profile." />
        }
        else
        {
            <TreeView Items="@ProviderTreeNodes"
                      Style="TreeViewStyle.Workbench"
                      AriaLabel="Provider profiles grouped by tag"
                      EmptyText="No provider profiles are available."
                      OnSelect="HandleProviderTreeSelectAsync"
                      OnToggle="HandleProviderTreeToggleAsync"
                      data-testid="providers-tree" />
        }
    </ListContent>

    <DetailHeader>
        <Stack GapScale="LayoutGap.Tiny">
            <TextBlock TextStyle="TextStyle.EyebrowCaption" Value="Provider editor" />
            <h2 class="app-title-xl">@(providerModel.Id.HasValue ? providerModel.Name : "New provider profile")</h2>
            <p class="app-body-muted">@ResolveSelectedProviderStatus()</p>
        </Stack>
    </DetailHeader>

    <DetailContent>
        <EditForm Model="providerModel" OnValidSubmit="SaveProviderAsync">
            <Stack Class="agent-provider-editor-form min-h-full" GapScale="LayoutGap.XXLarge">
                <div class="agent-provider-editor-tabs-shell">
                    <Tabs @bind-SelectedIndex="providerEditorTabIndex"
                          RenderMode="TabRenderMode.Server"
                          OverflowMode="TabsOverflowMode.Wrap"
                          Class="agent-provider-editor-tabs"
                          AriaLabel="Provider editor tabs"
                          data-testid="provider-editor-tabs">
                        <TabsItem Text="Connection" Icon="plug" data-testid="provider-editor-tab-connection">
                            <div class="agent-provider-connection-tab">
                                <FormSection Title="Identity" Description="Provider identity, endpoint, model, and grouping tags. Tags drive the tree and future capability search.">
                                <Grid Gap="LayoutGap.Large" ColumnsMd="2" ColumnsXl="4">
                                    <div>
                                        <FormField Text="Name">
                                        <InputText @bind-Value="providerModel.Name"
                                                   class="ui-input"
                                                   data-testid="providers-name-input" />
                                        </FormField>
                                    </div>
                                    <div>
                                        <FormField Text="Default model">
                                        <InputText @bind-Value="providerModel.DefaultModel"
                                                   class="ui-input"
                                                   data-testid="providers-model-input" />
                                        </FormField>
                                    </div>
                                    <div>
                                        <FormField Text="Provider kind">
                                        <InputSelect @bind-Value="providerModel.Kind"
                                                     class="ui-input"
                                                     data-testid="providers-kind-select">
                                            @foreach (var kind in Enum.GetValues<ProviderKind>())
                                            {
                                                <option value="@kind">@kind</option>
                                            }
                                        </InputSelect>
                                        </FormField>
                                    </div>
                                    <div>
                                        <FormField Text="Purpose">
                                        <InputSelect @bind-Value="providerModel.Purpose"
                                                     class="ui-input"
                                                     data-testid="providers-purpose-select">
                                            @foreach (var purpose in Enum.GetValues<ProviderProfilePurpose>())
                                            {
                                                <option value="@purpose">@purpose</option>
                                            }
                                        </InputSelect>
                                        </FormField>
                                    </div>
                                </Grid>

                                <div>
                                    <FormField Text="Base URL">
                                    <InputText @bind-Value="providerModel.BaseUrl"
                                               class="ui-input"
                                               data-testid="providers-base-url-input" />
                                    </FormField>
                                </div>

                                <div>
                                    <FormField Text="API key secret">
                                    <InputSelect @bind-Value="providerModel.ApiKeyEnvironmentVariable"
                                                 class="ui-input"
                                                 data-testid="providers-api-key-input">
                                        <option value="">None</option>
                                        @if (HasUnavailableSecretReference)
                                        {
                                            <option value="@providerModel.ApiKeyEnvironmentVariable">Unavailable saved secret</option>
                                        }
                                        @foreach (var secret in secrets)
                                        {
                                            <option value="@AgentFrameworkProviderMetadata.CreateSecretReference(secret.Id)">@secret.Name</option>
                                        }
                                    </InputSelect>
                                    </FormField>
                                    @if (HasUnavailableSecretReference)
                                    {
                                        <p class="app-body-muted mt-1">The saved secret reference is no longer available in the vault. Select another secret before saving.</p>
                                    }
                                    else if (secrets.Count == 0)
                                    {
                                        <p class="app-body-muted mt-1">Add an API key in Settings → Secrets, then refresh this provider list.</p>
                                    }
                                </div>

                                <TagEditor Value="@providerTagValues"
                                           ValueChanged="HandleProviderTagsChangedAsync"
                                           Suggestions="@AvailableProviderTags"
                                           Placeholder="Add provider tag"
                                           Hint="Use tags such as openai, ollama, local, cloud, chat, image, or fallback."
                                           MaxTags="12"
                                           TestId="providers-tags"
                                           InputTestId="providers-tags-input" />
                                </FormSection>
                            </div>
                        </TabsItem>
                        <TabsItem Text="Prices" Icon="paid" data-testid="provider-editor-tab-prices">
                            <div class="agent-provider-prices-tab">
                                <ProviderModelPricingEditor Model="providerModel"
                                                            PricingKind="@providerModel.Kind"
                                                            DefaultModel="@providerModel.DefaultModel"
                                                            OnRefreshPrices="RefreshProviderModelPricesAsync" />
                            </div>
                        </TabsItem>
                        <TabsItem Text="Runtime" Icon="tune" data-testid="provider-editor-tab-runtime">
                            <div class="agent-provider-runtime-tab">
                                <FormSection Title="Runtime behavior" Description="Keep transport and advertised runtime capabilities explicit.">
                                    <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                        <div>
                                            <FormField Text="Transport">
                                            <InputSelect @bind-Value="providerModel.Transport"
                                                         class="ui-input"
                                                         data-testid="providers-transport-select">
                                                @foreach (var transport in Enum.GetValues<ProviderTransportKind>())
                                                {
                                                    <option value="@transport">@transport</option>
                                                }
                                            </InputSelect>
                                            </FormField>
                                        </div>
                                        <div>
                                            <FormField Text="Suggested models">
                                            <textarea @bind="suggestedModelsText"
                                                      class="ui-input min-h-[7rem]"
                                                      data-testid="providers-suggested-models"></textarea>
                                            </FormField>
                                        </div>
                                    </Grid>

                                    <Grid Gap="LayoutGap.Medium" ColumnsMd="2" ColumnsXl="3">
                                        <CheckboxOption @bind-Value="providerModel.IsEnabled"  Text="Enabled" />
                                        <CheckboxOption @bind-Value="providerModel.SupportsStreaming"  Text="Streaming" />
                                        <CheckboxOption @bind-Value="providerModel.SupportsTools"  Text="Tool calling" />
                                        <CheckboxOption @bind-Value="providerModel.PreferFrameworkManagedChatHistory"  Text="Framework-managed history" />
                                        <CheckboxOption @bind-Value="providerModel.SupportsBackgroundResponses"  Text="Background responses" />
                                    </Grid>
                                </FormSection>

                                <FormSection Title="Configuration and notes" Description="Advanced provider metadata. Keep JSON valid and explicit.">
                                    <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                        <div>
                                            <FormField Text="Configuration JSON">
                                            <TextArea @bind-Value="providerModel.ConfigurationJson"
                                                           class="ui-input min-h-[12rem] font-mono text-xs"
                                                           data-testid="providers-config-json" />
                                            </FormField>
                                        </div>
                                        <div>
                                            <FormField Text="Notes">
                                            <TextArea @bind-Value="providerModel.Notes"
                                                           class="ui-input min-h-[12rem]"
                                                           data-testid="providers-notes" />
                                            </FormField>
                                        </div>
                                    </Grid>
                                </FormSection>
                            </div>
                        </TabsItem>
                    </Tabs>
                </div>

                <StickyActionFooter StatusLabel="Provider profiles">
                    <SecondaryActions>
                        <Button Text="Clear" Tone="ButtonTone.Default" Click="ResetProviderAsync" />
                        @if (providerModel.Id.HasValue)
                        {
                            <Button Text="Health" Tone="ButtonTone.Info" Disabled="@isBusy" Click="@(() => TestProviderAsync(providerModel.Id.Value))" />
                        }
                    </SecondaryActions>
                    <PrimaryActions>
                        <Button Text="Save provider"
                                Type="submit"
                                Disabled="@isBusy"
                                IsBusy="@isBusy"
                                data-testid="providers-save" />
                    </PrimaryActions>
                    <DangerActions>
                        @if (providerModel.Id.HasValue)
                        {
                            <Button Text="Delete"
                                    Tone="ButtonTone.Danger"
                                    Disabled="@isBusy"
                                    Click="@(() => DeleteProviderAsync(providerModel.Id.Value))" />
                        }
                    </DangerActions>
                </StickyActionFooter>
            </Stack>
        </EditForm>
    </DetailContent>
</ListDetailShell>

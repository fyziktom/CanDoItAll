@using CanDoItAll.AgentFramework.Providers.UI

<ProviderProfilesSurface View="this">
    <SharingSlot Context="slot">
        <SharedProviderManagementPanel @key="slot.Target.ProviderId" Revision="sharingRevision"
                                       OriginalOpening="opening"
                                       ProviderRevision="session.Draft.ExpectedConcurrencyToken"
                                       ProviderProfileId="slot.Target.ProviderId"
                                       ProvidersChanged="@(delivery => RefreshSharedAsync(slot.Target, delivery))" />
    </SharingSlot>
    <HistorySlot Context="slot">
        @if (slot.Target.ProviderId is { } providerId) {
            <CanDoItAll.Modules.AgentFramework.Pages.Components.History.ProviderRequestHistoryPanel @key="providerId"
                Scope="@(new CanDoItAll.AgentFramework.ProviderHistory.HistoryProviderScope.SingleProvider(new(providerId)))"
                Location="@(IsRouteControlled ? HistoryLocation : null)" LocationChanged="HistoryChanged" />
        } else {
            <EmptyState Title="Save this provider first" Description="Request history is scoped to a saved provider identity." />
        }
    </HistorySlot>
    <ConnectionsSlot Context="slot">
        <SharedProviderSourcesDialog Secrets="session.Catalog.Secrets.Items"
                                     OriginalOpening="opening"
                                     SecretMetadataError="@session.Catalog.Secrets.Error"
                                     ProvidersChanged="@(delivery => RefreshSharedAsync(slot.Target, delivery))"
                                     OnClose="@(() => CloseConnections(slot.Target))" />
    </ConnectionsSlot>
    <SourceRefreshSlot Context="slot">
        @if (slot.Target.ProviderId is { } providerId && slot.SourceManaged) {
            <SharedProviderRefreshButton ProviderId="providerId"
                                         OriginalOpening="opening"
                                         Refreshed="@(delivery => RefreshSharedAsync(slot.Target, delivery))" />
        }
    </SourceRefreshSlot>
</ProviderProfilesSurface>

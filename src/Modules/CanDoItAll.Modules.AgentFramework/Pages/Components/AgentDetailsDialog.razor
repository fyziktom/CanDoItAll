@using CanDoItAll.AgentFramework.Editor.UI
@{
    var renderedSession = session;
    var renderedProvider = SelectedRuntimeProvider;
    var renderedProviderRevision = providerSelectionRevision;
}
<AgentEditorCoreSurface State="@CreateCoreState(renderedSession)">
    <AvatarActions Context="slot">
        @if (IsCurrent(renderedSession) && slot.Origin == renderedSession.Origin) {
            <AvatarPicker Value="@slot.Draft.AvatarImageUrl"
                          ValueChanged="value => HandleAvatarChangedAsync(renderedSession, value)"
                          EntityName="@slot.Draft.Name"
                          EntityDescription="@slot.Draft.RoleTitle"
                          EntityKind="Agent"
                          GenerationSource="@AvatarGenerationSource"
                          Disabled="@isBusy"
                          TestIdPrefix="agents-catalog-avatar" />
        }
    </AvatarActions>
    <ProviderRefresh Context="slot">
        @if (IsCurrent(renderedSession) && slot.Origin == renderedSession.Origin && renderedProvider is { IsSourceManaged: true } sharedProvider) {
            <SharedProviderRefreshButton @key="sharedProvider.Id" ProviderId="sharedProvider.Id"
                Refreshed="delivery => delivery.ReconcileAsync(() => RefreshRuntimeProvidersAsync(renderedSession, sharedProvider.Id, renderedProviderRevision))" />
        }
    </ProviderRefresh>
    <DeferredSection Context="slot">
        @if (IsCurrent(renderedSession) && slot.Origin == renderedSession.Origin) {
            var editorModel = slot.Draft;
            @switch (slot.Section) {
            case AgentEditorSection.Memory:
                        <AgentMemorySettingsPanel Value="@editorModel.MemoryAccess" />
                break;
            case AgentEditorSection.ProjectStructureAccess:
                        <FormSection Title="Project Structure Access" Description="Project reads, project creation, subproject creation, non-task structure changes, task-only changes, and unrestricted changes are separate permissions. Advanced plan and cost analysis additionally requires its assigned planning skill and tool capability.">
                            <Grid Gap="LayoutGap.Large" ColumnsMd="3" data-testid="agents-catalog-project-structure-access">
                                <div class="cda-admin-subpanel">
                                    <p class="cda-field-label mb-2">Access mode</p>
                                    <Stack GapScale="LayoutGap.Small">
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.ProjectStructureAccess.CanRead"
                                                   @onchange="args => ChangeFor(renderedSession, () => ToggleProjectStructureRead(args.Value))"
                                                   data-testid="agents-catalog-project-structure-read" />
                                            Can read project structure
                                        </label>
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.ProjectStructureAccess.CanCreateProjects"
                                                   @onchange="args => ChangeFor(renderedSession, () => ToggleProjectCreation(args.Value))"
                                                   data-testid="agents-catalog-project-create" />
                                            Can create standalone projects
                                        </label>
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.ProjectStructureAccess.CanCreateSubprojects"
                                                   @onchange="args => ChangeFor(renderedSession, () => ToggleSubprojectCreation(args.Value))"
                                                   data-testid="agents-catalog-subproject-create" />
                                            Can create subprojects under allowed projects
                                        </label>
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@(editorModel.ProjectStructureAccess.CanWrite || editorModel.ProjectStructureAccess.CanWriteNonTaskStructure)"
                                                   disabled="@editorModel.ProjectStructureAccess.CanWrite"
                                                   @onchange="args => ChangeFor(renderedSession, () => ToggleProjectStructureNonTaskWrite(args.Value))"
                                                   data-testid="agents-catalog-project-structure-non-task-write" />
                                            Can write project structure except tasks
                                        </label>
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@(editorModel.ProjectStructureAccess.CanWrite || editorModel.ProjectStructureAccess.CanWriteTasks)"
                                                   disabled="@editorModel.ProjectStructureAccess.CanWrite"
                                                   @onchange="args => ChangeFor(renderedSession, () => ToggleProjectStructureTaskWrite(args.Value))"
                                                   data-testid="agents-catalog-project-structure-task-write" />
                                            Can write project tasks
                                        </label>
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.ProjectStructureAccess.CanWrite"
                                                   @onchange="args => ChangeFor(renderedSession, () => ToggleProjectStructureWrite(args.Value))"
                                                   data-testid="agents-catalog-project-structure-write" />
                                            Can write entire project structure (includes tasks)
                                        </label>
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.ProjectStructureAccess.AllowAllProjects"
                                                   @onchange="args => ChangeFor(renderedSession, () => ToggleProjectStructureAllowAll(args.Value))"
                                                   data-testid="agents-catalog-project-structure-all" />
                                            Allow all current and future projects
                                        </label>
                                    </Stack>
                                </div>
                                <div class="cda-admin-subpanel md:col-span-2">
                                    <Split Breakpoint="LayoutBreakpoint.Md"
                                           Gap="LayoutGap.Medium"
                                           AlignItems="AlignItems.Center"
                                           JustifyContent="JustifyContent.SpaceBetween"
                                           Wrap="FlexWrap.Wrap">
                                        <div>
                                            <p class="cda-field-label mb-1">Allowed projects</p>
                                            <p class="text-sm leading-6 text-slate-600">
                                                @DescribeProjectStructureScope(editorModel)
                                            </p>
                                        </div>
                                        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                            <Button Text="Select all"
                                                    ButtonStyle="ButtonStyle.Light"
                                                    Size="ButtonSize.Small"
                                                    Click="() => ChangeFor(renderedSession, SelectAllProjectStructureProjects)"
                                                    Disabled="@(!areProjectStructureProjectsLoaded || isLoadingProjectStructureProjects || !string.IsNullOrWhiteSpace(projectStructureProjectsErrorMessage) || editorModel.ProjectStructureAccess.AllowAllProjects)" />
                                            <Button Text="Clear"
                                                    ButtonStyle="ButtonStyle.Light"
                                                    Size="ButtonSize.Small"
                                                    Click="() => ChangeFor(renderedSession, ClearProjectStructureProjects)"
                                                    Disabled="@(!areProjectStructureProjectsLoaded || isLoadingProjectStructureProjects || !string.IsNullOrWhiteSpace(projectStructureProjectsErrorMessage) || editorModel.ProjectStructureAccess.AllowAllProjects)" />
                                        </Cluster>
                                    </Split>

                                    @if (editorModel.ProjectStructureAccess.AllowAllProjects)
                                    {
                                        <div class="mt-3 cda-admin-empty">
                                            This agent can access all current and future projects. Turn off the all-projects option to manage a specific allowlist.
                                        </div>
                                    }
                                    else if (!projectStructureProjectsRequested)
                                    {
                                        <div class="mt-3 cda-admin-empty">
                                            Load the project list only when you need to inspect or change the access scope.
                                        </div>
                                        <Cluster Gap="LayoutGap.Small"
                                                 Wrap="FlexWrap.Wrap"
                                                 Class="mt-3">
                                            <Button Text="Load project list"
                                                    ButtonStyle="ButtonStyle.Light"
                                                    Size="ButtonSize.Small"
                                                    Click="() => RunFor(renderedSession, () => RequestProjectStructureProjectsAsync())"
                                                    Disabled="@isLoadingProjectStructureProjects"
                                                    IsBusy="@isLoadingProjectStructureProjects"
                                                    data-testid="agents-catalog-project-structure-load" />
                                        </Cluster>
                                    }
                                    else if (!areProjectStructureProjectsLoaded &&
                                             string.IsNullOrWhiteSpace(projectStructureProjectsErrorMessage))
                                    {
                                        <div class="mt-3 cda-admin-empty">
                                            Loading projects that can be granted to this agent...
                                        </div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(projectStructureProjectsErrorMessage))
                                    {
                                        <div class="mt-3 cda-admin-empty text-rose-700">
                                            @projectStructureProjectsErrorMessage
                                        </div>
                                        <Cluster Gap="LayoutGap.Small"
                                                 Wrap="FlexWrap.Wrap"
                                                 Class="mt-3">
                                            <Button Text="Retry project list"
                                                    ButtonStyle="ButtonStyle.Light"
                                                    Size="ButtonSize.Small"
                                                    Click="() => RunFor(renderedSession, () => RequestProjectStructureProjectsAsync())"
                                                    Disabled="@isLoadingProjectStructureProjects"
                                                    IsBusy="@isLoadingProjectStructureProjects" />
                                        </Cluster>
                                    }
                                    else if (projectStructureProjects.Count == 0)
                                    {
                                        <div class="mt-3 cda-admin-empty">
                                            No projects exist yet. Create a project before granting project-structure access.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mt-3 max-h-64 overflow-y-auto rounded-2xl border border-slate-200 bg-white p-4"
                                             data-testid="agents-catalog-project-structure-projects">
                                            <Stack GapScale="LayoutGap.Small">
                                                @foreach (var project in projectStructureProjects)
                                                {
                                                    <label class="cda-inline-option cda-inline-option--muted">
                                                        <input type="checkbox"
                                                               checked="@HasProjectStructureProjectAccess(project.Id)"
                                                               @onchange="args => ChangeFor(renderedSession, () => ToggleProjectStructureProject(project.Id, args.Value))" />
                                                        @project.Name
                                                    </label>
                                                }
                                            </Stack>
                                        </div>
                                    }
                                </div>
                            </Grid>
                        </FormSection>
                break;
            case AgentEditorSection.WorkspaceTools:
                        <FormSection Title="Workspace Tools" Description="These settings decide whether the current agent receives native workspace file tools, external workspace roots, and storage-driver tools.">
                            <Grid Gap="LayoutGap.Large" ColumnsMd="3" data-testid="agents-catalog-workspace-tools">
                                <div class="cda-admin-subpanel">
                                    <label class="cda-field-label" for="agents-catalog-workspace-profile">Access profile</label>
                                    <select id="agents-catalog-workspace-profile"
                                            class="cda-input mt-2"
                                            value="@editorModel.WorkspaceToolAccess.Profile"
                                            @onchange="args => ChangeFor(renderedSession, () => ChangeWorkspaceToolProfile(args.Value))"
                                            data-testid="agents-catalog-workspace-profile">
                                        @foreach (var profile in WorkspaceToolProfileOptions)
                                        {
                                            <option value="@profile">@FormatWorkspaceToolProfile(profile)</option>
                                        }
                                    </select>
                                    <p class="mt-3 text-sm leading-6 text-slate-600">
                                        @DescribeWorkspaceExecutionScope(editorModel)
                                    </p>
                                </div>
                                <div class="cda-admin-subpanel md:col-span-2">
                                    <p class="cda-field-label mb-2">Execution tools</p>
                                    <Grid Gap="LayoutGap.Small" ColumnsMd="2">
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.WorkspaceToolAccess.CanRunValidationCommands"
                                                   @onchange="args => ChangeFor(renderedSession, () => ToggleWorkspaceValidationCommands(args.Value))"
                                                   data-testid="agents-catalog-workspace-validation" />
                                            Can run build, test, and app commands
                                        </label>
                                        <label class="cda-inline-option">
                                            <input @key="@($"scripts-{workspaceRiskInputVersion}")"
                                                   type="checkbox"
                                                   checked="@editorModel.WorkspaceToolAccess.CanRunLocalScripts"
                                                   disabled="@isConfirmingWorkspaceRisk"
                                                   @onchange="args => RunFor(renderedSession, () => HandleWorkspaceLocalScriptsChangedAsync(args.Value))"
                                                   data-testid="agents-catalog-workspace-scripts" />
                                            Can run local scripts
                                        </label>
                                        <label class="cda-inline-option">
                                            <input @key="@($"environment-{workspaceRiskInputVersion}")"
                                                   type="checkbox"
                                                   checked="@editorModel.WorkspaceToolAccess.CanScriptsReadEnvironment"
                                                   disabled="@(isConfirmingWorkspaceRisk || !editorModel.WorkspaceToolAccess.CanRunLocalScripts)"
                                                   @onchange="args => RunFor(renderedSession, () => HandleScriptsReadEnvironmentChangedAsync(args.Value))"
                                                   data-testid="agents-catalog-workspace-scripts-environment" />
                                            Scripts may read environment variables
                                        </label>
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.WorkspaceToolAccess.CanScaffoldProjects"
                                                   @onchange="args => ChangeFor(renderedSession, () => ToggleWorkspaceScaffoldProjects(args.Value))"
                                                   data-testid="agents-catalog-workspace-scaffold" />
                                            Can scaffold projects
                                        </label>
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.WorkspaceToolAccess.CanManageWorkspacePaths"
                                                   @onchange="args => ChangeFor(renderedSession, () => ToggleWorkspaceManagePaths(args.Value))"
                                                   data-testid="agents-catalog-workspace-manage-paths" />
                                            Can move, copy, and delete paths
                                        </label>
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.WorkspaceToolAccess.CanTransformArtifacts"
                                                   @onchange="args => ChangeFor(renderedSession, () => ToggleWorkspaceTransformArtifacts(args.Value))"
                                                   data-testid="agents-catalog-workspace-transform" />
                                            Can transform artifacts
                                        </label>
                                    </Grid>
                                    @if (editorModel.WorkspaceToolAccess.CanRunLocalScripts)
                                    {
                                        <Alert AlertStyle="AlertStyle.Warning" class="mt-3" data-testid="agents-catalog-workspace-scripts-warning">
                                            <p class="font-semibold">Local scripts are enabled</p>
                                            <p class="mt-1">Scripts run with your account's rights and are not sandboxed. They are inspected before they run, and runs need approval unless auto-approval is on.</p>
                                            @if (editorModel.WorkspaceToolAccess.CanScriptsReadEnvironment)
                                            {
                                                <p class="mt-1" data-testid="agents-catalog-workspace-scripts-environment-warning">Scripts may also read every environment variable passed to them, including operator proxy settings.</p>
                                            }
                                            else
                                            {
                                                <p class="mt-1">Scripts that read environment variables beyond PATH, TEMP and HOME, or list all variables, are blocked until "Scripts may read environment variables" is enabled.</p>
                                            }
                                        </Alert>
                                    }
                                </div>
                                <div class="cda-admin-subpanel">
                                    <p class="cda-field-label mb-2">File access</p>
                                    <Stack GapScale="LayoutGap.Small">
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.WorkspaceToolAccess.CanReadFiles"
                                                   @onchange="args => ChangeFor(renderedSession, () => ToggleWorkspaceFileRead(args.Value))"
                                                   data-testid="agents-catalog-workspace-read" />
                                            Can browse and read files
                                        </label>
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.WorkspaceToolAccess.CanWriteFiles"
                                                   @onchange="args => ChangeFor(renderedSession, () => ToggleWorkspaceFileWrite(args.Value))"
                                                   data-testid="agents-catalog-workspace-write" />
                                            Can write files
                                        </label>
                                    </Stack>
                                    <p class="mt-3 text-sm leading-6 text-slate-600">
                                        @DescribeWorkspaceFileScope(editorModel)
                                    </p>
                                </div>
                                <div class="cda-admin-subpanel md:col-span-2">
                                    <ExternalWorkspaceRootSelectionField
                                        AllowedAliases="@editorModel.WorkspaceToolAccess.AllowedExternalTargetAliases"
                                        RootBindings="@editorModel.WorkspaceToolAccess.ExternalTargetRootBindings"
                                        SelectionChanged="selection => ApplyExternalWorkspaceRootSelection(renderedSession, selection)"
                                        DataTestId="agents-catalog-workspace-external-roots" />
                                </div>
                                <div class="cda-admin-subpanel">
                                    <p class="cda-field-label mb-2">Storage access</p>
                                    <Stack GapScale="LayoutGap.Small">
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.WorkspaceToolAccess.CanReadStorage"
                                                   @onchange="args => ChangeFor(renderedSession, () => ToggleStorageRead(args.Value))"
                                                   data-testid="agents-catalog-storage-read" />
                                            Can read storage driver catalogs
                                        </label>
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.WorkspaceToolAccess.CanWriteStorage"
                                                   @onchange="args => ChangeFor(renderedSession, () => ToggleStorageWrite(args.Value))"
                                                   data-testid="agents-catalog-storage-write" />
                                            Can write storage driver objects
                                        </label>
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.WorkspaceToolAccess.AllowAllStorageCatalogs"
                                                   @onchange="args => ChangeFor(renderedSession, () => ToggleStorageAllowAll(args.Value))"
                                                   data-testid="agents-catalog-storage-all" />
                                            Allow all storage catalogs
                                        </label>
                                    </Stack>
                                    <p class="mt-3 text-sm leading-6 text-slate-600">
                                        @DescribeStorageScope(editorModel)
                                    </p>
                                </div>
                                <div class="cda-admin-subpanel md:col-span-2">
                                    <CanDoItAll.Workspace.StorageSelection.UI.StorageCatalogSelectionField
                                        Value="@editorModel.WorkspaceToolAccess.AllowedStorageCatalogIds"
                                        OwnerLifetime="@renderedSession.CancellationToken"
                                        ValueChanged="selection => ApplyStorageCatalogSelection(renderedSession, selection)"
                                        AllowAll="@editorModel.WorkspaceToolAccess.AllowAllStorageCatalogs"
                                        DataTestId="agents-catalog-storage-selection" />
                                </div>
                            </Grid>
                        </FormSection>
                break;
            case AgentEditorSection.Secrets:
                        <FormSection Title="Secrets" Description="Grant only the stored secrets this agent may request during explicit runtime actions. Values are not stored in the agent definition.">
                            <Grid Gap="LayoutGap.Large" ColumnsMd="3" data-testid="agents-catalog-secrets">
                                <div class="cda-admin-subpanel">
                                    <p class="cda-field-label mb-2">Allowed secrets</p>
                                    <p class="text-sm leading-6 text-slate-600">
                                        @DescribeSecretScope(editorModel)
                                    </p>
                                </div>
                                <div class="cda-admin-subpanel md:col-span-2">
                                    @if (isLoadingSecrets && !areSecretsLoaded)
                                    {
                                        <div class="cda-admin-empty">
                                            Loading stored secrets...
                                        </div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(secretsErrorMessage))
                                    {
                                        <div class="cda-admin-empty text-rose-700">
                                            @secretsErrorMessage
                                        </div>
                                    }
                                    else if (secrets.Count == 0)
                                    {
                                        <div class="cda-admin-empty">
                                            No stored secrets exist yet.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="max-h-64 overflow-y-auto rounded-2xl border border-slate-200 bg-white p-4"
                                             data-testid="agents-catalog-secret-list">
                                            <Stack GapScale="LayoutGap.Small">
                                                @foreach (var secret in secrets)
                                                {
                                                    <label class="cda-inline-option cda-inline-option--muted">
                                                        <input type="checkbox"
                                                               checked="@HasAllowedSecret(secret.Id)"
                                                               @onchange="args => ChangeFor(renderedSession, () => ToggleAllowedSecret(secret, args.Value))" />
                                                        @secret.Name
                                                        <span class="text-slate-500">(@secret.KindLabel)</span>
                                                    </label>
                                                }
                                            </Stack>
                                        </div>
                                    }
                                </div>
                            </Grid>
                        </FormSection>
                break;
            case AgentEditorSection.ProcessAccess:
                        <FormSection Title="Process Access" Description="Internal agents always carry the process-module tool family. These settings decide whether the current agent can read or mutate process data and which process definitions it may touch.">
                            <Grid Gap="LayoutGap.Large" ColumnsMd="3" data-testid="agents-catalog-process-access">
                                <div class="cda-admin-subpanel">
                                    <p class="cda-field-label mb-2">Access mode</p>
                                    <Stack GapScale="LayoutGap.Small">
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.ProcessAccess.CanRead"
                                                   @onchange="args => ChangeFor(renderedSession, () => ToggleProcessRead(args.Value))"
                                                   data-testid="agents-catalog-process-read" />
                                            Can read processes
                                        </label>
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.ProcessAccess.CanWrite"
                                                   @onchange="args => ChangeFor(renderedSession, () => ToggleProcessWrite(args.Value))"
                                                   data-testid="agents-catalog-process-write" />
                                            Can write processes
                                        </label>
                                        <label class="cda-inline-option">
                                            <input type="checkbox"
                                                   checked="@editorModel.ProcessAccess.AllowAllDefinitions"
                                                   @onchange="args => ChangeFor(renderedSession, () => ToggleProcessAllowAll(args.Value))"
                                                   data-testid="agents-catalog-process-all" />
                                            Allow all current and future processes
                                        </label>
                                    </Stack>
                                </div>
                                <div class="cda-admin-subpanel md:col-span-2">
                                    <p class="cda-field-label mb-1">Allowed processes</p>
                                    <p class="text-sm leading-6 text-slate-600">
                                        @DescribeProcessScope(editorModel)
                                    </p>
                                    <div class="mt-3 cda-admin-empty">
                                        Process definition selection is unavailable while the Process module is rebuilt. Existing stored access metadata is preserved.
                                    </div>
                                </div>
                            </Grid>
                        </FormSection>
                break;
            case AgentEditorSection.Capabilities:
                        <FormSection Title="Capabilities" Description="Attach cataloged tools, skills, and MCP servers to this agent, or open the guided setup flow to create and assign one.">
                            <div data-testid="agents-details-capability-summary">
                                <CompactStatStrip>
                                    <CompactStat Label="attached"
                                                 Value="@editorModel.SelectedCapabilityIds.Count.ToString()"
                                                 TooltipText="Capabilities currently assigned to this agent."
                                                 Tone="info" />
                                    <CompactStat Label="skills"
                                                 Value="@capabilities.Count(item => item.Kind == CapabilityKind.Skill).ToString()"
                                                 TooltipText="Prompt and workflow skills in the catalog."
                                                 Tone="success" />
                                    <CompactStat Label="tools"
                                                 Value="@capabilities.Count(item => item.Kind == CapabilityKind.Tool).ToString()"
                                                 TooltipText="Runtime tools in the catalog."
                                                 Tone="accent" />
                                    <CompactStat Label="MCP servers"
                                                 Value="@capabilities.Count(item => item.Kind == CapabilityKind.McpServer).ToString()"
                                                 TooltipText="MCP tool surfaces in the catalog."
                                                 Tone="warning" />
                                    <CompactStat Label="verified"
                                                 Value="@capabilities.Count(item => item.ProofStatus == CapabilityProofStatus.Verified).ToString()"
                                                 TooltipText="Capabilities with successful proof status."
                                                 Tone="success" />
                                </CompactStatStrip>
                            </div>

                            <Cluster Gap="LayoutGap.Small"
                                     Wrap="FlexWrap.Wrap"
                                     Class="agent-details-dialog__capability-actions"
                                 data-testid="agents-details-new-capability">
                                <Button Text="New tool"
                                        Icon="build"
                                        ButtonStyle="ButtonStyle.Light"
                                        Size="ButtonSize.Small"
                                        Disabled="@(IsMutationBlocked || isOpeningCapabilityWizard)"
                                        Click="@(() => RunFor(renderedSession, () => OpenCapabilityWizardAsync(CapabilityKind.Tool)))"
                                        data-testid="agents-details-new-tool" />
                                <Button Text="New MCP"
                                        Icon="hub"
                                        ButtonStyle="ButtonStyle.Light"
                                        Size="ButtonSize.Small"
                                        Disabled="@(IsMutationBlocked || isOpeningCapabilityWizard)"
                                        Click="@(() => RunFor(renderedSession, () => OpenCapabilityWizardAsync(CapabilityKind.McpServer)))"
                                        data-testid="agents-details-new-mcp" />
                                <Button Text="New skill"
                                        Icon="psychology"
                                        ButtonStyle="ButtonStyle.Light"
                                        Size="ButtonSize.Small"
                                        Disabled="@(IsMutationBlocked || isOpeningCapabilityWizard)"
                                        Click="@(() => RunFor(renderedSession, () => OpenCapabilityWizardAsync(CapabilityKind.Skill)))"
                                        data-testid="agents-details-new-skill" />
                            </Cluster>

                            @if (AssignableCapabilities.Count > 0)
                            {
                                <FilterBar ResultText="@($"{FilteredAssignableCapabilities.Count} matching capability(s)")">
                                    <div class="agent-details-dialog__capability-filters">
                                        <input @bind="capabilitySearch"
                                               @bind:event="oninput"
                                               class="cda-input agent-details-dialog__capability-filter-input"
                                               placeholder="Search capabilities"
                                               data-testid="agents-details-capability-search" />
                                        <InputSelect @bind-Value="capabilityAssignmentFilter"
                                                     class="cda-input agent-details-dialog__capability-filter-select"
                                                     data-testid="agents-details-capability-assignment-filter">
                                            <option value="@CapabilityDialogAssignmentFilter.All">All assignments</option>
                                            <option value="@CapabilityDialogAssignmentFilter.Attached">Attached</option>
                                            <option value="@CapabilityDialogAssignmentFilter.Available">Available</option>
                                        </InputSelect>
                                        <InputSelect @bind-Value="capabilityKindFilter"
                                                     class="cda-input agent-details-dialog__capability-filter-select"
                                                     data-testid="agents-details-capability-kind-filter">
                                            <option value="@CapabilityDialogKindFilter.All">All kinds</option>
                                            <option value="@CapabilityDialogKindFilter.Tool">Tool</option>
                                            <option value="@CapabilityDialogKindFilter.Skill">Skill</option>
                                            <option value="@CapabilityDialogKindFilter.Mcp">MCP server</option>
                                        </InputSelect>
                                        <Button Text="Reset"
                                                ButtonStyle="ButtonStyle.Light"
                                                Size="ButtonSize.Small"
                                                Click="() => ChangeFor(renderedSession, ResetCapabilityFilters)"
                                                data-testid="agents-details-capability-filter-reset" />
                                    </div>
                                </FilterBar>
                            }

                            @if (AssignableCapabilities.Count == 0)
                            {
                                <EmptyState Eyebrow="No capabilities"
                                            Title="No tools, skills, or MCP servers are cataloged yet"
                                            Description="Use the guided setup actions above to create the first capability for this agent." />
                            }
                            else if (FilteredAssignableCapabilities.Count == 0)
                            {
                                <EmptyState Eyebrow="No matches"
                                            Title="No capabilities match the current filters"
                                            Description="Clear search, assignment, or kind filters to broaden the catalog." />
                            }
                            else
                            {
                                <AgentCapabilityList Items="@FilteredAssignableCapabilities"
                                                     AttachedCapabilityIds="@editorModel.SelectedCapabilityIds"
                                                     IsBusy="@IsMutationBlocked"
                                                     CanVerify="@editorModel.Id.HasValue"
                                                     AssignmentRequested="value => RunFor(renderedSession, () => ToggleCapabilityAsync(value))"
                                                     VerificationRequested="value => RunFor(renderedSession, () => VerifyCapabilityAsync(value))"
                                                     TestIdPrefix="agents-details-capability"
                                                     ColumnTemplateLg="repeat(2,minmax(16rem,1fr))" />
                            }
                        </FormSection>
                break;
            }
        }
    </DeferredSection>
</AgentEditorCoreSurface>

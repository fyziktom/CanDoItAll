@using CanDoItAll.AgentFramework.Editor.UI
@{
    var renderedSession = session;
    var renderedProvider = SelectedRuntimeProvider;
    var renderedProviderRevision = providerSelectionRevision;
}
<AgentEditorCoreSurface State="@CreateCoreState(renderedSession)">
    <AvatarActions Context="slot">
        @if (IsCurrent(renderedSession) && slot.Origin == renderedSession.Origin) {
            <AvatarPicker @key="renderedSession.Origin" OwnerLifetime="renderedSession.CancellationToken" Value="@slot.Draft.AvatarImageUrl"
                          ValueChanged="value => HandleAvatarChangedAsync(renderedSession, value)"
                          EntityName="@slot.Draft.Name"
                          EntityDescription="@slot.Draft.RoleTitle"
                          EntityKind="Agent"
                          GenerationSource="@AvatarGenerationSource"
                          Disabled="@isBusy"
                          TestIdPrefix="agents-catalog-avatar" />
        }
    </AvatarActions>
    <ProviderRefresh Context="slot">
        @if (IsCurrent(renderedSession) && slot.Origin == renderedSession.Origin && renderedProvider is { IsSourceManaged: true } sharedProvider) {
            <SharedProviderRefreshButton @key="sharedProvider.Id" ProviderId="sharedProvider.Id"
                Refreshed="delivery => delivery.ReconcileAsync(() => RefreshRuntimeProvidersAsync(renderedSession, sharedProvider.Id, renderedProviderRevision))" />
        }
    </ProviderRefresh>
    <DeferredSection Context="slot">
        @if (IsCurrent(renderedSession) && slot.Origin == renderedSession.Origin) {
            <AgentEditorAccessSurface State="@CreateAccessState(renderedSession)" Section="slot.Section">
                <Memory><AgentMemorySettingsPanel Value="@slot.Draft.MemoryAccess" State="renderedSession.Memory" OwnerLifetime="renderedSession.CancellationToken" EntryFormId="@renderedSession.EntryFormId" /></Memory>
                <ExternalRoots>
                    <ExternalWorkspaceRootSelectionField AllowedAliases="slot.Draft.WorkspaceToolAccess.AllowedExternalTargetAliases"
                        RootBindings="slot.Draft.WorkspaceToolAccess.ExternalTargetRootBindings" Entry="renderedSession.RootEntry"
                        OwnerLifetime="renderedSession.CancellationToken" EntryFormId="@renderedSession.EntryFormId"
                        SelectionChanged="selection => ApplyExternalWorkspaceRootSelection(renderedSession, selection)" />
                </ExternalRoots>
                <StorageSelection>
                    <CanDoItAll.Workspace.StorageSelection.UI.StorageCatalogSelectionField
                        Value="slot.Draft.WorkspaceToolAccess.AllowedStorageCatalogIds" OwnerLifetime="renderedSession.CancellationToken"
                        ValueChanged="selection => ApplyStorageCatalogSelection(renderedSession, selection)"
                        AllowAll="slot.Draft.WorkspaceToolAccess.AllowAllStorageCatalogs" DataTestId="agents-catalog-storage-selection" />
                </StorageSelection>
                <CapabilityList Context="items">
                    <AgentCapabilityList Items="items" AttachedCapabilityIds="slot.Draft.SelectedCapabilityIds"
                        IsBusy="IsMutationBlocked" CanVerify="slot.Draft.Id.HasValue"
                        AssignmentRequested="value => RunFor(renderedSession, () => ToggleCapabilityAsync(value))"
                        VerificationRequested="value => RunFor(renderedSession, () => VerifyCapabilityAsync(value))"
                        TestIdPrefix="agents-details-capability" ColumnTemplateLg="repeat(2,minmax(16rem,1fr))" />
                </CapabilityList>
            </AgentEditorAccessSurface>
        }
    </DeferredSection>
</AgentEditorCoreSurface>

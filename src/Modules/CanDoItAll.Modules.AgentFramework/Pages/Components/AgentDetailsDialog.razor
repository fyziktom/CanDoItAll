@if (isLoading)
{
    <SurfaceCard Soft="true" data-testid="agents-details-loading">
        <TextBlock TextStyle="TextStyle.EyebrowCaption" Value="Loading agent" />
        <h3 class="mt-1 text-lg font-semibold text-slate-950">Preparing technical editor</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">
            AgentFramework is loading the selected technical record and runtime catalogs.
        </p>
    </SurfaceCard>
}
else
{
    <EditForm Model="editorModel" OnValidSubmit="SaveAgentAsync">
        <ConversationDefinitionEditorShell Class="agent-details-dialog min-h-0">
            <Header>
                @if (linkedPartyId.HasValue)
                {
                    <Alert AlertStyle="AlertStyle.Info">
                        <p class="font-semibold">Bound CRM-HR resource</p>
                        <p class="mt-1">This technical agent is linked to business resource <a class="text-slate-900 underline" href="@($"/crm-hr/agents?partyId={linkedPartyId.Value:D}")">/crm-hr/agents</a>.</p>
                    </Alert>
                }
            </Header>
            <Sections>
                <Tabs data-testid="agents-details-tabs"
                  SelectedIndex="@selectedTabIndex"
                  SelectedIndexChanged="HandleSelectedTabIndexChanged"
                  Density="@(TabsDensity.Compact)"
                  BorderMode="@(TabsBorderMode.Soft)"
                  Tone="@(TabsTone.Info)"
                  OverflowMode="@(TabsOverflowMode.Scroll)"
                  PanelOverflowMode="@(TabsPanelOverflowMode.Auto)"
                  FillHeight="true"
                  Class="agent-details-dialog__tabs w-full min-w-0 flex-1 min-h-0"
                  AriaLabel="Agent details sections">
                <TabItems>
                    <TabsItem Text="Identity">
                        <FormSection Title="Identity" Description="Keep the technical identity explicit and strongly typed. Business metadata stays in CRM-HR; runtime behavior lives here.">
                            <ConversationIdentityFields Name="@editorModel.Name"
                                                        NameChanged="HandleNameChangedAsync"
                                                        Role="@editorModel.RoleTitle"
                                                        RoleChanged="HandleRoleChangedAsync"
                                                        Summary="@editorModel.Summary"
                                                        SummaryChanged="HandleSummaryChangedAsync"
                                                        Instructions="@editorModel.Instructions"
                                                        InstructionsChanged="HandleInstructionsChangedAsync"
                                                        Avatar="@IdentityAvatar"
                                                        AvatarStatus="@ResolveAvatarSelectionText()"
                                                        AvatarDescription="Stored with the technical agent identity and reused by runtime surfaces."
                                                        RoleLabel="Role title"
                                                        InstructionsLabel="Instructions"
                                                        NameTestId="agents-catalog-name"
                                                        RoleTestId="agents-catalog-role"
                                                        AvatarTestId="agents-catalog-avatar-summary"
                                                        SummaryTestId="agents-catalog-summary"
                                                        InstructionsTestId="agents-catalog-instructions">
                                <AvatarActions>
                                    <AvatarPicker Value="@editorModel.AvatarImageUrl"
                                                  ValueChanged="HandleAvatarChangedAsync"
                                                  EntityName="@editorModel.Name"
                                                  EntityDescription="@editorModel.RoleTitle"
                                                  EntityKind="Agent"
                                                  GenerationSource="@AvatarGenerationSource"
                                                  Disabled="@isBusy"
                                                  TestIdPrefix="agents-catalog-avatar" />
                                </AvatarActions>
                                <AdditionalFields>
                                    <FormField Text="Tags"
                                               data-testid="agents-catalog-tags-section">
                                        <TagEditor Value="@tagValues"
                                                   ValueChanged="HandleTagsChangedAsync"
                                                   Suggestions="@VisibleTagSuggestions"
                                                   Placeholder="Add agent tag"
                                                   Hint="Use Enter or comma to add tags. Favorites are managed with the star action in Switch Agent."
                                                   MaxTags="12"
                                                   TestId="agents-catalog-tags"
                                                   InputTestId="agents-catalog-tags-input" />
                                    </FormField>
                                </AdditionalFields>
                            </ConversationIdentityFields>
                        </FormSection>
                    </TabsItem>

                    <TabsItem Text="Runtime">
                        <FormSection Title="Runtime" Description="Pick the provider and model that the imported AgentFramework runtime will actually execute.">
                            <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                <ConversationProviderSelector Options="@RuntimeProviderOptions"
                                                              Value="@SelectedRuntimeProviderKey"
                                                              ValueChanged="HandleRuntimeProviderPresentationChangedAsync"
                                                              IsLoading="@(!areProvidersLoaded && string.IsNullOrWhiteSpace(providerLoadErrorMessage))"
                                                              LoadingMessage="Loading providers for runtime binding..."
                                                              ErrorMessage="@providerLoadErrorMessage"
                                                              InputTestId="agents-catalog-provider" />
                                <ProviderModelSelector Provider="@SelectedRuntimeProvider"
                                                       Value="@editorModel.Model"
                                                       ValueChanged="HandleRuntimeModelChangedAsync"
                                                       Disabled="@(!areProvidersLoaded && string.IsNullOrWhiteSpace(providerLoadErrorMessage))"
                                                       TestId="agents-catalog-model-selector"
                                                       ChoiceTestId="agents-catalog-model-choice"
                                                       OverrideTestId="agents-catalog-model-override"
                                                       CustomModelTestId="agents-catalog-model" />
                            </Grid>

                            <AgentThinkingEffortSettings Provider="@SelectedRuntimeProvider"
                                                         Model="@editorModel.Model"
                                                         Value="@editorModel.ThinkingEffortOverride"
                                                         ValueChanged="HandleThinkingEffortChangedAsync"
                                                         Disabled="@(!areProvidersLoaded && string.IsNullOrWhiteSpace(providerLoadErrorMessage))"
                                                         TestId="agents-catalog-thinking-effort"
                                                         SupportTestId="agents-catalog-thinking-effort-support" />

                            <Grid Gap="LayoutGap.Large" ColumnsMd="3">
                                <div>
                                    <FormField Text="Status">
                                    <InputSelect @bind-Value="editorModel.Status" class="ui-input">
                                        @foreach (var status in Enum.GetValues<AgentLifecycleStatus>())
                                        {
                                            <option value="@status">@status</option>
                                        }
                                    </InputSelect>
                                    </FormField>
                                </div>
                                <div>
                                    <FormField Text="Workload">
                                    <InputSelect @bind-Value="editorModel.Workload" class="ui-input">
                                        @foreach (var workload in Enum.GetValues<AgentWorkloadKind>())
                                        {
                                            <option value="@workload">@workload</option>
                                        }
                                    </InputSelect>
                                    </FormField>
                                </div>
                                <div>
                                    <FormField Text="Chat history">
                                    <InputSelect @bind-Value="editorModel.ChatHistoryMode" class="ui-input">
                                        @foreach (var mode in Enum.GetValues<AgentChatHistoryMode>())
                                        {
                                            <option value="@mode">@mode</option>
                                        }
                                    </InputSelect>
                                    </FormField>
                                </div>
                            </Grid>

                            @if (SelectedRuntimeProvider is { } runtimeProvider)
                            {
                                <Alert AlertStyle="AlertStyle.Info">
                                    <p class="font-semibold">Runtime parameter policy</p>
                                    <p class="mt-1">@DescribeRuntimeParameterPolicy(runtimeProvider)</p>
                                </Alert>
                            }

                            <SurfaceCard Soft="true" data-testid="agents-catalog-approval-policy">
                                <Stack GapScale="LayoutGap.Small">
                                    <TextBlock TextStyle="TextStyle.Eyebrow" Value="Approval policy" />
                                    <CheckboxOption TValue="bool" Value="@editorModel.Permissions.RequiresApprovalForExternalCalls" ValueChanged="value => ToggleExternalCallApprovalRequirement(value)" data-testid="agents-catalog-require-external-approval">
                                        Require approval for external calls
                                    </CheckboxOption>
                                    <CheckboxOption TValue="bool" Value="@editorModel.Permissions.AutoApproveExternalCallsByDefault" ValueChanged="value => HandleAutoApprovalChangedAsync(value)" Disabled="@isConfirmingAutoApproval" @key="autoApprovalInputVersion"
                                               data-testid="agents-catalog-auto-approval">
                                        Auto-approve approval-required tool calls by default
                                    </CheckboxOption>
                                    <TextBlock TextStyle="TextStyle.Body2"
                                               Value="Per-run approval choices remain available in chat. This setting changes the default for every new run of this agent." />

                                    @if (editorModel.Permissions.AutoApproveExternalCallsByDefault)
                                    {
                                        <Alert AlertStyle="AlertStyle.Warning" data-testid="agents-catalog-auto-approval-warning">
                                            <p class="font-semibold">Automatic approval is enabled</p>
                                            <p class="mt-1">This agent can continue approval-required tool calls without asking for each call. Scope and runtime policy checks still apply.</p>
                                        </Alert>
                                    }
                                </Stack>
                            </SurfaceCard>
                        </FormSection>
                    </TabsItem>

                    <TabsItem Text="Memory">
                        <AgentMemorySettingsPanel Value="@editorModel.MemoryAccess" />
                    </TabsItem>

                    <TabsItem Text="Images">
                        <FormSection Title="Image Generation" Description="Control whether this agent may generate image deliverables and which image provider it should use.">
                            <Grid Gap="LayoutGap.Large" ColumnsMd="3" data-testid="agents-catalog-image-generation-access">
                                <div class="app-admin-subpanel">
                                    <TextBlock TextStyle="TextStyle.EyebrowCaption" Class="mb-2" Value="Access" />
                                    <Stack GapScale="LayoutGap.Small">
                                        <CheckboxOption TValue="bool" Value="@editorModel.ImageGenerationAccess.CanGenerateImages" ValueChanged="value => ToggleImageGenerationAccess(value)" data-testid="agents-catalog-image-generation-enabled">
                                            Can generate images
                                        </CheckboxOption>
                                        <CheckboxOption TValue="bool" Value="@editorModel.ImageGenerationAccess.CanStoreImagesAsProjectAssets" ValueChanged="value => ToggleImageProjectAssetStorage(value)" data-testid="agents-catalog-image-generation-project-assets">
                                            Can store generated images as project assets
                                        </CheckboxOption>
                                    </Stack>
                                </div>
                                <div class="app-admin-subpanel md:col-span-2">
                                    <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                        <ConversationProviderSelector Options="@ImageGenerationProviderPresentationOptions"
                                                                      Value="@SelectedImageGenerationProviderKey"
                                                                      ValueChanged="HandleImageGenerationProviderPresentationChangedAsync"
                                                                      Label="Image provider"
                                                                      NoneLabel="Choose recommended image provider on save"
                                                                      ShowDisabledStatus="true"
                                                                      Disabled="@(!editorModel.ImageGenerationAccess.CanGenerateImages)"
                                                                      IsLoading="@(!areProvidersLoaded && string.IsNullOrWhiteSpace(providerLoadErrorMessage))"
                                                                      LoadingMessage="Loading image-generation providers..."
                                                                      ErrorMessage="@providerLoadErrorMessage"
                                                                      EmptyMessage="No image-generation provider profiles are configured."
                                                                      InputTestId="agents-catalog-image-generation-provider" />
                                        <ProviderModelSelector Provider="@SelectedImageGenerationProvider"
                                                               Value="@editorModel.ImageGenerationAccess.DefaultModel"
                                                               ValueChanged="HandleImageGenerationModelChangedAsync"
                                                               Disabled="@(!editorModel.ImageGenerationAccess.CanGenerateImages || SelectedImageGenerationProvider is null)"
                                                               Label="Image model"
                                                               TestId="agents-catalog-image-model-selector"
                                                               ChoiceTestId="agents-catalog-image-model-choice"
                                                               OverrideTestId="agents-catalog-image-model-override"
                                                               CustomModelTestId="agents-catalog-image-model" />
                                    </Grid>

                                    <Alert AlertStyle="AlertStyle.Info" Class="mt-4">
                                        <p class="font-semibold">Image provider policy</p>
                                        <p class="mt-1">@DescribeImageGenerationProviderChoice()</p>
                                    </Alert>

                                    @{
                                        var imageGenerationWarning = ResolveImageGenerationWarning();
                                    }
                                    @if (!string.IsNullOrWhiteSpace(imageGenerationWarning))
                                    {
                                        <Alert AlertStyle="AlertStyle.Warning" Class="mt-3">
                                            <p class="font-semibold">Image generation configuration needs attention</p>
                                            <p class="mt-1">@imageGenerationWarning</p>
                                        </Alert>
                                    }
                                </div>
                            </Grid>
                        </FormSection>
                    </TabsItem>

                    <TabsItem Text="Project Structure Access">
                        <FormSection Title="Project Structure Access" Description="Project reads, project creation, subproject creation, non-task structure changes, task-only changes, and unrestricted changes are separate permissions. Advanced plan and cost analysis additionally requires its assigned planning skill and tool capability.">
                            <Grid Gap="LayoutGap.Large" ColumnsMd="3" data-testid="agents-catalog-project-structure-access">
                                <div class="app-admin-subpanel">
                                    <TextBlock TextStyle="TextStyle.EyebrowCaption" Class="mb-2" Value="Access mode" />
                                    <Stack GapScale="LayoutGap.Small">
                                        <CheckboxOption TValue="bool" Value="@editorModel.ProjectStructureAccess.CanRead" ValueChanged="value => ToggleProjectStructureRead(value)" data-testid="agents-catalog-project-structure-read">
                                            Can read project structure
                                        </CheckboxOption>
                                        <CheckboxOption TValue="bool" Value="@editorModel.ProjectStructureAccess.CanCreateProjects" ValueChanged="value => ToggleProjectCreation(value)" data-testid="agents-catalog-project-create">
                                            Can create standalone projects
                                        </CheckboxOption>
                                        <CheckboxOption TValue="bool" Value="@editorModel.ProjectStructureAccess.CanCreateSubprojects" ValueChanged="value => ToggleSubprojectCreation(value)" data-testid="agents-catalog-subproject-create">
                                            Can create subprojects under allowed projects
                                        </CheckboxOption>
                                        <CheckboxOption TValue="bool" Value="@(editorModel.ProjectStructureAccess.CanWrite || editorModel.ProjectStructureAccess.CanWriteNonTaskStructure)" ValueChanged="value => ToggleProjectStructureNonTaskWrite(value)" Disabled="@editorModel.ProjectStructureAccess.CanWrite" data-testid="agents-catalog-project-structure-non-task-write">
                                            Can write project structure except tasks
                                        </CheckboxOption>
                                        <CheckboxOption TValue="bool" Value="@(editorModel.ProjectStructureAccess.CanWrite || editorModel.ProjectStructureAccess.CanWriteTasks)" ValueChanged="value => ToggleProjectStructureTaskWrite(value)" Disabled="@editorModel.ProjectStructureAccess.CanWrite" data-testid="agents-catalog-project-structure-task-write">
                                            Can write project tasks
                                        </CheckboxOption>
                                        <CheckboxOption TValue="bool" Value="@editorModel.ProjectStructureAccess.CanWrite" ValueChanged="value => ToggleProjectStructureWrite(value)" data-testid="agents-catalog-project-structure-write">
                                            Can write entire project structure (includes tasks)
                                        </CheckboxOption>
                                        <CheckboxOption TValue="bool" Value="@editorModel.ProjectStructureAccess.AllowAllProjects" ValueChanged="value => ToggleProjectStructureAllowAll(value)" data-testid="agents-catalog-project-structure-all">
                                            Allow all current and future projects
                                        </CheckboxOption>
                                    </Stack>
                                </div>
                                <div class="app-admin-subpanel md:col-span-2">
                                    <Split Breakpoint="LayoutBreakpoint.Md"
                                           Gap="LayoutGap.Medium"
                                           AlignItems="AlignItems.Center"
                                           JustifyContent="JustifyContent.SpaceBetween"
                                           Wrap="FlexWrap.Wrap">
                                        <div>
                                            <TextBlock TextStyle="TextStyle.EyebrowCaption" Class="mb-1" Value="Allowed projects" />
                                            <p class="text-sm leading-6 text-slate-600">
                                                @DescribeProjectStructureScope(editorModel)
                                            </p>
                                        </div>
                                        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                            <Button Text="Select all"
                                                    Tone="ButtonTone.Default"
                                                    Size="ButtonSize.Small"
                                                    Click="SelectAllProjectStructureProjects"
                                                    Disabled="@(!areProjectStructureProjectsLoaded || isLoadingProjectStructureProjects || !string.IsNullOrWhiteSpace(projectStructureProjectsErrorMessage) || editorModel.ProjectStructureAccess.AllowAllProjects)" />
                                            <Button Text="Clear"
                                                    Tone="ButtonTone.Default"
                                                    Size="ButtonSize.Small"
                                                    Click="ClearProjectStructureProjects"
                                                    Disabled="@(!areProjectStructureProjectsLoaded || isLoadingProjectStructureProjects || !string.IsNullOrWhiteSpace(projectStructureProjectsErrorMessage) || editorModel.ProjectStructureAccess.AllowAllProjects)" />
                                        </Cluster>
                                    </Split>

                                    @if (editorModel.ProjectStructureAccess.AllowAllProjects)
                                    {
                                        <div class="mt-3 app-admin-empty">
                                            This agent can access all current and future projects. Turn off the all-projects option to manage a specific allowlist.
                                        </div>
                                    }
                                    else if (!projectStructureProjectsRequested)
                                    {
                                        <div class="mt-3 app-admin-empty">
                                            Load the project list only when you need to inspect or change the access scope.
                                        </div>
                                        <Cluster Gap="LayoutGap.Small"
                                                 Wrap="FlexWrap.Wrap"
                                                 Class="mt-3">
                                            <Button Text="Load project list"
                                                    Tone="ButtonTone.Default"
                                                    Size="ButtonSize.Small"
                                                    Click="RequestProjectStructureProjectsAsync"
                                                    Disabled="@isLoadingProjectStructureProjects"
                                                    IsBusy="@isLoadingProjectStructureProjects"
                                                    data-testid="agents-catalog-project-structure-load" />
                                        </Cluster>
                                    }
                                    else if (!areProjectStructureProjectsLoaded &&
                                             string.IsNullOrWhiteSpace(projectStructureProjectsErrorMessage))
                                    {
                                        <div class="mt-3 app-admin-empty">
                                            Loading projects that can be granted to this agent...
                                        </div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(projectStructureProjectsErrorMessage))
                                    {
                                        <div class="mt-3 app-admin-empty text-rose-700">
                                            @projectStructureProjectsErrorMessage
                                        </div>
                                        <Cluster Gap="LayoutGap.Small"
                                                 Wrap="FlexWrap.Wrap"
                                                 Class="mt-3">
                                            <Button Text="Retry project list"
                                                    Tone="ButtonTone.Default"
                                                    Size="ButtonSize.Small"
                                                    Click="RequestProjectStructureProjectsAsync"
                                                    Disabled="@isLoadingProjectStructureProjects"
                                                    IsBusy="@isLoadingProjectStructureProjects" />
                                        </Cluster>
                                    }
                                    else if (projectStructureProjects.Count == 0)
                                    {
                                        <div class="mt-3 app-admin-empty">
                                            No projects exist yet. Create a project before granting project-structure access.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mt-3 max-h-64 overflow-y-auto rounded-2xl border border-slate-200 bg-white p-4"
                                             data-testid="agents-catalog-project-structure-projects">
                                            <Stack GapScale="LayoutGap.Small">
                                                @foreach (var project in projectStructureProjects)
                                                {
                                                    <CheckboxOption TValue="bool" Value="@HasProjectStructureProjectAccess(project.Id)" ValueChanged="value => ToggleProjectStructureProject(project.Id, value)" Muted="true">
                                                        @project.Name
                                                    </CheckboxOption>
                                                }
                                            </Stack>
                                        </div>
                                    }
                                </div>
                            </Grid>
                        </FormSection>
                    </TabsItem>

                    <TabsItem Text="Workspace Tools">
                        <FormSection Title="Workspace Tools" Description="These settings decide whether the current agent receives native workspace file tools, external workspace roots, and storage-driver tools.">
                            <Grid Gap="LayoutGap.Large" ColumnsMd="3" data-testid="agents-catalog-workspace-tools">
                                <div class="app-admin-subpanel">
                                    <FormField Text="Access profile">
                                    <select id="agents-catalog-workspace-profile"
                                            class="ui-input mt-2"
                                            aria-label="Access profile"
                                            value="@editorModel.WorkspaceToolAccess.Profile"
                                            @onchange="args => ChangeWorkspaceToolProfile(args.Value)"
                                            data-testid="agents-catalog-workspace-profile">
                                        @foreach (var profile in WorkspaceToolProfileOptions)
                                        {
                                            <option value="@profile">@FormatWorkspaceToolProfile(profile)</option>
                                        }
                                    </select>
                                    </FormField>
                                    <p class="mt-3 text-sm leading-6 text-slate-600">
                                        @DescribeWorkspaceExecutionScope(editorModel)
                                    </p>
                                </div>
                                <div class="app-admin-subpanel md:col-span-2">
                                    <TextBlock TextStyle="TextStyle.EyebrowCaption" Class="mb-2" Value="Execution tools" />
                                    <Grid Gap="LayoutGap.Small" ColumnsMd="2">
                                        <CheckboxOption TValue="bool" Value="@editorModel.WorkspaceToolAccess.CanRunValidationCommands" ValueChanged="value => ToggleWorkspaceValidationCommands(value)" data-testid="agents-catalog-workspace-validation">
                                            Can run build, test, and app commands
                                        </CheckboxOption>
                                        <CheckboxOption TValue="bool" Value="@editorModel.WorkspaceToolAccess.CanRunLocalScripts" ValueChanged="value => ToggleWorkspaceLocalScripts(value)" data-testid="agents-catalog-workspace-scripts">
                                            Can run local scripts
                                        </CheckboxOption>
                                        <CheckboxOption TValue="bool" Value="@editorModel.WorkspaceToolAccess.CanScaffoldProjects" ValueChanged="value => ToggleWorkspaceScaffoldProjects(value)" data-testid="agents-catalog-workspace-scaffold">
                                            Can scaffold projects
                                        </CheckboxOption>
                                        <CheckboxOption TValue="bool" Value="@editorModel.WorkspaceToolAccess.CanManageWorkspacePaths" ValueChanged="value => ToggleWorkspaceManagePaths(value)" data-testid="agents-catalog-workspace-manage-paths">
                                            Can move, copy, and delete paths
                                        </CheckboxOption>
                                        <CheckboxOption TValue="bool" Value="@editorModel.WorkspaceToolAccess.CanTransformArtifacts" ValueChanged="value => ToggleWorkspaceTransformArtifacts(value)" data-testid="agents-catalog-workspace-transform">
                                            Can transform artifacts
                                        </CheckboxOption>
                                    </Grid>
                                </div>
                                <div class="app-admin-subpanel">
                                    <TextBlock TextStyle="TextStyle.EyebrowCaption" Class="mb-2" Value="File access" />
                                    <Stack GapScale="LayoutGap.Small">
                                        <CheckboxOption TValue="bool" Value="@editorModel.WorkspaceToolAccess.CanReadFiles" ValueChanged="value => ToggleWorkspaceFileRead(value)" data-testid="agents-catalog-workspace-read">
                                            Can browse and read files
                                        </CheckboxOption>
                                        <CheckboxOption TValue="bool" Value="@editorModel.WorkspaceToolAccess.CanWriteFiles" ValueChanged="value => ToggleWorkspaceFileWrite(value)" data-testid="agents-catalog-workspace-write">
                                            Can write files
                                        </CheckboxOption>
                                    </Stack>
                                    <p class="mt-3 text-sm leading-6 text-slate-600">
                                        @DescribeWorkspaceFileScope(editorModel)
                                    </p>
                                </div>
                                <div class="app-admin-subpanel md:col-span-2">
                                    <ExternalWorkspaceRootSelectionField
                                        AllowedAliases="@editorModel.WorkspaceToolAccess.AllowedExternalTargetAliases"
                                        RootBindings="@editorModel.WorkspaceToolAccess.ExternalTargetRootBindings"
                                        SelectionChanged="ApplyExternalWorkspaceRootSelection"
                                        DataTestId="agents-catalog-workspace-external-roots" />
                                </div>
                                <div class="app-admin-subpanel">
                                    <TextBlock TextStyle="TextStyle.EyebrowCaption" Class="mb-2" Value="Storage access" />
                                    <Stack GapScale="LayoutGap.Small">
                                        <CheckboxOption TValue="bool" Value="@editorModel.WorkspaceToolAccess.CanReadStorage" ValueChanged="value => ToggleStorageRead(value)" data-testid="agents-catalog-storage-read">
                                            Can read storage driver catalogs
                                        </CheckboxOption>
                                        <CheckboxOption TValue="bool" Value="@editorModel.WorkspaceToolAccess.CanWriteStorage" ValueChanged="value => ToggleStorageWrite(value)" data-testid="agents-catalog-storage-write">
                                            Can write storage driver objects
                                        </CheckboxOption>
                                        <CheckboxOption TValue="bool" Value="@editorModel.WorkspaceToolAccess.AllowAllStorageCatalogs" ValueChanged="value => ToggleStorageAllowAll(value)" data-testid="agents-catalog-storage-all">
                                            Allow all storage catalogs
                                        </CheckboxOption>
                                    </Stack>
                                    <p class="mt-3 text-sm leading-6 text-slate-600">
                                        @DescribeStorageScope(editorModel)
                                    </p>
                                </div>
                                <div class="app-admin-subpanel md:col-span-2">
                                    <StorageCatalogSelectionField
                                        Value="@editorModel.WorkspaceToolAccess.AllowedStorageCatalogIds"
                                        ValueChanged="ApplyStorageCatalogSelection"
                                        AllowAll="@editorModel.WorkspaceToolAccess.AllowAllStorageCatalogs"
                                        DataTestId="agents-catalog-storage-selection" />
                                </div>
                            </Grid>
                        </FormSection>
                    </TabsItem>

                    <TabsItem Text="Secrets">
                        <FormSection Title="Secrets" Description="Grant only the stored secrets this agent may request during explicit runtime actions. Values are not stored in the agent definition.">
                            <Grid Gap="LayoutGap.Large" ColumnsMd="3" data-testid="agents-catalog-secrets">
                                <div class="app-admin-subpanel">
                                    <TextBlock TextStyle="TextStyle.EyebrowCaption" Class="mb-2" Value="Allowed secrets" />
                                    <p class="text-sm leading-6 text-slate-600">
                                        @DescribeSecretScope(editorModel)
                                    </p>
                                </div>
                                <div class="app-admin-subpanel md:col-span-2">
                                    @if (isLoadingSecrets && !areSecretsLoaded)
                                    {
                                        <div class="app-admin-empty">
                                            Loading stored secrets...
                                        </div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(secretsErrorMessage))
                                    {
                                        <div class="app-admin-empty text-rose-700">
                                            @secretsErrorMessage
                                        </div>
                                    }
                                    else if (secrets.Count == 0)
                                    {
                                        <div class="app-admin-empty">
                                            No stored secrets exist yet.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="max-h-64 overflow-y-auto rounded-2xl border border-slate-200 bg-white p-4"
                                             data-testid="agents-catalog-secret-list">
                                            <Stack GapScale="LayoutGap.Small">
                                                @foreach (var secret in secrets)
                                                {
                                                    <CheckboxOption TValue="bool" Value="@HasAllowedSecret(secret.Id)" ValueChanged="value => ToggleAllowedSecret(secret, value)" Muted="true">
                                                        @secret.Name
                                                        <span class="text-slate-500">(@secret.Kind)</span>
                                                    </CheckboxOption>
                                                }
                                            </Stack>
                                        </div>
                                    }
                                </div>
                            </Grid>
                        </FormSection>
                    </TabsItem>

                    <TabsItem Text="Process Access">
                        <FormSection Title="Process Access" Description="Internal agents always carry the process-module tool family. These settings decide whether the current agent can read or mutate process data and which process definitions it may touch.">
                            <Grid Gap="LayoutGap.Large" ColumnsMd="3" data-testid="agents-catalog-process-access">
                                <div class="app-admin-subpanel">
                                    <TextBlock TextStyle="TextStyle.EyebrowCaption" Class="mb-2" Value="Access mode" />
                                    <Stack GapScale="LayoutGap.Small">
                                        <CheckboxOption TValue="bool" Value="@editorModel.ProcessAccess.CanRead" ValueChanged="value => ToggleProcessRead(value)" data-testid="agents-catalog-process-read">
                                            Can read processes
                                        </CheckboxOption>
                                        <CheckboxOption TValue="bool" Value="@editorModel.ProcessAccess.CanWrite" ValueChanged="value => ToggleProcessWrite(value)" data-testid="agents-catalog-process-write">
                                            Can write processes
                                        </CheckboxOption>
                                        <CheckboxOption TValue="bool" Value="@editorModel.ProcessAccess.AllowAllDefinitions" ValueChanged="value => ToggleProcessAllowAll(value)" data-testid="agents-catalog-process-all">
                                            Allow all current and future processes
                                        </CheckboxOption>
                                    </Stack>
                                </div>
                                <div class="app-admin-subpanel md:col-span-2">
                                    <TextBlock TextStyle="TextStyle.EyebrowCaption" Class="mb-1" Value="Allowed processes" />
                                    <p class="text-sm leading-6 text-slate-600">
                                        @DescribeProcessScope(editorModel)
                                    </p>
                                    <div class="mt-3 app-admin-empty">
                                        Process definition selection is unavailable while the Process module is rebuilt. Existing stored access metadata is preserved.
                                    </div>
                                </div>
                            </Grid>
                        </FormSection>
                    </TabsItem>

                    <TabsItem Text="Capabilities">
                        <FormSection Title="Capabilities" Description="Attach cataloged tools, skills, and MCP servers to this agent, or open the guided setup flow to create and assign one.">
                            <div data-testid="agents-details-capability-summary">
                                <CompactStatStrip>
                                    <CompactStat Label="attached"
                                                 Value="@editorModel.SelectedCapabilityIds.Count.ToString()"
                                                 TooltipText="Capabilities currently assigned to this agent."
                                                 Tone="info" />
                                    <CompactStat Label="skills"
                                                 Value="@capabilities.Count(item => item.Kind == CapabilityKind.Skill).ToString()"
                                                 TooltipText="Prompt and workflow skills in the catalog."
                                                 Tone="success" />
                                    <CompactStat Label="tools"
                                                 Value="@capabilities.Count(item => item.Kind == CapabilityKind.Tool).ToString()"
                                                 TooltipText="Runtime tools in the catalog."
                                                 Tone="accent" />
                                    <CompactStat Label="MCP servers"
                                                 Value="@capabilities.Count(item => item.Kind == CapabilityKind.McpServer).ToString()"
                                                 TooltipText="MCP tool surfaces in the catalog."
                                                 Tone="warning" />
                                    <CompactStat Label="verified"
                                                 Value="@capabilities.Count(item => item.ProofStatus == CapabilityProofStatus.Verified).ToString()"
                                                 TooltipText="Capabilities with successful proof status."
                                                 Tone="success" />
                                </CompactStatStrip>
                            </div>

                            <Cluster Gap="LayoutGap.Small"
                                     Wrap="FlexWrap.Wrap"
                                     Class="agent-details-dialog__capability-actions"
                                 data-testid="agents-details-new-capability">
                                <Button Text="New tool"
                                        Icon="build"
                                        Tone="ButtonTone.Default"
                                        Size="ButtonSize.Small"
                                        Disabled="@(isBusy || isOpeningCapabilityWizard)"
                                        Click="@(() => OpenCapabilityWizardAsync(CapabilityKind.Tool))"
                                        data-testid="agents-details-new-tool" />
                                <Button Text="New MCP"
                                        Icon="hub"
                                        Tone="ButtonTone.Default"
                                        Size="ButtonSize.Small"
                                        Disabled="@(isBusy || isOpeningCapabilityWizard)"
                                        Click="@(() => OpenCapabilityWizardAsync(CapabilityKind.McpServer))"
                                        data-testid="agents-details-new-mcp" />
                                <Button Text="New skill"
                                        Icon="psychology"
                                        Tone="ButtonTone.Default"
                                        Size="ButtonSize.Small"
                                        Disabled="@(isBusy || isOpeningCapabilityWizard)"
                                        Click="@(() => OpenCapabilityWizardAsync(CapabilityKind.Skill))"
                                        data-testid="agents-details-new-skill" />
                            </Cluster>

                            @if (AssignableCapabilities.Count > 0)
                            {
                                <FilterBar ResultText="@($"{FilteredAssignableCapabilities.Count} matching capability(s)")">
                                    <div class="agent-details-dialog__capability-filters">
                                        <input @bind="capabilitySearch"
                                               @bind:event="oninput"
                                               class="ui-input agent-details-dialog__capability-filter-input"
                                               placeholder="Search capabilities"
                                               data-testid="agents-details-capability-search" />
                                        <InputSelect @bind-Value="capabilityAssignmentFilter"
                                                     class="ui-input agent-details-dialog__capability-filter-select"
                                                     data-testid="agents-details-capability-assignment-filter">
                                            <option value="@CapabilityDialogAssignmentFilter.All">All assignments</option>
                                            <option value="@CapabilityDialogAssignmentFilter.Attached">Attached</option>
                                            <option value="@CapabilityDialogAssignmentFilter.Available">Available</option>
                                        </InputSelect>
                                        <InputSelect @bind-Value="capabilityKindFilter"
                                                     class="ui-input agent-details-dialog__capability-filter-select"
                                                     data-testid="agents-details-capability-kind-filter">
                                            <option value="@CapabilityDialogKindFilter.All">All kinds</option>
                                            <option value="@CapabilityDialogKindFilter.Tool">Tool</option>
                                            <option value="@CapabilityDialogKindFilter.Skill">Skill</option>
                                            <option value="@CapabilityDialogKindFilter.Mcp">MCP server</option>
                                        </InputSelect>
                                        <Button Text="Reset"
                                                Tone="ButtonTone.Default"
                                                Size="ButtonSize.Small"
                                                Click="ResetCapabilityFilters"
                                                data-testid="agents-details-capability-filter-reset" />
                                    </div>
                                </FilterBar>
                            }

                            @if (AssignableCapabilities.Count == 0)
                            {
                                <EmptyState Eyebrow="No capabilities"
                                            Title="No tools, skills, or MCP servers are cataloged yet"
                                            Description="Use the guided setup actions above to create the first capability for this agent." />
                            }
                            else if (FilteredAssignableCapabilities.Count == 0)
                            {
                                <EmptyState Eyebrow="No matches"
                                            Title="No capabilities match the current filters"
                                            Description="Clear search, assignment, or kind filters to broaden the catalog." />
                            }
                            else
                            {
                                <AgentCapabilityList Items="@FilteredAssignableCapabilities"
                                                     AttachedCapabilityIds="@editorModel.SelectedCapabilityIds"
                                                     IsBusy="@isBusy"
                                                     CanVerify="@editorModel.Id.HasValue"
                                                     AssignmentRequested="ToggleCapabilityAsync"
                                                     VerificationRequested="VerifyCapabilityAsync"
                                                     TestIdPrefix="agents-details-capability"
                                                     ColumnTemplateLg="repeat(2,minmax(16rem,1fr))" />
                            }
                        </FormSection>
                    </TabsItem>

                    <TabsItem Text="Voice">
                        <FormSection Title="Voice" Description="Allow this agent to participate in audio mode and optionally override the general text-to-speech voice.">
                            <Grid Gap="LayoutGap.Large" ColumnsMd="2" data-testid="agents-catalog-voice-access">
                                <div class="app-admin-subpanel">
                                    <TextBlock TextStyle="TextStyle.EyebrowCaption" Class="mb-2" Value="Voice access" />
                                    <Stack GapScale="LayoutGap.Small">
                                        <CheckboxOption TValue="bool" Value="@editorModel.VoiceAccess.CanUseVoiceMode" ValueChanged="value => ToggleVoiceModeAccess(value)" data-testid="agents-catalog-voice-enabled">
                                            Can use audio mode
                                        </CheckboxOption>
                                    </Stack>
                                </div>
                                <div class="app-admin-subpanel">
                                    <FormField Text="Voice override">
                                    <InputSelect @bind-Value="editorModel.VoiceAccess.PreferredVoiceId"
                                                 class="ui-input"
                                                 disabled="@(!editorModel.VoiceAccess.CanUseVoiceMode)"
                                                 data-testid="agents-catalog-voice-override">
                                        <option value="">Use general voice</option>
                                        @foreach (var voiceId in AgentVoiceDefaults.OpenAiVoiceIds)
                                        {
                                            <option value="@voiceId">@voiceId</option>
                                        }
                                    </InputSelect>
                                    </FormField>
                                    <p class="mt-2 text-sm leading-6 text-slate-600">
                                        When set, this voice takes priority over the general AgentFramework voice.
                                    </p>
                                </div>
                            </Grid>
                        </FormSection>
                    </TabsItem>

                </TabItems>
                </Tabs>
            </Sections>
            <Actions>
                <StickyActionFooter StatusLabel="Technical agents">
                    <SecondaryActions>
                        <Button Text="Clear" Tone="ButtonTone.Default" Click="ResetAgentAsync" />
                    </SecondaryActions>
                    <PrimaryActions>
                        <Button Text="Save agent"
                                Type="submit"
                                Disabled="@(isBusy || HasIncompatibleThinkingEffortOverride)"
                                IsBusy="@isBusy"
                                data-testid="agents-catalog-save" />
                    </PrimaryActions>
                    <DangerActions>
                        @if (editorModel.Id.HasValue && !IsManagedSeedAgent)
                        {
                            <Button Text="Delete"
                                    Icon="delete"
                                    Tone="ButtonTone.Danger"
                                    Disabled="@(isBusy || isConfirmingDelete)"
                                    IsBusy="@isBusy"
                                    Click="DeleteAgentAsync"
                                    data-testid="agents-catalog-delete" />
                        }
                    </DangerActions>
                </StickyActionFooter>
            </Actions>
        </ConversationDefinitionEditorShell>
    </EditForm>
}

@using System.Collections.Immutable
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject IAgentsWorkspaceQuery WorkspaceQuery
@inject ILogger<AgentUsageDialog> Logger

@if (isLoading) {
    <LoadingState Eyebrow="Consumer usage"
                  Title="Loading consumer usage"
                  Description="Combining Agent and Simple Chat usage for the selected scope." />
}
else if (!string.IsNullOrWhiteSpace(loadError)) {
    <EmptyState Eyebrow="Usage unavailable"
                Title="Consumer usage could not be loaded"
                Description="@loadError" />
}
else {
    <Stack GapScale="LayoutGap.Large"
           data-testid="agents-usage-dialog">
        @if (!snapshot.IsComplete) {
            <Alert AlertStyle="AlertStyle.Warning" data-testid="usage-dialog-partial">
                Some usage evidence is unavailable. Displayed totals are partial.
            </Alert>
        }
        <Grid Gap="LayoutGap.Medium"
              ColumnTemplate="repeat(auto-fit,minmax(9rem,1fr))">
            <MetricCard Label="Ranked consumers" Value="@AgentUsageDisplay.FormatCount(snapshot.Consumers.Count)" />
            <MetricCard Label="Executions" Value="@AgentUsageDisplay.FormatCount(snapshot.Totals.ExecutionCount)" />
            <MetricCard Label="Usage observations" Value="@AgentUsageDisplay.FormatCount(snapshot.Totals.UsageObservationCount)" />
            <MetricCard Label="Unknown observations" Value="@AgentUsageDisplay.FormatCount(snapshot.Totals.UnknownUsageObservationCount)" />
            <MetricCard Label="Tokens" Value="@AgentUsageDisplay.FormatTokens(snapshot.Totals.Tokens.TotalTokens)" />
            <MetricCard Label="Known cost" Value="@AgentUsageDisplay.FormatCost(snapshot.Totals.KnownCostUsd)" />
            <MetricCard Label="Unpriced" Value="@AgentUsageDisplay.FormatCount(snapshot.Totals.UnpricedObservationCount)" />
        </Grid>

        <CdaChart Title="Consumer execution ranking"
                  Description="Top Agents and Simple Chat definitions by execution count in the selected scope."
                  Series="@ConsumerExecutionSeries"
                  Options="@ConsumerExecutionChartOptions"
                  Height="320"
                  Class="w-full"
                  EmptyText="No consumer usage has been recorded." />

        <SurfaceCard Soft="true">
            @if (snapshot.Consumers.Count == 0) {
                <EmptyState Eyebrow="No usage"
                            Title="No consumer usage rows"
                            Description="Run an Agent or Simple Chat in the selected scope to populate this detail view." />
            }
            else {
                <DataGrid TItem="ProviderUsageConsumerRow"
                          Data="@ConsumerRows"
                          AllowPaging="true"
                          PageSize="10"
                          data-testid="agents-usage-dialog-grid">
                    <Columns>
                        <DataGridColumn TItem="ProviderUsageConsumerRow" Title="Consumer">
                            <Template Context="consumer">
                                <Stack Gap="0.15rem">
                                    <span class="font-medium text-slate-950">@consumer.ConsumerName</span>
                                    <span class="text-xs text-slate-500">@ResolveConsumerKind(consumer.ConsumerKind) · @AgentUsageDisplay.FormatLastUsed(consumer.LastUsedAtUtc)</span>
                                </Stack>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="ProviderUsageConsumerRow" Title="Executions">
                            <Template Context="consumer">
                                <span>@AgentUsageDisplay.FormatCount(consumer.Totals.ExecutionCount)</span>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="ProviderUsageConsumerRow" Title="Failed">
                            <Template Context="consumer">
                                <StatusBadge Tone="@(consumer.Totals.FailedExecutionCount > 0 ? "danger" : "success")"
                                             Text="@AgentUsageDisplay.FormatCount(consumer.Totals.FailedExecutionCount)"
                                             NoWrap="true" />
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="ProviderUsageConsumerRow" Title="Observations">
                            <Template Context="consumer">
                                <span>@AgentUsageDisplay.FormatCount(consumer.Totals.UsageObservationCount)</span>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="ProviderUsageConsumerRow" Title="Unknown">
                            <Template Context="consumer">
                                <span>@AgentUsageDisplay.FormatCount(consumer.Totals.UnknownUsageObservationCount)</span>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="ProviderUsageConsumerRow" Title="Tokens">
                            <Template Context="consumer">
                                <span>@AgentUsageDisplay.FormatTokens(consumer.Totals.Tokens.TotalTokens)</span>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="ProviderUsageConsumerRow" Title="Known cost">
                            <Template Context="consumer">
                                <span>@AgentUsageDisplay.FormatCost(consumer.Totals.KnownCostUsd)</span>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="ProviderUsageConsumerRow" Title="Unpriced">
                            <Template Context="consumer">
                                <span>@AgentUsageDisplay.FormatCount(consumer.Totals.UnpricedObservationCount)</span>
                            </Template>
                        </DataGridColumn>
                    </Columns>
                </DataGrid>
            }
        </SurfaceCard>

        <Cluster JustifyContent="JustifyContent.End">
            <Button Text="Close"
                    Icon="close"
                    Variant="Variant.Outlined"
                    Click="CloseAsync" />
        </Cluster>
    </Stack>
}

@code {
    private readonly CdaChartOptions ConsumerExecutionChartOptions = new() {
        Type = CdaChartType.Bar,
        XAxisType = CdaChartAxisType.Category,
        Unit = "executions",
        YAxisTitle = "Executions",
        ShowToolbar = false,
        EnableZoom = false,
        ShowLegend = false,
        ValuePrecision = 0,
        TooltipPrecision = 0,
        Palette = CdaChartPalette.Calm.ToImmutableArray()
    };

    [CascadingParameter]
    public DialogReference? DialogReference { get; set; }

    [Parameter]
    public ProviderUsageWorkloadSelection Selection { get; set; } = ProviderUsageWorkloadSelection.Both;

    private ProviderUsageSnapshot snapshot = ProviderUsageSnapshot.Empty(ProviderUsageWorkloadSelection.Both);
    private bool isLoading = true;
    private bool disposed;
    private long generation;
    private ProviderUsageWorkloadSelection? requestedSelection;
    private CancellationTokenSource? readCancellation;
    private string? loadError;

    private IReadOnlyList<ProviderUsageConsumerRow> ConsumerRows =>
        snapshot.Consumers
            .OrderByDescending(item => item.Totals.ExecutionCount)
            .ThenBy(item => item.ConsumerName, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private IReadOnlyList<CdaChartSeries> ConsumerExecutionSeries =>
        ConsumerRows.Count == 0
            ? []
            :
            [
                new CdaChartSeries {
                    Name = "Executions",
                    Type = CdaChartType.Bar,
                    Points = ConsumerRows
                        .Take(10)
                        .Select(item => new CdaChartPoint(
                            AgentUsageDisplay.TrimLabel(item.ConsumerName, 22),
                            item.Totals.ExecutionCount))
                        .ToArray()
                }
            ];

    protected override async Task OnParametersSetAsync() {
        if (disposed || requestedSelection == Selection) {
            return;
        }
        var requestGeneration = ++generation;
        CancelRead();
        var request = Selection;
        requestedSelection = request;
        readCancellation = new();
        var owner = readCancellation;
        var token = owner.Token;
        isLoading = true;
        loadError = null;
        try {
            request.Validate();
            var result = await WorkspaceQuery.ReadUsageAsync(request, token);
            if (!IsCurrent()) {
                return;
            }
            if (result.Selection != request) {
                throw new InvalidDataException("Usage evidence returned a different requested scope.");
            }
            snapshot = result with {
                Consumers = result.Consumers.ToImmutableArray(),
                Providers = result.Providers.ToImmutableArray(),
                Models = result.Models.ToImmutableArray(),
                Sources = result.Sources.ToImmutableArray()
            };
        } catch (OperationCanceledException) when (token.IsCancellationRequested) {
        } catch (Exception exception) {
            if (IsCurrent()) {
                loadError = "Usage evidence could not be refreshed. Close this dialog and retry the selected scope.";
                Logger.LogWarning("Usage detail read failed ({FailureType}); scope {Scope}.", exception.GetType().Name, request);
            }
        } finally {
            if (IsCurrent()) {
                isLoading = false;
            }
            if (ReferenceEquals(readCancellation, owner)) {
                readCancellation = null;
                owner.Dispose();
            }
        }

        bool IsCurrent() => !disposed && generation == requestGeneration && Selection == request && !token.IsCancellationRequested;
    }

    private void CancelRead() {
        var owner = readCancellation;
        readCancellation = null;
        if (owner is null) {
            return;
        }
        try {
            owner.Cancel();
        } finally {
            owner.Dispose();
        }
    }

    public void Dispose() {
        if (disposed) {
            return;
        }
        disposed = true;
        generation++;
        CancelRead();
    }

    private Task CloseAsync()
        => DialogReference?.CloseAsync() ?? Task.CompletedTask;

    private static string ResolveConsumerKind(ProviderUsageConsumerKind kind)
        => kind switch {
            ProviderUsageConsumerKind.Agent => "Agent",
            ProviderUsageConsumerKind.SimpleChatDefinition => "Simple Chat",
            ProviderUsageConsumerKind.Unattributed => "Unattributed",
            _ => throw new ArgumentOutOfRangeException(nameof(kind), kind, "Unknown usage consumer kind.")
        };
}

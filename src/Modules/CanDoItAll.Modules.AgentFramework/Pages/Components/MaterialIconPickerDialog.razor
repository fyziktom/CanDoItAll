@using CanDoItAll.AgentFramework.UI.Teams
@implements IDisposable

<TeamIconPicker @ref="picker" SelectedIcon="@SelectedIcon" OwnerCancellationToken="OwnerCancellationToken" Completed="CompleteAsync" Cancelled="CancelAsync" />

@code {
    [Parameter] public string? SelectedIcon { get; set; }
    [Parameter] public CancellationToken OwnerCancellationToken { get; set; }
    [CascadingParameter] public DialogReference? DialogReference { get; set; }
    private TeamIconPicker? picker;
    private bool disposed;
    private Task CompleteAsync(string icon) => disposed || OwnerCancellationToken.IsCancellationRequested
        ? Task.CompletedTask : DialogReference?.CloseAsync(icon) ?? Task.CompletedTask;
    private Task CancelAsync() => disposed ? Task.CompletedTask : DialogReference?.CloseAsync() ?? Task.CompletedTask;
    public void Dispose() {
        disposed = true;
        picker?.Dispose();
    }
}

@using CanDoItAll.AgentFramework.WorkflowAuthoring.UI
@using CanDoItAll.AgentFramework.Workflows.Abstractions
@using CanDoItAll.Configuration.UI
@using CanDoItAll.Modules.Security
@using CanDoItAll.SharedKernel.Configuration
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable
@inject IWorkflowComponentLibraryService ComponentLibrary
@inject ILogger<WorkflowImageGenerationSettingsRenderer> Logger

<WorkflowImageGenerationSettingsSurface Schema="Schema" State="State" Secrets="secretOptions" Validation="Validation"
                                        StateChanged="StateChanged" TestIdPrefix="@TestIdPrefix" Providers="providers"
                                        IsLoading="loading" LoadError="@error" />

@code {
    [Parameter] public required ConfigurationSchema Schema { get; set; }
    [Parameter] public required ConfigurationState State { get; set; }
    [Parameter] public IReadOnlyList<SecretListItem> Secrets { get; set; } = [];
    [Parameter] public ConfigurationValidationResult? Validation { get; set; }
    [Parameter] public EventCallback<ConfigurationState> StateChanged { get; set; }
    [Parameter] public string TestIdPrefix { get; set; } = "workflow-image-generation-settings";
    private readonly CancellationTokenSource lifetime = new();
    private IReadOnlyList<WorkflowProviderOption> providers = [];
    private IReadOnlyList<ConfigurationSecretOption> secretOptions = [];
    private bool loading = true;
    private bool disposed;
    private string error = string.Empty;

    protected override void OnParametersSet() {
        secretOptions = Secrets.Select(secret => new ConfigurationSecretOption(secret.Id, secret.Name)).ToArray();
    }

    protected override async Task OnInitializedAsync() {
        using var read = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
        try {
            var result = await ComponentLibrary.ListProviderOptionsAsync(read.Token);
            if (!disposed) {
                providers = result.Where(option => option.Purpose == ProviderProfilePurpose.ImageGeneration)
                    .OrderByDescending(option => option.IsEnabled).ThenBy(option => option.Name, StringComparer.OrdinalIgnoreCase).ToArray();
            }
        } catch (OperationCanceledException) when (disposed) {
        } catch (Exception exception) {
            if (!disposed) {
                error = "Image-generation providers could not be loaded.";
                Logger.LogWarning("Workflow image provider metadata unavailable: {FailureType}", exception.GetType().Name);
            }
        } finally {
            if (!disposed) {
                loading = false;
            }
        }
    }

    public ValueTask DisposeAsync() {
        if (disposed) {
            return ValueTask.CompletedTask;
        }
        disposed = true;
        lifetime.Cancel();
        lifetime.Dispose();
        return ValueTask.CompletedTask;
    }
}

<div class="rounded-md border border-chrome-200 bg-chrome-50 p-3">
    <TextBlock TextStyle="TextStyle.EyebrowCaption">@Label</TextBlock>
    <p class="@(Monospace ? "break-all font-mono text-xs" : "font-medium")">@Value</p>
</div>

@code {
    [Parameter, EditorRequired]
    public required string Label { get; set; }

    [Parameter, EditorRequired]
    public required string Value { get; set; }

    [Parameter]
    public bool Monospace { get; set; }
}

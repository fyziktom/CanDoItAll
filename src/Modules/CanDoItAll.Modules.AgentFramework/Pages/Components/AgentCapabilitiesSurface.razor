@using AccessEffect = CanDoItAll.AgentFramework.Capabilities.Abstractions.CapabilityAccessEffect
@using AccessScope = CanDoItAll.AgentFramework.Capabilities.Abstractions.CapabilityAccessScope
@using SelectorKind = CanDoItAll.AgentFramework.Capabilities.Abstractions.CapabilitySelectorKind

<ListDetailShell ListPaneWidth="23rem"
                 data-testid="agents-capabilities-panel">
    <ListHeader>
        <ListPanelHeader Title="Agents"
                         Description="Select the technical agent whose runtime capabilities you want to inspect, assign, or verify."
                         Count="@($"{agents.Count} agent(s)")" />
    </ListHeader>

    <ListContent>
        @if (agents.Count == 0) {
            <EmptyState Eyebrow="No agents"
                        Title="Create a technical agent first"
                        Description="Capability assignment only makes sense after the technical runtime catalog exists." />
        }
        else {
            <div class="agent-capabilities-panel__tree-scroll">
                <TreeView Items="@AgentTreeNodes"
                          Style="TreeViewStyle.Workbench"
                          AriaLabel="Capability agents"
                          EmptyText="No technical agents are available."
                          OnSelect="HandleAgentTreeSelectAsync"
                          OnToggle="HandleAgentTreeToggleAsync"
                          data-testid="agents-capability-agent-tree" />
            </div>
        }
    </ListContent>

    <DetailHeader>
        <div class="agent-capabilities-panel__detail-header">
            <Stack Gap="0.25rem" Class="agent-capabilities-panel__detail-title">
                <p class="cda-eyebrow">Capability assignment</p>
                <h2 class="agent-capabilities-panel__heading">@(LoadState == AgentCapabilitiesLoadState.Loading ? "Loading capabilities" : selectedAgent?.Name ?? "Select an agent")</h2>
            </Stack>

            @if (hasSelection) {
                <div class="agent-capabilities-panel__header-stats">
                    <CompactStatStrip>
                        <CompactStat Label="attached"
                                     Value="@Snapshot.SelectedCapabilityIds.Length.ToString()"
                                     TooltipText="Capabilities currently assigned to this agent."
                                     Tone="info" />
                        <CompactStat Label="shown"
                                     Value="@FilteredCapabilities.Count.ToString()"
                                     TooltipText="Capabilities matching the current filters."
                                     Tone="accent" />
                        <CompactStat Label="skills"
                                     Value="@capabilities.Count(item => item.Kind == CapabilityKind.Skill).ToString()"
                                     TooltipText="Prompt and workflow skills."
                                     Tone="success" />
                        <CompactStat Label="tools"
                                     Value="@capabilities.Count(item => item.Kind == CapabilityKind.Tool).ToString()"
                                     TooltipText="Runtime tools in the catalog."
                                     Tone="accent" />
                        <CompactStat Label="MCP servers"
                                     Value="@capabilities.Count(item => item.Kind == CapabilityKind.McpServer).ToString()"
                                     TooltipText="Connector-backed tool surfaces."
                                     Tone="warning" />
                        <CompactStat Label="verified"
                                     Value="@capabilities.Count(item => item.ProofStatus == CapabilityProofStatus.Verified).ToString()"
                                     TooltipText="Capabilities with successful proof status."
                                     Tone="success" />
                    </CompactStatStrip>
                </div>
            }

            @if (Snapshot.CuratorLaunchStatus == CapabilityCuratorLaunchStatus.Unconfirmed) {
                <p role="status" data-testid="agents-capability-curator-unconfirmed">Chat creation is unconfirmed. Inspect managed chats before starting another conversation; this launch will not be replayed.</p>
            }
            <Cluster Gap="LayoutGap.Small"
                     Wrap="FlexWrap.Wrap"
                     JustifyContent="JustifyContent.End"
                     Class="agent-capabilities-panel__header-actions">
                <AgentAvatarActionButton AgentName="@CapabilityCuratorDisplayName"
                                         AvatarImageUrl="@CapabilityCuratorAvatarImageUrl"
                                         FallbackText="CC"
                                         Label="@($"Open {CapabilityCuratorDisplayName}")"
                                         Click="OpenCapabilityCuratorAsync"
                                         Disabled="@(!CanOpenCapabilityCurator)"
                                         TestId="agents-capability-curator-open"
                                         TooltipTestId="agents-capability-curator-tooltip" />
                <Button Text="New tool"
                        Icon="build"
                        Size="ButtonSize.Small"
                        ButtonStyle="ButtonStyle.Light"
                        Disabled="@(isBusy || isOpeningCapabilityWizard)"
                        Click="@(() => OpenCapabilityWizardAsync(CapabilityKind.Tool))"
                        data-testid="agents-capability-new-tool" />
                <Button Text="New MCP"
                        Icon="hub"
                        Size="ButtonSize.Small"
                        ButtonStyle="ButtonStyle.Light"
                        Disabled="@(isBusy || isOpeningCapabilityWizard)"
                        Click="@(() => OpenCapabilityWizardAsync(CapabilityKind.McpServer))"
                        data-testid="agents-capability-new-mcp" />
                <Button Text="New skill"
                        Icon="psychology"
                        Size="ButtonSize.Small"
                        ButtonStyle="ButtonStyle.Light"
                        Disabled="@(isBusy || isOpeningCapabilityWizard)"
                        Click="@(() => OpenCapabilityWizardAsync(CapabilityKind.Skill))"
                        data-testid="agents-capability-new-skill" />
            </Cluster>
        </div>
    </DetailHeader>

    <DetailContent>
        <Stack GapScale="LayoutGap.Large">
            @if (Snapshot.Operation is { } operation) {
                <SurfaceCard Soft="true" data-testid="agents-capability-operation">
                    <Stack GapScale="LayoutGap.Small">
                        <p role="status">@operation.Message</p>
                        <Cluster Gap="LayoutGap.Small">
                            @if (operation.CanVerify || operation.CanReconcile) {
                                <Button Text="@(operation.CanVerify ? "Verify outcome" : "Retry reconciliation")"
                                        Click="@(() => Emit(new AgentCapabilitiesIntent.RecoverOperation()))"
                                        data-testid="agents-capability-recover" />
                            }
                            @if (operation.CanRetry) {
                                <Button Text="Retry same assignment" Click="@(() => Emit(new AgentCapabilitiesIntent.RetryAssignment()))"
                                        data-testid="agents-capability-retry-assignment" />
                            }
                            @if (operation.CanAdopt) {
                                <Button Text="Adopt current state" Click="@(() => Emit(new AgentCapabilitiesIntent.AdoptCurrent()))"
                                        data-testid="agents-capability-adopt" />
                            }
                        </Cluster>
                    </Stack>
                </SurfaceCard>
            }
            @if (LoadState == AgentCapabilitiesLoadState.Loading) {
                <Stack data-testid="agents-capability-loading">
                    <EmptyState Eyebrow="Loading capabilities"
                                Title="Loading selected capability assignments"
                                Description="The current target is loading. Actions will be available when its editor is ready." />
                </Stack>
            }
            else if (LoadState == AgentCapabilitiesLoadState.Failed) {
                <Stack GapScale="LayoutGap.Small" data-testid="agents-capability-load-failed">
                    <EmptyState Eyebrow="Capability workspace unavailable"
                                Title="Unable to load the selected agent"
                                Description="@Snapshot.LoadError" />
                    <Button Text="Retry" Click="@(() => Emit(new AgentCapabilitiesIntent.RetryLoad()))"
                            data-testid="agents-capability-load-retry" />
                </Stack>
            }
            else if (selectedAgent is null) {
                <EmptyState Eyebrow="Select an agent"
                            Title="Choose a technical agent from the left rail"
                            Description="The right pane shows the capability inventory and the attached runtime set for the selected agent." />
            }
            else if (capabilities.Count == 0) {
                <EmptyState Eyebrow="No capabilities"
                            Title="No capabilities are cataloged yet"
                            Description="Add a skill, tool, or MCP server before assigning it to this agent." />
            }
            else {
                <FormSection Title="Access preview"
                             Description="Validate one capability access rule against the selected agent capability set before changing runtime policy templates.">
                    <Grid Gap="LayoutGap.Large" ColumnsLg="5">
                        <div>
                            <label class="cda-field-label">Effect</label>
                            <InputSelect @bind-Value="accessRuleEffect"
                                         class="cda-input"
                                         data-testid="agents-capability-access-effect">
                                <option value="@AccessEffect.Deny">Deny</option>
                                <option value="@AccessEffect.Allow">Allow</option>
                                <option value="@AccessEffect.Require">Require</option>
                            </InputSelect>
                        </div>
                        <div>
                            <label class="cda-field-label">Scope</label>
                            <InputSelect @bind-Value="accessRuleScope"
                                         class="cda-input"
                                         data-testid="agents-capability-access-scope">
                                <option value="@AccessScope.UiPreview">UI preview</option>
                                <option value="@AccessScope.AgentDefault">Agent default</option>
                                <option value="@AccessScope.WorkflowDefinition">Workflow definition</option>
                                <option value="@AccessScope.WorkflowNode">Workflow node</option>
                                <option value="@AccessScope.ProcessDefinition">Process definition</option>
                                <option value="@AccessScope.ProcessStep">Process step</option>
                            </InputSelect>
                        </div>
                        <div>
                            <label class="cda-field-label">Selector</label>
                            <InputSelect @bind-Value="accessRuleSelectorKind"
                                         class="cda-input"
                                         data-testid="agents-capability-access-selector">
                                <option value="@SelectorKind.All">All</option>
                                <option value="@SelectorKind.Kind">Kind</option>
                                <option value="@SelectorKind.CapabilityKey">Capability key</option>
                                <option value="@SelectorKind.Tag">Tag</option>
                                <option value="@SelectorKind.OperationClassification">Operation classification</option>
                                <option value="@SelectorKind.RuntimeToolName">Runtime tool name</option>
                                <option value="@SelectorKind.McpServerKey">MCP server key</option>
                                <option value="@SelectorKind.McpToolName">MCP tool name</option>
                                <option value="@SelectorKind.ImplementationKey">Implementation key</option>
                            </InputSelect>
                        </div>
                        <div>
                            <label class="cda-field-label">Value</label>
                            <InputText @bind-Value="accessRuleSelectorValue"
                                       class="cda-input"
                                       data-testid="agents-capability-access-value" />
                        </div>
                        <div>
                            <label class="cda-field-label">MCP server key</label>
                            <InputText @bind-Value="accessRuleSelectorServerKey"
                                       class="cda-input"
                                       data-testid="agents-capability-access-server-key" />
                        </div>
                    </Grid>

                    <Grid Gap="LayoutGap.Large" ColumnsLg="2">
                        <div>
                            <label class="cda-field-label">Reason</label>
                            <InputText @bind-Value="accessRuleReason"
                                       class="cda-input"
                                       data-testid="agents-capability-access-reason" />
                        </div>
                        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.End">
                            <Button Text="Preview access"
                                    Icon="policy"
                                    ButtonStyle="ButtonStyle.Light"
                                    Disabled="@isAccessPreviewBusy"
                                    IsBusy="@isAccessPreviewBusy"
                                    Click="PreviewAccessAsync"
                                    data-testid="agents-capability-access-preview" />
                            @if (accessPreviewResult is not null) {
                                <StatusBadge Tone="@(accessPreviewResult.IsValid ? "success" : "danger")"
                                             Text="@($"{accessPreviewResult.AllowedCount} allowed")" />
                                <StatusBadge Tone="@(accessPreviewResult.SuppressedCount == 0 ? "neutral" : "warning")"
                                             Text="@($"{accessPreviewResult.SuppressedCount} suppressed")" />
                            }
                        </Cluster>
                    </Grid>

                    @if (accessPreviewResult is not null && !accessPreviewResult.IsValid) {
                        <SurfaceCard Soft="true" data-testid="agents-capability-access-validation">
                            <Stack GapScale="LayoutGap.Small">
                                @foreach (var issue in accessPreviewResult.ValidationIssues.Take(4)) {
                                    <div>
                                        <p class="cda-field-label">@issue.Label</p>
                                        <p>@issue.Message</p>
                                        <p class="cda-body-muted">@issue.RepairHint</p>
                                    </div>
                                }
                            </Stack>
                        </SurfaceCard>
                    }
                    else if (accessPreviewResult is not null && accessPreviewResult.SuppressedCount > 0) {
                        <SurfaceCard Soft="true" data-testid="agents-capability-access-diagnostics">
                            <Stack GapScale="LayoutGap.Small">
                                @foreach (var diagnostic in accessPreviewResult.Diagnostics.Take(4)) {
                                    <div>
                                        <p class="cda-field-label">@diagnostic.Label</p>
                                        <p>@diagnostic.Message</p>
                                        <p class="cda-body-muted">@diagnostic.RepairHint</p>
                                    </div>
                                }
                            </Stack>
                        </SurfaceCard>
                    }
                </FormSection>

                <FilterBar ResultText="@($"{FilteredCapabilities.Count} matching capability(s)")">
                    <div class="agent-capabilities-panel__filters">
                        <input @bind="capabilitySearch"
                               @bind:event="oninput"
                               class="cda-input agent-capabilities-panel__filter-input"
                               placeholder="Search capabilities"
                               data-testid="agents-capability-search" />
                        <TagEditor Value="@capabilityTagFilters"
                                   ValueChanged="HandleCapabilityTagFiltersChangedAsync"
                                   Suggestions="@AvailableCapabilityTags"
                                   Placeholder="Filter tags"
                                   MaxTags="6"
                                   TestId="agents-capability-tag-filter"
                                   InputTestId="agents-capability-tag-filter-input" />
                        <InputSelect @bind-Value="assignmentFilter"
                                     class="cda-input agent-capabilities-panel__filter-select"
                                     data-testid="agents-capability-assignment-filter">
                            <option value="@CapabilityAssignmentFilter.All">All</option>
                            <option value="@CapabilityAssignmentFilter.Assigned">Assigned</option>
                            <option value="@CapabilityAssignmentFilter.NotAssigned">Not Assigned</option>
                        </InputSelect>
                        <InputSelect @bind-Value="typeFilter"
                                     class="cda-input agent-capabilities-panel__filter-select"
                                     data-testid="agents-capability-type-filter">
                            <option value="@CapabilityTypeFilter.All">All</option>
                            <option value="@CapabilityTypeFilter.Mcp">MCP</option>
                            <option value="@CapabilityTypeFilter.Skill">Skill</option>
                            <option value="@CapabilityTypeFilter.Tool">Tool</option>
                        </InputSelect>
                        <Button Text="Reset"
                                ButtonStyle="ButtonStyle.Light"
                                Size="ButtonSize.Small"
                                Click="ResetCapabilityFilters" />
                    </div>
                </FilterBar>

                @if (FilteredCapabilities.Count == 0) {
                    <EmptyState Eyebrow="No matches"
                                Title="No capabilities match the current filters"
                                Description="Clear search, tag, assignment, or type filters to broaden the inventory." />
                }
                else {
                    <div class="agent-capabilities-panel__card-scroll">
                        <AgentCapabilityList Items="@FilteredCapabilities"
                                             AttachedCapabilityIds="@Snapshot.SelectedCapabilityIds"
                                             IsBusy="@isBusy"
                                             CanVerify="true"
                                             AssignmentRequested="ToggleCapabilityAsync"
                                             VerificationRequested="VerifyCapabilityAsync"
                                             DetailsRequested="OpenCapabilityDetailsDialogAsync"
                                             TestIdPrefix="agents-capability"
                                             ListTestId="agents-capability-card-grid"
                                             ColumnTemplateLg="repeat(3,minmax(16rem,1fr))" />
                    </div>
                }
            }
        </Stack>
    </DetailContent>
</ListDetailShell>

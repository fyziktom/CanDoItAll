@using CanDoItAll.AgentFramework.Core
@using CanDoItAll.AgentFramework.Models
@using CanDoItAll.Components.BaseLib
@using Microsoft.AspNetCore.Components.Forms

<EditForm Model="editorModel" OnValidSubmit="CreateAsync">
    <div class="capability-setup-wizard">
    <Stack Class="min-h-0" GapScale="LayoutGap.Large">
        <Steps @bind-Value="wizardStep"
               CanSelect="false"
               data-testid="agents-capability-setup-wizard">
            <StepsItem Text="Identity" Icon="badge">
                <FormSection Title="Type and identity"
                             Description="Create a catalog entry with explicit metadata before binding runtime parameters. Tags drive the tree, search, and later prompt-time grouping.">
                    <Grid Gap="LayoutGap.Large" ColumnsLg="3">
                        <div>
                            <label class="cda-field-label">Capability type</label>
                            <InputSelect TValue="CapabilityKind"
                                         Value="@editorModel.Kind"
                                         ValueChanged="HandleKindChangedAsync"
                                 class="ui-input"
                                 data-testid="agents-capability-setup-kind">
                            <option value="@CapabilityKind.McpServer">MCP server</option>
                            <option value="@CapabilityKind.Skill">Skill</option>
                            <option value="@CapabilityKind.Tool">Tool</option>
                        </InputSelect>
                        </div>
                        <div>
                            <label class="cda-field-label">Name</label>
                            <TextBox Value="@editorModel.Name"
                                     ValueChanged="HandleNameChangedAsync"
                                     data-testid="agents-capability-setup-name" />
                        </div>
                        <div>
                            <label class="cda-field-label">Key</label>
                            <TextBox Value="@editorModel.Key"
                                     ValueChanged="HandleKeyChangedAsync"
                                     data-testid="agents-capability-setup-key" />
                        </div>
                    </Grid>

                    <div>
                        <label class="cda-field-label">Description</label>
                        <TextArea @bind-Value="editorModel.Description"
                                       Class="capability-setup-wizard__textarea"
                                       data-testid="agents-capability-setup-description" />
                    </div>

                    <TagEditor Value="@capabilityTags"
                               ValueChanged="HandleTagsChangedAsync"
                               Suggestions="@VisibleTagSuggestions"
                               Placeholder="Add capability tag"
                               MaxTags="12"
                               TestId="agents-capability-setup-tags"
                               InputTestId="agents-capability-setup-tags-input" />
                </FormSection>
            </StepsItem>

            <StepsItem Text="Configure" Icon="settings">
                @if (editorModel.Kind == CapabilityKind.McpServer)
                {
                    <FormSection Title="MCP server configuration"
                                 Description="Choose a local stdio launch or remote endpoint. Local servers must declare allowed tools before the runtime can launch them.">
                        <Grid Gap="LayoutGap.Large" ColumnsLg="3">
                            <div>
                                <label class="cda-field-label">Transport</label>
                                <InputSelect @bind-Value="mcpState.Transport"
                                             class="ui-input"
                                             data-testid="agents-capability-setup-mcp-transport">
                                    <option value="stdio">Stdio</option>
                                    <option value="http">HTTP</option>
                                    <option value="sse">SSE</option>
                                    <option value="logical">Logical seam</option>
                                </InputSelect>
                            </div>
                            <div>
                                <label class="cda-field-label">Server name</label>
                                <InputText @bind-Value="mcpState.ServerName"
                                           class="ui-input"
                                           data-testid="agents-capability-setup-mcp-server" />
                            </div>
                            <label class="cda-inline-option capability-setup-wizard__inline-option">
                                <InputCheckbox @bind-Value="mcpState.Hosted"
                                               data-testid="agents-capability-setup-mcp-hosted" />
                                Hosted provider MCP
                            </label>
                        </Grid>

                        <Grid Gap="LayoutGap.Large" ColumnsLg="2">
                            <div>
                                <label class="cda-field-label">Endpoint</label>
                                <InputText @bind-Value="mcpState.Endpoint"
                                           class="ui-input"
                                           data-testid="agents-capability-setup-mcp-endpoint" />
                            </div>
                            <div>
                                <label class="cda-field-label">Command</label>
                                <InputText @bind-Value="mcpState.Command"
                                           class="ui-input"
                                           data-testid="agents-capability-setup-mcp-command" />
                            </div>
                        </Grid>

                        <Grid Gap="LayoutGap.Large" ColumnsLg="2">
                            <div>
                                <label class="cda-field-label">Arguments</label>
                                <TextArea @bind-Value="mcpState.ArgumentsText"
                                               Class="capability-setup-wizard__textarea"
                                               data-testid="agents-capability-setup-mcp-arguments" />
                            </div>
                            <div>
                                <label class="cda-field-label">Allowed tools</label>
                                <TextArea @bind-Value="mcpState.AllowedToolsText"
                                               Class="capability-setup-wizard__textarea"
                                               data-testid="agents-capability-setup-mcp-tools" />
                            </div>
                        </Grid>

                        <Grid Gap="LayoutGap.Large" ColumnsLg="3">
                            <div>
                                <label class="cda-field-label">Working directory</label>
                                <InputText @bind-Value="mcpState.WorkingDirectory"
                                           class="ui-input"
                                           data-testid="agents-capability-setup-mcp-working-directory" />
                            </div>
                            <div>
                                <label class="cda-field-label">Approval mode</label>
                                <InputSelect @bind-Value="mcpState.ApprovalMode"
                                             class="ui-input"
                                             data-testid="agents-capability-setup-mcp-approval">
                                    <option value="NeverRequire">Never Require</option>
                                    <option value="AlwaysRequire">Always Require</option>
                                </InputSelect>
                            </div>
                            <div>
                                <label class="cda-field-label">Allowed working roots</label>
                                <TextArea @bind-Value="mcpState.AllowedWorkingDirectoriesText"
                                               Class="capability-setup-wizard__small-textarea"
                                               data-testid="agents-capability-setup-mcp-roots" />
                            </div>
                        </Grid>
                    </FormSection>
                }
                else if (editorModel.Kind == CapabilityKind.Tool)
                {
                    <FormSection Title="Tool configuration"
                                 Description="Create an external process or HTTP tool descriptor with explicit runtime identity, bounded execution, and setup-test input.">
                        <Grid Gap="LayoutGap.Large" ColumnsLg="3">
                            <div>
                                <label class="cda-field-label">Tool setup kind</label>
                                <InputSelect @bind-Value="toolState.ToolKind"
                                             class="ui-input"
                                             data-testid="agents-capability-setup-tool-kind">
                                    <option value="externalProcess">External process</option>
                                    <option value="externalHttp">External HTTP</option>
                                </InputSelect>
                            </div>
                            <div>
                                <label class="cda-field-label">Runtime tool name</label>
                                <InputText @bind-Value="toolState.RuntimeToolName"
                                           class="ui-input"
                                           data-testid="agents-capability-setup-tool-runtime-name" />
                            </div>
                            <div>
                                <label class="cda-field-label">Implementation key</label>
                                <InputText @bind-Value="toolState.ImplementationKey"
                                           class="ui-input"
                                           data-testid="agents-capability-setup-tool-implementation-key" />
                            </div>
                        </Grid>

                        <Grid Gap="LayoutGap.Large" ColumnsLg="3">
                            <div>
                                <label class="cda-field-label">Operation classifications</label>
                                <TextArea @bind-Value="toolState.OperationClassificationsText"
                                               Class="capability-setup-wizard__small-textarea"
                                               data-testid="agents-capability-setup-tool-classifications" />
                            </div>
                            <div>
                                <label class="cda-field-label">Side-effect kind</label>
                                <InputText @bind-Value="toolState.SideEffectKind"
                                           class="ui-input"
                                           data-testid="agents-capability-setup-tool-side-effect" />
                            </div>
                            <Stack Gap="0.5rem">
                                <label class="cda-inline-option capability-setup-wizard__inline-option">
                                    <InputCheckbox @bind-Value="toolState.RequiresApprovalByDefault"
                                                   data-testid="agents-capability-setup-tool-approval" />
                                    Requires approval
                                </label>
                                <label class="cda-inline-option capability-setup-wizard__inline-option">
                                    <InputCheckbox @bind-Value="toolState.IsStateChanging"
                                                   data-testid="agents-capability-setup-tool-state-changing" />
                                    State changing
                                </label>
                            </Stack>
                        </Grid>

                        @if (string.Equals(toolState.ToolKind, "externalHttp", StringComparison.OrdinalIgnoreCase))
                        {
                            <Grid Gap="LayoutGap.Large" ColumnsLg="3">
                                <div>
                                    <label class="cda-field-label">HTTP method</label>
                                    <InputText @bind-Value="toolState.HttpMethod"
                                               class="ui-input"
                                               data-testid="agents-capability-setup-tool-http-method" />
                                </div>
                                <div>
                                    <label class="cda-field-label">Endpoint</label>
                                    <InputText @bind-Value="toolState.Endpoint"
                                               class="ui-input"
                                               data-testid="agents-capability-setup-tool-http-endpoint" />
                                </div>
                                <div>
                                    <label class="cda-field-label">Timeout seconds</label>
                                    <InputNumber @bind-Value="toolState.HttpTimeoutSeconds"
                                                 class="ui-input"
                                                 data-testid="agents-capability-setup-tool-http-timeout" />
                                </div>
                            </Grid>

                            <Grid Gap="LayoutGap.Large" ColumnsLg="3">
                                <div>
                                    <label class="cda-field-label">Header bindings</label>
                                    <TextArea @bind-Value="toolState.HeaderBindingsText"
                                                   Class="capability-setup-wizard__small-textarea"
                                                   data-testid="agents-capability-setup-tool-http-header-bindings" />
                                </div>
                                <div>
                                    <label class="cda-field-label">Required output properties</label>
                                    <TextArea @bind-Value="toolState.HttpRequiredOutputPropertiesText"
                                                   Class="capability-setup-wizard__small-textarea"
                                                   data-testid="agents-capability-setup-tool-http-output" />
                                </div>
                                <div>
                                    <label class="cda-field-label">Max response bytes</label>
                                    <InputNumber @bind-Value="toolState.MaxResponseBytes"
                                                 class="ui-input"
                                                 data-testid="agents-capability-setup-tool-http-max-response" />
                                </div>
                            </Grid>
                        }
                        else
                        {
                            <Grid Gap="LayoutGap.Large" ColumnsLg="3">
                                <div>
                                    <label class="cda-field-label">Command</label>
                                    <InputText @bind-Value="toolState.Command"
                                               class="ui-input"
                                               data-testid="agents-capability-setup-tool-process-command" />
                                </div>
                                <div>
                                    <label class="cda-field-label">Working directory</label>
                                    <InputText @bind-Value="toolState.WorkingDirectory"
                                               class="ui-input"
                                               data-testid="agents-capability-setup-tool-process-working-directory" />
                                </div>
                                <div>
                                    <label class="cda-field-label">Timeout seconds</label>
                                    <InputNumber @bind-Value="toolState.ProcessTimeoutSeconds"
                                                 class="ui-input"
                                                 data-testid="agents-capability-setup-tool-process-timeout" />
                                </div>
                            </Grid>

                            <Grid Gap="LayoutGap.Large" ColumnsLg="3">
                                <div>
                                    <label class="cda-field-label">Arguments</label>
                                    <TextArea @bind-Value="toolState.ArgumentsText"
                                                   Class="capability-setup-wizard__small-textarea"
                                                   data-testid="agents-capability-setup-tool-process-arguments" />
                                </div>
                                <div>
                                    <label class="cda-field-label">Allowed executable names</label>
                                    <TextArea @bind-Value="toolState.AllowedExecutableNamesText"
                                                   Class="capability-setup-wizard__small-textarea"
                                                   data-testid="agents-capability-setup-tool-process-allowed-executables" />
                                </div>
                                <div>
                                    <label class="cda-field-label">Required output properties</label>
                                    <TextArea @bind-Value="toolState.ProcessRequiredOutputPropertiesText"
                                                   Class="capability-setup-wizard__small-textarea"
                                                   data-testid="agents-capability-setup-tool-process-output" />
                                </div>
                            </Grid>

                            <div>
                                <label class="cda-field-label">Max output bytes</label>
                                <InputNumber @bind-Value="toolState.MaxOutputBytes"
                                             class="ui-input"
                                             data-testid="agents-capability-setup-tool-process-max-output" />
                            </div>
                        }
                    </FormSection>
                }
                else
                {
                    <FormSection Title="Skill configuration"
                                 Description="Add a file-backed skill from a known path, write inline instructions, or upload a SKILL.md into an inline catalog entry.">
                        <Grid Gap="LayoutGap.Large" ColumnsLg="3">
                            <div>
                                <label class="cda-field-label">Setup mode</label>
                                <InputSelect @bind-Value="skillInputMode"
                                             class="ui-input"
                                             data-testid="agents-capability-setup-skill-mode">
                                    <option value="@CapabilityWizardSkillInputMode.FilePath">Path</option>
                                    <option value="@CapabilityWizardSkillInputMode.Inline">Inline</option>
                                    <option value="@CapabilityWizardSkillInputMode.Upload">Upload SKILL.md</option>
                                </InputSelect>
                            </div>
                            <label class="cda-inline-option capability-setup-wizard__inline-option">
                                <InputCheckbox @bind-Value="skillState.ScriptApproval"
                                               data-testid="agents-capability-setup-skill-approval" />
                                Require script approval
                            </label>
                            <div>
                                <label class="cda-field-label">Trust level</label>
                                <InputText @bind-Value="skillState.ScriptTrustLevel"
                                           class="ui-input"
                                           data-testid="agents-capability-setup-skill-trust" />
                            </div>
                        </Grid>

                        @if (skillInputMode == CapabilityWizardSkillInputMode.FilePath)
                        {
                            <Grid Gap="LayoutGap.Large" ColumnsLg="2">
                                <div>
                                    <label class="cda-field-label">Skill root or SKILL.md path</label>
                                    <InputText @bind-Value="skillState.SkillRoot"
                                               class="ui-input"
                                               data-testid="agents-capability-setup-skill-root" />
                                </div>
                                <div>
                                    <label class="cda-field-label">Allowed external roots</label>
                                    <TextArea @bind-Value="skillState.AllowedExternalRootsText"
                                                   Class="capability-setup-wizard__small-textarea"
                                                   data-testid="agents-capability-setup-skill-roots" />
                                </div>
                            </Grid>
                        }
                        else
                        {
                            @if (skillInputMode == CapabilityWizardSkillInputMode.Upload)
                            {
                                <div class="capability-setup-wizard__upload">
                                    <label class="cda-field-label" for="agents-capability-setup-skill-file">SKILL.md file</label>
                                    <InputFile id="agents-capability-setup-skill-file"
                                               class="ui-input"
                                               accept=".md,text/markdown,text/plain"
                                               data-testid="agents-capability-setup-skill-file"
                                               OnChange="UploadSkillAsync" />
                                    @if (!string.IsNullOrWhiteSpace(uploadedSkillFileName))
                                    {
                                        <p class="cda-body-muted break-all">@uploadedSkillFileName</p>
                                    }
                                </div>
                            }

                            <Grid Gap="LayoutGap.Large" ColumnsLg="2">
                                <div>
                                    <label class="cda-field-label">Inline name</label>
                                    <InputText @bind-Value="skillState.InlineName"
                                               class="ui-input"
                                               data-testid="agents-capability-setup-inline-name" />
                                </div>
                                <div>
                                    <label class="cda-field-label">Inline description</label>
                                    <InputText @bind-Value="skillState.InlineDescription"
                                               class="ui-input"
                                               data-testid="agents-capability-setup-inline-description" />
                                </div>
                            </Grid>

                            <div>
                                <label class="cda-field-label">Instructions</label>
                                <TextArea @bind-Value="skillState.InlineInstructions"
                                               Class="capability-setup-wizard__large-textarea"
                                               data-testid="agents-capability-setup-inline-instructions" />
                            </div>
                        }
                    </FormSection>
                }

                @if (editorModel.Kind is CapabilityKind.Tool or CapabilityKind.McpServer)
                {
                    <FormSection Title="Setup test"
                                 Description="Run the typed setup path before saving so startup, command policy, timeout, schema, and secret-binding errors are visible.">
                        @if (editorModel.Kind == CapabilityKind.Tool)
                        {
                            <div>
                                <label class="cda-field-label">Tool test input JSON</label>
                                <TextArea @bind-Value="toolState.TestInputJson"
                                               Class="capability-setup-wizard__small-textarea"
                                               data-testid="agents-capability-setup-tool-test-input" />
                            </div>
                        }

                        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                            <Button Text="Test setup"
                                    Icon="play_arrow"
                                    Tone="ButtonTone.Default"
                                    Disabled="@isBusy"
                                    IsBusy="@isBusy"
                                    Click="TestSetupAsync"
                                    data-testid="agents-capability-setup-test" />
                            @if (CurrentSetupSucceeded.HasValue)
                            {
                                <StatusBadge Tone="@(CurrentSetupSucceeded.Value ? "success" : "danger")"
                                             Text="@(CurrentSetupSucceeded.Value ? "Setup passed" : "Setup failed")" />
                            }
                        </Cluster>

                        @if (CurrentMcpDiscoveredTools.Count > 0)
                        {
                            <Cluster Gap="LayoutGap.XSmall" Wrap="FlexWrap.Wrap">
                                @foreach (var toolName in CurrentMcpDiscoveredTools.Take(8))
                                {
                                    <StatusBadge Tone="info" Text="@toolName" />
                                }
                            </Cluster>
                        }

                        @if (CurrentSetupDiagnostics.Count > 0)
                        {
                            <SurfaceCard Soft="true" data-testid="agents-capability-setup-diagnostics">
                                <Stack GapScale="LayoutGap.Small">
                                    @foreach (var diagnostic in CurrentSetupDiagnostics.Take(4))
                                    {
                                        <div>
                                            <p class="cda-field-label">@diagnostic.Category.ToString()</p>
                                            <p>@diagnostic.MaskedDetail</p>
                                            <p class="cda-body-muted">@diagnostic.RepairHint</p>
                                        </div>
                                    }
                                </Stack>
                            </SurfaceCard>
                        }
                    </FormSection>
                }
            </StepsItem>

            <StepsItem Text="Review" Icon="fact_check">
                <FormSection Title="Review"
                             Description="Confirm the persisted identity and runtime shape before creating the capability. Assignment remains explicit per agent.">
                    <Grid Gap="LayoutGap.Large" ColumnsLg="2">
                        <FactTable>
                            <div class="grid gap-3">
                                <div>
                                    <p class="cda-field-label">Type</p>
                                    <p>@ResolveCapabilityKindLabel(editorModel.Kind)</p>
                                </div>
                                <div>
                                    <p class="cda-field-label">Name</p>
                                    <p>@editorModel.Name</p>
                                </div>
                                <div>
                                    <p class="cda-field-label">Key</p>
                                    <p class="capability-setup-wizard__mono">@editorModel.Key</p>
                                </div>
                                <div>
                                    <p class="cda-field-label">Endpoint preview</p>
                                    <p class="capability-setup-wizard__mono">@ResolveEndpointPreview()</p>
                                </div>
                            </div>
                        </FactTable>

                        <SurfaceCard Soft="true">
                            <Stack GapScale="LayoutGap.Small">
                                <Cluster Gap="LayoutGap.XSmall" Wrap="FlexWrap.Wrap">
                                    @foreach (var tag in capabilityTags)
                                    {
                                        <StatusBadge Tone="neutral" Text="@tag" />
                                    }
                                    @if (capabilityTags.Count == 0)
                                    {
                                        <StatusBadge Tone="warning" Text="No tags" />
                                    }
                                </Cluster>
                                <p class="cda-body-muted">@ResolveReviewSummary()</p>
                            </Stack>
                        </SurfaceCard>
                    </Grid>
                </FormSection>
            </StepsItem>
        </Steps>

        <StickyActionFooter StatusLabel="Capability setup">
            <SecondaryActions>
                <Button Text="Cancel"
                        Icon="close"
                        Tone="ButtonTone.Default"
                        Disabled="@isBusy"
                        Click="CancelAsync" />
                <Button Text="Back"
                        Icon="arrow_back"
                        Tone="ButtonTone.Default"
                        Disabled="@(wizardStep == 0 || isBusy)"
                        Click="MoveBackAsync"
                        data-testid="agents-capability-setup-back" />
            </SecondaryActions>
            <PrimaryActions>
                @if (wizardStep < LastWizardStep)
                {
                    <Button Text="Next"
                            Icon="arrow_forward"
                            Disabled="@isBusy"
                            Click="MoveNextAsync"
                            data-testid="agents-capability-setup-next" />
                }
                else
                {
                    <Button Text="Create capability"
                            Icon="check"
                            Type="submit"
                            Disabled="@isBusy"
                            IsBusy="@isBusy"
                            data-testid="agents-capability-setup-create" />
                }
            </PrimaryActions>
        </StickyActionFooter>
    </Stack>
    </div>
</EditForm>

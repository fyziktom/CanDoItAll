@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Modules.AgentFramework.ProviderManagement
@using CanDoItAll.SharedProviders.Abstractions
@inject ISharedProviderManagementService ManagementService
@inject SharedProviderRecovery Recovery
@implements IDisposable

<Stack GapScale="LayoutGap.Small">
    <Cluster>
        <Button Text="Refresh shared provider" Icon="sync" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                IsBusy="busy" Disabled="@(busy || Recovery.Source is not null)" Click="RefreshAsync" data-testid="shared-provider-refresh-capabilities" />
        @if (PendingDeliveryAttempt is not null) {
            <Button Text="Retry workspace delivery" Disabled="@busy" Click="RetryDeliveryAsync" data-testid="shared-provider-refresh-delivery" />
        }
    </Cluster>
    @if (Recovery.Source is not null) {
        <Alert AlertStyle="AlertStyle.Warning">Resolve the pending source attempt in Shared provider connections before another refresh.</Alert>
    }
    @if (message is not null) {
        <Alert AlertStyle="@(failed ? AlertStyle.Danger : AlertStyle.Success)" data-testid="shared-provider-refresh-result">@message</Alert>
    }
</Stack>

@code {
    [Parameter] public Guid ProviderId { get; set; }
    [Parameter] public EventCallback<SharedProviderChangeDelivery> Refreshed { get; set; }
    private CancellationTokenSource owner = new();
    private Guid target;
    private long generation;
    private bool disposed;
    private bool busy;
    private bool failed;
    private string? message;
    private SharedProviderSourceMutationAttempt? PendingDeliveryAttempt => Recovery.Source is { } attempt &&
        attempt.Before?.Imports.Any(import => import.ProviderProfileId == target) == true &&
        Recovery.PendingDelivery(attempt.AttemptId) is not null ? attempt : null;

    protected override void OnParametersSet() {
        if (disposed) {
            return;
        }
        if (target == ProviderId) {
            return;
        }
        owner.Cancel();
        owner.Dispose();
        owner = new();
        generation++;
        target = ProviderId;
        busy = false;
        message = null;
    }

    private bool IsCurrent(long operation, CancellationToken token) =>
        !disposed && operation == generation && !token.IsCancellationRequested;

    private async Task RefreshAsync() {
        if (disposed || busy || Recovery.Source is not null) {
            return;
        }
        var operation = ++generation;
        var token = owner.Token;
        var providerId = target;
        busy = true;
        message = null;
        SharedProviderSourceMutationAttempt? attempt = null;
        try {
            var sources = await ManagementService.ListSourcesAsync(token);
            if (!IsCurrent(operation, token)) {
                return;
            }
            var source = sources.SingleOrDefault(item => item.Imports.Any(import => import.ProviderProfileId == providerId))
                ?? throw new KeyNotFoundException("The shared connection was not found.");
            var selected = source.Imports.Where(import => import.SelectionState == SharedProviderSelectionState.Selected)
                .Select(import => import.RemotePublicationId).ToHashSet();
            attempt = new(source.Source.Id, SharedProviderSourceMutationKind.Synchronize, source, selection: selected);
            Recovery.BeginSource(attempt);
            var result = await ManagementService.SynchronizeSourceAsync(source.Source.Id, selected, token);
            Recovery.RecordCommit(attempt.AttemptId, result.Change);
            if (!IsCurrent(operation, token)) {
                return;
            }
            Recovery.CompleteSource(attempt);
            if (result.Change is not null && !await DeliverAsync(attempt, operation, token)) {
                return;
            }
            if (IsCurrent(operation, token)) {
                failed = !result.IsSuccessful;
                message = result.Change?.Warning ?? (failed
                    ? result.Failure?.SanitizedMessage ?? "The shared source is unavailable."
                    : "Shared models and thinking settings refreshed. Your unsaved selections were preserved.");
            }
        } catch (OperationCanceledException) when (token.IsCancellationRequested) {
        } catch (SharedProviderCommittedException exception) {
            if (attempt is not null) {
                Recovery.RecordCommit(attempt.AttemptId, exception.Change);
            }
            if (IsCurrent(operation, token) && attempt is not null &&
                await DeliverAsync(attempt, operation, token) && IsCurrent(operation, token)) {
                failed = true;
                message = exception.Change.Warning;
            }
        } catch (Exception) {
            if (IsCurrent(operation, token)) {
                failed = true;
                message = attempt is null ? "The source could not be read. No synchronization was started."
                    : "Shared provider refresh could not be confirmed. Verify the source state before retrying.";
                await Refreshed.InvokeAsync(new SharedProviderChangeDelivery(Guid.NewGuid(),
                    new(SharedProviderChangeKind.SourceAvailability, [], commitState: SharedProviderCommitState.Unconfirmed,
                        unknownScope: true, warning: message)));
            }
        } finally {
            if (IsCurrent(operation, token)) {
                busy = false;
            }
        }
    }

    private async Task RetryDeliveryAsync() {
        if (disposed || busy || PendingDeliveryAttempt is not { } attempt) {
            return;
        }
        var operation = ++generation;
        var token = owner.Token;
        busy = true;
        try {
            if (await DeliverAsync(attempt, operation, token) && IsCurrent(operation, token)) {
                failed = false;
                message = "Workspace reconciliation completed without repeating synchronization.";
            }
        } finally {
            if (IsCurrent(operation, token)) {
                busy = false;
            }
        }
    }

    private async Task<bool> DeliverAsync(SharedProviderSourceMutationAttempt attempt, long operation, CancellationToken token) {
        var result = await Recovery.DeliverSourceAsync(attempt, attempt.SourceId, () => IsCurrent(operation, token),
            delivery => Refreshed.InvokeAsync(delivery));
        if (result != SharedProviderDeliveryDisposition.Acknowledged && IsCurrent(operation, token)) {
            failed = true;
            message = "The source write is resolved, but workspace delivery is pending. Retry delivery without repeating synchronization.";
        }
        return result == SharedProviderDeliveryDisposition.Acknowledged;
    }

    public void Dispose() {
        if (disposed) {
            return;
        }
        disposed = true;
        owner.Cancel();
        owner.Dispose();
    }
}

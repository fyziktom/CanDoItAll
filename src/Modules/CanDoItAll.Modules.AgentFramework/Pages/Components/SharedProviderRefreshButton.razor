@using CanDoItAll.AgentFramework.SharedProviders.UI
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Modules.AgentFramework.ProviderManagement
@using CanDoItAll.SharedProviders.Abstractions
@using CanDoItAll.Editing
@inject ISharedProviderManagementService ManagementService
@inject SharedProviderRecovery Recovery
@inject ProviderEditingChanges Editing
@implements IDisposable
@implements IAsyncDisposable
@implements ISharedProviderRefreshView

<SharedProviderRefreshSurface View="this" />

@code {
    [Parameter] public Guid ProviderId { get; set; }
    [Parameter] public EventCallback<SharedProviderChangeDelivery> Refreshed { get; set; }
    [Parameter] public ProviderEditingOpening? OriginalOpening { get; set; }
    private CancellationTokenSource owner = new();
    private Guid target;
    private long generation;
    private bool disposed;
    private bool busy;
    private bool failed;
    private bool admitted;
    private ProviderEditingOpening? opening;
    private string? message;
    private readonly Guid viewId = Guid.NewGuid();
    private long activation;
    private SharedProviderRefreshOrigin Origin => new(viewId, activation, target);
    public SharedProviderRefreshPresentation Presentation => new(Origin, busy, !admitted || Recovery.Source is not null,
        PendingDeliveryAttempt?.AttemptId, message, failed);
    private SharedProviderSourceMutationAttempt? PendingDeliveryAttempt => admitted && Recovery.Source is { } attempt &&
        attempt.Before?.Imports.Any(import => import.ProviderProfileId == target) == true &&
        Recovery.PendingDelivery(attempt.AttemptId) is not null ? attempt : null;

    protected override async Task OnInitializedAsync() {
        if (!RendererInfo.IsInteractive) {
            return;
        }
        opening = Editing.Open(viewId, () => !disposed, EditingOwner.SharedProviderSource, OriginalOpening);
        try {
            await opening.StartAsync(_ => Task.CompletedTask, () => {
                RetireAccess();
                return InvokeAsync(StateHasChanged);
            });
            Recovery.Bind(new(opening.Scope, opening.PrincipalStamp));
            admitted = true;
        } catch (UnauthorizedAccessException) {
            RetireAccess();
        }
    }

    private void RetireAccess() {
        admitted = false;
        opening?.Stop();
        message = "Original source access has ended. Reopen the provider with current access.";
        failed = true;
        busy = false;
    }

    protected override void OnParametersSet() {
        if (disposed) {
            return;
        }
        if (target == ProviderId) {
            return;
        }
        owner.Cancel();
        owner.Dispose();
        owner = new();
        generation++;
        activation++;
        target = ProviderId;
        busy = false;
        message = null;
    }

    private bool IsCurrent(long operation, CancellationToken token) =>
        !disposed && admitted && operation == generation && !token.IsCancellationRequested;

    public async Task RefreshAsync(SharedProviderRefreshOrigin origin) {
        if (origin != Origin || disposed || !admitted || busy || Recovery.Source is not null) {
            return;
        }
        var operation = ++generation;
        using var request = CancellationTokenSource.CreateLinkedTokenSource(owner.Token);
        var token = request.Token;
        var providerId = target;
        busy = true;
        message = null;
        SharedProviderSourceMutationAttempt? attempt = null;
        try {
            var original = opening ?? throw new UnauthorizedAccessException("Original source access is unavailable.");
            var sources = await original.ReadAsync(ManagementService.ListSourcesAsync, token);
            if (!IsCurrent(operation, token)) {
                return;
            }
            var source = sources.SingleOrDefault(item => item.Imports.Any(import => import.ProviderProfileId == providerId))
                ?? throw new KeyNotFoundException("The shared connection was not found.");
            var selected = source.Imports.Where(import => import.SelectionState == SharedProviderSelectionState.Selected)
                .Select(import => import.RemotePublicationId).ToHashSet();
            attempt = new(source.Source.Id, SharedProviderSourceMutationKind.Synchronize, source, selection: selected);
            var result = await original.WriteAsync(() => {
                Recovery.BeginSource(attempt);
                return ManagementService.SynchronizeSourceAsync(source.Source.Id, source.Observation, selected, token);
            }, () => IsCurrent(operation, token), token);
            Recovery.RecordCommit(attempt.AttemptId, result.Change);
            result = await original.ReadAsync(_ => Task.FromResult(result), token);
            if (!IsCurrent(operation, token)) {
                return;
            }
            Recovery.CompleteSource(attempt);
            if (result.Change is not null && !await DeliverAsync(attempt, operation, token)) {
                return;
            }
            if (IsCurrent(operation, token)) {
                failed = !result.IsSuccessful;
                message = result.Change?.Warning ?? (failed
                    ? result.Failure?.SanitizedMessage ?? "The shared source is unavailable."
                    : "Shared models and thinking settings refreshed. Your unsaved selections were preserved.");
            }
        } catch (UnauthorizedAccessException) {
            if (attempt is not null && Recovery.PendingDelivery(attempt.AttemptId) is null) {
                Recovery.CompleteSource(attempt);
            }
            RetireAccess();
        } catch (OperationCanceledException) when (token.IsCancellationRequested || !admitted) {
        } catch (SharedProviderCommittedException exception) {
            if (attempt is not null) {
                Recovery.RecordCommit(attempt.AttemptId, exception.Change);
            }
            if (IsCurrent(operation, token) && attempt is not null &&
                await DeliverAsync(attempt, operation, token) && IsCurrent(operation, token)) {
                failed = true;
                message = exception.Change.Warning;
            }
        } catch (Exception) {
            if (IsCurrent(operation, token)) {
                failed = true;
                message = attempt is null ? "The source could not be read. No synchronization was started."
                    : "Shared provider refresh could not be confirmed. Verify the source state before retrying.";
                await Refreshed.InvokeAsync(new SharedProviderChangeDelivery(Guid.NewGuid(),
                    new(SharedProviderChangeKind.SourceAvailability, [], commitState: SharedProviderCommitState.Unconfirmed,
                        unknownScope: true, warning: message)));
            }
        } finally {
            if (IsCurrent(operation, token)) {
                busy = false;
            }
        }
    }

    public async Task RetryDeliveryAsync(SharedProviderRefreshOrigin origin, Guid attemptId) {
        if (origin != Origin || disposed || busy || PendingDeliveryAttempt is not { } attempt || attempt.AttemptId != attemptId) {
            return;
        }
        var operation = ++generation;
        using var request = CancellationTokenSource.CreateLinkedTokenSource(owner.Token);
        var token = request.Token;
        busy = true;
        try {
            await (opening ?? throw new UnauthorizedAccessException("Original source access is unavailable."))
                .ReadAsync(_ => Task.FromResult(true), token);
            if (await DeliverAsync(attempt, operation, token) && IsCurrent(operation, token)) {
                failed = false;
                message = "Workspace reconciliation completed without repeating synchronization.";
            }
        } catch (UnauthorizedAccessException) {
            RetireAccess();
        } finally {
            if (IsCurrent(operation, token)) {
                busy = false;
            }
        }
    }

    private async Task<bool> DeliverAsync(SharedProviderSourceMutationAttempt attempt, long operation, CancellationToken token) {
        var result = await Recovery.DeliverSourceAsync(attempt, attempt.SourceId, () => IsCurrent(operation, token),
            delivery => Refreshed.InvokeAsync(delivery));
        if (result != SharedProviderDeliveryDisposition.Acknowledged && IsCurrent(operation, token)) {
            failed = true;
            message = "The source write is resolved, but workspace delivery is pending. Retry delivery without repeating synchronization.";
        }
        return result == SharedProviderDeliveryDisposition.Acknowledged;
    }

    public void Dispose() {
        if (disposed) {
            return;
        }
        disposed = true;
        admitted = false;
        opening?.Stop();
        owner.Cancel();
        owner.Dispose();
    }

    public async ValueTask DisposeAsync() {
        Dispose();
        if (opening is not null) {
            await opening.DisposeAsync();
        }
    }
}

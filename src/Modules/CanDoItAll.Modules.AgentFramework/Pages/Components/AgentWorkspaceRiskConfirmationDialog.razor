@using CanDoItAll.AgentFramework.Editor.UI
<AgentWorkspaceRiskConfirmation Question="@Question" Warning="@Warning" Acknowledgement="@Acknowledgement" ConfirmText="@ConfirmText" TestIdPrefix="@TestIdPrefix" Completed="CompleteAsync" />
@code {
    [CascadingParameter] public DialogReference? DialogReference { get; set; }
    [Parameter] public string Question { get; set; } = string.Empty;
    [Parameter] public string Warning { get; set; } = string.Empty;
    [Parameter] public string Acknowledgement { get; set; } = string.Empty;
    [Parameter] public string ConfirmText { get; set; } = "Enable";
    [Parameter] public string TestIdPrefix { get; set; } = "agents-workspace-risk";
    private Task CompleteAsync(bool confirmed) => DialogReference?.CloseAsync(confirmed) ?? Task.CompletedTask;
}

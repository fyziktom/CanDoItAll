@using CanDoItAll.AgentFramework.WorkflowAuthoring.UI
@using CanDoItAll.Modules.Prompts
@using CanDoItAll.Modules.Prompts.Components

@if (ready && !lifetime.IsCancellationRequested) {
    <WorkflowCanvasSurface Definition="Definition" Components="Components" ProviderOptions="ProviderOptions"
                           Executors="@ExecutorCatalog.ListExecutors()" Backends="@RuntimeBackendCatalog.ListBackends()"
                           Secrets="secretOptions" SecretLoadError="@secretLoadError" OwnerToken="lifetime.Token"
                           NewDraftRequested="NewDraftRequested" DocumentOperations="DocumentOwner.Operations" BindPrompt="BindingOwner.BindAsync"
                           PreviewOperations="PreviewOwner.Operations" DefinitionSaved="DefinitionSaved"
                           PreviewRunCompleted="PreviewRunCompleted" ComponentLibraryChanged="ComponentLibraryChanged"
                           SelectedNodeChanged="HandleSelectedNodeChangedAsync">
        <PromptPicker Context="picker">
            <PromptGalleryPickerButton Text="@picker.Text" Icon="library_books" Size="ButtonSize.Small"
                                       Consumer="PromptGalleryConsumer.Workflow" Provider="@picker.Provider" Model="@picker.Model"
                                       AllowEdit="true" TargetKey="picker.TargetKey" Disabled="picker.Disabled" Selected="picker.Selected" />
        </PromptPicker>
        <SettingsRenderer Context="settings">
            <WorkflowNativeSettingsSlot Context="settings" Executors="@ExecutorCatalog.ListExecutors()" Secrets="secrets" />
        </SettingsRenderer>
    </WorkflowCanvasSurface>
}

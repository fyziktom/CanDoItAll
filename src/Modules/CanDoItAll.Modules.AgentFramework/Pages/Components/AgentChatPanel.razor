@using CanDoItAll.Modules.Prompts.Components

<div class="@ResolveShellClass()"
     data-testid="agents-chat-panel">
<Stack GapScale="LayoutGap.Large"
       AlignItems="AlignItems.Stretch"
       Class="flex-1 min-h-0 w-full">
    <Grid Gap="LayoutGap.Large"
          Class="agents-chat-grid flex-1 min-h-0 overflow-hidden"
          ColumnTemplateXl="@ChatGridColumnTemplate">
        @if (!IsFocusedFloating)
        {
        <WorkspacePanel Class="agents-chat-left-rail h-full min-h-0 overflow-hidden">
            <div class="border-b border-chrome-200 pb-4">
                <Split Gap="LayoutGap.Small">
                    <div>
                        <Cluster Gap="LayoutGap.Small"
                                 Wrap="FlexWrap.NoWrap">
                            <TextBlock TextStyle="TextStyle.Subtitle2" Value="Agent threads" />
                            <HelpPopover RootClass="pf-help-popover inline-flex items-center"
                                         ToggleClass="pf-help-popover__toggle pf-help-popover__toggle--compact"
                                         OpenOnHover="true"
                                         AriaLabel="Show agent thread help"
                                         Title="Show agent thread help"
                                         Heading="Agent threads"
                                         Body="@AgentThreadsHelpText" />
                        </Cluster>
                        @if (selectedAgent is not null)
                        {
                            <div class="agents-chat-agent-context mt-2"
                                 data-testid="agent-thread-selected-agent">
                                <Avatar Alt="@selectedAgent.Name"
                                        ImageUrl="@selectedAgent.AvatarImageUrl"
                                        FallbackText="@ResolveAgentInitials(selectedAgent)"
                                        DefaultImageSeed="@selectedAgent.Name"
                                        Size="AvatarSize.Small"
                                        Shape="AvatarShape.Rounded" />
                                <span class="min-w-0 truncate text-xs font-semibold text-chrome-700">Selected agent: @selectedAgent.Name</span>
                            </div>
                        }
                    </div>
                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                        <Button Icon="cloud_sync"
                                Text="Switch Agent"
                                Tone="ButtonTone.Default"
                                Size="ButtonSize.Small"
                                Disabled="@(isBusy || agents.Count == 0)"
                                Click="OpenAgentSwitchDialogAsync"
                                data-testid="agent-switch-button" />
                        <Button Text="Refresh"
                                Tone="ButtonTone.Default"
                                Size="ButtonSize.Small"
                                Disabled="@isBusy"
                                Click="RefreshAsync" />
                        <Button Text="New thread"
                                Size="ButtonSize.Small"
                                Disabled="@(isBusy || selectedAgentId is null)"
                                Click="CreateThreadAsync" />
                    </Cluster>
                </Split>
            </div>

            <div class="agents-chat-left-scroll mt-4 min-h-0 flex-1 overflow-y-auto pr-1"
                 style="scrollbar-gutter:stable;">
                @if (agents.Count == 0)
                {
                    <EmptyState Eyebrow="No agents"
                                Title="Create a technical agent first"
                                Description="Chat is only available after a technical agent exists and is bound to a provider." />
                }
                else
                {
                    <ConversationThreadRail @key="selectedAgentId"
                                            Threads="@ThreadPresentations"
                                            Text="@ThreadRailText"
                                            Selected="HandleThreadSelectedAsync" />
                }
            </div>
        </WorkspacePanel>
        }

        @if (IsFocusedFloating && !string.IsNullOrWhiteSpace(focusedAgentLoadError))
        {
            <EmptyState Eyebrow="Agent unavailable"
                        Title="Unable to open focused chat"
                        Description="@focusedAgentLoadError" />
        }
        else
        {
        <ChatWorkspacePanel Agent="@selectedAgent"
                            Session="@workspace?.SelectedSession"
                            ActiveRun="@workspace?.SelectedRun"
                            ExecutionLog="@executionLog"
                            DraftPrompt="@draftPrompt"
                            DraftPromptChanged="HandleDraftPromptChangedAsync"
                            IsBusy="@IsChatInteractionBusy"
                            ComposerKey="@composerKey"
                            RunStateText="@runStateText"
                            RunStateTone="@runStateTone"
                            PendingUserPrompt="@pendingUserPrompt"
                            ActivityStreamId="@activeActivityStreamId"
                            DraftAttachmentPaths="@draftAttachmentPaths"
                            CanUseVoiceMode="@CanUseSelectedAgentVoiceMode"
                            IsVoiceModeEnabled="@isVoiceModeEnabled"
                            IsVoiceRecording="@isVoiceRecording"
                            IsVoiceTranscribing="@isVoiceTranscribing"
                            IsVoiceSpeaking="@isVoiceSpeaking"
                            VoiceStatusText="@voiceStatusText"
                            VoiceStatusTone="@voiceStatusTone"
                            SendRequested="SendMessageAsync"
                            ApprovalDecisionsRequested="HandleApprovalDecisionsAsync"
                            ApprovalDecisionForConversationRequested="ApproveConversationAsync"
                            AttachmentRequested="StageAttachmentsAsync"
                            AttachmentFilesSelected="StageUploadedAttachmentFilesAsync"
                            SessionTitleChanged="HandleSessionTitleChangedAsync"
                            VoiceModeChanged="HandleVoiceModeChangedAsync"
                            VoiceRecordingToggled="ToggleVoiceRecordingAsync"
                            SpeakLatestAssistantMessageRequested="SpeakLatestAssistantMessageAsync">
            <ComposerActions>
                <PromptGalleryChatComposerButton Provider="@SelectedAgentProviderKind"
                                                 Model="@selectedAgent?.Model"
                                                 ContentSelected="InsertPromptGalleryContentAsync" />
            </ComposerActions>
            <HeaderActions>
                @if (IsFocusedFloating)
                {
                    <Button Icon="add_comment"
                            Text="New thread"
                            Tone="ButtonTone.Default"
                            Size="ButtonSize.Small"
                            Disabled="@(isBusy || selectedAgentId is null)"
                            Click="CreateThreadAsync"
                            data-testid="agents-chat-focused-new-thread" />
                }
                <Button Icon="runtime"
                        Text="Runtime details"
                        Tone="ButtonTone.Default"
                        Size="ButtonSize.Small"
                        Disabled="@(!CanOpenRuntimeDetails)"
                        Click="OpenRuntimeDetailsDialogAsync"
                        data-testid="agents-chat-open-runtime-details" />
            </HeaderActions>
        </ChatWorkspacePanel>
        }
    </Grid>
</Stack>
</div>

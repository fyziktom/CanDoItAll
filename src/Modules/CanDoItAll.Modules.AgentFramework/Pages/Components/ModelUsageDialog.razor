@using System.Collections.Immutable
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject IAgentsWorkspaceQuery WorkspaceQuery
@inject ILogger<ModelUsageDialog> Logger

@if (isLoading) {
    <LoadingState Eyebrow="Model usage"
                  Title="Loading model usage"
                  Description="Reading model-level usage aggregates only for this dialog." />
}
else if (!string.IsNullOrWhiteSpace(loadError)) {
    <EmptyState Eyebrow="Usage unavailable"
                Title="Model usage could not be loaded"
                Description="@loadError" />
}
else {
    <Stack GapScale="LayoutGap.Large"
           data-testid="model-usage-dialog">
        @if (!snapshot.IsComplete) {
            <Alert AlertStyle="AlertStyle.Warning" data-testid="usage-dialog-partial">
                Some usage evidence is unavailable. Displayed totals are partial.
            </Alert>
        }
        <Grid Gap="LayoutGap.Medium"
              ColumnTemplate="repeat(auto-fit,minmax(9rem,1fr))">
            <MetricCard Label="Models" Value="@AgentUsageDisplay.FormatCount(snapshot.Models.Count)" />
            <MetricCard Label="Usage observations" Value="@AgentUsageDisplay.FormatCount(snapshot.Totals.UsageObservationCount)" />
            <MetricCard Label="Unknown observations" Value="@AgentUsageDisplay.FormatCount(snapshot.Totals.UnknownUsageObservationCount)" />
            <MetricCard Label="Tokens" Value="@AgentUsageDisplay.FormatTokens(snapshot.Totals.Tokens.TotalTokens)" />
            <MetricCard Label="Known cost" Value="@AgentUsageDisplay.FormatCost(snapshot.Totals.KnownCostUsd)" />
            <MetricCard Label="Unpriced" Value="@AgentUsageDisplay.FormatCount(snapshot.Totals.UnpricedObservationCount)" />
        </Grid>

        <CdaChart Title="Model usage"
                  Description="Model-level usage stays lazy-loaded so the default Agents overview stays light."
                  Series="@ModelUsageSeries"
                  Options="@ModelUsageChartOptions"
                  Height="340"
                  Class="w-full"
                  EmptyText="No model usage has been recorded." />

        <SurfaceCard Soft="true">
            @if (snapshot.Models.Count == 0) {
                <EmptyState Eyebrow="No usage"
                            Title="No model usage rows"
                            Description="Model usage rows appear after executions report provider model metadata." />
            }
            else {
                <DataGrid TItem="ProviderUsageModelRow"
                          Data="@ModelRows"
                          AllowPaging="true"
                          PageSize="10"
                          data-testid="model-usage-dialog-grid">
                    <Columns>
                        <DataGridColumn TItem="ProviderUsageModelRow" Title="Model">
                            <Template Context="model">
                                <Stack Gap="0.15rem">
                                    <span class="font-medium text-slate-950">@model.Model</span>
                                    <span class="text-xs text-slate-500">@model.ProviderName · @model.ProviderKind</span>
                                </Stack>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="ProviderUsageModelRow" Title="Share">
                            <Template Context="model">
                                <span>@AgentUsageDisplay.FormatUsageShare(model.Totals.UsageObservationCount, TotalModelUsage)</span>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="ProviderUsageModelRow" Title="Observations">
                            <Template Context="model">
                                <span>@AgentUsageDisplay.FormatCount(model.Totals.UsageObservationCount)</span>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="ProviderUsageModelRow" Title="Unknown">
                            <Template Context="model">
                                <span>@AgentUsageDisplay.FormatCount(model.Totals.UnknownUsageObservationCount)</span>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="ProviderUsageModelRow" Title="Tokens">
                            <Template Context="model">
                                <span>@AgentUsageDisplay.FormatTokens(model.Totals.Tokens.TotalTokens)</span>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="ProviderUsageModelRow" Title="Known cost">
                            <Template Context="model">
                                <span>@AgentUsageDisplay.FormatCost(model.Totals.KnownCostUsd)</span>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="ProviderUsageModelRow" Title="Last used">
                            <Template Context="model">
                                <span>@AgentUsageDisplay.FormatLastUsed(model.LastUsedAtUtc)</span>
                            </Template>
                        </DataGridColumn>
                    </Columns>
                </DataGrid>
            }
        </SurfaceCard>

        <Cluster JustifyContent="JustifyContent.End">
            <Button Text="Close"
                    Icon="close"
                    Variant="Variant.Outlined"
                    Click="CloseAsync" />
        </Cluster>
    </Stack>
}

@code {
    private readonly CdaChartOptions ModelUsageChartOptions = new() {
        Type = CdaChartType.Bar,
        XAxisType = CdaChartAxisType.Category,
        Unit = "observations",
        YAxisTitle = "Usage observations",
        ShowToolbar = false,
        EnableZoom = false,
        ShowLegend = false,
        ValuePrecision = 0,
        TooltipPrecision = 0,
        Palette = CdaChartPalette.Calm.ToImmutableArray()
    };

    [CascadingParameter]
    public DialogReference? DialogReference { get; set; }

    [Parameter]
    public ProviderUsageWorkloadSelection Selection { get; set; } = ProviderUsageWorkloadSelection.Both;

    private ProviderUsageSnapshot snapshot = ProviderUsageSnapshot.Empty(ProviderUsageWorkloadSelection.Both);
    private bool isLoading = true;
    private bool disposed;
    private long generation;
    private ProviderUsageWorkloadSelection? requestedSelection;
    private CancellationTokenSource? readCancellation;
    private string? loadError;

    private IReadOnlyList<ProviderUsageModelRow> ModelRows =>
        snapshot.Models
            .OrderByDescending(item => item.Totals.UsageObservationCount)
            .ThenBy(item => item.ProviderName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(item => item.Model, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private decimal TotalModelUsage => ModelRows.Sum(item => item.Totals.UsageObservationCount);

    private IReadOnlyList<CdaChartSeries> ModelUsageSeries =>
        ModelRows.Count == 0
            ? []
            :
            [
                new CdaChartSeries {
                    Name = "Model usage",
                    Type = CdaChartType.Bar,
                    Points = ModelRows
                        .Take(12)
                        .Select(item => new CdaChartPoint(
                            AgentUsageDisplay.TrimLabel(item.Model, 24),
                            item.Totals.UsageObservationCount))
                        .ToArray()
                }
            ];

    protected override async Task OnParametersSetAsync() {
        if (disposed || requestedSelection == Selection) {
            return;
        }
        var requestGeneration = ++generation;
        CancelRead();
        var request = Selection;
        requestedSelection = request;
        readCancellation = new();
        var owner = readCancellation;
        var token = owner.Token;
        isLoading = true;
        loadError = null;
        try {
            request.Validate();
            var result = await WorkspaceQuery.ReadUsageAsync(request, token);
            if (!IsCurrent()) {
                return;
            }
            if (result.Selection != request) {
                throw new InvalidDataException("Usage evidence returned a different requested scope.");
            }
            snapshot = result with {
                Consumers = result.Consumers.ToImmutableArray(),
                Providers = result.Providers.ToImmutableArray(),
                Models = result.Models.ToImmutableArray(),
                Sources = result.Sources.ToImmutableArray()
            };
        } catch (OperationCanceledException) when (token.IsCancellationRequested) {
        } catch (Exception exception) {
            if (IsCurrent()) {
                loadError = "Usage evidence could not be refreshed. Close this dialog and retry the selected scope.";
                Logger.LogWarning("Usage detail read failed ({FailureType}); scope {Scope}.", exception.GetType().Name, request);
            }
        } finally {
            if (IsCurrent()) {
                isLoading = false;
            }
            if (ReferenceEquals(readCancellation, owner)) {
                readCancellation = null;
            }
            owner.Dispose();
        }

        bool IsCurrent() => !disposed && generation == requestGeneration && Selection == request && !token.IsCancellationRequested;
    }

    private void CancelRead() {
        var owner = readCancellation;
        readCancellation = null;
        if (owner is null) {
            return;
        }
        owner.Cancel();
    }

    public void Dispose() {
        if (disposed) {
            return;
        }
        disposed = true;
        generation++;
        CancelRead();
    }

    private Task CloseAsync()
        => DialogReference?.CloseAsync() ?? Task.CompletedTask;
}

@implements IDisposable
@using CanDoItAll.AgentFramework.Core
@using CanDoItAll.AgentFramework.Models
@using CanDoItAll.Components.BaseLib
@inject IAgentFrameworkWorkspaceService WorkspaceService
@inject NotificationService NotificationService
@inject DialogService DialogService

<div class="agent-team-details-dialog" data-testid="agents-team-details-dialog-content">
    @if (isLoading)
    {
        <SurfaceCard Soft="true">
            <p class="cda-eyebrow">Loading</p>
            <h3 class="agent-team-details-dialog__title">Loading team details</h3>
        </SurfaceCard>
    }
    else if (loadFailed)
    {
        <Alert AlertStyle="AlertStyle.Danger">Team details could not be loaded. Retry before editing this team.</Alert>
        <Button Text="Retry" Click="LoadAsync" />
        <Button Text="Close" Click="CancelAsync" />
    }
    else
    {
        <Stack GapScale="LayoutGap.Medium">
            <div class="grid gap-2">
                <span class="text-xs font-bold text-slate-600">Icon</span>
                <Cluster Gap="LayoutGap.Small" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                    <span class="flex h-14 w-14 items-center justify-center rounded-lg border border-slate-200 bg-slate-50 text-slate-700"
                          data-testid="agents-team-selected-icon">
                        <Icon Name="@AgentTeamIconCatalog.Normalize(editorModel.Icon)" Class="text-2xl" />
                    </span>
                    <Button Text="Choose icon"
                            Icon="widgets"
                            ButtonStyle="ButtonStyle.Light"
                            Variant="Variant.Outlined"
                            Click="OpenIconPickerAsync"
                            data-testid="agents-team-choose-icon" />
                </Cluster>
            </div>

            <label class="agent-team-details-dialog__field">
                <span>Name</span>
                <input @bind="editorModel.Name"
                       @bind:event="oninput"
                       class="cda-input agent-team-details-dialog__input"
                       data-testid="agents-team-name" />
            </label>

            <label class="agent-team-details-dialog__field">
                <span>Description</span>
                <textarea @bind="editorModel.Description"
                          @bind:event="oninput"
                          class="cda-input agent-team-details-dialog__textarea"
                          data-testid="agents-team-description"></textarea>
            </label>

            <Cluster Gap="LayoutGap.Small" JustifyContent="JustifyContent.End">
                <Button Text="Cancel"
                        Icon="close"
                        Variant="Variant.Outlined"
                        Disabled="@isBusy"
                        Click="CancelAsync" />
                <Button Text="Save team"
                        Icon="check"
                        Disabled="@isBusy"
                        IsBusy="@isBusy"
                        Click="SaveAsync"
                        data-testid="agents-team-save" />
            </Cluster>
        </Stack>
    }
</div>

@code {
    [Parameter]
    public Guid? TeamId { get; set; }

    [CascadingParameter]
    public DialogReference? DialogReference { get; set; }

    private AgentTeamEditorModel editorModel = new();
    private bool isLoading = true;
    private bool loadFailed;
    private bool isBusy;
    private readonly CancellationTokenSource lifetime = new();
    private CancellationToken ownerToken;
    private bool disposed;

    protected override Task OnInitializedAsync() {
        ownerToken = lifetime.Token;
        return LoadAsync();
    }

    private async Task LoadAsync() {
        if (disposed) {
            return;
        }
        isLoading = true;
        loadFailed = false;
        using var request = CancellationTokenSource.CreateLinkedTokenSource(ownerToken);
        try
        {
            var loaded = await WorkspaceService.GetAgentTeamEditorAsync(TeamId, request.Token);
            if (!disposed) {
                editorModel = loaded;
            }
        }
        catch (Exception) when (ownerToken.IsCancellationRequested) {
        } catch (Exception) {
            loadFailed = true;
            NotificationService.Error("Team details unavailable", "Team details could not be loaded. Retry before editing this team.");
        } finally {
            if (!disposed) {
                isLoading = false;
            }
        }
    }

    private async Task SaveAsync() {
        if (disposed || isLoading || loadFailed) {
            return;
        }
        using var request = CancellationTokenSource.CreateLinkedTokenSource(ownerToken);
        if (disposed || isBusy) {
            return;
        }
        isBusy = true;
        try
        {
            editorModel.Icon = AgentTeamIconCatalog.Normalize(editorModel.Icon);
            var teamId = await WorkspaceService.SaveAgentTeamAsync(editorModel, request.Token);
            if (disposed) {
                return;
            }
            NotificationService.Success("Team saved", "Agent team details were saved.");
            if (DialogReference is not null)
            {
                await DialogReference.CloseAsync(new AgentTeamDetailsDialogResult(teamId));
            }
        }
        catch (OperationCanceledException) when (request.Token.IsCancellationRequested) {
        } catch (Exception) {
            if (!disposed) {
                NotificationService.Error("Team save failed", "The save result could not be confirmed. Check the team catalog before trying again.");
            }
        } finally {
            if (!disposed) {
                isBusy = false;
            }
        }
    }

    private Task CancelAsync()
        => DialogReference?.CloseAsync() ?? Task.CompletedTask;

    private async Task OpenIconPickerAsync() {
        if (disposed || isLoading || loadFailed) {
            return;
        }
        using var request = CancellationTokenSource.CreateLinkedTokenSource(ownerToken);
        if (disposed) {
            return;
        }
        try {
            var result = await DialogService.OpenAsync<MaterialIconPickerDialog>(
                "Choose team icon",
                new Dictionary<string, object?> {
                    [nameof(MaterialIconPickerDialog.SelectedIcon)] = editorModel.Icon
                },
                new DialogOptions {
                    Eyebrow = "Team identity",
                    Subtitle = "Pick a Material icon for this AgentFramework team.",
                    Size = ModalSize.Wide,
                    DenseChrome = true,
                    AriaLabel = "Choose team icon",
                    TestId = "material-icon-picker-dialog-shell"
                }, request.Token);
            if (!disposed && result is string icon) {
                editorModel.Icon = AgentTeamIconCatalog.Normalize(icon);
            }
        } catch (OperationCanceledException) when (request.Token.IsCancellationRequested) {
        }
    }

    public void Dispose() {
        if (disposed) {
            return;
        }
        disposed = true;
        try {
            lifetime.Cancel();
        } finally {
            lifetime.Dispose();
        }
    }
}

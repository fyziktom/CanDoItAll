@using CanDoItAll.AgentFramework.Core
@using CanDoItAll.AgentFramework.Models
@using CanDoItAll.AgentFramework.UI.Teams
@using CanDoItAll.Infrastructure.Persistence
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject IAgentFrameworkWorkspaceService WorkspaceService
@inject IDatabaseSwitchNotificationService ProfileChanges
@inject DialogService DialogService
@inject ILogger<AgentTeamDetailsDialog> Logger

<TeamMetadataEditor @ref="editor" TeamId="TeamId" Operations="operations!" OwnerCancellationToken="ownerToken" Completed="CompleteAsync" Cancelled="CancelAsync" />

@code {
    [Parameter] public Guid? TeamId { get; set; }
    [Parameter] public CancellationToken OwnerCancellationToken { get; set; }
    [CascadingParameter] public DialogReference? DialogReference { get; set; }
    private readonly CancellationTokenSource lifetime = new();
    private CancellationTokenSource? owner;
    private CancellationToken previousOwner;
    private CancellationToken ownerToken;
    private TeamMetadataEditor? editor;
    private TeamMetadataOperations? operations;
    private bool disposed;
    protected override void OnInitialized() {
        ProfileChanges.Changed += ProfileChanged;
        operations = new((id, token) => WorkspaceService.GetAgentTeamEditorAsync(id, token), SaveAsync, ChooseIconAsync);
    }
    protected override void OnParametersSet() {
        if (owner is not null && previousOwner == OwnerCancellationToken) {
            return;
        }
        owner?.Cancel();
        owner?.Dispose();
        previousOwner = OwnerCancellationToken;
        owner = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token, OwnerCancellationToken);
        ownerToken = owner.Token;
    }
    private async Task<TeamMetadataOutcome> SaveAsync(TeamMetadataSubmission submission, CancellationToken token) {
        if (disposed || ownerToken.IsCancellationRequested) {
            return new TeamMetadataOutcome.Rejected();
        }
        try {
            var accepted = await WorkspaceService.SaveAgentTeamMetadataAsync(submission.ToEditorModel(), token);
            return accepted.Id is { } id ? new TeamMetadataOutcome.Accepted(id) : new TeamMetadataOutcome.Unknown();
        } catch (AgentTeamMetadataRejectedException) {
            return new TeamMetadataOutcome.Rejected();
        } catch (Exception error) {
            Logger.LogWarning("Team metadata acknowledgement unavailable for {TeamId}: {FailureType}", submission.Id, error.GetType().Name);
            return new TeamMetadataOutcome.Unknown();
        }
    }
    private async Task<string?> ChooseIconAsync(string selected, CancellationToken token) {
        var result = await DialogService.OpenAsync<MaterialIconPickerDialog>("Choose team icon",
            new Dictionary<string, object?> {
                [nameof(MaterialIconPickerDialog.SelectedIcon)] = selected,
                [nameof(MaterialIconPickerDialog.OwnerCancellationToken)] = token
            }, new DialogOptions {
                Eyebrow = "Team identity", Subtitle = "Pick a Material icon for this AgentFramework team.", Size = ModalSize.Wide,
                DenseChrome = true, AriaLabel = "Choose team icon", TestId = "material-icon-picker-dialog-shell"
            }, token);
        return result as string;
    }
    private Task CompleteAsync(Guid id) => disposed || ownerToken.IsCancellationRequested ? Task.CompletedTask
        : DialogReference?.CloseAsync(new AgentTeamDetailsDialogResult(id)) ?? Task.CompletedTask;
    private Task CancelAsync() => disposed ? Task.CompletedTask : DialogReference?.CloseAsync() ?? Task.CompletedTask;
    private void ProfileChanged(object? sender, DatabaseProfileChangedNotification notification) {
        if (disposed) {
            return;
        }
        lifetime.Cancel();
        _ = InvokeAsync(() => {
            if (!disposed) {
                StateHasChanged();
            }
        });
    }
    public void Dispose() {
        if (disposed) {
            return;
        }
        disposed = true;
        ProfileChanges.Changed -= ProfileChanged;
        editor?.Dispose();
        lifetime.Cancel();
        owner?.Dispose();
        lifetime.Dispose();
    }
}

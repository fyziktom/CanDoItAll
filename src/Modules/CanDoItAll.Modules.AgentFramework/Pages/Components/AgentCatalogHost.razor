@using Microsoft.AspNetCore.Components
@implements IDisposable
@using CanDoItAll.Infrastructure.Persistence
@using Microsoft.Extensions.Logging
@inject IDatabaseSwitchNotificationService ProfileChanges
@inject ILogger<AgentCatalogHost> Logger

@if (teamRecovery is { } recovery) {
    <Alert AlertStyle="@(recovery.Confirmed ? AlertStyle.Warning : AlertStyle.Danger)" data-testid="agents-team-recovery">
        @(recovery.Confirmed ? "The team change was saved, but the catalog could not refresh." : "The team change could not be confirmed. Check the current catalog before editing again.")
        <Button Text="Reload catalog" Click="RetryTeamReadbackAsync" data-testid="agents-team-retry-read" />
    </Alert>
}
<AgentCatalogPanel Snapshot="@snapshot"
                   Selection="@(new AgentCatalogSelection(selectedAgentId, selectedTeamId))"
                   IsLoading="@isLoading"
                   OpeningManagedAgentChatId="@openingManagedAgentChatId"
                   Intent="HandleIntentAsync" />

@code {
    [Parameter]
    public Guid? RequestedAgentId { get; set; }

    [Parameter]
    public Guid? RequestedTeamId { get; set; }

    [Parameter]
    public IReadOnlyList<AgentDefinition>? InitialAgents { get; set; }

    [Parameter]
    public IReadOnlyList<ProviderProfile>? InitialProviders { get; set; }

    [Parameter]
    public IReadOnlyList<AgentTeamDefinition>? InitialTeams { get; set; }

    [Parameter]
    public bool SkipCatalogRepair { get; set; }

    [Parameter]
    public EventCallback<AgentDefinition?> SelectedAgentChanged { get; set; }

    [Parameter]
    public EventCallback<AgentTeamDefinition?> SelectedTeamChanged { get; set; }

    [Parameter]
    public EventCallback<AgentChatContextAccessState> ContextAccessStateChanged { get; set; }

    [Inject]
    public IAgentCatalogOperations CatalogOperations { get; set; } = default!;

    [Inject]
    public NotificationService NotificationService { get; set; } = default!;

    [Inject]
    public DialogService DialogService { get; set; } = default!;

    [Inject]
    public IAgentChatLauncher AgentChatLauncher { get; set; } = default!;

    private readonly Dictionary<Guid, AgentEditorTarget> editorTargets = [];
    public IReadOnlyList<AgentEditorTarget> OpenEditorTargets => editorTargets.Values.ToArray();

    private readonly CancellationTokenSource lifetime = new();
    private CancellationToken lifetimeToken;
    private bool isDisposed;
    private long requestGeneration;
    private long catalogGeneration;
    private long teamSelectionRevision;
    private CancellationTokenSource? teamDialog;
    private bool teamMutationBusy;
    private TeamRecovery? teamRecovery;

    public void Dispose() {
        if (isDisposed) {
            return;
        }
        isDisposed = true;
        ProfileChanges.Changed -= OnProfileChanged;
        lifetime.Cancel();
        lifetime.Dispose();
        editorTargets.Clear();
    }

    private bool IsCurrentRequest(long generation) => !isDisposed && !lifetimeToken.IsCancellationRequested && requestGeneration == generation;


    private AgentCatalogSnapshot snapshot = AgentCatalogSnapshot.Empty;
    private IReadOnlyList<AgentDefinition> agents => snapshot.Agents;
    private IReadOnlyList<AgentTeamDefinition> teams => snapshot.Teams;
    private bool hasLoaded;
    private bool isLoading = true;
    private bool interactiveReloadAttempted;
    private Task? loadTask;
    private object? initialLoadOwner;
    private Guid? selectedAgentId;
    private Guid? selectedTeamId;
    private Guid? appliedRequestedTeamId;
    private Guid? openedRequestedAgentId;
    private Guid? openingManagedAgentChatId;
    private AgentChatContextAccessState? publishedAccessState;
    private Guid? contextRequestedAgentId;
    private Guid? contextRequestedTeamId;
    private bool contextRequestApplied;

    private AgentTeamDefinition? SelectedTeam => teams.FirstOrDefault(team => team.Id == selectedTeamId);

    private Task HandleIntentAsync(AgentCatalogIntent intent) => isDisposed ? Task.CompletedTask : intent switch {
        AgentCatalogIntent.SelectAgent select => SelectAgentAsync(select.AgentId),
        AgentCatalogIntent.SelectTeamMember select => SelectTeamMemberAsync(select.AgentId),
        AgentCatalogIntent.SelectTeam select => SelectTeamAsync(select.TeamId),
        AgentCatalogIntent.OpenAgent open => QueueAgentDetailsDialogAsync(open.AgentId),
        AgentCatalogIntent.OpenTeam open => QueueTeamDetailsDialogAsync(open.TeamId),
        AgentCatalogIntent.OpenChat open => OpenManagedAgentChatAsync(agents.First(agent => agent.Id == open.AgentId)),
        AgentCatalogIntent.EditMembers edit when edit.TeamId == selectedTeamId => OpenSelectedTeamMembersDialogAsync(),
        AgentCatalogIntent.DeleteTeam delete when delete.TeamId == selectedTeamId => DeleteSelectedTeamAsync(),
        _ => throw new InvalidOperationException("The catalog intent does not match the current selection.")
    };

    private async Task SelectTeamAsync(Guid? teamId) {
        if (selectedTeamId != teamId) {
            teamSelectionRevision++;
            InvalidateTeamDialog();
        }
        selectedTeamId = teamId;
        await SelectedTeamChanged.InvokeAsync(SelectedTeam);
    }

    private async Task SelectTeamMemberAsync(Guid agentId) {
        selectedAgentId = agentId;
        await SelectedAgentChanged.InvokeAsync(agents.First(agent => agent.Id == agentId));
    }

    protected override async Task OnInitializedAsync() {
        lifetimeToken = lifetime.Token;
        ProfileChanges.Changed += OnProfileChanged;
        await EnsureLoadedAsync();
    }

    protected override async Task OnParametersSetAsync() {
        if (isDisposed) {
            return;
        }
        var previousAgentId = contextRequestedAgentId;
        var agentRequestChanged = !contextRequestApplied || previousAgentId != RequestedAgentId;
        var requestChanged = !contextRequestApplied || agentRequestChanged || contextRequestedTeamId != RequestedTeamId;
        if (requestChanged) {
            InvalidateTeamDialog();
            teamSelectionRevision++;
            requestGeneration++;
            contextRequestApplied = true;
            contextRequestedAgentId = RequestedAgentId;
            contextRequestedTeamId = RequestedTeamId;
            publishedAccessState = null;
        }
        var generation = requestGeneration;
        if (requestChanged) {
            await PublishAccessStateAsync(AgentChatContextAccessState.Loading);
        }
        if (!IsCurrentRequest(generation)) {
            return;
        }
        await EnsureLoadedAsync();
        if (!IsCurrentRequest(generation)) {
            return;
        }
        if (!RequestedAgentId.HasValue || agents.All(agent => agent.Id != RequestedAgentId.Value)) {
            if (agentRequestChanged && openedRequestedAgentId == previousAgentId) {
                openedRequestedAgentId = null;
            }
            if (agentRequestChanged && previousAgentId.HasValue && selectedAgentId == previousAgentId) {
                selectedAgentId = null;
                await SelectedAgentChanged.InvokeAsync(null);
                if (!IsCurrentRequest(generation)) {
                    return;
                }
            }
        }
        ApplyRequestedTeam();
        await OpenRequestedAgentDialogIfNeededAsync();
        if (!IsCurrentRequest(generation)) {
            return;
        }
        await PublishAccessStateAsync(
            HasValidRequestedSelection() ? AgentChatContextAccessState.Ready : AgentChatContextAccessState.Failed);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender ||
            interactiveReloadAttempted ||
            hasLoaded) {
            return;
        }

        interactiveReloadAttempted = true;
        await EnsureLoadedAsync();
        if (!isDisposed) {
            StateHasChanged();
        }
    }

    private Task EnsureLoadedAsync() {
        if (isDisposed || hasLoaded) {
            return Task.CompletedTask;
        }

        if (loadTask is not null) {
            return loadTask;
        }

        var owner = new object();
        initialLoadOwner = owner;
        var task = LoadAsync(owner);
        if (ReferenceEquals(initialLoadOwner, owner)) {
            loadTask = task;
        }
        return task;
    }

    private async Task LoadAsync(object owner) {
        if (isDisposed) {
            return;
        }
        using var request = CancellationTokenSource.CreateLinkedTokenSource(lifetimeToken);
        var generation = ++catalogGeneration;
        isLoading = true;
        try {
            await PublishAccessStateAsync(AgentChatContextAccessState.Loading);
            if (isDisposed) {
                return;
            }
            var loaded = await CatalogOperations.LoadAsync(new(!SkipCatalogRepair, InitialAgents, InitialProviders, InitialTeams), request.Token);
            if (isDisposed || generation != catalogGeneration) {
                return;
            }
            snapshot = loaded;

            if (RequestedAgentId.HasValue &&
                agents.Any(item => item.Id == RequestedAgentId.Value)) {
                selectedAgentId = RequestedAgentId.Value;
            }

            ApplyRequestedTeam(force: true);

            hasLoaded = true;
            await PublishAccessStateAsync(
                HasValidRequestedSelection()
                    ? AgentChatContextAccessState.Ready
                    : AgentChatContextAccessState.Failed);
        } catch (OperationCanceledException) when (request.Token.IsCancellationRequested) {
        } catch {
            if (isDisposed || generation != catalogGeneration) {
                return;
            }
            await PublishAccessStateAsync(AgentChatContextAccessState.Failed);
            throw;
        } finally {
            if (!isDisposed && generation == catalogGeneration) {
                isLoading = false;
            }
            if (ReferenceEquals(initialLoadOwner, owner)) {
                initialLoadOwner = null;
                loadTask = null;
            }
        }
    }

    private async Task OpenRequestedAgentDialogIfNeededAsync() {
        if (!RequestedAgentId.HasValue ||
            openedRequestedAgentId == RequestedAgentId.Value ||
            !agents.Any(item => item.Id == RequestedAgentId.Value)) {
            return;
        }

        openedRequestedAgentId = RequestedAgentId.Value;
        selectedAgentId = RequestedAgentId.Value;
        var agentId = RequestedAgentId.Value;
        var generation = requestGeneration;
        await SelectedAgentChanged.InvokeAsync(agents.First(item => item.Id == agentId));
        if (IsCurrentRequest(generation) && RequestedAgentId == agentId) {
            _ = OpenAgentDetailsDialogAsync(agentId);
        }
    }

    private async Task SelectAgentAsync(Guid agentId) {
        selectedAgentId = agentId;
        openedRequestedAgentId = agentId;
        await SelectedAgentChanged.InvokeAsync(agents.First(item => item.Id == agentId));
        await PublishAccessStateAsync(AgentChatContextAccessState.Ready);
    }

    private async Task OpenManagedAgentChatAsync(AgentDefinition agent) {
        if (isDisposed) {
            return;
        }
        using var request = CancellationTokenSource.CreateLinkedTokenSource(lifetimeToken);
        if (openingManagedAgentChatId.HasValue) {
            return;
        }

        if (!IsManagedQuickChatAgent(agent)) {
            throw new InvalidOperationException(
                "Only an exact configured managed-agent identity can open a quick chat window.");
        }

        selectedAgentId = agent.Id;
        await SelectedAgentChanged.InvokeAsync(agent);
        if (isDisposed) {
            return;
        }
        openingManagedAgentChatId = agent.Id;
        try {
            await AgentChatLauncher.StartNewChatAsync(agent.Id, request.Token);
            if (isDisposed) {
                return;
            }
            NotificationService.Success("Chat ready", $"Opened a new chat with {agent.Name}.");
        } catch (OperationCanceledException) when (request.Token.IsCancellationRequested) {
        } catch (Exception) {
            if (isDisposed) {
                return;
            }
            NotificationService.Error("Unable to open managed agent chat", "The chat could not be opened. Check its current state before retrying.");
        } finally {
            if (!isDisposed) {
                openingManagedAgentChatId = null;
            }
        }
    }

    private static bool IsManagedQuickChatAgent(AgentDefinition agent) {
        return HrAgentIdentity.Matches(agent) ||
               PromptsCuratorAgentIdentity.Matches(agent) ||
               WorkflowCuratorAgentIdentity.Matches(agent) ||
               SchedulerAgentIdentity.Matches(agent);
    }

    private Task OpenSelectedTeamMembersDialogAsync() {
        _ = OpenTeamMembersDialogAsync();
        return Task.CompletedTask;
    }

    private Task QueueAgentDetailsDialogAsync(Guid? agentId) {
        _ = OpenAgentDetailsDialogAsync(agentId);
        return Task.CompletedTask;
    }

    private Task QueueTeamDetailsDialogAsync(Guid? teamId) {
        _ = OpenTeamDetailsDialogAsync(teamId);
        return Task.CompletedTask;
    }

    private async Task OpenAgentDetailsDialogAsync(Guid? agentId) {
        if (isDisposed) {
            return;
        }
        using var request = CancellationTokenSource.CreateLinkedTokenSource(lifetimeToken);
        if (isDisposed) {
            return;
        }
        var presentationId = Guid.NewGuid();
        if (agentId.HasValue) {
            openedRequestedAgentId = agentId.Value;
            selectedAgentId = agentId.Value;
            await SelectedAgentChanged.InvokeAsync(agents.FirstOrDefault(item => item.Id == agentId.Value));
        }

        if (isDisposed || (agentId.HasValue && selectedAgentId != agentId)) {
            return;
        }
        editorTargets.Add(presentationId, new(agentId));
        try {
            var title = agentId.HasValue
                ? ResolveDialogTitle(agentId.Value)
                : "New technical agent";

            var result = await DialogService.OpenAsync<AgentDetailsDialog>(
                title,
                new Dictionary<string, object?> {
                    [nameof(AgentDetailsDialog.AgentId)] = agentId,
                    [nameof(AgentDetailsDialog.InitialProviders)] = InitialProviders,
                    [nameof(AgentDetailsDialog.TargetChanged)] =
                        EventCallback.Factory.Create<AgentEditorTarget>(this, target => {
                            if (editorTargets.ContainsKey(presentationId)) {
                                editorTargets[presentationId] = target;
                            }
                        }),
                    [nameof(AgentDetailsDialog.Saved)] =
                        EventCallback.Factory.Create<AgentDetailsDialogResult>(this, result =>
                            HandleAgentDialogSavedAsync(presentationId, result))
                },
                new DialogOptions {
                    Eyebrow = "Technical editor",
                    Subtitle = "Edit identity, runtime, access policy, and capabilities for this technical agent.",
                    Size = ModalSize.Full,
                    DenseChrome = true,
                    AriaLabel = "Agent details editor",
                    TestId = "agents-details-dialog"
                }, request.Token);

            if (result is AgentDetailsDialogResult dialogResult) {
                await HandleAgentDialogSavedAsync(presentationId, dialogResult);
            }
        } catch (OperationCanceledException) when (request.Token.IsCancellationRequested) {
        } catch (Exception) {
            if (isDisposed) {
                return;
            }
            NotificationService.Error("Agent dialog failed", "The agent editor could not be completed. Reload the catalog before continuing.");
        } finally {
            editorTargets.Remove(presentationId);
        }
    }

    private bool IsCurrentEditorResult(Guid presentationId, AgentDetailsDialogResult result)
        => !isDisposed && result.AgentId is { } agentId && editorTargets.TryGetValue(presentationId, out var target) && target.AgentId == agentId;

    private string ResolveDialogTitle(Guid agentId) {
        var agent = agents.FirstOrDefault(item => item.Id == agentId);
        return string.IsNullOrWhiteSpace(agent?.Name)
            ? "Agent details"
            : agent.Name;
    }

    private async Task HandleAgentDialogSavedAsync(Guid presentationId, AgentDetailsDialogResult result) {
        if (!IsCurrentEditorResult(presentationId, result)) {
            return;
        }
        var generation = requestGeneration;
        await ReloadCatalogAsync();
        if (!IsCurrentRequest(generation) || !IsCurrentEditorResult(presentationId, result)) {
            return;
        }
        if (result.Deleted) {
            selectedAgentId = null;
            await SelectedAgentChanged.InvokeAsync(null);
            await RenderIfAliveAsync();
            return;
        }

        if (result.AgentId.HasValue) {
            openedRequestedAgentId = result.AgentId.Value;
            selectedAgentId = result.AgentId.Value;
            await SelectedAgentChanged.InvokeAsync(agents.FirstOrDefault(item => item.Id == result.AgentId.Value));
        }

        await RenderIfAliveAsync();
    }

    private bool CanStartTeamOperation => !isDisposed && !lifetimeToken.IsCancellationRequested && !teamMutationBusy && teamRecovery is null;

    private CancellationTokenSource BeginTeamDialog() {
        InvalidateTeamDialog();
        teamDialog = CancellationTokenSource.CreateLinkedTokenSource(lifetimeToken);
        return teamDialog;
    }

    private void InvalidateTeamDialog() {
        teamDialog?.Cancel();
        teamDialog = null;
    }

    private bool IsCurrentTeamDialog(long generation, CancellationTokenSource owner)
        => IsCurrentRequest(generation) && ReferenceEquals(teamDialog, owner) && !owner.IsCancellationRequested;

    private async Task OpenTeamDetailsDialogAsync(Guid? teamId) {
        if (!CanStartTeamOperation) {
            return;
        }
        using var request = BeginTeamDialog();
        var generation = requestGeneration;
        var selection = teamSelectionRevision;
        try {
            var result = await DialogService.OpenAsync<AgentTeamDetailsDialog>(teamId.HasValue ? "Edit agent team" : "New agent team",
                new Dictionary<string, object?> {
                    [nameof(AgentTeamDetailsDialog.TeamId)] = teamId,
                    [nameof(AgentTeamDetailsDialog.OwnerCancellationToken)] = request.Token
                }, new DialogOptions {
                    Eyebrow = "Technical team", Subtitle = "Create or rename an AgentFramework team for filtering and process delivery.",
                    Size = ModalSize.Compact, AriaLabel = "Agent team editor", TestId = "agents-team-details-dialog-shell"
                }, request.Token);
            if (!IsCurrentTeamDialog(generation, request) || result is not AgentTeamDetailsDialogResult saved
                || teamId.HasValue && saved.TeamId != teamId.Value) {
                return;
            }
            await ReconcileTeamAsync(new(saved.TeamId, false, true, selection), generation);
        } catch (Exception) when (!IsCurrentTeamDialog(generation, request)) {
        } catch (Exception error) {
            Logger.LogWarning("Team dialog failed for {TeamId}: {FailureType}", teamId, error.GetType().Name);
            NotificationService.Error("Team dialog failed", "The team editor could not be completed. Reload the catalog before continuing.");
        } finally {
            if (ReferenceEquals(teamDialog, request)) {
                teamDialog = null;
            }
        }
    }

    private async Task OpenTeamMembersDialogAsync() {
        var team = SelectedTeam;
        if (!CanStartTeamOperation || team is null) {
            return;
        }
        using var request = BeginTeamDialog();
        var generation = requestGeneration;
        var selection = teamSelectionRevision;
        try {
            var result = await DialogService.OpenAsync<AgentTeamMembersDialog>($"Add agents to {team.Name}",
                new Dictionary<string, object?> {
                    [nameof(AgentTeamMembersDialog.Team)] = team with { AgentIds = team.AgentIds.ToArray() },
                    [nameof(AgentTeamMembersDialog.Agents)] = agents.ToArray(),
                    [nameof(AgentTeamMembersDialog.PrivateAgentIds)] = ResolvePrivateAgentIds(),
                    [nameof(AgentTeamMembersDialog.OwnerCancellationToken)] = request.Token
                }, new DialogOptions {
                    Eyebrow = "Team membership", Subtitle = "Click agent cards to select multiple agents, then confirm the team membership.",
                    Size = ModalSize.Wide, AriaLabel = "Add agents to team", TestId = "agents-team-members-dialog-shell"
                }, request.Token);
            if (!IsCurrentTeamDialog(generation, request) || result is not AgentTeamMembersDialogResult members || members.TeamId != team.Id) {
                return;
            }
            var intendedIds = members.AgentIds.ToArray();
            teamMutationBusy = true;
            await CatalogOperations.UpdateMembersAsync(team.Id, intendedIds, request.Token);
            if (IsCurrentTeamDialog(generation, request)) {
                await ReconcileTeamAsync(new(team.Id, false, true, selection), generation);
            }
        } catch (Exception) when (!IsCurrentTeamDialog(generation, request)) {
        } catch (Exception error) {
            Logger.LogWarning("Team membership acknowledgement unavailable for {TeamId}: {FailureType}", team.Id, error.GetType().Name);
            teamRecovery = new(team.Id, false, false, selection);
            NotificationService.Error("Team membership failed", "The membership change could not be confirmed. Reload the team before retrying.");
        } finally {
            teamMutationBusy = false;
            if (ReferenceEquals(teamDialog, request)) {
                teamDialog = null;
            }
            await RenderIfAliveAsync();
        }
    }

    private async Task DeleteSelectedTeamAsync() {
        var team = SelectedTeam;
        if (!CanStartTeamOperation || team is null) {
            return;
        }
        using var request = CancellationTokenSource.CreateLinkedTokenSource(lifetimeToken);
        var generation = requestGeneration;
        var selection = teamSelectionRevision;
        teamMutationBusy = true;
        try {
            await CatalogOperations.DeleteTeamAsync(team.Id, request.Token);
            if (IsCurrentRequest(generation)) {
                await ReconcileTeamAsync(new(team.Id, true, true, selection), generation);
            }
        } catch (Exception) when (!IsCurrentRequest(generation)) {
        } catch (Exception error) {
            Logger.LogWarning("Team deletion acknowledgement unavailable for {TeamId}: {FailureType}", team.Id, error.GetType().Name);
            teamRecovery = new(team.Id, true, false, selection);
            NotificationService.Error("Team delete failed", "The deletion could not be confirmed. Reload the catalog before retrying.");
        } finally {
            teamMutationBusy = false;
            await RenderIfAliveAsync();
        }
    }

    private async Task ReconcileTeamAsync(TeamRecovery recovery, long generation) {
        teamRecovery = recovery;
        try {
            var published = await ReloadCatalogAsync();
            if (!published || !IsCurrentRequest(generation) || !ReferenceEquals(teamRecovery, recovery)) {
                return;
            }
            if (recovery.SelectionRevision == teamSelectionRevision) {
                selectedTeamId = !recovery.Deleted && teams.Any(team => team.Id == recovery.TeamId) ? recovery.TeamId : null;
                await SelectedTeamChanged.InvokeAsync(SelectedTeam);
            }
            if (ReferenceEquals(teamRecovery, recovery)) {
                teamRecovery = null;
            }
            if (IsCurrentRequest(generation)) {
                NotificationService.Success(recovery.Confirmed ? recovery.Deleted ? "Team deleted" : "Team updated" : "Catalog reloaded",
                    recovery.Confirmed ? "The saved team change is reflected in the catalog." : "Review the current team before making another change.");
            }
        } catch (Exception) when (!IsCurrentRequest(generation)) {
        } catch (Exception error) {
            Logger.LogWarning("Team catalog read-back failed for {TeamId}; confirmed={Confirmed}: {FailureType}", recovery.TeamId, recovery.Confirmed, error.GetType().Name);
            NotificationService.Warning(recovery.Confirmed ? "Team saved; refresh failed" : "Team outcome needs review",
                "Reload the catalog to read the current state. The team change will not be repeated.");
        }
        await RenderIfAliveAsync();
    }

    private Task RetryTeamReadbackAsync() => teamRecovery is { } recovery && IsCurrentRequest(requestGeneration)
        ? ReconcileTeamAsync(recovery, requestGeneration) : Task.CompletedTask;

    private void OnProfileChanged(object? sender, DatabaseProfileChangedNotification notification) {
        if (isDisposed) {
            return;
        }
        requestGeneration++;
        catalogGeneration++;
        lifetime.Cancel();
        _ = InvokeAsync(() => {
            if (!isDisposed) {
                snapshot = AgentCatalogSnapshot.Empty;
                teamRecovery = null;
                StateHasChanged();
            }
        });
    }

    private sealed record TeamRecovery(Guid TeamId, bool Deleted, bool Confirmed, long SelectionRevision);

    private async Task<bool> ReloadCatalogAsync() {
        if (isDisposed) {
            return false;
        }
        using var request = CancellationTokenSource.CreateLinkedTokenSource(lifetimeToken);
        if (isDisposed) {
            return false;
        }
        var generation = ++catalogGeneration;
        try {
            var loaded = await CatalogOperations.LoadAsync(new(Repair: false), request.Token);
            if (isDisposed || request.IsCancellationRequested || generation != catalogGeneration) {
                return false;
            }
            snapshot = loaded;
            hasLoaded = true;
            isLoading = false;
            if (selectedTeamId.HasValue && teams.All(item => item.Id != selectedTeamId.Value)) {
                selectedTeamId = null;
            }
            await PublishAccessStateAsync(
                HasValidRequestedSelection() ? AgentChatContextAccessState.Ready : AgentChatContextAccessState.Failed);
            return !isDisposed && !request.IsCancellationRequested && generation == catalogGeneration;
        } catch (Exception) when (isDisposed || generation != catalogGeneration) {
            return false;
        } finally {
            if (!isDisposed && generation == catalogGeneration) {
                isLoading = false;
            }
        }
    }

    private void ApplyRequestedTeam(bool force = false) {
        if (!force &&
            appliedRequestedTeamId == RequestedTeamId) {
            return;
        }

        appliedRequestedTeamId = RequestedTeamId;
        if (!RequestedTeamId.HasValue) {
            selectedTeamId = null;
            return;
        }

        selectedTeamId = teams.Any(item => item.Id == RequestedTeamId.Value)
            ? RequestedTeamId.Value
            : null;

    }

    private bool HasValidRequestedSelection()
        => (!RequestedAgentId.HasValue || agents.Any(item => item.Id == RequestedAgentId.Value)) &&
           (!RequestedTeamId.HasValue || teams.Any(item => item.Id == RequestedTeamId.Value));

    private async Task PublishAccessStateAsync(AgentChatContextAccessState state) {
        if (isDisposed || publishedAccessState == state) {
            return;
        }

        publishedAccessState = state;
        await ContextAccessStateChanged.InvokeAsync(state);
    }

    private Task RenderIfAliveAsync() => isDisposed ? Task.CompletedTask : InvokeAsync(StateHasChanged);

    private IReadOnlyCollection<Guid> ResolvePrivateAgentIds() {
        return agents
            .Where(snapshot.UsesPrivateProvider)
            .Select(agent => agent.Id)
            .ToHashSet();
    }

}

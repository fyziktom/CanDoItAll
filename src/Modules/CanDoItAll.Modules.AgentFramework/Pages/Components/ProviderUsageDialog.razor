@using System.Collections.Immutable
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject IAgentsWorkspaceQuery WorkspaceQuery
@inject ILogger<ProviderUsageDialog> Logger

@if (isLoading) {
    <LoadingState Eyebrow="Provider usage"
                  Title="Loading provider usage"
                  Description="Reading provider-level usage aggregates for this workspace." />
}
else if (!string.IsNullOrWhiteSpace(loadError)) {
    <EmptyState Eyebrow="Usage unavailable"
                Title="Provider usage could not be loaded"
                Description="@loadError" />
}
else {
    <Stack GapScale="LayoutGap.Large"
           data-testid="provider-usage-dialog">
        @if (!snapshot.IsComplete) {
            <Alert AlertStyle="AlertStyle.Warning" data-testid="usage-dialog-partial">
                Some usage evidence is unavailable. Displayed totals are partial.
            </Alert>
        }
        <Grid Gap="LayoutGap.Medium"
              ColumnTemplate="repeat(auto-fit,minmax(9rem,1fr))">
            <MetricCard Label="Providers" Value="@AgentUsageDisplay.FormatCount(snapshot.Providers.Count)" />
            <MetricCard Label="Usage observations" Value="@AgentUsageDisplay.FormatCount(snapshot.Totals.UsageObservationCount)" />
            <MetricCard Label="Unknown observations" Value="@AgentUsageDisplay.FormatCount(snapshot.Totals.UnknownUsageObservationCount)" />
            <MetricCard Label="Tokens" Value="@AgentUsageDisplay.FormatTokens(snapshot.Totals.Tokens.TotalTokens)" />
            <MetricCard Label="Known cost" Value="@AgentUsageDisplay.FormatCost(snapshot.Totals.KnownCostUsd)" />
            <MetricCard Label="Unpriced" Value="@AgentUsageDisplay.FormatCount(snapshot.Totals.UnpricedObservationCount)" />
            <MetricCard Label="Failed executions" Value="@AgentUsageDisplay.FormatCount(snapshot.Totals.FailedExecutionCount)" />
        </Grid>

        <Grid Gap="LayoutGap.Large"
              ColumnsLg="2">
            <CdaChart Title="Provider usage"
                      Description="Provider usage observations captured from technical executions."
                      Series="@ProviderUsageBarSeries"
                      Options="@ProviderUsageBarChartOptions"
                      Height="320"
                      EmptyText="No provider usage has been recorded." />
            <CdaChart Title="Provider share"
                      Description="Distribution across total provider usage observations in this workspace."
                      Series="@ProviderUsageDonutSeries"
                      Options="@ProviderUsageDonutChartOptions"
                      Height="320"
                      EmptyText="Provider share is not available yet." />
        </Grid>

        <SurfaceCard Soft="true">
            @if (snapshot.Providers.Count == 0) {
                <EmptyState Eyebrow="No usage"
                            Title="No provider usage rows"
                            Description="Provider usage rows appear after executions report usage observations." />
            }
            else {
                <DataGrid TItem="ProviderUsageProviderRow"
                          Data="@ProviderRows"
                          AllowPaging="true"
                          PageSize="10"
                          data-testid="provider-usage-dialog-grid">
                    <Columns>
                        <DataGridColumn TItem="ProviderUsageProviderRow" Title="Provider">
                            <Template Context="provider">
                                <Stack Gap="0.15rem">
                                    <span class="font-medium text-slate-950">@provider.ProviderName</span>
                                    <span class="text-xs text-slate-500">@provider.ProviderKind</span>
                                </Stack>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="ProviderUsageProviderRow" Title="Share">
                            <Template Context="provider">
                                <span>@AgentUsageDisplay.FormatUsageShare(provider.Totals.UsageObservationCount, TotalProviderUsage)</span>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="ProviderUsageProviderRow" Title="Observations">
                            <Template Context="provider">
                                <span>@AgentUsageDisplay.FormatCount(provider.Totals.UsageObservationCount)</span>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="ProviderUsageProviderRow" Title="Unknown">
                            <Template Context="provider">
                                <span>@AgentUsageDisplay.FormatCount(provider.Totals.UnknownUsageObservationCount)</span>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="ProviderUsageProviderRow" Title="Tokens">
                            <Template Context="provider">
                                <span>@AgentUsageDisplay.FormatTokens(provider.Totals.Tokens.TotalTokens)</span>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="ProviderUsageProviderRow" Title="Known cost">
                            <Template Context="provider">
                                <span>@AgentUsageDisplay.FormatCost(provider.Totals.KnownCostUsd)</span>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="ProviderUsageProviderRow" Title="Unpriced">
                            <Template Context="provider">
                                <StatusBadge Tone="@(provider.Totals.UnpricedObservationCount > 0 ? "warning" : "success")"
                                             Text="@AgentUsageDisplay.FormatCount(provider.Totals.UnpricedObservationCount)"
                                             NoWrap="true" />
                            </Template>
                        </DataGridColumn>
                    </Columns>
                </DataGrid>
            }
        </SurfaceCard>

        <Cluster JustifyContent="JustifyContent.End">
            <Button Text="Close"
                    Icon="close"
                    Variant="Variant.Outlined"
                    Click="CloseAsync" />
        </Cluster>
    </Stack>
}

@code {
    private readonly CdaChartOptions ProviderUsageBarChartOptions = new() {
        Type = CdaChartType.Bar,
        XAxisType = CdaChartAxisType.Category,
        Unit = "observations",
        YAxisTitle = "Usage observations",
        ShowToolbar = false,
        EnableZoom = false,
        ShowLegend = false,
        ValuePrecision = 0,
        TooltipPrecision = 0,
        Palette = CdaChartPalette.Calm.ToImmutableArray()
    };

    private readonly CdaChartOptions ProviderUsageDonutChartOptions = new() {
        Type = CdaChartType.Donut,
        XAxisType = CdaChartAxisType.Category,
        Unit = "observations",
        ShowToolbar = false,
        EnableZoom = false,
        ShowLegend = true,
        ShowDataLabels = true,
        ValuePrecision = 0,
        TooltipPrecision = 0,
        LegendPosition = CdaChartLegendPosition.Bottom,
        Palette = CdaChartPalette.Energetic.ToImmutableArray()
    };

    [CascadingParameter]
    public DialogReference? DialogReference { get; set; }

    [Parameter]
    public ProviderUsageWorkloadSelection Selection { get; set; } = ProviderUsageWorkloadSelection.Both;

    private ProviderUsageSnapshot snapshot = ProviderUsageSnapshot.Empty(ProviderUsageWorkloadSelection.Both);
    private bool isLoading = true;
    private bool disposed;
    private long generation;
    private ProviderUsageWorkloadSelection? requestedSelection;
    private CancellationTokenSource? readCancellation;
    private string? loadError;

    private IReadOnlyList<ProviderUsageProviderRow> ProviderRows =>
        snapshot.Providers
            .OrderByDescending(item => item.Totals.UsageObservationCount)
            .ThenBy(item => item.ProviderName, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private decimal TotalProviderUsage => ProviderRows.Sum(item => item.Totals.UsageObservationCount);

    private IReadOnlyList<CdaChartSeries> ProviderUsageBarSeries => BuildProviderUsageSeries(CdaChartType.Bar, "Provider usage");

    private IReadOnlyList<CdaChartSeries> ProviderUsageDonutSeries => BuildProviderUsageSeries(CdaChartType.Donut, "Provider share");

    protected override async Task OnParametersSetAsync() {
        if (disposed || requestedSelection == Selection) {
            return;
        }
        var requestGeneration = ++generation;
        CancelRead();
        var request = Selection;
        requestedSelection = request;
        readCancellation = new();
        var owner = readCancellation;
        var token = owner.Token;
        isLoading = true;
        loadError = null;
        try {
            request.Validate();
            var result = await WorkspaceQuery.ReadUsageAsync(request, token);
            if (!IsCurrent()) {
                return;
            }
            if (result.Selection != request) {
                throw new InvalidDataException("Usage evidence returned a different requested scope.");
            }
            snapshot = result with {
                Consumers = result.Consumers.ToImmutableArray(),
                Providers = result.Providers.ToImmutableArray(),
                Models = result.Models.ToImmutableArray(),
                Sources = result.Sources.ToImmutableArray()
            };
        } catch (OperationCanceledException) when (token.IsCancellationRequested) {
        } catch (Exception exception) {
            if (IsCurrent()) {
                loadError = "Usage evidence could not be refreshed. Close this dialog and retry the selected scope.";
                Logger.LogWarning("Usage detail read failed ({FailureType}); scope {Scope}.", exception.GetType().Name, request);
            }
        } finally {
            if (IsCurrent()) {
                isLoading = false;
            }
            if (ReferenceEquals(readCancellation, owner)) {
                readCancellation = null;
            }
            owner.Dispose();
        }

        bool IsCurrent() => !disposed && generation == requestGeneration && Selection == request && !token.IsCancellationRequested;
    }

    private void CancelRead() {
        var owner = readCancellation;
        readCancellation = null;
        if (owner is null) {
            return;
        }
        owner.Cancel();
    }

    public void Dispose() {
        if (disposed) {
            return;
        }
        disposed = true;
        generation++;
        CancelRead();
    }

    private IReadOnlyList<CdaChartSeries> BuildProviderUsageSeries(CdaChartType chartType, string name) {
        if (ProviderRows.Count == 0) {
            return [];
        }

        return
        [
            new CdaChartSeries {
                Name = name,
                Type = chartType,
                Points = ProviderRows
                    .Take(12)
                    .Select(item => new CdaChartPoint(
                        AgentUsageDisplay.TrimLabel(item.ProviderName, 22),
                        item.Totals.UsageObservationCount))
                    .ToArray()
            }
        ];
    }

    private Task CloseAsync()
        => DialogReference?.CloseAsync() ?? Task.CompletedTask;
}

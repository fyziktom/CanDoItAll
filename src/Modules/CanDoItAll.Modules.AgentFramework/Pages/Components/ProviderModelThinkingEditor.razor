@using CanDoItAll.AgentFramework.Providers.UI

<ProviderThinkingSurface Model="Model" Provider="Provider">
    <SourceRefresh>
        @if (Provider is { IsSourceManaged: true } provider) {
            <SharedProviderRefreshButton ProviderId="provider.Id" Refreshed="Refreshed" />
        }
    </SourceRefresh>
</ProviderThinkingSurface>

@code {
    [Parameter, EditorRequired] public ProviderProfileEditorModel Model { get; set; } = default!;
    [Parameter] public ProviderProfile? Provider { get; set; }
    [Parameter] public EventCallback<SharedProviderChangeDelivery> Refreshed { get; set; }
}

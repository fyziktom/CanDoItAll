@using static CanDoItAll.CrmHr.UI.Recruiting.AgentRecruitingEvidencePresentation
@using System.Text
@using CanDoItAll.AgentFramework.Core
@using CanDoItAll.AgentFramework.Models
@using Microsoft.Extensions.Logging
@inject IAgentRecruitingEvidenceService EvidenceService
@inject IAgentFrameworkWorkspaceService AgentWorkspaceService
@inject NotificationService NotificationService
@inject ILogger<AgentRecruitingEvidencePanel> Logger

<AgentRecruitingEvidenceSurface View="this" />

@code {
    private AgentDefinition? candidate;
    private AgentRecruitingCandidateReadiness? readiness;
    private IReadOnlyList<AgentRecruitingInterview> interviews = [];
    private IReadOnlyList<AgentDefinition> evaluatorAgents = [];
    private IReadOnlyList<ProviderProfile> providers = [];
    private LoadIdentity? loadedIdentity;
    private string createCandidateName = string.Empty;
    private string createPurpose = string.Empty;
    private string loadError = string.Empty;
    private AttemptDraft attemptDraft = new();
    private long loadGeneration;
    private bool isLoading;
    private bool isSaving;
    private bool isCreateDialogOpen;
    private bool isAttachDialogOpen;

    [Parameter]
    public Guid? CandidateAgentId { get; set; }

    [Parameter]
    public Guid? RecruitmentApplicationId { get; set; }

    [Parameter]
    public Guid? ProjectId { get; set; }

    [Parameter]
    public EventCallback<RecruitmentTrainingRequest> RequestTraining { get; set; }

    [Parameter]
    public EventCallback<AgentRecruitingCandidateReadiness?> ReadinessChanged { get; set; }

    private int AttemptCount => interviews.Sum(item => item.Attempts.Count);

    private AgentRecruitingAssessmentAnalysis? LatestAnalysis => interviews
        .SelectMany(item => item.Attempts)
        .OrderByDescending(item => item.CreatedAtUtc)
        .Select(item => item.Analysis)
        .FirstOrDefault(item => item is not null);

    protected override async Task OnParametersSetAsync()
    {
        var identity = new LoadIdentity(CandidateAgentId, RecruitmentApplicationId);
        if (loadedIdentity == identity)
        {
            return;
        }

        loadedIdentity = identity;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var generation = Interlocked.Increment(ref loadGeneration);
        var identity = new LoadIdentity(
            CandidateAgentId,
            RecruitmentApplicationId);
        loadError = string.Empty;
        candidate = null;
        readiness = null;
        interviews = [];
        evaluatorAgents = [];
        providers = [];
        await ReadinessChanged.InvokeAsync(null);
        if (!IsCurrentLoad(generation, identity))
        {
            return;
        }

        if (!identity.CandidateAgentId.HasValue)
        {
            isLoading = false;
            return;
        }

        isLoading = true;
        try
        {
            var agentsTask = AgentWorkspaceService.ListAgentsAsync();
            var providersTask = AgentWorkspaceService.ListProvidersAsync();
            var readinessTask = EvidenceService.GetCandidateReadinessAsync(
                identity.CandidateAgentId.Value,
                identity.RecruitmentApplicationId);
            var interviewsTask = EvidenceService.ListCandidateInterviewsAsync(
                identity.CandidateAgentId.Value,
                identity.RecruitmentApplicationId);
            await Task.WhenAll(agentsTask, providersTask, readinessTask, interviewsTask);
            if (!IsCurrentLoad(generation, identity))
            {
                return;
            }

            var agents = await agentsTask;
            candidate = agents.FirstOrDefault(
                item => item.Id == identity.CandidateAgentId.Value);
            evaluatorAgents = agents
                .Where(item => !item.IsTemplate)
                .OrderBy(item => item.Name, StringComparer.OrdinalIgnoreCase)
                .ToArray();
            providers = (await providersTask)
                .OrderBy(item => item.Name, StringComparer.OrdinalIgnoreCase)
                .ToArray();
            readiness = await readinessTask;
            interviews = await interviewsTask;
            await ReadinessChanged.InvokeAsync(readiness);
        }
        catch when (!IsCurrentLoad(generation, identity))
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to load recruiting evidence for candidate agent {CandidateAgentId} and application {ApplicationId}.",
                identity.CandidateAgentId,
                identity.RecruitmentApplicationId);
            loadError = exception is AgentRecruitingEvidenceException evidenceException
                ? evidenceException.Message
                : "Assessment evidence could not be loaded. Refresh the workspace and try again.";
        }
        finally
        {
            if (IsCurrentLoad(generation, identity))
            {
                isLoading = false;
            }
        }
    }

    private bool IsCurrentLoad(long generation, LoadIdentity identity)
    {
        return generation == Volatile.Read(ref loadGeneration) &&
               loadedIdentity == identity;
    }

    private Task OpenCreateDialog()
    {
        createCandidateName = candidate?.Name ?? string.Empty;
        createPurpose = string.Empty;
        isCreateDialogOpen = true;
        return Task.CompletedTask;
    }

    private Task CloseCreateDialog()
    {
        isCreateDialogOpen = false;
        return Task.CompletedTask;
    }

    private Task OpenRecheckDialog(
        AgentRecruitingInterview interview,
        AgentRecruitingAttempt attempt)
    {
        createCandidateName = candidate?.Name ?? string.Empty;
        createPurpose =
            $"Recheck after assessment {interview.Id:D}, attempt {attempt.Id:D}: " +
            (attempt.Analysis?.Summary ?? interview.Purpose);
        isCreateDialogOpen = true;
        return Task.CompletedTask;
    }

    private async Task CreateAssessmentAsync()
    {
        if (candidate is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(createPurpose))
        {
            NotificationService.Error("Assessment purpose required", "Describe what this assessment must prove.");
            return;
        }

        // One admitted command at a time: assessment evidence is append-only, so a second dispatch must not write again.
        if (isSaving)
        {
            return;
        }

        var identity = loadedIdentity;
        var command = new CreateAgentRecruitingInterviewCommand(
            candidate.Id,
            AgentConfigurationVersion.Create(candidate),
            createPurpose,
            RecruitmentApplicationId,
            ProjectId);
        isSaving = true;
        try
        {
            try
            {
                await EvidenceService.CreateInterviewAsync(command);
            }
            catch (Exception exception)
            {
                if (identity == loadedIdentity)
                {
                    HandleSaveFailure(exception, "The assessment could not be created.");
                }

                return;
            }

            // The candidate changed while the owner was writing: the completion belongs to a retired target.
            if (identity != loadedIdentity)
            {
                return;
            }

            isCreateDialogOpen = false;
            NotificationService.Success("Assessment created", "The configuration-fenced assessment is ready for evidence.");
            await ReloadAsync();
        }
        finally
        {
            isSaving = false;
        }
    }

    private Task OpenAttachDialog()
    {
        var latestInterview = interviews.FirstOrDefault();
        if (latestInterview is null)
        {
            return Task.CompletedTask;
        }

        attemptDraft = new AttemptDraft
        {
            InterviewId = latestInterview.Id
        };
        isAttachDialogOpen = true;
        return Task.CompletedTask;
    }

    private Task CloseAttachDialog()
    {
        isAttachDialogOpen = false;
        return Task.CompletedTask;
    }

    private async Task AttachResultAsync()
    {
        if (!attemptDraft.InterviewId.HasValue ||
            !Guid.TryParse(attemptDraft.TargetId, out var targetId) ||
            targetId == Guid.Empty)
        {
            NotificationService.Error("Execution target required", "Choose an assessment and enter one valid target run ID.");
            return;
        }

        if (string.IsNullOrWhiteSpace(attemptDraft.AnalysisSummary))
        {
            NotificationService.Error("Analysis summary required", "Record the evidence-grounded classification summary.");
            return;
        }

        if (HasPartialEvaluatorProvenance(attemptDraft))
        {
            NotificationService.Error(
                "Evaluator provenance incomplete",
                "Evaluator agent, provider, and model must either all be supplied or all remain empty.");
            return;
        }

        var strengths = SplitLines(attemptDraft.Strengths);
        var gaps = SplitLines(attemptDraft.Gaps);
        var automatedEvaluation = HasCompleteEvaluatorProvenance(attemptDraft)
            ? new AgentRecruitingAutomatedEvaluation(
                attemptDraft.AutomatedDecision,
                attemptDraft.Score,
                attemptDraft.EvaluatorAgentId,
                attemptDraft.ProviderProfileId,
                attemptDraft.Model,
                attemptDraft.RubricVersion,
                strengths.Concat(gaps).ToArray(),
                DateTimeOffset.UtcNow)
            : null;
        var analysis = new AgentRecruitingAssessmentAnalysis(
            attemptDraft.Classification,
            attemptDraft.Confidence,
            attemptDraft.AnalysisSummary,
            attemptDraft.ProposedNextStep,
            strengths,
            gaps);

        if (isSaving)
        {
            return;
        }

        var identity = loadedIdentity;
        var interviewId = attemptDraft.InterviewId.Value;
        isSaving = true;
        try
        {
            try
            {
                await EvidenceService.AppendAttemptAsync(
                interviewId,
                new AppendAgentRecruitingAttemptCommand(
                    new AgentRecruitingExecutionTarget(attemptDraft.TargetKind, targetId),
                    attemptDraft.ChallengeKey,
                    attemptDraft.ChallengeVersion,
                    attemptDraft.RubricVersion,
                    attemptDraft.InputHash,
                    attemptDraft.OutputHash,
                    attemptDraft.StructuredOutputContractKey,
                    attemptDraft.StructuredOutputSchemaHash,
                    string.IsNullOrWhiteSpace(attemptDraft.StructuredOutputContractKey)
                        ? string.Empty
                        : "succeeded",
                    automatedEvaluation,
                    analysis));
            }
            catch (Exception exception)
            {
                if (identity == loadedIdentity)
                {
                    HandleSaveFailure(exception, "The result could not be attached.");
                }

                return;
            }

            if (identity != loadedIdentity)
            {
                return;
            }

            isAttachDialogOpen = false;
            NotificationService.Success("Result attached", "The target and typed analysis were appended to the assessment.");
            await ReloadAsync();
        }
        finally
        {
            isSaving = false;
        }
    }

    private void HandleSaveFailure(Exception exception, string fallbackMessage)
    {
        Logger.LogError(
            exception,
            "Recruiting evidence mutation failed for candidate agent {CandidateAgentId} and application {ApplicationId}.",
            CandidateAgentId,
            RecruitmentApplicationId);
        NotificationService.Error(
            "Assessment update failed",
            exception is AgentRecruitingEvidenceException evidenceException
                ? evidenceException.Message
                : fallbackMessage);
    }

    private static bool HasCompleteEvaluatorProvenance(AttemptDraft draft)
    {
        return draft.EvaluatorAgentId.HasValue &&
               draft.ProviderProfileId.HasValue &&
               !string.IsNullOrWhiteSpace(draft.Model);
    }

    private static bool HasPartialEvaluatorProvenance(AttemptDraft draft)
    {
        var supplied = new[]
        {
            draft.EvaluatorAgentId.HasValue,
            draft.ProviderProfileId.HasValue,
            !string.IsNullOrWhiteSpace(draft.Model)
        };
        return supplied.Any(item => item) && supplied.Any(item => !item);
    }

    private string FormatLatestScore()
    {
        var score = interviews
            .SelectMany(item => item.Attempts)
            .OrderByDescending(item => item.CreatedAtUtc)
            .Select(item => item.AutomatedEvaluation?.Score)
            .FirstOrDefault(item => item.HasValue);
        return score.HasValue ? $"{score.Value:0.#}/100" : "Not scored";
    }

    private string FormatLatestNextStep()
    {
        return LatestAnalysis is null
            ? "Create assessment"
            : FormatNextStep(LatestAnalysis.ProposedNextStep);
    }

    private static IReadOnlyList<string> SplitLines(string value)
    {
        return value
            .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.Ordinal)
            .ToArray();
    }

    private readonly record struct LoadIdentity(
        Guid? CandidateAgentId,
        Guid? RecruitmentApplicationId);
}

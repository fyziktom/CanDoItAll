<FormSection Title="Next action"
             Description="Capture the follow-up commitment explicitly so overdue work is visible on the CRM surface instead of hiding in notes.">
    <Grid Gap="LayoutGap.Large" ColumnsMd="2">
        <div>
            <FormField Text="Next action">
            <TextInput @bind-Value="Model.NextActionText"
                       data-testid="crmhr-next-action-text" />
            </FormField>
        </div>
        <div>
            <FormField Text="Owner">
            <SelectInput @bind-Value="Model.NextActionOwnerPartyId"
                         data-testid="crmhr-next-action-owner">
                <option value="">Select owner</option>
                @foreach (var option in OwnerOptions)
                {
                    <option value="@option.Id">@option.DisplayName (@option.PartyType)</option>
                }
            </SelectInput>
            </FormField>
        </div>
    </Grid>

    <div class="mt-5 max-w-sm">
        <FormField Text="Due on">
        <DateInput @bind-Value="Model.NextActionDueOn"
                   data-testid="crmhr-next-action-due-on" />
        </FormField>
    </div>
</FormSection>

@code {
    [Parameter, EditorRequired]
    public CrmInteractionEditorModel Model { get; set; } = new();

    [Parameter]
    public IReadOnlyList<PartyOptionModel> OwnerOptions { get; set; } = [];
}

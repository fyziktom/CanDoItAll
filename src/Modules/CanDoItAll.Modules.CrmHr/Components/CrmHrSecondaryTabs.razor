@inject NavigationManager Navigation

<Cluster Gap="LayoutGap.XSmall" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
    <SecondaryTabs Items="Tabs"
                   SelectedKey="@SelectedKey"
                   SelectedKeyChanged="HandleSelectedKeyChanged"
                   ShowActiveDescription="false" />
    <TooltipTarget Text="@ActiveDescription"
                   Position="TooltipPosition.Bottom"
                   TestId="crmhr-navigation-tooltip">
        <Button ButtonStyle="ButtonStyle.Light"
                Variant="Variant.Text"
                Size="ButtonSize.Small"
                Class="cda-button--quick"
                Icon="info"
                aria-label="@($"{ActiveLabel} tab information")" />
    </TooltipTarget>
</Cluster>

@code {
    private static readonly IReadOnlyDictionary<string, string> Routes = new Dictionary<string, string>(StringComparer.Ordinal)
    {
        ["home"] = "/crm-hr",
        ["directory"] = "/crm-hr/directory",
        ["crm"] = "/crm-hr/crm",
        ["workforce"] = "/crm-hr/workforce",
        ["recruiting"] = "/crm-hr/recruiting",
        ["agents"] = "/crm-hr/agents",
        ["assignments"] = "/crm-hr/assignments"
    };

    private static readonly IReadOnlyList<SecondaryTabItem> Tabs =
    [
        new("home", "Home", Description: "Module summary, routing hub, and at-a-glance counts."),
        new("directory", "Directory", Description: "Unified party directory for people, organizations, units, and AI agents."),
        new("crm", "CRM", Description: "Account and opportunity workspace shell."),
        new("workforce", "Workforce", Description: "People, units, and staffing supply overview."),
        new("recruiting", "Recruiting", Description: "Candidate and onboarding route shell."),
        new("agents", "Agents", Description: "AI agent directory and governance route shell."),
        new("assignments", "Assignments", Description: "Project-linked staffing and party assignment workspace.")
    ];

    [Parameter, EditorRequired]
    public string SelectedKey { get; set; } = string.Empty;

    private string ActiveDescription => Tabs
        .FirstOrDefault(item => string.Equals(item.Key, SelectedKey, StringComparison.Ordinal))
        ?.Description
        ?? "CRM / HR module navigation";

    private string ActiveLabel => Tabs
        .FirstOrDefault(item => string.Equals(item.Key, SelectedKey, StringComparison.Ordinal))
        ?.Label
        ?? "CRM / HR";

    private Task HandleSelectedKeyChanged(string key)
    {
        if (Routes.TryGetValue(key, out var route))
        {
            Navigation.NavigateTo(route);
        }

        return Task.CompletedTask;
    }
}

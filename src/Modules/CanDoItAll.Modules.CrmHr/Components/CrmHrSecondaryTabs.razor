@inject NavigationManager Navigation

<CrmHrAreaTabs SelectedArea="@SelectedArea" AreaSelected="Navigate" />

@code {
    // Host-owned chrome: the rendering library draws the area tabs, this adapter performs the navigation.
    [Parameter, EditorRequired]
    public CrmHrWorkspaceArea SelectedArea { get; set; }

    private void Navigate(CrmHrRouteDefinition definition)
        => Navigation.NavigateTo(definition.Route);
}

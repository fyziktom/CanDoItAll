@typeparam TItem

@if (Items.Count > 0)
{
    <Grid Gap="LayoutGap.Medium"
          ColumnTemplate="repeat(auto-fill,minmax(min(100%,20rem),30rem))"
          data-testid="@($"{TestIdPrefix}-grid")">
        @foreach (var item in VisibleItems)
        {
            <div @key="item" class="h-full">
                @ItemTemplate(item)
            </div>
        }
    </Grid>

    @if (PageCount > 1)
    {
        <Split Breakpoint="LayoutBreakpoint.None"
               Gap="LayoutGap.Small"
               AlignItems="AlignItems.Center"
               JustifyContent="JustifyContent.SpaceBetween"
               Wrap="FlexWrap.Wrap"
               Class="mt-3"
               data-testid="@($"{TestIdPrefix}-pager")">
            <SmallText Text="@($"Showing {FirstVisibleItem}-{LastVisibleItem} of {ResolvedTotalCount}")" />
            <Cluster Gap="LayoutGap.XSmall" Wrap="FlexWrap.NoWrap">
                <TooltipTarget Text="Previous page" Position="TooltipPosition.Bottom">
                    <Button ButtonStyle="ButtonStyle.Light"
                            Class="cda-button--quick"
                            Icon="chevron_left"
                            Disabled="@(CurrentPageIndex == 0)"
                            aria-label="Previous page"
                            data-testid="@($"{TestIdPrefix}-previous-page")"
                            Click="@(() => MovePageAsync(-1))" />
                </TooltipTarget>
                <StatusBadge Tone="neutral" Text="@($"{CurrentPageIndex + 1} / {PageCount}")" />
                <TooltipTarget Text="Next page" Position="TooltipPosition.Bottom">
                    <Button ButtonStyle="ButtonStyle.Light"
                            Class="cda-button--quick"
                            Icon="chevron_right"
                            Disabled="@(CurrentPageIndex >= PageCount - 1)"
                            aria-label="Next page"
                            data-testid="@($"{TestIdPrefix}-next-page")"
                            Click="@(() => MovePageAsync(1))" />
                </TooltipTarget>
            </Cluster>
        </Split>
    }
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<TItem> Items { get; set; } = [];

    [Parameter, EditorRequired]
    public RenderFragment<TItem> ItemTemplate { get; set; } = default!;

    [Parameter]
    public int PageSize { get; set; } = 6;

    [Parameter]
    public int? TotalCount { get; set; }

    [Parameter]
    public int PageIndex { get; set; }

    [Parameter]
    public EventCallback<int> PageChanged { get; set; }

    [Parameter]
    public string TestIdPrefix { get; set; } = "crmhr-paged-cards";

    private int localPageIndex;

    private int NormalizedPageSize => Math.Max(1, PageSize);

    private bool IsServerPaged => TotalCount.HasValue && PageChanged.HasDelegate;

    private int CurrentPageIndex => IsServerPaged ? PageIndex : localPageIndex;

    private int ResolvedTotalCount => TotalCount ?? Items.Count;

    private int PageCount => Math.Max(
        1,
        (int)Math.Ceiling(ResolvedTotalCount / (double)NormalizedPageSize));

    private int FirstVisibleItem => ResolvedTotalCount == 0
        ? 0
        : CurrentPageIndex * NormalizedPageSize + 1;

    private int LastVisibleItem => Math.Min(
        CurrentPageIndex * NormalizedPageSize + Items.Count,
        ResolvedTotalCount);

    private IReadOnlyList<TItem> VisibleItems => IsServerPaged
        ? Items
        : Items
            .Skip(localPageIndex * NormalizedPageSize)
            .Take(NormalizedPageSize)
            .ToList();

    protected override void OnParametersSet()
    {
        localPageIndex = Math.Clamp(localPageIndex, 0, PageCount - 1);
    }

    private async Task MovePageAsync(int delta)
    {
        var targetPageIndex = Math.Clamp(CurrentPageIndex + delta, 0, PageCount - 1);
        if (targetPageIndex == CurrentPageIndex)
        {
            return;
        }

        if (IsServerPaged)
        {
            await PageChanged.InvokeAsync(targetPageIndex);
            return;
        }

        localPageIndex = targetPageIndex;
    }
}

<Stack GapScale="LayoutGap.Medium">
    <Split Gap="LayoutGap.Medium"
           AlignItems="AlignItems.Center"
           JustifyContent="JustifyContent.SpaceBetween">
        <div>
            <p class="cda-eyebrow">Relationships and org structure</p>
            <p class="mt-1 text-sm leading-6 text-slate-600">Model parent-child, reporting, membership, and partner links without losing the shared party identity.</p>
        </div>
        <Button Text="Add relationship"
                ButtonStyle="ButtonStyle.Light"
                Size="ButtonSize.Small"
                Click="AddRelationship"
                Disabled="@(!CurrentPartyId.HasValue || AvailableParties.Count == 0)"
                data-testid="crmhr-relationship-add" />
    </Split>

    @if (!CurrentPartyId.HasValue)
    {
        <div class="rounded-[1.25rem] border border-dashed border-slate-300 bg-slate-50/70 px-4 py-4 text-sm leading-6 text-slate-600">
            Save the party first, then add relationships to other saved parties.
        </div>
    }
    else if (Relationships.Count == 0)
    {
        <div class="rounded-[1.25rem] border border-dashed border-slate-300 bg-slate-50/70 px-4 py-4 text-sm leading-6 text-slate-600">
            No relationships defined yet.
        </div>
    }
    else
    {
        @for (var index = 0; index < Relationships.Count; index++)
        {
            var item = Relationships[index];
            <PanelCard Soft="true">
                <Grid Gap="LayoutGap.Medium" ColumnsLg="4">
                    <div>
                        <label class="cda-field-label">Direction</label>
                        <select class="cda-input"
                                value="@(item.IsOutgoing ? "outgoing" : "incoming")"
                                @onchange="args => UpdateDirection(index, args.Value?.ToString())"
                                data-testid="@($"crmhr-relationship-direction-{index}")">
                            <option value="outgoing">This party points to related party</option>
                            <option value="incoming">Related party points to this party</option>
                        </select>
                    </div>
                    <div>
                        <label class="cda-field-label">Relationship</label>
                        <InputSelect @bind-Value="item.RelationshipKind"
                                     class="cda-input"
                                     data-testid="@($"crmhr-relationship-kind-{index}")">
                            @foreach (var relationshipKind in Enum.GetValues<PartyRelationshipKind>())
                            {
                                <option value="@relationshipKind">@relationshipKind</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="lg:col-span-2">
                        <label class="cda-field-label">Related party</label>
                        <InputSelect @bind-Value="item.RelatedPartyId"
                                     class="cda-input"
                                     data-testid="@($"crmhr-relationship-party-{index}")">
                            <option value="@Guid.Empty">Select party</option>
                            @foreach (var party in OrderedParties)
                            {
                                <option value="@party.Id">@party.DisplayName (@party.PartyType)</option>
                            }
                        </InputSelect>
                    </div>
                </Grid>

                <Grid Gap="LayoutGap.Medium" ColumnsLg="3" Class="mt-4">
                    <div>
                        <label class="cda-field-label">Start date</label>
                        <InputDate @bind-Value="item.StartDateUtc"
                                   class="cda-input"
                                   data-testid="@($"crmhr-relationship-start-{index}")" />
                    </div>
                    <div>
                        <label class="cda-field-label">End date</label>
                        <InputDate @bind-Value="item.EndDateUtc"
                                   class="cda-input"
                                   data-testid="@($"crmhr-relationship-end-{index}")" />
                    </div>
                    <label class="cda-inline-option">
                        <InputCheckbox @bind-Value="item.IsPrimary"
                                       data-testid="@($"crmhr-relationship-primary-{index}")" />
                        Primary relationship
                    </label>
                </Grid>

                <Grid Gap="LayoutGap.Medium" ColumnsLg="2" Class="mt-4">
                    <div>
                        <label class="cda-field-label">Notes</label>
                        <InputText @bind-Value="item.Notes"
                                   class="cda-input"
                                   data-testid="@($"crmhr-relationship-notes-{index}")" />
                    </div>
                    <div class="flex items-end justify-end">
                        <Button Text="Remove"
                                ButtonStyle="ButtonStyle.Danger"
                                Size="ButtonSize.Small"
                                Click="@(() => RemoveRelationship(index))"
                                data-testid="@($"crmhr-relationship-remove-{index}")" />
                    </div>
                </Grid>
            </PanelCard>
        }
    }
</Stack>

@code {
    [Parameter]
    public Guid? CurrentPartyId { get; set; }

    [Parameter, EditorRequired]
    public IList<PartyRelationshipEditorModel> Relationships { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<PartyDirectoryListItemModel> AvailableParties { get; set; } = [];

    private IReadOnlyList<PartyDirectoryListItemModel> OrderedParties => AvailableParties
        .OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private void AddRelationship()
    {
        Relationships.Add(new PartyRelationshipEditorModel());
    }

    private void RemoveRelationship(int index)
    {
        Relationships.RemoveAt(index);
    }

    private void UpdateDirection(int index, string? direction)
    {
        Relationships[index].IsOutgoing = !string.Equals(direction, "incoming", StringComparison.OrdinalIgnoreCase);
    }
}

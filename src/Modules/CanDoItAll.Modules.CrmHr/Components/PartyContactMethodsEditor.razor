<Stack GapScale="LayoutGap.Medium">
    <Split Gap="LayoutGap.Medium"
           AlignItems="AlignItems.Center"
           JustifyContent="JustifyContent.SpaceBetween">
        <div>
            <p class="cda-eyebrow">Additional contact methods</p>
            <p class="mt-1 text-sm leading-6 text-slate-600">Keep secondary email, phone, website, messaging, or social handles attached to the same party record.</p>
        </div>
        <Button Text="Add contact"
                ButtonStyle="ButtonStyle.Light"
                Size="ButtonSize.Small"
                Click="AddContactPoint"
                data-testid="crmhr-contact-add" />
    </Split>

    @if (ContactPoints.Count == 0)
    {
        <div class="rounded-[1.25rem] border border-dashed border-slate-300 bg-slate-50/70 px-4 py-4 text-sm leading-6 text-slate-600">
            No extra contact methods yet.
        </div>
    }
    else
    {
        @for (var index = 0; index < ContactPoints.Count; index++)
        {
            var item = ContactPoints[index];
            <PanelCard Soft="true">
                <Grid Gap="LayoutGap.Medium" ColumnsLg="5">
                    <div>
                        <label class="cda-field-label">Type</label>
                        <InputSelect @bind-Value="item.ContactType"
                                     class="cda-input"
                                     data-testid="@($"crmhr-contact-type-{index}")">
                            @foreach (var contactType in Enum.GetValues<PartyContactType>())
                            {
                                <option value="@contactType">@contactType</option>
                            }
                        </InputSelect>
                    </div>
                    <div>
                        <label class="cda-field-label">Label</label>
                        <InputText @bind-Value="item.Label"
                                   class="cda-input"
                                   data-testid="@($"crmhr-contact-label-{index}")" />
                    </div>
                    <div class="lg:col-span-2">
                        <label class="cda-field-label">Value</label>
                        <InputText @bind-Value="item.Value"
                                   class="cda-input"
                                   data-testid="@($"crmhr-contact-value-{index}")" />
                    </div>
                    <div class="flex items-end">
                        <Button Text="Remove"
                                ButtonStyle="ButtonStyle.Danger"
                                Size="ButtonSize.Small"
                                Click="@(() => RemoveContactPoint(index))"
                                data-testid="@($"crmhr-contact-remove-{index}")" />
                    </div>
                </Grid>

                <Grid Gap="LayoutGap.Medium" ColumnsLg="2" Class="mt-4">
                    <label class="cda-inline-option">
                        <InputCheckbox @bind-Value="item.IsPublic"
                                       data-testid="@($"crmhr-contact-public-{index}")" />
                        Publicly shareable
                    </label>
                    <div>
                        <label class="cda-field-label">Notes</label>
                        <InputText @bind-Value="item.Notes"
                                   class="cda-input"
                                   data-testid="@($"crmhr-contact-notes-{index}")" />
                    </div>
                </Grid>
            </PanelCard>
        }
    }
</Stack>

@code {
    [Parameter, EditorRequired]
    public IList<PartyContactPointEditorModel> ContactPoints { get; set; } = default!;

    private void AddContactPoint()
    {
        ContactPoints.Add(new PartyContactPointEditorModel
        {
            ContactType = PartyContactType.Email,
            Label = "Additional contact",
            IsPublic = true
        });
    }

    private void RemoveContactPoint(int index)
    {
        ContactPoints.RemoveAt(index);
    }
}

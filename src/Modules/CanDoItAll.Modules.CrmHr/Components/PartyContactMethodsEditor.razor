<Stack GapScale="LayoutGap.Medium">
    <Split Gap="LayoutGap.Medium"
           AlignItems="AlignItems.Center"
           JustifyContent="JustifyContent.SpaceBetween">
        <div>
            <TextBlock TextStyle="TextStyle.EyebrowCaption" Value="Additional contact methods" />
            <p class="mt-1 text-sm leading-6 text-chrome-600">Keep secondary email, phone, website, messaging, or social handles attached to the same party record.</p>
        </div>
        <Button Text="Add contact"
                Tone="ButtonTone.Default"
                Size="ButtonSize.Small"
                Click="OpenContactWizard"
                data-testid="crmhr-contact-add" />
    </Split>

    @if (ContactPoints.Count == 0) {
        <div class="rounded-[1.25rem] border border-dashed border-chrome-300 bg-chrome-50/70 px-4 py-4 text-sm leading-6 text-chrome-600">
            No extra contact methods yet.
        </div>
    } else {
        @foreach (var row in ContactPoints.Select((item, index) => (Item: item, Index: index))) {
            var item = row.Item;
            var rowIndex = row.Index;
            <PanelCard @key="item" Soft="true">
                <Grid Gap="LayoutGap.Medium" ColumnsLg="5">
                    <div>
                        <FormField Text="Type">
                        <SelectInput @bind-Value="item.ContactType"
                                     data-testid="@($"crmhr-contact-type-{rowIndex}")">
                            @foreach (var contactType in Enum.GetValues<PartyContactType>()) {
                                <option value="@contactType">@contactType</option>
                            }
                        </SelectInput>
                        </FormField>
                    </div>
                    <div>
                        <FormField Text="Label">
                        <TextInput @bind-Value="item.Label"
                                   data-testid="@($"crmhr-contact-label-{rowIndex}")" />
                        </FormField>
                    </div>
                    <div class="lg:col-span-2">
                        <FormField Text="Value">
                        <TextInput @bind-Value="item.Value"
                                   data-testid="@($"crmhr-contact-value-{rowIndex}")" />
                        </FormField>
                    </div>
                    <div class="flex items-end">
                        <Button Text="Remove"
                                Tone="ButtonTone.Danger"
                                Size="ButtonSize.Small"
                                Click="@(() => RemoveContactPoint(item))"
                                data-testid="@($"crmhr-contact-remove-{rowIndex}")" />
                    </div>
                </Grid>

                <Grid Gap="LayoutGap.Medium" ColumnsLg="2" Class="mt-4">
                    <CheckboxOption @bind-Value="item.IsPublic"
                                       data-testid="@($"crmhr-contact-public-{rowIndex}")"  Text="Publicly shareable" />
                    <div>
                        <FormField Text="Notes">
                        <TextInput @bind-Value="item.Notes"
                                   data-testid="@($"crmhr-contact-notes-{rowIndex}")" />
                        </FormField>
                    </div>
                </Grid>
            </PanelCard>
        }
    }
</Stack>

@if (contactDraft is not null) {
    <Dialog IsOpen="true"
            Eyebrow="Additional contact"
            Title="Add contact method"
            Subtitle="Choose the channel, then enter the contact details."
            Size="ModalSize.Medium"
            DenseChrome="true"
            CloseOnBackdrop="false"
            TestId="crmhr-contact-wizard"
            OnClose="CancelContactWizard">
        <ChildContent>
            <Steps Value="@((int)contactWizardStep)"
                   ValueChanged="SetContactWizardStep"
                   CanSelect="false"
                   data-testid="crmhr-contact-wizard-steps">
                <StepsItem Text="Type" Icon="category">
                    <Stack GapScale="LayoutGap.Medium">
                        <p class="text-sm leading-6 text-chrome-600">
                            Select the contact channel to add.
                        </p>
                        <Grid Gap="LayoutGap.Medium" ColumnsMd="3">
                            @foreach (var contactType in Enum.GetValues<PartyContactType>()) {
                                <CardButton Class="@ResolveContactTypeCardClass(contactType)"
                                            Ghost="true"
                                            Click="@(() => SelectContactType(contactType))"
                                            aria-label="@($"Choose {ResolveContactTypeLabel(contactType)} contact type")"
                                            aria-pressed="@(contactDraft.ContactType == contactType ? "true" : "false")"
                                            data-testid="@($"crmhr-contact-wizard-type-{contactType.ToString().ToLowerInvariant()}")">
                                    <Icon Name="@ResolveContactTypeIcon(contactType)"
                                          Class="text-3xl" />
                                    <span class="text-sm font-semibold">
                                        @ResolveContactTypeLabel(contactType)
                                    </span>
                                </CardButton>
                            }
                        </Grid>
                    </Stack>
                </StepsItem>

                <StepsItem Text="Details" Icon="edit">
                    <Stack GapScale="LayoutGap.Medium">
                        <Grid Gap="LayoutGap.Medium" ColumnsMd="2">
                            <FormField Text="Value">
                                <TextInput @bind-Value="contactDraft.Value"
                                           aria-invalid="@(!string.IsNullOrEmpty(contactValidationError) ? "true" : "false")"
                                           data-testid="crmhr-contact-wizard-value" />
                                @if (!string.IsNullOrEmpty(contactValidationError)) {
                                    <p class="mt-1 text-sm text-rose-700"
                                       role="alert"
                                       data-testid="crmhr-contact-wizard-validation">
                                        @contactValidationError
                                    </p>
                                }
                            </FormField>

                            <FormField Text="Label">
                                <TextInput @bind-Value="contactDraft.Label"
                                           data-testid="crmhr-contact-wizard-label" />
                            </FormField>
                        </Grid>

                        <FormField Text="Tags">
                            <TagEditor Value="@contactDraft.Tags"
                                       ValueChanged="UpdateContactTags"
                                       Placeholder="Add contact tags"
                                       Hint="Press comma or Enter to add a tag."
                                       MaxTags="20"
                                       TestId="crmhr-contact-wizard-tags"
                                       InputTestId="crmhr-contact-wizard-tags-input" />
                        </FormField>

                        <CheckboxOption @bind-Value="contactDraft.IsPublic"
                                           data-testid="crmhr-contact-wizard-public"  Text="Publicly shareable" />

                        <FormField Text="Notes">
                            <TextAreaInput Value="@contactDraft.Notes"
                                      ValueChanged="UpdateContactNotes"
                                      Size="TextAreaSize.Standard"
                                      Placeholder="Optional context for this contact method"
                                      data-testid="crmhr-contact-wizard-notes" />
                        </FormField>
                    </Stack>
                </StepsItem>
            </Steps>
        </ChildContent>
        <Footer>
            <Split Breakpoint="LayoutBreakpoint.None"
                   Gap="LayoutGap.Medium"
                   AlignItems="AlignItems.Center"
                   JustifyContent="JustifyContent.SpaceBetween"
                   Wrap="FlexWrap.Wrap">
                <Cluster Gap="LayoutGap.Small">
                    <Button Text="Cancel"
                            Tone="ButtonTone.Default"
                            Click="CancelContactWizard"
                            data-testid="crmhr-contact-wizard-cancel" />
                    @if (contactWizardStep == ContactWizardStep.Details) {
                        <Button Text="Back"
                                Icon="arrow_back"
                                Tone="ButtonTone.Default"
                                Click="MoveToContactTypeStep"
                                data-testid="crmhr-contact-wizard-back" />
                    }
                </Cluster>

                @if (contactWizardStep == ContactWizardStep.Type) {
                    <Button Text="Next"
                            Icon="arrow_forward"
                            Disabled="@(!contactDraft.ContactType.HasValue)"
                            Click="MoveToContactDetailsStep"
                            data-testid="crmhr-contact-wizard-next" />
                } else {
                    <Button Text="Finish"
                            Icon="check"
                            Click="FinishContactWizard"
                            data-testid="crmhr-contact-wizard-finish" />
                }
            </Split>
        </Footer>
    </Dialog>
}

@code {
    private ContactMethodDraft? contactDraft;
    private ContactWizardStep contactWizardStep;
    private string contactValidationError = string.Empty;

    [Parameter, EditorRequired]
    public IList<PartyContactPointEditorModel> ContactPoints { get; set; } = default!;

    private void OpenContactWizard() {
        contactDraft = new ContactMethodDraft();
        contactWizardStep = ContactWizardStep.Type;
        contactValidationError = string.Empty;
    }

    private void SelectContactType(PartyContactType contactType) {
        if (contactDraft is null) {
            return;
        }

        contactDraft.ContactType = contactType;
        if (string.IsNullOrWhiteSpace(contactDraft.Label)) {
            contactDraft.Label = ResolveContactTypeLabel(contactType);
        }
    }

    private void MoveToContactDetailsStep() {
        if (contactDraft?.ContactType is null) {
            return;
        }

        contactWizardStep = ContactWizardStep.Details;
        contactValidationError = string.Empty;
    }

    private void MoveToContactTypeStep() {
        contactWizardStep = ContactWizardStep.Type;
        contactValidationError = string.Empty;
    }

    private void SetContactWizardStep(int step) {
        contactWizardStep = step == (int)ContactWizardStep.Details
            ? ContactWizardStep.Details
            : ContactWizardStep.Type;
    }

    private void UpdateContactTags(IReadOnlyList<string> tags) {
        if (contactDraft is not null) {
            contactDraft.Tags = tags;
        }
    }

    private void UpdateContactNotes(string notes) {
        if (contactDraft is not null) {
            contactDraft.Notes = notes;
        }
    }

    private void FinishContactWizard() {
        if (contactDraft is null || contactWizardStep != ContactWizardStep.Details) {
            return;
        }

        if (!contactDraft.TryBuild(out var contactPoint, out contactValidationError)) {
            return;
        }

        ContactPoints.Add(contactPoint);
        CloseContactWizard();
    }

    private void CancelContactWizard() {
        CloseContactWizard();
    }

    private void CloseContactWizard() {
        contactDraft = null;
        contactWizardStep = ContactWizardStep.Type;
        contactValidationError = string.Empty;
    }

    private void RemoveContactPoint(PartyContactPointEditorModel contactPoint) {
        ContactPoints.Remove(contactPoint);
    }

    private string ResolveContactTypeCardClass(PartyContactType contactType) {
        var selectionClasses = contactDraft?.ContactType == contactType
            ? "border-sky-500 bg-sky-50 text-sky-950 ring-2 ring-sky-200"
            : "border-chrome-200 bg-white text-chrome-800 hover:border-sky-300 hover:bg-sky-50/60";

        return $"aspect-square w-full flex flex-col items-center justify-center gap-3 text-center {selectionClasses}";
    }

    private static string ResolveContactTypeLabel(PartyContactType contactType) {
        return contactType switch {
            PartyContactType.Email => "Email",
            PartyContactType.Phone => "Phone",
            PartyContactType.Website => "Website",
            PartyContactType.Messaging => "Messaging",
            PartyContactType.Social => "Social",
            PartyContactType.Other => "Other",
            _ => throw new ArgumentOutOfRangeException(nameof(contactType), contactType, null)
        };
    }

    private static string ResolveContactTypeIcon(PartyContactType contactType) {
        return contactType switch {
            PartyContactType.Email => "mail",
            PartyContactType.Phone => "phone",
            PartyContactType.Website => "language",
            PartyContactType.Messaging => "chat",
            PartyContactType.Social => "share",
            PartyContactType.Other => "contact_page",
            _ => throw new ArgumentOutOfRangeException(nameof(contactType), contactType, null)
        };
    }

    private enum ContactWizardStep {
        Type,
        Details
    }

    private sealed class ContactMethodDraft {
        public PartyContactType? ContactType { get; set; }

        public string Label { get; set; } = string.Empty;

        public string Value { get; set; } = string.Empty;

        public bool IsPublic { get; set; } = true;

        public IReadOnlyList<string> Tags { get; set; } = [];

        public string Notes { get; set; } = string.Empty;

        public bool TryBuild(
            out PartyContactPointEditorModel contactPoint,
            out string validationError) {
            if (!ContactType.HasValue) {
                contactPoint = default!;
                validationError = "Choose a contact type.";
                return false;
            }

            if (string.IsNullOrWhiteSpace(Value)) {
                contactPoint = default!;
                validationError = "Enter a contact value.";
                return false;
            }

            var contactType = ContactType.Value;
            contactPoint = new PartyContactPointEditorModel {
                ContactType = contactType,
                Label = string.IsNullOrWhiteSpace(Label)
                    ? ResolveContactTypeLabel(contactType)
                    : Label.Trim(),
                Value = Value.Trim(),
                IsPrimary = false,
                IsPublic = IsPublic,
                Tags = Tags
                    .Where(tag => !string.IsNullOrWhiteSpace(tag))
                    .Select(tag => tag.Trim())
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList(),
                Notes = Notes.Trim()
            };
            validationError = string.Empty;
            return true;
        }
    }
}

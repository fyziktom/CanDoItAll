<div class="w-full" data-testid="@DataTestId">
    <SurfaceCard Soft="true">
        <Split Gap="LayoutGap.Medium"
               AlignItems="AlignItems.Start"
               JustifyContent="JustifyContent.SpaceBetween"
               Wrap="FlexWrap.Wrap">
            <div class="min-w-0">
                <TextBlock TextStyle="TextStyle.EyebrowCaption" Value="@Eyebrow" />
                <h3 class="mt-1 text-lg font-semibold text-slate-950">Sensitive handling and accountability</h3>
                <p class="mt-3 text-sm leading-6 text-slate-600">
                    @(IsSensitive ? SensitiveDescription : StandardDescription)
                </p>
            </div>
            <Cluster Gap="LayoutGap.Small">
                <StatusBadge Tone="@(IsSensitive ? "warning" : "neutral")"
                             Text="@(IsSensitive ? "Sensitive handling" : "Standard handling")" />
                @if (IsSensitive)
                {
                    <StatusBadge Tone="warning" Text="Hidden from global search" />
                }
                @if (UpdatedAtUtc.HasValue)
                {
                    <StatusBadge Tone="neutral" Text="@UpdatedAtUtc.Value.LocalDateTime.ToString("g")" />
                }
            </Cluster>
        </Split>

        <Grid Gap="LayoutGap.Medium" ColumnsMd="2" Class="mt-5">
            <div class="rounded-[1.2rem] border border-slate-200 bg-white/90 px-4 py-4">
                <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Last changed by</p>
                <p class="mt-1 text-sm font-medium text-slate-950">@FormatActor(LastChangedBy)</p>
            </div>
            <div class="rounded-[1.2rem] border border-slate-200 bg-white/90 px-4 py-4">
                <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Handling rule</p>
                <p class="mt-1 text-sm font-medium text-slate-950">
                    @(IsSensitive ? "Keep HR-only notes separate and avoid broad search exposure." : "Operational notes remain broadly visible across CRM-HR flows.")
                </p>
            </div>
        </Grid>
    </SurfaceCard>
</div>

@code {
    [Parameter]
    public bool IsSensitive { get; set; }

    [Parameter]
    public string LastChangedBy { get; set; } = string.Empty;

    [Parameter]
    public DateTimeOffset? UpdatedAtUtc { get; set; }

    [Parameter]
    public string Eyebrow { get; set; } = "Privacy and stewardship";

    [Parameter]
    public string StandardDescription { get; set; } = "Use this summary before editing or handing off the record so ownership and broad visibility stay explicit.";

    [Parameter]
    public string SensitiveDescription { get; set; } = "Sensitive records stay out of global search and should keep HR-only notes separate from operational context.";

    [Parameter]
    public string DataTestId { get; set; } = "crmhr-sensitive-callout";

    private static string FormatActor(string actor)
    {
        return string.IsNullOrWhiteSpace(actor) ? "Unknown" : actor;
    }
}

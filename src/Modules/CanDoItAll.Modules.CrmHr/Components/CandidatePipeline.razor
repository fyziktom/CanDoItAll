<FormSection Title="Candidate pipeline"
             Icon="person_search"
             Description="Keep candidate identity in the shared registry, move stage explicitly, and preserve stage evidence without splitting recruiting into a disconnected tool.">
    <Grid Gap="LayoutGap.Large"
          ColumnTemplateXl="minmax(0,1.65fr) minmax(18rem,0.75fr)">
        <SurfaceCard>
            <p class="cda-eyebrow">Application editor</p>
            <h3 class="mt-1 text-lg font-semibold text-slate-950">Candidate and stage</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
                Select an existing person or bound AI agent, or create a new human candidate inline, then keep role, ownership, stage, and decision on the same record.
            </p>

            <Tabs Density="TabsDensity.Compact"
                  BorderMode="TabsBorderMode.Soft"
                  Tone="TabsTone.Success"
                  OverflowMode="TabsOverflowMode.Wrap"
                  AriaLabel="Candidate pipeline editor sections"
                  Class="mt-4"
                  data-testid="crmhr-recruiting-application-tabs">
                <TabItems>
                    <TabsItem Text="Candidate"
                              Icon="person"
                              data-testid="crmhr-recruiting-application-tab-candidate">
                        <Stack GapScale="LayoutGap.Medium"
                               AlignItems="AlignItems.Stretch">
                            <Grid Gap="LayoutGap.Medium"
                                  ColumnsMd="2">
                                <PartyPicker Label="Candidate"
                                             TestIdPrefix="crmhr-recruiting-candidate-party"
                                             AllowedScope="@(PartyRecordScope.People | PartyRecordScope.AiAgents)"
                                             InitialScope="@(PartyRecordScope.People | PartyRecordScope.AiAgents)"
                                             SelectedPartyId="@Draft.PartyId"
                                             SelectedPartyIdChanged="SetCandidatePartyAsync" />
                                <FormField Text="Desired role">
                                    <InputText @bind-Value="Draft.DesiredRole"
                                               class="ui-input"
                                               data-testid="crmhr-recruiting-role" />
                                </FormField>
                            </Grid>

                            <Grid Gap="LayoutGap.Medium"
                                  ColumnsMd="2"
                                  ColumnsLg="3">
                                <FormField Text="New candidate name">
                                    <InputText @bind-Value="Draft.CandidateName"
                                               class="ui-input"
                                               data-testid="crmhr-recruiting-candidate-name" />
                                </FormField>
                                <FormField Text="Email">
                                    <InputText @bind-Value="Draft.CandidateEmail"
                                               class="ui-input"
                                               data-testid="crmhr-recruiting-candidate-email" />
                                </FormField>
                                <FormField Text="Phone">
                                    <InputText @bind-Value="Draft.CandidatePhone"
                                               class="ui-input"
                                               data-testid="crmhr-recruiting-candidate-phone" />
                                </FormField>
                            </Grid>

                            <FormField Text="Candidate summary">
                                <TextArea @bind-Value="Draft.CandidateSummary"

                                               data-testid="crmhr-recruiting-candidate-summary" />
                            </FormField>
                        </Stack>
                    </TabsItem>

                    <TabsItem Text="Stage"
                              Icon="phase"
                              data-testid="crmhr-recruiting-application-tab-stage">
                        <Stack GapScale="LayoutGap.Medium"
                               AlignItems="AlignItems.Stretch">
                            <Grid Gap="LayoutGap.Medium" ColumnsMd="2">
                                <FormField Text="Stage">
                                    <InputSelect @bind-Value="Draft.Stage"
                                                 class="ui-input"
                                                 data-testid="crmhr-recruiting-stage">
                                        @foreach (var stage in Enum.GetValues<RecruitmentStage>())
                                        {
                                            <option value="@stage">@stage</option>
                                        }
                                    </InputSelect>
                                </FormField>
                                <FormField Text="Decision">
                                    <InputSelect @bind-Value="Draft.Decision"
                                                 class="ui-input"
                                                 data-testid="crmhr-recruiting-decision">
                                        @foreach (var decision in Enum.GetValues<RecruitmentDecision>())
                                        {
                                            <option value="@decision">@decision</option>
                                        }
                                    </InputSelect>
                                </FormField>
                                <FormField Text="Available from">
                                    <InputDate @bind-Value="Draft.AvailableFrom"
                                               class="ui-input"
                                               data-testid="crmhr-recruiting-available-from" />
                                </FormField>
                                <FormField Text="Source">
                                    <InputText @bind-Value="Draft.Source"
                                               class="ui-input"
                                               data-testid="crmhr-recruiting-source" />
                                </FormField>
                            </Grid>
                        </Stack>
                    </TabsItem>

                    <TabsItem Text="Ownership"
                              Icon="manage_accounts"
                              data-testid="crmhr-recruiting-application-tab-ownership">
                        <Stack GapScale="LayoutGap.Medium"
                               AlignItems="AlignItems.Stretch">
                            <Grid Gap="LayoutGap.Medium"
                                  ColumnsMd="2"
                                  ColumnsLg="3">
                                <PartyPicker Label="Recruiter"
                                             TestIdPrefix="crmhr-recruiting-recruiter"
                                             AllowedScope="PartyRecordScope.People"
                                             InitialScope="PartyRecordScope.People"
                                             SelectedPartyId="@Draft.RecruiterPartyId"
                                             SelectedPartyIdChanged="SetRecruiterPartyAsync" />
                                <PartyPicker Label="Hiring manager"
                                             TestIdPrefix="crmhr-recruiting-hiring-manager"
                                             AllowedScope="PartyRecordScope.People"
                                             InitialScope="PartyRecordScope.People"
                                             SelectedPartyId="@Draft.HiringManagerPartyId"
                                             SelectedPartyIdChanged="SetHiringManagerPartyAsync" />
                                <PartyPicker Label="Target unit"
                                             TestIdPrefix="crmhr-recruiting-target-unit"
                                             AllowedScope="@(PartyRecordScope.Organizations | PartyRecordScope.OrganizationUnits)"
                                             InitialScope="@(PartyRecordScope.Organizations | PartyRecordScope.OrganizationUnits)"
                                             SelectedPartyId="@Draft.TargetUnitPartyId"
                                             SelectedPartyIdChanged="SetTargetUnitPartyAsync" />
                            </Grid>
                        </Stack>
                    </TabsItem>

                    <TabsItem Text="Notes"
                              Icon="note"
                              data-testid="crmhr-recruiting-application-tab-notes">
                        <Stack GapScale="LayoutGap.Medium"
                               AlignItems="AlignItems.Stretch">
                            <FormField Text="Stage note">
                                <TextArea @bind-Value="Draft.StageNotes"

                                               data-testid="crmhr-recruiting-stage-notes" />
                            </FormField>

                            <FormField Text="Notes">
                                <TextArea @bind-Value="Draft.Notes"

                                               data-testid="crmhr-recruiting-notes" />
                            </FormField>
                        </Stack>
                    </TabsItem>
                </TabItems>
            </Tabs>

            <Cluster Gap="LayoutGap.Small"
                     Wrap="FlexWrap.Wrap"
                     Class="mt-4">
                <Button Text="Save application"
                        Icon="save"
                        Click="SaveApplication"
                        data-testid="crmhr-recruiting-save-button" />
                <Button Text="Reset"
                        Icon="restart_alt"
                        Tone="ButtonTone.Default"
                        Click="ResetApplication"
                        data-testid="crmhr-recruiting-reset-button" />
            </Cluster>
        </SurfaceCard>

        <SurfaceCard Soft="true">
            <Split Gap="LayoutGap.Medium"
                   AlignItems="AlignItems.Center"
                   JustifyContent="JustifyContent.SpaceBetween"
                   Wrap="FlexWrap.Wrap">
                <div>
                    <p class="cda-eyebrow">Stage history</p>
                    <h3 class="mt-1 text-lg font-semibold text-slate-950">@StageHistory.Count update(s)</h3>
                </div>
                @if (HasWorkforceProfile)
                {
                    <StatusBadge Tone="success"
                                 Text="Workforce profile exists" />
                }
            </Split>

            @if (StageHistory.Count == 0)
            {
                <div class="mt-4">
                    <EmptyState Eyebrow="No stage updates"
                                Title="Save the application first"
                                Description="Recruitment creation and every stage transition appear here after the application has been saved." />
                </div>
            }
            else
            {
                <Stack GapScale="LayoutGap.Medium" Class="mt-4">
                    @foreach (var item in StageHistory)
                    {
                        <PanelCard data-testid="crmhr-recruiting-stage-history-item">
                            <Split Gap="LayoutGap.Medium"
                                   AlignItems="AlignItems.Start"
                                   JustifyContent="JustifyContent.SpaceBetween"
                                   Wrap="FlexWrap.Wrap">
                                <div class="min-w-0 space-y-1">
                                    <p class="text-base font-semibold text-slate-950">@item.Summary</p>
                                    <p class="text-sm text-slate-600">@item.ChangedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm") / @item.ChangedBy</p>
                                    @if (!string.IsNullOrWhiteSpace(item.Notes))
                                    {
                                        <p class="text-sm leading-6 text-slate-600">@item.Notes</p>
                                    }
                                </div>
                                <StatusBadge Tone="@ResolveStageTone(item.Stage)"
                                             Text="@item.Stage.ToString()" />
                            </Split>
                        </PanelCard>
                    }
                </Stack>
            }
        </SurfaceCard>
    </Grid>
</FormSection>

@code {
    [Parameter]
    public RecruitmentApplicationEditorModel Draft { get; set; } = new();

    [Parameter]
    public IReadOnlyList<RecruitmentStageHistoryItemModel> StageHistory { get; set; } = [];

    [Parameter]
    public bool HasWorkforceProfile { get; set; }

    [Parameter]
    public EventCallback SaveApplication { get; set; }

    [Parameter]
    public EventCallback ResetApplication { get; set; }

    private Task SetCandidatePartyAsync(Guid? partyId)
    {
        Draft.PartyId = partyId;
        return Task.CompletedTask;
    }

    private Task SetRecruiterPartyAsync(Guid? partyId)
    {
        Draft.RecruiterPartyId = partyId;
        return Task.CompletedTask;
    }

    private Task SetHiringManagerPartyAsync(Guid? partyId)
    {
        Draft.HiringManagerPartyId = partyId;
        return Task.CompletedTask;
    }

    private Task SetTargetUnitPartyAsync(Guid? partyId)
    {
        Draft.TargetUnitPartyId = partyId;
        return Task.CompletedTask;
    }

    private static string ResolveStageTone(RecruitmentStage stage)
    {
        return stage switch
        {
            RecruitmentStage.Hired => "success",
            RecruitmentStage.Offer => "primary",
            RecruitmentStage.Interviewing => "info",
            RecruitmentStage.Rejected => "danger",
            RecruitmentStage.Withdrawn => "warning",
            _ => "base"
        };
    }
}

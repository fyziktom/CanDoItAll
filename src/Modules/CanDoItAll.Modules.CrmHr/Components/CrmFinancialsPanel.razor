@implements IDisposable
@inject ICrmFinancialSnapshotQueryService Financials
@inject ILogger<CrmFinancialsPanel> Logger

@* Thin host of the CRM Financials projection under its existing name and AccountPartyId entry: it owns the read
   session (account, accepted snapshot, retry, period) and forwards the surface's intents; the rendering, including
   the real chart, lives in CanDoItAll.CrmHr.UI. *@
<CrmHrFinancialsSurface Presentation="@session.Presentation" Intent="HandleIntentAsync" />

@code {
    private CrmFinancialsReadSession session = default!;
    private bool disposed;

    [Parameter]
    public Guid AccountPartyId { get; set; }

    // Exposed for host tests that inspect the accepted presentation without reflection.
    public CrmHrFinancialsPresentation Presentation => session.Presentation;

    protected override void OnInitialized()
    {
        session = new CrmFinancialsReadSession(Financials, Logger)
        {
            Changed = RenderAsync
        };
    }

    protected override Task OnParametersSetAsync()
        => session.LoadAsync(AccountPartyId);

    private Task HandleIntentAsync(CrmHrFinancialsIntent intent)
    {
        switch (intent)
        {
            case CrmHrFinancialsIntent.Retry retry:
                return session.RetryAsync(retry.Generation);
            case CrmHrFinancialsIntent.SetPeriod setPeriod:
                session.SetPeriod(setPeriod.Period);
                return Task.CompletedTask;
            default:
                throw new NotSupportedException($"The Financials host does not own the {intent.GetType().Name} intent.");
        }
    }

    private async Task RenderAsync()
    {
        if (disposed)
        {
            return;
        }

        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception) when (disposed)
        {
            // The host went away while the render was queued; there is nothing left to show.
        }
    }

    public void Dispose()
    {
        if (disposed)
        {
            return;
        }

        disposed = true;
        session.Dispose();
    }
}

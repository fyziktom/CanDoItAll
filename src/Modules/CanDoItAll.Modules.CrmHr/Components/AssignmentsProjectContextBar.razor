@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Modules.Projects

<SurfaceCard Soft="true"
             data-testid="crmhr-assignments-project-context">
    <Split Breakpoint="LayoutBreakpoint.None"
           Gap="LayoutGap.Medium"
           AlignItems="AlignItems.Center"
           JustifyContent="JustifyContent.SpaceBetween"
           Wrap="FlexWrap.Wrap">
        <div class="min-w-[20rem] flex-[1_1_34rem]">
            <FormField Text="Project">
                <SurfaceCard Soft="true">
                    <Split Breakpoint="LayoutBreakpoint.None"
                           Gap="LayoutGap.Medium"
                           AlignItems="AlignItems.Center"
                           JustifyContent="JustifyContent.SpaceBetween"
                           Wrap="FlexWrap.Wrap">
                        <Stack GapScale="LayoutGap.Tiny"
                               Class="min-w-0">
                            <TextBlock TextStyle="TextStyle.Subtitle2"
                                       Value="@SelectedProjectLabel" />
                            <SmallText Text="@SelectedProjectDescription" />
                        </Stack>
                        <Cluster Gap="LayoutGap.XSmall"
                                 Wrap="FlexWrap.NoWrap">
                            @if (SelectedProjectId.HasValue)
                            {
                                <Button Text="Clear"
                                        Tone="ButtonTone.Default"
                                        Size="ButtonSize.Small"
                                        Click="ClearProjectAsync"
                                        data-testid="crmhr-assignment-project-clear" />
                            }
                            <Button Text="@(SelectedProjectId.HasValue ? "Change project" : "Choose project")"
                                    Icon="search"
                                    Tone="ButtonTone.Default"
                                    Size="ButtonSize.Small"
                                    Click="OpenProjectPicker"
                                    data-testid="crmhr-assignment-project" />
                        </Cluster>
                    </Split>
                </SurfaceCard>
            </FormField>
        </div>

        @if (SelectedProject is { } project)
        {
            <Stack GapScale="LayoutGap.Tiny"
                   Class="min-w-[20rem] flex-[1_1_32rem]">
                <TextBlock TextStyle="TextStyle.EyebrowCaption" Value="Active project" />
                <p class="truncate text-base font-semibold text-chrome-950">@project.Name</p>
                <Cluster Gap="LayoutGap.XSmall" Wrap="FlexWrap.Wrap">
                    <StatusBadge Tone="info" Text="@project.Status.ToString()" />
                    @if (!string.IsNullOrWhiteSpace(project.CurrentPhase))
                    {
                        <StatusBadge Tone="base" Text="@project.CurrentPhase" />
                    }
                    <StatusBadge Tone="base" Text="@($"{AssignmentCount} relationships")" />
                    <StatusBadge Tone="base" Text="@($"{AllocationCount} allocations")" />
                    <StatusBadge Tone="base" Text="@StaffingRequestLabel" />
                </Cluster>
            </Stack>
        }
        else
        {
            <SmallText Text="Choose a project to load its resource schedule and assignment workflows."
                       Class="min-w-[20rem] flex-[1_1_32rem]" />
        }

        @if (SelectedProjectId.HasValue)
        {
            <Cluster Gap="LayoutGap.XSmall" Wrap="FlexWrap.NoWrap">
                <TooltipTarget Text="Switch to the selected project's structure workspace"
                               Position="TooltipPosition.Bottom"
                               TestId="crmhr-assignment-open-structure-tooltip">
                    <Button Tone="ButtonTone.Default"
                            Size="ButtonSize.Small"
                            Class="ui-button--quick"
                            Icon="account_tree"
                            aria-label="Open project structure"
                            data-testid="crmhr-assignment-open-structure"
                            Click="@(() => OpenStructure.InvokeAsync(SelectedProjectId.Value))" />
                </TooltipTarget>
                <TooltipTarget Text="Switch to the selected project's interactive Gantt workspace"
                               Position="TooltipPosition.Bottom"
                               TestId="crmhr-assignment-open-gantt-tooltip">
                    <Button Tone="ButtonTone.Default"
                            Size="ButtonSize.Small"
                            Class="ui-button--quick"
                            Icon="timeline"
                            aria-label="Open project Gantt"
                            data-testid="crmhr-assignment-open-gantt"
                            Click="@(() => OpenGantt.InvokeAsync(SelectedProjectId.Value))" />
                </TooltipTarget>
            </Cluster>
        }
    </Split>
</SurfaceCard>

<ProjectRecordPickerDialog IsOpen="isProjectPickerOpen"
                           SelectedProjectId="SelectedProjectId"
                           InitialScope="ProjectRecordScope.All"
                           SelectionConfirmed="HandleProjectSelectedAsync"
                           OnClose="CloseProjectPickerAsync"
                           LoadFailed="ProjectLoadFailed"
                           Title="Choose an assignments project"
                           Subtitle="Search and page through Projects-owned records."
                           DataTestId="crmhr-assignment-project-picker" />

@code {
    private bool isProjectPickerOpen;

    [Parameter]
    public Guid? SelectedProjectId { get; set; }

    [Parameter]
    public ProjectRecordQueryItem? SelectedProject { get; set; }

    [Parameter]
    public EventCallback<Guid?> SelectedProjectIdChanged { get; set; }

    [Parameter]
    public EventCallback<Exception> ProjectLoadFailed { get; set; }

    [Parameter]
    public int AssignmentCount { get; set; }

    [Parameter]
    public int AllocationCount { get; set; }

    [Parameter]
    public int? StaffingRequestCount { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenStructure { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenGantt { get; set; }

    private string StaffingRequestLabel => StaffingRequestCount.HasValue
        ? $"{StaffingRequestCount.Value} staffing requests"
        : "Staffing on demand";

    private string SelectedProjectLabel => SelectedProject?.Name
        ?? (SelectedProjectId.HasValue ? "Selected project" : "No project selected");

    private string SelectedProjectDescription => SelectedProject is null
        ? SelectedProjectId.HasValue
            ? "The selected project record is unavailable."
            : "Choose from the server-paged project catalog."
        : string.IsNullOrWhiteSpace(SelectedProject.CurrentPhase)
            ? SelectedProject.Status.ToString()
            : $"{SelectedProject.Status} / {SelectedProject.CurrentPhase}";

    private void OpenProjectPicker()
    {
        isProjectPickerOpen = true;
    }

    private Task CloseProjectPickerAsync()
    {
        isProjectPickerOpen = false;
        return Task.CompletedTask;
    }

    private async Task HandleProjectSelectedAsync(Guid projectId)
    {
        isProjectPickerOpen = false;
        await SelectedProjectIdChanged.InvokeAsync(projectId);
    }

    private Task ClearProjectAsync()
        => SelectedProjectIdChanged.InvokeAsync(null);
}

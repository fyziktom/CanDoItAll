@* Compatibility adapter: the CRM, Directory and Workforce pages keep composing InteractionTimeline with their own
   wording and test identifier, while the rendering lives in CanDoItAll.CrmHr.UI. The pages own the read through
   CrmHrActivityHistorySession and pass its presentation; the adapter forwards a page request only while that
   presentation admits one (an accepted page, no read in flight, the index inside the accepted range). *@
<CrmHrActivitySurface Presentation="@Presentation"
                      Copy="@Copy"
                      DataTestId="@DataTestId"
                      Intent="HandleIntentAsync" />

@code {
    [Parameter, EditorRequired]
    public CrmHrActivityPresentation Presentation { get; set; } = CrmHrActivityPresentation.NotAccepted;

    [Parameter]
    public EventCallback<int> PageRequested { get; set; }

    [Parameter]
    public string Eyebrow { get; set; } = CrmHrActivityCopy.Default.Eyebrow;

    [Parameter]
    public string Title { get; set; } = CrmHrActivityCopy.Default.Title;

    [Parameter]
    public string Description { get; set; } = CrmHrActivityCopy.Default.Description;

    [Parameter]
    public string EmptyEyebrow { get; set; } = CrmHrActivityCopy.Default.EmptyEyebrow;

    [Parameter]
    public string EmptyTitle { get; set; } = CrmHrActivityCopy.Default.EmptyTitle;

    [Parameter]
    public string EmptyDescription { get; set; } = CrmHrActivityCopy.Default.EmptyDescription;

    [Parameter]
    public string DataTestId { get; set; } = "crmhr-timeline";

    private CrmHrActivityCopy Copy => new(Eyebrow, Title, Description, EmptyEyebrow, EmptyTitle, EmptyDescription);

    private Task HandleIntentAsync(CrmHrActivityIntent intent)
        => intent switch
        {
            CrmHrActivityIntent.RequestPage request when IsAdmissible(request.PageIndex) => PageRequested.InvokeAsync(request.PageIndex),
            CrmHrActivityIntent.RequestPage => Task.CompletedTask,
            _ => throw new NotSupportedException($"The timeline adapter does not own the {intent.GetType().Name} intent.")
        };

    private bool IsAdmissible(int pageIndex)
        => Presentation is { IsLoading: false, Accepted: { } page } && pageIndex >= 0 && pageIndex < page.TotalPages;
}

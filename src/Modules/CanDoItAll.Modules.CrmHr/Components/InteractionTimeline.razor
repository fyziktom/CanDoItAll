<SurfaceCard>
    <TextBlock TextStyle="TextStyle.EyebrowCaption" Value="@Eyebrow" />
    <h3 class="mt-1 text-lg font-semibold text-chrome-950">@Title</h3>
    <p class="mt-3 text-sm leading-6 text-chrome-600">
        @Description
    </p>

    <Cluster Gap="LayoutGap.Small" Class="mt-4">
        <StatusBadge Tone="neutral" Text="@($"{Page.TotalCount:N0} activities")" />
        <StatusBadge Tone="info" Text="@($"{Page.ActionCount:N0} next actions")" />
        @if (Page.OverdueActionCount > 0)
        {
            <StatusBadge Tone="danger" Text="@($"{Page.OverdueActionCount:N0} overdue")" />
        }
    </Cluster>

    @if (IsLoading)
    {
        <div class="mt-5" data-testid="@($"{DataTestId}-loading")">
            <LoadingState Eyebrow="@Eyebrow"
                          Title="Loading history"
                          Description="Loading only the requested activity page." />
        </div>
    }
    else if (Page.Items.Count == 0)
    {
        <div class="mt-5">
            <EmptyState Eyebrow="@EmptyEyebrow"
                        Title="@EmptyTitle"
                        Description="@EmptyDescription" />
        </div>
    }
    else
    {
        <Stack GapScale="LayoutGap.Small" Class="mt-5">
            @foreach (var item in Page.Items)
            {
                <div class="rounded-[1.25rem] border border-chrome-200 bg-chrome-50/80 px-4 py-4"
                     data-testid="@($"{DataTestId}-item")">
                    <Split Gap="LayoutGap.Medium">
                        <div class="min-w-0">
                            <p class="text-sm font-semibold text-chrome-950">@item.Title</p>
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <p class="mt-2 text-sm leading-6 text-chrome-600">@item.Description</p>
                            }
                            <p class="mt-2 text-xs uppercase tracking-[0.18em] text-chrome-500">@item.Meta</p>
                        </div>
                        <Cluster Gap="LayoutGap.Small">
                            <StatusBadge Tone="@item.Tone" Text="@item.Kind" />
                            @if (item.IsOverdue)
                            {
                                <StatusBadge Tone="danger" Text="Overdue" />
                            }
                            <StatusBadge Tone="neutral" Text="@item.OccurredAtUtc.LocalDateTime.ToString("g")" />
                        </Cluster>
                    </Split>
                </div>
            }
        </Stack>
    }

    <Split Breakpoint="LayoutBreakpoint.None"
           Gap="LayoutGap.Small"
           AlignItems="AlignItems.Center"
           JustifyContent="JustifyContent.SpaceBetween"
           Wrap="FlexWrap.Wrap"
           Class="mt-5"
           data-testid="@($"{DataTestId}-pager")">
        <StatusBadge Tone="neutral" Text="@PageText" />
        <Cluster Gap="LayoutGap.Small">
            <Button Text="Previous"
                    Icon="chevron_left"
                    Tone="ButtonTone.Default"
                    Size="ButtonSize.Small"
                    Disabled="@(!CanMovePrevious)"
                    Click="@(() => RequestPageAsync(Page.PageIndex - 1))"
                    data-testid="@($"{DataTestId}-previous")" />
            <Button Text="Next"
                    Icon="chevron_right"
                    Tone="ButtonTone.Default"
                    Size="ButtonSize.Small"
                    Disabled="@(!CanMoveNext)"
                    Click="@(() => RequestPageAsync(Page.PageIndex + 1))"
                    data-testid="@($"{DataTestId}-next")" />
        </Cluster>
    </Split>
</SurfaceCard>

@code {
    [Parameter]
    public CrmActivityHistoryPage Page { get; set; } = CrmActivityHistoryPage.Empty();

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public EventCallback<int> PageRequested { get; set; }

    [Parameter]
    public string Eyebrow { get; set; } = "Timeline";

    [Parameter]
    public string Title { get; set; } = "Recent interactions and changes";

    [Parameter]
    public string Description { get; set; } = "Use this view before customer meetings or handoffs so the latest conversations, follow-ups, and CRM edits are visible in one place.";

    [Parameter]
    public string EmptyEyebrow { get; set; } = "No activity yet";

    [Parameter]
    public string EmptyTitle { get; set; } = "Log the first CRM interaction";

    [Parameter]
    public string EmptyDescription { get; set; } = "Timeline entries appear here after you save CRM interactions or update account details.";

    [Parameter]
    public string DataTestId { get; set; } = "crmhr-timeline";

    private string PageText => Page.TotalPages == 0
        ? "No pages"
        : $"Page {Page.PageIndex + 1:N0} of {Page.TotalPages:N0}";

    private bool CanMovePrevious => !IsLoading && Page.PageIndex > 0;

    private bool CanMoveNext =>
        !IsLoading &&
        Page.TotalPages > 0 &&
        Page.PageIndex + 1 < Page.TotalPages;

    private Task RequestPageAsync(int pageIndex)
    {
        return pageIndex < 0 || pageIndex >= Page.TotalPages
            ? Task.CompletedTask
            : PageRequested.InvokeAsync(pageIndex);
    }
}

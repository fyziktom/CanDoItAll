@* Compatibility adapter: the CRM, Directory and Workforce pages keep composing InteractionTimeline with the query
   owner's history page and their own wording, while the rendering lives in CanDoItAll.CrmHr.UI. Loading, failure
   and the read stay with each page; the adapter maps the page once per reference and forwards page requests. *@
<CrmHrActivitySurface Page="@presentation"
                      IsLoading="@IsLoading"
                      Copy="@Copy"
                      DataTestId="@DataTestId"
                      Intent="HandleIntentAsync" />

@code {
    private CrmActivityHistoryPage? mapped;
    private CrmHrActivityPage presentation = CrmHrActivityPage.Empty();

    [Parameter]
    public CrmActivityHistoryPage Page { get; set; } = CrmActivityHistoryPage.Empty();

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public EventCallback<int> PageRequested { get; set; }

    [Parameter]
    public string Eyebrow { get; set; } = CrmHrActivityCopy.Default.Eyebrow;

    [Parameter]
    public string Title { get; set; } = CrmHrActivityCopy.Default.Title;

    [Parameter]
    public string Description { get; set; } = CrmHrActivityCopy.Default.Description;

    [Parameter]
    public string EmptyEyebrow { get; set; } = CrmHrActivityCopy.Default.EmptyEyebrow;

    [Parameter]
    public string EmptyTitle { get; set; } = CrmHrActivityCopy.Default.EmptyTitle;

    [Parameter]
    public string EmptyDescription { get; set; } = CrmHrActivityCopy.Default.EmptyDescription;

    [Parameter]
    public string DataTestId { get; set; } = "crmhr-timeline";

    private CrmHrActivityCopy Copy => new(Eyebrow, Title, Description, EmptyEyebrow, EmptyTitle, EmptyDescription);

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(mapped, Page))
        {
            return;
        }

        mapped = Page;
        presentation = CrmHrActivityPresentationMapper.ToPage(Page);
    }

    private Task HandleIntentAsync(CrmHrActivityIntent intent)
        => intent switch
        {
            CrmHrActivityIntent.RequestPage request => PageRequested.InvokeAsync(request.PageIndex),
            _ => throw new NotSupportedException($"The timeline adapter does not own the {intent.GetType().Name} intent.")
        };
}

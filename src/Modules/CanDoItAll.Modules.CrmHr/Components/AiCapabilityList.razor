<Stack GapScale="LayoutGap.Medium">
    <Split Gap="LayoutGap.Medium"
           AlignItems="AlignItems.Center"
           JustifyContent="JustifyContent.SpaceBetween">
        <div>
            <TextBlock TextStyle="TextStyle.EyebrowCaption" Value="Capabilities and guardrails" />
            <p class="mt-1 text-sm leading-6 text-chrome-600">Capture what the agent can do, where it is safe to use it, which tools it may touch, and the limits that delivery teams need to respect.</p>
        </div>
        <Button Text="Add capability"
                Tone="ButtonTone.Default"
                Size="ButtonSize.Small"
                Click="AddCapability"
                data-testid="crmhr-agent-capability-add" />
    </Split>

    @if (Capabilities.Count == 0)
    {
        <div class="rounded-[1.25rem] border border-dashed border-chrome-300 bg-chrome-50/70 px-4 py-4 text-sm leading-6 text-chrome-600">
            No capabilities captured yet.
        </div>
    }
    else
    {
        @for (var index = 0; index < Capabilities.Count; index++)
        {
            var rowIndex = index;
            var capability = Capabilities[rowIndex];
            <PanelCard Soft="true">
                <Grid Gap="LayoutGap.Medium" ColumnsLg="2">
                    <div>
                        <FormField Text="Capability">
                        <TextInput @bind-Value="capability.Name"
                                   data-testid="@($"crmhr-agent-capability-name-{rowIndex}")" />
                        </FormField>
                    </div>
                    <div>
                        <FormField Text="Scope">
                        <TextInput @bind-Value="capability.Scope"
                                   data-testid="@($"crmhr-agent-capability-scope-{rowIndex}")" />
                        </FormField>
                    </div>
                </Grid>

                <Grid Gap="LayoutGap.Medium" ColumnsLg="2" Class="mt-4">
                    <div>
                        <FormField Text="Tool access">
                        <TextInput @bind-Value="capability.ToolAccess"
                                   data-testid="@($"crmhr-agent-capability-tool-access-{rowIndex}")" />
                        </FormField>
                    </div>
                    <div>
                        <FormField Text="Limitations">
                        <TextInput @bind-Value="capability.Limitations"
                                   data-testid="@($"crmhr-agent-capability-limitations-{rowIndex}")" />
                        </FormField>
                    </div>
                </Grid>

                <Grid Gap="LayoutGap.Medium" ColumnsLg="2" Class="mt-4">
                    <div>
                        <FormField Text="Notes">
                        <TextAreaInput @bind-Value="capability.Notes"

                                       data-testid="@($"crmhr-agent-capability-notes-{rowIndex}")" />
                        </FormField>
                    </div>
                    <div class="flex items-end justify-end">
                        <Button Text="Remove"
                                Tone="ButtonTone.Danger"
                                Size="ButtonSize.Small"
                                Click="@(() => RemoveCapability(rowIndex))"
                                data-testid="@($"crmhr-agent-capability-remove-{rowIndex}")" />
                    </div>
                </Grid>
            </PanelCard>
        }
    }
</Stack>

@code {
    [Parameter, EditorRequired]
    public IList<AiCapabilityEditorModel> Capabilities { get; set; } = default!;

    private void AddCapability()
    {
        Capabilities.Add(new AiCapabilityEditorModel());
    }

    private void RemoveCapability(int index)
    {
        Capabilities.RemoveAt(index);
    }
}

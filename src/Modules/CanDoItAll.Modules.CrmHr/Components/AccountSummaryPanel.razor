@* Compatibility adapter: the CRM page keeps composing AccountSummaryPanel with its workspace model, while the
   rendering lives in CanDoItAll.CrmHr.UI. The adapter maps the model once per instance and hands intents back as the
   callbacks the page owns; a conversion intent for an account this adapter no longer shows is dropped here. *@
<CrmHrAccountSummarySurface Account="@summary" IsInteractive="@IsInteractive" Intent="HandleIntentAsync" />

@code {
    private CrmAccountWorkspaceModel? mapped;
    private CrmHrAccountSummary? summary;

    [Parameter]
    public CrmAccountWorkspaceModel? Account { get; set; }

    [Parameter]
    public EventCallback OpenDirectory { get; set; }

    // Raised with the identity of the account the operator asked to convert; the page fences it against its selection.
    [Parameter]
    public EventCallback<Guid> MarkActiveCustomer { get; set; }

    [Parameter]
    public bool IsInteractive { get; set; } = true;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(mapped, Account))
        {
            return;
        }

        mapped = Account;
        summary = Account is null ? null : CrmHrAccountSummaryMapper.ToSummary(Account);
    }

    private Task HandleIntentAsync(CrmHrAccountSummaryIntent intent)
        => intent switch
        {
            CrmHrAccountSummaryIntent.OpenDirectory => OpenDirectory.InvokeAsync(),
            CrmHrAccountSummaryIntent.ConvertToActiveCustomer convert when Account?.AccountPartyId == convert.AccountPartyId
                => MarkActiveCustomer.InvokeAsync(convert.AccountPartyId),
            CrmHrAccountSummaryIntent.ConvertToActiveCustomer => Task.CompletedTask,
            _ => throw new NotSupportedException($"The account summary adapter does not own the {intent.GetType().Name} intent.")
        };
}

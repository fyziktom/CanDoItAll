@using static CanDoItAll.CrmHr.UI.Recruiting.CrmHrRecruitingWorkspacePresentation
@page "/crm-hr/recruiting"
@implements IDisposable
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.SharedKernel
@using Microsoft.Extensions.Logging
@inject RecruitingService RecruitingService
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject ILogger<CrmHrRecruitingPage> Logger

<PageTitle>CRM / HR Recruiting</PageTitle>

<AgentChatContextSurfaceProvider Surface="@AgentChatSurface"
                                 ContextNavigationIdentity="@AgentChatNavigationFence"
                                 ContextAccessState="@agentChatContextAccessState" />

<CrmHrRecruitingWorkspaceSurface View="this">
    <SecondaryNavigation>
        <CrmHrSecondaryTabs SelectedArea="CrmHrWorkspaceArea.Recruiting" />
    </SecondaryNavigation>
    <AgentEvidence>
        @if (currentWorkspace is { } recruitmentWorkspace)
        {
            <AgentRecruitingEvidencePanel CandidateAgentId="recruitmentWorkspace.CandidateTechnicalAgentId"
                                          RecruitmentApplicationId="recruitmentWorkspace.Application.Id"
                                          ReadinessChanged="HandleAssessmentReadinessChangedAsync"
                                          RequestTraining="OpenTrainingAsync" />
        }
    </AgentEvidence>
</CrmHrRecruitingWorkspaceSurface>

@code {
    [SupplyParameterFromQuery]
    private Guid? ApplicationId { get; set; }

    [SupplyParameterFromQuery]
    private Guid? PartyId { get; set; }

    private RecruitmentWorkspaceModel? currentWorkspace;
    private RecruitmentApplicationEditorModel applicationEditor = new();
    private RecruitmentInterviewEditorModel interviewEditor = new();
    private LifecycleTaskEditorModel taskEditor = new();
    private RecruitmentSupportAssignmentsEditorModel supportEditor = new();
    private RecruitmentConversionEditorModel conversionEditor = new();
    private AgentRecruitingCandidateReadiness? assessmentReadiness;
    private RecruitmentApplicationSummary applicationSummary = new(0, 0, 0);
    private int applicationBrowserRevision;
    private AgentChatContextAccessState agentChatContextAccessState = AgentChatContextAccessState.Loading;
    private long agentChatContextLoadGeneration;
    private long recruitmentActionGeneration;
    private readonly CrmHrMutationGate mutationGate = new();
    private readonly CrmHrDraftReconciler drafts = new();
    private const string ApplicationDraft = "application";
    private const string InterviewDraft = "interview";
    private const string TaskDraft = "task";
    private const string SupportDraft = "support";
    private const string ConversionDraft = "conversion";
    private Guid? committedApplicationId;
    private Guid? committedPartyId;
    private RecruitingRecordTab selectedRecruitingTab = RecruitingRecordTab.Application;
    private bool hasCommittedRecruitmentRoute;
    private bool isRecruitmentDialogOpen;
    private bool openNewApplicationAfterRouteReset;
    private bool isDisposed;

    private Guid? SelectedPartyId => currentWorkspace?.HasSelectedApplication == true ? currentWorkspace.Application.PartyId : null;

    private Error? ConversionEligibilityError => currentWorkspace?.HasSelectedApplication == true
        ? RecruitmentConversionPolicy.Evaluate(
            applicationEditor.Stage,
            applicationEditor.Decision,
            assessmentRequired: currentWorkspace.CandidatePartyType == PartyType.AiAgent,
            assessmentReady: assessmentReadiness?.ReadyForProduction == true)
        : Error.Validation("Save or select an application first.");

    private PagedRecordSelection<Guid>? ApplicationSelection => currentWorkspace?.Application.Id is { } applicationId
        ? new PagedRecordSelection<Guid>(applicationId)
        : null;

    private int SelectedRecruitingTabIndex => (int)selectedRecruitingTab;

    private string RecruitmentDialogTitle
        => currentWorkspace?.HasSelectedApplication == true &&
           !string.IsNullOrWhiteSpace(currentWorkspace.CandidateDisplayName)
            ? currentWorkspace.CandidateDisplayName
            : "New recruitment application";

    private AgentChatContextSurface AgentChatSurface
    {
        get
        {
            if (agentChatContextAccessState != AgentChatContextAccessState.Ready ||
                currentWorkspace is not { HasSelectedApplication: true } workspace ||
                !RecruitmentWorkspaceContextSelection.MatchesRequestedApplication(
                    ApplicationId,
                    PartyId,
                    workspace))
            {
                return CrmHrAgentChatSurfaceBuilder.BuildRecruitingSurface();
            }

            return CrmHrAgentChatSurfaceBuilder.BuildRecruitingSurface(
                workspace.Application.Id,
                workspace.Application.Stage,
                workspace.Application.Decision,
                workspace.Application.PartyId,
                workspace.CandidateDisplayName);
        }
    }

    private AgentChatNavigationIdentity AgentChatNavigationFence
        => AgentChatNavigationIdentity.CreateForLocation(
            Navigation.BaseUri,
            Navigation.Uri,
            [
                new("applicationId", ApplicationId?.ToString("D")),
                new("partyId", PartyId?.ToString("D"))
            ]);

    protected override async Task OnParametersSetAsync()
    {
        var requestedApplicationId = ApplicationId;
        var requestedPartyId = PartyId;
        if (!hasCommittedRecruitmentRoute ||
            committedApplicationId != requestedApplicationId ||
            committedPartyId != requestedPartyId)
        {
            InvalidateRecruitmentActions();
            isRecruitmentDialogOpen = false;
        }

        await LoadAsync();
    }

    private async Task LoadAsync(RecruitingEditor committed = RecruitingEditor.None)
    {
        var loadGeneration = Interlocked.Increment(ref agentChatContextLoadGeneration);
        var requestedApplicationId = ApplicationId;
        var requestedPartyId = PartyId;
        var previousApplicationId = currentWorkspace?.Application.Id;
        agentChatContextAccessState = AgentChatContextAccessState.Loading;
        try
        {
            var workspaceTask = RecruitingService.GetRecruitmentWorkspaceAsync(
                requestedApplicationId,
                requestedPartyId);
            var summaryTask = RecruitingService.GetRecruitmentApplicationSummaryAsync();
            await Task.WhenAll(workspaceTask, summaryTask);
            if (!IsCurrentAgentChatContextLoad(loadGeneration))
            {
                return;
            }

            var loadedWorkspace = await workspaceTask;
            currentWorkspace = loadedWorkspace;
            applicationSummary = await summaryTask;
            ApplyWorkspace(
                loadedWorkspace,
                applicationChanged: previousApplicationId != loadedWorkspace.Application.Id,
                committed);
            committedApplicationId = requestedApplicationId;
            committedPartyId = requestedPartyId;
            hasCommittedRecruitmentRoute = true;
            if (!RecruitmentWorkspaceContextSelection.MatchesRequestedApplication(
                    requestedApplicationId,
                    requestedPartyId,
                    loadedWorkspace))
            {
                isRecruitmentDialogOpen = false;
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
                return;
            }

            if (previousApplicationId != loadedWorkspace.Application.Id)
            {
                selectedRecruitingTab = RecruitingRecordTab.Application;
            }

            var shouldOpenNewApplication =
                openNewApplicationAfterRouteReset &&
                !requestedApplicationId.HasValue &&
                !requestedPartyId.HasValue &&
                !loadedWorkspace.HasSelectedApplication;
            openNewApplicationAfterRouteReset = false;
            isRecruitmentDialogOpen =
                shouldOpenNewApplication ||
                (loadedWorkspace.HasSelectedApplication &&
                 (requestedApplicationId.HasValue || requestedPartyId.HasValue));
            agentChatContextAccessState = AgentChatContextAccessState.Ready;
        }
        catch when (!IsCurrentAgentChatContextLoad(loadGeneration))
        {
        }
        catch
        {
            agentChatContextAccessState = AgentChatContextAccessState.Failed;
            throw;
        }
    }

    private bool IsCurrentAgentChatContextLoad(long loadGeneration)
        => !isDisposed &&
           loadGeneration == Volatile.Read(ref agentChatContextLoadGeneration);

    // A reload of the application already on screen (another editor's commit, a deleted interview or task, an agent
    // refresh) keeps what the operator typed into the editors it did not commit. Closing the record and starting a new
    // application discard every draft.
    private void ApplyWorkspace(
        RecruitmentWorkspaceModel workspace,
        bool applicationChanged,
        RecruitingEditor committed = RecruitingEditor.None)
    {
        assessmentReadiness = null;
        applicationEditor = drafts.Reconcile(
            ApplicationDraft,
            applicationEditor,
            () => CloneApplication(workspace.Application),
            applicationChanged,
            committed.HasFlag(RecruitingEditor.Application));
        interviewEditor = drafts.Reconcile(
            InterviewDraft,
            interviewEditor,
            () => workspace.HasSelectedApplication && workspace.Application.Id.HasValue
                ? CreateInterviewDraft(workspace.Application.Id.Value)
                : new RecruitmentInterviewEditorModel(),
            applicationChanged,
            committed.HasFlag(RecruitingEditor.Interview));
        taskEditor = drafts.Reconcile(
            TaskDraft,
            taskEditor,
            () => workspace.HasSelectedApplication && workspace.Application.PartyId.HasValue
                ? CreateTaskDraft(workspace.Application.PartyId.Value)
                : new LifecycleTaskEditorModel(),
            applicationChanged,
            committed.HasFlag(RecruitingEditor.Task));
        supportEditor = drafts.Reconcile(
            SupportDraft,
            supportEditor,
            () => workspace.HasSelectedApplication
                ? new RecruitmentSupportAssignmentsEditorModel
                {
                    PartyId = workspace.SupportAssignments.PartyId,
                    ManagerPartyId = workspace.SupportAssignments.ManagerPartyId,
                    BuddyPartyId = workspace.SupportAssignments.BuddyPartyId,
                    MentorPartyId = workspace.SupportAssignments.MentorPartyId
                }
                : new RecruitmentSupportAssignmentsEditorModel(),
            applicationChanged,
            committed.HasFlag(RecruitingEditor.Support));
        conversionEditor = drafts.Reconcile(
            ConversionDraft,
            conversionEditor,
            () => CloneConversion(workspace.Conversion),
            applicationChanged,
            committed.HasFlag(RecruitingEditor.Conversion));
    }

    private Task HandleAssessmentReadinessChangedAsync(
        AgentRecruitingCandidateReadiness? value)
    {
        assessmentReadiness = value;
        return Task.CompletedTask;
    }

    private async Task<PagedRecordPage<Guid>> LoadApplicationPageAsync(
        PagedRecordRequest<RecruitmentApplicationScope> request,
        CancellationToken cancellationToken)
    {
        if (request.Tags.Count > 0)
        {
            throw new InvalidOperationException("Recruitment application tag filtering is not supported.");
        }

        var result = await RecruitingService.SearchRecruitmentApplicationsAsync(
            new RecruitmentApplicationQuery(
                request.SearchText,
                request.Filter,
                request.PageIndex,
                request.PageSize),
            cancellationToken);
        return new PagedRecordPage<Guid>(
            result.Items.Select(ToApplicationOption).ToList(),
            result.PageIndex,
            result.PageSize,
            result.TotalCount);
    }

    private Task SelectApplicationAsync(Guid applicationId)
    {
        if (currentWorkspace?.Application.Id == applicationId &&
            (ApplicationId == applicationId || PartyId == currentWorkspace.Application.PartyId))
        {
            isRecruitmentDialogOpen = true;
            return Task.CompletedTask;
        }

        InvalidateRecruitmentActions();
        Interlocked.Increment(ref agentChatContextLoadGeneration);
        isRecruitmentDialogOpen = false;
        agentChatContextAccessState = AgentChatContextAccessState.Loading;
        Navigation.NavigateTo($"/crm-hr/recruiting?applicationId={applicationId:D}");
        return Task.CompletedTask;
    }

    private Task HandleApplicationPageLoadFailed(Exception exception)
    {
        Logger.LogError(exception, "Failed to load the server-paged recruitment application directory.");
        NotificationService.Error(
            "Recruitment applications unavailable",
            "The application list could not be loaded. Try again.");
        return Task.CompletedTask;
    }

    private Task CreateNewApplicationAsync()
    {
        if (ApplicationId.HasValue || PartyId.HasValue)
        {
            openNewApplicationAfterRouteReset = true;
            InvalidateRecruitmentActions();
            Interlocked.Increment(ref agentChatContextLoadGeneration);
            isRecruitmentDialogOpen = false;
            agentChatContextAccessState = AgentChatContextAccessState.Loading;
            Navigation.NavigateTo("/crm-hr/recruiting", replace: true);
            return Task.CompletedTask;
        }

        if (currentWorkspace is null)
        {
            openNewApplicationAfterRouteReset = true;
            return Task.CompletedTask;
        }

        if (currentWorkspace.HasSelectedApplication)
        {
            return Task.CompletedTask;
        }

        InvalidateRecruitmentActions();
        selectedRecruitingTab = RecruitingRecordTab.Application;
        ApplyWorkspace(currentWorkspace, applicationChanged: true);
        isRecruitmentDialogOpen = true;
        return Task.CompletedTask;
    }

    private Task CloseRecruitmentDialogAsync()
    {
        if (!isRecruitmentDialogOpen)
        {
            return Task.CompletedTask;
        }

        InvalidateRecruitmentActions();
        openNewApplicationAfterRouteReset = false;
        isRecruitmentDialogOpen = false;
        selectedRecruitingTab = RecruitingRecordTab.Application;
        if (currentWorkspace is { } workspace)
        {
            ApplyWorkspace(workspace, applicationChanged: true);
            agentChatContextAccessState = AgentChatContextAccessState.Ready;
            return Task.CompletedTask;
        }

        Interlocked.Increment(ref agentChatContextLoadGeneration);
        currentWorkspace = null;
        drafts.Reset();
        applicationEditor = new();
        interviewEditor = new();
        taskEditor = new();
        supportEditor = new();
        conversionEditor = new();
        agentChatContextAccessState = AgentChatContextAccessState.Loading;
        Navigation.NavigateTo("/crm-hr/recruiting", replace: true);
        return Task.CompletedTask;
    }

    private Task HandleRecruitingTabChangedAsync(int selectedIndex)
    {
        var requestedTab = (RecruitingRecordTab)selectedIndex;
        if (Enum.IsDefined(requestedTab))
        {
            selectedRecruitingTab = requestedTab;
        }

        return Task.CompletedTask;
    }

    private async Task SaveApplicationAsync()
    {
        var action = CaptureRecruitmentAction();
        if (!IsCurrentRecruitmentAction(action))
        {
            return;
        }

        using var admission = mutationGate.TryEnter(action.Generation);
        if (admission is null)
        {
            return;
        }

        var result = await RecruitingService.SaveRecruitmentApplicationAsync(
            drafts.Submit(ApplicationDraft, applicationEditor, static editor => editor.Snapshot()));
        if (!IsCurrentRecruitmentAction(action))
        {
            drafts.Retire(ApplicationDraft);
            return;
        }

        if (!result.IsSuccess)
        {
            // Nothing was written: the draft stays as the operator left it and owns all of its fields again.
            drafts.Retire(ApplicationDraft);
            SetError(result.Errors);
            return;
        }

        NotificationService.Success("Recruitment application saved", "Recruitment application saved.");
        applicationBrowserRevision++;
        if (ApplicationId != result.Value)
        {
            InvalidateRecruitmentActions();
            Interlocked.Increment(ref agentChatContextLoadGeneration);
            isRecruitmentDialogOpen = false;
            agentChatContextAccessState = AgentChatContextAccessState.Loading;
            Navigation.NavigateTo($"/crm-hr/recruiting?applicationId={result.Value:D}");
            return;
        }

        await RefreshAfterCommitAsync(RecruitingEditor.Application);
    }

    private Task ResetApplicationAsync()
    {
        applicationEditor = drafts.Replace(
            ApplicationDraft,
            currentWorkspace?.HasSelectedApplication == true ? CloneApplication(currentWorkspace.Application) : new RecruitmentApplicationEditorModel());
        return Task.CompletedTask;
    }

    private async Task SaveInterviewAsync()
    {
        var action = CaptureRecruitmentAction();
        if (!IsCurrentRecruitmentAction(action))
        {
            return;
        }

        if (currentWorkspace?.HasSelectedApplication != true || !currentWorkspace.Application.Id.HasValue)
        {
            SetError([Error.Validation("Save or select an application first.")]);
            return;
        }

        using var admission = mutationGate.TryEnter(action.Generation);
        if (admission is null)
        {
            return;
        }

        interviewEditor.ApplicationId = currentWorkspace.Application.Id.Value;
        var result = await RecruitingService.SaveRecruitmentInterviewAsync(
            drafts.Submit(InterviewDraft, interviewEditor, static editor => editor.Snapshot()));
        if (!IsCurrentRecruitmentAction(action))
        {
            drafts.Retire(InterviewDraft);
            return;
        }

        if (!result.IsSuccess)
        {
            drafts.Retire(InterviewDraft);
            SetError(result.Errors);
            return;
        }

        NotificationService.Success("Interview saved", "Interview saved.");
        // The create editor starts over once the owner accepted it, unless the operator already typed the next
        // interview into it while the write was in flight; that draft is theirs and survives the read-back whole.
        var interviewStartsOver = !drafts.ChangedAfterSubmission(InterviewDraft, interviewEditor);
        drafts.Retire(InterviewDraft);
        await RefreshAfterCommitAsync(interviewStartsOver ? RecruitingEditor.Interview : RecruitingEditor.None);
    }

    private Task ResetInterviewAsync()
    {
        interviewEditor = drafts.Replace(
            InterviewDraft,
            currentWorkspace?.HasSelectedApplication == true && currentWorkspace.Application.Id.HasValue
                ? CreateInterviewDraft(currentWorkspace.Application.Id.Value)
                : new RecruitmentInterviewEditorModel());
        return Task.CompletedTask;
    }

    private async Task DeleteInterviewAsync(Guid interviewId)
    {
        var action = CaptureRecruitmentAction();
        if (!IsCurrentRecruitmentAction(action))
        {
            return;
        }

        using var admission = mutationGate.TryEnter(action.Generation);
        if (admission is null)
        {
            return;
        }

        await RecruitingService.DeleteRecruitmentInterviewAsync(interviewId);
        if (!IsCurrentRecruitmentAction(action))
        {
            return;
        }

        NotificationService.Warning("Interview deleted", "Interview deleted.");
        await RefreshAfterCommitAsync(RecruitingEditor.None);
    }

    private async Task SaveTaskAsync()
    {
        var action = CaptureRecruitmentAction();
        if (!IsCurrentRecruitmentAction(action))
        {
            return;
        }

        if (currentWorkspace?.HasSelectedApplication != true || !currentWorkspace.Application.PartyId.HasValue)
        {
            SetError([Error.Validation("Save or select an application first.")]);
            return;
        }

        using var admission = mutationGate.TryEnter(action.Generation);
        if (admission is null)
        {
            return;
        }

        taskEditor.PartyId = currentWorkspace.Application.PartyId.Value;
        var result = await RecruitingService.SaveLifecycleTaskAsync(
            drafts.Submit(TaskDraft, taskEditor, static editor => editor.Snapshot()));
        if (!IsCurrentRecruitmentAction(action))
        {
            drafts.Retire(TaskDraft);
            return;
        }

        if (!result.IsSuccess)
        {
            drafts.Retire(TaskDraft);
            SetError(result.Errors);
            return;
        }

        NotificationService.Success("Lifecycle task saved", "Lifecycle task saved.");
        var taskStartsOver = !drafts.ChangedAfterSubmission(TaskDraft, taskEditor);
        drafts.Retire(TaskDraft);
        await RefreshAfterCommitAsync(taskStartsOver ? RecruitingEditor.Task : RecruitingEditor.None);
    }

    private Task ResetTaskAsync()
    {
        taskEditor = drafts.Replace(
            TaskDraft,
            currentWorkspace?.HasSelectedApplication == true && currentWorkspace.Application.PartyId.HasValue
                ? CreateTaskDraft(currentWorkspace.Application.PartyId.Value)
                : new LifecycleTaskEditorModel());
        return Task.CompletedTask;
    }

    private Task OpenTrainingAsync(RecruitmentTrainingRequest request)
    {
        if (currentWorkspace?.HasSelectedApplication != true ||
            !currentWorkspace.Application.PartyId.HasValue)
        {
            SetError([Error.Validation("Save or select an application first.")]);
            return Task.CompletedTask;
        }

        // The prefilled plan is unsaved content like anything typed: it is tracked from the empty draft, so a reload
        // of the same application keeps it.
        taskEditor = drafts.Replace(TaskDraft, CreateTaskDraft(currentWorkspace.Application.PartyId.Value));
        taskEditor.TaskKind = LifecycleTaskKind.Training;
        taskEditor.Title = $"{FormatClassification(request.Classification)} development plan";
        taskEditor.Notes =
            $"Assessment {request.InterviewId:D}; attempt {request.AttemptId:D}. " +
            (request.Gaps.Count == 0
                ? "No structured gaps were supplied."
                : $"Target gaps: {string.Join(", ", request.Gaps)}.");
        selectedRecruitingTab = RecruitingRecordTab.Development;
        return Task.CompletedTask;
    }

    private async Task DeleteTaskAsync(Guid taskId)
    {
        var action = CaptureRecruitmentAction();
        if (!IsCurrentRecruitmentAction(action))
        {
            return;
        }

        using var admission = mutationGate.TryEnter(action.Generation);
        if (admission is null)
        {
            return;
        }

        await RecruitingService.DeleteLifecycleTaskAsync(taskId);
        if (!IsCurrentRecruitmentAction(action))
        {
            return;
        }

        NotificationService.Warning("Lifecycle task deleted", "Lifecycle task deleted.");
        await RefreshAfterCommitAsync(RecruitingEditor.None);
    }

    private async Task SaveSupportAssignmentsAsync()
    {
        var action = CaptureRecruitmentAction();
        if (!IsCurrentRecruitmentAction(action))
        {
            return;
        }

        if (currentWorkspace?.HasSelectedApplication != true || !currentWorkspace.Application.PartyId.HasValue)
        {
            SetError([Error.Validation("Save or select an application first.")]);
            return;
        }

        using var admission = mutationGate.TryEnter(action.Generation);
        if (admission is null)
        {
            return;
        }

        supportEditor.PartyId = currentWorkspace.Application.PartyId.Value;
        var result = await RecruitingService.SaveSupportAssignmentsAsync(
            drafts.Submit(SupportDraft, supportEditor, static editor => editor.Snapshot()));
        if (!IsCurrentRecruitmentAction(action))
        {
            drafts.Retire(SupportDraft);
            return;
        }

        if (!result.IsSuccess)
        {
            drafts.Retire(SupportDraft);
            SetError(result.Errors);
            return;
        }

        NotificationService.Success("Support assignments saved", "Support assignments saved.");
        await RefreshAfterCommitAsync(RecruitingEditor.Support);
    }

    private async Task ConvertCandidateAsync()
    {
        var action = CaptureRecruitmentAction();
        if (!IsCurrentRecruitmentAction(action))
        {
            return;
        }

        if (currentWorkspace?.HasSelectedApplication != true || !currentWorkspace.Application.Id.HasValue)
        {
            SetError([Error.Validation("Save or select an application first.")]);
            return;
        }

        using var admission = mutationGate.TryEnter(action.Generation);
        if (admission is null)
        {
            return;
        }

        conversionEditor.ApplicationId = currentWorkspace.Application.Id.Value;
        var result = await RecruitingService.ConvertCandidateAsync(
            drafts.Submit(ConversionDraft, conversionEditor, static editor => editor.Snapshot()));
        if (!IsCurrentRecruitmentAction(action))
        {
            drafts.Retire(ConversionDraft);
            return;
        }

        if (!result.IsSuccess)
        {
            drafts.Retire(ConversionDraft);
            SetError(result.Errors);
            return;
        }

        NotificationService.Success("Candidate converted", "Candidate converted to workforce.");
        applicationBrowserRevision++;
        await RefreshAfterCommitAsync(RecruitingEditor.Conversion);
    }

    // The owner committed. A failed read-back is a warning: it never repeats the write and never discards the
    // committed identity; the operator can reload to reconcile the view.
    private async Task RefreshAfterCommitAsync(RecruitingEditor committed)
    {
        try
        {
            await LoadAsync(committed);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "The recruiting workspace could not be refreshed after a committed change.");
            NotificationService.Warning(
                "Saved, refresh failed",
                "The change was saved, but the workspace could not be refreshed. Reload the page to see the current state.");
        }
    }

    private Task SetConversionHomeUnitAsync(Guid? partyId)
    {
        conversionEditor.HomeUnitPartyId = partyId;
        return Task.CompletedTask;
    }

    private Task SetConversionManagerAsync(Guid? partyId)
    {
        conversionEditor.ManagerPartyId = partyId;
        return Task.CompletedTask;
    }

    private Task OpenWorkforceAsync()
    {
        if (SelectedPartyId.HasValue)
        {
            InvalidateRecruitmentActions();
            Navigation.NavigateTo($"/crm-hr/workforce?partyId={SelectedPartyId.Value:D}");
        }

        return Task.CompletedTask;
    }

    private RecruitmentActionStamp CaptureRecruitmentAction()
        => new(
            Volatile.Read(ref recruitmentActionGeneration),
            ApplicationId,
            PartyId,
            currentWorkspace?.Application.Id,
            isRecruitmentDialogOpen);

    private bool IsCurrentRecruitmentAction(RecruitmentActionStamp action)
        => !isDisposed &&
           action.Generation == Volatile.Read(ref recruitmentActionGeneration) &&
           action.RouteApplicationId == ApplicationId &&
           action.RoutePartyId == PartyId &&
           action.SelectedApplicationId == currentWorkspace?.Application.Id &&
           action.DialogWasOpen &&
           isRecruitmentDialogOpen;

    private void InvalidateRecruitmentActions()
        => Interlocked.Increment(ref recruitmentActionGeneration);

    private void SetError(IReadOnlyList<Error> errors)
    {
        NotificationService.Error(
            "Recruiting update failed",
            errors.Count == 0 ? "The operation failed." : string.Join(" ", errors.Select(item => item.Message)));
    }

    private static RecruitmentApplicationEditorModel CloneApplication(RecruitmentApplicationEditorModel source)
    {
        return new RecruitmentApplicationEditorModel
        {
            Id = source.Id,
            PartyId = source.PartyId,
            CandidateName = source.CandidateName,
            CandidateEmail = source.CandidateEmail,
            CandidatePhone = source.CandidatePhone,
            CandidateSummary = source.CandidateSummary,
            TargetUnitPartyId = source.TargetUnitPartyId,
            RecruiterPartyId = source.RecruiterPartyId,
            HiringManagerPartyId = source.HiringManagerPartyId,
            DesiredRole = source.DesiredRole,
            Source = source.Source,
            Stage = source.Stage,
            AvailableFrom = source.AvailableFrom,
            Decision = source.Decision,
            StageNotes = source.StageNotes,
            Notes = source.Notes,
            LastChangedBy = source.LastChangedBy
        };
    }

    private static RecruitmentConversionEditorModel CloneConversion(RecruitmentConversionEditorModel source)
    {
        return new RecruitmentConversionEditorModel
        {
            ApplicationId = source.ApplicationId,
            WorkforceKind = source.WorkforceKind,
            JobTitle = source.JobTitle,
            Discipline = source.Discipline,
            Seniority = source.Seniority,
            HomeUnitPartyId = source.HomeUnitPartyId,
            ManagerPartyId = source.ManagerPartyId,
            StartDate = source.StartDate,
            Location = source.Location,
            TimeZone = source.TimeZone,
            CapacityHoursPerWeek = source.CapacityHoursPerWeek,
            Status = source.Status,
            Notes = source.Notes,
            LastChangedBy = source.LastChangedBy
        };
    }

    private static RecruitmentInterviewEditorModel CreateInterviewDraft(Guid applicationId)
    {
        return new RecruitmentInterviewEditorModel
        {
            ApplicationId = applicationId,
            ScheduledAtLocal = DateTime.Today.AddHours(9),
            InterviewType = RecruitmentInterviewType.Screening,
            Outcome = RecruitmentInterviewOutcome.Pending
        };
    }

    private static LifecycleTaskEditorModel CreateTaskDraft(Guid partyId)
    {
        return new LifecycleTaskEditorModel
        {
            PartyId = partyId,
            TaskKind = LifecycleTaskKind.Onboarding,
            Status = LifecycleTaskStatus.NotStarted,
            DueDate = DateOnly.FromDateTime(DateTime.Today.AddDays(7))
        };
    }

    private static PagedRecordOption<Guid> ToApplicationOption(
        RecruitmentApplicationListItemModel item)
    {
        var tags = new List<string>
        {
            FormatCandidateType(item.CandidatePartyType),
            item.Stage.ToString(),
            item.Decision.ToString()
        };
        if (item.HasWorkforceProfile)
        {
            tags.Add("Workforce");
        }

        return new PagedRecordOption<Guid>(
            item.Id,
            item.CandidateName,
            BuildApplicationEyebrow(item))
        {
            Subtitle = BuildApplicationSummary(item),
            Description = BuildApplicationMeta(item),
            Meta = $"Updated {item.UpdatedAtUtc.LocalDateTime:g}",
            Tags = tags,
            Icon = item.CandidatePartyType == PartyType.AiAgent ? "smart_toy" : "person_search",
            KindTone = item.CandidatePartyType == PartyType.AiAgent
                ? PagedRecordBadgeTone.Info
                : PagedRecordBadgeTone.Accent,
            TagTone = ResolveApplicationTagTone(item),
            CornerStatus = ResolveApplicationCornerStatus(item),
            TestId = $"crmhr-recruiting-application-{item.Id:N}"
        };
    }

    private static PagedRecordBadgeTone ResolveApplicationTagTone(
        RecruitmentApplicationListItemModel item)
    {
        return item.Stage switch
        {
            RecruitmentStage.Hired => PagedRecordBadgeTone.Success,
            RecruitmentStage.Offer => PagedRecordBadgeTone.Info,
            RecruitmentStage.Interviewing => PagedRecordBadgeTone.Accent,
            RecruitmentStage.Rejected => PagedRecordBadgeTone.Warning,
            RecruitmentStage.Withdrawn => PagedRecordBadgeTone.Neutral,
            _ => PagedRecordBadgeTone.Teal
        };
    }

    private static PagedRecordCornerStatus ResolveApplicationCornerStatus(
        RecruitmentApplicationListItemModel item)
    {
        if (item.Decision == RecruitmentDecision.Rejected ||
            item.Stage == RecruitmentStage.Rejected)
        {
            return new PagedRecordCornerStatus("Rejected", PagedRecordStatusTone.Danger);
        }

        if (item.Decision == RecruitmentDecision.Withdrawn ||
            item.Stage == RecruitmentStage.Withdrawn)
        {
            return new PagedRecordCornerStatus("Withdrawn", PagedRecordStatusTone.Neutral);
        }

        return item.Stage switch
        {
            RecruitmentStage.Hired => new("Hired", PagedRecordStatusTone.Success),
            RecruitmentStage.Offer => new("Offer", PagedRecordStatusTone.Info),
            RecruitmentStage.Interviewing => new("Interview", PagedRecordStatusTone.Info),
            RecruitmentStage.Screening => new("Screening", PagedRecordStatusTone.Info),
            _ => new("Applied", PagedRecordStatusTone.Neutral)
        };
    }

    private static string BuildApplicationEyebrow(RecruitmentApplicationListItemModel item)
    {
        return string.IsNullOrWhiteSpace(item.DesiredRole) ? "Recruitment application" : item.DesiredRole;
    }

    private static string BuildApplicationMeta(RecruitmentApplicationListItemModel item)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(item.RecruiterName))
        {
            parts.Add($"Recruiter {item.RecruiterName}");
        }

        if (!string.IsNullOrWhiteSpace(item.HiringManagerName))
        {
            parts.Add($"Manager {item.HiringManagerName}");
        }

        if (item.AvailableFrom.HasValue)
        {
            parts.Add($"Available {item.AvailableFrom.Value:yyyy-MM-dd}");
        }

        return string.Join(" / ", parts);
    }

    private static string BuildApplicationSummary(RecruitmentApplicationListItemModel item)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(item.PrimaryEmail))
        {
            parts.Add(item.PrimaryEmail);
        }

        if (!string.IsNullOrWhiteSpace(item.TargetUnitName))
        {
            parts.Add(item.TargetUnitName);
        }

        return parts.Count == 0 ? "No additional candidate detail yet." : string.Join(" / ", parts);
    }

    private static string FormatClassification(
        AgentRecruitingAssessmentClassification classification)
    {
        return classification switch
        {
            AgentRecruitingAssessmentClassification.StrongFit => "Strong fit",
            AgentRecruitingAssessmentClassification.NeedsTraining => "Needs training",
            AgentRecruitingAssessmentClassification.NotSuitable => "Not suitable",
            _ => classification.ToString()
        };
    }

    // The editors of the recruitment record; a reload names the one whose commit caused it.
    [Flags]
    private enum RecruitingEditor
    {
        None = 0,
        Application = 1,
        Interview = 2,
        Task = 4,
        Support = 8,
        Conversion = 16
    }

    private enum RecruitingRecordTab
    {
        Application,
        Interviews,
        Assessments,
        Development,
        Conversion
    }

    private readonly record struct RecruitmentActionStamp(
        long Generation,
        Guid? RouteApplicationId,
        Guid? RoutePartyId,
        Guid? SelectedApplicationId,
        bool DialogWasOpen);

    public void Dispose()
    {
        if (isDisposed)
        {
            return;
        }

        isDisposed = true;
        InvalidateRecruitmentActions();
        Interlocked.Increment(ref agentChatContextLoadGeneration);
    }
}

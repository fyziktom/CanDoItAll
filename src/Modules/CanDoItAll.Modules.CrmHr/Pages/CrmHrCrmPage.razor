    private AgentChatNavigationIdentity AgentChatNavigationFence
        => AgentChatNavigationIdentity.CreateForLocation(
            Navigation.BaseUri,
            Navigation.Uri,
            [
                new("accountId", AccountIdQuery?.ToString("D")),
                new("opportunityId", OpportunityIdQuery?.ToString("D")),
                new("interactionId", InteractionIdQuery?.ToString("D"))
            ]);

    protected override async Task OnParametersSetAsync()
    {
        var requestedAccountId = AccountIdQuery;
        var requestedOpportunityId = OpportunityIdQuery;
        var requestedInteractionId = InteractionIdQuery;
        var queryKey = BuildQueryKey(
            requestedAccountId,
            requestedOpportunityId,
            requestedInteractionId);
        var capturedSelectedAccountId = selectedAccount?.AccountPartyId;
        var capturedSelectedOpportunityId = selectedOpportunityId;
        var loadGeneration = BeginQueryLoad(queryKey, resetTransientState: true);
        using var loadCancellation = new CancellationTokenSource();
        var supersededLoad = Interlocked.Exchange(ref queryLoadCancellation, loadCancellation);
        supersededLoad?.Cancel();
        try
        {
            if (committedQueryKey is not null &&
                !string.Equals(committedQueryKey, queryKey, StringComparison.Ordinal))
            {
                agentChatAccountContext = null;
                agentChatOpportunityContext = null;
                agentChatInteractionContext = null;
                await InvokeAsync(StateHasChanged);
            }

            var loadedAccountsTask = CrmService.ListAccountsAsync(loadCancellation.Token);
            var routeResolutionTask = CrmService.ResolveRouteSelectionAsync(
                requestedAccountId,
                requestedOpportunityId,
                requestedInteractionId,
                loadCancellation.Token);
            await Task.WhenAll(loadedAccountsTask, routeResolutionTask);
            var loadedAccounts = await loadedAccountsTask;
            var routeResolution = await routeResolutionTask;
            if (!IsCurrentQueryLoad(loadGeneration))
            {
                return;
            }

            accounts = loadedAccounts;
            committedQueryKey = queryKey;
            if (!routeResolution.IsResolved)
            {
                ClearAccountSelection();
                message = null;
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
                return;
            }

            var targetId = routeResolution.AccountPartyId;
            if (!targetId.HasValue && loadedAccounts.Count > 0)
            {
                targetId = loadedAccounts[0].AccountPartyId;
            }

            CrmAccountWorkspaceModel? account = null;
            if (targetId.HasValue)
            {
                account = await CrmService.GetAccountWorkspaceAsync(
                    targetId.Value,
                    loadCancellation.Token);
                if (!IsCurrentQueryLoad(loadGeneration))
                {
                    return;
                }
            }

            if (account is null)
            {
                ClearAccountSelection();
                message = null;
                agentChatContextAccessState = requestedAccountId.HasValue ||
                                                  requestedOpportunityId.HasValue ||
                                                  requestedInteractionId.HasValue
                    ? AgentChatContextAccessState.Failed
                    : AgentChatContextAccessState.Ready;
                return;
            }

            var preferredOpportunityId = requestedOpportunityId ??
                                         (!requestedInteractionId.HasValue &&
                                          capturedSelectedAccountId == account.AccountPartyId
                                             ? capturedSelectedOpportunityId
                                             : null);
            ApplyLoadedAccount(
                account,
                clearMessage: true,
                requestedOpportunityId,
                preferredOpportunityId,
                requestedInteractionId);
            var requestedSelectionFound =
                (!requestedOpportunityId.HasValue ||
                 selectedOpportunityId == requestedOpportunityId) &&
                (!requestedInteractionId.HasValue ||
                 selectedInteractionId == requestedInteractionId);
            agentChatContextAccessState = requestedSelectionFound
                ? AgentChatContextAccessState.Ready
                : AgentChatContextAccessState.Failed;
        }
        catch (OperationCanceledException) when (loadCancellation.IsCancellationRequested)
        {
        }
        catch when (!IsCurrentQueryLoad(loadGeneration))
        {
        }
        catch
        {
            agentChatContextAccessState = AgentChatContextAccessState.Failed;
            throw;
        }
        finally
        {
            Interlocked.CompareExchange(
                ref queryLoadCancellation,
                null,
                loadCancellation);
        }
    }

    private CrmQueryLoadStamp BeginQueryLoad(string queryKey, bool resetTransientState)
    {
        if (resetTransientState)
        {
            Interlocked.Increment(ref transientStateGeneration);
            isOpportunityBusy = false;
            isOpportunityConversionBusy = false;
            isOpportunityConversionDialogOpen = false;
        }

        agentChatContextAccessState = AgentChatContextAccessState.Loading;
        var stamp = queryLoadGeneration.Begin(queryKey);
        activeQueryLoadStamp = stamp;
        return stamp;
    }

    private void ApplyLoadedAccount(
        CrmAccountWorkspaceModel account,
        bool clearMessage,
        Guid? requestedOpportunityId,
        Guid? preferredOpportunityId,
        Guid? requestedInteractionId)
    {
        selectedAccount = account;
        profileEditor = new CrmAccountProfileEditorModel
        {
            Id = account.Profile.Id,
            AccountPartyId = account.Profile.AccountPartyId,
            RelationshipStage = account.Profile.RelationshipStage,
            CommercialNotes = account.Profile.CommercialNotes,
            ConstraintNotes = account.Profile.ConstraintNotes,
            TimingRiskNotes = account.Profile.TimingRiskNotes,
            LastChangedBy = account.Profile.LastChangedBy
        };
        stakeholderEditors = account.Stakeholders
            .Select(item => new CrmAccountStakeholderEditorModel
            {
                Id = item.Id,
                RelatedPartyId = item.RelatedPartyId,
                Role = item.Role,
                IsPrimary = item.IsPrimary,
                Notes = item.Notes
            })
            .ToList();
        ApplyContextSelection(
            requestedOpportunityId,
            preferredOpportunityId,
            requestedInteractionId);

        if (clearMessage)
        {
            message = null;
            messageTone = "success";
        }
    }

    private async Task<bool> ReloadSelectedAccountAsync(
        CrmPageActionStamp action,
        bool clearMessage,
        Guid? preferredOpportunityId = null)
    {
        if (!IsCurrentCrmAction(action))
        {
            return false;
        }

        var queryKey = BuildQueryKey(
            action.RouteAccountId,
            action.RouteOpportunityId,
            action.RouteInteractionId);
        var loadGeneration = BeginQueryLoad(queryKey, resetTransientState: false);
        using var loadCancellation = new CancellationTokenSource();
        var supersededLoad = Interlocked.Exchange(ref queryLoadCancellation, loadCancellation);
        supersededLoad?.Cancel();
        try
        {
            var accountsTask = CrmService.ListAccountsAsync(loadCancellation.Token);
            var accountTask = CrmService.GetAccountWorkspaceAsync(
                action.AccountId,
                loadCancellation.Token);
            await Task.WhenAll(accountsTask, accountTask);
            var loadedAccounts = await accountsTask;
            var account = await accountTask;
            if (!IsCurrentAccountRefresh(loadGeneration, action))
            {
                return false;
            }

            accounts = loadedAccounts;
            committedQueryKey = queryKey;
            if (account is null)
            {
                ClearAccountSelection();
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
                return false;
            }

            ApplyLoadedAccount(
                account,
                clearMessage,
                action.RouteOpportunityId,
                preferredOpportunityId ?? action.SelectedOpportunityId,
                action.RouteInteractionId);
            var requestedSelectionFound =
                (!action.RouteOpportunityId.HasValue ||
                 selectedOpportunityId == action.RouteOpportunityId) &&
                (!action.RouteInteractionId.HasValue ||
                 selectedInteractionId == action.RouteInteractionId);
            agentChatContextAccessState = requestedSelectionFound
                ? AgentChatContextAccessState.Ready
                : AgentChatContextAccessState.Failed;
            return requestedSelectionFound;
        }
        catch (OperationCanceledException) when (loadCancellation.IsCancellationRequested)
        {
            return false;
        }
        catch when (!IsCurrentAccountRefresh(loadGeneration, action))
        {
            return false;
        }
        catch
        {
            agentChatContextAccessState = AgentChatContextAccessState.Failed;
            throw;
        }
        finally
        {
            Interlocked.CompareExchange(
                ref queryLoadCancellation,
                null,
                loadCancellation);
        }
    }

    private bool TryCaptureCrmAction(out CrmPageActionStamp action)
    {
        action = default;
        if (agentChatContextAccessState != AgentChatContextAccessState.Ready ||
            activeQueryLoadStamp is not CrmQueryLoadStamp loadStamp ||
            selectedAccount is not { } account ||
            !IsCurrentQueryLoad(loadStamp))
        {
            return false;
        }

        action = new CrmPageActionStamp(
            loadStamp,
            AccountIdQuery,
            OpportunityIdQuery,
            InteractionIdQuery,
            account.AccountPartyId,
            selectedOpportunityId,
            selectedInteractionId);
        return IsCurrentCrmAction(action);
    }

    private bool IsCurrentCrmAction(CrmPageActionStamp action)
        => IsCurrentQueryLoad(action.LoadStamp) &&
           AccountIdQuery == action.RouteAccountId &&
           OpportunityIdQuery == action.RouteOpportunityId &&
           InteractionIdQuery == action.RouteInteractionId &&
           selectedAccount?.AccountPartyId == action.AccountId &&
           selectedOpportunityId == action.SelectedOpportunityId &&
           selectedInteractionId == action.SelectedInteractionId;

    private bool IsCurrentAccountRefresh(
        CrmQueryLoadStamp loadStamp,
        CrmPageActionStamp action)
        => IsCurrentQueryLoad(loadStamp) &&
           AccountIdQuery == action.RouteAccountId &&
           OpportunityIdQuery == action.RouteOpportunityId &&
           InteractionIdQuery == action.RouteInteractionId &&
           selectedAccount?.AccountPartyId == action.AccountId &&
           selectedOpportunityId == action.SelectedOpportunityId &&
           selectedInteractionId == action.SelectedInteractionId;


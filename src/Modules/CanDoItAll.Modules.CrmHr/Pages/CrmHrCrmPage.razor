                .Concat(selectedAccount.Opportunities
                    .Where(item => item.DeliveryUnitPartyId.HasValue && !string.IsNullOrWhiteSpace(item.DeliveryUnitDisplayName))
                    .Select(item => new PartyOptionModel(item.DeliveryUnitPartyId!.Value, item.DeliveryUnitDisplayName, PartyType.OrganizationUnit))));


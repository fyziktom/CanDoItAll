    private async Task RefreshObservedAccountActivityAsync() {
        accountActivityOutdated = true;
        if (selectedAccount is { } account && accountRecords.AccountId == account.AccountPartyId && url.State.Section == CrmSection.Interactions) {
            await EnsureAccountActivityLoadedAsync();
        }
    }


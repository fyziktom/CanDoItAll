@using static CanDoItAll.CrmHr.UI.Crm.CrmHrCrmWorkspacePresentation
@page "/crm-hr/crm"
@implements IDisposable
@using CanDoItAll.AgentFramework.Core
@using CanDoItAll.AgentFramework.Models
@using CanDoItAll.Components.BaseLib
@using Microsoft.Extensions.Logging
@inject CrmService CrmService
@inject CanDoItAll.Modules.Projects.ProjectWriteAdmissionService ProjectWriteAdmissions
@inject IPartyRecordQueryService PartyRecordQueryService
@inject IAgentChatLauncher AgentChatLauncher
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject ILogger<CrmHrCrmPage> Logger

<PageTitle>CRM / HR CRM</PageTitle>

<CrmAgentChatContextProvider AccountCount="accountCount"
                             Account="agentChatAccountContext"
                             Opportunity="agentChatOpportunityContext"
                             Interaction="agentChatInteractionContext"
                             ContextNavigationIdentity="@AgentChatNavigationFence"
                             ContextAccessState="@agentChatContextAccessState"
                             RefreshRequested="HandleAgentChatRefreshRequestedAsync" />

<CrmHrCrmWorkspaceSurface View="this">
    <SecondaryNavigation>
        <CrmHrSecondaryTabs SelectedArea="CrmHrWorkspaceArea.Crm" />
    </SecondaryNavigation>
    <AccountSummary>
        <AccountSummaryPanel Account="selectedAccount"
                             OpenDirectory="OpenDirectory"
                             MarkActiveCustomer="MarkActiveCustomerAsync"
                             IsInteractive="@isInteractive" />
    </AccountSummary>
    <Financials>
        @if (selectedAccount is { } financialsAccount)
        {
            <CrmFinancialsPanel AccountPartyId="@financialsAccount.AccountPartyId" />
        }
    </Financials>
    <ActivityTimeline>
        <InteractionTimeline Presentation="@AccountActivityPresentation"
                             PageRequested="HandleAccountActivityPageRequestedAsync"
                             DataTestId="crmhr-account-activity" />
    </ActivityTimeline>
</CrmHrCrmWorkspaceSurface>

@code {
    // The database profile that project admissions captured on this page are bound to.
    private Guid ProjectDatabaseProfileId => ProjectWriteAdmissions.DatabaseProfileId;

    // What the history lane accepted for the selected account, and its failure copy; the surface never sees the session.
    private CrmHrActivityPresentation AccountActivityPresentation => accountActivity.Presentation;

    private string? AccountActivityFailureMessage => accountActivity.FailureMessage;

    [SupplyParameterFromQuery(Name = "accountId")]
    public Guid? AccountIdQuery { get; set; }

    [SupplyParameterFromQuery(Name = "opportunityId")]
    public Guid? OpportunityIdQuery { get; set; }

    [SupplyParameterFromQuery(Name = "interactionId")]
    public Guid? InteractionIdQuery { get; set; }

    private readonly Dictionary<Guid, string> connectionPartyLabels = [];
    private CrmAccountWorkspaceModel? selectedAccount;
    private CrmInteractionDetailModel? selectedInteraction;
    private CrmOpportunityDetailModel? selectedOpportunity;
    private CrmHrActivityHistorySession accountActivity = default!;
    private CrmAccountProfileEditorModel profileEditor = new();
    private List<CrmAccountConnectionEditorModel> connectedRecordEditors = [];
    private CrmInteractionEditorModel interactionEditor = CreateInteractionEditor();
    private CrmOpportunityEditorModel opportunityEditor = new();
    private CrmOpportunityConversionEditorModel opportunityConversionEditor = new();
    private CrmAgentChatAccountContext? agentChatAccountContext;
    private CrmAgentChatOpportunityContext? agentChatOpportunityContext;
    private CrmAgentChatInteractionContext? agentChatInteractionContext;
    private AgentChatContextAccessState agentChatContextAccessState = AgentChatContextAccessState.Loading;
    private int accountCount;
    private Guid? selectedOpportunityId;
    private Guid? selectedInteractionId;
    private int? connectionPartyPickerIndex;
    private CrmRecordTab selectedCrmRecordTab = CrmRecordTab.Overview;
    private string? committedQueryKey;
    private readonly CrmQueryLoadGeneration queryLoadGeneration = new();
    private CrmQueryLoadStamp? activeQueryLoadStamp;
    private CancellationTokenSource? queryLoadCancellation;
    private long transientStateGeneration;
    private string? message;
    private long opportunityPipelineRefreshVersion;
    private bool isOpportunityBusy;
    private bool isOpportunityCreateDialogOpen;
    private bool isOpportunityDetailDialogOpen;
    private bool isOpportunityEditDialogOpen;
    private bool isOpportunityConversionDialogOpen;
    private bool isAccountDialogOpen;
    private bool isOpportunityConversionBusy;
    private bool isInteractive;
    private bool isDisposed;

    private int SelectedCrmRecordTabIndex => (int)selectedCrmRecordTab;

    private IReadOnlyList<PartyOptionModel> ParticipantOptions
        => selectedAccount is null
            ? []
            : selectedAccount.ConnectedParties
                .Where(option => connectedRecordEditors.Any(connection => connection.RelatedPartyId == option.Id))
                .ToList();

    private CrmOpportunityDetailModel? SelectedOpportunity
        => selectedOpportunity?.Id == selectedOpportunityId
            ? selectedOpportunity
            : null;

    private Guid? SelectedConnectionPartyId
        => connectionPartyPickerIndex is int index &&
           index >= 0 &&
           index < connectedRecordEditors.Count &&
           connectedRecordEditors[index].RelatedPartyId != Guid.Empty
            ? connectedRecordEditors[index].RelatedPartyId
            : null;

    private CrmInteractionDetailModel? SelectedInteraction
        => selectedInteraction?.Id == selectedInteractionId
            ? selectedInteraction
            : null;

    private AgentChatNavigationIdentity AgentChatNavigationFence
        => AgentChatNavigationIdentity.CreateForLocation(
            Navigation.BaseUri,
            Navigation.Uri,
            [
                new("accountId", AccountIdQuery?.ToString("D")),
                new("opportunityId", OpportunityIdQuery?.ToString("D")),
                new("interactionId", InteractionIdQuery?.ToString("D"))
            ]);

    protected override void OnInitialized()
    {
        accountActivity = new CrmHrActivityHistorySession(
            (query, cancellationToken) => CrmService.SearchAccountActivityAsync(query, cancellationToken),
            initialFailureMessage: "Account activity could not be loaded.",
            pageFailureMessage: "The requested account activity page could not be loaded.",
            Logger);
    }

    protected override async Task OnParametersSetAsync()
    {
        var requestedAccountId = AccountIdQuery;
        var requestedOpportunityId = OpportunityIdQuery;
        var requestedInteractionId = InteractionIdQuery;
        var queryKey = BuildQueryKey(
            requestedAccountId,
            requestedOpportunityId,
            requestedInteractionId);
        if (!string.Equals(committedQueryKey, queryKey, StringComparison.Ordinal))
        {
            isAccountDialogOpen = false;
        }

        var capturedSelectedAccountId = selectedAccount?.AccountPartyId;
        var capturedSelectedOpportunityId = selectedOpportunityId;
        var loadGeneration = BeginQueryLoad(queryKey, resetTransientState: true);
        using var loadCancellation = new CancellationTokenSource();
        var supersededLoad = Interlocked.Exchange(ref queryLoadCancellation, loadCancellation);
        supersededLoad?.Cancel();
        try
        {
            if (committedQueryKey is not null &&
                !string.Equals(committedQueryKey, queryKey, StringComparison.Ordinal))
            {
                agentChatAccountContext = null;
                agentChatOpportunityContext = null;
                agentChatInteractionContext = null;
                await InvokeAsync(StateHasChanged);
            }

            var accountCountTask = CrmService.CountAccountsAsync(loadCancellation.Token);
            var routeResolutionTask = CrmService.ResolveRouteSelectionAsync(
                requestedAccountId,
                requestedOpportunityId,
                requestedInteractionId,
                loadCancellation.Token);
            await Task.WhenAll(accountCountTask, routeResolutionTask);
            accountCount = await accountCountTask;
            var routeResolution = await routeResolutionTask;
            if (!IsCurrentQueryLoad(loadGeneration))
            {
                return;
            }

            committedQueryKey = queryKey;
            if (!routeResolution.IsResolved)
            {
                ClearAccountSelection();
                message = null;
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
                return;
            }

            var targetId = routeResolution.AccountPartyId;
            CrmAccountWorkspaceModel? account = null;
            if (targetId.HasValue)
            {
                account = await CrmService.GetAccountWorkspaceAsync(
                    targetId.Value,
                    loadCancellation.Token);
                if (!IsCurrentQueryLoad(loadGeneration))
                {
                    return;
                }
            }

            if (account is null)
            {
                ClearAccountSelection();
                message = null;
                agentChatContextAccessState = requestedAccountId.HasValue ||
                                                  requestedOpportunityId.HasValue ||
                                                  requestedInteractionId.HasValue
                    ? AgentChatContextAccessState.Failed
                    : AgentChatContextAccessState.Ready;
                return;
            }

            var interaction = requestedInteractionId.HasValue
                ? await CrmService.GetAccountInteractionAsync(
                    account.AccountPartyId,
                    requestedInteractionId.Value,
                    loadCancellation.Token)
                : null;
            if (!IsCurrentQueryLoad(loadGeneration))
            {
                return;
            }

            var relatedInteractionOpportunityId = interaction?.RelatedOpportunityId;
            var preferredOpportunityId = requestedOpportunityId ??
                                         relatedInteractionOpportunityId ??
                                         (capturedSelectedAccountId == account.AccountPartyId
                                             ? capturedSelectedOpportunityId
                                             : null);
            var opportunity = await LoadOpportunityForAccountAsync(
                preferredOpportunityId,
                account.AccountPartyId,
                loadCancellation.Token);
            if (!IsCurrentQueryLoad(loadGeneration))
            {
                return;
            }

            ApplyLoadedAccount(
                account,
                opportunity,
                interaction,
                clearMessage: true,
                requestedOpportunityId,
                preferredOpportunityId,
                requestedInteractionId);
            SelectCrmRecordTabForRoute(
                account.AccountPartyId,
                capturedSelectedAccountId,
                requestedOpportunityId,
                requestedInteractionId);
            isAccountDialogOpen = true;
            if (selectedCrmRecordTab == CrmRecordTab.Interactions)
            {
                await EnsureAccountActivityLoadedAsync();
            }
            var requestedSelectionFound =
                (!requestedOpportunityId.HasValue ||
                 selectedOpportunityId == requestedOpportunityId) &&
                (!requestedInteractionId.HasValue ||
                 selectedInteractionId == requestedInteractionId);
            agentChatContextAccessState = requestedSelectionFound
                ? AgentChatContextAccessState.Ready
                : AgentChatContextAccessState.Failed;
        }
        catch (OperationCanceledException) when (loadCancellation.IsCancellationRequested)
        {
        }
        catch when (!IsCurrentQueryLoad(loadGeneration))
        {
        }
        catch
        {
            agentChatContextAccessState = AgentChatContextAccessState.Failed;
            throw;
        }
        finally
        {
            Interlocked.CompareExchange(
                ref queryLoadCancellation,
                null,
                loadCancellation);
        }
    }

    private CrmQueryLoadStamp BeginQueryLoad(string queryKey, bool resetTransientState)
    {
        if (resetTransientState)
        {
            Interlocked.Increment(ref transientStateGeneration);
            isOpportunityBusy = false;
            isOpportunityConversionBusy = false;
            isOpportunityCreateDialogOpen = false;
            isOpportunityDetailDialogOpen = false;
            isOpportunityEditDialogOpen = false;
            isOpportunityConversionDialogOpen = false;
        }

        agentChatContextAccessState = AgentChatContextAccessState.Loading;
        var stamp = queryLoadGeneration.Begin(queryKey);
        activeQueryLoadStamp = stamp;
        return stamp;
    }

    private async Task<CrmOpportunityDetailModel?> LoadOpportunityForAccountAsync(
        Guid? opportunityId,
        Guid accountPartyId,
        CancellationToken cancellationToken)
    {
        if (!opportunityId.HasValue)
        {
            return null;
        }

        var opportunity = await CrmService.GetOpportunityAsync(
            opportunityId.Value,
            cancellationToken);
        return opportunity?.AccountPartyId == accountPartyId
            ? opportunity
            : null;
    }

    private void ApplyLoadedAccount(
        CrmAccountWorkspaceModel account,
        CrmOpportunityDetailModel? opportunity,
        CrmInteractionDetailModel? interaction,
        bool clearMessage,
        Guid? requestedOpportunityId,
        Guid? preferredOpportunityId,
        Guid? requestedInteractionId)
    {
        InvalidateAccountActivity();
        selectedAccount = account;
        selectedOpportunity = opportunity;
        selectedInteraction = interaction;
        profileEditor = new CrmAccountProfileEditorModel
        {
            Id = account.Profile.Id,
            AccountPartyId = account.Profile.AccountPartyId,
            RelationshipStage = account.Profile.RelationshipStage,
            CommercialNotes = account.Profile.CommercialNotes,
            ConstraintNotes = account.Profile.ConstraintNotes,
            TimingRiskNotes = account.Profile.TimingRiskNotes,
            LastChangedBy = account.Profile.LastChangedBy
        };
        connectedRecordEditors = account.ConnectedRecords
            .Select(item => new CrmAccountConnectionEditorModel
            {
                Id = item.Id,
                RelatedPartyId = item.RelatedPartyId,
                Role = item.Role,
                IsPrimary = item.IsPrimary,
                Notes = item.Notes,
                ProjectIds = item.Projects.Select(project => project.Id).ToList()
            })
            .ToList();
        connectionPartyLabels.Clear();
        foreach (var connection in account.ConnectedRecords)
        {
            connectionPartyLabels[connection.RelatedPartyId] =
                $"{connection.DisplayName} ({connection.PartyType})";
        }

        connectionPartyPickerIndex = null;
        ApplyContextSelection(
            requestedOpportunityId,
            preferredOpportunityId,
            requestedInteractionId);

        if (clearMessage)
        {
            message = null;
        }
    }

    private async Task<bool> ReloadSelectedAccountAsync(
        CrmPageActionStamp action,
        bool clearMessage,
        Guid? preferredOpportunityId = null)
    {
        if (!IsCurrentCrmAction(action))
        {
            return false;
        }

        var queryKey = BuildQueryKey(
            action.RouteAccountId,
            action.RouteOpportunityId,
            action.RouteInteractionId);
        var loadGeneration = BeginQueryLoad(queryKey, resetTransientState: false);
        using var loadCancellation = new CancellationTokenSource();
        var supersededLoad = Interlocked.Exchange(ref queryLoadCancellation, loadCancellation);
        supersededLoad?.Cancel();
        try
        {
            var account = await CrmService.GetAccountWorkspaceAsync(
                action.AccountId,
                loadCancellation.Token);
            if (!IsCurrentAccountRefresh(loadGeneration, action))
            {
                return false;
            }

            committedQueryKey = queryKey;
            if (account is null)
            {
                ClearAccountSelection();
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
                return false;
            }

            var targetOpportunityId = preferredOpportunityId ??
                                      action.SelectedOpportunityId ??
                                      action.RouteOpportunityId;
            var opportunity = await LoadOpportunityForAccountAsync(
                targetOpportunityId,
                account.AccountPartyId,
                loadCancellation.Token);
            if (!IsCurrentAccountRefresh(loadGeneration, action))
            {
                return false;
            }

            var interaction = action.RouteInteractionId.HasValue
                ? await CrmService.GetAccountInteractionAsync(
                    account.AccountPartyId,
                    action.RouteInteractionId.Value,
                    loadCancellation.Token)
                : null;
            if (!IsCurrentAccountRefresh(loadGeneration, action))
            {
                return false;
            }

            ApplyLoadedAccount(
                account,
                opportunity,
                interaction,
                clearMessage,
                action.RouteOpportunityId,
                preferredOpportunityId ?? action.SelectedOpportunityId,
                action.RouteInteractionId);
            if (selectedCrmRecordTab == CrmRecordTab.Interactions)
            {
                await EnsureAccountActivityLoadedAsync();
            }
            var requestedSelectionFound =
                (!action.RouteOpportunityId.HasValue ||
                 selectedOpportunityId == action.RouteOpportunityId) &&
                (!action.RouteInteractionId.HasValue ||
                 selectedInteractionId == action.RouteInteractionId);
            agentChatContextAccessState = requestedSelectionFound
                ? AgentChatContextAccessState.Ready
                : AgentChatContextAccessState.Failed;
            return requestedSelectionFound;
        }
        catch (OperationCanceledException) when (loadCancellation.IsCancellationRequested)
        {
            return false;
        }
        catch when (!IsCurrentAccountRefresh(loadGeneration, action))
        {
            return false;
        }
        catch
        {
            agentChatContextAccessState = AgentChatContextAccessState.Failed;
            throw;
        }
        finally
        {
            Interlocked.CompareExchange(
                ref queryLoadCancellation,
                null,
                loadCancellation);
        }
    }

    private bool TryCaptureCrmAction(out CrmPageActionStamp action)
    {
        action = default;
        if (agentChatContextAccessState != AgentChatContextAccessState.Ready ||
            activeQueryLoadStamp is not CrmQueryLoadStamp loadStamp ||
            selectedAccount is not { } account ||
            !IsCurrentQueryLoad(loadStamp))
        {
            return false;
        }

        action = new CrmPageActionStamp(
            loadStamp,
            AccountIdQuery,
            OpportunityIdQuery,
            InteractionIdQuery,
            account.AccountPartyId,
            selectedOpportunityId,
            selectedInteractionId);
        return IsCurrentCrmAction(action);
    }

    private bool IsCurrentCrmAction(CrmPageActionStamp action)
        => IsCurrentQueryLoad(action.LoadStamp) &&
           AccountIdQuery == action.RouteAccountId &&
           OpportunityIdQuery == action.RouteOpportunityId &&
           InteractionIdQuery == action.RouteInteractionId &&
           selectedAccount?.AccountPartyId == action.AccountId &&
           selectedOpportunityId == action.SelectedOpportunityId &&
           selectedInteractionId == action.SelectedInteractionId;

    private bool IsCurrentAccountRefresh(
        CrmQueryLoadStamp loadStamp,
        CrmPageActionStamp action)
        => IsCurrentQueryLoad(loadStamp) &&
           AccountIdQuery == action.RouteAccountId &&
           OpportunityIdQuery == action.RouteOpportunityId &&
           InteractionIdQuery == action.RouteInteractionId &&
           selectedAccount?.AccountPartyId == action.AccountId &&
           selectedOpportunityId == action.SelectedOpportunityId &&
           selectedInteractionId == action.SelectedInteractionId;

    private async Task HandleCrmRecordTabChanged(int selectedIndex)
    {
        var requestedTab = (CrmRecordTab)selectedIndex;
        if (!Enum.IsDefined(requestedTab))
        {
            return;
        }

        selectedCrmRecordTab = requestedTab;
        if (requestedTab == CrmRecordTab.Interactions)
        {
            await EnsureAccountActivityLoadedAsync();
        }
    }

    // The account activity lane: the session owns the read, the accepted page, the busy gate and the fencing of
    // late outcomes; this page decides when the lane is asked for the selected account and renders its failure.
    private Task EnsureAccountActivityLoadedAsync()
        => selectedAccount is { } account
            ? accountActivity.EnsureLoadedAsync(account.AccountPartyId)
            : Task.CompletedTask;

    private Task HandleAccountActivityPageRequestedAsync(int pageIndex)
        => selectedAccount is { } account && accountActivity.Target == account.AccountPartyId
            ? accountActivity.RequestPageAsync(pageIndex)
            : Task.CompletedTask;

    private Task RetryAccountActivityAsync()
        => selectedAccount is { } account && accountActivity.Target == account.AccountPartyId
            ? accountActivity.RetryAsync()
            : Task.CompletedTask;

    private void InvalidateAccountActivity()
        => accountActivity.Invalidate();

    private void SelectCrmRecordTabForRoute(
        Guid accountPartyId,
        Guid? previousAccountPartyId,
        Guid? requestedOpportunityId,
        Guid? requestedInteractionId)
    {
        if (requestedOpportunityId.HasValue)
        {
            selectedCrmRecordTab = CrmRecordTab.Opportunities;
            return;
        }

        if (requestedInteractionId.HasValue)
        {
            selectedCrmRecordTab = CrmRecordTab.Interactions;
            return;
        }

        if (previousAccountPartyId != accountPartyId)
        {
            selectedCrmRecordTab = CrmRecordTab.Overview;
        }
    }

    private void ClearAccountSelection()
    {
        InvalidateAccountActivity();
        selectedAccount = null;
        selectedOpportunity = null;
        selectedInteraction = null;
        profileEditor = new();
        connectedRecordEditors = [];
        connectionPartyLabels.Clear();
        connectionPartyPickerIndex = null;
        interactionEditor = CreateInteractionEditor();
        opportunityEditor = new();
        opportunityConversionEditor = new();
        selectedOpportunityId = null;
        selectedInteractionId = null;
        isOpportunityCreateDialogOpen = false;
        isOpportunityDetailDialogOpen = false;
        isOpportunityEditDialogOpen = false;
        isOpportunityConversionDialogOpen = false;
        isAccountDialogOpen = false;
        selectedCrmRecordTab = CrmRecordTab.Overview;
        UpdateAgentChatContext();
    }

    private Task SelectAccountAsync(Guid accountPartyId)
    {
        if (AccountIdQuery == accountPartyId &&
            selectedAccount?.AccountPartyId == accountPartyId)
        {
            isAccountDialogOpen = true;
            return Task.CompletedTask;
        }

        InvalidateCurrentQueryForNavigation();
        Navigation.NavigateTo($"/crm-hr/crm?accountId={accountPartyId}");
        return Task.CompletedTask;
    }

    private Task CloseAccountDialogAsync()
    {
        if (!isAccountDialogOpen)
        {
            return Task.CompletedTask;
        }

        InvalidateCurrentQueryForNavigation();
        ClearAccountSelection();
        agentChatContextAccessState = AgentChatContextAccessState.Ready;
        Navigation.NavigateTo("/crm-hr/crm", replace: true);
        return Task.CompletedTask;
    }

    private void OpenDirectory()
    {
        if (selectedAccount is null)
        {
            Navigation.NavigateTo("/crm-hr/directory");
            return;
        }

        Navigation.NavigateTo($"/crm-hr/directory?partyId={selectedAccount.AccountPartyId}");
    }

    // Prerendered markup has no event handlers; OnAfterRender runs only for an interactive render, so the account
    // summary's actions become usable exactly when a browser click can reach this page.
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || isInteractive)
        {
            return;
        }

        isInteractive = true;
        StateHasChanged();
    }

    // The conversion is a mutation this page owns: it is admitted only for the account currently selected and only
    // while the page's query load is current, and the editor is changed only once the action was captured, so a
    // stale callback from a summary of a previous account neither saves nor leaves the form half-edited.
    private async Task MarkActiveCustomerAsync(Guid accountPartyId)
    {
        if (selectedAccount?.AccountPartyId != accountPartyId || !TryCaptureCrmAction(out var action))
        {
            return;
        }

        profileEditor.RelationshipStage = CrmAccountRelationshipStage.ActiveCustomer;
        await SaveAccountProfileAsync(action);
    }

    private async Task SaveAccountProfileAsync()
    {
        if (!TryCaptureCrmAction(out var action))
        {
            return;
        }

        await SaveAccountProfileAsync(action);
    }

    private async Task SaveAccountProfileAsync(CrmPageActionStamp action)
    {
        var result = await CrmService.SaveAccountProfileAsync(profileEditor);
        if (result.IsFailure)
        {
            if (IsCurrentCrmAction(action))
            {
                NotifyError("CRM account save failed", string.Join(" ", result.Errors.Select(error => error.Message)));
            }

            return;
        }

        if (!await ReloadSelectedAccountAsync(action, clearMessage: false))
        {
            return;
        }

        NotifySuccess("CRM account saved", "CRM account profile saved.");
    }

    private void AddConnectedRecord()
    {
        connectedRecordEditors.Add(new CrmAccountConnectionEditorModel());
        StateHasChanged();
    }

    private void RemoveConnectedRecord(int index)
    {
        if (index < 0 || index >= connectedRecordEditors.Count)
        {
            return;
        }

        connectedRecordEditors.RemoveAt(index);
        if (connectionPartyPickerIndex == index)
        {
            connectionPartyPickerIndex = null;
        }
        else if (connectionPartyPickerIndex > index)
        {
            connectionPartyPickerIndex--;
        }

        StateHasChanged();
    }

    private void OpenConnectionPartyPicker(int index)
    {
        if (index < 0 || index >= connectedRecordEditors.Count)
        {
            return;
        }

        connectionPartyPickerIndex = index;
    }

    private Task CloseConnectionPartyPickerAsync()
    {
        connectionPartyPickerIndex = null;
        return Task.CompletedTask;
    }

    private async Task ConfirmConnectionPartyAsync(Guid partyId)
    {
        if (connectionPartyPickerIndex is not int index ||
            index < 0 ||
            index >= connectedRecordEditors.Count)
        {
            connectionPartyPickerIndex = null;
            return;
        }

        if (!TryCaptureCrmAction(out var action))
        {
            connectionPartyPickerIndex = null;
            return;
        }

        var party = await PartyRecordQueryService.GetAsync(partyId);
        if (!IsCurrentCrmAction(action) ||
            connectionPartyPickerIndex != index ||
            index < 0 ||
            index >= connectedRecordEditors.Count)
        {
            return;
        }

        if (party is null)
        {
            connectionPartyPickerIndex = null;
            NotifyError(
                "Directory record unavailable",
                "The selected party no longer exists or is archived.");
            return;
        }

        connectedRecordEditors[index].RelatedPartyId = party.Id;
        connectionPartyLabels[party.Id] = $"{party.DisplayName} ({party.PartyType})";
        connectionPartyPickerIndex = null;
    }

    private void ClearConnectionParty(int index)
    {
        if (index < 0 || index >= connectedRecordEditors.Count)
        {
            return;
        }

        connectedRecordEditors[index].RelatedPartyId = Guid.Empty;
    }

    private void UpdateConnectedRecordProjects(
        int index,
        IReadOnlyList<Guid> projectIds)
    {
        if (index < 0 || index >= connectedRecordEditors.Count)
        {
            return;
        }

        connectedRecordEditors[index].ProjectIds = projectIds
            .Where(projectId => projectId != Guid.Empty)
            .Distinct()
            .ToList();
    }

    private string ResolveConnectionPartyLabel(Guid partyId)
    {
        if (partyId == Guid.Empty)
        {
            return "No directory record selected";
        }

        return connectionPartyLabels.GetValueOrDefault(partyId)
            ?? "Selected directory party";
    }

    private async Task SaveConnectedRecordsAsync()
    {
        if (!TryCaptureCrmAction(out var action))
        {
            return;
        }

        var result = await CrmService.SaveConnectedRecordsAsync(
            action.AccountId,
            connectedRecordEditors,
            profileEditor.LastChangedBy);
        if (result.IsFailure)
        {
            if (IsCurrentCrmAction(action))
            {
                NotifyError(
                    "Connected records save failed",
                    string.Join(" ", result.Errors.Select(error => error.Message)));
            }

            return;
        }

        if (!await ReloadSelectedAccountAsync(action, clearMessage: false))
        {
            return;
        }

        NotifySuccess("Connected records saved", "Company connections and related projects saved.");
    }

    private async Task SaveInteractionAsync()
    {
        if (!TryCaptureCrmAction(out var action))
        {
            return;
        }

        var result = await CrmService.AddInteractionAsync(
            action.AccountId,
            interactionEditor,
            profileEditor.LastChangedBy);
        if (result.IsFailure)
        {
            if (IsCurrentCrmAction(action))
            {
                NotifyError("Interaction save failed", string.Join(" ", result.Errors.Select(error => error.Message)));
            }

            return;
        }

        if (!await ReloadSelectedAccountAsync(action, clearMessage: false))
        {
            return;
        }

        NotifySuccess("Interaction saved", "CRM interaction saved.");
    }

    private Task SelectOpportunityAsync(Guid opportunityId)
    {
        if (selectedAccount is null)
        {
            return Task.CompletedTask;
        }

        InvalidateCurrentQueryForNavigation();
        Navigation.NavigateTo(
            $"/crm-hr/crm?accountId={selectedAccount.AccountPartyId:D}&opportunityId={opportunityId:D}");
        return Task.CompletedTask;
    }

    private async Task SaveOpportunityAsync(CrmOpportunityEditorModel model)
    {
        if (!TryCaptureCrmAction(out var action))
        {
            return;
        }

        var transientGeneration = Interlocked.Increment(ref transientStateGeneration);
        isOpportunityBusy = true;
        try
        {
            var editor = OpportunityEditorDrafts.Clone(model);
            editor.AccountPartyId = action.AccountId;
            editor.RelationshipStage = profileEditor.RelationshipStage.ToString();
            editor.LastChangedBy = profileEditor.LastChangedBy;

            var result = await CrmService.SaveOpportunityAsync(editor);
            if (result.IsFailure)
            {
                if (IsCurrentCrmAction(action))
                {
                    NotifyError(
                        "Opportunity save failed",
                        string.Join(" ", result.Errors.Select(error => error.Message)),
                        keepDialogMessage: true);
                }

                return;
            }

            if (!await ReloadSelectedAccountAsync(
                    action,
                    clearMessage: false,
                    preferredOpportunityId: result.Value))
            {
                return;
            }

            opportunityPipelineRefreshVersion++;
            isOpportunityCreateDialogOpen = false;
            isOpportunityEditDialogOpen = false;
            isOpportunityDetailDialogOpen = true;
            NotifySuccess("Opportunity saved", "Opportunity saved.");
        }
        finally
        {
            if (transientGeneration == Volatile.Read(ref transientStateGeneration))
            {
                isOpportunityBusy = false;
            }
        }
    }

    private async Task AdvanceOpportunityStageAsync(Guid opportunityId)
    {
        if (!TryCaptureCrmAction(out var action))
        {
            return;
        }

        var opportunity = await CrmService.GetOpportunityAsync(opportunityId);
        if (!IsCurrentCrmAction(action) ||
            opportunity is null ||
            opportunity.AccountPartyId != action.AccountId)
        {
            return;
        }

        var editor = OpportunityEditorDrafts.FromDetail(opportunity);
        editor.Stage = ResolveNextOpportunityStage(opportunity.Stage);
        editor.StageNotes = $"Advanced from {opportunity.Stage} to {editor.Stage}.";
        await SaveOpportunityAsync(editor);
    }


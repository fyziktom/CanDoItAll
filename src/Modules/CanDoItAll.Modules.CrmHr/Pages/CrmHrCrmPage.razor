            "The selected account was refreshed after the agent run completed.");
    }

    private static CrmOpportunityConversionEditorModel CreateOpportunityConversionEditor(
        CrmOpportunityDetailModel? opportunity,
        ProjectWriteAdmission? capturedLinkedProjectAdmission)
    {
        if (opportunity is null)
        {
            return new CrmOpportunityConversionEditorModel();
        }

        // The linked project is preselected only with the admission its load captured. A linked project that no
        // longer exists is not offered: the operator chooses a project in the picker instead.
        var linkedProjectAdmission = opportunity.LinkedProjectId is { } linkedProjectId &&
                                     capturedLinkedProjectAdmission?.ProjectId == linkedProjectId
            ? capturedLinkedProjectAdmission
            : null;
        return new CrmOpportunityConversionEditorModel
        {
            OpportunityId = opportunity.Id,
            ExpectedUpdatedAtUtc = opportunity.UpdatedAtUtc,
            LinkExistingProject = opportunity.LinkedProjectId.HasValue,
            ExistingProjectId = linkedProjectAdmission?.ProjectId,
            ExpectedProjectAdmission = linkedProjectAdmission,
            ProjectName = string.IsNullOrWhiteSpace(opportunity.LinkedProjectName)
                ? $"{opportunity.AccountDisplayName} - {opportunity.Title}"
                : opportunity.LinkedProjectName,
            ProjectDescription = opportunity.Summary,
            ProjectObjective = string.IsNullOrWhiteSpace(opportunity.Notes) ? opportunity.Title : opportunity.Notes,
            CurrentPhase = "Sales handoff"
        };
    }

    // An opportunity read together with the admission of its linked project, observed by the same load.
    private sealed record LoadedOpportunity(CrmOpportunityDetailModel Detail, ProjectWriteAdmission? LinkedProjectAdmission);

    private static CrmInteractionEditorModel CreateInteractionEditor(Guid? relatedOpportunityId = null)
    {
        return new CrmInteractionEditorModel
        {
            OccurredOn = DateOnly.FromDateTime(DateTime.UtcNow),
            RelatedOpportunityId = relatedOpportunityId
        };
    }

    private readonly record struct CrmPageActionStamp(
        CrmQueryLoadStamp LoadStamp,
        Guid? RouteAccountId,
        Guid? RouteOpportunityId,
        Guid? RouteInteractionId,
        Guid AccountId,
        Guid? SelectedOpportunityId,
        Guid? SelectedInteractionId);

    private bool AccountMutationInFlight => accountEditing.State.IsSaving || opportunityEditing.State.IsSaving || interactionAppend.IsSaving || connections.IsSaving || connections.PickerPending ||
        activeQueryLoadStamp is { } stamp && mutationGate.IsInFlight(stamp.Generation);

    private void ProfileInputChanged(AccountProfileField field) {
        accountEditing.State.InputChanged(field);
        MarkAccountInput();
    }

    private void MarkAccountInput() {
        hasAccountInput = true;
        accountInputRevision++;
    }

    private bool HasAccountChanges() => accountEditing.State.IsDirty(profileEditor) || accountEditing.State.Review is not null ||
        connections.IsDirty || interactionAppend.IsDirty ||
        isOpportunityCreateDialogOpen || isOpportunityEditDialogOpen || isOpportunityConversionDialogOpen;

    private Task<bool> RequestAccountLeaveAsync() {
        if (!HasAccountChanges() && !AccountMutationInFlight && !accountEditing.State.IsUnknown && !opportunityEditing.State.IsUnknown && !interactionAppend.IsUnknown && !connections.IsUnknown) {
            return Task.FromResult(true);
        }
        return (accountLeaveGuard ?? throw new InvalidOperationException("An active dirty account requires its leave guard.")).RequestLeaveAsync();
    }

    private bool IsSameAccountRoute(string target) {
        var destination = Navigation.ToAbsoluteUri(target);
        return destination.AbsolutePath == new Uri(Navigation.Uri).AbsolutePath &&
            CrmUrlCodec.Instance.Read(destination.AbsoluteUri).AccountId == url.State.AccountId;
    }

    private Task<bool> RequestOpportunityLeaveAsync() =>
        (opportunityLeaveGuard ?? throw new InvalidOperationException("The opportunity leave guard is unavailable.")).RequestLeaveAsync();

    private bool IsSameOpportunityRoute(string target) {
        if (!isOpportunityCreateDialogOpen && !isOpportunityEditDialogOpen) {
            return true;
        }
        var destination = Navigation.ToAbsoluteUri(target);
        var state = CrmUrlCodec.Instance.Read(destination.AbsoluteUri);
        return destination.AbsolutePath == new Uri(Navigation.Uri).AbsolutePath && state.AccountId == url.State.AccountId && state.OpportunityId == url.State.OpportunityId;
    }

    private void OpportunityInputChanged(long opening, OpportunityInput input) {
        if (opening != opportunityEditing.Opening) {
            return;
        }
        opportunityEditing.InputChanged(input);
        MarkAccountInput();
    }

    private void OpportunityPickerChanged(long opening, bool pending) {
        if (opening != opportunityEditing.Opening) {
            return;
        }
        opportunityEditing.State.ReportPicker(pending);
        MarkAccountInput();
    }

    private void ApplyProfileReview() {
        if (accountEditing.ReadingReview || !accountEditing.State.Apply(profileEditor)) {
            NotifyError("Comparison changed", "Refresh the comparison before applying it.");
        }
        MarkAccountInput();
    }

    private void UndoProfileMerge() {
        accountEditing.State.Undo(profileEditor);
        MarkAccountInput();
    }

    private void CancelProfileReview() => accountEditing.CancelReview();
    private void RefreshAccountCatalog() => accountCatalogVersion++;

    public async ValueTask DisposeAsync()
    {
        if (isDisposed)
        {
            return;
        }

        isDisposed = true;
        connectionReviewRead?.Cancel();
        queryLoadGeneration.Invalidate();
        activeQueryLoadStamp = null;
        Interlocked.Increment(ref transientStateGeneration);
        Interlocked.Exchange(ref queryLoadCancellation, null)?.Cancel();
        accountActivity.Dispose();
        await accountEditing.DisposeAsync();
        await accountRecords.DisposeAsync();
        await opportunityEditing.DisposeAsync();
        await conversionEditing.DisposeAsync();
    }
}

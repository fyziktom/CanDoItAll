        selectedAccount = null;
        selectedOpportunity = null;
        selectedOpportunityProjectAdmission = null;
        selectedInteraction = null;
        // Closing the record discards its drafts: the next record, or the same one reopened, starts from the owner.
        accountEditing.Clear();
        accountRecords.Clear();
        accountActivityOutdated = false;
        hasAccountInput = false;
        connections.Clear();
        connectionReviewRead?.Cancel();
        connectionsMessage = null;
        connectionProjectReads.Clear();
        connectionProjectPickerOpen = false;
        connectionPartyLabels.Clear();
        connectionProjectLabels.Clear();
        connectionPartyPickerIndex = null;
        interactionAppend.Open(Guid.Empty, CreateInteractionEditor());
        interactionMessage = null;
        opportunityEditing.Clear();
        stageOutcomeUnknown = false;
        conversionEditing.Clear();

    // Prerendered markup has no event handlers; OnAfterRender runs only for an interactive render, so the account
    // summary's actions become usable exactly when a browser click can reach this page.
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || isInteractive)
        {
            return;

    private void ApplyContextSelection(
        Guid? requestedOpportunityId,
        Guid? preferredOpportunityId,
        Guid? requestedInteractionId)
    {
        if (selectedAccount is null)
        {
            selectedOpportunity = null;
            selectedOpportunityId = null;
            selectedInteractionId = null;
            opportunityEditor = new();
            interactionEditor = CreateInteractionEditor();
            opportunityConversionEditor = new();
            isOpportunityCreateDialogOpen = false;
            isOpportunityDetailDialogOpen = false;
            isOpportunityEditDialogOpen = false;
            isOpportunityConversionDialogOpen = false;
            UpdateAgentChatContext();
            return;
        }

        selectedInteractionId = requestedInteractionId.HasValue &&
                                selectedInteraction?.Id == requestedInteractionId.Value
            ? requestedInteractionId
            : null;
        var targetOpportunityId = requestedOpportunityId ?? preferredOpportunityId;
        if (targetOpportunityId.HasValue &&
            (selectedOpportunity?.Id != targetOpportunityId.Value ||
             selectedOpportunity.AccountPartyId != selectedAccount.AccountPartyId))
        {
            targetOpportunityId = null;
            selectedOpportunity = null;
        }

        selectedOpportunityId = targetOpportunityId;
        opportunityEditor = SelectedOpportunity is null
            ? new CrmOpportunityEditorModel
            {
                AccountPartyId = selectedAccount.AccountPartyId,
                RelationshipStage = selectedAccount.Profile.RelationshipStage.ToString()
            }
            : OpportunityEditorDrafts.FromDetail(SelectedOpportunity);
        interactionEditor = CreateInteractionEditor(
            selectedOpportunityId ?? SelectedInteraction?.RelatedOpportunityId);
        opportunityConversionEditor = CreateOpportunityConversionEditor(SelectedOpportunity);
        isOpportunityDetailDialogOpen =
            requestedOpportunityId.HasValue &&
            SelectedOpportunity is not null;
        UpdateAgentChatContext();
    }

    private void UpdateAgentChatContext()
    {
        if (selectedAccount is null)
        {
            agentChatAccountContext = null;
            agentChatOpportunityContext = null;
            agentChatInteractionContext = null;
            return;
        }

        agentChatAccountContext = new CrmAgentChatAccountContext(
            selectedAccount.AccountPartyId,
            selectedAccount.DisplayName,
            selectedAccount.LifecycleStatus,
            selectedAccount.Profile.RelationshipStage,
            selectedAccount.Roles);
        var opportunity = SelectedOpportunity;
        agentChatOpportunityContext = opportunity is null
            ? null
            : new CrmAgentChatOpportunityContext(
                selectedAccount.AccountPartyId,
                opportunity.Id,
                opportunity.Title,
                opportunity.Stage,
                opportunity.OpportunitySource,
                opportunity.Parties.Select(party => party.Role));
        var interaction = SelectedInteraction;
        agentChatInteractionContext = interaction is null
            ? null
            : new CrmAgentChatInteractionContext(
                selectedAccount.AccountPartyId,
                interaction.Id,
                interaction.Subject,
                interaction.InteractionType,
                interaction.RelatedOpportunityId);
    }

    private bool IsCurrentQueryLoad(CrmQueryLoadStamp loadGeneration)
    {
        return !isDisposed &&
               queryLoadGeneration.IsCurrent(
                   loadGeneration,
                   BuildQueryKey(
                       AccountIdQuery,
                       OpportunityIdQuery,
                       InteractionIdQuery));
    }

    private void InvalidateCurrentQueryForNavigation()
    {
        queryLoadGeneration.Invalidate();
        activeQueryLoadStamp = null;
        Interlocked.Exchange(ref queryLoadCancellation, null)?.Cancel();
        Interlocked.Increment(ref transientStateGeneration);
        isOpportunityBusy = false;
        isOpportunityConversionBusy = false;
        isOpportunityCreateDialogOpen = false;
        isOpportunityDetailDialogOpen = false;
        isOpportunityEditDialogOpen = false;
        isOpportunityConversionDialogOpen = false;
        agentChatAccountContext = null;
        agentChatOpportunityContext = null;
        agentChatInteractionContext = null;
        agentChatContextAccessState = AgentChatContextAccessState.Loading;
    }

    private static string BuildQueryKey(
        Guid? accountId,
        Guid? opportunityId,
        Guid? interactionId)
        => $"{accountId?.ToString("N") ?? "none"}:" +
           $"{opportunityId?.ToString("N") ?? "none"}:" +
           $"{interactionId?.ToString("N") ?? "none"}";

    private void OpenAgentChats()
        => AgentChatLauncher.ShowCatalog();

    private async Task HandleAgentChatRefreshRequestedAsync(
        AgentChatExecutionCompleted notification)
    {
        if (!TryCaptureCrmAction(out var action) ||
            !await ReloadSelectedAccountAsync(action, clearMessage: false))
        {
            return;
        }

        NotifySuccess(
            "CRM refreshed",
            "The selected account was refreshed after the agent run completed.");
    }

    private static OpportunityStage ResolveNextOpportunityStage(OpportunityStage stage)
    {
        return stage switch
        {
            OpportunityStage.Identified => OpportunityStage.Qualified,
            OpportunityStage.Qualified => OpportunityStage.Proposal,
            OpportunityStage.Proposal => OpportunityStage.Negotiation,
            OpportunityStage.Negotiation => OpportunityStage.Won,
            _ => stage
        };
    }

    private static CrmOpportunityConversionEditorModel CreateOpportunityConversionEditor(CrmOpportunityDetailModel? opportunity)
    {
        if (opportunity is null)
        {
            return new CrmOpportunityConversionEditorModel();
        }

        return new CrmOpportunityConversionEditorModel
        {
            OpportunityId = opportunity.Id,
            ExpectedUpdatedAtUtc = opportunity.UpdatedAtUtc,
            LinkExistingProject = opportunity.LinkedProjectId.HasValue,
            ExistingProjectId = opportunity.LinkedProjectId,
            ProjectName = string.IsNullOrWhiteSpace(opportunity.LinkedProjectName)
                ? $"{opportunity.AccountDisplayName} - {opportunity.Title}"
                : opportunity.LinkedProjectName,
            ProjectDescription = opportunity.Summary,
            ProjectObjective = string.IsNullOrWhiteSpace(opportunity.Notes) ? opportunity.Title : opportunity.Notes,
            CurrentPhase = "Sales handoff"
        };
    }

    private static CrmInteractionEditorModel CreateInteractionEditor(Guid? relatedOpportunityId = null)
    {
        return new CrmInteractionEditorModel
        {
            OccurredOn = DateOnly.FromDateTime(DateTime.UtcNow),
            RelatedOpportunityId = relatedOpportunityId
        };
    }

    private static CrmOpportunityConversionEditorModel CloneOpportunityConversionEditor(
        CrmOpportunityConversionEditorModel source)
    {
        return new CrmOpportunityConversionEditorModel
        {
            OpportunityId = source.OpportunityId,
            ExpectedUpdatedAtUtc = source.ExpectedUpdatedAtUtc,
            LinkExistingProject = source.LinkExistingProject,
            ExistingProjectId = source.ExistingProjectId,
            ProjectName = source.ProjectName,
            ProjectDescription = source.ProjectDescription,
            ProjectObjective = source.ProjectObjective,
            CurrentPhase = source.CurrentPhase,
            LastChangedBy = source.LastChangedBy
        };
    }

    private enum CrmRecordTab
    {
        Overview,
        Financials,
        Stakeholders,
        Interactions,
        Opportunities
    }

    private readonly record struct CrmPageActionStamp(
        CrmQueryLoadStamp LoadStamp,
        Guid? RouteAccountId,
        Guid? RouteOpportunityId,
        Guid? RouteInteractionId,
        Guid AccountId,
        Guid? SelectedOpportunityId,
        Guid? SelectedInteractionId);

    public void Dispose()
    {
        if (isDisposed)
        {
            return;
        }

        isDisposed = true;
        queryLoadGeneration.Invalidate();
        activeQueryLoadStamp = null;
        Interlocked.Increment(ref transientStateGeneration);
        Interlocked.Exchange(ref queryLoadCancellation, null)?.Cancel();
    }
}

    private void ToggleInteractionParticipant(Guid partyId, ChangeEventArgs args)
    {
        var isSelected = bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
        if (isSelected)
        {
            if (!interactionEditor.ParticipantPartyIds.Contains(partyId))
            {
                interactionEditor.ParticipantPartyIds.Add(partyId);
            }

            return;
        }

        interactionEditor.ParticipantPartyIds.Remove(partyId);
    }

    private void ResetFilters()
    {
        searchText = string.Empty;
        stageFilter = string.Empty;
    }

    private void ResetOpportunityFilters()
    {
        opportunitySearchText = string.Empty;
        opportunityStageFilter = string.Empty;
        opportunityOwnerFilter = null;
        opportunityDeliveryUnitFilter = null;
        opportunityPartnerFilter = null;
        opportunitySourceFilter = string.Empty;
    }

    private bool MatchesSearch(CrmAccountListItemModel item)
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return true;
        }

        var normalizedSearch = searchText.Trim();
        return item.DisplayName.Contains(normalizedSearch, StringComparison.OrdinalIgnoreCase)
            || item.PrimaryEmail.Contains(normalizedSearch, StringComparison.OrdinalIgnoreCase)
            || item.PrimaryPhone.Contains(normalizedSearch, StringComparison.OrdinalIgnoreCase)
            || item.RelationshipStage.ToString().Contains(normalizedSearch, StringComparison.OrdinalIgnoreCase)
            || item.Roles.Any(role => role.ToString().Contains(normalizedSearch, StringComparison.OrdinalIgnoreCase));
    }

    private bool MatchesStage(CrmAccountListItemModel item)
    {
        return string.IsNullOrWhiteSpace(stageFilter)
            || string.Equals(item.RelationshipStage.ToString(), stageFilter, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesOpportunitySearch(CrmOpportunityDetailModel item)
    {
        if (string.IsNullOrWhiteSpace(opportunitySearchText))
        {
            return true;
        }

        var normalizedSearch = opportunitySearchText.Trim();
        return item.Title.Contains(normalizedSearch, StringComparison.OrdinalIgnoreCase)
            || item.OwnerDisplayName.Contains(normalizedSearch, StringComparison.OrdinalIgnoreCase)
            || item.DeliveryUnitDisplayName.Contains(normalizedSearch, StringComparison.OrdinalIgnoreCase)
            || item.Summary.Contains(normalizedSearch, StringComparison.OrdinalIgnoreCase)
            || item.Notes.Contains(normalizedSearch, StringComparison.OrdinalIgnoreCase)
            || item.Parties.Any(party => party.DisplayName.Contains(normalizedSearch, StringComparison.OrdinalIgnoreCase));
    }

    private bool MatchesOpportunityStage(CrmOpportunityDetailModel item)
    {
        return string.IsNullOrWhiteSpace(opportunityStageFilter)
            || string.Equals(item.Stage.ToString(), opportunityStageFilter, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesOpportunityOwner(CrmOpportunityDetailModel item)
    {
        return !opportunityOwnerFilter.HasValue || item.OwnerPartyId == opportunityOwnerFilter.Value;
    }

    private bool MatchesOpportunityDeliveryUnit(CrmOpportunityDetailModel item)
    {
        return !opportunityDeliveryUnitFilter.HasValue || item.DeliveryUnitPartyId == opportunityDeliveryUnitFilter.Value;
    }

    private bool MatchesOpportunityPartner(CrmOpportunityDetailModel item)
    {
        return !opportunityPartnerFilter.HasValue
            || item.Parties.Any(party =>
                party.Role == OpportunityPartyRole.Partner &&
                party.PartyId == opportunityPartnerFilter.Value);
    }

    private bool MatchesOpportunitySource(CrmOpportunityDetailModel item)
    {
        return string.IsNullOrWhiteSpace(opportunitySourceFilter)
            || string.Equals(item.OpportunitySource.ToString(), opportunitySourceFilter, StringComparison.OrdinalIgnoreCase);
    }

    private void NotifySuccess(string summary, string detail)
    {
        message = detail;
        messageTone = "success";
        NotificationService.Success(summary, detail);
    }

    private void NotifyWarning(string summary, string detail)
    {
        message = detail;
        messageTone = "danger";
        NotificationService.Warning(summary, detail);
    }

    private void NotifyError(string summary, string detail, bool keepDialogMessage = false)
    {
        if (keepDialogMessage || isOpportunityConversionDialogOpen)
        {
            message = detail;
            messageTone = "danger";
        }

        NotificationService.Error(summary, detail);
    }

    private static string BuildAccountMeta(CrmAccountListItemModel item)
    {
        var roleText = item.Roles.Count == 0 ? "No roles" : string.Join(", ", item.Roles);
        return $"{roleText} / {item.OpenOpportunityCount} open opportunity record(s)";
    }

    private static string BuildAccountSummary(CrmAccountListItemModel item)
    {
        if (!string.IsNullOrWhiteSpace(item.PrimaryEmail))
        {
            return item.PrimaryEmail;
        }

        if (!string.IsNullOrWhiteSpace(item.PrimaryPhone))
        {
            return item.PrimaryPhone;
        }

        return item.LastInteractionAtUtc.HasValue
            ? $"Last interaction {item.LastInteractionAtUtc.Value.LocalDateTime:g}"
            : "No interactions logged yet";
    }

    private static string ResolveStageTone(CrmAccountRelationshipStage stage)
    {
        return stage switch
        {
            CrmAccountRelationshipStage.ActiveCustomer => "success",
            CrmAccountRelationshipStage.Prospect => "info",
            CrmAccountRelationshipStage.DormantCustomer => "warning",
            CrmAccountRelationshipStage.LostCustomer => "danger",
            _ => "neutral"
        };
    }

    private void ApplyContextSelection(
        Guid? requestedOpportunityId,
        Guid? preferredOpportunityId,
        Guid? requestedInteractionId)
    {
        if (selectedAccount is null)
        {
            selectedOpportunityId = null;
            selectedInteractionId = null;
            opportunityEditor = CreateOpportunityEditor(null, null);
            interactionEditor = CreateInteractionEditor();
            opportunityConversionEditor = new();
            UpdateAgentChatContext();
            return;
        }

        selectedInteractionId = requestedInteractionId.HasValue &&
                                selectedAccount.Interactions.Any(item => item.Id == requestedInteractionId.Value)
            ? requestedInteractionId
            : null;
        var targetOpportunityId = requestedOpportunityId ?? preferredOpportunityId;
        if (targetOpportunityId.HasValue &&
            !selectedAccount.Opportunities.Any(item => item.Id == targetOpportunityId.Value))
        {
            targetOpportunityId = null;
        }

        if (!requestedOpportunityId.HasValue &&
            !requestedInteractionId.HasValue &&
            !targetOpportunityId.HasValue &&
            selectedAccount.Opportunities.Count > 0)
        {
            targetOpportunityId = selectedAccount.Opportunities[0].Id;
        }

        selectedOpportunityId = targetOpportunityId;
        opportunityEditor = CreateOpportunityEditor(selectedAccount, SelectedOpportunity);
        interactionEditor = CreateInteractionEditor(
            selectedOpportunityId ?? SelectedInteraction?.RelatedOpportunityId);
        opportunityConversionEditor = CreateOpportunityConversionEditor(SelectedOpportunity);
        UpdateAgentChatContext();
    }

    private void UpdateAgentChatContext()
    {
        if (selectedAccount is null)
        {
            agentChatAccountContext = null;
            agentChatOpportunityContext = null;
            agentChatInteractionContext = null;
            return;
        }

        agentChatAccountContext = new CrmAgentChatAccountContext(
            selectedAccount.AccountPartyId,
            selectedAccount.DisplayName,
            selectedAccount.LifecycleStatus,
            selectedAccount.Profile.RelationshipStage,
            selectedAccount.Roles);
        var opportunity = SelectedOpportunity;
        agentChatOpportunityContext = opportunity is null
            ? null
            : new CrmAgentChatOpportunityContext(
                selectedAccount.AccountPartyId,
                opportunity.Id,
                opportunity.Title,
                opportunity.Stage,
                opportunity.OpportunitySource,
                opportunity.Parties.Select(party => party.Role));
        var interaction = SelectedInteraction;
        agentChatInteractionContext = interaction is null
            ? null
            : new CrmAgentChatInteractionContext(
                selectedAccount.AccountPartyId,
                interaction.Id,
                interaction.Subject,
                interaction.InteractionType,
                interaction.RelatedOpportunityId);
    }

    private bool IsCurrentQueryLoad(CrmQueryLoadStamp loadGeneration)
    {
        return !isDisposed &&
               queryLoadGeneration.IsCurrent(
                   loadGeneration,
                   BuildQueryKey(
                       AccountIdQuery,
                       OpportunityIdQuery,
                       InteractionIdQuery));
    }

    private void InvalidateCurrentQueryForNavigation()
    {
        queryLoadGeneration.Invalidate();
        activeQueryLoadStamp = null;
        Interlocked.Exchange(ref queryLoadCancellation, null)?.Cancel();
        Interlocked.Increment(ref transientStateGeneration);
        isOpportunityBusy = false;
        isOpportunityConversionBusy = false;
        isOpportunityConversionDialogOpen = false;
        agentChatAccountContext = null;
        agentChatOpportunityContext = null;
        agentChatInteractionContext = null;
        agentChatContextAccessState = AgentChatContextAccessState.Loading;
    }

    private static string BuildQueryKey(
        Guid? accountId,
        Guid? opportunityId,
        Guid? interactionId)
        => $"{accountId?.ToString("N") ?? "none"}:" +
           $"{opportunityId?.ToString("N") ?? "none"}:" +
           $"{interactionId?.ToString("N") ?? "none"}";

    private void OpenAgentChats()
        => AgentChatLauncher.ShowCatalog();

    private async Task HandleAgentChatRefreshRequestedAsync(
        AgentChatExecutionCompleted notification)
    {
        if (!TryCaptureCrmAction(out var action) ||
            !await ReloadSelectedAccountAsync(action, clearMessage: false))
        {
            return;
        }

        NotifySuccess(
            "CRM refreshed",
            "The selected account was refreshed after the agent run completed.");
    }

    private PartyOptionModel ResolvePartyFilterOption(Guid id, string displayName, PartyType fallbackPartyType)
    {
        return OpportunityPartyOptions.FirstOrDefault(item => item.Id == id)
            ?? new PartyOptionModel(id, displayName, fallbackPartyType);
    }

    private static IReadOnlyList<PartyOptionModel> DistinctPartyOptions(IEnumerable<PartyOptionModel> options)
    {
        return options
            .GroupBy(item => item.Id)
            .Select(group => group.First())
            .OrderBy(item => item.DisplayName)
            .ToList();
    }

    private static OpportunityStage ResolveNextOpportunityStage(OpportunityStage stage)
    {
        return stage switch
        {
            OpportunityStage.Identified => OpportunityStage.Qualified,
            OpportunityStage.Qualified => OpportunityStage.Proposal,
            OpportunityStage.Proposal => OpportunityStage.Negotiation,
            OpportunityStage.Negotiation => OpportunityStage.Won,
            _ => stage
        };
    }

    private static CrmOpportunityEditorModel CreateOpportunityEditor(CrmAccountWorkspaceModel? account, CrmOpportunityDetailModel? opportunity)
    {
        if (opportunity is not null)
        {
            return new CrmOpportunityEditorModel
            {
                Id = opportunity.Id,
                AccountPartyId = opportunity.AccountPartyId,
                Title = opportunity.Title,
                Stage = opportunity.Stage,
                RelationshipStage = opportunity.RelationshipStage,
                OpportunitySource = opportunity.OpportunitySource,
                OwnerPartyId = opportunity.OwnerPartyId,
                DeliveryUnitPartyId = opportunity.DeliveryUnitPartyId,
                CurrencyCode = opportunity.CurrencyCode,
                Amount = opportunity.Amount,
                ProbabilityPercent = opportunity.ProbabilityPercent,
                ExpectedCloseOn = opportunity.ExpectedCloseOn,
                LostReason = opportunity.LostReason,
                CompetitorName = opportunity.CompetitorName,
                PartnerContributionSummary = opportunity.PartnerContributionSummary,
                Summary = opportunity.Summary,
                Notes = opportunity.Notes,
                LinkedProjectId = opportunity.LinkedProjectId,
                Parties = opportunity.Parties
                    .Select(item => new CrmOpportunityPartyLinkEditorModel
                    {
                        Id = item.Id,
                        PartyId = item.PartyId,
                        Role = item.Role
                    })
                    .ToList()
            };
        }

        return new CrmOpportunityEditorModel
        {
            AccountPartyId = account?.AccountPartyId ?? Guid.Empty,
            RelationshipStage = account?.Profile.RelationshipStage.ToString() ?? string.Empty,
            OwnerPartyId = account is null ? Guid.Empty : ResolveDefaultOwnerId(account)
        };
    }

    private static Guid ResolveDefaultOwnerId(CrmAccountWorkspaceModel account)
    {
        return account.AvailableParties
            .Where(item => item.PartyType is PartyType.Person or PartyType.OrganizationUnit or PartyType.AiAgent)
            .OrderBy(item => item.DisplayName)
            .Select(item => item.Id)
            .FirstOrDefault();
    }

    private static CrmOpportunityConversionEditorModel CreateOpportunityConversionEditor(CrmOpportunityDetailModel? opportunity)
    {
        if (opportunity is null)
        {
            return new CrmOpportunityConversionEditorModel();
        }

        return new CrmOpportunityConversionEditorModel
        {
            OpportunityId = opportunity.Id,
            LinkExistingProject = opportunity.LinkedProjectId.HasValue,
            ExistingProjectId = opportunity.LinkedProjectId,
            ProjectName = string.IsNullOrWhiteSpace(opportunity.LinkedProjectName)
                ? $"{opportunity.AccountDisplayName} - {opportunity.Title}"
                : opportunity.LinkedProjectName,
            ProjectDescription = opportunity.Summary,
            ProjectObjective = string.IsNullOrWhiteSpace(opportunity.Notes) ? opportunity.Title : opportunity.Notes,
            CurrentPhase = "Sales handoff"
        };
    }

    private static CrmInteractionEditorModel CreateInteractionEditor(Guid? relatedOpportunityId = null)
    {
        return new CrmInteractionEditorModel
        {
            OccurredOn = DateOnly.FromDateTime(DateTime.UtcNow),
            RelatedOpportunityId = relatedOpportunityId
        };
    }

    private readonly record struct CrmPageActionStamp(
        CrmQueryLoadStamp LoadStamp,
        Guid? RouteAccountId,
        Guid? RouteOpportunityId,
        Guid? RouteInteractionId,
        Guid AccountId,
        Guid? SelectedOpportunityId,
        Guid? SelectedInteractionId);

    public void Dispose()
    {
        if (isDisposed)
        {
            return;
        }

        isDisposed = true;
        queryLoadGeneration.Invalidate();
        activeQueryLoadStamp = null;
        Interlocked.Increment(ref transientStateGeneration);
        Interlocked.Exchange(ref queryLoadCancellation, null)?.Cancel();
    }
}

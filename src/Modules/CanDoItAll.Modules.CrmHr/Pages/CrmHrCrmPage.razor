@using static CanDoItAll.CrmHr.UI.Crm.CrmHrCrmWorkspacePresentation
@page "/crm-hr/crm"
@implements IAsyncDisposable
@using CanDoItAll.Editing
@using CanDoItAll.Infrastructure.Editing
@inject CrmHrChanges Changes
@inject EditingChangeFeed ChangeFeed
@inject IEditingUiAccess EditingAccess
@inject ILogger<EditingObservation> ObservationLog
@inject ILogger<AccountProfileEditor> ProfileLog
@inject ICrmOpportunityEditorService OpportunityOwner
@inject ILogger<OpportunityEditingSession> OpportunityLog
@inject ICrmOpportunityConversionService ConversionOwner
@inject ILogger<OpportunityConversionSession> ConversionLog
@using CanDoItAll.AgentFramework.Core
@using CanDoItAll.AgentFramework.Models
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Modules.Projects
@using Microsoft.Extensions.Logging
@inject CrmService CrmService
@inject ProjectWriteAdmissionService ProjectWriteAdmissions
@inject IPartyRecordQueryService PartyRecordQueryService
@inject IProjectRecordQueryService ConnectionProjectQuery
@inject IAgentChatLauncher AgentChatLauncher
@inject NavigationManager Navigation
@inject IAppNavigationHistory History
@inject NotificationService NotificationService
@inject ILogger<CrmHrCrmPage> Logger

<PageTitle>CRM / HR CRM</PageTitle>

<CrmAgentChatContextProvider AccountCount="accountCount"
                             Account="agentChatAccountContext"
                             Opportunity="agentChatOpportunityContext"
                             Interaction="agentChatInteractionContext"
                             ContextNavigationIdentity="@AgentChatNavigationFence"
                             ContextAccessState="@agentChatContextAccessState"
                             RefreshRequested="HandleAgentChatRefreshRequestedAsync" />

@{
    var opportunityOpening = opportunityEditing.Opening;
    var conversionOpening = opportunityConversion.Opening;
    var journalOpening = interactionAppend.Opening;
    var connectionOpening = connections.Opening;
}
<CrmHrLiveCatalog Owner="EditingOwner.CrmHrParty" Ignore="accountEditing.IsOwn" Changed="RefreshAccountCatalog">
<CrmHrLiveCatalog Owner="EditingOwner.CrmOpportunity" Changed="@(() => opportunityPipelineRefreshVersion++)">
<CrmHrCrmWorkspaceSurface View="this" CatalogRefreshVersion="@accountCatalogVersion" DirtyChanged="MarkAccountInput" ProfileInputChanged="ProfileInputChanged"
    OpportunityOpening="opportunityOpening" OpportunityInputChanged="@(input => OpportunityInputChanged(opportunityOpening, input))" OpportunityPickerChanged="@(pending => OpportunityPickerChanged(opportunityOpening, pending))"
    OpportunityProjectSelected="@(id => opportunityEditing.SelectProjectAsync(id, opportunityOpening))"
    ConversionOpening="opportunityConversion.Opening" ConversionSaveDisabled="@(!conversionEditing.CanSave)"
    ConversionBasis="opportunityConversion.Basis"
    ConversionInputChanged="@(() => opportunityConversion.Input(conversionOpening))"
    ConversionPickerChanged="@(pending => opportunityConversion.Picker(conversionOpening, pending))"
    ConversionProjectSelected="@(selection => ObserveConversionProjectAsync(selection.ProjectId, conversionOpening))"
    OpportunitySaveDisabled="@(opportunityEditing.ReadingReview || opportunityEditing.State.IsSaving || opportunityEditing.State.IsUnknown || opportunityEditing.State.IsOutdated || opportunityEditing.State.Missing || opportunityEditing.State.Review is not null)"
    ConnectionsInputChanged="@(input => ConnectionInputChanged(connectionOpening, input))" ConnectionsPickerChanged="@(pending => SetConnectionsProjectPicker(connectionOpening, pending))"
    ConnectionsProjectSelected="@(selection => SelectConnectionProjectsAsync(connectionOpening, selection))"
    ConnectionsValidationMessage="@connections.ValidationMessage" ConnectionsMessage="@connectionsMessage" ConnectionsSaveDisabled="@(!connections.CanSubmit)"
    ConnectionsMessageStyle="@(connections.IsOutdated || connections.IsUnknown ? AlertStyle.Warning : AlertStyle.Info)"
    InteractionInputChanged="@(() => JournalInputChanged(journalOpening))" InteractionMessage="@interactionMessage"
    InteractionSaveDisabled="@(!interactionAppend.CanSubmit)"
    InteractionOutcomeUnknown="interactionAppend.IsUnknown"
    ProfileSaveDisabled="@(accountEditing.ReadingReview || accountEditing.State.IsSaving || accountEditing.State.IsUnknown || accountEditing.State.IsOutdated || accountEditing.State.Review is not null)">
    <ProfileEditing>
        <AccountProfileEditing State="@accountEditing.State" Message="@accountEditing.Message" ReadingReview="@accountEditing.ReadingReview"
            ReviewRequested="accountEditing.ReviewAsync" ApplyRequested="ApplyProfileReview" UndoRequested="UndoProfileMerge" Cancelled="CancelProfileReview" Changed="StateHasChanged" />
    </ProfileEditing>
    <ConnectionsEditing>
        <ConnectionEditing State="connections" PartyNames="connectionPartyLabels" ProjectNames="connectionProjectLabels"
            ReviewRequested="ReviewConnectionsAsync" ApplyRequested="ApplyConnectionsReviewAsync" UndoRequested="connections.Undo"
            Cancelled="CancelConnectionsReview" Changed="StateHasChanged" />
    </ConnectionsEditing>
    <OpportunityEditing>
        <OpportunityEditing State="opportunityEditing.State" Message="@opportunityEditing.Message" ReadingReview="opportunityEditing.ReadingReview"
            PartyNames="opportunityEditing.PartyNames" ProjectNames="opportunityEditing.ProjectNames"
            ReviewRequested="opportunityEditing.ReviewAsync" ApplyRequested="opportunityEditing.ApplyReview" UndoRequested="opportunityEditing.Undo"
            Cancelled="opportunityEditing.CancelReview" Changed="StateHasChanged" />
    </OpportunityEditing>
    <ConversionEditing>
        <OpportunityConversionEditing State="opportunityConversion" Reading="conversionEditing.Reading" Message="@conversionEditing.Message" RecoveryProject="conversionEditing.RecoveryProject"
            ReviewRequested="conversionEditing.ReviewAsync" ApplyRequested="conversionEditing.ApplyReviewAsync"
            Cancelled="CancelConversionReview" />
    </ConversionEditing>
    <EditorOverlays>
        <CrmHrEditorLeaveGuard @ref="accountLeaveGuard" TestIdPrefix="crmhr-account" HasLocalChanges="HasAccountChanges" IsSameEditorRoute="IsSameAccountRoute"
            InputRevision="@accountInputRevision" HasInput="@hasAccountInput" IsBusy="@(() => AccountMutationInFlight)" Unknown="@(accountEditing.State.IsUnknown || opportunityEditing.State.IsUnknown || opportunityConversion.IsUnknown || interactionAppend.IsUnknown || connections.IsUnknown)" />
        <CrmHrEditorLeaveGuard @ref="opportunityLeaveGuard" TestIdPrefix="crmhr-opportunity" HasLocalChanges="@(() => opportunityEditing.State.IsDirty || opportunityEditing.State.Review is not null)"
            IsSameEditorRoute="IsSameOpportunityRoute" Opening="opportunityEditing.Opening" InputRevision="opportunityEditing.State.InputRevision" HasInput="@(opportunityEditing.State.IsDirty)"
            IsBusy="@(() => opportunityEditing.State.IsSaving)" Unknown="opportunityEditing.State.IsUnknown" />
        <CrmHrEditorLeaveGuard @ref="conversionLeaveGuard" TestIdPrefix="crmhr-conversion"
            HasLocalChanges="@(() => opportunityConversion.HasChanges || opportunityConversion.Review is not null)" IsSameEditorRoute="IsSameOpportunityRoute"
            Opening="opportunityConversion.Opening" InputRevision="opportunityConversion.InputRevision" HasInput="@(opportunityConversion.HasChanges)"
            IsBusy="@(() => opportunityConversion.IsSaving || opportunityConversion.PickerPending)" Unknown="opportunityConversion.IsUnknown" />
    </EditorOverlays>
    <SecondaryNavigation>
        <CrmHrSecondaryTabs SelectedArea="CrmHrWorkspaceArea.Crm" />
    </SecondaryNavigation>
    <AccountSummary>
        <AccountSummaryPanel Account="selectedAccount"
                             OpenDirectory="OpenDirectory"
                             MarkActiveCustomer="MarkActiveCustomerAsync"
                             IsInteractive="@isInteractive" />
    </AccountSummary>
    <Financials>
        @if (selectedAccount is { } financialsAccount)
        {
            <CrmFinancialsPanel AccountPartyId="@financialsAccount.AccountPartyId" />
        }
    </Financials>
    <ActivityTimeline>
        <InteractionTimeline Presentation="@AccountActivityPresentation"
                             PageRequested="HandleAccountActivityPageRequestedAsync"
                             DataTestId="crmhr-account-activity" />
    </ActivityTimeline>
</CrmHrCrmWorkspaceSurface>
</CrmHrLiveCatalog>
</CrmHrLiveCatalog>

@code {
    // The database profile that project admissions captured on this page are bound to.
    private Guid ProjectDatabaseProfileId => ProjectWriteAdmissions.DatabaseProfileId;

    // What the history lane accepted for the selected account, and its failure copy; the surface never sees the session.
    private CrmHrActivityPresentation AccountActivityPresentation => accountActivity.Presentation;

    private string? AccountActivityFailureMessage => accountActivity.FailureMessage;

    // Triggers only: the binding reads the complete location, so these values are never parsed here.
    [SupplyParameterFromQuery(Name = CrmUrlCodec.AccountKey)]
    public string? AccountIdQuery { get; set; }

    [SupplyParameterFromQuery(Name = CrmUrlCodec.OpportunityKey)]
    public string? OpportunityIdQuery { get; set; }

    [SupplyParameterFromQuery(Name = CrmUrlCodec.InteractionKey)]
    public string? InteractionIdQuery { get; set; }

    [SupplyParameterFromQuery(Name = CrmUrlCodec.SectionKey)]
    public string? SectionQuery { get; set; }

    [SupplyParameterFromQuery(Name = CrmUrlCodec.SearchKey)]
    public string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = CrmUrlCodec.TagsKey)]
    public string? TagsQuery { get; set; }

    [SupplyParameterFromQuery(Name = CrmUrlCodec.PageKey)]
    public string? PageQuery { get; set; }

    private UrlStateBinding<CrmUrlState> url = default!;
    private readonly Dictionary<Guid, string> connectionPartyLabels = [];
    private readonly Dictionary<Guid, string> connectionProjectLabels = [];
    private CancellationTokenSource? connectionReviewRead;
    private CrmAccountWorkspaceModel? selectedAccount;
    private CrmInteractionDetailModel? selectedInteraction;
    private CrmOpportunityDetailModel? selectedOpportunity;
    // The linked project of the selected opportunity, bound to the incarnation the same load observed.
    private ProjectWriteAdmission? selectedOpportunityProjectAdmission;
    private CrmHrActivityHistorySession accountActivity = default!;
    private AccountProfileEditor accountEditing = default!;
    private CrmAccountRecordsObservation accountRecords = default!;
    private bool accountActivityOutdated;
    private CrmAccountProfileEditorModel profileEditor => accountEditing.Draft;
    private CrmHrEditorLeaveGuard? accountLeaveGuard;
    private long accountInputRevision;
    private bool hasAccountInput;
    private long accountCatalogVersion;
    private readonly ConnectionReconciliation connections = new();
    private List<CrmAccountConnectionEditorModel> connectedRecordEditors => connections.Draft;
    private string? connectionsMessage;
    private readonly Dictionary<Guid, Guid> connectionProjectReads = [];
    private bool connectionProjectPickerOpen;
    private readonly InteractionAppendState interactionAppend = new();
    private CrmInteractionEditorModel interactionEditor => interactionAppend.Draft;
    private string? interactionMessage;
    private OpportunityEditingSession opportunityEditing = default!;
    private CrmHrEditorLeaveGuard? opportunityLeaveGuard;
    private CrmOpportunityEditorModel opportunityEditor => opportunityEditing.Draft;
    private OpportunityConversionSession conversionEditing = default!;
    private OpportunityConversionState opportunityConversion => conversionEditing.State;
    private CrmOpportunityConversionEditorModel opportunityConversionEditor => opportunityConversion.Draft;
    private CrmHrEditorLeaveGuard? conversionLeaveGuard;
    private CrmAgentChatAccountContext? agentChatAccountContext;
    private CrmAgentChatOpportunityContext? agentChatOpportunityContext;
    private CrmAgentChatInteractionContext? agentChatInteractionContext;
    private AgentChatContextAccessState agentChatContextAccessState = AgentChatContextAccessState.Loading;
    private int accountCount;
    private Guid? selectedOpportunityId;
    private Guid? selectedInteractionId;
    private int? connectionPartyPickerIndex;
    private string? committedQueryKey;
    private readonly CrmQueryLoadGeneration queryLoadGeneration = new();
    private CrmQueryLoadStamp? activeQueryLoadStamp;
    private readonly CrmHrMutationGate mutationGate = new();
    private CancellationTokenSource? queryLoadCancellation;
    private long transientStateGeneration;
    private string? message;
    private long opportunityPipelineRefreshVersion;
    private bool isOpportunityBusy;
    private bool stageOutcomeUnknown;
    private bool isOpportunityCreateDialogOpen;
    private bool isOpportunityDetailDialogOpen;
    private bool isOpportunityEditDialogOpen;
    private bool isOpportunityConversionDialogOpen;
    private bool isAccountDialogOpen;
    private bool isOpportunityConversionBusy => opportunityConversion.IsSaving;
    private bool isInteractive;
    private bool isDisposed;

    // The account section is navigation state: the tab index is only its rendering.
    private int SelectedCrmRecordTabIndex => (int)url.State.Section;

    private PagedRecordQueryState<PartyRecordScope> CatalogQuery => url.State.Catalog.ToQuery();

    private IReadOnlyList<PartyOptionModel> ParticipantOptions
        => selectedAccount is null
            ? []
            : selectedAccount.ConnectedParties
                .Where(option => connectedRecordEditors.Any(connection => connection.RelatedPartyId == option.Id))
                .ToList();

    private CrmOpportunityDetailModel? SelectedOpportunity
        => selectedOpportunity?.Id == selectedOpportunityId
            ? selectedOpportunity
            : null;

    private Guid? SelectedConnectionPartyId
        => connectionPartyPickerIndex is int index &&
           index >= 0 &&
           index < connectedRecordEditors.Count &&
           connectedRecordEditors[index].RelatedPartyId != Guid.Empty
            ? connectedRecordEditors[index].RelatedPartyId
            : null;

    private CrmInteractionDetailModel? SelectedInteraction
        => selectedInteraction?.Id == selectedInteractionId
            ? selectedInteraction
            : null;

    private AgentChatNavigationIdentity AgentChatNavigationFence
        => CrmHrNavigationFence.Create(Navigation, url);

    protected override void OnInitialized()
    {
        conversionEditing = new(ConversionOwner, Changes, ChangeFeed, EditingAccess, ObservationLog, ConversionLog) {
            Dispatch = work => InvokeAsync(work),
            Changed = () => {
                if (isOpportunityConversionDialogOpen && conversionEditing.Message is not null) {
                    message = conversionEditing.Message;
                }
                StateHasChanged();
            },
            Retired = () => isOpportunityConversionDialogOpen = false,
            Notice = notice => {
                message = notice.Message;
                if (notice.Kind == OpportunityConversionNoticeKind.Error) {
                    NotificationService.Error(notice.Title, notice.Message);
                } else {
                    NotificationService.Warning(notice.Title, notice.Message);
                }
            }
        };
        accountEditing = new(CrmService, Changes, ChangeFeed, EditingAccess, ObservationLog, ProfileLog) {
            Dispatch = work => InvokeAsync(work),
            Changed = StateHasChanged,
            Retired = () => {
                ClearAccountSelection();
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
                NotifyError("CRM editing access changed", "Reopen this account with current access.");
            },
            Notice = () => NotificationService.Warning("Account changed", "Another editor changed this account. Your draft is retained; review the saved profile before saving.")
        };
        opportunityEditing = new(OpportunityOwner, ProjectWriteAdmissions.CaptureAsync, Changes, ChangeFeed, EditingAccess, ObservationLog, OpportunityLog) {
            Dispatch = work => InvokeAsync(work), Changed = StateHasChanged,
            Retired = () => {
                isOpportunityCreateDialogOpen = false;
                isOpportunityEditDialogOpen = false;
                NotifyError("Opportunity access changed", "Reopen the opportunity with current access.");
            },
            Notice = () => NotificationService.Warning("Opportunity changed", "Your draft is retained. Review the saved changes before saving.")
        };
        accountRecords = new(Changes, ChangeFeed, EditingAccess, ObservationLog) {
            Dispatch = work => InvokeAsync(work), Changed = StateHasChanged,
            ConnectionsChanged = () => {
                if (connections.AccountPartyId == accountRecords.AccountId) {
                    connections.Hint();
                }
            },
            ActivityChanged = RefreshObservedAccountActivityAsync,
            Retired = () => {
                ClearAccountSelection();
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
                NotifyError("Account records access changed", "Reopen this account with current access.");
            }
        };
        url = new UrlStateBinding<CrmUrlState>(Navigation, CrmUrlCodec.Instance, History, typeof(CrmHrCrmPage));
        accountActivity = new CrmHrActivityHistorySession(
            (query, cancellationToken) => CrmService.SearchAccountActivityAsync(query, cancellationToken),
            initialFailureMessage: "Account activity could not be loaded.",
            pageFailureMessage: "The requested account activity page could not be loaded.",
            Logger);
    }

    // Every location reaches the same instance: a pasted link, Back, Forward and this page's own intents arriving.
    // A different account, opportunity or interaction loads the route; another section of the open account loads
    // only that section's lazy data; a catalog query belongs to the catalog, which loads it itself.
    protected override async Task OnParametersSetAsync()
    {
        var change = url.Apply(canonicalize: RendererInfo.IsInteractive);
        if (!change.IsChanged)
        {
            return;
        }

        if (change.IsInitial || IsOtherRecord(change.Previous, change.Current))
        {
            await LoadRouteAsync(change.Current);
            return;
        }

        if (change.Previous.Section != change.Current.Section &&
            change.Current.Section == CrmSection.Interactions &&
            isAccountDialogOpen)
        {
            await EnsureAccountActivityLoadedAsync();
        }
    }

    private static bool IsOtherRecord(CrmUrlState previous, CrmUrlState current)
        => previous.AccountId != current.AccountId ||
           previous.OpportunityId != current.OpportunityId ||
           previous.InteractionId != current.InteractionId;

    // Applies one location: the account an opportunity or interaction names is resolved, loaded with the requested
    // opportunity and interaction and opened. An explicit identity that resolves to nothing never opens another
    // record. The selected opportunity is the one the location names or its interaction relates to, nothing else.
    private async Task LoadRouteAsync(CrmUrlState route)
    {
        var requestedAccountId = route.AccountId;
        var requestedOpportunityId = route.OpportunityId;
        var requestedInteractionId = route.InteractionId;
        var queryKey = BuildQueryKey(
            requestedAccountId,
            requestedOpportunityId,
            requestedInteractionId);
        if (requestedAccountId is null || selectedAccount?.AccountPartyId != requestedAccountId)
        {
            isAccountDialogOpen = false;
        }

        var loadGeneration = BeginQueryLoad(queryKey, resetTransientState: true);
        using var loadCancellation = new CancellationTokenSource();
        var supersededLoad = Interlocked.Exchange(ref queryLoadCancellation, loadCancellation);
        supersededLoad?.Cancel();
        try
        {
            if (committedQueryKey is not null &&
                !string.Equals(committedQueryKey, queryKey, StringComparison.Ordinal))
            {
                agentChatAccountContext = null;
                agentChatOpportunityContext = null;
                agentChatInteractionContext = null;
                await InvokeAsync(StateHasChanged);
            }

            await accountEditing.AuthorizeCatalogReadAsync(loadCancellation.Token);
            var accountCountTask = CrmService.CountAccountsAsync(loadCancellation.Token);
            var routeResolutionTask = CrmService.ResolveRouteSelectionAsync(
                requestedAccountId,
                requestedOpportunityId,
                requestedInteractionId,
                loadCancellation.Token);
            await Task.WhenAll(accountCountTask, routeResolutionTask);
            accountCount = await accountCountTask;
            var routeResolution = await routeResolutionTask;
            if (!IsCurrentQueryLoad(loadGeneration))
            {
                return;
            }

            committedQueryKey = queryKey;
            if (!routeResolution.IsResolved)
            {
                ClearAccountSelection();
                message = null;
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
                NotifyRouteRecordUnavailable();
                return;
            }

            var targetId = routeResolution.AccountPartyId;
            CrmAccountWorkspaceModel? account = null;
            AccountProfileRead? profileRead = null;
            long? recordsRevision = null;
            if (targetId.HasValue)
            {
                var read = await ReadAccountWorkspaceAsync(targetId.Value, loadCancellation.Token);
                profileRead = read.Profile;
                recordsRevision = read.ConnectionsRevision;
                account = profileRead.Workspace;
                if (!IsCurrentQueryLoad(loadGeneration))
                {
                    return;
                }
            }

            if (account is null)
            {
                if (targetId.HasValue && selectedAccount?.AccountPartyId == targetId) {
                    accountEditing.Missing();
                    return;
                }
                ClearAccountSelection();
                message = null;
                agentChatContextAccessState = route.HasAccountContext
                    ? AgentChatContextAccessState.Failed
                    : AgentChatContextAccessState.Ready;
                if (route.HasAccountContext)
                {
                    NotifyRouteRecordUnavailable();
                }

                return;
            }

            var interaction = requestedInteractionId.HasValue
                ? await CrmService.GetAccountInteractionAsync(
                    account.AccountPartyId,
                    requestedInteractionId.Value,
                    loadCancellation.Token)
                : null;
            if (!IsCurrentQueryLoad(loadGeneration))
            {
                return;
            }

            var relatedInteractionOpportunityId = interaction?.RelatedOpportunityId;
            var preferredOpportunityId = requestedOpportunityId ?? relatedInteractionOpportunityId;
            var opportunity = await LoadOpportunityForAccountAsync(
                preferredOpportunityId,
                account.AccountPartyId,
                loadCancellation.Token);
            if (!IsCurrentQueryLoad(loadGeneration))
            {
                return;
            }

            ApplyLoadedAccount(
                account,
                profileRead!,
                opportunity,
                interaction,
                clearMessage: true,
                requestedOpportunityId,
                preferredOpportunityId,
                requestedInteractionId, connectionsRevision: recordsRevision);
            isAccountDialogOpen = true;
            if (url.State.Section == CrmSection.Interactions)
            {
                await EnsureAccountActivityLoadedAsync();
            }
            var requestedSelectionFound =
                (!requestedOpportunityId.HasValue ||
                 selectedOpportunityId == requestedOpportunityId) &&
                (!requestedInteractionId.HasValue ||
                 selectedInteractionId == requestedInteractionId);
            agentChatContextAccessState = requestedSelectionFound
                ? AgentChatContextAccessState.Ready
                : AgentChatContextAccessState.Failed;
            if (!requestedSelectionFound)
            {
                NotifyRouteRecordUnavailable();
            }
        }
        catch (UnauthorizedAccessException)
        {
            ClearAccountSelection();
            agentChatContextAccessState = AgentChatContextAccessState.Failed;
            NotifyError("CRM access required", "Open this account with current CRM editing access.");
        }
        catch (OperationCanceledException) when (loadCancellation.IsCancellationRequested)
        {
        }
        catch when (!IsCurrentQueryLoad(loadGeneration))
        {
        }
        catch
        {
            agentChatContextAccessState = AgentChatContextAccessState.Failed;
            throw;
        }
        finally
        {
            Interlocked.CompareExchange(
                ref queryLoadCancellation,
                null,
                loadCancellation);
        }
    }

    private CrmQueryLoadStamp BeginQueryLoad(string queryKey, bool resetTransientState)
    {
        if (resetTransientState)
        {
            opportunityEditing.Clear();
            Interlocked.Increment(ref transientStateGeneration);
            isOpportunityBusy = false;
            conversionEditing.Clear();
            isOpportunityCreateDialogOpen = false;
            isOpportunityDetailDialogOpen = false;
            isOpportunityEditDialogOpen = false;
            isOpportunityConversionDialogOpen = false;
        }

        agentChatContextAccessState = AgentChatContextAccessState.Loading;
        var stamp = queryLoadGeneration.Begin(queryKey);
        activeQueryLoadStamp = stamp;
        return stamp;
    }

    private async Task<LoadedOpportunity?> LoadOpportunityForAccountAsync(
        Guid? opportunityId,
        Guid accountPartyId,
        CancellationToken cancellationToken)
    {
        if (!opportunityId.HasValue)
        {
            return null;
        }

        var opportunity = await CrmService.GetOpportunityAsync(
            opportunityId.Value,
            cancellationToken);
        if (opportunity?.AccountPartyId != accountPartyId)
        {
            return null;
        }

        // A conversion that links the already linked project writes against the project incarnation this load
        // observed. A project retired or recreated since is rejected by the owner; it is never rebound on save.
        var linkedProjectAdmission = opportunity.LinkedProjectId is { } linkedProjectId
            ? await ProjectWriteAdmissions.CaptureAsync(linkedProjectId, cancellationToken)
            : null;
        return new LoadedOpportunity(opportunity, linkedProjectAdmission);
    }

    private void ApplyLoadedAccount(
        CrmAccountWorkspaceModel account,
        AccountProfileRead profileRead,
        LoadedOpportunity? opportunity,
        CrmInteractionDetailModel? interaction,
        bool clearMessage,
        Guid? requestedOpportunityId,
        Guid? preferredOpportunityId,
        Guid? requestedInteractionId,
        long? connectionsRevision = null)
    {
        InvalidateAccountActivity();
        // A reload of the account already on screen (an opportunity or interaction selected in the route, another
        // editor's commit, an agent refresh) keeps what the operator typed into the editors it did not commit.
        var accountChanged = selectedAccount?.AccountPartyId != account.AccountPartyId;
        selectedAccount = account;
        selectedOpportunity = opportunity?.Detail;
        selectedOpportunityProjectAdmission = opportunity?.LinkedProjectAdmission;
        selectedInteraction = interaction;
        accountEditing.Observe(profileRead);
        connections.Observe(account);
        if (connectionsRevision.HasValue && connectionsRevision != accountRecords.ConnectionRevision) {
            connections.Hint();
        }
        if (accountChanged) {
            connectionReviewRead?.Cancel();
            connectionPartyLabels.Clear();
            connectionProjectLabels.Clear();
            connectionPartyPickerIndex = null;
            connectionProjectReads.Clear();
            connectionProjectPickerOpen = false;
            connectionsMessage = null;
        }

        foreach (var connection in account.ConnectedRecords)
        {
            connectionPartyLabels[connection.RelatedPartyId] =
                $"{connection.DisplayName} ({connection.PartyType})";
            foreach (var project in connection.Projects) {
                connectionProjectLabels[project.Id] = project.Name;
            }
        }

        ApplyContextSelection(
            requestedOpportunityId,
            preferredOpportunityId,
            requestedInteractionId,
            accountChanged);

        if (clearMessage)
        {
            message = null;
        }
    }

    private async Task<bool> ReloadSelectedAccountAsync(
        CrmPageActionStamp action,
        bool clearMessage,
        Guid? preferredOpportunityId = null)
    {
        if (!IsCurrentCrmAction(action))
        {
            return false;
        }

        var queryKey = BuildQueryKey(
            action.RouteAccountId,
            action.RouteOpportunityId,
            action.RouteInteractionId);
        var loadGeneration = BeginQueryLoad(queryKey, resetTransientState: false);
        using var loadCancellation = new CancellationTokenSource();
        var supersededLoad = Interlocked.Exchange(ref queryLoadCancellation, loadCancellation);
        supersededLoad?.Cancel();
        try
        {
            var recordsRead = await ReadAccountWorkspaceAsync(action.AccountId, loadCancellation.Token);
            var profileRead = recordsRead.Profile;
            var account = profileRead.Workspace;
            if (!IsCurrentAccountRefresh(loadGeneration, action))
            {
                return false;
            }

            committedQueryKey = queryKey;
            if (account is null)
            {
                accountEditing.Missing();
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
                return false;
            }

            var targetOpportunityId = preferredOpportunityId ??
                                      action.SelectedOpportunityId ??
                                      action.RouteOpportunityId;
            var opportunity = await LoadOpportunityForAccountAsync(
                targetOpportunityId,
                account.AccountPartyId,
                loadCancellation.Token);
            if (!IsCurrentAccountRefresh(loadGeneration, action))
            {
                return false;
            }

            var interaction = action.RouteInteractionId.HasValue
                ? await CrmService.GetAccountInteractionAsync(
                    account.AccountPartyId,
                    action.RouteInteractionId.Value,
                    loadCancellation.Token)
                : null;
            if (!IsCurrentAccountRefresh(loadGeneration, action))
            {
                return false;
            }

            ApplyLoadedAccount(
                account,
                profileRead,
                opportunity,
                interaction,
                clearMessage,
                action.RouteOpportunityId,
                preferredOpportunityId ?? action.SelectedOpportunityId,
                action.RouteInteractionId,
                recordsRead.ConnectionsRevision);
            if (url.State.Section == CrmSection.Interactions)
            {
                await EnsureAccountActivityLoadedAsync();
            }
            var requestedSelectionFound =
                (!action.RouteOpportunityId.HasValue ||
                 selectedOpportunityId == action.RouteOpportunityId) &&
                (!action.RouteInteractionId.HasValue ||
                 selectedInteractionId == action.RouteInteractionId);
            agentChatContextAccessState = requestedSelectionFound
                ? AgentChatContextAccessState.Ready
                : AgentChatContextAccessState.Failed;
            return requestedSelectionFound;
        }
        catch (UnauthorizedAccessException)
        {
            ClearAccountSelection();
            agentChatContextAccessState = AgentChatContextAccessState.Failed;
            NotifyError("CRM access required", "Reopen this account with current CRM editing access.");
            return false;
        }
        catch (OperationCanceledException) when (loadCancellation.IsCancellationRequested)
        {
            return false;
        }
        catch when (!IsCurrentAccountRefresh(loadGeneration, action))
        {
            return false;
        }
        catch (Exception exception)
        {
            // Every caller refreshes after an owner already committed (a save, a conversion, an agent run). A failed
            // read-back is a warning: it never repeats a write, and the operator can reload to reconcile the view.
            agentChatContextAccessState = AgentChatContextAccessState.Failed;
            Logger.LogWarning(exception, "The CRM account {AccountId} could not be refreshed after a committed change.", action.AccountId);
            NotificationService.Warning(
                "Refresh failed",
                "The change was kept by its owner, but the account could not be refreshed. Reload the page to see the current state.");
            return false;
        }
        finally
        {
            Interlocked.CompareExchange(
                ref queryLoadCancellation,
                null,
                loadCancellation);
        }
    }

    private bool TryCaptureCrmAction(out CrmPageActionStamp action)
    {
        action = default;
        if (agentChatContextAccessState != AgentChatContextAccessState.Ready ||
            activeQueryLoadStamp is not CrmQueryLoadStamp loadStamp ||
            selectedAccount is not { } account ||
            !IsCurrentQueryLoad(loadStamp))
        {
            return false;
        }

        action = new CrmPageActionStamp(
            loadStamp,
            url.State.AccountId,
            url.State.OpportunityId,
            url.State.InteractionId,
            account.AccountPartyId,
            selectedOpportunityId,
            selectedInteractionId);
        return IsCurrentCrmAction(action);
    }

    private bool IsCurrentCrmAction(CrmPageActionStamp action)
        => IsCurrentQueryLoad(action.LoadStamp) &&
           url.State.AccountId == action.RouteAccountId &&
           url.State.OpportunityId == action.RouteOpportunityId &&
           url.State.InteractionId == action.RouteInteractionId &&
           selectedAccount?.AccountPartyId == action.AccountId &&
           selectedOpportunityId == action.SelectedOpportunityId &&
           selectedInteractionId == action.SelectedInteractionId;

    private bool IsCurrentAccountRefresh(
        CrmQueryLoadStamp loadStamp,
        CrmPageActionStamp action)
        => IsCurrentQueryLoad(loadStamp) &&
           url.State.AccountId == action.RouteAccountId &&
           url.State.OpportunityId == action.RouteOpportunityId &&
           url.State.InteractionId == action.RouteInteractionId &&
           selectedAccount?.AccountPartyId == action.AccountId &&
           selectedOpportunityId == action.SelectedOpportunityId &&
           selectedInteractionId == action.SelectedInteractionId;


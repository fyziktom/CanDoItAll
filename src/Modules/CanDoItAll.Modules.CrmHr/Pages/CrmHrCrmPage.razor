        isInteractive = true;
        StateHasChanged();
    }

    // The conversion is a mutation this page owns: it is admitted only for the account currently selected and only
    // while the page's query load is current, and the editor is changed only once the action was captured, so a
    // stale callback from a summary of a previous account neither saves nor leaves the form half-edited.
    private async Task MarkActiveCustomerAsync(Guid accountPartyId)
    {
        if (selectedAccount?.AccountPartyId != accountPartyId || !TryCaptureCrmAction(out var action))
        {
            return;
        }

        profileEditor.RelationshipStage = CrmAccountRelationshipStage.ActiveCustomer;
        ProfileInputChanged(AccountProfileField.RelationshipStage);
        await SaveAccountProfileAsync(action);
    }

    private async Task SaveAccountProfileAsync()
    {
        if (!TryCaptureCrmAction(out var action))
        {
            return;
        }

        await SaveAccountProfileAsync(action);
    }

    private async Task SaveAccountProfileAsync(CrmPageActionStamp action)
    {
        // One admitted write per account lifetime; the submission is independent of later typing.
        using var admission = mutationGate.TryEnter(action.LoadStamp.Generation);
        if (admission is null)
        {
            return;
        }

        var result = await accountEditing.SaveAsync();
        if (result.IsFailure)
        {
            if (IsCurrentCrmAction(action))
            {
                NotifyError(accountEditing.State.IsUnknown ? "CRM profile save outcome unknown" : "CRM account save failed", string.Join(" ", result.Errors.Select(error => error.Message)));
            }

            return;
        }

        if (!await ReloadSelectedAccountAsync(action, clearMessage: false))
        {
            return;
        }

        hasAccountInput = HasAccountChanges();
        accountCatalogVersion++;
        if (accountEditing.Message is { } warning) {
            NotificationService.Warning("CRM account saved", warning);
        } else {
            NotifySuccess("CRM account saved", "CRM account profile saved.");
        }
    }

    private void AddConnectedRecord()
    {
        var row = new CrmAccountConnectionEditorModel { Id = Guid.NewGuid() };
        connectedRecordEditors.Add(row);
        connections.Input(new(row.Id.Value, ConnectionField.Party));
        StateHasChanged();
    }

    private void RemoveConnectedRecord(int index)
    {
        if (index < 0 || index >= connectedRecordEditors.Count)
        {
            return;
        }

        var removed = connectedRecordEditors[index];
        connectedRecordEditors.RemoveAt(index);
        connectionProjectReads.Remove(removed.Id!.Value);
        if (connectionPartyPickerIndex == index)
        {
            connectionPartyPickerIndex = null;
        }
        else if (connectionPartyPickerIndex > index)
        {
            connectionPartyPickerIndex--;
        }
        UpdateConnectionsPicker();
        StateHasChanged();
    }

    private void OpenConnectionPartyPicker(int index)
    {
        if (index < 0 || index >= connectedRecordEditors.Count)
        {
            return;
        }

        connectionPartyPickerIndex = index;
        UpdateConnectionsPicker();
    }

    private Task CloseConnectionPartyPickerAsync()
    {
        connectionPartyPickerIndex = null;
        UpdateConnectionsPicker();
        return Task.CompletedTask;
    }

    private async Task ConfirmConnectionPartyAsync(Guid partyId)
    {
        if (connectionPartyPickerIndex is not int index ||
            index < 0 ||
            index >= connectedRecordEditors.Count)
        {
            connectionPartyPickerIndex = null;
            return;
        }

        if (!TryCaptureCrmAction(out var action))
        {
            connectionPartyPickerIndex = null;
            return;
        }

        var row = connectedRecordEditors[index];
        var opening = connections.Opening;
        var party = await PartyRecordQueryService.GetAsync(partyId);
        if (!IsCurrentCrmAction(action) ||
            connectionPartyPickerIndex != index ||
            index < 0 ||
            index >= connectedRecordEditors.Count || opening != connections.Opening || !ReferenceEquals(row, connectedRecordEditors[index]))
        {
            return;
        }

        if (party is null)
        {
            connectionPartyPickerIndex = null;
            UpdateConnectionsPicker();
            NotifyError(
                "Directory record unavailable",
                "The selected party no longer exists or is archived.");
            return;
        }

        connectedRecordEditors[index].RelatedPartyId = party.Id;
        connections.Input(new(row.Id!.Value, ConnectionField.Party));
        connectionPartyLabels[party.Id] = $"{party.DisplayName} ({party.PartyType})";
        connectionPartyPickerIndex = null;
        UpdateConnectionsPicker();
    }

    private void ClearConnectionParty(int index)
    {
        if (index < 0 || index >= connectedRecordEditors.Count)
        {
            return;
        }

        connectedRecordEditors[index].RelatedPartyId = Guid.Empty;
        connections.Input(new(connectedRecordEditors[index].Id!.Value, ConnectionField.Party));
    }

    private async Task UpdateConnectedRecordProjects(
        int index,
        IReadOnlyList<Guid> projectIds)
    {
        if (index < 0 || index >= connectedRecordEditors.Count)
        {
            return;
        }

        var row = connectedRecordEditors[index];
        var id = row.Id ?? throw new InvalidOperationException("A project selection requires a stable connection row.");
        var opening = connections.Opening;
        var request = Guid.NewGuid();
        row.ProjectIds = projectIds.Where(projectId => projectId != Guid.Empty).Distinct().ToList();
        row.ProjectAdmissions = row.ProjectAdmissions.Where(binding => row.ProjectIds.Contains(binding.Key)).ToDictionary();
        connections.Input(new(id, ConnectionField.Projects));
        connectionProjectReads[id] = request;
        UpdateConnectionsPicker();
        try {
            foreach (var projectId in row.ProjectIds.ToArray()) {
                if (row.ProjectAdmissions.ContainsKey(projectId)) {
                    continue;
                }
                var project = await ConnectionProjectQuery.GetAsync(projectId);
                if (project?.LifetimeId is not Guid lifetime) {
                    throw new InvalidOperationException("The selected project is unavailable. Choose its current record.");
                }
                if (opening != connections.Opening || connectionProjectReads.GetValueOrDefault(id) != request || !connectedRecordEditors.Contains(row)) {
                    return;
                }
                row.ProjectAdmissions[projectId] = new(ProjectWriteAdmissions.DatabaseProfileId, projectId, lifetime);
                connectionProjectLabels[projectId] = project.Name;
            }
        } catch (Exception exception) {
            Logger.LogWarning(exception, "Connection project selection failed for {AccountId} and row {ConnectionId}.", connections.AccountPartyId, id);
            if (opening == connections.Opening && connectionProjectReads.GetValueOrDefault(id) == request) {
                connectionsMessage = "The selected project could not be observed. Its selection is retained; choose a current record before saving.";
                NotifyError("Connection project unavailable", connectionsMessage);
            }
        } finally {
            if (opening == connections.Opening && connectionProjectReads.GetValueOrDefault(id) == request) {
                connectionProjectReads.Remove(id);
                UpdateConnectionsPicker();
            }
        }
    }

    private void ConnectionInputChanged(long opening, ConnectionFieldInput input) {
        if (opening == connections.Opening && connectedRecordEditors.Contains(input.Row) && input.Row.Id is Guid id) {
            connections.Input(new(id, input.Field));
        }
    }

    private void JournalInputChanged(long opening) {
        if (opening == interactionAppend.Opening) {
            interactionAppend.Input();
        }
    }

    private Task SelectConnectionProjectsAsync(long opening, ConnectionProjectSelection selection) {
        var index = connectedRecordEditors.IndexOf(selection.Row);
        return opening == connections.Opening && index >= 0
            ? UpdateConnectedRecordProjects(index, selection.ProjectIds) : Task.CompletedTask;
    }

    private void SetConnectionsProjectPicker(long opening, bool pending) {
        if (opening != connections.Opening) {
            return;
        }
        connectionProjectPickerOpen = pending;
        UpdateConnectionsPicker();
    }

    private void UpdateConnectionsPicker() => connections.Picker(connectionProjectPickerOpen || connectionPartyPickerIndex.HasValue || connectionProjectReads.Count > 0);

    private async Task ReviewConnectionsAsync() {
        if (!TryCaptureCrmAction(out var action) || connections.Reading || connections.IsSaving || connections.PickerPending) {
            return;
        }
        var opening = connections.Opening;
        var hint = connections.HintRevision;
        var input = connections.InputRevision;
        using var pending = new CancellationTokenSource();
        connectionReviewRead?.Cancel();
        connectionReviewRead = pending;
        connections.ReadingReview(true);
        try {
            var read = await accountEditing.ReadWorkspaceAsync(action.AccountId, pending.Token);
            if (!IsCurrentCrmAction(action) || opening != connections.Opening || pending.IsCancellationRequested) {
                return;
            }
            if (read.Workspace is not { } current) {
                connections.Hint();
                connectionsMessage = "The account is unavailable. Your connections are retained and cannot recreate it.";
                return;
            }
            connections.SetReview(current, hint, input);
            foreach (var row in current.ConnectedRecords) {
                connectionPartyLabels[row.RelatedPartyId] = $"{row.DisplayName} ({row.PartyType})";
                foreach (var project in row.Projects) {
                    connectionProjectLabels[project.Id] = project.Name;
                }
            }
        } catch (OperationCanceledException) when (pending.IsCancellationRequested) {
        } catch (Exception exception) {
            Logger.LogWarning(exception, "Connection review failed for {AccountId}.", action.AccountId);
            if (opening == connections.Opening && !connections.IsUnknown) {
                connectionsMessage = "Current connections could not be read. Your draft, original and previous comparison are retained; refresh before applying.";
            }
        } finally {
            if (ReferenceEquals(connectionReviewRead, pending)) {
                connectionReviewRead = null;
                if (opening == connections.Opening) {
                    connections.ReadingReview(false);
                }
            }
        }
    }

    private async Task ApplyConnectionsReviewAsync() {
        var opening = connections.Opening;
        try {
            await accountEditing.AuthorizeWriteAsync(connections.AccountPartyId, default);
            if (opening == connections.Opening && connections.ApplyReview()) {
                connectionsMessage = "The comparison was applied locally. Save connected records remains a separate command.";
                MarkAccountInput();
            }
        } catch (UnauthorizedAccessException) {
            if (opening == connections.Opening) {
                connections.Hint();
                connectionsMessage = "Current account access is required before applying the comparison. Your draft is retained.";
            }
        }
    }

    private void CancelConnectionsReview() {
        connectionReviewRead?.Cancel();
        connections.CancelReview();
    }

    private string ResolveConnectionPartyLabel(Guid partyId)
    {
        if (partyId == Guid.Empty)
        {
            return "No directory record selected";
        }

        return connectionPartyLabels.GetValueOrDefault(partyId)
            ?? "Selected directory party";
    }

    private async Task SaveConnectedRecordsAsync()
    {
        if (!TryCaptureCrmAction(out var action) || !connections.CanSubmit)
        {
            return;
        }

        using var admission = mutationGate.TryEnter(action.LoadStamp.Generation);
        if (admission is null)
        {
            return;
        }

        var submitted = connections.Begin();
        if (submitted is null) {
            return;
        }
        connectionsMessage = null;
        var ownerStarted = false;
        try {
            await accountEditing.AuthorizeWriteAsync(action.AccountId, default);
            if (!IsCurrentCrmAction(action)) {
                return;
            }
            using var authority = Changes.EnterUiWrite(token => accountEditing.AuthorizeWriteAsync(action.AccountId, token));
            using var origin = accountRecords.EnterWrite(action.AccountId);
            ownerStarted = true;
            var result = await CrmService.SaveConnectedRecordsAsync(action.AccountId, submitted.Rows, accountEditing.Actor,
                original: submitted.Original, onCommitted: receipt => connections.Accept(submitted, receipt));
            if (!IsCurrentCrmAction(action) || !connections.IsCurrent(submitted)) {
                return;
            }
            if (result.IsFailure) {
                if (result.Errors.Any(error => error.Code == CrmHrEditingErrorCodes.ConnectionConflict)) {
                    connections.Hint();
                }
                connectionsMessage = string.Join(" ", result.Errors.Select(error => error.Message));
                NotifyError("Connected records not saved", connectionsMessage);
                return;
            }
            if (connections.Accepted is null) {
                throw new InvalidOperationException("The connection owner returned success without its committed receipt.");
            }
            connectionsMessage = connections.IsDirty ? "Connected records saved. Later input is retained." : "Connected records saved.";
            if (!await ReloadSelectedAccountAsync(action, clearMessage: false) && connections.IsCurrent(submitted)) {
                connectionsMessage = "The connections committed, but the account could not be refreshed. The accepted write will not be repeated.";
            }
        } catch (ProjectWriteAdmissionRejectedException) {
            if (connections.IsCurrent(submitted)) {
                connections.Hint();
                connectionsMessage = "A selected project changed after it was chosen. Review its current lifetime before saving.";
                NotifyError("Connected records not saved", connectionsMessage);
            }
        } catch (Exception exception) {
            Logger.LogWarning(exception, "Connection replacement continuation failed for {AccountId}; accepted {Accepted}.", action.AccountId, connections.Accepted is not null);
            if (IsCurrentCrmAction(action) && connections.IsCurrent(submitted)) {
                if (ownerStarted && connections.Accepted is null) {
                    connections.Unknown(submitted);
                    connectionsMessage = "The connected-record save outcome is unknown. Its submission and your draft are retained; resubmission is blocked.";
                } else {
                    connectionsMessage = connections.Accepted is not null
                        ? "The connections committed. Follow-up failed; the accepted write will not be repeated."
                        : "Current account access is required. Your connected records are retained.";
                }
                NotifyError("Connected records require attention", connectionsMessage);
            }
        } finally {
            connections.Complete(submitted);
        }
    }

    private async Task SaveInteractionAsync()
    {
        if (!TryCaptureCrmAction(out var action) || !interactionAppend.CanSubmit)
        {
            return;
        }

        using var admission = mutationGate.TryEnter(action.LoadStamp.Generation);
        if (admission is null)
        {
            return;
        }

        var submitted = interactionAppend.Begin();
        if (submitted is null) {
            return;
        }
        interactionMessage = null;
        var ownerStarted = false;
        try {
            await accountEditing.AuthorizeWriteAsync(action.AccountId, default);
            if (!IsCurrentCrmAction(action)) {
                return;
            }
            using var authority = Changes.EnterUiWrite(token => accountEditing.AuthorizeWriteAsync(action.AccountId, token));
            using var origin = accountRecords.EnterWrite(action.AccountId);
            ownerStarted = true;
            var result = await CrmService.AddInteractionAsync(action.AccountId, submitted.Model, accountEditing.Actor,
                onCommitted: receipt => interactionAppend.Accept(submitted, receipt));
            if (!IsCurrentCrmAction(action) || !interactionAppend.IsCurrent(submitted)) {
                return;
            }
            if (result.IsFailure) {
                interactionMessage = string.Join(" ", result.Errors.Select(error => error.Message));
                NotifyError("Interaction not saved", interactionMessage);
                return;
            }
            if (interactionAppend.Accepted is null) {
                throw new InvalidOperationException("The interaction owner returned success without its committed receipt.");
            }
            interactionMessage = "Interaction saved. Later input is retained for a separate new journal entry.";
            if (await ReloadSelectedAccountAsync(action, clearMessage: false)) {
                NotifySuccess("Interaction saved", "CRM interaction saved.");
            } else if (interactionAppend.IsCurrent(submitted)) {
                interactionMessage = "The interaction committed, but the account could not be refreshed. The accepted entry will not be logged again.";
            }
        } catch (Exception exception) {
            Logger.LogWarning(exception, "Interaction append continuation failed for {AccountId}; accepted {Accepted}.", action.AccountId, interactionAppend.Accepted is not null);
            if (IsCurrentCrmAction(action) && interactionAppend.IsCurrent(submitted)) {
                if (ownerStarted && interactionAppend.Accepted is null) {
                    interactionAppend.Unknown(submitted);
                    interactionMessage = "The interaction append outcome is unknown. Its submission and your draft are retained; resubmission is blocked.";
                } else {
                    interactionMessage = interactionAppend.Accepted is not null
                        ? "The interaction committed. Follow-up failed; the accepted entry will not be logged again."
                        : "Current account access is required. Your interaction draft is retained.";
                }
                NotifyError("Interaction requires attention", interactionMessage);
            }
        } finally {
            interactionAppend.Complete(submitted);
        }
    }

    // An opportunity opens over its account as a new history entry; Back closes it again and keeps the account on the
    // section it showed.
    private async Task SelectOpportunityAsync(Guid opportunityId)
    {
        if (selectedAccount is null)
        {
            return;
        }

        InvalidateCurrentQueryForNavigation(closeAccount: false);
        url.OpenOverlay(url.State with { OpportunityId = opportunityId });
        await LoadRouteAsync(url.State);
    }

    private async Task SaveOpportunityAsync(CrmOpportunityEditorModel model) {
        if (!ReferenceEquals(model, opportunityEditing.Draft) || !TryCaptureCrmAction(out var action)) {
            return;
        }
        using var admission = mutationGate.TryEnter(action.LoadStamp.Generation);
        if (admission is null) {
            return;
        }
        var transientGeneration = Interlocked.Increment(ref transientStateGeneration);
        var inputRevision = opportunityEditing.State.InputRevision;
        isOpportunityBusy = true;
        try {
            var result = await opportunityEditing.SaveAsync();
            if (!IsCurrentCrmAction(action)) {
                return;
            }
            if (result.IsFailure) {
                NotifyError("Opportunity save failed", opportunityEditing.Message ?? string.Join(" ", result.Errors.Select(error => error.Message)), keepDialogMessage: true);
                return;
            }
            opportunityPipelineRefreshVersion++;
            if (opportunityEditing.State.IsDirty || opportunityEditing.State.IsOutdated || opportunityEditing.State.InputRevision != inputRevision || opportunityEditing.Message is not null) {
                NotifySuccess("Opportunity saved", "The submission was saved. Your editor remains open with its later input and current save information.");
                return;
            }
            isOpportunityCreateDialogOpen = false;
            isOpportunityEditDialogOpen = false;
            opportunityEditing.Clear();
            if (url.State.OpportunityId != result.Value) {
                await OpenCommittedOpportunityAsync(action, result.Value);
                return;
            }
            if (!await ReloadSelectedAccountAsync(action, clearMessage: false, preferredOpportunityId: result.Value)) {
                return;
            }
            isOpportunityDetailDialogOpen = true;
            NotifySuccess("Opportunity saved", "Opportunity saved.");
        } finally {
            if (transientGeneration == Volatile.Read(ref transientStateGeneration)) {
                isOpportunityBusy = false;
            }
        }
    }

    private async Task AdvanceOpportunityStageAsync(CrmOpportunityStageAdvance intent) {
        if (!TryCaptureCrmAction(out var action) || intent.AccountPartyId != action.AccountId || isOpportunityBusy || stageOutcomeUnknown) {
            return;
        }
        using var admission = mutationGate.TryEnter(action.LoadStamp.Generation);
        if (admission is null) {
            return;
        }
        using var grant = await EditingAccess.OpenAsync(new(Changes.Scope, EditingOwner.CrmOpportunity, intent.OpportunityId), default);
        await EditingAccess.ValidateAsync(grant, write: true, default);
        if (!IsCurrentCrmAction(action)) {
            return;
        }
        isOpportunityBusy = true;
        CrmOpportunityStageReceipt? accepted = null;
        using var authority = Changes.EnterUiWrite(token => EditingAccess.ValidateAsync(grant, write: true, token));
        try {
            var result = await CrmService.AdvanceOpportunityStageAsync(intent, grant.Actor, onCommitted: receipt => accepted = receipt);
            if (!IsCurrentCrmAction(action)) {
                return;
            }
            if (result.IsFailure) {
                NotifyError("Stage advance refused", string.Join(" ", result.Errors.Select(error => error.Message)));
            } else {
                NotifySuccess("Stage advanced", "Opportunity stage saved.");
            }
            opportunityPipelineRefreshVersion++;
        } catch (Exception exception) {
            Logger.LogWarning(exception, "Opportunity stage continuation failed for {OpportunityId}; accepted {Accepted}.", intent.OpportunityId, accepted is not null);
            if (IsCurrentCrmAction(action)) {
                stageOutcomeUnknown = accepted is null;
                NotifyError("Stage advance", accepted is null ? "The stage outcome is unknown. Further stage commands are blocked until this workspace is reopened and observed." : "The stage was saved; a follow-up failed.");
                opportunityPipelineRefreshVersion++;
            }
        } finally {
            if (IsCurrentCrmAction(action)) {
                isOpportunityBusy = false;
            }
        }
    }

    private async Task OpenOpportunityCreateDialog() {
        if (selectedAccount is null || !TryCaptureCrmAction(out var action)) {
            return;
        }
        if (!await opportunityEditing.OpenAsync(new() {
            AccountPartyId = selectedAccount.AccountPartyId, RelationshipStage = profileEditor.RelationshipStage.ToString()
        })) {
            return;
        }
        if (!IsCurrentCrmAction(action)) {
            return;
        }
        message = null;
        isOpportunityDetailDialogOpen = false;
        isOpportunityEditDialogOpen = false;
        isOpportunityCreateDialogOpen = true;
        StateHasChanged();
    }

    private async Task CloseOpportunityCreateDialogAsync() {
        if (!await RequestOpportunityLeaveAsync()) {
            return;
        }
        var savedId = opportunityEditing.Draft.Id;
        var canRefresh = TryCaptureCrmAction(out var action);
        isOpportunityCreateDialogOpen = false;
        opportunityEditing.Clear();
        message = null;
        StateHasChanged();
        if (savedId is Guid id && canRefresh) {
            await OpenCommittedOpportunityAsync(action, id);
        }
    }

    // Closing the opportunity returns to its account: Back when the opportunity was opened here, otherwise the location
    // is replaced with the account it belongs to.
    private async Task CloseOpportunityDetailDialogAsync()
    {
        isOpportunityDetailDialogOpen = false;
        if (url.State.OpportunityId is null)
        {
            return;
        }

        var account = url.State with { OpportunityId = null };
        if (!account.HasAccountContext && selectedAccount is { } selected)
        {
            account = account with { AccountId = selected.AccountPartyId };
        }

        InvalidateCurrentQueryForNavigation(closeAccount: false);
        await url.CloseOverlayAsync(account);
        await LoadRouteAsync(url.State);
    }

    // An opportunity created, or advanced from the board, is another record than the location names: it opens over
    // the account as a new history entry, so an opportunity the location named before can never outrank it. The
    // write committed; a failed read-back afterwards is only a warning.
    private async Task OpenCommittedOpportunityAsync(CrmPageActionStamp action, Guid opportunityId)
    {
        if (!IsCurrentCrmAction(action))
        {
            return;
        }

        InvalidateCurrentQueryForNavigation(closeAccount: false);
        url.OpenOverlay(url.State with { OpportunityId = opportunityId });
        try
        {
            await LoadRouteAsync(url.State);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "The saved CRM opportunity {OpportunityId} could not be opened.", opportunityId);
            NotificationService.Warning(
                "Saved, refresh failed",
                "The opportunity was saved, but the account could not be refreshed. Reload the page to see the current state.");
            return;
        }

        if (SelectedOpportunity?.Id != opportunityId)
        {
            return;
        }

        opportunityPipelineRefreshVersion++;
        NotifySuccess("Opportunity saved", "Opportunity saved.");
    }

    private async Task OpenOpportunityEditDialog() {
        if (SelectedOpportunity is not { } selected || !TryCaptureCrmAction(out var action)) {
            return;
        }
        if (!await opportunityEditing.OpenAsync(OpportunityEditorDrafts.FromDetail(selected))) {
            return;
        }
        if (!IsCurrentCrmAction(action)) {
            return;
        }
        message = null;
        isOpportunityDetailDialogOpen = false;
        isOpportunityEditDialogOpen = true;
        StateHasChanged();
    }

    private async Task CloseOpportunityEditDialogAsync() {
        if (!await RequestOpportunityLeaveAsync()) {
            return;
        }
        var target = SelectedOpportunity?.Id;
        var canRefresh = TryCaptureCrmAction(out var action);
        isOpportunityEditDialogOpen = false;
        isOpportunityDetailDialogOpen = SelectedOpportunity is not null;
        opportunityEditing.Clear();
        message = null;
        StateHasChanged();
        if (target is Guid id && canRefresh) {
            var opening = opportunityEditing.Opening;
            try {
                await ReloadSelectedAccountAsync(action, clearMessage: false, preferredOpportunityId: id);
            } catch (Exception exception) when (exception is not OperationCanceledException) {
                Logger.LogWarning(exception, "Opportunity detail refresh failed after editor close for {OpportunityId}.", id);
                if (opening == opportunityEditing.Opening && SelectedOpportunity?.Id == id) {
                    NotifyWarning("Detail refresh failed", "The editor closed, but current opportunity detail could not be read. Reopen it to retry.");
                }
            }
        }
    }

    private async Task OpenConversionDialogAsync() {
        if (isOpportunityConversionDialogOpen || !TryCaptureCrmAction(out var action) || SelectedOpportunity is not { } opportunity) {
            return;
        }
        if (opportunity.Stage != OpportunityStage.Won) {
            NotifyWarning("Opportunity conversion unavailable", "Only won opportunities can be converted into projects.");
            return;
        }
        message = null;
        isOpportunityDetailDialogOpen = false;
        isOpportunityConversionDialogOpen = true;
        await conversionEditing.OpenAsync(opportunity, CreateOpportunityConversionEditor(opportunity, selectedOpportunityProjectAdmission));
        if (!IsCurrentCrmAction(action)) {
            return;
        }
    }

    private async Task ObserveConversionProjectAsync(Guid projectId, long opening) {
        if (opening == opportunityConversion.Opening && opportunityConversionEditor.ExistingProjectId == projectId &&
            opportunityConversionEditor.ExpectedProjectAdmission is { } project) {
            await conversionEditing.ObserveProjectAsync(project);
        }
    }

    private async Task CloseOpportunityConversionDialogAsync() {
        conversionEditing.CancelRead();
        if (conversionLeaveGuard is not null && !await conversionLeaveGuard.RequestLeaveAsync()) {
            return;
        }
        var known = opportunityConversion.Accepted;
        isOpportunityConversionDialogOpen = false;
        isOpportunityDetailDialogOpen = SelectedOpportunity is not null;
        message = null;
        conversionEditing.Clear();
        if (known is not null && TryCaptureCrmAction(out var action)) {
            await ReloadSelectedAccountAsync(action, clearMessage: false, preferredOpportunityId: known.OpportunityId);
        }
    }

    private async Task SaveOpportunityConversionAsync(CrmOpportunityConversionEditorModel model) {
        if (!isOpportunityConversionDialogOpen || !conversionEditing.CanSave || !TryCaptureCrmAction(out var action) ||
            SelectedOpportunity is not { } opportunity || model.OpportunityId != opportunity.Id) {
            return;
        }
        if (model.LinkExistingProject && (model.ExistingProjectId is not { } projectId || model.ExpectedProjectAdmission?.ProjectId != projectId)) {
            conversionEditing.RefuseSubmission("Choose the project to link in the project picker before converting.");
            return;
        }
        using var admission = mutationGate.TryEnter(action.LoadStamp.Generation);
        if (admission is null) {
            return;
        }
        message = null;
        var submission = await conversionEditing.SaveAsync(model);
        if (submission is null || !IsCurrentCrmAction(action) || !opportunityConversion.IsCurrent(submission) ||
            opportunityConversion.Accepted is not { } converted) {
            return;
        }
        opportunityPipelineRefreshVersion++;
        selectedOpportunity = opportunity with {
            LinkedProjectId = converted.ProjectId, LinkedProjectName = converted.ProjectName,
            LinkedProjectAdmission = converted.ProjectAdmission,
            UpdatedAtUtc = converted.OpportunityUpdatedAtUtc ?? throw new InvalidOperationException("The conversion has no committed opportunity observation.")
        };
        selectedOpportunityProjectAdmission = converted.ProjectAdmission;
        if (opportunityConversion.HasLaterInput(submission)) {
            NotifySuccess("Opportunity converted", "The submitted conversion committed. Your later input is retained; this completed command cannot be submitted again.");
            return;
        }
        isOpportunityConversionDialogOpen = false;
        isOpportunityDetailDialogOpen = true;
        if (await ReloadSelectedAccountAsync(action, clearMessage: false, preferredOpportunityId: converted.OpportunityId)) {
            NotifySuccess("Opportunity converted", converted.CreatedNewProject ? "Opportunity converted into a new project." : "Opportunity linked to the selected project.");
        }
    }


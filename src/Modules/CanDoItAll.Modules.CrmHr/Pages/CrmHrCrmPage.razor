    private async Task OpenConversionDialogAsync()
    {
        if (!TryCaptureCrmAction(out var action) ||
            SelectedOpportunity is not { } selectedOpportunity)
        {
            NotifyWarning("Opportunity conversion unavailable", "Choose a won opportunity before converting it to a project.");
            return;
        }

        if (selectedOpportunity.Stage != OpportunityStage.Won)
        {
            NotifyWarning("Opportunity conversion unavailable", "Only won opportunities can be converted into projects.");
            return;
        }

        var loadedProjectSummaries = await ProjectsService.ListAsync();
        if (!IsCurrentCrmAction(action) ||
            SelectedOpportunity?.Id != selectedOpportunity.Id)
        {
            return;
        }

        projectSummaries = loadedProjectSummaries;
        opportunityConversionEditor = CreateOpportunityConversionEditor(selectedOpportunity);
        message = null;
        messageTone = "success";
        isOpportunityConversionDialogOpen = true;
    }

    private Task CloseOpportunityConversionDialogAsync()
    {
        isOpportunityConversionDialogOpen = false;
        return Task.CompletedTask;
    }

    private async Task SaveOpportunityConversionAsync()
    {
        if (!TryCaptureCrmAction(out var action) ||
            SelectedOpportunity is not { } selectedOpportunity)
        {
            return;
        }

        var transientGeneration = Interlocked.Increment(ref transientStateGeneration);
        isOpportunityConversionBusy = true;
        try
        {
            opportunityConversionEditor.OpportunityId = selectedOpportunity.Id;
            opportunityConversionEditor.LastChangedBy = profileEditor.LastChangedBy;

            var result = await CrmService.ConvertOpportunityToProjectAsync(opportunityConversionEditor);
            if (result.IsFailure)
            {
                if (IsCurrentCrmAction(action))
                {
                    NotifyError("Opportunity conversion failed", string.Join(" ", result.Errors.Select(error => error.Message)), keepDialogMessage: true);
                }

                return;
            }

            var conversion = result.Value;
            if (conversion is null)
            {
                if (IsCurrentCrmAction(action))
                {
                    NotifyError("Opportunity conversion failed", "The opportunity conversion completed without a result payload.", keepDialogMessage: true);
                }

                return;
            }

            if (!await ReloadSelectedAccountAsync(
                    action,
                    clearMessage: false,
                    preferredOpportunityId: conversion.OpportunityId))
            {
                return;
            }

            isOpportunityConversionDialogOpen = false;
            var conversionMessage = conversion.CreatedNewProject
                ? "Opportunity converted into a new project."
                : "Opportunity linked to the selected project.";
            NotifySuccess("Opportunity converted", conversionMessage);
        }
        finally
        {
            if (transientGeneration == Volatile.Read(ref transientStateGeneration))
            {
                isOpportunityConversionBusy = false;
            }
        }
    }


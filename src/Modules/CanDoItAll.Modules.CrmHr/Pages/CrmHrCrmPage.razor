    private Task HandleCatalogQueryChangedAsync(PagedRecordQueryChange<PartyRecordScope> change)
    {
        url.Navigate(
            url.State with { Catalog = CrmUrlCodec.Catalog.FromQuery(change.Query) },
            CrmHrCatalogUrlCodec<PartyRecordScope>.HistoryMode(change.Kind));
        return Task.CompletedTask;
    }

    // The account activity lane: the session owns the read, the accepted page, the busy gate and the fencing of
    // late outcomes; this page decides when the lane is asked for the selected account and renders its failure.
    private async Task EnsureAccountActivityLoadedAsync() {
        if (selectedAccount is not { } account) {
            return;
        }
        await accountActivity.EnsureLoadedAsync(account.AccountPartyId);
        if (accountActivityOutdated && accountActivity.Target == account.AccountPartyId) {
            accountActivityOutdated = false;
            await accountActivity.RefreshAsync();

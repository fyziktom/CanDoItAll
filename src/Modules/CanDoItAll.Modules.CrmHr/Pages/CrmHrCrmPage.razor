    private async Task ConfirmStakeholderPartyAsync(Guid partyId)
    {
        if (stakeholderPartyPickerIndex is not int index ||
            index < 0 ||
            index >= stakeholderEditors.Count)
        {
            stakeholderPartyPickerIndex = null;
            return;
        }

        var party = await PartyRecordQueryService.GetAsync(partyId);
        if (party is null)
        {
            stakeholderPartyPickerIndex = null;
            NotifyError(
                "Stakeholder unavailable",
                "The selected party no longer exists or is archived.");

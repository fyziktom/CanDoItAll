@page "/crm-hr/crm"
@implements IDisposable
@using CanDoItAll.AgentFramework.Core
@using CanDoItAll.AgentFramework.Models
@using CanDoItAll.Components.BaseLib
@using Microsoft.Extensions.Logging
@inject CrmService CrmService
@inject IPartyRecordQueryService PartyRecordQueryService
@inject IAgentChatLauncher AgentChatLauncher
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject ILogger<CrmHrCrmPage> Logger

<PageTitle>CRM / HR CRM</PageTitle>

<PageScaffold MaxWidthClass="max-w-full">
    <Header>
        <PageHeader Eyebrow="CRM / HR"
                    Title="CRM workspace"
                    Description="Review shared customer, partner, and vendor accounts, keep stakeholder ownership explicit, and log follow-ups before they disappear into side channels."
                    Compact="true">
            <Stats>
                <CompactStat Label="accounts"
                             Value="@accountCount.ToString()"
                             TooltipText="Active organization records in the shared directory." />
                <CompactStat Label="selection"
                             Value="@(selectedAccount is null ? "None" : "Active")"
                             TooltipText="Current account workspace selection."
                             Tone="info" />
            </Stats>
            <Actions>
                <PageHeaderActionButton Icon="smart_toy"
                                        Label="Agent chats"
                                        TooltipText="Open the global agent catalog with the current CRM selection as context."
                                        ButtonStyle="ButtonStyle.Primary"
                                        Click="OpenAgentChats"
                                        data-testid="crmhr-crm-agent-chats" />
                <PageHeaderActionButton Icon="asset"
                                        Label="Open directory"
                                        TooltipText="Open the shared party directory."
                                        Click="OpenDirectory" />
            </Actions>
        </PageHeader>
    </Header>

    <ChildContent>
        <Stack GapScale="LayoutGap.Large">
            <CrmHrSecondaryTabs SelectedArea="CrmHrWorkspaceArea.Crm" />

            <ListDetailShell ListPaneWidth="28rem">
                <ListHeader>
                    <ListPanelHeader Title="Accounts"
                                     Description="Search and page through organization records, then open one account workspace." />
                </ListHeader>

                <ListContent>
                    <PartyRecordBrowser AllowedScope="PartyRecordScope.Organizations"
                                        InitialScope="PartyRecordScope.Organizations"
                                        SelectedPartyId="selectedAccount?.AccountPartyId"
                                        SelectionChanged="SelectAccountAsync"
                                        LoadFailed="HandleAccountBrowserLoadFailedAsync"
                                        PageSize="12"
                                        SearchPlaceholder="Search account name, code, summary, or tag"
                                        DataTestId="crmhr-account-browser"
                                        OptionTestId="crmhr-account-item" />
                </ListContent>

                <DetailHeader>
                    <AccountSummaryPanel Account="selectedAccount"
                                         OpenDirectory="OpenDirectory"
                                         MarkActiveCustomer="MarkActiveCustomerAsync" />
                </DetailHeader>

                <DetailContent>
                    @if (selectedAccount is null)
                    {
                        <EmptyState Eyebrow="CRM workspace ready"
                                    Title="Select an account to continue"
                                    Description="The account detail surface will show relationship stage, stakeholders, interaction history, and overdue next actions after you choose an organization." />
                    }
                    else
                    {
                        <Tabs SelectedIndex="@SelectedCrmRecordTabIndex"
                              SelectedIndexChanged="HandleCrmRecordTabChanged"
                              RenderMode="TabRenderMode.Server"
                              Variant="TabsVariant.WorkspaceSecondary"
                              BorderMode="TabsBorderMode.Soft"
                              OverflowMode="TabsOverflowMode.Wrap"
                              AriaLabel="CRM account sections"
                              data-testid="crmhr-crm-tabs">
                            <TabItems>
                                <TabsItem Text="Overview"
                                          Icon="dashboard"
                                          data-testid="crmhr-crm-tab-overview">
                            <EditForm Model="profileEditor" OnValidSubmit="SaveAccountProfileAsync">
                                <FormSection Title="Relationship profile"
                                             Description="Keep prospect conversion, commercial context, and timing risk on the same account record instead of scattering it across notes.">
                                    <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                        <div>
                                            <label class="cda-field-label">Relationship stage</label>
                                            <InputSelect @bind-Value="profileEditor.RelationshipStage"
                                                         class="cda-input"
                                                         data-testid="crmhr-account-stage">
                                                @foreach (var stage in Enum.GetValues<CrmAccountRelationshipStage>())
                                                {
                                                    <option value="@stage">@stage</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div class="rounded-[1.25rem] border border-slate-200 bg-slate-50/80 px-4 py-4">
                                            <p class="cda-eyebrow">Current scope</p>
                                            <p class="mt-2 text-sm leading-6 text-slate-700">
                                                Account context, stakeholder ownership, follow-up history, opportunity progression, and recognized sold value stay grounded on the shared party record.
                                            </p>
                                        </div>
                                    </Grid>

                                    <Grid Gap="LayoutGap.Large" ColumnsMd="3" Class="mt-5">
                                        <div>
                                            <label class="cda-field-label">Commercial notes</label>
                                            <InputTextArea @bind-Value="profileEditor.CommercialNotes"
                                                           class="cda-input cda-input--textarea min-h-[9rem]"
                                                           data-testid="crmhr-account-commercial-notes" />
                                        </div>
                                        <div>
                                            <label class="cda-field-label">Constraints</label>
                                            <InputTextArea @bind-Value="profileEditor.ConstraintNotes"
                                                           class="cda-input cda-input--textarea min-h-[9rem]"
                                                           data-testid="crmhr-account-constraints" />
                                        </div>
                                        <div>
                                            <label class="cda-field-label">Timing risks</label>
                                            <InputTextArea @bind-Value="profileEditor.TimingRiskNotes"
                                                           class="cda-input cda-input--textarea min-h-[9rem]"
                                                           data-testid="crmhr-account-timing-risks" />
                                        </div>
                                    </Grid>

                                    <Cluster Gap="LayoutGap.Small" Class="mt-5">
                                        <Button Text="Save CRM profile"
                                                data-testid="crmhr-account-save-button"
                                                Type="submit" />
                                        <Button Text="Open directory record"
                                                ButtonStyle="ButtonStyle.Light"
                                                Click="OpenDirectory" />
                                    </Cluster>
                                </FormSection>
                            </EditForm>
                                </TabsItem>

                                <TabsItem Text="Financials"
                                          Icon="monitoring"
                                          data-testid="crmhr-crm-tab-financials">
                                    <CrmFinancialsPanel AccountPartyId="@selectedAccount.AccountPartyId" />
                                </TabsItem>

                                <TabsItem Text="Stakeholders"
                                          Icon="groups"
                                          data-testid="crmhr-crm-tab-stakeholders">
                            <FormSection Title="Stakeholders"
                                         Description="Link account-specific contacts and ownership roles so billing, contract, delivery, and sponsor responsibilities remain explicit.">
                                <Split Gap="LayoutGap.Medium"
                                       AlignItems="AlignItems.Center"
                                       JustifyContent="JustifyContent.SpaceBetween">
                                    <div>
                                        <p class="cda-eyebrow">Account contact map</p>
                                        <p class="mt-1 text-sm leading-6 text-slate-600">Use explicit account roles instead of encoding billing, contract, or sponsor ownership in free text.</p>
                                    </div>
                                    <Button Text="Add stakeholder"
                                            ButtonStyle="ButtonStyle.Light"
                                            Size="ButtonSize.Small"
                                            Click="AddStakeholder"
                                            data-testid="crmhr-stakeholder-add" />
                                </Split>

                                @if (stakeholderEditors.Count == 0)
                                {
                                    <div class="mt-5 rounded-[1.25rem] border border-dashed border-slate-300 bg-slate-50/70 px-4 py-4 text-sm leading-6 text-slate-600">
                                        No account-specific stakeholders saved yet.
                                    </div>
                                }
                                else
                                {
                                    <Stack GapScale="LayoutGap.Medium" Class="mt-5">
                                        @for (var index = 0; index < stakeholderEditors.Count; index++)
                                        {
                                            var rowIndex = index;
                                            var stakeholder = stakeholderEditors[index];
                                            <PanelCard Soft="true">
                                                <Grid Gap="LayoutGap.Medium" ColumnsLg="4">
                                                    <div class="lg:col-span-2">
                                                        <label class="cda-field-label">Related party</label>
                                                        <SurfaceCard Soft="true">
                                                            <Split Breakpoint="LayoutBreakpoint.None"
                                                                   Gap="LayoutGap.Medium"
                                                                   AlignItems="AlignItems.Center"
                                                                   JustifyContent="JustifyContent.SpaceBetween"
                                                                   Wrap="FlexWrap.Wrap">
                                                                <TextBlock TextStyle="TextStyle.Note"
                                                                           Value="@ResolveStakeholderPartyLabel(stakeholder.RelatedPartyId)" />
                                                                <Cluster Gap="LayoutGap.Small">
                                                                    @if (stakeholder.RelatedPartyId != Guid.Empty)
                                                                    {
                                                                        <Button Text="Clear"
                                                                                ButtonStyle="ButtonStyle.Light"
                                                                                Size="ButtonSize.Small"
                                                                                Click="@(() => ClearStakeholderParty(rowIndex))"
                                                                                data-testid="@($"crmhr-stakeholder-party-clear-{rowIndex}")" />
                                                                    }
                                                                    <Button Text="Choose party"
                                                                            Icon="search"
                                                                            Size="ButtonSize.Small"
                                                                            Click="@(() => OpenStakeholderPartyPicker(rowIndex))"
                                                                            data-testid="@($"crmhr-stakeholder-party-{rowIndex}")" />
                                                                </Cluster>
                                                            </Split>
                                                        </SurfaceCard>
                                                    </div>
                                                    <div>
                                                        <label class="cda-field-label">Account role</label>
                                                        <InputSelect @bind-Value="stakeholder.Role"
                                                                     class="cda-input"
                                                                     data-testid="@($"crmhr-stakeholder-role-{rowIndex}")">
                                                            @foreach (var role in Enum.GetValues<CrmAccountStakeholderRole>())
                                                            {
                                                                <option value="@role">@role</option>
                                                            }
                                                        </InputSelect>
                                                    </div>
                                                    <div class="flex items-end justify-end">
                                                        <Button Text="Remove"
                                                                ButtonStyle="ButtonStyle.Danger"
                                                                Size="ButtonSize.Small"
                                                                Click="@(() => RemoveStakeholder(rowIndex))"
                                                                data-testid="@($"crmhr-stakeholder-remove-{rowIndex}")" />
                                                    </div>
                                                </Grid>

                                                <Grid Gap="LayoutGap.Medium" ColumnsLg="3" Class="mt-4">
                                                    <div class="lg:col-span-2">
                                                        <label class="cda-field-label">Notes</label>
                                                        <InputText @bind-Value="stakeholder.Notes"
                                                                   class="cda-input"
                                                                   data-testid="@($"crmhr-stakeholder-notes-{rowIndex}")" />
                                                    </div>
                                                    <div class="flex items-end gap-3">
                                                        <InputCheckbox @bind-Value="stakeholder.IsPrimary"
                                                                       data-testid="@($"crmhr-stakeholder-primary-{rowIndex}")" />
                                                        <label class="text-sm text-slate-700">Primary for this role</label>
                                                    </div>
                                                </Grid>
                                            </PanelCard>
                                        }
                                    </Stack>
                                }

                                <Cluster Gap="LayoutGap.Small" Class="mt-5">
                                    <Button Text="Save stakeholders"
                                            Click="SaveStakeholdersAsync"
                                            data-testid="crmhr-stakeholder-save-button" />
                                </Cluster>
                            </FormSection>
                                </TabsItem>

                                <TabsItem Text="Interactions"
                                          Icon="forum"
                                          data-testid="crmhr-crm-tab-interactions">
                                    <Stack GapScale="LayoutGap.Large">
                            <Grid Gap="LayoutGap.Large" ColumnsLg="2">
                                @if (!string.IsNullOrWhiteSpace(accountActivityLoadError))
                                {
                                    <SurfaceCard Soft="true" data-testid="crmhr-account-activity-error">
                                        <p class="cda-eyebrow text-rose-700">Account activity unavailable</p>
                                        <p class="mt-2 text-sm leading-6 text-slate-700">@accountActivityLoadError</p>
                                        <Button Text="Retry"
                                                Icon="refresh"
                                                ButtonStyle="ButtonStyle.Light"
                                                Size="ButtonSize.Small"
                                                Class="mt-4"
                                                Click="RetryAccountActivityAsync" />
                                    </SurfaceCard>
                                }
                                else
                                {
                                    <InteractionTimeline Page="accountActivityPage"
                                                         IsLoading="@isAccountActivityLoading"
                                                         PageRequested="HandleAccountActivityPageRequestedAsync"
                                                         DataTestId="crmhr-account-activity" />
                                }

                                <SurfaceCard Soft="true">
                                    <p class="cda-eyebrow">Next actions</p>
                                    <h3 class="mt-1 text-lg font-semibold text-slate-950">Follow-up pressure</h3>
                                    <p class="mt-4 text-sm leading-6 text-slate-600">
                                        Counts cover the complete account history while the timeline renders only the active page.
                                    </p>
                                    <Cluster Gap="LayoutGap.Small" Class="mt-4">
                                        <StatusBadge Tone="info"
                                                     Text="@($"{accountActivityPage.ActionCount:N0} open follow-ups")"
                                                     data-testid="crmhr-account-action-count" />
                                        <StatusBadge Tone="@(accountActivityPage.OverdueActionCount > 0 ? "danger" : "success")"
                                                     Text="@($"{accountActivityPage.OverdueActionCount:N0} overdue")"
                                                     data-testid="crmhr-account-overdue-count" />
                                    </Cluster>
                                </SurfaceCard>
                            </Grid>

                            <EditForm Model="interactionEditor" OnValidSubmit="SaveInteractionAsync">
                                <Stack GapScale="LayoutGap.Large">
                                    <FormSection Title="Interaction journal"
                                                 Description="Record calls, meetings, emails, and messages against the account so recent context survives handoffs and reloads.">
                                        <Grid Gap="LayoutGap.Large" ColumnsMd="3">
                                            <div>
                                                <label class="cda-field-label">Interaction type</label>
                                                <InputSelect @bind-Value="interactionEditor.InteractionType"
                                                             class="cda-input"
                                                             data-testid="crmhr-interaction-type">
                                                    @foreach (var interactionType in Enum.GetValues<InteractionType>())
                                                    {
                                                        <option value="@interactionType">@interactionType</option>
                                                    }
                                                </InputSelect>
                                            </div>
                                            <div>
                                                <label class="cda-field-label">Occurred on</label>
                                                <InputDate @bind-Value="interactionEditor.OccurredOn"
                                                           class="cda-input"
                                                           data-testid="crmhr-interaction-occurred-on" />
                                            </div>
                                            <div>
                                                <label class="cda-field-label">Linked opportunity</label>
                                                <InputSelect @bind-Value="interactionEditor.RelatedOpportunityId"
                                                             class="cda-input"
                                                             data-testid="crmhr-interaction-opportunity">
                                                    <option value="">No linked opportunity</option>
                                                    @if (SelectedOpportunity is { } selectedOpportunity)
                                                    {
                                                        <option value="@selectedOpportunity.Id">@selectedOpportunity.Title</option>
                                                    }
                                                </InputSelect>
                                                <p class="mt-1 text-xs leading-5 text-slate-500">
                                                    Select an opportunity from the paged Opportunities tab before linking it here.
                                                </p>
                                            </div>
                                        </Grid>

                                        <div class="mt-5">
                                            <label class="cda-field-label">Subject</label>
                                            <InputText @bind-Value="interactionEditor.Subject"
                                                       class="cda-input"
                                                       data-testid="crmhr-interaction-subject" />
                                        </div>

                                        <Grid Gap="LayoutGap.Large" ColumnsMd="2" Class="mt-5">
                                            <div>
                                                <label class="cda-field-label">Summary</label>
                                                <InputTextArea @bind-Value="interactionEditor.Summary"
                                                               class="cda-input cda-input--textarea min-h-[9rem]"
                                                               data-testid="crmhr-interaction-summary" />
                                            </div>
                                            <div>
                                                <label class="cda-field-label">Notes</label>
                                                <InputTextArea @bind-Value="interactionEditor.Notes"
                                                               class="cda-input cda-input--textarea min-h-[9rem]"
                                                               data-testid="crmhr-interaction-notes" />
                                            </div>
                                        </Grid>

                                        <div class="mt-5">
                                            <p class="cda-field-label">Participants</p>
                                            @if (ParticipantOptions.Count == 0)
                                            {
                                                <div class="rounded-[1.25rem] border border-dashed border-slate-300 bg-slate-50/70 px-4 py-4 text-sm leading-6 text-slate-600">
                                                    Save at least one stakeholder to expose reusable participant shortcuts here.
                                                </div>
                                            }
                                            else
                                            {
                                                <Grid Gap="LayoutGap.Small" ColumnsMd="2">
                                                    @foreach (var option in ParticipantOptions)
                                                    {
                                                        <label class="flex items-center gap-3 rounded-[1rem] border border-slate-200 bg-slate-50/80 px-4 py-3 text-sm text-slate-700"
                                                               data-testid="@($"crmhr-interaction-participant-option-{option.Id:N}")">
                                                            <input type="checkbox"
                                                                   checked="@interactionEditor.ParticipantPartyIds.Contains(option.Id)"
                                                                   @onchange="args => ToggleInteractionParticipant(option.Id, args)"
                                                                   data-testid="@($"crmhr-interaction-participant-{option.Id:N}")" />
                                                            <span>@option.DisplayName (@option.PartyType)</span>
                                                        </label>
                                                    }
                                                </Grid>
                                            }
                                        </div>
                                    </FormSection>

                                    <NextActionEditor Model="interactionEditor"
                                                      OwnerOptions="selectedAccount.StakeholderParties" />

                                    <Cluster Gap="LayoutGap.Small">
                                        <Button Text="Log interaction"
                                                data-testid="crmhr-interaction-save-button"
                                                Type="submit" />
                                    </Cluster>
                                </Stack>
                            </EditForm>
                                    </Stack>
                                </TabsItem>

                                <TabsItem Text="Opportunities"
                                          Icon="trending_up"
                                          data-testid="crmhr-crm-tab-opportunities">
                                    <OpportunityPipeline AccountPartyId="selectedAccount.AccountPartyId"
                                                         SelectedOpportunityId="selectedOpportunityId"
                                                         RefreshVersion="opportunityPipelineRefreshVersion"
                                                         AddOpportunity="OpenOpportunityCreateDialog"
                                                         SelectOpportunity="SelectOpportunityAsync"
                                                         AdvanceOpportunityStage="AdvanceOpportunityStageAsync"
                                                         LoadFailed="HandleOpportunityPipelineLoadFailedAsync" />
                                </TabsItem>
                            </TabItems>
                        </Tabs>
                    }
                </DetailContent>
            </ListDetailShell>
        </Stack>
    </ChildContent>
</PageScaffold>

<OpportunityCreateDialog IsOpen="@isOpportunityCreateDialogOpen"
                         InitialModel="opportunityEditor"
                         AccountDisplayName="@(selectedAccount?.DisplayName ?? string.Empty)"
                         RelationshipStageLabel="@profileEditor.RelationshipStage.ToString()"
                         IsBusy="isOpportunityBusy"
                         Message="@(isOpportunityCreateDialogOpen ? message : null)"
                         Save="SaveOpportunityAsync"
                         Close="CloseOpportunityCreateDialogAsync"
                         LoadFailed="HandleOpportunityPickerLoadFailedAsync" />

<OpportunityDetailDialog IsOpen="@isOpportunityDetailDialogOpen"
                         Opportunity="SelectedOpportunity"
                         Close="CloseOpportunityDetailDialogAsync"
                         Edit="OpenOpportunityEditDialog"
                         Convert="OpenConversionDialogAsync"
                         OpenLinkedProject="OpenLinkedProjectAsync" />

<OpportunityEditDialog IsOpen="@isOpportunityEditDialogOpen"
                       Opportunity="SelectedOpportunity"
                       IsBusy="isOpportunityBusy"
                       Message="@(isOpportunityEditDialogOpen ? message : null)"
                       Save="SaveOpportunityAsync"
                       Close="CloseOpportunityEditDialogAsync"
                       LoadFailed="HandleOpportunityPickerLoadFailedAsync" />

<OpportunityConversionDialog IsOpen="@isOpportunityConversionDialogOpen"
                             Opportunity="SelectedOpportunity"
                             Model="opportunityConversionEditor"
                             IsBusy="isOpportunityConversionBusy"
                             Message="@(isOpportunityConversionDialogOpen ? message : null)"
                             Close="CloseOpportunityConversionDialogAsync"
                             Save="SaveOpportunityConversionAsync"
                             LoadFailed="HandleOpportunityPickerLoadFailedAsync" />

<PartyRecordPickerDialog IsOpen="@stakeholderPartyPickerIndex.HasValue"
                         SelectedPartyId="@SelectedStakeholderPartyId"
                         ExcludedPartyId="selectedAccount?.AccountPartyId"
                         SelectionConfirmed="ConfirmStakeholderPartyAsync"
                         OnClose="CloseStakeholderPartyPickerAsync"
                         LoadFailed="HandleOpportunityPickerLoadFailedAsync"
                         Eyebrow="Account stakeholders"
                         Title="Choose a stakeholder"
                         Subtitle="Search and page through the shared party directory."
                         DataTestId="crmhr-stakeholder-party-picker" />

<CrmAgentChatContextProvider AccountCount="accountCount"
                             Account="agentChatAccountContext"
                             Opportunity="agentChatOpportunityContext"
                             Interaction="agentChatInteractionContext"
                             ContextNavigationIdentity="@AgentChatNavigationFence"
                             ContextAccessState="@agentChatContextAccessState"
                             RefreshRequested="HandleAgentChatRefreshRequestedAsync" />

@code {
    [SupplyParameterFromQuery(Name = "accountId")]
    public Guid? AccountIdQuery { get; set; }

    [SupplyParameterFromQuery(Name = "opportunityId")]
    public Guid? OpportunityIdQuery { get; set; }

    [SupplyParameterFromQuery(Name = "interactionId")]
    public Guid? InteractionIdQuery { get; set; }

    private readonly Dictionary<Guid, string> stakeholderPartyLabels = [];
    private CrmAccountWorkspaceModel? selectedAccount;
    private CrmInteractionDetailModel? selectedInteraction;
    private CrmOpportunityDetailModel? selectedOpportunity;
    private CrmActivityHistoryPage accountActivityPage = CrmActivityHistoryPage.Empty();
    private CrmAccountProfileEditorModel profileEditor = new();
    private List<CrmAccountStakeholderEditorModel> stakeholderEditors = [];
    private CrmInteractionEditorModel interactionEditor = CreateInteractionEditor();
    private CrmOpportunityEditorModel opportunityEditor = new();
    private CrmOpportunityConversionEditorModel opportunityConversionEditor = new();
    private CrmAgentChatAccountContext? agentChatAccountContext;
    private CrmAgentChatOpportunityContext? agentChatOpportunityContext;
    private CrmAgentChatInteractionContext? agentChatInteractionContext;
    private AgentChatContextAccessState agentChatContextAccessState = AgentChatContextAccessState.Loading;
    private int accountCount;
    private Guid? selectedOpportunityId;
    private Guid? selectedInteractionId;
    private Guid? accountActivityLoadedPartyId;
    private int? stakeholderPartyPickerIndex;
    private CrmRecordTab selectedCrmRecordTab = CrmRecordTab.Overview;
    private string? committedQueryKey;
    private readonly CrmQueryLoadGeneration queryLoadGeneration = new();
    private CrmQueryLoadStamp? activeQueryLoadStamp;
    private CancellationTokenSource? queryLoadCancellation;
    private long transientStateGeneration;
    private long accountActivityLoadGeneration;
    private Task? accountActivityLoadTask;
    private string? message;
    private long opportunityPipelineRefreshVersion;
    private bool isOpportunityBusy;
    private bool isOpportunityCreateDialogOpen;
    private bool isOpportunityDetailDialogOpen;
    private bool isOpportunityEditDialogOpen;
    private bool isOpportunityConversionDialogOpen;
    private bool isOpportunityConversionBusy;
    private bool isAccountActivityLoading;
    private bool isDisposed;
    private string accountActivityLoadError = string.Empty;

    private int SelectedCrmRecordTabIndex => (int)selectedCrmRecordTab;

    private IReadOnlyList<PartyOptionModel> ParticipantOptions
        => selectedAccount is null
            ? []
            : selectedAccount.StakeholderParties
                .Where(option => stakeholderEditors.Any(stakeholder => stakeholder.RelatedPartyId == option.Id))
                .ToList();

    private CrmOpportunityDetailModel? SelectedOpportunity
        => selectedOpportunity?.Id == selectedOpportunityId
            ? selectedOpportunity
            : null;

    private Guid? SelectedStakeholderPartyId
        => stakeholderPartyPickerIndex is int index &&
           index >= 0 &&
           index < stakeholderEditors.Count &&
           stakeholderEditors[index].RelatedPartyId != Guid.Empty
            ? stakeholderEditors[index].RelatedPartyId
            : null;

    private CrmInteractionDetailModel? SelectedInteraction
        => selectedInteraction?.Id == selectedInteractionId
            ? selectedInteraction
            : null;

    private AgentChatNavigationIdentity AgentChatNavigationFence
        => AgentChatNavigationIdentity.CreateForLocation(
            Navigation.BaseUri,
            Navigation.Uri,
            [
                new("accountId", AccountIdQuery?.ToString("D")),
                new("opportunityId", OpportunityIdQuery?.ToString("D")),
                new("interactionId", InteractionIdQuery?.ToString("D"))
            ]);

    protected override async Task OnParametersSetAsync()
    {
        var requestedAccountId = AccountIdQuery;
        var requestedOpportunityId = OpportunityIdQuery;
        var requestedInteractionId = InteractionIdQuery;
        var queryKey = BuildQueryKey(
            requestedAccountId,
            requestedOpportunityId,
            requestedInteractionId);
        var capturedSelectedAccountId = selectedAccount?.AccountPartyId;
        var capturedSelectedOpportunityId = selectedOpportunityId;
        var loadGeneration = BeginQueryLoad(queryKey, resetTransientState: true);
        using var loadCancellation = new CancellationTokenSource();
        var supersededLoad = Interlocked.Exchange(ref queryLoadCancellation, loadCancellation);
        supersededLoad?.Cancel();
        try
        {
            if (committedQueryKey is not null &&
                !string.Equals(committedQueryKey, queryKey, StringComparison.Ordinal))
            {
                agentChatAccountContext = null;
                agentChatOpportunityContext = null;
                agentChatInteractionContext = null;
                await InvokeAsync(StateHasChanged);
            }

            var accountCountTask = CrmService.CountAccountsAsync(loadCancellation.Token);
            var routeResolutionTask = CrmService.ResolveRouteSelectionAsync(
                requestedAccountId,
                requestedOpportunityId,
                requestedInteractionId,
                loadCancellation.Token);
            await Task.WhenAll(accountCountTask, routeResolutionTask);
            accountCount = await accountCountTask;
            var routeResolution = await routeResolutionTask;
            if (!IsCurrentQueryLoad(loadGeneration))
            {
                return;
            }

            committedQueryKey = queryKey;
            if (!routeResolution.IsResolved)
            {
                ClearAccountSelection();
                message = null;
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
                return;
            }

            var targetId = routeResolution.AccountPartyId;
            CrmAccountWorkspaceModel? account = null;
            if (targetId.HasValue)
            {
                account = await CrmService.GetAccountWorkspaceAsync(
                    targetId.Value,
                    loadCancellation.Token);
                if (!IsCurrentQueryLoad(loadGeneration))
                {
                    return;
                }
            }

            if (account is null)
            {
                ClearAccountSelection();
                message = null;
                agentChatContextAccessState = requestedAccountId.HasValue ||
                                                  requestedOpportunityId.HasValue ||
                                                  requestedInteractionId.HasValue
                    ? AgentChatContextAccessState.Failed
                    : AgentChatContextAccessState.Ready;
                return;
            }

            var interaction = requestedInteractionId.HasValue
                ? await CrmService.GetAccountInteractionAsync(
                    account.AccountPartyId,
                    requestedInteractionId.Value,
                    loadCancellation.Token)
                : null;
            if (!IsCurrentQueryLoad(loadGeneration))
            {
                return;
            }

            var relatedInteractionOpportunityId = interaction?.RelatedOpportunityId;
            var preferredOpportunityId = requestedOpportunityId ??
                                         relatedInteractionOpportunityId ??
                                         (capturedSelectedAccountId == account.AccountPartyId
                                             ? capturedSelectedOpportunityId
                                             : null);
            var opportunity = await LoadOpportunityForAccountAsync(
                preferredOpportunityId,
                account.AccountPartyId,
                loadCancellation.Token);
            if (!IsCurrentQueryLoad(loadGeneration))
            {
                return;
            }

            ApplyLoadedAccount(
                account,
                opportunity,
                interaction,
                clearMessage: true,
                requestedOpportunityId,
                preferredOpportunityId,
                requestedInteractionId);
            SelectCrmRecordTabForRoute(
                account.AccountPartyId,
                capturedSelectedAccountId,
                requestedOpportunityId,
                requestedInteractionId);
            if (selectedCrmRecordTab == CrmRecordTab.Interactions)
            {
                await EnsureAccountActivityLoadedAsync();
            }
            var requestedSelectionFound =
                (!requestedOpportunityId.HasValue ||
                 selectedOpportunityId == requestedOpportunityId) &&
                (!requestedInteractionId.HasValue ||
                 selectedInteractionId == requestedInteractionId);
            agentChatContextAccessState = requestedSelectionFound
                ? AgentChatContextAccessState.Ready
                : AgentChatContextAccessState.Failed;
        }
        catch (OperationCanceledException) when (loadCancellation.IsCancellationRequested)
        {
        }
        catch when (!IsCurrentQueryLoad(loadGeneration))
        {
        }
        catch
        {
            agentChatContextAccessState = AgentChatContextAccessState.Failed;
            throw;
        }
        finally
        {
            Interlocked.CompareExchange(
                ref queryLoadCancellation,
                null,
                loadCancellation);
        }
    }

    private CrmQueryLoadStamp BeginQueryLoad(string queryKey, bool resetTransientState)
    {
        if (resetTransientState)
        {
            Interlocked.Increment(ref transientStateGeneration);
            isOpportunityBusy = false;
            isOpportunityConversionBusy = false;
            isOpportunityCreateDialogOpen = false;
            isOpportunityDetailDialogOpen = false;
            isOpportunityEditDialogOpen = false;
            isOpportunityConversionDialogOpen = false;
        }

        agentChatContextAccessState = AgentChatContextAccessState.Loading;
        var stamp = queryLoadGeneration.Begin(queryKey);
        activeQueryLoadStamp = stamp;
        return stamp;
    }

    private async Task<CrmOpportunityDetailModel?> LoadOpportunityForAccountAsync(
        Guid? opportunityId,
        Guid accountPartyId,
        CancellationToken cancellationToken)
    {
        if (!opportunityId.HasValue)
        {
            return null;
        }

        var opportunity = await CrmService.GetOpportunityAsync(
            opportunityId.Value,
            cancellationToken);
        return opportunity?.AccountPartyId == accountPartyId
            ? opportunity
            : null;
    }

    private void ApplyLoadedAccount(
        CrmAccountWorkspaceModel account,
        CrmOpportunityDetailModel? opportunity,
        CrmInteractionDetailModel? interaction,
        bool clearMessage,
        Guid? requestedOpportunityId,
        Guid? preferredOpportunityId,
        Guid? requestedInteractionId)
    {
        InvalidateAccountActivity();
        selectedAccount = account;
        selectedOpportunity = opportunity;
        selectedInteraction = interaction;
        profileEditor = new CrmAccountProfileEditorModel
        {
            Id = account.Profile.Id,
            AccountPartyId = account.Profile.AccountPartyId,
            RelationshipStage = account.Profile.RelationshipStage,
            CommercialNotes = account.Profile.CommercialNotes,
            ConstraintNotes = account.Profile.ConstraintNotes,
            TimingRiskNotes = account.Profile.TimingRiskNotes,
            LastChangedBy = account.Profile.LastChangedBy
        };
        stakeholderEditors = account.Stakeholders
            .Select(item => new CrmAccountStakeholderEditorModel
            {
                Id = item.Id,
                RelatedPartyId = item.RelatedPartyId,
                Role = item.Role,
                IsPrimary = item.IsPrimary,
                Notes = item.Notes
            })
            .ToList();
        stakeholderPartyLabels.Clear();
        foreach (var stakeholder in account.Stakeholders)
        {
            stakeholderPartyLabels[stakeholder.RelatedPartyId] =
                $"{stakeholder.DisplayName} ({stakeholder.PartyType})";
        }

        stakeholderPartyPickerIndex = null;
        ApplyContextSelection(
            requestedOpportunityId,
            preferredOpportunityId,
            requestedInteractionId);

        if (clearMessage)
        {
            message = null;
        }
    }

    private async Task<bool> ReloadSelectedAccountAsync(
        CrmPageActionStamp action,
        bool clearMessage,
        Guid? preferredOpportunityId = null)
    {
        if (!IsCurrentCrmAction(action))
        {
            return false;
        }

        var queryKey = BuildQueryKey(
            action.RouteAccountId,
            action.RouteOpportunityId,
            action.RouteInteractionId);
        var loadGeneration = BeginQueryLoad(queryKey, resetTransientState: false);
        using var loadCancellation = new CancellationTokenSource();
        var supersededLoad = Interlocked.Exchange(ref queryLoadCancellation, loadCancellation);
        supersededLoad?.Cancel();
        try
        {
            var account = await CrmService.GetAccountWorkspaceAsync(
                action.AccountId,
                loadCancellation.Token);
            if (!IsCurrentAccountRefresh(loadGeneration, action))
            {
                return false;
            }

            committedQueryKey = queryKey;
            if (account is null)
            {
                ClearAccountSelection();
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
                return false;
            }

            var targetOpportunityId = preferredOpportunityId ??
                                      action.SelectedOpportunityId ??
                                      action.RouteOpportunityId;
            var opportunity = await LoadOpportunityForAccountAsync(
                targetOpportunityId,
                account.AccountPartyId,
                loadCancellation.Token);
            if (!IsCurrentAccountRefresh(loadGeneration, action))
            {
                return false;
            }

            var interaction = action.RouteInteractionId.HasValue
                ? await CrmService.GetAccountInteractionAsync(
                    account.AccountPartyId,
                    action.RouteInteractionId.Value,
                    loadCancellation.Token)
                : null;
            if (!IsCurrentAccountRefresh(loadGeneration, action))
            {
                return false;
            }

            ApplyLoadedAccount(
                account,
                opportunity,
                interaction,
                clearMessage,
                action.RouteOpportunityId,
                preferredOpportunityId ?? action.SelectedOpportunityId,
                action.RouteInteractionId);
            if (selectedCrmRecordTab == CrmRecordTab.Interactions)
            {
                await EnsureAccountActivityLoadedAsync();
            }
            var requestedSelectionFound =
                (!action.RouteOpportunityId.HasValue ||
                 selectedOpportunityId == action.RouteOpportunityId) &&
                (!action.RouteInteractionId.HasValue ||
                 selectedInteractionId == action.RouteInteractionId);
            agentChatContextAccessState = requestedSelectionFound
                ? AgentChatContextAccessState.Ready
                : AgentChatContextAccessState.Failed;
            return requestedSelectionFound;
        }
        catch (OperationCanceledException) when (loadCancellation.IsCancellationRequested)
        {
            return false;
        }
        catch when (!IsCurrentAccountRefresh(loadGeneration, action))
        {
            return false;
        }
        catch
        {
            agentChatContextAccessState = AgentChatContextAccessState.Failed;
            throw;
        }
        finally
        {
            Interlocked.CompareExchange(
                ref queryLoadCancellation,
                null,
                loadCancellation);
        }
    }

    private bool TryCaptureCrmAction(out CrmPageActionStamp action)
    {
        action = default;
        if (agentChatContextAccessState != AgentChatContextAccessState.Ready ||
            activeQueryLoadStamp is not CrmQueryLoadStamp loadStamp ||
            selectedAccount is not { } account ||
            !IsCurrentQueryLoad(loadStamp))
        {
            return false;
        }

        action = new CrmPageActionStamp(
            loadStamp,
            AccountIdQuery,
            OpportunityIdQuery,
            InteractionIdQuery,
            account.AccountPartyId,
            selectedOpportunityId,
            selectedInteractionId);
        return IsCurrentCrmAction(action);
    }

    private bool IsCurrentCrmAction(CrmPageActionStamp action)
        => IsCurrentQueryLoad(action.LoadStamp) &&
           AccountIdQuery == action.RouteAccountId &&
           OpportunityIdQuery == action.RouteOpportunityId &&
           InteractionIdQuery == action.RouteInteractionId &&
           selectedAccount?.AccountPartyId == action.AccountId &&
           selectedOpportunityId == action.SelectedOpportunityId &&
           selectedInteractionId == action.SelectedInteractionId;

    private bool IsCurrentAccountRefresh(
        CrmQueryLoadStamp loadStamp,
        CrmPageActionStamp action)
        => IsCurrentQueryLoad(loadStamp) &&
           AccountIdQuery == action.RouteAccountId &&
           OpportunityIdQuery == action.RouteOpportunityId &&
           InteractionIdQuery == action.RouteInteractionId &&
           selectedAccount?.AccountPartyId == action.AccountId &&
           selectedOpportunityId == action.SelectedOpportunityId &&
           selectedInteractionId == action.SelectedInteractionId;

    private async Task HandleCrmRecordTabChanged(int selectedIndex)
    {
        var requestedTab = (CrmRecordTab)selectedIndex;
        if (!Enum.IsDefined(requestedTab))
        {
            return;
        }

        selectedCrmRecordTab = requestedTab;
        if (requestedTab == CrmRecordTab.Interactions)
        {
            await EnsureAccountActivityLoadedAsync();
        }
    }

    private async Task EnsureAccountActivityLoadedAsync()
    {
        if (selectedAccount is not { } account ||
            accountActivityLoadedPartyId == account.AccountPartyId)
        {
            return;
        }

        var accountPartyId = account.AccountPartyId;
        var generation = Volatile.Read(ref accountActivityLoadGeneration);
        if (accountActivityLoadTask is null)
        {
            isAccountActivityLoading = true;
            accountActivityLoadError = string.Empty;
            accountActivityLoadTask = LoadAccountActivityAsync(
                accountPartyId,
                pageIndex: 0,
                generation);
        }

        await accountActivityLoadTask;
    }

    private async Task LoadAccountActivityAsync(
        Guid accountPartyId,
        int pageIndex,
        long generation)
    {
        try
        {
            var page = await CrmService.SearchAccountActivityAsync(
                new CrmActivityHistoryQuery(
                    accountPartyId,
                    pageIndex,
                    accountActivityPage.PageSize));
            if (!IsCurrentAccountActivityLoad(accountPartyId, generation))
            {
                return;
            }

            accountActivityPage = page;
            accountActivityLoadedPartyId = accountPartyId;
        }
        catch when (!IsCurrentAccountActivityLoad(accountPartyId, generation))
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to load account activity page {PageIndex} for account {AccountPartyId}.",
                pageIndex,
                accountPartyId);
            accountActivityLoadError = "Account activity could not be loaded.";
        }
        finally
        {
            if (IsCurrentAccountActivityLoad(accountPartyId, generation))
            {
                isAccountActivityLoading = false;
                accountActivityLoadTask = null;
            }
        }
    }

    private async Task HandleAccountActivityPageRequestedAsync(int pageIndex)
    {
        if (selectedAccount is not { } account ||
            pageIndex < 0 ||
            pageIndex >= accountActivityPage.TotalPages)
        {
            return;
        }

        isAccountActivityLoading = true;
        accountActivityLoadError = string.Empty;
        await LoadAccountActivityAsync(
            account.AccountPartyId,
            pageIndex,
            Volatile.Read(ref accountActivityLoadGeneration));
    }

    private bool IsCurrentAccountActivityLoad(Guid accountPartyId, long generation)
        => !isDisposed &&
           selectedAccount?.AccountPartyId == accountPartyId &&
           generation == Volatile.Read(ref accountActivityLoadGeneration);

    private async Task RetryAccountActivityAsync()
    {
        InvalidateAccountActivity();
        await EnsureAccountActivityLoadedAsync();
    }

    private void InvalidateAccountActivity()
    {
        Interlocked.Increment(ref accountActivityLoadGeneration);
        accountActivityPage = CrmActivityHistoryPage.Empty();
        accountActivityLoadedPartyId = null;
        accountActivityLoadTask = null;
        isAccountActivityLoading = false;
        accountActivityLoadError = string.Empty;
    }

    private void SelectCrmRecordTabForRoute(
        Guid accountPartyId,
        Guid? previousAccountPartyId,
        Guid? requestedOpportunityId,
        Guid? requestedInteractionId)
    {
        if (requestedOpportunityId.HasValue)
        {
            selectedCrmRecordTab = CrmRecordTab.Opportunities;
            return;
        }

        if (requestedInteractionId.HasValue)
        {
            selectedCrmRecordTab = CrmRecordTab.Interactions;
            return;
        }

        if (previousAccountPartyId != accountPartyId)
        {
            selectedCrmRecordTab = CrmRecordTab.Overview;
        }
    }


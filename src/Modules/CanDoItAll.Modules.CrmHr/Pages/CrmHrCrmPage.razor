    private void ApplyContextSelection(
        Guid? requestedOpportunityId,
        Guid? preferredOpportunityId,
        Guid? requestedInteractionId,
        bool accountChanged)
    {
        if (selectedAccount is null)
        {
            selectedOpportunity = null;
            selectedOpportunityProjectAdmission = null;
            selectedOpportunityId = null;
            selectedInteractionId = null;
            opportunityEditing.Clear();
            interactionAppend.Open(Guid.Empty, CreateInteractionEditor());
            interactionMessage = null;
            conversionEditing.Clear();
            isOpportunityCreateDialogOpen = false;
            isOpportunityDetailDialogOpen = false;
            isOpportunityEditDialogOpen = false;
            isOpportunityConversionDialogOpen = false;
            UpdateAgentChatContext();
            return;
        }

        selectedInteractionId = requestedInteractionId.HasValue &&
                                selectedInteraction?.Id == requestedInteractionId.Value
            ? requestedInteractionId
            : null;
        var targetOpportunityId = requestedOpportunityId ?? preferredOpportunityId;
        if (targetOpportunityId.HasValue &&
            (selectedOpportunity?.Id != targetOpportunityId.Value ||
             selectedOpportunity.AccountPartyId != selectedAccount.AccountPartyId))
        {
            targetOpportunityId = null;
            selectedOpportunity = null;
            selectedOpportunityProjectAdmission = null;
        }

        selectedOpportunityId = targetOpportunityId;
        var initialOpportunity = SelectedOpportunity is null
            ? new CrmOpportunityEditorModel
            {
                AccountPartyId = selectedAccount.AccountPartyId,
                RelationshipStage = selectedAccount.Profile.RelationshipStage.ToString()
            }
            : OpportunityEditorDrafts.FromDetail(SelectedOpportunity);
        if (!isOpportunityCreateDialogOpen && !isOpportunityEditDialogOpen) {
            opportunityEditing.State.Reset(initialOpportunity);
        }
        // The new-interaction draft shows its related opportunity as a field: it follows the selection until the
        // operator chooses one, and a draft the operator started keeps its text either way.
        if (accountChanged) {
            interactionAppend.Open(selectedAccount.AccountPartyId,
                CreateInteractionEditor(selectedOpportunityId ?? SelectedInteraction?.RelatedOpportunityId));
            interactionMessage = null;
        } else {
            interactionAppend.SetOpportunityContext(selectedOpportunityId ?? SelectedInteraction?.RelatedOpportunityId);
        }
        if (!isOpportunityConversionDialogOpen) {
            conversionEditing.Clear();
            opportunityConversion.Open(CreateOpportunityConversionEditor(SelectedOpportunity, selectedOpportunityProjectAdmission));
        }
        isOpportunityDetailDialogOpen =
            !isOpportunityCreateDialogOpen && !isOpportunityEditDialogOpen && requestedOpportunityId.HasValue &&
            SelectedOpportunity is not null;
        UpdateAgentChatContext();
    }

    private void UpdateAgentChatContext()
    {
        if (selectedAccount is null)
        {
            agentChatAccountContext = null;
            agentChatOpportunityContext = null;
            agentChatInteractionContext = null;
            return;
        }

        agentChatAccountContext = new CrmAgentChatAccountContext(
            selectedAccount.AccountPartyId,
            selectedAccount.DisplayName,
            selectedAccount.LifecycleStatus,
            selectedAccount.Profile.RelationshipStage,
            selectedAccount.Roles);
        var opportunity = SelectedOpportunity;
        agentChatOpportunityContext = opportunity is null
            ? null
            : new CrmAgentChatOpportunityContext(
                selectedAccount.AccountPartyId,
                opportunity.Id,
                opportunity.Title,
                opportunity.Stage,
                opportunity.OpportunitySource,
                opportunity.Parties.Select(party => party.Role));
        var interaction = SelectedInteraction;
        agentChatInteractionContext = interaction is null
            ? null
            : new CrmAgentChatInteractionContext(
                selectedAccount.AccountPartyId,
                interaction.Id,
                interaction.Subject,
                interaction.InteractionType,
                interaction.RelatedOpportunityId);
    }

    private bool IsCurrentQueryLoad(CrmQueryLoadStamp loadGeneration)
    {
        return !isDisposed &&
               queryLoadGeneration.IsCurrent(
                   loadGeneration,
                   BuildQueryKey(
                       url.State.AccountId,
                       url.State.OpportunityId,
                       url.State.InteractionId));
    }

    // Retires the current load and every transient action before the page moves to another location. A move within
    // the open account keeps its dialog on screen while the account reloads.
    private void InvalidateCurrentQueryForNavigation(bool closeAccount)
    {
        queryLoadGeneration.Invalidate();
        activeQueryLoadStamp = null;
        Interlocked.Exchange(ref queryLoadCancellation, null)?.Cancel();
        Interlocked.Increment(ref transientStateGeneration);
        isOpportunityBusy = false;
        conversionEditing.Clear();
        isOpportunityCreateDialogOpen = false;
        isOpportunityDetailDialogOpen = false;
        isOpportunityEditDialogOpen = false;
        isOpportunityConversionDialogOpen = false;
        if (closeAccount)
        {
            isAccountDialogOpen = false;
        }

        agentChatAccountContext = null;
        agentChatOpportunityContext = null;
        agentChatInteractionContext = null;
        agentChatContextAccessState = AgentChatContextAccessState.Loading;
    }

    // The identity the location names stays in the location and no other record takes its place.
    private void NotifyRouteRecordUnavailable()
        => NotificationService.Warning(
            "CRM record unavailable",
            "The requested account, opportunity or interaction does not exist or is no longer available.");

    private static string BuildQueryKey(
        Guid? accountId,
        Guid? opportunityId,
        Guid? interactionId)
        => $"{accountId?.ToString("N") ?? "none"}:" +
           $"{opportunityId?.ToString("N") ?? "none"}:" +
           $"{interactionId?.ToString("N") ?? "none"}";


    private async Task SaveOpportunityAsync()
    {
        if (!TryCaptureCrmAction(out var action))
        {
            return;
        }

        var transientGeneration = Interlocked.Increment(ref transientStateGeneration);
        isOpportunityBusy = true;
        try
        {
            opportunityEditor.AccountPartyId = action.AccountId;
            opportunityEditor.RelationshipStage = profileEditor.RelationshipStage.ToString();
            opportunityEditor.LastChangedBy = profileEditor.LastChangedBy;

            var result = await CrmService.SaveOpportunityAsync(opportunityEditor);
            if (result.IsFailure)
            {
                if (IsCurrentCrmAction(action))
                {
                    NotifyError("Opportunity save failed", string.Join(" ", result.Errors.Select(error => error.Message)));
                }

                return;
            }

            if (!await ReloadSelectedAccountAsync(
                    action,
                    clearMessage: false,
                    preferredOpportunityId: result.Value))
            {
                return;
            }

            NotifySuccess("Opportunity saved", "Opportunity saved.");
        }
        finally
        {
            if (transientGeneration == Volatile.Read(ref transientStateGeneration))
            {
                isOpportunityBusy = false;
            }
        }
    }

    private async Task AdvanceOpportunityStageAsync(Guid opportunityId)
    {
        if (selectedAccount is null)
        {
            return;
        }

        var opportunity = selectedAccount.Opportunities.FirstOrDefault(item => item.Id == opportunityId);
        if (opportunity is null)
        {
            return;
        }

        opportunityEditor = CreateOpportunityEditor(selectedAccount, opportunity);
        opportunityEditor.Stage = ResolveNextOpportunityStage(opportunity.Stage);
        opportunityEditor.StageNotes = $"Advanced from {opportunity.Stage} to {opportunityEditor.Stage}.";
        selectedOpportunityId = opportunityId;
        await SaveOpportunityAsync();
    }


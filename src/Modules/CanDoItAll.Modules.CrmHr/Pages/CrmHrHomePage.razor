@page "/crm-hr"
@inject PartyDirectoryService PartyDirectoryService
@inject CrmService CrmService
@inject HrService HrService
@inject AiAgentService AiAgentService
@inject NavigationManager Navigation

<PageTitle>CRM / HR</PageTitle>

<PageScaffold MaxWidthClass="max-w-full">
    <Header>
        <PageHeader Eyebrow="CRM / HR"
                    Title="Unified relationship and workforce workspace"
                    Description="Track people, organizations, delivery units, recruiting, and AI agents in one module shell without leaving the core application."
                    Compact="true">
            <Stats>
                <CompactStat Label="parties"
                             Value="@directoryItems.Count.ToString()"
                             TooltipText="Unified directory records across CRM and HR." />
                <CompactStat Label="organizations"
                             Value="@directoryItems.Count(item => item.PartyType == PartyType.Organization || item.PartyType == PartyType.OrganizationUnit).ToString()"
                             TooltipText="Accounts, legal entities, and delivery units."
                             Tone="info" />
                <CompactStat Label="pipeline"
                             Value="@opportunities.Count.ToString()"
                             TooltipText="Tracked opportunities in the shared CRM workspace." />
                <CompactStat Label="workforce"
                             Value="@workforceProfiles.Count.ToString()"
                             TooltipText="People and delivery supply profiles."
                             Tone="success" />
                <CompactStat Label="agents"
                             Value="@agentProfiles.Count.ToString()"
                             TooltipText="AI agents represented in the same staffing surface."
                             Tone="warning" />
            </Stats>
            <Actions>
                <PageHeaderActionButton Icon="asset"
                                        Label="Open directory"
                                        TooltipText="Open the CRM-HR party directory."
                                        ButtonStyle="ButtonStyle.Primary"
                                        Click="OpenDirectory"
                                        data-testid="crmhr-home-open-directory" />
            </Actions>
        </PageHeader>
    </Header>

    <ChildContent>
        <Stack GapScale="LayoutGap.Large">
            <CrmHrSecondaryTabs SelectedKey="home" />

            <Grid Gap="LayoutGap.Large" ColumnsLg="2">
                <SurfaceCard>
                    <p class="cda-eyebrow">Directory focus</p>
                    <h2 class="mt-1 text-lg font-semibold text-slate-950">One party model, multiple operating contexts</h2>
                    <p class="mt-3 text-sm leading-6 text-slate-600">
                        Start from the directory when you need to create or maintain a shared party record before CRM, HR, recruiting, or assignments branch into specialized flows.
                    </p>

                    <Stack GapScale="LayoutGap.Small" Class="mt-5">
                        @foreach (var item in directoryItems.Take(5))
                        {
                            <div class="rounded-[1.25rem] border border-slate-200 bg-slate-50/90 px-4 py-3">
                                <Split Gap="LayoutGap.Small">
                                    <div class="min-w-0">
                                        <p class="text-sm font-semibold text-slate-950">@item.DisplayName</p>
                                        <p class="mt-1 text-xs uppercase tracking-[0.18em] text-slate-500">@item.PartyType / @item.LifecycleStatus</p>
                                        @if (!string.IsNullOrWhiteSpace(item.Summary))
                                        {
                                            <p class="mt-2 text-sm leading-6 text-slate-600">@item.Summary</p>
                                        }
                                    </div>
                                    @if (item.IsSensitive)
                                    {
                                        <StatusBadge Tone="warning" Text="Sensitive" />
                                    }
                                </Split>
                            </div>
                        }
                    </Stack>

                    @if (directoryItems.Count == 0)
                    {
                        <div class="mt-5">
                            <EmptyState Eyebrow="No parties"
                                        Title="Create the first shared party record"
                                        Description="The directory shell is ready. Add a person, organization, unit, or AI agent record to unlock downstream CRM and HR flows.">
                                <Actions>
                                    <Button Text="Create party"
                                            Click="OpenDirectory" />
                                </Actions>
                            </EmptyState>
                        </div>
                    }
                </SurfaceCard>

                <SurfaceCard Soft="true">
                    <p class="cda-eyebrow">Route coverage</p>
                    <h2 class="mt-1 text-lg font-semibold text-slate-950">Module entry points</h2>
                    <p class="mt-3 text-sm leading-6 text-slate-600">
                        The B02 shell exposes every planned CRM / HR workspace route now, even where later bundles still need to populate the deeper business flows.
                    </p>

                    <Grid Gap="LayoutGap.Medium" ColumnsSm="2" Class="mt-5">
                        <Button Text="Directory"
                                Click="OpenDirectory" />
                        <Button Text="CRM"
                                ButtonStyle="ButtonStyle.Light"
                                Click="OpenCrm" />
                        <Button Text="Workforce"
                                ButtonStyle="ButtonStyle.Light"
                                Click="OpenWorkforce" />
                        <Button Text="Recruiting"
                                ButtonStyle="ButtonStyle.Light"
                                Click="OpenRecruiting" />
                        <Button Text="Agents"
                                ButtonStyle="ButtonStyle.Light"
                                Click="OpenAgents" />
                        <Button Text="Assignments"
                                ButtonStyle="ButtonStyle.Light"
                                Click="OpenAssignments" />
                    </Grid>

                    <div class="mt-6 rounded-[1.25rem] border border-slate-200 bg-white px-4 py-4">
                        <p class="cda-eyebrow">Current signal</p>
                        <p class="mt-2 text-sm leading-6 text-slate-700">
                            Opportunities: @opportunities.Count. Workforce profiles: @workforceProfiles.Count. Agent profiles: @agentProfiles.Count.
                        </p>
                    </div>
                </SurfaceCard>
            </Grid>

            <div data-testid="crmhr-home-sensitive-card">
                <SurfaceCard Soft="true">
                    <Split Gap="LayoutGap.Medium"
                           AlignItems="AlignItems.Start"
                           JustifyContent="JustifyContent.SpaceBetween">
                        <div class="min-w-0">
                            <p class="cda-eyebrow">Privacy posture</p>
                            <h2 class="mt-1 text-lg font-semibold text-slate-950">Sensitive directory records</h2>
                            <p class="mt-3 text-sm leading-6 text-slate-600">
                                Sensitive parties remain visible to trusted operators in CRM-HR while staying out of the global search surface and keeping confidential notes separated in the directory.
                            </p>
                        </div>
                        <Cluster Gap="LayoutGap.Small">
                            <StatusBadge Tone="warning" Text="@($"{SensitiveCount} sensitive record(s)")" />
                            <Button Text="Open directory"
                                    ButtonStyle="ButtonStyle.Light"
                                    Size="ButtonSize.Small"
                                    Click="OpenDirectory"
                                    data-testid="crmhr-home-sensitive-open-directory" />
                        </Cluster>
                    </Split>

                    @if (SensitivePreview.Count == 0)
                    {
                        <p class="mt-5 text-sm leading-6 text-slate-600">No sensitive parties are currently flagged in the shared directory.</p>
                    }
                    else
                    {
                        <Stack GapScale="LayoutGap.Small" Class="mt-5">
                            @foreach (var item in SensitivePreview)
                            {
                                <div class="rounded-[1rem] border border-slate-200 bg-white/90 px-4 py-4">
                                    <Split Gap="LayoutGap.Small"
                                           AlignItems="AlignItems.Start"
                                           JustifyContent="JustifyContent.SpaceBetween">
                                        <div class="min-w-0">
                                            <p class="text-sm font-semibold text-slate-950">@item.DisplayName</p>
                                            <p class="mt-1 text-xs uppercase tracking-[0.18em] text-slate-500">@item.PartyType / @item.LifecycleStatus</p>
                                        </div>
                                        <StatusBadge Tone="warning" Text="Sensitive" />
                                    </Split>
                                </div>
                            }
                        </Stack>
                    }
                </SurfaceCard>
            </div>

            <SurfaceCard>
                <Split Gap="LayoutGap.Medium"
                       AlignItems="AlignItems.Center"
                       JustifyContent="JustifyContent.SpaceBetween">
                    <div>
                        <p class="cda-eyebrow">Open pipeline</p>
                        <h2 class="mt-1 text-lg font-semibold text-slate-950">Recent opportunities</h2>
                        <p class="mt-2 text-sm leading-6 text-slate-600">
                            CRM-18 keeps live opportunity context visible here so project and workforce reviews do not have to reconstruct the commercial pipeline.
                        </p>
                    </div>
                    <Button Text="Open CRM"
                            ButtonStyle="ButtonStyle.Light"
                            Click="OpenCrm" />
                </Split>

                @if (OpenPipelinePreview.Count == 0)
                {
                    <p class="mt-5 text-sm leading-6 text-slate-600">No open opportunities are currently tracked.</p>
                }
                else
                {
                    <Grid Gap="LayoutGap.Medium" ColumnsLg="2" Class="mt-5">
                        @foreach (var opportunity in OpenPipelinePreview)
                        {
                            <div class="rounded-[1.25rem] border border-slate-200 bg-slate-50/80 px-4 py-4"
                                 data-testid="crmhr-home-opportunity-item">
                                <Split Gap="LayoutGap.Medium"
                                       AlignItems="AlignItems.Start"
                                       JustifyContent="JustifyContent.SpaceBetween">
                                    <div class="min-w-0">
                                        <p class="text-sm font-semibold text-slate-950">@opportunity.Title</p>
                                        <p class="mt-1 text-xs uppercase tracking-[0.18em] text-slate-500">
                                            @opportunity.AccountDisplayName / @opportunity.Stage / @opportunity.OpportunitySource
                                        </p>
                                        <p class="mt-2 text-sm text-slate-600">Owner: @opportunity.OwnerDisplayName</p>
                                        @if (opportunity.Amount.HasValue)
                                        {
                                            <p class="mt-1 text-sm text-slate-600">
                                                @($"{opportunity.Amount.Value:0.##}") / @($"{opportunity.ProbabilityPercent}%")
                                            </p>
                                        }
                                    </div>
                                    <Button Text="Open"
                                            Size="ButtonSize.Small"
                                            Click="@(() => OpenCrmOpportunity(opportunity.AccountPartyId, opportunity.Id))" />
                                </Split>
                            </div>
                        }
                    </Grid>
                }
            </SurfaceCard>
        </Stack>
    </ChildContent>
</PageScaffold>

@code {
    private IReadOnlyList<PartyDirectoryListItemModel> directoryItems = [];
    private IReadOnlyList<OpportunitySummaryModel> opportunities = [];
    private IReadOnlyList<WorkforceProfileSummaryModel> workforceProfiles = [];
    private IReadOnlyList<AiAgentProfileSummaryModel> agentProfiles = [];

    private IReadOnlyList<OpportunitySummaryModel> OpenPipelinePreview => opportunities
        .Where(item => item.Stage is not OpportunityStage.Won and not OpportunityStage.Lost)
        .OrderBy(item => item.ExpectedCloseOn ?? DateOnly.MaxValue)
        .ThenByDescending(item => item.UpdatedAtUtc)
        .Take(6)
        .ToList();

    private IReadOnlyList<PartyDirectoryListItemModel> SensitivePreview => directoryItems
        .Where(item => item.IsSensitive)
        .OrderByDescending(item => item.UpdatedAtUtc)
        .Take(3)
        .ToList();

    private int SensitiveCount => directoryItems.Count(item => item.IsSensitive);

    protected override async Task OnInitializedAsync()
    {
        directoryItems = await PartyDirectoryService.ListDirectoryAsync();
        opportunities = await CrmService.ListOpportunitiesAsync();
        workforceProfiles = await HrService.ListWorkforceProfilesAsync();
        agentProfiles = await AiAgentService.ListAgentProfilesAsync();
    }

    private void OpenDirectory()
    {
        Navigation.NavigateTo("/crm-hr/directory");
    }

    private void OpenCrm()
    {
        Navigation.NavigateTo("/crm-hr/crm");
    }

    private void OpenCrmOpportunity(Guid accountPartyId, Guid opportunityId)
    {
        Navigation.NavigateTo($"/crm-hr/crm?accountId={accountPartyId}&opportunityId={opportunityId}");
    }

    private void OpenWorkforce()
    {
        Navigation.NavigateTo("/crm-hr/workforce");
    }

    private void OpenRecruiting()
    {
        Navigation.NavigateTo("/crm-hr/recruiting");
    }

    private void OpenAgents()
    {
        Navigation.NavigateTo("/crm-hr/agents");
    }

    private void OpenAssignments()
    {
        Navigation.NavigateTo("/crm-hr/assignments");
    }
}

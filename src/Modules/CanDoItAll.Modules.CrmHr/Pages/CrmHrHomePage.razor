@page "/crm-hr"
@implements IDisposable
@inject ICrmHrHomeQueryService HomeQueryService
@inject NavigationManager Navigation
@inject ILogger<CrmHrHomePage> Logger

<PageTitle>CRM / HR</PageTitle>

<AgentChatContextSurfaceProvider Surface="@AgentChatSurface" />

<CrmHrHomeSurface Presentation="@session.Presentation" Intent="HandleIntentAsync">
    <SecondaryNavigation>
        <CrmHrSecondaryTabs SelectedArea="CrmHrWorkspaceArea.Home" />
    </SecondaryNavigation>
</CrmHrHomeSurface>

@code {
    // Host of the Home overview: it owns the read session, navigation through the route catalogue, the document
    // title and the static agent-context surface. Rendering belongs to CrmHrHomeSurface.
    private static AgentChatContextSurface AgentChatSurface { get; } =
        CrmHrAgentChatSurfaceBuilder.BuildHomeSurface();

    private CrmHrHomeReadSession session = default!;
    private bool disposed;

    // Exposed for host tests that inspect the accepted presentation without reflection.
    public CrmHrHomePresentation Presentation => session.Presentation;

    protected override void OnInitialized()
    {
        session = new CrmHrHomeReadSession(HomeQueryService, Logger)
        {
            Changed = RenderAsync
        };
    }

    protected override Task OnInitializedAsync()
        => session.LoadAsync();

    private Task HandleIntentAsync(CrmHrHomeIntent intent)
    {
        switch (intent)
        {
            case CrmHrHomeIntent.Navigate navigate:
                Navigation.NavigateTo(CrmHrRouteCatalog.Get(ToArea(navigate.Destination)).Route);
                return Task.CompletedTask;
            case CrmHrHomeIntent.OpenOpportunity open:
                Navigation.NavigateTo(BuildOpportunityRoute(open.AccountPartyId, open.OpportunityId));
                return Task.CompletedTask;
            case CrmHrHomeIntent.Retry retry:
                return session.RetryAsync(retry.Generation);
            default:
                throw new NotSupportedException($"The Home host does not own the {intent.GetType().Name} intent.");
        }
    }

    // The CRM route with both identifiers; the existing CRM page reads accountId and opportunityId from the query.
    public static string BuildOpportunityRoute(Guid accountPartyId, Guid opportunityId)
        => $"{CrmHrRouteCatalog.Get(CrmHrWorkspaceArea.Crm).Route}?accountId={accountPartyId:D}&opportunityId={opportunityId:D}";

    private static CrmHrWorkspaceArea ToArea(CrmHrHomeDestination destination)
        => destination switch
        {
            CrmHrHomeDestination.Directory => CrmHrWorkspaceArea.Directory,
            CrmHrHomeDestination.Crm => CrmHrWorkspaceArea.Crm,
            CrmHrHomeDestination.Workforce => CrmHrWorkspaceArea.Workforce,
            CrmHrHomeDestination.Recruiting => CrmHrWorkspaceArea.Recruiting,
            CrmHrHomeDestination.Agents => CrmHrWorkspaceArea.Agents,
            CrmHrHomeDestination.Assignments => CrmHrWorkspaceArea.Assignments,
            _ => throw new ArgumentOutOfRangeException(nameof(destination), destination, "Unknown CRM / HR Home destination.")
        };

    private async Task RenderAsync()
    {
        if (disposed)
        {
            return;
        }

        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception) when (disposed)
        {
            // The page went away while the render was queued; there is nothing left to show.
        }
    }

    public void Dispose()
    {
        if (disposed)
        {
            return;
        }

        disposed = true;
        session.Dispose();
    }
}

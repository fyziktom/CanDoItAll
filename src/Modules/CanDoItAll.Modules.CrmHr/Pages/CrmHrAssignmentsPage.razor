@page "/crm-hr/assignments"
@implements IAsyncDisposable
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Modules.Projects
@using Microsoft.Extensions.Logging
@inject ProjectsService ProjectsService
@inject ProjectPartyIntegrationService ProjectPartyIntegrationService
@inject IProjectNodeDetailsBridge ProjectNodeDetailsBridge
@inject HrService HrService
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject Microsoft.Extensions.Logging.ILogger<CrmHrAssignmentsPage> Logger

<PageTitle>CRM / HR Assignments</PageTitle>

<AgentChatContextSurfaceProvider Surface="@AgentChatSurface"
                                 ContextNavigationIdentity="@AgentChatNavigationFence"
                                 ContextAccessState="@agentChatContextAccessState" />

<PageScaffold MaxWidthClass="max-w-full">
    <Header>
        <PageHeader Eyebrow="CRM / HR"
                    Title="Assignments workspace"
                    Description="Keep commercial, staffing, and project allocations aligned with the live project portfolio."
                    Compact="true">
            <Stats>
                <CompactStat Label="projects"
                             Value="@projectSummaries.Count.ToString()"
                             TooltipText="Projects currently available for CRM-HR relationship binding." />
                <CompactStat Label="open requests"
                             Value="@staffingDashboard.OpenRequestCount.ToString()"
                             TooltipText="Open staffing demand across the CRM-HR module."
                             Tone="info" />
                <CompactStat Label="open demand"
                             Value="@($"{staffingDashboard.OpenDemandPercent:0.##}%")"
                             TooltipText="Requested allocation still flowing through open staffing requests."
                             Tone="warning" />
                <CompactStat Label="bench"
                             Value="@staffingDashboard.BenchCount.ToString()"
                             TooltipText="Profiles currently available for staffing."
                             Tone="success" />
                <CompactStat Label="overallocated"
                             Value="@staffingDashboard.OverallocatedCount.ToString()"
                             TooltipText="Profiles already exceeding available capacity."
                             Tone="danger" />
            </Stats>
        </PageHeader>
    </Header>

    <ChildContent>
        <Stack GapScale="LayoutGap.Medium">
            <CrmHrSecondaryTabs SelectedKey="assignments" />

            <AssignmentsProjectContextBar Projects="projectSummaries"
                                          SelectedProjectId="selectedProjectId"
                                          SelectedProjectIdChanged="HandleProjectChanged"
                                          AssignmentCount="assignments.Count"
                                          AllocationCount="AllocationAssignments.Count"
                                          StaffingRequestCount="StaffingRequestCount"
                                          OpenStructure="OpenStructure"
                                          OpenGantt="OpenGantt" />

            <Tabs @key="WorkspaceTabsKey"
                  SelectedIndex="@((int)selectedWorkspaceTab)"
                  SelectedIndexChanged="HandleWorkspaceTabChangedAsync"
                  RenderMode="TabRenderMode.Server"
                  Variant="TabsVariant.WorkspaceSecondary"
                  BorderMode="TabsBorderMode.Soft"
                  OverflowMode="TabsOverflowMode.Wrap"
                  AriaLabel="Project assignment workflows"
                  data-testid="crmhr-assignments-workspace-tabs">
                <TabsItem Text="Resource schedule"
                          Icon="view_timeline"
                          BadgeText="@AllocationAssignments.Count.ToString()"
                          data-testid="crmhr-assignments-tab-schedule">
                    <ProjectAssignmentResourceGanttPanel ProjectName="@(SelectedProject?.Name ?? string.Empty)"
                                                         Assignments="AllocationAssignments" />
                </TabsItem>

                <TabsItem Text="Relationships"
                          Icon="hub"
                          BadgeText="@assignments.Count.ToString()"
                          data-testid="crmhr-assignments-tab-relationships">
                    <ProjectPartyAssignmentPanel ProjectName="@(SelectedProject?.Name ?? string.Empty)"
                                                 CanCreate="@(selectedProjectId.HasValue && !isProjectContextLoading)"
                                                 Draft="draftAssignment"
                                                 PartyOptions="partyOptions"
                                                 Assignments="assignments"
                                                 PrepareCreate="PrepareRelationshipCreateAsync"
                                                 SaveDraft="SaveDraftAsync"
                                                 ResetDraft="ResetDraftAsync"
                                                 DeleteAssignment="DeleteAssignmentAsync"
                                                 LoadTaskDetails="LoadTaskDetailsAsync"
                                                 OpenStructure="OpenSelectedProjectStructure"
                                                 OpenGantt="OpenSelectedProjectGantt" />
                </TabsItem>

                <TabsItem Text="Staffing requests"
                          Icon="person_search"
                          BadgeText="@StaffingRequestBadgeText"
                          data-testid="crmhr-assignments-tab-staffing">
                    @if (IsLoading(AssignmentSelectionData.StaffingRequests))
                    {
                        <LoadingState Eyebrow="Staffing requests"
                                      Title="Loading project demand"
                                      Description="Only this tab's staffing records are being loaded." />
                    }
                    else
                    {
                        <StaffingRequestEditor ProjectName="@(SelectedProject?.Name ?? string.Empty)"
                                               CanCreate="@(selectedProjectId.HasValue && !isProjectContextLoading)"
                                               Draft="staffingRequestDraft"
                                               SkillCatalog="skillCatalog"
                                               PartyOptions="partyOptions"
                                               Requests="staffingRequests"
                                               PrepareCreate="PrepareStaffingCreateAsync"
                                               SaveRequest="SaveStaffingRequestAsync"
                                               ResetRequest="ResetStaffingRequestAsync"
                                               DeleteRequest="DeleteStaffingRequestAsync" />
                    }
                </TabsItem>

                <TabsItem Text="Allocations"
                          Icon="groups"
                          BadgeText="@AllocationAssignments.Count.ToString()"
                          data-testid="crmhr-assignments-tab-allocations">
                    <ProjectAllocationEditor Draft="allocationDraft"
                                             ProjectName="@(SelectedProject?.Name ?? string.Empty)"
                                             CanCreate="@(selectedProjectId.HasValue && !isProjectContextLoading)"
                                             PartyOptions="partyOptions"
                                             Allocations="AllocationAssignments"
                                             SkillCatalog="skillCatalog"
                                             Candidates="staffingCandidates"
                                             CandidateSearchText="candidateSearchText"
                                             CandidateSearchTextChanged="HandleCandidateSearchTextChanged"
                                             CandidateSkillFilter="candidateSkillFilter"
                                             CandidateSkillFilterChanged="HandleCandidateSkillFilterChanged"
                                             CandidateAvailabilityFilter="candidateAvailabilityFilter"
                                             CandidateAvailabilityFilterChanged="HandleCandidateAvailabilityFilterChanged"
                                             SearchCandidates="SearchCandidatesAsync"
                                             ResetCandidateFilters="ResetCandidateFiltersAsync"
                                             PrepareCreate="PrepareAllocationCreateAsync"
                                             SaveAllocation="SaveAllocationAsync"
                                             ResetAllocation="ResetAllocationAsync"
                                             DeleteAllocation="DeleteAllocationAsync"
                                             LoadTaskDetails="LoadTaskDetailsAsync"
                                             OpenStructure="OpenSelectedProjectStructure"
                                             OpenGantt="OpenSelectedProjectGantt" />
                </TabsItem>
            </Tabs>
        </Stack>
    </ChildContent>
</PageScaffold>

@code {
    [SupplyParameterFromQuery(Name = "projectId")]
    public Guid? ProjectIdQuery { get; set; }

    private IReadOnlyList<ProjectSummary> projectSummaries = [];
    private IReadOnlyList<ProjectPartyOption> partyOptions = [];
    private IReadOnlyList<ProjectPartyAssignmentDetail> assignments = [];
    private IReadOnlyList<SkillCatalogItemModel> skillCatalog = [];
    private IReadOnlyList<StaffingRequestItemModel> staffingRequests = [];
    private IReadOnlyList<StaffingCandidateItemModel> staffingCandidates = [];
    private StaffingDashboardModel staffingDashboard = new(0, 0m, 0, 0);
    private Guid? selectedProjectId;
    private AssignmentWorkspaceTab selectedWorkspaceTab;
    private AssignmentSelectionData loadedSelectionData;
    private AssignmentSelectionData loadingSelectionData;
    private bool isSelectionDataLoading;
    private bool isProjectContextLoading;
    private bool hasStaffingDashboardLoaded;
    private bool isDisposed;
    private long loadGeneration;
    private CancellationTokenSource? loadCancellation;
    private CancellationTokenSource? selectionLifetimeCancellation;
    private AgentChatContextAccessState agentChatContextAccessState = AgentChatContextAccessState.Loading;
    private string candidateSearchText = string.Empty;
    private string candidateSkillFilter = string.Empty;
    private string candidateAvailabilityFilter = string.Empty;
    private ProjectPartyAssignmentUpsertRequest draftAssignment = CreateProjectAssignmentDraft();
    private ProjectPartyAssignmentUpsertRequest allocationDraft = CreateAllocationDraft();
    private StaffingRequestEditorModel staffingRequestDraft = CreateStaffingRequestDraft();

    private AgentChatContextSurface AgentChatSurface
    {
        get
        {
            if (selectedProjectId is not { } projectId)
            {
                return CrmHrAgentChatSurfaceBuilder.BuildAssignmentsSurface();
            }

            var project = projectSummaries.FirstOrDefault(item => item.Id == projectId);
            return project is null
                ? CrmHrAgentChatSurfaceBuilder.BuildAssignmentsSurface()
                : CrmHrAgentChatSurfaceBuilder.BuildAssignmentsSurface(
                    project.Id,
                    project.Name,
                    project.Status);
        }
    }

    private AgentChatNavigationIdentity AgentChatNavigationFence
        => AgentChatNavigationIdentity.CreateForLocation(
            Navigation.BaseUri,
            Navigation.Uri,
            [
                new("projectId", selectedProjectId?.ToString("D")),
                new("routeProjectId", ProjectIdQuery?.ToString("D"))
            ]);

    private IReadOnlyList<ProjectPartyAssignmentDetail> AllocationAssignments => assignments
        .Where(item =>
            item.AllocationPercent.HasValue
            || item.Role is ProjectPartyAssignmentRole.TeamMember
                or ProjectPartyAssignmentRole.DeliveryUnit
                or ProjectPartyAssignmentRole.Manager
                or ProjectPartyAssignmentRole.AiAgent
                or ProjectPartyAssignmentRole.Reviewer
                or ProjectPartyAssignmentRole.WorkItemAssignee)
        .OrderByDescending(item => item.IsPrimary)
        .ThenBy(item => item.PartyDisplayName, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private WorkspaceTabsIdentity WorkspaceTabsKey => new(
        selectedProjectId,
        assignments.Count,
        AllocationAssignments.Count,
        staffingRequests.Count,
        loadedSelectionData.HasFlag(AssignmentSelectionData.StaffingRequests));

    private int? StaffingRequestCount => loadedSelectionData.HasFlag(AssignmentSelectionData.StaffingRequests)
        ? staffingRequests.Count
        : null;

    private string StaffingRequestBadgeText => StaffingRequestCount?.ToString() ?? string.Empty;

    private ProjectSummary? SelectedProject => selectedProjectId.HasValue
        ? projectSummaries.FirstOrDefault(project => project.Id == selectedProjectId.Value)
        : null;

    private readonly record struct WorkspaceTabsIdentity(
        Guid? ProjectId,
        int AssignmentCount,
        int AllocationCount,
        int StaffingRequestCount,
        bool StaffingRequestsLoaded);

    private enum AssignmentWorkspaceTab
    {
        ResourceSchedule,
        Relationships,
        StaffingRequests,
        Allocations
    }

    [Flags]
    protected enum AssignmentSelectionData
    {
        None = 0,
        Assignments = 1 << 0,
        PartyOptions = 1 << 1,
        SkillCatalog = 1 << 2,
        StaffingRequests = 1 << 3,
        StaffingCandidates = 1 << 4
    }

    protected override async Task OnParametersSetAsync()
    {
        var requestedProjectId = ProjectIdQuery;
        isProjectContextLoading = true;
        var generation = BeginLoad(out var cancellation);
        if (requestedProjectId.HasValue)
        {
            SetSelectedProject(requestedProjectId);
        }

        await InvokeAsync(StateHasChanged);
        try
        {
            var projectsTask = ListProjectsAsync(cancellation.Token);
            var dashboardTask = hasStaffingDashboardLoaded
                ? Task.FromResult(staffingDashboard)
                : GetStaffingDashboardAsync(cancellation.Token);

            await Task.WhenAll(projectsTask, dashboardTask);
            if (!IsCurrentRouteLoad(generation, requestedProjectId))
            {
                return;
            }

            var loadedProjects = await projectsTask;
            projectSummaries = loadedProjects;
            staffingDashboard = await dashboardTask;
            hasStaffingDashboardLoaded = true;

            var targetProjectId = requestedProjectId;
            if (!targetProjectId.HasValue)
            {
                targetProjectId = selectedProjectId.HasValue &&
                                  loadedProjects.Any(project => project.Id == selectedProjectId.Value)
                    ? selectedProjectId
                    : loadedProjects.FirstOrDefault()?.Id;
            }

            SetSelectedProject(targetProjectId);
            if (requestedProjectId.HasValue &&
                loadedProjects.All(project => project.Id != requestedProjectId.Value))
            {
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
                return;
            }

            var requestedData = AssignmentSelectionData.Assignments | GetRequiredData(selectedWorkspaceTab);
            var missingData = requestedData & ~loadedSelectionData;
            if (missingData is not AssignmentSelectionData.None)
            {
                var snapshot = await LoadSelectionSnapshotAsync(
                    new AssignmentSelectionLoadRequest(
                        targetProjectId,
                        missingData,
                        CaptureCandidateFilter()),
                    cancellation.Token);
                if (!IsCurrentRouteSelectionLoad(generation, requestedProjectId, targetProjectId))
                {
                    return;
                }

                MergeSelectionSnapshot(snapshot);
            }

            agentChatContextAccessState = AgentChatContextAccessState.Ready;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            if (IsCurrentRouteLoad(generation, requestedProjectId))
            {
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
                Logger.LogError(
                    exception,
                    "Failed to load the CRM-HR assignments workspace for route project {ProjectId}.",
                    requestedProjectId);
                throw;
            }
        }
        finally
        {
            if (generation == Volatile.Read(ref loadGeneration))
            {
                isProjectContextLoading = false;
            }

            CompleteLoad(cancellation);
        }
    }

    private Task HandleProjectChanged(Guid? projectId)
        => LoadSelectionAsync(projectId);

    private async Task LoadSelectionAsync(Guid? projectId)
    {
        isProjectContextLoading = true;
        var generation = BeginLoad(out var cancellation);
        SetSelectedProject(projectId);
        await InvokeAsync(StateHasChanged);
        try
        {
            if (projectId.HasValue && projectSummaries.All(project => project.Id != projectId.Value))
            {
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
                return;
            }

            var requestedData = AssignmentSelectionData.Assignments | GetRequiredData(selectedWorkspaceTab);
            var snapshot = await LoadSelectionSnapshotAsync(
                new AssignmentSelectionLoadRequest(
                    projectId,
                    requestedData,
                    CaptureCandidateFilter()),
                cancellation.Token);
            if (!IsCurrentSelectionLoad(generation, projectId))
            {
                return;
            }

            MergeSelectionSnapshot(snapshot);
            agentChatContextAccessState = AgentChatContextAccessState.Ready;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            if (IsCurrentSelectionLoad(generation, projectId))
            {
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
                Logger.LogError(
                    exception,
                    "Failed to load assignment data for project {ProjectId}.",
                    projectId);
                throw;
            }
        }
        finally
        {
            if (generation == Volatile.Read(ref loadGeneration))
            {
                isProjectContextLoading = false;
            }

            CompleteLoad(cancellation);
        }
    }

    private async Task HandleWorkspaceTabChangedAsync(int selectedIndex)
    {
        if (!Enum.IsDefined(typeof(AssignmentWorkspaceTab), selectedIndex))
        {
            throw new ArgumentOutOfRangeException(nameof(selectedIndex));
        }

        selectedWorkspaceTab = (AssignmentWorkspaceTab)selectedIndex;
        await InvokeAsync(StateHasChanged);
        await EnsureSelectionDataLoadedAsync(
            AssignmentSelectionData.Assignments | GetRequiredData(selectedWorkspaceTab));
    }

    private static AssignmentSelectionData GetRequiredData(AssignmentWorkspaceTab tab)
        => tab is AssignmentWorkspaceTab.StaffingRequests
            ? AssignmentSelectionData.StaffingRequests
            : AssignmentSelectionData.None;

    private async Task<bool> EnsureSelectionDataLoadedAsync(
        AssignmentSelectionData requestedData,
        bool force = false)
    {
        if (isProjectContextLoading || !selectedProjectId.HasValue)
        {
            return false;
        }

        var dataToLoad = force
            ? requestedData
            : requestedData & ~loadedSelectionData;
        if (dataToLoad is AssignmentSelectionData.None)
        {
            return true;
        }

        var expectedProjectId = selectedProjectId;
        var generation = BeginLoad(out var cancellation);
        isSelectionDataLoading = true;
        loadingSelectionData = dataToLoad;
        await InvokeAsync(StateHasChanged);
        try
        {
            var snapshot = await LoadSelectionSnapshotAsync(
                new AssignmentSelectionLoadRequest(
                    expectedProjectId,
                    dataToLoad,
                    CaptureCandidateFilter()),
                cancellation.Token);
            if (!IsCurrentSelectionLoad(generation, expectedProjectId))
            {
                return false;
            }

            MergeSelectionSnapshot(snapshot);
            agentChatContextAccessState = AgentChatContextAccessState.Ready;
            await InvokeAsync(StateHasChanged);
            return true;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
            return false;
        }
        catch (Exception exception)
        {
            if (IsCurrentSelectionLoad(generation, expectedProjectId))
            {
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
                Logger.LogError(
                    exception,
                    "Failed to load CRM-HR assignment data {RequestedData} for project {ProjectId}.",
                    dataToLoad,
                    expectedProjectId);
                NotificationService.Error(
                    "Project records unavailable",
                    "The requested project records could not be loaded. Try again.");
            }

            return false;
        }
        finally
        {
            if (generation == Volatile.Read(ref loadGeneration))
            {
                isSelectionDataLoading = false;
                loadingSelectionData = AssignmentSelectionData.None;
            }

            CompleteLoad(cancellation);
        }
    }

    protected virtual async Task<AssignmentSelectionSnapshot> LoadSelectionSnapshotAsync(
        AssignmentSelectionLoadRequest request,
        CancellationToken cancellationToken)
    {
        var projectId = request.ProjectId;
        var requestedData = request.RequestedData;
        var partyOptionsTask = requestedData.HasFlag(AssignmentSelectionData.PartyOptions) && projectId.HasValue
            ? ProjectPartyIntegrationService.ListPartyOptionsAsync(projectId.Value, cancellationToken)
            : Task.FromResult<IReadOnlyList<ProjectPartyOption>>([]);
        var assignmentsTask = requestedData.HasFlag(AssignmentSelectionData.Assignments) && projectId.HasValue
            ? ProjectPartyIntegrationService.ListAssignmentsDetailedAsync(projectId.Value, cancellationToken)
            : Task.FromResult<IReadOnlyList<ProjectPartyAssignmentDetail>>([]);
        var skillCatalogTask = requestedData.HasFlag(AssignmentSelectionData.SkillCatalog)
            ? HrService.ListSkillCatalogAsync(cancellationToken)
            : Task.FromResult<IReadOnlyList<SkillCatalogItemModel>>([]);
        var staffingRequestsTask = requestedData.HasFlag(AssignmentSelectionData.StaffingRequests) && projectId.HasValue
            ? HrService.ListStaffingRequestsAsync(projectId.Value, cancellationToken)
            : Task.FromResult<IReadOnlyList<StaffingRequestItemModel>>([]);
        var staffingCandidatesTask = requestedData.HasFlag(AssignmentSelectionData.StaffingCandidates)
            ? SearchStaffingCandidatesAsync(request.CandidateFilter, cancellationToken)
            : Task.FromResult<IReadOnlyList<StaffingCandidateItemModel>>([]);

        await Task.WhenAll(
            partyOptionsTask,
            assignmentsTask,
            skillCatalogTask,
            staffingRequestsTask,
            staffingCandidatesTask);

        return new AssignmentSelectionSnapshot(
            requestedData,
            await partyOptionsTask,
            await assignmentsTask,
            await skillCatalogTask,
            await staffingRequestsTask,
            await staffingCandidatesTask);
    }

    protected virtual Task<StaffingDashboardModel> GetStaffingDashboardAsync(
        CancellationToken cancellationToken)
        => HrService.GetStaffingDashboardAsync(cancellationToken);

    protected virtual Task<IReadOnlyList<ProjectSummary>> ListProjectsAsync(
        CancellationToken cancellationToken)
        => ProjectsService.ListAsync(cancellationToken);

    protected virtual Task<IReadOnlyList<StaffingCandidateItemModel>> SearchStaffingCandidatesAsync(
        CandidateFilterSnapshot candidateFilter,
        CancellationToken cancellationToken)
        => HrService.SearchStaffingCandidatesAsync(
            candidateFilter.SkillId,
            candidateFilter.SearchText,
            candidateFilter.AvailabilityState,
            cancellationToken);

    private CandidateFilterSnapshot CaptureCandidateFilter()
        => new(
            ResolveCandidateSkillId(),
            candidateSearchText,
            ResolveCandidateAvailabilityState());

    private Guid? ResolveCandidateSkillId()
    {
        return Guid.TryParse(candidateSkillFilter, out var skillId) ? skillId : null;
    }

    private WorkforceAvailabilityState? ResolveCandidateAvailabilityState()
    {
        return Enum.TryParse<WorkforceAvailabilityState>(candidateAvailabilityFilter, out var availabilityState)
            ? availabilityState
            : null;
    }

    private long BeginLoad(out CancellationTokenSource cancellation)
    {
        var generation = Interlocked.Increment(ref loadGeneration);
        agentChatContextAccessState = AgentChatContextAccessState.Loading;
        cancellation = new CancellationTokenSource();
        var supersededLoad = Interlocked.Exchange(ref loadCancellation, cancellation);
        supersededLoad?.Cancel();
        return generation;
    }

    private void CompleteLoad(CancellationTokenSource cancellation)
    {
        Interlocked.CompareExchange(ref loadCancellation, null, cancellation);
        cancellation.Dispose();
    }

    private bool IsCurrentRouteLoad(long generation, Guid? expectedRouteProjectId)
        => !isDisposed &&
           generation == Volatile.Read(ref loadGeneration) &&
           ProjectIdQuery == expectedRouteProjectId;

    private bool IsCurrentRouteSelectionLoad(
        long generation,
        Guid? expectedRouteProjectId,
        Guid? expectedProjectId)
        => IsCurrentRouteLoad(generation, expectedRouteProjectId) &&
           selectedProjectId == expectedProjectId;

    private bool IsCurrentSelectionLoad(long generation, Guid? expectedProjectId)
        => !isDisposed &&
           generation == Volatile.Read(ref loadGeneration) &&
           selectedProjectId == expectedProjectId;

    private void MergeSelectionSnapshot(AssignmentSelectionSnapshot snapshot)
    {
        if (snapshot.LoadedData.HasFlag(AssignmentSelectionData.PartyOptions))
        {
            partyOptions = snapshot.PartyOptions;
        }

        if (snapshot.LoadedData.HasFlag(AssignmentSelectionData.Assignments))
        {
            assignments = snapshot.Assignments;
        }

        if (snapshot.LoadedData.HasFlag(AssignmentSelectionData.SkillCatalog))
        {
            skillCatalog = snapshot.SkillCatalog;
        }

        if (snapshot.LoadedData.HasFlag(AssignmentSelectionData.StaffingRequests))
        {
            staffingRequests = snapshot.StaffingRequests;
        }

        if (snapshot.LoadedData.HasFlag(AssignmentSelectionData.StaffingCandidates))
        {
            staffingCandidates = snapshot.StaffingCandidates;
        }

        loadedSelectionData |= snapshot.LoadedData;
    }

    private void SetSelectedProject(Guid? projectId)
    {
        if (selectedProjectId == projectId)
        {
            return;
        }

        var previousSelection = Interlocked.Exchange(
            ref selectionLifetimeCancellation,
            projectId.HasValue ? new CancellationTokenSource() : null);
        previousSelection?.Cancel();
        previousSelection?.Dispose();

        selectedProjectId = projectId;
        partyOptions = [];
        assignments = [];
        skillCatalog = [];
        staffingRequests = [];
        staffingCandidates = [];
        loadedSelectionData = AssignmentSelectionData.None;
        loadingSelectionData = AssignmentSelectionData.None;
        isSelectionDataLoading = false;
        candidateSearchText = string.Empty;
        candidateSkillFilter = string.Empty;
        candidateAvailabilityFilter = string.Empty;
        draftAssignment = CreateProjectAssignmentDraft(projectId);
        allocationDraft = CreateAllocationDraft(projectId);
        staffingRequestDraft = CreateStaffingRequestDraft(projectId);
    }

    private async Task<bool> PrepareRelationshipCreateAsync()
    {
        if (!await EnsureSelectionDataLoadedAsync(AssignmentSelectionData.PartyOptions))
        {
            return false;
        }

        ResetDraft();
        await InvokeAsync(StateHasChanged);
        return true;
    }

    private async Task<bool> PrepareStaffingCreateAsync()
    {
        if (!await EnsureSelectionDataLoadedAsync(
                AssignmentSelectionData.PartyOptions | AssignmentSelectionData.SkillCatalog))
        {
            return false;
        }

        ResetStaffingRequestDraft();
        await InvokeAsync(StateHasChanged);
        return true;
    }

    private async Task<bool> PrepareAllocationCreateAsync()
    {
        if (!await EnsureSelectionDataLoadedAsync(
                AssignmentSelectionData.PartyOptions |
                AssignmentSelectionData.SkillCatalog |
                AssignmentSelectionData.StaffingCandidates))
        {
            return false;
        }

        ResetAllocationDraft();
        await InvokeAsync(StateHasChanged);
        return true;
    }

    private async Task<bool> SaveDraftAsync()
    {
        if (selectedProjectId is not { } projectId)
        {
            NotificationService.Warning("Assignment not saved", "Choose a project before saving an assignment.");
            return false;
        }

        draftAssignment.ProjectId = projectId;
        var result = await ProjectPartyIntegrationService.SaveAssignmentAsync(
            draftAssignment,
            selectionLifetimeCancellation?.Token ?? CancellationToken.None);
        if (!result.IsSuccess)
        {
            NotificationService.Error("Assignment save failed", result.Errors.FirstOrDefault()?.Message ?? "Unable to save the assignment.");
            return false;
        }

        NotificationService.Success("Assignment saved", "Project assignment saved.");
        ResetDraft();
        if (selectedProjectId == projectId)
        {
            loadedSelectionData &= ~AssignmentSelectionData.Assignments;
            await EnsureSelectionDataLoadedAsync(AssignmentSelectionData.Assignments, force: true);
            await RefreshStaffingDashboardAsync();
            await InvokeAsync(StateHasChanged);
        }

        return true;
    }

    private async Task<bool> SaveAllocationAsync()
    {
        if (selectedProjectId is not { } projectId)
        {
            NotificationService.Warning("Allocation not saved", "Choose a project before saving an allocation.");
            return false;
        }

        allocationDraft.ProjectId = projectId;
        allocationDraft.Source = "crm-hr-ui";
        var result = await ProjectPartyIntegrationService.SaveAssignmentAsync(
            allocationDraft,
            selectionLifetimeCancellation?.Token ?? CancellationToken.None);
        if (!result.IsSuccess)
        {
            NotificationService.Error("Allocation save failed", result.Errors.FirstOrDefault()?.Message ?? "Unable to save the allocation.");
            return false;
        }

        NotificationService.Success("Allocation saved", "Project allocation saved.");
        ResetAllocationDraft();
        if (selectedProjectId == projectId)
        {
            loadedSelectionData &= ~(AssignmentSelectionData.Assignments | AssignmentSelectionData.StaffingCandidates);
            await EnsureSelectionDataLoadedAsync(AssignmentSelectionData.Assignments, force: true);
            await RefreshStaffingDashboardAsync();
            await InvokeAsync(StateHasChanged);
        }

        return true;
    }

    private async Task<bool> SaveStaffingRequestAsync()
    {
        if (selectedProjectId is not { } projectId)
        {
            NotificationService.Warning("Staffing request not saved", "Choose a project before saving a staffing request.");
            return false;
        }

        staffingRequestDraft.ProjectId = projectId;
        var result = await HrService.SaveStaffingRequestAsync(
            staffingRequestDraft,
            selectionLifetimeCancellation?.Token ?? CancellationToken.None);
        if (result.IsFailure)
        {
            NotificationService.Error("Staffing request save failed", string.Join(" ", result.Errors.Select(error => error.Message)));
            return false;
        }

        NotificationService.Success("Staffing request saved", "Staffing request saved.");
        ResetStaffingRequestDraft();
        if (selectedProjectId == projectId)
        {
            loadedSelectionData &= ~AssignmentSelectionData.StaffingRequests;
            await EnsureSelectionDataLoadedAsync(AssignmentSelectionData.StaffingRequests, force: true);
            await RefreshStaffingDashboardAsync();
            await InvokeAsync(StateHasChanged);
        }

        return true;
    }

    private Task SearchCandidatesAsync()
        => ReloadCandidatesAsync();

    private Task HandleCandidateSearchTextChanged(string value)
    {
        candidateSearchText = value;
        return Task.CompletedTask;
    }

    private Task HandleCandidateSkillFilterChanged(string value)
    {
        candidateSkillFilter = value;
        return Task.CompletedTask;
    }

    private Task HandleCandidateAvailabilityFilterChanged(string value)
    {
        candidateAvailabilityFilter = value;
        return Task.CompletedTask;
    }

    private async Task ResetDraftAsync()
    {
        ResetDraft();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ResetAllocationAsync()
    {
        ResetAllocationDraft();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ResetStaffingRequestAsync()
    {
        ResetStaffingRequestDraft();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ResetCandidateFiltersAsync()
    {
        candidateSearchText = string.Empty;
        candidateSkillFilter = string.Empty;
        candidateAvailabilityFilter = string.Empty;
        await ReloadCandidatesAsync();
    }

    private Task<bool> ReloadCandidatesAsync()
        => EnsureSelectionDataLoadedAsync(AssignmentSelectionData.StaffingCandidates, force: true);

    private async Task DeleteAssignmentAsync(Guid assignmentId)
    {
        var projectId = selectedProjectId;
        await ProjectPartyIntegrationService.DeleteAssignmentAsync(
            assignmentId,
            selectionLifetimeCancellation?.Token ?? CancellationToken.None);
        NotificationService.Warning("Assignment deleted", "Project assignment deleted.");
        if (selectedProjectId == projectId)
        {
            loadedSelectionData &= ~AssignmentSelectionData.Assignments;
            await EnsureSelectionDataLoadedAsync(AssignmentSelectionData.Assignments, force: true);
            await RefreshStaffingDashboardAsync();
        }
    }

    private async Task DeleteAllocationAsync(Guid assignmentId)
    {
        var projectId = selectedProjectId;
        await ProjectPartyIntegrationService.DeleteAssignmentAsync(
            assignmentId,
            selectionLifetimeCancellation?.Token ?? CancellationToken.None);
        NotificationService.Warning("Allocation deleted", "Project allocation deleted.");
        if (selectedProjectId == projectId)
        {
            loadedSelectionData &= ~(AssignmentSelectionData.Assignments | AssignmentSelectionData.StaffingCandidates);
            await EnsureSelectionDataLoadedAsync(AssignmentSelectionData.Assignments, force: true);
            await RefreshStaffingDashboardAsync();
        }
    }

    private async Task DeleteStaffingRequestAsync(Guid staffingRequestId)
    {
        var projectId = selectedProjectId;
        await HrService.DeleteStaffingRequestAsync(
            staffingRequestId,
            selectionLifetimeCancellation?.Token ?? CancellationToken.None);
        NotificationService.Warning("Staffing request deleted", "Staffing request deleted.");
        if (selectedProjectId == projectId)
        {
            loadedSelectionData &= ~AssignmentSelectionData.StaffingRequests;
            await EnsureSelectionDataLoadedAsync(AssignmentSelectionData.StaffingRequests, force: true);
            await RefreshStaffingDashboardAsync();
        }
    }

    private bool IsLoading(AssignmentSelectionData data)
        => isSelectionDataLoading && loadingSelectionData.HasFlag(data);

    private async Task<ProjectNodeDetails?> LoadTaskDetailsAsync(ProjectPartyAssignmentDetail assignment)
    {
        if (string.IsNullOrWhiteSpace(assignment.NodeKey) || selectedProjectId != assignment.ProjectId)
        {
            return null;
        }

        var expectedProjectId = selectedProjectId;
        var cancellationToken = selectionLifetimeCancellation?.Token ?? CancellationToken.None;
        try
        {
            var details = await ProjectNodeDetailsBridge.GetAsync(
                assignment.ProjectId,
                new ProjectNodeReference(assignment.NodeKey),
                cancellationToken);
            return selectedProjectId == expectedProjectId ? details : null;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return null;
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to load linked work item {NodeKey} for project {ProjectId}.",
                assignment.NodeKey,
                assignment.ProjectId);
            NotificationService.Error(
                "Work item details unavailable",
                "The linked project work item could not be loaded.");
            return null;
        }
    }

    private async Task RefreshStaffingDashboardAsync()
    {
        var cancellationToken = selectionLifetimeCancellation?.Token ?? CancellationToken.None;
        try
        {
            staffingDashboard = await GetStaffingDashboardAsync(cancellationToken);
            hasStaffingDashboardLoaded = true;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to refresh CRM-HR staffing summary after an assignment change.");
            NotificationService.Warning(
                "Summary refresh delayed",
                "The change was saved, but the staffing summary could not be refreshed.");
        }
    }

    private Task OpenStructure(Guid projectId)
    {
        Navigation.NavigateTo($"/projects/{projectId}/structure");
        return Task.CompletedTask;
    }

    private Task OpenGantt(Guid projectId)
    {
        Navigation.NavigateTo($"/projects/{projectId:D}/structure?tab=gantt");
        return Task.CompletedTask;
    }

    private Task OpenSelectedProjectStructure()
        => selectedProjectId is { } projectId
            ? OpenStructure(projectId)
            : Task.CompletedTask;

    private Task OpenSelectedProjectGantt()
        => selectedProjectId is { } projectId
            ? OpenGantt(projectId)
            : Task.CompletedTask;

    private void ResetDraft()
    {
        draftAssignment = CreateProjectAssignmentDraft(selectedProjectId);
    }

    private void ResetAllocationDraft()
    {
        allocationDraft = CreateAllocationDraft(selectedProjectId);
    }

    private void ResetStaffingRequestDraft()
    {
        staffingRequestDraft = CreateStaffingRequestDraft(selectedProjectId);
    }

    public ValueTask DisposeAsync()
    {
        isDisposed = true;
        Interlocked.Increment(ref loadGeneration);
        var cancellation = Interlocked.Exchange(ref loadCancellation, null);
        cancellation?.Cancel();
        cancellation?.Dispose();
        var selectionCancellation = Interlocked.Exchange(ref selectionLifetimeCancellation, null);
        selectionCancellation?.Cancel();
        selectionCancellation?.Dispose();
        return ValueTask.CompletedTask;
    }

    protected sealed record AssignmentSelectionSnapshot(
        AssignmentSelectionData LoadedData,
        IReadOnlyList<ProjectPartyOption> PartyOptions,
        IReadOnlyList<ProjectPartyAssignmentDetail> Assignments,
        IReadOnlyList<SkillCatalogItemModel> SkillCatalog,
        IReadOnlyList<StaffingRequestItemModel> StaffingRequests,
        IReadOnlyList<StaffingCandidateItemModel> StaffingCandidates)
    {
        public static AssignmentSelectionSnapshot Empty { get; } = new(
            AssignmentSelectionData.None,
            [],
            [],
            [],
            [],
            []);
    }

    protected readonly record struct AssignmentSelectionLoadRequest(
        Guid? ProjectId,
        AssignmentSelectionData RequestedData,
        CandidateFilterSnapshot CandidateFilter);

    protected readonly record struct CandidateFilterSnapshot(
        Guid? SkillId,
        string SearchText,
        WorkforceAvailabilityState? AvailabilityState);

    private static ProjectPartyAssignmentUpsertRequest CreateProjectAssignmentDraft(Guid? projectId = null)
    {
        return new ProjectPartyAssignmentUpsertRequest
        {
            ProjectId = projectId ?? Guid.Empty,
            Role = ProjectPartyAssignmentRole.Customer,
            Source = "crm-hr-ui",
            IsPrimary = true
        };
    }

    private static ProjectPartyAssignmentUpsertRequest CreateAllocationDraft(Guid? projectId = null)
    {
        return new ProjectPartyAssignmentUpsertRequest
        {
            ProjectId = projectId ?? Guid.Empty,
            Role = ProjectPartyAssignmentRole.TeamMember,
            Source = "crm-hr-ui",
            IsPrimary = false,
            AllocationPercent = 100m
        };
    }

    private static StaffingRequestEditorModel CreateStaffingRequestDraft(Guid? projectId = null)
    {
        return new StaffingRequestEditorModel
        {
            ProjectId = projectId,
            AllocationPercent = 100m,
            Status = StaffingRequestStatus.Open
        };
    }
}

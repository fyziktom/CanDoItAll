    private void CancelAllocationAssignmentSearch()
    {
        var cancellation = Interlocked.Exchange(
            ref allocationAssignmentSearchCancellation,
            null);
        cancellation?.Cancel();
        cancellation?.Dispose();
    }

    public ValueTask DisposeAsync()
    {
        isDisposed = true;
        Interlocked.Increment(ref loadGeneration);
        var cancellation = Interlocked.Exchange(ref loadCancellation, null);
        cancellation?.Cancel();
        cancellation?.Dispose();
        var selectionCancellation = Interlocked.Exchange(ref selectionLifetimeCancellation, null);
        selectionCancellation?.Cancel();
        selectionCancellation?.Dispose();
        CancelStaffingRequestSearch();
        CancelAssignmentSearches();
        return ValueTask.CompletedTask;
    }


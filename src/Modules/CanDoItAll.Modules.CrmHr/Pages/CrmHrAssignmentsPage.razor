    protected virtual async Task<AssignmentProjectCatalog> LoadProjectCatalogAsync(
        Guid? preferredProjectId,
        bool allowFallback,
        CancellationToken cancellationToken)
    {
        var firstPageTask = ProjectRecordQueryService.SearchAsync(
            new ProjectRecordQuery(
                Scope: ProjectRecordScope.All,
                PageSize: 1),
            cancellationToken);
        var preferredProjectTask = preferredProjectId.HasValue
            ? GetProjectAsync(preferredProjectId.Value, cancellationToken)
            : Task.FromResult<ProjectRecordQueryItem?>(null);

        await Task.WhenAll(firstPageTask, preferredProjectTask);
        var firstPage = await firstPageTask;
        var preferredProject = await preferredProjectTask;
        var selectedProject = preferredProject
            ?? (allowFallback ? firstPage.Items.FirstOrDefault() : null);

        return new AssignmentProjectCatalog(selectedProject, firstPage.TotalCount);
    }


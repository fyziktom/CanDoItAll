@page "/crm-hr/assignments"
@implements IAsyncDisposable
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Modules.Projects
@using Microsoft.Extensions.Logging
@inject IProjectRecordQueryService ProjectRecordQueryService
@inject ProjectPartyIntegrationService ProjectPartyIntegrationService
@inject IProjectNodeDetailsBridge ProjectNodeDetailsBridge
@inject HrService HrService
@inject CanDoItAll.SharedKernel.IClock Clock
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject Microsoft.Extensions.Logging.ILogger<CrmHrAssignmentsPage> Logger

<PageTitle>CRM / HR Assignments</PageTitle>

<AgentChatContextSurfaceProvider Surface="@AgentChatSurface"
                                 ContextNavigationIdentity="@AgentChatNavigationFence"
                                 ContextAccessState="@agentChatContextAccessState" />

<PageScaffold MaxWidthClass="max-w-full">
    <Header>
        <PageHeader Eyebrow="CRM / HR"
                    Title="Assignments workspace"
                    Description="Keep commercial, staffing, and project allocations aligned with the live project portfolio."
                    Compact="true">
            <Stats>
                <CompactStat Label="projects"
                             Value="@projectCount.ToString()"
                             TooltipText="Projects currently available for CRM-HR relationship binding." />
                <CompactStat Label="open requests"
                             Value="@staffingDashboard.OpenRequestCount.ToString()"
                             TooltipText="Open staffing demand across the CRM-HR module."
                             Tone="info" />
                <CompactStat Label="open demand"
                             Value="@($"{staffingDashboard.OpenDemandPercent:0.##}%")"
                             TooltipText="Requested allocation still flowing through open staffing requests."
                             Tone="warning" />
                <CompactStat Label="bench"
                             Value="@staffingDashboard.BenchCount.ToString()"
                             TooltipText="Profiles currently available for staffing."
                             Tone="success" />
                <CompactStat Label="overallocated"
                             Value="@staffingDashboard.OverallocatedCount.ToString()"
                             TooltipText="Profiles already exceeding available capacity."
                             Tone="danger" />
            </Stats>
        </PageHeader>
    </Header>

    <ChildContent>
        <Stack GapScale="LayoutGap.Medium">
            <CrmHrSecondaryTabs SelectedArea="CrmHrWorkspaceArea.Assignments" />

            <AssignmentsProjectContextBar SelectedProject="SelectedProject"
                                          SelectedProjectId="selectedProjectId"
                                          SelectedProjectIdChanged="HandleProjectChanged"
                                          ProjectLoadFailed="HandleProjectPickerLoadFailed"
                                          AssignmentCount="assignmentCounts.TotalCount"
                                          AllocationCount="assignmentCounts.AllocationCount"
                                          StaffingRequestCount="StaffingRequestCount"
                                          OpenStructure="OpenStructure"
                                          OpenGantt="OpenGantt" />

            <Tabs @key="WorkspaceTabsKey"
                  SelectedIndex="@((int)selectedWorkspaceTab)"
                  SelectedIndexChanged="HandleWorkspaceTabChangedAsync"
                  RenderMode="TabRenderMode.Server"
                  BorderMode="TabsBorderMode.Soft"
                  OverflowMode="TabsOverflowMode.Wrap"
                  AriaLabel="Project assignment workflows"
                  data-testid="crmhr-assignments-workspace-tabs">
                <TabsItem Text="Resource schedule"
                          Icon="view_timeline"
                          BadgeText="@assignmentCounts.ScheduledCount.ToString()"
                          data-testid="crmhr-assignments-tab-schedule">
                    @if (IsLoading(AssignmentSelectionData.ScheduleAssignments))
                    {
                        <LoadingState Eyebrow="Resource schedule"
                                      Title="Loading the bounded schedule window"
                                      Description="Only the current project's dated allocation view is being loaded." />
                    }
                    else
                    {
                        <ProjectAssignmentResourceGanttPanel ProjectName="@(SelectedProject?.Name ?? string.Empty)"
                                                             Assignments="scheduleAssignments"
                                                             TotalCount="scheduleAssignmentTotalCount" />
                    }
                </TabsItem>

                <TabsItem Text="Relationships"
                          Icon="hub"
                          BadgeText="@assignmentCounts.TotalCount.ToString()"
                          data-testid="crmhr-assignments-tab-relationships">
                    @if (IsLoading(AssignmentSelectionData.RelationshipAssignments))
                    {
                        <LoadingState Eyebrow="Project relationships"
                                      Title="Loading relationship records"
                                      Description="The selected relationship page is being loaded from the server." />
                    }
                    else
                    {
                        <ProjectPartyAssignmentPanel ProjectName="@(SelectedProject?.Name ?? string.Empty)"
                                                     CanCreate="@(selectedProjectId.HasValue && !isProjectContextLoading)"
                                                     Draft="draftAssignment"
                                                     Assignments="relationshipAssignments"
                                                     PageIndex="relationshipAssignmentPageIndex"
                                                     PageSize="AssignmentPageSize"
                                                     TotalCount="relationshipAssignmentTotalCount"
                                                     SearchText="relationshipAssignmentSearchText"
                                                     SearchTextChanged="HandleRelationshipSearchTextChangedAsync"
                                                     RoleFilter="relationshipAssignmentRoleFilter"
                                                     RoleFilterChanged="HandleRelationshipRoleFilterChangedAsync"
                                                     PageChanged="HandleRelationshipPageChangedAsync"
                                                     PrepareCreate="PrepareRelationshipCreateAsync"
                                                     SaveDraft="SaveDraftAsync"
                                                     ResetDraft="ResetDraftAsync"
                                                     DeleteAssignment="DeleteAssignmentAsync"
                                                     LoadTaskDetails="LoadTaskDetailsAsync"
                                                     OpenStructure="OpenSelectedProjectStructure"
                                                     OpenGantt="OpenSelectedProjectGantt" />
                    }
                </TabsItem>

                <TabsItem Text="Staffing requests"
                          Icon="person_search"
                          BadgeText="@StaffingRequestBadgeText"
                          data-testid="crmhr-assignments-tab-staffing">
                    @if (IsLoading(AssignmentSelectionData.StaffingRequests))
                    {
                        <LoadingState Eyebrow="Staffing requests"
                                      Title="Loading project demand"
                                      Description="Only this tab's staffing records are being loaded." />
                    }
                    else
                    {
                        <StaffingRequestEditor ProjectName="@(SelectedProject?.Name ?? string.Empty)"
                                               CanCreate="@(selectedProjectId.HasValue && !isProjectContextLoading)"
                                               Draft="staffingRequestDraft"
                                               SkillCatalog="skillCatalog"
                                               Requests="staffingRequests"
                                               PageIndex="staffingRequestPageIndex"
                                               PageSize="StaffingPageSize"
                                               TotalCount="staffingRequestTotalCount"
                                               SearchText="staffingRequestSearchText"
                                               SearchTextChanged="HandleStaffingRequestSearchTextChangedAsync"
                                               StatusFilter="staffingRequestStatusFilter"
                                               StatusFilterChanged="HandleStaffingRequestStatusFilterChangedAsync"
                                               PageChanged="HandleStaffingRequestPageChangedAsync"
                                               PrepareCreate="PrepareStaffingCreateAsync"
                                               SaveRequest="SaveStaffingRequestAsync"
                                               ResetRequest="ResetStaffingRequestAsync"
                                               DeleteRequest="DeleteStaffingRequestAsync" />
                    }
                </TabsItem>

                <TabsItem Text="Allocations"
                          Icon="groups"
                          BadgeText="@assignmentCounts.AllocationCount.ToString()"
                          data-testid="crmhr-assignments-tab-allocations">
                    @if (IsLoading(AssignmentSelectionData.AllocationAssignments))
                    {
                        <LoadingState Eyebrow="Project allocations"
                                      Title="Loading allocation records"
                                      Description="The selected allocation page is being loaded from the server." />
                    }
                    else
                    {
                        <ProjectAllocationEditor Draft="allocationDraft"
                                                 ProjectName="@(SelectedProject?.Name ?? string.Empty)"
                                                 CanCreate="@(selectedProjectId.HasValue && !isProjectContextLoading)"
                                                 Allocations="allocationAssignments"
                                                 PageIndex="allocationAssignmentPageIndex"
                                                 PageSize="AssignmentPageSize"
                                                 TotalCount="allocationAssignmentTotalCount"
                                                 SearchText="allocationAssignmentSearchText"
                                                 SearchTextChanged="HandleAllocationSearchTextChangedAsync"
                                                 RoleFilter="allocationAssignmentRoleFilter"
                                                 RoleFilterChanged="HandleAllocationRoleFilterChangedAsync"
                                                 PageChanged="HandleAllocationPageChangedAsync"
                                                 SkillCatalog="skillCatalog"
                                                 Candidates="staffingCandidates"
                                                 CandidatePageIndex="staffingCandidatePageIndex"
                                                 CandidatePageSize="StaffingPageSize"
                                                 CandidateTotalCount="staffingCandidateTotalCount"
                                                 CandidatePageChanged="HandleCandidatePageChangedAsync"
                                                 CandidateSearchText="candidateSearchText"
                                                 CandidateSearchTextChanged="HandleCandidateSearchTextChanged"
                                                 CandidateSkillFilter="candidateSkillFilter"
                                                 CandidateSkillFilterChanged="HandleCandidateSkillFilterChanged"
                                                 CandidateAvailabilityFilter="candidateAvailabilityFilter"
                                                 CandidateAvailabilityFilterChanged="HandleCandidateAvailabilityFilterChanged"
                                                 SearchCandidates="SearchCandidatesAsync"
                                                 ResetCandidateFilters="ResetCandidateFiltersAsync"
                                                 PrepareCreate="PrepareAllocationCreateAsync"
                                                 SaveAllocation="SaveAllocationAsync"
                                                 ResetAllocation="ResetAllocationAsync"
                                                 DeleteAllocation="DeleteAllocationAsync"
                                                 LoadTaskDetails="LoadTaskDetailsAsync"
                                                 OpenStructure="OpenSelectedProjectStructure"
                                                 OpenGantt="OpenSelectedProjectGantt" />
                    }
                </TabsItem>
            </Tabs>
        </Stack>
    </ChildContent>
</PageScaffold>

@code {
    private const int StaffingPageSize = StaffingQueryLimits.DefaultPageSize;
    private const int AssignmentPageSize = ProjectPartyAssignmentQueryLimits.DefaultPageSize;
    private const int StaffingRequestSearchDebounceMilliseconds = 250;
    private const int AssignmentSearchDebounceMilliseconds = 250;
    private static readonly IReadOnlyList<ProjectPartyAssignmentRole> AllAssignmentRoles =
        Enum.GetValues<ProjectPartyAssignmentRole>();
    private static readonly IReadOnlyList<ProjectPartyAssignmentRole> AllocationRoles =
    [
        ProjectPartyAssignmentRole.TeamMember,
        ProjectPartyAssignmentRole.DeliveryUnit,
        ProjectPartyAssignmentRole.Manager,
        ProjectPartyAssignmentRole.AiAgent,
        ProjectPartyAssignmentRole.Reviewer,
        ProjectPartyAssignmentRole.WorkItemAssignee
    ];

    [SupplyParameterFromQuery(Name = "projectId")]
    public Guid? ProjectIdQuery { get; set; }

    private ProjectRecordQueryItem? selectedProject;
    private int projectCount;
    private IReadOnlyList<ProjectPartyAssignmentDetail> scheduleAssignments = [];
    private IReadOnlyList<ProjectPartyAssignmentDetail> relationshipAssignments = [];
    private IReadOnlyList<ProjectPartyAssignmentDetail> allocationAssignments = [];
    private ProjectPartyAssignmentCounts assignmentCounts = ProjectPartyAssignmentCounts.Empty;
    private int scheduleAssignmentTotalCount;
    private int relationshipAssignmentPageIndex;
    private int relationshipAssignmentTotalCount;
    private int allocationAssignmentPageIndex;
    private int allocationAssignmentTotalCount;
    private DateTimeOffset scheduleWindowStartUtc;
    private DateTimeOffset scheduleWindowEndUtc;
    private IReadOnlyList<SkillCatalogItemModel> skillCatalog = [];
    private IReadOnlyList<StaffingRequestItemModel> staffingRequests = [];
    private IReadOnlyList<StaffingCandidateItemModel> staffingCandidates = [];
    private int staffingRequestPageIndex;
    private int staffingRequestTotalCount;
    private int staffingCandidatePageIndex;
    private int staffingCandidateTotalCount;
    private StaffingDashboardModel staffingDashboard = new(0, 0m, 0, 0);
    private Guid? selectedProjectId;
    private AssignmentWorkspaceTab selectedWorkspaceTab;
    private AssignmentSelectionData loadedSelectionData;
    private AssignmentSelectionData loadingSelectionData;
    private bool isSelectionDataLoading;
    private bool isProjectContextLoading;
    private bool hasStaffingDashboardLoaded;
    private bool isDisposed;
    private long loadGeneration;
    private CancellationTokenSource? loadCancellation;
    private CancellationTokenSource? selectionLifetimeCancellation;
    private CancellationTokenSource? staffingRequestSearchCancellation;
    private CancellationTokenSource? relationshipAssignmentSearchCancellation;
    private CancellationTokenSource? allocationAssignmentSearchCancellation;
    private AgentChatContextAccessState agentChatContextAccessState = AgentChatContextAccessState.Loading;
    private string candidateSearchText = string.Empty;
    private string candidateSkillFilter = string.Empty;
    private string candidateAvailabilityFilter = string.Empty;
    private string staffingRequestSearchText = string.Empty;
    private string relationshipAssignmentSearchText = string.Empty;
    private string allocationAssignmentSearchText = string.Empty;
    private StaffingRequestStatus? staffingRequestStatusFilter;
    private ProjectPartyAssignmentRole? relationshipAssignmentRoleFilter;
    private ProjectPartyAssignmentRole? allocationAssignmentRoleFilter;
    private ProjectPartyAssignmentUpsertRequest draftAssignment = CreateProjectAssignmentDraft();
    private ProjectPartyAssignmentUpsertRequest allocationDraft = CreateAllocationDraft();
    private StaffingRequestEditorModel staffingRequestDraft = CreateStaffingRequestDraft();

    private AgentChatContextSurface AgentChatSurface
    {
        get
        {
            if (selectedProjectId is not { } projectId)
            {
                return CrmHrAgentChatSurfaceBuilder.BuildAssignmentsSurface();
            }

            var project = SelectedProject;
            return project is null
                ? CrmHrAgentChatSurfaceBuilder.BuildAssignmentsSurface()
                : CrmHrAgentChatSurfaceBuilder.BuildAssignmentsSurface(
                    project.Id,
                    project.Name,
                    project.Status);
        }
    }

    private AgentChatNavigationIdentity AgentChatNavigationFence
        => AgentChatNavigationIdentity.CreateForLocation(
            Navigation.BaseUri,
            Navigation.Uri,
            [
                new("projectId", selectedProjectId?.ToString("D")),
                new("routeProjectId", ProjectIdQuery?.ToString("D"))
            ]);

    private WorkspaceTabsIdentity WorkspaceTabsKey => new(
        selectedProjectId,
        assignmentCounts.TotalCount,
        assignmentCounts.AllocationCount,
        staffingRequestTotalCount,
        loadedSelectionData.HasFlag(AssignmentSelectionData.StaffingRequests));

    private int? StaffingRequestCount => loadedSelectionData.HasFlag(AssignmentSelectionData.StaffingRequests)
        ? staffingRequestTotalCount
        : null;

    private string StaffingRequestBadgeText => StaffingRequestCount?.ToString() ?? string.Empty;

    private ProjectRecordQueryItem? SelectedProject => selectedProject?.Id == selectedProjectId
        ? selectedProject
        : null;

    private readonly record struct WorkspaceTabsIdentity(
        Guid? ProjectId,
        int AssignmentCount,
        int AllocationCount,
        int StaffingRequestCount,
        bool StaffingRequestsLoaded);

    private enum AssignmentWorkspaceTab
    {
        ResourceSchedule,
        Relationships,
        StaffingRequests,
        Allocations
    }

    [Flags]
    protected enum AssignmentSelectionData
    {
        None = 0,
        AssignmentCounts = 1 << 0,
        ScheduleAssignments = 1 << 1,
        RelationshipAssignments = 1 << 2,
        Assignments = RelationshipAssignments,
        AllocationAssignments = 1 << 3,
        SkillCatalog = 1 << 4,
        StaffingRequests = 1 << 5,
        StaffingCandidates = 1 << 6
    }

    protected override async Task OnParametersSetAsync()
    {
        EnsureScheduleWindow();
        var requestedProjectId = ProjectIdQuery;
        isProjectContextLoading = true;
        var generation = BeginLoad(out var cancellation);
        if (requestedProjectId.HasValue)
        {
            SetSelectedProject(requestedProjectId);
        }

        await InvokeAsync(StateHasChanged);
        try
        {
            var projectCatalogTask = LoadProjectCatalogAsync(
                requestedProjectId ?? selectedProjectId,
                allowFallback: !requestedProjectId.HasValue,
                cancellation.Token);
            var dashboardTask = hasStaffingDashboardLoaded
                ? Task.FromResult(staffingDashboard)
                : GetStaffingDashboardAsync(cancellation.Token);

            await Task.WhenAll(projectCatalogTask, dashboardTask);
            if (!IsCurrentRouteLoad(generation, requestedProjectId))
            {
                return;
            }

            var projectCatalog = await projectCatalogTask;
            projectCount = projectCatalog.TotalCount;
            staffingDashboard = await dashboardTask;
            hasStaffingDashboardLoaded = true;

            var targetProjectId = projectCatalog.SelectedProject?.Id
                ?? requestedProjectId;
            SetSelectedProject(targetProjectId);
            selectedProject = projectCatalog.SelectedProject;
            if (requestedProjectId.HasValue &&
                projectCatalog.SelectedProject is null)
            {
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
                return;
            }

            var requestedData = AssignmentSelectionData.AssignmentCounts | GetRequiredData(selectedWorkspaceTab);
            var missingData = requestedData & ~loadedSelectionData;
            if (missingData is not AssignmentSelectionData.None)
            {
                var snapshot = await LoadSelectionSnapshotAsync(
                    new AssignmentSelectionLoadRequest(
                        targetProjectId,
                        missingData,
                        CaptureCandidateFilter())
                    {
                        StaffingRequestPageIndex = staffingRequestPageIndex,
                        StaffingRequestFilter = CaptureStaffingRequestFilter(),
                        StaffingCandidatePageIndex = staffingCandidatePageIndex,
                        RelationshipPageIndex = relationshipAssignmentPageIndex,
                        RelationshipSearchText = relationshipAssignmentSearchText,
                        RelationshipRoleFilter = relationshipAssignmentRoleFilter,
                        AllocationPageIndex = allocationAssignmentPageIndex,
                        AllocationSearchText = allocationAssignmentSearchText,
                        AllocationRoleFilter = allocationAssignmentRoleFilter
                    },
                    cancellation.Token);
                if (!IsCurrentRouteSelectionLoad(generation, requestedProjectId, targetProjectId))
                {
                    return;
                }

                MergeSelectionSnapshot(snapshot);
            }

            agentChatContextAccessState = AgentChatContextAccessState.Ready;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            if (IsCurrentRouteLoad(generation, requestedProjectId))
            {
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
                Logger.LogError(
                    exception,
                    "Failed to load the CRM-HR assignments workspace for route project {ProjectId}.",
                    requestedProjectId);
                throw;
            }
        }
        finally
        {
            if (generation == Volatile.Read(ref loadGeneration))
            {
                isProjectContextLoading = false;
            }

            CompleteLoad(cancellation);
        }
    }

    private Task HandleProjectChanged(Guid? projectId)
        => LoadSelectionAsync(projectId);

    private async Task LoadSelectionAsync(Guid? projectId)
    {
        isProjectContextLoading = true;
        var generation = BeginLoad(out var cancellation);
        SetSelectedProject(projectId);
        await InvokeAsync(StateHasChanged);
        try
        {
            var resolvedProject = projectId.HasValue
                ? await GetProjectAsync(projectId.Value, cancellation.Token)
                : null;
            if (!IsCurrentSelectionLoad(generation, projectId))
            {
                return;
            }

            if (projectId.HasValue && resolvedProject is null)
            {
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
                return;
            }

            selectedProject = resolvedProject;
            var requestedData = AssignmentSelectionData.AssignmentCounts | GetRequiredData(selectedWorkspaceTab);
            var snapshot = await LoadSelectionSnapshotAsync(
                new AssignmentSelectionLoadRequest(
                    projectId,
                    requestedData,
                    CaptureCandidateFilter())
                {
                    StaffingRequestPageIndex = staffingRequestPageIndex,
                    StaffingRequestFilter = CaptureStaffingRequestFilter(),
                    StaffingCandidatePageIndex = staffingCandidatePageIndex,
                    RelationshipPageIndex = relationshipAssignmentPageIndex,
                    RelationshipSearchText = relationshipAssignmentSearchText,
                    RelationshipRoleFilter = relationshipAssignmentRoleFilter,
                    AllocationPageIndex = allocationAssignmentPageIndex,
                    AllocationSearchText = allocationAssignmentSearchText,
                    AllocationRoleFilter = allocationAssignmentRoleFilter
                },
                cancellation.Token);
            if (!IsCurrentSelectionLoad(generation, projectId))
            {
                return;
            }

            MergeSelectionSnapshot(snapshot);
            agentChatContextAccessState = AgentChatContextAccessState.Ready;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            if (IsCurrentSelectionLoad(generation, projectId))
            {
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
                Logger.LogError(
                    exception,
                    "Failed to load assignment data for project {ProjectId}.",
                    projectId);
                throw;
            }
        }
        finally
        {
            if (generation == Volatile.Read(ref loadGeneration))
            {
                isProjectContextLoading = false;
            }

            CompleteLoad(cancellation);
        }
    }

    private async Task HandleWorkspaceTabChangedAsync(int selectedIndex)
    {
        if (!Enum.IsDefined(typeof(AssignmentWorkspaceTab), selectedIndex))
        {
            throw new ArgumentOutOfRangeException(nameof(selectedIndex));
        }

        selectedWorkspaceTab = (AssignmentWorkspaceTab)selectedIndex;
        await InvokeAsync(StateHasChanged);
        await EnsureSelectionDataLoadedAsync(
            AssignmentSelectionData.AssignmentCounts | GetRequiredData(selectedWorkspaceTab));
    }

    private static AssignmentSelectionData GetRequiredData(AssignmentWorkspaceTab tab)
        => tab switch
        {
            AssignmentWorkspaceTab.ResourceSchedule => AssignmentSelectionData.ScheduleAssignments,
            AssignmentWorkspaceTab.Relationships => AssignmentSelectionData.RelationshipAssignments,
            AssignmentWorkspaceTab.StaffingRequests => AssignmentSelectionData.StaffingRequests,
            AssignmentWorkspaceTab.Allocations => AssignmentSelectionData.AllocationAssignments,
            _ => throw new ArgumentOutOfRangeException(nameof(tab), tab, "The assignment workspace tab is not supported.")
        };

    private async Task<bool> EnsureSelectionDataLoadedAsync(
        AssignmentSelectionData requestedData,
        bool force = false)
    {
        if (isProjectContextLoading || !selectedProjectId.HasValue)
        {
            return false;
        }

        var dataToLoad = force
            ? requestedData
            : requestedData & ~loadedSelectionData;
        if (dataToLoad is AssignmentSelectionData.None)
        {
            return true;
        }

        var expectedProjectId = selectedProjectId;
        var generation = BeginLoad(out var cancellation);
        isSelectionDataLoading = true;
        loadingSelectionData = dataToLoad;
        await InvokeAsync(StateHasChanged);
        try
        {
            var snapshot = await LoadSelectionSnapshotAsync(
                new AssignmentSelectionLoadRequest(
                    expectedProjectId,
                    dataToLoad,
                    CaptureCandidateFilter())
                {
                    StaffingRequestPageIndex = staffingRequestPageIndex,
                    StaffingRequestFilter = CaptureStaffingRequestFilter(),
                    StaffingCandidatePageIndex = staffingCandidatePageIndex,
                    RelationshipPageIndex = relationshipAssignmentPageIndex,
                    RelationshipSearchText = relationshipAssignmentSearchText,
                    RelationshipRoleFilter = relationshipAssignmentRoleFilter,
                    AllocationPageIndex = allocationAssignmentPageIndex,
                    AllocationSearchText = allocationAssignmentSearchText,
                    AllocationRoleFilter = allocationAssignmentRoleFilter
                },
                cancellation.Token);
            if (!IsCurrentSelectionLoad(generation, expectedProjectId))
            {
                return false;
            }

            MergeSelectionSnapshot(snapshot);
            agentChatContextAccessState = AgentChatContextAccessState.Ready;
            await InvokeAsync(StateHasChanged);
            return true;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
            return false;
        }
        catch (Exception exception)
        {
            if (IsCurrentSelectionLoad(generation, expectedProjectId))
            {
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
                Logger.LogError(
                    exception,
                    "Failed to load CRM-HR assignment data {RequestedData} for project {ProjectId}.",
                    dataToLoad,
                    expectedProjectId);
                NotificationService.Error(
                    "Project records unavailable",
                    "The requested project records could not be loaded. Try again.");
            }

            return false;
        }
        finally
        {
            if (generation == Volatile.Read(ref loadGeneration))
            {
                isSelectionDataLoading = false;
                loadingSelectionData = AssignmentSelectionData.None;
            }

            CompleteLoad(cancellation);
        }
    }

    protected virtual async Task<AssignmentSelectionSnapshot> LoadSelectionSnapshotAsync(
        AssignmentSelectionLoadRequest request,
        CancellationToken cancellationToken)
    {
        var projectId = request.ProjectId;
        var requestedData = request.RequestedData;
        var assignmentCountsTask = requestedData.HasFlag(AssignmentSelectionData.AssignmentCounts) && projectId.HasValue
            ? ProjectPartyIntegrationService.GetAssignmentCountsAsync(
                projectId.Value,
                scheduleWindowStartUtc,
                scheduleWindowEndUtc,
                cancellationToken)
            : Task.FromResult(ProjectPartyAssignmentCounts.Empty);
        var assignmentPageTask = projectId.HasValue
            ? LoadRequestedAssignmentPageAsync(request, projectId.Value, cancellationToken)
            : Task.FromResult(ProjectPartyAssignmentPage.Empty());
        var skillCatalogTask = requestedData.HasFlag(AssignmentSelectionData.SkillCatalog)
            ? HrService.ListSkillCatalogAsync(cancellationToken)
            : Task.FromResult<IReadOnlyList<SkillCatalogItemModel>>([]);
        var staffingRequestsTask = requestedData.HasFlag(AssignmentSelectionData.StaffingRequests) && projectId.HasValue
            ? HrService.SearchStaffingRequestsAsync(
                new StaffingRequestQuery(
                    projectId.Value,
                    request.StaffingRequestFilter.SearchText,
                    request.StaffingRequestFilter.Status,
                    request.StaffingRequestPageIndex,
                    StaffingPageSize),
                cancellationToken)
            : Task.FromResult(StaffingRequestPage.Empty(StaffingPageSize));
        var staffingCandidatesTask = requestedData.HasFlag(AssignmentSelectionData.StaffingCandidates)
            ? SearchStaffingCandidatesAsync(
                request.CandidateFilter,
                request.StaffingCandidatePageIndex,
                cancellationToken)
            : Task.FromResult(StaffingCandidatePage.Empty(StaffingPageSize));

        await Task.WhenAll(
            assignmentCountsTask,
            assignmentPageTask,
            skillCatalogTask,
            staffingRequestsTask,
            staffingCandidatesTask);

        var staffingRequestPage = await staffingRequestsTask;
        var staffingCandidatePage = await staffingCandidatesTask;
        var assignmentPage = await assignmentPageTask;
        return new AssignmentSelectionSnapshot(
            requestedData,
            assignmentPage.Items,
            await skillCatalogTask,
            staffingRequestPage.Items,
            staffingCandidatePage.Items)
        {
            AssignmentCounts = await assignmentCountsTask,
            AssignmentPageIndex = assignmentPage.PageIndex,
            AssignmentTotalCount = assignmentPage.TotalCount,
            StaffingRequestPageIndex = staffingRequestPage.PageIndex,
            StaffingRequestTotalCount = staffingRequestPage.TotalCount,
            StaffingCandidatePageIndex = staffingCandidatePage.PageIndex,
            StaffingCandidateTotalCount = staffingCandidatePage.TotalCount
        };
    }

    private Task<ProjectPartyAssignmentPage> LoadRequestedAssignmentPageAsync(
        AssignmentSelectionLoadRequest request,
        Guid projectId,
        CancellationToken cancellationToken)
    {
        var requestedViews = request.RequestedData &
            (AssignmentSelectionData.ScheduleAssignments |
             AssignmentSelectionData.RelationshipAssignments |
             AssignmentSelectionData.AllocationAssignments);
        if (requestedViews is AssignmentSelectionData.None)
        {
            return Task.FromResult(ProjectPartyAssignmentPage.Empty());
        }

        if (requestedViews != AssignmentSelectionData.ScheduleAssignments &&
            requestedViews != AssignmentSelectionData.RelationshipAssignments &&
            requestedViews != AssignmentSelectionData.AllocationAssignments)
        {
            throw new InvalidOperationException(
                "Only one assignment detail view can be loaded in a single selection snapshot.");
        }

        if (requestedViews == AssignmentSelectionData.ScheduleAssignments)
        {
            return ProjectPartyIntegrationService.SearchAssignmentsDetailedAsync(
                new ProjectPartyAssignmentQuery(
                    projectId,
                    AllAssignmentRoles,
                    PageSize: ProjectPartyAssignmentQueryLimits.SchedulePageSize,
                    WindowStartUtc: scheduleWindowStartUtc,
                    WindowEndUtc: scheduleWindowEndUtc,
                    AllocationOnly: true),
                cancellationToken);
        }

        if (requestedViews == AssignmentSelectionData.RelationshipAssignments)
        {
            var roles = request.RelationshipRoleFilter.HasValue
                ? [request.RelationshipRoleFilter.Value]
                : AllAssignmentRoles;
            return ProjectPartyIntegrationService.SearchAssignmentsDetailedAsync(
                new ProjectPartyAssignmentQuery(
                    projectId,
                    roles,
                    request.RelationshipSearchText,
                    request.RelationshipPageIndex,
                    AssignmentPageSize),
                cancellationToken);
        }

        var allocationRoles = request.AllocationRoleFilter.HasValue
            ? [request.AllocationRoleFilter.Value]
            : AllAssignmentRoles;
        return ProjectPartyIntegrationService.SearchAssignmentsDetailedAsync(
            new ProjectPartyAssignmentQuery(

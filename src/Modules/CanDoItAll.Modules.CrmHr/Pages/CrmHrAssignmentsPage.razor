    protected readonly record struct AssignmentSelectionLoadRequest(
        Guid? ProjectId,
        AssignmentSelectionData RequestedData,
        CandidateFilterSnapshot CandidateFilter)
    {
        public int StaffingRequestPageIndex { get; init; }

        public StaffingRequestFilterSnapshot StaffingRequestFilter { get; init; }

        public int StaffingCandidatePageIndex { get; init; }

        public int RelationshipPageIndex { get; init; }

        public string RelationshipSearchText { get; init; } = string.Empty;

        public ProjectPartyAssignmentRole? RelationshipRoleFilter { get; init; }

        public int AllocationPageIndex { get; init; }

        public string AllocationSearchText { get; init; } = string.Empty;

        public ProjectPartyAssignmentRole? AllocationRoleFilter { get; init; }
    }

    protected readonly record struct CandidateFilterSnapshot(
        Guid? SkillId,
        string SearchText,
        WorkforceAvailabilityState? AvailabilityState);

    protected readonly record struct StaffingRequestFilterSnapshot(
        string SearchText,
        StaffingRequestStatus? Status);

    private static ProjectPartyAssignmentUpsertRequest CreateProjectAssignmentDraft(Guid? projectId = null)
    {
        return new ProjectPartyAssignmentUpsertRequest
        {
            ProjectId = projectId ?? Guid.Empty,
            Role = ProjectPartyAssignmentRole.Customer,
            Source = "crm-hr-ui",
            IsPrimary = true
        };
    }

    private static ProjectPartyAssignmentUpsertRequest CreateAllocationDraft(Guid? projectId = null)
    {
        return new ProjectPartyAssignmentUpsertRequest
        {
            ProjectId = projectId ?? Guid.Empty,
            Role = ProjectPartyAssignmentRole.TeamMember,
            Source = "crm-hr-ui",
            IsPrimary = false,
            AllocationPercent = 100m
        };
    }

    private static StaffingRequestEditorModel CreateStaffingRequestDraft(Guid? projectId = null)
    {
        return new StaffingRequestEditorModel
        {
            ProjectId = projectId,
            AllocationPercent = 100m,
            Status = StaffingRequestStatus.Open
        };
    }
}

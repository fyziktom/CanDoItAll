    private async Task HandleStaffingRequestSearchTextChangedAsync(string value)
    {
        staffingRequestSearchText = value;
        staffingRequestPageIndex = 0;
        var currentSearch = new CancellationTokenSource();
        var supersededSearch = Interlocked.Exchange(
            ref staffingRequestSearchCancellation,
            currentSearch);
        supersededSearch?.Cancel();
        supersededSearch?.Dispose();
        try
        {
            await Task.Delay(
                StaffingRequestSearchDebounceMilliseconds,
                currentSearch.Token);
            await EnsureSelectionDataLoadedAsync(
                AssignmentSelectionData.StaffingRequests,
                force: true);
        }
        catch (OperationCanceledException) when (currentSearch.IsCancellationRequested)
        {
        }
        finally
        {
            if (ReferenceEquals(
                    Interlocked.CompareExchange(
                        ref staffingRequestSearchCancellation,
                        null,
                        currentSearch),
                    currentSearch))
            {
                currentSearch.Dispose();
            }
        }
    }


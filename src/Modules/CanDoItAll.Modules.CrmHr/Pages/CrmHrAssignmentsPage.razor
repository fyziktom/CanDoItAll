    private void EnsureScheduleWindow()
    {
        if (scheduleWindowStartUtc != default &&
            scheduleWindowEndUtc != default)
        {
            return;
        }

        ResetScheduleWindow();
    }

    private void ResetScheduleWindow()
    {
        var now = Clock.GetUtcNow();
        scheduleWindowStartUtc = now.AddDays(-90);
        scheduleWindowEndUtc = now.AddMonths(18);
    }

    private void CancelStaffingRequestSearch()
    {
        var cancellation = Interlocked.Exchange(
            ref staffingRequestSearchCancellation,
            null);
        cancellation?.Cancel();
        cancellation?.Dispose();

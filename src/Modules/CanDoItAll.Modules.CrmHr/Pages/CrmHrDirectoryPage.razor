@using static CanDoItAll.CrmHr.UI.Parties.CrmHrDirectoryWorkspacePresentation
@page "/crm-hr/directory"
@implements IDisposable
@using CanDoItAll.SharedKernel
@using Microsoft.Extensions.Logging
@inject PartyDirectoryService PartyDirectoryService
@inject PartyDirectoryManagementService ManagementService
@inject IPartyOrganizationAffiliationService AffiliationService
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject ILogger<CrmHrDirectoryPage> Logger

<PageTitle>CRM / HR Directory</PageTitle>

<AgentChatContextSurfaceProvider Surface="@AgentChatSurface"
                                 ContextNavigationIdentity="@AgentChatNavigationFence"
                                 ContextAccessState="@agentChatContextAccessState" />

<CrmHrDirectoryWorkspaceSurface View="this">
    <SecondaryNavigation>
        <CrmHrSecondaryTabs SelectedArea="CrmHrWorkspaceArea.Directory" />
    </SecondaryNavigation>
    <ActivityTimeline>
        <InteractionTimeline Presentation="@PartyActivityPresentation"
                             PageRequested="HandleActivityPageRequestedAsync"
                             DataTestId="crmhr-directory-activity"
                             Eyebrow="Party history"
                            Title="Recent interactions, changes, and follow-ups"
                            Description="Directory edits, CRM interactions, recruiting state changes, and workforce or AI updates stay visible in one place for the selected party."
                            EmptyEyebrow="No party activity"
                            EmptyTitle="No saved activity for this party"
                            EmptyDescription="Save the party and related CRM-HR workflows to start building a shared history." />
    </ActivityTimeline>
</CrmHrDirectoryWorkspaceSurface>

@code {
    // What the history lane accepted for the selected party, and its failure copy; the surface never sees the session.
    private CrmHrActivityPresentation PartyActivityPresentation => partyActivity.Presentation;

    private string? PartyActivityFailureMessage => partyActivity.FailureMessage;

    [SupplyParameterFromQuery(Name = "partyId")]
    public Guid? PartyIdQuery { get; set; }

    private const int ProfileTabIndex = 0;
    private const int ContactsTabIndex = 1;
    private const int HandlingTabIndex = 2;
    private const int ActivityTabIndex = 3;
    private const int RelationshipsTabIndex = 4;

    private PartyEditorViewModel editor = PartyEditorViewModel.CreateNew();
    private IReadOnlyList<PartyOrganizationAffiliationListItemModel> affiliationItems = [];
    private IReadOnlyList<PartyOrganizationAffiliationEditorModel> affiliationEditors = [];
    private IReadOnlyDictionary<Guid, string> affiliationPartyDisplayNames =
        new Dictionary<Guid, string>();
    private List<PartyRelationshipEditorModel> relationships = [];
    private IReadOnlyList<PartyDuplicateCandidateModel> duplicateCandidates = [];
    private CrmHrActivityHistorySession partyActivity = default!;
    private long partyActivityGeneration;
    private PartyProjectAssignmentPage projectAssignmentsPage = PartyProjectAssignmentPage.Empty();
    private PartyDuplicateCandidateModel? mergeCandidate;
    private bool isEditorDialogOpen;
    private bool isMergeDialogOpen;
    private bool isImportExportDialogOpen;
    private bool isRelationshipsLoading;
    private bool isProjectAssignmentsLoading;
    private string? handledPartyKey;
    private bool hasHandledPartyRequest;
    private long directoryLoadGeneration;
    private long directoryBrowserVersion;
    private int selectedEditorTabIndex = ProfileTabIndex;
    private string relationshipsLoadError = string.Empty;
    private string projectAssignmentsLoadError = string.Empty;
    private Guid? relationshipsLoadedPartyId;
    private Guid? affiliationsLoadedPartyId;
    private Guid? projectAssignmentsLoadedPartyId;
    private Guid? relationshipsLoadPartyId;
    private Guid? projectAssignmentsLoadPartyId;
    private long relationshipsLoadGeneration;
    private long projectAssignmentsLoadGeneration;
    private Task? relationshipsLoadTask;
    private Task? projectAssignmentsLoadTask;
    private CancellationTokenSource? projectAssignmentsLoadCancellation;
    private AgentChatContextAccessState agentChatContextAccessState = AgentChatContextAccessState.Loading;

    private AgentChatContextSurface AgentChatSurface => editor.Id is { } partyId &&
                                                         (!PartyIdQuery.HasValue || PartyIdQuery.Value == partyId)
        ? CrmHrAgentChatSurfaceBuilder.BuildDirectorySurface(
            partyId,
            editor.DisplayName,
            editor.LifecycleStatus)
        : CrmHrAgentChatSurfaceBuilder.BuildDirectorySurface();

    private AgentChatNavigationIdentity AgentChatNavigationFence
        => AgentChatNavigationIdentity.CreateForLocation(
            Navigation.BaseUri,
            Navigation.Uri,
            [new("partyId", PartyIdQuery?.ToString("D"))]);

    private string EditorTitle => editor.Id.HasValue ? editor.DisplayName : "New party";

    private PartyOrganizationAffiliationListItemModel? CurrentPrimaryAffiliation
        => affiliationItems
            .Where(item => item.IsCurrent)
            .OrderByDescending(item => item.IsPrimary)
            .ThenBy(item => item.OrganizationDisplayName)
            .FirstOrDefault();

    private string OtherCurrentAffiliationsTooltip
    {
        get
        {
            var primaryAffiliation = CurrentPrimaryAffiliation;
            var otherAffiliations = affiliationItems
                .Where(item => item.IsCurrent && item.Id != primaryAffiliation?.Id)
                .Select(FormatAffiliation)
                .ToList();
            return otherAffiliations.Count == 0
                ? "No other current affiliations."
                : $"Other current affiliations: {string.Join("; ", otherAffiliations)}";
        }
    }

    protected override void OnInitialized()
    {
        partyActivity = new CrmHrActivityHistorySession(
            (query, cancellationToken) => PartyDirectoryService.SearchPartyActivityAsync(query, cancellationToken),
            initialFailureMessage: "Activity and project assignments could not be loaded.",
            pageFailureMessage: "The requested activity page could not be loaded.",
            Logger);
    }

    protected override async Task OnParametersSetAsync()
    {
        var requestedPartyId = PartyIdQuery;
        var currentPartyKey = PartyIdQuery?.ToString("N") ?? "new";
        if (hasHandledPartyRequest &&
            string.Equals(currentPartyKey, handledPartyKey, StringComparison.Ordinal))
        {
            return;
        }

        if (requestedPartyId != editor.Id)
        {
            isEditorDialogOpen = false;
        }

        var request = BeginDirectoryLoad(
            requestedPartyId,
            DirectoryLoadBinding.RouteBound);
        var outcome = await LoadAndCommitDirectoryAsync(request);
        if (outcome == DirectoryLoadOutcome.Stale)
        {
            return;
        }

        handledPartyKey = currentPartyKey;
        hasHandledPartyRequest = true;
        agentChatContextAccessState = outcome == DirectoryLoadOutcome.Ready
            ? AgentChatContextAccessState.Ready
            : AgentChatContextAccessState.Failed;
        isEditorDialogOpen = outcome == DirectoryLoadOutcome.Ready && requestedPartyId.HasValue;

        if (outcome == DirectoryLoadOutcome.Ready)
        {
            await EnsureSelectedTabDataLoadedAsync();
        }
    }

    private async Task LoadAsync(Guid? selectedPartyId, bool clearMessage = true)
    {
        var request = BeginDirectoryLoad(
            selectedPartyId,
            DirectoryLoadBinding.Interactive);
        var outcome = await LoadAndCommitDirectoryAsync(request);
        if (outcome == DirectoryLoadOutcome.Stale)
        {
            return;
        }

        handledPartyKey = selectedPartyId?.ToString("N") ?? "new";
        hasHandledPartyRequest = true;
        agentChatContextAccessState = outcome == DirectoryLoadOutcome.Ready
            ? AgentChatContextAccessState.Ready
            : AgentChatContextAccessState.Failed;

        if (outcome == DirectoryLoadOutcome.Ready)
        {
            await EnsureSelectedTabDataLoadedAsync();
        }
    }

    private Task SelectPartyAsync(Guid partyId)
    {
        Interlocked.Increment(ref directoryLoadGeneration);
        isEditorDialogOpen = false;
        selectedEditorTabIndex = ProfileTabIndex;
        agentChatContextAccessState = AgentChatContextAccessState.Loading;
        Navigation.NavigateTo($"/crm-hr/directory?partyId={partyId}", replace: true);
        return Task.CompletedTask;
    }

    private DirectoryLoadRequest BeginDirectoryLoad(
        Guid? requestedPartyId,
        DirectoryLoadBinding binding)
    {
        agentChatContextAccessState = AgentChatContextAccessState.Loading;
        return new DirectoryLoadRequest(
            requestedPartyId,
            binding == DirectoryLoadBinding.RouteBound ? PartyIdQuery : null,
            binding,
            Interlocked.Increment(ref directoryLoadGeneration));
    }

    private async Task<DirectoryLoadOutcome> LoadAndCommitDirectoryAsync(DirectoryLoadRequest request)
    {
        try
        {
            var snapshot = await LoadDirectorySnapshotAsync(request.RequestedPartyId);
            if (!IsCurrentDirectoryLoad(request))
            {
                return DirectoryLoadOutcome.Stale;
            }

            CommitDirectorySnapshot(snapshot);
            return snapshot.RequestedPartyFound
                ? DirectoryLoadOutcome.Ready
                : DirectoryLoadOutcome.Missing;
        }
        catch
        {
            if (!IsCurrentDirectoryLoad(request))
            {
                return DirectoryLoadOutcome.Stale;
            }

            agentChatContextAccessState = AgentChatContextAccessState.Failed;
            throw;
        }
    }

    private async Task<DirectoryLoadSnapshot> LoadDirectorySnapshotAsync(Guid? requestedPartyId)
    {
        if (!requestedPartyId.HasValue)
        {
            return DirectoryLoadSnapshot.ForNewParty();
        }

        var party = await PartyDirectoryService.GetPartyAsync(requestedPartyId.Value);
        if (party is null)
        {
            return DirectoryLoadSnapshot.ForMissingParty();
        }

        var affiliations = party.PartyType == PartyType.Person
            ? await AffiliationService.ListAsync(requestedPartyId.Value)
            : [];
        return new DirectoryLoadSnapshot(
            PartyEditorViewModel.FromEditorModel(party),
            affiliations,
            RequestedPartyFound: true);
    }

    private void CommitDirectorySnapshot(DirectoryLoadSnapshot snapshot)
    {
        var isPartySelectionChanged = editor.Id != snapshot.Editor.Id;
        editor = snapshot.Editor;
        if (isPartySelectionChanged)
        {
            selectedEditorTabIndex = ProfileTabIndex;
        }

        ResetDirectoryDetailState();
        ApplyAffiliations(snapshot.Affiliations);
    }

    private bool IsCurrentDirectoryLoad(DirectoryLoadRequest request)
        => request.Generation == Volatile.Read(ref directoryLoadGeneration) &&
           (request.Binding == DirectoryLoadBinding.Interactive ||
            PartyIdQuery == request.RoutePartyId);

    private Task CreateNewAsync()
    {
        Interlocked.Increment(ref directoryLoadGeneration);
        editor = PartyEditorViewModel.CreateNew();
        selectedEditorTabIndex = ProfileTabIndex;
        ResetDirectoryDetailState();
        handledPartyKey = "new";
        hasHandledPartyRequest = true;
        agentChatContextAccessState = AgentChatContextAccessState.Ready;
        isEditorDialogOpen = true;
        Navigation.NavigateTo("/crm-hr/directory", replace: true);
        return Task.CompletedTask;
    }

    private Task CloseEditorDialogAsync()
    {
        if (!isEditorDialogOpen)
        {
            return Task.CompletedTask;
        }

        Interlocked.Increment(ref directoryLoadGeneration);
        isEditorDialogOpen = false;
        editor = PartyEditorViewModel.CreateNew();
        selectedEditorTabIndex = ProfileTabIndex;
        ResetDirectoryDetailState();
        handledPartyKey = "new";
        hasHandledPartyRequest = true;
        agentChatContextAccessState = AgentChatContextAccessState.Ready;
        Navigation.NavigateTo("/crm-hr/directory", replace: true);
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        var action = CaptureDirectoryAction();
        var result = await PartyDirectoryService.SavePartyAsync(editor.ToEditorModel());
        if (!IsCurrentDirectoryAction(action))
        {
            return;
        }

        if (result.IsFailure)
        {
            NotificationService.Warning("Party was not saved", string.Join(" ", result.Errors.Select(error => error.Message)));
            return;
        }

        var savedPartyId = result.Value;
        editor.Id = savedPartyId;
        handledPartyKey = savedPartyId.ToString("N");

        if (affiliationsLoadedPartyId == savedPartyId)
        {
            var affiliationSaveResult = await AffiliationService.ReplaceAsync(
                savedPartyId,
                affiliationEditors,
                editor.LastChangedBy);
            if (!IsCurrentDirectoryAction(action))
            {
                return;
            }

            if (affiliationSaveResult.IsFailure)
            {
                directoryBrowserVersion++;
                NotificationService.Warning(
                    "Party saved with affiliation issue",
                    $"Affiliations were not updated. {string.Join(" ", affiliationSaveResult.Errors.Select(error => error.Message))}");
                return;
            }

            ApplyAffiliations(affiliationSaveResult.Value ?? []);
        }

        if (relationshipsLoadedPartyId == savedPartyId)
        {
            var relationshipSaveResult = await ManagementService.SaveRelationshipsAsync(
                savedPartyId,
                relationships,
                editor.LastChangedBy);
            if (!IsCurrentDirectoryAction(action))
            {
                return;
            }

            if (relationshipSaveResult.IsFailure)
            {
                directoryBrowserVersion++;
                duplicateCandidates = await ManagementService.FindPotentialDuplicatesAsync(savedPartyId);
                if (!IsCurrentDirectoryAction(action))
                {
                    return;
                }

                NotificationService.Warning(
                    "Party saved with relationship issue",
                    $"Relationships were not updated. {string.Join(" ", relationshipSaveResult.Errors.Select(error => error.Message))}");
                Navigation.NavigateTo($"/crm-hr/directory?partyId={savedPartyId}", replace: true);
                return;
            }
        }

        NotificationService.Success("Party saved", "Party saved.");
        directoryBrowserVersion++;
        await LoadAsync(savedPartyId, clearMessage: false);
        if (!isEditorDialogOpen || editor.Id != savedPartyId)
        {
            return;
        }

        Navigation.NavigateTo($"/crm-hr/directory?partyId={savedPartyId}", replace: true);
    }

    // CSV stewardship effects of the import and export region: the directory management owner exports, previews and
    // applies; the renderer only calls these.
    private Task<string> ExportPartyCsvAsync(PartyCsvExportScope scope, IReadOnlyList<Guid> partyIds)
        => scope switch
        {
            PartyCsvExportScope.SelectedParties => ManagementService.ExportPartiesCsvAsync(partyIds),
            PartyCsvExportScope.EntireDirectory => ManagementService.ExportAllPartiesCsvAsync(),
            _ => throw new ArgumentOutOfRangeException(nameof(scope), scope, "Unsupported party CSV export scope.")
        };

    private Task<Result<PartyCsvImportPreviewModel>> PreviewPartyImportAsync(string csvContent)
        => ManagementService.PreviewImportAsync(csvContent);

    private Task<Result<int>> ApplyPartyImportAsync(IReadOnlyList<PartyCsvImportPreviewRowModel> rows)
        => ManagementService.ApplyImportAsync(rows, "crm-hr-ui");

    private async Task HandleImportAppliedAsync()
    {
        directoryBrowserVersion++;
        await LoadAsync(editor.Id, clearMessage: false);
        isImportExportDialogOpen = false;
    }

    private void OpenImportExportDialog()
    {
        isImportExportDialogOpen = true;
    }

    private Task CloseImportExportDialogAsync()
    {
        isImportExportDialogOpen = false;
        return Task.CompletedTask;
    }

    private async Task HandleEditorTabChangedAsync(int index)
    {
        selectedEditorTabIndex = index;
        await EnsureSelectedTabDataLoadedAsync();
    }

    private Task EnsureSelectedTabDataLoadedAsync()
    {
        return selectedEditorTabIndex switch
        {
            ActivityTabIndex => EnsureActivityLoadedAsync(),
            RelationshipsTabIndex => EnsureRelationshipsLoadedAsync(),
            _ => Task.CompletedTask
        };
    }

    private async Task EnsureRelationshipsLoadedAsync()
    {
        if (editor.Id is not Guid partyId || relationshipsLoadedPartyId == partyId)
        {
            return;
        }

        var generation = Volatile.Read(ref directoryLoadGeneration);
        if (relationshipsLoadTask is null ||
            relationshipsLoadPartyId != partyId ||
            relationshipsLoadGeneration != generation)
        {
            relationshipsLoadPartyId = partyId;
            relationshipsLoadGeneration = generation;
            isRelationshipsLoading = true;
            relationshipsLoadError = string.Empty;
            relationshipsLoadTask = LoadRelationshipsAsync(partyId, generation);
        }

        await relationshipsLoadTask;
    }

    private async Task LoadRelationshipsAsync(Guid partyId, long generation)
    {
        try
        {
            var relationshipsTask = ManagementService.ListRelationshipsAsync(partyId);
            var duplicatesTask = ManagementService.FindPotentialDuplicatesAsync(partyId);
            await Task.WhenAll(relationshipsTask, duplicatesTask);
            if (!IsCurrentDetailLoad(partyId, generation))
            {
                return;
            }

            relationships = (await relationshipsTask).Select(MapRelationship).ToList();
            duplicateCandidates = await duplicatesTask;
            relationshipsLoadedPartyId = partyId;
        }
        catch when (!IsCurrentDetailLoad(partyId, generation))
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load directory relationships for party {PartyId}.", partyId);
            relationshipsLoadError = "Relationships and duplicate candidates could not be loaded.";
        }
        finally
        {
            if (relationshipsLoadPartyId == partyId && relationshipsLoadGeneration == generation)
            {
                isRelationshipsLoading = false;
                relationshipsLoadTask = null;
            }
        }
    }

    private async Task EnsureActivityLoadedAsync()
    {
        if (editor.Id is not Guid partyId)
        {
            return;
        }

        var timelineTask = EnsureActivityTimelineLoadedAsync(partyId);
        var assignmentsTask = EnsureProjectAssignmentsLoadedAsync(partyId);
        await Task.WhenAll(timelineTask, assignmentsTask);
    }

    // The party activity lane: the session owns the read, the accepted page, the busy gate and the fencing of late
    // outcomes. A newer directory load generation starts a fresh lane for the party, as the previous inline read did.
    private Task EnsureActivityTimelineLoadedAsync(Guid partyId)
    {
        var generation = Volatile.Read(ref directoryLoadGeneration);
        if (partyActivityGeneration != generation)
        {
            partyActivity.Invalidate();
            partyActivityGeneration = generation;
        }

        return partyActivity.EnsureLoadedAsync(partyId);
    }

    private async Task EnsureProjectAssignmentsLoadedAsync(Guid partyId)
    {
        if (projectAssignmentsLoadedPartyId == partyId)
        {
            return;
        }

        await LoadProjectAssignmentsPageAsync(partyId, 0);
    }

    private async Task HandleProjectAssignmentsPageRequestedAsync(int pageIndex)
    {
        if (editor.Id is not Guid partyId ||
            pageIndex < 0 ||
            pageIndex >= projectAssignmentsPage.TotalPages)
        {
            return;
        }

        await LoadProjectAssignmentsPageAsync(partyId, pageIndex);
    }

    private async Task LoadProjectAssignmentsPageAsync(Guid partyId, int pageIndex)
    {
        var generation = Volatile.Read(ref directoryLoadGeneration);
        CancelProjectAssignmentsLoad();
        projectAssignmentsLoadPartyId = partyId;
        projectAssignmentsLoadGeneration = generation;
        isProjectAssignmentsLoading = true;
        projectAssignmentsLoadError = string.Empty;
        projectAssignmentsLoadCancellation = new CancellationTokenSource();
        var cancellationToken = projectAssignmentsLoadCancellation.Token;
        projectAssignmentsLoadTask = LoadProjectAssignmentsPageCoreAsync(
            partyId,
            pageIndex,
            generation,
            cancellationToken);
        await projectAssignmentsLoadTask;
    }

    private async Task LoadProjectAssignmentsPageCoreAsync(
        Guid partyId,
        int pageIndex,
        long generation,
        CancellationToken cancellationToken)
    {
        try
        {
            var page = await PartyDirectoryService.SearchPartyProjectAssignmentsAsync(
                new PartyProjectAssignmentQuery(
                    partyId,
                    pageIndex,
                    PartyProjectAssignmentQueryLimits.DefaultPageSize),
                cancellationToken);
            if (!IsCurrentDetailLoad(partyId, generation))
            {
                return;
            }

            projectAssignmentsPage = page;
            projectAssignmentsLoadedPartyId = partyId;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch when (!IsCurrentDetailLoad(partyId, generation))
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to load project assignment page {PageIndex} for party {PartyId}.",
                pageIndex,
                partyId);
            projectAssignmentsLoadError = "The requested project assignment page could not be loaded.";
        }
        finally
        {
            if (projectAssignmentsLoadPartyId == partyId &&
                projectAssignmentsLoadGeneration == generation)
            {
                isProjectAssignmentsLoading = false;
                projectAssignmentsLoadTask = null;
            }
        }
    }

    private Task HandleActivityPageRequestedAsync(int pageIndex)
        => editor.Id is Guid partyId && partyActivity.Target == partyId
            ? partyActivity.RequestPageAsync(pageIndex)
            : Task.CompletedTask;

    private bool IsCurrentDetailLoad(Guid partyId, long generation)
        => editor.Id == partyId && generation == Volatile.Read(ref directoryLoadGeneration);

    private Task RetryRelationshipsLoadAsync()
    {
        relationshipsLoadedPartyId = null;
        relationshipsLoadTask = null;
        relationshipsLoadError = string.Empty;
        return EnsureRelationshipsLoadedAsync();
    }

    private Task RetryActivityLoadAsync()
    {
        partyActivity.Invalidate();
        return EnsureActivityLoadedAsync();
    }

    private Task RetryProjectAssignmentsLoadAsync()
    {
        projectAssignmentsLoadedPartyId = null;
        projectAssignmentsLoadTask = null;
        projectAssignmentsLoadError = string.Empty;
        return EnsureActivityLoadedAsync();
    }

    private void AddAdditionalRole()
    {
        editor.AdditionalRoles.Add(new PartyRoleAssignmentEditorModel
        {
            RoleKind = PartyRoleKind.Stakeholder,
            Title = "Stakeholder"
        });
    }

    private void AddConfidentialNote()
    {
        editor.ConfidentialNotes.Add(new PartyConfidentialNoteEditorModel
        {
            Category = PartyConfidentialNoteCategories.HumanResources,
            CreatedBy = editor.LastChangedBy,
            CreatedAtUtc = DateTimeOffset.UtcNow,
            UpdatedAtUtc = DateTimeOffset.UtcNow
        });
    }

    private void RemoveAdditionalRole(int index)
    {
        editor.AdditionalRoles.RemoveAt(index);
    }

    private void RemoveConfidentialNote(int index)
    {
        editor.ConfidentialNotes.RemoveAt(index);
    }

    private void OpenMergeDialog(PartyDuplicateCandidateModel candidate)
    {
        mergeCandidate = candidate;
        isMergeDialogOpen = true;
    }

    private Task HandleMergeCloseAsync()
    {
        isMergeDialogOpen = false;
        mergeCandidate = null;
        return Task.CompletedTask;
    }

    private async Task HandleMergeConfirmAsync(string reason)
    {
        if (editor.Id is not Guid retainedPartyId || mergeCandidate is null)
        {
            return;
        }

        var action = CaptureDirectoryAction();
        var candidateId = mergeCandidate.Id;
        var result = await ManagementService.MergePartyAsync(
            retainedPartyId,
            candidateId,
            editor.LastChangedBy,
            reason);
        if (!IsCurrentDirectoryAction(action) ||
            !isMergeDialogOpen ||
            mergeCandidate?.Id != candidateId)
        {
            return;
        }

        if (result.IsFailure || result.Value is not PartyMergeSummaryModel summary)
        {
            NotificationService.Warning("Party merge failed", string.Join(" ", result.Errors.Select(error => error.Message)));
            return;
        }

        await HandleMergeCloseAsync();
        NotificationService.Success("Party merged", summary.Summary);
        handledPartyKey = retainedPartyId.ToString("N");
        directoryBrowserVersion++;
        await LoadAsync(retainedPartyId, clearMessage: false);
        if (!isEditorDialogOpen || editor.Id != retainedPartyId)
        {
            return;
        }

        Navigation.NavigateTo($"/crm-hr/directory?partyId={retainedPartyId}", replace: true);
    }

    private DirectoryActionStamp CaptureDirectoryAction()
        => new(
            Volatile.Read(ref directoryLoadGeneration),
            PartyIdQuery,
            editor);

    private bool IsCurrentDirectoryAction(DirectoryActionStamp action)
        => action.Generation == Volatile.Read(ref directoryLoadGeneration) &&
           action.RoutePartyId == PartyIdQuery &&
           ReferenceEquals(action.Editor, editor);

    private void ResetDirectoryDetailState()
    {
        affiliationItems = [];
        affiliationEditors = [];
        affiliationPartyDisplayNames = new Dictionary<Guid, string>();
        relationships = [];
        duplicateCandidates = [];
        partyActivity.Invalidate();
        projectAssignmentsPage = PartyProjectAssignmentPage.Empty();
        relationshipsLoadedPartyId = null;
        affiliationsLoadedPartyId = null;
        projectAssignmentsLoadedPartyId = null;
        relationshipsLoadPartyId = null;
        projectAssignmentsLoadPartyId = null;
        relationshipsLoadTask = null;
        projectAssignmentsLoadTask = null;
        CancelProjectAssignmentsLoad();
        isRelationshipsLoading = false;
        isProjectAssignmentsLoading = false;
        relationshipsLoadError = string.Empty;
        projectAssignmentsLoadError = string.Empty;
        mergeCandidate = null;
        isMergeDialogOpen = false;
    }

    private void CancelProjectAssignmentsLoad()
    {
        projectAssignmentsLoadCancellation?.Cancel();
        projectAssignmentsLoadCancellation?.Dispose();
        projectAssignmentsLoadCancellation = null;
    }

    public void Dispose()
    {
        partyActivity.Dispose();
        CancelProjectAssignmentsLoad();
    }

    private Task HandleAffiliationsChangedAsync(
        IReadOnlyList<PartyOrganizationAffiliationEditorModel> affiliations)
    {
        affiliationEditors = affiliations;
        return Task.CompletedTask;
    }

    private void ApplyAffiliations(
        IReadOnlyList<PartyOrganizationAffiliationListItemModel> affiliations)
    {
        affiliationItems = affiliations;
        affiliationEditors = affiliations
            .Select(MapAffiliation)
            .ToList();
        var displayNames = new Dictionary<Guid, string>();
        foreach (var affiliation in affiliations)
        {
            displayNames[affiliation.OrganizationPartyId] =
                affiliation.OrganizationDisplayName;
            if (affiliation.OrganizationUnitPartyId is Guid organizationUnitPartyId)
            {
                displayNames[organizationUnitPartyId] =
                    affiliation.OrganizationUnitDisplayName;
            }

            if (affiliation.ManagerPartyId is Guid managerPartyId)
            {
                displayNames[managerPartyId] = affiliation.ManagerDisplayName;
            }
        }

        affiliationPartyDisplayNames = displayNames;
        affiliationsLoadedPartyId = editor.PartyType == PartyType.Person
            ? editor.Id
            : null;
    }

    private static PartyOrganizationAffiliationEditorModel MapAffiliation(
        PartyOrganizationAffiliationListItemModel affiliation)
    {
        return new PartyOrganizationAffiliationEditorModel
        {
            Id = affiliation.Id,
            PersonPartyId = affiliation.PersonPartyId,
            OrganizationPartyId = affiliation.OrganizationPartyId,
            AffiliationKind = affiliation.AffiliationKind,
            IsPrimary = affiliation.IsPrimary,
            JobTitle = affiliation.JobTitle,
            EmployeeCode = affiliation.EmployeeCode,
            OrganizationUnitPartyId = affiliation.OrganizationUnitPartyId,
            ManagerPartyId = affiliation.ManagerPartyId,
            ValidFrom = affiliation.ValidFrom,
            ValidTo = affiliation.ValidTo,
            Notes = affiliation.Notes,
            ExpectedUpdatedAtUtc = affiliation.UpdatedAtUtc
        };
    }

    private static PartyRelationshipEditorModel MapRelationship(PartyRelationshipListItemModel relationship)
    {
        return new PartyRelationshipEditorModel
        {
            Id = relationship.Id,
            RelatedPartyId = relationship.RelatedPartyId,
            RelatedPartyDisplayName = relationship.RelatedPartyDisplayName,
            RelatedPartyType = relationship.RelatedPartyType,
            RelationshipKind = relationship.RelationshipKind,
            IsOutgoing = relationship.IsOutgoing,
            IsPrimary = relationship.IsPrimary,
            StartDateUtc = relationship.StartDateUtc,
            EndDateUtc = relationship.EndDateUtc,
            Notes = relationship.Notes
        };
    }

    private string ProjectAssignmentsPageText => projectAssignmentsPage.TotalPages == 0
        ? "No pages"
        : $"Page {projectAssignmentsPage.PageIndex + 1:N0} of {projectAssignmentsPage.TotalPages:N0}";

    private bool CanMoveProjectAssignmentsPrevious =>
        !isProjectAssignmentsLoading && projectAssignmentsPage.PageIndex > 0;

    private bool CanMoveProjectAssignmentsNext =>
        !isProjectAssignmentsLoading &&
        projectAssignmentsPage.PageIndex + 1 < projectAssignmentsPage.TotalPages;

    private enum DirectoryLoadBinding
    {
        RouteBound,
        Interactive
    }

    private enum DirectoryLoadOutcome
    {
        Ready,
        Missing,
        Stale
    }

    private readonly record struct DirectoryLoadRequest(
        Guid? RequestedPartyId,
        Guid? RoutePartyId,
        DirectoryLoadBinding Binding,
        long Generation);

    private readonly record struct DirectoryActionStamp(
        long Generation,
        Guid? RoutePartyId,
        PartyEditorViewModel Editor);

    private sealed record DirectoryLoadSnapshot(
        PartyEditorViewModel Editor,
        IReadOnlyList<PartyOrganizationAffiliationListItemModel> Affiliations,
        bool RequestedPartyFound)
    {
        public static DirectoryLoadSnapshot ForNewParty()
            => Empty(requestedPartyFound: true);

        public static DirectoryLoadSnapshot ForMissingParty()
            => Empty(requestedPartyFound: false);

        private static DirectoryLoadSnapshot Empty(bool requestedPartyFound)
            => new(
                PartyEditorViewModel.CreateNew(),
                [],
                requestedPartyFound);
    }
}

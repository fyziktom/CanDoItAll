@page "/crm-hr/directory"
@using Microsoft.Extensions.Logging
@inject PartyDirectoryService PartyDirectoryService
@inject PartyDirectoryManagementService ManagementService
@inject IPartyOrganizationAffiliationService AffiliationService
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject ILogger<CrmHrDirectoryPage> Logger

<PageTitle>CRM / HR Directory</PageTitle>

<AgentChatContextSurfaceProvider Surface="@AgentChatSurface"
                                 ContextNavigationIdentity="@AgentChatNavigationFence"
                                 ContextAccessState="@agentChatContextAccessState" />

<PageScaffold MaxWidthClass="max-w-full">
    <Header>
        <PageHeader Eyebrow="CRM / HR"
                    Title="Party directory"
                    Description="Create and maintain shared party records for people, organizations, delivery units, and AI agents before downstream CRM or HR workflows branch into specialized screens."
                    Compact="true">
            <Stats>
                <CompactStat Label="directory"
                             Value="Server-paged"
                             TooltipText="Directory records are queried in bounded pages." />
                <CompactStat Label="search"
                             Value="Name + tags"
                             TooltipText="Search and tag filters execute at the data source."
                             Tone="info" />
                <CompactStat Label="scope"
                             Value="4 party types"
                             TooltipText="People, organizations, organization units, and AI agents share this directory."
                             Tone="success" />
                <CompactStat Label="sensitive"
                             Value="Masked"
                             TooltipText="Sensitive summaries and tags stay out of list projections."
                             Tone="warning" />
            </Stats>
            <Actions>
                <PageHeaderActionButton Icon="import_export"
                                        Label="CSV tools"
                                        TooltipText="Import or export directory records as CSV."
                                        Click="OpenImportExportDialog"
                                        data-testid="crmhr-directory-import-export-button" />
                <PageHeaderActionButton Icon="person_add"
                                        Label="New party"
                                        TooltipText="Create a new shared party record."
                                        Tone="ButtonTone.Primary"
                                        Click="CreateNewAsync"
                                        data-testid="crmhr-directory-new-button" />
            </Actions>
        </PageHeader>
    </Header>

    <ChildContent>
        <Stack GapScale="LayoutGap.Medium">
            <CrmHrSecondaryTabs SelectedArea="CrmHrWorkspaceArea.Directory" />

            <SurfaceCard data-testid="crmhr-directory-catalog">
                <Stack GapScale="LayoutGap.Medium">
                    <ListPanelHeader Title="Directory records"
                                     Description="Search and page through shared people, organizations, delivery units, and AI agents. Open a card to view or edit the complete record."
                                     Count="Server-paged" />
                    <PartyRecordBrowser @key="directoryBrowserVersion"
                                        SelectedPartyId="@editor.Id"
                                        SelectionChanged="SelectPartyAsync"
                                        IncludeArchived="true"
                                        PageSize="18"
                                        ResultsScrollMode="PagedRecordResultsScrollMode.Bounded"
                                        GridMode="PagedRecordGridMode.BoundedCatalog"
                                        SearchPlaceholder="Search name, code, summary, or tags"
                                        OptionTestId="crmhr-directory-item"
                                        DataTestId="crmhr-directory" />
                </Stack>
            </SurfaceCard>

            @if (isEditorDialogOpen)
            {
                <Dialog IsOpen="true"
                        Eyebrow="Party directory"
                        Title="@EditorTitle"
                        Subtitle="Shared identity, contact, privacy, activity, and relationship record."
                        Size="ModalSize.Full"
                        DenseChrome="true"
                        CloseOnBackdrop="false"
                        TestId="crmhr-directory-record-dialog"
                        OnClose="CloseEditorDialogAsync">
                    <ChildContent>
                    <Split Gap="LayoutGap.Medium">
                        <Stack GapScale="LayoutGap.Tiny">
                            <TextBlock TextStyle="TextStyle.EyebrowCaption" Value="Party editor" />
                            <h2 class="app-title-xl">@EditorTitle</h2>
                            <p class="app-body-muted">Shared identity and stewardship record.</p>
                            @if (editor.PartyType == PartyType.Person && editor.Id.HasValue)
                            {
                                @if (CurrentPrimaryAffiliation is { } primaryAffiliation)
                                {
                                    <TooltipTarget Text="@OtherCurrentAffiliationsTooltip"
                                                   Position="TooltipPosition.Bottom"
                                                   Duration="@((TimeSpan?)null)"
                                                   TestId="crmhr-directory-primary-affiliation-tooltip">
                                        <p class="text-sm font-medium text-slate-700"
                                           data-testid="crmhr-directory-primary-affiliation">
                                            @FormatAffiliation(primaryAffiliation)
                                        </p>
                                    </TooltipTarget>
                                }
                                else
                                {
                                    <p class="text-sm font-medium text-slate-600"
                                       data-testid="crmhr-directory-primary-affiliation">
                                        No current organization affiliation
                                    </p>
                                }
                            }
                        </Stack>
                        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                            <StatusBadge Tone="@ResolveStatusTone(editor.LifecycleStatus)" Text="@editor.LifecycleStatus.ToString()" />
                            <StatusBadge Tone="neutral" Text="@editor.PartyType.ToString()" />
                            @if (editor.IsSensitive)
                            {
                                <StatusBadge Tone="warning" Text="Sensitive" />
                            }
                        </Cluster>
                    </Split>

                    <EditForm id="crmhr-directory-record-form"
                              Model="editor"
                              OnValidSubmit="SaveAsync">
                        <Stack Class="min-h-full" GapScale="LayoutGap.Large">
                            <Tabs SelectedIndex="@selectedEditorTabIndex"
                                  SelectedIndexChanged="HandleEditorTabChangedAsync"
                                  RenderMode="TabRenderMode.Server"
                                  OverflowMode="TabsOverflowMode.Wrap"
                                  AriaLabel="Party editor sections"
                                  data-testid="crmhr-directory-tabs">
                                <TabsItem Text="Profile"
                                          Icon="badge"
                                          data-testid="crmhr-directory-tab-profile">
                                    <Stack GapScale="LayoutGap.XLarge">
                            <FormSection Title="Identity"
                                         Description="Capture the durable identity fields that let one record participate in CRM, HR, recruiting, and AI-agent flows.">
                                <Grid Gap="LayoutGap.Large" ColumnsMd="3">
                                    <div>
                                        <FormField Text="Type">
                                        <InputSelect @bind-Value="editor.PartyType"
                                                     class="ui-input"
                                                     data-testid="crmhr-party-type">
                                            @foreach (var partyType in Enum.GetValues<PartyType>())
                                            {
                                                <option value="@partyType">@partyType</option>
                                            }
                                        </InputSelect>
                                        </FormField>
                                    </div>
                                    <div>
                                        <FormField Text="Status">
                                        <InputSelect @bind-Value="editor.LifecycleStatus"
                                                     class="ui-input"
                                                     data-testid="crmhr-party-status">
                                            @foreach (var lifecycleStatus in Enum.GetValues<PartyLifecycleStatus>())
                                            {
                                                <option value="@lifecycleStatus">@lifecycleStatus</option>
                                            }
                                        </InputSelect>
                                        </FormField>
                                    </div>
                                    <div>
                                        <FormField Text="External code">
                                        <InputText @bind-Value="editor.ExternalCode"
                                                   class="ui-input"
                                                   data-testid="crmhr-party-external-code" />
                                        </FormField>
                                    </div>
                                </Grid>

                                <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                    <div>
                                        <FormField Text="Display name">
                                        <InputText @bind-Value="editor.DisplayName"
                                                   class="ui-input"
                                                   data-testid="crmhr-party-display-name" />
                                        </FormField>
                                    </div>
                                    <div>
                                        <FormField Text="Preferred name">
                                        <InputText @bind-Value="editor.PreferredName"
                                                   class="ui-input"
                                                   data-testid="crmhr-party-preferred-name" />
                                        </FormField>
                                    </div>
                                </Grid>

                                <div>
                                    <FormField Text="Legal name">
                                    <InputText @bind-Value="editor.LegalName"
                                               class="ui-input"
                                               data-testid="crmhr-party-legal-name" />
                                    </FormField>
                                </div>
                            </FormSection>

                            <FormSection Title="Classification and contact"
                                         Description="Keep role, tags, and direct contact details near the core identity so CRM, HR, and recruiting flows all start from the same party record.">
                                <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                    <div>
                                        <FormField Text="Primary role">
                                        <InputSelect @bind-Value="editor.PrimaryRoleKindText"
                                                     class="ui-input"
                                                     data-testid="crmhr-party-role">
                                            <option value="">No primary role yet</option>
                                            @foreach (var roleKind in Enum.GetValues<PartyRoleKind>())
                                            {
                                                <option value="@roleKind.ToString()">@roleKind</option>
                                            }
                                        </InputSelect>
                                        </FormField>
                                    </div>
                                    <div>
                                        <FormField Text="Tags">
                                        <TagEditor Value="@editor.Tags"
                                                   ValueChanged="value => editor.Tags = value"
                                                   Placeholder="Add customer, priority, or region tags"
                                                   MaxTags="20"
                                                   TestId="crmhr-party-tags-editor"
                                                   InputTestId="crmhr-party-tags" />
                                        </FormField>
                                    </div>
                                </Grid>

                                <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                    <div>
                                        <FormField Text="Primary email">
                                        <InputText @bind-Value="editor.PrimaryEmail"
                                                   class="ui-input"
                                                   data-testid="crmhr-party-email" />
                                        </FormField>
                                    </div>
                                    <div>
                                        <FormField Text="Primary phone">
                                        <InputText @bind-Value="editor.PrimaryPhone"
                                                   class="ui-input"
                                                   data-testid="crmhr-party-phone" />
                                        </FormField>
                                    </div>
                                </Grid>

                                <Stack GapScale="LayoutGap.Medium" Class="mt-5">
                                    <Split Gap="LayoutGap.Medium"
                                           AlignItems="AlignItems.Center"
                                           JustifyContent="JustifyContent.SpaceBetween">
                                        <div>
                                            <TextBlock TextStyle="TextStyle.EyebrowCaption" Value="Additional role assignments" />
                                            <p class="mt-1 text-sm leading-6 text-slate-600">Keep more than one business role on the same party instead of creating duplicate directory records.</p>
                                        </div>
                                        <Button Text="Add role"
                                                Tone="ButtonTone.Default"
                                                Size="ButtonSize.Small"
                                                Click="AddAdditionalRole"
                                                data-testid="crmhr-party-role-add" />
                                    </Split>

                                    @if (editor.AdditionalRoles.Count == 0)
                                    {
                                        <div class="rounded-[1.25rem] border border-dashed border-slate-300 bg-slate-50/70 px-4 py-4 text-sm leading-6 text-slate-600">
                                            No secondary roles defined yet.
                                        </div>
                                    }
                                    else
                                    {
                                        @for (var index = 0; index < editor.AdditionalRoles.Count; index++)
                                        {
                                            var role = editor.AdditionalRoles[index];
                                            <PanelCard Soft="true">
                                                <Grid Gap="LayoutGap.Medium" ColumnsLg="4">
                                                    <div>
                                                        <FormField Text="Role kind">
                                                        <InputSelect @bind-Value="role.RoleKind"
                                                                     class="ui-input"
                                                                     data-testid="@($"crmhr-party-extra-role-kind-{index}")">
                                                            @foreach (var roleKind in Enum.GetValues<PartyRoleKind>())
                                                            {
                                                                <option value="@roleKind">@roleKind</option>
                                                            }
                                                        </InputSelect>
                                                        </FormField>
                                                    </div>
                                                    <div class="lg:col-span-2">
                                                        <FormField Text="Role title">
                                                        <InputText @bind-Value="role.Title"
                                                                   class="ui-input"
                                                                   data-testid="@($"crmhr-party-extra-role-title-{index}")" />
                                                        </FormField>
                                                    </div>
                                                    <div class="flex items-end justify-end">
                                                        <Button Text="Remove"
                                                                Tone="ButtonTone.Danger"
                                                                Size="ButtonSize.Small"
                                                                Click="@(() => RemoveAdditionalRole(index))"
                                                                data-testid="@($"crmhr-party-extra-role-remove-{index}")" />
                                                    </div>
                                                </Grid>

                                                <Grid Gap="LayoutGap.Medium" ColumnsLg="3" Class="mt-4">
                                                    <div>
                                                        <FormField Text="Valid from">
                                                        <InputDate @bind-Value="role.ValidFromUtc"
                                                                   class="ui-input"
                                                                   data-testid="@($"crmhr-party-extra-role-start-{index}")" />
                                                        </FormField>
                                                    </div>
                                                    <div>
                                                        <FormField Text="Valid to">
                                                        <InputDate @bind-Value="role.ValidToUtc"
                                                                   class="ui-input"
                                                                   data-testid="@($"crmhr-party-extra-role-end-{index}")" />
                                                        </FormField>
                                                    </div>
                                                    <div>
                                                        <FormField Text="Notes">
                                                        <InputText @bind-Value="role.Notes"
                                                                   class="ui-input"
                                                                   data-testid="@($"crmhr-party-extra-role-notes-{index}")" />
                                                        </FormField>
                                                    </div>
                                                </Grid>
                                            </PanelCard>
                                        }
                                    }
                                </Stack>

                                <div>
                                    <FormField Text="Summary">
                                    <TextArea @bind-Value="editor.Summary"
                                                   Rows="4"
                                                   data-testid="crmhr-party-summary" />
                                    </FormField>
                                </div>
                            </FormSection>
                                    </Stack>
                                </TabsItem>

                                <TabsItem Text="Contacts"
                                          Icon="contacts"
                                          data-testid="crmhr-directory-tab-contacts">
                                    <FormSection Title="Contact methods and addresses"
                                                 Description="Keep secondary contact methods and structured addresses on the shared party record so downstream screens do not need their own copies.">
                                        <Stack GapScale="LayoutGap.XLarge">
                                            <PartyContactMethodsEditor ContactPoints="editor.AdditionalContactPoints" />
                                            <PartyAddressesEditor Addresses="editor.Addresses" />
                                        </Stack>

                                        <Grid Gap="LayoutGap.Large" ColumnsMd="3" Class="mt-5">
                                            <div>
                                                <FormField Text="Region">
                                                <InputText @bind-Value="editor.Region"
                                                           class="ui-input"
                                                           data-testid="crmhr-party-region" />
                                                </FormField>
                                            </div>
                                            <div>
                                                <FormField Text="Country code">
                                                <InputText @bind-Value="editor.CountryCode"
                                                           class="ui-input"
                                                           data-testid="crmhr-party-country" />
                                                </FormField>
                                            </div>
                                            <div>
                                                <FormField Text="Time zone">
                                                <InputText @bind-Value="editor.TimeZone"
                                                           class="ui-input"
                                                           data-testid="crmhr-party-timezone" />
                                                </FormField>
                                            </div>
                                        </Grid>
                                    </FormSection>
                                </TabsItem>

                                <TabsItem Text="Privacy"
                                          Icon="shield_lock"
                                          data-testid="crmhr-directory-tab-handling">
                            <FormSection Title="Privacy and notes"
                                         Description="Keep sensitivity, operational context, and confidential notes together so downstream CRM-HR flows do not overexpose private detail.">
                                @if (editor.Id.HasValue)
                                {
                                    <SensitiveDataCallout IsSensitive="editor.IsSensitive"
                                                         LastChangedBy="@editor.LastChangedBy"
                                                         UpdatedAtUtc="editor.UpdatedAtUtc"
                                                         DataTestId="crmhr-directory-sensitive-callout" />
                                }

                                <CheckboxOption @bind-Value="editor.IsSensitive"
                                                   data-testid="crmhr-party-sensitive"  Text="Mark as sensitive" />

                                <div>
                                    <FormField Text="Operational notes">
                                    <TextArea @bind-Value="editor.Notes"

                                                   data-testid="crmhr-party-notes" />
                                    </FormField>
                                </div>

                                <div class="rounded-[1.25rem] border border-slate-200 bg-slate-50/80 px-4 py-4"
                                     data-testid="crmhr-confidential-notes-panel">
                                    <Split Gap="LayoutGap.Medium"
                                           AlignItems="AlignItems.Start"
                                           JustifyContent="JustifyContent.SpaceBetween">
                                        <div class="min-w-0">
                                            <TextBlock TextStyle="TextStyle.EyebrowCaption" Value="Confidential notes" />
                                            <h3 class="mt-1 text-lg font-semibold text-slate-950">HR-only and sensitive note stream</h3>
                                            <p class="mt-3 text-sm leading-6 text-slate-600">
                                                Keep high-sensitivity notes separate from broad operational context so downstream CRM-HR screens do not overexpose private detail.
                                            </p>
                                        </div>
                                        <Button Text="Add confidential note"
                                                Tone="ButtonTone.Default"
                                                Size="ButtonSize.Small"
                                                Type="button"
                                                Disabled="@(!editor.IsSensitive)"
                                                Click="AddConfidentialNote"
                                                data-testid="crmhr-confidential-note-add" />
                                    </Split>

                                    @if (!editor.IsSensitive)
                                    {
                                        <div class="mt-4 rounded-[1rem] border border-amber-200 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-800">
                                            Mark this record as sensitive before storing confidential notes.
                                        </div>
                                    }
                                    else if (editor.ConfidentialNotes.Count == 0)
                                    {
                                        <div class="mt-4 rounded-[1rem] border border-dashed border-slate-300 bg-white/80 px-4 py-4 text-sm leading-6 text-slate-600">
                                            No confidential notes stored yet.
                                        </div>
                                    }
                                    else
                                    {
                                        <Stack GapScale="LayoutGap.Medium" Class="mt-4">
                                            @for (var index = 0; index < editor.ConfidentialNotes.Count; index++)
                                            {
                                                var note = editor.ConfidentialNotes[index];
                                                <div class="rounded-[1rem] border border-slate-200 bg-white px-4 py-4"
                                                     data-testid="crmhr-confidential-note-item">
                                                    <Grid Gap="LayoutGap.Medium" ColumnsMd="4">
                                                        <div>
                                                            <FormField Text="Category">
                                                            <InputSelect @bind-Value="note.Category"
                                                                         class="ui-input"
                                                                         data-testid="@($"crmhr-confidential-note-category-{index}")">
                                                                @foreach (var category in ConfidentialNoteCategories)
                                                                {
                                                                    <option value="@category">@category</option>
                                                                }
                                                            </InputSelect>
                                                            </FormField>
                                                        </div>
                                                        <div class="md:col-span-2">
                                                            <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Stewardship</p>
                                                            <p class="mt-1 text-sm leading-6 text-slate-700">
                                                                Created @FormatMoment(note.CreatedAtUtc) by @FormatActor(note.CreatedBy)
                                                            </p>
                                                            <p class="text-sm leading-6 text-slate-600">
                                                                Updated @FormatMoment(note.UpdatedAtUtc)
                                                            </p>
                                                        </div>
                                                        <div class="flex items-start justify-end">
                                                            <Button Text="Remove"
                                                                    Tone="ButtonTone.Danger"
                                                                    Size="ButtonSize.Small"
                                                                    Type="button"
                                                                    Click="@(() => RemoveConfidentialNote(index))"
                                                                    data-testid="@($"crmhr-confidential-note-remove-{index}")" />
                                                        </div>
                                                    </Grid>

                                                    <div class="mt-4">
                                                        <FormField Text="Confidential note">
                                                        <TextArea @bind-Value="note.NoteText"
                                                                       Rows="4"
                                                                       data-testid="@($"crmhr-confidential-note-text-{index}")" />
                                                        </FormField>
                                                    </div>
                                                </div>
                                            }
                                        </Stack>
                                    }
                                </div>

                            </FormSection>
                                </TabsItem>

                                <TabsItem Text="Activity"
                                          Icon="history"
                                          Disabled="@(!editor.Id.HasValue)"
                                          data-testid="crmhr-directory-tab-activity">
                                    @if (isActivityLoading)
                                    {
                                        <LoadingState Eyebrow="Party activity"
                                                      Title="Loading activity and assignments"
                                                      Description="Only this tab's timeline and project links are being loaded." />
                                    }
                                    else if (!string.IsNullOrWhiteSpace(activityLoadError))
                                    {
                                        <SurfaceCard Soft="true" data-testid="crmhr-directory-activity-error">
                                            <TextBlock TextStyle="TextStyle.EyebrowCaption" Class="text-rose-700" Value="Activity unavailable" />
                                            <p class="mt-2 text-sm leading-6 text-slate-700">@activityLoadError</p>
                                            <Button Text="Retry"
                                                    Icon="refresh"
                                                    Tone="ButtonTone.Default"
                                                    Size="ButtonSize.Small"
                                                    Class="mt-4"
                                                    Click="RetryActivityLoadAsync" />
                                        </SurfaceCard>
                                    }
                                    else
                                    {
                            <FormSection Title="Activity and project context"
                                         Description="Review the selected party's interaction history and project links without crowding the editable record fields.">
                                <Stack GapScale="LayoutGap.XLarge">
                                    <InteractionTimeline Page="activityPage"
                                                         IsLoading="@isActivityLoading"
                                                         PageRequested="HandleActivityPageRequestedAsync"
                                                         DataTestId="crmhr-directory-activity"
                                                         Eyebrow="Party history"
                                                        Title="Recent interactions, changes, and follow-ups"
                                                        Description="Directory edits, CRM interactions, recruiting state changes, and workforce or AI updates stay visible in one place for the selected party."
                                                        EmptyEyebrow="No party activity"
                                                        EmptyTitle="No saved activity for this party"
                                                        EmptyDescription="Save the party and related CRM-HR workflows to start building a shared history." />

                                    <SurfaceCard>
                                        <TextBlock TextStyle="TextStyle.EyebrowCaption" Value="Project assignments" />
                                        <h3 class="mt-1 text-lg font-semibold text-slate-950">Assignments and delivery context</h3>
                                        <p class="mt-3 text-sm leading-6 text-slate-600">
                                            Project-party links stay visible here so staffing, ownership, and stakeholder context do not require a separate workbench pass.
                                        </p>

                                        @if (isProjectAssignmentsLoading)
                                        {
                                            <div class="mt-5">
                                                <LoadingState Eyebrow="Project assignments"
                                                              Title="Loading assignment page"
                                                              Description="Loading only the requested assignment page for this party." />
                                            </div>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(projectAssignmentsLoadError))
                                        {
                                            <SurfaceCard Soft="true" Class="mt-5">
                                                <TextBlock TextStyle="TextStyle.EyebrowCaption" Class="text-rose-700" Value="Project assignments unavailable" />
                                                <h4 class="mt-1 text-base font-semibold text-slate-950">Assignment history could not be loaded</h4>
                                                <p class="mt-2 text-sm leading-6 text-slate-700">Retry to load the requested assignment page for this party.</p>
                                                <Button Text="Retry"
                                                        Icon="refresh"
                                                        Tone="ButtonTone.Default"
                                                        Size="ButtonSize.Small"
                                                        Class="mt-4"
                                                        Click="RetryProjectAssignmentsLoadAsync" />
                                            </SurfaceCard>
                                        }
                                        else if (projectAssignmentsPage.Items.Count == 0)
                                        {
                                            <div class="mt-5">
                                                <EmptyState Eyebrow="No assignments"
                                                            Title="This party is not linked to a project yet"
                                                            Description="Project, staffing, and stakeholder assignments will appear here after they are saved from project-aware flows." />
                                            </div>
                                        }
                                        else
                                        {
                                            <Stack GapScale="LayoutGap.Small" Class="mt-5">
                                                @foreach (var assignment in projectAssignmentsPage.Items)
                                                {
                                                    <div class="rounded-[1.25rem] border border-slate-200 bg-slate-50/80 px-4 py-4"
                                                         data-testid="crmhr-party-assignment-item">
                                                        <Split Gap="LayoutGap.Medium">
                                                            <div class="min-w-0">
                                                                <p class="text-sm font-semibold text-slate-950">@assignment.ProjectName</p>
                                                                <p class="mt-2 text-xs uppercase tracking-[0.18em] text-slate-500">@assignment.AssignmentKind / @assignment.NodeKey</p>
                                                                <p class="mt-2 text-xs text-slate-500">@BuildAssignmentSchedule(assignment)</p>
                                                                @if (!string.IsNullOrWhiteSpace(assignment.Notes))
                                                                {
                                                                    <p class="mt-3 text-sm leading-6 text-slate-600">@assignment.Notes</p>
                                                                }
                                                            </div>
                                                            <Cluster Gap="LayoutGap.Small">
                                                                @if (assignment.IsPrimary)
                                                                {
                                                                    <StatusBadge Tone="success" Text="Primary" />
                                                                }
                                                                @if (assignment.AllocationPercent.HasValue)
                                                                {
                                                                    <StatusBadge Tone="info" Text="@($"{assignment.AllocationPercent.Value:0.##}%")" />
                                                                }
                                                            </Cluster>
                                                        </Split>
                                                    </div>
                                                }
                                            </Stack>
                                        }

                                        <Split Breakpoint="LayoutBreakpoint.None"
                                               Gap="LayoutGap.Small"
                                               AlignItems="AlignItems.Center"
                                               JustifyContent="JustifyContent.SpaceBetween"
                                               Wrap="FlexWrap.Wrap"
                                               Class="mt-5"
                                               data-testid="crmhr-party-assignments-pager">
                                            <StatusBadge Tone="neutral" Text="@ProjectAssignmentsPageText" />
                                            <Cluster Gap="LayoutGap.Small">
                                                <Button Text="Previous"
                                                        Icon="chevron_left"
                                                        Tone="ButtonTone.Default"
                                                        Size="ButtonSize.Small"
                                                        Disabled="@(!CanMoveProjectAssignmentsPrevious)"
                                                        Click="@(() => HandleProjectAssignmentsPageRequestedAsync(projectAssignmentsPage.PageIndex - 1))"
                                                        data-testid="crmhr-party-assignments-previous" />
                                                <Button Text="Next"
                                                        Icon="chevron_right"
                                                        Tone="ButtonTone.Default"
                                                        Size="ButtonSize.Small"
                                                        Disabled="@(!CanMoveProjectAssignmentsNext)"
                                                        Click="@(() => HandleProjectAssignmentsPageRequestedAsync(projectAssignmentsPage.PageIndex + 1))"
                                                        data-testid="crmhr-party-assignments-next" />
                                            </Cluster>
                                        </Split>
                                    </SurfaceCard>
                                </Stack>
                            </FormSection>
                                    }
                                </TabsItem>

                                <TabsItem Text="Relations"
                                          Icon="account_tree"
                                          Disabled="@(!editor.Id.HasValue)"
                                          data-testid="crmhr-directory-tab-relationships">
                                    @if (isRelationshipsLoading)
                                    {
                                        <LoadingState Eyebrow="Party relationships"
                                                      Title="Loading relationships and duplicate candidates"
                                                      Description="Only this tab's stewardship data is being loaded." />
                                    }
                                    else if (!string.IsNullOrWhiteSpace(relationshipsLoadError))
                                    {
                                        <SurfaceCard Soft="true" data-testid="crmhr-directory-relationships-error">
                                            <TextBlock TextStyle="TextStyle.EyebrowCaption" Class="text-rose-700" Value="Relationship data unavailable" />
                                            <p class="mt-2 text-sm leading-6 text-slate-700">@relationshipsLoadError</p>
                                            <Button Text="Retry"
                                                    Icon="refresh"
                                                    Tone="ButtonTone.Default"
                                                    Size="ButtonSize.Small"
                                                    Class="mt-4"
                                                    Click="RetryRelationshipsLoadAsync" />
                                        </SurfaceCard>
                                    }
                                    else
                                    {
                            <FormSection Title="Relationships and duplicate stewardship"
                                         Description="Model org structure and safe deduplication here so downstream CRM, workforce, recruiting, and assignment flows inherit trusted references.">
                                <Stack GapScale="LayoutGap.XLarge">
                                    @if (editor.PartyType == PartyType.Person)
                                    {
                                        <PartyAffiliationsEditor CurrentPersonPartyId="editor.Id"
                                                                 Affiliations="affiliationEditors"
                                                                 AffiliationsChanged="HandleAffiliationsChangedAsync"
                                                                 PartyDisplayNames="affiliationPartyDisplayNames" />
                                    }

                                    <PartyRelationshipsEditor CurrentPartyId="editor.Id"
                                                             Relationships="relationships" />

                                    @if (!editor.Id.HasValue)
                                    {
                                        <div class="rounded-[1.25rem] border border-dashed border-slate-300 bg-slate-50/70 px-4 py-4 text-sm leading-6 text-slate-600">
                                            Save the party first to evaluate duplicate candidates against persisted directory records.
                                        </div>
                                    }
                                    else
                                    {
                                        <Stack GapScale="LayoutGap.Medium">
                                            <Split Gap="LayoutGap.Medium"
                                                   AlignItems="AlignItems.Center"
                                                   JustifyContent="JustifyContent.SpaceBetween">
                                                <div>
                                                    <TextBlock TextStyle="TextStyle.EyebrowCaption" Value="Potential duplicates" />
                                                    <p class="mt-1 text-sm leading-6 text-slate-600">Candidates are ranked by external code, normalized names, and contact value overlap.</p>
                                                </div>
                                                <StatusBadge Tone="@(duplicateCandidates.Count == 0 ? "success" : "warning")"
                                                             Text="@(duplicateCandidates.Count == 0 ? "No duplicates" : $"{duplicateCandidates.Count} candidate(s)")" />
                                            </Split>

                                            @if (duplicateCandidates.Count == 0)
                                            {
                                                <div class="rounded-[1.25rem] border border-dashed border-slate-300 bg-slate-50/70 px-4 py-4 text-sm leading-6 text-slate-600">
                                                    No duplicate candidates are currently detected for this party.
                                                </div>
                                            }
                                            else
                                            {
                                                @foreach (var candidate in duplicateCandidates)
                                                {
                                                    <PanelCard Soft="true">
                                                        <Split Gap="LayoutGap.Medium"
                                                               AlignItems="AlignItems.Start"
                                                               JustifyContent="JustifyContent.SpaceBetween">
                                                            <div class="min-w-0">
                                                                <p class="text-sm font-semibold text-slate-950">@candidate.DisplayName</p>
                                                                <p class="mt-1 text-xs uppercase tracking-[0.18em] text-slate-500">@candidate.PartyType / @candidate.LifecycleStatus</p>
                                                                @if (!string.IsNullOrWhiteSpace(candidate.Summary))
                                                                {
                                                                    <p class="mt-3 text-sm leading-6 text-slate-700">@candidate.Summary</p>
                                                                }
                                                                <p class="mt-3 text-sm leading-6 text-slate-700">Reasons: @string.Join(", ", candidate.MatchReasons)</p>
                                                            </div>
                                                            <Button Text="Merge into current party"
                                                                    Tone="ButtonTone.Warning"
                                                                    Size="ButtonSize.Small"
                                                                    Click="@(() => OpenMergeDialog(candidate))"
                                                                    data-testid="@($"crmhr-merge-open-{candidate.Id:N}")" />
                                                        </Split>
                                                    </PanelCard>
                                                }
                                            }
                                        </Stack>
                                    }
                                </Stack>
                            </FormSection>
                                    }
                                </TabsItem>
                            </Tabs>

                        </Stack>
                    </EditForm>
                    </ChildContent>
                    <Footer>
                        <Split Breakpoint="LayoutBreakpoint.None"
                               Gap="LayoutGap.Medium"
                               AlignItems="AlignItems.Center"
                               JustifyContent="JustifyContent.SpaceBetween"
                               Wrap="FlexWrap.Wrap">
                            <SmallText Text="Changes remain local until Save party succeeds." />
                            <Cluster Gap="LayoutGap.Small">
                                <Button Text="Close"
                                        Tone="ButtonTone.Default"
                                        Click="CloseEditorDialogAsync"
                                        data-testid="crmhr-directory-record-close" />
                                <Button Text="Save party"
                                        Click="SaveAsync"
                                        data-testid="crmhr-party-save-button" />
                            </Cluster>
                        </Split>
                    </Footer>
                </Dialog>
            }

            <PartyMergeDialog IsOpen="@isMergeDialogOpen"
                              CurrentPartyDisplayName="@editor.DisplayName"
                              Candidate="@mergeCandidate"
                              OnClose="HandleMergeCloseAsync"
                              OnConfirm="HandleMergeConfirmAsync" />

            @if (isImportExportDialogOpen)
            {
                <Dialog IsOpen="true"
                        Eyebrow="Party directory"
                        Title="Import and export"
                        Subtitle="Export the full directory on demand or validate CSV rows before importing them."
                        Size="ModalSize.Wide"
                        DenseChrome="true"
                        TestId="crmhr-directory-import-export-dialog"
                        OnClose="CloseImportExportDialogAsync">
                    <ChildContent>
                        <PartyImportExportActions ExportScope="PartyCsvExportScope.EntireDirectory"
                                                  ImportApplied="HandleImportAppliedAsync" />
                    </ChildContent>
                </Dialog>
            }

        </Stack>
    </ChildContent>
</PageScaffold>

@code {
    [SupplyParameterFromQuery(Name = "partyId")]
    public Guid? PartyIdQuery { get; set; }

    private const int ProfileTabIndex = 0;
    private const int ContactsTabIndex = 1;
    private const int HandlingTabIndex = 2;
    private const int ActivityTabIndex = 3;
    private const int RelationshipsTabIndex = 4;
    private static readonly IReadOnlyList<string> ConfidentialNoteCategories = PartyConfidentialNoteCategories.All;

    private PartyEditorViewModel editor = PartyEditorViewModel.CreateNew();
    private IReadOnlyList<PartyOrganizationAffiliationListItemModel> affiliationItems = [];
    private IReadOnlyList<PartyOrganizationAffiliationEditorModel> affiliationEditors = [];
    private IReadOnlyDictionary<Guid, string> affiliationPartyDisplayNames =
        new Dictionary<Guid, string>();
    private List<PartyRelationshipEditorModel> relationships = [];
    private IReadOnlyList<PartyDuplicateCandidateModel> duplicateCandidates = [];
    private CrmActivityHistoryPage activityPage = CrmActivityHistoryPage.Empty();
    private PartyProjectAssignmentPage projectAssignmentsPage = PartyProjectAssignmentPage.Empty();
    private PartyDuplicateCandidateModel? mergeCandidate;
    private bool isEditorDialogOpen;
    private bool isMergeDialogOpen;
    private bool isImportExportDialogOpen;
    private bool isRelationshipsLoading;
    private bool isActivityLoading;
    private bool isProjectAssignmentsLoading;
    private string? handledPartyKey;
    private bool hasHandledPartyRequest;
    private long directoryLoadGeneration;
    private long directoryBrowserVersion;
    private int selectedEditorTabIndex = ProfileTabIndex;
    private string relationshipsLoadError = string.Empty;
    private string activityLoadError = string.Empty;
    private string projectAssignmentsLoadError = string.Empty;
    private Guid? relationshipsLoadedPartyId;
    private Guid? affiliationsLoadedPartyId;
    private Guid? activityLoadedPartyId;
    private Guid? projectAssignmentsLoadedPartyId;
    private Guid? relationshipsLoadPartyId;
    private Guid? activityLoadPartyId;
    private Guid? projectAssignmentsLoadPartyId;
    private long relationshipsLoadGeneration;
    private long activityLoadGeneration;
    private long projectAssignmentsLoadGeneration;
    private Task? relationshipsLoadTask;
    private Task? activityLoadTask;
    private Task? projectAssignmentsLoadTask;
    private CancellationTokenSource? activityLoadCancellation;
    private CancellationTokenSource? projectAssignmentsLoadCancellation;
    private AgentChatContextAccessState agentChatContextAccessState = AgentChatContextAccessState.Loading;

    private AgentChatContextSurface AgentChatSurface => editor.Id is { } partyId &&
                                                         (!PartyIdQuery.HasValue || PartyIdQuery.Value == partyId)
        ? CrmHrAgentChatSurfaceBuilder.BuildDirectorySurface(
            partyId,
            editor.DisplayName,
            editor.LifecycleStatus)
        : CrmHrAgentChatSurfaceBuilder.BuildDirectorySurface();

    private AgentChatNavigationIdentity AgentChatNavigationFence
        => AgentChatNavigationIdentity.CreateForLocation(
            Navigation.BaseUri,
            Navigation.Uri,
            [new("partyId", PartyIdQuery?.ToString("D"))]);

    private string EditorTitle => editor.Id.HasValue ? editor.DisplayName : "New party";

    private PartyOrganizationAffiliationListItemModel? CurrentPrimaryAffiliation
        => affiliationItems
            .Where(item => item.IsCurrent)
            .OrderByDescending(item => item.IsPrimary)
            .ThenBy(item => item.OrganizationDisplayName)
            .FirstOrDefault();

    private string OtherCurrentAffiliationsTooltip
    {
        get
        {
            var primaryAffiliation = CurrentPrimaryAffiliation;
            var otherAffiliations = affiliationItems
                .Where(item => item.IsCurrent && item.Id != primaryAffiliation?.Id)
                .Select(FormatAffiliation)
                .ToList();
            return otherAffiliations.Count == 0
                ? "No other current affiliations."
                : $"Other current affiliations: {string.Join("; ", otherAffiliations)}";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var requestedPartyId = PartyIdQuery;
        var currentPartyKey = PartyIdQuery?.ToString("N") ?? "new";
        if (hasHandledPartyRequest &&
            string.Equals(currentPartyKey, handledPartyKey, StringComparison.Ordinal))
        {
            return;
        }

        if (requestedPartyId != editor.Id)
        {
            isEditorDialogOpen = false;
        }

        var request = BeginDirectoryLoad(
            requestedPartyId,
            DirectoryLoadBinding.RouteBound);
        var outcome = await LoadAndCommitDirectoryAsync(request);
        if (outcome == DirectoryLoadOutcome.Stale)
        {
            return;
        }

        handledPartyKey = currentPartyKey;
        hasHandledPartyRequest = true;
        agentChatContextAccessState = outcome == DirectoryLoadOutcome.Ready
            ? AgentChatContextAccessState.Ready
            : AgentChatContextAccessState.Failed;
        isEditorDialogOpen = outcome == DirectoryLoadOutcome.Ready && requestedPartyId.HasValue;

        if (outcome == DirectoryLoadOutcome.Ready)
        {
            await EnsureSelectedTabDataLoadedAsync();
        }
    }

    private async Task LoadAsync(Guid? selectedPartyId, bool clearMessage = true)
    {
        var request = BeginDirectoryLoad(
            selectedPartyId,
            DirectoryLoadBinding.Interactive);
        var outcome = await LoadAndCommitDirectoryAsync(request);
        if (outcome == DirectoryLoadOutcome.Stale)
        {
            return;
        }

        handledPartyKey = selectedPartyId?.ToString("N") ?? "new";
        hasHandledPartyRequest = true;
        agentChatContextAccessState = outcome == DirectoryLoadOutcome.Ready
            ? AgentChatContextAccessState.Ready
            : AgentChatContextAccessState.Failed;

        if (outcome == DirectoryLoadOutcome.Ready)
        {
            await EnsureSelectedTabDataLoadedAsync();
        }
    }

    private Task SelectPartyAsync(Guid partyId)
    {
        Interlocked.Increment(ref directoryLoadGeneration);
        isEditorDialogOpen = false;
        selectedEditorTabIndex = ProfileTabIndex;
        agentChatContextAccessState = AgentChatContextAccessState.Loading;
        Navigation.NavigateTo($"/crm-hr/directory?partyId={partyId}", replace: true);
        return Task.CompletedTask;
    }

    private DirectoryLoadRequest BeginDirectoryLoad(
        Guid? requestedPartyId,
        DirectoryLoadBinding binding)
    {
        agentChatContextAccessState = AgentChatContextAccessState.Loading;
        return new DirectoryLoadRequest(
            requestedPartyId,
            binding == DirectoryLoadBinding.RouteBound ? PartyIdQuery : null,
            binding,
            Interlocked.Increment(ref directoryLoadGeneration));
    }

    private async Task<DirectoryLoadOutcome> LoadAndCommitDirectoryAsync(DirectoryLoadRequest request)
    {
        try
        {
            var snapshot = await LoadDirectorySnapshotAsync(request.RequestedPartyId);
            if (!IsCurrentDirectoryLoad(request))
            {
                return DirectoryLoadOutcome.Stale;
            }

            CommitDirectorySnapshot(snapshot);
            return snapshot.RequestedPartyFound
                ? DirectoryLoadOutcome.Ready
                : DirectoryLoadOutcome.Missing;
        }
        catch
        {
            if (!IsCurrentDirectoryLoad(request))
            {
                return DirectoryLoadOutcome.Stale;
            }

            agentChatContextAccessState = AgentChatContextAccessState.Failed;
            throw;
        }
    }

    private async Task<DirectoryLoadSnapshot> LoadDirectorySnapshotAsync(Guid? requestedPartyId)
    {
        if (!requestedPartyId.HasValue)
        {
            return DirectoryLoadSnapshot.ForNewParty();
        }

        var party = await PartyDirectoryService.GetPartyAsync(requestedPartyId.Value);
        if (party is null)
        {
            return DirectoryLoadSnapshot.ForMissingParty();
        }

        var affiliations = party.PartyType == PartyType.Person
            ? await AffiliationService.ListAsync(requestedPartyId.Value)
            : [];
        return new DirectoryLoadSnapshot(
            PartyEditorViewModel.FromEditorModel(party),
            affiliations,
            RequestedPartyFound: true);
    }

    private void CommitDirectorySnapshot(DirectoryLoadSnapshot snapshot)
    {
        var isPartySelectionChanged = editor.Id != snapshot.Editor.Id;
        editor = snapshot.Editor;
        if (isPartySelectionChanged)
        {
            selectedEditorTabIndex = ProfileTabIndex;
        }

        ResetDirectoryDetailState();
        ApplyAffiliations(snapshot.Affiliations);
    }

    private bool IsCurrentDirectoryLoad(DirectoryLoadRequest request)
        => request.Generation == Volatile.Read(ref directoryLoadGeneration) &&
           (request.Binding == DirectoryLoadBinding.Interactive ||
            PartyIdQuery == request.RoutePartyId);

    private Task CreateNewAsync()
    {
        Interlocked.Increment(ref directoryLoadGeneration);
        editor = PartyEditorViewModel.CreateNew();
        selectedEditorTabIndex = ProfileTabIndex;
        ResetDirectoryDetailState();
        handledPartyKey = "new";
        hasHandledPartyRequest = true;
        agentChatContextAccessState = AgentChatContextAccessState.Ready;
        isEditorDialogOpen = true;
        Navigation.NavigateTo("/crm-hr/directory", replace: true);
        return Task.CompletedTask;
    }

    private Task CloseEditorDialogAsync()
    {
        if (!isEditorDialogOpen)
        {
            return Task.CompletedTask;
        }

        Interlocked.Increment(ref directoryLoadGeneration);
        isEditorDialogOpen = false;
        editor = PartyEditorViewModel.CreateNew();
        selectedEditorTabIndex = ProfileTabIndex;
        ResetDirectoryDetailState();
        handledPartyKey = "new";
        hasHandledPartyRequest = true;
        agentChatContextAccessState = AgentChatContextAccessState.Ready;
        Navigation.NavigateTo("/crm-hr/directory", replace: true);
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        var action = CaptureDirectoryAction();
        var result = await PartyDirectoryService.SavePartyAsync(editor.ToEditorModel());
        if (!IsCurrentDirectoryAction(action))
        {
            return;
        }

        if (result.IsFailure)
        {
            NotificationService.Warning("Party was not saved", string.Join(" ", result.Errors.Select(error => error.Message)));
            return;
        }

        var savedPartyId = result.Value;
        editor.Id = savedPartyId;
        handledPartyKey = savedPartyId.ToString("N");

        if (affiliationsLoadedPartyId == savedPartyId)
        {
            var affiliationSaveResult = await AffiliationService.ReplaceAsync(
                savedPartyId,
                affiliationEditors,
                editor.LastChangedBy);
            if (!IsCurrentDirectoryAction(action))
            {
                return;
            }

            if (affiliationSaveResult.IsFailure)
            {
                directoryBrowserVersion++;
                NotificationService.Warning(
                    "Party saved with affiliation issue",
                    $"Affiliations were not updated. {string.Join(" ", affiliationSaveResult.Errors.Select(error => error.Message))}");
                return;
            }

            ApplyAffiliations(affiliationSaveResult.Value ?? []);
        }

        if (relationshipsLoadedPartyId == savedPartyId)
        {
            var relationshipSaveResult = await ManagementService.SaveRelationshipsAsync(
                savedPartyId,
                relationships,
                editor.LastChangedBy);
            if (!IsCurrentDirectoryAction(action))
            {
                return;
            }

            if (relationshipSaveResult.IsFailure)
            {
                directoryBrowserVersion++;
                duplicateCandidates = await ManagementService.FindPotentialDuplicatesAsync(savedPartyId);
                if (!IsCurrentDirectoryAction(action))
                {
                    return;
                }

                NotificationService.Warning(
                    "Party saved with relationship issue",
                    $"Relationships were not updated. {string.Join(" ", relationshipSaveResult.Errors.Select(error => error.Message))}");
                Navigation.NavigateTo($"/crm-hr/directory?partyId={savedPartyId}", replace: true);
                return;
            }
        }

        NotificationService.Success("Party saved", "Party saved.");
        directoryBrowserVersion++;
        await LoadAsync(savedPartyId, clearMessage: false);
        if (!isEditorDialogOpen || editor.Id != savedPartyId)
        {
            return;
        }

        Navigation.NavigateTo($"/crm-hr/directory?partyId={savedPartyId}", replace: true);
    }

    private async Task HandleImportAppliedAsync()
    {
        directoryBrowserVersion++;
        await LoadAsync(editor.Id, clearMessage: false);
        isImportExportDialogOpen = false;
    }

    private void OpenImportExportDialog()
    {
        isImportExportDialogOpen = true;
    }

    private Task CloseImportExportDialogAsync()
    {
        isImportExportDialogOpen = false;
        return Task.CompletedTask;
    }

    private async Task HandleEditorTabChangedAsync(int index)
    {
        selectedEditorTabIndex = index;
        await EnsureSelectedTabDataLoadedAsync();
    }

    private Task EnsureSelectedTabDataLoadedAsync()
    {
        return selectedEditorTabIndex switch
        {
            ActivityTabIndex => EnsureActivityLoadedAsync(),
            RelationshipsTabIndex => EnsureRelationshipsLoadedAsync(),
            _ => Task.CompletedTask
        };
    }

    private async Task EnsureRelationshipsLoadedAsync()
    {
        if (editor.Id is not Guid partyId || relationshipsLoadedPartyId == partyId)
        {
            return;
        }

        var generation = Volatile.Read(ref directoryLoadGeneration);
        if (relationshipsLoadTask is null ||
            relationshipsLoadPartyId != partyId ||
            relationshipsLoadGeneration != generation)
        {
            relationshipsLoadPartyId = partyId;
            relationshipsLoadGeneration = generation;
            isRelationshipsLoading = true;
            relationshipsLoadError = string.Empty;
            relationshipsLoadTask = LoadRelationshipsAsync(partyId, generation);
        }

        await relationshipsLoadTask;
    }

    private async Task LoadRelationshipsAsync(Guid partyId, long generation)
    {
        try
        {
            var relationshipsTask = ManagementService.ListRelationshipsAsync(partyId);
            var duplicatesTask = ManagementService.FindPotentialDuplicatesAsync(partyId);
            await Task.WhenAll(relationshipsTask, duplicatesTask);
            if (!IsCurrentDetailLoad(partyId, generation))
            {
                return;
            }

            relationships = (await relationshipsTask).Select(MapRelationship).ToList();
            duplicateCandidates = await duplicatesTask;
            relationshipsLoadedPartyId = partyId;
        }
        catch when (!IsCurrentDetailLoad(partyId, generation))
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load directory relationships for party {PartyId}.", partyId);
            relationshipsLoadError = "Relationships and duplicate candidates could not be loaded.";
        }
        finally
        {
            if (relationshipsLoadPartyId == partyId && relationshipsLoadGeneration == generation)
            {
                isRelationshipsLoading = false;
                relationshipsLoadTask = null;
            }
        }
    }

    private async Task EnsureActivityLoadedAsync()
    {
        if (editor.Id is not Guid partyId)
        {
            return;
        }

        var timelineTask = EnsureActivityTimelineLoadedAsync(partyId);
        var assignmentsTask = EnsureProjectAssignmentsLoadedAsync(partyId);
        await Task.WhenAll(timelineTask, assignmentsTask);
    }

    private async Task EnsureActivityTimelineLoadedAsync(Guid partyId)
    {
        if (activityLoadedPartyId == partyId)
        {
            return;
        }

        var generation = Volatile.Read(ref directoryLoadGeneration);
        if (activityLoadTask is null ||
            activityLoadPartyId != partyId ||
            activityLoadGeneration != generation)
        {
            CancelActivityLoad();
            activityLoadPartyId = partyId;
            activityLoadGeneration = generation;
            isActivityLoading = true;
            activityLoadError = string.Empty;
            activityLoadCancellation = new CancellationTokenSource();
            activityLoadTask = LoadActivityAsync(
                partyId,
                generation,
                activityLoadCancellation.Token);
        }

        await activityLoadTask;
    }

    private async Task LoadActivityAsync(
        Guid partyId,
        long generation,
        CancellationToken cancellationToken)
    {
        try
        {
            var timeline = await PartyDirectoryService.SearchPartyActivityAsync(
                new CrmActivityHistoryQuery(partyId),
                cancellationToken);
            if (!IsCurrentDetailLoad(partyId, generation))
            {
                return;
            }

            activityPage = timeline;
            activityLoadedPartyId = partyId;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch when (!IsCurrentDetailLoad(partyId, generation))
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load directory activity for party {PartyId}.", partyId);
            activityLoadError = "Activity and project assignments could not be loaded.";
        }
        finally
        {
            if (activityLoadPartyId == partyId && activityLoadGeneration == generation)
            {
                isActivityLoading = false;
                activityLoadTask = null;
            }
        }
    }

    private async Task EnsureProjectAssignmentsLoadedAsync(Guid partyId)
    {
        if (projectAssignmentsLoadedPartyId == partyId)
        {
            return;
        }

        await LoadProjectAssignmentsPageAsync(partyId, 0);
    }

    private async Task HandleProjectAssignmentsPageRequestedAsync(int pageIndex)
    {
        if (editor.Id is not Guid partyId ||
            pageIndex < 0 ||
            pageIndex >= projectAssignmentsPage.TotalPages)
        {
            return;
        }

        await LoadProjectAssignmentsPageAsync(partyId, pageIndex);
    }

    private async Task LoadProjectAssignmentsPageAsync(Guid partyId, int pageIndex)
    {
        var generation = Volatile.Read(ref directoryLoadGeneration);
        CancelProjectAssignmentsLoad();
        projectAssignmentsLoadPartyId = partyId;
        projectAssignmentsLoadGeneration = generation;
        isProjectAssignmentsLoading = true;
        projectAssignmentsLoadError = string.Empty;
        projectAssignmentsLoadCancellation = new CancellationTokenSource();
        var cancellationToken = projectAssignmentsLoadCancellation.Token;
        projectAssignmentsLoadTask = LoadProjectAssignmentsPageCoreAsync(
            partyId,
            pageIndex,
            generation,
            cancellationToken);
        await projectAssignmentsLoadTask;
    }

    private async Task LoadProjectAssignmentsPageCoreAsync(
        Guid partyId,
        int pageIndex,
        long generation,
        CancellationToken cancellationToken)
    {
        try
        {
            var page = await PartyDirectoryService.SearchPartyProjectAssignmentsAsync(
                new PartyProjectAssignmentQuery(
                    partyId,
                    pageIndex,
                    PartyProjectAssignmentQueryLimits.DefaultPageSize),
                cancellationToken);
            if (!IsCurrentDetailLoad(partyId, generation))
            {
                return;
            }

            projectAssignmentsPage = page;
            projectAssignmentsLoadedPartyId = partyId;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch when (!IsCurrentDetailLoad(partyId, generation))
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to load project assignment page {PageIndex} for party {PartyId}.",
                pageIndex,
                partyId);
            projectAssignmentsLoadError = "The requested project assignment page could not be loaded.";
        }
        finally
        {
            if (projectAssignmentsLoadPartyId == partyId &&
                projectAssignmentsLoadGeneration == generation)
            {
                isProjectAssignmentsLoading = false;
                projectAssignmentsLoadTask = null;
            }
        }
    }

    private async Task HandleActivityPageRequestedAsync(int pageIndex)
    {
        if (editor.Id is not Guid partyId ||
            pageIndex < 0 ||
            pageIndex >= activityPage.TotalPages)
        {
            return;
        }

        var generation = Volatile.Read(ref directoryLoadGeneration);
        isActivityLoading = true;
        activityLoadError = string.Empty;
        try
        {
            var page = await PartyDirectoryService.SearchPartyActivityAsync(
                new CrmActivityHistoryQuery(
                    partyId,
                    pageIndex,
                    activityPage.PageSize));
            if (!IsCurrentDetailLoad(partyId, generation))
            {
                return;
            }

            activityPage = page;
        }
        catch when (!IsCurrentDetailLoad(partyId, generation))
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to load activity page {PageIndex} for party {PartyId}.",
                pageIndex,
                partyId);
            activityLoadError = "The requested activity page could not be loaded.";
        }
        finally
        {
            if (IsCurrentDetailLoad(partyId, generation))
            {
                isActivityLoading = false;
            }
        }
    }

    private bool IsCurrentDetailLoad(Guid partyId, long generation)
        => editor.Id == partyId && generation == Volatile.Read(ref directoryLoadGeneration);

    private Task RetryRelationshipsLoadAsync()
    {
        relationshipsLoadedPartyId = null;
        relationshipsLoadTask = null;
        relationshipsLoadError = string.Empty;
        return EnsureRelationshipsLoadedAsync();
    }

    private Task RetryActivityLoadAsync()
    {
        activityLoadedPartyId = null;
        activityLoadTask = null;
        activityLoadError = string.Empty;
        return EnsureActivityLoadedAsync();
    }

    private Task RetryProjectAssignmentsLoadAsync()
    {
        projectAssignmentsLoadedPartyId = null;
        projectAssignmentsLoadTask = null;
        projectAssignmentsLoadError = string.Empty;
        return EnsureActivityLoadedAsync();
    }

    private void AddAdditionalRole()
    {
        editor.AdditionalRoles.Add(new PartyRoleAssignmentEditorModel
        {
            RoleKind = PartyRoleKind.Stakeholder,
            Title = "Stakeholder"
        });
    }

    private void AddConfidentialNote()
    {

    private async Task OpenMergeDialogAsync(PartyDuplicateCandidateModel candidate) {
        if (editor.Id is not Guid retained || retained == candidate.Id || mergeState.IsBusy) {
            return;
        }
        if (HasUnsavedChanges() || editing.State.IsUnknown || affiliationEditing.State.IsUnknown || relationshipEditing.State.IsUnknown) {
            NotificationService.Warning("Local changes remain", "Save or discard the current party drafts before preparing a business merge.");
            return;
        }
        await merge.OpenAsync(retained, candidate);
    }

    private async Task HandleMergeCloseAsync() {
        if (!mergeState.IsOpen) {
            return;
        }
        var opening = mergeState.Opening;
        if (!await (mergeLeaveGuard ?? throw new InvalidOperationException("An open merge requires its leave guard.")).RequestLeaveAsync() ||
            isDisposed || opening != mergeState.Opening) {
            return;
        }
        var acceptedTarget = merge.AcceptedTarget;
        merge.Reset();
        if (acceptedTarget is Guid id) {
            await RefreshAfterCommitAsync(id, committed: true);
        }
    }

    private Task RefreshMergePreviewAsync() => merge.RefreshAsync();

    private async Task HandleMergeConfirmAsync(string reason) {
        if (!mergeState.CanConfirm || mergeState.Preview is not { } preview || editor.Id != preview.Retained.Id ||
            mergeCandidate?.Id != preview.Duplicate.Id || HasUnsavedChanges()) {
            return;
        }
        var action = CaptureDirectoryAction();
        using var admission = mutationGate.TryEnter(action.Generation);
        if (admission is not null && await merge.ConfirmAsync(reason) && IsCurrentDirectoryAction(action)) {
            directoryBrowserVersion++;
        }
    }

    private void CancelDirectorySubmissions(AffiliationSubmission? affiliations, RelationshipSubmission? relationships) {
        if (affiliations is not null) {
            affiliationEditing.CancelSubmission(affiliations);
        }
        if (relationships is not null) {
            relationshipEditing.CancelSubmission(relationships);
        }
    }

    private async Task<bool> RefreshAfterCommitAsync(Guid committedPartyId, bool committed = false)
    {
        try
        {
            await LoadAsync(committedPartyId, clearMessage: false, committed);
            return true;
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            // The read-back never ran, so the drafts keep owning every field they hold until the operator reloads.
            Logger.LogWarning(exception, "The directory record {PartyId} could not be refreshed after a committed change.", committedPartyId);
            NotificationService.Warning(
                "Saved, refresh failed",
                "The change was saved, but the record could not be refreshed. Reload the page to see the current state.");
            return false;
        }
    }

    private DirectoryActionStamp CaptureDirectoryAction()
        => new(
            Volatile.Read(ref directoryLoadGeneration),
            url.State.PartyId,
            editor);

    // A page that was left publishes nothing: its location intents would land in the page shown now.
    private bool IsCurrentDirectoryAction(DirectoryActionStamp action)
        => !isDisposed &&
           action.Generation == Volatile.Read(ref directoryLoadGeneration) &&
           action.RoutePartyId == url.State.PartyId &&
           ReferenceEquals(action.Editor, editor);

    private void ResetDirectoryDetailState(bool retainRelationships = false)
    {
        affiliationItems = [];
        affiliationPartyDisplayNames = new Dictionary<Guid, string>();
        if (!retainRelationships)
        {
            relationshipEditing.Clear();
            relationshipsLoadedPartyId = null;
        }

        duplicateCandidates = [];
        partyActivity.Invalidate();
        projectAssignmentsPage = PartyProjectAssignmentPage.Empty();
        affiliationsLoadedPartyId = null;
        projectAssignmentsLoadedPartyId = null;
        relationshipsLoadPartyId = null;
        projectAssignmentsLoadPartyId = null;
        relationshipsLoadTask = null;
        projectAssignmentsLoadTask = null;
        CancelProjectAssignmentsLoad();
        isRelationshipsLoading = false;
        isProjectAssignmentsLoading = false;
        relationshipsLoadError = string.Empty;
        projectAssignmentsLoadError = string.Empty;
        merge.Reset();
    }

    private void CancelProjectAssignmentsLoad()
    {
        projectAssignmentsLoadCancellation?.Cancel();
        projectAssignmentsLoadCancellation?.Dispose();
        projectAssignmentsLoadCancellation = null;
    }

    private void HandlePartyInput(PartyEditorInputChange change) {
        editing.State.InputChanged(change);
        MarkDraftInput();
    }

    private void HandlePartyValidation(bool hasErrors) {
        editing.State.ReportValidation(hasErrors);
        hasDraftInput |= hasErrors;
    }

    private void HandlePendingTag(string value) {
        editing.State.SetPendingTagInput(value);
        MarkDraftInput();
    }

    private void HandleChildInput(bool pending) {
        editing.State.ReportChildInput(pending);
        MarkDraftInput();
        if (!pending) {
            hasDraftInput = editing.State.IsDirty(editor);
        }
    }

    private async Task<bool> ValidatePartyInputAsync() {
        if (editing.State.HasPendingChildInput || affiliationEditing.State.HasPendingPicker || relationshipEditing.State.HasPendingPicker) {
            editing.ReportInputProblem();
            return false;
        }
        try {
            if (!await (workspace ?? throw new InvalidOperationException("The active Party workspace is unavailable.")).ValidateInputsAsync()) {
                editing.State.ReportValidation(true);
                affiliationEditing.State.ReportValidation(true);
                relationshipEditing.State.ReportValidation(true);
                editing.ReportInputProblem();
                return false;
            }
            editing.ConfirmParsedInput();
            affiliationEditing.State.ReportValidation(false);
            relationshipEditing.State.ReportValidation(false);
            return true;
        } catch (Exception exception) when (exception is Microsoft.JSInterop.JSException or OperationCanceledException) {
            if (!isDisposed) {
                Logger.LogWarning(exception, "Party input validation could not inspect the active form.");
                editing.ReportInputProblem();
            }
            return false;
        }
    }

    private async Task ReviewPartyAsync() {
        var draft = editor;
        if (await ValidatePartyInputAsync() && ReferenceEquals(draft, editor)) {
            await editing.ReviewAsync();
        }
    }

    private void MarkDraftInput() {
        hasDraftInput = true;
        draftInputRevision++;
    }

    private void RefreshDirectoryCatalog() => directoryBrowserVersion++;

    private void ApplyPartyReview() {
        if (editing.ApplyReview()) {
            MarkDraftInput();
            hasDraftInput = editing.State.IsDirty(editor);
        }
    }

    private void UndoPartyMerge() {
        editing.State.Undo(editor);
        MarkDraftInput();
    }

    private Task CancelPartyReview() {
        editing.CancelReview();
        return Task.CompletedTask;
    }

    private bool HasUnsavedChanges() => editing.State.IsDirty(editor) || editing.State.Review is not null ||
        affiliationEditing.State.IsDirty || affiliationEditing.State.Review is not null || relationshipEditing.State.IsDirty || relationshipEditing.State.Review is not null;

    private bool AffiliationSaveBlocked => affiliationEditing.ReadingReview || affiliationEditing.State.IsSaving ||
        affiliationEditing.State.IsUnknown || affiliationEditing.State.IsOutdated || affiliationEditing.State.Review is not null;

    private bool RelationshipSaveBlocked => isRelationshipsLoading || !string.IsNullOrWhiteSpace(relationshipsLoadError) || relationshipEditing.ReadingReview || relationshipEditing.State.IsSaving ||
        relationshipEditing.State.IsUnknown || relationshipEditing.State.IsOutdated || relationshipEditing.State.Review is not null;

    private void HandleRelationshipInput(RelationshipInput input) {
        relationshipEditing.State.InputChanged(input);
        MarkDraftInput();
    }

    private void HandleRelationshipPending(bool pending) {
        relationshipEditing.State.ReportPicker(pending);
        MarkDraftInput();
    }

    private Task HandleRelationshipsChangedAsync(IReadOnlyList<PartyRelationshipEditorModel> rows) {
        relationshipEditing.State.TakeInput(rows);
        MarkDraftInput();
        return Task.CompletedTask;
    }

    private async Task ReviewRelationshipsAsync() {
        var draft = editor;
        if (await ValidatePartyInputAsync() && ReferenceEquals(draft, editor)) {
            await relationshipEditing.ReviewAsync();
        }
    }

    private void ApplyRelationshipReview() {
        if (relationshipEditing.ApplyReview()) {
            MarkDraftInput();
        }
    }

    private void HandleAffiliationInput(AffiliationInput input) {
        affiliationEditing.State.InputChanged(input);
        MarkDraftInput();
    }

    private void HandleAffiliationPending(bool pending) {
        affiliationEditing.State.ReportPicker(pending);
        MarkDraftInput();
    }

    private async Task ReviewAffiliationsAsync() {
        var draft = editor;
        if (await ValidatePartyInputAsync() && ReferenceEquals(draft, editor)) {
            await affiliationEditing.ReviewAsync();
        }
    }

    private void ApplyAffiliationReview() {
        if (affiliationEditing.ApplyReview()) {
            MarkDraftInput();
        }
    }

    private Task<bool> RequestLeaveAsync() {
        if (!HasUnsavedChanges() && !editing.State.IsSaving && !editing.State.IsUnknown && !affiliationEditing.State.IsSaving && !affiliationEditing.State.IsUnknown &&
            !relationshipEditing.State.IsSaving && !relationshipEditing.State.IsUnknown) {
            return Task.FromResult(true);
        }
        return (leaveGuard ?? throw new InvalidOperationException("An active dirty party editor requires its leave guard.")).RequestLeaveAsync();
    }

    private bool IsSameEditorRoute(string target) {
        var destination = Navigation.ToAbsoluteUri(target);
        var current = new Uri(Navigation.Uri);
        var state = DirectoryUrlCodec.Instance.Read(destination.AbsoluteUri);
        return destination.AbsolutePath == current.AbsolutePath && state.PartyId == url.State.PartyId && state.Dialog == url.State.Dialog;
    }

    public async ValueTask DisposeAsync() {
        isDisposed = true;
        merge.Reset();
        Interlocked.Increment(ref directoryLoadGeneration);
        partyActivity.Dispose();
        CancelProjectAssignmentsLoad();
        await editing.DisposeAsync();
        await affiliationEditing.DisposeAsync();
        await relationshipEditing.DisposeAsync();
    }

    private Task HandleAffiliationsChangedAsync(
        IReadOnlyList<PartyOrganizationAffiliationEditorModel> affiliations)
    {
        MarkDraftInput();
        affiliationEditing.State.TakeInput(affiliations);
        return Task.CompletedTask;
    }

    private void ApplyAffiliationItems(
        IReadOnlyList<PartyOrganizationAffiliationListItemModel> affiliations)
    {
        affiliationItems = affiliations;
        var displayNames = new Dictionary<Guid, string>();
        foreach (var affiliation in affiliations)
        {
            displayNames[affiliation.OrganizationPartyId] =
                affiliation.OrganizationDisplayName;
            if (affiliation.OrganizationUnitPartyId is Guid organizationUnitPartyId)
            {
                displayNames[organizationUnitPartyId] =
                    affiliation.OrganizationUnitDisplayName;
            }

            if (affiliation.ManagerPartyId is Guid managerPartyId)
            {
                displayNames[managerPartyId] = affiliation.ManagerDisplayName;
            }
        }

        affiliationPartyDisplayNames = displayNames;
        affiliationsLoadedPartyId = editor.PartyType == PartyType.Person
            ? editor.Id
            : null;
    }


    private string ProjectAssignmentsPageText => projectAssignmentsPage.TotalPages == 0
        ? "No pages"
        : $"Page {projectAssignmentsPage.PageIndex + 1:N0} of {projectAssignmentsPage.TotalPages:N0}";

    private bool CanMoveProjectAssignmentsPrevious =>
        !isProjectAssignmentsLoading && projectAssignmentsPage.PageIndex > 0;

    private bool CanMoveProjectAssignmentsNext =>
        !isProjectAssignmentsLoading &&
        projectAssignmentsPage.PageIndex + 1 < projectAssignmentsPage.TotalPages;

    private enum DirectoryLoadBinding
    {
        RouteBound,
        Interactive
    }

    private enum DirectoryLoadOutcome
    {
        Ready,
        Missing,
        Stale
    }

    private readonly record struct DirectoryLoadRequest(
        Guid? RequestedPartyId,
        Guid? RoutePartyId,
        DirectoryLoadBinding Binding,
        long Generation);

    private readonly record struct DirectoryActionStamp(
        long Generation,
        Guid? RoutePartyId,
        PartyEditorViewModel Editor);

    private sealed record DirectoryLoadSnapshot(
        PartyEditorViewModel Editor,
        IReadOnlyList<PartyOrganizationAffiliationListItemModel> Affiliations,
        bool RequestedPartyFound,
        PartyDirectoryRead? Observation = null,
        AffiliationRead? AffiliationObservation = null)
    {
        public static DirectoryLoadSnapshot ForNewParty()
            => Empty(requestedPartyFound: true);

        public static DirectoryLoadSnapshot ForMissingParty()
            => Empty(requestedPartyFound: false);

        private static DirectoryLoadSnapshot Empty(bool requestedPartyFound)
            => new(
                PartyEditorViewModel.CreateNew(),
                [],
                requestedPartyFound);
    }

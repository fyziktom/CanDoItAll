            editor.DisplayName,
            editor.LifecycleStatus)
        : CrmHrAgentChatSurfaceBuilder.BuildDirectorySurface();

    private AgentChatNavigationIdentity AgentChatNavigationFence
        => CrmHrNavigationFence.Create(Navigation, url);

    // The record section is navigation state: the tab index is only its rendering.
    private DirectorySection SelectedSection => url.State.Section;

    private PagedRecordQueryState<PartyRecordScope> CatalogQuery => url.State.Catalog.ToQuery();

    private string EditorTitle => editor.Id.HasValue ? editor.DisplayName : "New party";

    private PartyOrganizationAffiliationListItemModel? CurrentPrimaryAffiliation
        => affiliationItems
            .Where(item => item.IsCurrent)
            .OrderByDescending(item => item.IsPrimary)
            .ThenBy(item => item.OrganizationDisplayName)
            .FirstOrDefault();

    private string OtherCurrentAffiliationsTooltip
    {
        get
        {
            var primaryAffiliation = CurrentPrimaryAffiliation;
            var otherAffiliations = affiliationItems
                .Where(item => item.IsCurrent && item.Id != primaryAffiliation?.Id)
                .Select(FormatAffiliation)
                .ToList();
            return otherAffiliations.Count == 0
                ? "No other current affiliations."
                : $"Other current affiliations: {string.Join("; ", otherAffiliations)}";
        }
    }

    protected override void OnInitialized()
    {
        editing = new(PartyDirectoryService, Changes, ChangeFeed, EditingAccess, ObservationLog, EditingLog) {
            Dispatch = action => InvokeAsync(action),
            Changed = StateHasChanged,
            Retired = () => {
                Interlocked.Increment(ref directoryLoadGeneration);
                isEditorDialogOpen = false;
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
                affiliationEditing.Clear();
                ResetDirectoryDetailState();
                NotificationService.Warning("Editing access changed", "The full party editor was retired. Reopen it with current CRM editing access.");
            },
            Notice = () => NotificationService.Warning("Party changed", "Another editor changed this party. Your local draft is retained; review the saved values before saving.")
        };
        affiliationEditing = new(AffiliationService, Changes, ChangeFeed, EditingAccess, Clock, ObservationLog, AffiliationLog) {
            Dispatch = action => InvokeAsync(action),
            Changed = () => {
                ApplyAffiliationItems(affiliationEditing.Saved);
                StateHasChanged();
            },
            Retired = () => {
                isEditorDialogOpen = false;
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
                NotificationService.Warning("Affiliation access changed", "Reopen the person with current CRM editing access.");
            },
            Notice = () => NotificationService.Warning("Affiliations changed", "Your local affiliation draft is retained. Review the saved affiliations before saving.")
        };
        relationshipEditing = new(RelationshipService, Changes, ChangeFeed, EditingAccess, ObservationLog, RelationshipLog) {
            Dispatch = action => InvokeAsync(action),
            Changed = StateHasChanged,
            Retired = () => {
                isEditorDialogOpen = false;
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
                NotificationService.Warning("Relationship access changed", "Reopen the party with current CRM editing access.");
            },
            Notice = () => NotificationService.Warning("Relationships changed", "Your local relationship draft is retained. Review the saved relationships before saving.")
        };
        url = new UrlStateBinding<DirectoryUrlState>(Navigation, DirectoryUrlCodec.Instance, History, typeof(CrmHrDirectoryPage));
        merge = new(ManagementService, Changes, EditingAccess, MergeLog);
        partyActivity = new CrmHrActivityHistorySession(
            (query, cancellationToken) => PartyDirectoryService.SearchPartyActivityAsync(query, cancellationToken),
            initialFailureMessage: "Activity and project assignments could not be loaded.",
            pageFailureMessage: "The requested activity page could not be loaded.",
            Logger);
    }

    // Every location reaches the same instance: a pasted link, Back, Forward and this page's own intents arriving.
    // Only a change of the applied state does anything; the binding ignores the page's own locations in flight.
    protected override async Task OnParametersSetAsync()
    {
        var change = url.Apply(canonicalize: RendererInfo.IsInteractive);
        if (!change.IsChanged)
        {
            return;
        }

        await ApplyRouteAsync(change.Previous, change.Current, change.IsInitial);
    }

    // A record opened, closed or replaced loads or retires the editor; another section of the same record loads only
    // that section's lazy data; a catalog query belongs to the catalog, which loads it itself.
    private async Task ApplyRouteAsync(DirectoryUrlState previous, DirectoryUrlState current, bool initial)
    {
        if (initial || previous.PartyId != current.PartyId || previous.Dialog != current.Dialog)
        {
            await OpenRouteRecordAsync(current);
            return;
        }

        if (previous.Section != current.Section && isEditorDialogOpen)
        {
            await EnsureSelectedTabDataLoadedAsync();
        }
    }

    private async Task OpenRouteRecordAsync(DirectoryUrlState route)
    {
        if (route.Dialog == DirectoryDialog.NewParty)
        {
            await StartNewPartyAsync();
            return;
        }

        if (route.PartyId is not { } requestedPartyId)
        {
            await RetireRecordAsync();
            return;
        }

        if (requestedPartyId != editor.Id)
        {
            isEditorDialogOpen = false;
        }

        var request = BeginDirectoryLoad(
            requestedPartyId,
            DirectoryLoadBinding.RouteBound);
        var outcome = await LoadAndCommitDirectoryAsync(request);
        if (outcome == DirectoryLoadOutcome.Stale)
        {
            return;
        }

        agentChatContextAccessState = outcome == DirectoryLoadOutcome.Ready
            ? AgentChatContextAccessState.Ready
            : AgentChatContextAccessState.Failed;
        isEditorDialogOpen = outcome == DirectoryLoadOutcome.Ready;
        if (outcome == DirectoryLoadOutcome.Missing)
        {
            // The requested identity stays in the location and no other record takes its place.
            NotificationService.Warning(
                "Party unavailable",
                "The requested directory record does not exist or is no longer available.");
            return;
        }

        await EnsureSelectedTabDataLoadedAsync();
    }

    private async Task LoadAsync(Guid? selectedPartyId, bool clearMessage = true, bool committed = false)
    {
        var request = BeginDirectoryLoad(
            selectedPartyId,
            DirectoryLoadBinding.Interactive);
        var outcome = await LoadAndCommitDirectoryAsync(request, committed);
        if (outcome == DirectoryLoadOutcome.Stale)
        {
            return;
        }

        agentChatContextAccessState = outcome == DirectoryLoadOutcome.Ready
            ? AgentChatContextAccessState.Ready
            : AgentChatContextAccessState.Failed;

        if (outcome == DirectoryLoadOutcome.Ready)
        {
            await EnsureSelectedTabDataLoadedAsync();
        }
    }

    // A card opens its record over the catalog as a new history entry; Back closes it again.
    private async Task SelectPartyAsync(Guid partyId) {
        if (url.State.PartyId == partyId && isEditorDialogOpen || !await RequestLeaveAsync()) {
            return;
        }
        url.OpenOverlay(url.State.WithoutRecord() with { PartyId = partyId });
        await OpenRouteRecordAsync(url.State);
    }

    private DirectoryLoadRequest BeginDirectoryLoad(
        Guid? requestedPartyId,
        DirectoryLoadBinding binding)
    {
        agentChatContextAccessState = AgentChatContextAccessState.Loading;
        return new DirectoryLoadRequest(
            requestedPartyId,
            binding == DirectoryLoadBinding.RouteBound ? url.State.PartyId : null,
            binding,
            Interlocked.Increment(ref directoryLoadGeneration));
    }

    private async Task<DirectoryLoadOutcome> LoadAndCommitDirectoryAsync(
        DirectoryLoadRequest request,
        bool committed = false)
    {
        try
        {
            var snapshot = await LoadDirectorySnapshotAsync(request.RequestedPartyId);
            if (!IsCurrentDirectoryLoad(request))
            {
                return DirectoryLoadOutcome.Stale;
            }

            CommitDirectorySnapshot(snapshot, committed);
            return snapshot.RequestedPartyFound
                ? DirectoryLoadOutcome.Ready
                : DirectoryLoadOutcome.Missing;
        }
        catch
        {
            if (!IsCurrentDirectoryLoad(request))
            {
                return DirectoryLoadOutcome.Stale;
            }

            agentChatContextAccessState = AgentChatContextAccessState.Failed;
            throw;
        }
    }

    private async Task<DirectoryLoadSnapshot> LoadDirectorySnapshotAsync(Guid? requestedPartyId)
    {
        if (!requestedPartyId.HasValue)
        {
            return DirectoryLoadSnapshot.ForNewParty();
        }

        var read = await editing.ReadAsync(requestedPartyId.Value);
        var party = read.Content;
        if (party is null)
        {
            return DirectoryLoadSnapshot.ForMissingParty();
        }

        var affiliationRead = party.PartyType == PartyType.Person ? await affiliationEditing.ReadAsync(requestedPartyId.Value) : null;
        return new DirectoryLoadSnapshot(
            PartyEditorViewModel.FromEditorModel(party),
            affiliationRead?.Rows ?? [],
            RequestedPartyFound: true,
            read,
            affiliationRead);
    }

    // The read-back of a record already on screen. Another party replaces the form; the form's own commit takes the
    // owner's accepted values into every field the operator did not type into after the save was dispatched, in the
    // same draft instance and EditContext, so text typed while the write was in flight is never discarded.
    private void CommitDirectorySnapshot(DirectoryLoadSnapshot snapshot, bool committed = false)
    {
        var isPartySelectionChanged = editor.Id != snapshot.Editor.Id;
        editing.Observe(snapshot.Editor, snapshot.Observation);
        ResetDirectoryDetailState(retainRelationships: !isPartySelectionChanged);
        if (snapshot.AffiliationObservation is { } affiliations) {
            affiliationEditing.Observe(affiliations);
            ApplyAffiliationItems(affiliationEditing.Saved);
        } else {
            affiliationEditing.Clear();
            ApplyAffiliationItems([]);
        }
    }

    private bool IsCurrentDirectoryLoad(DirectoryLoadRequest request)
        => request.Generation == Volatile.Read(ref directoryLoadGeneration) &&
           (request.Binding == DirectoryLoadBinding.Interactive ||
            url.State.PartyId == request.RoutePartyId);

    // The new-party editor opens over the catalog as a new history entry; Back closes it again.
    private async Task CreateNewAsync() {
        if (!await RequestLeaveAsync()) {
            return;
        }
        url.OpenOverlay(url.State.WithoutRecord() with { Dialog = DirectoryDialog.NewParty });
        await StartNewPartyAsync();
    }

    private async Task CloseEditorDialogAsync() {
        if (!isEditorDialogOpen || !await RequestLeaveAsync()) {
            return;
        }
        await RetireRecordAsync();
        await url.CloseOverlayAsync(url.State.WithoutRecord());
    }

    private async Task StartNewPartyAsync() {
        Interlocked.Increment(ref directoryLoadGeneration);
        affiliationEditing.Clear();
        await editing.NewDraftAsync();
        hasDraftInput = false;
        ResetDirectoryDetailState();
        agentChatContextAccessState = AgentChatContextAccessState.Ready;
        isEditorDialogOpen = true;
    }

    private async Task RetireRecordAsync() {
        Interlocked.Increment(ref directoryLoadGeneration);
        affiliationEditing.Clear();
        isEditorDialogOpen = false;
        await editing.NewDraftAsync();
        hasDraftInput = false;
        ResetDirectoryDetailState();
        agentChatContextAccessState = AgentChatContextAccessState.Ready;
    }

    private async Task SaveAsync()
    {
        var action = CaptureDirectoryAction();
        // One admitted save per editor lifetime: a second dispatch while the owner is writing is dropped, so a new
        // party can never be created twice. The submission and its affiliation and relationship lists are captured
        // before the first await.
        using var admission = mutationGate.TryEnter(action.Generation);
        if (admission is null)
        {
            return;
        }

        if (AffiliationSaveBlocked || RelationshipSaveBlocked || !await ValidatePartyInputAsync() || !IsCurrentDirectoryAction(action)) {
            return;
        }
        var affiliationSubmission = affiliationsLoadedPartyId.HasValue && affiliationsLoadedPartyId == editor.Id && affiliationEditing.State.IsDirty
            ? affiliationEditing.PrepareSave() : null;
        var relationshipSubmission = relationshipsLoadedPartyId.HasValue && relationshipsLoadedPartyId == editor.Id && relationshipEditing.State.IsDirty
            ? relationshipEditing.PrepareSave() : null;
        var result = await editing.SaveAsync();
        if (!IsCurrentDirectoryAction(action))
        {
            if (affiliationSubmission is not null) {
                affiliationEditing.CancelSubmission(affiliationSubmission);
            }
            CancelDirectorySubmissions(affiliationSubmission, relationshipSubmission);
            return;
        }

        if (result.IsFailure)
        {
            if (affiliationSubmission is not null) {
                affiliationEditing.CancelSubmission(affiliationSubmission);
            }
            CancelDirectorySubmissions(affiliationSubmission, relationshipSubmission);
            NotificationService.Warning(editing.State.IsUnknown ? "Party save outcome unknown" : "Party was not saved", string.Join(" ", result.Errors.Select(error => error.Message)));
            return;
        }

        hasDraftInput = editing.State.IsDirty(editor);
        var savedPartyId = result.Value;
        editor.Id = savedPartyId;
        // A created party is the open record from now on: the new-party entry names it, so a refresh, a copied link
        // or a failed read-back below still shows this party and never offers a second create.
        if (url.State.PartyId != savedPartyId)
        {
            url.Navigate(url.State with { PartyId = savedPartyId, Dialog = null }, UrlHistoryMode.Replace);
            action = action with { RoutePartyId = savedPartyId };
        }

        if (affiliationSubmission is not null)
        {
            var affiliationSaveResult = await affiliationEditing.CommitAsync(affiliationSubmission);
            if (!IsCurrentDirectoryAction(action))
            {
                CancelDirectorySubmissions(affiliationSubmission, relationshipSubmission);
                return;
            }

            if (affiliationSaveResult.IsFailure)
            {
                CancelDirectorySubmissions(affiliationSubmission, relationshipSubmission);
                directoryBrowserVersion++;
                NotificationService.Warning(
                    "Party saved with affiliation issue",
                    $"Affiliations were not updated. {string.Join(" ", affiliationSaveResult.Errors.Select(error => error.Message))}");
                return;
            }

            ApplyAffiliationItems(affiliationEditing.Saved);
        }

        if (relationshipSubmission is not null)
        {
            var relationshipSaveResult = await relationshipEditing.CommitAsync(relationshipSubmission);
            if (!IsCurrentDirectoryAction(action))
            {
                CancelDirectorySubmissions(affiliationSubmission, relationshipSubmission);
                return;
            }

            if (relationshipSaveResult.IsFailure)
            {
                CancelDirectorySubmissions(affiliationSubmission, relationshipSubmission);
                directoryBrowserVersion++;
                NotificationService.Warning(
                    "Party saved with relationship issue",
                    $"Relationships were not updated. {string.Join(" ", relationshipSaveResult.Errors.Select(error => error.Message))}");
                return;
            }
        }

        if (editing.Message is { } postCommitMessage) {
            NotificationService.Warning("Party saved", postCommitMessage);
        } else {
            NotificationService.Success("Party saved", "Party saved.");
        }
        directoryBrowserVersion++;
        await RefreshAfterCommitAsync(savedPartyId, committed: true);
    }

    // CSV stewardship effects of the import and export region: the directory management owner exports, previews and
    // applies; the renderer only calls these.
    private Task<string> ExportPartyCsvAsync(PartyCsvExportScope scope, IReadOnlyList<Guid> partyIds)
        => ReadStewardshipAsync(StewardshipRead.Export, token => scope switch
        {
            PartyCsvExportScope.SelectedParties => ManagementService.ExportPartiesCsvAsync(partyIds, token),
            PartyCsvExportScope.EntireDirectory => ManagementService.ExportAllPartiesCsvAsync(token),
            _ => throw new ArgumentOutOfRangeException(nameof(scope), scope, "Unsupported party CSV export scope.")
        });

    private Task<Result<PartyCsvImportPreviewModel>> PreviewPartyImportAsync(string csvContent)
        => ReadStewardshipAsync(StewardshipRead.ImportPreview, token => ManagementService.PreviewImportAsync(csvContent, token));

    private async Task<T> ReadStewardshipAsync<T>(StewardshipRead operation, Func<CancellationToken, Task<T>> read) {
        try {
            using var grant = await EditingAccess.OpenAsync(new(Changes.Scope, EditingOwner.CrmHrParty), CancellationToken.None);
            using var reading = CancellationTokenSource.CreateLinkedTokenSource(grant.Lifetime);
            await EditingAccess.ValidateAsync(grant, write: true, reading.Token);
            var result = await read(reading.Token);
            await EditingAccess.ValidateAsync(grant, write: true, reading.Token);
            return result;
        } catch (Exception exception) {
            Logger.LogWarning("Directory stewardship {Operation} read failed after {FailureType}.", operation, exception.GetType().Name);
            throw;
        }
    }

    private async Task<Result<int>> ApplyPartyImportAsync(IReadOnlyList<PartyCsvImportPreviewRowModel> rows) {
        var opening = importOpening;
        int? acceptedCount = null;
        try {
            using var grant = await EditingAccess.OpenAsync(new(Changes.Scope, EditingOwner.CrmHrParty), CancellationToken.None);
            await EditingAccess.ValidateAsync(grant, write: true, CancellationToken.None);
            using var admission = Changes.EnterUiWrite(token => EditingAccess.ValidateAsync(grant, write: true, token));
            return await ManagementService.ApplyImportAsync(rows, grant.Actor, onCommitted: count => acceptedCount = count);
        } catch (Exception exception) when (acceptedCount.HasValue) {
            Logger.LogWarning("Directory import committed {Count} rows but follow-up failed after {FailureType}.", acceptedCount, exception.GetType().Name);
            if (!isDisposed && opening == importOpening) {
                NotificationService.Warning("Import saved", "The import was saved, but a follow-up notification failed. Refresh the directory before continuing.");
            }
            return Result<int>.Success(acceptedCount.Value);
        } catch (UnauthorizedAccessException) {
            return Result<int>.Failure(Error.Validation("Current CRM write access is required to apply an import.", CrmHrEditingErrorCodes.EditingAccessDenied));
        }
    }

    private Task HandleImportAppliedAsync() {
        directoryBrowserVersion++;
        return Task.CompletedTask;
    }

    private void OpenImportExportDialog()
    {
        if (isImportExportDialogOpen) {
            return;
        }
        importOpening++;
        importStatus = new(0, false, PartyImportPhase.Editing);
        isImportExportDialogOpen = true;
    }

    private async Task CloseImportExportDialogAsync() {
        if (!isImportExportDialogOpen) {
            return;
        }
        var opening = importOpening;
        if (!await (importLeaveGuard ?? throw new InvalidOperationException("An open CSV workspace requires its leave guard.")).RequestLeaveAsync() ||
            isDisposed || opening != importOpening) {
            return;
        }
        importOpening++;
        isImportExportDialogOpen = false;
        importStatus = new(0, false, PartyImportPhase.Editing);
    }

    private bool IsSameImportRoute(string target) => Navigation.ToAbsoluteUri(target).AbsolutePath == new Uri(Navigation.Uri).AbsolutePath;

    // A section of the open record refines its entry; it loads only the data that section shows.
    private async Task HandleEditorTabChangedAsync(int index)
    {
        var section = (DirectorySection)index;
        if (!Enum.IsDefined(section))
        {
            throw new ArgumentOutOfRangeException(nameof(index), index, "The party editor has no such section.");
        }

        url.Navigate(url.State with { Section = section }, UrlHistoryMode.Replace);
        await EnsureSelectedTabDataLoadedAsync();
    }

    // The catalog committed a query and is already loading it: only the location follows.
    private Task HandleCatalogQueryChangedAsync(PagedRecordQueryChange<PartyRecordScope> change)
    {
        url.Navigate(
            url.State with { Catalog = DirectoryUrlCodec.Catalog.FromQuery(change.Query) },
            CrmHrCatalogUrlCodec<PartyRecordScope>.HistoryMode(change.Kind));
        return Task.CompletedTask;
    }

    private Task EnsureSelectedTabDataLoadedAsync()
    {
        return SelectedSection switch
        {
            DirectorySection.Activity => EnsureActivityLoadedAsync(),
            DirectorySection.Relationships => EnsureRelationshipsLoadedAsync(),
            _ => Task.CompletedTask
        };
    }

    private async Task EnsureRelationshipsLoadedAsync()
    {
        if (editor.Id is not Guid partyId || relationshipsLoadedPartyId == partyId)
        {
            return;
        }

        var generation = Volatile.Read(ref directoryLoadGeneration);
        if (relationshipsLoadTask is null ||
            relationshipsLoadPartyId != partyId ||
            relationshipsLoadGeneration != generation)
        {
            relationshipsLoadPartyId = partyId;
            relationshipsLoadGeneration = generation;
            isRelationshipsLoading = true;
            relationshipsLoadError = string.Empty;
            relationshipsLoadTask = LoadRelationshipsAsync(partyId, generation);
        }

        await relationshipsLoadTask;
    }

    private async Task LoadRelationshipsAsync(Guid partyId, long generation)
    {
        try
        {
            var relationshipsTask = relationshipEditing.ReadAsync(partyId);
            var duplicatesTask = ManagementService.FindPotentialDuplicatesAsync(partyId);
            await Task.WhenAll(relationshipsTask, duplicatesTask);
            if (!IsCurrentDetailLoad(partyId, generation))
            {
                return;
            }

            relationshipEditing.Observe(await relationshipsTask);
            duplicateCandidates = await duplicatesTask;
            relationshipsLoadedPartyId = partyId;
        }
        catch when (!IsCurrentDetailLoad(partyId, generation))
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load directory relationships for party {PartyId}.", partyId);
            relationshipsLoadError = "Relationships and duplicate candidates could not be loaded.";
        }
        finally
        {
            if (relationshipsLoadPartyId == partyId && relationshipsLoadGeneration == generation)
            {
                isRelationshipsLoading = false;
                relationshipsLoadTask = null;
            }
        }
    }

    private async Task EnsureActivityLoadedAsync()
    {
        if (editor.Id is not Guid partyId)
        {
            return;
        }

        var timelineTask = EnsureActivityTimelineLoadedAsync(partyId);
        var assignmentsTask = EnsureProjectAssignmentsLoadedAsync(partyId);
        await Task.WhenAll(timelineTask, assignmentsTask);
    }

    // The party activity lane: the session owns the read, the accepted page, the busy gate and the fencing of late
    // outcomes. A newer directory load generation starts a fresh lane for the party, as the previous inline read did.
    private Task EnsureActivityTimelineLoadedAsync(Guid partyId)
    {
        var generation = Volatile.Read(ref directoryLoadGeneration);
        if (partyActivityGeneration != generation)
        {
            partyActivity.Invalidate();
            partyActivityGeneration = generation;
        }

        return partyActivity.EnsureLoadedAsync(partyId);
    }

    private async Task EnsureProjectAssignmentsLoadedAsync(Guid partyId)
    {
        if (projectAssignmentsLoadedPartyId == partyId)
        {
            return;
        }

        await LoadProjectAssignmentsPageAsync(partyId, 0);
    }

    private async Task HandleProjectAssignmentsPageRequestedAsync(int pageIndex)
    {
        if (editor.Id is not Guid partyId ||
            pageIndex < 0 ||
            pageIndex >= projectAssignmentsPage.TotalPages)
        {
            return;
        }

        await LoadProjectAssignmentsPageAsync(partyId, pageIndex);
    }

    private async Task LoadProjectAssignmentsPageAsync(Guid partyId, int pageIndex)
    {
        var generation = Volatile.Read(ref directoryLoadGeneration);
        CancelProjectAssignmentsLoad();
        projectAssignmentsLoadPartyId = partyId;
        projectAssignmentsLoadGeneration = generation;
        isProjectAssignmentsLoading = true;
        projectAssignmentsLoadError = string.Empty;
        projectAssignmentsLoadCancellation = new CancellationTokenSource();
        var cancellationToken = projectAssignmentsLoadCancellation.Token;
        projectAssignmentsLoadTask = LoadProjectAssignmentsPageCoreAsync(
            partyId,
            pageIndex,
            generation,
            cancellationToken);
        await projectAssignmentsLoadTask;
    }

    private async Task LoadProjectAssignmentsPageCoreAsync(
        Guid partyId,
        int pageIndex,
        long generation,
        CancellationToken cancellationToken)
    {
        try
        {
            var page = await PartyDirectoryService.SearchPartyProjectAssignmentsAsync(
                new PartyProjectAssignmentQuery(
                    partyId,
                    pageIndex,
                    PartyProjectAssignmentQueryLimits.DefaultPageSize),
                cancellationToken);
            if (!IsCurrentDetailLoad(partyId, generation))
            {
                return;
            }

            projectAssignmentsPage = page;
            projectAssignmentsLoadedPartyId = partyId;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch when (!IsCurrentDetailLoad(partyId, generation))
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to load project assignment page {PageIndex} for party {PartyId}.",
                pageIndex,
                partyId);
            projectAssignmentsLoadError = "The requested project assignment page could not be loaded.";
        }
        finally
        {
            if (projectAssignmentsLoadPartyId == partyId &&
                projectAssignmentsLoadGeneration == generation)
            {
                isProjectAssignmentsLoading = false;
                projectAssignmentsLoadTask = null;
            }
        }
    }

    private Task HandleActivityPageRequestedAsync(int pageIndex)
        => editor.Id is Guid partyId && partyActivity.Target == partyId
            ? partyActivity.RequestPageAsync(pageIndex)
            : Task.CompletedTask;

    private bool IsCurrentDetailLoad(Guid partyId, long generation)
        => editor.Id == partyId && generation == Volatile.Read(ref directoryLoadGeneration);

    private Task RetryRelationshipsLoadAsync()
    {
        relationshipsLoadedPartyId = null;
        relationshipsLoadTask = null;
        relationshipsLoadError = string.Empty;
        return EnsureRelationshipsLoadedAsync();
    }

    private Task RetryActivityLoadAsync()
    {
        partyActivity.Invalidate();
        return EnsureActivityLoadedAsync();
    }

    private Task RetryProjectAssignmentsLoadAsync()
    {
        projectAssignmentsLoadedPartyId = null;
        projectAssignmentsLoadTask = null;
        projectAssignmentsLoadError = string.Empty;
        return EnsureActivityLoadedAsync();
    }


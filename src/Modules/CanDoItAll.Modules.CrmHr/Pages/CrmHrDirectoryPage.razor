@page "/crm-hr/directory"
@implements IAsyncDisposable
@using CanDoItAll.Editing
@using CanDoItAll.Infrastructure.Editing
@using Microsoft.AspNetCore.Components.Routing
@inject CrmHrChanges Changes
@inject EditingChangeFeed ChangeFeed
@inject IEditingUiAccess EditingAccess
@inject ILogger<EditingObservation> ObservationLog
@inject ILogger<PartyDirectoryEditor> EditingLog
@inject ILogger<AffiliationEditor> AffiliationLog
@inject ILogger<RelationshipEditor> RelationshipLog
@inject ILogger<PartyMergeSession> MergeLog
@using CanDoItAll.SharedKernel
@inject IClock Clock
@using Microsoft.Extensions.Logging
@inject PartyDirectoryService PartyDirectoryService
@inject PartyDirectoryManagementService ManagementService
@inject IPartyOrganizationAffiliationService AffiliationService
@inject IPartyRelationshipService RelationshipService
@inject NavigationManager Navigation
@inject IAppNavigationHistory History
@inject NotificationService NotificationService
@inject ILogger<CrmHrDirectoryPage> Logger

<PageTitle>CRM / HR Directory</PageTitle>

<AgentChatContextSurfaceProvider Surface="@AgentChatSurface"
                                 ContextNavigationIdentity="@AgentChatNavigationFence"
                                 ContextAccessState="@agentChatContextAccessState" />

<CrmHrLiveCatalog Owner="EditingOwner.CrmHrParty" Ignore="editing.IsOwn" Changed="RefreshDirectoryCatalog">
<CrmHrDirectoryWorkspaceSurface @ref="workspace" View="this" DirtyChanged="MarkDraftInput"
    InputChanged="HandlePartyInput" ValidationChanged="HandlePartyValidation" ChildInputChanged="HandleChildInput"
    PendingTagInput="@editing.State.PendingTagInput" PendingTagInputChanged="HandlePendingTag" AffiliationRevision="@affiliationEditing.RenderRevision" AffiliationInputChanged="HandleAffiliationInput" AffiliationPendingChanged="HandleAffiliationPending"
    RelationshipRevision="@relationshipEditing.RenderRevision" RelationshipInputChanged="HandleRelationshipInput" RelationshipPendingChanged="HandleRelationshipPending"
    SaveDisabled="@(editing.ReadingReview || editing.State.IsSaving || editing.State.IsOutdated || editing.State.IsUnknown || editing.State.Review is not null || AffiliationSaveBlocked || RelationshipSaveBlocked)">
    <EditingStatus>
        <PartyEditingStatus State="@editing.State" Message="@editing.Message" ReadingReview="@editing.ReadingReview"
            ReviewRequested="ReviewPartyAsync" UndoRequested="UndoPartyMerge" />
        <AffiliationEditing State="@affiliationEditing.State" Message="@affiliationEditing.Message" Reading="@affiliationEditing.ReadingReview" PartyNames="@affiliationPartyDisplayNames"
            ReviewRequested="ReviewAffiliationsAsync" ApplyRequested="ApplyAffiliationReview" UndoRequested="affiliationEditing.Undo" Cancelled="affiliationEditing.CancelReview" Changed="StateHasChanged" />
        <RelationshipEditing State="@relationshipEditing.State" Message="@relationshipEditing.Message" Reading="@relationshipEditing.ReadingReview"
            ReviewRequested="ReviewRelationshipsAsync" ApplyRequested="ApplyRelationshipReview" UndoRequested="relationshipEditing.Undo" Cancelled="relationshipEditing.CancelReview" Changed="StateHasChanged" />
    </EditingStatus>
    <EditorOverlays>
        <PartyReviewDialog State="@editing.State" ReadingReview="@editing.ReadingReview" Changed="StateHasChanged"
            Cancelled="CancelPartyReview" RefreshRequested="ReviewPartyAsync" ApplyRequested="ApplyPartyReview" />
        <CrmHrEditorLeaveGuard @ref="leaveGuard" HasLocalChanges="HasUnsavedChanges" IsSameEditorRoute="IsSameEditorRoute"
            InputRevision="@draftInputRevision" HasInput="@hasDraftInput" IsBusy="@(() => editing.State.IsSaving || affiliationEditing.State.IsSaving || relationshipEditing.State.IsSaving || mergeState.IsBusy)" Unknown="@(editing.State.IsUnknown || affiliationEditing.State.IsUnknown || relationshipEditing.State.IsUnknown || mergeState.IsUnknown)" />
    </EditorOverlays>
    <ImportOverlays>
        <CrmHrEditorLeaveGuard @ref="importLeaveGuard" TestIdPrefix="crmhr-import"
            HasLocalChanges="@(() => importStatus.HasInput)" IsSameEditorRoute="IsSameImportRoute"
            InputRevision="@importStatus.InputRevision" HasInput="@importStatus.HasInput"
            IsBusy="@(() => importStatus.IsBusy)" Unknown="@importStatus.IsUnknown" />
    </ImportOverlays>
    <MergeOverlays>
        <CrmHrEditorLeaveGuard @ref="mergeLeaveGuard" TestIdPrefix="crmhr-merge"
            HasLocalChanges="@(() => merge.HasLocalChanges)"
            IsSameEditorRoute="IsSameEditorRoute" InputRevision="@mergeNote.Revision" HasInput="@mergeNote.HasInput"
            IsBusy="@(() => mergeState.IsBusy)" Unknown="@mergeState.IsUnknown" />
    </MergeOverlays>
    <SecondaryNavigation>
        <CrmHrSecondaryTabs SelectedArea="CrmHrWorkspaceArea.Directory" />
    </SecondaryNavigation>
    <ActivityTimeline>
        <InteractionTimeline Presentation="@PartyActivityPresentation"
                             PageRequested="HandleActivityPageRequestedAsync"
                             DataTestId="crmhr-directory-activity"
                             Eyebrow="Party history"
                            Title="Recent interactions, changes, and follow-ups"
                            Description="Directory edits, CRM interactions, recruiting state changes, and workforce or AI updates stay visible in one place for the selected party."
                            EmptyEyebrow="No party activity"
                            EmptyTitle="No saved activity for this party"
                            EmptyDescription="Save the party and related CRM-HR workflows to start building a shared history." />
    </ActivityTimeline>
</CrmHrDirectoryWorkspaceSurface>
</CrmHrLiveCatalog>

@code {

    private Task? projectAssignmentsLoadTask;
    private CancellationTokenSource? projectAssignmentsLoadCancellation;
    private AgentChatContextAccessState agentChatContextAccessState = AgentChatContextAccessState.Loading;

    private AgentChatContextSurface AgentChatSurface => editor.Id is { } partyId &&

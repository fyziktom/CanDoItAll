    private async Task EnsureHistoryLoadedAsync()
    {
        if (selectedWorkspace is not { } workspace ||
            historyLoadedPartyId == workspace.PartyId)
        {
            return;
        }

        var partyId = workspace.PartyId;
        var workforceGeneration = Volatile.Read(ref workforceLoadGeneration);
        if (historyLoadTask is null ||
            historyLoadPartyId != partyId ||
            historyLoadWorkforceGeneration != workforceGeneration)
        {
            historyLoadPartyId = partyId;
            historyLoadWorkforceGeneration = workforceGeneration;
            isHistoryLoading = true;
            historyLoadError = string.Empty;
            historyLoadTask = LoadHistoryAsync(partyId, workforceGeneration);
        }

        await historyLoadTask;
    }

    private async Task LoadHistoryAsync(Guid partyId, long workforceGeneration)
    {
        try
        {
            var page = await PartyDirectoryService.SearchPartyActivityAsync(
                new CrmActivityHistoryQuery(partyId));
            if (!IsCurrentHistoryRequest(partyId, workforceGeneration))
            {
                return;
            }

            activityPage = page;
            historyLoadedPartyId = partyId;
        }
        catch when (!IsCurrentHistoryRequest(partyId, workforceGeneration))
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load workforce history for party {PartyId}.", partyId);
            historyLoadError = "Workforce history could not be loaded.";
        }
        finally
        {
            if (IsTrackedHistoryRequest(partyId, workforceGeneration))
            {
                isHistoryLoading = false;
                historyLoadTask = null;
            }
        }
    }

    private async Task HandleHistoryPageRequestedAsync(int pageIndex)
    {
        if (selectedWorkspace is not { } workspace ||
            pageIndex < 0 ||
            pageIndex >= activityPage.TotalPages)
        {
            return;
        }

        var partyId = workspace.PartyId;
        var workforceGeneration = Volatile.Read(ref workforceLoadGeneration);
        isHistoryLoading = true;
        historyLoadError = string.Empty;
        try
        {
            var page = await PartyDirectoryService.SearchPartyActivityAsync(
                new CrmActivityHistoryQuery(
                    partyId,
                    pageIndex,
                    activityPage.PageSize));
            if (!IsCurrentHistoryRequest(partyId, workforceGeneration))
            {
                return;
            }

            activityPage = page;
        }
        catch when (!IsCurrentHistoryRequest(partyId, workforceGeneration))
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to load workforce history page {PageIndex} for party {PartyId}.",
                pageIndex,
                partyId);
            historyLoadError = "The requested workforce history page could not be loaded.";
        }
        finally
        {
            if (IsCurrentHistoryRequest(partyId, workforceGeneration))
            {
                isHistoryLoading = false;
            }
        }
    }

    private bool IsCurrentHistoryRequest(Guid partyId, long workforceGeneration)
        => !isDisposed &&
           selectedWorkspace?.PartyId == partyId &&
           workforceGeneration == Volatile.Read(ref workforceLoadGeneration);

    private bool IsTrackedHistoryRequest(Guid partyId, long workforceGeneration)
        => historyLoadPartyId == partyId &&
           historyLoadWorkforceGeneration == workforceGeneration;

    private async Task RetryHistoryAsync()
    {
        InvalidateHistory();
        await EnsureHistoryLoadedAsync();
    }

    private void InvalidateHistory()
    {
        activityPage = CrmActivityHistoryPage.Empty();
        historyLoadTask = null;
        historyLoadPartyId = null;
        historyLoadedPartyId = null;
        historyLoadWorkforceGeneration = 0;
        isHistoryLoading = false;
        historyLoadError = string.Empty;
    }

    private async Task EnsureCapacityWorkspaceLoadedAsync()
    {
        if (selectedWorkspace is not { } workspace ||
            capacityWorkspace?.PartyId == workspace.PartyId)
        {
            return;
        }

        var partyId = workspace.PartyId;
        var workforceGeneration = Volatile.Read(ref workforceLoadGeneration);
        if (capacityWorkspaceLoadTask is null ||
            capacityWorkspaceLoadPartyId != partyId ||
            capacityWorkspaceLoadWorkforceGeneration != workforceGeneration)
        {
            capacityWorkspaceLoadPartyId = partyId;
            capacityWorkspaceLoadWorkforceGeneration = workforceGeneration;
            capacityWorkspaceLoadTask = HrService.GetWorkforceCapacityWorkspaceAsync(partyId);
            isCapacityWorkspaceLoading = true;
            capacityWorkspaceError = string.Empty;
        }

        var loadTask = capacityWorkspaceLoadTask;
        workforceGeneration = capacityWorkspaceLoadWorkforceGeneration;

        try
        {
            var loadedWorkspace = await loadTask;
            if (!IsCurrentCapacityRequest(loadTask, partyId, workforceGeneration))
            {
                return;
            }

            if (loadedWorkspace is null)
            {
                capacityWorkspaceError = "The selected workforce record no longer exists.";
                return;
            }

            capacityWorkspace = loadedWorkspace;
        }
        catch (Exception exception)
        {
            if (!IsCurrentCapacityRequest(loadTask, partyId, workforceGeneration))
            {
                return;
            }

            Logger.LogError(
                exception,
                "Failed to load workforce capacity workspace for party {PartyId}.",
                partyId);
            capacityWorkspaceError = "Capacity and allocation data could not be loaded. Retry the request or inspect the application logs.";
            NotificationService.Error("Allocation workspace load failed", capacityWorkspaceError);
        }
        finally
        {
            if (IsTrackedCapacityRequest(loadTask, partyId))
            {
                capacityWorkspaceLoadTask = null;
                capacityWorkspaceLoadPartyId = null;
                capacityWorkspaceLoadWorkforceGeneration = 0;
                isCapacityWorkspaceLoading = false;
            }
        }
    }

    private bool IsCurrentCapacityRequest(
        Task<WorkforceCapacityWorkspaceModel?> loadTask,
        Guid partyId,
        long workforceGeneration)
        => !isDisposed &&
           ReferenceEquals(capacityWorkspaceLoadTask, loadTask) &&
           capacityWorkspaceLoadPartyId == partyId &&
           selectedWorkspace?.PartyId == partyId &&
           workforceGeneration == Volatile.Read(ref workforceLoadGeneration);

    private bool IsTrackedCapacityRequest(
        Task<WorkforceCapacityWorkspaceModel?> loadTask,
        Guid partyId)
        => ReferenceEquals(capacityWorkspaceLoadTask, loadTask) &&
           capacityWorkspaceLoadPartyId == partyId;

    private async Task RetryCapacityWorkspaceAsync()
    {
        InvalidateCapacityWorkspace();
        await EnsureCapacityWorkspaceLoadedAsync();
    }

    private void InvalidateCapacityWorkspace()
    {

    private async Task RefreshWorkforceContextAsync() {
        if (WorkforceMutationInFlight || !TryCaptureSelectedWorkforceAction(out var action)) {
            return;
        }
        var observed = contextRevision;
        var outcome = recordOutcomeRevision;
        if (await ReloadAfterActionAsync(action, refreshDraft: true)) {
            contextOutdated = observed != contextRevision;
            if (outcome == recordOutcomeRevision && !AnyWorkforceOutcomeUnknown) {
                RecordMessage = null;
            }
        }
    }

    private async Task CreateDeliveryUnitAsync() {
        if (!isDeliveryUnitDialogOpen || isDeliveryUnitSaving || deliveryEditing is not { } current || AnyWorkforceOutcomeUnknown) {
            return;
        }
        if (string.IsNullOrWhiteSpace(current.Draft.DisplayName)) {
            NotificationService.Warning("Delivery unit not saved", "Delivery unit name is required.");
            return;
        }
        var opening = deliveryUnitDialogGeneration;
        isDeliveryUnitSaving = true;
        Guid? accepted = null;
        try {
            var result = await current.SaveAsync();
            if (isDisposed || opening != deliveryUnitDialogGeneration || !ReferenceEquals(deliveryEditing, current)) {
                return;
            }
            if (result.IsFailure) {
                NotificationService.Warning("Delivery unit was not saved", current.Message ?? string.Join(" ", result.Errors.Select(error => error.Message)));
                return;
            }
            workforceBrowserVersion++;
            if (current.State.IsDirty(current.Draft) || current.State.IsOutdated || current.State.Review is not null) {
                NotificationService.Success("Delivery unit saved", "Later input remains in this delivery-unit draft. Save it separately.");
                return;
            }
            accepted = result.Value;
            isDeliveryUnitDialogOpen = false;
            Interlocked.Increment(ref deliveryUnitDialogGeneration);
            await current.DisposeAsync();
            deliveryEditing = null;
        } finally {
            if (ReferenceEquals(deliveryEditing, current) || deliveryEditing is null) {
                isDeliveryUnitSaving = false;
            }
        }
        if (accepted is { } party) {
            await SelectPartyAsync(party);
        }
    }

    private void ProfileStateChanged() {
        if (selectedWorkspace is { } workspace && profileEditing.CurrentProfile is { } saved && saved.PartyId == workspace.PartyId) {
            selectedWorkspace = workspace with {

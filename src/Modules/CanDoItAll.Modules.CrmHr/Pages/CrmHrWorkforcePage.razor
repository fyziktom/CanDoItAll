@page "/crm-hr/workforce"
@implements IDisposable
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Modules.Projects
@using Microsoft.Extensions.Logging
@inject HrService HrService
@inject PartyDirectoryService PartyDirectoryService
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject ILogger<CrmHrWorkforcePage> Logger

<PageTitle>CRM / HR Workforce</PageTitle>

<AgentChatContextSurfaceProvider Surface="@AgentChatSurface"
                                 ContextNavigationIdentity="@AgentChatNavigationFence"
                                 ContextAccessState="@agentChatContextAccessState" />

<PageScaffold MaxWidthClass="max-w-full">
    <Header>
        <PageHeader Eyebrow="CRM / HR"
                    Title="Workforce workspace"
                    Description="Keep worker identity, delivery-unit structure, manager lines, and commercial staffing metadata on the shared party model instead of splitting people ops and delivery records."
                    Compact="true">
            <Actions>
                <PageHeaderActionButton Icon="asset"
                                        Label="Open directory"
                                        TooltipText="Open the shared party directory."
                                        Click="OpenDirectory" />
            </Actions>
        </PageHeader>
    </Header>

    <ChildContent>
        <Stack GapScale="LayoutGap.Medium">
            <CrmHrSecondaryTabs SelectedArea="CrmHrWorkspaceArea.Workforce" />

            <SurfaceCard data-testid="crmhr-workforce-catalog">
                <Stack GapScale="LayoutGap.Medium">
                    <ListPanelHeader Title="Workforce records"
                                     Description="Search and page through workers and delivery units. Open a card to manage its profile, skills, allocations, and history."
                                     Count="Server-paged">
                        <Actions>
                            <Button Text="New delivery unit"
                                    Icon="add"
                                    Size="ButtonSize.Small"
                                    Disabled="@isDeliveryUnitSaving"
                                    IsBusy="@isDeliveryUnitSaving"
                                    Click="OpenDeliveryUnitDialog"
                                    data-testid="crmhr-workforce-new-delivery-unit" />
                        </Actions>
                    </ListPanelHeader>
                    <PartyRecordBrowser @key="workforceBrowserVersion"
                                        AllowedScope="@(PartyRecordScope.People | PartyRecordScope.Organizations | PartyRecordScope.OrganizationUnits)"
                                        InitialScope="@(PartyRecordScope.People | PartyRecordScope.Organizations | PartyRecordScope.OrganizationUnits)"
                                        Population="PartyRecordPopulation.Workforce"
                                        SelectedPartyId="selectedWorkspace?.PartyId"
                                        SelectionChanged="SelectPartyAsync"
                                        LoadFailed="HandleWorkforceBrowserLoadFailedAsync"
                                        PageSize="12"
                                        ResultsScrollMode="PagedRecordResultsScrollMode.Bounded"
                                        SearchPlaceholder="Search workforce name, code, summary, or tag"
                                        DataTestId="crmhr-workforce"
                                        OptionTestId="crmhr-workforce-item" />
                </Stack>
            </SurfaceCard>

            @if (isRecordDialogOpen && selectedWorkspace is not null)
            {
                <Dialog IsOpen="true"
                        Eyebrow="Workforce record"
                        Title="@selectedWorkspace.DisplayName"
                        Subtitle="Profile, skills, allocation-driven availability, and workforce history."
                        Size="ModalSize.Full"
                        DenseChrome="true"
                        CloseOnBackdrop="false"
                        TestId="crmhr-workforce-record-dialog"
                        OnClose="CloseRecordDialogAsync">
                    <ChildContent>
                        <SurfaceCard Soft="true">
                            <Split Gap="LayoutGap.Medium">
                                <div class="min-w-0">
                                    <p class="cda-eyebrow">Selected workforce record</p>
                                    <h2 class="mt-1 text-lg font-semibold text-slate-950">@selectedWorkspace.DisplayName</h2>
                                    @if (!string.IsNullOrWhiteSpace(selectedWorkspace.Summary))
                                    {
                                        <p class="mt-1 line-clamp-2 text-sm leading-6 text-slate-600">@selectedWorkspace.Summary</p>
                                    }
                                    <p class="mt-2 text-sm font-medium text-slate-700"
                                       data-testid="crmhr-workforce-availability-message">
                                        @SelectedAvailabilityMessage
                                    </p>
                                </div>
                                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                    <StatusBadge Tone="@ResolveKindTone(profileEditor.WorkforceKind)" Text="@profileEditor.WorkforceKind.ToString()" />
                                    <StatusBadge Tone="@ResolveStatusTone(profileEditor.Status)" Text="@profileEditor.Status" />
                                    @if (SelectedAvailabilityState is { } availabilityState)
                                    {
                                        <StatusBadge Tone="@ResolveAvailabilityTone(availabilityState)"
                                                     Text="@availabilityState.ToString()" />
                                    }
                                </Cluster>
                            </Split>
                        </SurfaceCard>

                        <Tabs SelectedIndex="@selectedDetailTabIndex"
                              SelectedIndexChanged="HandleDetailTabChangedAsync"
                              RenderMode="TabRenderMode.Server"
                              Variant="TabsVariant.WorkspaceSecondary"
                              OverflowMode="TabsOverflowMode.Wrap"
                              AriaLabel="Workforce record sections"
                              data-testid="crmhr-workforce-tabs">
                            <TabsItem Text="Overview"
                                      Icon="dashboard"
                                      data-testid="crmhr-workforce-tab-overview">
                                <Stack GapScale="LayoutGap.Medium">
                                    <SensitiveDataCallout IsSensitive="selectedWorkspace.IsSensitive"
                                                         LastChangedBy="@selectedWorkspace.LastChangedBy"
                                                         UpdatedAtUtc="selectedWorkspace.UpdatedAtUtc"
                                                         DataTestId="crmhr-workforce-sensitive-callout"
                                                         StandardDescription="Use this summary before staffing or line-management changes so ownership and broad visibility stay explicit."
                                                         SensitiveDescription="Sensitive workforce records stay out of global search while still preserving assignment, manager, and capacity context for trusted operators." />

                                    <Grid Gap="LayoutGap.Medium" ColumnsMd="4">
                                        <SurfaceCard Soft="true">
                                            <p class="cda-eyebrow">Home unit</p>
                                            <p class="mt-1 text-sm font-medium text-slate-950"
                                               data-testid="crmhr-workforce-summary-home-unit">@FormatValue(selectedWorkspace.HomeUnitName)</p>
                                        </SurfaceCard>
                                        <SurfaceCard Soft="true">
                                            <p class="cda-eyebrow">Manager</p>
                                            <p class="mt-1 text-sm font-medium text-slate-950"
                                               data-testid="crmhr-workforce-summary-manager">@FormatValue(selectedWorkspace.ManagerName)</p>
                                        </SurfaceCard>
                                        <SurfaceCard Soft="true">
                                            <p class="cda-eyebrow">Primary email</p>
                                            <p class="mt-1 text-sm font-medium text-slate-950">@FormatValue(selectedWorkspace.PrimaryEmail)</p>
                                        </SurfaceCard>
                                        <SurfaceCard Soft="true">
                                            <p class="cda-eyebrow">Primary phone</p>
                                            <p class="mt-1 text-sm font-medium text-slate-950">@FormatValue(selectedWorkspace.PrimaryPhone)</p>
                                        </SurfaceCard>
                                        <SurfaceCard Soft="true">
                                            <p class="cda-eyebrow">Available now</p>
                                            <p class="mt-1 text-sm font-medium text-slate-950"
                                               data-testid="crmhr-workforce-summary-available">@FormatOptionalPercent(SelectedAvailablePercent)</p>
                                        </SurfaceCard>
                                        <SurfaceCard Soft="true">
                                            <p class="cda-eyebrow">Next availability</p>
                                            <p class="mt-1 text-sm font-medium text-slate-950"
                                               data-testid="crmhr-workforce-summary-next-availability">@(HasSelectedAvailabilityDetails ? FormatDate(SelectedNextAvailabilityOn) : "Not loaded")</p>
                                        </SurfaceCard>
                                        <SurfaceCard Soft="true">
                                            <p class="cda-eyebrow">Contract end</p>
                                            <p class="mt-1 text-sm font-medium text-slate-950">@FormatDate(selectedWorkspace.Profile.EndDate)</p>
                                        </SurfaceCard>
                                        <SurfaceCard Soft="true">
                                            <p class="cda-eyebrow">Searchable skills</p>
                                            <p class="mt-1 text-sm font-medium text-slate-950">@FormatValue(BuildSkillCoverage(selectedWorkspace.Skills))</p>
                                        </SurfaceCard>
                                    </Grid>
                                </Stack>
                            </TabsItem>

                            <TabsItem Text="Profile"
                                      Icon="badge"
                                      data-testid="crmhr-workforce-tab-profile">
                            <EditForm id="crmhr-workforce-profile-form"
                                      Model="profileEditor"
                                      OnValidSubmit="SaveWorkforceProfileAsync">
                                <FormSection Title="Workforce profile"
                                             Description="Keep employment type, commercial rate context, and org-structure metadata attached to the same Party identity used by CRM and project flows.">
                                    <Grid Gap="LayoutGap.Large" ColumnsMd="3">
                                        <div>
                                            <label class="cda-field-label">Workforce kind</label>
                                            <InputSelect @bind-Value="profileEditor.WorkforceKind"
                                                         class="cda-input"
                                                         data-testid="crmhr-workforce-kind">
                                                @foreach (var workforceKind in AvailableWorkforceKinds)
                                                {
                                                    <option value="@workforceKind">@workforceKind</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div>
                                            <label class="cda-field-label">Status</label>
                                            <InputSelect @bind-Value="profileEditor.Status"
                                                         class="cda-input"
                                                         data-testid="crmhr-workforce-status">
                                                @foreach (var status in WorkforceStatuses)
                                                {
                                                    <option value="@status">@status</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div>
                                            <label class="cda-field-label">Employee code</label>
                                            <InputText @bind-Value="profileEditor.EmployeeCode"
                                                       class="cda-input"
                                                       data-testid="crmhr-workforce-employee-code" />
                                        </div>
                                    </Grid>

                                    <Grid Gap="LayoutGap.Large" ColumnsMd="3" Class="mt-5">
                                        <div>
                                            <label class="cda-field-label">Job title</label>
                                            <InputText @bind-Value="profileEditor.JobTitle"
                                                       class="cda-input"
                                                       data-testid="crmhr-workforce-job-title" />
                                        </div>
                                        <div>
                                            <label class="cda-field-label">Discipline</label>
                                            <InputText @bind-Value="profileEditor.Discipline"
                                                       class="cda-input"
                                                       data-testid="crmhr-workforce-discipline" />
                                        </div>
                                        <div>
                                            <label class="cda-field-label">Seniority</label>
                                            <InputSelect @bind-Value="profileEditor.Seniority"
                                                         class="cda-input"
                                                         data-testid="crmhr-workforce-seniority">
                                                @foreach (var seniority in SeniorityValues)
                                                {
                                                    <option value="@seniority">@seniority</option>
                                                }
                                            </InputSelect>
                                        </div>
                                    </Grid>

                                    <Grid Gap="LayoutGap.Large" ColumnsMd="2" Class="mt-5">
                                        <PartyPicker Label="Home unit"
                                                     TestIdPrefix="crmhr-workforce-home-unit"
                                                     SelectedPartyId="@profileEditor.HomeUnitPartyId"
                                                     SelectedPartyIdChanged="HandleHomeUnitChangedAsync"
                                                     ExcludedPartyId="@selectedWorkspace.PartyId"
                                                     AllowedScope="@(PartyRecordScope.Organizations | PartyRecordScope.OrganizationUnits)"
                                                     InitialScope="@(PartyRecordScope.Organizations | PartyRecordScope.OrganizationUnits)" />
                                        <PartyPicker Label="Manager"
                                                     TestIdPrefix="crmhr-workforce-manager"
                                                     SelectedPartyId="@profileEditor.ManagerPartyId"
                                                     SelectedPartyIdChanged="HandleManagerChangedAsync"
                                                     ExcludedPartyId="@selectedWorkspace.PartyId"
                                                     AllowedScope="PartyRecordScope.People"
                                                     InitialScope="PartyRecordScope.People" />
                                    </Grid>

                                    <Grid Gap="LayoutGap.Large" ColumnsMd="3" Class="mt-5">
                                        <div>
                                            <label class="cda-field-label">Start date</label>
                                            <InputDate @bind-Value="profileEditor.StartDate"
                                                       class="cda-input"
                                                       data-testid="crmhr-workforce-start-date" />
                                        </div>
                                        <div>
                                            <label class="cda-field-label">End date</label>
                                            <InputDate @bind-Value="profileEditor.EndDate"
                                                       class="cda-input"
                                                       data-testid="crmhr-workforce-end-date" />
                                        </div>
                                        <div>
                                            <label class="cda-field-label">Capacity hours / week</label>
                                            <InputNumber @bind-Value="profileEditor.CapacityHoursPerWeek"
                                                         class="cda-input"
                                                         data-testid="crmhr-workforce-capacity" />
                                        </div>
                                    </Grid>

                                    <Grid Gap="LayoutGap.Large" ColumnsMd="2" Class="mt-5">
                                        <div>
                                            <label class="cda-field-label">Location</label>
                                            <InputText @bind-Value="profileEditor.Location"
                                                       class="cda-input"
                                                       data-testid="crmhr-workforce-location" />
                                        </div>
                                        <div>
                                            <label class="cda-field-label">Time zone</label>
                                            <InputText @bind-Value="profileEditor.TimeZone"
                                                       class="cda-input"
                                                       data-testid="crmhr-workforce-timezone" />
                                        </div>
                                    </Grid>

                                    <Grid Gap="LayoutGap.Large" ColumnsMd="4" Class="mt-5">
                                        <div>
                                            <label class="cda-field-label">Internal cost rate</label>
                                            <InputNumber @bind-Value="profileEditor.InternalCostRate"
                                                         class="cda-input"
                                                         data-testid="crmhr-workforce-internal-rate" />
                                        </div>
                                        <div>
                                            <label class="cda-field-label">External billing rate</label>
                                            <InputNumber @bind-Value="profileEditor.ExternalBillingRate"
                                                         class="cda-input"
                                                         data-testid="crmhr-workforce-external-rate" />
                                        </div>
                                        <div>
                                            <label class="cda-field-label">Rate unit</label>
                                            <InputSelect @bind-Value="profileEditor.RateUnit"
                                                         class="cda-input"
                                                         data-testid="crmhr-workforce-rate-unit">
                                                <option value="@ProjectResourceRateUnit.Hour">Per hour</option>
                                                <option value="@ProjectResourceRateUnit.ManDay">Per man-day</option>
                                            </InputSelect>
                                        </div>
                                        <div>
                                            <label class="cda-field-label">Rate currency</label>
                                            <InputText @bind-Value="profileEditor.RateCurrencyCode"
                                                       class="cda-input"
                                                       maxlength="3"
                                                       data-testid="crmhr-workforce-rate-currency" />
                                        </div>
                                    </Grid>

                                    <div class="mt-5">
                                        <label class="cda-field-label">Notes</label>
                                        <InputTextArea @bind-Value="profileEditor.Notes"
                                                       class="cda-input cda-input--textarea min-h-[9rem]"
                                                       data-testid="crmhr-workforce-notes" />
                                    </div>

                                </FormSection>
                            </EditForm>
                            </TabsItem>

                            <TabsItem Text="Skills"
                                      Icon="psychology"
                                      BadgeText="@selectedWorkspace.Skills.Count.ToString()"
                                      data-testid="crmhr-workforce-tab-skills">
                                <SkillMatrixPanel SkillCatalog="selectedWorkspace.SkillCatalog"
                                                  Skills="selectedWorkspace.Skills"
                                                  SkillDraft="skillEditor"
                                                  SkillDefinitionDraft="skillDefinitionEditor"
                                                  SavePartySkill="SavePartySkillAsync"
                                                  SaveSkillDefinition="SaveSkillDefinitionAsync"
                                                  DeletePartySkill="DeletePartySkillAsync" />
                            </TabsItem>

                            <TabsItem Text="Allocations"
                                      Icon="view_timeline"
                                      BadgeText="@AllocationBadgeText"
                                      data-testid="crmhr-workforce-tab-allocations">
                                <div data-testid="crmhr-workforce-allocations-panel">
                                    @if (isCapacityWorkspaceLoading)
                                    {
                                        <SurfaceCard Soft="true"
                                                     data-testid="crmhr-workforce-allocations-loading">
                                            <p class="cda-eyebrow">Loading allocation workspace</p>
                                            <p class="mt-2 text-sm leading-6 text-slate-600">
                                                Reading capacity blocks, project assignments, and the allocation timeline for this record.
                                            </p>
                                        </SurfaceCard>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(capacityWorkspaceError))
                                    {
                                        <SurfaceCard Soft="true"
                                                     data-testid="crmhr-workforce-allocations-error">
                                            <p class="cda-eyebrow text-rose-700">Allocation workspace unavailable</p>
                                            <p class="mt-2 text-sm leading-6 text-slate-700">@capacityWorkspaceError</p>
                                            <Button Text="Retry"
                                                    Icon="refresh"
                                                    ButtonStyle="ButtonStyle.Light"
                                                    Size="ButtonSize.Small"
                                                    Class="mt-4"
                                                    Click="RetryCapacityWorkspaceAsync" />
                                        </SurfaceCard>
                                    }
                                    else if (capacityWorkspace is { } loadedCapacityWorkspace)
                                    {
                                        <CapacityTimelinePanel CapacitySummary="loadedCapacityWorkspace.CapacitySummary"
                                                               CapacityBlocks="loadedCapacityWorkspace.CapacityBlocks"
                                                               ProjectAllocations="loadedCapacityWorkspace.ProjectAllocations"
                                                               CapacityBlockDraft="capacityBlockEditor"
                                                               SaveCapacityBlock="SaveCapacityBlockAsync"
                                                               DeleteCapacityBlock="DeleteCapacityBlockAsync"
                                                               OpenProject="OpenProjectAsync" />
                                    }
                                </div>
                            </TabsItem>

                            <TabsItem Text="History"
                                      Icon="history"
                                      BadgeText="@activityPage.TotalCount.ToString()"
                                      data-testid="crmhr-workforce-tab-history">
                                <div data-testid="crmhr-workforce-timeline">
                                    @if (!string.IsNullOrWhiteSpace(historyLoadError))
                                    {
                                        <SurfaceCard Soft="true" data-testid="crmhr-workforce-history-error">
                                            <p class="cda-eyebrow text-rose-700">History unavailable</p>
                                            <p class="mt-2 text-sm leading-6 text-slate-700">@historyLoadError</p>
                                            <Button Text="Retry"
                                                    Icon="refresh"
                                                    ButtonStyle="ButtonStyle.Light"
                                                    Size="ButtonSize.Small"
                                                    Class="mt-4"
                                                    Click="RetryHistoryAsync" />
                                        </SurfaceCard>
                                    }
                                    else
                                    {
                                        <InteractionTimeline Page="activityPage"
                                                             IsLoading="@isHistoryLoading"
                                                             PageRequested="HandleHistoryPageRequestedAsync"
                                                             DataTestId="crmhr-workforce-history"
                                                             Eyebrow="Workforce history"
                                                             Title="Recent staffing, lifecycle, and audit activity"
                                                             Description="Workforce profile saves, archive/reactivate events, recruiting transitions, and related CRM-HR changes stay visible here for the selected party."
                                                             EmptyEyebrow="No workforce history"
                                                             EmptyTitle="No saved history for this record"
                                                             EmptyDescription="Save a workforce profile or related CRM-HR workflow to build the shared audit trail." />
                                    }
                                </div>
                            </TabsItem>
                        </Tabs>
                    </ChildContent>
                    <Footer>
                        <Split Breakpoint="LayoutBreakpoint.None"
                               Gap="LayoutGap.Medium"
                               AlignItems="AlignItems.Center"
                               JustifyContent="JustifyContent.SpaceBetween"
                               Wrap="FlexWrap.Wrap">
                            <Button Text="Open directory record"
                                    ButtonStyle="ButtonStyle.Light"
                                    Click="OpenDirectory" />
                            <Cluster Gap="LayoutGap.Small">
                                <Button Text="Close"
                                        ButtonStyle="ButtonStyle.Light"
                                        Click="CloseRecordDialogAsync"
                                        data-testid="crmhr-workforce-record-close" />
                                @if (selectedDetailTabIndex == ProfileTabIndex)
                                {
                                    <Button Text="Save workforce profile"
                                            Click="SaveWorkforceProfileAsync"
                                            data-testid="crmhr-workforce-save-button" />
                                }
                            </Cluster>
                        </Split>
                    </Footer>
                </Dialog>
            }

            @if (isDeliveryUnitDialogOpen)
            {
                <Dialog IsOpen="true"
                        Eyebrow="Workforce"
                        Title="New delivery unit"
                        Subtitle="Create an organization unit with delivery semantics without displacing the workforce list."
                        Size="ModalSize.Compact"
                        DenseChrome="true"
                        ShowCloseButton="@(!isDeliveryUnitSaving)"
                        CloseOnBackdrop="@(!isDeliveryUnitSaving)"
                        TestId="crmhr-workforce-delivery-unit-dialog"
                        OnClose="CloseDeliveryUnitDialogAsync">
                    <ChildContent>
                        <EditForm Model="deliveryUnitEditor" OnValidSubmit="CreateDeliveryUnitAsync">
                            <Stack GapScale="LayoutGap.Medium">
                                <Grid Gap="LayoutGap.Medium" ColumnsMd="2">
                                    <FormField Text="Unit name">
                                        <InputText @bind-Value="deliveryUnitEditor.Name"
                                                   class="cda-input"
                                                   data-testid="crmhr-delivery-unit-name" />
                                    </FormField>
                                    <FormField Text="External code">
                                        <InputText @bind-Value="deliveryUnitEditor.ExternalCode"
                                                   class="cda-input"
                                                   data-testid="crmhr-delivery-unit-code" />
                                    </FormField>
                                </Grid>

                                <FormField Text="Summary">
                                    <InputTextArea @bind-Value="deliveryUnitEditor.Summary"
                                                   class="cda-input cda-input--textarea min-h-[7rem]"
                                                   data-testid="crmhr-delivery-unit-summary" />
                                </FormField>

                                <Cluster Gap="LayoutGap.Small" JustifyContent="JustifyContent.End">
                                    <Button Text="Cancel"
                                            ButtonStyle="ButtonStyle.Light"
                                            Disabled="@isDeliveryUnitSaving"
                                            Click="CloseDeliveryUnitDialogAsync" />
                                    <Button Text="Create delivery unit"
                                            Type="submit"
                                            Disabled="@isDeliveryUnitSaving"
                                            IsBusy="@isDeliveryUnitSaving"
                                            data-testid="crmhr-delivery-unit-save-button" />
                                </Cluster>
                            </Stack>
                        </EditForm>
                    </ChildContent>
                </Dialog>
            }

        </Stack>
    </ChildContent>
</PageScaffold>

@code {
    [SupplyParameterFromQuery(Name = "partyId")]
    public Guid? PartyIdQuery { get; set; }

    private const int OverviewTabIndex = 0;
    private const int ProfileTabIndex = 1;
    private const int SkillsTabIndex = 2;
    private const int AllocationsTabIndex = 3;
    private const int HistoryTabIndex = 4;

    private static readonly IReadOnlyList<string> WorkforceStatuses =
    [
        "Planned",
        "Active",
        "Leave",
        "Inactive",
        "Alumni"
    ];

    private static readonly IReadOnlyList<string> SeniorityValues =
    [
        string.Empty,
        "Associate",
        "Mid",
        "Senior",
        "Lead",
        "Principal"
    ];

    private readonly DeliveryUnitQuickCreateModel deliveryUnitEditor = new();
    private readonly SkillDefinitionEditorModel skillDefinitionEditor = new()
    {
        IsActive = true
    };
    private CrmActivityHistoryPage activityPage = CrmActivityHistoryPage.Empty();
    private WorkforceProfileWorkspaceModel? selectedWorkspace;
    private WorkforceCapacityWorkspaceModel? capacityWorkspace;
    private Task<WorkforceCapacityWorkspaceModel?>? capacityWorkspaceLoadTask;
    private Guid? capacityWorkspaceLoadPartyId;
    private long capacityWorkspaceLoadWorkforceGeneration;
    private Task? historyLoadTask;
    private Guid? historyLoadPartyId;
    private Guid? historyLoadedPartyId;
    private long historyLoadWorkforceGeneration;
    private CancellationTokenSource? deliveryUnitSaveCancellation;
    private WorkforceProfileEditorModel profileEditor = new();
    private PartySkillEditorModel skillEditor = CreatePartySkillEditor(Guid.Empty);
    private CapacityBlockEditorModel capacityBlockEditor = CreateCapacityBlockEditor(Guid.Empty);
    private string capacityWorkspaceError = string.Empty;
    private AgentChatContextAccessState agentChatContextAccessState = AgentChatContextAccessState.Loading;
    private long workforceLoadGeneration;
    private long deliveryUnitDialogGeneration;
    private int selectedDetailTabIndex = OverviewTabIndex;
    private int workforceBrowserVersion;
    private bool isCapacityWorkspaceLoading;
    private bool isHistoryLoading;
    private bool isRecordDialogOpen;
    private bool isDeliveryUnitDialogOpen;
    private bool isDeliveryUnitSaving;
    private bool isDisposed;
    private string historyLoadError = string.Empty;

    private AgentChatContextSurface AgentChatSurface => selectedWorkspace is { } workspace &&
                                                         (!PartyIdQuery.HasValue || PartyIdQuery.Value == workspace.PartyId)
        ? CrmHrAgentChatSurfaceBuilder.BuildWorkforceSurface(
            workspace.PartyId,
            workspace.DisplayName,
            workspace.LifecycleStatus,
            workspace.Profile.Id.HasValue ? SelectedAvailabilityState : null,
            hasWorkforceProfile: workspace.Profile.Id.HasValue,
            availabilityLoaded: HasSelectedAvailabilityDetails)
        : CrmHrAgentChatSurfaceBuilder.BuildWorkforceSurface();

    private AgentChatNavigationIdentity AgentChatNavigationFence
        => AgentChatNavigationIdentity.CreateForLocation(
            Navigation.BaseUri,
            Navigation.Uri,
            [new("partyId", PartyIdQuery?.ToString("D"))]);

    private WorkforceAvailabilityState? SelectedAvailabilityState
        => capacityWorkspace?.CapacitySummary.AvailabilityState;

    private bool HasSelectedAvailabilityDetails
        => capacityWorkspace is not null;

    private decimal? SelectedAvailablePercent
        => capacityWorkspace?.CapacitySummary.AvailablePercent;

    private DateOnly? SelectedNextAvailabilityOn
        => capacityWorkspace?.CapacitySummary.NextAvailabilityOn;

    private string SelectedAvailabilityMessage
        => capacityWorkspace?.CapacitySummary.AvailabilityMessage
           ?? "Capacity details are available from the Allocations tab.";

    private string AllocationBadgeText
        => capacityWorkspace?.ProjectAllocations.Count.ToString() ?? string.Empty;

    private IReadOnlyList<WorkforceKind> AvailableWorkforceKinds
        => selectedWorkspace is null
            ? Enum.GetValues<WorkforceKind>()
            : selectedWorkspace.PartyType == PartyType.Person
                ? [WorkforceKind.Employee, WorkforceKind.Contractor, WorkforceKind.Freelancer]
                : [WorkforceKind.DeliveryUnit];

    protected override async Task OnParametersSetAsync()
    {
        var requestedPartyId = PartyIdQuery;
        if (requestedPartyId != selectedWorkspace?.PartyId)
        {
            isRecordDialogOpen = false;
        }

        var request = BeginWorkforceLoad(
            requestedPartyId,
            WorkforceLoadBinding.RouteBound,
            expectedSelectedPartyId: null);
        var outcome = await LoadAndCommitWorkforceAsync(request);
        if (outcome == WorkforceLoadOutcome.Stale)
        {
            return;
        }

        agentChatContextAccessState = outcome == WorkforceLoadOutcome.Ready
            ? AgentChatContextAccessState.Ready
            : AgentChatContextAccessState.Failed;
        isRecordDialogOpen = outcome == WorkforceLoadOutcome.Ready &&
                             requestedPartyId.HasValue &&
                             selectedWorkspace is not null;

        if (outcome == WorkforceLoadOutcome.Ready && selectedDetailTabIndex == AllocationsTabIndex)
        {
            await EnsureCapacityWorkspaceLoadedAsync();
        }
    }

    private WorkforceLoadRequest BeginWorkforceLoad(
        Guid? requestedPartyId,
        WorkforceLoadBinding binding,
        Guid? expectedSelectedPartyId)
    {
        agentChatContextAccessState = AgentChatContextAccessState.Loading;
        return new WorkforceLoadRequest(
            Interlocked.Increment(ref workforceLoadGeneration),
            requestedPartyId,
            PartyIdQuery,
            expectedSelectedPartyId,
            binding);
    }

    private async Task<WorkforceLoadOutcome> LoadAndCommitWorkforceAsync(
        WorkforceLoadRequest request)
    {
        try
        {
            var snapshot = await LoadWorkforceSnapshotAsync(request.RequestedPartyId);
            if (!IsCurrentWorkforceLoad(request))
            {
                return WorkforceLoadOutcome.Stale;
            }

            CommitWorkforceSnapshot(snapshot);
            return snapshot.RequestedPartyFound
                ? WorkforceLoadOutcome.Ready
                : WorkforceLoadOutcome.Missing;
        }
        catch when (!IsCurrentWorkforceLoad(request))
        {
            return WorkforceLoadOutcome.Stale;
        }
        catch
        {
            agentChatContextAccessState = AgentChatContextAccessState.Failed;
            throw;
        }
    }

    private async Task<WorkforceLoadSnapshot> LoadWorkforceSnapshotAsync(Guid? requestedPartyId)
    {
        if (!requestedPartyId.HasValue)
        {
            return WorkforceLoadSnapshot.Empty(requestedPartyFound: true);
        }

        var workspace = await HrService.GetWorkforceProfileWorkspaceAsync(requestedPartyId.Value);
        if (workspace is null)
        {
            return WorkforceLoadSnapshot.Empty(requestedPartyFound: false);
        }

        return new WorkforceLoadSnapshot(
            workspace,
            RequestedPartyFound: true);
    }

    private void CommitWorkforceSnapshot(WorkforceLoadSnapshot snapshot)
    {
        if (snapshot.Workspace is null)
        {
            ClearWorkforceSelection();
            return;
        }

        var isPartySelectionChanged = selectedWorkspace?.PartyId != snapshot.Workspace.PartyId;
        if (isPartySelectionChanged)
        {
            selectedDetailTabIndex = OverviewTabIndex;
            InvalidateCapacityWorkspace();
        }

        InvalidateHistory();
        ApplyLoadedWorkspace(snapshot.Workspace);
    }

    private bool IsCurrentWorkforceLoad(WorkforceLoadRequest request)
        => !isDisposed &&
           request.Generation == Volatile.Read(ref workforceLoadGeneration) &&
           PartyIdQuery == request.RoutePartyId &&
           (request.Binding == WorkforceLoadBinding.RouteBound ||
            selectedWorkspace?.PartyId == request.ExpectedSelectedPartyId);

    private void ApplyLoadedWorkspace(WorkforceProfileWorkspaceModel workspace)
    {
        selectedWorkspace = workspace;
        profileEditor = new WorkforceProfileEditorModel
        {
            Id = workspace.Profile.Id,
            PartyId = workspace.Profile.PartyId,
            WorkforceKind = workspace.Profile.WorkforceKind,
            EmployeeCode = workspace.Profile.EmployeeCode,
            JobTitle = workspace.Profile.JobTitle,
            Discipline = workspace.Profile.Discipline,
            Seniority = workspace.Profile.Seniority,
            HomeUnitPartyId = workspace.Profile.HomeUnitPartyId,
            ManagerPartyId = workspace.Profile.ManagerPartyId,
            StartDate = workspace.Profile.StartDate,
            EndDate = workspace.Profile.EndDate,
            Location = workspace.Profile.Location,
            TimeZone = workspace.Profile.TimeZone,
            InternalCostRate = workspace.Profile.InternalCostRate,
            ExternalBillingRate = workspace.Profile.ExternalBillingRate,
            RateUnit = workspace.Profile.RateUnit,
            RateCurrencyCode = workspace.Profile.RateCurrencyCode,
            CapacityHoursPerWeek = workspace.Profile.CapacityHoursPerWeek,
            Status = workspace.Profile.Status,
            Notes = workspace.Profile.Notes,
            LastChangedBy = workspace.Profile.LastChangedBy
        };
        skillEditor = CreatePartySkillEditor(workspace.PartyId);
        capacityBlockEditor = CreateCapacityBlockEditor(workspace.PartyId);

    }

    private async Task<bool> ReloadAfterActionAsync(WorkforceActionStamp action)
    {
        if (!IsCurrentWorkforceAction(action))
        {
            return false;
        }

        var request = BeginWorkforceLoad(
            action.SelectedPartyId ?? action.RoutePartyId,
            WorkforceLoadBinding.ActionRefresh,
            action.SelectedPartyId);
        var outcome = await LoadAndCommitWorkforceAsync(request);
        agentChatContextAccessState = outcome switch
        {
            WorkforceLoadOutcome.Ready => AgentChatContextAccessState.Ready,
            WorkforceLoadOutcome.Missing => AgentChatContextAccessState.Failed,
            _ => agentChatContextAccessState
        };

        if (outcome == WorkforceLoadOutcome.Ready)
        {
            InvalidateCapacityWorkspace();
            if (selectedDetailTabIndex == AllocationsTabIndex)
            {
                await EnsureCapacityWorkspaceLoadedAsync();
            }
            else if (selectedDetailTabIndex == HistoryTabIndex)
            {
                await EnsureHistoryLoadedAsync();
            }
        }

        return outcome == WorkforceLoadOutcome.Ready;
    }

    private WorkforceActionStamp CaptureWorkforceAction()
        => new(
            Volatile.Read(ref workforceLoadGeneration),
            PartyIdQuery,
            selectedWorkspace?.PartyId);

    private bool TryCaptureSelectedWorkforceAction(out WorkforceActionStamp action)
    {
        action = CaptureWorkforceAction();
        return action.SelectedPartyId.HasValue &&
               IsCurrentWorkforceAction(action);
    }

    private bool IsCurrentWorkforceAction(WorkforceActionStamp action)
        => !isDisposed &&
           action.Generation == Volatile.Read(ref workforceLoadGeneration) &&
           PartyIdQuery == action.RoutePartyId &&
           selectedWorkspace?.PartyId == action.SelectedPartyId;


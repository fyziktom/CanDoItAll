    public async ValueTask DisposeAsync()
    {
        if (isDisposed)
        {
            return;
        }

        isDisposed = true;
        Interlocked.Increment(ref workforceLoadGeneration);
        Interlocked.Increment(ref deliveryUnitDialogGeneration);
        workforceHistory.Dispose();
        await profileEditing.DisposeAsync();
        if (deliveryEditing is { } current) {
            await current.DisposeAsync();
        }
    }

    private async Task SaveRecordAsync<TModel, TField>(RecordDraftState<TModel, TField> draft, WorkforceWriteArea area,
        Func<TModel, Action<WorkforceSaveReceipt<TModel>>, Task<Result<Guid>>> write,
        Action<RecordSubmission<TModel, TField>, WorkforceSaveReceipt<TModel>> accept, string label)
        where TModel : class where TField : struct, Enum {
        if (WorkforceMutationInFlight || AnyWorkforceOutcomeUnknown || !TryCaptureSelectedWorkforceAction(out var action) || action.SelectedPartyId is not { } party) {
            return;
        }
        using var gate = mutationGate.TryEnter(action.Generation);
        if (gate is null || draft.Begin() is not { } submitted) {
            return;
        }
        var started = false;
        try {
            var authorize = profileEditing.CaptureWriteAdmission(party, area);
            await authorize(default);
            if (!IsCurrentWorkforceAction(action) || !draft.IsCurrent(submitted)) {
                return;
            }
            using var authority = Changes.EnterUiWrite(authorize);
            using var origin = profileEditing.EnterWrite(party);
            started = true;
            var result = await write(submitted.Model, receipt => {
                if (IsCurrentWorkforceAction(action) && draft.IsCurrent(submitted)) {
                    accept(submitted, receipt);
                    RecordMessage = label + " saved. Later input remains in your draft.";
                }
            });
            if (result.IsFailure && IsCurrentWorkforceAction(action)) {
                RecordMessage = string.Join(" ", result.Errors.Select(error => error.Message));
                if (result.Errors.Any(error => error.Code == CrmHrEditingErrorCodes.SkillConflict)) {
                    recordDrafts.HintSkills();
                    recordsOutdated = true;
                }
                NotificationService.Warning(label + " was not saved", RecordMessage);
                return;
            }
            if (draft.Accepted is null) {
                throw new InvalidOperationException("The workforce owner completed without a commit receipt.");
            }
            if (!await ReloadAfterActionAsync(action)) {
                RecordMessage = label + " was saved; refresh failed. Your draft is retained.";
            }
        } catch (UnauthorizedAccessException exception) {
            if (draft.IsCurrent(submitted)) {
                RecordMessage = "Current access no longer permits this workforce change.";
                Logger.LogWarning(exception, "Workforce {Area} write rejected for party {PartyId}.", area, party);
            }
        } catch (Exception exception) {
            if (draft.IsCurrent(submitted)) {
                if (started && draft.Accepted is null) {
                    draft.Unknown(submitted);
                    RecordMessage = label + " save outcome is unknown. Its submission and later input are retained; resubmission is blocked.";
                } else {
                    RecordMessage = label + (draft.Accepted is null ? " was not saved." : " was saved; a follow-up failed. Your draft is retained.");
                }
                Logger.LogWarning(exception, "Workforce {Area} write failed for party {PartyId}; acceptance known: {Known}.", area, party, draft.Accepted is not null);
            }
        } finally {
            draft.Complete(submitted);
        }
    }


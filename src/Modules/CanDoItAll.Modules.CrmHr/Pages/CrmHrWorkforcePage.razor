    private async Task CreateDeliveryUnitAsync()
    {
        if (!isDeliveryUnitDialogOpen || isDeliveryUnitSaving)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(deliveryUnitEditor.Name))
        {
            NotificationService.Warning("Delivery unit not created", "Delivery unit name is required.");
            return;
        }

        var dialogGeneration = Volatile.Read(ref deliveryUnitDialogGeneration);
        using var saveCancellation = new CancellationTokenSource();
        deliveryUnitSaveCancellation = saveCancellation;
        isDeliveryUnitSaving = true;

        try
        {
            var saveResult = await PartyDirectoryService.SavePartyAsync(new PartyEditorModel
            {
                PartyType = PartyType.OrganizationUnit,
                LifecycleStatus = PartyLifecycleStatus.Active,
                DisplayName = deliveryUnitEditor.Name.Trim(),
                ExternalCode = deliveryUnitEditor.ExternalCode.Trim(),
                Summary = deliveryUnitEditor.Summary.Trim(),
                LastChangedBy = "crm-hr-ui",
                Roles =
                [
                    new PartyRoleAssignmentEditorModel
                    {
                        RoleKind = PartyRoleKind.DeliveryUnit,
                        Title = "Delivery unit",
                        IsPrimary = true
                    }
                ]
            }, saveCancellation.Token);
            if (saveResult.IsFailure)
            {
                if (IsCurrentDeliveryUnitSave(dialogGeneration, saveCancellation))
                {
                    NotificationService.Error("Delivery unit create failed", string.Join(" ", saveResult.Errors.Select(error => error.Message)));
                }

                return;
            }

            if (!IsCurrentDeliveryUnitSave(dialogGeneration, saveCancellation))
            {
                return;
            }

            deliveryUnitEditor.Name = string.Empty;
            deliveryUnitEditor.ExternalCode = string.Empty;
            deliveryUnitEditor.Summary = string.Empty;
            isDeliveryUnitDialogOpen = false;
            Interlocked.Increment(ref deliveryUnitDialogGeneration);

            Interlocked.Increment(ref workforceLoadGeneration);
            agentChatContextAccessState = AgentChatContextAccessState.Loading;
            Navigation.NavigateTo($"/crm-hr/workforce?partyId={saveResult.Value:D}");
            NotificationService.Success("Delivery unit created", "Delivery unit created.");
        }
        catch (OperationCanceledException) when (saveCancellation.IsCancellationRequested)
        {
            return;
        }
        finally
        {
            if (ReferenceEquals(deliveryUnitSaveCancellation, saveCancellation))
            {
                deliveryUnitSaveCancellation = null;
                isDeliveryUnitSaving = false;
            }
        }
    }

    private bool IsCurrentDeliveryUnitSave(
        long dialogGeneration,
        CancellationTokenSource saveCancellation)
        => isDeliveryUnitDialogOpen &&
           isDeliveryUnitSaving &&
           !saveCancellation.IsCancellationRequested &&
           ReferenceEquals(deliveryUnitSaveCancellation, saveCancellation) &&
           dialogGeneration == Volatile.Read(ref deliveryUnitDialogGeneration);

    private void ResetFilters()
    {
        searchText = string.Empty;
        kindFilter = string.Empty;
        skillFilter = string.Empty;
        availabilityFilter = string.Empty;
    }

    private bool MatchesSearch(WorkforceListItemModel item)
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return true;
        }

        return item.DisplayName.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || item.JobTitle.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || item.Discipline.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || item.Seniority.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || item.Location.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || item.SkillSummary.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || item.HomeUnitName.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || item.ManagerName.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || ResolveAvailabilityText(item.AvailabilityState).Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || item.Roles.Any(role => role.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase));
    }

    private bool MatchesKind(WorkforceListItemModel item)
    {
        return string.IsNullOrWhiteSpace(kindFilter)
            || string.Equals(item.WorkforceKind?.ToString(), kindFilter, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesSkill(WorkforceListItemModel item)
    {
        if (string.IsNullOrWhiteSpace(skillFilter))
        {
            return true;
        }

        var selectedSkillName = skillCatalog
            .FirstOrDefault(skill => string.Equals(skill.Id.ToString("D"), skillFilter, StringComparison.OrdinalIgnoreCase))
            ?.Name;
        return !string.IsNullOrWhiteSpace(selectedSkillName)
            && item.SkillSummary.Contains(selectedSkillName, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesAvailability(WorkforceListItemModel item)
    {
        return string.IsNullOrWhiteSpace(availabilityFilter)
            || string.Equals(item.AvailabilityState?.ToString(), availabilityFilter, StringComparison.OrdinalIgnoreCase);
    }

    private static string BuildItemEyebrow(WorkforceListItemModel item)
    {
        return item.PartyType switch
        {
            PartyType.OrganizationUnit => "Organization unit",
            PartyType.Organization => "Organization",
            _ => "Person"
        };
    }

    private static string BuildItemMeta(WorkforceListItemModel item)
    {
        var parts = new List<string>
        {
            item.Status
        };

        if (item.AvailabilityState.HasValue)
        {
            parts.Add($"{item.AvailabilityState.Value} / {item.AvailablePercent:0.##}% free");
        }

        if (!string.IsNullOrWhiteSpace(item.Location))
        {
            parts.Add(item.Location);
        }

        if (!string.IsNullOrWhiteSpace(item.HomeUnitName))
        {
            parts.Add($"Home unit: {item.HomeUnitName}");
        }

        if (!string.IsNullOrWhiteSpace(item.ManagerName))
        {
            parts.Add($"Manager: {item.ManagerName}");
        }

        if (item.ContractEndDate.HasValue)
        {
            parts.Add($"Contract ends {item.ContractEndDate.Value:yyyy-MM-dd}");
        }

        return string.Join(" / ", parts);
    }

    private static string BuildItemSummary(WorkforceListItemModel item)
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(item.JobTitle))
        {
            parts.Add(item.JobTitle);
        }

        if (!string.IsNullOrWhiteSpace(item.Discipline))
        {
            parts.Add(item.Discipline);
        }

        if (!string.IsNullOrWhiteSpace(item.Seniority))
        {
            parts.Add(item.Seniority);
        }

        if (!string.IsNullOrWhiteSpace(item.SkillSummary))
        {
            parts.Add(item.SkillSummary);
        }

        if (parts.Count == 0)
        {
            return item.HasProfile
                ? "Profile created but searchable staffing details are still empty."
                : "Directory identity exists, but workforce metadata still needs to be captured.";
        }

        return string.Join(" / ", parts);
    }

    private static string ResolveKindText(WorkforceListItemModel item)
    {
        return item.WorkforceKind?.ToString() ?? "No profile";
    }

    private static string ResolveKindTone(WorkforceKind? workforceKind)
    {
        return workforceKind switch
        {
            WorkforceKind.Employee => "success",
            WorkforceKind.Contractor => "warning",
            WorkforceKind.Freelancer => "info",
            WorkforceKind.DeliveryUnit => "primary",
            _ => "base"
        };
    }

    private static string ResolveStatusTone(string status)
    {
        return status switch
        {
            "Active" => "success",
            "Leave" => "warning",
            "Inactive" => "danger",
            "Alumni" => "info",
            _ => "base"
        };
    }

    private static string ResolveAvailabilityTone(WorkforceAvailabilityState availabilityState)
    {
        return availabilityState switch
        {
            WorkforceAvailabilityState.Overallocated => "danger",
            WorkforceAvailabilityState.Bench => "success",
            WorkforceAvailabilityState.NearAvailable => "warning",
            _ => "info"
        };
    }

    private static string ResolveAvailabilityText(WorkforceAvailabilityState? availabilityState)
    {
        return availabilityState?.ToString() ?? string.Empty;
    }

    private static string BuildAvailabilityMessage(WorkforceListItemModel? item)
    {
        if (item?.AvailabilityState is not { } availabilityState)
        {
            return "Capacity details are available from the Allocations tab.";
        }

        var nextAvailability = item.NextAvailabilityOn.HasValue
            ? $" Next availability: {item.NextAvailabilityOn.Value:yyyy-MM-dd}."
            : string.Empty;
        return $"{availabilityState} · {item.AvailablePercent:0.##}% available.{nextAvailability}";
    }

    private static string FormatValue(string value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Not set" : value;
    }

    private static string FormatDate(DateOnly? value)
    {
        return value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "Not set";
    }

    private static string FormatOptionalPercent(decimal? value)
    {
        return value.HasValue ? $"{value.Value:0.##}%" : "Not loaded";
    }

    private static string BuildSkillCoverage(IReadOnlyList<PartySkillItemModel> skills)
    {
        return string.Join(", ", skills.Select(item => item.SkillName));
    }

    private static PartySkillEditorModel CreatePartySkillEditor(Guid partyId)
    {
        return new PartySkillEditorModel
        {
            PartyId = partyId,
            Proficiency = SkillProficiencyLevel.Basic,
            LastValidatedOn = DateOnly.FromDateTime(DateTime.UtcNow)
        };
    }

    private static CapacityBlockEditorModel CreateCapacityBlockEditor(Guid partyId)
    {
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        return new CapacityBlockEditorModel
        {
            PartyId = partyId,
            BlockKind = CapacityBlockKind.Leave,
            StartDate = today,
            EndDate = today,
            Percentage = 100m
        };
    }

    private enum WorkforceLoadBinding
    {
        RouteBound,
        ActionRefresh
    }

    private enum WorkforceLoadOutcome
    {
        Ready,
        Missing,
        Stale
    }

    private readonly record struct WorkforceLoadRequest(
        long Generation,
        Guid? RequestedPartyId,
        Guid? RoutePartyId,
        Guid? ExpectedSelectedPartyId,
        WorkforceLoadBinding Binding);

    private readonly record struct WorkforceActionStamp(
        long Generation,
        Guid? RoutePartyId,
        Guid? SelectedPartyId);

    private sealed record WorkforceLoadSnapshot(
        IReadOnlyList<WorkforceListItemModel> WorkforceItems,
        IReadOnlyList<SkillCatalogItemModel> SkillCatalog,
        WorkforceProfileWorkspaceModel? Workspace,
        IReadOnlyList<CrmAccountActivityTimelineItemModel> ActivityTimeline,
        bool RequestedPartyFound)
    {
        public static WorkforceLoadSnapshot Empty(
            IReadOnlyList<WorkforceListItemModel> workforceItems,
            IReadOnlyList<SkillCatalogItemModel> skillCatalog,
            bool requestedPartyFound)
            => new(
                workforceItems,
                skillCatalog,
                Workspace: null,
                ActivityTimeline: [],
                RequestedPartyFound: requestedPartyFound);
    }

    private sealed class DeliveryUnitQuickCreateModel
    {
        public string Name { get; set; } = string.Empty;
        public string ExternalCode { get; set; } = string.Empty;
        public string Summary { get; set; } = string.Empty;
    }

    public void Dispose()
    {
        if (isDisposed)
        {
            return;
        }

        isDisposed = true;
        deliveryUnitSaveCancellation?.Cancel();
        Interlocked.Increment(ref workforceLoadGeneration);
        Interlocked.Increment(ref deliveryUnitDialogGeneration);
    }
}

    private async Task DeleteRecordAsync(Guid id, Func<Action<WorkforceDeleteReceipt>, Task<Result>> write, Action unknown, string label) {
        if (WorkforceMutationInFlight || AnyWorkforceOutcomeUnknown || !TryCaptureSelectedWorkforceAction(out var action) || action.SelectedPartyId is not { } party) {
            return;
        }
        using var gate = mutationGate.TryEnter(action.Generation);
        if (gate is null) {
            return;
        }
        var known = false;
        var started = false;
        try {
            var authorize = profileEditing.CaptureWriteAdmission(party, WorkforceWriteArea.Records);
            await authorize(default);
            using var authority = Changes.EnterUiWrite(authorize);
            using var origin = profileEditing.EnterWrite(party);
            started = true;
            var result = await write(receipt => {
                if (receipt.Id != id || receipt.PartyId != party) {
                    throw new InvalidOperationException("The workforce deletion receipt identifies another row or worker.");
                }
                known = true;
            });
            if (!IsCurrentWorkforceAction(action)) {
                return;
            }
            if (result.IsFailure) {
                RecordMessage = string.Join(" ", result.Errors.Select(error => error.Message));
                NotificationService.Warning(label + " was not removed", RecordMessage);
                return;
            }
            if (!known) {
                throw new InvalidOperationException("The workforce deletion completed without a receipt.");
            }
            RecordMessage = label + " removed.";
            await ReloadAfterActionAsync(action);
        } catch (UnauthorizedAccessException exception) {
            RecordMessage = "Current access no longer permits removing this workforce row.";
            Logger.LogWarning(exception, "Workforce deletion rejected for party {PartyId}, row {RowId}.", party, id);
        } catch (Exception exception) {
            if (IsCurrentWorkforceAction(action)) {
                if (started && !known) {
                    unknown();
                }
                RecordMessage = known ? label + " was removed; a follow-up failed." : label + " removal outcome is unknown. Review the current rows; repeating the command is blocked.";
                Logger.LogWarning(exception, "Workforce deletion failed for party {PartyId}, row {RowId}; acceptance known: {Known}.", party, id, known);
            }
        }
    }


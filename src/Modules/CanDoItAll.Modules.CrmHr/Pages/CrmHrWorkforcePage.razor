@using static CanDoItAll.CrmHr.UI.Workforce.CrmHrWorkforceWorkspacePresentation
@page "/crm-hr/workforce"
@implements IAsyncDisposable
@using CanDoItAll.Editing
@using CanDoItAll.Infrastructure.Editing
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Modules.Projects
@using Microsoft.Extensions.Logging
@using CanDoItAll.SharedKernel
@using CanDoItAll.CrmHr.UI.Parties
@inject ILogger<PartyDirectoryEditor> DeliveryLogger
@inject HrService HrService
@inject IWorkforceProfileEditing WorkforceProfiles
@inject CrmHrChanges Changes
@inject EditingChangeFeed EditingFeed
@inject IEditingUiAccess EditingAccess
@inject ILogger<EditingObservation> ObservationLogger
@inject ILogger<WorkforceProfileSession> ProfileLogger
@inject PartyDirectoryService PartyDirectoryService
@inject IPartyOrganizationAffiliationService AffiliationService
@inject NavigationManager Navigation
@inject IAppNavigationHistory History
@inject NotificationService NotificationService
@inject ILogger<CrmHrWorkforcePage> Logger

<PageTitle>CRM / HR Workforce</PageTitle>

<CrmHrEditorLeaveGuard @ref="workforceLeaveGuard" TestIdPrefix="crmhr-workforce" HasLocalChanges="HasWorkforceChanges" IsSameEditorRoute="IsSameWorkforceRoute"
            Opening="profileEditing.State.Opening" InputRevision="@(workforceInputRevision + profileEditing.State.InputRevision)" HasInput="HasWorkforceChanges()" IsBusy="@(() => WorkforceWriteInFlight)" Unknown="AnyWorkforceOutcomeUnknown" />


<CrmHrLiveCatalog Owner="EditingOwner.CrmWorkforceProfile" Ignore="profileEditing.IsOwn" Changed="@(() => profileCatalogRefreshVersion++)">
<AgentChatContextSurfaceProvider Surface="@AgentChatSurface"
                                 ContextNavigationIdentity="@AgentChatNavigationFence"
                                 ContextAccessState="@agentChatContextAccessState" />

<CrmHrWorkforceWorkspaceSurface View="this" CatalogRefreshVersion="profileCatalogRefreshVersion" ProfileSaveDisabled="@(!profileEditing.State.CanSave || profileEditing.Reading || WorkforceMutationInFlight || AnyWorkforceOutcomeUnknown)"
    ProfileInputChanged="ProfileInputChanged" ProfilePickerChanged="ProfilePickerChanged"
    SkillSelected="SelectSkillAsync" SkillInputChanged="SkillInputAsync" DefinitionInputChanged="DefinitionInputAsync" CapacityInputChanged="CapacityInputAsync"
    RecordWritesDisabled="@(WorkforceMutationInFlight || AnyWorkforceOutcomeUnknown)" SkillSaveDisabled="@(!recordDrafts.CanSaveSkill)"
    DefinitionSaveDisabled="@(!recordDrafts.Definition.CanSave)" CapacitySaveDisabled="@(!recordDrafts.Capacity.CanSave)"
    DeliveryInputChanged="DeliveryInputAsync" DeliverySaveDisabled="@(deliveryEditing?.State.IsUnknown == true || deliveryEditing?.State.IsOutdated == true || deliveryEditing?.ReadingReview == true || deliveryEditing?.State.Review is not null)">
    <DeliveryEditing>
        @if (deliveryEditing is { } current) {
            <CrmHrEditorLeaveGuard @ref="deliveryLeaveGuard" TestIdPrefix="crmhr-delivery-unit" ObserveNavigation="false" HasLocalChanges="HasDeliveryChanges" IsSameEditorRoute="@(_ => false)"
                Opening="deliveryUnitDialogGeneration" InputRevision="workforceInputRevision" HasInput="HasDeliveryChanges()" IsBusy="@(() => isDeliveryUnitSaving)" Unknown="current.State.IsUnknown" />
            <PartyEditingStatus State="current.State" Message="@current.Message" ReadingReview="current.ReadingReview" ReviewRequested="current.ReviewAsync" UndoRequested="UndoDeliveryMerge" />
            <PartyReviewDialog State="current.State" ReadingReview="current.ReadingReview" Changed="ProfileReviewChanged" Cancelled="current.CancelReview" RefreshRequested="current.ReviewAsync" ApplyRequested="ApplyDeliveryReview" />
        }
    </DeliveryEditing>
    <RecordUpdates>
        @if (contextOutdated || recordsOutdated || catalogOutdated || RecordMessage is not null || AnyWorkforceOutcomeUnknown) {
            <Alert AlertStyle="AlertStyle.Warning" data-testid="crmhr-workforce-record-updates">
                <TextBlock Value="@(AnyWorkforceOutcomeUnknown ? "A workforce command has an unknown outcome. Submitted values and later input are retained; repeating writes is blocked." : contextOutdated || recordsOutdated || catalogOutdated ? "Workforce information changed. Refresh the saved rows and context; your drafts will remain." : RecordMessage)" />
                <Button Text="Refresh saved information" Tone="ButtonTone.Default" Disabled="WorkforceMutationInFlight" Click="RefreshWorkforceContextAsync" data-testid="crmhr-workforce-refresh-records" />
            </Alert>
        }
    </RecordUpdates>
    <SkillEditing>
        <WorkforceSkillEditing State="recordDrafts" Reading="WorkforceMutationInFlight" ReviewRequested="ReviewSkillAsync" ApplyRequested="ApplySkillAsync"
            UndoRequested="UndoSkillAsync" Cancelled="recordDrafts.CancelSkillReview" Changed="ProfileReviewChanged" />
    </SkillEditing>
    <ProfileEditing>
        <WorkforceProfileEditing State="profileEditing.State" Message="@profileEditing.Message" Attention="profileEditing.RequiresAttention" Reading="profileEditing.Reading"
            PartyName="profileEditing.PartyName" ReviewRequested="profileEditing.ReviewAsync" ApplyRequested="profileEditing.ApplyReviewAsync"
            UndoRequested="profileEditing.UndoAsync" Cancelled="CancelProfileReview" Changed="ProfileReviewChanged" />

    </ProfileEditing>
    <SecondaryNavigation>
        <CrmHrSecondaryTabs SelectedArea="CrmHrWorkspaceArea.Workforce" />
    </SecondaryNavigation>
    <ActivityTimeline>
        <InteractionTimeline Presentation="@WorkforceHistoryPresentation"
                             PageRequested="HandleHistoryPageRequestedAsync"
                             DataTestId="crmhr-workforce-history"
                             Eyebrow="Workforce history"
                             Title="Recent staffing, lifecycle, and audit activity"
                             Description="Workforce profile saves, archive/reactivate events, recruiting transitions, and related CRM-HR changes stay visible here for the selected party."
                             EmptyEyebrow="No workforce history"
                             EmptyTitle="No saved history for this record"
                             EmptyDescription="Save a workforce profile or related CRM-HR workflow to build the shared audit trail." />
    </ActivityTimeline>
</CrmHrWorkforceWorkspaceSurface>
</CrmHrLiveCatalog>

@code {
    // What the history lane accepted for the selected record, and its failure copy; the surface never sees the session.
    private CrmHrActivityPresentation WorkforceHistoryPresentation => workforceHistory.Presentation;

    private string? WorkforceHistoryFailureMessage => workforceHistory.FailureMessage;

    // Triggers only: the binding reads the complete location, so these values are never parsed here.
    [SupplyParameterFromQuery(Name = WorkforceUrlCodec.PartyKey)]
    public string? PartyIdQuery { get; set; }

    [SupplyParameterFromQuery(Name = WorkforceUrlCodec.SectionKey)]
    public string? SectionQuery { get; set; }

    [SupplyParameterFromQuery(Name = WorkforceUrlCodec.SearchKey)]
    public string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = WorkforceUrlCodec.KindKey)]
    public string? KindQuery { get; set; }

    [SupplyParameterFromQuery(Name = WorkforceUrlCodec.PageKey)]
    public string? PageQuery { get; set; }

    private UrlStateBinding<WorkforceUrlState> url = default!;
    private PartyDirectoryEditor? deliveryEditing;
    private PartyEditorViewModel deliveryUnitEditor => deliveryEditing?.Draft ?? emptyDeliveryDraft;
    private readonly PartyEditorViewModel emptyDeliveryDraft = new();
    private CrmHrEditorLeaveGuard? deliveryLeaveGuard;
    private readonly WorkforceRecordDrafts recordDrafts = new();
    private SkillDefinitionEditorModel skillDefinitionEditor => recordDrafts.Definition.Draft;
    private CrmHrActivityHistorySession workforceHistory = default!;
    private long workforceHistoryGeneration;
    private WorkforceProfileWorkspaceModel? selectedWorkspace;
    private IReadOnlyList<PartyOrganizationAffiliationListItemModel> selectedAffiliations = [];
    private WorkforceRecordClassification selectedClassification =
        WorkforceRecordClassification.ExternalContact;
    private WorkforceCapacityWorkspaceModel? capacityWorkspace;
    private Task<WorkforceCapacityWorkspaceModel?>? capacityWorkspaceLoadTask;
    private Guid? capacityWorkspaceLoadPartyId;
    private long capacityWorkspaceLoadWorkforceGeneration;
    private WorkforceProfileSession profileEditing = default!;
    private WorkforceProfileEditorModel profileEditor => profileEditing.State.Draft;
    private CrmHrEditorLeaveGuard? workforceLeaveGuard;
    private long workforceInputRevision;
    private long recordsRevision;
    private long catalogRevision;
    private long profileCatalogRefreshVersion;
    private bool recordsOutdated;
    private bool catalogOutdated;
    private PartySkillEditorModel skillEditor => recordDrafts.Skill.Draft;
    private CapacityBlockEditorModel capacityBlockEditor => recordDrafts.Capacity.Draft;
    private PartySkillObservation? unknownSkillDelete;
    private CapacityBlockObservation? unknownCapacityDelete;
    private string? recordOutcome;
    private long recordOutcomeRevision;
    private string? RecordMessage {
        get => recordOutcome;
        set {
            recordOutcomeRevision++;
            recordOutcome = value;
        }
    }
    private bool contextOutdated;
    private long contextRevision;
    private string capacityWorkspaceError = string.Empty;
    private AgentChatContextAccessState agentChatContextAccessState = AgentChatContextAccessState.Loading;
    private long workforceLoadGeneration;
    private readonly CrmHrMutationGate mutationGate = new();
    private long deliveryUnitDialogGeneration;
    private int workforceBrowserVersion;
    private bool isCapacityWorkspaceLoading;
    private bool capacityNeedsRefresh;
    private bool isRecordDialogOpen;
    private bool isProfileCreationRequested;
    private bool isDeliveryUnitDialogOpen;
    private bool isDeliveryUnitSaving;
    private bool isDisposed;

    private AgentChatContextSurface AgentChatSurface => selectedWorkspace is { } workspace &&
                                                         (url.State.PartyId is not { } routePartyId || routePartyId == workspace.PartyId)
        ? CrmHrAgentChatSurfaceBuilder.BuildWorkforceSurface(
            workspace.PartyId,
            workspace.DisplayName,
            workspace.LifecycleStatus,
            workspace.Profile.Id.HasValue ? SelectedAvailabilityState : null,
            hasWorkforceProfile: workspace.Profile.Id.HasValue,
            availabilityLoaded: HasSelectedAvailabilityDetails)
        : CrmHrAgentChatSurfaceBuilder.BuildWorkforceSurface();

    private AgentChatNavigationIdentity AgentChatNavigationFence
        => CrmHrNavigationFence.Create(Navigation, url);

    // The record section is navigation state: the tab index is only its rendering.
    private int SelectedDetailTabIndex => (int)url.State.Section;

    private PagedRecordQueryState<WorkforceRecordViewFilter> CatalogQuery => url.State.Catalog.ToQuery();

    private WorkforceAvailabilityState? SelectedAvailabilityState
        => capacityWorkspace?.CapacitySummary.AvailabilityState;

    private bool HasSelectedAvailabilityDetails
        => capacityWorkspace is not null;

    private decimal? SelectedAvailablePercent
        => capacityWorkspace?.CapacitySummary.AvailablePercent;

    private DateOnly? SelectedNextAvailabilityOn
        => capacityWorkspace?.CapacitySummary.NextAvailabilityOn;

    private string SelectedAvailabilityMessage
        => SelectedIsExternalContactWithoutProfile
            ? "No staffable profile. Capacity and availability are not inferred for an external contact."
            : capacityWorkspace?.CapacitySummary.AvailabilityMessage
           ?? "Capacity details are available from the Allocations tab.";

    private bool SelectedIsExternalContactWithoutProfile
        => selectedWorkspace is { PartyType: PartyType.Person } workspace &&
           !workspace.Profile.Id.HasValue &&
           selectedClassification == WorkforceRecordClassification.ExternalContact;

    private string SelectedClassificationLabel
        => WorkforceRecordPresentation.ResolveClassificationLabel(selectedClassification);

    private string SelectedClassificationTone
        => WorkforceRecordPresentation.ResolveClassificationTone(selectedClassification);

    private string AllocationBadgeText
        => capacityWorkspace?.ProjectAllocations.Count.ToString() ?? string.Empty;

    private IReadOnlyList<WorkforceKind> AvailableWorkforceKinds
        => selectedWorkspace is null
            ? Enum.GetValues<WorkforceKind>()
            : selectedWorkspace.PartyType == PartyType.Person
                ? [WorkforceKind.Employee, WorkforceKind.Contractor, WorkforceKind.Freelancer]
                : [WorkforceKind.DeliveryUnit];

    protected override void OnInitialized()
    {
        profileEditing = new(WorkforceProfiles, Changes, EditingFeed, EditingAccess, ObservationLogger, ProfileLogger) {
            Dispatch = work => InvokeAsync(work), Changed = ProfileStateChanged,
            Retired = () => {
                Interlocked.Increment(ref workforceLoadGeneration);
                isRecordDialogOpen = false;
                ClearWorkforceSelection();
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
            },
            ContextChanged = () => {
                contextRevision++;
                contextOutdated = true;
            },
            RecordsChanged = () => {
                recordsRevision++;
                recordsOutdated = true;
                recordDrafts.HintSkills();
            },
            CatalogChanged = () => {
                catalogRevision++;
                catalogOutdated = true;
            },
            Notice = () => NotificationService.Warning("Workforce profile requires attention", profileEditing.Message ?? "Review the current workforce profile.")
        };
        url = new UrlStateBinding<WorkforceUrlState>(Navigation, WorkforceUrlCodec.Instance, History, typeof(CrmHrWorkforcePage));
        workforceHistory = new CrmHrActivityHistorySession(
            (query, cancellationToken) => PartyDirectoryService.SearchPartyActivityAsync(query, cancellationToken),
            initialFailureMessage: "Workforce history could not be loaded.",
            pageFailureMessage: "The requested workforce history page could not be loaded.",
            Logger);
    }

    // Every location reaches the same instance: a pasted link, Back, Forward and this page's own intents arriving.
    // Another record loads it; another section of the same record loads only that section's lazy data; a catalog
    // query belongs to the catalog, which loads it itself.
    protected override async Task OnParametersSetAsync()
    {
        var change = url.Apply(canonicalize: RendererInfo.IsInteractive);
        if (!change.IsChanged)
        {
            return;
        }

        if (change.IsInitial || change.Previous.PartyId != change.Current.PartyId)
        {
            await OpenRouteRecordAsync(change.Current);
            return;
        }

        if (change.Previous.Section != change.Current.Section && isRecordDialogOpen)
        {
            await EnsureSectionDataLoadedAsync();
        }
    }

    private async Task OpenRouteRecordAsync(WorkforceUrlState route)
    {
        var requestedPartyId = route.PartyId;
        if (requestedPartyId != selectedWorkspace?.PartyId)
        {
            isRecordDialogOpen = false;
        }

        var request = BeginWorkforceLoad(
            requestedPartyId,
            WorkforceLoadBinding.RouteBound,
            expectedSelectedPartyId: null);
        var outcome = await LoadAndCommitWorkforceAsync(request);
        if (outcome == WorkforceLoadOutcome.Stale)
        {
            return;
        }

        agentChatContextAccessState = outcome == WorkforceLoadOutcome.Ready
            ? AgentChatContextAccessState.Ready
            : AgentChatContextAccessState.Failed;
        isRecordDialogOpen = outcome == WorkforceLoadOutcome.Ready &&
                             requestedPartyId.HasValue &&
                             selectedWorkspace is not null;
        if (outcome == WorkforceLoadOutcome.Missing)
        {
            // The requested identity stays in the location and no other record takes its place.
            NotificationService.Warning(
                "Workforce record unavailable",
                "The requested workforce record does not exist or is no longer available.");
            return;
        }

        if (isRecordDialogOpen)
        {
            await EnsureSectionDataLoadedAsync();
        }
    }

    // The lazy data of the open record's section.
    private Task EnsureSectionDataLoadedAsync()
        => url.State.Section switch
        {
            WorkforceSection.Allocations => EnsureCapacityWorkspaceLoadedAsync(),
            WorkforceSection.History => EnsureHistoryLoadedAsync(),
            _ => Task.CompletedTask
        };

    private WorkforceLoadRequest BeginWorkforceLoad(
        Guid? requestedPartyId,
        WorkforceLoadBinding binding,
        Guid? expectedSelectedPartyId)
    {
        agentChatContextAccessState = AgentChatContextAccessState.Loading;
        return new WorkforceLoadRequest(
            Interlocked.Increment(ref workforceLoadGeneration),
            requestedPartyId,
            url.State.PartyId,
            expectedSelectedPartyId,
            binding);
    }

    private async Task<WorkforceLoadOutcome> LoadAndCommitWorkforceAsync(
        WorkforceLoadRequest request, bool refreshDraft = false)
    {
        try
        {
            var snapshot = await LoadWorkforceSnapshotAsync(request.RequestedPartyId);
            if (!IsCurrentWorkforceLoad(request))
            {
                return WorkforceLoadOutcome.Stale;
            }

            CommitWorkforceSnapshot(snapshot, refreshDraft);
            return snapshot.RequestedPartyFound
                ? WorkforceLoadOutcome.Ready
                : WorkforceLoadOutcome.Missing;
        }
        catch when (!IsCurrentWorkforceLoad(request))
        {
            return WorkforceLoadOutcome.Stale;
        }
        catch
        {
            agentChatContextAccessState = AgentChatContextAccessState.Failed;
            throw;
        }
    }

    private async Task<WorkforceLoadSnapshot> LoadWorkforceSnapshotAsync(Guid? requestedPartyId)
    {
        if (!requestedPartyId.HasValue)
        {
            await profileEditing.CloseAsync();
            return WorkforceLoadSnapshot.Empty(requestedPartyFound: true);
        }

        var observedRecords = recordsRevision;
        var observedCatalog = catalogRevision;
        var observedContext = contextRevision;
        var profileRead = await profileEditing.ReadWorkspaceAsync(requestedPartyId.Value, default);
        var workspace = profileRead.Workspace;
        if (workspace is null)
        {
            return WorkforceLoadSnapshot.Empty(requestedPartyFound: false);
        }

        var affiliations = workspace.PartyType == PartyType.Person
            ? await AffiliationService.ListAsync(workspace.PartyId)
            : [];
        return new WorkforceLoadSnapshot(
            workspace,
            affiliations,
            RequestedPartyFound: true) { ProfileRead = profileRead, RecordsRevision = observedRecords, CatalogRevision = observedCatalog, ContextRevision = observedContext };
    }

    private void CommitWorkforceSnapshot(WorkforceLoadSnapshot snapshot, bool refreshDraft)
    {
        if (snapshot.Workspace is null)
        {
            ClearWorkforceSelection();
            return;
        }

        var isPartySelectionChanged = selectedWorkspace?.PartyId != snapshot.Workspace.PartyId;
        if (isPartySelectionChanged)
        {
            InvalidateCapacityWorkspace(retire: true);
        }

        profileEditing.Observe(snapshot.ProfileRead ?? throw new InvalidOperationException("The workforce snapshot has no authorized profile observation."), refreshDraft);
        contextOutdated = snapshot.ContextRevision != contextRevision;
        recordsOutdated = snapshot.RecordsRevision != recordsRevision;
        catalogOutdated = snapshot.CatalogRevision != catalogRevision;
        if (selectedWorkspace?.PartyId == snapshot.Workspace.PartyId) {
            recordDrafts.ObserveSkills(snapshot.Workspace.Skills);
        }
        InvalidateHistory();
        selectedAffiliations = snapshot.Affiliations;
        ApplyLoadedWorkspace(snapshot.Workspace, isPartySelectionChanged);
    }

    private bool IsCurrentWorkforceLoad(WorkforceLoadRequest request)
        => !isDisposed &&
           request.Generation == Volatile.Read(ref workforceLoadGeneration) &&
           url.State.PartyId == request.RoutePartyId &&
           (request.Binding == WorkforceLoadBinding.RouteBound ||
            selectedWorkspace?.PartyId == request.ExpectedSelectedPartyId);

    // A reload of the record already on screen (another editor's commit, a removed skill or block, an agent refresh)
    // keeps what the operator typed into the editors it did not commit.
    private void ApplyLoadedWorkspace(
        WorkforceProfileWorkspaceModel workspace,
        bool partyChanged)
    {
        selectedWorkspace = workspace;
        selectedClassification = WorkforceRecordPresentation.ResolveSelectedClassification(
            workspace,
            selectedAffiliations);
        if (partyChanged || !profileEditing.State.IsDirty) {
            isProfileCreationRequested = false;
        }

        if (partyChanged) {
            recordDrafts.Open(workspace.PartyId);
            unknownSkillDelete = null;
            unknownCapacityDelete = null;
            RecordMessage = null;
        }

    }

    private async Task<bool> ReloadAfterActionAsync(
        WorkforceActionStamp action, bool refreshDraft = false)
    {
        if (!IsCurrentWorkforceAction(action))
        {
            return false;
        }

        var request = BeginWorkforceLoad(
            action.SelectedPartyId ?? action.RoutePartyId,
            WorkforceLoadBinding.ActionRefresh,
            action.SelectedPartyId);
        WorkforceLoadOutcome outcome;
        try
        {
            outcome = await LoadAndCommitWorkforceAsync(request, refreshDraft);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            // The owner committed. A failed read-back is a warning: it never repeats the write; the operator can
            // reload to reconcile the view.
            Logger.LogWarning(exception, "The workforce workspace could not be refreshed after a committed change.");
            NotificationService.Warning(
                "Saved, refresh failed",
                "The change was saved, but the workspace could not be refreshed. Reload the page to see the current state.");
            return false;
        }

        agentChatContextAccessState = outcome switch
        {
            WorkforceLoadOutcome.Ready => AgentChatContextAccessState.Ready,
            WorkforceLoadOutcome.Missing => AgentChatContextAccessState.Failed,
            _ => agentChatContextAccessState
        };

        if (outcome == WorkforceLoadOutcome.Ready)
        {
            InvalidateCapacityWorkspace();
            await EnsureSectionDataLoadedAsync();
        }

        return outcome == WorkforceLoadOutcome.Ready;
    }

    private WorkforceActionStamp CaptureWorkforceAction()
        => new(
            Volatile.Read(ref workforceLoadGeneration),
            url.State.PartyId,
            selectedWorkspace?.PartyId);

    private bool TryCaptureSelectedWorkforceAction(out WorkforceActionStamp action)
    {
        action = CaptureWorkforceAction();
        return action.SelectedPartyId.HasValue &&
               IsCurrentWorkforceAction(action);
    }

    private bool IsCurrentWorkforceAction(WorkforceActionStamp action)
        => !isDisposed &&
           action.Generation == Volatile.Read(ref workforceLoadGeneration) &&
           url.State.PartyId == action.RoutePartyId &&
           selectedWorkspace?.PartyId == action.SelectedPartyId;

    private void ClearWorkforceSelection()
    {
        selectedWorkspace = null;
        selectedAffiliations = [];
        selectedClassification = WorkforceRecordClassification.ExternalContact;
        isProfileCreationRequested = false;
        InvalidateCapacityWorkspace(retire: true);
        InvalidateHistory();
        // Closing the record discards its drafts: the next record, or the same one reopened, starts from the owner.
        recordDrafts.Open(Guid.Empty);
        unknownSkillDelete = null;
        unknownCapacityDelete = null;
        RecordMessage = null;
        contextOutdated = false;
        profileEditing.Clear();
        recordsOutdated = catalogOutdated = false;
    }

    // A card opens its record over the catalog as a new history entry; Back closes it again.
    private async Task SelectPartyAsync(Guid partyId)
    {
        if (url.State.PartyId == partyId && selectedWorkspace?.PartyId == partyId)
        {
            isRecordDialogOpen = true;
            return;
        }

        if (!await RequestWorkforceLeaveAsync()) {
            return;
        }
        url.OpenOverlay(url.State.WithoutRecord() with { PartyId = partyId });
        await OpenRouteRecordAsync(url.State);
    }

    private async Task CloseRecordDialogAsync()
    {
        if (!isRecordDialogOpen)
        {
            return;
        }

        if (!await RequestWorkforceLeaveAsync()) {
            return;
        }
        Interlocked.Increment(ref workforceLoadGeneration);
        isRecordDialogOpen = false;
        ClearWorkforceSelection();
        agentChatContextAccessState = AgentChatContextAccessState.Ready;
        await profileEditing.CloseAsync();
        await url.CloseOverlayAsync(url.State.WithoutRecord());
    }

    private Task HandleWorkforceBrowserLoadFailedAsync(Exception exception)
    {
        Logger.LogError(exception, "Failed to load the server-paged workforce browser.");
        NotificationService.Error(
            "Workforce directory unavailable",
            "The workforce query failed. Retry after checking the active CRM-HR data source.");
        return Task.CompletedTask;
    }

    private Task HandleHomeUnitChangedAsync(Guid? partyId)
    {
        profileEditor.HomeUnitPartyId = partyId;
        return Task.CompletedTask;
    }

    private Task HandleManagerChangedAsync(Guid? partyId)
    {
        profileEditor.ManagerPartyId = partyId;
        return Task.CompletedTask;
    }

    // A section of the open record refines its entry; it loads only the data that section shows.
    private async Task HandleDetailTabChangedAsync(int index)
    {
        var section = (WorkforceSection)index;
        if (!Enum.IsDefined(section))
        {
            throw new ArgumentOutOfRangeException(nameof(index), index, "The workforce record has no such section.");
        }

        url.Navigate(url.State with { Section = section }, UrlHistoryMode.Replace);
        await EnsureSectionDataLoadedAsync();
    }

    // The catalog committed a query and is already loading it: only the location follows.
    private Task HandleCatalogQueryChangedAsync(PagedRecordQueryChange<WorkforceRecordViewFilter> change)
    {
        url.Navigate(
            url.State with { Catalog = WorkforceUrlCodec.Catalog.FromQuery(change.Query) },
            CrmHrCatalogUrlCodec<WorkforceRecordViewFilter>.HistoryMode(change.Kind));
        return Task.CompletedTask;
    }

    private Task RequestProfileCreation()
    {
        if (!SelectedIsExternalContactWithoutProfile)
        {
            return Task.CompletedTask;
        }

        isProfileCreationRequested = true;
        url.Navigate(url.State with { Section = WorkforceSection.Profile }, UrlHistoryMode.Replace);
        return Task.CompletedTask;
    }

    // The workforce history lane: the session owns the read, the accepted page, the busy gate and the fencing of
    // late outcomes. A newer workforce load generation starts a fresh lane for the party, as the inline read did.
    private Task EnsureHistoryLoadedAsync()
    {
        if (selectedWorkspace is not { } workspace)
        {
            return Task.CompletedTask;
        }

        var workforceGeneration = Volatile.Read(ref workforceLoadGeneration);
        if (workforceHistoryGeneration != workforceGeneration)
        {
            workforceHistory.Invalidate();
            workforceHistoryGeneration = workforceGeneration;
        }

        return workforceHistory.EnsureLoadedAsync(workspace.PartyId);
    }

    private Task HandleHistoryPageRequestedAsync(int pageIndex)
        => selectedWorkspace is { } workspace && workforceHistory.Target == workspace.PartyId
            ? workforceHistory.RequestPageAsync(pageIndex)
            : Task.CompletedTask;

    private Task RetryHistoryAsync()
    {
        InvalidateHistory();
        return EnsureHistoryLoadedAsync();
    }

    private void InvalidateHistory()
        => workforceHistory.Invalidate();

    private async Task<WorkforceCapacityWorkspaceModel?> ReadCapacityWorkspaceAsync(Guid partyId) {
        var authorize = profileEditing.CaptureReadAdmission(partyId, WorkforceWriteArea.Records);
        await authorize(default);
        var workspace = await HrService.GetWorkforceCapacityWorkspaceAsync(partyId);
        await authorize(default);
        if (workspace is not null && workspace.PartyId != partyId) {
            throw new InvalidOperationException("The capacity read returned another workforce record.");
        }
        return workspace;
    }

    private async Task EnsureCapacityWorkspaceLoadedAsync()
    {
        if (selectedWorkspace is not { } workspace ||
            capacityWorkspace?.PartyId == workspace.PartyId && !capacityNeedsRefresh)
        {
            return;
        }

        var partyId = workspace.PartyId;
        var workforceGeneration = Volatile.Read(ref workforceLoadGeneration);
        if (capacityWorkspaceLoadTask is null ||
            capacityWorkspaceLoadPartyId != partyId ||
            capacityWorkspaceLoadWorkforceGeneration != workforceGeneration)
        {
            capacityWorkspaceLoadPartyId = partyId;
            capacityWorkspaceLoadWorkforceGeneration = workforceGeneration;
            capacityWorkspaceLoadTask = ReadCapacityWorkspaceAsync(partyId);
            isCapacityWorkspaceLoading = true;
            capacityWorkspaceError = string.Empty;
        }

        var loadTask = capacityWorkspaceLoadTask;
        workforceGeneration = capacityWorkspaceLoadWorkforceGeneration;

        try
        {
            var loadedWorkspace = await loadTask;
            if (!IsCurrentCapacityRequest(loadTask, partyId, workforceGeneration))
            {
                return;
            }

            if (loadedWorkspace is null)
            {
                capacityWorkspaceError = "The selected workforce record no longer exists.";
                return;
            }

            capacityWorkspace = loadedWorkspace;
            capacityNeedsRefresh = false;
        }
        catch (Exception exception)
        {
            if (!IsCurrentCapacityRequest(loadTask, partyId, workforceGeneration))
            {
                return;
            }

            Logger.LogError(
                exception,
                "Failed to load workforce capacity workspace for party {PartyId}.",
                partyId);
            capacityWorkspaceError = "Capacity and allocation data could not be loaded. Retry the request or inspect the application logs.";
            NotificationService.Error("Allocation workspace load failed", capacityWorkspaceError);
        }
        finally
        {
            if (IsTrackedCapacityRequest(loadTask, partyId))
            {
                capacityWorkspaceLoadTask = null;
                capacityWorkspaceLoadPartyId = null;
                capacityWorkspaceLoadWorkforceGeneration = 0;
                isCapacityWorkspaceLoading = false;
            }
        }
    }

    private bool IsCurrentCapacityRequest(
        Task<WorkforceCapacityWorkspaceModel?> loadTask,
        Guid partyId,
        long workforceGeneration)
        => !isDisposed &&
           ReferenceEquals(capacityWorkspaceLoadTask, loadTask) &&
           capacityWorkspaceLoadPartyId == partyId &&
           selectedWorkspace?.PartyId == partyId &&
           workforceGeneration == Volatile.Read(ref workforceLoadGeneration);

    private bool IsTrackedCapacityRequest(
        Task<WorkforceCapacityWorkspaceModel?> loadTask,
        Guid partyId)
        => ReferenceEquals(capacityWorkspaceLoadTask, loadTask) &&
           capacityWorkspaceLoadPartyId == partyId;


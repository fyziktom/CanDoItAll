    private async Task SaveWorkforceProfileAsync()
    {
        if (!TryCaptureSelectedWorkforceAction(out var action))
        {
            return;
        }

        var result = await HrService.SaveWorkforceProfileAsync(profileEditor);
        if (result.IsFailure)
        {
            if (IsCurrentWorkforceAction(action))
            {
                NotificationService.Error("Workforce profile save failed", string.Join(" ", result.Errors.Select(error => error.Message)));
            }

            return;
        }

        if (!await ReloadAfterActionAsync(action))
        {
            return;
        }

        NotificationService.Success("Workforce profile saved", "Workforce profile saved.");
    }


                HomeUnitName = saved.HomeUnitPartyId is null ? string.Empty : profileEditing.PartyName(saved.HomeUnitPartyId),
                ManagerName = saved.ManagerPartyId is null ? string.Empty : profileEditing.PartyName(saved.ManagerPartyId)
            };
            selectedClassification = WorkforceRecordPresentation.ResolveSelectedClassification(selectedWorkspace, selectedAffiliations);
        }
        StateHasChanged();
    }

    private bool WorkforceWriteInFlight => isDeliveryUnitSaving || profileEditing.State.IsSaving ||
        mutationGate.IsInFlight(Volatile.Read(ref workforceLoadGeneration));
    private bool WorkforceMutationInFlight => WorkforceWriteInFlight || profileEditing.Reading ||
        profileEditing.State.PickerPending || agentChatContextAccessState == AgentChatContextAccessState.Loading;

    private bool AnyWorkforceOutcomeUnknown => profileEditing.State.IsUnknown || recordDrafts.IsUnknown || unknownSkillDelete is not null || unknownCapacityDelete is not null || deliveryEditing?.State.IsUnknown == true;

    private bool HasWorkforceChanges() => profileEditing.State.IsDirty || profileEditing.State.Review is not null || recordDrafts.IsDirty || HasDeliveryChanges();

    private bool HasDeliveryChanges() => isDeliveryUnitDialogOpen && deliveryEditing is { } current && (current.State.IsDirty(current.Draft) || current.State.Review is not null);


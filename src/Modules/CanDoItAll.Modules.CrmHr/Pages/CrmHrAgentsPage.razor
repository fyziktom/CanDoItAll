@using static CanDoItAll.CrmHr.UI.Agents.CrmHrAgentsWorkspacePresentation
@page "/crm-hr/agents"
@implements IAsyncDisposable
@using CanDoItAll.Editing
@inject AiAgentService AiAgentService
@inject IAiAgentDirectoryQueryService AiAgentDirectoryQueryService
@inject NavigationManager Navigation
@inject IAppNavigationHistory History
@inject NotificationService NotificationService
@inject CrmHrChanges Changes
@inject IEditingUiAccess EditingAccess
@inject ILogger<CrmHrAgentsPage> Logger

<PageTitle>CRM Agents</PageTitle>

<CrmHrLiveCatalog Owner="EditingOwner.CrmAiStewardProfile" Changed="RefreshCatalog" Observed="ObserveAgentChanges">
<AgentChatContextSurfaceProvider Surface="@AgentChatSurface"
                                 ContextNavigationIdentity="@AgentChatNavigationFence"
                                 ContextAccessState="@agentChatContextAccessState" />

<CrmHrAgentsWorkspaceSurface View="this">
    <SecondaryNavigation>
        <CrmHrSecondaryTabs SelectedArea="CrmHrWorkspaceArea.Agents" />
    </SecondaryNavigation>
    <RecruitingEvidence Context="technicalAgentId">
        <AgentRecruitingEvidencePanel CandidateAgentId="technicalAgentId" />
    </RecruitingEvidence>
</CrmHrAgentsWorkspaceSurface>
</CrmHrLiveCatalog>

@code {
    // Triggers only: the binding reads the complete location, so these values are never parsed here.
    [SupplyParameterFromQuery(Name = CrmHrAgentsUrlCodec.PartyKey)]
    public string? PartyIdQuery { get; set; }

    [SupplyParameterFromQuery(Name = CrmHrAgentsUrlCodec.SectionKey)]
    public string? SectionQuery { get; set; }

    [SupplyParameterFromQuery(Name = CrmHrAgentsUrlCodec.SearchKey)]
    public string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = CrmHrAgentsUrlCodec.ValidationKey)]
    public string? ValidationQuery { get; set; }

    [SupplyParameterFromQuery(Name = CrmHrAgentsUrlCodec.PageKey)]
    public string? PageQuery { get; set; }

    private UrlStateBinding<CrmHrAgentsUrlState> url = default!;
    private AiAgentDirectoryPage agentPage = new(
        [],
        0,
        AiAgentDirectoryQueryLimits.DefaultPageSize,
        0);
    private IReadOnlyDictionary<Guid, AiAgentDirectoryItemModel> currentPageItems =
        new Dictionary<Guid, AiAgentDirectoryItemModel>();
    private AiAgentDirectoryItemModel? selectedDirectoryItem;
    private AiAgentWorkspaceModel? selectedWorkspace;
    private bool isListLoading = true;
    private bool isWorkspaceLoading;
    private bool isRecordDialogOpen;
    private bool isDisposed;
    private long loadGeneration;
    private long directoryLoadGeneration;
    private long catalogRefreshVersion;
    private long recordRevision;
    private bool recordOutdated;
    private CancellationTokenSource? loadCancellation;
    private AgentChatContextAccessState agentChatContextAccessState = AgentChatContextAccessState.Loading;

    private AgentChatContextSurface AgentChatSurface => selectedWorkspace is { } workspace
        ? CrmHrAgentChatSurfaceBuilder.BuildAgentsSurface(
            workspace.PartyId,
            workspace.DisplayName,
            workspace.LifecycleStatus,
            workspace.BindingStatus,
            workspace.Profile.ValidationStatus)
        : CrmHrAgentChatSurfaceBuilder.BuildAgentsSurface();

    private AgentChatNavigationIdentity AgentChatNavigationFence
        => CrmHrNavigationFence.Create(Navigation, url);

    private PagedRecordSelection<Guid>? AgentSelection => url.State.PartyId is Guid partyId
        ? new PagedRecordSelection<Guid>(partyId)
        : null;

    // The record section is navigation state; the dialog only renders it.
    private CrmHrAgentRecordSection RecordSection => url.State.Section;

    private PagedRecordQueryState<AiAgentValidationFilter> CatalogQuery => url.State.Catalog.ToQuery();

    private bool ShouldShowListLoadingState => isListLoading;

    protected override void OnInitialized()
        => url = new UrlStateBinding<CrmHrAgentsUrlState>(Navigation, CrmHrAgentsUrlCodec.Instance, History, typeof(CrmHrAgentsPage));

    // Every location reaches the same instance: a pasted link, Back, Forward and this page's own intents arriving.
    // Only another agent loads; a section and a catalog query load nothing here.
    protected override Task OnParametersSetAsync()
    {
        var change = url.Apply(canonicalize: RendererInfo.IsInteractive);
        if (!change.IsChanged || (!change.IsInitial && change.Previous.PartyId == change.Current.PartyId))
        {
            return Task.CompletedTask;
        }

        return LoadAsync(change.Current.PartyId);
    }

    private void RefreshCatalog() => catalogRefreshVersion++;

    private void ObserveAgentChanges(EditingChangeBatch batch) {
        if (isDisposed || !isRecordDialogOpen || url.State.PartyId is not Guid id) {
            return;
        }
        if (batch.RequiresResync || selectedWorkspace is null || batch.Changes.Any(change =>
                change.Resource.ResourceId == id || change.Resource.ResourceId == selectedWorkspace.Profile.OwnerPartyId)) {
            recordRevision++;
            recordOutdated = true;
            agentChatContextAccessState = AgentChatContextAccessState.Loading;
        }
    }

    private Task RefreshRecordAsync() => isWorkspaceLoading || url.State.PartyId is not Guid id
        ? Task.CompletedTask : LoadAsync(id, retainCurrent: true);

    private async Task LoadAsync(Guid? requestedPartyId, bool retainCurrent = false) {
        var expectedQueryPartyId = requestedPartyId;
        var currentGeneration = Interlocked.Increment(ref loadGeneration);
        var observedRevision = recordRevision;
        var keepCurrent = retainCurrent && requestedPartyId is Guid id && selectedWorkspace?.PartyId == id;
        var cancellation = new CancellationTokenSource();
        var supersededLoad = Interlocked.Exchange(ref loadCancellation, cancellation);
        supersededLoad?.Cancel();

        if (!keepCurrent) {
            selectedDirectoryItem = null;
            selectedWorkspace = null;
        }
        recordOutdated = keepCurrent;
        isRecordDialogOpen = requestedPartyId.HasValue;
        isWorkspaceLoading = requestedPartyId.HasValue;
        agentChatContextAccessState = requestedPartyId.HasValue
            ? AgentChatContextAccessState.Loading
            : AgentChatContextAccessState.Ready;

        if (!requestedPartyId.HasValue)
        {
            Interlocked.CompareExchange(ref loadCancellation, null, cancellation);
            cancellation.Dispose();
            return;
        }

        try
        {
            using var grant = await EditingAccess.OpenAsync(new(Changes.Scope, EditingOwner.CrmAiStewardProfile), cancellation.Token);
            using var reading = CancellationTokenSource.CreateLinkedTokenSource(cancellation.Token, grant.Lifetime);
            await EditingAccess.ValidateAsync(grant, write: false, reading.Token);
            var workspaceTask = GetAgentWorkspaceAsync(requestedPartyId.Value, reading.Token);
            var directoryItemTask = GetAgentDirectoryItemAsync(requestedPartyId.Value, reading.Token);
            await Task.WhenAll(workspaceTask, directoryItemTask);
            var loadedWorkspace = await workspaceTask;
            var loadedDirectoryItem = await directoryItemTask;
            await EditingAccess.ValidateAsync(grant, write: false, reading.Token);

            if (!IsCurrentLoad(currentGeneration, expectedQueryPartyId))
            {
                return;
            }

            if (loadedWorkspace is not null && loadedWorkspace.PartyId != requestedPartyId.Value)
            {
                throw new InvalidOperationException(
                    $"Agent workspace '{loadedWorkspace.PartyId:D}' did not match requested party '{requestedPartyId.Value:D}'.");
            }

            if (loadedDirectoryItem is not null && loadedDirectoryItem.PartyId != requestedPartyId.Value)
            {
                throw new InvalidOperationException(
                    $"Agent directory item '{loadedDirectoryItem.PartyId:D}' did not match requested party '{requestedPartyId.Value:D}'.");
            }

            if (loadedWorkspace is not null &&
                loadedDirectoryItem is not null &&
                loadedWorkspace.TechnicalAgentId != loadedDirectoryItem.Agent.Id)
            {
                throw new InvalidOperationException(
                    $"CRM-HR party '{requestedPartyId.Value:D}' resolved conflicting technical agents: " +
                    $"workspace '{loadedWorkspace.TechnicalAgentId?.ToString("D") ?? "none"}' and " +
                    $"catalog '{loadedDirectoryItem.Agent.Id:D}'.");
            }

            selectedWorkspace = loadedWorkspace;
            selectedDirectoryItem = loadedDirectoryItem;
            isRecordDialogOpen = loadedWorkspace is not null && loadedDirectoryItem is not null;
            recordOutdated = observedRevision != recordRevision;
            agentChatContextAccessState = isRecordDialogOpen
                ? recordOutdated ? AgentChatContextAccessState.Loading : AgentChatContextAccessState.Ready
                : AgentChatContextAccessState.Failed;
            if (!isRecordDialogOpen)
            {
                // The requested identity stays in the location and no other agent takes its place.
                NotificationService.Warning(
                    "Agent record unavailable",
                    "The requested CRM-HR agent record does not exist or is no longer available.");
            }
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        catch (Exception exception) {
            if (IsCurrentLoad(currentGeneration, expectedQueryPartyId)) {
                var denied = exception is UnauthorizedAccessException or OperationCanceledException;
                if (denied || !keepCurrent) {
                    selectedWorkspace = null;
                    selectedDirectoryItem = null;
                }
                isRecordDialogOpen = !denied && keepCurrent;
                recordOutdated = !denied && keepCurrent;
                agentChatContextAccessState = AgentChatContextAccessState.Failed;
                Logger.LogWarning("Agent workspace read failed for {PartyId} after {FailureType}.", requestedPartyId, exception.GetType().Name);
                NotificationService.Warning("Agent information unavailable", denied
                    ? "Current CRM access is required. Reopen this workspace with current access."
                    : "The current agent information could not be read. Refresh the saved information or reopen the record.");
            }
        }
        finally
        {
            Interlocked.CompareExchange(ref loadCancellation, null, cancellation);
            if (IsCurrentLoad(currentGeneration, expectedQueryPartyId))
            {
                isWorkspaceLoading = false;
            }

            cancellation.Dispose();
        }
    }

    protected virtual Task RefreshAgentDirectoryProjectionAsync(
        CancellationToken cancellationToken)
        => AiAgentDirectoryQueryService.RefreshProjectionAsync(cancellationToken);

    protected virtual Task<AiAgentDirectoryPage> QueryAgentDirectoryAsync(
        AiAgentDirectoryQuery query,
        CancellationToken cancellationToken)
        => AiAgentDirectoryQueryService.SearchAsync(query, cancellationToken);

    protected virtual Task<AiAgentDirectoryItemModel?> GetAgentDirectoryItemAsync(
        Guid partyId,
        CancellationToken cancellationToken)
        => AiAgentDirectoryQueryService.GetByPartyIdAsync(partyId, cancellationToken);

    protected virtual Task<AiAgentWorkspaceModel?> GetAgentWorkspaceAsync(
        Guid partyId,
        CancellationToken cancellationToken)
        => AiAgentService.GetAgentWorkspaceAsync(partyId, cancellationToken);

    private bool IsCurrentLoad(long generation, Guid? expectedQueryPartyId)
        => !isDisposed &&
           generation == Volatile.Read(ref loadGeneration) &&
           url.State.PartyId == expectedQueryPartyId;

    private async Task<PagedRecordPage<Guid>> LoadAgentPageAsync(
        PagedRecordRequest<AiAgentValidationFilter> request,
        CancellationToken cancellationToken)
    {
        var generation = Interlocked.Increment(ref directoryLoadGeneration);
        isListLoading = true;
        try
        {
            using var grant = await EditingAccess.OpenAsync(new(Changes.Scope, EditingOwner.CrmAiStewardProfile), cancellationToken);
            using var reading = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken, grant.Lifetime);
            await EditingAccess.ValidateAsync(grant, write: false, reading.Token);
            var result = await QueryAgentDirectoryAsync(
                new AiAgentDirectoryQuery(
                    request.SearchText,
                    MapValidationFilter(request.Filter),
                    request.PageIndex,
                    request.PageSize),
                reading.Token);
            await EditingAccess.ValidateAsync(grant, write: false, reading.Token);
            cancellationToken.ThrowIfCancellationRequested();
            if (generation != Volatile.Read(ref directoryLoadGeneration) || isDisposed)
            {
                throw new OperationCanceledException(cancellationToken);
            }

            agentPage = result;
            currentPageItems = result.Items.ToDictionary(item => item.PartyId);
            return new PagedRecordPage<Guid>(
                result.Items.Select(ToPagedRecordOption).ToArray(),
                result.PageIndex,
                result.PageSize,
                result.TotalCount);
        }
        finally
        {
            if (generation == Volatile.Read(ref directoryLoadGeneration))
            {
                isListLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void HandleAgentDirectoryLoadFailed(Exception _)
    {
        isListLoading = false;
        if (!url.State.PartyId.HasValue)
        {
            agentChatContextAccessState = AgentChatContextAccessState.Failed;
        }
    }

    private AiAgentDirectoryItemModel GetCurrentPageItem(Guid partyId)
        => currentPageItems.TryGetValue(partyId, out var item)
            ? item
            : throw new InvalidOperationException(
                $"The rendered CRM-HR agent page does not contain party '{partyId:D}'.");

    // A card of the rendered page opens its record over the catalog as a new history entry; Back closes it again.
    private Task SelectPartyAsync(Guid partyId)
    {
        var item = GetCurrentPageItem(partyId);
        if (url.State.PartyId == item.PartyId && isRecordDialogOpen)
        {
            return Task.CompletedTask;
        }

        url.OpenOverlay(url.State.WithoutRecord() with { PartyId = item.PartyId });
        return LoadAsync(item.PartyId);
    }

    // A section of the open record refines its entry.
    private Task SelectRecordSectionAsync(CrmHrAgentRecordSection section)
    {
        url.Navigate(url.State with { Section = section }, UrlHistoryMode.Replace);
        return Task.CompletedTask;
    }

    // The catalog committed a query and is already loading it: only the location follows.
    private Task HandleCatalogQueryChangedAsync(PagedRecordQueryChange<AiAgentValidationFilter> change)
    {
        url.Navigate(
            url.State with { Catalog = CrmHrAgentsUrlCodec.Catalog.FromQuery(change.Query) },
            CrmHrCatalogUrlCodec<AiAgentValidationFilter>.HistoryMode(change.Kind));
        return Task.CompletedTask;
    }

    // Closing returns to the catalog: Back when the record was opened here, otherwise the location is replaced.
    private async Task CloseRecordDialogAsync()
    {
        if (!isRecordDialogOpen)
        {
            return;
        }

        await LoadAsync(null);
        await url.CloseOverlayAsync(url.State.WithoutRecord());
    }

    // The AgentFramework catalog keeps its own location keys; its published routes are used as they are.
    private void OpenTechnicalCatalog()
    {
        Navigation.NavigateTo("/agents?tab=agents");
    }

    private void OpenTechnicalRecord()
    {
        if (selectedWorkspace is null)
        {
            OpenTechnicalCatalog();
            return;
        }

        Navigation.NavigateTo(selectedWorkspace.AgentsRoute);
    }

    private void OpenDirectoryRecord()
    {
        var directory = DirectoryUrlCodec.Default with { PartyId = selectedWorkspace?.PartyId };
        Navigation.NavigateTo(DirectoryUrlCodec.Instance.Href(CrmHrRouteCatalog.Get(CrmHrWorkspaceArea.Directory).Route, directory));
    }

    private static AiValidationStatus? MapValidationFilter(AiAgentValidationFilter filter)
        => filter switch
        {
            AiAgentValidationFilter.All => null,
            AiAgentValidationFilter.Draft => AiValidationStatus.Draft,
            AiAgentValidationFilter.ReviewRequired => AiValidationStatus.ReviewRequired,
            AiAgentValidationFilter.Approved => AiValidationStatus.Approved,
            AiAgentValidationFilter.Suspended => AiValidationStatus.Suspended,
            _ => throw new ArgumentOutOfRangeException(
                nameof(filter),
                filter,
                "Validation filter is not supported.")
        };

    private static PagedRecordOption<Guid> ToPagedRecordOption(AiAgentDirectoryItemModel item)
        => new(item.PartyId, item.Agent.Name, "AI agent")
        {
            Subtitle = item.Agent.RoleTitle,
            Description = item.Agent.Summary,
            TestId = "crmhr-agent-item"
        };

    public ValueTask DisposeAsync()
    {
        isDisposed = true;
        Interlocked.Increment(ref loadGeneration);
        Interlocked.Increment(ref directoryLoadGeneration);
        var cancellation = Interlocked.Exchange(ref loadCancellation, null);
        cancellation?.Cancel();
        cancellation?.Dispose();
        return ValueTask.CompletedTask;
    }
}

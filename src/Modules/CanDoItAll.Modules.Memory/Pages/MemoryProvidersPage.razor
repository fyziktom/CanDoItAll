    private static void RenderCapabilities(
        RenderTreeBuilder builder,
        int sequence,
        IReadOnlyList<MemoryCapabilityDescriptor> capabilities)
    {
        if (capabilities.Count == 0)
        {
            builder.OpenElement(sequence, "p");
            builder.AddAttribute(sequence + 1, "class", "memory-ui-muted");
            builder.AddContent(sequence + 2, "No capabilities declared.");
            builder.CloseElement();
            return;
        }

        builder.OpenElement(sequence, "div");
        builder.AddAttribute(sequence + 1, "class", "memory-ui-capabilities");
        var localSequence = sequence + 2;
        foreach (var capability in capabilities.OrderBy(item => item.Id.Value, StringComparer.Ordinal))
        {
            builder.OpenElement(localSequence++, "span");
            builder.AddAttribute(localSequence++, "class", capability.Supported ? "memory-ui-chip" : "memory-ui-chip memory-ui-chip--disabled");
            builder.AddContent(localSequence++, capability.Id.Value);
            builder.CloseElement();
        }

        builder.CloseElement();
    }


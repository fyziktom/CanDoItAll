        builder.CloseElement();
        builder.CloseElement();
    }

    private bool CanRunQuery(MemoryProviderManagementProfile? selectedProvider)
    {
        if (selectedProvider is null ||
            !selectedProvider.IsEnabled ||
            selectedProvider.HealthState != MemoryProviderHealthState.Healthy)
        {
            return false;
        }

        var requiredCapability = queryEditor.UseAsyncQuery
            ? MemoryCapabilityIds.ContextQueryAsync
            : MemoryCapabilityIds.ContextQuerySync;
        return selectedProvider.Capabilities.Any(capability =>
            capability.Supported &&
            capability.Id == requiredCapability);
    }

    private static bool CanRunManualIngestion(MemoryProviderManagementProfile? selectedProvider)
    {
        return selectedProvider is not null &&
            selectedProvider.IsEnabled &&
            selectedProvider.HealthState == MemoryProviderHealthState.Healthy &&
            selectedProvider.Capabilities.Any(capability =>
                capability.Supported &&
                capability.Id == MemoryCapabilityIds.IngestionSnapshot);
    }

    private static bool CanManageOperationStatus(MemoryProviderManagementProfile? selectedProvider)
    {
        return selectedProvider is not null &&
            selectedProvider.IsEnabled &&
            selectedProvider.HealthState == MemoryProviderHealthState.Healthy &&
            selectedProvider.Capabilities.Any(capability =>
                capability.Supported &&
                capability.Id == MemoryCapabilityIds.OperationStatus);
    }

    private static string QueryDiagnostic(MemoryProviderManagementProfile? selectedProvider)
    {
        if (selectedProvider is null)
        {
            return "No provider is selected. Provider-backed actions are disabled.";
        }

        if (!selectedProvider.IsEnabled)
        {
            return "Selected provider is disabled.";
        }

        if (selectedProvider.HealthState != MemoryProviderHealthState.Healthy)
        {
            return "Selected provider health is not healthy.";
        }

        return selectedProvider.CanRunProviderBackedActions
            ? $"Selected provider: {selectedProvider.DisplayName}."
            : "Selected provider does not declare query capability.";
    }

    private static string ManualIngestionDiagnostic(MemoryProviderManagementProfile? selectedProvider)
    {
        if (selectedProvider is null)
        {
            return "No provider is selected. Manual ingestion is disabled.";
        }

        if (!selectedProvider.IsEnabled)
        {
            return "Selected provider is disabled.";
        }

        if (selectedProvider.HealthState != MemoryProviderHealthState.Healthy)
        {
            return "Selected provider health is not healthy.";
        }

        return CanRunManualIngestion(selectedProvider)
            ? $"Selected provider: {selectedProvider.DisplayName}."
            : "Selected provider does not declare snapshot ingestion capability.";
    }

    private static string HealthTone(MemoryProviderHealthState healthState) => healthState switch
    {
        MemoryProviderHealthState.Healthy => "success",
        MemoryProviderHealthState.Degraded => "warning",
        MemoryProviderHealthState.Unreachable => "danger",
        _ => "neutral"
    };

    private static string HandlerTone(MemoryOperationHandlerStatus status) => status switch
    {
        MemoryOperationHandlerStatus.Completed => "success",
        MemoryOperationHandlerStatus.Accepted => "info",
        MemoryOperationHandlerStatus.Cancelled => "neutral",
        MemoryOperationHandlerStatus.NoProviderConfigured or
            MemoryOperationHandlerStatus.NoEnabledProvider or
            MemoryOperationHandlerStatus.ProviderDisabled or
            MemoryOperationHandlerStatus.ProviderNotFound or
            MemoryOperationHandlerStatus.CapabilityUnavailable or
            MemoryOperationHandlerStatus.CapabilityDenied or
            MemoryOperationHandlerStatus.CapabilityMismatch or
            MemoryOperationHandlerStatus.UnsupportedOperation => "warning",
        _ => "danger"
    };

    private static string SummaryValue(int? value) => value?.ToString() ?? "-";

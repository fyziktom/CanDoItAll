    private void RenderEnumSelect<TEnum>(
        RenderTreeBuilder builder,
        int sequence,
        string label,
        TEnum value,
        Action<TEnum> update,
        string testId)
        where TEnum : struct, Enum
    {
        builder.OpenElement(sequence, "label");
        builder.AddAttribute(sequence + 1, "class", "memory-ui-field");
        builder.OpenElement(sequence + 2, "span");
        builder.AddContent(sequence + 3, label);
        builder.CloseElement();
        builder.OpenElement(sequence + 4, "select");
        builder.AddAttribute(sequence + 5, "class", "cda-input");
        builder.AddAttribute(sequence + 6, "value", value.ToString());
        builder.AddAttribute(sequence + 7, "data-testid", testId);
        builder.AddAttribute(sequence + 8, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, args =>
        {
            var text = args.Value?.ToString();
            if (Enum.TryParse<TEnum>(text, ignoreCase: false, out var parsed))
            {
                update(parsed);
            }
        }));
        var optionSequence = sequence + 9;
        foreach (var option in Enum.GetValues<TEnum>())
        {
            builder.OpenElement(optionSequence++, "option");
            builder.AddAttribute(optionSequence++, "value", option.ToString());
            builder.AddContent(optionSequence++, option.ToString());
            builder.CloseElement();
        }

        builder.CloseElement();
        builder.CloseElement();
    }


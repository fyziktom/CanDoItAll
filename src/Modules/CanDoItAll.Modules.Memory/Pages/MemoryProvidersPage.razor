    private void RenderContextPack(RenderTreeBuilder builder, int sequence, MemoryContextPack contextPack)
    {
        builder.OpenElement(sequence, "section");
        builder.AddAttribute(sequence + 1, "class", "memory-ui-context-pack");
        builder.AddAttribute(sequence + 2, "data-testid", "memory-ui-context-pack");
        builder.OpenElement(sequence + 3, "h3");
        builder.AddContent(sequence + 4, contextPack.Summary);
        builder.CloseElement();
        builder.OpenElement(sequence + 5, "div");
        builder.AddAttribute(sequence + 6, "class", "memory-ui-facts");
        RenderFact(builder, sequence + 7, "Context pack", contextPack.ContextPackId.Value.ToString("D"));
        RenderFact(builder, sequence + 15, "Confidence", contextPack.ProviderConfidence.ToString("P0"));
        if (contextPack.FeedbackHandle is not null)
        {
            RenderFact(builder, sequence + 23, "Feedback handle", contextPack.FeedbackHandle.Value.ToString());
        }
        builder.CloseElement();

        builder.OpenElement(sequence + 40, "div");
        builder.AddAttribute(sequence + 41, "class", "memory-ui-ledger-list");
        var localSequence = sequence + 42;
        foreach (var section in contextPack.Sections)
        {
            builder.OpenElement(localSequence++, "article");
            builder.AddAttribute(localSequence++, "class", "memory-ui-ledger-row");
            builder.OpenElement(localSequence++, "strong");
            builder.AddContent(localSequence++, section.Title);
            builder.CloseElement();
            builder.OpenElement(localSequence++, "p");
            builder.AddAttribute(localSequence++, "class", "memory-ui-muted");
            builder.AddContent(localSequence++, section.Text);
            builder.CloseElement();
            if (section.Citations.Count > 0)
            {
                builder.OpenElement(localSequence++, "div");
                builder.AddAttribute(localSequence++, "class", "memory-ui-capabilities");
                foreach (var citation in section.Citations)
                {
                    builder.OpenElement(localSequence++, "span");
                    builder.AddAttribute(localSequence++, "class", "memory-ui-chip");
                    builder.AddContent(localSequence++, $"{citation.Label} / {citation.SourceRef}");
                    builder.CloseElement();
                }

                builder.CloseElement();
            }

            builder.CloseElement();
        }

        builder.CloseElement();
        builder.CloseElement();
    }


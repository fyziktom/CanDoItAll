@page "/memory"
@namespace CanDoItAll.Modules.Memory.Pages
@inject IMemoryProviderManagementUiService ProviderUiService

<PageTitle>Memory</PageTitle>

<PageScaffold MaxWidthClass="max-w-full" data-testid="memory-ui-page">
    <Header>
        <PageHeader Eyebrow="Memory"
                    Title="Provider management"
                    Description="Generic provider profiles, capability manifests, health, and safe provider selection.">
            <Actions>
                <Button Icon="refresh"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Class="cda-button--quick"
                        title="Refresh memory providers"
                        aria-label="Refresh memory providers"
                        Click="RefreshAsync"
                        Disabled="@isBusy"
                        IsBusy="@isBusy"
                        data-testid="memory-ui-refresh" />
            </Actions>
        </PageHeader>
    </Header>

    <Lead>
        <Cluster Gap="LayoutGap.Small"
                 Wrap="FlexWrap.Wrap"
                 Class="memory-ui-summary"
                 data-testid="memory-ui-summary">
            <SummaryTile Label="Providers"
                         Value="@SummaryValue(snapshot?.ProviderCount)"
                         HelperText="Registered generic memory provider profiles."
                         Tone="info"
                         Badge="true"
                         Compact="true"
                         ShowHelperTextAsTooltip="true" />
            <SummaryTile Label="Enabled"
                         Value="@SummaryValue(snapshot?.EnabledProviderCount)"
                         HelperText="Provider profiles enabled for selection."
                         Tone="success"
                         Badge="true"
                         Compact="true"
                         ShowHelperTextAsTooltip="true" />
            <SummaryTile Label="Healthy"
                         Value="@SummaryValue(snapshot?.HealthyProviderCount)"
                         HelperText="Provider profiles reporting healthy status."
                         Tone="@(snapshot?.HealthyProviderCount > 0 ? "success" : "secondary")"
                         Badge="true"
                         Compact="true"
                         ShowHelperTextAsTooltip="true" />
            <SummaryTile Label="Provider UI"
                         Value="@SummaryValue(snapshot?.UiSurfaceCount)"
                         HelperText="Optional provider-specific UI surfaces declared by provider manifests."
                         Tone="secondary"
                         Badge="true"
                         Compact="true"
                         ShowHelperTextAsTooltip="true" />
        </Cluster>
    </Lead>

    <ChildContent>
        <div class="memory-ui-root">
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <SurfaceCard Soft="true" data-testid="memory-ui-error">
                    <TextBlock TextStyle="TextStyle.Eyebrow" Value="Action required" />
                    <h2 class="memory-ui-card-title">Memory provider action failed</h2>
                    <p class="memory-ui-muted">@errorMessage</p>
                </SurfaceCard>
            }

            @if (isLoading)
            {
                <SurfaceCard data-testid="memory-ui-loading">
                    <TextBlock TextStyle="TextStyle.Eyebrow" Value="Loading" />
                    <h2 class="memory-ui-card-title">Loading memory providers</h2>
                    <p class="memory-ui-muted">Reading generic provider profiles and manifest status.</p>
                </SurfaceCard>
            }
            else if (snapshot is null)
            {
                <EmptyState Eyebrow="Unavailable"
                            Title="Memory provider state is unavailable"
                            Description="Refresh after the runtime database is ready." />
            }
            else
            {
                <Tabs @key="TabsRenderKey"
                      @bind-SelectedIndex="activeTabIndex"
                      RenderMode="TabRenderMode.Server"
                      Variant="TabsVariant.WorkspacePrimary"
                      OverflowMode="TabsOverflowMode.Wrap"
                      AriaLabel="Memory provider tabs"
                      data-testid="memory-ui-tabs">
                    <TabsItem Text="Providers"
                              Icon="memory"
                              BadgeText="@snapshot.ProviderCount.ToString()"
                              data-testid="memory-ui-tab-providers">
                        @ProvidersTab()
                    </TabsItem>
                <TabsItem Text="Operations"
                          Icon="route"
                          data-testid="memory-ui-tab-operations">
                    @OperationsTab()
                </TabsItem>
                <TabsItem Text="Events"
                          Icon="event"
                          data-testid="memory-ui-tab-events">
                    @EventsTab()
                </TabsItem>
                <TabsItem Text="Feedback"
                          Icon="rate_review"
                          data-testid="memory-ui-tab-feedback">
                    @FeedbackTab()
                </TabsItem>
                    <TabsItem Text="Query"
                              Icon="travel_explore"
                              data-testid="memory-ui-tab-query">
                        @QueryTab()
                    </TabsItem>
                    <TabsItem Text="Ingestion"
                              Icon="upload_file"
                              data-testid="memory-ui-tab-ingestion">
                        @IngestionTab()
                    </TabsItem>
                    <TabsItem Text="Provider UI"
                              Icon="widgets"
                              BadgeText="@snapshot.ProviderUiSurfaces.Count.ToString()"
                              data-testid="memory-ui-tab-provider-ui">
                        @ProviderUiTab()
                    </TabsItem>
                </Tabs>
            }
        </div>
    </ChildContent>
</PageScaffold>

@code {
    private MemoryProviderManagementSnapshot? snapshot;
    private MemoryProviderProfileEditorModel editor = new();
    private MemoryQueryEditorModel queryEditor = new();
    private MemoryFeedbackEditorModel feedbackEditor = new();
    private MemoryManualIngestionEditorModel manualIngestionEditor = new();
    private int activeTabIndex;
    private bool isLoading = true;
    private bool isBusy;
    private bool isQueryBusy;
    private bool isFeedbackBusy;
    private bool isOperationBusy;
    private bool isEventBusy;
    private bool isIngestionBusy;
    private string? errorMessage;
    private string? selectedProviderId;
    private MemoryProviderQueryUiResult? queryResult;
    private MemoryProviderOperationUiResult? operationActionResult;
    private MemoryProviderFeedbackUiResult? feedbackActionResult;
    private MemoryProviderManualIngestionUiResult? manualIngestionResult;
    private MemoryProviderEventAcknowledgeUiResult? eventActionResult;

    private MemoryProviderManagementProfile? SelectedProvider => snapshot?.SelectedProvider;

    private string TabsRenderKey => snapshot is null
        ? "loading"
        : $"{snapshot.ProviderCount}:{snapshot.EnabledProviderCount}:{snapshot.HealthyProviderCount}:{snapshot.ProviderUiSurfaces.Count}:{snapshot.UiSurfaceCount}";

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        isBusy = true;
        isLoading = snapshot is null;
        errorMessage = null;

        try
        {
            snapshot = await ProviderUiService.GetSnapshotAsync(selectedProviderId);
            selectedProviderId = snapshot.SelectedProvider?.InstanceId.Value;
            editor = MemoryProviderProfileEditorModel.FromProfile(snapshot.SelectedProvider);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
            isBusy = false;
        }
    }

    private async Task SelectProviderAsync(string providerId)
    {
        selectedProviderId = providerId;
        queryResult = null;
        operationActionResult = null;
        feedbackActionResult = null;
        eventActionResult = null;
        manualIngestionResult = null;
        await RefreshAsync();
    }

    private async Task SaveProviderAsync()
    {
        isBusy = true;
        errorMessage = null;

        try
        {
            var saved = await ProviderUiService.SaveProviderAsync(editor);
            selectedProviderId = saved.InstanceId.Value;
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task AddDemoProvidersAsync()
    {
        isBusy = true;
        errorMessage = null;

        try
        {
            await ProviderUiService.CreateDemoProvidersAsync();
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task RunQueryAsync()
    {
        isQueryBusy = true;
        errorMessage = null;

        try
        {
            queryResult = await ProviderUiService.RunQueryAsync(selectedProviderId, queryEditor);
            if (queryResult.ContextPack is not null)
            {
                feedbackEditor.ContextPackId = queryResult.ContextPack.ContextPackId.Value.ToString("D");
            }

            await RefreshAsync();
            activeTabIndex = 4;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isQueryBusy = false;
        }
    }

    private async Task SubmitFeedbackAsync()
    {
        isFeedbackBusy = true;
        errorMessage = null;

        try
        {
            feedbackActionResult = await ProviderUiService.SubmitFeedbackAsync(selectedProviderId, feedbackEditor);
            await RefreshAsync();
            activeTabIndex = 3;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isFeedbackBusy = false;
        }
    }

    private async Task EnqueueManualIngestionAsync()
    {
        isIngestionBusy = true;
        errorMessage = null;

        try
        {
            manualIngestionResult = await ProviderUiService.EnqueueManualIngestionAsync(
                selectedProviderId,
                manualIngestionEditor);
            await RefreshAsync();
            activeTabIndex = 5;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isIngestionBusy = false;
        }
    }

    private async Task RefreshOperationAsync(MemoryOperationId operationId)
    {
        isOperationBusy = true;
        errorMessage = null;

        try
        {
            operationActionResult = await ProviderUiService.RefreshOperationAsync(operationId.Value.ToString("D"));
            await RefreshAsync();
            activeTabIndex = 1;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isOperationBusy = false;
        }
    }

    private async Task CancelOperationAsync(MemoryOperationId operationId)
    {
        isOperationBusy = true;
        errorMessage = null;

        try
        {
            operationActionResult = await ProviderUiService.CancelOperationAsync(operationId.Value.ToString("D"));
            await RefreshAsync();
            activeTabIndex = 1;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isOperationBusy = false;
        }
    }

    private async Task AcknowledgeEventAsync(MemoryProviderEventId eventId, bool accepted)
    {
        isEventBusy = true;
        errorMessage = null;

        try
        {
            eventActionResult = await ProviderUiService.AcknowledgeEventAsync(
                selectedProviderId,
                eventId.Value.ToString("D"),
                accepted);
            await RefreshAsync();
            activeTabIndex = 2;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isEventBusy = false;
        }
    }

    private RenderFragment ProvidersTab() => builder =>
    {
        builder.OpenComponent<Grid>(0);
        builder.AddAttribute(1, nameof(Grid.Gap), LayoutGap.Large);
        builder.AddAttribute(2, nameof(Grid.Class), "memory-ui-layout");
        builder.AddAttribute(3, nameof(Grid.ColumnTemplateXl), "minmax(21rem,0.75fr) minmax(0,1.25fr)");
        builder.AddAttribute(4, "data-testid", "memory-ui-provider-management");
        builder.AddAttribute(5, nameof(Grid.ChildContent), (RenderFragment)(contentBuilder =>
        {
            contentBuilder.OpenComponent<MemoryProviderListPanel>(0);
            contentBuilder.AddAttribute(1, nameof(MemoryProviderListPanel.Providers), snapshot?.Providers ?? Array.Empty<MemoryProviderManagementProfile>());
            contentBuilder.AddAttribute(2, nameof(MemoryProviderListPanel.SelectedProviderId), selectedProviderId);
            contentBuilder.AddAttribute(3, nameof(MemoryProviderListPanel.IsBusy), isBusy);
            contentBuilder.AddAttribute(4, nameof(MemoryProviderListPanel.OnAddDemoProviders), EventCallback.Factory.Create(this, AddDemoProvidersAsync));
            contentBuilder.AddAttribute(5, nameof(MemoryProviderListPanel.OnSelectProvider), EventCallback.Factory.Create<string>(this, SelectProviderAsync));
            contentBuilder.CloseComponent();
            contentBuilder.AddContent(10, ProviderDetailPanel());
        }));
        builder.CloseComponent();
    };

    private RenderFragment ProviderDetailPanel() => builder =>
    {
        if (SelectedProvider is null)
        {
            builder.OpenComponent<SurfaceCard>(0);
            builder.AddAttribute(1, "data-testid", "memory-ui-provider-detail-empty");
            builder.AddAttribute(2, nameof(SurfaceCard.ChildContent), (RenderFragment)(contentBuilder =>
            {
                contentBuilder.OpenComponent<EmptyState>(0);
                contentBuilder.AddAttribute(1, nameof(EmptyState.Eyebrow), "No selection");
                contentBuilder.AddAttribute(2, nameof(EmptyState.Title), "Create or select a provider");
                contentBuilder.AddAttribute(3, nameof(EmptyState.Description), "No provider-backed action can dispatch in the current state.");
                contentBuilder.CloseComponent();
                contentBuilder.AddContent(4, ProviderEditor());
            }));
            builder.CloseComponent();
            return;
        }

        builder.OpenComponent<SurfaceCard>(3);
        builder.AddAttribute(4, "data-testid", "memory-ui-provider-detail");
        builder.AddAttribute(5, nameof(SurfaceCard.ChildContent), (RenderFragment)(contentBuilder =>
        {
            contentBuilder.OpenComponent<Cluster>(0);
            contentBuilder.AddAttribute(1, nameof(Cluster.Gap), LayoutGap.Small);
            contentBuilder.AddAttribute(2, nameof(Cluster.Wrap), FlexWrap.Wrap);
            contentBuilder.AddAttribute(3, nameof(Cluster.AlignItems), AlignItems.Center);
            contentBuilder.AddAttribute(4, nameof(Cluster.JustifyContent), JustifyContent.SpaceBetween);
            contentBuilder.AddAttribute(5, nameof(Cluster.ChildContent), (RenderFragment)(headBuilder =>
            {
                headBuilder.OpenElement(0, "div");
                headBuilder.OpenComponent<TextBlock>(1);
                headBuilder.AddAttribute(2, nameof(TextBlock.TextStyle), TextStyle.Eyebrow);
                headBuilder.AddAttribute(3, nameof(TextBlock.Value), SelectedProvider.InstanceId.Value);
                headBuilder.CloseComponent();
                headBuilder.OpenElement(4, "h2");
                headBuilder.AddAttribute(5, "class", "memory-ui-card-title");
                headBuilder.AddContent(6, SelectedProvider.DisplayName);
                headBuilder.CloseElement();
                headBuilder.CloseElement();
                headBuilder.OpenComponent<StatusBadge>(7);
                headBuilder.AddAttribute(8, nameof(StatusBadge.Tone), HealthTone(SelectedProvider.HealthState));
                headBuilder.AddAttribute(9, nameof(StatusBadge.Text), SelectedProvider.HealthState.ToString());
                headBuilder.CloseComponent();
            }));
            contentBuilder.CloseComponent();

            contentBuilder.OpenElement(20, "div");
            contentBuilder.AddAttribute(21, "class", "memory-ui-facts");
            RenderFact(contentBuilder, 22, "Driver", SelectedProvider.DriverKind.ToString());
            RenderFact(contentBuilder, 30, "Workspace", SelectedProvider.WorkspaceScope.ToString());
            RenderFact(contentBuilder, 38, "Protocol", SelectedProvider.ProtocolVersion.Value);
            RenderFact(contentBuilder, 46, "Fallback", SelectedProvider.DefaultPolicy.FallbackBehavior.ToString());
            RenderFact(contentBuilder, 54, "Sections", SelectedProvider.Limits.MaxContextSections.ToString());
            RenderFact(contentBuilder, 62, "Timeout", SelectedProvider.Limits.OperationTimeout.ToString());
            contentBuilder.CloseElement();

            contentBuilder.OpenElement(70, "section");
            contentBuilder.AddAttribute(71, "class", "memory-ui-section");
            contentBuilder.OpenElement(72, "h3");
            contentBuilder.AddContent(73, "Capabilities");
            contentBuilder.CloseElement();
            RenderCapabilities(contentBuilder, 74, SelectedProvider.Capabilities);
            contentBuilder.CloseElement();

            contentBuilder.AddContent(100, ProviderEditor());
        }));
        builder.CloseComponent();
    };

    private RenderFragment ProviderEditor() => builder =>
    {
        builder.OpenElement(0, "section");
        builder.AddAttribute(1, "class", "memory-ui-section memory-ui-editor");
        builder.AddAttribute(2, "data-testid", "memory-ui-provider-editor");
        builder.OpenElement(3, "h3");
        builder.AddContent(4, "Provider profile");
        builder.CloseElement();

        builder.OpenComponent<Grid>(5);
        builder.AddAttribute(6, nameof(Grid.Gap), LayoutGap.Medium);
        builder.AddAttribute(7, nameof(Grid.ColumnTemplateXl), "minmax(0,1fr) minmax(0,1fr)");
        builder.AddAttribute(8, nameof(Grid.ChildContent), (RenderFragment)(gridBuilder =>
        {
            RenderTextField(gridBuilder, 0, "Instance id", () => editor.InstanceId, value => editor.InstanceId = value, "memory-ui-editor-instance-id");
            RenderTextField(gridBuilder, 20, "Display name", () => editor.DisplayName, value => editor.DisplayName = value, "memory-ui-editor-display-name");
            RenderEnumSelect(gridBuilder, 40, "Driver", editor.DriverKind, value => editor.DriverKind = value, "memory-ui-editor-driver");
            RenderEnumSelect(gridBuilder, 70, "Health", editor.HealthState, value => editor.HealthState = value, "memory-ui-editor-health");
            RenderEnumSelect(gridBuilder, 100, "Workspace", editor.WorkspaceScope, value => editor.WorkspaceScope = value, "memory-ui-editor-workspace");
            RenderEnumSelect(gridBuilder, 130, "Fallback", editor.FallbackBehavior, value => editor.FallbackBehavior = value, "memory-ui-editor-fallback");
            RenderTextField(gridBuilder, 160, "Provider kind", () => editor.ProviderKind, value => editor.ProviderKind = value, "memory-ui-editor-provider-kind");
            RenderTextField(gridBuilder, 190, "Provider UI URL", () => editor.ProviderUiUrl, value => editor.ProviderUiUrl = value, "memory-ui-editor-provider-ui-url");
        }));
        builder.CloseComponent();

        builder.OpenElement(180, "div");
        builder.AddAttribute(181, "class", "memory-ui-checks");
        RenderCheckbox(builder, 182, "Enabled", editor.IsEnabled, value => editor.IsEnabled = value, "memory-ui-editor-enabled");
        RenderCheckbox(builder, 190, "Sync query", editor.SupportsContextQuerySync, value => editor.SupportsContextQuerySync = value, "memory-ui-editor-sync-query");
        RenderCheckbox(builder, 198, "Async query", editor.SupportsContextQueryAsync, value => editor.SupportsContextQueryAsync = value, "memory-ui-editor-async-query");
        RenderCheckbox(builder, 206, "Snapshot ingestion", editor.SupportsSnapshotIngestion, value => editor.SupportsSnapshotIngestion = value, "memory-ui-editor-snapshot-ingestion");
        RenderCheckbox(builder, 214, "Provider source requests", editor.SupportsProviderRequestedSources, value => editor.SupportsProviderRequestedSources = value, "memory-ui-editor-source-requests");
        RenderCheckbox(builder, 222, "Immediate feedback", editor.SupportsImmediateFeedback, value => editor.SupportsImmediateFeedback = value, "memory-ui-editor-immediate-feedback");
        RenderCheckbox(builder, 230, "Delayed feedback", editor.SupportsDelayedFeedback, value => editor.SupportsDelayedFeedback = value, "memory-ui-editor-delayed-feedback");
        RenderCheckbox(builder, 238, "Provider events", editor.SupportsProviderEvents, value => editor.SupportsProviderEvents = value, "memory-ui-editor-provider-events");
        RenderCheckbox(builder, 246, "Host event polling", editor.SupportsHostEventPolling, value => editor.SupportsHostEventPolling = value, "memory-ui-editor-host-events");
        RenderCheckbox(builder, 254, "Operation status", editor.SupportsOperationStatus, value => editor.SupportsOperationStatus = value, "memory-ui-editor-operation-status");
        RenderCheckbox(builder, 262, "RCL surface", editor.SupportsRclUi, value => editor.SupportsRclUi = value, "memory-ui-editor-rcl");
        RenderCheckbox(builder, 270, "Iframe surface", editor.SupportsIframeUi, value => editor.SupportsIframeUi = value, "memory-ui-editor-iframe");
        builder.CloseElement();

        builder.OpenComponent<Button>(280);
        builder.AddAttribute(281, nameof(Button.Text), "Save provider");
        builder.AddAttribute(282, nameof(Button.Icon), "save");
        builder.AddAttribute(283, nameof(Button.ButtonStyle), ButtonStyle.Primary);
        builder.AddAttribute(284, nameof(Button.Size), ButtonSize.Small);
        builder.AddAttribute(285, nameof(Button.Click), EventCallback.Factory.Create(this, SaveProviderAsync));
        builder.AddAttribute(286, nameof(Button.Disabled), isBusy);
        builder.AddAttribute(287, nameof(Button.IsBusy), isBusy);
        builder.AddAttribute(288, "data-testid", "memory-ui-save-provider");
        builder.CloseComponent();
        builder.CloseElement();
    };

    private RenderFragment QueryTab() => builder =>
    {
        var selectedProvider = SelectedProvider;
        var canRun = CanRunQuery(selectedProvider);

        builder.OpenComponent<SurfaceCard>(0);
        builder.AddAttribute(1, "data-testid", "memory-ui-query");
        builder.AddAttribute(2, nameof(SurfaceCard.ChildContent), (RenderFragment)(contentBuilder =>
        {
            contentBuilder.OpenComponent<TextBlock>(0);
            contentBuilder.AddAttribute(1, nameof(TextBlock.TextStyle), TextStyle.Eyebrow);
            contentBuilder.AddAttribute(2, nameof(TextBlock.Value), "Query");
            contentBuilder.CloseComponent();
            contentBuilder.OpenElement(3, "h2");
            contentBuilder.AddAttribute(4, "class", "memory-ui-card-title");
            contentBuilder.AddContent(5, canRun ? "Ready for selected provider" : "Query unavailable");
            contentBuilder.CloseElement();
            contentBuilder.OpenElement(6, "p");
            contentBuilder.AddAttribute(7, "class", "memory-ui-muted");
            contentBuilder.AddContent(8, QueryDiagnostic(selectedProvider));
            contentBuilder.CloseElement();
            RenderTextAreaField(contentBuilder, 9, "Query", () => queryEditor.Query, value => queryEditor.Query = value, "memory-ui-query-text");
            contentBuilder.OpenElement(30, "div");
            contentBuilder.AddAttribute(31, "class", "memory-ui-checks");
            RenderCheckbox(contentBuilder, 32, "Async query", queryEditor.UseAsyncQuery, value => queryEditor.UseAsyncQuery = value, "memory-ui-query-async");
            contentBuilder.CloseElement();
            contentBuilder.OpenComponent<Button>(40);
            contentBuilder.AddAttribute(41, nameof(Button.Text), "Run query");
            contentBuilder.AddAttribute(42, nameof(Button.Icon), "play_arrow");
            contentBuilder.AddAttribute(43, nameof(Button.ButtonStyle), ButtonStyle.Primary);
            contentBuilder.AddAttribute(44, nameof(Button.Size), ButtonSize.Small);
            contentBuilder.AddAttribute(45, nameof(Button.Click), EventCallback.Factory.Create(this, RunQueryAsync));
            contentBuilder.AddAttribute(46, nameof(Button.Disabled), !canRun || isQueryBusy);
            contentBuilder.AddAttribute(47, nameof(Button.IsBusy), isQueryBusy);
            contentBuilder.AddAttribute(48, "data-testid", "memory-ui-query-submit");
            contentBuilder.CloseComponent();
            if (queryResult is not null)
            {
                contentBuilder.AddContent(60, QueryResultPanel());
            }
        }));
        builder.CloseComponent();
    };

    private RenderFragment IngestionTab() => builder =>
    {
        var selectedProvider = SelectedProvider;
        var canRun = CanRunManualIngestion(selectedProvider);

        builder.OpenComponent<SurfaceCard>(0);
        builder.AddAttribute(1, "data-testid", "memory-ui-ingestion");
        builder.AddAttribute(2, nameof(SurfaceCard.ChildContent), (RenderFragment)(contentBuilder =>
        {
            contentBuilder.OpenComponent<TextBlock>(0);
            contentBuilder.AddAttribute(1, nameof(TextBlock.TextStyle), TextStyle.Eyebrow);
            contentBuilder.AddAttribute(2, nameof(TextBlock.Value), "Ingestion");
            contentBuilder.CloseComponent();
            contentBuilder.OpenElement(3, "h2");
            contentBuilder.AddAttribute(4, "class", "memory-ui-card-title");
            contentBuilder.AddContent(5, canRun ? "Manual source snapshot" : "Ingestion unavailable");
            contentBuilder.CloseElement();
            contentBuilder.OpenElement(6, "p");
            contentBuilder.AddAttribute(7, "class", "memory-ui-muted");
            contentBuilder.AddContent(8, ManualIngestionDiagnostic(selectedProvider));
            contentBuilder.CloseElement();
            RenderTextField(contentBuilder, 10, "Title", () => manualIngestionEditor.Title, value => manualIngestionEditor.Title = value, "memory-ui-ingestion-title");
            RenderTextAreaField(contentBuilder, 30, "Content", () => manualIngestionEditor.ContentText, value => manualIngestionEditor.ContentText = value, "memory-ui-ingestion-content");
            RenderTextField(contentBuilder, 55, "Category", () => manualIngestionEditor.SourceCategory, value => manualIngestionEditor.SourceCategory = value, "memory-ui-ingestion-category");
            RenderTextField(contentBuilder, 75, "Tags", () => manualIngestionEditor.Tags, value => manualIngestionEditor.Tags = value, "memory-ui-ingestion-tags");
            contentBuilder.OpenComponent<Button>(95);
            contentBuilder.AddAttribute(96, nameof(Button.Text), "Enqueue ingestion");
            contentBuilder.AddAttribute(97, nameof(Button.Icon), "upload_file");
            contentBuilder.AddAttribute(98, nameof(Button.ButtonStyle), ButtonStyle.Primary);
            contentBuilder.AddAttribute(99, nameof(Button.Size), ButtonSize.Small);
            contentBuilder.AddAttribute(100, nameof(Button.Click), EventCallback.Factory.Create(this, EnqueueManualIngestionAsync));
            contentBuilder.AddAttribute(101, nameof(Button.Disabled), !canRun || isIngestionBusy);
            contentBuilder.AddAttribute(102, nameof(Button.IsBusy), isIngestionBusy);
            contentBuilder.AddAttribute(103, "data-testid", "memory-ui-ingestion-submit");
            contentBuilder.CloseComponent();
            if (manualIngestionResult is not null)
            {
                RenderManualIngestionResult(contentBuilder, 120, manualIngestionResult);
            }
        }));
        builder.CloseComponent();
    };

    private RenderFragment ProviderUiTab() => builder =>
    {
        builder.OpenComponent<SurfaceCard>(0);
        builder.AddAttribute(1, "data-testid", "memory-ui-provider-ui");
        builder.AddAttribute(2, nameof(SurfaceCard.ChildContent), (RenderFragment)(contentBuilder =>
        {
            contentBuilder.OpenComponent<MemoryProviderUiSurfaceHost>(0);
            contentBuilder.AddAttribute(1, nameof(MemoryProviderUiSurfaceHost.Provider), SelectedProvider);
            contentBuilder.AddAttribute(2, nameof(MemoryProviderUiSurfaceHost.Surfaces), snapshot?.ProviderUiSurfaces ?? Array.Empty<MemoryProviderUiSurfaceProjection>());
            contentBuilder.CloseComponent();
        }));
        builder.CloseComponent();
    };

    private RenderFragment OperationsTab() => builder =>
    {
        builder.OpenComponent<SurfaceCard>(0);
        builder.AddAttribute(1, "data-testid", "memory-ui-operations");
        builder.AddAttribute(2, nameof(SurfaceCard.ChildContent), (RenderFragment)(contentBuilder =>
        {
            contentBuilder.OpenComponent<TextBlock>(0);
            contentBuilder.AddAttribute(1, nameof(TextBlock.TextStyle), TextStyle.Eyebrow);
            contentBuilder.AddAttribute(2, nameof(TextBlock.Value), "Operations");
            contentBuilder.CloseComponent();
            contentBuilder.OpenElement(3, "h2");
            contentBuilder.AddAttribute(4, "class", "memory-ui-card-title");
            contentBuilder.AddContent(5, "Operation status");
            contentBuilder.CloseElement();
            if (operationActionResult is not null)
            {
                RenderActionResult(contentBuilder, 10, operationActionResult.Status.ToString(), operationActionResult.Diagnostic);
            }

            if (snapshot?.Operations.Count > 0)
            {
                contentBuilder.OpenElement(20, "div");

@namespace CanDoItAll.Modules.CognitiveMemory.Pages

@if (Page.snapshot is { } snapshot)
{
                        <Grid Gap="LayoutGap.Large"
                              Class="cognitive-memory-layout"
                              ColumnTemplateXl="minmax(20rem,0.85fr) minmax(0,1.15fr)"
                              data-testid="cognitive-memory-explorer">
                            <SurfaceCard>
                                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Explorer" />
                                <h2 class="cognitive-memory-card-title">Memory items</h2>
                                @Page.MemoryExplorerList()
                            </SurfaceCard>

                            <SurfaceCard data-testid="cognitive-memory-detail">
                                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Detail" />
                                <h2 class="cognitive-memory-card-title">Memory source evidence</h2>
                                @Page.MemoryDetailPanel()
                            </SurfaceCard>
                        </Grid>
}

@code {
    [CascadingParameter]
    internal CognitiveMemoryPage Page { get; set; } = default!;
}


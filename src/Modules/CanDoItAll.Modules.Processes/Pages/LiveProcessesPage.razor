@page "/processes/live"
@page "/projects/{ProjectId:guid}/processes/live"
@using CanDoItAll.AppComponents

<PageTitle>Live Processes</PageTitle>
@if (ProjectId.HasValue)
{
    <AppToolbarTabText Text="Live Processes" />
}

<LiveProcessesDashboard ProjectId="@ProjectId"
                        MockScenarioQuery="@MockScenarioQuery" />

@code {
    [Parameter]
    public Guid? ProjectId { get; set; }

    [SupplyParameterFromQuery(Name = LiveProcessesUrlCodec.MockScenarioKey)]
    public string? MockScenarioQuery { get; set; }
}

    private ProcessDefinitionWorkspaceLoadOptions CreateDefinitionLoadOptions(ProcessWorkspaceDetailTabKey detailTabKey)
        => detailTabKey switch {
            ProcessWorkspaceDetailTabKey.Definition => ProcessDefinitionWorkspaceLoadOptions.Basics,
            ProcessWorkspaceDetailTabKey.Roles => ProcessDefinitionWorkspaceLoadOptions.Roles,
            ProcessWorkspaceDetailTabKey.Steps => ProcessDefinitionWorkspaceLoadOptions.Steps,
            ProcessWorkspaceDetailTabKey.Analytics => ProcessDefinitionWorkspaceLoadOptions.Basics,
            ProcessWorkspaceDetailTabKey.Exchange => ProcessDefinitionWorkspaceLoadOptions.Exchange,

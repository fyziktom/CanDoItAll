    private AgentVoiceAccessSettings ManagerChatVoiceAccess
        => managerChatAgent is null
            ? new AgentVoiceAccessSettings()
            : AgentVoiceAccessMetadata.Read(managerChatAgent.ConfigurationJson);

    private bool CanUseManagerChatVoiceMode
        => ManagerChatVoiceAccess.CanUseVoiceMode;

    private bool ManagerChatReloadDisabled
        => managerChatIsLoading || ManagerChatOperationActive;

    private bool ManagerChatOperationActive
        => managerChatIsBusy || managerChatVoiceStarting || managerChatVoiceRecording || managerChatVoiceTranscribing || managerChatVoiceSpeaking;

    private bool ManagerChatReady
        => !isDisposed && !managerChatIsLoading && managerChatWorkspace is not null &&
            managerChatAgent is not null && managerChatAgent.Id == managerChatAgentId;

    private Task HandleManagerChatVoiceModeChangedAsync(bool enabled) {
        if (enabled && !CanUseManagerChatVoiceMode) {
            SetManagerChatVoiceStatus("Voice denied", "warning", "This agent does not allow voice mode.");
            return Task.CompletedTask;
        }

        managerChatVoiceModeEnabled = enabled;
        SetManagerChatVoiceStatus(enabled ? "Audio on" : "Audio off", enabled ? "primary" : "neutral");
        return Task.CompletedTask;
    }

    private async Task ToggleManagerChatVoiceRecordingAsync() {
        if (managerChatVoiceStarting || !ManagerChatReady) {
            return;
        }
        if (!CanUseManagerChatVoiceMode) {
            SetManagerChatVoiceStatus("Voice denied", "warning", "This agent does not allow voice mode.");
            return;
        }

        if (!managerChatVoiceRecording) {
            var operationContext = CaptureManagerChatContext();
            managerChatVoiceStarting = true;
            SetManagerChatVoiceStatus("Requesting microphone", "info");
            try {
                await JsRuntime.InvokeVoidAsync("CanDoItAll.agentFramework.voice.startRecordingForOwner", operationContext.VoiceOwnerId.ToString("N"));
                if (!IsCurrentManagerChatContext(operationContext)) {
                    return;
                }
                managerChatVoiceModeEnabled = true;
                managerChatVoiceRecording = true;
                SetManagerChatVoiceStatus("Recording", "danger");
            } catch (Exception exception) when (exception is not OperationCanceledException) {
                if (!IsCurrentManagerChatContext(operationContext)) {
                    return;
                }
                SetManagerChatVoiceStatus("Record failed", "danger", exception.Message);
            } finally {
                if (OwnsManagerChatOperation(operationContext)) {
                    managerChatVoiceStarting = false;
                }
            }

            return;
        }

        await StopManagerChatRecordingAndSendAsync();
    }

    private async Task StopManagerChatRecordingAndSendAsync() {
        if (!ManagerChatReady) {
            return;
        }
        var operationContext = CaptureManagerChatContext();
        managerChatVoiceRecording = false;
        managerChatVoiceTranscribing = true;
        SetManagerChatVoiceStatus("Transcribing", "info");
        try {
            var voiceService = ResolveManagerChatVoiceService();
            if (voiceService is null) {
                return;
            }

            var recording = await JsRuntime.InvokeAsync<BrowserVoiceRecording>(
                "CanDoItAll.agentFramework.voice.stopRecordingForOwner", operationContext.VoiceOwnerId.ToString("N"));
            if (!IsCurrentManagerChatContext(operationContext)) {
                return;
            }
            var transcription = await voiceService.TranscribeAsync(recording.ToTranscriptionRequest());
            if (!IsCurrentManagerChatContext(operationContext)) {
                return;
            }

            managerChatDraftPrompt = transcription.Text;
            managerChatComposerKey++;
            SetManagerChatVoiceStatus("Sending", "info");
            await SendManagerChatMessageAsync();
        } catch (Exception exception) when (exception is not OperationCanceledException) {
            if (!IsCurrentManagerChatContext(operationContext)) {
                return;
            }
            SetManagerChatVoiceStatus("Voice failed", "danger", exception.Message);
        } finally {
            if (OwnsManagerChatOperation(operationContext)) {
                managerChatVoiceTranscribing = false;
            }
        }
    }

    private Task SpeakLatestManagerChatAssistantMessageAsync() {
        var latestAssistantMessage = managerChatWorkspace?.SelectedSession?.Messages
            .Where(message => message.Role == ChatMessageRole.Assistant)
            .OrderByDescending(message => message.CreatedAtUtc)
            .FirstOrDefault();
        if (latestAssistantMessage is null || string.IsNullOrWhiteSpace(latestAssistantMessage.Content)) {
            SetManagerChatVoiceStatus("Nothing to speak", "warning", "No assistant message is available.");
            return Task.CompletedTask;
        }

        return SpeakManagerChatTextAsync(latestAssistantMessage.Content);
    }

    private async Task SpeakManagerChatTextAsync(string text) {
        if (!ManagerChatReady) {
            return;
        }
        if (managerChatAgent is null) {
            SetManagerChatVoiceStatus("No agent", "warning", "Select a manager agent before using text-to-speech.");
            return;
        }

        var voiceService = ResolveManagerChatVoiceService();
        if (voiceService is null) {
            return;
        }

        var operationContext = CaptureManagerChatContext();
        var voiceAccess = ManagerChatVoiceAccess;
        var suppressIdentifierNotice = ShouldSuppressManagerChatIdentifierOmissionNotice();
        managerChatVoiceSpeaking = true;
        SetManagerChatVoiceStatus("Speaking", "primary");
        try {
            await JsRuntime.InvokeVoidAsync("CanDoItAll.agentFramework.voice.clearAudioQueueForOwner", operationContext.VoiceOwnerId.ToString("N"));
            if (!IsCurrentManagerChatContext(operationContext)) {
                return;
            }
            var queuedChunks = 0;
            await foreach (var synthesis in voiceService.SynthesizeChunksAsync(new AgentVoiceSynthesisRequest(
                               text,
                               voiceAccess,
                               SuppressIdentifierOmissionNotice: suppressIdentifierNotice))) {
                if (!IsCurrentManagerChatContext(operationContext)) {
                    return;
                }
                TrackManagerChatIdentifierOmissionNotice(synthesis);
                queuedChunks++;
                await JsRuntime.InvokeVoidAsync(
                    "CanDoItAll.agentFramework.voice.enqueueAudioForOwner",
                    operationContext.VoiceOwnerId.ToString("N"),
                    Convert.ToBase64String(synthesis.AudioBytes),
                    synthesis.ContentType);
                if (!IsCurrentManagerChatContext(operationContext)) {
                    return;
                }
                if (queuedChunks == 1) {
                    SetManagerChatVoiceStatus("Playing", "primary");
                }
            }

            if (IsCurrentManagerChatContext(operationContext)) {
                SetManagerChatVoiceStatus(queuedChunks == 1 ? "Audio ready" : $"Audio ready ({queuedChunks} chunks)", "success");
            }
        } catch (Exception exception) when (exception is not OperationCanceledException) {
            if (!IsCurrentManagerChatContext(operationContext)) {
                return;
            }
            SetManagerChatVoiceStatus("Speak failed", "danger", exception.Message);
        } finally {
            if (OwnsManagerChatOperation(operationContext)) {
                managerChatVoiceSpeaking = false;
            }
        }
    }

    private IAgentVoiceService? ResolveManagerChatVoiceService() {
        var voiceService = Services.GetService<IAgentVoiceService>();
        if (voiceService is not null) {
            return voiceService;
        }

        SetManagerChatVoiceStatus("Voice unavailable", "warning", "Voice services are not registered.");
        return null;
    }

    private bool ShouldSuppressManagerChatIdentifierOmissionNotice() {
        return managerChatSessionId is { } sessionId
            ? managerChatSessionsWithVoiceIdentifierOmissionNotice.Contains(sessionId)
            : managerChatHasVoiceIdentifierOmissionNoticeWithoutSession;
    }

    private void TrackManagerChatIdentifierOmissionNotice(AgentVoiceSynthesisResult synthesis) {
        if (!synthesis.IdentifierOmissionNoticeIncluded) {
            return;
        }

        if (managerChatSessionId is { } sessionId) {
            managerChatSessionsWithVoiceIdentifierOmissionNotice.Add(sessionId);
            return;
        }

        managerChatHasVoiceIdentifierOmissionNoticeWithoutSession = true;
    }

    private void ResetManagerChatVoiceState() {
        var previousOwnerId = managerChatVoiceOwnerId;
        managerChatVoiceOwnerId = Guid.NewGuid();
        managerChatVoiceModeEnabled = false;
        managerChatVoiceRecording = false;
        managerChatVoiceStarting = false;
        managerChatVoiceTranscribing = false;
        managerChatVoiceSpeaking = false;
        managerChatVoiceStatusText = string.Empty;
        managerChatVoiceStatusTone = "neutral";
        managerChatVoiceCleanup = Task.WhenAll(managerChatVoiceCleanup, DisposeManagerChatVoiceOwnerAsync(previousOwnerId));
    }

    private async Task DisposeManagerChatVoiceOwnerAsync(Guid ownerId) {
        try {
            await JsRuntime.InvokeVoidAsync("CanDoItAll.agentFramework.voice.disposeOwner", ownerId.ToString("N"));
        } catch (Exception exception) when (exception is JSDisconnectedException or InvalidOperationException) {
            Logger.LogDebug("Manager chat voice cleanup is unavailable. OwnerId={OwnerId}; FailureType={FailureType}.", ownerId, exception.GetType().Name);
        } catch (JSException exception) {
            Logger.LogWarning("Manager chat voice cleanup failed. OwnerId={OwnerId}; FailureType={FailureType}.", ownerId, exception.GetType().Name);
        }
    }


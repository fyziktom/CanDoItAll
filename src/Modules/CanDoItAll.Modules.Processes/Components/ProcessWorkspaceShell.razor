    private string LiveRunAttentionText
        => shell?.LiveRuns.AttentionRunCount.ToString(CultureInfo.InvariantCulture) ?? "0";

    private string LiveRunTooltip
        => shell?.LiveRuns.Summary ?? "Live run projection is loading.";

    private string ProjectionStatusText
        => shell?.Refresh.Status switch {
            ProcessWorkspaceProjectionStatus.Ready => "Ready",
            ProcessWorkspaceProjectionStatus.RefreshRequested => "Refresh requested",
            ProcessWorkspaceProjectionStatus.ProjectionStoreUnavailable => "Store pending",
            _ => "Loading"
        };

    private string ProjectionTooltip
        => shell?.Refresh.Summary ?? "Projection freshness is loading.";

    private string ProjectionTone
        => shell?.Refresh.Status switch {
            ProcessWorkspaceProjectionStatus.Ready => "success",
            ProcessWorkspaceProjectionStatus.RefreshRequested => "info",
            ProcessWorkspaceProjectionStatus.ProjectionStoreUnavailable => "warning",
            _ => "neutral"
        };

    private bool AgentContextDisabled
        => WorkspaceBusy || shell?.AgentEntry.IsAvailable != true;

    private string AgentContextTooltip
        => shell?.AgentEntry.DisabledReason ?? shell?.AgentEntry.ContextKey ?? "Process agent context is loading.";

    private ProcessDefinitionCatalogProjection DefinitionCatalog
        => shell?.DefinitionCatalog ?? throw new InvalidOperationException("Definition catalog is not loaded.");

    private ProcessWorkspaceShellProjection CurrentShell
        => shell ?? throw new InvalidOperationException("Process workspace shell is not loaded.");

    private bool HasUnresolvedRouteRunSelection
        => requiredRouteRunId is { } requestedRunId &&
           shell is not null &&
           shell.Runtime.SelectedRunId != requestedRunId;

    private bool HasUnresolvedRouteDefinitionSelection
        => !string.IsNullOrWhiteSpace(requiredRouteDefinitionKey) &&
           shell is not null &&
           !string.Equals(
               shell.DefinitionCatalog.SelectedItem?.Key.Value,
               requiredRouteDefinitionKey,
               StringComparison.Ordinal);

    private bool HasUnresolvedRouteProcessSelection
        => requiredRouteProcessId is { } requestedProcessId &&
           shell is not null &&
           (shell.DefinitionCatalog.SelectedItem is not { } selectedDefinition ||
            ProcessDefinitionCatalogProjectionService.CreateDefinitionId(selectedDefinition.Key).Value != requestedProcessId);

    private bool HasUnresolvedRouteLaunchPlanSelection
        => requiredRouteLaunchPlanId.HasValue && shell is not null;

    private bool HasUnresolvedNonRunRouteSelection
        => HasUnresolvedRouteDefinitionSelection ||
           HasUnresolvedRouteProcessSelection ||
           HasUnresolvedRouteLaunchPlanSelection;

    private bool HasUnresolvedRouteSelection
        => HasUnresolvedRouteRunSelection || HasUnresolvedNonRunRouteSelection;

    private ProcessWorkspaceShellProjection? AgentChatShell {
        get {
            if (!HasUnresolvedNonRunRouteSelection || shell is null) {
                return shell;
            }

            return shell with {
                DefinitionCatalog = shell.DefinitionCatalog with {
                    SelectedDefinitionKey = string.IsNullOrWhiteSpace(requiredRouteDefinitionKey)
                        ? null
                        : new ProcessDefinitionCatalogItemKey(requiredRouteDefinitionKey),
                    SelectedItem = null,
                    SelectedEditor = null
                }
            };
        }
    }

    private ProcessAgentChatContextPublication ResolveAgentChatPublication() {
        var context = new ProcessWorkspaceAgentChatContext(
            Navigation.Uri,
            ProjectId,
            AgentChatWorkspaceView,
            AgentChatRunView,
            HasUnresolvedNonRunRouteSelection
                ? null
                : requiredRouteRunId ?? selectedRuntimeRunId ?? shell?.Runtime.SelectedRunId ?? RunIdQuery,
            AgentChatShell,
            !HasUnresolvedRouteSelection && runDetailDialogOpen ? runDetailSnapshot : null,
            !HasUnresolvedRouteSelection && eventDetailDialogOpen ? eventDetail : null,
            AgentChatAccessState,
            shell?.ProjectBinding is { } binding ? new(binding.DatabaseProfileId, binding.ProjectId, binding.LifetimeId) : null);
        agentChatPublication = ProcessInvocationSnapshotMapper.BuildWorkspacePublication(
            context,
            new DatabaseProfileGeneration(DatabaseRuntimeState.GetSnapshot().Generation),
            TimeProvider.GetUtcNow(),
            agentChatPublication);
        AgentChatFreshnessLease.Schedule(
            agentChatPublication.SnapshotCapture?.AttachmentDraft);
        return agentChatPublication;
    }

    private ProcessAgentChatFreshnessLease AgentChatFreshnessLease
        => agentChatFreshnessLease ??= new ProcessAgentChatFreshnessLease(
            TimeProvider,
            ExpireAgentChatPublicationAsync,
            exception => Logger.LogError(
                exception,
                "Failed to expire the process workspace agent context at its freshness deadline."));

    private Task ExpireAgentChatPublicationAsync()
        => InvokeAsync(() => {
            if (isDisposed) {
                return;
            }

            StateHasChanged();
        });

    private AgentChatContextAccessState AgentChatAccessState
        => WorkspaceBusy
            ? AgentChatContextAccessState.Loading
            : !string.IsNullOrWhiteSpace(errorMessage)
                ? AgentChatContextAccessState.Failed
            : shell is not null
            ? HasUnresolvedRouteSelection
                ? AgentChatContextAccessState.Failed
                : AgentChatContextAccessState.Ready
            : string.IsNullOrWhiteSpace(errorMessage)
                ? AgentChatContextAccessState.Loading
                : AgentChatContextAccessState.Failed;

    private AgentChatNavigationIdentity AgentChatNavigationFence
        => AgentChatNavigationIdentity.CreateForLocation(
            Navigation.BaseUri,
            Navigation.Uri,
            [
                new("processId", ProcessIdQuery?.ToString("D")),
                new("runId", RunIdQuery?.ToString("D")),
                new("launchPlanId", LaunchPlanIdQuery?.ToString("D")),
                new("q", DefinitionSearchText),
                new("definitionKey", SelectedDefinitionKey)
            ]);

    private ProcessAgentChatWorkspaceView AgentChatWorkspaceView
        => (!activeDetailTabInitialized && ResolvePreferredDetailTab() == ProcessWorkspaceDetailTabKey.Runs
                ? 3
                : activeDetailTabIndex) switch {
            0 => ProcessAgentChatWorkspaceView.Definition,
            1 => ProcessAgentChatWorkspaceView.Roles,
            2 => ProcessAgentChatWorkspaceView.Steps,
            3 => ProcessAgentChatWorkspaceView.Runs,
            4 => ProcessAgentChatWorkspaceView.Graphs,
            5 => ProcessAgentChatWorkspaceView.Analytics,
            6 => ProcessAgentChatWorkspaceView.Exchange,
            7 => ProcessAgentChatWorkspaceView.ManagerChat,
            _ => ProcessAgentChatWorkspaceView.Definition
        };

    private ProcessAgentChatRunView AgentChatRunView
        => selectedRunViewIndex switch {
            0 => ProcessAgentChatRunView.Launch,
            1 => ProcessAgentChatRunView.Activity,
            2 => ProcessAgentChatRunView.Control,
            3 => ProcessAgentChatRunView.Execution,
            4 => ProcessAgentChatRunView.Graphs,
            5 => ProcessAgentChatRunView.Coordination,
            6 => ProcessAgentChatRunView.Evidence,
            _ => ProcessAgentChatRunView.Activity
        };

    protected override async Task OnParametersSetAsync() {
        var previousRunId = ResolveSelectedManagerChatRunId();
        SynchronizeRouteSelections();
        if (previousRunId != ResolveSelectedManagerChatRunId()) {
            ResetManagerChatForSelectedRunChange();
        }
        searchText = DefinitionSearchText?.Trim() ?? string.Empty;
        pendingSearchText = searchText;
        selectedDefinitionKey = string.IsNullOrWhiteSpace(SelectedDefinitionKey)
            ? null
            : SelectedDefinitionKey.Trim();
        await LoadAsync(forceRefresh: false);
    }

    private void SynchronizeRouteSelections(bool force = false) {
        var normalizedDefinitionKey = string.IsNullOrWhiteSpace(SelectedDefinitionKey)
            ? null
            : SelectedDefinitionKey.Trim();
        if (!force && routeSelectionInitialized &&
            routeSelectionProjectId == ProjectId &&
            routeSelectionProcessId == ProcessIdQuery &&
            routeSelectionRunId == RunIdQuery &&
            routeSelectionLaunchPlanId == LaunchPlanIdQuery &&
            string.Equals(routeSelectionDefinitionKey, normalizedDefinitionKey, StringComparison.Ordinal)) {
            return;
        }

        routeSelectionInitialized = true;
        routeSelectionProjectId = ProjectId;
        routeSelectionProcessId = ProcessIdQuery;
        routeSelectionRunId = RunIdQuery;
        routeSelectionLaunchPlanId = LaunchPlanIdQuery;
        requiredRouteProcessId = ProcessIdQuery;
        requiredRouteRunId = RunIdQuery;
        requiredRouteLaunchPlanId = LaunchPlanIdQuery;
        routeSelectionDefinitionKey = normalizedDefinitionKey;
        requiredRouteDefinitionKey = normalizedDefinitionKey;
        selectedRuntimeRunId = RunIdQuery;
        runtimeEventPage = 0;
        runDetailDialogOpen = false;
        runDetailSnapshot = null;
        eventDetailDialogOpen = false;
        eventDetail = null;
    }

    private async Task RefreshAsync() {
        await LoadAsync(forceRefresh: true);
    }

    private async Task LoadAsync(bool forceRefresh) {
        var generation = Interlocked.Increment(ref workspaceGeneration);
        var originScope = ResolveScope();
        var originProfileGeneration = DatabaseRuntimeState.GetSnapshot().Generation;
        var completionSequence = definitionCompletionSequence;
        if (shell is not null && (shell.Scope != originScope || acceptedProfileGeneration != originProfileGeneration)) {
            shell = null;
            RetireDefinitionEditor();
            ResetManagerChatForSelectedRunChange();
            SynchronizeRouteSelections(force: true);
        } else if (selectedDefinitionKey is not null && shell?.DefinitionCatalog.SelectedDefinitionKey?.Value != selectedDefinitionKey) {
            RetireDefinitionEditor();
        }
        isBusy = true;
        errorMessage = definitionOutcomeUnknown ? UnknownAuthoringOutcome : null;

        try {
            var detailTabKey = ResolveRequestedDetailTabKey();
            var definitionLoadOptions = CreateDefinitionLoadOptions(detailTabKey);
            var runtimeLoadOptions = CreateRuntimeLoadOptions(detailTabKey);
            var runtimeQueryHistoryWindow = ResolveRuntimeHistoryWindow(detailTabKey);
            var shouldAutoSelectRuntimeRun = detailTabKey == ProcessWorkspaceDetailTabKey.ManagerChat ||
                (selectedRuntimeRunId ?? RunIdQuery).HasValue;
            var scope = ResolveScope();
            var request = new ProcessWorkspaceShellRequest(
                scope,
                new ProcessWorkspaceSelectionProjection(ProcessIdQuery, RunIdQuery, LaunchPlanIdQuery),
                new ProcessDefinitionCatalogQueryProjection(
                    searchText,
                    string.IsNullOrWhiteSpace(selectedDefinitionKey)
                        ? null
                        : new ProcessDefinitionCatalogItemKey(selectedDefinitionKey),
                    selectedDefinitionScope,
                    Take: 50),
                new ProcessTemplateCatalogQueryProjection(
                    templateSearchText,
                    selectedTemplateCategory,
                    selectedTemplateItemKey,
                    selectedTemplatePreviewTab,
                    Take: 50),
                forceRefresh,
                new ProcessRuntimeWorkspaceQueryProjection(
                    runtimeQueryHistoryWindow,
                    runtimeEventPage,
                    RuntimeEventPageSize,
                    selectedRuntimeRunId ?? RunIdQuery,
                    AutoSelectRun: shouldAutoSelectRuntimeRun,
                    TakeRuns: 50,
                    runtimeLoadOptions) {
                    PreviouslyLoadedRuns = ResolvePreviouslyLoadedRuns(
                        forceRefresh,
                        scope,
                        runtimeQueryHistoryWindow)
                },
                definitionLoadOptions) { ProjectBinding = shell?.ProjectBinding };

            var loadedShell = await ProjectionClient.GetShellAsync(request);
            if (!OwnsWorkspaceRead()) {
                return;
            }

            if (shell?.ProjectBinding != loadedShell.ProjectBinding ||
                shell?.DefinitionCatalog.SelectedDefinitionKey != loadedShell.DefinitionCatalog.SelectedDefinitionKey) {
                RetireDefinitionEditor();
                SynchronizeRouteSelections(force: true);
                ResetManagerChatForSelectedRunChange();
            } else {
                loadedShell = ReconcileDefinitionRead(loadedShell, completionSequence);
            }
            shell = loadedShell;
            acceptedProfileGeneration = originProfileGeneration;
            selectedRuntimeRunId = requiredRouteRunId is { } requestedRunId &&
                loadedShell.Runtime.SelectedRunId != requestedRunId
                    ? requestedRunId
                    : loadedShell.Runtime.SelectedRunId ?? selectedRuntimeRunId ?? RunIdQuery;
            if (!activeDetailTabInitialized) {
                activeDetailTabIndex = ResolveDetailTabIndex(ResolvePreferredDetailTab());
                activeDetailTabInitialized = true;
            }

            if (!HasUnresolvedNonRunRouteSelection &&
                (definitionLoadOptions.IncludeSelectedEditor || shell.DefinitionCatalog.SelectedEditor is not null)) {
                SyncDefinitionEditor(shell.DefinitionCatalog.SelectedEditor);
            }

            if (!HasUnresolvedNonRunRouteSelection &&
                (definitionLoadOptions.IncludeTemplateCatalog || shell.DefinitionCatalog.SelectedEditor?.TemplateCatalog is not null)) {
                SyncTemplateCatalogQuery(shell.DefinitionCatalog.SelectedEditor?.TemplateCatalog);
            }

            if (!HasUnresolvedRouteSelection &&
                activeDetailTabIndex == ResolveDetailTabIndex(ProcessWorkspaceDetailTabKey.ManagerChat)) {
                await EnsureManagerChatLoadedAsync();
            }
        } catch (Exception exception) when (exception is not OperationCanceledException) {
            if (!OwnsWorkspaceRead()) {
                return;
            }

            var retainAccepted = shell?.Scope == originScope && acceptedProfileGeneration == originProfileGeneration &&
                DatabaseRuntimeState.GetSnapshot().Generation == originProfileGeneration &&
                exception is TimeoutException or System.Data.Common.DbException { IsTransient: true };
            errorMessage = retainAccepted
                ? "Refresh failed. The last accepted projection remains visible; use Refresh to retry the read."
                : exception is ProcessProjectionAccessException access ? access.Message
                    : "The process workspace could not be read. Refresh to recheck its current scope and access.";
            if (!retainAccepted) {
                shell = null;
                RetireDefinitionEditor();
                SynchronizeRouteSelections(force: true);
            }
            Logger.LogWarning("Process projection read failed. ProjectId={ProjectId} FailureType={FailureType} Retained={Retained}.", originScope.ProjectId, exception.GetType().Name, retainAccepted);
        } finally {
            if (OwnsWorkspaceOperation(generation)) {
                isBusy = false;
            }
        }

        bool OwnsWorkspaceRead() => OwnsWorkspaceOperation(generation) && ResolveScope() == originScope &&
            DatabaseRuntimeState.GetSnapshot().Generation == originProfileGeneration;
    }

    private ProcessWorkspaceShellProjection ReconcileDefinitionRead(ProcessWorkspaceShellProjection observed, long completionSequence) {
        if (shell?.DefinitionCatalog.SelectedEditor is not { } current) {
            return observed;
        }
        var editor = observed.DefinitionCatalog.SelectedEditor ?? current;
        var pending = definitionOperation is not null || definitionOutcomeUnknown || completionSequence != definitionCompletionSequence;
        var definitionMismatch = current.LastCommandReceipt?.Status == ProcessDefinitionEditorCommandStatus.Accepted && editor.VersionToken != current.VersionToken;
        var roleMismatch = current.RoleEditor?.LastCommandReceipt?.Status == ProcessDefinitionRoleCommandStatus.Accepted &&
            editor.RoleEditor is { } roles && roles.VersionToken != current.RoleEditor.VersionToken;
        var stepMismatch = current.StepEditor?.LastCommandReceipt?.Status == ProcessDefinitionStepCommandStatus.Accepted &&
            editor.StepEditor is { } steps && steps.VersionToken != current.StepEditor.VersionToken;
        var canvasMismatch = current.Canvas?.LastCommandReceipt?.Status == ProcessDefinitionCanvasCommandStatus.Accepted &&
            editor.Canvas is { } canvas && canvas.VersionToken != current.Canvas.VersionToken;
        var templateMismatch = current.TemplateCatalog?.LastImportReceipt?.Status == ProcessTemplateImportCommandStatus.Accepted &&
            editor.TemplateCatalog is { } templates && templates.VersionToken != current.TemplateCatalog.VersionToken;
        if (!pending && (definitionMismatch || roleMismatch || stepMismatch || canvasMismatch || templateMismatch)) {
            errorMessage = "The command was accepted, but this read does not confirm its version. The accepted result and draft remain visible. Refresh retries observation only; no command was replayed.";
        }
        var reconciled = pending || definitionMismatch ? current : editor with {
            LastCommandReceipt = editor.LastCommandReceipt ?? current.LastCommandReceipt
        };
        reconciled = reconciled with {
            RoleEditor = (pending || roleMismatch ? current.RoleEditor : editor.RoleEditor) ?? editor.RoleEditor ?? current.RoleEditor,
            StepEditor = (pending || stepMismatch ? current.StepEditor : editor.StepEditor) ?? editor.StepEditor ?? current.StepEditor,
            Canvas = (pending || canvasMismatch ? current.Canvas : editor.Canvas) ?? editor.Canvas ?? current.Canvas,
            TemplateCatalog = editor.TemplateCatalog ?? current.TemplateCatalog
        };
        if (reconciled.RoleEditor is { } role && role.VersionToken == current.RoleEditor?.VersionToken) {
            reconciled = reconciled with { RoleEditor = role with { LastCommandReceipt = role.LastCommandReceipt ?? current.RoleEditor.LastCommandReceipt } };
        }
        if (reconciled.StepEditor is { } step && step.VersionToken == current.StepEditor?.VersionToken) {
            reconciled = reconciled with { StepEditor = step with { LastCommandReceipt = step.LastCommandReceipt ?? current.StepEditor.LastCommandReceipt } };
        }
        if (reconciled.Canvas is { } reconciledCanvas && reconciledCanvas.VersionToken == current.Canvas?.VersionToken) {
            reconciled = reconciled with { Canvas = reconciledCanvas with { LastCommandReceipt = reconciledCanvas.LastCommandReceipt ?? current.Canvas.LastCommandReceipt } };
        }
        if (reconciled.TemplateCatalog is { } catalog && current.TemplateCatalog is { } currentCatalog &&
            (pending || templateMismatch || catalog.VersionToken == currentCatalog.VersionToken)) {
            reconciled = reconciled with { TemplateCatalog = catalog with {
                VersionToken = currentCatalog.VersionToken,
                ImportedComponents = currentCatalog.ImportedComponents,
                LastImportReceipt = currentCatalog.LastImportReceipt
            } };
        }
        return observed with { DefinitionCatalog = observed.DefinitionCatalog with { SelectedEditor = reconciled } };
    }

    private void RetireDefinitionEditor() {
        definitionOperation = null;
        definitionOutcomeUnknown = false;
        pendingCanvasMove = null;
        definitionDraft = new();
        roleEditorState = new();
        templateBrowserState = new();
        stepEditorState = new();
        editorCommandNotice = null;
    }

    private ProcessWorkspaceShellScope ResolveScope()
        => ProjectId.HasValue
            ? ProcessWorkspaceShellScope.ForProject(ProjectId.Value)
            : ProcessWorkspaceShellScope.Global;

    private IReadOnlyList<ProcessLiveProcessSnapshot>? ResolvePreviouslyLoadedRuns(
        bool forceRefresh,
        ProcessWorkspaceShellScope scope,
        ProcessRuntimeHistoryWindow historyWindow)
        => !forceRefresh &&
           shell is { } loadedShell &&
           loadedShell.Scope == scope &&
           loadedShell.Runtime.HistoryWindow == historyWindow
            ? loadedShell.Runtime.ReusableRuns
            : null;

    private ProcessWorkspaceDetailTabKey ResolvePreferredDetailTab()
        => LiveRoute || RunIdQuery.HasValue || LaunchPlanIdQuery.HasValue
            ? ProcessWorkspaceDetailTabKey.Runs

        => selectedRuntimeRunId ?? shell?.Runtime.SelectedRunId ?? RunIdQuery;

    private readonly record struct ManagerChatOperationContext(long Generation, Guid? ProjectId,
        ProcessProjectionProjectBinding? ProjectBinding, Guid? RunId, Guid? AgentId, Guid? SessionId, Guid VoiceOwnerId);

    private ManagerChatOperationContext CaptureManagerChatContext()
        => new(Volatile.Read(ref managerChatLoadGeneration), ProjectId, shell?.ProjectBinding,
            ResolveSelectedManagerChatRunId(), managerChatAgentId, managerChatSessionId, managerChatVoiceOwnerId);

    private bool OwnsManagerChatOperation(ManagerChatOperationContext context)
        => !isDisposed && context.Generation == Volatile.Read(ref managerChatLoadGeneration);

    private bool IsCurrentManagerChatContext(ManagerChatOperationContext context)
        => OwnsManagerChatOperation(context) && shell is not null && context.ProjectId == ProjectId &&
            context.ProjectBinding == shell.ProjectBinding && context.RunId == ResolveSelectedManagerChatRunId() &&
            context.AgentId == managerChatAgentId && context.SessionId == managerChatSessionId &&
            context.VoiceOwnerId == managerChatVoiceOwnerId;

    private async Task<Guid?> ResolveManagerChatSessionIdAsync(
        IAgentFrameworkWorkspaceService workspaceService,
        Guid agentId,
        Guid? selectedRunId,
        Func<bool> isCurrent) {
        if (selectedRunId is null) {
            return managerChatSessionId;
        }

        var mapKey = BuildManagerChatSessionMapKey(agentId, selectedRunId.Value);
        if (managerChatSessionIdsByRun.TryGetValue(mapKey, out var cachedSessionId)) {
            return cachedSessionId;
        }

        var title = BuildManagerChatRunThreadTitle(selectedRunId.Value);
        var existingSession = (await workspaceService.ListChatSessionsAsync(agentId))
            .FirstOrDefault(session => string.Equals(session.Title, title, StringComparison.OrdinalIgnoreCase));
        if (!isCurrent()) {
            return null;
        }
        if (existingSession is not null) {
            managerChatSessionIdsByRun[mapKey] = existingSession.Id;
            return existingSession.Id;
        }

        var createdSession = await workspaceService.GetOrCreateChatSessionAsync(agentId);
        if (!isCurrent()) {
            return null;
        }
        var renamedSession = string.Equals(createdSession.Title, title, StringComparison.Ordinal)
            ? createdSession
            : await workspaceService.RenameChatSessionAsync(agentId, createdSession.Id, title);
        if (!isCurrent()) {
            return null;
        }
        managerChatSessionIdsByRun[mapKey] = renamedSession.Id;
        return renamedSession.Id;
    }

    private void TrackManagerChatSessionForRun(Guid agentId, Guid? selectedRunId, Guid? chatSessionId) {
        if (selectedRunId is null || chatSessionId is null) {
            return;
        }

        managerChatSessionIdsByRun[BuildManagerChatSessionMapKey(agentId, selectedRunId.Value)] = chatSessionId.Value;
    }


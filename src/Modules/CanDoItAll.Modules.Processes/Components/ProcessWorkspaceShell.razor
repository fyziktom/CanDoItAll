    private async Task ExecuteDefinitionCanvasCommandAsync(ProcessDefinitionCanvasCommand command) {
        command = command with { NodePositions = command.NodePositions?.ToArray() };
        if (command.CommandKind == ProcessDefinitionCanvasCommandKind.MoveNodes &&
            definitionOperation is { } pending && IsCurrentDefinitionEditorOperation(pending) &&
            command.DefinitionKey == pending.DefinitionKey && command.Scope == pending.Scope) {
            var positions = (pendingCanvasMove?.NodePositions ?? [])
                .Concat(command.NodePositions ?? [])
                .GroupBy(position => position.NodeKey)
                .Select(group => group.Last())
                .ToArray();
            pendingCanvasMove = command with { NodePositions = positions };
            return;
        }
        var operation = TryBeginDefinitionEditorOperation(command.DefinitionKey);
        if (operation is null) {
            return;
        }

        try {
            var result = await ProjectionClient.ExecuteDefinitionCanvasCommandAsync(command);
            if (!IsCurrentDefinitionEditorOperation(operation.Value)) {
                return;
            }
            definitionCompletionSequence++;

            ApplyDefinitionCanvasProjection(result.Projection);
        } catch (Exception exception) {
            RecordDefinitionOperationFailure(operation.Value, exception);
        } finally {
            await CompleteDefinitionEditorOperationAsync(operation.Value);
        }
    }


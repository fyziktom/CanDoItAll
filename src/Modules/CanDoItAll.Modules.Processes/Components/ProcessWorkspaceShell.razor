}

<AgentChatContextSurfaceProvider Surface="@agentChatContextPublication.Surface"
                                 ContributorPublications="@agentChatContextPublication.ContributorPublications"
                                 ContextNavigationIdentity="@AgentChatNavigationFence" />

<ChatWorkspacePanel Agent="@managerChatAgent"
                                    Session="@managerChatWorkspace?.SelectedSession"
                                    ActiveRun="@managerChatWorkspace?.SelectedRun"
                                    ExecutionLog="@managerChatExecutionLog"
                                    DraftPrompt="@managerChatDraftPrompt"
                                    DraftPromptChanged="HandleManagerChatDraftPromptChangedAsync"
                                    IsBusy="@(managerChatIsBusy || managerChatVoiceStarting)"
                                    ComposerKey="@managerChatComposerKey"
                                     RunStateText="@managerChatRunStateText"
                                     RunStateTone="@managerChatRunStateTone"
                                     PendingUserPrompt="@managerChatPendingPrompt"
                                     ActivityStreamId="@managerChatActivityStreamId"
                                     DraftAttachmentPaths="@managerChatDraftAttachmentPaths"
                                    CanUseVoiceMode="@CanUseManagerChatVoiceMode"
                                    IsVoiceModeEnabled="@managerChatVoiceModeEnabled"
                                    IsVoiceRecording="@managerChatVoiceRecording"
                                    IsVoiceTranscribing="@managerChatVoiceTranscribing"
                                    IsVoiceSpeaking="@managerChatVoiceSpeaking"
                                    VoiceStatusText="@managerChatVoiceStatusText"
                                    VoiceStatusTone="@managerChatVoiceStatusTone"
                                    SendRequested="SendManagerChatMessageAsync"
                                    ApprovalDecisionsRequested="HandleManagerChatApprovalDecisionsAsync"
                                    ApprovalDecisionForConversationRequested="ApproveManagerChatConversationAsync"
                                    AttachmentRequested="StageManagerChatRunArtifactsAsync"
                                    SessionTitleChanged="RenameManagerChatSessionAsync"
                                    VoiceModeChanged="HandleManagerChatVoiceModeChangedAsync"
                                    VoiceRecordingToggled="ToggleManagerChatVoiceRecordingAsync"
                                    SpeakLatestAssistantMessageRequested="SpeakLatestManagerChatAssistantMessageAsync"
                                    SelectionGeneration="workspaceGeneration">
    <ChildContent Context="chat">
        <ProcessWorkspaceSurface Session="@this" ManagerChat="chat" />
    </ChildContent>
</ChatWorkspacePanel>


    private void SyncDefinitionEditor(ProcessDefinitionEditorProjection? editor) {
        definitionDraft.Observe(editor);
        editorCommandNotice = editor?.LastCommandReceipt?.Summary;
    }

    private async Task ExecuteDefinitionEditorCommandAsync(ProcessDefinitionEditorCommandKind commandKind) {
        var editor = DefinitionCatalog.SelectedEditor;
        if (editor is null) {
            return;
        }

        var operation = TryBeginDefinitionEditorOperation(editor.DefinitionKey);
        if (operation is null) {
            return;
        }

        var submitted = definitionDraft.Capture();
        try {
            var result = await ProjectionClient.ExecuteDefinitionEditorCommandAsync(new ProcessDefinitionEditorCommand(
                ResolveScope(),
                editor.DefinitionKey,
                commandKind,
                definitionDraft.VersionToken,
                submitted));
            if (!IsCurrentDefinitionEditorOperation(operation.Value)) {
                return;
            }
            definitionCompletionSequence++;

            editorCommandNotice = result.Receipt.Summary;
            if (result.Receipt.Status == ProcessDefinitionEditorCommandStatus.Accepted) {
                definitionDraft.Accept(result.Projection, submitted);
            }
            ApplyDefinitionEditorProjection(result.Projection);
        } catch (Exception exception) {
            RecordDefinitionOperationFailure(operation.Value, exception);
        } finally {
            await CompleteDefinitionEditorOperationAsync(operation.Value);
        }
    }

    private void ApplyDefinitionEditorProjection(ProcessDefinitionEditorProjection projection) {
        if (shell?.DefinitionCatalog.SelectedEditor is not { } currentEditor ||
            currentEditor.DefinitionKey != projection.DefinitionKey) {
            return;
        }

        var selectedEditor = projection;
        if (selectedEditor.RoleEditor is null && currentEditor.RoleEditor is { } roleEditor) {
            selectedEditor = selectedEditor with { RoleEditor = roleEditor };
        }

        if (selectedEditor.Canvas is null && currentEditor.Canvas is { } canvas) {
            selectedEditor = selectedEditor with { Canvas = canvas };
        }

        if (selectedEditor.StepEditor is null && currentEditor.StepEditor is { } stepEditor) {
            selectedEditor = selectedEditor with { StepEditor = stepEditor };
        }

        if (selectedEditor.TemplateCatalog is null && currentEditor.TemplateCatalog is { } templateCatalog) {
            selectedEditor = selectedEditor with { TemplateCatalog = templateCatalog };
        }

        shell = shell with {
            DefinitionCatalog = shell.DefinitionCatalog with {
                SelectedDefinitionKey = selectedEditor.DefinitionKey,
                SelectedEditor = selectedEditor
            }
        };
        SyncDefinitionEditor(selectedEditor);
    }


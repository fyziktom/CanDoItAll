    private Guid? ResolveManagerAgentId(IReadOnlyList<AgentDefinition> agents, Guid? currentAgentId) {
        if (currentAgentId is { } current && agents.Any(agent => agent.Id == current)) {
            return current;
        }

        return agents
            .OrderByDescending(agent => agent.Name.Contains("process", StringComparison.OrdinalIgnoreCase))
            .ThenByDescending(agent => agent.Name.Contains("manager", StringComparison.OrdinalIgnoreCase))
            .ThenBy(agent => agent.Name, StringComparer.OrdinalIgnoreCase)
            .Select(agent => (Guid?)agent.Id)
            .FirstOrDefault();
    }


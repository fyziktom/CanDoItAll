    private async Task EnsureManagerChatLoadedAsync(bool forceReload = false) {
        if (forceReload && ManagerChatOperationActive) {
            return;
        }
        var selectedRunId = ResolveSelectedManagerChatRunId();
        var requestedAgentId = managerChatAgentId;
        if (!forceReload &&
            managerChatWorkspace is not null &&
            managerChatAgent is not null &&
            managerChatLoadedRunId == selectedRunId &&
            managerChatLoadedAgentId == managerChatAgentId) {
            return;
        }

        var workspaceService = ResolveManagerChatWorkspaceService();
        if (workspaceService is null) {
            managerChatErrorMessage = "Agent workspace service is not registered for this module instance.";
            return;
        }

        var referenceDataProvider = Services.GetService<IAgentReferenceDataProvider>();
        if (referenceDataProvider is null) {
            managerChatErrorMessage = "Agent reference data provider is not registered for this module instance.";
            return;
        }

        var generation = Interlocked.Increment(ref managerChatLoadGeneration);
        var operationContext = CaptureManagerChatContext();
        bool IsCurrent() => IsCurrentManagerChatContext(operationContext);
        managerChatIsLoading = true;
        managerChatErrorMessage = null;

        try {
            var referenceData = await referenceDataProvider.GetAsync(
                new AgentReferenceDataRequest(AgentReferenceDataSections.Agents));
            if (!IsCurrent()) {
                return;
            }
            var resolvedAgentId = ResolveManagerAgentId(referenceData.Agents, requestedAgentId);
            if (resolvedAgentId is null) {
                managerChatAgent = null;
                managerChatWorkspace = null;
                managerChatExecutionLog = [];
                managerChatErrorMessage = "No technical agent is available for process manager chat.";
                return;
            }

            var sessionId = await ResolveManagerChatSessionIdAsync(workspaceService, resolvedAgentId.Value, selectedRunId, IsCurrent);
            if (!IsCurrent()) {
                return;
            }
            var workspace = await workspaceService.GetChatAgentWorkspaceAsync(resolvedAgentId.Value, sessionId);
            if (!IsCurrent()) {
                return;
            }
            var runtimeSnapshot = await workspaceService.GetChatRuntimeSnapshotAsync(resolvedAgentId.Value, workspace.SelectedSessionId);
            if (!IsCurrent()) {
                return;
            }
            managerChatAgents = referenceData.Agents;
            managerChatAgentId = resolvedAgentId;
            managerChatAgent = managerChatAgents.First(agent => agent.Id == resolvedAgentId.Value);
            managerChatWorkspace = workspace;
            managerChatSessionId = workspace.SelectedSessionId;
            TrackManagerChatSessionForRun(resolvedAgentId.Value, selectedRunId, managerChatSessionId);
            managerChatExecutionLog = runtimeSnapshot.ExecutionLog;
            managerChatLoadedRunId = selectedRunId;
            managerChatLoadedAgentId = managerChatAgentId;
            ResolveManagerChatRunState();
            if (!CanUseManagerChatVoiceMode) {
                ResetManagerChatVoiceState();
            }
        } catch (Exception exception) when (exception is not OperationCanceledException) {
            if (!IsCurrent()) {
                return;
            }
            managerChatErrorMessage = exception.Message;
            managerChatWorkspace = null;
        } finally {
            if (generation == Volatile.Read(ref managerChatLoadGeneration)) {
                managerChatIsLoading = false;
            }
        }
    }


    private async Task ExecuteCommandAsync(ProcessWorkspaceCommandProjection command) {
        if (!command.IsEnabled) {
            return;
        }

        switch (command.Kind) {
            case ProcessWorkspaceCommandKind.RefreshProjections:
                await RefreshAsync();
                break;
            case ProcessWorkspaceCommandKind.OpenAgentContext:
                OpenAgentContext();
                break;
            case ProcessWorkspaceCommandKind.FeedDefaults:
                await FeedDefaultsAsync();
                break;
            case ProcessWorkspaceCommandKind.OpenLiveDashboard:
                Navigation.NavigateTo(ProjectId.HasValue
                    ? $"/projects/{ProjectId.Value:D}/processes/live"
                    : "/processes/live");
                break;
            case ProcessWorkspaceCommandKind.LaunchRun:
                if (CanStartAnotherLaunch) {
                    await StartNewProcessLaunchAsync();
                } else {
                    await LaunchSelectedDefinitionAsync();
                }
                break;
        }
    }

    private async Task LaunchSelectedDefinitionAsync() {
        var selectedDefinition = shell?.DefinitionCatalog.SelectedItem;
        if (selectedDefinition is null || WorkspaceBusy) {
            catalogCommandNotice = "Select a process definition before launching.";
            return;
        }
        var projectId = ProjectId;
        var definitionKey = selectedDefinition.Key.Value;
        var navigation = AgentChatNavigationFence;
        var generation = Interlocked.Increment(ref workspaceGeneration);
        isBusy = true;
        errorMessage = null;
        try {
            var launchService = Services.GetRequiredService<ProcessLaunchApplicationService>();
            var authorities = Services.GetRequiredService<IProcessLaunchOperatorAuthoritySource>();
            var preparations = Services.GetRequiredService<IProcessPreparedLaunchStore>();
            var caller = await authorities.CaptureLocalAsync(null, ProcessLaunchOperatorSurface.UserInterface);
            if (!OwnsWorkspaceOperation(generation)) {
                return;
            }
            var storageKey = $"candoitall.process-launch.workspace:{caller.DatabaseProfileId:D}:{projectId?.ToString("D") ?? "global"}:{definitionKey}";
            if (pendingLaunchStorageKey != storageKey) {
                pendingLaunchRequest = null;
                pendingLaunchAccepted = false;
                pendingLaunchStorageKey = storageKey;
            }
            ProcessLaunchRequest request;
            if (pendingLaunchStorageKey == storageKey && pendingLaunchRequest is { } retained) {
                request = retained;
            } else {
                var stored = await JsRuntime.InvokeAsync<string?>("sessionStorage.getItem", storageKey);
                if (!string.IsNullOrEmpty(stored)) {
                    if (!Guid.TryParse(stored, out var intentId) || intentId == Guid.Empty) {
                        throw new InvalidOperationException("The browser process launch identity is invalid; it requires reconciliation before another launch.");
                    }
                    var saved = await preparations.FindByIntentAsync(new(intentId))
                        ?? throw new InvalidOperationException($"Process launch intent {intentId:D} has no observable preparation yet. Retry observation after the original request completes.");
                    request = ProcessLaunchProducerRequests.Restore(saved, caller, execute: true);
                    if (request.ProjectId != projectId || request.DefinitionKey != definitionKey) {
                        throw new InvalidOperationException("The retained process preparation belongs to another workspace selection.");
                    }
                } else {
                    var authority = projectId is null ? caller
                        : await authorities.CaptureLocalAsync(projectId, ProcessLaunchOperatorSurface.UserInterface);
                    var variables = new Dictionary<string, string>(StringComparer.Ordinal) {
                        ["LaunchSource"] = projectId.HasValue ? "project-processes-ui" : "processes-ui"
                    };
                    if (projectId.HasValue) {
                        variables["ProjectId"] = projectId.Value.ToString("D");
                    }
                    request = new(definitionKey, null, null, projectId, null, "processes-ui", variables, true, true) {
                        CallerIntentId = new(Guid.NewGuid()),
                        Authority = authority,
                        ProjectAdmission = authority.ProjectAdmission
                    };
                }
            }
            if (!OwnsWorkspaceOperation(generation) || ProjectId != projectId || AgentChatNavigationFence != navigation || shell?.DefinitionCatalog.SelectedItem?.Key.Value != definitionKey) {
                return;
            }
            pendingLaunchRequest = request;
            pendingLaunchStorageKey = storageKey;
            await JsRuntime.InvokeVoidAsync("sessionStorage.setItem", storageKey, request.CallerIntentId!.Value.Value.ToString("D"));
            if (!OwnsWorkspaceOperation(generation) || ProjectId != projectId || AgentChatNavigationFence != navigation) {
                return;
            }
            var result = await launchService.LaunchAsync(request);
            if (OwnsWorkspaceOperation(generation) && result.RunId is not null && pendingLaunchStorageKey == storageKey) {
                pendingLaunchAccepted = true;
                pendingLaunchRequest = request with { PreparedAdmissionId = result.Observation?.AdmissionId ?? request.PreparedAdmissionId };
            }
            if (!OwnsWorkspaceOperation(generation) || ProjectId != projectId || AgentChatNavigationFence != navigation) {
                return;
            }
            catalogCommandNotice = result.RunId is { } runId
                ? $"Process {runId.Value:D} accepted. {string.Join(" ", result.Warnings)}".Trim()
                : result.Warnings.Count == 0 ? $"Launch {result.Stage}." : string.Join(" ", result.Warnings);
            var refresh = LoadAsync(forceRefresh: true);
            generation = Volatile.Read(ref workspaceGeneration);
            await refresh;
            if (OwnsWorkspaceOperation(generation) && ProjectId == projectId && AgentChatNavigationFence == navigation && result.RunId is not null && !string.IsNullOrWhiteSpace(result.Route)) {
                if (result.Observation is { ContinuationState: ProcessLaunchContinuationState.Started,
                        LinkDeliveryState: ProcessLaunchLinkDeliveryState.NotRequested or ProcessLaunchLinkDeliveryState.Delivered }) {
                    await JsRuntime.InvokeVoidAsync("sessionStorage.removeItem", storageKey);
                    if (OwnsWorkspaceOperation(generation) && pendingLaunchStorageKey == storageKey) {
                        pendingLaunchRequest = null;
                        pendingLaunchStorageKey = null;
                        pendingLaunchAccepted = false;
                    }
                }
                if (OwnsWorkspaceOperation(generation) && ProjectId == projectId && AgentChatNavigationFence == navigation) {
                    Navigation.NavigateTo(result.Route);
                }
            }
        } catch (Exception exception) when (exception is not OperationCanceledException) {
            if (OwnsWorkspaceOperation(generation) && ProjectId == projectId && AgentChatNavigationFence == navigation) {
                errorMessage = ProcessPublicReceiptTextPolicy.NormalizePublicMessage(exception.Message, "Process launch could not be completed. The retained intent will be reused on retry.");
            }
        } finally {
            if (OwnsWorkspaceOperation(generation)) {
                isBusy = false;
            }
        }
    }

    private async Task StartNewProcessLaunchAsync() {
        if (WorkspaceBusy || pendingLaunchStorageKey is not { } storageKey) {
            return;
        }
        var generation = Interlocked.Increment(ref workspaceGeneration);
        isBusy = true;
        try {
            await JsRuntime.InvokeVoidAsync("sessionStorage.removeItem", storageKey);
            if (!OwnsWorkspaceOperation(generation)) {
                return;
            }
            pendingLaunchRequest = null;
            pendingLaunchStorageKey = null;
            pendingLaunchAccepted = false;
            isBusy = false;
            await LaunchSelectedDefinitionAsync();
        } catch (Exception exception) when (exception is not OperationCanceledException) {
            if (OwnsWorkspaceOperation(generation)) {
                errorMessage = ProcessPublicReceiptTextPolicy.NormalizePublicMessage(exception.Message,
                    "The retained launch intent could not be cleared. Retry the explicit new launch action.");
            }
        } finally {
            if (OwnsWorkspaceOperation(generation)) {
                isBusy = false;
            }
        }
    }

    private bool OwnsWorkspaceOperation(long generation)
        => !isDisposed && generation == Volatile.Read(ref workspaceGeneration);


    private async Task ContinueManagerChatApprovalAsync(
        IReadOnlyList<PendingToolApprovalDecision>? decisions,
        bool autoApprovePendingToolCalls) {
        var workspaceService = ResolveManagerChatWorkspaceService();
        if (workspaceService is null || managerChatAgentId is null || managerChatSessionId is null || managerChatIsBusy || !ManagerChatReady) {
            return;
        }

        var pendingApprovals = managerChatWorkspace?.SelectedRun?.PendingApprovals ?? [];
        if (pendingApprovals.Count == 0) {
            return;
        }

        // Per-proposal decisions come from the panel unchanged; the
        // approve-remaining action explicitly approves every pending proposal.
        var effectiveDecisions = decisions
            ?? pendingApprovals
                .Select(item => new PendingToolApprovalDecision(item.ApprovalId, Approved: true))
                .ToArray();
        if (effectiveDecisions.Count == 0) {
            return;
        }

        var operationContext = CaptureManagerChatContext();
        managerChatIsBusy = true;
        try {
            var operation = ChatExecutionOrchestrator.StartApprovalContinuation(
                operationContext.AgentId!.Value,
                operationContext.SessionId!.Value,
                effectiveDecisions,
                autoApprovePendingToolCalls);
            managerChatActivityStreamId = operation.StreamId;
            await InvokeAsync(StateHasChanged);
            await operation.Completion;
            if (!IsCurrentManagerChatContext(operationContext)) {
                return;
            }
            var workspace = await workspaceService.GetChatAgentWorkspaceAsync(operationContext.AgentId.Value, operationContext.SessionId);
            if (!IsCurrentManagerChatContext(operationContext)) {
                return;
            }
            var runtimeSnapshot = await workspaceService.GetChatRuntimeSnapshotAsync(operationContext.AgentId.Value, operationContext.SessionId);
            if (!IsCurrentManagerChatContext(operationContext)) {
                return;
            }
            managerChatWorkspace = workspace;
            managerChatExecutionLog = runtimeSnapshot.ExecutionLog;
            ResolveManagerChatRunState();
        } catch (Exception exception) when (exception is not OperationCanceledException) {
            if (!IsCurrentManagerChatContext(operationContext)) {
                return;
            }
            managerChatErrorMessage = exception.Message;
        } finally {
            if (OwnsManagerChatOperation(operationContext)) {
                managerChatIsBusy = false;
            }
        }
    }

    private async Task RenameManagerChatSessionAsync(string title) {
        var workspaceService = ResolveManagerChatWorkspaceService();
        if (workspaceService is null || managerChatAgentId is null || managerChatSessionId is null || managerChatIsBusy || !ManagerChatReady) {
            return;
        }

        var operationContext = CaptureManagerChatContext();
        managerChatIsBusy = true;
        try {
            var session = await workspaceService.RenameChatSessionAsync(operationContext.AgentId!.Value, operationContext.SessionId!.Value, title);
            if (!IsCurrentManagerChatContext(operationContext)) {
                return;
            }
            var workspace = await workspaceService.GetChatAgentWorkspaceAsync(operationContext.AgentId.Value, session.Id);
            if (!IsCurrentManagerChatContext(operationContext)) {
                return;
            }
            managerChatSessionId = session.Id;
            TrackManagerChatSessionForRun(operationContext.AgentId.Value, operationContext.RunId, managerChatSessionId);
            managerChatWorkspace = workspace;
        } catch (Exception exception) when (exception is not OperationCanceledException) {
            if (!IsCurrentManagerChatContext(operationContext)) {
                return;
            }
            managerChatErrorMessage = exception.Message;
        } finally {
            if (OwnsManagerChatOperation(operationContext)) {
                managerChatIsBusy = false;
            }
        }
    }

    private async Task StageManagerChatRunArtifactsAsync() {
        var workspaceService = ResolveManagerChatWorkspaceService();
        if (workspaceService is null || managerChatWorkspace?.SelectedRun is null || !ManagerChatReady) {
            managerChatDraftAttachmentPaths = [];
            return;
        }

        var operationContext = CaptureManagerChatContext();
        var executionRunId = managerChatWorkspace.SelectedRun.Id;
        var detail = await workspaceService.GetExecutionRunDetailAsync(executionRunId);
        if (!IsCurrentManagerChatContext(operationContext) || managerChatWorkspace?.SelectedRun?.Id != executionRunId) {
            return;
        }
        managerChatDraftAttachmentPaths = detail.Artifacts
            .Select(item => item.RelativePath)
            .Where(item => !string.IsNullOrWhiteSpace(item))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }


    private DefinitionEditorOperationFence? TryBeginDefinitionEditorOperation(
        ProcessDefinitionCatalogItemKey definitionKey) {
        if (isDisposed || definitionOperation is not null || definitionOutcomeUnknown ||
            shell?.DefinitionCatalog.SelectedEditor is not { } currentEditor ||
            currentEditor.DefinitionKey != definitionKey || shell.Scope != ResolveScope() ||
            acceptedProfileGeneration != DatabaseRuntimeState.GetSnapshot().Generation) {
            return null;
        }

        var operation = new DefinitionEditorOperationFence(
            ++definitionOperationSequence,
            currentEditor.DefinitionKey,
            ResolveScope(),
            DatabaseRuntimeState.GetSnapshot().Generation,
            shell.ProjectBinding);
        definitionOperation = operation;
        errorMessage = null;
        return operation;
    }

    private bool IsCurrentDefinitionEditorOperation(DefinitionEditorOperationFence operation)
        => !isDisposed && definitionOperation == operation &&
           ResolveScope() == operation.Scope &&
           DatabaseRuntimeState.GetSnapshot().Generation == operation.ProfileGeneration &&
           shell?.ProjectBinding == operation.ProjectBinding &&
           shell?.DefinitionCatalog.SelectedEditor is { } currentEditor &&
           currentEditor.DefinitionKey == operation.DefinitionKey;

    private void RecordDefinitionOperationFailure(DefinitionEditorOperationFence operation, Exception exception) {
        if (!IsCurrentDefinitionEditorOperation(operation)) {
            return;
        }
        definitionOutcomeUnknown = true;
        errorMessage = UnknownAuthoringOutcome;
        pendingCanvasMove = null;
        Logger.LogWarning("Process authoring outcome is unknown. Operation={Operation} Definition={Definition} ProjectId={ProjectId} FailureType={FailureType}.",
            operation.Sequence, operation.DefinitionKey, operation.Scope.ProjectId, exception.GetType().Name);
    }

    private async Task CompleteDefinitionEditorOperationAsync(DefinitionEditorOperationFence operation) {
        if (!IsCurrentDefinitionEditorOperation(operation)) {
            return;
        }
        definitionOperation = null;
        if (!definitionOutcomeUnknown && pendingCanvasMove is { } move && shell?.DefinitionCatalog.SelectedEditor?.Canvas is { } canvas) {
            pendingCanvasMove = null;
            await ExecuteDefinitionCanvasCommandAsync(move with { ExpectedVersionToken = canvas.VersionToken });
        }
    }

    private readonly record struct DefinitionEditorOperationFence(
        long Sequence,
        ProcessDefinitionCatalogItemKey DefinitionKey,
        ProcessWorkspaceShellScope Scope,
        long ProfileGeneration,
        ProcessProjectionProjectBinding? ProjectBinding);


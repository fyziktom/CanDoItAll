        };

    private ProcessRuntimeWorkspaceLoadOptions CreateRuntimeLoadOptions(ProcessWorkspaceDetailTabKey detailTabKey) {
        var hasExplicitRuntimeSelection = (selectedRuntimeRunId ?? RunIdQuery).HasValue || LiveRoute || LaunchPlanIdQuery.HasValue;
        return detailTabKey switch {
            ProcessWorkspaceDetailTabKey.Runs => new ProcessRuntimeWorkspaceLoadOptions {
                IncludeSelectedRun = !SelectedRunViewNeedsMetrics,
                IncludeHistory = !SelectedRunViewNeedsMetrics,
                IncludeMetricHistory = SelectedRunViewNeedsMetrics,
                IncludeUsageTelemetry = SelectedRunViewNeedsMetrics,
                IncludeActiveAgents = SelectedRunViewNeedsActiveAgents
            },
            ProcessWorkspaceDetailTabKey.Graphs when !processGraphsHistoryLoaded => ProcessRuntimeWorkspaceLoadOptions.ListOnly,
            ProcessWorkspaceDetailTabKey.Graphs or ProcessWorkspaceDetailTabKey.Analytics => new ProcessRuntimeWorkspaceLoadOptions {
                IncludeSelectedRun = false,
                IncludeHistory = false,
                IncludeActiveAgents = false
            },
            ProcessWorkspaceDetailTabKey.ManagerChat => new ProcessRuntimeWorkspaceLoadOptions {
                LiveProcesses = ProcessLiveProcessesLoadOptions.SnapshotOnly,
                IncludeSelectedRun = true,
                IncludeHistory = false,
                IncludeMetricHistory = false,
                IncludeActiveAgents = false,
                IncludeUsageTelemetry = true
            },
            _ when hasExplicitRuntimeSelection => new ProcessRuntimeWorkspaceLoadOptions {
                IncludeMetricHistory = false,
                IncludeUsageTelemetry = false
            },
            _ => ProcessRuntimeWorkspaceLoadOptions.ListOnly
        };
    }


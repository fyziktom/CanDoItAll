@implements IProcessWorkspaceSession
@inject IProcessWorkspaceProjectionClient ProjectionClient
@inject IServiceProvider Services
@inject ICurrencyFormatter CurrencyFormatter
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@inject ILogger<ProcessWorkspaceShell> Logger
@inject IDatabaseRuntimeState DatabaseRuntimeState
@inject TimeProvider TimeProvider

    private async Task SendManagerChatMessageAsync() {
        var workspaceService = ResolveManagerChatWorkspaceService();
        if (workspaceService is null || managerChatAgentId is null || managerChatIsBusy || !ManagerChatReady) {
            managerChatErrorMessage = "Select a manager agent before sending a message.";
            return;
        }

        var prompt = managerChatDraftPrompt.Trim();
        if (string.IsNullOrWhiteSpace(prompt)) {
            managerChatErrorMessage = "Enter a manager prompt before sending.";
            return;
        }

        var operationContext = CaptureManagerChatContext();
        managerChatIsBusy = true;
        managerChatPendingPrompt = managerChatDraftPrompt;
        var previousDraft = managerChatDraftPrompt;
        managerChatDraftPrompt = string.Empty;
        managerChatComposerKey++;

        try {
            var disableManagerTelemetryTools = ProcessManagerChatPromptClassifier.ShouldDisableRuntimeTools(previousDraft);
            var operation = ChatExecutionOrchestrator.StartSendMessage(
                new AgentChatSendRequest(
                    operationContext.AgentId!.Value,
                    operationContext.SessionId,
                    prompt) {
                    AttachmentPaths = managerChatDraftAttachmentPaths,
                    Behavior = disableManagerTelemetryTools
                        ? new AgentChatExecutionBehavior(
                            RuntimeToolProvidersEnabled: false,
                            WorkspaceToolsEnabled: false)
                        : AgentChatExecutionBehavior.Default
                });
            managerChatActivityStreamId = operation.StreamId;
            await InvokeAsync(StateHasChanged);
            var result = await operation.Completion;
            if (!IsCurrentManagerChatContext(operationContext)) {
                return;
            }
            var workspace = await workspaceService.GetChatAgentWorkspaceAsync(operationContext.AgentId.Value, result.ChatSessionId);
            if (!IsCurrentManagerChatContext(operationContext)) {
                return;
            }
            var runtimeSnapshot = await workspaceService.GetChatRuntimeSnapshotAsync(operationContext.AgentId.Value, result.ChatSessionId);
            if (!IsCurrentManagerChatContext(operationContext)) {
                return;
            }
            managerChatSessionId = result.ChatSessionId;
            TrackManagerChatSessionForRun(operationContext.AgentId.Value, operationContext.RunId, managerChatSessionId);
            managerChatDraftAttachmentPaths = [];
            managerChatWorkspace = workspace;
            managerChatExecutionLog = runtimeSnapshot.ExecutionLog;
            ResolveManagerChatRunState();
            managerChatErrorMessage = null;
            if (managerChatVoiceModeEnabled && !string.IsNullOrWhiteSpace(result.AssistantMessage.Content)) {
                await SpeakManagerChatTextAsync(result.AssistantMessage.Content);
            }
        } catch (Exception exception) when (exception is not OperationCanceledException) {
            if (!IsCurrentManagerChatContext(operationContext)) {
                return;
            }
            managerChatDraftPrompt = previousDraft;
            managerChatComposerKey++;
            managerChatErrorMessage = exception.Message;
        } finally {
            if (OwnsManagerChatOperation(operationContext)) {
                managerChatPendingPrompt = string.Empty;
                managerChatIsBusy = false;
            }
        }
    }


    public async ValueTask DisposeAsync() {
        if (isDisposed) {
            return;
        }

        isDisposed = true;
        RetireDefinitionEditor();
        agentChatFreshnessLease?.Dispose();
        agentChatFreshnessLease = null;
        await Task.WhenAll(managerChatVoiceCleanup, DisposeManagerChatVoiceOwnerAsync(managerChatVoiceOwnerId));
    }



    private async Task DispatchViewActionAsync(Func<Task> action) {
        if (isDisposed) {
            return;
        }
        var pending = action();
        StateHasChanged();
        try {
            await pending;
        } finally {
            if (!isDisposed) {
                StateHasChanged();
            }
        }
    }

    private void DispatchViewAction(Action action) {
        if (!isDisposed) {
            action();
            StateHasChanged();
        }
    }


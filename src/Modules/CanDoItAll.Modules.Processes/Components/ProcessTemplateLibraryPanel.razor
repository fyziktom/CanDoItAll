@namespace CanDoItAll.Modules.Processes
@using CanDoItAll.Processes.Projections

<div class="mt-6 border-t border-slate-200 pt-5" data-testid="processes-template-library">
    <Split Gap="LayoutGap.Small">
        <Stack GapScale="LayoutGap.Tiny">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Templates" />
            <h3 class="text-sm font-semibold text-slate-900">Template library</h3>
            <p class="text-sm leading-6 text-slate-600">@TemplateCatalog.CanonicalSourceSummary</p>
        </Stack>
        <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
            <StatusBadge Tone="info" Text="@($"{TemplateCatalog.Items.Count} item(s)")" />
            <StatusBadge Tone="neutral" Text="@TemplateCatalog.PackVersion" />
            <StatusBadge Tone="success" Text="@($"{TemplateCatalog.ImportedComponents.Count} imported")" />
        </Cluster>
    </Split>

    @if (TemplateCatalog.LastImportReceipt is not null)
    {
        <p class="mt-3 text-xs font-semibold text-slate-500" data-testid="processes-template-library-import-receipt">
            @($"{TemplateCatalog.LastImportReceipt.Status}: {TemplateCatalog.LastImportReceipt.Summary}")
        </p>
    }

    <Grid Gap="LayoutGap.Large" ColumnsLg="3" Class="mt-5" data-testid="processes-template-library-layout">
        <Stack GapScale="LayoutGap.Small" data-testid="processes-template-library-browser">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Browse" />
            <input class="min-h-9 w-full rounded-md border border-slate-300 px-3 text-sm text-slate-900 shadow-sm"
                   value="@pendingSearchText"
                   @oninput="args => pendingSearchText = ReadChangeValue(args)"
                   placeholder="Search templates, roles, artifacts"
                   aria-label="Search templates"
                   data-testid="processes-template-library-search" />
            <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                <Button Text="Search"
                        Icon="search"
                        Size="ButtonSize.Small"
                        ButtonStyle="ButtonStyle.Primary"
                        Disabled="@Disabled"
                        Click="ApplySearchAsync"
                        data-testid="processes-template-library-search-submit" />
                <Button Text="Clear"
                        Icon="close"
                        Size="ButtonSize.Small"
                        ButtonStyle="ButtonStyle.Light"
                        Disabled="@Disabled"
                        Click="ClearSearchAsync"
                        data-testid="processes-template-library-search-clear" />
            </Cluster>

            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Category" />
            @foreach (var category in TemplateCatalog.Categories)
            {
                <Button Text="@($"{category.Label} ({category.Count})")"
                        Icon="@ResolveCategoryIcon(category.Kind)"
                        Size="ButtonSize.Small"
                        ButtonStyle="@(category.IsSelected ? ButtonStyle.Primary : ButtonStyle.Light)"
                        Disabled="@Disabled"
                        Click="@(() => SelectCategoryAsync(category.Kind))"
                        title="@category.Description"
                        data-testid="@BuildCategoryTestId(category.Kind)" />
            }

            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Results" />
            @if (TemplateCatalog.Items.Count == 0)
            {
                <EmptyState Eyebrow="No templates"
                            Title="No template items match"
                            Description="Clear the search or select a broader category." />
            }
            else
            {
                @foreach (var item in TemplateCatalog.Items)
                {
                    <Button Text="@item.Title"
                            Icon="@ResolveItemIcon(item.Kind)"
                            Size="ButtonSize.Small"
                            ButtonStyle="@(item.IsSelected ? ButtonStyle.Primary : ButtonStyle.Light)"
                            Disabled="@Disabled"
                            Click="@(() => SelectItemAsync(item.Key))"
                            data-testid="@BuildItemTestId(item.Key)" />
                    <p class="text-xs leading-5 text-slate-500">@item.Summary</p>
                    <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                        <StatusBadge Tone="neutral" Text="@item.CategoryLabel" />
                        @foreach (var fact in item.Facts.Take(2))
                        {
                            <StatusBadge Tone="@ResolveFactTone(fact)" Text="@($"{fact.Label}: {fact.Value}")" />
                        }
                    </Cluster>
                }
            }
        </Stack>

        <Stack GapScale="LayoutGap.Small" Class="lg:col-span-2" data-testid="processes-template-library-preview">
            @if (TemplateCatalog.Preview is null || TemplateCatalog.SelectedItem is null)
            {
                <EmptyState Eyebrow="Preview"
                            Title="Select a template item"
                            Description="Template previews include generated Markdown, generated Mermaid, canonical JSON, and a structure tree." />
            }
            else
            {
                var preview = TemplateCatalog.Preview;
                <Split Gap="LayoutGap.Small">
                    <Stack GapScale="LayoutGap.Tiny">
                        <TextBlock TextStyle="TextStyle.Eyebrow" Value="@TemplateCatalog.SelectedItem.CategoryLabel" />
                        <h4 class="text-sm font-semibold text-slate-900">@preview.Title</h4>
                        <p class="text-sm leading-6 text-slate-600">@preview.Summary</p>
                        <p class="text-xs leading-5 text-slate-500">@preview.GeneratedProjectionNotice</p>
                    </Stack>
                    <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                        <StatusBadge Tone="neutral" Text="@preview.SourceJsonRelativePath" />
                        <StatusBadge Tone="info" Text="@preview.SourceJsonHash" />
                    </Cluster>
                </Split>

                <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                    @foreach (var tab in PreviewTabs)
                    {
                        <Button Text="@ResolvePreviewTabText(tab)"
                                Icon="@ResolvePreviewTabIcon(tab)"
                                Size="ButtonSize.Small"
                                ButtonStyle="@(TemplateCatalog.Query.PreviewTab == tab ? ButtonStyle.Primary : ButtonStyle.Light)"
                                Disabled="@Disabled"
                                Click="@(() => SelectPreviewTabAsync(tab))"
                                data-testid="@BuildPreviewTabTestId(tab)" />
                    }
                </Cluster>

                @RenderPreview(preview)

                <Grid Gap="LayoutGap.Small" ColumnsMd="2">
                    <Stack GapScale="LayoutGap.Small" data-testid="processes-template-library-imports">
                        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Import" />
                        @if (ShouldShowTargetStepPicker(preview))
                        {
                            @RenderTargetStepPicker()
                        }
                        @if (TemplateCatalog.SelectedItem.Kind == ProcessTemplateCatalogItemKind.Process)
                        {
                            <Button Text="Import process"
                                    Icon="account_tree"
                                    Size="ButtonSize.Small"
                                    ButtonStyle="ButtonStyle.Success"
                                    Disabled="@(Disabled || !CanImport(ProcessTemplateImportCommandKind.ImportProcess))"
                                    Click="@(() => ExecuteImportAsync(ProcessTemplateImportCommandKind.ImportProcess, TemplateCatalog.SelectedItem.Key))"
                                    data-testid="processes-template-library-import-process" />
                        }
                        else if (TemplateCatalog.SelectedItem.Kind == ProcessTemplateCatalogItemKind.Role)
                        {
                            <Button Text="Import role"
                                    Icon="badge"
                                    Size="ButtonSize.Small"
                                    ButtonStyle="ButtonStyle.Success"
                                    Disabled="@(Disabled || !CanImport(ProcessTemplateImportCommandKind.ImportRole))"
                                    Click="@(() => ExecuteImportAsync(ProcessTemplateImportCommandKind.ImportRole, TemplateCatalog.SelectedItem.Key))"
                                    data-testid="processes-template-library-import-role" />
                        }
                        else if (TemplateCatalog.SelectedItem.Kind == ProcessTemplateCatalogItemKind.Artifact)
                        {
                            <Button Text="Import artifact"
                                    Icon="inventory_2"
                                    Size="ButtonSize.Small"
                                    ButtonStyle="ButtonStyle.Success"
                                    Disabled="@(Disabled || !CanImport(ProcessTemplateImportCommandKind.ImportArtifact))"
                                    Click="@(() => ExecuteImportAsync(ProcessTemplateImportCommandKind.ImportArtifact, TemplateCatalog.SelectedItem.Key))"
                                    data-testid="processes-template-library-import-artifact" />
                        }
                    </Stack>

                    <Stack GapScale="LayoutGap.Small" data-testid="processes-template-library-related">
                        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Related components" />
                        @if (preview.RelatedComponents.Count == 0)
                        {
                            <p class="text-sm leading-6 text-slate-600">No related role or artifact components are projected for this template.</p>
                        }
                        else
                        {
                            @foreach (var related in preview.RelatedComponents)
                            {
                                <div class="rounded-md border border-slate-200 bg-slate-50 p-3" data-testid="@BuildRelatedTestId(related.Key)">
                                    <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                                        <StatusBadge Tone="neutral" Text="@related.Kind.ToString()" />
                                        @if (related.IsImported)
                                        {
                                            <StatusBadge Tone="success" Text="Imported" />
                                        }
                                    </Cluster>
                                    <p class="mt-2 text-sm font-semibold text-slate-900">@related.Title</p>
                                    <p class="text-xs leading-5 text-slate-500">@related.Summary</p>
                                    @if (related.Kind == ProcessTemplateCatalogItemKind.Role)
                                    {
                                        <Button Text="Import role"
                                                Icon="badge"
                                                Size="ButtonSize.Small"
                                                ButtonStyle="ButtonStyle.Light"
                                                Disabled="@Disabled"
                                                Click="@(() => ExecuteImportAsync(ProcessTemplateImportCommandKind.ImportRole, related.Key))"
                                                data-testid="@BuildRelatedImportTestId(ProcessTemplateImportCommandKind.ImportRole, related.Key)" />
                                    }
                                    else if (related.Kind == ProcessTemplateCatalogItemKind.Artifact)
                                    {
                                        <Button Text="Import artifact"
                                                Icon="inventory_2"
                                                Size="ButtonSize.Small"
                                                ButtonStyle="ButtonStyle.Light"
                                                Disabled="@(Disabled || selectedTargetStepKey is null)"
                                                Click="@(() => ExecuteImportAsync(ProcessTemplateImportCommandKind.ImportArtifact, related.Key))"
                                                data-testid="@BuildRelatedImportTestId(ProcessTemplateImportCommandKind.ImportArtifact, related.Key)" />
                                    }
                                </div>
                            }
                        }
                    </Stack>
                </Grid>
            }
        </Stack>
    </Grid>
</div>

@code {
    private static readonly ProcessTemplateCatalogPreviewTabKind[] PreviewTabs =
    [
        ProcessTemplateCatalogPreviewTabKind.Overview,
        ProcessTemplateCatalogPreviewTabKind.Markdown,
        ProcessTemplateCatalogPreviewTabKind.Diagram,
        ProcessTemplateCatalogPreviewTabKind.Json,
        ProcessTemplateCatalogPreviewTabKind.Structure
    ];

    [Parameter, EditorRequired]
    public ProcessTemplateCatalogProjection TemplateCatalog { get; set; } = default!;

    [Parameter, EditorRequired]
    public ProcessWorkspaceShellScope Scope { get; set; } = default!;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<ProcessTemplateCatalogQueryProjection> QueryChanged { get; set; }

    [Parameter]
    public EventCallback<ProcessTemplateImportCommand> ExecuteImport { get; set; }

    private ProcessTemplateCatalogVersionToken? syncedVersionToken;
    private ProcessTemplateCatalogQueryProjection? syncedQuery;
    private string pendingSearchText = string.Empty;
    private ProcessDefinitionStepKey? selectedTargetStepKey;

    protected override void OnParametersSet()
    {
        if (syncedVersionToken == TemplateCatalog.VersionToken &&
            Equals(syncedQuery, TemplateCatalog.Query))
        {
            return;
        }

        syncedVersionToken = TemplateCatalog.VersionToken;
        syncedQuery = TemplateCatalog.Query;
        pendingSearchText = TemplateCatalog.Query.SearchText ?? string.Empty;
        selectedTargetStepKey = TemplateCatalog.ImportTargets.FirstOrDefault(target => target.IsDefaultTarget)?.StepKey ??
                                TemplateCatalog.ImportTargets.FirstOrDefault()?.StepKey;
    }

    private Task ApplySearchAsync()
        => QueryChanged.InvokeAsync(TemplateCatalog.Query with
        {
            SearchText = pendingSearchText.Trim(),
            SelectedItemKey = null
        });

    private Task ClearSearchAsync()
    {
        pendingSearchText = string.Empty;
        return QueryChanged.InvokeAsync(TemplateCatalog.Query with
        {
            SearchText = string.Empty,
            SelectedItemKey = null
        });
    }

    private Task SelectCategoryAsync(ProcessTemplateCatalogCategoryKind category)
        => QueryChanged.InvokeAsync(TemplateCatalog.Query with
        {
            Category = category,
            SelectedItemKey = null
        });

    private Task SelectItemAsync(ProcessTemplateCatalogItemKey itemKey)
        => QueryChanged.InvokeAsync(TemplateCatalog.Query with
        {
            SelectedItemKey = itemKey,
            PreviewTab = ProcessTemplateCatalogPreviewTabKind.Overview
        });

    private Task SelectPreviewTabAsync(ProcessTemplateCatalogPreviewTabKind tab)
        => QueryChanged.InvokeAsync(TemplateCatalog.Query with
        {
            PreviewTab = tab
        });

    private Task ExecuteImportAsync(
        ProcessTemplateImportCommandKind commandKind,
        ProcessTemplateCatalogItemKey itemKey)
        => ExecuteImport.InvokeAsync(new ProcessTemplateImportCommand(
            Scope,
            TemplateCatalog.TargetDefinitionKey,
            commandKind,
            itemKey,
            TemplateCatalog.VersionToken,
            TemplateCatalog.Query,
            commandKind == ProcessTemplateImportCommandKind.ImportArtifact ? selectedTargetStepKey : null));

    private bool CanImport(ProcessTemplateImportCommandKind commandKind)
        => TemplateCatalog.Commands.Any(command => command.Kind == commandKind && command.IsEnabled);

    private bool ShouldShowTargetStepPicker(ProcessTemplateCatalogPreviewProjection preview)
        => TemplateCatalog.ImportTargets.Count > 0 &&
           (TemplateCatalog.SelectedItem?.Kind == ProcessTemplateCatalogItemKind.Artifact ||
            preview.RelatedComponents.Any(component => component.Kind == ProcessTemplateCatalogItemKind.Artifact));

    private RenderFragment RenderPreview(ProcessTemplateCatalogPreviewProjection preview) => @<div class="rounded-md border border-slate-200 bg-slate-50 p-3" data-testid="@BuildPreviewContentTestId(TemplateCatalog.Query.PreviewTab)">
        @switch (TemplateCatalog.Query.PreviewTab)
        {
            case ProcessTemplateCatalogPreviewTabKind.Overview:
                <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                    <StatusBadge Tone="neutral" Text="@preview.Kind.ToString()" />
                    <StatusBadge Tone="info" Text="@($"{preview.RelatedComponents.Count} related")" />
                    <StatusBadge Tone="success" Text="@($"{TemplateCatalog.ImportTargets.Count} target step(s)")" />
                </Cluster>
                <p class="mt-3 text-sm leading-6 text-slate-700">@preview.Summary</p>
                break;
            case ProcessTemplateCatalogPreviewTabKind.Markdown:
                <pre class="max-h-96 overflow-auto whitespace-pre-wrap break-words text-xs leading-5 text-slate-700" data-testid="processes-template-library-markdown">@preview.GeneratedMarkdown</pre>
                break;
            case ProcessTemplateCatalogPreviewTabKind.Diagram:
                <pre class="max-h-96 overflow-auto whitespace-pre-wrap break-words text-xs leading-5 text-slate-700" data-testid="processes-template-library-diagram">@preview.GeneratedMermaid</pre>
                break;
            case ProcessTemplateCatalogPreviewTabKind.Json:
                <pre class="max-h-96 overflow-auto whitespace-pre-wrap break-words text-xs leading-5 text-slate-700" data-testid="processes-template-library-json">@preview.CanonicalJson</pre>
                break;
            case ProcessTemplateCatalogPreviewTabKind.Structure:
                <ul role="tree" aria-label="Template structure" class="space-y-2" data-testid="processes-template-library-structure">
                    @foreach (var node in preview.Structure)
                    {
                        <li role="treeitem"
                            class="rounded border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700"
                            style="@($"margin-left:{node.Depth * 0.75}rem")">
                            <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                                <StatusBadge Tone="neutral" Text="@node.Kind.ToString()" />
                                <span class="font-semibold text-slate-900">@node.Title</span>
                            </Cluster>
                            @if (!string.IsNullOrWhiteSpace(node.Summary))
                            {
                                <p class="mt-1 text-xs leading-5 text-slate-500">@node.Summary</p>
                            }
                        </li>
                    }
                </ul>
                break;
        }
    </div>;

    private RenderFragment RenderTargetStepPicker() => @<Stack GapScale="LayoutGap.Tiny">
        <label class="text-xs font-semibold text-slate-500" for="processes-template-library-artifact-target-input">Artifact target step</label>
        <select id="processes-template-library-artifact-target-input"
                class="min-h-9 w-full rounded-md border border-slate-300 px-3 text-sm text-slate-900 shadow-sm"
                value="@selectedTargetStepKey?.Value"
                @onchange="UpdateTargetStep"
                data-testid="processes-template-library-artifact-target">
            @foreach (var target in TemplateCatalog.ImportTargets)
            {
                <option value="@target.StepKey.Value">@target.Title</option>
            }
        </select>
    </Stack>;

    private void UpdateTargetStep(ChangeEventArgs args)
    {
        var value = ReadChangeValue(args);
        selectedTargetStepKey = string.IsNullOrWhiteSpace(value)
            ? null
            : new ProcessDefinitionStepKey(value);
    }

    private static string ReadChangeValue(ChangeEventArgs args)
        => args.Value?.ToString() ?? string.Empty;

    private static string ResolveCategoryIcon(ProcessTemplateCatalogCategoryKind category)
        => category switch
        {
            ProcessTemplateCatalogCategoryKind.All => "select_all",
            ProcessTemplateCatalogCategoryKind.Processes => "account_tree",
            ProcessTemplateCatalogCategoryKind.Roles => "badge",
            ProcessTemplateCatalogCategoryKind.Artifacts => "inventory_2",
            _ => "category"
        };

    private static string ResolveItemIcon(ProcessTemplateCatalogItemKind kind)
        => kind switch
        {
            ProcessTemplateCatalogItemKind.Process => "account_tree",
            ProcessTemplateCatalogItemKind.Role => "badge",
            ProcessTemplateCatalogItemKind.Artifact => "inventory_2",
            _ => "category"
        };

    private static string ResolvePreviewTabText(ProcessTemplateCatalogPreviewTabKind tab)
        => tab switch
        {
            ProcessTemplateCatalogPreviewTabKind.Overview => "Overview",
            ProcessTemplateCatalogPreviewTabKind.Markdown => "Markdown",
            ProcessTemplateCatalogPreviewTabKind.Diagram => "Diagram",
            ProcessTemplateCatalogPreviewTabKind.Json => "JSON",
            ProcessTemplateCatalogPreviewTabKind.Structure => "Structure",
            _ => "Preview"
        };

    private static string ResolvePreviewTabIcon(ProcessTemplateCatalogPreviewTabKind tab)
        => tab switch
        {
            ProcessTemplateCatalogPreviewTabKind.Overview => "info",
            ProcessTemplateCatalogPreviewTabKind.Markdown => "article",
            ProcessTemplateCatalogPreviewTabKind.Diagram => "schema",
            ProcessTemplateCatalogPreviewTabKind.Json => "data_object",
            ProcessTemplateCatalogPreviewTabKind.Structure => "account_tree",
            _ => "preview"
        };

    private static string ResolveFactTone(ProcessTemplateCatalogFactProjection fact)
        => string.Equals(fact.Label, "Import", StringComparison.OrdinalIgnoreCase) ? "success" : "neutral";

    private static string BuildCategoryTestId(ProcessTemplateCatalogCategoryKind category)
        => category switch
        {
            ProcessTemplateCatalogCategoryKind.All => "processes-template-library-category-all",
            ProcessTemplateCatalogCategoryKind.Processes => "processes-template-library-category-processes",
            ProcessTemplateCatalogCategoryKind.Roles => "processes-template-library-category-roles",
            ProcessTemplateCatalogCategoryKind.Artifacts => "processes-template-library-category-artifacts",
            _ => $"processes-template-library-category-{NormalizeForTestId(category.ToString())}"
        };

    private static string BuildItemTestId(ProcessTemplateCatalogItemKey key)
        => $"processes-template-library-item-{NormalizeForTestId(key.Value)}";

    private static string BuildRelatedTestId(ProcessTemplateCatalogItemKey key)
        => $"processes-template-library-related-{NormalizeForTestId(key.Value)}";

    private static string BuildRelatedImportTestId(
        ProcessTemplateImportCommandKind kind,
        ProcessTemplateCatalogItemKey key)
        => kind switch
        {
            ProcessTemplateImportCommandKind.ImportRole => $"processes-template-library-import-role-{NormalizeForTestId(key.Value)}",
            ProcessTemplateImportCommandKind.ImportArtifact => $"processes-template-library-import-artifact-{NormalizeForTestId(key.Value)}",
            _ => $"processes-template-library-import-{NormalizeForTestId(key.Value)}"
        };

    private static string BuildPreviewTabTestId(ProcessTemplateCatalogPreviewTabKind tab)
        => $"processes-template-library-preview-tab-{NormalizeForTestId(tab.ToString())}";

    private static string BuildPreviewContentTestId(ProcessTemplateCatalogPreviewTabKind tab)
        => $"processes-template-library-preview-{NormalizeForTestId(tab.ToString())}";

    private static string NormalizeForTestId(string value)
    {
        var normalized = new string(value
            .Select(character => char.IsLetterOrDigit(character) ? char.ToLowerInvariant(character) : '-')
            .ToArray())
            .Trim('-');
        return string.IsNullOrWhiteSpace(normalized) ? "item" : normalized;
    }
}

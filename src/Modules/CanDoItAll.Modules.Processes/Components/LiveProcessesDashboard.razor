@using static CanDoItAll.Processes.UI.ProcessRuntimeDisplay
@namespace CanDoItAll.Modules.Processes
@using System.Globalization
@using System.Text.Json
@using CanDoItAll.AgentFramework.Components
@using CanDoItAll.AgentFramework.Models
@using CanDoItAll.Infrastructure.Configuration
@using CanDoItAll.Infrastructure.Persistence
@using CanDoItAll.Modules.Processes.AgentChat
@using CanDoItAll.Processes.Abstractions
@using CanDoItAll.Processes.Application
@using CanDoItAll.Processes.Projections
@using CanDoItAll.Processes.Runtime
@using Microsoft.JSInterop
@implements IDisposable
@implements ILiveProcessesSession
@inject IProcessWorkspaceProjectionClient ProjectionClient
@inject ProcessWorkspaceMockProjectionFactory MockProjectionFactory
@inject ICurrencyFormatter CurrencyFormatter
@inject NavigationManager Navigation
@inject NotificationService Notifications
@inject TooltipService TooltipService
@inject IJSRuntime JsRuntime
@inject IDatabaseRuntimeState DatabaseRuntimeState
@inject TimeProvider TimeProvider
@inject ILogger<LiveProcessesDashboard> Logger

<PageTitle>@PageTitleText</PageTitle>

@{
    var agentChatContextPublication = ResolveAgentChatPublication();
}

<AgentChatContextSurfaceProvider Surface="@agentChatContextPublication.Surface"
                                 ContributorPublications="@agentChatContextPublication.ContributorPublications"
                                 ContextNavigationIdentity="@AgentChatNavigationFence" />

<LiveProcessesSurface Session="@this">
    <CancellationContent>
        @if (runDetailDialogOpen && runDetailSnapshot is not null && !IsMockProjection) {
            <ProcessRunCancellationAction @key="(runDetailSnapshot.RunId, shell?.ProjectBinding)"
                                                  RunId="@runDetailSnapshot.RunId" Status="@runDetailSnapshot.Status"
                                                  CancellationCommitted="RefreshCancelledRunAsync" />
        }
    </CancellationContent>
</LiveProcessesSurface>

@if (filesRunId is Guid activeFilesRunId) {
    <ProcessRunFilesDialog IsOpen="true"
                           RunId="activeFilesRunId"
                           Closed="CloseRunFilesAsync" />
}

@code {
    private const string HiddenRunGroupsStorageKey = "candoitall.live-processes.hidden-run-groups.v2";
    private const string LegacyHiddenRunGroupsStorageKeyPrefix = "candoitall.live-processes.hidden-run-groups";
    private static readonly TimeSpan HiddenRunGroupRetention = TimeSpan.FromDays(30);
    private static readonly JsonSerializerOptions HiddenRunGroupsJsonOptions = new(JsonSerializerDefaults.Web);

    private sealed record HiddenRunGroupEntry(Guid RunGroupId, DateTimeOffset HiddenAtUtc);

    private CdaChartOptions RuntimeCostChartOptions => new() {
        Type = CdaChartType.Area,
        XAxisType = CdaChartAxisType.DateTime,
        YAxisTitle = CurrencyFormatter.CurrencyCode,
        TooltipPrecision = 4,
        ValuePrecision = 4,
        FillOpacity = 0.2,
        ShowToolbar = false,
        EnableZoom = false,
        LegendPosition = CdaChartLegendPosition.Bottom,
        Palette = ["#dc2626"]
    };

    [Parameter]
    public Guid? ProjectId { get; set; }

    [Parameter]
    public Guid? ProcessIdQuery { get; set; }

    [Parameter]
    public Guid? RunIdQuery { get; set; }

    [Parameter]
    public Guid? LaunchPlanIdQuery { get; set; }

    [Parameter]
    public bool LaunchStarted { get; set; }

    [Parameter]
    public string? MockScenarioQuery { get; set; }

    private ProcessWorkspaceShellProjection? shell;
    private long? acceptedProfileGeneration;
    private bool isLoading;
    private string? errorMessage;
    private long loadGeneration;
    private int selectedTabIndex;
    private Guid? selectedRuntimeRunId;
    private Guid? routeSelectionProjectId;
    private Guid? routeSelectionProcessId;
    private Guid? routeSelectionRunId;
    private Guid? routeSelectionLaunchPlanId;
    private Guid? requiredRouteProcessId;
    private Guid? requiredRouteRunId;
    private Guid? requiredRouteLaunchPlanId;
    private bool routeSelectionInitialized;
    private ProcessRuntimeHistoryWindow runtimeHistoryWindow = ProcessRuntimeHistoryWindow.LiveHour;
    private int runtimeEventPage;
    private const int RuntimeEventPageSize = 25;
    private ProcessProjectedRunStatus? statusFilter;
    private bool runDetailDialogOpen;
    private ProcessLiveProcessSnapshot? runDetailSnapshot;
    private Guid? filesRunId;
    private bool agentDetailDialogOpen;
    private ProcessRuntimeActiveAgentProjection? agentDetailAgent;
    private Guid? busyOperatorActionStepId;
    private long operatorOperation;
    private string? operatorActionMessage;
    private string? operatorActionError;
    private readonly Dictionary<Guid, string> operatorActionNotes = new();
    private readonly HashSet<Guid> mockResolvedOperatorActionStepIds = [];
    private readonly Dictionary<Guid, DateTimeOffset> hiddenRunGroups = [];
    private string? hiddenRunGroupsLoadedScopeKey;
    private ProcessAgentChatContextPublication? agentChatPublication;
    private ProcessAgentChatFreshnessLease? agentChatFreshnessLease;
    private bool isDisposed;
    private readonly CancellationTokenSource lifetimeCancellation = new();
    private static readonly TimeSpan LiveRefreshInterval = TimeSpan.FromSeconds(10);

    private ProcessAgentChatContextPublication ResolveAgentChatPublication() {
        var context = new LiveProcessesAgentChatContext(
            Navigation.Uri,
            ProjectId,
            AgentChatLiveView,
            HasUnresolvedNonRunRouteSelection
                ? null
                : requiredRouteRunId ?? selectedRuntimeRunId ?? shell?.Runtime.SelectedRunId ?? RunIdQuery,
            runtimeHistoryWindow,
            statusFilter,
            shell,
            !HasUnresolvedRouteSelection && runDetailDialogOpen ? runDetailSnapshot : null,
            HasUnresolvedRouteSelection ? null : filesRunId,
            !HasUnresolvedRouteSelection && agentDetailDialogOpen ? agentDetailAgent : null,
            AgentChatAccessState,
            shell?.ProjectBinding is { } binding ? new(binding.DatabaseProfileId, binding.ProjectId, binding.LifetimeId) : null);
        agentChatPublication = ProcessInvocationSnapshotMapper.BuildLivePublication(
            context,
            new DatabaseProfileGeneration(DatabaseRuntimeState.GetSnapshot().Generation),
            TimeProvider.GetUtcNow(),
            agentChatPublication);
        AgentChatFreshnessLease.Schedule(
            agentChatPublication.SnapshotCapture?.AttachmentDraft);
        return agentChatPublication;
    }

    private ProcessAgentChatFreshnessLease AgentChatFreshnessLease
        => agentChatFreshnessLease ??= new ProcessAgentChatFreshnessLease(
            TimeProvider,
            ExpireAgentChatPublicationAsync,
            exception => Logger.LogError(
                exception,
                "Failed to expire the live-processes agent context at its freshness deadline."));

    private Task ExpireAgentChatPublicationAsync()
        => InvokeAsync(() => {
            if (isDisposed) {
                return;
            }

            StateHasChanged();
        });

    private bool HasUnresolvedRouteRunSelection
        => requiredRouteRunId is { } requestedRunId &&
           shell is not null &&
           shell.Runtime.SelectedRunId != requestedRunId;

    private bool HasUnresolvedNonRunRouteSelection
        => shell is not null &&
           (requiredRouteProcessId.HasValue || requiredRouteLaunchPlanId.HasValue);

    private bool HasUnresolvedRouteSelection
        => HasUnresolvedRouteRunSelection || HasUnresolvedNonRunRouteSelection;

    private AgentChatContextAccessState AgentChatAccessState
        => isLoading
            ? AgentChatContextAccessState.Loading
            : !string.IsNullOrWhiteSpace(errorMessage)
                ? AgentChatContextAccessState.Failed
            : shell is not null
            ? HasUnresolvedRouteSelection
                ? AgentChatContextAccessState.Failed
                : AgentChatContextAccessState.Ready
            : string.IsNullOrWhiteSpace(errorMessage)
                ? AgentChatContextAccessState.Loading
                : AgentChatContextAccessState.Failed;

    private AgentChatNavigationIdentity AgentChatNavigationFence
        => AgentChatNavigationIdentity.CreateForLocation(
            Navigation.BaseUri,
            Navigation.Uri,
            [
                new("processId", ProcessIdQuery?.ToString("D")),
                new("runId", RunIdQuery?.ToString("D")),
                new("launchPlanId", LaunchPlanIdQuery?.ToString("D")),
                new("mockScenario", MockScenarioQuery)
            ]);

    private ProcessAgentChatLiveView AgentChatLiveView
        => selectedTabIndex switch {
            0 => ProcessAgentChatLiveView.Activity,
            1 => ProcessAgentChatLiveView.Agents,
            2 => ProcessAgentChatLiveView.Graphs,
            3 => ProcessAgentChatLiveView.ToolHistory,
            _ => ProcessAgentChatLiveView.Activity
        };

    private string PageTitleText => ProjectId.HasValue ? "Project live processes" : "Live processes";

    private bool IsMockProjection
        => !string.IsNullOrWhiteSpace(MockScenarioQuery);

    private string DefinitionCountText
        => shell is null
            ? "0"
            : shell.DefinitionCatalog.TotalDefinitionCount.ToString("N0", CultureInfo.CurrentCulture);

    private string LastEventText
        => shell?.Runtime.Runs.Count > 0
            ? shell.Runtime.Runs.Max(run => run.LastEventAtUtc).LocalDateTime.ToString("g", CultureInfo.CurrentCulture)
            : "No events";

    private int HiddenRelatedRunCount
        => shell?.Runtime.Runs.Count(run => !IsRunGroupVisible(run)) ?? 0;

    private string LegacyHiddenRunGroupsStorageKey
        => ProjectId.HasValue
            ? $"{LegacyHiddenRunGroupsStorageKeyPrefix}:project:{ProjectId.Value:D}"
            : $"{LegacyHiddenRunGroupsStorageKeyPrefix}:global";

    private string ProjectionStatusText
        => shell?.Refresh.Status switch {
            ProcessWorkspaceProjectionStatus.Ready => "Ready",
            ProcessWorkspaceProjectionStatus.RefreshRequested => "Refresh requested",
            ProcessWorkspaceProjectionStatus.ProjectionStoreUnavailable => "Store pending",
            _ => "Loading"
        };

    private string ProjectionTooltip
        => shell?.Refresh.Summary ?? "Live process projection is loading.";

    private string ProjectionTone
        => shell?.Refresh.Status switch {
            ProcessWorkspaceProjectionStatus.Ready => "success",
            ProcessWorkspaceProjectionStatus.RefreshRequested => "info",
            ProcessWorkspaceProjectionStatus.ProjectionStoreUnavailable => "warning",
            _ => "neutral"
        };

    protected override async Task OnParametersSetAsync() {
        SynchronizeRouteSelections();
        await LoadAsync(forceRefresh: LaunchStarted);
    }

    private void SynchronizeRouteSelections(bool force = false) {
        if (!force && routeSelectionInitialized &&
            routeSelectionProjectId == ProjectId &&
            routeSelectionProcessId == ProcessIdQuery &&
            routeSelectionRunId == RunIdQuery &&
            routeSelectionLaunchPlanId == LaunchPlanIdQuery) {
            return;
        }

        routeSelectionInitialized = true;
        operatorOperation++;
        busyOperatorActionStepId = null;
        routeSelectionProjectId = ProjectId;
        routeSelectionProcessId = ProcessIdQuery;
        routeSelectionRunId = RunIdQuery;
        routeSelectionLaunchPlanId = LaunchPlanIdQuery;
        requiredRouteProcessId = ProcessIdQuery;
        requiredRouteRunId = RunIdQuery;
        requiredRouteLaunchPlanId = LaunchPlanIdQuery;
        selectedRuntimeRunId = RunIdQuery;
        runtimeEventPage = 0;
        runDetailDialogOpen = false;
        runDetailSnapshot = null;
        filesRunId = null;
        agentDetailDialogOpen = false;
        agentDetailAgent = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            _ = RefreshLiveProjectionAsync(lifetimeCancellation.Token);
        }

        var legacyStorageKey = LegacyHiddenRunGroupsStorageKey;
        if (string.Equals(hiddenRunGroupsLoadedScopeKey, legacyStorageKey, StringComparison.Ordinal)) {
            return;
        }

        hiddenRunGroupsLoadedScopeKey = legacyStorageKey;
        await LoadHiddenRunGroupsAsync(legacyStorageKey);
        StateHasChanged();
    }

    private Task ForceRefreshAsync()
        => LoadAsync(forceRefresh: true);

    private async Task RefreshLiveProjectionAsync(CancellationToken cancellationToken) {
        try {
            using var timer = new PeriodicTimer(LiveRefreshInterval, TimeProvider);
            while (await timer.WaitForNextTickAsync(cancellationToken)) {
                await InvokeAsync(async () => {
                    if (isDisposed || isLoading || IsMockProjection || runtimeHistoryWindow != ProcessRuntimeHistoryWindow.LiveHour) {
                        return;
                    }

                    await LoadAsync(forceRefresh: true);
                    if (!isDisposed) {
                        StateHasChanged();
                    }
                });
            }
        } catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) {
        } catch (Exception exception) {
            Logger.LogError(exception, "Live process refresh stopped for project {ProjectId} and run {RunId}.", ProjectId, selectedRuntimeRunId);
        }
    }

    private async Task RefreshCancelledRunAsync(ProcessRunId runId) {
        await ForceRefreshAsync();
        if (runDetailDialogOpen && runDetailSnapshot?.RunId == runId) {
            runDetailSnapshot = shell?.Runtime.Runs.FirstOrDefault(run => run.RunId == runId);
        }
    }

    private Task OpenDefinitionsAsync() {
        Navigation.NavigateTo(ProjectId.HasValue ? $"/projects/{ProjectId.Value:D}/processes" : "/processes");
        return Task.CompletedTask;
    }

    private async Task LoadAsync(bool forceRefresh) {
        var generation = Interlocked.Increment(ref loadGeneration);
        var originScope = ResolveScope();
        var originProfileGeneration = DatabaseRuntimeState.GetSnapshot().Generation;
        if (shell is not null && (shell.Scope != originScope || acceptedProfileGeneration != originProfileGeneration)) {
            shell = null;
            SynchronizeRouteSelections(force: true);
        }
        isLoading = true;
        errorMessage = null;

        try {
            var loadedShell = await LoadShellProjectionAsync(
                forceRefresh,
                selectedRuntimeRunId ?? RunIdQuery);
            if (isDisposed || generation != Volatile.Read(ref loadGeneration)) {
                return;
            }

            if (shell?.ProjectBinding != loadedShell.ProjectBinding) {
                SynchronizeRouteSelections(force: true);
                mockResolvedOperatorActionStepIds.Clear();
            }
            shell = loadedShell;
            acceptedProfileGeneration = originProfileGeneration;
            if (requiredRouteRunId is { } requestedRouteRunId &&
                loadedShell.Runtime.SelectedRunId != requestedRouteRunId) {
                selectedRuntimeRunId = requestedRouteRunId;
                runtimeEventPage = 0;
                return;
            }

            var requestedRunId = requiredRouteRunId ??
                loadedShell.Runtime.SelectedRunId ??
                selectedRuntimeRunId ??
                RunIdQuery;
            var resolvedRunId = ResolveRunIdForCurrentStatusFilter(
                VisibleRuntimeRuns(loadedShell.Runtime.Runs),
                requestedRunId);
            if (requiredRouteRunId.HasValue) {
                resolvedRunId = requiredRouteRunId;
            }

            if (resolvedRunId != requestedRunId) {
                selectedRuntimeRunId = resolvedRunId;
                runtimeEventPage = 0;
                var filteredShell = await LoadShellProjectionAsync(
                    forceRefresh: false,
                    selectedRuntimeRunId);
                if (isDisposed || generation != Volatile.Read(ref loadGeneration)) {
                    return;
                }

                if (shell.ProjectBinding != filteredShell.ProjectBinding) {
                    SynchronizeRouteSelections(force: true);
                    mockResolvedOperatorActionStepIds.Clear();
                }
                shell = filteredShell;
            } else {
                selectedRuntimeRunId = resolvedRunId;
            }

            if (runDetailDialogOpen && runDetailSnapshot is { } openRun) {
                runDetailSnapshot = shell.Runtime.Runs.FirstOrDefault(run => run.RunId == openRun.RunId);
                runDetailDialogOpen = runDetailSnapshot is not null;
            }
            if (agentDetailDialogOpen && agentDetailAgent is { } openAgent) {
                agentDetailAgent = shell.Runtime.ActiveAgents.FirstOrDefault(agent =>
                    agent.RunId == openAgent.RunId && agent.StepInstanceId == openAgent.StepInstanceId);
                agentDetailDialogOpen = agentDetailAgent is not null;
            }
        } catch (Exception exception) when (exception is not OperationCanceledException) {
            if (isDisposed || generation != Volatile.Read(ref loadGeneration)) {
                return;
            }

            var retainAccepted = shell?.Scope == originScope && acceptedProfileGeneration == originProfileGeneration &&
                DatabaseRuntimeState.GetSnapshot().Generation == originProfileGeneration &&
                exception is TimeoutException or System.Data.Common.DbException { IsTransient: true };
            errorMessage = retainAccepted
                ? "Refresh failed. The last accepted projection remains visible; use Refresh to retry the read."
                : exception is ProcessProjectionAccessException access ? access.Message
                    : "The process workspace could not be read. Refresh to recheck its current scope and access.";
            if (!retainAccepted) {
                shell = null;
                SynchronizeRouteSelections(force: true);
            }
            Logger.LogError(exception, "Could not load live processes for project {ProjectId} and run {RunId}.", ProjectId, selectedRuntimeRunId);
        } finally {
            if (!isDisposed && generation == Volatile.Read(ref loadGeneration)) {
                isLoading = false;
            }
        }
    }

    private async Task<ProcessWorkspaceShellProjection> LoadShellProjectionAsync(bool forceRefresh, Guid? runId) {
        var runtimeLoadOptions = CreateRuntimeLoadOptions();
        var scope = ResolveScope();
        var request = new ProcessWorkspaceShellRequest(
            scope,
            new ProcessWorkspaceSelectionProjection(ProcessIdQuery, RunIdQuery, LaunchPlanIdQuery),
            new ProcessDefinitionCatalogQueryProjection(
                SearchText: null,
                SelectedDefinitionKey: null,
                ProcessDefinitionCatalogScopeKind.All,
                Take: 25),
            new ProcessTemplateCatalogQueryProjection(
                SearchText: null,
                ProcessTemplateCatalogCategoryKind.All,
                SelectedItemKey: null,
                ProcessTemplateCatalogPreviewTabKind.Overview,
                Take: 25),
            forceRefresh,
            new ProcessRuntimeWorkspaceQueryProjection(
                runtimeHistoryWindow,
                runtimeEventPage,
                RuntimeEventPageSize,
                runId,
                AutoSelectRun: runId.HasValue,
                TakeRuns: 40,
                runtimeLoadOptions) {
                PreviouslyLoadedRuns = ResolvePreviouslyLoadedRuns(
                    forceRefresh,
                    scope,
                    runtimeHistoryWindow)
            },
            ProcessDefinitionWorkspaceLoadOptions.CatalogOnly) { ProjectBinding = shell?.ProjectBinding };

        var baseline = await ProjectionClient.GetShellAsync(request, lifetimeCancellation.Token).ConfigureAwait(false);
        if (!MockProjectionFactory.TryParseScenario(MockScenarioQuery, out var scenario)) {
            return baseline;
        }
        if (request.ProjectBinding != baseline.ProjectBinding) {
            request = request with { ProjectBinding = baseline.ProjectBinding, RuntimeQuery = request.RuntimeQuery! with {
                PreviouslyLoadedRuns = null, SelectedRunId = request.Selection.RunId, EventPage = 0
            } };
        }

        return MockProjectionFactory.CreateShell(
            baseline,
            request,
            scenario,
            shell?.ProjectBinding == baseline.ProjectBinding ? mockResolvedOperatorActionStepIds : new HashSet<Guid>());
    }

    private ProcessWorkspaceShellScope ResolveScope()
        => ProjectId.HasValue
            ? ProcessWorkspaceShellScope.ForProject(ProjectId.Value)
            : ProcessWorkspaceShellScope.Global;

    private IReadOnlyList<ProcessLiveProcessSnapshot>? ResolvePreviouslyLoadedRuns(
        bool forceRefresh,
        ProcessWorkspaceShellScope scope,
        ProcessRuntimeHistoryWindow historyWindow)
        => !forceRefresh &&
           shell is { } loadedShell &&
           loadedShell.Scope == scope &&
           loadedShell.Runtime.HistoryWindow == historyWindow
            ? loadedShell.Runtime.ReusableRuns
            : null;

    private ProcessRuntimeWorkspaceLoadOptions CreateRuntimeLoadOptions()
        => selectedTabIndex switch {
            1 => new ProcessRuntimeWorkspaceLoadOptions {
                IncludeSelectedRun = false,
                IncludeHistory = false,
                IncludeMetricHistory = false,
                IncludeActiveAgents = true,
                IncludeUsageTelemetry = false
            },
            2 => new ProcessRuntimeWorkspaceLoadOptions {
                IncludeSelectedRun = false,
                IncludeHistory = false,
                IncludeMetricHistory = true,
                IncludeActiveAgents = false,
                IncludeUsageTelemetry = true
            },
            3 => new ProcessRuntimeWorkspaceLoadOptions {
                IncludeSelectedRun = false,
                IncludeHistory = true,
                IncludeMetricHistory = true,
                IncludeActiveAgents = false,
                IncludeUsageTelemetry = false
            },
            _ => new ProcessRuntimeWorkspaceLoadOptions {
                IncludeSelectedRun = false,
                IncludeHistory = true,
                IncludeMetricHistory = false,
                IncludeActiveAgents = true,
                IncludeUsageTelemetry = false
            }
        };

    private async Task HandleTabChangedAsync(int index) {
        if (selectedTabIndex == index) {
            return;
        }

        selectedTabIndex = index;
        runtimeEventPage = 0;
        await LoadAsync(forceRefresh: false);
    }

    private IReadOnlyList<ProcessLiveProcessSnapshot> SelectableRuns
        => shell?.Runtime.Runs
            .Where(IsRunGroupVisible)
            .Where(run => statusFilter is null || run.Status == statusFilter)
            .OrderByDescending(run => run.LastEventAtUtc)
            .ThenBy(run => run.RunId.Value)
            .ToArray() ?? [];

    private IReadOnlyList<ProcessLiveProcessSnapshot> VisibleRuns
        => SelectableRuns
            .Where(run => !selectedRuntimeRunId.HasValue || run.RunId.Value == selectedRuntimeRunId.Value)
            .ToArray();

    private IReadOnlyList<ProcessRuntimeActiveAgentProjection> VisibleActiveAgents
        => shell?.Runtime.ActiveAgents
            .Where(agent => !selectedRuntimeRunId.HasValue || agent.RunId == selectedRuntimeRunId.Value)
            .OrderByDescending(agent => agent.IsWorking)
            .ThenByDescending(agent => string.Equals(agent.Status, "Running", StringComparison.Ordinal))
            .ThenBy(agent => agent.ExecutorDisplayName, StringComparer.OrdinalIgnoreCase)
            .ToArray() ?? [];

    private IReadOnlyList<ProcessLiveProcessSnapshot> ActivityCardRuns
        => VisibleRuns
            .Where(run =>
                run.IsActive ||
                run.Status is ProcessProjectedRunStatus.NeedsAttention or ProcessProjectedRunStatus.Failed ||
                run.Incidents.Count > 0)
            .OrderByDescending(run => run.LastEventAtUtc)
            .ThenByDescending(run => run.Status == ProcessProjectedRunStatus.NeedsAttention)
            .ThenByDescending(run => run.Status == ProcessProjectedRunStatus.Failed)
            .ThenByDescending(run => run.IsActive)
            .ThenBy(run => run.RunId.Value)
            .Take(12)
            .ToArray();

    private IReadOnlyList<ProcessLiveProcessSnapshot> AttentionRuns
        => VisibleRuns
            .Where(RequiresOperatorAttention)
            .OrderByDescending(run => run.LastEventAtUtc)
            .ThenByDescending(run => run.Status == ProcessProjectedRunStatus.NeedsAttention)
            .ThenByDescending(run => run.Status == ProcessProjectedRunStatus.Failed)
            .ThenByDescending(run => run.Incidents.Count)
            .ThenByDescending(run => ResolveManagerMessages(run.RunId).Count)
            .ThenBy(run => run.RunId.Value)
            .Take(6)
            .ToArray();

    private IReadOnlyList<ToolFamilySummary> ToolFamilySummaries
        => BuildToolFamilySummaries(shell?.Runtime.ToolUsage ?? []);

    private string RuntimeRunSelectValue
        => selectedRuntimeRunId.HasValue && SelectableRuns.Any(run => run.RunId.Value == selectedRuntimeRunId.Value)
            ? selectedRuntimeRunId.Value.ToString("D")
            : string.Empty;

    private string StatusFilterValue => statusFilter?.ToString() ?? string.Empty;

    private async Task ChangeRuntimeHistoryWindowAsync(ChangeEventArgs args) {
        if (Enum.TryParse<ProcessRuntimeHistoryWindow>(args.Value?.ToString(), out var parsed)) {
            runtimeHistoryWindow = parsed;
            runtimeEventPage = 0;
            await LoadAsync(forceRefresh: false);
        }
    }

    private async Task ChangeStatusFilterAsync(ChangeEventArgs args) {
        var value = args.Value?.ToString();
        statusFilter = Enum.TryParse<ProcessProjectedRunStatus>(value, out var parsed)
            ? parsed
            : null;
        runtimeEventPage = 0;
        selectedRuntimeRunId = ResolveRunIdForCurrentStatusFilter(VisibleRuntimeRuns(shell?.Runtime.Runs ?? []), selectedRuntimeRunId);
        await LoadAsync(forceRefresh: false);
    }

    private async Task SelectRuntimeRunAsync(ChangeEventArgs args) {
        requiredRouteProcessId = null;
        requiredRouteLaunchPlanId = null;
        requiredRouteRunId = null;
        selectedRuntimeRunId = Guid.TryParse(args.Value?.ToString(), out var parsed) && parsed != Guid.Empty
            ? parsed
            : null;
        runtimeEventPage = 0;
        await LoadAsync(forceRefresh: false);
    }

    private async Task SelectRuntimeRunAsync(Guid runId) {
        requiredRouteProcessId = null;
        requiredRouteLaunchPlanId = null;
        requiredRouteRunId = null;
        selectedRuntimeRunId = runId == Guid.Empty ? null : runId;
        runtimeEventPage = 0;
        await LoadAsync(forceRefresh: false);
    }

    private async Task HideRunGroupAsync(ProcessLiveProcessSnapshot run) {
        var groupId = ResolveRunGroupId(run);
        var groupLastEventAtUtc = shell?.Runtime.Runs
            .Where(candidate => ResolveRunGroupId(candidate) == groupId)
            .Select(candidate => candidate.LastEventAtUtc)
            .DefaultIfEmpty(run.LastEventAtUtc)
            .Max() ?? run.LastEventAtUtc;
        var nowUtc = TimeProvider.GetUtcNow();
        hiddenRunGroups[groupId] = groupLastEventAtUtc > nowUtc ? groupLastEventAtUtc : nowUtc;
        await SaveHiddenRunGroupsAsync();

        if (selectedRuntimeRunId.HasValue &&
            shell?.Runtime.Runs.Any(candidate =>
                candidate.RunId.Value == selectedRuntimeRunId.Value &&
                ResolveRunGroupId(candidate) == groupId) == true) {
            requiredRouteProcessId = null;
            requiredRouteLaunchPlanId = null;
            requiredRouteRunId = null;
            selectedRuntimeRunId = null;
            runtimeEventPage = 0;
            await LoadAsync(forceRefresh: false);
        }
    }

    private async Task ShowHiddenRunGroupsAsync() {
        hiddenRunGroups.Clear();
        await SaveHiddenRunGroupsAsync();
    }

    // Hidden run groups are shared by the global and project dashboards. Groups hidden by the earlier per-scope
    // storage are merged once, as hidden now, and their scope key is removed.
    private async Task LoadHiddenRunGroupsAsync(string legacyStorageKey) {
        var readingStorageKey = HiddenRunGroupsStorageKey;
        try {
            hiddenRunGroups.Clear();
            var json = await JsRuntime.InvokeAsync<string?>("localStorage.getItem", readingStorageKey);
            if (!string.IsNullOrWhiteSpace(json)) {
                var entries = JsonSerializer.Deserialize<HiddenRunGroupEntry[]>(json, HiddenRunGroupsJsonOptions) ?? [];
                foreach (var entry in entries.Where(entry => entry.RunGroupId != Guid.Empty)) {
                    hiddenRunGroups[entry.RunGroupId] = entry.HiddenAtUtc;
                }
            }

            readingStorageKey = legacyStorageKey;
            var legacyJson = await JsRuntime.InvokeAsync<string?>("localStorage.getItem", legacyStorageKey);
            if (string.IsNullOrWhiteSpace(legacyJson)) {
                return;
            }

            var nowUtc = TimeProvider.GetUtcNow();
            var legacyValues = JsonSerializer.Deserialize<string[]>(legacyJson, HiddenRunGroupsJsonOptions) ?? [];
            foreach (var value in legacyValues) {
                if (Guid.TryParse(value, out var runGroupId) && runGroupId != Guid.Empty) {
                    hiddenRunGroups.TryAdd(runGroupId, nowUtc);
                }
            }

            await SaveHiddenRunGroupsAsync();
            await JsRuntime.InvokeVoidAsync("localStorage.removeItem", legacyStorageKey);
        } catch (JsonException exception) {
            operatorActionError = $"Stored hidden process card preferences were invalid and were cleared: {exception.Message}";
            await JsRuntime.InvokeVoidAsync("localStorage.removeItem", readingStorageKey);
        } catch (Exception exception) when (exception is JSException or InvalidOperationException) {
            operatorActionError = $"Could not load hidden process card preferences: {exception.Message}";
        }
    }

    private async Task SaveHiddenRunGroupsAsync() {
        operatorActionError = null;
        try {
            var retainedAfterUtc = TimeProvider.GetUtcNow() - HiddenRunGroupRetention;
            foreach (var expiredGroupId in hiddenRunGroups
                .Where(entry => entry.Value < retainedAfterUtc)
                .Select(entry => entry.Key)
                .ToArray()) {
                hiddenRunGroups.Remove(expiredGroupId);
            }

            if (hiddenRunGroups.Count == 0) {
                await JsRuntime.InvokeVoidAsync("localStorage.removeItem", HiddenRunGroupsStorageKey);
                return;
            }

            var entries = hiddenRunGroups
                .OrderBy(entry => entry.Key)
                .Select(entry => new HiddenRunGroupEntry(entry.Key, entry.Value))
                .ToArray();
            var json = JsonSerializer.Serialize(entries, HiddenRunGroupsJsonOptions);
            await JsRuntime.InvokeVoidAsync("localStorage.setItem", HiddenRunGroupsStorageKey, json);
        } catch (Exception exception) when (exception is JSException or InvalidOperationException) {
            operatorActionError = $"Could not save hidden process card preferences: {exception.Message}";
        }
    }

    private IReadOnlyList<ProcessLiveProcessSnapshot> VisibleRuntimeRuns(IReadOnlyList<ProcessLiveProcessSnapshot> runs)
        => runs.Where(IsRunGroupVisible).ToArray();

    // A hidden group returns when one of its runs needs attention again after it was hidden, and a run requested
    // by the route stays visible so a direct link never opens an empty dashboard.
    private bool IsRunGroupVisible(ProcessLiveProcessSnapshot run) {
        var groupId = ResolveRunGroupId(run);
        if (!hiddenRunGroups.TryGetValue(groupId, out var hiddenAtUtc) ||
            run.RunId.Value == requiredRouteRunId) {
            return true;
        }

        return shell?.Runtime.Runs.Any(candidate =>
            ResolveRunGroupId(candidate) == groupId &&
            candidate.LastEventAtUtc > hiddenAtUtc &&
            (candidate.Status is ProcessProjectedRunStatus.NeedsAttention or ProcessProjectedRunStatus.Failed ||
             RequiresOperatorAttention(candidate))) == true;
    }

    private static Guid ResolveRunGroupId(ProcessLiveProcessSnapshot run)
        => run.RootRunId.Value == Guid.Empty ? run.RunId.Value : run.RootRunId.Value;

    private Guid? ResolveRunIdForCurrentStatusFilter(IReadOnlyList<ProcessLiveProcessSnapshot> runs, Guid? requestedRunId) {
        if (statusFilter is null) {
            return requestedRunId;
        }

        if (!requestedRunId.HasValue) {
            return null;
        }

        if (requestedRunId.HasValue && runs.Any(run => run.RunId.Value == requestedRunId.Value && run.Status == statusFilter)) {
            return requestedRunId;
        }

        return runs
            .Where(run => run.Status == statusFilter)
            .OrderByDescending(run => run.LastEventAtUtc)
            .Select(run => (Guid?)run.RunId.Value)
            .FirstOrDefault();
    }


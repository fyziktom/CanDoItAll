    void IDisposable.Dispose() {
        if (isDisposed) {
            return;
        }

        isDisposed = true;
        Interlocked.Increment(ref loadGeneration);
        lifetimeCancellation.Cancel();
        lifetimeCancellation.Dispose();
        agentChatFreshnessLease?.Dispose();
        agentChatFreshnessLease = null;
    }

    private async Task ExecuteOperatorActionAsync(ProcessRuntimeOperatorActionProjection action) {
        if (!action.IsEnabled || busyOperatorActionStepId.HasValue) {
            return;
        }

        var operation = ++operatorOperation;
        var profileGeneration = DatabaseRuntimeState.GetSnapshot().Generation;
        bool IsCurrent() => !isDisposed && operation == operatorOperation && profileGeneration == DatabaseRuntimeState.GetSnapshot().Generation;
        busyOperatorActionStepId = action.StepInstanceId;
        operatorActionMessage = null;
        operatorActionError = null;

        try {
            var result = await ExecuteOperatorActionCommandAsync(action);
            if (!IsCurrent()) {
                return;
            }
            if (!result.Succeeded) {
                operatorActionError = result.Diagnostics.Count == 0
                    ? $"{action.Label} was rejected by the runtime."
                    : string.Join(" ", result.Diagnostics);
                NotifyOperatorAction(
                    NotificationSeverity.Error,
                    $"{action.Label} rejected",
                    operatorActionError);
                return;
            }

            operatorActionMessage = $"{action.Label} accepted for {action.StepKey}. Dispatch has been queued.";
            NotifyOperatorAction(
                NotificationSeverity.Success,
                $"{action.Label} accepted",
                $"{action.StepKey} is queued for dispatch.");
            operatorActionNotes.Remove(action.StepInstanceId);
            requiredRouteProcessId = null;
            requiredRouteLaunchPlanId = null;
            requiredRouteRunId = null;
            selectedRuntimeRunId = action.RunId;
            runtimeEventPage = 0;
            await LoadAsync(forceRefresh: true);
            if (!IsCurrent()) {
                return;
            }
            if (runDetailDialogOpen) {
                var refreshedRun = shell?.Runtime.Runs.FirstOrDefault(run => run.RunId.Value == action.RunId);
                if (refreshedRun is null || !RequiresOperatorAttention(refreshedRun)) {
                    await CloseRunDetailDialogAsync();
                } else {
                    runDetailSnapshot = refreshedRun;
                }
            }
        } catch (Exception exception) when (exception is not OperationCanceledException) {
            if (!IsCurrent()) {
                return;
            }
            operatorActionError = "The process operator action failed. Refresh the run before retrying.";
            Logger.LogWarning("Process operator action failed. RunId={RunId} StepId={StepId} FailureType={FailureType}.", action.RunId, action.StepInstanceId, exception.GetType().Name);
            NotifyOperatorAction(
                NotificationSeverity.Error,
                $"{action.Label} failed",
                operatorActionError);
        } finally {
            if (operation == operatorOperation) {
                busyOperatorActionStepId = null;
            }
        }
    }

    private async Task<ProcessRuntimeOperatorActionResult> ExecuteOperatorActionCommandAsync(
        ProcessRuntimeOperatorActionProjection action) {
        if (IsMockProjection) {
            mockResolvedOperatorActionStepIds.Add(action.StepInstanceId);
            return new ProcessRuntimeOperatorActionResult(
                new ProcessRunId(action.RunId),
                new ProcessStepInstanceId(action.StepInstanceId),
                action.Kind,
                ProcessRuntimeTransitionOutcome.Applied,
                ProcessRuntimeStatus.Active,
                []);
        }

        return await ProjectionClient.ExecuteRuntimeOperatorActionAsync(new ProcessRuntimeOperatorActionCommand(
            new ProcessRunId(action.RunId),
            new ProcessStepInstanceId(action.StepInstanceId),
            action.Kind,
            "live-processes",
            BuildOperatorActionReason(action)));
    }

    private void NotifyOperatorAction(
        NotificationSeverity severity,
        string summary,
        string detail) {
        Notifications.Notify(new NotificationMessage {
            Severity = severity,
            Summary = summary,
            Detail = detail,
            Duration = severity == NotificationSeverity.Error ? 14_000 : 9_000,
            TestId = "live-processes-operator-action-toast"
        });
    }

    private IReadOnlyList<ProcessRuntimeActiveAgentProjection> ResolveActiveAgents(Guid runId)
        => shell?.Runtime.ActiveAgents
            .Where(agent => agent.RunId == runId)
            .OrderByDescending(agent => agent.IsWorking)
            .ThenByDescending(agent => string.Equals(agent.Status, "Running", StringComparison.Ordinal))
            .ThenBy(agent => agent.ExecutorDisplayName, StringComparer.OrdinalIgnoreCase)
            .ToArray() ?? [];

    private IReadOnlyList<ProcessManagerMessageProjection> ResolveManagerMessages(ProcessRunId runId)
        => shell?.Runtime.ManagerMessages
            .Where(message => message.RunId == runId)
            .OrderByDescending(message => message.CreatedAtUtc)
            .ToArray() ?? [];

    private static ProcessRuntimeOperatorActionProjection? ResolvePrimaryOperatorAction(ProcessLiveProcessSnapshot run)
        => run.OperatorActions
            .Where(action => action.IsEnabled)
            .OrderByDescending(action => string.Equals(action.StepStatus, nameof(ProcessRuntimeStepStatus.Failed), StringComparison.Ordinal))
            .ThenByDescending(action => string.Equals(action.StepStatus, nameof(ProcessRuntimeStepStatus.Blocked), StringComparison.Ordinal))
            .ThenBy(action => action.StepKey, StringComparer.OrdinalIgnoreCase)
            .FirstOrDefault();

    private static ProcessRuntimeActiveAgentProjection? ResolvePrimaryAgent(
        IReadOnlyList<ProcessRuntimeActiveAgentProjection> activeAgents)
        => activeAgents
            .OrderByDescending(agent => agent.IsWorking && !agent.IsLeaseExpired)
            .ThenByDescending(agent => string.Equals(agent.Status, nameof(ProcessRuntimeStepStatus.Running), StringComparison.Ordinal))
            .ThenBy(agent => agent.StepKey, StringComparer.OrdinalIgnoreCase)
            .FirstOrDefault();

    private static string ResolveCurrentStepText(ProcessLiveProcessSnapshot run) {
        if (run.CurrentStep is not null) {
            return $"{run.CurrentStep.StepKey} / {run.CurrentStep.StepStatus}";
        }

        var childWait = run.WaitingOnChildRuns.FirstOrDefault();
        if (childWait is not null) {
            return $"{childWait.ParentStepKey} / waiting on child";
        }

        var action = ResolvePrimaryOperatorAction(run);
        if (action is not null) {
            return $"{action.StepKey} / {action.StepStatus}";
        }

        return "No current step";
    }

    private bool IsOperatorActionBusy(ProcessRuntimeOperatorActionProjection action)
        => busyOperatorActionStepId == action.StepInstanceId;

    private string GetOperatorActionNote(ProcessRuntimeOperatorActionProjection action)
        => operatorActionNotes.GetValueOrDefault(action.StepInstanceId, string.Empty);

    private void SetOperatorActionNote(ProcessRuntimeOperatorActionProjection action, string? value) {
        var normalized = value?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(normalized)) {
            operatorActionNotes.Remove(action.StepInstanceId);
            return;
        }

        operatorActionNotes[action.StepInstanceId] = normalized;
    }

    private string BuildOperatorActionReason(ProcessRuntimeOperatorActionProjection action) {
        var instruction = FirstNonEmpty(
            action.RecommendedInstruction,
            $"LiveProcesses requested {action.Kind} for step '{action.StepKey}'.");
        var note = GetOperatorActionNote(action);
        return string.IsNullOrWhiteSpace(note)
            ? instruction
            : $"{instruction}{Environment.NewLine}{Environment.NewLine}Operator note:{Environment.NewLine}{note}";
    }

    private string BuildRunCardSummary(ProcessLiveProcessSnapshot run) {
        var action = ResolvePrimaryOperatorAction(run);
        if (action is not null) {
            return FirstNonEmpty(
                action.ProblemSummary,
                $"Cause: {action.StepKey} is {action.StepStatus}. Next action: {action.Label.ToLowerInvariant()} for {action.RoleDisplayName}.");
        }

        var incident = run.Incidents.OrderByDescending(item => item.RaisedAtUtc).FirstOrDefault();
        if (incident is not null) {
            return $"Cause: {EnsureSentence(incident.SafeSummary)}";
        }

        var activeAgents = ResolveActiveAgents(run.RunId.Value);
        var workingAgent = activeAgents.FirstOrDefault(agent => agent.IsWorking && !agent.IsLeaseExpired);
        if (run.Status == ProcessProjectedRunStatus.Active && workingAgent is not null) {
            return $"Active: {EnsureSentence(ResolveAgentCardSummary(workingAgent))}";
        }

        var staleAgent = activeAgents.FirstOrDefault(agent => agent.IsLeaseExpired);
        if (staleAgent is not null) {
            return $"Attention: {ResolveAgentDisplayName(staleAgent)} has an expired lease on {staleAgent.StepKey}.";
        }

        var childWait = run.WaitingOnChildRuns.FirstOrDefault();
        if (childWait is not null) {
            return $"Waiting: {EnsureSentence(childWait.Summary)}";
        }

        if (run.CurrentStep is not null) {
            return $"Current: {EnsureSentence(run.CurrentStep.Summary)}";
        }

        var runtimeEvent = ResolveRunCardEvent(run.RecentEvents);
        return runtimeEvent is null
            ? "No recent runtime events are attached to this run."
            : $"{runtimeEvent.EventType}: {runtimeEvent.Summary}";
    }

    private string BuildAttentionSummary(ProcessLiveProcessSnapshot run) {
        var action = ResolvePrimaryOperatorAction(run);
        if (action is not null) {
            return $"{FirstNonEmpty(action.ProblemSummary, action.Summary)} {FirstNonEmpty(action.RequiredOperatorDecision, $"Next action: {action.Label} for {action.StepKey}.")}";
        }

        var managerMessage = ResolveManagerMessages(run.RunId).FirstOrDefault();
        if (managerMessage is not null) {
            return $"{managerMessage.Kind}: {EnsureSentence(managerMessage.Summary)}";
        }

        return BuildRunCardSummary(run);
    }

    private bool RequiresOperatorAttention(ProcessLiveProcessSnapshot run)
        => run.OperatorActions.Any(action => action.IsEnabled) ||
           run.Status == ProcessProjectedRunStatus.Failed ||
           run.Incidents.Count > 0 ||
           ResolveManagerMessages(run.RunId).Any(message => IsAttentionEventType(message.Kind));

    private static string ResolveAgentStatusTone(ProcessRuntimeActiveAgentProjection agent)
        => agent.IsLeaseExpired
            ? "warning"
            : agent.Status switch {
            "WaitingOnTool" => "warning",
            "Preparing" => "info",
            "Persisting" => "info",
            "Completed" => "success",
            nameof(ProcessRuntimeStepStatus.Running) => "success",
            nameof(ProcessRuntimeStepStatus.Claimed) => "info",
            nameof(ProcessRuntimeStepStatus.Waiting) => "info",
            nameof(ProcessRuntimeStepStatus.Blocked) => "warning",
            nameof(ProcessRuntimeStepStatus.Failed) => "danger",
            _ => "neutral"
        };

    private string ResolveManagerSummary(ProcessLiveProcessSnapshot run) {
        if (ResolvePrimaryOperatorAction(run) is { } action) {
            return FirstNonEmpty(
                action.RequiredOperatorDecision,
                action.ProblemSummary,
                action.Summary,
                "Operator review is required before the run can continue.");
        }

        if (ResolveManagerMessages(run.RunId).FirstOrDefault() is { } managerMessage) {
            return $"{managerMessage.Kind}: {EnsureSentence(managerMessage.Summary)}";
        }

        if (run.Incidents.OrderByDescending(item => item.RaisedAtUtc).FirstOrDefault() is { } incident) {
            return EnsureSentence(incident.SafeSummary);
        }

        return run.CurrentStep is null
            ? "No manager message is attached to this run."
            : EnsureSentence(run.CurrentStep.Summary);
    }

    private static ProcessLiveRunEventProjection? ResolveRunCardEvent(IReadOnlyList<ProcessLiveRunEventProjection> events)
        => events
            .OrderByDescending(item => IsAttentionEventType(item.EventType))
            .ThenByDescending(item => item.OccurredAtUtc)
            .FirstOrDefault();

    private string FormatCurrency(decimal value)
        => CurrencyFormatter.Format(value);

    private static string EnsureSentence(string value) {
        var trimmed = value.Trim();
        if (trimmed.Length == 0 ||
            trimmed.EndsWith(".", StringComparison.Ordinal) ||
            trimmed.EndsWith("!", StringComparison.Ordinal) ||
            trimmed.EndsWith("?", StringComparison.Ordinal)) {
            return trimmed;
        }

        return $"{trimmed}.";
    }

    private async Task DispatchViewActionAsync(Func<Task> action) {
        if (isDisposed) {
            return;
        }
        var pending = action();
        StateHasChanged();
        try {
            await pending;
        } finally {
            if (!isDisposed) {
                StateHasChanged();
            }
        }
    }

    private void DispatchViewAction(Action action) {
        if (!isDisposed) {
            action();
            StateHasChanged();
        }
    }


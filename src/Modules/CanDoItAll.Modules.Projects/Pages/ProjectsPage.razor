    private static ProjectEditorModel CloneProjectEditor(ProjectEditorModel source)
    {
        return new ProjectEditorModel
        {
            Id = source.Id,
            Name = source.Name,
            Description = source.Description,
            Objective = source.Objective,
            Status = source.Status,
            CurrentPhase = source.CurrentPhase,
            TargetDateUtc = source.TargetDateUtc,
            Phases = source.Phases
                .Select(phase => new ProjectPhaseEditorModel
                {
                    Id = phase.Id,
                    Name = phase.Name,
                    Goal = phase.Goal,
                    Status = phase.Status,
                    StartDateUtc = phase.StartDateUtc,
                    EndDateUtc = phase.EndDateUtc
                })
                .ToList(),
            Options = source.Options
                .Select(option => new ProjectOptionEditorModel
                {
                    Id = option.Id,
                    Category = option.Category,
                    OptionName = option.OptionName,
                    Notes = option.Notes
                })
                .ToList()
        };
    }


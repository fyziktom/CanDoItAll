@page "/projects"
@* codex-capsule
kind: page
name: ProjectsPage
summary: Surfaces projects as a card-first workspace with modal overview and editing flows instead of a permanent inline detail pane.
owns: project-cards, project-modal, phase-planning
deps: ProjectsService, IProjectWorkbenchSeedService, NavigationManager
risks: route-driven-modal-state, modal-save-regressions
tests: component:ProjectsPageTests, e2e:projects-smoke
*@
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using CanDoItAll.AgentFramework.Models
@using CanDoItAll.Infrastructure.ControlPlane
@using CanDoItAll.Modules.Projects
@using CanDoItAll.Modules.Projects.Pages.Components
@using CanDoItAll.SharedKernel
@inject ProjectsService ProjectsService
@inject IProjectWorkbenchSeedService ProjectWorkbenchSeedService
@inject IProjectPackageService ProjectPackageService
@inject IDatabaseProfileService DatabaseProfileService
@inject NavigationManager Navigation

<PageTitle>Projects</PageTitle>

<PageScaffold MaxWidthClass="max-w-full">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(projectDeletionNotice))
        {
            <Alert AlertStyle="@(projectDeletionNoticeIsError ? AlertStyle.Warning : AlertStyle.Info)"
                   Variant="Variant.Outlined"
                   data-testid="project-deletion-notice">
                <Stack GapScale="LayoutGap.Small">
                    <TextBlock Value="@projectDeletionNotice" />
                    @foreach (var cleanup in pendingProjectDeletionCleanups)
                    {
                        <Stack GapScale="LayoutGap.Small">
                            <TextBlock Value="@($"Project {cleanup.ProjectId:D} · {cleanup.ParticipantId} · mutation {cleanup.RecoveryId:D} · {cleanup.Status}")" />
                            <TextBlock Value="@cleanup.RetryGuidance" />
                            @if (!cleanup.CanRetryNow && cleanup.RetryAvailableAtUtc.HasValue)
                            {
                                <TextBlock Value="@($"The active claim can be taken over after {cleanup.RetryAvailableAtUtc.Value:u}; use retry to refresh its state.")" />
                            }
                            <Cluster JustifyContent="JustifyContent.End">
                                <Button Text="Retry cleanup"
                                        Tone="ButtonTone.Warning"
                                        Disabled="false"
                                        Click="@(() => RetryProjectDeletionCleanupAsync(cleanup))"
                                        data-testid="project-deletion-retry" />
                            </Cluster>
                        </Stack>
                    }
                    @foreach (var notice in projectDeletionCompletionNotices)
                    {
                        <Stack GapScale="LayoutGap.Small">
                            <TextBlock Value="@($"Project {notice.ProjectId:D} · {notice.ParticipantId} · mutation {notice.RecoveryId:D} · {FormatCompletionOperation(notice.Operation)} completed")" />
                            @foreach (var warning in notice.Warnings)
                            {
                                <TextBlock Value="@($"{warning.RetainedObject.Provider} · storage {warning.RetainedObject.StorageId?.ToString("D") ?? "bootstrap"} · {warning.RetainedObject.LocatorKind} · {warning.RetainedObject.Locator}")" />
                                <TextBlock Value="@($"{warning.RetainedObject.Reason} {warning.Remediation}")" />
                            }
                        </Stack>
                    }
                </Stack>
            </Alert>
        }

        <ProjectsBoard ProjectSummaries="projectSummaries"
                       ProjectProjection="projectFileProjection"
                       HierarchyLinks="hierarchyLinks"
                       ProjectSearch="@projectSearch"
                       ProjectSearchChanged="HandleProjectSearchChanged"
                       StatusFilter="@statusFilter"
                       StatusFilterChanged="HandleStatusFilterChanged"
                       RelatedPartyCategoryFilter="@relatedPartyCategoryFilter"
                       RelatedPartyCategoryFilterChanged="HandleRelatedPartyCategoryFilterChanged"
                       RelatedPartyValueFilter="@relatedPartyValueFilter"
                       RelatedPartyValueFilterChanged="HandleRelatedPartyValueFilterChanged"
                       HierarchyFilterProjectId="@hierarchyFilterProjectId"
                       HierarchyFilterProjectIdChanged="HandleHierarchyFilterProjectChanged"
                       HierarchyFilterMode="@hierarchyFilterMode"
                       HierarchyFilterModeChanged="HandleHierarchyFilterModeChanged"
                       IncludeSubprojects="@includeSubprojects"
                       IncludeSubprojectsChanged="HandleIncludeSubprojectsChanged"
                       HierarchyFilterHelper="@HierarchyFilterHelper"
                       LatestUpdatedProjectLabel="@LatestUpdatedProjectLabel"
                       LatestUpdatedProjectHelper="@LatestUpdatedProjectHelper"
                       OpenNewProject="OpenNewProjectAsync"
                       NavigateHome="NavigateHome"
                       ResetFilters="ResetFilters"
                       OpenProjectPreview="OpenProjectPreviewAsync"
                       OpenProjectFiles="OpenProjectFiles"
                       OpenHierarchyModal="OpenHierarchyModalAsync"
                       OpenProjectDashboard="OpenProjectDashboard"
                       OpenProcesses="OpenProcesses"
                       OpenStructure="OpenStructure"
                       OpenGantt="OpenGantt"
                       OpenCalendar="OpenCalendar"
                       PortfolioViewChanged="HandlePortfolioViewChanged"
                       ProjectPackagePath="@projectPackagePath"
                       ProjectPackagePathChanged="@(value => { projectPackagePath = value; })"
                       ProjectPackageTargetProfiles="@projectPackageTargetProfiles"
                       ProjectPackageTargetProfileId="@projectPackageTargetProfileId"
                       ProjectPackageTargetProfileIdChanged="@(value => { projectPackageTargetProfileId = value; })"
                       ProjectPackageMessage="@projectPackageMessage"
                       IsProjectPackageMessageError="@projectPackageMessageIsError"
                       IsProjectPackageBusy="@projectPackageBusy"
                       ExportProjectsPackage="ExportProjectsPackageAsync"
                       ImportProjectsPackage="ImportProjectsPackageAsync" />
    </ChildContent>
</PageScaffold>

<ProjectsAgentChatContextProvider ProjectSummaries="projectSummaries"
                                  SelectedProjectId="@AgentChatFocusedProjectId"
                                  ActiveView="@agentChatPortfolioView"
                                  ContextNavigationIdentity="@AgentChatNavigationFence"
                                  ContextAccessState="@agentChatPositionAccessState"
                                  RefreshRequested="HandleAgentChatRefreshRequestedAsync" />

<ProjectModalHost IsOpen="showProjectModal"
                  IsEditorMode="@(modalMode == ProjectModalMode.Editor)"
                  Editor="editor"
                  StarterObjects="starterObjects"
                  StarterObjectKinds="starterObjectKinds"
                  ProjectSummaries="projectSummaries"
                  WizardStep="wizardStep"
                  WizardSteps="wizardSteps"
                  WizardTabs="WizardTabs"
                  Message="@message"
                  IsErrorMessage="IsErrorMessage"
                  Close="CloseProjectModalAsync"
                  SwitchToOverview="SwitchToOverview"
                  SwitchToEditor="SwitchToEditor"
                  WizardTabChanged="HandleWizardTabChanged"
                  AddPhase="AddPhaseAsync"
                  RemovePhase="RemovePhaseAsync"
                  AddStarterObject="AddStarterObject"
                  RemoveStarterObject="RemoveStarterObject"
                  PreviousStep="PreviousStep"
                  NextStep="NextStep"
                  Save="SaveAsync"
                  SaveAndOpenStructure="SaveAndOpenStructureAsync"
                  Delete="DeleteAsync"
                  OpenProjectDashboard="OpenProjectDashboardAsync"
                  OpenProcesses="OpenProcessesAsync"
                  OpenStructure="OpenStructure"
                  OpenCalendar="OpenCalendar" />

<ProjectHierarchyModal State="hierarchyDialog"
                       Close="CloseHierarchyModal"
                       OpenProjectPreview="OpenProjectPreviewFromHierarchyAsync"
                       OpenStructure="OpenStructure"
                       OpenHierarchy="OpenHierarchyModalAsync" />

<ProjectFilesDialog IsOpen="@(projectFilesDialogProject is not null)"
                    ProjectId="@(projectFilesDialogProject?.Id ?? Guid.Empty)"
                    ProjectName="@(projectFilesDialogProject?.Name ?? string.Empty)"
                    Closed="CloseProjectFiles" />

@code {
    private static readonly string[] wizardSteps = ["Identity", "Dates and phases", "Stack profile", "Linked objects", "Review"];

    private static readonly ProjectObjectType[] starterObjectKinds =
    [
        ProjectObjectType.Note,
        ProjectObjectType.Decision,
        ProjectObjectType.Milestone,
        ProjectObjectType.Repository,
        ProjectObjectType.Link
    ];

    [SupplyParameterFromQuery(Name = "projectId")]
    public Guid? ProjectIdQuery { get; set; }

    private IReadOnlyList<ProjectSummary> projectSummaries = [];
    private IReadOnlyList<ProjectHierarchyLinkSummary> hierarchyLinks = [];
    private ProjectFileFilterProjection projectFileProjection = ProjectFileFilterProjection.Create(
        [],
        [],
        new ProjectFileFilter());
    private ProjectEditorModel editor = new();
    private readonly List<StarterObjectDraft> starterObjects = [];
    private string? message;
    private string? projectDeletionNotice;
    private bool projectDeletionNoticeIsError;
    private readonly List<ProjectDeletionPendingCleanup> pendingProjectDeletionCleanups = [];
    private readonly List<ProjectDeletionCompletionNotice> projectDeletionCompletionNotices = [];
    private int wizardStep;
    private bool showProjectModal;
    private string projectSearch = string.Empty;
    private ProjectStatus? statusFilter;
    private ProjectPartyPortfolioCategory? relatedPartyCategoryFilter;
    private string relatedPartyValueFilter = string.Empty;
    private ProjectHierarchyFilterMode hierarchyFilterMode = ProjectHierarchyFilterMode.Descendants;
    private Guid? hierarchyFilterProjectId;
    private bool includeSubprojects = true;
    private ProjectModalMode modalMode = ProjectModalMode.Overview;
    private bool modalOpenedFromRoute;
    private ProjectHierarchyDialogState? hierarchyDialog;
    private ProjectSummary? projectFilesDialogProject;
    private string projectPackagePath = string.Empty;
    private IReadOnlyList<DatabaseProfileSummary> projectPackageTargetProfiles = [];
    private Guid? projectPackageTargetProfileId;
    private string? projectPackageMessage;
    private bool projectPackageMessageIsError;
    private bool projectPackageBusy;
    private ProjectsAgentChatView agentChatPortfolioView = ProjectsAgentChatView.Cards;
    private AgentChatContextAccessState agentChatPositionAccessState = AgentChatContextAccessState.Loading;
    private readonly ProjectsPageLoadGeneration projectLoads = new();

    private AgentChatNavigationIdentity AgentChatNavigationFence
        => AgentChatNavigationIdentity.CreateForLocation(
            Navigation.BaseUri,
            Navigation.Uri,
            [new("projectId", ProjectIdQuery?.ToString("D"))]);

    private Task HandlePortfolioViewChanged(ProjectsAgentChatView view)
    {
        agentChatPortfolioView = view;
        return Task.CompletedTask;
    }

    private Guid? AgentChatFocusedProjectId
    {
        get
        {
            if (hierarchyDialog is not null)
            {
                return hierarchyDialog.ProjectId;
            }

            if (projectFilesDialogProject is not null)
            {
                return projectFilesDialogProject.Id;
            }

            if (showProjectModal)
            {
                return editor.Id;
            }

            return hierarchyFilterProjectId;
        }
    }

    private string HierarchyFilterHelper
        => !hierarchyFilterProjectId.HasValue
            ? "Showing main projects. Choose a project to show it with its subprojects or narrow by direct links."
            : hierarchyFilterMode switch
            {
                ProjectHierarchyFilterMode.Descendants when includeSubprojects
                    => $"Showing {ResolveProjectName(hierarchyFilterProjectId.Value)} and its subprojects.",
                ProjectHierarchyFilterMode.Descendants
                    => $"Showing only {ResolveProjectName(hierarchyFilterProjectId.Value)}.",
                ProjectHierarchyFilterMode.Children
                    => $"Showing direct subprojects of {ResolveProjectName(hierarchyFilterProjectId.Value)}.",
                ProjectHierarchyFilterMode.Parents
                    => $"Showing direct parents of {ResolveProjectName(hierarchyFilterProjectId.Value)}.",
                ProjectHierarchyFilterMode.Related
                    => $"Showing the direct relationship neighborhood around {ResolveProjectName(hierarchyFilterProjectId.Value)}.",
                _ => throw new ArgumentOutOfRangeException(nameof(hierarchyFilterMode))
            };

    private IReadOnlyList<ProjectOptionEditorModel> MeaningfulOptions => editor.Options
        .Where(option => !string.IsNullOrWhiteSpace(option.OptionName) || !string.IsNullOrWhiteSpace(option.Notes))
        .ToList();

    private IReadOnlyList<SecondaryTabItem> WizardTabs => wizardSteps
        .Select((step, index) => new SecondaryTabItem(index.ToString(), $"{index + 1}. {step}"))
        .ToList();

    private bool IsErrorMessage
        => !string.IsNullOrWhiteSpace(message) &&
           (message.StartsWith("Unable", StringComparison.OrdinalIgnoreCase) ||
            message.StartsWith("No ", StringComparison.OrdinalIgnoreCase));

    private string LatestUpdatedProjectLabel
        => projectSummaries.Count == 0
            ? "No projects"
            : projectSummaries.OrderByDescending(project => project.UpdatedAtUtc).First().UpdatedAtUtc.LocalDateTime.ToString("g");

    private string LatestUpdatedProjectHelper
        => projectSummaries.Count == 0
            ? "Save the first project to populate the workspace."
            : projectSummaries.OrderByDescending(project => project.UpdatedAtUtc).First().Name;

    protected override async Task OnParametersSetAsync()
    {
        var requestedProjectId = ProjectIdQuery;
        var loadStamp = BeginProjectLoad(new ProjectsPageLoadKey(
            ProjectsPageLoadKind.Route,
            requestedProjectId));
        try
        {
            var portfolioTask = LoadPortfolioStateAsync();
            var editorTask = LoadRequiredProjectEditorAsync(requestedProjectId);
            var packageTargetProfilesTask = LoadProjectPackageTargetProfilesAsync();
            await Task.WhenAll(
                portfolioTask,
                editorTask,
                packageTargetProfilesTask);

            var loadedPortfolio = await portfolioTask;
            var loadedEditor = await editorTask;
            var loadedPackageTargetProfiles = await packageTargetProfilesTask;
            TryCompleteProjectLoad(loadStamp, () =>
            {
                ApplyPortfolioState(loadedPortfolio);
                ApplyProjectPackageTargetProfiles(loadedPackageTargetProfiles);
                if (requestedProjectId.HasValue)
                {
                    editor = loadedEditor!;
                    wizardStep = 0;
                    modalMode = ProjectModalMode.Overview;
                    showProjectModal = true;
                    modalOpenedFromRoute = true;
                    message = null;
                    return;
                }

                if (modalOpenedFromRoute)
                {
                    showProjectModal = false;
                    modalOpenedFromRoute = false;
                    message = null;
                }
            });
        }
        catch
        {
            if (!FailProjectLoad(loadStamp))
            {
                return;
            }

            throw;
        }
    }

    private Task HandleProjectSearchChanged(string value)
    {
        projectSearch = value;
        RebuildProjectFileProjection();
        return Task.CompletedTask;
    }

    private Task HandleStatusFilterChanged(ProjectStatus? value)
    {
        statusFilter = value;
        RebuildProjectFileProjection();
        return Task.CompletedTask;
    }

    private Task HandleRelatedPartyCategoryFilterChanged(ProjectPartyPortfolioCategory? value)
    {
        relatedPartyCategoryFilter = value;
        if (!string.IsNullOrWhiteSpace(relatedPartyValueFilter) &&
            !ProjectFileFilterProjection.Create(
                projectSummaries,
                hierarchyLinks,
                CreateProjectFileFilter()).AvailableRelatedPartyValues.Contains(
                    relatedPartyValueFilter,
                    StringComparer.OrdinalIgnoreCase))
        {
            relatedPartyValueFilter = string.Empty;
        }

        RebuildProjectFileProjection();
        return Task.CompletedTask;
    }

    private Task HandleRelatedPartyValueFilterChanged(string value)
    {
        relatedPartyValueFilter = value;
        RebuildProjectFileProjection();
        return Task.CompletedTask;
    }

    private Task HandleHierarchyFilterProjectChanged(Guid? value)
    {
        hierarchyFilterProjectId = value;
        RebuildProjectFileProjection();
        return Task.CompletedTask;
    }

    private Task HandleHierarchyFilterModeChanged(ProjectHierarchyFilterMode value)
    {
        hierarchyFilterMode = value;
        RebuildProjectFileProjection();
        return Task.CompletedTask;
    }

    private Task HandleIncludeSubprojectsChanged(bool value)
    {
        includeSubprojects = value;
        RebuildProjectFileProjection();
        return Task.CompletedTask;
    }

    private async Task<ProjectsPortfolioState> LoadPortfolioStateAsync()
    {
        var projectSummariesTask = ProjectsService.ListAsync();
        var hierarchyLinksTask = ProjectsService.ListHierarchyLinksAsync();
        var deletionCleanupsTask = ProjectsService.ListPendingDeletionCleanupsAsync();
        var deletionNoticesTask = ProjectsService.ListDeletionCompletionNoticesAsync();
        await Task.WhenAll(
            projectSummariesTask,
            hierarchyLinksTask,
            deletionCleanupsTask,
            deletionNoticesTask);
        return new ProjectsPortfolioState(
            await projectSummariesTask,
            await hierarchyLinksTask,
            await deletionCleanupsTask,
            await deletionNoticesTask);
    }

    private void ApplyPortfolioState(ProjectsPortfolioState state)
    {
        projectSummaries = state.ProjectSummaries;
        hierarchyLinks = state.HierarchyLinks;
        pendingProjectDeletionCleanups.Clear();
        pendingProjectDeletionCleanups.AddRange(state.PendingDeletionCleanups);
        projectDeletionCompletionNotices.Clear();
        projectDeletionCompletionNotices.AddRange(
            state.DeletionCompletionNotices.Where(notice => notice.Warnings.Count > 0));
        if (pendingProjectDeletionCleanups.Count > 0)
        {
            projectDeletionNotice =
                $"{pendingProjectDeletionCleanups.Count} deleted project cleanup operation(s) remain pending and can be retried by exact mutation id.";
            projectDeletionNoticeIsError = true;
        }
        else if (projectDeletionCompletionNotices.Count > 0 &&
                 string.IsNullOrWhiteSpace(projectDeletionNotice))
        {
            projectDeletionNotice =
                $"{projectDeletionCompletionNotices.Count} completed project deletion operation(s) retained managed media and require manual review.";
            projectDeletionNoticeIsError = true;
        }
        RebuildProjectFileProjection();
    }

    private async Task<IReadOnlyList<DatabaseProfileSummary>>
        LoadProjectPackageTargetProfilesAsync()
    {
        var profiles = await DatabaseProfileService.ListAsync();
        return profiles
            .Where(profile =>
                !profile.IsActive &&
                !profile.IsRuntimeLocked &&
                !profile.IsPendingRestartActivation)
            .OrderBy(profile => profile.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(profile => profile.Id)
            .ToArray();
    }

    private void ApplyProjectPackageTargetProfiles(
        IReadOnlyList<DatabaseProfileSummary> profiles)
    {
        projectPackageTargetProfiles = profiles;
        if (projectPackageTargetProfileId.HasValue &&
            profiles.All(profile => profile.Id != projectPackageTargetProfileId.Value))
        {
            projectPackageTargetProfileId = null;
        }
    }

    private static string FormatCompletionOperation(
        ProjectDeletionCompletionOperation operation)
        => operation switch
        {
            ProjectDeletionCompletionOperation.ProjectDeletion => "project deletion",
            ProjectDeletionCompletionOperation.ProjectNodeCleanup => "prior node cleanup",
            _ => throw new ArgumentOutOfRangeException(nameof(operation), operation, null)
        };

    private async Task HandleAgentChatRefreshRequestedAsync(AgentChatExecutionCompleted notification)
    {
        var expectedProjectId = AgentChatFocusedProjectId;
        var loadStamp = BeginProjectLoad(new ProjectsPageLoadKey(
            ProjectsPageLoadKind.CompletionRefresh,
            expectedProjectId));
        try
        {
            var loadedPortfolio = await LoadPortfolioStateAsync();
            if (expectedProjectId.HasValue &&
                loadedPortfolio.ProjectSummaries.All(project => project.Id != expectedProjectId.Value))
            {
                FailProjectLoad(loadStamp);
                return;
            }

            TryCompleteProjectLoad(loadStamp, () => ApplyPortfolioState(loadedPortfolio));
        }
        catch
        {
            if (!FailProjectLoad(loadStamp))
            {
                return;
            }

            throw;
        }
    }

    private async Task<ProjectEditorModel?> LoadRequiredProjectEditorAsync(Guid? projectId)
    {
        if (!projectId.HasValue)
        {
            return null;
        }

        var loadedEditor = await ProjectsService.GetAsync(projectId.Value);
        if (loadedEditor.Id != projectId.Value)
        {
            throw new InvalidOperationException($"Project '{projectId.Value:D}' is unavailable.");
        }

        return loadedEditor;
    }

    private async Task OpenNewProjectAsync()
    {
        var loadStamp = BeginProjectLoad(new ProjectsPageLoadKey(
            ProjectsPageLoadKind.NewProject,
            null));
        try
        {
            var loadedEditor = await ProjectsService.GetAsync(null);
            if (TryCompleteProjectLoad(loadStamp, () =>
                {
                    editor = loadedEditor;
                    wizardStep = 0;
                    starterObjects.Clear();
                    showProjectModal = true;
                    modalMode = ProjectModalMode.Editor;
                    modalOpenedFromRoute = false;
                    message = null;
                }) && ProjectIdQuery.HasValue)
            {
                Navigation.NavigateTo("/projects", replace: true);
            }
        }
        catch
        {
            if (!FailProjectLoad(loadStamp))
            {
                return;
            }

            throw;
        }
    }

    private async Task OpenProjectPreviewAsync(Guid id)
    {
        var loadStamp = BeginProjectLoad(new ProjectsPageLoadKey(
            ProjectsPageLoadKind.Preview,
            id));
        try
        {
            var loadedEditor = await LoadRequiredProjectEditorAsync(id);
            TryCompleteProjectLoad(loadStamp, () =>
            {
                editor = loadedEditor!;
                wizardStep = 0;
                showProjectModal = true;
                modalMode = ProjectModalMode.Overview;
                modalOpenedFromRoute = false;
                message = null;
            });
        }
        catch
        {
            if (!FailProjectLoad(loadStamp))
            {
                return;
            }

            throw;
        }
    }

    private ProjectsPageLoadStamp BeginProjectLoad(ProjectsPageLoadKey key)
    {
        agentChatPositionAccessState = AgentChatContextAccessState.Loading;
        return projectLoads.Begin(key);
    }

    private bool TryCompleteProjectLoad(ProjectsPageLoadStamp stamp, Action commit)
    {
        return projectLoads.TryCommit(stamp, ProjectIdQuery, () =>
        {
            commit();
            agentChatPositionAccessState = AgentChatContextAccessState.Ready;
        });
    }

    private bool CompleteProjectLoad(ProjectsPageLoadStamp stamp)
    {
        return projectLoads.TryCommit(
            stamp,
            ProjectIdQuery,
            () => agentChatPositionAccessState = AgentChatContextAccessState.Ready);
    }

    private bool FailProjectLoad(ProjectsPageLoadStamp stamp)
    {
        return projectLoads.TryCommit(
            stamp,
            ProjectIdQuery,
            () => agentChatPositionAccessState = AgentChatContextAccessState.Failed);
    }

    private void InvalidateProjectLoad()
    {
        projectLoads.Invalidate();
        agentChatPositionAccessState = AgentChatContextAccessState.Ready;
    }

    private async Task ExportProjectsPackageAsync()
    {
        if (projectPackageBusy)
        {
            return;
        }

        projectPackageBusy = true;
        projectPackageMessage = null;
        projectPackageMessageIsError = false;

        try
        {
            var result = await ProjectPackageService.ExportAllAsync(new ProjectPackageExportRequest
            {
                PackagePath = string.IsNullOrWhiteSpace(projectPackagePath) ? null : projectPackagePath
            });

            if (result.IsFailure)
            {
                projectPackageMessage = string.Join(" ", result.Errors.Select(error => error.Message));
                projectPackageMessageIsError = true;
                return;
            }

            projectPackagePath = result.Value!.PackagePath;
            projectPackageMessage = $"Exported {result.Value.Manifest.TotalRecordCount} project record(s) to {result.Value.PackagePath}.";
        }
        finally
        {
            projectPackageBusy = false;
        }
    }

    private async Task ImportProjectsPackageAsync()
    {
        if (projectPackageBusy)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(projectPackagePath))
        {
            projectPackageMessage = "Choose a project package path.";
            projectPackageMessageIsError = true;
            return;
        }

        if (!projectPackageTargetProfileId.HasValue)
        {
            projectPackageMessage = "Choose an inactive target database profile.";
            projectPackageMessageIsError = true;
            return;
        }

        var packagePath = projectPackagePath;
        var targetProfileId = projectPackageTargetProfileId.Value;
        var loadStamp = BeginProjectLoad(new ProjectsPageLoadKey(
            ProjectsPageLoadKind.Import,
            AgentChatFocusedProjectId));
        projectPackageBusy = true;
        projectPackageMessage = null;
        projectPackageMessageIsError = false;

        try
        {
            var result = await ProjectPackageService.ImportAllAsync(new ProjectPackageImportRequest
            {
                PackagePath = packagePath,
                TargetProfileId = targetProfileId
            });

            if (result.IsFailure)
            {
                TryCompleteProjectLoad(loadStamp, () =>
                {
                    projectPackageMessage = string.Join(" ", result.Errors.Select(error => error.Message));
                    projectPackageMessageIsError = true;
                });
                return;
            }

            var loadedPortfolio = await LoadPortfolioStateAsync();
            TryCompleteProjectLoad(loadStamp, () =>
            {
                ApplyPortfolioState(loadedPortfolio);
                projectPackageMessage = $"Imported {result.Value!.RecordsImported} project record(s) from {result.Value.Manifest.PackageId:N}.";
            });
        }
        catch
        {
            if (!FailProjectLoad(loadStamp))
            {
                return;
            }

            throw;
        }
        finally
        {
            projectPackageBusy = false;
        }
    }

    private void OpenProjectDashboard(Guid id)
        => Navigation.NavigateTo($"/projects?projectId={id}");

    private void OpenProjectDashboardAsync()
    {
        if (editor.Id.HasValue)
        {
            OpenProjectDashboard(editor.Id.Value);
        }
    }

    private void OpenProcesses(Guid projectId)
    {
        if (projectId != Guid.Empty)
        {
            Navigation.NavigateTo($"/projects/{projectId}/processes");
        }
    }

    private void OpenProcessesAsync()
    {
        if (editor.Id.HasValue)
        {
            OpenProcesses(editor.Id.Value);
        }
    }

    private Task HandleWizardTabChanged(string key)
    {
        if (int.TryParse(key, out var parsed))
        {
            wizardStep = parsed;
        }

        return Task.CompletedTask;
    }

    private void SwitchToOverview()
        => modalMode = ProjectModalMode.Overview;

    private void SwitchToEditor()
    {
        modalMode = ProjectModalMode.Editor;
        message = null;
    }

    private Task CloseProjectModalAsync()
    {
        InvalidateProjectLoad();
        showProjectModal = false;
        message = null;

        if (modalOpenedFromRoute)
        {
            modalOpenedFromRoute = false;
            Navigation.NavigateTo("/projects", replace: true);
        }

        return Task.CompletedTask;
    }

    private Task AddPhaseAsync()
    {
        editor.Phases.Add(new ProjectPhaseEditorModel());
        return Task.CompletedTask;
    }

    private Task RemovePhaseAsync(ProjectPhaseEditorModel phase)
    {
        editor.Phases.Remove(phase);
        return Task.CompletedTask;
    }

    private void AddStarterObject()
        => starterObjects.Add(new StarterObjectDraft());

    private void RemoveStarterObject(StarterObjectDraft starter)
        => starterObjects.Remove(starter);

    private void NextStep()
        => wizardStep = Math.Min(wizardSteps.Length - 1, wizardStep + 1);

    private void PreviousStep()
        => wizardStep = Math.Max(0, wizardStep - 1);

    private void ResetFilters()
    {
        projectSearch = string.Empty;
        statusFilter = null;
        relatedPartyCategoryFilter = null;
        relatedPartyValueFilter = string.Empty;
        hierarchyFilterMode = ProjectHierarchyFilterMode.Descendants;
        hierarchyFilterProjectId = null;
        includeSubprojects = true;
        RebuildProjectFileProjection();
    }

    private async Task SaveAsync()
    {
        await SaveCoreAsync();
    }

    private async Task<Guid?> SaveCoreAsync()
    {
        var editorToSave = CloneProjectEditor(editor);
        var starterObjectSeeds = starterObjects
            .Where(item => !string.IsNullOrWhiteSpace(item.Title))
            .Select(item => new ProjectObjectSeedDraft(item.ObjectType, item.Title, item.Subtitle, item.Subtitle))
            .ToList();
        var loadStamp = BeginProjectLoad(new ProjectsPageLoadKey(
            ProjectsPageLoadKind.Save,
            editorToSave.Id));
        try
        {
            var result = await ProjectsService.SaveAsync(editorToSave);
            if (!result.IsSuccess)
            {
                TryCompleteProjectLoad(
                    loadStamp,
                    () => message = string.Join(" ", result.Errors.Select(error => error.Message)));
                return null;
            }

            if (starterObjectSeeds.Count > 0)
            {
                await ProjectWorkbenchSeedService.SeedProjectObjectsAsync(
                    result.Value,
                    starterObjectSeeds);
            }

            var loadedPortfolioTask = LoadPortfolioStateAsync();
            var loadedEditorTask = LoadRequiredProjectEditorAsync(result.Value);
            await Task.WhenAll(loadedPortfolioTask, loadedEditorTask);
            var loadedPortfolio = await loadedPortfolioTask;
            var loadedEditor = await loadedEditorTask;
            var committed = TryCompleteProjectLoad(loadStamp, () =>
            {
                ApplyPortfolioState(loadedPortfolio);
                editor = loadedEditor!;
                wizardStep = 0;
                starterObjects.Clear();
                message = starterObjectSeeds.Count > 0
                    ? "Project saved and starter objects seeded to the structure workbench."
                    : "Project saved.";
            });
            if (!committed)
            {
                return null;
            }

            if (ProjectIdQuery.HasValue && ProjectIdQuery != result.Value)
            {
                Navigation.NavigateTo($"/projects?projectId={result.Value}");
            }

            return result.Value;
        }
        catch
        {
            if (!FailProjectLoad(loadStamp))
            {
                return null;
            }

            throw;
        }
    }

    private async Task SaveAndOpenStructureAsync()
    {
        var savedProjectId = await SaveCoreAsync();
        if (savedProjectId.HasValue)
        {
            Navigation.NavigateTo($"/projects/{savedProjectId.Value}/structure");
        }
    }

    private async Task DeleteAsync()
    {
        if (!editor.Id.HasValue)
        {
            return;
        }

        var projectId = editor.Id.Value;
        var loadStamp = BeginProjectLoad(new ProjectsPageLoadKey(
            ProjectsPageLoadKind.Delete,
            projectId));
        try
        {
            var deletion = await ProjectsService.DeleteAsync(projectId);
            var loadedPortfolio = await LoadPortfolioStateAsync();
            if (!TryCompleteProjectLoad(loadStamp, () =>
                {
                    ApplyPortfolioState(loadedPortfolio);
                    showProjectModal = false;
                    message = deletion.Warnings.Count == 0
                        ? "Project deleted."
                        : BuildProjectDeletionWarningMessage(
                            "Project deleted with retained managed media.",
                            deletion.Warnings);
                    modalOpenedFromRoute = false;
                    projectDeletionNotice = deletion.Warnings.Count == 0
                        ? null
                        : BuildProjectDeletionWarningMessage(
                            "Project deletion completed with non-retryable storage warnings.",
                            deletion.Warnings);
                    projectDeletionNoticeIsError = deletion.Warnings.Count > 0;
                }))
            {
                return;
            }

            if (ProjectIdQuery.HasValue)
            {
                Navigation.NavigateTo("/projects", replace: true);
            }
        }
        catch (ProjectDeletionPartialCommitException)
        {
            var loadedPortfolio = await LoadPortfolioStateAsync();
            if (!TryCompleteProjectLoad(loadStamp, () =>
                {
                    ApplyPortfolioState(loadedPortfolio);
                    showProjectModal = false;
                    modalOpenedFromRoute = false;
                    projectDeletionNotice =
                        "The project was deleted, but cleanup remains pending. Retry the exact durable operation listed below.";
                    projectDeletionNoticeIsError = true;
                }))
            {
                return;
            }

            if (ProjectIdQuery.HasValue)
            {
                Navigation.NavigateTo("/projects", replace: true);
            }
        }
        catch
        {
            if (!FailProjectLoad(loadStamp))
            {
                return;
            }

            throw;
        }
    }

    private async Task RetryProjectDeletionCleanupAsync(
        ProjectDeletionPendingCleanup cleanup)
    {
        var projectId = cleanup.ProjectId;
        var loadStamp = BeginProjectLoad(new ProjectsPageLoadKey(
            ProjectsPageLoadKind.Delete,
            projectId));
        try
        {
            var deletion = await ProjectsService.RetryDeletionCleanupAsync(
                projectId,
                cleanup.ParticipantId,
                cleanup.RecoveryId);
            var loadedPortfolio = await LoadPortfolioStateAsync();
            TryCompleteProjectLoad(loadStamp, () =>
            {
                ApplyPortfolioState(loadedPortfolio);
                projectDeletionNotice = deletion.Warnings.Count == 0
                    ? "Project cleanup completed."
                    : BuildProjectDeletionWarningMessage(
                        "Project cleanup completed with non-retryable storage warnings.",
                        deletion.Warnings);
                projectDeletionNoticeIsError = deletion.Warnings.Count > 0;
            });
        }
        catch (ProjectDeletionPartialCommitException)
        {
            if (!FailProjectLoad(loadStamp))
            {
                return;
            }

            projectDeletionNotice =
                "Project cleanup is still pending. The durable operation remains available for another retry.";
            projectDeletionNoticeIsError = true;
        }
    }

    private static string BuildProjectDeletionWarningMessage(
        string message,
        IReadOnlyCollection<ProjectDeletionWarning> warnings)
        => $"{message} {string.Join(" ", warnings.Select(warning => $"{warning.Message} {warning.Remediation}"))}";


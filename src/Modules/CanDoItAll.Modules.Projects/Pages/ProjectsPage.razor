    public void Dispose() {
        disposed = true;
        CancelSearchCommit();
        editorIntent++;
        projectLoads.Invalidate();
        portfolioLoads.Invalidate();
        filesLoads.Invalidate();
        packageLoads.Invalidate();
        hierarchyLoads.Invalidate();
        editorRead?.Cancel();
        readLifetime.Cancel();
    }

    private sealed record ProjectsPortfolioState(
        IReadOnlyList<ProjectSummary> ProjectSummaries,
        IReadOnlyList<ProjectHierarchyLinkSummary> HierarchyLinks,
        IReadOnlyList<ProjectDeletionPendingCleanup> PendingDeletionCleanups,
        IReadOnlyList<ProjectDeletionCompletionNotice> DeletionCompletionNotices);
}

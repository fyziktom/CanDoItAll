@page "/projects"
@* codex-capsule
kind: page
name: ProjectsPage
summary: Surfaces projects as a card-first workspace with modal overview and editing flows instead of a permanent inline detail pane.
owns: project-cards, project-modal, phase-planning
deps: ProjectsService, IProjectWorkbenchSeedService, NavigationManager
risks: route-driven-modal-state, modal-save-regressions
tests: component:ProjectsPageTests, e2e:projects-smoke
*@
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using CanDoItAll.AgentFramework.Models
@using CanDoItAll.AppComponents.Navigation
@using CanDoItAll.Infrastructure.ControlPlane
@using CanDoItAll.Modules.Projects
@using CanDoItAll.Modules.Projects.Pages.Components
@using CanDoItAll.SharedKernel
@inject ProjectsService ProjectsService
@inject IAdmittedProjectWorkbenchSeedService ProjectWorkbenchSeedService
@inject ILogger<ProjectsPage> Logger
@implements IDisposable
@using Microsoft.Extensions.Logging
@inject IProjectPackageService ProjectPackageService
@inject IDatabaseProfileService DatabaseProfileService
@inject NavigationManager Navigation
@inject IAppNavigationHistory History

<PageTitle>Projects</PageTitle>

<PageScaffold MaxWidthClass="max-w-full" data-testid="projects-workspace" data-interactive="@interactive.ToString().ToLowerInvariant()">
    <Header>
        <div class="pr-20 sm:pr-24">
            <PageHeader Eyebrow="Projects"
                        Compact="true"
                        Title="Project workspace" />
        </div>
    </Header>

    <ChildContent>
        <ProjectDeletionStatusSurface Message="@projectDeletionNotice" IsError="projectDeletionNoticeIsError"
                                      Pending="CleanupStatuses" Completed="CleanupNotices" BusyTargets="busyCleanupTargets"
                                      Retry="RetryProjectDeletionCleanupAsync" Review="cleanupReview"
                                      ReviewChanged="value => cleanupReview = value" />
        @if (portfolioError is not null || editorError is not null) {
            <Alert AlertStyle="AlertStyle.Warning" data-testid="projects-read-error">
                <TextBlock Value="@(editorError ?? portfolioError)" />
                <Button Text="Retry project reads" Click="RetryReadsAsync" />
            </Alert>
        }

        <ProjectsBoard ProjectSummaries="projectSummaries"
                       ProjectProjection="projectFileProjection"
                       HierarchyLinks="hierarchyLinks"
                       ProjectSearch="@projectSearch"
                       ProjectSearchChanged="HandleProjectSearchChanged"
                       StatusFilter="@url.State.Status"
                       StatusFilterChanged="HandleStatusFilterChanged"
                       RelatedPartyCategoryFilter="@url.State.PartyCategory"
                       RelatedPartyCategoryFilterChanged="HandleRelatedPartyCategoryFilterChanged"
                       RelatedPartyValueFilter="@(url.State.Party ?? string.Empty)"
                       RelatedPartyValueFilterChanged="HandleRelatedPartyValueFilterChanged"
                       HierarchyFilterProjectId="@url.State.ParentId"
                       HierarchyFilterProjectIdChanged="HandleHierarchyFilterProjectChanged"
                       HierarchyFilterMode="@url.State.Scope"
                       HierarchyFilterModeChanged="HandleHierarchyFilterModeChanged"
                       IncludeSubprojects="@url.State.IncludeSubprojects"
                       IncludeSubprojectsChanged="HandleIncludeSubprojectsChanged"
                       HierarchyFilterHelper="@HierarchyFilterHelper"
                       LatestUpdatedProjectLabel="@LatestUpdatedProjectLabel"
                       LatestUpdatedProjectHelper="@LatestUpdatedProjectHelper"
                       OpenNewProject="OpenNewProjectAsync"
                       NavigateHome="NavigateHome"
                       ResetFilters="ResetFilters"
                       OpenProjectPreview="OpenProjectPreviewAsync"
                       OpenProjectFiles="OpenProjectFiles"
                       OpenHierarchyModal="OpenHierarchyModalAsync"
                       OpenProjectDashboard="OpenProjectDashboard"
                       OpenProcesses="OpenProcesses"
                       OpenStructure="OpenStructure"
                       OpenGantt="OpenGantt"
                       OpenCalendar="OpenCalendar"
                       PortfolioView="@BoardPortfolioView"
                       PortfolioViewChanged="HandlePortfolioViewChanged"
                       ProjectPackagePath="@projectPackagePath"
                       ProjectPackagePathChanged="@(value => { projectPackagePath = value; })"
                       ProjectPackageTargetProfiles="@projectPackageTargetProfiles"
                       ProjectPackageTargetProfileId="@projectPackageTargetProfileId"
                       ProjectPackageTargetProfileIdChanged="@(value => { projectPackageTargetProfileId = value; })"
                       ProjectPackageMessage="@projectPackageMessage"
                       IsProjectPackageMessageError="@projectPackageMessageIsError"
                       IsProjectPackageBusy="@(projectPackageBusy || projectPackageOutcomeUnknown)"
                       ExportProjectsPackage="ExportProjectsPackageAsync"
                       ImportProjectsPackage="ImportProjectsPackageAsync">
            <FilesContent Context="projection">
                <ProjectFilesPortfolioPane Projection="projection" />
            </FilesContent>
        </ProjectsBoard>
    </ChildContent>
</PageScaffold>

<ProjectsAgentChatContextProvider ProjectSummaries="projectSummaries"
                                  SelectedProjectId="@AgentChatFocusedProjectId"
                                  ActiveView="@AgentChatActiveView"
                                  ContextNavigationIdentity="@AgentChatNavigationFence"
                                  ContextAccessState="@AgentChatAccessState"
                                  RefreshRequested="HandleAgentChatRefreshRequestedAsync" />

<ProjectModalHost @key="draft" IsOpen="showProjectModal"
                  IsEditorMode="@(modalMode == ProjectsModalMode.Editor)"
                  Draft="draft"
                  StarterObjectKinds="starterObjectKinds"
                  ProjectSummaries="projectSummaries"
                  WizardStep="wizardStep"
                  WizardSteps="wizardSteps"
                  WizardTabs="WizardTabs"
                  Message="@message"
                  IsErrorMessage="IsErrorMessage"
                  Close="CloseProjectModalAsync"
                  SwitchToOverview="SwitchToOverview"
                  SwitchToEditor="SwitchToEditor"
                  WizardTabChanged="HandleWizardTabChanged"
                  AddPhase="AddPhaseAsync"
                  RemovePhase="RemovePhaseAsync"
                  AddStarterObject="AddStarterObject"
                  RemoveStarterObject="RemoveStarterObject"
                  PreviousStep="PreviousStep"
                  NextStep="NextStep"
                  Save="SaveAsync"
                  SaveAndOpenStructure="SaveAndOpenStructureAsync"
                  ReadCurrentDefinition="ReadCurrentDefinitionAsync"
                  DiscardAndReloadDefinition="DiscardAndReloadDefinition"
                  BeginDefinitionReconciliation="BeginDefinitionReconciliation"
                  Delete="DeleteAsync"
                  OpenProjectDashboard="OpenProjectDashboardAsync"
                  OpenProcesses="OpenProcessesAsync"
                  OpenStructure="OpenStructure"
                  OpenCalendar="OpenCalendar" />

<ProjectHierarchyModal State="hierarchyDialog"
                       Close="CloseHierarchyModalAsync"
                       OpenProjectPreview="OpenProjectPreviewAsync"
                       OpenStructure="OpenStructure"
                       OpenHierarchy="OpenHierarchyModalAsync" />

<ProjectFilesDialog IsOpen="@(projectFilesDialogProject is not null)"
                    ProjectId="@(projectFilesDialogProject?.Id ?? Guid.Empty)"
                    ProjectName="@(projectFilesDialogProject?.Name ?? string.Empty)"
                    Closed="CloseProjectFilesAsync" />

@code {
    private static readonly string[] wizardSteps = ["Identity", "Dates and phases", "Stack profile", "Linked objects", "Review"];

    private static readonly ProjectObjectType[] starterObjectKinds =
    [
        ProjectObjectType.Note,
        ProjectObjectType.Decision,
        ProjectObjectType.Milestone,
        ProjectObjectType.Repository,
        ProjectObjectType.Link
    ];

    private static readonly ProjectsEditorStep[] editorSteps =
    [
        ProjectsEditorStep.Identity,
        ProjectsEditorStep.Dates,
        ProjectsEditorStep.Stack,
        ProjectsEditorStep.Links,
        ProjectsEditorStep.Review
    ];

    private static readonly TimeSpan SearchCommitDelay = TimeSpan.FromMilliseconds(300);

    [SupplyParameterFromQuery(Name = ProjectsUrlCodec.ProjectKey)]
    public string? ProjectIdQuery { get; set; }

    [SupplyParameterFromQuery(Name = ProjectsUrlCodec.ModeKey)]
    public string? ModeQuery { get; set; }

    [SupplyParameterFromQuery(Name = ProjectsUrlCodec.StepKey)]
    public string? StepQuery { get; set; }

    [SupplyParameterFromQuery(Name = ProjectsUrlCodec.SearchKey)]
    public string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = ProjectsUrlCodec.StatusKey)]
    public string? StatusQuery { get; set; }

    [SupplyParameterFromQuery(Name = ProjectsUrlCodec.PartyCategoryKey)]
    public string? PartyCategoryQuery { get; set; }

    [SupplyParameterFromQuery(Name = ProjectsUrlCodec.PartyKey)]
    public string? PartyQuery { get; set; }

    [SupplyParameterFromQuery(Name = ProjectsUrlCodec.ParentKey)]
    public string? ParentQuery { get; set; }

    [SupplyParameterFromQuery(Name = ProjectsUrlCodec.ScopeKey)]
    public string? ScopeQuery { get; set; }

    [SupplyParameterFromQuery(Name = ProjectsUrlCodec.SubprojectsKey)]
    public string? SubprojectsQuery { get; set; }

    [SupplyParameterFromQuery(Name = ProjectsUrlCodec.ViewKey)]
    public string? ViewQuery { get; set; }

    [SupplyParameterFromQuery(Name = ProjectsUrlCodec.HierarchyKey)]
    public string? HierarchyQuery { get; set; }

    [SupplyParameterFromQuery(Name = ProjectsUrlCodec.FilesKey)]
    public string? FilesQuery { get; set; }

    private UrlStateBinding<ProjectsUrlState> url = default!;
    private CancellationTokenSource? searchCommit;
    private IReadOnlyList<ProjectSummary> projectSummaries = [];
    private IReadOnlyList<ProjectHierarchyLinkSummary> hierarchyLinks = [];
    private ProjectFileFilterProjection projectFileProjection = ProjectFileFilterProjection.Create(
        [],
        [],
        new ProjectFileFilter());
    private ProjectEditorDraft draft = new(new());
    private ProjectEditorModel editor => draft.Model;
    private List<StarterObjectDraft> starterObjects => draft.StarterObjects;
    private string? message {
        get => draft.Message;
        set => draft.Message = value;
    }
    private readonly Dictionary<Guid, ProjectEditorDraft> mutationTargets = [];
    private readonly HashSet<ProjectCleanupTarget> busyCleanupTargets = [];
    private ProjectCleanupReview? cleanupReview;
    private readonly ProjectsPageLoadGeneration portfolioLoads = new();
    private readonly ProjectsPageLoadGeneration packageLoads = new();
    private readonly ProjectsPageLoadGeneration filesLoads = new();
    private readonly ProjectsPageLoadGeneration hierarchyLoads = new();
    private CancellationTokenSource? editorRead;
    private readonly CancellationTokenSource readLifetime = new();
    private long editorIntent;
    private bool disposed;
    private bool interactive;
    private Guid? failedEditorId;
    private string? portfolioError;
    private string? editorError;
    private string? projectDeletionNotice;
    private bool projectDeletionNoticeIsError;
    private readonly List<ProjectDeletionPendingCleanup> pendingProjectDeletionCleanups = [];
    private readonly List<ProjectDeletionCompletionNotice> projectDeletionCompletionNotices = [];
    private int wizardStep;
    private bool showProjectModal;
    private string projectSearch = string.Empty;
    private ProjectsModalMode modalMode = ProjectsModalMode.Overview;
    private bool modalOpenedFromRoute;
    private ProjectHierarchyDialogState? hierarchyDialog;
    private ProjectSummary? projectFilesDialogProject;
    private string projectPackagePath = string.Empty;
    private IReadOnlyList<ProjectPackageTargetOption> projectPackageTargetProfiles = [];
    private Guid? projectPackageTargetProfileId;
    private string? projectPackageMessage;
    private bool projectPackageMessageIsError;
    private bool projectPackageBusy;
    private bool projectPackageOutcomeUnknown;
    private AgentChatContextAccessState agentChatPositionAccessState = AgentChatContextAccessState.Ready;
    private AgentChatContextAccessState portfolioAccessState = AgentChatContextAccessState.Loading;
    private readonly ProjectsPageLoadGeneration projectLoads = new();

    private Guid? RouteProjectId => url.State.ProjectId;

    // The agent-chat position is matched with the shell's identity of the arrived location, so it never follows an intent in flight.
    private AgentChatNavigationIdentity AgentChatNavigationFence
        => AgentChatNavigationIdentity.CreateForLocation(
            Navigation.BaseUri,
            Navigation.Uri,
            [new(ProjectsUrlCodec.ProjectKey, ProjectsUrlCodec.Instance.Read(Navigation.Uri).ProjectId?.ToString("D"))]);

    private ProjectsAgentChatView BoardPortfolioView => url.State.View switch
    {
        ProjectsPortfolioView.Cards => ProjectsAgentChatView.Cards,
        ProjectsPortfolioView.Files => ProjectsAgentChatView.Files,
        _ => throw new ArgumentOutOfRangeException(nameof(url.State.View), url.State.View, "The Projects portfolio view is undefined.")
    };

    private Task HandlePortfolioViewChanged(ProjectsAgentChatView view)
    {
        var next = view switch
        {
            ProjectsAgentChatView.Cards => ProjectsPortfolioView.Cards,
            ProjectsAgentChatView.Files => ProjectsPortfolioView.Files,
            _ => throw new ArgumentOutOfRangeException(nameof(view), view, "The Projects portfolio view is undefined.")
        };
        CommitPendingSearch();
        url.Navigate(url.State with { View = next }, UrlHistoryMode.Push);
        return Task.CompletedTask;
    }

    private Guid? AgentChatFocusedProjectId
    {
        get
        {
            if (hierarchyDialog is not null)
            {
                return hierarchyDialog.ProjectId;
            }

            if (projectFilesDialogProject is not null)
            {
                return projectFilesDialogProject.Id;
            }

            if (showProjectModal)
            {
                return editor.Id;
            }

            return url.State.ParentId;
        }
    }

    private string HierarchyFilterHelper
        => url.State.ParentId is not { } parentId
            ? "Showing main projects. Choose a project to show it with its subprojects or narrow by direct links."
            : url.State.Scope switch
            {
                ProjectHierarchyFilterMode.Descendants when url.State.IncludeSubprojects
                    => $"Showing {ResolveProjectName(parentId)} and its subprojects.",
                ProjectHierarchyFilterMode.Descendants
                    => $"Showing only {ResolveProjectName(parentId)}.",
                ProjectHierarchyFilterMode.Children
                    => $"Showing direct subprojects of {ResolveProjectName(parentId)}.",
                ProjectHierarchyFilterMode.Parents
                    => $"Showing direct parents of {ResolveProjectName(parentId)}.",
                ProjectHierarchyFilterMode.Related
                    => $"Showing the direct relationship neighborhood around {ResolveProjectName(parentId)}.",
                _ => throw new ArgumentOutOfRangeException(nameof(url.State.Scope))
            };

    private IReadOnlyList<ProjectOptionEditorModel> MeaningfulOptions => editor.Options
        .Where(option => !string.IsNullOrWhiteSpace(option.OptionName) || !string.IsNullOrWhiteSpace(option.Notes))
        .ToList();

    private IReadOnlyList<SecondaryTabItem> WizardTabs => wizardSteps
        .Select((step, index) => new SecondaryTabItem(index.ToString(), $"{index + 1}. {step}"))
        .ToList();

    private bool IsErrorMessage => draft.IsError;

    private string LatestUpdatedProjectLabel
        => projectSummaries.Count == 0
            ? "No projects"
            : projectSummaries.OrderByDescending(project => project.UpdatedAtUtc).First().UpdatedAtUtc.LocalDateTime.ToString("g");

    private string LatestUpdatedProjectHelper
        => projectSummaries.Count == 0
            ? "Save the first project to populate the workspace."
            : projectSummaries.OrderByDescending(project => project.UpdatedAtUtc).First().Name;

    protected override void OnInitialized()
        => url = new(Navigation, ProjectsUrlCodec.Instance, History, typeof(ProjectsPage));

    protected override Task OnParametersSetAsync() {
        var change = url.Apply(canonicalize: RendererInfo.IsInteractive);
        if (!change.IsChanged) {
            return Task.CompletedTask;
        }
        CancelSearchCommit();
        projectSearch = change.Current.Search ?? string.Empty;
        RebuildProjectFileProjection();
        var overlays = ApplyOverlaysAsync(change.Previous, change.Current, change.IsInitial);
        return change.IsInitial
            ? Task.WhenAll(overlays, RefreshPortfolioAsync(), RefreshPackageTargetsAsync())
            : overlays;
    }

    private Task ApplyOverlaysAsync(ProjectsUrlState previous, ProjectsUrlState current, bool initial) {
        var reads = new List<Task>(3);
        if (initial || previous.ProjectId != current.ProjectId) {
            if (current.ProjectId is { } id) {
                reads.Add(AcquireEditorAsync(id, fromRoute: true));
            } else if (modalOpenedFromRoute) {
                RetireEditor();
            }
        } else if (current.ProjectId is not null && modalOpenedFromRoute && showProjectModal) {
            ApplyModalSection(current);
        }
        if (initial || previous.HierarchyId != current.HierarchyId) {
            if (current.HierarchyId is { } hierarchyId) {
                reads.Add(LoadHierarchyAsync(hierarchyId));
            } else {
                hierarchyLoads.Invalidate();
                hierarchyDialog = null;
            }
        }
        if (initial || previous.FilesId != current.FilesId) {
            if (current.FilesId is { } filesId) {
                reads.Add(LoadProjectFilesAsync(filesId));
            } else {
                filesLoads.Invalidate();
                projectFilesDialogProject = null;
            }
        }
        return Task.WhenAll(reads);
    }

    private void ApplyModalSection(ProjectsUrlState state) {
        modalMode = state.Mode;
        if (state.Mode == ProjectsModalMode.Editor) {
            wizardStep = Array.IndexOf(editorSteps, state.Step);
        }
    }

    private void PublishModalSection() {
        if (!modalOpenedFromRoute || editor.Id is not { } id || url.State.ProjectId != id) {
            return;
        }
        url.Navigate(url.State with { Mode = modalMode, Step = editorSteps[wizardStep] }, UrlHistoryMode.Replace);
    }

    // Selecting another overlay while one is open replaces it, so Close and Back still return to the board.
    private void NavigateOverlay(ProjectsUrlState next) {
        CommitPendingSearch();
        next = next with { Search = url.State.Search };
        if (url.State.HasOverlay) {
            url.Navigate(next, UrlHistoryMode.Replace);
        } else {
            url.OpenOverlay(next);
        }
    }

    private Task RetryReadsAsync() => Task.WhenAll(RefreshPortfolioAsync(), RefreshPackageTargetsAsync(),
        failedEditorId is { } id ? AcquireEditorAsync(id, RouteProjectId == id) : Task.CompletedTask);

    private async Task RefreshPortfolioAsync() {
        var stamp = portfolioLoads.Begin(new(ProjectsPageLoadKind.CompletionRefresh, null));
        portfolioAccessState = AgentChatContextAccessState.Loading;
        try {
            var state = await LoadPortfolioStateAsync();
            if (!disposed) {
                portfolioLoads.TryCommit(stamp, RouteProjectId, () => {
                    ApplyPortfolioState(state);
                    unconfirmedCleanupTargets.Clear();
                    portfolioError = null;
                    portfolioAccessState = AgentChatContextAccessState.Ready;
                });
            }
        } catch (OperationCanceledException) when (readLifetime.IsCancellationRequested) {
        } catch (Exception exception) {
            Logger.LogError(exception, "Projects portfolio read failed; acquired drafts and acknowledged mutations are retained.");
            if (!disposed) {
                portfolioLoads.TryCommit(stamp, RouteProjectId, () => {
                    portfolioError = "Unable to refresh the portfolio. Acquired edits and completed operations are retained.";
                    portfolioAccessState = AgentChatContextAccessState.Failed;
                });
            }
        }
    }

    private async Task RefreshPackageTargetsAsync() {
        var stamp = packageLoads.Begin(new(ProjectsPageLoadKind.CompletionRefresh, null));
        try {
            var profiles = await LoadProjectPackageTargetProfilesAsync();
            if (!disposed) {
                packageLoads.TryCommit(stamp, RouteProjectId, () => ApplyProjectPackageTargetProfiles(profiles));
            }
        } catch (OperationCanceledException) when (readLifetime.IsCancellationRequested) {
        } catch (Exception exception) {
            Logger.LogError(exception, "Project package target read failed.");
            packageLoads.TryCommit(stamp, RouteProjectId, () => {
                projectPackageTargetProfiles = [];
                projectPackageMessage = "Unable to read package targets. Retry project reads to refresh the available targets.";
                projectPackageMessageIsError = true;
            });
        }
    }

    // The board filters per keystroke; the URL takes the committed text once typing pauses.
    private Task HandleProjectSearchChanged(string value)
    {
        projectSearch = value.Length > ProjectFileFilter.MaximumTextLength ? value[..ProjectFileFilter.MaximumTextLength] : value;
        RebuildProjectFileProjection();
        ScheduleSearchCommit();
        return Task.CompletedTask;
    }

    private void ScheduleSearchCommit() {
        CancelSearchCommit();
        var pending = new CancellationTokenSource();
        searchCommit = pending;
        _ = CommitSearchAsync(pending);
    }

    private async Task CommitSearchAsync(CancellationTokenSource pending) {
        try {
            await Task.Delay(SearchCommitDelay, pending.Token);
        } catch (OperationCanceledException) {
            return;
        }
        await InvokeAsync(() => {
            if (disposed || !ReferenceEquals(searchCommit, pending)) {
                return;
            }
            searchCommit = null;
            url.Navigate(url.State with { Search = projectSearch }, UrlHistoryMode.Replace);
        });
    }

    // A pushed entry and its parent marker must carry the text the operator already typed.
    private void CommitPendingSearch() {
        if (searchCommit is null) {
            return;
        }
        CancelSearchCommit();
        url.Navigate(url.State with { Search = projectSearch }, UrlHistoryMode.Replace);
    }

    private void CancelSearchCommit() {
        var pending = searchCommit;
        searchCommit = null;
        pending?.Cancel();
    }

    private void ApplyFilter(ProjectsUrlState next) {
        CancelSearchCommit();
        url.Navigate(next with { Search = projectSearch }, UrlHistoryMode.Replace);
        RebuildProjectFileProjection();
    }

    private Task HandleStatusFilterChanged(ProjectStatus? value)
    {
        ApplyFilter(url.State with { Status = value });
        return Task.CompletedTask;
    }

    private Task HandleRelatedPartyCategoryFilterChanged(ProjectPartyPortfolioCategory? value)
    {
        var next = url.State with { PartyCategory = value };
        if (!string.IsNullOrWhiteSpace(next.Party) &&
            !ProjectFileFilterProjection.Create(
                projectSummaries,
                hierarchyLinks,
                CreateProjectFileFilter(next)).AvailableRelatedPartyValues.Contains(
                    next.Party,
                    StringComparer.OrdinalIgnoreCase))
        {
            next = next with { Party = null };
        }

        ApplyFilter(next);
        return Task.CompletedTask;
    }

    private Task HandleRelatedPartyValueFilterChanged(string value)
    {
        ApplyFilter(url.State with { Party = value });
        return Task.CompletedTask;
    }

    private Task HandleHierarchyFilterProjectChanged(Guid? value)
    {
        ApplyFilter(url.State with { ParentId = value });
        return Task.CompletedTask;
    }

    private Task HandleHierarchyFilterModeChanged(ProjectHierarchyFilterMode value)
    {
        ApplyFilter(url.State with { Scope = value });
        return Task.CompletedTask;
    }

    private Task HandleIncludeSubprojectsChanged(bool value)
    {
        ApplyFilter(url.State with { IncludeSubprojects = value });
        return Task.CompletedTask;
    }

    private async Task<ProjectsPortfolioState> LoadPortfolioStateAsync()
    {
        var projectSummariesTask = ProjectsService.ListAsync(readLifetime.Token);
        var hierarchyLinksTask = ProjectsService.ListHierarchyLinksAsync(readLifetime.Token);
        var deletionCleanupsTask = ProjectsService.ListPendingDeletionCleanupsAsync(readLifetime.Token);
        var deletionNoticesTask = ProjectsService.ListDeletionCompletionNoticesAsync(readLifetime.Token);
        await Task.WhenAll(
            projectSummariesTask,
            hierarchyLinksTask,
            deletionCleanupsTask,
            deletionNoticesTask);
        return new ProjectsPortfolioState(
            await projectSummariesTask,
            await hierarchyLinksTask,
            await deletionCleanupsTask,
            await deletionNoticesTask);
    }

    private void ApplyPortfolioState(ProjectsPortfolioState state)
    {
        projectSummaries = state.ProjectSummaries;
        hierarchyLinks = state.HierarchyLinks;
        pendingProjectDeletionCleanups.Clear();
        pendingProjectDeletionCleanups.AddRange(state.PendingDeletionCleanups);
        projectDeletionCompletionNotices.Clear();
        projectDeletionCompletionNotices.AddRange(
            state.DeletionCompletionNotices.Where(notice => notice.Warnings.Count > 0));
        RebuildProjectFileProjection();
    }

    private async Task<IReadOnlyList<ProjectPackageTargetOption>>
        LoadProjectPackageTargetProfilesAsync()
    {
        var profiles = await DatabaseProfileService.ListAsync(readLifetime.Token);
        return profiles
            .Where(profile =>
                !profile.IsActive &&
                !profile.IsRuntimeLocked &&
                !profile.IsPendingRestartActivation)
            .OrderBy(profile => profile.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(profile => profile.Id)
            .Select(profile => new ProjectPackageTargetOption(profile.Id, profile.DisplayName, profile.Descriptor))
            .ToArray();
    }

    private void ApplyProjectPackageTargetProfiles(
        IReadOnlyList<ProjectPackageTargetOption> profiles)
    {
        projectPackageTargetProfiles = profiles;
        if (projectPackageTargetProfileId.HasValue &&
            profiles.All(profile => profile.Id != projectPackageTargetProfileId.Value))
        {
            projectPackageTargetProfileId = null;
        }
    }

    private static string FormatCompletionOperation(
        ProjectDeletionCompletionOperation operation)
        => operation switch
        {
            ProjectDeletionCompletionOperation.ProjectDeletion => "project deletion",
            ProjectDeletionCompletionOperation.ProjectNodeCleanup => "prior node cleanup",
            _ => throw new ArgumentOutOfRangeException(nameof(operation), operation, null)
        };

    private Task HandleAgentChatRefreshRequestedAsync(AgentChatExecutionCompleted notification)
        => RefreshPortfolioAsync();

    // A new project is a draft and stays out of the URL until its first save.
    private async Task OpenNewProjectAsync() {
        if (url.State.HasOverlay) {
            var previous = url.State;
            url.Navigate(previous.WithoutOverlay(), UrlHistoryMode.Replace);
            await ApplyOverlaysAsync(previous, url.State, initial: false);
        }
        await AcquireEditorAsync(null, fromRoute: false);
    }

    private Task OpenProjectPreviewAsync(Guid id) {
        var previous = url.State;
        NavigateOverlay(previous.WithoutOverlay() with { ProjectId = id });
        return ApplyOverlaysAsync(previous, url.State, initial: false);
    }

    private async Task AcquireEditorAsync(Guid? id, bool fromRoute) {
        if (id.HasValue && showProjectModal && editor.Id == id && failedEditorId is null) {
            return;
        }
        long intent = ++editorIntent;
        editorRead?.Cancel();
        using var read = CancellationTokenSource.CreateLinkedTokenSource(readLifetime.Token);
        editorRead = read;
        var stamp = BeginProjectLoad(new(fromRoute ? ProjectsPageLoadKind.Route : id.HasValue ? ProjectsPageLoadKind.Preview : ProjectsPageLoadKind.NewProject, id));
        showProjectModal = false;
        editorError = null;
        try {
            var loaded = await ProjectsService.GetAsync(id, read.Token);
            if (id.HasValue && loaded.Id != id) {
                throw new InvalidOperationException($"Project '{id:D}' is unavailable.");
            }
            if (disposed || intent != editorIntent || read.IsCancellationRequested) {
                return;
            }
            TryCompleteProjectLoad(stamp, () => {
                draft = new(loaded);
                wizardStep = 0;
                modalMode = id.HasValue ? ProjectsModalMode.Overview : ProjectsModalMode.Editor;
                if (fromRoute) {
                    ApplyModalSection(url.State);
                }
                showProjectModal = true;
                modalOpenedFromRoute = fromRoute;
                failedEditorId = null;
            });
        } catch (OperationCanceledException) when (read.IsCancellationRequested) {
        } catch (Exception exception) {
            Logger.LogError(exception, "Project editor acquisition failed for {ProjectId}.", id);
            if (!disposed && intent == editorIntent && FailProjectLoad(stamp)) {
                failedEditorId = id;
                editorError = $"Unable to acquire project {id:D}. Retry the read before editing.";
            }
        } finally {
            if (ReferenceEquals(editorRead, read)) {
                editorRead = null;
            }
        }
    }

    private void RetireEditor() {
        editorIntent++;
        editorRead?.Cancel();
        InvalidateProjectLoad();
        showProjectModal = false;
        modalOpenedFromRoute = false;
        failedEditorId = null;
        editorError = null;
        draft = new(new());
    }

    private ProjectsPageLoadStamp BeginProjectLoad(ProjectsPageLoadKey key)
    {

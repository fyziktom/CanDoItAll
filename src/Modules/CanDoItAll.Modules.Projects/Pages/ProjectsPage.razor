    private async Task LoadProjectFilesAsync(Guid projectId)
    {
        var loadStamp = filesLoads.Begin(new ProjectsPageLoadKey(
            ProjectsPageLoadKind.Files,
            projectId));
        projectFilesDialogProject = null;
        try
        {
            var project = projectSummaries.FirstOrDefault(item => item.Id == projectId)
                ?? await ProjectsService.GetSummaryAsync(projectId, readLifetime.Token);

            if (project is null)
            {
                throw new InvalidOperationException($"Project '{projectId:D}' is unavailable.");
            }

            filesLoads.TryCommit(loadStamp, RouteProjectId, () =>
            {
                projectFilesDialogProject = project;
            });
        }
        catch (OperationCanceledException) when (readLifetime.IsCancellationRequested) {
        }
        catch (Exception exception) {
            Logger.LogError(exception, "Project Files selection could not be acquired for {ProjectId}.", projectId);
            filesLoads.TryCommit(loadStamp, RouteProjectId, () => portfolioError = "Unable to open the selected project's files. Retry the selection after refreshing the portfolio.");
        }
    }


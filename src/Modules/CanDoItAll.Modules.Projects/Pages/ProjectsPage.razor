    private async Task<Guid?> SaveCoreAsync(ProjectEditorSubmission submitted) {
        var target = draft;
        if (!showProjectModal || !target.Validate() || !TryAdmitMutation(target, ProjectEditorMutationState.Saving)) {
            return null;
        }
        long intent = ++editorIntent;
        bool projectCommitted = false;
        bool seeding = false;
        try {
            var result = await ProjectsService.SaveEditorAsync(submitted.Model);
            if (result.IsFailure) {
                if (result.Errors.Any(error => error.Code == ProjectErrorCodes.DefinitionConflict)) {
                    ReleaseMutation(target, ProjectEditorMutationState.Conflict);
                    target.RecordConflict(submitted);
                    return null;
                }
                target.Message = string.Join(" ", result.Errors.Select(error => error.Message));
                target.IsError = true;
                ReleaseMutation(target);
                return null;
            }
            projectCommitted = true;
            target.RecordAcceptedOutcome(submitted, result.Value!);
            mutationTargets[result.Value!.Project.ProjectId] = target;
            target.Acknowledge(submitted, result.Value);
            if (submitted.Model.Id is null && IsActiveEditor(target, intent)) {
                PublishCreatedProject(result.Value.Project.ProjectId);
            }
            target.Message = "Project saved.";
            target.IsError = false;
            if (submitted.Seeds.Count > 0) {
                target.Mutation = ProjectEditorMutationState.Seeding;
                seeding = true;
                try {
                    await ProjectWorkbenchSeedService.SeedProjectObjectsAsync(result.Value.Project, submitted.Seeds.Select(seed => seed.Value).ToArray());
                } catch (ProjectWriteAdmissionRejectedException exception) when (exception.Admission == result.Value.Project) {
                    RefuseMutation(target, exception, "Project saved. Starter-object creation was refused because the acquired project lifetime no longer exists. Close and reopen the current project before another write.");
                    return null;
                }
                target.AcknowledgeSeeds(submitted);
                seeding = false;
                target.Message = "Project saved and starter objects seeded to the structure workbench.";
            }
            ReleaseMutation(target);
            await RefreshPortfolioAsync();
            if (target.EditRevision != submitted.EditRevision) {
                target.Message += " Newer edits remain unsaved.";
                return null;
            }
            return IsActiveEditor(target, intent) ? result.Value.Project.ProjectId : null;
        } catch (Exception exception) {
            Logger.LogError(exception, "Project editor operation failed for {ProjectId}; current stage {Stage}.", target.Model.Id, target.Mutation);
            target.Mutation = !projectCommitted ? ProjectEditorMutationState.SaveOutcomeUnknown
                : seeding ? ProjectEditorMutationState.SeedOutcomeUnknown : ProjectEditorMutationState.SaveReconciliationFailed;
            target.Message = !projectCommitted
                ? "Save completion is unconfirmed. Inspect the project inventory before attempting another write."
                : seeding
                ? "Project saved. Starter-object completion is unconfirmed. Inspect Structure before creating any of these objects again."
                : "Project saved, but its accepted result could not be reconciled safely with this draft. Your input is preserved. Inspect the saved project before another write.";
            target.IsError = true;
            return null;
        }
    }

    private bool TryAdmitMutation(ProjectEditorDraft target, ProjectEditorMutationState operation) {
        if (!target.CanMutate) {
            return false;
        }
        if (target.Model.Id is { } id && mutationTargets.ContainsKey(id)) {
            target.Message = "A previous operation for this project is still pending or unconfirmed. Observe its result before another write.";
            target.IsError = true;
            return false;
        }
        target.Mutation = operation;
        if (target.Model.Id is { } projectId) {
            mutationTargets.Add(projectId, target);
        }
        return true;
    }

    private void ReleaseMutation(ProjectEditorDraft target, ProjectEditorMutationState state = ProjectEditorMutationState.Ready) {
        target.Mutation = state;
        if (target.Model.Id is { } id && mutationTargets.TryGetValue(id, out var owner) && ReferenceEquals(owner, target)) {
            mutationTargets.Remove(id);
        }
    }

    private void RefuseMutation(ProjectEditorDraft target, ProjectWriteAdmissionRejectedException exception, string message) {
        Logger.LogWarning(exception, "Project operation refused before native writes for {ProjectId}; stage {Stage}.", target.Model.Id, target.Mutation);
        ReleaseMutation(target, ProjectEditorMutationState.AdmissionRefused);
        target.Message = message;
        target.IsError = true;
    }

    private bool IsActiveEditor(ProjectEditorDraft target, long intent)
        => !disposed && showProjectModal && ReferenceEquals(draft, target) && editorIntent == intent;

    private async Task ReadCurrentDefinitionAsync(ProjectEditorDraft target) {
        if (!showProjectModal || !ReferenceEquals(draft, target) || target.Model.Id is not { } projectId ||
            target.Conflict is null or { ReadState: ProjectEditorConflictReadState.Loading }) {
            return;
        }
        long intent = ++editorIntent;
        editorRead?.Cancel();
        using var read = CancellationTokenSource.CreateLinkedTokenSource(readLifetime.Token);
        editorRead = read;
        target.BeginConflictRead();
        try {
            var result = await ProjectsService.GetDefinitionAsync(projectId, read.Token);
            if (!IsActiveEditor(target, intent) || read.IsCancellationRequested) {
                return;
            }
            if (result.IsFailure) {
                target.FailConflictRead(string.Join(" ", result.Errors.Select(error => error.Message)));
                return;
            }
            target.CompleteConflictRead(result.Value!);
        } catch (OperationCanceledException) when (read.IsCancellationRequested) {
        } catch (Exception exception) {
            Logger.LogError(exception, "Current project definition comparison failed for {ProjectId}.", projectId);
            if (IsActiveEditor(target, intent)) {
                target.FailConflictRead("Unable to read the current definition. Your draft is preserved; retry the comparison read.");
            }
        } finally {
            if (ReferenceEquals(editorRead, read)) {
                editorRead = null;
            }
        }
    }

    private void DiscardAndReloadDefinition(ProjectEditorDraft target) => StartCurrentDefinitionDraft(target, preservePrevious: false);

    private void BeginDefinitionReconciliation(ProjectEditorDraft target) => StartCurrentDefinitionDraft(target, preservePrevious: true);

    private void StartCurrentDefinitionDraft(ProjectEditorDraft target, bool preservePrevious) {
        if (!showProjectModal || !ReferenceEquals(draft, target) ||
            target.Conflict is not { ReadState: ProjectEditorConflictReadState.Ready }) {
            return;
        }
        if (preservePrevious && !target.EditContext.Validate()) {
            target.Message = "Complete or clear invalid dates before preserving this draft for reconciliation. Discard and reload remains available.";
            target.IsError = true;
            return;
        }
        editorIntent++;
        editorRead?.Cancel();
        draft = target.StartFromCurrent(preservePrevious);
        wizardStep = 0;
        modalMode = ProjectsModalMode.Editor;
        PublishModalSection();
    }


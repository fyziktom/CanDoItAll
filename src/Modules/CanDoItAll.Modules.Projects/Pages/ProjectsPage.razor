    private ProjectsAgentChatView AgentChatActiveView => hierarchyDialog is not null ? ProjectsAgentChatView.Hierarchy
        : projectFilesDialogProject is not null ? ProjectsAgentChatView.Files
        : showProjectModal ? modalMode == ProjectModalMode.Editor ? ProjectsAgentChatView.Editor : ProjectsAgentChatView.Overview
        : agentChatPortfolioView;

    private AgentChatContextAccessState AgentChatAccessState => (portfolioAccessState, agentChatPositionAccessState) switch {
        (AgentChatContextAccessState.Failed, _) or (_, AgentChatContextAccessState.Failed) => AgentChatContextAccessState.Failed,
        (AgentChatContextAccessState.Loading, _) or (_, AgentChatContextAccessState.Loading) => AgentChatContextAccessState.Loading,
        _ => AgentChatContextAccessState.Ready
    };

    protected override void OnAfterRender(bool firstRender) {
        if (firstRender) {
            interactive = true;
            StateHasChanged();
        }
    }

    public void Dispose() {
        disposed = true;
        editorIntent++;
        projectLoads.Invalidate();
        portfolioLoads.Invalidate();
        filesLoads.Invalidate();
        packageLoads.Invalidate();
        hierarchyLoads.Invalidate();
        editorRead?.Cancel();
        readLifetime.Cancel();
    }

    private sealed record ProjectsPortfolioState(
        IReadOnlyList<ProjectSummary> ProjectSummaries,
        IReadOnlyList<ProjectHierarchyLinkSummary> HierarchyLinks,
        IReadOnlyList<ProjectDeletionPendingCleanup> PendingDeletionCleanups,
        IReadOnlyList<ProjectDeletionCompletionNotice> DeletionCompletionNotices);

    private enum ProjectModalMode
    {
        Overview,
        Editor
    }

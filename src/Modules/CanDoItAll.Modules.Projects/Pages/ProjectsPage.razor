    private async Task DeleteAsync() {
        var target = draft;
        if (!showProjectModal || target.Model.Id is not { } id || !TryAdmitMutation(target, ProjectEditorMutationState.Deleting)) {
            return;
        }
        long intent = ++editorIntent;
        var admission = target.Model.ExpectedProjectAdmission;
        try {
            if (admission is null) {
                throw new InvalidOperationException("The acquired editor has no owner-issued deletion admission.");
            }
            var deletion = await ProjectsService.DeleteAsync(id, expectedProjectAdmission: admission);
            RecordDeletion(target, intent);
            projectDeletionNotice = deletion.Warnings.Count == 0 ? "Project deleted."
                : "Project deleted. Retained media is recorded in cleanup history.";
            projectDeletionNoticeIsError = false;
        } catch (ProjectWriteAdmissionRejectedException exception) when (admission is not null && exception.Admission == admission) {
            RefuseMutation(target, exception, "Deletion was refused because the acquired project lifetime no longer exists. Close and reopen the current project before another write.");
            return;
        } catch (ProjectDeletionPartialCommitException exception) {
            RecordDeletion(target, intent);
            foreach (var failure in exception.Recovery.Failures.Where(item => item.RecoveryId.HasValue)) {
                if (!pendingProjectDeletionCleanups.Any(item => item.ProjectId == id && item.ParticipantId == failure.ParticipantId && item.RecoveryId == failure.RecoveryId)) {
                    pendingProjectDeletionCleanups.Add(new(id, failure.ParticipantId, failure.RecoveryId!.Value,
                        ProjectDeletionRecoveryStatus.Failed, true, null, exception.Recovery.RetryGuidance));
                }
            }
            projectDeletionNotice = "The project was deleted, but cleanup remains pending. Retry the exact durable operation listed below.";
            projectDeletionNoticeIsError = true;
        } catch (Exception exception) {
            Logger.LogError(exception, "Project deletion outcome is unconfirmed for {ProjectId}.", id);
            target.Mutation = ProjectEditorMutationState.DeleteOutcomeUnknown;
            target.Message = "Deletion completion is unconfirmed. Refresh the inventory and inspect cleanup before another write.";
            target.IsError = true;
            return;
        }
        await RefreshPortfolioAsync();
    }

    private void RecordDeletion(ProjectEditorDraft target, long intent) {
        portfolioLoads.Invalidate();
        Guid id = target.Model.Id!.Value;
        ReleaseMutation(target);
        target.Mutation = ProjectEditorMutationState.Deleted;
        projectSummaries = projectSummaries.Where(project => project.Id != id).ToArray();
        hierarchyLinks = hierarchyLinks.Where(link => link.ParentProjectId != id && link.ChildProjectId != id).ToArray();
        var next = url.State.ParentId == id ? url.State with { ParentId = null } : url.State;
        if (IsActiveEditor(target, intent)) {
            bool routed = modalOpenedFromRoute;
            RetireEditor();
            if (routed && next.ProjectId == id) {
                next = next.WithoutOverlay();
            }
        }
        if (next != url.State) {
            url.Navigate(next, UrlHistoryMode.Replace);
        }
        RebuildProjectFileProjection();
    }

    private async Task RetryProjectDeletionCleanupAsync(ProjectCleanupTarget target) {
        if (!pendingProjectDeletionCleanups.Any(cleanup => cleanup.ProjectId == target.ProjectId && cleanup.ParticipantId == target.ParticipantId && cleanup.RecoveryId == target.RecoveryId) ||
            unconfirmedCleanupTargets.Contains(target) || !busyCleanupTargets.Add(target)) {
            return;
        }
        try {
            var result = await ProjectsService.RetryDeletionCleanupAsync(target.ProjectId, target.ParticipantId, target.RecoveryId);
            portfolioLoads.Invalidate();
            pendingProjectDeletionCleanups.RemoveAll(cleanup => cleanup.ProjectId == target.ProjectId && cleanup.ParticipantId == target.ParticipantId && cleanup.RecoveryId == target.RecoveryId);
            projectDeletionNotice = result.Warnings.Count == 0 ? "Project cleanup completed."
                : "Project cleanup completed. Retained media is recorded in cleanup history.";
            projectDeletionNoticeIsError = false;
        } catch (ProjectDeletionPartialCommitException) {
            projectDeletionNotice = "Project cleanup is still pending. The exact durable operation remains available for another retry.";
            projectDeletionNoticeIsError = true;
        } catch (Exception exception) {
            Logger.LogError(exception, "Project cleanup observation failed for {ProjectId}, {ParticipantId}, {RecoveryId}.", target.ProjectId, target.ParticipantId, target.RecoveryId);
            unconfirmedCleanupTargets.Add(target);
            projectDeletionNotice = "Cleanup completion is unconfirmed. Refresh the inventory before another explicit retry.";
            projectDeletionNoticeIsError = true;
        } finally {
            busyCleanupTargets.Remove(target);
        }
        await RefreshPortfolioAsync();
    }

    private IReadOnlyList<ProjectCleanupStatus> CleanupStatuses => pendingProjectDeletionCleanups.Select(item => new ProjectCleanupStatus(
        new(item.ProjectId, item.ParticipantId, item.RecoveryId), item.Status.ToString(),
        item.CanRetryNow && !unconfirmedCleanupTargets.Contains(new(item.ProjectId, item.ParticipantId, item.RecoveryId)),
        item.RetryAvailableAtUtc, item.RetryGuidance)).ToArray();

    private readonly HashSet<ProjectCleanupTarget> unconfirmedCleanupTargets = [];

    private IReadOnlyList<ProjectCleanupNotice> CleanupNotices => projectDeletionCompletionNotices.Select(item => new ProjectCleanupNotice(
        new(item.ProjectId, item.ParticipantId, item.RecoveryId), FormatCompletionOperation(item.Operation),
        item.Warnings.Select(warning => $"{warning.RetainedObject.Provider} · storage {warning.RetainedObject.StorageId?.ToString("D") ?? "bootstrap"} · {warning.RetainedObject.LocatorKind} · {warning.RetainedObject.Locator}. {warning.RetainedObject.Reason} {warning.Remediation}").ToArray())).ToArray();


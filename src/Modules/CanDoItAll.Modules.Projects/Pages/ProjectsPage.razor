@page "/projects"
@* codex-capsule
kind: page
name: ProjectsPage
summary: Surfaces projects as a card-first workspace with modal overview and editing flows instead of a permanent inline detail pane.
owns: project-cards, project-modal, phase-planning
deps: ProjectsService, IProjectWorkbenchSeedService, NavigationManager
risks: route-driven-modal-state, modal-save-regressions
tests: component:ProjectsPageTests, e2e:projects-smoke
*@
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using CanDoItAll.AgentFramework.Models
@using CanDoItAll.Infrastructure.ControlPlane
@using CanDoItAll.Modules.Projects
@using CanDoItAll.Modules.Projects.Pages.Components
@using CanDoItAll.SharedKernel
@inject ProjectsService ProjectsService
@inject IAdmittedProjectWorkbenchSeedService ProjectWorkbenchSeedService
@inject ILogger<ProjectsPage> Logger
@implements IDisposable
@using Microsoft.Extensions.Logging
@inject IProjectPackageService ProjectPackageService
@inject IDatabaseProfileService DatabaseProfileService
@inject NavigationManager Navigation

<PageTitle>Projects</PageTitle>

<PageScaffold MaxWidthClass="max-w-full" data-testid="projects-workspace" data-interactive="@interactive.ToString().ToLowerInvariant()">
    <Header>
        <div class="pr-20 sm:pr-24">
            <PageHeader Eyebrow="Projects"
                        Compact="true"
                        Title="Project workspace" />
        </div>
    </Header>

    <ChildContent>
        <ProjectDeletionStatusSurface Message="@projectDeletionNotice" IsError="projectDeletionNoticeIsError"
                                      Pending="CleanupStatuses" Completed="CleanupNotices" BusyTargets="busyCleanupTargets"
                                      Retry="RetryProjectDeletionCleanupAsync" />
        @if (portfolioError is not null || editorError is not null) {
            <Alert AlertStyle="AlertStyle.Warning" data-testid="projects-read-error">
                <TextBlock Value="@(editorError ?? portfolioError)" />
                <Button Text="Retry project reads" Click="RetryReadsAsync" />
            </Alert>
        }

        <ProjectsBoard ProjectSummaries="projectSummaries"
                       ProjectProjection="projectFileProjection"
                       HierarchyLinks="hierarchyLinks"
                       ProjectSearch="@projectSearch"
                       ProjectSearchChanged="HandleProjectSearchChanged"
                       StatusFilter="@statusFilter"
                       StatusFilterChanged="HandleStatusFilterChanged"
                       RelatedPartyCategoryFilter="@relatedPartyCategoryFilter"
                       RelatedPartyCategoryFilterChanged="HandleRelatedPartyCategoryFilterChanged"
                       RelatedPartyValueFilter="@relatedPartyValueFilter"
                       RelatedPartyValueFilterChanged="HandleRelatedPartyValueFilterChanged"
                       HierarchyFilterProjectId="@hierarchyFilterProjectId"
                       HierarchyFilterProjectIdChanged="HandleHierarchyFilterProjectChanged"
                       HierarchyFilterMode="@hierarchyFilterMode"
                       HierarchyFilterModeChanged="HandleHierarchyFilterModeChanged"
                       IncludeSubprojects="@includeSubprojects"
                       IncludeSubprojectsChanged="HandleIncludeSubprojectsChanged"
                       HierarchyFilterHelper="@HierarchyFilterHelper"
                       LatestUpdatedProjectLabel="@LatestUpdatedProjectLabel"
                       LatestUpdatedProjectHelper="@LatestUpdatedProjectHelper"
                       OpenNewProject="OpenNewProjectAsync"
                       NavigateHome="NavigateHome"
                       ResetFilters="ResetFilters"
                       OpenProjectPreview="OpenProjectPreviewAsync"
                       OpenProjectFiles="OpenProjectFiles"
                       OpenHierarchyModal="OpenHierarchyModalAsync"
                       OpenProjectDashboard="OpenProjectDashboard"
                       OpenProcesses="OpenProcesses"
                       OpenStructure="OpenStructure"
                       OpenGantt="OpenGantt"
                       OpenCalendar="OpenCalendar"
                       PortfolioViewChanged="HandlePortfolioViewChanged"
                       ProjectPackagePath="@projectPackagePath"
                       ProjectPackagePathChanged="@(value => { projectPackagePath = value; })"
                       ProjectPackageTargetProfiles="@projectPackageTargetProfiles"
                       ProjectPackageTargetProfileId="@projectPackageTargetProfileId"
                       ProjectPackageTargetProfileIdChanged="@(value => { projectPackageTargetProfileId = value; })"
                       ProjectPackageMessage="@projectPackageMessage"
                       IsProjectPackageMessageError="@projectPackageMessageIsError"
                       IsProjectPackageBusy="@(projectPackageBusy || projectPackageOutcomeUnknown)"
                       ExportProjectsPackage="ExportProjectsPackageAsync"
                       ImportProjectsPackage="ImportProjectsPackageAsync">
            <FilesContent Context="projection">
                <ProjectFilesPortfolioPane Projection="projection" />
            </FilesContent>
        </ProjectsBoard>
    </ChildContent>
</PageScaffold>

<ProjectsAgentChatContextProvider ProjectSummaries="projectSummaries"
                                  SelectedProjectId="@AgentChatFocusedProjectId"
                                  ActiveView="@AgentChatActiveView"
                                  ContextNavigationIdentity="@AgentChatNavigationFence"
                                  ContextAccessState="@AgentChatAccessState"
                                  RefreshRequested="HandleAgentChatRefreshRequestedAsync" />

<ProjectModalHost @key="draft" IsOpen="showProjectModal"
                  IsEditorMode="@(modalMode == ProjectModalMode.Editor)"
                  Draft="draft"
                  StarterObjectKinds="starterObjectKinds"
                  ProjectSummaries="projectSummaries"
                  WizardStep="wizardStep"
                  WizardSteps="wizardSteps"
                  WizardTabs="WizardTabs"
                  Message="@message"
                  IsErrorMessage="IsErrorMessage"
                  Close="CloseProjectModalAsync"
                  SwitchToOverview="SwitchToOverview"
                  SwitchToEditor="SwitchToEditor"
                  WizardTabChanged="HandleWizardTabChanged"
                  AddPhase="AddPhaseAsync"
                  RemovePhase="RemovePhaseAsync"
                  AddStarterObject="AddStarterObject"
                  RemoveStarterObject="RemoveStarterObject"
                  PreviousStep="PreviousStep"
                  NextStep="NextStep"
                  Save="SaveAsync"
                  SaveAndOpenStructure="SaveAndOpenStructureAsync"
                  Delete="DeleteAsync"
                  OpenProjectDashboard="OpenProjectDashboardAsync"
                  OpenProcesses="OpenProcessesAsync"
                  OpenStructure="OpenStructure"
                  OpenCalendar="OpenCalendar" />

<ProjectHierarchyModal State="hierarchyDialog"
                       Close="CloseHierarchyModal"
                       OpenProjectPreview="OpenProjectPreviewFromHierarchyAsync"
                       OpenStructure="OpenStructure"
                       OpenHierarchy="OpenHierarchyModalAsync" />

<ProjectFilesDialog IsOpen="@(projectFilesDialogProject is not null)"
                    ProjectId="@(projectFilesDialogProject?.Id ?? Guid.Empty)"
                    ProjectName="@(projectFilesDialogProject?.Name ?? string.Empty)"
                    Closed="CloseProjectFiles" />

@code {
    private static readonly string[] wizardSteps = ["Identity", "Dates and phases", "Stack profile", "Linked objects", "Review"];

    private static readonly ProjectObjectType[] starterObjectKinds =
    [
        ProjectObjectType.Note,
        ProjectObjectType.Decision,
        ProjectObjectType.Milestone,
        ProjectObjectType.Repository,
        ProjectObjectType.Link
    ];

    [SupplyParameterFromQuery(Name = "projectId")]
    public Guid? ProjectIdQuery { get; set; }

    private IReadOnlyList<ProjectSummary> projectSummaries = [];
    private IReadOnlyList<ProjectHierarchyLinkSummary> hierarchyLinks = [];
    private ProjectFileFilterProjection projectFileProjection = ProjectFileFilterProjection.Create(
        [],
        [],
        new ProjectFileFilter());
    private ProjectEditorDraft draft = new(new());
    private ProjectEditorModel editor => draft.Model;
    private List<StarterObjectDraft> starterObjects => draft.StarterObjects;
    private string? message {
        get => draft.Message;
        set => draft.Message = value;
    }
    private readonly Dictionary<Guid, ProjectEditorDraft> mutationTargets = [];
    private readonly HashSet<ProjectCleanupTarget> busyCleanupTargets = [];
    private readonly ProjectsPageLoadGeneration portfolioLoads = new();
    private readonly ProjectsPageLoadGeneration packageLoads = new();
    private readonly ProjectsPageLoadGeneration filesLoads = new();
    private readonly ProjectsPageLoadGeneration hierarchyLoads = new();
    private CancellationTokenSource? editorRead;
    private readonly CancellationTokenSource readLifetime = new();
    private long editorIntent;
    private bool disposed;
    private bool interactive;
    private bool routeAcquired;
    private Guid? observedRoute;
    private Guid? failedEditorId;
    private string? portfolioError;
    private string? editorError;
    private string? projectDeletionNotice;
    private bool projectDeletionNoticeIsError;
    private readonly List<ProjectDeletionPendingCleanup> pendingProjectDeletionCleanups = [];
    private readonly List<ProjectDeletionCompletionNotice> projectDeletionCompletionNotices = [];
    private int wizardStep;
    private bool showProjectModal;
    private string projectSearch = string.Empty;
    private ProjectStatus? statusFilter;
    private ProjectPartyPortfolioCategory? relatedPartyCategoryFilter;
    private string relatedPartyValueFilter = string.Empty;
    private ProjectHierarchyFilterMode hierarchyFilterMode = ProjectHierarchyFilterMode.Descendants;
    private Guid? hierarchyFilterProjectId;
    private bool includeSubprojects = true;
    private ProjectModalMode modalMode = ProjectModalMode.Overview;
    private bool modalOpenedFromRoute;
    private ProjectHierarchyDialogState? hierarchyDialog;
    private ProjectSummary? projectFilesDialogProject;
    private string projectPackagePath = string.Empty;
    private IReadOnlyList<ProjectPackageTargetOption> projectPackageTargetProfiles = [];
    private Guid? projectPackageTargetProfileId;
    private string? projectPackageMessage;
    private bool projectPackageMessageIsError;
    private bool projectPackageBusy;
    private bool projectPackageOutcomeUnknown;
    private ProjectsAgentChatView agentChatPortfolioView = ProjectsAgentChatView.Cards;
    private AgentChatContextAccessState agentChatPositionAccessState = AgentChatContextAccessState.Ready;
    private AgentChatContextAccessState portfolioAccessState = AgentChatContextAccessState.Loading;
    private readonly ProjectsPageLoadGeneration projectLoads = new();

    private AgentChatNavigationIdentity AgentChatNavigationFence
        => AgentChatNavigationIdentity.CreateForLocation(
            Navigation.BaseUri,
            Navigation.Uri,
            [new("projectId", ProjectIdQuery?.ToString("D"))]);

    private Task HandlePortfolioViewChanged(ProjectsAgentChatView view)
    {
        agentChatPortfolioView = view;
        return Task.CompletedTask;
    }

    private Guid? AgentChatFocusedProjectId
    {
        get
        {
            if (hierarchyDialog is not null)
            {
                return hierarchyDialog.ProjectId;
            }

            if (projectFilesDialogProject is not null)
            {
                return projectFilesDialogProject.Id;
            }

            if (showProjectModal)
            {
                return editor.Id;
            }

            return hierarchyFilterProjectId;
        }
    }

    private string HierarchyFilterHelper
        => !hierarchyFilterProjectId.HasValue
            ? "Showing main projects. Choose a project to show it with its subprojects or narrow by direct links."
            : hierarchyFilterMode switch
            {
                ProjectHierarchyFilterMode.Descendants when includeSubprojects
                    => $"Showing {ResolveProjectName(hierarchyFilterProjectId.Value)} and its subprojects.",
                ProjectHierarchyFilterMode.Descendants
                    => $"Showing only {ResolveProjectName(hierarchyFilterProjectId.Value)}.",
                ProjectHierarchyFilterMode.Children
                    => $"Showing direct subprojects of {ResolveProjectName(hierarchyFilterProjectId.Value)}.",
                ProjectHierarchyFilterMode.Parents
                    => $"Showing direct parents of {ResolveProjectName(hierarchyFilterProjectId.Value)}.",
                ProjectHierarchyFilterMode.Related
                    => $"Showing the direct relationship neighborhood around {ResolveProjectName(hierarchyFilterProjectId.Value)}.",
                _ => throw new ArgumentOutOfRangeException(nameof(hierarchyFilterMode))
            };

    private IReadOnlyList<ProjectOptionEditorModel> MeaningfulOptions => editor.Options
        .Where(option => !string.IsNullOrWhiteSpace(option.OptionName) || !string.IsNullOrWhiteSpace(option.Notes))
        .ToList();

    private IReadOnlyList<SecondaryTabItem> WizardTabs => wizardSteps
        .Select((step, index) => new SecondaryTabItem(index.ToString(), $"{index + 1}. {step}"))
        .ToList();

    private bool IsErrorMessage => draft.IsError;

    private string LatestUpdatedProjectLabel
        => projectSummaries.Count == 0
            ? "No projects"
            : projectSummaries.OrderByDescending(project => project.UpdatedAtUtc).First().UpdatedAtUtc.LocalDateTime.ToString("g");

    private string LatestUpdatedProjectHelper
        => projectSummaries.Count == 0
            ? "Save the first project to populate the workspace."
            : projectSummaries.OrderByDescending(project => project.UpdatedAtUtc).First().Name;

    protected override Task OnParametersSetAsync() {
        bool changed = !routeAcquired || observedRoute != ProjectIdQuery;
        if (changed) {
            filesLoads.Invalidate();
            hierarchyLoads.Invalidate();
            projectFilesDialogProject = null;
            hierarchyDialog = null;
        }
        observedRoute = ProjectIdQuery;
        routeAcquired = true;
        Task acquisition = Task.CompletedTask;
        if (ProjectIdQuery is { } id && (changed || !showProjectModal || editor.Id != id)) {
            acquisition = AcquireEditorAsync(id, fromRoute: true);
        } else if (changed && modalOpenedFromRoute) {
            RetireEditor();
        }
        return Task.WhenAll(acquisition, RefreshPortfolioAsync(), RefreshPackageTargetsAsync());
    }

    private Task RetryReadsAsync() => Task.WhenAll(RefreshPortfolioAsync(), RefreshPackageTargetsAsync(),
        failedEditorId is { } id ? AcquireEditorAsync(id, ProjectIdQuery == id) : Task.CompletedTask);

    private async Task RefreshPortfolioAsync() {
        var stamp = portfolioLoads.Begin(new(ProjectsPageLoadKind.CompletionRefresh, null));
        portfolioAccessState = AgentChatContextAccessState.Loading;
        try {
            var state = await LoadPortfolioStateAsync();
            if (!disposed) {
                portfolioLoads.TryCommit(stamp, ProjectIdQuery, () => {
                    ApplyPortfolioState(state);
                    unconfirmedCleanupTargets.Clear();
                    portfolioError = null;
                    portfolioAccessState = AgentChatContextAccessState.Ready;
                });
            }
        } catch (OperationCanceledException) when (readLifetime.IsCancellationRequested) {
        } catch (Exception exception) {
            Logger.LogError(exception, "Projects portfolio read failed; acquired drafts and acknowledged mutations are retained.");
            if (!disposed) {
                portfolioLoads.TryCommit(stamp, ProjectIdQuery, () => {
                    portfolioError = "Unable to refresh the portfolio. Acquired edits and completed operations are retained.";
                    portfolioAccessState = AgentChatContextAccessState.Failed;
                });
            }
        }
    }

    private async Task RefreshPackageTargetsAsync() {
        var stamp = packageLoads.Begin(new(ProjectsPageLoadKind.CompletionRefresh, null));
        try {
            var profiles = await LoadProjectPackageTargetProfilesAsync();
            if (!disposed) {
                packageLoads.TryCommit(stamp, ProjectIdQuery, () => ApplyProjectPackageTargetProfiles(profiles));
            }
        } catch (OperationCanceledException) when (readLifetime.IsCancellationRequested) {
        } catch (Exception exception) {
            Logger.LogError(exception, "Project package target read failed.");
            packageLoads.TryCommit(stamp, ProjectIdQuery, () => {
                projectPackageTargetProfiles = [];
                projectPackageMessage = "Unable to read package targets. Retry project reads to refresh the available targets.";
                projectPackageMessageIsError = true;
            });
        }
    }

    private Task HandleProjectSearchChanged(string value)
    {
        projectSearch = value;
        RebuildProjectFileProjection();
        return Task.CompletedTask;
    }

    private Task HandleStatusFilterChanged(ProjectStatus? value)
    {
        statusFilter = value;
        RebuildProjectFileProjection();
        return Task.CompletedTask;
    }

    private Task HandleRelatedPartyCategoryFilterChanged(ProjectPartyPortfolioCategory? value)
    {
        relatedPartyCategoryFilter = value;
        if (!string.IsNullOrWhiteSpace(relatedPartyValueFilter) &&
            !ProjectFileFilterProjection.Create(
                projectSummaries,
                hierarchyLinks,
                CreateProjectFileFilter()).AvailableRelatedPartyValues.Contains(
                    relatedPartyValueFilter,
                    StringComparer.OrdinalIgnoreCase))
        {
            relatedPartyValueFilter = string.Empty;
        }

        RebuildProjectFileProjection();
        return Task.CompletedTask;
    }

    private Task HandleRelatedPartyValueFilterChanged(string value)
    {
        relatedPartyValueFilter = value;
        RebuildProjectFileProjection();
        return Task.CompletedTask;
    }

    private Task HandleHierarchyFilterProjectChanged(Guid? value)
    {
        hierarchyFilterProjectId = value;
        RebuildProjectFileProjection();
        return Task.CompletedTask;
    }

    private Task HandleHierarchyFilterModeChanged(ProjectHierarchyFilterMode value)
    {
        hierarchyFilterMode = value;
        RebuildProjectFileProjection();
        return Task.CompletedTask;
    }

    private Task HandleIncludeSubprojectsChanged(bool value)
    {
        includeSubprojects = value;
        RebuildProjectFileProjection();
        return Task.CompletedTask;
    }

    private async Task<ProjectsPortfolioState> LoadPortfolioStateAsync()
    {
        var projectSummariesTask = ProjectsService.ListAsync(readLifetime.Token);
        var hierarchyLinksTask = ProjectsService.ListHierarchyLinksAsync(readLifetime.Token);
        var deletionCleanupsTask = ProjectsService.ListPendingDeletionCleanupsAsync(readLifetime.Token);
        var deletionNoticesTask = ProjectsService.ListDeletionCompletionNoticesAsync(readLifetime.Token);
        await Task.WhenAll(
            projectSummariesTask,
            hierarchyLinksTask,
            deletionCleanupsTask,
            deletionNoticesTask);
        return new ProjectsPortfolioState(
            await projectSummariesTask,
            await hierarchyLinksTask,
            await deletionCleanupsTask,
            await deletionNoticesTask);
    }

    private void ApplyPortfolioState(ProjectsPortfolioState state)
    {
        projectSummaries = state.ProjectSummaries;
        hierarchyLinks = state.HierarchyLinks;
        pendingProjectDeletionCleanups.Clear();
        pendingProjectDeletionCleanups.AddRange(state.PendingDeletionCleanups);
        projectDeletionCompletionNotices.Clear();
        projectDeletionCompletionNotices.AddRange(
            state.DeletionCompletionNotices.Where(notice => notice.Warnings.Count > 0));
        if (pendingProjectDeletionCleanups.Count > 0 && (string.IsNullOrWhiteSpace(projectDeletionNotice) || !projectDeletionNoticeIsError))
        {
            projectDeletionNotice =
                $"{pendingProjectDeletionCleanups.Count} deleted project cleanup operation(s) remain pending and can be retried by exact mutation id.";
            projectDeletionNoticeIsError = true;
        }
        else if (projectDeletionCompletionNotices.Count > 0 &&
                 string.IsNullOrWhiteSpace(projectDeletionNotice))
        {
            projectDeletionNotice =
                $"{projectDeletionCompletionNotices.Count} completed project deletion operation(s) retained managed media and require manual review.";
            projectDeletionNoticeIsError = true;
        }
        RebuildProjectFileProjection();
    }

    private async Task<IReadOnlyList<ProjectPackageTargetOption>>
        LoadProjectPackageTargetProfilesAsync()
    {
        var profiles = await DatabaseProfileService.ListAsync(readLifetime.Token);
        return profiles
            .Where(profile =>
                !profile.IsActive &&
                !profile.IsRuntimeLocked &&
                !profile.IsPendingRestartActivation)
            .OrderBy(profile => profile.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(profile => profile.Id)
            .Select(profile => new ProjectPackageTargetOption(profile.Id, profile.DisplayName, profile.Descriptor))
            .ToArray();
    }

    private void ApplyProjectPackageTargetProfiles(
        IReadOnlyList<ProjectPackageTargetOption> profiles)
    {
        projectPackageTargetProfiles = profiles;
        if (projectPackageTargetProfileId.HasValue &&
            profiles.All(profile => profile.Id != projectPackageTargetProfileId.Value))
        {
            projectPackageTargetProfileId = null;
        }
    }

    private static string FormatCompletionOperation(
        ProjectDeletionCompletionOperation operation)
        => operation switch
        {
            ProjectDeletionCompletionOperation.ProjectDeletion => "project deletion",
            ProjectDeletionCompletionOperation.ProjectNodeCleanup => "prior node cleanup",
            _ => throw new ArgumentOutOfRangeException(nameof(operation), operation, null)
        };

    private Task HandleAgentChatRefreshRequestedAsync(AgentChatExecutionCompleted notification)
        => RefreshPortfolioAsync();

    private Task OpenNewProjectAsync() => AcquireEditorAsync(null, fromRoute: false);

    private Task OpenProjectPreviewAsync(Guid id) => AcquireEditorAsync(id, fromRoute: false);

    private async Task AcquireEditorAsync(Guid? id, bool fromRoute) {
        if (id.HasValue && showProjectModal && editor.Id == id && failedEditorId is null) {
            return;
        }
        long intent = ++editorIntent;
        editorRead?.Cancel();
        using var read = CancellationTokenSource.CreateLinkedTokenSource(readLifetime.Token);
        editorRead = read;
        var stamp = BeginProjectLoad(new(fromRoute ? ProjectsPageLoadKind.Route : id.HasValue ? ProjectsPageLoadKind.Preview : ProjectsPageLoadKind.NewProject, id));
        showProjectModal = false;
        editorError = null;
        try {
            var loaded = await ProjectsService.GetAsync(id, read.Token);
            if (id.HasValue && loaded.Id != id) {
                throw new InvalidOperationException($"Project '{id:D}' is unavailable.");
            }
            if (disposed || intent != editorIntent || read.IsCancellationRequested) {
                return;
            }
            TryCompleteProjectLoad(stamp, () => {
                draft = new(loaded);
                wizardStep = 0;
                modalMode = id.HasValue ? ProjectModalMode.Overview : ProjectModalMode.Editor;
                showProjectModal = true;
                modalOpenedFromRoute = fromRoute;
                failedEditorId = null;
            });
        } catch (OperationCanceledException) when (read.IsCancellationRequested) {
        } catch (Exception exception) {
            Logger.LogError(exception, "Project editor acquisition failed for {ProjectId}.", id);
            if (!disposed && intent == editorIntent && FailProjectLoad(stamp)) {
                failedEditorId = id;
                editorError = $"Unable to acquire project {id:D}. Retry the read before editing.";
            }
        } finally {
            if (ReferenceEquals(editorRead, read)) {
                editorRead = null;
            }
        }
    }

    private void RetireEditor() {
        editorIntent++;
        editorRead?.Cancel();
        InvalidateProjectLoad();
        showProjectModal = false;
        modalOpenedFromRoute = false;
        failedEditorId = null;
        editorError = null;
        draft = new(new());
    }

    private ProjectsPageLoadStamp BeginProjectLoad(ProjectsPageLoadKey key)
    {
        agentChatPositionAccessState = AgentChatContextAccessState.Loading;
        return projectLoads.Begin(key);
    }

    private bool TryCompleteProjectLoad(ProjectsPageLoadStamp stamp, Action commit)
    {
        return projectLoads.TryCommit(stamp, ProjectIdQuery, () =>
        {
            commit();
            agentChatPositionAccessState = AgentChatContextAccessState.Ready;
        });
    }

    private bool FailProjectLoad(ProjectsPageLoadStamp stamp)
    {
        return projectLoads.TryCommit(
            stamp,
            ProjectIdQuery,
            () => agentChatPositionAccessState = AgentChatContextAccessState.Failed);
    }

    private void InvalidateProjectLoad()
    {
        projectLoads.Invalidate();
        agentChatPositionAccessState = AgentChatContextAccessState.Ready;
    }

    private async Task ExportProjectsPackageAsync()
    {
        if (projectPackageBusy || projectPackageOutcomeUnknown)
        {
            return;
        }

        projectPackageBusy = true;
        projectPackageMessage = null;
        projectPackageMessageIsError = false;
        string submittedPath = projectPackagePath;

        try
        {
            var result = await ProjectPackageService.ExportAllAsync(new ProjectPackageExportRequest
            {
                PackagePath = string.IsNullOrWhiteSpace(submittedPath) ? null : submittedPath
            });

            if (result.IsFailure)
            {
                projectPackageMessage = string.Join(" ", result.Errors.Select(error => error.Message));
                projectPackageMessageIsError = true;
                return;
            }

            var exported = result.Value!;
            if (projectPackagePath == submittedPath) {
                projectPackagePath = exported.PackagePath;
            }
            projectPackageMessage = $"Exported {exported.Manifest.TotalRecordCount} project record(s) to {exported.PackagePath}.";
        } catch (Exception exception) {
            Logger.LogError(exception, "Project package export outcome is unconfirmed.");
            projectPackageOutcomeUnknown = true;
            projectPackageMessage = "The export outcome is unconfirmed. Inspect the requested package before attempting another export.";
            projectPackageMessageIsError = true;
        }
        finally
        {
            projectPackageBusy = false;
        }
    }

    private async Task ImportProjectsPackageAsync() {
        if (projectPackageBusy || projectPackageOutcomeUnknown) {
            return;
        }
        if (string.IsNullOrWhiteSpace(projectPackagePath)) {
            projectPackageMessage = "Choose a project package path.";
            projectPackageMessageIsError = true;
            return;
        }
        if (!projectPackageTargetProfileId.HasValue ||
            projectPackageTargetProfiles.All(profile => profile.Id != projectPackageTargetProfileId)) {
            projectPackageMessage = "Choose a package path and an available inactive target database profile.";
            projectPackageMessageIsError = true;
            return;
        }
        var request = new ProjectPackageImportRequest { PackagePath = projectPackagePath, TargetProfileId = projectPackageTargetProfileId.Value };
        projectPackageBusy = true;
        projectPackageMessage = null;
        projectPackageMessageIsError = false;
        try {
            var result = await ProjectPackageService.ImportAllAsync(request);
            projectPackageMessage = result.IsFailure
                ? string.Join(" ", result.Errors.Select(error => error.Message))
                : $"Imported {result.Value!.RecordsImported} project record(s) from {result.Value.Manifest.PackageId:N} into {request.TargetProfileId:D}.";
            projectPackageMessageIsError = result.IsFailure;
            if (result.IsSuccess) {
                await RefreshPortfolioAsync();
            }
        } catch (Exception exception) {
            Logger.LogError(exception, "Project package import outcome is unconfirmed for target {TargetProfileId}.", request.TargetProfileId);
            projectPackageOutcomeUnknown = true;
            projectPackageMessage = "The import outcome is unconfirmed. Inspect the target database before attempting another import.";
            projectPackageMessageIsError = true;
        } finally {
            projectPackageBusy = false;
        }
    }

    private void OpenProjectDashboard(Guid id)
        => Navigation.NavigateTo($"/projects?projectId={id}");

    private void OpenProjectDashboardAsync()
    {
        if (editor.Id.HasValue)
        {
            OpenProjectDashboard(editor.Id.Value);
        }
    }

    private void OpenProcesses(Guid projectId)
    {
        if (projectId != Guid.Empty)
        {
            Navigation.NavigateTo($"/projects/{projectId}/processes");
        }
    }

    private void OpenProcessesAsync()
    {
        if (editor.Id.HasValue)
        {
            OpenProcesses(editor.Id.Value);
        }
    }

    private Task HandleWizardTabChanged(string key)
    {
        if (int.TryParse(key, out var parsed))
        {
            wizardStep = parsed;
        }

        return Task.CompletedTask;
    }

    private void SwitchToOverview()
        => modalMode = ProjectModalMode.Overview;

    private void SwitchToEditor()
    {
        modalMode = ProjectModalMode.Editor;
        message = null;
    }

    private Task CloseProjectModalAsync() {
        bool navigate = modalOpenedFromRoute;
        RetireEditor();
        if (navigate) {
            Navigation.NavigateTo("/projects", replace: true);
        }
        return Task.CompletedTask;
    }

    private Task AddPhaseAsync()
    {
        editor.Phases.Add(new ProjectPhaseEditorModel());
        draft.RecordStructureEdit();
        return Task.CompletedTask;
    }

    private Task RemovePhaseAsync(ProjectPhaseEditorModel phase)
    {
        editor.Phases.Remove(phase);
        draft.RecordStructureEdit();
        return Task.CompletedTask;
    }

    private void AddStarterObject() {
        starterObjects.Add(new StarterObjectDraft());
        draft.RecordStructureEdit();
    }

    private void RemoveStarterObject(StarterObjectDraft starter) {
        starterObjects.Remove(starter);
        draft.RecordStructureEdit();
    }

    private void NextStep()
        => wizardStep = Math.Min(wizardSteps.Length - 1, wizardStep + 1);

    private void PreviousStep()
        => wizardStep = Math.Max(0, wizardStep - 1);

    private void ResetFilters()
    {
        projectSearch = string.Empty;
        statusFilter = null;
        relatedPartyCategoryFilter = null;
        relatedPartyValueFilter = string.Empty;
        hierarchyFilterMode = ProjectHierarchyFilterMode.Descendants;
        hierarchyFilterProjectId = null;
        includeSubprojects = true;
        RebuildProjectFileProjection();
    }

    private async Task SaveAsync(ProjectEditorSubmission submitted)
    {
        await SaveCoreAsync(submitted);
    }

    private async Task<Guid?> SaveCoreAsync(ProjectEditorSubmission submitted) {
        var target = draft;
        if (!showProjectModal || !target.Validate() || !TryAdmitMutation(target, ProjectEditorMutationState.Saving)) {
            return null;
        }
        long intent = ++editorIntent;
        bool projectCommitted = false;
        try {
            var result = await ProjectsService.SaveEditorAsync(submitted.Model);
            if (result.IsFailure) {
                target.Message = string.Join(" ", result.Errors.Select(error => error.Message));
                target.IsError = true;
                ReleaseMutation(target);
                return null;
            }
            target.Acknowledge(submitted, result.Value!);
            projectCommitted = true;
            mutationTargets[result.Value!.Project.ProjectId] = target;
            target.Message = "Project saved.";
            target.IsError = false;
            if (submitted.Seeds.Count > 0) {
                target.Mutation = ProjectEditorMutationState.Seeding;
                await ProjectWorkbenchSeedService.SeedProjectObjectsAsync(result.Value.Project, submitted.Seeds.Select(seed => seed.Value).ToArray());
                target.AcknowledgeSeeds(submitted);
                target.Message = "Project saved and starter objects seeded to the structure workbench.";
            }
            ReleaseMutation(target);
            await RefreshPortfolioAsync();
            if (target.EditRevision != submitted.EditRevision) {
                target.Message += " Newer edits remain unsaved.";
                return null;
            }
            return IsActiveEditor(target, intent) ? result.Value.Project.ProjectId : null;
        } catch (Exception exception) {
            Logger.LogError(exception, "Project editor operation failed for {ProjectId}; current stage {Stage}.", target.Model.Id, target.Mutation);
            target.Mutation = projectCommitted ? ProjectEditorMutationState.SeedOutcomeUnknown : ProjectEditorMutationState.SaveOutcomeUnknown;
            target.Message = projectCommitted
                ? "Project saved. Starter-object completion is unconfirmed. Inspect Structure before creating any of these objects again."
                : "Save completion is unconfirmed. Inspect the project inventory before attempting another write.";
            target.IsError = true;
            return null;
        }
    }

    private bool TryAdmitMutation(ProjectEditorDraft target, ProjectEditorMutationState operation) {
        if (!target.CanMutate) {
            return false;
        }
        if (target.Model.Id is { } id && mutationTargets.ContainsKey(id)) {
            target.Message = "A previous operation for this project is still pending or unconfirmed. Observe its result before another write.";
            target.IsError = true;
            return false;
        }
        target.Mutation = operation;
        if (target.Model.Id is { } projectId) {
            mutationTargets.Add(projectId, target);
        }
        return true;
    }

    private void ReleaseMutation(ProjectEditorDraft target) {
        target.Mutation = ProjectEditorMutationState.Ready;
        if (target.Model.Id is { } id && mutationTargets.TryGetValue(id, out var owner) && ReferenceEquals(owner, target)) {
            mutationTargets.Remove(id);
        }
    }

    private bool IsActiveEditor(ProjectEditorDraft target, long intent)
        => !disposed && showProjectModal && ReferenceEquals(draft, target) && editorIntent == intent;

    private async Task SaveAndOpenStructureAsync(ProjectEditorSubmission submitted)
    {
        var savedProjectId = await SaveCoreAsync(submitted);
        if (savedProjectId.HasValue)
        {
            Navigation.NavigateTo($"/projects/{savedProjectId.Value}/structure");
        }
    }

    private async Task DeleteAsync() {
        var target = draft;
        if (!showProjectModal || target.Model.Id is not { } id || !TryAdmitMutation(target, ProjectEditorMutationState.Deleting)) {
            return;
        }
        long intent = ++editorIntent;
        try {
            var admission = target.Model.ExpectedProjectAdmission
                ?? throw new InvalidOperationException("The acquired editor has no owner-issued deletion admission.");
            var deletion = await ProjectsService.DeleteAsync(id, expectedProjectAdmission: admission);
            RecordDeletion(target, intent);
            projectDeletionNotice = deletion.Warnings.Count == 0 ? "Project deleted."
                : BuildProjectDeletionWarningMessage("Project deleted with retained managed media.", deletion.Warnings);
            projectDeletionNoticeIsError = deletion.Warnings.Count > 0;
        } catch (ProjectDeletionPartialCommitException exception) {
            RecordDeletion(target, intent);
            foreach (var failure in exception.Recovery.Failures.Where(item => item.RecoveryId.HasValue)) {
                if (!pendingProjectDeletionCleanups.Any(item => item.ProjectId == id && item.ParticipantId == failure.ParticipantId && item.RecoveryId == failure.RecoveryId)) {
                    pendingProjectDeletionCleanups.Add(new(id, failure.ParticipantId, failure.RecoveryId!.Value,
                        ProjectDeletionRecoveryStatus.Failed, true, null, exception.Recovery.RetryGuidance));
                }
            }
            projectDeletionNotice = "The project was deleted, but cleanup remains pending. Retry the exact durable operation listed below.";
            projectDeletionNoticeIsError = true;
        } catch (Exception exception) {
            Logger.LogError(exception, "Project deletion outcome is unconfirmed for {ProjectId}.", id);
            target.Mutation = ProjectEditorMutationState.DeleteOutcomeUnknown;
            target.Message = "Deletion completion is unconfirmed. Refresh the inventory and inspect cleanup before another write.";
            target.IsError = true;
            return;
        }
        await RefreshPortfolioAsync();
    }

    private void RecordDeletion(ProjectEditorDraft target, long intent) {
        portfolioLoads.Invalidate();
        Guid id = target.Model.Id!.Value;
        ReleaseMutation(target);
        target.Mutation = ProjectEditorMutationState.Deleted;
        projectSummaries = projectSummaries.Where(project => project.Id != id).ToArray();
        hierarchyLinks = hierarchyLinks.Where(link => link.ParentProjectId != id && link.ChildProjectId != id).ToArray();
        RebuildProjectFileProjection();
        if (IsActiveEditor(target, intent)) {
            bool navigate = modalOpenedFromRoute;
            RetireEditor();
            if (navigate) {
                Navigation.NavigateTo("/projects", replace: true);
            }
        }
    }

    private async Task RetryProjectDeletionCleanupAsync(ProjectCleanupTarget target) {
        if (!pendingProjectDeletionCleanups.Any(cleanup => cleanup.ProjectId == target.ProjectId && cleanup.ParticipantId == target.ParticipantId && cleanup.RecoveryId == target.RecoveryId) ||
            unconfirmedCleanupTargets.Contains(target) || !busyCleanupTargets.Add(target)) {
            return;
        }
        try {
            var result = await ProjectsService.RetryDeletionCleanupAsync(target.ProjectId, target.ParticipantId, target.RecoveryId);
            portfolioLoads.Invalidate();
            pendingProjectDeletionCleanups.RemoveAll(cleanup => cleanup.ProjectId == target.ProjectId && cleanup.ParticipantId == target.ParticipantId && cleanup.RecoveryId == target.RecoveryId);
            projectDeletionNotice = result.Warnings.Count == 0 ? "Project cleanup completed."
                : BuildProjectDeletionWarningMessage("Project cleanup completed with retained managed media.", result.Warnings);
            projectDeletionNoticeIsError = result.Warnings.Count > 0;
        } catch (ProjectDeletionPartialCommitException) {
            projectDeletionNotice = "Project cleanup is still pending. The exact durable operation remains available for another retry.";
            projectDeletionNoticeIsError = true;
        } catch (Exception exception) {
            Logger.LogError(exception, "Project cleanup observation failed for {ProjectId}, {ParticipantId}, {RecoveryId}.", target.ProjectId, target.ParticipantId, target.RecoveryId);
            unconfirmedCleanupTargets.Add(target);
            projectDeletionNotice = "Cleanup completion is unconfirmed. Refresh the inventory before another explicit retry.";
            projectDeletionNoticeIsError = true;
        } finally {
            busyCleanupTargets.Remove(target);
        }
        await RefreshPortfolioAsync();
    }

    private IReadOnlyList<ProjectCleanupStatus> CleanupStatuses => pendingProjectDeletionCleanups.Select(item => new ProjectCleanupStatus(
        new(item.ProjectId, item.ParticipantId, item.RecoveryId), item.Status.ToString(),
        item.CanRetryNow && !unconfirmedCleanupTargets.Contains(new(item.ProjectId, item.ParticipantId, item.RecoveryId)),
        item.RetryAvailableAtUtc, item.RetryGuidance)).ToArray();

    private readonly HashSet<ProjectCleanupTarget> unconfirmedCleanupTargets = [];

    private IReadOnlyList<ProjectCleanupNotice> CleanupNotices => projectDeletionCompletionNotices.Select(item => new ProjectCleanupNotice(
        new(item.ProjectId, item.ParticipantId, item.RecoveryId), FormatCompletionOperation(item.Operation),
        item.Warnings.Select(warning => $"{warning.RetainedObject.Provider} · storage {warning.RetainedObject.StorageId?.ToString("D") ?? "bootstrap"} · {warning.RetainedObject.LocatorKind} · {warning.RetainedObject.Locator}. {warning.RetainedObject.Reason} {warning.Remediation}").ToArray())).ToArray();

    private static string BuildProjectDeletionWarningMessage(
        string message,
        IReadOnlyCollection<ProjectDeletionWarning> warnings)
        => $"{message} {string.Join(" ", warnings.Select(warning => $"{warning.Message} {warning.Remediation}"))}";

    private ProjectFileFilter CreateProjectFileFilter()
        => new(
            projectSearch,
            statusFilter,
            relatedPartyCategoryFilter,
            relatedPartyValueFilter,
            hierarchyFilterProjectId,
            hierarchyFilterMode,
            includeSubprojects);

    private void RebuildProjectFileProjection()
        => projectFileProjection = ProjectFileFilterProjection.Create(
            projectSummaries,
            hierarchyLinks,
            CreateProjectFileFilter());

    private string ResolveProjectName(Guid projectId)
        => projectSummaries.FirstOrDefault(project => project.Id == projectId)?.Name ?? "Selected project";

    private async Task OpenProjectFiles(Guid projectId)
    {
        var loadStamp = filesLoads.Begin(new ProjectsPageLoadKey(
            ProjectsPageLoadKind.Files,
            projectId));
        try
        {
            var project = projectSummaries.FirstOrDefault(item => item.Id == projectId)
                ?? await ProjectsService.GetSummaryAsync(projectId, readLifetime.Token);

            if (project is null)
            {
                throw new InvalidOperationException($"Project '{projectId:D}' is unavailable.");
            }

            filesLoads.TryCommit(loadStamp, ProjectIdQuery, () =>
            {
                projectFilesDialogProject = project;
            });
        }
        catch (Exception exception) {
            Logger.LogError(exception, "Project Files selection could not be acquired for {ProjectId}.", projectId);
            filesLoads.TryCommit(loadStamp, ProjectIdQuery, () => portfolioError = "Unable to open the selected project's files. Retry the selection after refreshing the portfolio.");
        }
    }

    private Task CloseProjectFiles()
    {
        filesLoads.Invalidate();
        projectFilesDialogProject = null;
        return Task.CompletedTask;
    }

    private async Task OpenHierarchyModalAsync(Guid projectId)
    {
        var loadStamp = hierarchyLoads.Begin(new ProjectsPageLoadKey(
            ProjectsPageLoadKind.Hierarchy,
            projectId));
        try
        {
            var project = projectSummaries.FirstOrDefault(item => item.Id == projectId);
            var summaryTask = project is null ? ProjectsService.GetSummaryAsync(projectId, readLifetime.Token) : null;
            var hierarchyTask = ProjectsService.GetHierarchyAsync(projectId, readLifetime.Token);
            if (summaryTask is not null)
            {
                await Task.WhenAll(summaryTask, hierarchyTask);
                project = await summaryTask;
            }
            else
            {
                await hierarchyTask;
            }

            if (project is null)
            {
                throw new InvalidOperationException($"Project '{projectId:D}' is unavailable.");
            }

            var hierarchy = await hierarchyTask;
            var selectedProject = project;
            hierarchyLoads.TryCommit(loadStamp, ProjectIdQuery, () =>
            {
                hierarchyDialog = new ProjectHierarchyDialogState(
                    selectedProject.Id,
                    selectedProject.Name,
                    hierarchy.ParentProjects,
                    hierarchy.ChildProjects);
            });
        }
        catch (Exception exception) {
            Logger.LogError(exception, "Project hierarchy could not be acquired for {ProjectId}.", projectId);
            hierarchyLoads.TryCommit(loadStamp, ProjectIdQuery, () => portfolioError = "Unable to open the selected project's hierarchy. Retry the selection after refreshing the portfolio.");
        }
    }

    private void CloseHierarchyModal()
    {
        hierarchyLoads.Invalidate();
        hierarchyDialog = null;
    }


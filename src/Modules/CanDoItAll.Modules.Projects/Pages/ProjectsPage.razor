    private string ResolveProjectName(Guid projectId)
        => projectSummaries.FirstOrDefault(project => project.Id == projectId)?.Name ?? "Selected project";

    private async Task OpenProjectFiles(Guid projectId)
    {
        var loadStamp = BeginProjectLoad(new ProjectsPageLoadKey(
            ProjectsPageLoadKind.Files,
            projectId));
        try
        {
            var project = projectSummaries.FirstOrDefault(item => item.Id == projectId);
            ProjectsPortfolioState? loadedPortfolio = null;
            if (project is null)
            {
                loadedPortfolio = await LoadPortfolioStateAsync();
                project = loadedPortfolio.ProjectSummaries.FirstOrDefault(item => item.Id == projectId);
            }

            if (project is null)
            {
                throw new InvalidOperationException($"Project '{projectId:D}' is unavailable.");
            }

            TryCompleteProjectLoad(loadStamp, () =>
            {
                if (loadedPortfolio is not null)
                {
                    ApplyPortfolioState(loadedPortfolio);
                }

                projectFilesDialogProject = project;
            });
        }
        catch
        {
            if (!FailProjectLoad(loadStamp))
            {
                return;
            }

            throw;
        }
    }

    private Task CloseProjectFiles()
    {
        InvalidateProjectLoad();
        projectFilesDialogProject = null;
        return Task.CompletedTask;
    }

    private async Task OpenHierarchyModalAsync(Guid projectId)
    {
        var loadStamp = BeginProjectLoad(new ProjectsPageLoadKey(
            ProjectsPageLoadKind.Hierarchy,
            projectId));
        try
        {
            var project = projectSummaries.FirstOrDefault(item => item.Id == projectId);
            var portfolioTask = project is null ? LoadPortfolioStateAsync() : null;
            var hierarchyTask = ProjectsService.GetHierarchyAsync(projectId);
            if (portfolioTask is not null)
            {
                await Task.WhenAll(portfolioTask, hierarchyTask);
                project = (await portfolioTask).ProjectSummaries.FirstOrDefault(item => item.Id == projectId);
            }
            else
            {
                await hierarchyTask;
            }

            if (project is null)
            {
                throw new InvalidOperationException($"Project '{projectId:D}' is unavailable.");
            }

            var hierarchy = await hierarchyTask;
            var loadedPortfolio = portfolioTask is null ? null : await portfolioTask;
            var selectedProject = project;
            TryCompleteProjectLoad(loadStamp, () =>
            {
                if (loadedPortfolio is not null)
                {
                    ApplyPortfolioState(loadedPortfolio);
                }

                hierarchyDialog = new ProjectHierarchyDialogState(
                    selectedProject.Id,
                    selectedProject.Name,
                    hierarchy.ParentProjects,
                    hierarchy.ChildProjects);
            });
        }
        catch
        {
            if (!FailProjectLoad(loadStamp))
            {
                return;
            }

            throw;
        }
    }

    private void CloseHierarchyModal()
    {
        InvalidateProjectLoad();
        hierarchyDialog = null;
    }


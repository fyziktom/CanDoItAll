    private async Task ExportProjectsPackageAsync()
    {
        if (projectPackageBusy || projectPackageOutcomeUnknown)
        {
            return;
        }

        projectPackageBusy = true;
        projectPackageMessage = null;
        projectPackageMessageIsError = false;
        string submittedPath = projectPackagePath;

        try
        {
            var result = await ProjectPackageService.ExportAllAsync(new ProjectPackageExportRequest
            {
                PackagePath = string.IsNullOrWhiteSpace(submittedPath) ? null : submittedPath
            });

            if (result.IsFailure)
            {
                projectPackageMessage = string.Join(" ", result.Errors.Select(error => error.Message));
                projectPackageMessageIsError = true;
                return;
            }

            var exported = result.Value!;
            if (projectPackagePath == submittedPath) {
                projectPackagePath = exported.PackagePath;
            }
            projectPackageMessage = $"Exported {exported.Manifest.TotalRecordCount} project record(s) to {exported.PackagePath}.";
        } catch (Exception exception) {
            Logger.LogError(exception, "Project package export outcome is unconfirmed.");
            projectPackageOutcomeUnknown = true;
            projectPackageMessage = "The export outcome is unconfirmed. Inspect the requested package before attempting another export.";
            projectPackageMessageIsError = true;
        }
        finally
        {
            projectPackageBusy = false;
        }
    }

    private async Task ImportProjectsPackageAsync() {
        if (projectPackageBusy || projectPackageOutcomeUnknown) {
            return;
        }
        if (string.IsNullOrWhiteSpace(projectPackagePath)) {
            projectPackageMessage = "Choose a project package path.";
            projectPackageMessageIsError = true;
            return;
        }
        if (!projectPackageTargetProfileId.HasValue ||
            projectPackageTargetProfiles.All(profile => profile.Id != projectPackageTargetProfileId)) {
            projectPackageMessage = "Choose a package path and an available inactive target database profile.";
            projectPackageMessageIsError = true;
            return;
        }
        var request = new ProjectPackageImportRequest { PackagePath = projectPackagePath, TargetProfileId = projectPackageTargetProfileId.Value };
        projectPackageBusy = true;
        projectPackageMessage = null;
        projectPackageMessageIsError = false;
        try {
            var result = await ProjectPackageService.ImportAllAsync(request);
            projectPackageMessage = result.IsFailure
                ? string.Join(" ", result.Errors.Select(error => error.Message))
                : $"Imported {result.Value!.RecordsImported} project record(s) from {result.Value.Manifest.PackageId:N} into {request.TargetProfileId:D}.";
            projectPackageMessageIsError = result.IsFailure;
            if (result.IsSuccess) {
                await RefreshPortfolioAsync();
            }
        } catch (Exception exception) {
            Logger.LogError(exception, "Project package import outcome is unconfirmed for target {TargetProfileId}.", request.TargetProfileId);
            projectPackageOutcomeUnknown = true;
            projectPackageMessage = "The import outcome is unconfirmed. Inspect the target database before attempting another import.";
            projectPackageMessageIsError = true;
        } finally {
            projectPackageBusy = false;
        }
    }


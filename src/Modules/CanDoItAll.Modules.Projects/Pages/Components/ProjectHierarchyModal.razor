@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using CanDoItAll.Modules.Projects

@if (State is not null)
{
    <Dialog IsOpen="true"
            Eyebrow="Project hierarchy"
            Title="@State.ProjectName"
            Subtitle="Inspect direct parents, browse direct subprojects, and keep drilling into deeper project branches without leaving the Projects board."
            Size="ModalSize.Wide"
            ShowCloseButton="false"
            TestId="projects-hierarchy-modal"
            OnClose="Close">
        <HeaderActions>
            <StatusBadge Tone="neutral" Text="@($"{State.ParentProjects.Count} parent(s)")" />
            <StatusBadge Tone="info" Text="@($"{State.Subprojects.Count} subproject(s)")" />
            <Button Tone="ButtonTone.Default"
                    Text="Close"
                    Click="Close" />
        </HeaderActions>
        <ChildContent>
            <Grid Gap="LayoutGap.Large"
                  ColumnTemplateXl="minmax(0,0.82fr) minmax(0,1.18fr)">
                <SurfaceCard Soft="true">
                    <Split Breakpoint="LayoutBreakpoint.None"
                           Gap="LayoutGap.Medium"
                           AlignItems="AlignItems.Center"
                           JustifyContent="JustifyContent.SpaceBetween"
                           Wrap="FlexWrap.Wrap">
                        <div>
                            <TextBlock TextStyle="TextStyle.EyebrowCaption" Value="Parents" />
                            <h3 class="mt-1 text-lg font-semibold text-chrome-950">Direct parent projects</h3>
                        </div>
                        <StatusBadge Tone="neutral" Text="@($"{State.ParentProjects.Count} linked")" />
                    </Split>

                    @if (State.ParentProjects.Count == 0)
                    {
                        <p class="mt-4 text-sm leading-6 text-chrome-600">This project does not currently sit under any parent project.</p>
                    }
                    else
                    {
                        <Stack GapScale="LayoutGap.Medium"
                               Class="mt-4">
                            @foreach (var parentProject in State.ParentProjects.OrderBy(project => project.Name))
                            {
                                <PanelCard>
                                    <Split Breakpoint="LayoutBreakpoint.None"
                                           Gap="LayoutGap.Medium"
                                           AlignItems="AlignItems.Start"
                                           JustifyContent="JustifyContent.SpaceBetween"
                                           Wrap="FlexWrap.Wrap">
                                        <div class="min-w-0">
                                            <p class="text-sm font-semibold text-chrome-950">@parentProject.Name</p>
                                            <TextBlock TextStyle="TextStyle.Eyebrow" Class="mt-1" Value="@(string.IsNullOrWhiteSpace(parentProject.CurrentPhase) ? "Parent project" : parentProject.CurrentPhase)" />
                                        </div>
                                        <StatusBadge Tone="@ProjectsPresentation.GetStatusTone(parentProject.Status)" Text="@parentProject.Status.ToString()" />
                                    </Split>
                                    <Cluster Class="mt-4">
                                        <Button Tone="ButtonTone.Default"
                                                Text="View"
                                                Size="ButtonSize.Small"
                                                Click="@(() => OpenProjectPreview.InvokeAsync(parentProject.Id))" />
                                        <Button Tone="ButtonTone.Default"
                                                Text="Structure"
                                                Size="ButtonSize.Small"
                                                Click="@(() => OpenStructure.InvokeAsync(parentProject.Id))" />
                                        </Cluster>
                                    </PanelCard>
                                }
                        </Stack>
                    }
                </SurfaceCard>

                <SurfaceCard>
                    <Split Breakpoint="LayoutBreakpoint.None"
                           Gap="LayoutGap.Medium"
                           AlignItems="AlignItems.Center"
                           JustifyContent="JustifyContent.SpaceBetween"
                           Wrap="FlexWrap.Wrap">
                        <div>
                            <TextBlock TextStyle="TextStyle.EyebrowCaption" Value="Subprojects" />
                            <h3 class="mt-1 text-lg font-semibold text-chrome-950">Direct child projects</h3>
                        </div>
                        <StatusBadge Tone="info" Text="@($"{State.Subprojects.Count} linked")" />
                    </Split>

                    @if (State.Subprojects.Count == 0)
                    {
                        <p class="mt-4 text-sm leading-6 text-chrome-600">No direct subprojects are connected to this project yet.</p>
                    }
                    else
                    {
                        <Grid Gap="LayoutGap.Medium"
                              ColumnsMd="2"
                              Class="mt-4">
                            @foreach (var subproject in State.Subprojects.OrderBy(project => project.Name))
                            {
                                <PanelCard Soft="true" data-testid="hierarchy-subproject-card">
                                    <Split Breakpoint="LayoutBreakpoint.None"
                                           Gap="LayoutGap.Medium"
                                           AlignItems="AlignItems.Start"
                                           JustifyContent="JustifyContent.SpaceBetween"
                                           Wrap="FlexWrap.Wrap">
                                        <div class="min-w-0">
                                            <p class="text-sm font-semibold text-chrome-950">@subproject.Name</p>
                                            <TextBlock TextStyle="TextStyle.Eyebrow" Class="mt-1" Value="@(string.IsNullOrWhiteSpace(subproject.CurrentPhase) ? "Subproject" : subproject.CurrentPhase)" />
                                        </div>
                                        <StatusBadge Tone="@ProjectsPresentation.GetStatusTone(subproject.Status)" Text="@subproject.Status.ToString()" />
                                    </Split>

                                    <CompactStatStrip Class="mt-4">
                                        <CompactStat Label="parents" Value="@subproject.ParentCount.ToString()" TooltipText="Parent projects linked to this subproject." />
                                        <CompactStat Label="subprojects" Value="@subproject.ChildCount.ToString()" TooltipText="Child projects linked under this subproject." Tone="info" />
                                        <CompactStat Label="updated" Value="@subproject.UpdatedAtUtc.LocalDateTime.ToString("g")" TooltipText="Most recent update time for this subproject." />
                                    </CompactStatStrip>

                                    <Cluster Class="mt-4">
                                        <Button Tone="ButtonTone.Default"
                                                Text="View"
                                                Size="ButtonSize.Small"
                                                Click="@(() => OpenProjectPreview.InvokeAsync(subproject.Id))" />
                                        <Button Tone="ButtonTone.Default"
                                                Text="Structure"
                                                Size="ButtonSize.Small"
                                                Click="@(() => OpenStructure.InvokeAsync(subproject.Id))" />
                                        <Button Text="Subprojects"
                                                Size="ButtonSize.Small"
                                                data-testid="hierarchy-card-subprojects-button"
                                                Click="@(() => OpenHierarchy.InvokeAsync(subproject.Id))" />
                                    </Cluster>
                                </PanelCard>
                            }
                        </Grid>
                    }
                </SurfaceCard>
            </Grid>
        </ChildContent>
    </Dialog>
}

@code {
    [Parameter]
    public ProjectHierarchyDialogState? State { get; set; }

    [Parameter]
    public EventCallback Close { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenProjectPreview { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenStructure { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenHierarchy { get; set; }
}

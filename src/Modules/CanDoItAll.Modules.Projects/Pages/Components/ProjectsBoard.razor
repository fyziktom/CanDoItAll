@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using CanDoItAll.Modules.Projects
@using CanDoItAll.SharedKernel

<section class="projects-board flex min-h-[26rem] w-full flex-col overflow-hidden rounded-[1.85rem] border border-slate-200 bg-white/92 shadow-sm shadow-slate-200/60"
         data-testid="projects-board">
    <Stack GapScale="LayoutGap.Small"
           Class="border-b border-slate-200 px-4 py-4 sm:px-5"
           data-testid="projects-command-bar">
        <Split Breakpoint="LayoutBreakpoint.Xl"
               Gap="LayoutGap.Small"
               AlignItems="AlignItems.Center"
               JustifyContent="JustifyContent.SpaceBetween"
               Wrap="FlexWrap.NoWrap"
               Class="projects-board__summary-row">
            <Cluster Gap="LayoutGap.Small"
                     Wrap="FlexWrap.NoWrap"
                     Class="projects-board__summary-main min-w-0">
                <h2 class="truncate text-lg font-semibold tracking-tight text-slate-950">Portfolio board</h2>
                <Pill Tone="PillTone.Info"
                      Text="@($"{FilteredProjectSummaries.Count} visible")" />
                <Pill Tone="PillTone.Info"
                      Text="@($"{ProjectSummaries.Count(project => project.Status == ProjectStatus.Active)} active")" />
                <Pill Tone="PillTone.Neutral"
                      Text="@($"{ProjectSummaries.Count(project => project.Status == ProjectStatus.Draft)} draft")" />
                <Pill Tone="PillTone.Warn"
                      Token="UPD"
                      Text="@LatestUpdatedProjectLabel" />
                <HelpPopover RootClass="pf-help-popover flex items-center"
                             ToggleClass="pf-help-popover__toggle pf-help-popover__toggle--compact"
                             AriaLabel="Show portfolio board help"
                             Title="Show portfolio board help"
                             Heading="Portfolio board"
                             Body="@HierarchyFilterHelper"
                             Tip="@LatestUpdatedProjectHelper" />
            </Cluster>

            <Cluster Gap="LayoutGap.XSmall"
                     Wrap="FlexWrap.NoWrap"
                     JustifyContent="JustifyContent.End"
                     Class="projects-board__summary-actions">
                <TooltipTarget Text="Create project"
                               Position="TooltipPosition.Bottom"
                               TestId="projects-new-tooltip">
                    <Button Class="cda-button--quick"
                            Icon="add"
                            aria-label="Create project"
                            data-testid="projects-new-button"
                            Click="OpenNewProject" />
                </TooltipTarget>
                <TooltipTarget Text="Open dashboard"
                               Position="TooltipPosition.Bottom"
                               TestId="projects-dashboard-tooltip">
                    <Button ButtonStyle="ButtonStyle.Light"
                            Class="cda-button--quick"
                            Icon="dashboard"
                            aria-label="Open dashboard"
                            Click="NavigateHome" />
                </TooltipTarget>
                <TooltipTarget Text="Import or export projects package"
                               Position="TooltipPosition.Bottom"
                               TestId="projects-package-dialog-tooltip">
                    <Button ButtonStyle="ButtonStyle.Light"
                            Class="cda-button--quick"
                            Icon="inventory_2"
                            aria-label="Import or export projects package"
                            data-testid="projects-package-dialog-button"
                            Click="OpenProjectPackageDialog" />
                </TooltipTarget>
            </Cluster>
        </Split>

        <Toolbar Class="rounded-[1.35rem] border border-slate-200/90 bg-slate-50/85 p-3 shadow-none">
            <div class="projects-board__filters">
                <PrefixedField Prefix="FIND"
                               Class="min-w-0">
                    <input value="@ProjectSearch"
                           @oninput="HandleProjectSearchInput"
                           maxlength="@ProjectFileFilter.MaximumTextLength"
                           class="cda-input cda-input--toolbar h-10"
                           placeholder="Search by name or current phase"
                           data-testid="projects-search-input" />
                </PrefixedField>
                <PrefixedField Prefix="STATUS"
                               Suffix="V"
                               PrefixPaddingRem="4.6"
                               SuffixPaddingRem="2.25"
                               StackOnMobile="true"
                               Class="min-w-0">
                    <InputSelect TValue="ProjectStatus?"
                                 @bind-Value="StatusFilterProxy"
                                 class="cda-input cda-input--toolbar h-10 appearance-none">
                        <option value="">All statuses</option>
                        @foreach (var status in Enum.GetValues<ProjectStatus>())
                        {
                            <option value="@status.ToString()">@status</option>
                        }
                    </InputSelect>
                </PrefixedField>
                <PrefixedField Prefix="REL"
                               Suffix="V"
                               PrefixPaddingRem="3.1"
                               SuffixPaddingRem="2.25"
                               StackOnMobile="true"
                               Class="min-w-0">
                    <InputSelect TValue="ProjectPartyPortfolioCategory?"
                                 @bind-Value="RelatedPartyCategoryFilterProxy"
                                 class="cda-input cda-input--toolbar h-10 appearance-none"
                                 data-testid="project-related-party-category-filter">
                        <option value="">Any relationship</option>
                        @foreach (var category in Enum.GetValues<ProjectPartyPortfolioCategory>())
                        {
                            <option value="@category.ToString()">@ResolveCategoryLabel(category)</option>
                        }
                    </InputSelect>
                </PrefixedField>
                <PrefixedField Prefix="PARTY"
                               Suffix="V"
                               PrefixPaddingRem="4.2"
                               SuffixPaddingRem="2.25"
                               StackOnMobile="true"
                               Class="min-w-0">
                    <InputSelect @bind-Value="RelatedPartyValueFilterProxy"
                                 class="cda-input cda-input--toolbar h-10 appearance-none"
                                 data-testid="project-related-party-value-filter">
                        <option value="">Any party</option>
                        @foreach (var value in ProjectProjection.AvailableRelatedPartyValues)
                        {
                            <option value="@value">@value</option>
                        }
                    </InputSelect>
                </PrefixedField>
                <PrefixedField Prefix="PROJECT"
                               Suffix="V"
                               PrefixPaddingRem="4.9"
                               SuffixPaddingRem="2.25"
                               StackOnMobile="true"
                               Class="min-w-0">
                    <InputSelect TValue="Guid?"
                                 @bind-Value="HierarchyFilterProjectIdProxy"
                                 class="cda-input cda-input--toolbar h-10 appearance-none"
                                 data-testid="hierarchy-filter-project">
                        <option value="">Any project</option>
                        @foreach (var project in MainProjectOptions)
                        {
                            <option value="@project.Id">@project.Name</option>
                        }
                    </InputSelect>
                </PrefixedField>
                <PrefixedField Prefix="LINK"
                               Suffix="V"
                               PrefixPaddingRem="3.8"
                               SuffixPaddingRem="2.25"
                               StackOnMobile="true"
                               Class="min-w-0">
                    <InputSelect TValue="ProjectHierarchyFilterMode"
                                 @bind-Value="HierarchyFilterModeProxy"
                                 class="cda-input cda-input--toolbar h-10 appearance-none"
                                 data-testid="hierarchy-filter-mode">
                        <option value="@ProjectHierarchyFilterMode.Descendants">Project scope</option>
                        <option value="@ProjectHierarchyFilterMode.Children">Subprojects</option>
                        <option value="@ProjectHierarchyFilterMode.Parents">Parents</option>
                        <option value="@ProjectHierarchyFilterMode.Related">Related</option>
                    </InputSelect>
                </PrefixedField>
                <label class="inline-flex h-10 min-w-fit items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 text-sm font-medium text-slate-700">
                    <CheckBox TValue="bool"
                              Value="@IncludeSubprojects"
                              ValueChanged="IncludeSubprojectsChanged"
                              Disabled="@(HierarchyFilterProjectId is null || HierarchyFilterMode != ProjectHierarchyFilterMode.Descendants)"
                              aria-label="Include subprojects"
                              data-testid="project-include-subprojects-filter" />
                    <TextBlock TextStyle="TextStyle.Caption"
                               Value="Include subprojects" />
                </label>
                <TooltipTarget Text="Reset filters"
                               Position="TooltipPosition.Bottom"
                               TestId="projects-reset-filters-tooltip">
                <Button ButtonStyle="ButtonStyle.Light"
                        Class="cda-button--quick"
                        Icon="restart_alt"
                        aria-label="Reset filters"
                        Click="ResetFilters" />
                </TooltipTarget>
            </div>
        </Toolbar>
    </Stack>

    @if (isProjectPackageDialogOpen)
    {
        <Dialog IsOpen="true"
                Eyebrow="Project package"
                Title="Import / export"
                Subtitle="Move the project portfolio as a zip package."
                Size="ModalSize.Compact"
                ShowCloseButton="false"
                TestId="projects-package-dialog"
                OnClose="CloseProjectPackageDialogAsync">
            <HeaderActions>
                @if (IsProjectPackageBusy)
                {
                    <StatusBadge Tone="info" Text="Working" />
                }
                <Button ButtonStyle="ButtonStyle.Light"
                        Icon="close"
                        aria-label="Close project package dialog"
                        Click="CloseProjectPackageDialogAsync" />
            </HeaderActions>
            <ChildContent>
                <Stack GapScale="LayoutGap.Medium"
                       Class="projects-board__package-dialog">
                    <PrefixedField Prefix="ZIP"
                                   PrefixPaddingRem="3.2"
                                   Class="min-w-0">
                        <input value="@ProjectPackagePath"
                               @oninput="HandleProjectPackagePathInput"
                               class="cda-input cda-input--toolbar h-10"
                               placeholder="Package path"
                               data-testid="projects-package-path-input" />
                    </PrefixedField>
                    <Cluster Gap="LayoutGap.Small"
                             JustifyContent="JustifyContent.End"
                             Class="min-w-0">
                        <TooltipTarget Text="Export projects package"
                                       Position="TooltipPosition.Bottom"
                                       TestId="projects-export-package-tooltip">
                            <Button Class="cda-button--quick"
                                    Icon="file_download"
                                    aria-label="Export projects package"
                                    Disabled="@IsProjectPackageBusy"
                                    IsBusy="@IsProjectPackageBusy"
                                    data-testid="projects-export-package-button"
                                    Click="ExportProjectsPackage" />
                        </TooltipTarget>
                        <TooltipTarget Text="Import projects package"
                                       Position="TooltipPosition.Bottom"
                                       TestId="projects-import-package-tooltip">
                            <Button ButtonStyle="ButtonStyle.Light"
                                    Class="cda-button--quick"
                                    Icon="file_upload"
                                    aria-label="Import projects package"
                                    Disabled="@IsProjectPackageBusy"
                                    data-testid="projects-import-package-button"
                                    Click="ImportProjectsPackage" />
                        </TooltipTarget>
                    </Cluster>
                    @if (!string.IsNullOrWhiteSpace(ProjectPackageMessage))
                    {
                        <p class="projects-board__package-message @(IsProjectPackageMessageError ? "projects-board__package-message--error" : "projects-board__package-message--success")"
                           data-testid="projects-package-message">
                            @ProjectPackageMessage
                        </p>
                    }
                </Stack>
            </ChildContent>
        </Dialog>
    }

    <ListDetailShell ListPaneWidth="22rem"
                     Dense="true"
                     ListPaneClass="min-h-0"
                     DetailPaneClass="min-h-0"
                     data-testid="projects-tree-workspace">
        <ListHeader>
            <ListPanelHeader Title="Portfolio tree"
                             Dense="true"
                             Count="@($"{ProjectTreeNodes.Count} root(s)")"
                             HelpText="Use the hierarchy tree to choose a project without leaving the portfolio board." />
        </ListHeader>
        <ListContent>
            <div class="h-full min-h-0 overflow-y-auto pr-1"
                 style="scrollbar-gutter:stable;"
                 data-testid="projects-tree-scroll">
                <TreeView Items="@ProjectTreeNodes"
                          Style="TreeViewStyle.Workbench"
                          AriaLabel="Project hierarchy"
                          EmptyText="No projects match the current filters."
                          OnSelect="HandleProjectTreeSelectAsync"
                          OnToggle="HandleProjectTreeToggleAsync" />
            </div>
        </ListContent>
        <DetailHeader>
            <Cluster Gap="LayoutGap.Small"
                     JustifyContent="JustifyContent.SpaceBetween"
                     Class="min-w-0">
                <div class="min-w-0">
                    <p class="cda-eyebrow cda-eyebrow--tight">Portfolio board</p>
                    <h3 class="truncate text-base font-semibold text-slate-950">@SelectedTreeProjectName</h3>
                </div>
                <Pill Tone="PillTone.Info"
                      Text="@($"{FilteredProjectSummaries.Count} visible")" />
            </Cluster>
        </DetailHeader>
        <DetailContent>
            <Tabs SelectedIndex="@selectedPortfolioTabIndex"
                  SelectedIndexChanged="HandlePortfolioTabChanged"
                  Variant="TabsVariant.WorkspaceSecondary"
                  BorderMode="TabsBorderMode.Soft"
                  PanelOverflowMode="TabsPanelOverflowMode.Hidden"
                  FillHeight="true"
                  AriaLabel="Project portfolio views"
                  data-testid="projects-portfolio-tabs">
                <TabItems>
                    <TabsItem Text="Cards"
                              Icon="dashboard">
                        <ProjectPortfolioCards Projects="FilteredProjectSummaries"
                                               OpenNewProject="OpenNewProject"
                                               OpenProjectPreview="OpenProjectPreview"
                                               OpenHierarchyModal="OpenHierarchyModal"
                                               OpenProjectFiles="OpenProjectFiles"
                                               OpenProjectDashboard="OpenProjectDashboard"
                                               OpenStructure="OpenStructure"
                                               OpenGantt="OpenGantt"
                                               OpenProcesses="OpenProcesses"
                                               OpenCalendar="OpenCalendar" />
                    </TabsItem>
                    <TabsItem Text="Files"
                              Icon="folder_open"
                              BadgeText="@ProjectProjection.Projects.Count.ToString()">
                        <ProjectFilesPortfolioPane Projection="ProjectProjection" />
                    </TabsItem>
                </TabItems>
            </Tabs>
        </DetailContent>
    </ListDetailShell>
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ProjectSummary> ProjectSummaries { get; set; } = default!;

    [Parameter, EditorRequired]
    public ProjectFileFilterProjection ProjectProjection { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<ProjectHierarchyLinkSummary> HierarchyLinks { get; set; } = [];

    [Parameter]
    public string ProjectSearch { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ProjectSearchChanged { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenProjectFiles { get; set; }

    [Parameter]
    public ProjectStatus? StatusFilter { get; set; }

    [Parameter]
    public EventCallback<ProjectStatus?> StatusFilterChanged { get; set; }

    [Parameter]
    public ProjectPartyPortfolioCategory? RelatedPartyCategoryFilter { get; set; }

    [Parameter]
    public EventCallback<ProjectPartyPortfolioCategory?> RelatedPartyCategoryFilterChanged { get; set; }

    [Parameter]
    public string RelatedPartyValueFilter { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> RelatedPartyValueFilterChanged { get; set; }

    [Parameter]
    public Guid? HierarchyFilterProjectId { get; set; }

    [Parameter]
    public EventCallback<Guid?> HierarchyFilterProjectIdChanged { get; set; }

    [Parameter]
    public ProjectHierarchyFilterMode HierarchyFilterMode { get; set; } = ProjectHierarchyFilterMode.Descendants;

    [Parameter]
    public EventCallback<ProjectHierarchyFilterMode> HierarchyFilterModeChanged { get; set; }

    [Parameter]
    public bool IncludeSubprojects { get; set; } = true;

    [Parameter]
    public EventCallback<bool> IncludeSubprojectsChanged { get; set; }

    [Parameter]
    public string HierarchyFilterHelper { get; set; } = string.Empty;

    [Parameter]
    public string LatestUpdatedProjectLabel { get; set; } = string.Empty;

    [Parameter]
    public string LatestUpdatedProjectHelper { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OpenNewProject { get; set; }

    [Parameter]
    public EventCallback NavigateHome { get; set; }

    [Parameter]
    public EventCallback ResetFilters { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenProjectPreview { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenHierarchyModal { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenProjectDashboard { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenStructure { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenProcesses { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenCalendar { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenGantt { get; set; }

    [Parameter]
    public EventCallback<ProjectsAgentChatView> PortfolioViewChanged { get; set; }

    [Parameter]
    public string ProjectPackagePath { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ProjectPackagePathChanged { get; set; }

    [Parameter]
    public string? ProjectPackageMessage { get; set; }

    [Parameter]
    public bool IsProjectPackageMessageError { get; set; }

    [Parameter]
    public bool IsProjectPackageBusy { get; set; }

    [Parameter]
    public EventCallback ExportProjectsPackage { get; set; }

    [Parameter]
    public EventCallback ImportProjectsPackage { get; set; }

    private readonly HashSet<string> expandedProjectTreeNodeIds = [];
    private Guid? selectedTreeProjectId;
    private bool isProjectPackageDialogOpen;
    private int selectedPortfolioTabIndex;

    private IReadOnlyList<ProjectSummary> FilteredProjectSummaries => ProjectProjection.Projects;

    private IReadOnlyList<ProjectSummary> MainProjectOptions
    {
        get
        {
            var mainProjects = ProjectSummaries
                .Where(IsMainProject)
                .OrderBy(project => project.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            return mainProjects.Count > 0
                ? mainProjects
                : ProjectSummaries.OrderBy(project => project.Name, StringComparer.OrdinalIgnoreCase).ToList();
        }
    }

    private IReadOnlyList<TreeViewNode> ProjectTreeNodes
        => ProjectPortfolioTreeNodeBuilder.Build(
            ProjectSummaries,
            HierarchyLinks,
            selectedTreeProjectId,
            expandedProjectTreeNodeIds);

    private string SelectedTreeProjectName
        => selectedTreeProjectId.HasValue
            ? ProjectSummaries.FirstOrDefault(project => project.Id == selectedTreeProjectId.Value)?.Name ?? "Selected project"
            : "All filtered projects";

    protected override void OnParametersSet()
    {
        selectedTreeProjectId = HierarchyFilterProjectId;
    }

    private async Task HandleProjectTreeSelectAsync(string nodeId)
    {
        if (!ProjectPortfolioTreeNodeBuilder.TryReadProjectId(nodeId, out var projectId))
        {
            return;
        }

        selectedTreeProjectId = projectId;
        await HierarchyFilterProjectIdChanged.InvokeAsync(projectId);
        if (HierarchyFilterMode != ProjectHierarchyFilterMode.Descendants)
        {
            await HierarchyFilterModeChanged.InvokeAsync(ProjectHierarchyFilterMode.Descendants);
        }
    }

    private Task HandleProjectTreeToggleAsync(string nodeId)
    {
        if (!expandedProjectTreeNodeIds.Add(nodeId))
        {
            expandedProjectTreeNodeIds.Remove(nodeId);
        }

        return Task.CompletedTask;
    }

    private string ProjectSearchProxy
    {
        get => ProjectSearch;
        set => _ = ProjectSearchChanged.InvokeAsync(value);
    }

    private Task HandleProjectSearchInput(ChangeEventArgs args)
    {
        return ProjectSearchChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    }

    private Task HandleProjectPackagePathInput(ChangeEventArgs args)
    {
        return ProjectPackagePathChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    }

    private void OpenProjectPackageDialog()
    {
        isProjectPackageDialogOpen = true;
    }

    private Task CloseProjectPackageDialogAsync()
    {
        isProjectPackageDialogOpen = false;
        return Task.CompletedTask;
    }

    private ProjectStatus? StatusFilterProxy
    {
        get => StatusFilter;
        set => _ = StatusFilterChanged.InvokeAsync(value);
    }

    private ProjectPartyPortfolioCategory? RelatedPartyCategoryFilterProxy
    {
        get => RelatedPartyCategoryFilter;
        set => _ = RelatedPartyCategoryFilterChanged.InvokeAsync(value);
    }

    private string RelatedPartyValueFilterProxy
    {
        get => RelatedPartyValueFilter;
        set => _ = RelatedPartyValueFilterChanged.InvokeAsync(value);
    }

    private Guid? HierarchyFilterProjectIdProxy
    {
        get => HierarchyFilterProjectId;
        set => _ = HierarchyFilterProjectIdChanged.InvokeAsync(value);
    }

    private ProjectHierarchyFilterMode HierarchyFilterModeProxy
    {
        get => HierarchyFilterMode;
        set => _ = HierarchyFilterModeChanged.InvokeAsync(value);
    }

    private async Task HandlePortfolioTabChanged(int index)
    {
        selectedPortfolioTabIndex = index;
        var view = index switch
        {
            0 => ProjectsAgentChatView.Cards,
            1 => ProjectsAgentChatView.Files,
            _ => throw new ArgumentOutOfRangeException(nameof(index), index, "The Projects portfolio tab is undefined.")
        };
        await PortfolioViewChanged.InvokeAsync(view);
    }

    private bool IsMainProject(ProjectSummary project)
        => project.ParentCount == 0 &&
           HierarchyLinks.All(link => link.ChildProjectId != project.Id);

    private static string ResolveCategoryLabel(ProjectPartyPortfolioCategory category)
    {
        return category switch
        {
            ProjectPartyPortfolioCategory.DeliveryUnit => "Delivery unit",
            ProjectPartyPortfolioCategory.AiAgent => "AI agent",
            _ => category.ToString()
        };
    }
}

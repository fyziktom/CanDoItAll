@implements IAsyncDisposable
@using CanDoItAll.Projects.Files.UI
@inject IFileToolsBrowseItemActionService ItemActionService
@inject IFileAccessContextProvider Contexts
@inject FileInteractionComponentComposition InteractionComposition
@inject IJSRuntime JSRuntime
@inject IProjectFilePortfolioCoordinator Coordinator
@inject ILogger<ProjectFilesPortfolioPane> Logger

<ProjectFilesPortfolioPaneView State="Session.State" />

@code {
    [Parameter, EditorRequired]
    public ProjectFileFilterProjection Projection { get; set; } = default!;

    private ProjectFilesSurfaceSession? session;
    private string? fingerprint;
    private ProjectFilesSurfaceSession Session => session ??= new(this, Contexts, ItemActionService, InteractionComposition, JSRuntime, Logger);

    protected override Task OnParametersSetAsync() {
        ArgumentNullException.ThrowIfNull(Projection);
        if (string.Equals(fingerprint, Projection.Fingerprint, StringComparison.Ordinal)) {
            return Task.CompletedTask;
        }
        var projection = Projection;
        fingerprint = projection.Fingerprint;
        return Session.OpenAsync(async token => ProjectFilesOwnedWorkspace.From(await Coordinator.OpenAsync(projection, token), Coordinator), $"{projection.Projects.Count} filtered project(s)");
    }

    public ValueTask DisposeAsync() => session?.DisposeAsync() ?? ValueTask.CompletedTask;
}

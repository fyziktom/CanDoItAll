@implements IAsyncDisposable
@using CanDoItAll.Projects.Files.UI
@inject IFileToolsBrowseItemActionService ItemActionService
@inject IFileAccessContextProvider Contexts
@inject FileInteractionComponentComposition InteractionComposition
@inject IJSRuntime JSRuntime
@inject IProjectFilesPilotCoordinator Coordinator
@inject ILogger<ProjectFilesDialog> Logger

<ProjectFilesDialogView IsOpen="IsOpen" ProjectName="ProjectName" State="Session.State" />

@code {
    [Parameter]
    public bool IsOpen { get; set; }
    [Parameter]
    public Guid ProjectId { get; set; }
    [Parameter]
    public string ProjectName { get; set; } = string.Empty;
    [Parameter]
    public EventCallback Closed { get; set; }

    private ProjectFilesSurfaceSession? session;
    private Guid? activeProject;
    private ProjectFilesSurfaceSession Session => session ??= new(this, Contexts, ItemActionService, InteractionComposition, JSRuntime, Logger);

    protected override Task OnParametersSetAsync() {
        if (!IsOpen) {
            activeProject = null;
            return Session.ResetAsync();
        }
        if (activeProject == ProjectId) {
            return Task.CompletedTask;
        }
        activeProject = ProjectId;
        Guid project = ProjectId;
        string name = ProjectName;
        var closed = Closed;
        return Session.OpenAsync(async token => ProjectFilesOwnedWorkspace.From(await Coordinator.OpenAsync(project, name, token), Coordinator), name, closed);
    }

    public ValueTask DisposeAsync() => session?.DisposeAsync() ?? ValueTask.CompletedTask;
}

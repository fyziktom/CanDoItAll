@page "/prompt-gallery"
@using CanDoItAll.AppComponents.Navigation
@implements IDisposable
@inject IPromptGalleryCuratorLauncher CuratorLauncher
@inject NotificationService Notifications
@inject NavigationManager Navigation
@inject IAppNavigationHistory History

<PageTitle>Prompt Gallery</PageTitle>

<PageScaffold MaxWidthClass="max-w-full">
    <Header>
        <PageHeader Eyebrow="Shared prompt library"
                    Title="Prompt gallery"
                    Description="Browse, filter, version, and maintain the canonical prompts and prompt parts reused by workflows, agents, processes, roles, and chat."
                    Compact="true">
            <Stats>
                <CompactStat Label="search" Value="Paged" TooltipText="Search is delegated to the active Gallery search driver." Tone="info" />
                <CompactStat Label="versions" Value="Immutable" TooltipText="Final versions remain stable when a draft changes." Tone="success" />
                <CompactStat Label="projection" Value="Optional" TooltipText="A projection driver can replace standard database search without changing Gallery consumers." />
            </Stats>
            <Actions>
                @if (CuratorLauncher.IsAvailable)
                {
                    <AgentAvatarActionButton AgentName="@CuratorDisplayName"
                                             AvatarImageUrl="@curatorPresentation?.AvatarImageUrl"
                                             FallbackText="PC"
                                             Label="@($"Open {CuratorDisplayName}")"
                                             Click="OpenCuratorAsync"
                                             Disabled="@(isOpeningCurator || isLoadingCuratorPresentation)"
                                             TestId="prompt-gallery-prompts-curator-open"
                                             TooltipTestId="prompt-gallery-prompts-curator-tooltip" />
                }
                <PageHeaderActionButton Icon="add"
                                        Label="New item"
                                        TooltipText="Create a reusable prompt or prompt part."
                                        ButtonStyle="ButtonStyle.Primary"
                                        Click="CreateNewAsync" />
            </Actions>
        </PageHeader>
    </Header>

    <ChildContent>
        <PromptGallerySearchHost @ref="searchHost"
                                 PageSize="25"
                                 Compact="false"
                                 AllowEdit="true"
                                 ShowSelectAction="false"
                                 Request="@url.State.ToSearchRequest()"
                                 Committed="HandleSearchCommitted"
                                 EditRequested="OpenEditorAsync" />
    </ChildContent>
</PageScaffold>

<Dialog IsOpen="@editorOpen"
        Eyebrow="Prompt gallery"
        Title="@EditorTitle"
        Subtitle="Edit canonical content and portable model recommendations."
        Size="ModalSize.Full"
        DenseChrome="true"
        CloseOnBackdrop="false"
        TestId="prompt-gallery-editor-dialog"
        OnClose="CloseEditorAsync">
    <ChildContent>
        @if (editorOpen)
        {
            <PromptGalleryItemEditorHost ItemId="@selectedItemId"
                                         Committed="HandleCommittedAsync"
                                         Cancelled="CloseEditorAsync" />
        }
    </ChildContent>
</Dialog>

@code {
    private readonly CancellationTokenSource lifetime = new();
    private UrlStateBinding<PromptGalleryUrlState> url = default!;
    private PromptGallerySearchHost? searchHost;
    private Guid? selectedItemId;
    private bool editorDirty;
    private bool editorOpen;
    private bool creatingNew;
    private bool isOpeningCurator;
    private bool isLoadingCuratorPresentation;
    private bool curatorContextFailed;
    private bool disposed;
    private PromptGalleryCuratorPresentation? curatorPresentation;
    private IPromptGalleryCuratorContextLease? curatorContextLease;

    [SupplyParameterFromQuery(Name = PromptGalleryUrlCodec.PromptKey)]
    public string? PromptIdQuery { get; set; }

    [SupplyParameterFromQuery(Name = PromptGalleryUrlCodec.SearchKey)]
    public string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = PromptGalleryUrlCodec.TagsKey)]
    public string? TagsQuery { get; set; }

    [SupplyParameterFromQuery(Name = PromptGalleryUrlCodec.KindKey)]
    public string? KindQuery { get; set; }

    [SupplyParameterFromQuery(Name = PromptGalleryUrlCodec.StatusKey)]
    public string? StatusQuery { get; set; }

    [SupplyParameterFromQuery(Name = PromptGalleryUrlCodec.ProviderKey)]
    public string? ProviderQuery { get; set; }

    [SupplyParameterFromQuery(Name = PromptGalleryUrlCodec.ModelKey)]
    public string? ModelQuery { get; set; }

    [SupplyParameterFromQuery(Name = PromptGalleryUrlCodec.FavoritesKey)]
    public string? FavoritesQuery { get; set; }

    [SupplyParameterFromQuery(Name = PromptGalleryUrlCodec.ArchivedKey)]
    public string? ArchivedQuery { get; set; }

    [SupplyParameterFromQuery(Name = PromptGalleryUrlCodec.ChatModelKey)]
    public string? ChatModelQuery { get; set; }

    [SupplyParameterFromQuery(Name = PromptGalleryUrlCodec.PageKey)]
    public string? PageQuery { get; set; }

    private string EditorTitle => selectedItemId.HasValue ? "Edit Gallery item" : "New Gallery item";

    private string CuratorDisplayName => curatorPresentation?.Name ?? "Prompts Curator Agent";

    protected override void OnInitialized()
        => url = new(Navigation, PromptGalleryUrlCodec.Instance, History, typeof(PromptGalleryPage));

    protected override Task OnParametersSetAsync()
    {
        SynchronizeCurator();

        // The editor is open exactly while its promptId is in the URL; an echo of the same location changes nothing.
        var change = url.Apply(canonicalize: RendererInfo.IsInteractive);
        if (!change.IsChanged || !change.IsInitial && change.Previous.PromptId == change.Current.PromptId)
        {
            return Task.CompletedTask;
        }

        return ApplyEditorRouteAsync(change.Current.PromptId);
    }

    private async Task ApplyEditorRouteAsync(Guid? promptId)
    {
        if (promptId is { } id)
        {
            selectedItemId = id;
            creatingNew = false;
            editorOpen = true;
            return;
        }

        // A new item stays a local draft until its first save; only an addressed editor follows the URL.
        if (!editorOpen || creatingNew)
        {
            return;
        }

        editorOpen = false;
        selectedItemId = null;
        await RefreshAfterEditorAsync();
    }

    private void HandleSearchCommitted(PromptGallerySearchCommit commit)
        => url.Navigate(
            url.State.WithSearch(commit.Filters, commit.PageIndex),
            commit.Kind == PromptGallerySearchCommitKind.Explicit ? UrlHistoryMode.Push : UrlHistoryMode.Replace);

    private void SynchronizeCurator()
    {
        if (disposed || !CuratorLauncher.IsAvailable || curatorContextFailed)
        {
            return;
        }

        try
        {
            curatorContextLease ??= CuratorLauncher.ActivateContext();
            curatorContextLease.SynchronizeNavigation();
        }
        catch (Exception exception)
        {
            // The Curator integration is optional; its failure never blocks the gallery itself.
            curatorContextFailed = true;
            Notifications.Error("Unable to prepare Prompts Curator", exception.Message);
            return;
        }

        // The presentation read runs beside the gallery, never ahead of promptId handling or the first render.
        _ = LoadCuratorPresentationAsync();
    }

    private Task CreateNewAsync()
    {
        if (url.State.PromptId is not null)
        {
            url.Navigate(url.State with { PromptId = null }, UrlHistoryMode.Replace);
        }

        selectedItemId = null;
        creatingNew = true;
        editorOpen = true;
        return Task.CompletedTask;
    }

    private Task OpenEditorAsync(Guid itemId)
    {
        url.OpenOverlay(url.State with { PromptId = itemId });
        selectedItemId = itemId;
        creatingNew = false;
        editorOpen = true;
        return Task.CompletedTask;
    }

    private async Task OpenCuratorAsync()
    {
        if (disposed || isOpeningCurator || isLoadingCuratorPresentation || !CuratorLauncher.IsAvailable)
        {
            return;
        }

        isOpeningCurator = true;
        try
        {
            await LoadCuratorPresentationAsync();
            if (disposed || curatorPresentation is null)
            {
                return;
            }

            await CuratorLauncher.OpenAsync(lifetime.Token);
            if (disposed)
            {
                // The chat may already exist; only this page's stale presentation of that fact is suppressed.
                return;
            }

            Notifications.Success("Chat ready", "Opened a new chat with Prompts Curator Agent.");
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            if (!disposed)
            {
                Notifications.Error("Unable to open Prompts Curator", exception.Message);
            }
        }
        finally
        {
            if (!disposed)
            {
                isOpeningCurator = false;
            }
        }
    }

    private async Task LoadCuratorPresentationAsync()
    {
        if (disposed || curatorPresentation is not null || isLoadingCuratorPresentation)
        {
            return;
        }

        isLoadingCuratorPresentation = true;
        try
        {
            var presentation = await CuratorLauncher.GetPresentationAsync(lifetime.Token);
            if (disposed)
            {
                return;
            }

            curatorPresentation = presentation;
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            if (disposed)
            {
                return;
            }

            // A transient failure keeps the action available; the next click retries the read.
            Notifications.Error("Unable to load Prompts Curator", exception.Message);
        }
        finally
        {
            if (!disposed)
            {
                isLoadingCuratorPresentation = false;
            }
        }

        await RenderIfAliveAsync();
    }

    private async Task RenderIfAliveAsync()
    {
        if (disposed)
        {
            return;
        }

        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception) when (disposed)
        {
            // The page went away while the render was queued; there is nothing left to show.
        }
    }

    private Task HandleCommittedAsync(PromptGalleryEditorCommit commit)
    {
        // The editor reports the identity it owns; the page echoes it back as the requested target.
        selectedItemId = commit.ItemId;
        editorDirty = true;
        if (creatingNew && editorOpen)
        {
            // The first save gives the draft its identity; the editor becomes addressable without a new history entry.
            creatingNew = false;
            url.Navigate(url.State with { PromptId = commit.ItemId }, UrlHistoryMode.Replace);
        }

        return Task.CompletedTask;
    }

    private async Task CloseEditorAsync()
    {
        editorOpen = false;
        creatingNew = false;
        selectedItemId = null;
        if (url.State.PromptId is not null)
        {
            await url.CloseOverlayAsync(url.State with { PromptId = null });
        }

        await RefreshAfterEditorAsync();
    }

    private async Task RefreshAfterEditorAsync()
    {
        if (disposed || !editorDirty)
        {
            return;
        }

        // Persisted changes invalidate the catalog data in place; filters and paging are preserved.
        editorDirty = false;
        if (searchHost is not null)
        {
            await searchHost.RefreshAsync();
        }
    }

    public void Dispose()
    {
        if (disposed)
        {
            return;
        }

        disposed = true;
        lifetime.Cancel();
        lifetime.Dispose();
        Interlocked.Exchange(ref curatorContextLease, null)?.Dispose();
    }
}

@page "/prompt-gallery"
@implements IDisposable
@inject IPromptGalleryCuratorLauncher CuratorLauncher
@inject NotificationService Notifications

<PageTitle>Prompt Gallery</PageTitle>

<PageScaffold MaxWidthClass="max-w-full">
    <Header>
        <PageHeader Eyebrow="Shared prompt library"
                    Title="Prompt gallery"
                    Description="Browse, filter, version, and maintain the canonical prompts and prompt parts reused by workflows, agents, processes, roles, and chat."
                    Compact="true">
            <Stats>
                <CompactStat Label="search" Value="Paged" TooltipText="Search is delegated to the active Gallery search driver." Tone="info" />
                <CompactStat Label="versions" Value="Immutable" TooltipText="Final versions remain stable when a draft changes." Tone="success" />
                <CompactStat Label="projection" Value="Optional" TooltipText="A projection driver can replace standard database search without changing Gallery consumers." />
            </Stats>
            <Actions>
                @if (CuratorLauncher.IsAvailable)
                {
                    <AgentAvatarActionButton AgentName="@CuratorDisplayName"
                                             AvatarImageUrl="@curatorPresentation?.AvatarImageUrl"
                                             FallbackText="PC"
                                             Label="@($"Open {CuratorDisplayName}")"
                                             Click="OpenCuratorAsync"
                                             Disabled="@(isOpeningCurator || isLoadingCuratorPresentation)"
                                             TestId="prompt-gallery-prompts-curator-open"
                                             TooltipTestId="prompt-gallery-prompts-curator-tooltip" />
                }
                <PageHeaderActionButton Icon="add"
                                        Label="New item"
                                        TooltipText="Create a reusable prompt or prompt part."
                                        ButtonStyle="ButtonStyle.Primary"
                                        Click="CreateNewAsync" />
            </Actions>
        </PageHeader>
    </Header>

    <ChildContent>
        <PromptGallerySearchHost @ref="searchHost"
                                 PageSize="25"
                                 Compact="false"
                                 AllowEdit="true"
                                 ShowSelectAction="false"
                                 EditRequested="OpenEditorAsync" />
    </ChildContent>
</PageScaffold>

<Dialog IsOpen="@editorOpen"
        Eyebrow="Prompt gallery"
        Title="@EditorTitle"
        Subtitle="Edit canonical content and portable model recommendations."
        Size="ModalSize.Full"
        DenseChrome="true"
        CloseOnBackdrop="false"
        TestId="prompt-gallery-editor-dialog"
        OnClose="CloseEditorAsync">
    <ChildContent>
        @if (editorOpen)
        {
            <PromptGalleryItemEditorHost ItemId="@selectedItemId"
                                         Committed="HandleCommittedAsync"
                                         Cancelled="CloseEditorAsync" />
        }
    </ChildContent>
</Dialog>

@code {
    private PromptGallerySearchHost? searchHost;
    private Guid? selectedItemId;
    private Guid? observedPromptIdQuery;
    private bool promptIdObserved;
    private bool editorDirty;
    private bool editorOpen;
    private bool isOpeningCurator;
    private bool isLoadingCuratorPresentation;
    private bool curatorContextFailed;
    private PromptGalleryCuratorPresentation? curatorPresentation;
    private IPromptGalleryCuratorContextLease? curatorContextLease;

    [SupplyParameterFromQuery(Name = "promptId")]
    public Guid? PromptIdQuery { get; set; }

    private string EditorTitle => selectedItemId.HasValue ? "Edit Gallery item" : "New Gallery item";

    private string CuratorDisplayName => curatorPresentation?.Name ?? "Prompts Curator Agent";

    protected override void OnParametersSet()
    {
        SynchronizeCurator();

        // A changed promptId request opens the editor; the same value echoed by a rerender never reopens a closed one.
        if (promptIdObserved && observedPromptIdQuery == PromptIdQuery)
        {
            return;
        }

        promptIdObserved = true;
        observedPromptIdQuery = PromptIdQuery;
        if (PromptIdQuery.HasValue)
        {
            selectedItemId = PromptIdQuery;
            editorDirty = false;
            editorOpen = true;
        }
    }

    private void SynchronizeCurator()
    {
        if (!CuratorLauncher.IsAvailable || curatorContextFailed)
        {
            return;
        }

        try
        {
            curatorContextLease ??= CuratorLauncher.ActivateContext();
            curatorContextLease.SynchronizeNavigation();
        }
        catch (Exception exception)
        {
            // The Curator integration is optional; its failure never blocks the gallery itself.
            curatorContextFailed = true;
            Notifications.Error("Unable to prepare Prompts Curator", exception.Message);
            return;
        }

        _ = LoadCuratorPresentationAsync();
    }

    private Task CreateNewAsync()
    {
        selectedItemId = null;
        editorDirty = false;
        editorOpen = true;
        return Task.CompletedTask;
    }

    private Task OpenEditorAsync(Guid itemId)
    {
        selectedItemId = itemId;
        editorDirty = false;
        editorOpen = true;
        return Task.CompletedTask;
    }

    private async Task OpenCuratorAsync()
    {
        if (isOpeningCurator || isLoadingCuratorPresentation || !CuratorLauncher.IsAvailable)
        {
            return;
        }

        isOpeningCurator = true;
        try
        {
            await LoadCuratorPresentationAsync();
            if (curatorPresentation is null)
            {
                return;
            }

            await CuratorLauncher.OpenAsync();
            Notifications.Success("Chat ready", "Opened a new chat with Prompts Curator Agent.");
        }
        catch (Exception exception)
        {
            Notifications.Error("Unable to open Prompts Curator", exception.Message);
        }
        finally
        {
            isOpeningCurator = false;
        }
    }

    private async Task LoadCuratorPresentationAsync()
    {
        if (curatorPresentation is not null || isLoadingCuratorPresentation)
        {
            return;
        }

        isLoadingCuratorPresentation = true;
        try
        {
            curatorPresentation = await CuratorLauncher.GetPresentationAsync();
        }
        catch (Exception exception)
        {
            Notifications.Error("Unable to load Prompts Curator", exception.Message);
        }
        finally
        {
            isLoadingCuratorPresentation = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private Task HandleCommittedAsync(PromptGalleryEditorCommit commit)
    {
        // The editor reports the identity it owns; the page echoes it back as the requested target.
        selectedItemId = commit.ItemId;
        editorDirty = true;
        return Task.CompletedTask;
    }

    private async Task CloseEditorAsync()
    {
        editorOpen = false;
        selectedItemId = null;
        if (!editorDirty)
        {
            return;
        }

        // Persisted changes invalidate the catalog data in place; filters and paging are preserved.
        editorDirty = false;
        if (searchHost is not null)
        {
            await searchHost.RefreshAsync();
        }
    }

    public void Dispose()
    {
        curatorContextLease?.Dispose();
        curatorContextLease = null;
    }
}

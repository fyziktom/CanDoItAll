@implements IAsyncDisposable
@inject IPromptGalleryService Gallery
@inject PromptGalleryChanges Changes
@inject IPromptGalleryUiAccess Access
@inject Microsoft.Extensions.Logging.ILogger<PromptGalleryObservation> ObserverLog
@inject NotificationService Notifications

<PromptGallerySearchSurface Presentation="@session.Presentation"
                            Compact="@Compact"
                            AllowEdit="@AllowEdit"
                            ShowSelectAction="@ShowSelectAction"
                            SelectText="@SelectText"
                            Intent="HandleIntentAsync" />

@code {
    private PromptGallerySearchSession session = default!;
    private PromptGalleryObservation observation = default!;
    private PromptGallerySearchRequest? appliedRequest;

    [Parameter]
    public PromptGalleryConsumer? Consumer { get; set; }

    [Parameter]
    public string? Provider { get; set; }

    [Parameter]
    public string? Model { get; set; }

    [Parameter]
    public bool ShowActualChatModelFilter { get; set; }

    [Parameter]
    public bool Compact { get; set; }

    [Parameter]
    public int PageSize { get; set; } = 25;

    [Parameter]
    public bool AllowEdit { get; set; } = true;

    [Parameter]
    public bool ShowSelectAction { get; set; } = true;

    [Parameter]
    public string SelectText { get; set; } = "Select";

    // Filters and page the owner asks for; only a changed request is applied, never an echo of a commit.
    [Parameter]
    public PromptGallerySearchRequest? Request { get; set; }

    [Parameter]
    public EventCallback<PromptGallerySearchCommit> Committed { get; set; }

    [Parameter]
    public EventCallback<PromptGallerySearchItem> Selected { get; set; }

    [Parameter]
    public EventCallback<Guid> EditRequested { get; set; }

    public PromptGallerySearchPresentation Presentation => session.Presentation;

    protected override async Task OnInitializedAsync()
    {
        observation = new(Changes, Access, ObserverLog);
        session = new PromptGallerySearchSession(Gallery)
        {
            Changed = () => InvokeAsync(StateHasChanged),
            Authorize = observation.AuthorizeAsync,
            NoticeRaised = notice =>
            {
                PromptGalleryNotices.Show(Notifications, notice);
                return Task.CompletedTask;
            },
            Committed = HandleCommittedAsync
        };
        try {
            await observation.StartAsync(null, batch => InvokeAsync(() => session.InvalidateAsync()),
                () => InvokeAsync(() => session.RetireAccessAsync()), catalog: true);
        } catch (Exception exception) when (exception is UnauthorizedAccessException or InvalidOperationException) {
            await session.RetireAccessAsync();
        }
    }

    protected override Task OnParametersSetAsync()
    {
        var context = new PromptGallerySearchContext(
            Consumer,
            Provider,
            Model,
            ShowActualChatModelFilter,
            Compact,
            PageSize);
        var request = Request;
        if (request is null || appliedRequest is not null && appliedRequest.SameAs(request))
        {
            return session.ConfigureAsync(context);
        }

        appliedRequest = request;
        return session.ConfigureAsync(context, request);
    }

    // Reloads the current page and clamps to the last page when the list shrank; filters and paging survive.
    public Task RefreshAsync() => session.InvalidateAsync();

    private Task HandleCommittedAsync(PromptGallerySearchCommit commit)
    {
        appliedRequest = new PromptGallerySearchRequest(commit.Filters, commit.PageIndex);
        return Committed.InvokeAsync(commit);
    }

    private async Task HandleIntentAsync(PromptGallerySearchIntent intent) {
        using var admission = Changes.EnterUiWrite(token => observation.AuthorizeAsync(write: true, token));
        await (intent switch {
        PromptGallerySearchIntent.Select select => Selected.InvokeAsync(select.Item),
        PromptGallerySearchIntent.Edit edit => EditRequested.InvokeAsync(edit.ItemId),
        _ => session.ApplyAsync(intent)
        });
    }

    public async ValueTask DisposeAsync() {
        await session.DisposeAsync();
        await observation.DisposeAsync();
    }
}

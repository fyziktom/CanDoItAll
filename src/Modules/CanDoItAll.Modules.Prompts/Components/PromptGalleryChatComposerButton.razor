@implements IDisposable
@inject IPromptGalleryService PromptGallery
@inject DialogService DialogService
@inject NotificationService Notifications

<PromptGalleryPickerButton Text=""
                           Icon="library_books"
                           IconOnly="true"
                           AriaLabel="Insert from prompt gallery"
                           Size="ButtonSize.Small"
                           Consumer="PromptGalleryConsumer.Chat"
                           Provider="@Provider"
                           Model="@Model"
                           TargetKey="@TargetKey"
                           ShowActualChatModelFilter="true"
                           Disabled="@Disabled"
                           AllowEdit="@AllowEdit"
                           Selected="HandleSelectionAsync" />

@code {
    private readonly CancellationTokenSource lifetime = new();
    private CancellationTokenSource? interaction;
    private ComposerContext observedContext;
    private long contextGeneration;
    private bool observed;
    private bool disposed;

    [Parameter]
    public string? Provider { get; set; }

    [Parameter]
    public string? Model { get; set; }

    // Identity of the conversation or composer the content is inserted into; provider/model equality alone is not
    // target equality, so owners pass their own key when they reuse this instance across targets.
    [Parameter]
    public object? TargetKey { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool AllowEdit { get; set; } = true;

    [Parameter, EditorRequired]
    public EventCallback<string> ContentSelected { get; set; }

    protected override void OnParametersSet()
    {
        var next = new ComposerContext(Provider, Model, TargetKey);
        if (observed && next.Equals(observedContext))
        {
            return;
        }

        // A changed chat target invalidates the whole interaction still running against the previous context; the
        // picker itself is cancelled by the nested button, this cancels the compatibility step and its dialog.
        observed = true;
        observedContext = next;
        contextGeneration++;
        interaction?.Cancel();
    }

    private async Task HandleSelectionAsync(PromptGallerySelection selection)
    {
        if (disposed || interaction is not null)
        {
            return;
        }

        // The picker only reports a selection while its own context is current, so this generation is the one the
        // picker was opened under.
        var generation = contextGeneration;
        var provider = Provider;
        var model = Model;
        using var current = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
        interaction = current;
        try
        {
            var compatibilityResult = await PromptGallery.EvaluateCompatibilityAsync(
                selection.ArtifactId,
                new PromptGalleryConsumerContext(
                    PromptGalleryConsumer.Chat,
                    PromptGalleryCompatibilityPurpose.Selection,
                    Provider: provider,
                    Model: model),
                current.Token);
            if (!IsCurrent(generation))
            {
                return;
            }

            if (compatibilityResult.IsFailure || compatibilityResult.Value is null)
            {
                Notifications.Warning(
                    "Prompt compatibility unavailable",
                    PromptGalleryNotices.DescribeErrors(compatibilityResult.Errors, "The Prompt Gallery did not return a result."));
                return;
            }

            var compatibility = compatibilityResult.Value;
            var decision = PromptCompatibilityWarningDecision.InsertAnyway;
            if (!compatibility.CanUse || compatibility.HasVisibleWarnings)
            {
                var decided = await AskAsync(
                    new PromptCompatibilityWarningPresentation(
                        selection.Title,
                        selection.Summary,
                        selection.Kind,
                        selection.VersionNumber,
                        compatibility),
                    current.Token);
                if (!IsCurrent(generation))
                {
                    return;
                }

                if (decided is not { } selectedDecision || selectedDecision == PromptCompatibilityWarningDecision.Cancel)
                {
                    return;
                }

                if (!compatibility.CanUse)
                {
                    // A blocking error is enforced by this host, whatever decision a dialog or callback path supplied.
                    Notifications.Warning(
                        "Prompt is not compatible",
                        string.Join(" ", compatibility.Issues
                            .Where(issue => issue.Severity == PromptCompatibilitySeverity.Error)
                            .Select(issue => issue.Message)));
                    return;
                }

                decision = selectedDecision;
            }

            if (decision == PromptCompatibilityWarningDecision.InsertAndSuppress)
            {
                foreach (var issue in compatibility.Issues.Where(issue => !issue.IsSuppressed && issue.IsSuppressible))
                {
                    if (!await TryPersistSuppressionAsync(selection.ArtifactId, issue.Code, generation, current.Token))
                    {
                        return;
                    }
                }
            }

            var content = selection.Content.Trim();
            if (content.Length == 0)
            {
                Notifications.Warning("Prompt is empty", "The selected Gallery item has no content to insert.");
                return;
            }

            if (!IsCurrent(generation))
            {
                return;
            }

            await ContentSelected.InvokeAsync(content);
        }
        catch (OperationCanceledException) when (current.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            if (IsCurrent(generation))
            {
                Notifications.Error("Prompt could not be inserted", exception.Message);
            }
        }
        finally
        {
            if (ReferenceEquals(interaction, current))
            {
                interaction = null;
            }
        }
    }

    // An optional preference write never decides the consented insertion: a rejected or thrown write is reported as a
    // preference problem and is not replayed. Only a cancelled interaction stops the chain.
    private async Task<bool> TryPersistSuppressionAsync(Guid artifactId, PromptCompatibilityIssueCode issueCode, long generation, CancellationToken token)
    {
        try
        {
            var suppression = await PromptGallery.SetWarningSuppressionAsync(
                artifactId,
                PromptGalleryConsumer.Chat,
                issueCode,
                suppressed: true,
                token);
            if (!IsCurrent(generation))
            {
                return false;
            }

            if (suppression.IsFailure)
            {
                Notifications.Warning(
                    "Warning preference was not saved",
                    PromptGalleryNotices.DescribeErrors(suppression.Errors, "The Prompt Gallery did not return a result."));
            }

            return true;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            return false;
        }
        catch (Exception exception)
        {
            if (!IsCurrent(generation))
            {
                return false;
            }

            Notifications.Warning("Warning preference was not saved", exception.Message);
            return true;
        }
    }

    private async Task<PromptCompatibilityWarningDecision?> AskAsync(PromptCompatibilityWarningPresentation presentation, CancellationToken token)
    {
        // The warning surface is rendered inline; the decision closes exactly this dialog reference, and the interaction
        // token closes it when the target changes or the owner is disposed.
        var result = await DialogService.OpenAsync(
            "Prompt compatibility",
            dialog => builder =>
            {
                builder.OpenComponent<PromptCompatibilityWarningSurface>(0);
                builder.AddAttribute(1, nameof(PromptCompatibilityWarningSurface.Presentation), presentation);
                builder.AddAttribute(
                    2,
                    nameof(PromptCompatibilityWarningSurface.Decision),
                    EventCallback.Factory.Create<PromptCompatibilityWarningDecision>(
                        this,
                        (PromptCompatibilityWarningDecision decision) => dialog.CloseAsync(decision)));
                builder.CloseComponent();
            },
            new DialogOptions
            {
                Eyebrow = "Provider and model check",
                Subtitle = "Review declared compatibility before inserting this prompt.",
                Size = ModalSize.Medium,
                DenseChrome = true,
                TestId = "prompt-gallery-chat-compatibility-dialog",
                AriaLabel = "Prompt compatibility warning"
            },
            token);
        return result as PromptCompatibilityWarningDecision?;
    }

    private bool IsCurrent(long generation)
        => !disposed && generation == contextGeneration;

    public void Dispose()
    {
        if (disposed)
        {
            return;
        }

        disposed = true;
        interaction?.Cancel();
        lifetime.Cancel();
        lifetime.Dispose();
    }

    private readonly record struct ComposerContext(string? Provider, string? Model, object? TargetKey);
}

@page "/settings"
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Modules.Security
@using CanDoItAll.Modules.Workspace.ApiAccess
@using CanDoItAll.Modules.Workspace.Pages.Components
@using Microsoft.AspNetCore.Components
@inject WorkspaceService WorkspaceService
@inject IWorkspaceProviderCatalog ProviderCatalog
@inject SecretService SecretService
@inject NavigationManager Navigation

<PageTitle>Settings</PageTitle>

<PageScaffold MaxWidthClass="max-w-full">
    <Header>
        <PageHeader Eyebrow="Settings"
                    Title="Workspace defaults and data sources"
                    Description="Manage workspace defaults, runtime data sources, encrypted secrets, and API access. Provider profiles are managed from Agents."
                    Compact="true">
            <Stats>
                <CompactStat Label="providers" Value="@providers.Count.ToString()" TooltipText="Configured provider profiles." />
                <CompactStat Label="enabled" Value="@providers.Count(item => item.IsEnabled).ToString()" TooltipText="Profiles currently enabled." Tone="success" />
                <CompactStat Label="secrets" Value="@secrets.Count.ToString()" TooltipText="Stored encrypted secrets." />
            </Stats>
        </PageHeader>
    </Header>

    <Lead>
        <SecondaryTabs Items="SettingsTabs" SelectedKey="@settingsTab" SelectedKeyChanged="HandleSettingsTabChanged" />
    </Lead>

    <ChildContent>
        @if (string.Equals(settingsTab, "workspace", StringComparison.Ordinal))
        {
            <EditForm Model="settingsModel" OnValidSubmit="SaveSettingsAsync">
                <Stack Class="min-h-full" GapScale="LayoutGap.XXLarge">
                    <FormSection Title="Workspace defaults"
                                 Icon="settings"
                                 Description="These values define how the rest of the app boots and which provider profile new prompt sessions prefer.">
                        <div>
                            <label class="cda-field-label">Workspace name</label>
                            <InputText @bind-Value="settingsModel.WorkspaceName" class="cda-input" />
                        </div>
                        <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                            <div>
                                <label class="cda-field-label">Default output format</label>
                                <InputText @bind-Value="settingsModel.DefaultPromptOutputFormat" class="cda-input" />
                            </div>
                            <div>
                                <label class="cda-field-label">Default provider</label>
                                <InputSelect @bind-Value="settingsModel.DefaultProviderProfileId" class="cda-input">
                                    <option value="">None</option>
                                    @foreach (var provider in providers)
                                    {
                                        <option value="@provider.Id">@provider.Name</option>
                                    }
                                </InputSelect>
                            </div>
                        </Grid>
                        <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                            <div>
                                <label class="cda-field-label">Currency code</label>
                                <InputText @bind-Value="settingsModel.CurrencyCode" class="cda-input" maxlength="3" />
                            </div>
                            <div>
                                <label class="cda-field-label">Currency culture</label>
                                <InputText @bind-Value="settingsModel.CurrencyCultureName" class="cda-input" />
                            </div>
                        </Grid>
                    </FormSection>

                    <FormSection Title="Workspace notes"
                                 Icon="note"
                                 Description="Keep any operating notes or setup caveats close to the defaults.">
                        <div>
                            <label class="cda-field-label">Notes</label>
                            <InputTextArea @bind-Value="settingsModel.Notes" class="cda-input cda-input--textarea min-h-32" />
                        </div>
                    </FormSection>

                    <StickyActionFooter StatusLabel="Workspace defaults">
                        <PrimaryActions>
                            <Button Text="Save defaults" Icon="save" Type="submit" />
                        </PrimaryActions>
                    </StickyActionFooter>
                </Stack>
            </EditForm>
        }
        else if (string.Equals(settingsTab, "data-sources", StringComparison.Ordinal))
        {
            <DatabaseSourcesSettingsPanel />
        }
        else if (string.Equals(settingsTab, "storage", StringComparison.Ordinal))
        {
            <StorageSettingsPanel />
        }
        else if (string.Equals(settingsTab, FilesSettingsTabKey, StringComparison.Ordinal))
        {
            <FileApplicationSettingsPanel />
        }
        else if (string.Equals(settingsTab, "secrets", StringComparison.Ordinal))
        {
            <ListDetailShell ListPaneWidth="24rem">
                <ListHeader>
                    <ListPanelHeader Title="Secret vault" Description="Encrypted secrets are stored once and referenced from other modules." Count="@($"{FilteredSecrets.Count} secret(s)")">
                        <Actions>
                            <Button Text="New secret" Icon="add" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="ResetSecretAsync" />
                        </Actions>
                        <Filters>
                            <FilterBar ResultText="@($"{FilteredSecrets.Count} matching secret(s)")">
                                <input @bind="secretSearch" @bind:event="oninput" class="cda-input min-w-[14rem] flex-1" placeholder="Search secrets" />
                                <Button Text="Reset" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="ResetSecretSearch" />
                            </FilterBar>
                        </Filters>
                    </ListPanelHeader>
                </ListHeader>

                <ListContent>
                    @if (FilteredSecrets.Count == 0)
                    {
                        <EmptyState Eyebrow="No secrets" Title="Add the first secret" Description="Secrets appear here after they are saved through the vault editor." />
                    }
                    else
                    {
                        <Stack GapScale="LayoutGap.Medium">
                            @foreach (var secret in FilteredSecrets)
                            {
                                <SelectionListItem Title="@secret.Name"
                                                   Eyebrow="@secret.Kind.ToString()"
                                                   Meta="@secret.Scope"
                                                   Summary="@FormatTimestamp(secret.UpdatedAtUtc)"
                                                   IsSelected="@(secretModel.Id == secret.Id)"
                                                   OnSelect="@(() => EditSecretAsync(secret.Id))">
                                    <Status>
                                        <StatusBadge Tone="info" Text="@secret.Kind.ToString()" />
                                    </Status>
                                    <Actions>
                                        <CopyButton Value="@secret.Name"
                                                    AriaLabel="Copy secret name"
                                                    DisplayMode="CopyButtonDisplayMode.IconOnly"
                                                    Size="CopyButtonSize.ExtraSmall" />
                                        <CopyButton Value='@secret.Id.ToString("D")'
                                                    Text="Copy ID"
                                                    CopiedText="ID copied"
                                                    AriaLabel="Copy secret ID"
                                                    DisplayMode="CopyButtonDisplayMode.TextWithIcon"
                                                    Size="CopyButtonSize.ExtraSmall"
                                                    data-testid="@($"settings-secret-copy-id-{secret.Id:N}")" />
                                    </Actions>
                                </SelectionListItem>
                            }
                        </Stack>
                    }
                </ListContent>

                <DetailHeader>
                    <Stack GapScale="LayoutGap.Tiny">
                        <p class="cda-eyebrow">Secret editor</p>
                        <h2 class="cda-title-xl">@(secretModel.Id.HasValue ? secretModel.Name : "New secret")</h2>
                        <p class="cda-body-muted">Secrets stay encrypted at rest and can be referenced from providers, resources, or other modules.</p>
                    </Stack>
                </DetailHeader>

                <DetailContent>
                    <EditForm Model="secretModel" OnValidSubmit="SaveSecretAsync">
                        <Stack Class="min-h-full" GapScale="LayoutGap.XXLarge">
                            <FormSection Title="Secret metadata"
                                         Icon="shield"
                                         Description="Name the secret clearly and capture its usage scope.">
                                <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                    <div>
                                        <label class="cda-field-label">Name</label>
                                        <InputText @bind-Value="secretModel.Name" class="cda-input" />
                                    </div>
                                    <div>
                                        <label class="cda-field-label">Kind</label>
                                        <InputSelect @bind-Value="secretModel.Kind" class="cda-input">
                                            @foreach (var kind in Enum.GetValues<SecretKind>())
                                            {
                                                <option value="@kind">@kind</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </Grid>
                                <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                    <div>
                                        <label class="cda-field-label">Scope</label>
                                        <InputText @bind-Value="secretModel.Scope" class="cda-input" />
                                    </div>
                                    <div>
                                        <label class="cda-field-label">Rotation note</label>
                                        <InputText @bind-Value="secretModel.RotationNote" class="cda-input" />
                                    </div>
                                </Grid>
                            </FormSection>

                            <FormSection Title="Encrypted payload"
                                         Icon="lock"
                                         Description="The raw value is only edited here, while other areas consume references to the saved record.">
                                <div>
                                    <label class="cda-field-label">Secret value</label>
                                    <SecretField @bind-Value="secretModel.SecretValue"
                                                 SecretName="@secretModel.Name"
                                                 ShowNameCopy="true"
                                                 ShowValueCopy="true"
                                                 RevealDurationSeconds="30"
                                                 Placeholder="Enter or update secret value"
                                                 data-testid="settings-secret-value" />
                                </div>
                                <div>
                                    <label class="cda-field-label">Metadata JSON</label>
                                    <InputTextArea @bind-Value="secretModel.MetadataJson" class="cda-input cda-input--textarea" />
                                </div>
                            </FormSection>

                            <StickyActionFooter StatusLabel="Secret vault">
                                <SecondaryActions>
                                    <Button Text="Clear" Icon="restart_alt" ButtonStyle="ButtonStyle.Light" Click="ResetSecretAsync" />
                                </SecondaryActions>
                                <PrimaryActions>
                                    <Button Text="Save secret" Icon="save" Type="submit" />
                                </PrimaryActions>
                                <DangerActions>
                                    @if (secretModel.Id.HasValue)
                                    {
                                        <Button Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger" Click="DeleteSecretAsync" />
                                    }
                                </DangerActions>
                            </StickyActionFooter>
                        </Stack>
                    </EditForm>
                </DetailContent>
            </ListDetailShell>
        }
        else if (string.Equals(settingsTab, "api-access", StringComparison.Ordinal))
        {
            <Stack Class="min-h-full" GapScale="LayoutGap.XXLarge">
                <FormSection Title="API access"
                             Icon="console"
                             Description="Control the local API surface and create JWT bearer tokens when authorization is active.">
                    <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                        <Stack GapScale="LayoutGap.Small">
                            <p class="cda-eyebrow">API</p>
                            <StatusBadge Tone="@(apiStatus?.ApiEnabled == true ? "success" : "warning")" Text="@(apiStatus?.ApiEnabled == true ? "Enabled" : "Disabled")" />
                            <p class="cda-body-muted break-all">OpenAPI: @(apiStatus?.OpenApiEnabled == true ? "/openapi/v1.json and /swagger/v1/swagger.json" : "Disabled")</p>
                        </Stack>
                        <Stack GapScale="LayoutGap.Small">
                            <p class="cda-eyebrow">Authorization</p>
                            <StatusBadge Tone="@(apiStatus?.AuthorizationEnabled == true ? "warning" : "info")" Text="@(apiStatus?.AuthorizationEnabled == true ? "JWT required" : "JWT disabled")" />
                            <p class="cda-body-muted break-all">@FormatApiAudience()</p>
                        </Stack>
                    </Grid>

                    @if (apiStatus?.AuthorizationEnabled != true)
                    {
                        <Alert AlertStyle="AlertStyle.Info">
                            <p>JWT authorization is disabled in configuration. API requests do not need bearer tokens until Api:Authorization:Enabled is set to true.</p>
                        </Alert>
                    }
                    else if (apiStatus.SigningKeyConfigured)
                    {
                        <EditForm Model="apiTokenModel" OnValidSubmit="IssueApiTokenAsync">
                            <Stack GapScale="LayoutGap.Large">
                                <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                    <div>
                                        <label class="cda-field-label">Subject</label>
                                        <InputText @bind-Value="apiTokenModel.Subject" class="cda-input" />
                                    </div>
                                    <div>
                                        <label class="cda-field-label">Display name</label>
                                        <InputText @bind-Value="apiTokenModel.DisplayName" class="cda-input" />
                                    </div>
                                </Grid>
                                <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                    <div>
                                        <label class="cda-field-label">Lifetime minutes</label>
                                        <InputNumber @bind-Value="apiTokenModel.LifetimeMinutes" class="cda-input" />
                                        <p class="cda-body-muted mt-1">Maximum: @apiStatus.MaxTokenLifetimeMinutes minutes</p>
                                    </div>
                                    <div>
                                        <label class="cda-field-label">Scopes</label>
                                        <InputText @bind-Value="apiScopesText" class="cda-input" />
                                        <p class="cda-body-muted mt-1">Separate scopes with spaces or commas.</p>
                                    </div>
                                </Grid>
                                <Button Text="Create token" Icon="key" Type="submit" />
                            </Stack>
                        </EditForm>

                        @if (issuedApiToken is not null)
                        {
                            <Alert AlertStyle="AlertStyle.Success">
                                <p class="font-semibold">Token created for @issuedApiToken.DisplayName.</p>
                                <p class="mt-1">Expires: @FormatTimestamp(issuedApiToken.ExpiresAtUtc)</p>
                                <textarea readonly class="cda-input cda-input--textarea mt-3 min-h-32">@issuedApiToken.Token</textarea>
                            </Alert>
                        }
                    }
                    else
                    {
                        <Alert AlertStyle="AlertStyle.Warning">
                            <p>JWT authorization is enabled, but no signing key is configured. Set Api:Authorization:SigningKey to at least 32 UTF-8 bytes before creating tokens.</p>
                        </Alert>
                    }
                </FormSection>
            </Stack>
        }
    </ChildContent>
</PageScaffold>

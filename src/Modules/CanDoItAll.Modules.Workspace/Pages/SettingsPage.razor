@page "/settings"
@using CanDoItAll.Workspace.UI
@using CanDoItAll.Modules.Workspace.Pages.Components
@implements IDisposable
<PageTitle>Settings</PageTitle>
@if (profileRetired) {
    <Alert AlertStyle="AlertStyle.Warning">The database or caller changed. Reopen Settings to acquire a new defaults and Secrets lifetime. Local file preferences are unchanged.</Alert>
}
<WorkspaceSettingsSurface Section="section" SectionChanged="SelectSectionAsync" Defaults="defaults" Secrets="secrets" Files="files" ApiStatusLabel="@apiStatusLabel">
    <History><ProviderHistoryPolicyPanel /></History>
    <DeferredSection Context="activeSection">
        @switch (activeSection) {
            case WorkspaceSection.DataSources:
                <DatabaseSourcesSettingsPanel />
                break;
            case WorkspaceSection.Storage:
                <StorageSettingsPanel />
                break;
            case WorkspaceSection.ApiAccess:
                <WorkspaceApiAccessHost StatusChanged="ApiStatusChanged" />
                break;
        }
    </DeferredSection>
</WorkspaceSettingsSurface>

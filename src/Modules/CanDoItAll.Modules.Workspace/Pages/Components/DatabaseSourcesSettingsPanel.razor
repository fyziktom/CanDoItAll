@using CanDoItAll.Workspace.DataSources.UI
@using CanDoItAll.Modules.Workspace.DataSources.Contracts
@using CanDoItAll.Infrastructure.ControlPlane
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject DatabaseProfileWorkspaceService Profiles
@inject ICanonicalRuntimeDatabase Canonical
@inject DataSourceOperationLedger Operations
@inject ILogger<WorkspaceDataSourcesOwner> Logger
@inject NotificationService Notifications

@if (session is not null) {
    <DataSourcesPanel Session="session" />
}

@code {
    private DataSourcesSession? session;
    private readonly HashSet<Guid> notified = [];
    protected override async Task OnInitializedAsync() {
        notified.UnionWith(Operations.Receipts.Where(item => item.Result is not null).Select(item => item.OperationId));
        Operations.Changed += NotifyCompleted;
        session = new(new WorkspaceDataSourcesOwner(Profiles, Canonical, Logger), Operations);
        await session.InitializeAsync();
    }
    private void NotifyCompleted() {
        foreach (var receipt in Operations.Receipts.Where(item => item.Result is not null)) {
            if (!notified.Add(receipt.OperationId)) {
                continue;
            }
            if (receipt.Result!.Outcome == DataSourceOutcome.Confirmed) {
                Notifications.Success("Data source updated", receipt.Result.Message);
            } else {
                Notifications.Warning("Data source needs attention", receipt.Result.Message);
            }
        }
    }
    public void Dispose() {
        Operations.Changed -= NotifyCompleted;
        session?.Dispose();
    }
}

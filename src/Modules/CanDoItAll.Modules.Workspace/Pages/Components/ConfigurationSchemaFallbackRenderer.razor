@using CanDoItAll.Modules.Security
@using CanDoItAll.Configuration.UI
@using CanDoItAll.SharedKernel.Configuration

<ConfigurationSchemaRenderer Schema="Schema" State="State" Secrets="secretOptions"
                             Validation="Validation" StateChanged="StateChanged" TestIdPrefix="@TestIdPrefix" />

@code {
    [Parameter, EditorRequired] public ConfigurationSchema Schema { get; set; } = default!;
    [Parameter, EditorRequired] public ConfigurationState State { get; set; } = default!;
    [Parameter] public IReadOnlyList<SecretListItem> Secrets { get; set; } = [];
    [Parameter] public ConfigurationValidationResult? Validation { get; set; }
    [Parameter] public EventCallback<ConfigurationState> StateChanged { get; set; }
    [Parameter] public string TestIdPrefix { get; set; } = "configuration-field";
    private IReadOnlyList<ConfigurationSecretOption> secretOptions = [];

    protected override void OnParametersSet() {
        var projected = Secrets.Select(secret => new ConfigurationSecretOption(secret.Id, secret.Name));
        if (!secretOptions.SequenceEqual(projected)) {
            secretOptions = projected.ToArray();
        }
    }
}

@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Modules.Workspace.ApiAccess
@using Microsoft.Extensions.Logging
@inject IApiTokenService ApiTokens
@inject ILogger<WorkspaceApiAccessHost> Logger
@if (status is null) {
    <Alert AlertStyle="AlertStyle.Warning">API status is unavailable. Authorization has not been determined.</Alert>
} else {
    <Stack Class="min-h-full" GapScale="LayoutGap.XXLarge">
        <FormSection Title="API access"
                     Icon="console"
                     Description="Control the local API surface and create JWT bearer tokens when authorization is active.">
            <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                <Stack GapScale="LayoutGap.Small">
                    <p class="cda-eyebrow">API</p>
                    <StatusBadge Tone="@(status.ApiEnabled == true ? "success" : "warning")" Text="@(status.ApiEnabled == true ? "Enabled" : "Disabled")" />
                    <p class="cda-body-muted break-all">OpenAPI: @(status.OpenApiEnabled == true ? "/openapi/v1.json and /swagger/v1/swagger.json" : "Disabled")</p>
                </Stack>
                <Stack GapScale="LayoutGap.Small">
                    <p class="cda-eyebrow">Authorization</p>
                    <StatusBadge Tone="@(status.AuthorizationEnabled == true ? "warning" : "info")" Text="@(status.AuthorizationEnabled == true ? "JWT required" : "JWT disabled")" />
                    <p class="cda-body-muted break-all">@FormatApiAudience()</p>
                </Stack>
            </Grid>

            @if (status.AuthorizationEnabled != true) {
                <Alert AlertStyle="AlertStyle.Info">
                    <p>API authorization is disabled. User permissions do not isolate anonymously accessible business operations.</p>
                </Alert>
            } else if (status.SigningKeyConfigured) {
                <ApiTokenAdministrationPanel Status="status" />
                <Alert AlertStyle="AlertStyle.Info" data-testid="api-effective-configuration">
                    User login: @(status.UserAuthenticationEnabled ? "enabled" : "disabled") (Api:UserAuthentication:Enabled).
                    @if (!status.AccessManagementEnabled) {
                        <p>HTTP access administration is disabled. Trusted local administration is still available.</p>
                    } else {
                        <p>HTTP access administration is enabled and requires a configured administrator session.</p>
                    }
                    <p>Api:AccessManagement:Enabled and other deployment options require configuration and restart. User sessions expire after @status.UserTokenLifetimeMinutes minutes.</p>
                </Alert>
                <FormSection Title="API users" Icon="group" Description="Manage instance-local accounts and explicit business capabilities.">
                    <ApiUserAdministrationPanel />
                </FormSection>
            } else {
                <Alert AlertStyle="AlertStyle.Warning">
                    <p>JWT authorization is enabled, but no signing key is configured. Set Api:Authorization:SigningKey to at least 32 UTF-8 bytes before creating tokens.</p>
                </Alert>
            }
        </FormSection>
    </Stack>
}
@code {
    [Parameter] public EventCallback<ApiAccessStatus?> StatusChanged { get; set; }
    private ApiAccessStatus? status;
    protected override async Task OnInitializedAsync() {
        try {
            status = ApiTokens.GetStatus();
        } catch (Exception exception) {
            Logger.LogWarning("API access status could not be read while activating Settings ({FailureType}); authorization remains unavailable.", exception.GetType().Name);
        }
        await StatusChanged.InvokeAsync(status);
    }
    private string FormatApiAudience() => status?.AuthorizationEnabled == true
        ? $"Issuer: {status.Issuer} / Audience: {status.Audience}"
        : "Bearer tokens are not required.";
}

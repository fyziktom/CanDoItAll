@using CanDoItAll.Infrastructure.Storage
@using CanDoItAll.Workspace.StorageRecovery.UI
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject IStoragePlacementRecovery Recovery
@inject IStoragePlacementOwnerContinuation OwnerContinuation
@inject ILogger<WorkspaceStorageRecoveryOwner> Logger

@if (session is not null) {
    <RecoveryDialog @key="session" Session="session" OnClose="OnClose" />
}

@code {
    [Parameter] public Guid? StorageId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [CascadingParameter] public Task<AuthenticationState>? AuthenticationState { get; set; }
    private RecoverySession? session;
    private Task<AuthenticationState>? caller;

    protected override async Task OnParametersSetAsync() {
        if (session is not null && session.StorageId == StorageId && ReferenceEquals(caller, AuthenticationState)) {
            return;
        }
        session?.Dispose();
        caller = AuthenticationState;
        var current = new RecoverySession(new WorkspaceStorageRecoveryOwner(Recovery, OwnerContinuation, Logger), StorageId);
        session = current;
        await current.RefreshAsync();
    }

    public void Dispose() => session?.Dispose();
}

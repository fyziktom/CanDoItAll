@using CanDoItAll.Modules.Security

<ListDetailShell ListPaneWidth="25rem">
    <ListHeader>
        <ListPanelHeader Title="Provider profiles" Description="Workspace and Security remain the master-data owners, while AgentFramework executes diagnostics and prompts through the same provider catalog." Count="@($"{FilteredProviders.Count} profile(s)")">
            <Actions>
                <Button Text="New provider" Tone="ButtonTone.Default" Size="ButtonSize.Small" Click="ResetProviderAsync" />
            </Actions>
            <Filters>
                <FilterBar ResultText="@($"{FilteredProviders.Count} matching profile(s)")">
                    <TextInput @bind-Value="providerSearch" Immediate="true" Class="min-w-[14rem] flex-1" placeholder="Search providers" />
                    <Button Text="Reset" Tone="ButtonTone.Default" Size="ButtonSize.Small" Click="ResetProviderSearch" />
                </FilterBar>
            </Filters>
        </ListPanelHeader>
    </ListHeader>

    <ListContent>
        @if (FilteredProviders.Count == 0)
        {
            <EmptyState Eyebrow="No providers" Title="Add the first provider profile" Description="Provider profiles appear here after they are saved." />
        }
        else
        {
            <Stack GapScale="LayoutGap.Medium">
                @foreach (var provider in FilteredProviders)
                {
                    <SelectionListItem Title="@provider.Name"
                                       Eyebrow="@provider.ConnectorDisplayName"
                                       Meta="@provider.DefaultModel"
                                       Summary="@provider.BaseUrl"
                                       IsSelected="@(providerModel.Id == provider.Id)"
                                       OnSelect="@(() => EditProviderAsync(provider.Id))">
                        <Status>
                            <StatusBadge Tone="@(provider.IsEnabled ? "success" : "warning")" Text="@(provider.IsEnabled ? "Enabled" : "Disabled")" />
                        </Status>
                    </SelectionListItem>
                }
            </Stack>
        }
    </ListContent>

    <DetailHeader>
        <Stack GapScale="LayoutGap.Tiny">
            <TextBlock TextStyle="TextStyle.EyebrowCaption" Value="Provider editor" />
            <h2 class="app-title-xl">@(providerModel.Id.HasValue ? providerModel.Name : "New provider profile")</h2>
        </Stack>
    </DetailHeader>

    <DetailContent>
        <EditForm Model="providerModel" OnValidSubmit="SaveProviderAsync">
            <Stack Class="min-h-full" GapScale="LayoutGap.XXLarge">
                <Tabs @bind-SelectedIndex="providerEditorTabIndex"
                      RenderMode="TabRenderMode.Server"
                      OverflowMode="TabsOverflowMode.Wrap"
                      AriaLabel="Provider editor tabs"
                      data-testid="provider-editor-tabs">
                    <TabsItem Text="Connection" Icon="plug" data-testid="provider-editor-tab-connection">
                        <FormSection Title="Connector identity" Description="Choose the connector plugin first, then fill only the schema fields that plugin exposes.">
                            <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                <div>
                                    <FormField Text="Profile name">
                                    <TextInput @bind-Value="providerModel.Name" data-testid="provider-name-input" />
                                    </FormField>
                                </div>
                                <div>
                                    <FormField Text="Connector plugin">
                                    <SelectInput @bind-Value="providerModel.ConnectorPluginKey" @bind-Value:after="HandleProviderPluginChangedAsync" data-testid="provider-plugin-select">
                                        @foreach (var manifest in providerManifests)
                                        {
                                            <option value="@manifest.PluginKey">@manifest.DisplayName</option>
                                        }
                                    </SelectInput>
                                    </FormField>
                                </div>
                            </Grid>

                            @if (SelectedProviderManifest is not null)
                            {
                                <Alert AlertStyle="AlertStyle.Info">
                                    <p class="font-semibold">@SelectedProviderManifest.DisplayName</p>
                                    <p class="mt-1 break-all">Plugin key: @SelectedProviderManifest.PluginKey</p>
                                    <p class="mt-1">@SelectedProviderManifest.HealthCheck.Summary</p>
                                </Alert>
                            }
                            else
                            {
                                <Alert AlertStyle="AlertStyle.Warning">
                                    <p class="font-semibold">Unknown provider plugin</p>
                                    <p class="mt-1 break-all">Plugin key: @providerModel.ConnectorPluginKey</p>
                                </Alert>
                            }

                            <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                @foreach (var field in SelectedProviderFields)
                                {
                                    <ConnectorConfigFieldEditor Field="field"
                                                                State="providerModel.Configuration"
                                                                Secrets="secrets"
                                                                InputClass="ui-input"
                                                                TestId="@ResolveProviderFieldTestId(field)" />
                                }
                            </Grid>
                        </FormSection>
                    </TabsItem>
                    <TabsItem Text="Prices" Icon="paid" data-testid="provider-editor-tab-prices">
                        @if (TryResolveProviderPricingKind(out var pricingKind))
                        {
                            <ProviderModelPricingEditor Model="providerModel"
                                                        PricingKind="@pricingKind"
                                                        DefaultModel="@ResolveProviderDefaultModel()"
                                                        OnRefreshPrices="RefreshProviderModelPricesAsync" />
                        }
                        else
                        {
                            <Alert AlertStyle="AlertStyle.Warning">
                                <p>Pricing controls are unavailable until this provider uses a registered connector plugin.</p>
                            </Alert>
                        }
                    </TabsItem>
                    <TabsItem Text="Access" Icon="shield" data-testid="provider-editor-tab-access">
                        <FormSection Title="Auth and capabilities" Description="Attach the secret reference and advertise what the profile supports.">
                            <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                <div>
                                    <FormField Text="API key secret">
                                    <SelectInput @bind-Value="providerModel.ApiKeySecretId" data-testid="provider-secret-select">
                                        <option value="">None</option>
                                        @foreach (var secret in secrets)
                                        {
                                            <option value="@secret.Id">@secret.Name</option>
                                        }
                                    </SelectInput>
                                    </FormField>
                                </div>
                            </Grid>

                            <Grid Gap="LayoutGap.Medium" ColumnsMd="2">
                                <CheckboxOption @bind-Value="providerModel.IsEnabled"  Text="Enabled" />
                                <CheckboxOption @bind-Value="providerModel.SupportsStreaming"  Text="Streaming" />
                                <CheckboxOption @bind-Value="providerModel.SupportsToolCalling"  Text="Tool calling" />
                                <CheckboxOption @bind-Value="providerModel.SupportsStructuredOutput"  Text="Structured output" />
                                <CheckboxOption @bind-Value="providerModel.SupportsVision"  Text="Vision" />
                            </Grid>
                        </FormSection>
                    </TabsItem>
                </Tabs>

                <StickyActionFooter StatusLabel="Provider profiles">
                    <SecondaryActions>
                        <Button Text="Clear" Tone="ButtonTone.Default" Click="ResetProviderAsync" />
                        @if (providerModel.Id.HasValue)
                        {
                            <Button Text="Health" Tone="ButtonTone.Info" Click="@(() => TestProviderAsync(providerModel.Id.Value))" />
                        }
                    </SecondaryActions>
                    <PrimaryActions>
                        <Button Text="Save provider" Type="submit" data-testid="provider-save-button" />
                    </PrimaryActions>
                    <DangerActions>
                        @if (providerModel.Id.HasValue)
                        {
                            <Button Text="Delete" Tone="ButtonTone.Danger" Click="@(() => DeleteProviderAsync(providerModel.Id.Value))" />
                        }
                    </DangerActions>
                </StickyActionFooter>
            </Stack>
        </EditForm>
    </DetailContent>
</ListDetailShell>

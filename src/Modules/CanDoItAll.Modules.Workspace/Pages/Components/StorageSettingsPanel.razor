@using CanDoItAll.Modules.Workspace.StorageCatalog.Contracts
@using CanDoItAll.Workspace.StorageCatalog.UI
@using CanDoItAll.Infrastructure.Persistence
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject IStorageCatalogOwner Owner
@inject CatalogOperationLedger Ledger
@inject IDatabaseSwitchNotificationService ProfileChanges

@if (session is not null) {
    <CatalogSurface Session="session" RecoveryRequested="OpenRecovery" />
}
@if (recoveryOpen) {
    <StoragePlacementRecoveryDialog StorageId="recoveryTarget" OnClose="@(() => recoveryOpen = false)" />
}

@code {
    [CascadingParameter] public Task<AuthenticationState>? AuthenticationState { get; set; }
    private Task<AuthenticationState>? previousAuthentication;
    private CatalogSession? session;
    private bool recoveryOpen;
    private Guid? recoveryTarget;
    private bool disposed;
    protected override async Task OnInitializedAsync() {
        previousAuthentication = AuthenticationState;
        ProfileChanges.Changed += ProfileChanged;
        session = new(Owner, Ledger);
        await session.LoadAsync();
    }
    protected override async Task OnParametersSetAsync() {
        if (!ReferenceEquals(previousAuthentication, AuthenticationState)) {
            previousAuthentication = AuthenticationState;
            session?.Dispose();
            recoveryOpen = false;
            session = new(Owner, Ledger);
            await session.LoadAsync();
        }
    }
    private void OpenRecovery(Guid? target) {
        recoveryTarget = target;
        recoveryOpen = true;
    }
    private void ProfileChanged(object? sender, DatabaseProfileChangedNotification notification) => _ = InvokeAsync(() => {
        if (!disposed) {
            session?.Dispose();
            recoveryOpen = false;
            StateHasChanged();
        }
    });
    public void Dispose() {
        disposed = true;
        ProfileChanges.Changed -= ProfileChanged;
        session?.Dispose();
    }
}

@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using CanDoItAll.Infrastructure.Storage
@using CanDoItAll.Modules.Security
@using Microsoft.AspNetCore.Components
@inject WorkspaceService WorkspaceService
@inject NotificationService NotificationService

<ListDetailShell ListPaneWidth="27rem">
    <ListHeader>
        <ListPanelHeader Title="Storage catalog"
                         Description="Define the storage drivers available to the workspace, verify health explicitly, and choose which lanes own prompt files, evidence, and release artifacts."
                         Count="@($"{FilteredStorages.Count} storage target(s)")">
            <Actions>
                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                    <Button Text="File system"
                            Tone="ButtonTone.Default"
                            Size="ButtonSize.Small"
                            Click="@(() => ResetStorageAsync(StorageProviderKind.FileSystem))"
                            data-testid="storage-settings-new-filesystem" />
                    <Button Text="IPFS"
                            Tone="ButtonTone.Default"
                            Size="ButtonSize.Small"
                            Click="@(() => ResetStorageAsync(StorageProviderKind.Ipfs))"
                            data-testid="storage-settings-new-ipfs" />
                    <Button Text="FTP"
                            Tone="ButtonTone.Default"
                            Size="ButtonSize.Small"
                            Click="@(() => ResetStorageAsync(StorageProviderKind.Ftp))"
                            data-testid="storage-settings-new-ftp" />
                </Cluster>
            </Actions>
            <Filters>
                <FilterBar ResultText="@($"{FilteredStorages.Count} matching storage target(s)")">
                    <input @bind="storageSearch"
                           @bind:event="oninput"
                           class="ui-input min-w-[14rem] flex-1"
                           placeholder="Search storage catalog"
                           data-testid="storage-settings-search" />
                    <Button Text="Reset"
                            Tone="ButtonTone.Default"
                            Size="ButtonSize.Small"
                            Click="ResetStorageSearch" />
                </FilterBar>
            </Filters>
        </ListPanelHeader>
    </ListHeader>

    <ListContent>
        <StorageSummaryCard Model="@BuildStorageSummaryModel()"
                            Emphasized="true"
                            data-testid="storage-settings-summary" />

        @if (FilteredStorages.Count == 0)
        {
            <EmptyState Eyebrow="No storage targets"
                        Title="Add the first storage target"
                        Description="Start with the local file system for prompt artifacts, then layer in IPFS or FTP only where those protocols add value." />
        }
        else
        {
            <Stack GapScale="LayoutGap.Medium" data-testid="storage-catalog-list">
                @foreach (var storage in FilteredStorages)
                {
                    <SelectionListItem Title="@storage.Name"
                                       Eyebrow="@StoragePresentation.DescribeProvider(storage.ProviderKind)"
                                       Meta="@StoragePresentation.DescribeConnectionMode(storage.ConnectionMode)"
                                       Summary="@BuildStorageRowSummary(storage)"
                                       DataTestId="@($"storage-catalog-row-{storage.Id:N}")"
                                       IsSelected="@(storageModel.Id == storage.Id)"
                                       OnSelect="@(() => EditStorageAsync(storage.Id))">
                        <Status>
                            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                <StatusBadge Tone="@ResolveHealthTone(storage.HealthStatus)"
                                             Text="@StoragePresentation.DescribeHealth(storage.HealthStatus)" />
                                @if (storage.IsSystemDefault)
                                {
                                    <StatusBadge Tone="info" Text="System default" />
                                }
                                @if (storage.IsReadOnly)
                                {
                                    <StatusBadge Tone="warning" Text="Read only" />
                                }
                            </Cluster>
                        </Status>
                    </SelectionListItem>
                }
            </Stack>
        }
    </ListContent>

    <DetailHeader>
        <Stack GapScale="LayoutGap.Tiny">
            <p class="cda-eyebrow">Storage editor</p>
            <h2 class="cda-title-xl">@(storageModel.Id.HasValue ? storageModel.Name : $"New {StoragePresentation.DescribeProvider(storageModel.ProviderKind)} target")</h2>
            <p class="cda-body-muted">@ResolveEditorLead()</p>
        </Stack>
    </DetailHeader>

    <DetailContent>
        <EditForm Model="storageModel" OnValidSubmit="SaveStorageAsync">
            <Stack Class="min-h-full" GapScale="LayoutGap.XXLarge">
                <Steps @bind-Value="storageEditorStep"
                       NavigationPosition="StepsNavigationPosition.Bottom"
                       NextText="Next step"
                       PreviousText="Previous step"
                       AdditionalAttributes="storageWizardAttributes">
                    <StepsItem Text="Identity"
                               Icon="inventory_2"
                               Description="Name the target, choose the provider kind, and make its operating mode explicit.">
                        <FormSection Title="Storage identity"
                                     Description="Keep the label concrete. This catalog drives routing and UI labels across workbench attachments and prompt exports.">
                            <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                <div>
                                    <label class="cda-field-label">Name</label>
                                    <InputText @bind-Value="storageModel.Name"
                                               class="ui-input"
                                               data-testid="storage-settings-name" />
                                </div>
                                <div>
                                    <label class="cda-field-label">Provider kind</label>
                                    <InputSelect Value="storageModel.ProviderKind"
                                                 ValueChanged="@((StorageProviderKind value) => HandleProviderKindChangedAsync(value))"
                                                 ValueExpression="() => storageModel.ProviderKind"
                                                 class="ui-input"
                                                 data-testid="storage-settings-provider">
                                        @foreach (var providerKind in Enum.GetValues<StorageProviderKind>())
                                        {
                                            <option value="@providerKind">@StoragePresentation.DescribeProvider(providerKind)</option>
                                        }
                                    </InputSelect>
                                </div>
                            </Grid>

                            <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                <div>
                                    <label class="cda-field-label">Connection mode</label>
                                    <InputSelect @bind-Value="storageModel.ConnectionMode"
                                                 class="ui-input"
                                                 disabled="@(storageModel.ProviderKind == StorageProviderKind.FileSystem)"
                                                 data-testid="storage-settings-connection-mode">
                                        @foreach (var connectionMode in Enum.GetValues<StorageConnectionMode>())
                                        {
                                            <option value="@connectionMode">@StoragePresentation.DescribeConnectionMode(connectionMode)</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div>
                                    <label class="cda-field-label">Credential secret</label>
                                    <InputSelect @bind-Value="storageModel.CredentialSecretId"
                                                 class="ui-input"
                                                 data-testid="storage-settings-secret">
                                        <option value="">None</option>
                                        @foreach (var secret in secrets)
                                        {
                                            <option value="@secret.Id">@secret.Name</option>
                                        }
                                    </InputSelect>
                                </div>
                            </Grid>

                            <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                <label class="cda-inline-option">
                                    <InputCheckbox @bind-Value="storageModel.IsEnabled"
                                                   data-testid="storage-settings-enabled" />
                                    Enabled
                                </label>
                                <label class="cda-inline-option">
                                    <InputCheckbox @bind-Value="storageModel.IsReadOnly"
                                                   data-testid="storage-settings-read-only" />
                                    Read only
                                </label>
                            </Grid>

                            <div>
                                <label class="cda-field-label">Display order</label>
                                <InputNumber @bind-Value="storageModel.DisplayOrder"
                                             class="ui-input"
                                             data-testid="storage-settings-display-order" />
                            </div>
                        </FormSection>
                    </StepsItem>
                    <StepsItem Text="Connectivity"
                               Icon="lan"
                               Description="Capture the root or endpoint, then add provider-specific connection details without guessing.">
                        <FormSection Title="Driver configuration"
                                     Description="Use exact host or root values. Test connection should fail loudly when the catalog entry is incomplete or the driver is unavailable.">
                            <div>
                                <label class="cda-field-label">@(storageModel.ProviderKind == StorageProviderKind.FileSystem ? "Root path" : "Endpoint or host")</label>
                                <InputText @bind-Value="storageModel.EndpointOrRoot"
                                           class="ui-input"
                                           data-testid="storage-settings-endpoint" />
                            </div>

                            @if (storageModel.ProviderKind == StorageProviderKind.Ipfs)
                            {
                                <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                    <div>
                                        <label class="cda-field-label">Gateway base URL</label>
                                        <InputText @bind-Value="storageModel.GatewayBaseUrl"
                                                   class="ui-input"
                                                   data-testid="storage-settings-ipfs-gateway" />
                                    </div>
                                    <div>
                                        <label class="cda-field-label">Base path</label>
                                        <InputText @bind-Value="storageModel.BasePath"
                                                   class="ui-input"
                                                   data-testid="storage-settings-base-path" />
                                    </div>
                                </Grid>

                                <label class="cda-inline-option">
                                    <InputCheckbox @bind-Value="storageModel.PinOnUpload"
                                                   data-testid="storage-settings-pin-on-upload" />
                                    Pin on upload
                                </label>
                            }
                            else if (storageModel.ProviderKind == StorageProviderKind.Ftp)
                            {
                                <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                    <div>
                                        <label class="cda-field-label">Port</label>
                                        <InputNumber @bind-Value="storageModel.Port"
                                                     class="ui-input"
                                                     data-testid="storage-settings-ftp-port" />
                                    </div>
                                    <div>
                                        <label class="cda-field-label">Username</label>
                                        <InputText @bind-Value="storageModel.Username"
                                                   class="ui-input"
                                                   data-testid="storage-settings-ftp-username" />
                                    </div>
                                </Grid>

                                <div>
                                    <label class="cda-field-label">Base path</label>
                                    <InputText @bind-Value="storageModel.BasePath"
                                               class="ui-input"
                                               data-testid="storage-settings-base-path" />
                                </div>

                                <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                    <label class="cda-inline-option">
                                        <InputCheckbox @bind-Value="storageModel.UseSsl"
                                                       data-testid="storage-settings-use-ssl" />
                                        Use SSL
                                    </label>
                                    <label class="cda-inline-option">
                                        <InputCheckbox @bind-Value="storageModel.UsePassiveMode"
                                                       data-testid="storage-settings-use-passive" />
                                        Passive mode
                                    </label>
                                </Grid>
                            }

                            <StorageSummaryCard Model="@BuildCapabilitySummaryModel()"
                                                data-testid="storage-settings-capability-summary" />
                        </FormSection>
                    </StepsItem>

                    <StepsItem Text="Routing"
                               Icon="alt_route"
                               Description="Choose which artifact lanes should prefer this target when the workspace has not overridden routing elsewhere.">
                        <FormSection Title="Default routing purposes"
                                     Description="Only assign lanes this target can genuinely support. Prompt attachments and evidence usually need preview-friendly storage, while exports and releases can route elsewhere.">
                            <div class="grid gap-3 md:grid-cols-2" data-testid="storage-settings-purpose-grid">
                                @foreach (var purpose in WorkspaceStorageDefaults.TrackedPurposes)
                                {
                                    <label class="cda-inline-option rounded-[1.25rem] border border-slate-200 bg-slate-50/80 px-4 py-3">
                                        <input type="checkbox"
                                               checked="@storageModel.DefaultPurposes.Contains(purpose)"
                                               @onchange="@((ChangeEventArgs args) => TogglePurpose(purpose, args.Value is bool selected && selected))"
                                               data-testid="@($"storage-settings-purpose-{purpose.ToString().ToLowerInvariant()}")" />
                                        @StoragePresentation.DescribeUsagePurpose(purpose)
                                    </label>
                                }
                            </div>

                            @if (routingDefaults.Count > 0)
                            {
                                <FactTable>
                                    <div class="grid gap-x-4 gap-y-3 md:grid-cols-2">
                                        @foreach (var routingDefault in routingDefaults)
                                        {
                                            <div class="min-w-0 rounded-[1.1rem] border border-slate-200 bg-white/90 px-4 py-3">
                                                <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-slate-500">@StoragePresentation.DescribeUsagePurpose(routingDefault.UsagePurpose)</p>
                                                <p class="mt-1 text-sm text-slate-700">@(string.IsNullOrWhiteSpace(routingDefault.PreferredStorageName) ? "No workspace default assigned" : routingDefault.PreferredStorageName)</p>
                                            </div>
                                        }
                                    </div>
                                </FactTable>
                            }
                        </FormSection>
                    </StepsItem>
                </Steps>

                <StickyActionFooter StatusLabel="Storage catalog"
                                    StatusTone="success">
                    <SecondaryActions>
                        <Button Text="Clear"
                                Tone="ButtonTone.Default"
                                Click="@(() => ResetStorageAsync(storageModel.ProviderKind))" />
                        <Button Text="Test connection"
                                Tone="ButtonTone.Info"
                                Click="TestStorageAsync"
                                data-testid="storage-settings-test" />
                    </SecondaryActions>
                    <PrimaryActions>
                        <Button Text="Save storage"
                                Type="submit"
                                data-testid="storage-settings-save" />
                    </PrimaryActions>
                    <DangerActions>
                        @if (storageModel.Id.HasValue && !storageModel.IsSystemDefault)
                        {
                            <Button Text="Delete"
                                    Tone="ButtonTone.Danger"
                                    Click="DeleteStorageAsync"
                                    data-testid="storage-settings-delete" />
                        }
                    </DangerActions>
                </StickyActionFooter>
            </Stack>
        </EditForm>
    </DetailContent>
</ListDetailShell>

@code {
    private static readonly IReadOnlyDictionary<string, object> storageWizardAttributes =
        new Dictionary<string, object>
        {
            ["data-testid"] = "storage-settings-wizard"
        };

    private IReadOnlyList<StorageCatalogSummary> storages = [];
    private IReadOnlyList<SecretListItem> secrets = [];
    private IReadOnlyList<StorageRoutingPreferenceSummary> routingDefaults = [];
    private StorageCatalogEditorModel storageModel = new();
    private string storageSearch = string.Empty;
    private int storageEditorStep;

    private IReadOnlyList<StorageCatalogSummary> FilteredStorages => storages
        .Where(storage =>
            string.IsNullOrWhiteSpace(storageSearch) ||
            storage.Name.Contains(storageSearch, StringComparison.OrdinalIgnoreCase) ||
            storage.EndpointOrRoot.Contains(storageSearch, StringComparison.OrdinalIgnoreCase) ||
            StoragePresentation.DescribeProvider(storage.ProviderKind).Contains(storageSearch, StringComparison.OrdinalIgnoreCase))
        .OrderBy(storage => storage.DisplayOrder)
        .ThenBy(storage => storage.Name)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        storages = await WorkspaceService.ListStorageCatalogAsync();
        secrets = await WorkspaceService.ListSecretsAsync();
        routingDefaults = await WorkspaceService.ListStorageRoutingDefaultsAsync();
        storageModel = WorkspaceService.CreateStorageDraft(StorageProviderKind.FileSystem);
    }

    private async Task ResetStorageAsync(StorageProviderKind providerKind)
    {
        storageModel = WorkspaceService.CreateStorageDraft(providerKind);
        storageEditorStep = 0;
        await InvokeAsync(StateHasChanged);
    }

    private async Task EditStorageAsync(Guid id)
    {
        storageModel = await WorkspaceService.GetStorageAsync(id);
        storageEditorStep = 0;
    }

    private async Task SaveStorageAsync()
    {
        try
        {
            var result = await WorkspaceService.SaveStorageAsync(storageModel);
            if (!result.IsSuccess)
            {
                NotificationService.Warning("Storage target was not saved", string.Join(" ", result.Errors.Select(error => error.Message)));
                return;
            }

            await RefreshStorageDataAsync();
            storageModel = await WorkspaceService.GetStorageAsync(result.Value);
            NotificationService.Success("Storage target saved", "Storage target saved.");
        }
        catch (Exception exception)
        {
            NotificationService.Error("Storage save failed", exception.Message);
        }
    }

    private async Task TestStorageAsync()
    {
        try
        {
            var result = await WorkspaceService.TestStorageAsync(storageModel);
            if (result.Success)
            {
                NotificationService.Success("Storage health check passed", result.Message);
            }
            else if (result.HealthStatus == StorageHealthStatus.Degraded)
            {
                NotificationService.Warning("Storage health is degraded", result.Message);
            }
            else
            {
                NotificationService.Error("Storage health check failed", result.Message);
            }

            await RefreshStorageDataAsync();
        }
        catch (Exception exception)
        {
            NotificationService.Error("Storage health check failed", exception.Message);
        }
    }

    private async Task DeleteStorageAsync()
    {
        if (!storageModel.Id.HasValue || storageModel.IsSystemDefault)
        {
            return;
        }

        try
        {
            await WorkspaceService.DeleteStorageAsync(storageModel.Id.Value);
            await RefreshStorageDataAsync();
            storageModel = WorkspaceService.CreateStorageDraft(StorageProviderKind.FileSystem);
            storageEditorStep = 0;
            NotificationService.Success("Storage target deleted", "Storage target deleted.");
        }
        catch (Exception exception)
        {
            NotificationService.Error("Storage delete failed", exception.Message);
        }
    }

    private Task HandleProviderKindChangedAsync(StorageProviderKind providerKind)
    {
        var template = WorkspaceService.CreateStorageDraft(providerKind);
        storageModel.ProviderKind = providerKind;
        storageModel.ConnectionMode = template.ConnectionMode;
        storageModel.CapabilityMask = template.CapabilityMask;
        storageModel.UseSsl = template.UseSsl;
        storageModel.UsePassiveMode = template.UsePassiveMode;
        storageModel.PinOnUpload = template.PinOnUpload;

        if (providerKind == StorageProviderKind.FileSystem)
        {
            storageModel.Port = null;
            storageModel.GatewayBaseUrl = string.Empty;
            storageModel.Username = string.Empty;
            storageModel.BasePath = string.Empty;
        }

        return Task.CompletedTask;
    }

    private void TogglePurpose(StorageUsagePurpose purpose, bool isSelected)
    {
        if (isSelected)
        {
            if (!storageModel.DefaultPurposes.Contains(purpose))
            {
                storageModel.DefaultPurposes.Add(purpose);
            }

            return;
        }

        storageModel.DefaultPurposes.RemoveAll(candidate => candidate == purpose);
    }

    private async Task RefreshStorageDataAsync()
    {
        storages = await WorkspaceService.ListStorageCatalogAsync();
        routingDefaults = await WorkspaceService.ListStorageRoutingDefaultsAsync();
    }

    private StorageSummaryModel BuildStorageSummaryModel()
    {
        var selected = storageModel.Id.HasValue
            ? storages.FirstOrDefault(storage => storage.Id == storageModel.Id.Value)
            : null;

        if (selected is null)
        {
            return new StorageSummaryModel
            {
                Eyebrow = "Workspace storage lanes",
                Title = $"{storages.Count} catalog target(s)",
                Description = "The active catalog is shared by project attachments, prompt exports, evidence packages, and release artifacts.",
                Badges =
                [
                    new StorageSummaryBadge($"{storages.Count(storage => storage.IsEnabled)} enabled", "success"),
                    new StorageSummaryBadge($"{routingDefaults.Count(route => route.IsEnabled)} defaults", "info")
                ],
                Facts =
                [
                    new StorageSummaryFact("Healthy", storages.Count(storage => storage.HealthStatus == StorageHealthStatus.Healthy).ToString()),
                    new StorageSummaryFact("Preview ready", storages.Count(storage => storage.CapabilityMask.HasFlag(StorageCapability.InlinePreview)).ToString())
                ],
                Footnote = "Keep preview-friendly lanes explicit. Do not route editable or evidence-heavy flows through storage that only partially supports them."
            };
        }

        return new StorageSummaryModel
        {
            Eyebrow = "Selected storage target",
            Title = selected.Name,
            Description = $"{StoragePresentation.DescribeProvider(selected.ProviderKind)} over {StoragePresentation.DescribeConnectionMode(selected.ConnectionMode)}",
            Badges = BuildBadgeList(selected.CapabilityMask, selected.HealthStatus, selected.IsReadOnly, selected.IsSystemDefault),
            Facts =
            [
                new StorageSummaryFact("Endpoint", selected.EndpointOrRoot),
                new StorageSummaryFact("Last check", selected.LastTestedAtUtc?.LocalDateTime.ToString("g") ?? "Not tested")
            ],
            Footnote = string.IsNullOrWhiteSpace(selected.LastHealthMessage)
                ? "No health message recorded yet."
                : selected.LastHealthMessage
        };
    }

    private StorageSummaryModel BuildCapabilitySummaryModel()
    {
        return new StorageSummaryModel
        {
            Eyebrow = "Capability preview",
            Title = StoragePresentation.DescribeProvider(storageModel.ProviderKind),
            Description = "These capabilities are inferred from the selected provider and read-only flags before connection test results refine them.",
            Badges = BuildBadgeList(storageModel.CapabilityMask, storageModel.HealthStatus, storageModel.IsReadOnly, storageModel.IsSystemDefault),
            Facts = StoragePresentation.ExpandCapabilities(storageModel.CapabilityMask)
                .Select(capability => new StorageSummaryFact(StoragePresentation.DescribeCapability(capability), ResolveCapabilityFactCopy(capability)))
                .ToList(),
            Footnote = string.IsNullOrWhiteSpace(storageModel.LastHealthMessage)
                ? "Connection test has not produced a driver message yet."
                : storageModel.LastHealthMessage
        };
    }

    private static IReadOnlyList<StorageSummaryBadge> BuildBadgeList(
        StorageCapability capabilityMask,
        StorageHealthStatus healthStatus,
        bool isReadOnly,
        bool isSystemDefault)
    {
        var badges = new List<StorageSummaryBadge>
        {
            new(StoragePresentation.DescribeHealth(healthStatus), ResolveHealthTone(healthStatus))
        };

        if (isSystemDefault)
        {
            badges.Add(new StorageSummaryBadge("System default", "info"));
        }

        if (isReadOnly)
        {
            badges.Add(new StorageSummaryBadge("Read only", "warning"));
        }

        badges.AddRange(StoragePresentation.ExpandCapabilities(capabilityMask)
            .Take(4)
            .Select(capability => new StorageSummaryBadge(StoragePresentation.DescribeCapability(capability))));
        return badges;
    }

    private static string BuildStorageRowSummary(StorageCatalogSummary storage)
    {
        var summarySegments = new List<string>
        {
            storage.EndpointOrRoot
        };

        var capabilitySummary = StoragePresentation.ExpandCapabilities(storage.CapabilityMask)
            .Take(3)
            .Select(StoragePresentation.DescribeCapability)
            .ToList();
        if (capabilitySummary.Count > 0)
        {
            summarySegments.Add(string.Join(", ", capabilitySummary));
        }

        return string.Join(" | ", summarySegments.Where(segment => !string.IsNullOrWhiteSpace(segment)));
    }

    private string ResolveEditorLead()
    {
        return storageModel.ProviderKind switch
        {
            StorageProviderKind.FileSystem => "Local file-system storage is the default for editable workspace artifacts and local previews.",
            StorageProviderKind.Ipfs => "IPFS storage is best for immutable shared assets, evidence, and exported bundles that benefit from content addressing.",
            StorageProviderKind.Ftp => "FTP storage is suitable for remote deployment mirrors or legacy drop targets where the workspace must push files outward.",
            _ => "Configure the storage target and test it before routing workspace artifacts through it."
        };
    }

    private static string ResolveCapabilityFactCopy(StorageCapability capability)
    {
        return capability switch
        {
            StorageCapability.InlinePreview => "UI can render previews without downloading first.",
            StorageCapability.OpenLocally => "Desktop flows can open the artifact directly on this machine.",
            StorageCapability.DirectUrl => "Published references can expose a direct remote URL.",
            StorageCapability.BatchFolderUpload => "Folder-style uploads can keep relative layout intact.",
            StorageCapability.BatchTransfer => "Storage-to-storage copy jobs can avoid local staging.",
            StorageCapability.ConnectionTest => "Driver exposes an explicit health-check path.",
            _ => "Available for this provider."
        };
    }

    private static string ResolveHealthTone(StorageHealthStatus healthStatus)
    {
        return healthStatus switch
        {
            StorageHealthStatus.Healthy => "success",
            StorageHealthStatus.Degraded => "warning",
            StorageHealthStatus.Unavailable => "danger",
            _ => "neutral"
        };
    }

    private void ResetStorageSearch()
    {
        storageSearch = string.Empty;
    }
}

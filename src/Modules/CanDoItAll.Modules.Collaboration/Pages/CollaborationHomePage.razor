@page "/collaboration"
@inject CollaborationService CollaborationService
@inject NavigationManager Navigation

<PageTitle>Collaboration</PageTitle>

<PageScaffold MaxWidthClass="max-w-full">
    <Header>
        <PageHeader Eyebrow="Collaboration"
                    Title="Inbox, threads, and escalation workspace"
                    Description="Durable notifications and human conversations now live in one canonical module instead of being scattered across transport and timeline views."
                    Compact="true">
            <Stats>
                <CompactStat Label="unread"
                             Value="@workspace.ShellState.UnreadCount.ToString()"
                             TooltipText="Unread collaboration items waiting for review."
                             Tone="info" />
                <CompactStat Label="escalations"
                             Value="@workspace.Escalations.Count.ToString()"
                             TooltipText="Threads flagged for explicit human attention."
                             Tone="warning" />
                <CompactStat Label="threads"
                             Value="@workspace.Threads.Count.ToString()"
                             TooltipText="Durable collaboration threads stored in the app database." />
                <CompactStat Label="transport"
                             Value="canonical"
                             TooltipText="External systems can project signals in, but Collaboration owns the read model."
                             Tone="success" />
            </Stats>
            <Actions>
                <PageHeaderActionButton Icon="calendar_month"
                                        Label="Open scheduler"
                                        TooltipText="Open scheduler planning."
                                        Click="OpenScheduler" />
                <PageHeaderActionButton Icon="done_all"
                                        Label="Mark selected read"
                                        TooltipText="Mark the selected collaboration thread as read."
                                        Tone="ButtonTone.Primary"
                                        Disabled="@(workspace.SelectedThread is null || !workspace.SelectedThread.IsUnread)"
                                        Click="MarkSelectedThreadAsReadAsync"
                                        data-testid="collaboration-mark-read" />
            </Actions>
        </PageHeader>
    </Header>

    <ChildContent>
        <Stack GapScale="LayoutGap.Large">
            <Tabs SelectedIndex="@selectedViewIndex"
                  SelectedIndexChanged="HandleSelectedViewChangedAsync"
                  BorderMode="TabsBorderMode.Soft"
                  OverflowMode="TabsOverflowMode.Wrap"
                  data-testid="collaboration-tabs">
                <TabItems>
                    <TabsItem Text="Inbox"
                              BadgeText="@ResolveBadgeText(workspace.ShellState.UnreadCount)" />
                    <TabsItem Text="Threads"
                              BadgeText="@ResolveBadgeText(workspace.Threads.Count)" />
                    <TabsItem Text="Escalations"
                              BadgeText="@ResolveBadgeText(workspace.Escalations.Count)" />
                </TabItems>
            </Tabs>

            <ListDetailShell ListPaneWidth="30rem">
                <ListHeader>
                    <ListPanelHeader Title="@ResolveListTitle()"
                                     Description="@ResolveListDescription()"
                                     Count="@($"{ResolveCurrentListCount()} item(s)")">
                        <Filters>
                            <FilterBar ResultText="@($"{ResolveCurrentListCount()} item(s)")">
                                @if (selectedViewIndex != 1)
                                {
                                    <Button Text="Unread only"
                                            Tone="@(showUnreadOnly ? ButtonTone.Info : ButtonTone.Default)"
                                            Size="ButtonSize.Small"
                                            Click="ShowUnreadOnlyAsync"
                                            data-testid="collaboration-filter-unread" />
                                    <Button Text="Show all"
                                            Tone="@(showUnreadOnly ? ButtonTone.Default : ButtonTone.Info)"
                                            Size="ButtonSize.Small"
                                            Click="ShowAllItemsAsync"
                                            data-testid="collaboration-filter-all" />
                                }
                                @if (selectedViewIndex == 0)
                                {
                                    <Button Text="Notification"
                                            Tone="ButtonTone.Default"
                                            Size="ButtonSize.Small"
                                            Click="@(() => PrepareNewThread(CollaborationInboxItemKind.Notification))" />
                                    <Button Text="Escalation"
                                            Tone="ButtonTone.Default"
                                            Size="ButtonSize.Small"
                                            Click="@(() => PrepareNewThread(CollaborationInboxItemKind.Escalation))" />
                                }
                            </FilterBar>
                        </Filters>
                    </ListPanelHeader>
                </ListHeader>

                <ListContent>
                    @if (selectedViewIndex == 0)
                    {
                        <EditForm Model="newThreadEditor" OnValidSubmit="CreateThreadAsync">
                            <SurfaceCard Soft="true">
                                <DataAnnotationsValidator />
                                <TextBlock TextStyle="TextStyle.EyebrowCaption" Value="Quick create" />
                                <h3 class="mt-1 text-lg font-semibold text-slate-950">New collaboration item</h3>
                                <Grid Gap="LayoutGap.Medium" ColumnsMd="2" Class="mt-4">
                                    <div>
                                        <FormField Text="Subject">
                                        <TextInput @bind-Value="newThreadEditor.Subject" data-testid="collaboration-thread-subject" />
                                        </FormField>
                                        <ValidationMessage For="@(() => newThreadEditor.Subject)" />
                                    </div>
                                    <div>
                                        <FormField Text="Item kind">
                                        <SelectInput @bind-Value="newThreadEditor.ItemKind" data-testid="collaboration-thread-kind">
                                            @foreach (var kind in Enum.GetValues<CollaborationInboxItemKind>())
                                            {
                                                <option value="@kind">@kind</option>
                                            }
                                        </SelectInput>
                                        </FormField>
                                    </div>
                                </Grid>
                                <Grid Gap="LayoutGap.Medium" ColumnsMd="2" Class="mt-4">
                                    <div>
                                        <FormField Text="Context kind">
                                        <SelectInput @bind-Value="newThreadEditor.ContextKind" data-testid="collaboration-thread-context-kind">
                                            @foreach (var kind in Enum.GetValues<CollaborationContextKind>())
                                            {
                                                <option value="@kind">@kind</option>
                                            }
                                        </SelectInput>
                                        </FormField>
                                    </div>
                                    <div>
                                        <FormField Text="Context label">
                                        <TextInput @bind-Value="newThreadEditor.ContextLabel" data-testid="collaboration-thread-context-label" />
                                        </FormField>
                                    </div>
                                </Grid>
                                <div class="mt-4">
                                    <FormField Text="Context route">
                                    <TextInput @bind-Value="newThreadEditor.ContextRoute" placeholder="/processes" data-testid="collaboration-thread-context-route" />
                                    </FormField>
                                </div>
                                <div class="mt-4">
                                    <FormField Text="First message">
                                    <TextAreaInput @bind-Value="newThreadEditor.MessageBody" rows="4" data-testid="collaboration-thread-message" />
                                    </FormField>
                                    <ValidationMessage For="@(() => newThreadEditor.MessageBody)" />
                                </div>
                                <Cluster Gap="LayoutGap.Small" Class="mt-4">
                                    <Button Text="Create collaboration item" Type="submit" data-testid="collaboration-thread-create" />
                                    <Button Text="Reset" Tone="ButtonTone.Default" Size="ButtonSize.Small" Click="@(() => PrepareNewThread(newThreadEditor.ItemKind))" />
                                </Cluster>
                            </SurfaceCard>
                        </EditForm>
                    }

                    @if (selectedViewIndex == 0)
                    {
                        @if (VisibleInboxItems.Count == 0)
                        {
                            <div class="mt-5">
                                <EmptyState Eyebrow="Inbox is empty" Title="No collaboration items yet" Description="Create a notification or escalation to start the canonical collaboration trail." />
                            </div>
                        }
                        else
                        {
                            <Stack GapScale="LayoutGap.Medium" Class="mt-5">
                                @foreach (var item in VisibleInboxItems)
                                {
                                    <div data-testid="collaboration-inbox-item">
                                        <SelectionListItem Title="@item.Title" Eyebrow="@ResolveItemEyebrow(item)" Summary="@item.PreviewText" Meta="@(item.UpdatedAtUtc.LocalDateTime.ToString("g"))" IsSelected="@(workspace.SelectedThread?.ThreadId == item.ThreadId)" OnSelect="@(() => SelectThreadAsync(item.ThreadId))">
                                            <Status>
                                                <Cluster Gap="LayoutGap.Small">
                                                    <StatusBadge Tone="@ResolveItemTone(item.ItemKind)" Text="@item.ItemKind.ToString()" />
                                                    @if (item.IsUnread)
                                                    {
                                                        <StatusBadge Tone="info" Text="@($"{item.UnreadCount} unread")" />
                                                    }
                                                </Cluster>
                                            </Status>
                                        </SelectionListItem>
                                    </div>
                                }
                            </Stack>
                        }
                    }
                    else if (selectedViewIndex == 1)
                    {
                        @if (workspace.Threads.Count == 0)
                        {
                            <EmptyState Eyebrow="No threads" Title="Create the first collaboration thread" Description="Threads collect participants, messages, context links, and unread state in one durable model." />
                        }
                        else
                        {
                            <Stack GapScale="LayoutGap.Medium">
                                @foreach (var item in workspace.Threads)
                                {
                                    <div data-testid="collaboration-thread-item">
                                        <SelectionListItem Title="@item.Subject" Eyebrow="@item.ContextKind.ToString()" Summary="@item.ContextLabel" Meta="@($"{item.MessageCount} message(s) / {item.LastActivityAtUtc.LocalDateTime:g}")" IsSelected="@(workspace.SelectedThread?.ThreadId == item.ThreadId)" OnSelect="@(() => SelectThreadAsync(item.ThreadId))">
                                            <Status>
                                                <Cluster Gap="LayoutGap.Small">
                                                    <StatusBadge Tone="@ResolveItemTone(item.ItemKind)" Text="@item.ItemKind.ToString()" />
                                                    <StatusBadge Tone="neutral" Text="@item.State.ToString()" />
                                                </Cluster>
                                            </Status>
                                        </SelectionListItem>
                                    </div>
                                }
                            </Stack>
                        }
                    }
                    else
                    {
                        @if (VisibleEscalations.Count == 0)
                        {
                            <EmptyState Eyebrow="No escalations" Title="Escalations will appear here" Description="Use the inbox quick-create form or project automation ingress to raise explicit human work." />
                        }
                        else
                        {
                            <Stack GapScale="LayoutGap.Medium">
                                @foreach (var item in VisibleEscalations)
                                {
                                    <div data-testid="collaboration-escalation-item">
                                        <SelectionListItem Title="@item.Title" Eyebrow="Escalation" Summary="@item.PreviewText" Meta="@(item.UpdatedAtUtc.LocalDateTime.ToString("g"))" IsSelected="@(workspace.SelectedThread?.ThreadId == item.ThreadId)" OnSelect="@(() => SelectThreadAsync(item.ThreadId))">
                                            <Status>
                                                <Cluster Gap="LayoutGap.Small">
                                                    <StatusBadge Tone="warning" Text="Escalation" />
                                                    @if (item.IsUnread)
                                                    {
                                                        <StatusBadge Tone="info" Text="@($"{item.UnreadCount} unread")" />
                                                    }
                                                </Cluster>
                                            </Status>
                                        </SelectionListItem>
                                    </div>
                                }
                            </Stack>
                        }
                    }
                </ListContent>

                <DetailHeader>
                    @if (workspace.SelectedThread is null)
                    {
                        <EmptyState Eyebrow="Thread detail" Title="Select an inbox item or thread" Description="Participants, context links, unread state, and message history appear here after you choose a collaboration item." />
                    }
                    else
                    {
                        <SurfaceCard>
                            <Split Gap="LayoutGap.Medium" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap">
                                <div class="min-w-0">
                                    <TextBlock TextStyle="TextStyle.EyebrowCaption" Value="@($"{workspace.SelectedThread.ContextKind} / {workspace.SelectedThread.ContextLabel}")" />
                                    <h2 class="mt-1 text-lg font-semibold text-slate-950" data-testid="collaboration-thread-title">@workspace.SelectedThread.Subject</h2>
                                </div>
                                <Cluster Gap="LayoutGap.Small">
                                    <StatusBadge Tone="@ResolveItemTone(workspace.SelectedThread.ItemKind)" Text="@workspace.SelectedThread.ItemKind.ToString()" />
                                    <StatusBadge Tone="neutral" Text="@workspace.SelectedThread.State.ToString()" />
                                    @if (workspace.SelectedThread.IsUnread)
                                    {
                                        <StatusBadge Tone="info" Text="@($"{workspace.SelectedThread.UnreadCount} unread")" />
                                    }
                                </Cluster>
                            </Split>
                        </SurfaceCard>
                    }
                </DetailHeader>

                <DetailContent>
                    @if (workspace.SelectedThread is null)
                    {
                        <EmptyState Eyebrow="No selection" Title="Choose a thread to continue" Description="The detail surface shows context, transcript, and reply actions for the selected collaboration thread." />
                    }
                    else
                    {
                        <Stack GapScale="LayoutGap.Large">
                            <Grid Gap="LayoutGap.Medium" ColumnsMd="3">
                                <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 px-4 py-4">
                                    <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Context</p>
                                    <p class="mt-1 text-sm font-medium text-slate-950">@workspace.SelectedThread.ContextLabel</p>
                                </div>
                                <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 px-4 py-4">
                                    <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Messages</p>
                                    <p class="mt-1 text-sm font-medium text-slate-950">@workspace.SelectedThread.Messages.Count</p>
                                </div>
                                <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 px-4 py-4">
                                    <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Participants</p>
                                    <p class="mt-1 text-sm font-medium text-slate-950">@workspace.SelectedThread.Participants.Count</p>
                                </div>
                            </Grid>
                            <SectionCard Title="Transcript" Description="Durable message history with preserved author and timestamp state.">
                                @if (workspace.SelectedThread.Messages.Count == 0)
                                {
                                    <EmptyState Eyebrow="No messages" Title="This thread has no messages" Description="Messages appear here after the first collaboration post is saved." />
                                }
                                else
                                {
                                    <Stack GapScale="LayoutGap.Medium">
                                        @foreach (var collaborationMessage in workspace.SelectedThread.Messages)
                                        {
                                            <div class="cda-panel-card--soft" data-testid="collaboration-thread-message-item">
                                                <Split Gap="LayoutGap.Medium" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap">
                                                    <div>
                                                        <p class="text-sm font-semibold text-slate-900">@collaborationMessage.AuthorName</p>
                                                        <p class="mt-1 text-xs text-slate-500">@collaborationMessage.AuthorKind / @collaborationMessage.MessageKind</p>
                                                    </div>
                                                    <Cluster Gap="LayoutGap.Small">
                                                        @if (collaborationMessage.RaisesEscalation)
                                                        {
                                                            <StatusBadge Tone="warning" Text="Escalation" />
                                                        }
                                                        <StatusBadge Tone="neutral" Text="@(collaborationMessage.CreatedAtUtc.LocalDateTime.ToString("g"))" />
                                                    </Cluster>
                                                </Split>
                                                <p class="mt-3 text-sm leading-6 text-slate-700">@collaborationMessage.Body</p>
                                            </div>
                                        }
                                    </Stack>
                                }
                            </SectionCard>
                            <SectionCard Title="Reply" Description="Record another collaboration message on the selected thread.">
                                <EditForm Model="replyEditor" OnValidSubmit="AddReplyAsync">
                                    <DataAnnotationsValidator />
                                    <Grid Gap="LayoutGap.Medium" ColumnsMd="2">
                                        <div>
                                            <FormField Text="Message kind">
                                            <SelectInput @bind-Value="replyEditor.MessageKind" data-testid="collaboration-reply-kind">
                                                @foreach (var kind in Enum.GetValues<CollaborationMessageKind>())
                                                {
                                                    <option value="@kind">@kind</option>
                                                }
                                            </SelectInput>
                                            </FormField>
                                        </div>
                                        <div class="flex items-end">
                                            @if (!string.IsNullOrWhiteSpace(workspace.SelectedThread.ContextRoute))
                                            {
                                                <Button Text="Open linked context" Tone="ButtonTone.Default" Size="ButtonSize.Small" Click="OpenContext" data-testid="collaboration-open-context" />
                                            }
                                        </div>
                                    </Grid>
                                    <div class="mt-4">
                                        <FormField Text="Reply">
                                        <TextAreaInput @bind-Value="replyEditor.MessageBody" rows="4" data-testid="collaboration-reply-message" />
                                        </FormField>
                                        <ValidationMessage For="@(() => replyEditor.MessageBody)" />
                                    </div>
                                    <Cluster Gap="LayoutGap.Small" Class="mt-4">
                                        <Button Text="Add reply" Type="submit" data-testid="collaboration-reply-submit" />
                                        <Button Text="Clear" Tone="ButtonTone.Default" Size="ButtonSize.Small" Click="ClearReply" />
                                    </Cluster>
                                </EditForm>
                            </SectionCard>
                        </Stack>
                    }
                </DetailContent>
            </ListDetailShell>
        </Stack>
    </ChildContent>
</PageScaffold>

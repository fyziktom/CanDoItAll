@page "/test-lab"
@using CanDoItAll.AppComponents.Navigation
@using CanDoItAll.TestLab.UI
@using CanDoItAll.Components.BaseLib
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject ITestLabWorkspaceOwner Owner
@inject NotificationService Notifications
@inject NavigationManager Navigation
@inject ILogger<TestLabWorkspaceSession> Logger

<PageTitle>Test Lab</PageTitle>
<TestLabWorkspaceSurface View="session" Interactive="interactive" />

@code {
    [SupplyParameterFromQuery(Name = TestLabUrlCodec.PlanKey)] public string? PlanQuery { get; set; }
    [SupplyParameterFromQuery(Name = TestLabUrlCodec.SectionKey)] public string? SectionQuery { get; set; }
    [SupplyParameterFromQuery(Name = TestLabUrlCodec.ProjectKey)] public string? ProjectQuery { get; set; }
    [SupplyParameterFromQuery(Name = TestLabUrlCodec.SearchKey)] public string? SearchQuery { get; set; }
    [SupplyParameterFromQuery(Name = TestLabUrlCodec.ProjectFilterKey)] public string? ProjectFilterQuery { get; set; }
    [SupplyParameterFromQuery(Name = TestLabUrlCodec.PhaseKey)] public string? PhaseQuery { get; set; }
    [SupplyParameterFromQuery(Name = TestLabUrlCodec.ResultKey)] public string? ResultQuery { get; set; }
    private UrlStateBinding<TestLabUrlState> url = default!;
    private TestLabWorkspaceSession session = default!;
    private bool disposed;
    private bool interactive;

    protected override void OnInitialized() {
        url = new(Navigation, TestLabUrlCodec.Instance, null, typeof(TestLabPage));
        session = new(Owner, Changed, Notify, Logger, Navigate);
    }

    protected override async Task OnParametersSetAsync() {
        var change = url.Apply(canonicalize: RendererInfo.IsInteractive);
        if (change.IsChanged) {
            await session.ApplyRouteAsync(change.Current);
        }
    }

    // The session reports the address of a user intent; the binding keeps the history rule it was given.
    private void Navigate(TestLabUrlState next, UrlHistoryMode mode) {
        if (!disposed) {
            url.Navigate(next, mode);
        }
    }

    protected override void OnAfterRender(bool firstRender) {
        if (firstRender) {
            interactive = true;
            StateHasChanged();
        }
    }
    private void Changed() => _ = RenderAsync();
    private async Task RenderAsync() {
        try {
            await InvokeAsync(() => {
                if (!disposed) {
                    StateHasChanged();
                }
            });
        } catch (Exception exception) {
            if (!disposed) {
                Logger.LogError("TestLab rendering failed. FailureType={FailureType}", exception.GetType().Name);
            }
        }
    }
    private void Notify(TestLabReceipt receipt) {
        if (disposed) {
            return;
        }
        switch (receipt.State) {
            case TestLabSaveState.Saved:
                Notifications.Success("Test plan saved", receipt.Message);
                break;
            case TestLabSaveState.SavedWithWarning:
                Notifications.Warning("Test plan saved; refresh incomplete", receipt.Message);
                break;
            case TestLabSaveState.Unknown:
                Notifications.Error("Test plan save outcome unknown", receipt.Message);
                break;
            default:
                Notifications.Error("Test plan save failed", receipt.Message);
                break;
        }
    }
    public void Dispose() {
        disposed = true;
        session.Dispose();
    }
}

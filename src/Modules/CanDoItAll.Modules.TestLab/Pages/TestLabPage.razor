@page "/test-lab"
@using CanDoItAll.TestLab.UI
@using CanDoItAll.Components.BaseLib
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject ITestLabWorkspaceOwner Owner
@inject NotificationService Notifications
@inject ILogger<TestLabWorkspaceSession> Logger

<PageTitle>Test Lab</PageTitle>
<TestLabWorkspaceSurface View="session" Interactive="interactive" />

@code {
    [SupplyParameterFromQuery(Name = "planId")] public Guid? PlanIdQuery { get; set; }
    [SupplyParameterFromQuery(Name = "projectId")] public Guid? ProjectIdQuery { get; set; }
    private TestLabWorkspaceSession session = default!;
    private bool disposed;
    private bool interactive;

    protected override void OnInitialized() => session = new(Owner, Changed, Notify, Logger);
    protected override Task OnParametersSetAsync() => session.ApplyRouteAsync(PlanIdQuery, ProjectIdQuery);
    protected override void OnAfterRender(bool firstRender) {
        if (firstRender) {
            interactive = true;
            StateHasChanged();
        }
    }
    private void Changed() => _ = RenderAsync();
    private async Task RenderAsync() {
        try {
            await InvokeAsync(() => {
                if (!disposed) {
                    StateHasChanged();
                }
            });
        } catch (Exception exception) {
            if (!disposed) {
                Logger.LogError("TestLab rendering failed. FailureType={FailureType}", exception.GetType().Name);
            }
        }
    }
    private void Notify(TestLabReceipt receipt) {
        if (disposed) {
            return;
        }
        switch (receipt.State) {
            case TestLabSaveState.Saved:
                Notifications.Success("Test plan saved", receipt.Message);
                break;
            case TestLabSaveState.SavedWithWarning:
                Notifications.Warning("Test plan saved; refresh incomplete", receipt.Message);
                break;
            case TestLabSaveState.Unknown:
                Notifications.Error("Test plan save outcome unknown", receipt.Message);
                break;
            default:
                Notifications.Error("Test plan save failed", receipt.Message);
                break;
        }
    }
    public void Dispose() {
        disposed = true;
        session.Dispose();
    }
}

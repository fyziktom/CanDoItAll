@namespace CanDoItAll.Components.Charts
@using ApexCharts
@implements IDisposable

@if (!HasRenderableData)
{
    <div class="@ShellClass" style="@Style">
        <div class="rounded-lg border border-dashed border-slate-300 bg-white p-6 text-sm text-slate-500">
            @EmptyText
        </div>
    </div>
}
else
{
    <div @attributes="AdditionalAttributes" class="@ShellClass" style="@Style">
        @if (!string.IsNullOrWhiteSpace(Title) || !string.IsNullOrWhiteSpace(Description))
        {
            <div class="mb-3 space-y-1">
                @if (!string.IsNullOrWhiteSpace(Title))
                {
                    <h3 class="text-base font-semibold text-slate-950">@Title</h3>
                }
                @if (!string.IsNullOrWhiteSpace(Description))
                {
                    <p class="text-sm text-slate-600">@Description</p>
                }
            </div>
        }

        <ApexChart @ref="_chart"
                   TItem="CdaChartPoint"
                   Height="@Height"
                   Options="@_apexOptions">
            @foreach (var chartSeries in _renderSeries)
            {
                <ApexPointSeries TItem="CdaChartPoint"
                                 Items="@chartSeries.Points"
                                 Name="@chartSeries.Name"
                                 Hidden="@(chartSeries.Hidden ? true : null)"
                                 SeriesType="@ResolveSeriesType(chartSeries)"
                                 XValue="point => point.XValue"
                                 YValue="point => (decimal?)point.Value"
                                 Color="@chartSeries.Color"
                                 PointColor="point => ResolvePointColor(chartSeries, point)"
                                 Stroke="@BuildSeriesStroke(chartSeries)"
                                 ShowDataLabels="@ResolveDataLabels(chartSeries)" />
            }
        </ApexChart>
    </div>
}

@code {
    private ApexChart<CdaChartPoint>? _chart;
    private ApexChartOptions<CdaChartPoint> _apexOptions = new();
    private IReadOnlyList<CdaChartSeries> _renderSeries = [];

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public IReadOnlyList<CdaChartSeries> Series { get; set; } = [];

    [Parameter]
    public CdaChartOptions Options { get; set; } = new();

    [Parameter]
    public object Height { get; set; } = 320;

    [Parameter]
    public string EmptyText { get; set; } = "No chart data.";

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Style { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool HasRenderableData => _renderSeries.Any(series => series.Points.Count > 0);

    private string ShellClass => string.Join(
        ' ',
        new[]
        {
            "rounded-lg border border-slate-200 bg-white p-4 shadow-sm",
            Class
        }.Where(value => !string.IsNullOrWhiteSpace(value)));

    protected override void OnParametersSet()
    {
        Options ??= new CdaChartOptions();
        _renderSeries = NormalizeSeries(Series);
        _apexOptions = CdaApexChartOptionsFactory.Build(Options, _renderSeries, null);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_chart is null || !HasRenderableData)
        {
            return;
        }

        if (!firstRender)
        {
            await _chart.UpdateSeriesAsync(Options.Animate);
            await _chart.UpdateOptionsAsync(true, Options.Animate, true);
        }
    }

    private static IReadOnlyList<CdaChartSeries> NormalizeSeries(IReadOnlyList<CdaChartSeries>? series)
    {
        return series?
            .Where(item => item.Points.Count > 0)
            .Select(item => item with { Points = item.Points.ToArray() })
            .ToArray() ?? [];
    }

    private SeriesType ResolveSeriesType(CdaChartSeries chartSeries)
    {
        return CdaApexChartOptionsFactory.ResolveSeriesType(chartSeries.Type ?? Options.Type);
    }

    private bool ResolveDataLabels(CdaChartSeries chartSeries)
    {
        return chartSeries.ShowDataLabels ?? Options.ShowDataLabels;
    }

    private string? ResolvePointColor(CdaChartSeries chartSeries, CdaChartPoint point)
    {
        return point.Color ?? chartSeries.PointColorSelector?.Invoke(point);
    }

    private SeriesStroke? BuildSeriesStroke(CdaChartSeries chartSeries)
    {
        if (chartSeries.StrokeWidth is null && chartSeries.StrokeDash <= 0 && string.IsNullOrWhiteSpace(chartSeries.Color))
        {
            return null;
        }

        return new SeriesStroke
        {
            Color = chartSeries.Color ?? "#64748b",
            DashSpace = Math.Max(0, chartSeries.StrokeDash),
            Width = Math.Max(0, chartSeries.StrokeWidth ?? Options.StrokeWidth)
        };
    }

    public void Dispose()
    {
        _chart?.Dispose();
    }
}

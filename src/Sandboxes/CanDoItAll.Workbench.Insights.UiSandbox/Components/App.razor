@using CanDoItAll.Workbench.Insights.UiSandbox
@using CanDoItAll.Components.Charts
@inject IWebHostEnvironment Environment

<!DOCTYPE html>
<html lang="en" data-asset-mode="@(Environment.IsDevelopment() ? InsightsAssets.Mode.ToString() : null)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" href="data:," />
    <link rel="stylesheet" href="@Assets["_content/CanDoItAll.Components.BaseLib/css/material-symbols.css"]" />
    <link rel="stylesheet" href="@Assets["_content/CanDoItAll.Components.BaseLib/css/output.css"]" />
    <link rel="stylesheet" href="@Assets[InsightsAssets.ThemePath]" />
    <link rel="stylesheet" href="@Assets["sandbox.css"]" />
    <link rel="stylesheet" href="@Assets["CanDoItAll.Workbench.Insights.UiSandbox.styles.css"]" />
    <ImportMap />
    <CanvasLibHeadAssets />
    <ChartsHeadAssets />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <CanvasLibBodyAssets IncludePreviewAssets="true" IncludeCalendarAssets="false" />
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>

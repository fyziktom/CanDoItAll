<ThemeHost>
    <Layout FitViewport="true" LockOverflow="true">
        <Body FillHeight="true" Scrollable="true">
            <Cluster Gap="LayoutGap.Medium" Class="p-3">
                <a href="/dashboard">Dashboard scenarios</a>
                <a href="/runtime">Runtime scenarios</a>
                <a href="/profiles">Profile and shell scenarios</a>
            </Cluster>
            <Router AppAssembly="@typeof(App).Assembly">

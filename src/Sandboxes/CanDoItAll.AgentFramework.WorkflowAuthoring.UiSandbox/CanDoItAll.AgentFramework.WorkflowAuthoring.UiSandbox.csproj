<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <CopyRepositoryTemplatesToOutput>false</CopyRepositoryTemplatesToOutput>
    <WorkflowAuthoringAssetMode Condition="'$(WorkflowAuthoringAssetMode)' == ''">Parity</WorkflowAuthoringAssetMode>
    <OutputPath>bin/$(WorkflowAuthoringAssetMode)/$(Configuration)/</OutputPath>
    <IntermediateOutputPath>obj/$(WorkflowAuthoringAssetMode)/$(Configuration)/</IntermediateOutputPath>
    <DefineConstants Condition="'$(WorkflowAuthoringAssetMode)' == 'Fast'">$(DefineConstants);WORKFLOW_AUTHORING_FAST_ASSETS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Fixtures/image-executor.json" />
    <Content Remove="wwwroot/css/workflow-authoring-fast.css" Condition="'$(WorkflowAuthoringAssetMode)' != 'Fast'" />
    <ProjectReference Include="../../UI/CanDoItAll.AgentFramework.WorkflowAuthoring.UI/CanDoItAll.AgentFramework.WorkflowAuthoring.UI.csproj" />
    <Content Include="../../App/CanDoItAll.Web/wwwroot/css/output.css" Link="wwwroot/css/output.css"
             ContentRoot="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../App/CanDoItAll.Web/wwwroot/'))"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             Condition="'$(WorkflowAuthoringAssetMode)' == 'Parity'" />
    <ProjectReference Include="../../UI/CanDoItAll.Prompts.UI/CanDoItAll.Prompts.UI.csproj" />
  </ItemGroup>
  <Target Name="RequireWorkflowAuthoringParityTheme" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(WorkflowAuthoringAssetMode)' != 'Parity' and '$(WorkflowAuthoringAssetMode)' != 'Fast'"
           Text="WorkflowAuthoringAssetMode must be Parity or Fast." />
    <Error Condition="'$(WorkflowAuthoringAssetMode)' == 'Parity' and !Exists('$(MSBuildProjectDirectory)/../../App/CanDoItAll.Web/wwwroot/css/output.css')"
           Text="Parity CSS is missing. Run npm ci --prefix Tailwind, then npm run tailwind:build from the repository root." />
    <Error Condition="'$(WorkflowAuthoringAssetMode)' == 'Fast' and !Exists('$(MSBuildProjectDirectory)/wwwroot/css/workflow-authoring-fast.css')"
           Text="Fast CSS is missing. Run npm run workflow-authoring:css:build from the repository root." />
  </Target>
</Project>

@page "/"
@page "/crm-hr"
@inject NavigationManager Navigation

<PageTitle>CRM / HR Home UI sandbox</PageTitle>

<header class="crmhr-sandbox__controls">
    <Stack GapScale="LayoutGap.Small">
        <h1 class="cda-title-xl">CRM / HR Home UI sandbox</h1>
        <p>The real CRM / HR Home overview with deterministic local state and recorded intents. No query service, persistence or navigation is involved; the production secondary tabs are host chrome and are not rendered here.</p>
        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.Center">
            <label for="crmhr-sandbox-scenario">Scenario</label>
            <select id="crmhr-sandbox-scenario"
                    class="cda-input"
                    value="@CrmHrHomeSandboxContext.Token(context.Scenario)"
                    @onchange="ChangeScenario"
                    data-testid="crmhr-sandbox-scenario">
                @foreach (var scenario in Enum.GetValues<CrmHrHomeSandboxScenario>())
                {
                    <option value="@CrmHrHomeSandboxContext.Token(scenario)">@scenario</option>
                }
            </select>
            <Button Text="@LayoutLabel" ButtonStyle="ButtonStyle.Light" Click="CycleLayout" data-testid="crmhr-sandbox-layout" />
        </Cluster>
        <output aria-live="polite" data-testid="crmhr-sandbox-intent">@fixture.IntentLog</output>
    </Stack>
</header>

<main class="@FrameClass" data-testid="crmhr-sandbox-frame" data-scenario="@CrmHrHomeSandboxContext.Token(context.Scenario)">
    <CrmHrHomeSurface Presentation="@fixture.Presentation" Intent="HandleIntent">
        <SecondaryNavigation>
            <p class="text-sm text-slate-500" data-testid="crmhr-sandbox-navigation-slot">Secondary navigation is host-owned chrome; the production page renders the CRM / HR tabs here.</p>
        </SecondaryNavigation>
    </CrmHrHomeSurface>
</main>

<Tooltip />

@code {
    private readonly CrmHrHomeSandboxFixture fixture = new();
    private CrmHrHomeSandboxContext context = new();
    private bool observed;

    [Parameter]
    [SupplyParameterFromQuery(Name = "scenario")]
    public string? ScenarioQuery { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "layout")]
    public string? LayoutQuery { get; set; }

    private string FrameClass => context.Layout switch
    {
        CrmHrHomeSandboxLayout.Matched => "crmhr-sandbox__frame crmhr-sandbox__frame--matched",
        CrmHrHomeSandboxLayout.Narrow => "crmhr-sandbox__frame crmhr-sandbox__frame--narrow",
        _ => "crmhr-sandbox__frame"
    };

    private string LayoutLabel => context.Layout switch
    {
        CrmHrHomeSandboxLayout.Matched => "Layout: matched desktop (1600×1000)",
        CrmHrHomeSandboxLayout.Narrow => "Layout: constrained 960px",
        _ => "Layout: flexible"
    };

    protected override void OnParametersSet()
    {
        var next = CrmHrHomeSandboxContext.Parse(ScenarioQuery, LayoutQuery);
        if (observed && next == context)
        {
            return;
        }

        var scenarioChanged = !observed || next.Scenario != context.Scenario;
        observed = true;
        context = next;
        if (scenarioChanged)
        {
            fixture.Apply(context.Scenario);
        }
    }

    private void HandleIntent(CrmHrHomeIntent intent) => fixture.Handle(intent);

    private void ChangeScenario(ChangeEventArgs args)
        => Navigate(context with { Scenario = CrmHrHomeSandboxContext.ParseScenario(args.Value?.ToString()) });

    private void CycleLayout()
        => Navigate(context with
        {
            Layout = context.Layout switch
            {
                CrmHrHomeSandboxLayout.Matched => CrmHrHomeSandboxLayout.Narrow,
                CrmHrHomeSandboxLayout.Narrow => CrmHrHomeSandboxLayout.Flexible,
                _ => CrmHrHomeSandboxLayout.Matched
            }
        });

    // Controls replace the current history entry so a reload restores the scenario and layout.
    private void Navigate(CrmHrHomeSandboxContext next)
        => Navigation.NavigateTo(Navigation.GetUriWithQueryParameters("/crm-hr", next.ToQuery()), replace: true);
}

@page "/crm-hr/financials"
@inject NavigationManager Navigation

<PageTitle>CRM / HR Financials UI sandbox</PageTitle>

<header class="crmhr-sandbox__controls">
    <Stack GapScale="LayoutGap.Small">
        <h1 class="cda-title-xl">CRM / HR Financials sandbox</h1>
        <p>The real CRM Financials projection with the real chart over deterministic local figures and recorded intents. No query service, persistence or CRM write is involved; Retry resolves the failed scenario locally and the period buttons re-project the same snapshot.</p>
        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.Center">
            <label for="crmhr-sandbox-scenario">Scenario</label>
            <select id="crmhr-sandbox-scenario"
                    class="cda-input"
                    value="@CrmHrFinancialsSandboxContext.Token(context.Scenario)"
                    @onchange="ChangeScenario"
                    data-testid="crmhr-sandbox-scenario">
                @foreach (var scenario in Enum.GetValues<CrmHrFinancialsSandboxScenario>())
                {
                    <option value="@CrmHrFinancialsSandboxContext.Token(scenario)">@scenario</option>
                }
            </select>
            <Button Text="@LayoutLabel" ButtonStyle="ButtonStyle.Light" Click="CycleLayout" data-testid="crmhr-sandbox-layout" />
            <a href="/crm-hr" data-testid="crmhr-sandbox-home-link">Home sandbox</a>
            <a href="/crm-hr/account-activity" data-testid="crmhr-sandbox-account-activity-link">Account and activity sandbox</a>
        </Cluster>
        <output aria-live="polite" data-testid="crmhr-sandbox-intent">@fixture.IntentLog</output>
    </Stack>
</header>

<main class="@FrameClass" data-testid="crmhr-sandbox-frame" data-scenario="@CrmHrFinancialsSandboxContext.Token(context.Scenario)">
    <CrmHrFinancialsSurface Presentation="@fixture.Presentation" Intent="HandleIntent" />
</main>

<Tooltip />

@code {
    private readonly CrmHrFinancialsSandboxFixture fixture = new();
    private CrmHrFinancialsSandboxContext context = new();
    private bool observed;

    [Parameter]
    [SupplyParameterFromQuery(Name = "scenario")]
    public string? ScenarioQuery { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "layout")]
    public string? LayoutQuery { get; set; }

    private string FrameClass => context.Layout switch
    {
        CrmHrHomeSandboxLayout.Matched => "crmhr-sandbox__frame crmhr-sandbox__frame--matched",
        CrmHrHomeSandboxLayout.Narrow => "crmhr-sandbox__frame crmhr-sandbox__frame--narrow",
        _ => "crmhr-sandbox__frame"
    };

    private string LayoutLabel => context.Layout switch
    {
        CrmHrHomeSandboxLayout.Matched => "Layout: matched desktop (1600×1000)",
        CrmHrHomeSandboxLayout.Narrow => "Layout: constrained 960px",
        _ => "Layout: flexible"
    };

    protected override void OnParametersSet()
    {
        var next = CrmHrFinancialsSandboxContext.Parse(ScenarioQuery, LayoutQuery);
        if (observed && next == context)
        {
            return;
        }

        var scenarioChanged = !observed || next.Scenario != context.Scenario;
        observed = true;
        context = next;
        if (scenarioChanged)
        {
            fixture.Apply(context.Scenario);
        }
    }

    private void HandleIntent(CrmHrFinancialsIntent intent) => fixture.Handle(intent);

    private void ChangeScenario(ChangeEventArgs args)
        => Navigate(context with { Scenario = CrmHrFinancialsSandboxContext.ParseScenario(args.Value?.ToString()) });

    private void CycleLayout()
        => Navigate(context with
        {
            Layout = context.Layout switch
            {
                CrmHrHomeSandboxLayout.Matched => CrmHrHomeSandboxLayout.Narrow,
                CrmHrHomeSandboxLayout.Narrow => CrmHrHomeSandboxLayout.Flexible,
                _ => CrmHrHomeSandboxLayout.Matched
            }
        });

    // Controls replace the current history entry so a reload restores the scenario and layout.
    private void Navigate(CrmHrFinancialsSandboxContext next)
        => Navigation.NavigateTo(Navigation.GetUriWithQueryParameters("/crm-hr/financials", next.ToQuery()), replace: true);
}

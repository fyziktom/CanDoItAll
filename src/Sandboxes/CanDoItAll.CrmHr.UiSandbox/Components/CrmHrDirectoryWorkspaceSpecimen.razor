@page "/crm-hr/workspaces/directory"
@inject NavigationManager Navigation
@inject CrmHrSandboxPartyStore PartyStore

<PageTitle>CRM / HR Directory workspace UI sandbox</PageTitle>

<header class="crmhr-sandbox__controls">
    <Stack GapScale="LayoutGap.Small">
        <h1 class="cda-title-xl">CRM / HR Directory workspace UI sandbox</h1>
        <p>The real Directory workspace surface with a deterministic sandbox view and recorded intents. No query service, persistence, navigation or agent context is involved; the party catalog and pickers read the shared in-memory party store.</p>
        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.Center">
            <label for="crmhr-sandbox-scenario">Scenario</label>
            <select id="crmhr-sandbox-scenario"
                    class="cda-input"
                    value="@CrmHrDirectoryWorkspaceSandboxContext.Token(context.Scenario)"
                    @onchange="ChangeScenario"
                    data-testid="crmhr-sandbox-scenario">
                @foreach (var scenario in Enum.GetValues<CrmHrDirectoryWorkspaceSandboxScenario>())
                {
                    <option value="@CrmHrDirectoryWorkspaceSandboxContext.Token(scenario)">@scenario</option>
                }
            </select>
            <Button Text="@LayoutLabel" ButtonStyle="ButtonStyle.Light" Click="CycleLayout" data-testid="crmhr-sandbox-layout" />
            <a href="/crm-hr/workspaces/crm" data-testid="crmhr-sandbox-crm-link">CRM workspace sandbox</a>
            <a href="/crm-hr/workspaces/workforce" data-testid="crmhr-sandbox-workforce-link">Workforce workspace sandbox</a>
            <a href="/crm-hr/workspaces/recruiting" data-testid="crmhr-sandbox-recruiting-link">Recruiting workspace sandbox</a>
            <a href="/crm-hr/workspaces/agents" data-testid="crmhr-sandbox-agents-link">Agents workspace sandbox</a>
            <a href="/crm-hr/workspaces/assignments" data-testid="crmhr-sandbox-assignments-link">Assignments workspace sandbox</a>
        </Cluster>
        <output aria-live="polite" data-testid="crmhr-sandbox-intent">@view.IntentLog</output>
    </Stack>
</header>

<main class="@FrameClass" data-testid="crmhr-sandbox-frame" data-scenario="@CrmHrDirectoryWorkspaceSandboxContext.Token(context.Scenario)">
    <CrmHrDirectoryWorkspaceSurface View="@view">
        <SecondaryNavigation>
            @* Host-only navigation: the real CRM / HR area tabs navigate; this sandbox only logs the destination. *@
            <CrmHrAreaTabs SelectedArea="CrmHrWorkspaceArea.Directory" AreaSelected="HandleAreaSelected" />
        </SecondaryNavigation>
        <ActivityTimeline>
            <CrmHrActivitySurface Presentation="@activityFixture.Presentation(CrmHrActivitySandboxHost.Directory)"
                                  Copy="@CrmHrAccountActivitySandboxFixture.Copy(CrmHrActivitySandboxHost.Directory)"
                                  DataTestId="@CrmHrAccountActivitySandboxFixture.TestId(CrmHrActivitySandboxHost.Directory)"
                                  Intent="@(intent => activityFixture.HandleActivity(CrmHrActivitySandboxHost.Directory, intent))" />
        </ActivityTimeline>
    </CrmHrDirectoryWorkspaceSurface>
</main>

<Tooltip />

@code {
    private readonly CrmHrAccountActivitySandboxFixture activityFixture = new();
    private CrmHrDirectorySandboxView view = null!;
    private CrmHrDirectoryWorkspaceSandboxContext context = new();
    private bool observed;

    [Parameter]
    [SupplyParameterFromQuery(Name = "scenario")]
    public string? ScenarioQuery { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "layout")]
    public string? LayoutQuery { get; set; }

    private string FrameClass => context.Layout switch
    {
        CrmHrHomeSandboxLayout.Matched => "crmhr-sandbox__frame crmhr-sandbox__frame--matched",
        CrmHrHomeSandboxLayout.Narrow => "crmhr-sandbox__frame crmhr-sandbox__frame--narrow",
        _ => "crmhr-sandbox__frame"
    };

    private string LayoutLabel => context.Layout switch
    {
        CrmHrHomeSandboxLayout.Matched => "Layout: matched desktop (1600×1000)",
        CrmHrHomeSandboxLayout.Narrow => "Layout: constrained 960px",
        _ => "Layout: flexible"
    };

    protected override void OnInitialized()
    {
        view = new CrmHrDirectorySandboxView(PartyStore) { RenderRequested = () => InvokeAsync(StateHasChanged) };
        activityFixture.Apply(CrmHrAccountActivitySandboxScenario.Populated);
    }

    protected override void OnParametersSet()
    {
        var next = CrmHrDirectoryWorkspaceSandboxContext.Parse(ScenarioQuery, LayoutQuery);
        if (observed && next == context)
        {
            return;
        }

        var scenarioChanged = !observed || next.Scenario != context.Scenario;
        observed = true;
        context = next;
        if (scenarioChanged)
        {
            view.Apply(context.Scenario);
        }
    }

    private void HandleAreaSelected(CrmHrRouteDefinition route) => view.LogNavigation(route.Route);

    private void ChangeScenario(ChangeEventArgs args)
        => Navigate(context with { Scenario = CrmHrDirectoryWorkspaceSandboxContext.ParseScenario(args.Value?.ToString()) });

    private void CycleLayout()
        => Navigate(context with
        {
            Layout = context.Layout switch
            {
                CrmHrHomeSandboxLayout.Matched => CrmHrHomeSandboxLayout.Narrow,
                CrmHrHomeSandboxLayout.Narrow => CrmHrHomeSandboxLayout.Flexible,
                _ => CrmHrHomeSandboxLayout.Matched
            }
        });

    // Controls replace the current history entry so a reload restores the scenario and layout.
    private void Navigate(CrmHrDirectoryWorkspaceSandboxContext next)
        => Navigation.NavigateTo(Navigation.GetUriWithQueryParameters("/crm-hr/workspaces/directory", next.ToQuery()), replace: true);
}

@page "/crm-hr/workspaces/agents"
@inject NavigationManager Navigation

<PageTitle>CRM / HR Agents workspace UI sandbox</PageTitle>

<header class="crmhr-sandbox__controls">
    <Stack GapScale="LayoutGap.Small">
        <h1 class="cda-title-xl">CRM / HR Agents workspace UI sandbox</h1>
        <p>The real Agents workspace surface with a deterministic sandbox view and recorded intents. No query service, persistence, navigation or live agent context is involved; the projected agent catalog is a small local list the sandbox view owns end to end. This surface has no create action and its record dialog owns its own tab index, so the scenario list has no NewDraft or NonDefaultSection token.</p>
        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.Center">
            <label for="crmhr-sandbox-scenario">Scenario</label>
            <select id="crmhr-sandbox-scenario"
                    class="cda-input"
                    value="@CrmHrAgentsWorkspaceSandboxContext.Token(context.Scenario)"
                    @onchange="ChangeScenario"
                    data-testid="crmhr-sandbox-scenario">
                @foreach (var scenario in Enum.GetValues<CrmHrAgentsWorkspaceSandboxScenario>())
                {
                    <option value="@CrmHrAgentsWorkspaceSandboxContext.Token(scenario)">@scenario</option>
                }
            </select>
            <Button Text="@LayoutLabel" ButtonStyle="ButtonStyle.Light" Click="CycleLayout" data-testid="crmhr-sandbox-layout" />
            <a href="/crm-hr/workspaces/directory" data-testid="crmhr-sandbox-directory-link">Directory workspace sandbox</a>
            <a href="/crm-hr/workspaces/crm" data-testid="crmhr-sandbox-crm-link">CRM workspace sandbox</a>
            <a href="/crm-hr/workspaces/workforce" data-testid="crmhr-sandbox-workforce-link">Workforce workspace sandbox</a>
            <a href="/crm-hr/workspaces/recruiting" data-testid="crmhr-sandbox-recruiting-link">Recruiting workspace sandbox</a>
            <a href="/crm-hr/workspaces/assignments" data-testid="crmhr-sandbox-assignments-link">Assignments workspace sandbox</a>
            <a href="/crm-hr/workspaces/agent-evidence" data-testid="crmhr-sandbox-agent-evidence-link">Agent evidence sandbox</a>
        </Cluster>
        <output aria-live="polite" data-testid="crmhr-sandbox-intent">@view.IntentLog</output>
    </Stack>
</header>

<main class="@FrameClass" data-testid="crmhr-sandbox-frame" data-scenario="@CrmHrAgentsWorkspaceSandboxContext.Token(context.Scenario)">
    <CrmHrAgentsWorkspaceSurface View="@view">
        <SecondaryNavigation>
            @* Host-only navigation: the real CRM / HR area tabs navigate; this sandbox only logs the destination. *@
            <CrmHrAreaTabs SelectedArea="CrmHrWorkspaceArea.Agents" AreaSelected="HandleAreaSelected" />
        </SecondaryNavigation>
        <RecruitingEvidence Context="technicalAgentId">
            @* The record dialog's evidence tab renders the same evidence surface as the standalone sandbox; this
               sandbox has a single deterministic evidence candidate regardless of the technical agent id. *@
            <AgentRecruitingEvidenceSurface View="@evidenceView" />
        </RecruitingEvidence>
    </CrmHrAgentsWorkspaceSurface>
</main>

<Tooltip />

@code {
    private CrmHrAgentsSandboxView view = null!;
    private AgentRecruitingEvidenceSandboxView evidenceView = null!;
    private CrmHrAgentsWorkspaceSandboxContext context = new();
    private bool observed;

    [Parameter]
    [SupplyParameterFromQuery(Name = "scenario")]
    public string? ScenarioQuery { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "layout")]
    public string? LayoutQuery { get; set; }

    private string FrameClass => context.Layout switch
    {
        CrmHrHomeSandboxLayout.Matched => "crmhr-sandbox__frame crmhr-sandbox__frame--matched",
        CrmHrHomeSandboxLayout.Narrow => "crmhr-sandbox__frame crmhr-sandbox__frame--narrow",
        _ => "crmhr-sandbox__frame"
    };

    private string LayoutLabel => context.Layout switch
    {
        CrmHrHomeSandboxLayout.Matched => "Layout: matched desktop (1600×1000)",
        CrmHrHomeSandboxLayout.Narrow => "Layout: constrained 960px",
        _ => "Layout: flexible"
    };

    protected override void OnInitialized()
    {
        view = new CrmHrAgentsSandboxView { RenderRequested = () => InvokeAsync(StateHasChanged) };
        evidenceView = new AgentRecruitingEvidenceSandboxView { RenderRequested = () => InvokeAsync(StateHasChanged) };
        evidenceView.Apply(AgentRecruitingEvidenceSandboxScenario.Ready);
    }

    protected override void OnParametersSet()
    {
        var next = CrmHrAgentsWorkspaceSandboxContext.Parse(ScenarioQuery, LayoutQuery);
        if (observed && next == context)
        {
            return;
        }

        var scenarioChanged = !observed || next.Scenario != context.Scenario;
        observed = true;
        context = next;
        if (scenarioChanged)
        {
            view.Apply(context.Scenario);
        }
    }

    private void HandleAreaSelected(CrmHrRouteDefinition route) => view.LogNavigation(route.Route);

    private void ChangeScenario(ChangeEventArgs args)
        => Navigate(context with { Scenario = CrmHrAgentsWorkspaceSandboxContext.ParseScenario(args.Value?.ToString()) });

    private void CycleLayout()
        => Navigate(context with
        {
            Layout = context.Layout switch
            {
                CrmHrHomeSandboxLayout.Matched => CrmHrHomeSandboxLayout.Narrow,
                CrmHrHomeSandboxLayout.Narrow => CrmHrHomeSandboxLayout.Flexible,
                _ => CrmHrHomeSandboxLayout.Matched
            }
        });

    // Controls replace the current history entry so a reload restores the scenario and layout.
    private void Navigate(CrmHrAgentsWorkspaceSandboxContext next)
        => Navigation.NavigateTo(Navigation.GetUriWithQueryParameters("/crm-hr/workspaces/agents", next.ToQuery()), replace: true);
}

<SurfaceCard data-testid="execution-workflow-specimen">
    <Stack GapScale="LayoutGap.Small">
        <TextBlock TextStyle="TextStyle.H6" Value="@Name" />
        <DropDown TValue="ExecutionScenario" Data="@(Enum.GetValues<ExecutionScenario>())" @bind-Value="scenario"
            Change="@(_ => ChangeScenario())" aria-label="Workflow scenario" Style="width:15rem" />
        <TextBlock TextStyle="TextStyle.Note" Value="@ExecutionScenarioDescriptions.Describe(scenario)" data-testid="execution-scenario-description" />
        <Stack Orientation="Orientation.Horizontal" GapScale="LayoutGap.Small">
            <Button Text="Add workflow" Click="OpenAdd" />
            <Button Text="Review start" Click="OpenStart" />
            <Button Text="Toggle busy" Click="ToggleBusy" />
            <Button Text="Unknown result" Click="Unknown" />
        </Stack>
        <TextBlock TextStyle="TextStyle.Note" Value="@receipt" data-testid="execution-workflow-receipt" />
    </Stack>
    <div class="execution-scenario-canvas">
        @if (add is { } input) {
            <WorkflowAddDialog @key="input.OpeningId" View="input" Actions="@AddActions(input.OpeningId)" />
        }
        @if (start is { } run) {
            <WorkflowStartDialog @key="run.OpeningId" View="run" Actions="@StartActions(run.OpeningId)" />
        }
    </div>
</SurfaceCard>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    private readonly WorkflowId workflowId = WorkflowId.New();
    private readonly WorkflowVersionId versionId = WorkflowVersionId.New();
    private WorkflowAddView? add;
    private WorkflowStartView? start;
    private string receipt = "No scenario action yet.";
    private ExecutionScenario scenario;

    private void ChangeScenario() {
        if (start is not null) {
            OpenStart();
        } else {
            OpenAdd();
        }
    }

    private void OpenAdd() {
        start = null;
        add = new(Guid.NewGuid(), Name, [new(workflowId, versionId, "Artifact review", "Saved synthetic Workflow choice",
            WorkflowLifecycleStatus.Active, WorkflowRuntimeBackendKind.InProcess, true, string.Empty)], workflowId, versionId,
            new(false, true, "{}", [new(WorkflowInputSourceKind.FilePath, "source", "Additional source", "")]),
            new([new("Project", Name, Enumerable.Range(1, 30).Select(i => new WorkflowPreviewRow($"Input {i}", $"Preserved synthetic value {i}")).ToArray())]),
            false, false, string.Empty);
        add = scenario switch {
            ExecutionScenario.Empty => add with { Options = [], SelectedWorkflowId = null, SelectedVersionId = null },
            ExecutionScenario.Unavailable => add with { Options = add.Options.Select(option => option with { IsSelectable = false, DisabledReason = "Saved version unavailable." }).ToArray(), SelectedWorkflowId = null },
            ExecutionScenario.Loading or ExecutionScenario.Pending => add with { IsBusy = true },
            ExecutionScenario.Error => add with { Error = "Synthetic options read failed. Select Normal to retry." },
            ExecutionScenario.InvalidInput => add with { InputSettings = add.InputSettings with { ManualInputJson = "{ invalid raw input" }, Error = "Manual input is not valid JSON." },
            ExecutionScenario.Conflict => add with { RequiresObservation = true, Error = "The original source changed. Observe the retained original result." },
            ExecutionScenario.Accepted or ExecutionScenario.ObservationRequired => add with { RequiresObservation = true, Error = "Original created identity retained; observation required." },
            _ => add
        };
    }

    private void OpenStart() {
        add = null;
        start = new(Guid.NewGuid(), Name, new("Ready", 0, 2, "Original saved Workflow version"),
            [new(new("attach-output"), "Attach output", "Preview without the selected structure write.", false)],
            WorkflowRuntimeBackendKind.InProcess, WorkflowRuntimeBackendKind.InProcess,
            [new(WorkflowRuntimeBackendKind.InProcess, "In process", true)], string.Empty, false, false, string.Empty);
        start = scenario switch {
            ExecutionScenario.Empty => start with { Status = null, SimulationOptions = [] },
            ExecutionScenario.Unavailable => start with { BackendWarning = "The saved backend is unavailable in this synthetic host." },
            ExecutionScenario.Loading or ExecutionScenario.Pending => start with { IsBusy = true },
            ExecutionScenario.Error or ExecutionScenario.InvalidInput => start with { Error = "Synthetic original start was rejected before dispatch." },
            ExecutionScenario.Conflict => start with { RequiresObservation = true, Error = "Source changed after original acceptance; observe original intent." },
            ExecutionScenario.Accepted or ExecutionScenario.ObservationRequired => start with { RequiresObservation = true, Status = new("Accepted", 1, 2, "Original synthetic run identity retained.") },
            _ => start
        };
    }

    private WorkflowAddActions AddActions(Guid opening) => new(
        id => ChangeAdd(opening, view => view with { SelectedWorkflowId = id }),
        enabled => ChangeAdd(opening, view => view with { InputSettings = view.InputSettings with { IncludeParentSubtree = enabled } }),
        enabled => ChangeAdd(opening, view => view with { InputSettings = view.InputSettings with { IncludeAssets = enabled } }),
        text => ChangeAdd(opening, view => view with { InputSettings = view.InputSettings with { ManualInputJson = text } }),
        kind => ChangeSource(opening, source => source with { Kind = kind }),
        key => ChangeSource(opening, source => source with { Key = key }),
        label => ChangeSource(opening, source => source with { Label = label }),
        value => ChangeSource(opening, source => source with { Value = value }),
        () => ChangeAdd(opening, view => {
            receipt = $"Scenario submit from {opening:N}; raw JSON: {view.InputSettings.ManualInputJson}";
            return view with { RequiresObservation = true, Error = "Synthetic receipt retained. No native write was performed." };
        }),
        () => {
            if (add?.OpeningId == opening) {
                add = null;
            }
            return InvokeAsync(StateHasChanged);
        });

    private WorkflowStartActions StartActions(Guid opening) => new(change => {
        if (start is { IsBusy: false, RequiresObservation: false } current && current.OpeningId == opening) {
            start = current with { SimulationOptions = current.SimulationOptions.Select(option => option.NodeId == change.NodeId
                ? option with { IsEnabled = change.IsEnabled } : option).ToArray() };
        }
        return InvokeAsync(StateHasChanged);
    }, () => {
        if (start is { IsBusy: false } current && current.OpeningId == opening) {
            receipt = $"Scenario {(current.RequiresObservation ? "observation" : "start review")} from {opening:N}. No runtime dispatched.";
            start = current with { RequiresObservation = true };
        }
        return InvokeAsync(StateHasChanged);
    }, () => {
        if (start?.OpeningId == opening) {
            start = null;
        }
        return InvokeAsync(StateHasChanged);
    });

    private Task ChangeSource(Guid opening, Func<WorkflowInputSourceView, WorkflowInputSourceView> update)
        => ChangeAdd(opening, view => view with { InputSettings = view.InputSettings with {
            AdditionalSources = [update(view.InputSettings.AdditionalSources[0]), .. view.InputSettings.AdditionalSources.Skip(1)]
        } });

    private Task ChangeAdd(Guid opening, Func<WorkflowAddView, WorkflowAddView> update) {
        if (add is { IsBusy: false, RequiresObservation: false } current && current.OpeningId == opening) {
            add = update(current);
        }
        return InvokeAsync(StateHasChanged);
    }

    private void ToggleBusy() {
        if (add is not null) {
            add = add with { IsBusy = !add.IsBusy };
        }
        if (start is not null) {
            start = start with { IsBusy = !start.IsBusy };
        }
    }

    private void Unknown() {
        if (add is not null) {
            add = add with { RequiresObservation = true, Error = "The original effect is unconfirmed." };
        }
        if (start is not null) {
            start = start with { RequiresObservation = true, Error = "Observe the original start." };
        }
    }
}

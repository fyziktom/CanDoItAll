@using CanDoItAll.Workbench.Operators.UI.Secrets
@using CanDoItAll.Modules.Security
<SurfaceCard data-testid="@($"operators-secret-{Name.ToLowerInvariant()}")">
    <Stack GapScale="LayoutGap.Medium">
        <TextBlock TextStyle="TextStyle.H4" Value="@($"{Name} protected-reference specimen")" />
        <Cluster>
            <FormField Text="Scenario">
                <InputSelect class="cda-input" @bind-Value="Scenario" data-testid="operators-secret-scenario">
                    @foreach (var scenario in Enum.GetValues<SecretScenarioKind>()) {
                        <option value="@scenario">@scenario</option>
                    }
                </InputSelect>
            </FormField>
            <Button Text="Open new reference" Click="@(() => Open(false))" />
            <Button Text="Open edit reference" Click="@(() => Open(true))" />
        </Cluster>
        <TextBlock Value="@($"Fixture creates {fixture?.Creates ?? 0}; fixture references {fixture?.References ?? 0}.")" />
    </Stack>
</SurfaceCard>
@if (fixture is { } opening && !opening.State.IsRetired) {
    <SecretReferenceEditor @key="opening.State.OpeningId" State="@opening.State"
        Create="@((input, model) => RunAsync(opening, () => opening.CreateAsync(input, model)))"
        Use="@(input => RunAsync(opening, () => opening.UseAsync(input)))"
        Retry="@(() => RunAsync(opening, opening.RetryAsync))" Finish="@(() => RunAsync(opening, opening.FinishAsync))"
        Close="@(() => opening.State.Retire())" />
}

@code {
    [Parameter] public string Name { get; set; } = "Specimen";
    private SecretScenarioKind Scenario { get; set; }
    private SecretScenario? fixture;
    private void Open(bool edit) {
        fixture?.State.Retire();
        fixture = new(Scenario, edit);
    }
    private async Task RunAsync(SecretScenario opening, Func<Task> action) {
        await action();
        if (ReferenceEquals(opening, fixture)) {
            await InvokeAsync(StateHasChanged);
        }
    }
}

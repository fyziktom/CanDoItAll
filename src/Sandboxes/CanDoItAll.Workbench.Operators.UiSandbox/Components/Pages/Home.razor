@page "/"
<PageTitle>Workbench operators sandbox</PageTitle>
<main class="operators-sandbox" data-testid="operators-sandbox">
    <Stack GapScale="LayoutGap.Large">
        <PageHeader Title="Workbench operators" Description="Independent renderer scenarios. Fixture callbacks do not create native parties, vault records, or processes." />
        <Grid ColumnTemplate="repeat(2,minmax(0,1fr))" Gap="LayoutGap.Large">
            <SecretSpecimen Name="Left" />
            <SecretSpecimen Name="Right" />
        </Grid>
        <Grid ColumnTemplate="repeat(2,minmax(0,1fr))" Gap="LayoutGap.Large">
            <PartySpecimen Name="Left" />
            <PartySpecimen Name="Right" />
        </Grid>
    </Stack>
    <DialogHost />
</main>

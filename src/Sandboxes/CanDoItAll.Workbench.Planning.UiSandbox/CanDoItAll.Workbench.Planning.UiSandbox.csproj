<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <CopyRepositoryTemplatesToOutput>false</CopyRepositoryTemplatesToOutput>
    <PlanningAssetMode Condition="'$(PlanningAssetMode)' == ''">Parity</PlanningAssetMode>
    <OutputPath>bin/$(PlanningAssetMode)/$(Configuration)/</OutputPath>
    <IntermediateOutputPath>obj/$(PlanningAssetMode)/$(Configuration)/</IntermediateOutputPath>
    <DefineConstants Condition="'$(PlanningAssetMode)' == 'Fast'">$(DefineConstants);PLANNING_FAST_ASSETS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../UI/CanDoItAll.Workbench.Planning.UI/CanDoItAll.Workbench.Planning.UI.csproj" />
    <Content Remove="wwwroot/css/planning-fast.css" Condition="'$(PlanningAssetMode)' != 'Fast'" />
    <Content Include="../../App/CanDoItAll.Web/wwwroot/css/output.css" Link="wwwroot/css/output.css"
             ContentRoot="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../App/CanDoItAll.Web/wwwroot/'))"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             Condition="'$(PlanningAssetMode)' == 'Parity'" />
  </ItemGroup>
  <Target Name="RequirePlanningTheme" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(PlanningAssetMode)' != 'Parity' and '$(PlanningAssetMode)' != 'Fast'"
           Text="PlanningAssetMode must be Parity or Fast." />
    <Error Condition="'$(PlanningAssetMode)' == 'Parity' and !Exists('$(MSBuildProjectDirectory)/../../App/CanDoItAll.Web/wwwroot/css/output.css')"
           Text="Parity CSS is missing. From the repository root run npm ci --prefix Tailwind, then npm run tailwind:build." />
    <Error Condition="'$(PlanningAssetMode)' == 'Fast' and !Exists('$(MSBuildProjectDirectory)/wwwroot/css/planning-fast.css')"
           Text="Fast CSS is missing. From the repository root run npm ci --prefix Tailwind, then npm run planning:css:build." />
  </Target>
</Project>

@using CanDoItAll.AgentFramework.Llm.SimpleChats.UI
<PageTitle>Simple Chat definition editor sandbox</PageTitle>
<header class="catalog-sandbox__controls">
    <h1 class="cda-title-xl">Simple Chat definition editor sandbox</h1>
    <label for="definition-editor-scenario">Scenario</label>
    <select id="definition-editor-scenario" class="cda-input" value="@fixture.Scenario" @onchange="ChangeScenario">
        @foreach (var scenario in Enum.GetValues<DefinitionEditorScenario>()) {
            <option value="@scenario">@scenario</option>
        }
    </select>
    <output aria-live="polite" data-testid="sandbox-intent">@fixture.IntentLog</output>
</header>
<main class="catalog-sandbox__frame" data-testid="sandbox-definition-editor-specimen" data-scenario="@fixture.Scenario">
    @if (fixture.IsOpen) {
        <LlmChatDefinitionEditorSurface Presentation="fixture.Presentation" Intent="fixture.Apply" />
    } else {
        <Button Text="Reopen editor" Click="@(() => fixture.SetScenario(fixture.Scenario))" />
    }
</main>
<Tooltip />
@code {
    [Parameter] public string? ScenarioQuery { get; set; }
    private readonly DefinitionEditorSandboxFixture fixture = new();
    private string? observedQuery;
    protected override void OnParametersSet() {
        if (observedQuery == ScenarioQuery) {
            return;
        }
        observedQuery = ScenarioQuery;
        fixture.SetScenario(Enum.TryParse<DefinitionEditorScenario>(ScenarioQuery, true, out var scenario)
            ? scenario : DefinitionEditorScenario.Existing);
    }
    private void ChangeScenario(ChangeEventArgs args) => fixture.SetScenario(Enum.Parse<DefinitionEditorScenario>(args.Value!.ToString()!));
}

@using CanDoItAll.AgentFramework.Llm.SimpleChats.UI
<PageTitle>Simple Chat definitions sandbox</PageTitle>
<header class="catalog-sandbox__controls">
    <h1 class="cda-title-xl">Simple Chat definitions sandbox</h1>
    <label for="definition-catalog-scenario">Scenario</label>
    <select id="definition-catalog-scenario" class="cda-input" value="@fixture.Scenario" @onchange="ChangeScenario">
        @foreach (var scenario in Enum.GetValues<DefinitionCatalogScenario>()) {
            <option value="@scenario">@scenario</option>
        }
    </select>
    <output aria-live="polite" data-testid="sandbox-intent">@fixture.IntentLog</output>
</header>
<main class="catalog-sandbox__frame" data-testid="sandbox-definition-catalog-specimen">
    <LlmChatDefinitionCatalogSurface Presentation="fixture.Presentation" Limits="DefinitionCatalogSandboxFixture.Limits" OnIntent="fixture.Apply" />
</main>
<Tooltip />
@code {
    [Parameter] public string? ScenarioQuery { get; set; }
    private readonly DefinitionCatalogSandboxFixture fixture = new();
    private string? observedQuery;
    protected override void OnParametersSet() {
        if (observedQuery == ScenarioQuery) {
            return;
        }
        observedQuery = ScenarioQuery;
        fixture.SetScenario(Enum.TryParse<DefinitionCatalogScenario>(ScenarioQuery, true, out var scenario)
            ? scenario : DefinitionCatalogScenario.Manageable);
    }
    private void ChangeScenario(ChangeEventArgs args) => fixture.SetScenario(Enum.Parse<DefinitionCatalogScenario>(args.Value!.ToString()!));
}

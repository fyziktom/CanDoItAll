@using CanDoItAll.AgentFramework.UiSandbox
@inject IWebHostEnvironment Environment

<!DOCTYPE html>
<html lang="en" data-asset-mode="@(Environment.IsDevelopment() ? CatalogAssets.Mode.ToString() : null)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["_content/CanDoItAll.Components.BaseLib/css/material-symbols.css"]" />
    <link rel="stylesheet" href="@Assets["_content/CanDoItAll.Components.BaseLib/css/output.css"]" />
    <link rel="stylesheet" href="@Assets[CatalogAssets.ThemePath]" />
    <link rel="stylesheet" href="@Assets["sandbox.css"]" />
    <link rel="stylesheet" href="@Assets["CanDoItAll.AgentFramework.UiSandbox.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>

@page "/adjuncts"
@using System.Security.Cryptography
@using CanDoItAll.AgentFramework.Components
@using CanDoItAll.AgentFramework.Models
@using CanDoItAll.AgentFramework.UI.Avatars
@using CanDoItAll.AgentFramework.UI.Chat
@using CanDoItAll.AgentFramework.UI.Runtime
@using CanDoItAll.Conversations.Components
@using CanDoItAll.Conversations.Components.Presentation
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Agents runtime and conversation sandbox</PageTitle>
<Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch" Class="p-6">
    <PageHeader Title="Agents runtime and conversation sandbox" Description="Actual adjunct renderers with owned sample data and deterministic image operations." Compact="true" />
    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
        @foreach (var item in Enum.GetValues<AdjunctScenario>()) {
            <Button Text="@item.ToString()" Click="@(() => scenario = item)" data-testid="@($"adjunct-{item}")" />
        }
        <Button Text="Open log" Click="@(() => showLog = true)" data-testid="adjunct-open-log" />
        <Button Text="Close choices" Click="@(() => showClose = true)" data-testid="adjunct-open-close" />
        <Button Text="Second instance" Click="@(() => showSecond = !showSecond)" data-testid="adjunct-second" />
        <CheckboxOption TValue="bool" @bind-Value="participantDisabled" Text="Participant busy / disabled" data-testid="adjunct-participant-disabled" />
        <CheckboxOption TValue="bool" @bind-Value="attachmentDisabled" Text="Disable attachment" data-testid="adjunct-attachment-disabled" />
    </Cluster>
    <output data-testid="adjunct-intent" aria-live="polite">@intent</output>
    <SurfaceCard>
        <AgentConversationContextSurface State="context" Intent="ContextIntent">
            <AgentActivitySurface State="@(new(new(Guid.Parse("ac100000-0000-4000-8000-000000000033")), scenario.ToString(), AdjunctSandboxFixture.Tone(scenario), "Projected activity remains separate from the saved run.", scenario == AdjunctScenario.Partial))" />
            <Cluster Gap="LayoutGap.Small">
                <AgentChatActionsSurface State="actions" Intent="@(value => intent = $"Sample {value.Action} / {value.Origin.RunId}")" />
                <AgentImageAttachmentPicker Generation="1" Disabled="attachmentDisabled" Selected="ReadAttachmentAsync" />
                <AvatarPickerSurface Value="@avatar" ValueChanged="@(value => avatar = value)" EntityName="Owned sample" Operations="avatarOperations"
                                     Notice="@(value => intent = $"{value.Kind}: {value.Detail}")" />
            </Cluster>
        </AgentConversationContextSurface>
        <Grid ColumnsLg="2" Gap="LayoutGap.Medium">
            <ConversationParticipantCard Participant="Participant" ShellTestId="adjunct-participant-card" SelectTestId="adjunct-participant-select"
                                         Selected="@(_ => intent = "Sample participant selected")"
                                         FavoriteToggled="@(_ => intent = "Sample favorite toggled")" />
            <ConversationParticipantCompactListItem Item="CompactParticipant"
                                                    Selected="@(_ => intent = "Sample compact participant selected")"
                                                    ActionRequested="@(_ => intent = "Sample history requested")" />
        </Grid>
    </SurfaceCard>
    <AgentRuntimeDetailsSurface State="AdjunctSandboxFixture.Runtime(scenario)" />
    @if (showSecond) {
        <SurfaceCard data-testid="adjunct-independent">
            <PageHeader Title="Independent completed run" Description="Closing the first log or context choices leaves this view intact." Compact="true" />
            <AgentExecutionLogSurface State="@(AdjunctSandboxFixture.Log(AdjunctScenario.Completed) with { Entries = [AdjunctSandboxFixture.Log(AdjunctScenario.Completed).Entries[0] with { RunId = secondRun }] })" />
        </SurfaceCard>
    }
</Stack>
@if (showLog) {
    <Dialog IsOpen="true" Title="Execution log" Size="ModalSize.Wide" TestId="adjunct-log-dialog" OnClose="@(() => showLog = false)">
        <ChildContent><AgentExecutionLogSurface State="AdjunctSandboxFixture.Log(scenario)" /></ChildContent>
        <Footer><Button Text="Close log" Click="@(() => showLog = false)" data-testid="adjunct-close-log" /></Footer>
    </Dialog>
}
@if (showClose) {
    <Dialog IsOpen="true" Title="Close active chat" Size="ModalSize.Compact" TestId="adjunct-choice-dialog" OnClose="@(() => showClose = false)">
        <ChildContent><AgentFloatingCloseSurface State="close" Intent="CloseIntent" /></ChildContent>
    </Dialog>
}
<Tooltip />

@code {
    private AdjunctScenario scenario;
    private string intent = "No sample action yet.";
    private string avatar = string.Empty;
    private bool showLog;
    private bool showClose;
    private bool showSecond;
    private bool participantDisabled;
    private bool attachmentDisabled;
    private static readonly ConversationPresentationKey ParticipantKey = new("adjunct-participant");
    private static readonly ConversationPresentationKey HistoryActionKey = new("adjunct-history");
    private ConversationParticipantPresentation Participant => new(ParticipantKey, "Review colleague",
        subtitle: "Document reviewer", summary: "Reviews the original document and explains the result.",
        avatarFallbackText: "RC", badges: [new(participantDisabled ? "Preparing" : "Ready", PresentationTone.Info)],
        metadata: [new("Local fixture")], favorite: new(true, participantDisabled, "Mark favorite", "Remove favorite", "adjunct-participant-favorite"),
        isSelected: true, isBusy: participantDisabled, isDisabled: participantDisabled);
    private ConversationParticipantCompactItemPresentation CompactParticipant => new(Participant,
        [new(HistoryActionKey, "Open history", "history", "adjunct-participant-history", participantDisabled)],
        "adjunct-participant-compact", "adjunct-participant-compact-select");
    private readonly Guid secondRun = new("ac100000-0000-4000-8000-000000000034");
    private AgentConversationContextState context = new(new(Guid.NewGuid(), new(Guid.NewGuid()), Guid.NewGuid(), null, null),
        "Owned source A", true, false, "Following: source A / files", "Next turn: source B / document");
    private readonly AgentFloatingCloseState close = new(Guid.NewGuid(), new(Guid.NewGuid()), "Owned sample", true, true);
    private readonly AgentChatActionState actions = new(new(1, Guid.NewGuid(), Guid.NewGuid(), AdjunctSandboxFixture.RunId), null, false, false, true, false, true, false, true);
    private static readonly AvatarPickerOperations avatarOperations = new(
        _ => Task.FromResult<AvatarGenerationSource?>(null),
        (_, _) => Task.FromException<AvatarGenerationResult>(new InvalidOperationException("No image service is configured in this sample.")),
        ReadImageAsync);

    private void ContextIntent(AgentConversationContextIntent value) {
        if (value.Origin != context.Origin) {
            return;
        }
        var detached = value.Mode == AgentConversationContextMode.Detached;
        context = context with { Detached = detached, Affinity = detached ? "Detached from application context" : "Following: source B / document", PendingContext = null };
        intent = $"Sample {value.Mode} / original handle {value.Origin.HandleId}";
    }

    private void CloseIntent(AgentFloatingCloseIntent value) {
        showClose = false;
        intent = $"Sample {value.Choice} / original handle {value.HandleId}. Durable approval remains undecided.";
    }

    private async Task ReadAttachmentAsync(AgentImageSelection selection) {
        foreach (var file in selection.Files.GetMultipleFiles(4)) {
            await using var stream = file.OpenReadStream(AgentAvatarImagePolicy.MaxAvatarBytes);
            intent = $"Sample file {file.Name} / {file.Size} bytes / SHA256 {Convert.ToHexString(await SHA256.HashDataAsync(stream))} / generation {selection.Generation}";
        }
    }

    private static async Task<string> ReadImageAsync(IBrowserFile file, CancellationToken token) {
        await using var stream = file.OpenReadStream(AgentAvatarImagePolicy.MaxAvatarBytes, token);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory, token);
        return AgentAvatarImagePolicy.BuildDataUrl(file.ContentType, memory.ToArray());
    }
}

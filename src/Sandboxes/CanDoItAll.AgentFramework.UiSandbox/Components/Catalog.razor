@page "/"
@page "/agents"

@if (SandboxSpecimens.Parse(SpecimenQuery) == SandboxSpecimen.Capabilities) {
    <CapabilitiesSpecimen ScenarioQuery="@ScenarioQuery" LayoutQuery="@LayoutQuery" AgentQuery="@AgentQuery" />
}
else if (SandboxSpecimens.Parse(SpecimenQuery) == SandboxSpecimen.Overview) {
    <OverviewSpecimen ScenarioQuery="@ScenarioQuery" LayoutQuery="@LayoutQuery" UsageScopeQuery="@UsageScopeQuery" />
}
else if (SandboxSpecimens.Parse(SpecimenQuery) == SandboxSpecimen.Governance) {
    <GovernanceSpecimen ScenarioQuery="@ScenarioQuery" LayoutQuery="@LayoutQuery" />
}
else if (SandboxSpecimens.Parse(SpecimenQuery) == SandboxSpecimen.Diagnostics) {
    <DiagnosticsSpecimen ScenarioQuery="@ScenarioQuery" />
}
else if (SandboxSpecimens.Parse(SpecimenQuery) == SandboxSpecimen.History) {
    <HistorySpecimen ScenarioQuery="@ScenarioQuery" />
}
else {
    <CatalogSpecimen ScenarioQuery="@ScenarioQuery" LayoutQuery="@LayoutQuery" AgentQuery="@AgentQuery" TeamQuery="@TeamQuery" />
}

@code {
    [SupplyParameterFromQuery(Name = "usageScope")]
    public string? UsageScopeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "specimen")]
    public string? SpecimenQuery { get; set; }

    [SupplyParameterFromQuery(Name = "scenario")]
    public string? ScenarioQuery { get; set; }

    [SupplyParameterFromQuery(Name = "layout")]
    public string? LayoutQuery { get; set; }

    [SupplyParameterFromQuery(Name = "agentId")]
    public string? AgentQuery { get; set; }

    [SupplyParameterFromQuery(Name = "teamId")]
    public string? TeamQuery { get; set; }
}

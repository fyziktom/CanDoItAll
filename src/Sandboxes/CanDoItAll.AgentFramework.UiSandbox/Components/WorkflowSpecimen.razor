@using CanDoItAll.AgentFramework.Workflows.UI
<PageTitle>Workflows sandbox</PageTitle>
<header class="catalog-sandbox__controls">
    <h1 class="cda-title-xl">Workflows sandbox</h1>
    <label for="workflow-scenario">Scenario</label>
    <select id="workflow-scenario" class="cda-input" value="@fixture.Scenario" @onchange="ChangeScenario">
        @foreach (var scenario in Enum.GetValues<WorkflowScenario>()) {
            <option value="@scenario">@scenario</option>
        }
    </select>
    <output aria-live="polite" data-testid="sandbox-intent">@fixture.IntentLog</output>
</header>
<main class="catalog-sandbox__frame" data-testid="sandbox-workflows-specimen" data-scenario="@fixture.Scenario">
    <WorkflowShellSurface Presentation="fixture.Shell" Catalog="fixture.Catalog" History="fixture.History" Intent="fixture.Apply">
        <Dashboard><WorkflowOverviewSurface Presentation="fixture.Overview" Intent="fixture.Query" /></Dashboard>
        <Analytics><WorkflowAnalyticsSurface Presentation="fixture.Analytics" Intent="fixture.Query" /></Analytics>
        <Editor><EmptyState Title="Workflow canvas is hosted in the application" Description="This sample exposes presentation intents." /></Editor>
        <Overlays>
            @if (fixture.TemplatesOpen) {
                <Dialog IsOpen="true" Title="Workflow templates" OnClose="fixture.CloseTemplates" Size="ModalSize.Wide" TestId="workflows-template-catalogue-dialog">
                    <WorkflowTemplateCatalogSurface Presentation="fixture.Templates" Intent="fixture.Apply" />
                </Dialog>
            }
        </Overlays>
    </WorkflowShellSurface>
</main>
@code {
    [Parameter] public string? ScenarioQuery { get; set; }
    private readonly WorkflowSandboxFixture fixture = new();
    private string? observed;
    protected override void OnParametersSet() {
        if (observed == ScenarioQuery) {
            return;
        }

        observed = ScenarioQuery;
        fixture.SetScenario(Enum.TryParse<WorkflowScenario>(ScenarioQuery, true, out var scenario) ? scenario : WorkflowScenario.CatalogReady);
    }
    private void ChangeScenario(ChangeEventArgs args) => fixture.SetScenario(Enum.Parse<WorkflowScenario>(args.Value!.ToString()!));
}

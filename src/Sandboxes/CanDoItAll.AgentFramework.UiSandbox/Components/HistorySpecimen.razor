@using CanDoItAll.AgentFramework.UI.History
<PageTitle>Request History sandbox</PageTitle>
<header class="catalog-sandbox__controls">
    <h1 class="cda-title-xl">Request History sandbox</h1>
    <p>Synthetic scenarios with separate page, metadata and content reads. Every workspace starts without a read.</p>
    <FormField Text="Scenario">
        <DropDown TValue="HistoryScenario" Data="HistoryScenarios.Options" TextProperty="@nameof(HistoryScenarioOption.Text)"
                  ValueProperty="@nameof(HistoryScenarioOption.Value)" @bind-Value="scenario" aria-label="History scenario" data-testid="history-scenario" />
    </FormField>
</header>
<main class="catalog-sandbox__frame" data-testid="sandbox-history-specimen" data-interactive="@interactive.ToString().ToLowerInvariant()">
    <Grid Columns="@(scenario == HistoryScenario.TwoWorkspaces ? 2 : 1)" GapScale="LayoutGap.Medium" @key="scenario">
        <HistoryScenarioWorkspace Scenario="scenario" />
        @if (scenario == HistoryScenario.TwoWorkspaces) {
            <HistoryScenarioWorkspace Scenario="scenario" />
        }
    </Grid>
</main>
<Tooltip />

@code {
    [Parameter] public string? ScenarioQuery { get; set; }
    private string? appliedQuery;
    private HistoryScenario scenario;
    private bool interactive;

    protected override void OnAfterRender(bool firstRender) {
        if (firstRender) {
            interactive = true;
            StateHasChanged();
        }
    }

    protected override void OnParametersSet() {
        if (appliedQuery != ScenarioQuery) {
            appliedQuery = ScenarioQuery;
            scenario = HistoryScenarios.Resolve(ScenarioQuery);
        }
    }
}

{
  "DevelopmentManager": {
    "TuningModeEnabled": true,
    "ReviewBeforeSend": true,
    "ManagerBaseUrl": "http://127.0.0.1:6407"
  },
  "AgentFramework": {
    "ProcessMockAgents": {
      "Enabled": false
    }
  },
  "Database": {
    "Provider": "PostgreSql",
    "ConnectionString": "Host=127.0.0.1;Port=5432;Database=candoitall_workflow_routing_dev;Username=candoitall;Password=candoitall;Include Error Detail=true"
  },
  "Storage": {
    "WorkspaceRoot": ".artifacts/workflow-routing-postgres/workspace"
  },
  "ControlPlane": {
    "RootPath": ".artifacts/workflow-routing-postgres/control-plane"
  },
  "Workflows": {
    "ExampleSeed": {
      "Enabled": true,
      "SeedSampleWorkspaceFiles": true
    }
  },
  "Processes": {
    "Runtime": {
      "RequirePostgreSqlForAgentAutomation": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}

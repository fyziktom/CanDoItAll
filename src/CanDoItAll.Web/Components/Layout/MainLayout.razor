@inherits LayoutComponentBase
@implements IDisposable
@using CanDoItAll.Components
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using CanDoItAll.Infrastructure.Configuration
@using CanDoItAll.Infrastructure.ControlPlane
@using CanDoItAll.Infrastructure.Persistence
@using CanDoItAll.Modules.Factory
@using CanDoItAll.Modules.Projects
@using CanDoItAll.Modules.Workbench
@using CanDoItAll.Modules.Workspace
@using CanDoItAll.SharedKernel
@using CanDoItAll.Web.Composition
@using CanDoItAll.Web.Infrastructure
@using Microsoft.AspNetCore.WebUtilities
@using System.Text.Json
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Options.IOptions<DevelopmentManagerOptions> DevelopmentManagerOptions
@inject DevelopmentManagerClient DevelopmentManagerClient
@inject TuningCoordinator TuningCoordinator
@inject WorkbenchStateService Workbench
@inject IDatabaseSwitchNotificationService DatabaseSwitchNotificationService
@inject DatabaseProfileWorkspaceService DatabaseProfileWorkspaceService
@inject ProjectsService ProjectsService
@inject PromptFactoryService PromptFactoryService
@inject IJSRuntime JS

<AppShell NavigationItems="ShellNavigation.Items"
          Mode="ShellMode"
          ShowRightRail="ShowStandardRail"
          ShowCollapsedRail="ShowCollapsedRail"
          ShowTabSummary="@(ShellMode == AppShellMode.FocusWorkbench)"
          CollapsedRailLabel="@(ShellMode == AppShellMode.FocusWorkbench ? "Workbench utilities" : "Workspace context")"
          Workspaces="workspaces"
          ActiveWorkspaceId="@activeWorkspaceId"
          CurrentRoute="@CurrentRouteBase"
          Tabs="Workbench.Tabs"
          RecentTabs="Workbench.RecentTabs"
          OpenedProjects="OpenedProjectTabs"
          OpenedSessions="OpenedPromptSessionTabs"
          ActiveTabId="Workbench.ActiveTabId"
          ProjectContextTitle="@ActiveProjectTitle"
          PhaseContextTitle="@ActivePhaseTitle"
          SelectWorkspace="HandleSelectWorkspaceAsync"
          Navigate="HandleNavigateAsync"
          OpenWorkbenchItem="HandleOpenWorkbenchItemAsync"
          SelectTab="HandleSelectTabAsync"
          CloseTab="HandleCloseTabAsync"
          MoveLeft="HandleMoveLeftAsync"
          MoveRight="HandleMoveRightAsync"
          ToggleTabPin="HandleTogglePinAsync"
          ToggleTabSleep="HandleToggleSleepAsync"
          CloseOtherTabs="HandleCloseOthersAsync"
          CloseTabsToRight="HandleCloseRightAsync"
          CloseBackgroundTabs="HandleCloseBackgroundAsync"
          ReopenRecentTab="HandleReopenRecentAsync">
    <TopBar>
        @if (!string.IsNullOrWhiteSpace(databaseSwitchAlert))
        {
            <div class="mb-3 rounded-[1.35rem] border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-950"
                 data-testid="database-switch-alert">
                @databaseSwitchAlert
            </div>
        }

        <Split Breakpoint="LayoutBreakpoint.None"
               Gap="LayoutGap.Medium"
               AlignItems="AlignItems.Center"
               JustifyContent="JustifyContent.SpaceBetween"
               Wrap="FlexWrap.Wrap">
            <Cluster Wrap="FlexWrap.NoWrap"
                     Gap="LayoutGap.Small"
                     Class="min-w-0">
                <span class="cda-shell-pill cda-shell-pill--neutral">@ActiveWorkspaceTitle</span>
                <h2 class="text-sm font-semibold tracking-tight text-slate-950">@ActiveNavigation.Title</h2>
                @if (ShellMode == AppShellMode.FocusWorkbench && !string.IsNullOrWhiteSpace(ActiveProjectTitle))
                {
                    <span class="cda-shell-pill cda-shell-pill--info">@ActiveProjectTitle</span>
                }
                <span class="hidden truncate text-xs text-slate-400 lg:inline">@CurrentRouteDisplay</span>
                @if (!string.IsNullOrWhiteSpace(ActivePhaseTitle))
                {
                    <span class="hidden text-xs text-slate-400 lg:inline">/ phase: @ActivePhaseTitle</span>
                }
            </Cluster>

            <Cluster Wrap="FlexWrap.Wrap"
                     Gap="LayoutGap.Small"
                     Class="flex-shrink-0 justify-end">
                <div class="min-w-[16rem] rounded-[1.35rem] border border-slate-200 bg-slate-50/90 px-4 py-3"
                     data-testid="active-database-indicator">
                    <p class="cda-eyebrow">Active database</p>
                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap" Class="mt-2">
                        <p class="text-sm font-semibold text-slate-950">@(databaseSelection?.DisplayName ?? "Loading runtime profile")</p>
                        @if (databaseSelection is not null)
                        {
                            <StatusBadge Tone="info" Text="@DescribeDatabaseProvider(databaseSelection.ProviderKind)" />
                            @if (databaseSelection.IsRuntimeLocked)
                            {
                                <StatusBadge Tone="warning" Text="Config lock" />
                            }
                        }
                        @if (!string.IsNullOrWhiteSpace(databaseSelection?.Descriptor))
                        {
                            <HelpPopover RootClass="pf-help-popover flex items-center"
                                         ToggleClass="pf-help-popover__toggle pf-help-popover__toggle--compact"
                                         AriaLabel="Show db details"
                                         Title="Show db details"
                                         Heading="Description"
                                         Body="@databaseSelection.Descriptor" />
                        }
                    
                    </Cluster>
                </div>
                <Button Text="Switch database"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Disabled="@databaseDialogBusy"
                        Click="OpenDatabaseDialogAsync"
                        data-testid="database-topbar-switcher" />
                <StatusBadge Tone="info" Text="Interactive Server" />
                <StatusBadge Tone="success" Text="@($"Live items {OpenedProjectTabs.Count + OpenedPromptSessionTabs.Count}")" />
                <StatusBadge Tone="neutral" Text="@($"Tabs {Workbench.Tabs.Count}")" />
            </Cluster>
        </Split>
    </TopBar>
    <Body>
        <Notification />
        @if (CurrentTuningSurface is { } tuningSurface)
        {
            <TunableComponentBoundary IsEnabled="@TuningEnabled"
                                      CapsuleKey="@tuningSurface.CapsuleKey"
                                      ComponentName="@tuningSurface.ComponentName"
                                      ContextSummary="@tuningSurface.ContextSummary"
                                      Route="@CurrentRouteDisplay"
                                      ProjectId="@Workbench.GetActiveTab()?.ProjectId"
                                      TabId="@Workbench.ActiveTabId">
                @Body
            </TunableComponentBoundary>
        }
        else
        {
            @Body
        }
    </Body>
    <RightRail>
        <Stack GapScale="LayoutGap.Large">
            @if (ShowStandardRail)
            {
                <SectionCard Title="Workbench" Description="Internal tabs now track artifact identity, recent closures, and contextual restore instead of flat route launches.">
                    <Grid Gap="LayoutGap.Medium">
                        <div class="cda-shell-stat-card">
                            <p class="cda-eyebrow tracking-[0.25em]">Current route</p>
                            <p class="mt-2 text-sm font-medium text-slate-900">@CurrentRouteDisplay</p>
                        </div>
                        <div class="cda-shell-stat-card">
                            <p class="cda-eyebrow tracking-[0.25em]">Active tab</p>
                            <p class="mt-2 text-sm font-medium text-slate-900">@ActiveTabTitle</p>
                        </div>
                        @if (Workbench.LastRestoreReport is not null)
                        {
                            <div class="cda-shell-stat-card">
                                <p class="cda-eyebrow tracking-[0.25em]">Restore report</p>
                                <p class="mt-2 text-sm font-medium text-slate-900">@($"{Workbench.LastRestoreReport.RestoredCount} tab(s) restored")</p>
                                @if (Workbench.LastRestoreReport.Failures.Count > 0)
                                {
                                    <p class="mt-1 text-xs text-amber-700">@($"{Workbench.LastRestoreReport.Failures.Count} tab(s) needed safe fallback.")</p>
                                }
                            </div>
                        }
                    </Grid>
                </SectionCard>

                <SectionCard Title="Context Queue" Description="The shell keeps active projects and prompt sessions visible so work starts from artifacts instead of a flat route list.">
                    <Stack GapScale="LayoutGap.Medium"
                           Class="text-sm text-slate-700">
                        <div>
                            <p class="cda-eyebrow">Opened projects</p>
                            <p class="mt-1">@OpenedProjectTabs.Count</p>
                        </div>
                        <div>
                            <p class="cda-eyebrow">Prompt sessions</p>
                            <p class="mt-1">@OpenedPromptSessionTabs.Count</p>
                        </div>
                        <div>
                            <p class="cda-eyebrow">Recent closures</p>
                            <p class="mt-1">@Workbench.RecentTabs.Count</p>
                        </div>
                    </Stack>
                </SectionCard>
            }

            @if (DevelopmentManagerOptions.Value.TuningModeEnabled)
            {
                <SectionCard Title="Tuning Mode" Description="Development-only request packaging for the active page surface.">
                    <Stack GapScale="LayoutGap.Medium">
                        @if (TuningCoordinator.CurrentRequest is null)
                        {
                            <p class="text-sm leading-6 text-slate-600">Use the `tune` handle on the current page surface to capture route, project, and tab context before opening a tuning request.</p>
                        }
                        else
                        {
                            <div class="cda-shell-stat-card text-sm text-slate-700">
                                <p class="cda-eyebrow tracking-[0.25em]">Target</p>
                                <p class="mt-2 font-semibold text-slate-900">@TuningCoordinator.CurrentRequest.ComponentName</p>
                                <p class="mt-1 text-xs text-slate-500">@TuningCoordinator.CurrentRequest.CapsuleKey</p>
                                <p class="mt-1 text-xs text-slate-500">@TuningCoordinator.CurrentRequest.Route</p>
                            </div>

                            <div>
                                <label class="cda-field-label">Instruction</label>
                                <InputTextArea @bind-Value="tuningInstruction"
                                               class="cda-input cda-input--textarea min-h-28"
                                               data-testid="tuning-instruction" />
                            </div>

                            <Stack GapScale="LayoutGap.Small">
                                <Split Breakpoint="LayoutBreakpoint.None"
                                       Gap="LayoutGap.Small"
                                       AlignItems="AlignItems.Center"
                                       JustifyContent="JustifyContent.SpaceBetween"
                                       Wrap="FlexWrap.Wrap">
                                    <label class="text-sm font-medium text-slate-700">Attachments</label>
                                    <Cluster Gap="LayoutGap.Small">
                                        <label class="cda-shell-upload">
                                            Add image
                                            <InputFile class="hidden" accept="image/*" OnChange="HandleTuningFilesSelectedAsync" />
                                        </label>
                                        <Button ButtonStyle="ButtonStyle.Light"
                                                Text="Paste clipboard image"
                                                Size="ButtonSize.Small"
                                                Click="PasteClipboardImageAsync" />
                                    </Cluster>
                                </Split>

                                @if (tuningAttachments.Count == 0)
                                {
                                    <p class="text-xs text-slate-500">Attach a screenshot or paste an image from the clipboard when visual evidence matters.</p>
                                }
                                else
                                {
                                    <Stack GapScale="LayoutGap.Small">
                                        @foreach (var attachment in tuningAttachments)
                                        {
                                            <div class="cda-shell-attachment">
                                                <span>@attachment.FileName (@attachment.Source)</span>
                                                <button type="button" class="font-semibold text-rose-700" @onclick="() => RemoveTuningAttachment(attachment.FileName)">Remove</button>
                                            </div>
                                        }
                                    </Stack>
                                }
                            </Stack>

                            <Cluster Gap="LayoutGap.Small">
                                <Button Text="Send request"
                                        Disabled="@tuningBusy"
                                        data-testid="tuning-send"
                                        Click="SendTuningRequestAsync" />
                                <Button ButtonStyle="ButtonStyle.Light"
                                        Text="Clear"
                                        Click="ClearTuningRequest" />
                                @if (pendingTuningRequest is { Status: "AwaitingApproval" })
                                {
                                    <Button ButtonStyle="ButtonStyle.Warning"
                                            Text="Submit after review"
                                            Disabled="@tuningBusy"
                                            Click="SubmitPendingTuningRequestAsync" />
                                }
                            </Cluster>
                        }

                        @if (!string.IsNullOrWhiteSpace(tuningMessage))
                        {
                            <p class="text-sm @(tuningMessage.StartsWith("Unable", StringComparison.OrdinalIgnoreCase) || tuningMessage.StartsWith("Add ", StringComparison.OrdinalIgnoreCase) ? "text-rose-700" : "text-emerald-700")">@tuningMessage</p>
                        }

                        @if (pendingTuningRequest is not null)
                        {
                            <div class="cda-shell-stat-card text-sm text-slate-700">
                                <p class="cda-eyebrow">Latest request</p>
                                <p class="mt-2 font-semibold text-slate-900">@pendingTuningRequest.ComponentName</p>
                                <p class="mt-1 text-xs text-slate-500">@pendingTuningRequest.Status</p>
                                <p class="mt-1 text-xs text-slate-500">@pendingTuningRequest.Summary</p>
                                @if (pendingTuningRequest.AttachmentCount > 0)
                                {
                                    <p class="mt-1 text-xs text-slate-500">@($"{pendingTuningRequest.AttachmentCount} attachment(s) packaged")</p>
                                }
                            </div>
                        }
                    </Stack>
                </SectionCard>
            }
        </Stack>
    </RightRail>
</AppShell>

<Dialog IsOpen="@databaseDialogOpen"
        Title="Database profiles"
        Eyebrow="@(databaseDialogStartupMode ? "Startup" : "Runtime")"
        Subtitle="@(databaseDialogStartupMode
            ? "Continue with the resolved runtime database, switch to another saved profile, or create a fresh managed SQLite workspace."
            : "Review the active runtime database and switch profiles without leaving the shell.")"
        Size="ModalSize.Wide"
        TestId="@(databaseDialogStartupMode ? "database-startup-modal" : "database-switcher-dialog")"
        OnClose="CloseDatabaseDialogAsync">
    <ChildContent>
        <Stack GapScale="LayoutGap.Large">
            @if (databaseSelection is not null)
            {
                <div class="rounded-[1.5rem] border border-slate-200 bg-slate-50/90 p-4"
                     data-testid="database-dialog-current-selection">
                    <Split Breakpoint="LayoutBreakpoint.None"
                           Gap="LayoutGap.Medium"
                           AlignItems="AlignItems.Start"
                           JustifyContent="JustifyContent.SpaceBetween"
                           Wrap="FlexWrap.Wrap">
                        <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
                            <p class="cda-eyebrow">Resolved profile</p>
                            <p class="text-base font-semibold text-slate-950">@databaseSelection.DisplayName</p>
                            <p class="text-sm leading-6 text-slate-600">@databaseSelection.Descriptor</p>
                        </Stack>

                        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                            <StatusBadge Tone="info" Text="@DescribeDatabaseProvider(databaseSelection.ProviderKind)" />
                            <StatusBadge Tone="neutral" Text="@DescribeDatabaseSource(databaseSelection.SourceKind)" />
                            @if (databaseSelection.IsRuntimeLocked)
                            {
                                <StatusBadge Tone="warning" Text="Config lock" />
                            }
                        </Cluster>
                    </Split>

                    <p class="mt-3 text-xs text-slate-500">Workspace root: @databaseSelection.WorkspaceRoot</p>
                    <p class="mt-1 text-xs text-slate-500">Selection source: @DescribeResolutionSource(databaseSelection.ResolutionSource)</p>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(databaseProfileMessage))
            {
                <div class="@ResolveDatabaseMessageClass()"
                     data-testid="database-dialog-message">
                    @databaseProfileMessage
                </div>
            }

            @if (databaseSelection?.IsRuntimeLocked == true)
            {
                <div class="rounded-[1.4rem] border border-amber-300 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-950"
                     data-testid="database-dialog-locked-message">
                    Startup configuration owns the active database for this session. Continue is still safe, but switching and creating profiles are disabled until the override is removed.
                </div>
            }

            @if (databaseProfiles.Count == 0)
            {
                <EmptyState Eyebrow="No saved profiles"
                            Title="Create the first managed SQLite workspace"
                            Description="Saved profiles appear here after they are persisted through the control plane or the Data Sources settings tab." />
            }
            else
            {
                <Stack GapScale="LayoutGap.Medium" data-testid="database-dialog-profile-list">
                    @foreach (var profile in databaseProfiles)
                    {
                        <SelectionListItem Title="@profile.DisplayName"
                                           Eyebrow="@DescribeDatabaseProvider(profile.ProviderKind)"
                                           Meta="@DescribeDatabaseSource(profile.SourceKind)"
                                           Summary="@profile.Descriptor"
                                           DataTestId="@($"database-dialog-profile-row-{profile.Id:N}")"
                                           IsSelected="@(selectedDatabaseProfileId == profile.Id)"
                                           OnSelect="@(() => SelectDatabaseProfile(profile.Id))">
                            <Status>
                                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                    @if (profile.IsActive)
                                    {
                                        <StatusBadge Tone="success" Text="Active" />
                                    }

                                    @if (profile.IsRuntimeLocked)
                                    {
                                        <StatusBadge Tone="warning" Text="Locked" />
                                    }
                                </Cluster>
                            </Status>
                        </SelectionListItem>
                    }
                </Stack>
            }
        </Stack>
    </ChildContent>
    <Footer>
        <Split Breakpoint="LayoutBreakpoint.None"
               Gap="LayoutGap.Medium"
               AlignItems="AlignItems.Center"
               JustifyContent="JustifyContent.SpaceBetween"
               Wrap="FlexWrap.Wrap">
            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                @if (databaseDialogStartupMode)
                {
                    <Button Text="Continue"
                            ButtonStyle="ButtonStyle.Light"
                            Disabled="@databaseDialogBusy"
                            Click="ContinueWithCurrentDatabaseAsync"
                            data-testid="database-startup-continue" />
                }
                else
                {
                    <Button Text="Close"
                            ButtonStyle="ButtonStyle.Light"
                            Disabled="@databaseDialogBusy"
                            Click="CloseDatabaseDialogAsync" />
                }

                <Button Text="Open Data Sources"
                        ButtonStyle="ButtonStyle.Light"
                        Disabled="@databaseDialogBusy"
                        Click="OpenDatabaseSettingsAsync"
                        data-testid="database-startup-open-settings" />
            </Cluster>

            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                <Button Text="Create managed SQLite"
                        ButtonStyle="ButtonStyle.Info"
                        Disabled="@(databaseDialogBusy || !CanManageDatabases)"
                        Click="CreateManagedSqliteAsync"
                        data-testid="database-startup-create-managed" />
                <Button Text="@(SelectedDialogProfileIsActive ? "Already active" : "Switch selected")"
                        ButtonStyle="ButtonStyle.Warning"
                        Disabled="@(databaseDialogBusy || !CanSwitchSelectedProfile)"
                        Click="SwitchDatabaseProfileAsync"
                        data-testid="database-startup-switch" />
            </Cluster>
        </Split>
    </Footer>
</Dialog>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss" aria-label="Dismiss">
        <Icon Name="close" />
    </span>
</div>

@code {
    private readonly IReadOnlyList<ShellWorkspaceItem> workspaces =
    [
        new("delivery", "Delivery Workspace", "Project authoring, structure, calendars, and prompt sessions.", "/projects"),
        new("quality", "Quality Desk", "Validation runs, test plans, and evidence review.", "/validation"),
        new("automation", "Automation Ops", "Activity, automation status, and environment settings.", "/automation")
    ];

    private string activeWorkspaceId = "delivery";
    private string tuningInstruction = string.Empty;
    private string? tuningMessage;
    private bool tuningBusy;
    private readonly List<TuningAttachmentRequest> tuningAttachments = [];
    private DevelopmentTuningRequestResult? pendingTuningRequest;
    private DotNetObjectReference<MainLayout>? databaseSwitchListenerReference;
    private IReadOnlyList<DatabaseProfileSummary> databaseProfiles = [];
    private DatabaseSelectionStateModel? databaseSelection;
    private Guid? selectedDatabaseProfileId;
    private bool databaseDialogOpen;
    private bool databaseDialogStartupMode;
    private bool databaseDialogBusy;
    private string? databaseProfileMessage;
    private long lastObservedDatabaseSwitchGeneration;
    private string? databaseSwitchAlert;

    private string CurrentLocation => Navigation.ToBaseRelativePath(Navigation.Uri);

    private Uri CurrentUri => Navigation.ToAbsoluteUri(Navigation.Uri);

    private string CurrentRouteBase => CurrentUri.AbsolutePath.TrimStart('/');

    private string CurrentRouteDisplay => string.IsNullOrWhiteSpace(CurrentLocation) ? "/" : $"/{CurrentLocation}";

    private ShellNavigationItem ActiveNavigation => ShellNavigation.MatchRoute(CurrentRouteBase);

    private string ActiveWorkspaceTitle => workspaces.FirstOrDefault(item => item.Id == activeWorkspaceId)?.Title ?? "Workspace";

    private string ActiveTabTitle => Workbench.GetActiveTab()?.Title ?? ActiveNavigation.Title;

    private string? ActiveProjectTitle => Workbench.GetActiveTab()?.ProjectName;

    private string? ActivePhaseTitle => Workbench.GetActiveTab()?.PhaseName;

    private AppShellMode ShellMode => IsFocusWorkbenchRoute ? AppShellMode.FocusWorkbench : AppShellMode.StandardPage;

    private bool ShowStandardRail => ShellMode == AppShellMode.StandardPage;

    private bool ShowCollapsedRail => ShellMode == AppShellMode.FocusWorkbench && DevelopmentManagerOptions.Value.TuningModeEnabled;

    private bool IsFocusWorkbenchRoute
        => CurrentUri.AbsolutePath.EndsWith("/structure", StringComparison.OrdinalIgnoreCase) ||
           string.Equals(CurrentUri.AbsolutePath, "/prompt-factory", StringComparison.OrdinalIgnoreCase);

    private IReadOnlyList<WorkbenchTabState> OpenedProjectTabs => Workbench.Tabs
        .Where(tab => tab.ProjectId.HasValue && tab.TabKind is WorkbenchTabKinds.ProjectOverview or WorkbenchTabKinds.ProjectStructure or WorkbenchTabKinds.ProjectCalendar)
        .GroupBy(tab => tab.ProjectId)
        .Select(group => group.First())
        .ToList();

    private IReadOnlyList<WorkbenchTabState> OpenedPromptSessionTabs => Workbench.Tabs
        .Where(tab => string.Equals(tab.TabKind, WorkbenchTabKinds.PromptWizardSession, StringComparison.Ordinal))
        .ToList();

    private bool TuningEnabled => DevelopmentManagerOptions.Value.TuningModeEnabled && CurrentTuningSurface is not null;

    private TuningSurfaceDefinition? CurrentTuningSurface => ResolveTuningSurface(CurrentUri.AbsolutePath);

    private bool CanManageDatabases => databaseSelection?.IsRuntimeLocked != true;

    private bool SelectedDialogProfileIsActive
        => selectedDatabaseProfileId.HasValue &&
           databaseSelection is not null &&
           selectedDatabaseProfileId.Value == databaseSelection.ActiveProfileId;

    private bool CanSwitchSelectedProfile
        => CanManageDatabases &&
           selectedDatabaseProfileId.HasValue &&
           !SelectedDialogProfileIsActive;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        Workbench.Changed += HandleWorkbenchChanged;
        TuningCoordinator.Changed += HandleWorkbenchChanged;
        DatabaseSwitchNotificationService.Changed += HandleDatabaseSwitchChanged;
        activeWorkspaceId = ResolveWorkspaceId(CurrentUri.AbsolutePath);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await Workbench.InitializeAsync(
            [
                new WorkbenchTabState(
                    "route:dashboard",
                    "Dashboard",
                    "/",
                    IsPinned: true,
                    CanClose: false,
                    TabKind: WorkbenchTabKinds.Page,
                    ArtifactKey: "/",
                    RestoreKey: "/",
                    TabGroup: "Workspace")
            ]);

        await ResolveAndTrackCurrentTabAsync();
        databaseSwitchListenerReference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("CanDoItAll.browserState.registerDatabaseSwitchListener", databaseSwitchListenerReference);
        await RestoreDatabaseSwitchAlertAsync();
        await LoadDatabaseProfileUiAsync(showStartupPrompt: true);
        StateHasChanged();
    }

    private async Task HandleNavigateAsync(string route)
    {
        Navigation.NavigateTo(route);
        await ResolveAndTrackCurrentTabAsync();
    }

    private Task HandleOpenWorkbenchItemAsync(string tabId) => HandleSelectTabAsync(tabId);

    private Task HandleSelectWorkspaceAsync(string workspaceId)
    {
        activeWorkspaceId = workspaceId;
        var workspace = workspaces.FirstOrDefault(item => item.Id == workspaceId);
        if (workspace is not null)
        {
            Navigation.NavigateTo(workspace.DefaultRoute);
        }

        return Task.CompletedTask;
    }

    private async Task HandleSelectTabAsync(string tabId)
    {
        var tab = Workbench.Tabs.FirstOrDefault(candidate => string.Equals(candidate.TabId, tabId, StringComparison.Ordinal));
        if (tab is null)
        {
            return;
        }

        Navigation.NavigateTo(tab.Route);
        await Workbench.ActivateAsync(tab.TabId);
    }

    private async Task HandleCloseTabAsync(string tabId)
    {
        await Workbench.CloseAsync(tabId);
        var activeTab = Workbench.GetActiveTab();
        if (activeTab is not null && !string.Equals(CurrentRouteDisplay, activeTab.Route, StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo(activeTab.Route);
        }
    }

    private Task HandleMoveLeftAsync(string tabId) => Workbench.MoveAsync(tabId, -1);

    private Task HandleMoveRightAsync(string tabId) => Workbench.MoveAsync(tabId, 1);

    private Task HandleTogglePinAsync(string tabId) => Workbench.TogglePinAsync(tabId);

    private Task HandleToggleSleepAsync(string tabId) => Workbench.ToggleSleepAsync(tabId);

    private Task HandleCloseOthersAsync(string tabId) => Workbench.CloseOthersAsync(tabId);

    private Task HandleCloseRightAsync(string tabId) => Workbench.CloseRightAsync(tabId);

    private Task HandleCloseBackgroundAsync(string tabId) => Workbench.CloseAllBackgroundAsync(tabId);

    private async Task HandleReopenRecentAsync(string tabId)
    {
        await Workbench.ReopenRecentAsync(tabId);
        var reopened = Workbench.GetActiveTab();
        if (reopened is not null)
        {
            Navigation.NavigateTo(reopened.Route);
        }
    }

    private async Task LoadDatabaseProfileUiAsync(bool showStartupPrompt)
    {
        databaseProfiles = await DatabaseProfileWorkspaceService.ListProfilesAsync();
        databaseSelection = await DatabaseProfileWorkspaceService.GetCurrentSelectionAsync();
        selectedDatabaseProfileId ??= databaseSelection.ActiveProfileId;
        if (databaseProfiles.Count > 0 &&
            !databaseProfiles.Any(profile => profile.Id == selectedDatabaseProfileId))
        {
            selectedDatabaseProfileId = databaseProfiles[0].Id;
        }

        if (!showStartupPrompt)
        {
            return;
        }

        var dismissed = await JS.InvokeAsync<bool>("CanDoItAll.browserState.isDatabaseStartupPromptDismissed");
        if (!dismissed)
        {
            databaseDialogStartupMode = true;
            databaseDialogOpen = true;
        }
    }

    private async Task OpenDatabaseDialogAsync()
    {
        databaseProfileMessage = null;
        databaseDialogStartupMode = false;
        await LoadDatabaseProfileUiAsync(showStartupPrompt: false);
        databaseDialogOpen = true;
    }

    private void SelectDatabaseProfile(Guid profileId)
    {
        selectedDatabaseProfileId = profileId;
        databaseProfileMessage = null;
    }


@namespace CanDoItAll.Web.Components.Layout
@using CanDoItAll.Components
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using CanDoItAll.Infrastructure.ControlPlane

<Dialog IsOpen="@IsOpen"
        Title="Database profiles"
        Eyebrow="@(IsStartupMode ? "Startup" : "Runtime")"
        Subtitle="@(IsStartupMode
            ? "Continue with the resolved runtime database, switch to another saved profile, or create a fresh managed SQLite workspace."
            : "Review the active runtime database and switch profiles without leaving the shell.")"
        Size="ModalSize.Wide"
        TestId="@(IsStartupMode ? "database-startup-modal" : "database-switcher-dialog")"
        OnClose="CloseDatabaseDialog">
    <ChildContent>
        <Stack GapScale="LayoutGap.Large">
            @if (DatabaseSelection is not null)
            {
                <div class="rounded-[1.5rem] border border-slate-200 bg-slate-50/90 p-4"
                     data-testid="database-dialog-current-selection">
                    <Split Breakpoint="LayoutBreakpoint.None"
                           Gap="LayoutGap.Medium"
                           AlignItems="AlignItems.Start"
                           JustifyContent="JustifyContent.SpaceBetween"
                           Wrap="FlexWrap.Wrap">
                        <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
                            <p class="cda-eyebrow">Resolved profile</p>
                            <p class="text-base font-semibold text-slate-950">@DatabaseSelection.DisplayName</p>
                        </Stack>

                        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                            <StatusBadge Tone="info" Text="@DescribeDatabaseProvider(DatabaseSelection.ProviderKind)" />
                            <StatusBadge Tone="neutral" Text="@DescribeDatabaseSource(DatabaseSelection.SourceKind)" />
                            @if (DatabaseSelection.IsRuntimeLocked)
                            {
                                <StatusBadge Tone="warning" Text="Config lock" />
                            }
                        </Cluster>
                    </Split>

                    <Stack GapScale="LayoutGap.Small"
                           Class="mt-3">
                        <Split Breakpoint="LayoutBreakpoint.None"
                               Gap="LayoutGap.Small"
                               AlignItems="AlignItems.Start"
                               JustifyContent="JustifyContent.SpaceBetween"
                               Wrap="FlexWrap.Wrap">
                            <Stack GapScale="LayoutGap.Tiny"
                                   Class="min-w-0 flex-1">
                                <p class="cda-eyebrow">Resolved target</p>
                                <p class="rounded-[1rem] border border-slate-200 bg-white/90 px-3 py-2 font-mono text-xs leading-5 text-slate-600 break-all"
                                   data-testid="database-dialog-active-target">@DatabaseSelection.Descriptor</p>
                            </Stack>
                            <CopyButton Value="@DatabaseSelection.Descriptor"
                                        DisplayMode="CopyButtonDisplayMode.IconButton"
                                        Size="CopyButtonSize.Small"
                                        AriaLabel="Copy active database target"
                                        data-testid="database-dialog-copy-active-target" />
                        </Split>

                        <Split Breakpoint="LayoutBreakpoint.None"
                               Gap="LayoutGap.Small"
                               AlignItems="AlignItems.Start"
                               JustifyContent="JustifyContent.SpaceBetween"
                               Wrap="FlexWrap.Wrap">
                            <Stack GapScale="LayoutGap.Tiny"
                                   Class="min-w-0 flex-1">
                                <p class="cda-eyebrow">Workspace root</p>
                                <p class="rounded-[1rem] border border-slate-200 bg-white/90 px-3 py-2 font-mono text-xs leading-5 text-slate-600 break-all"
                                   data-testid="database-dialog-workspace-root">@DatabaseSelection.WorkspaceRoot</p>
                            </Stack>
                            <CopyButton Value="@DatabaseSelection.WorkspaceRoot"
                                        DisplayMode="CopyButtonDisplayMode.IconButton"
                                        Size="CopyButtonSize.Small"
                                        AriaLabel="Copy active database workspace root"
                                        data-testid="database-dialog-copy-workspace-root" />
                        </Split>
                    </Stack>

                    <p class="mt-3 text-xs text-slate-500">Selection source: @DescribeResolutionSource(DatabaseSelection.ResolutionSource)</p>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(DatabaseProfileMessage))
            {
                <div class="@DatabaseMessageClass"
                     data-testid="database-dialog-message">
                    @DatabaseProfileMessage
                </div>
            }

            @if (DatabaseSelection?.IsRuntimeLocked == true)
            {
                <div class="rounded-[1.4rem] border border-amber-300 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-950"
                     data-testid="database-dialog-locked-message">
                    Startup configuration owns the active database for this session. Continue is still safe, but switching and creating profiles are disabled until the override is removed.
                </div>
            }

            @if (PendingCreatedDatabaseProfileId.HasValue)
            {
                <div class="rounded-[1.5rem] border border-sky-200 bg-sky-50/80 p-4"
                     data-testid="database-startup-transfer-prompt">
                    <Stack GapScale="LayoutGap.Medium">
                        <Stack GapScale="LayoutGap.Tiny">
                            <p class="cda-eyebrow">New database baseline settings</p>
                            <p class="text-base font-semibold text-slate-950">@PendingCreatedDatabaseName</p>
                            <p class="text-sm leading-6 text-slate-600">Choose the settings groups to copy before this managed SQLite profile becomes active.</p>
                        </Stack>

                        <div>
                            <label class="cda-field-label">Copy settings from</label>
                            <select class="cda-input"
                                    value="@CreatedDatabaseTransferSourceProfileId?.ToString()"
                                    disabled="@(CreatedDatabaseTransferBusy || CreatedDatabaseTransferSources.Count == 0)"
                                    @onchange="ChangeCreatedDatabaseTransferSourceAsync"
                                    data-testid="database-startup-transfer-source">
                                <option value="">Select source database</option>
                                @foreach (var source in CreatedDatabaseTransferSources)
                                {
                                    <option value="@source.ProfileId">@source.DisplayName (@DescribeDatabaseSource(source.SourceKind))</option>
                                }
                            </select>
                        </div>

                        @if (CreatedDatabaseTransferItems.Count > 0)
                        {
                            <Grid Gap="LayoutGap.Small" ColumnsMd="2" data-testid="database-startup-transfer-items">
                                @foreach (var item in CreatedDatabaseTransferItems)
                                {
                                    <label class="rounded-[1rem] border border-slate-200 bg-white px-3 py-3"
                                           data-testid="@($"database-startup-transfer-item-{item.Descriptor.Key}")">
                                        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.NoWrap" AlignItems="AlignItems.Start">
                                            <input type="checkbox"
                                                   class="mt-1 h-4 w-4 rounded border-slate-300"
                                                   checked="@CreatedDatabaseSelectedTransferItemKeys.Contains(item.Descriptor.Key)"
                                                   disabled="@(CreatedDatabaseTransferBusy || !item.IsAvailable)"
                                                   @onchange="@(() => ToggleCreatedDatabaseTransferItem.InvokeAsync(item.Descriptor.Key))" />
                                            <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
                                                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                                    <span class="font-semibold text-slate-950">@item.Descriptor.Label</span>
                                                    @if (item.Descriptor.IsSensitive)
                                                    {
                                                        <StatusBadge Tone="warning" Text="Encrypted" />
                                                    }
                                                </Cluster>
                                                <p class="text-sm leading-6 text-slate-600">@item.Summary</p>
                                            </Stack>
                                        </Cluster>
                                    </label>
                                }
                            </Grid>
                        }
                        else if (!CreatedDatabaseTransferBusy)
                        {
                            <p class="text-sm leading-6 text-slate-600">Select a source database to preview transferable settings.</p>
                        }
                    </Stack>
                </div>
            }

            @if (DatabaseProfiles.Count == 0)
            {
                <EmptyState Eyebrow="No saved profiles"
                            Title="Create the first managed SQLite workspace"
                            Description="Saved profiles appear here after they are persisted through the control plane or the Data Sources settings tab." />
            }
            else
            {
                <Stack GapScale="LayoutGap.Medium" data-testid="database-dialog-profile-list">
                    @foreach (var profile in DatabaseProfiles)
                    {
                        <SelectionListItem Title="@profile.DisplayName"
                                           Eyebrow="@DescribeDatabaseProvider(profile.ProviderKind)"
                                           Meta="@DescribeDatabaseSource(profile.SourceKind)"
                                           Summary="@profile.Descriptor"
                                           DataTestId="@($"database-dialog-profile-row-{profile.Id:N}")"
                                           IsSelected="@(SelectedDatabaseProfileId == profile.Id)"
                                           OnSelect="@(() => SelectDatabaseProfile.InvokeAsync(profile.Id))">
                            <Status>
                                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                    @if (profile.IsActive)
                                    {
                                        <StatusBadge Tone="success" Text="Active" />
                                    }

                                    @if (profile.IsRuntimeLocked)
                                    {
                                        <StatusBadge Tone="warning" Text="Locked" />
                                    }
                                </Cluster>
                            </Status>
                            <Actions>
                                <CopyButton Value="@profile.Descriptor"
                                            DisplayMode="CopyButtonDisplayMode.IconButton"
                                            Size="CopyButtonSize.Small"
                                            AriaLabel="@($"Copy database target for {profile.DisplayName}")"
                                            data-testid="@($"database-dialog-copy-profile-{profile.Id:N}")" />
                            </Actions>
                        </SelectionListItem>
                    }
                </Stack>
            }
        </Stack>
    </ChildContent>
    <Footer>
        <Split Breakpoint="LayoutBreakpoint.None"
               Gap="LayoutGap.Medium"
               AlignItems="AlignItems.Center"
               JustifyContent="JustifyContent.SpaceBetween"
               Wrap="FlexWrap.Wrap">
            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                @if (IsStartupMode)
                {
                    <Button Text="Continue"
                            ButtonStyle="ButtonStyle.Light"
                            Disabled="@DatabaseDialogBusy"
                            Click="ContinueWithCurrentDatabase"
                            data-testid="database-startup-continue" />
                }
                else
                {
                    <Button Text="Close"
                            ButtonStyle="ButtonStyle.Light"
                            Disabled="@DatabaseDialogBusy"
                            Click="CloseDatabaseDialog" />
                }

                <Button Text="Open Data Sources"
                        ButtonStyle="ButtonStyle.Light"
                        Disabled="@DatabaseDialogBusy"
                        Click="OpenDatabaseSettings"
                        data-testid="database-startup-open-settings" />
            </Cluster>

            @if (PendingCreatedDatabaseProfileId.HasValue)
            {
                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                    <Button Text="Skip transfer"
                            ButtonStyle="ButtonStyle.Light"
                            Disabled="@(DatabaseDialogBusy || CreatedDatabaseTransferBusy)"
                            Click="SkipCreatedDatabaseTransfer"
                            data-testid="database-startup-transfer-skip" />
                    <Button Text="Transfer and activate"
                            ButtonStyle="ButtonStyle.Info"
                            Disabled="@(DatabaseDialogBusy || CreatedDatabaseTransferBusy || CreatedDatabaseSelectedTransferItemKeys.Count == 0)"
                            Click="TransferCreatedDatabaseSettings"
                            data-testid="database-startup-transfer-apply" />
                </Cluster>
            }
            else
            {
                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                    <Button Text="Create managed SQLite"
                            ButtonStyle="ButtonStyle.Info"
                            Disabled="@(DatabaseDialogBusy || !CanManageDatabases)"
                            Click="CreateManagedSqlite"
                            data-testid="database-startup-create-managed" />
                    <Button Text="@(SelectedDialogProfileIsActive ? "Already active" : "Switch selected")"
                            ButtonStyle="ButtonStyle.Warning"
                            Disabled="@(DatabaseDialogBusy || !CanSwitchSelectedProfile)"
                            Click="SwitchDatabaseProfile"
                            data-testid="database-startup-switch" />
                </Cluster>
            }
        </Split>
    </Footer>
</Dialog>

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public bool IsStartupMode { get; set; }

    [Parameter]
    public DatabaseSelectionStateModel? DatabaseSelection { get; set; }

    [Parameter]
    public string? DatabaseProfileMessage { get; set; }

    [Parameter, EditorRequired]
    public string DatabaseMessageClass { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<DatabaseProfileSummary> DatabaseProfiles { get; set; } = [];

    [Parameter]
    public Guid? SelectedDatabaseProfileId { get; set; }

    [Parameter]
    public bool DatabaseDialogBusy { get; set; }

    [Parameter]
    public Guid? PendingCreatedDatabaseProfileId { get; set; }

    [Parameter]
    public string PendingCreatedDatabaseName { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<DatabaseTransferSourceSummary> CreatedDatabaseTransferSources { get; set; } = [];

    [Parameter]
    public Guid? CreatedDatabaseTransferSourceProfileId { get; set; }

    [Parameter]
    public IReadOnlyList<DatabaseTransferItemPreview> CreatedDatabaseTransferItems { get; set; } = [];

    [Parameter]
    public IReadOnlySet<string> CreatedDatabaseSelectedTransferItemKeys { get; set; } = new HashSet<string>();

    [Parameter]
    public bool CreatedDatabaseTransferBusy { get; set; }

    [Parameter]
    public bool CanManageDatabases { get; set; }

    [Parameter]
    public bool SelectedDialogProfileIsActive { get; set; }

    [Parameter]
    public bool CanSwitchSelectedProfile { get; set; }

    [Parameter, EditorRequired]
    public Func<DatabaseProviderKind, string> DescribeDatabaseProvider { get; set; } = static kind => kind.ToString();

    [Parameter, EditorRequired]
    public Func<DatabaseProfileSourceKind, string> DescribeDatabaseSource { get; set; } = static kind => kind.ToString();

    [Parameter, EditorRequired]
    public Func<DatabaseProfileResolutionSource, string> DescribeResolutionSource { get; set; } = static source => source.ToString();

    [Parameter]
    public EventCallback<Guid> SelectDatabaseProfile { get; set; }

    [Parameter]
    public EventCallback ContinueWithCurrentDatabase { get; set; }

    [Parameter]
    public EventCallback CloseDatabaseDialog { get; set; }

    [Parameter]
    public EventCallback OpenDatabaseSettings { get; set; }

    [Parameter]
    public EventCallback CreateManagedSqlite { get; set; }

    [Parameter]
    public EventCallback SwitchDatabaseProfile { get; set; }

    [Parameter]
    public EventCallback<Guid> CreatedDatabaseTransferSourceChanged { get; set; }

    [Parameter]
    public EventCallback<string> ToggleCreatedDatabaseTransferItem { get; set; }

    [Parameter]
    public EventCallback TransferCreatedDatabaseSettings { get; set; }

    [Parameter]
    public EventCallback SkipCreatedDatabaseTransfer { get; set; }

    private async Task ChangeCreatedDatabaseTransferSourceAsync(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var sourceProfileId))
        {
            await CreatedDatabaseTransferSourceChanged.InvokeAsync(sourceProfileId);
        }
    }
}

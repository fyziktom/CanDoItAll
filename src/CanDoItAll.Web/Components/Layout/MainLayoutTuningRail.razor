@namespace CanDoItAll.Web.Components.Layout
@using CanDoItAll.Components
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using CanDoItAll.Web.Infrastructure

<SectionCard Title="Tuning Mode" Description="Development-only request packaging for the active page surface.">
    <Stack GapScale="LayoutGap.Medium">
        @if (CurrentRequest is null)
        {
            <p class="text-sm leading-6 text-slate-600">Use the `tune` handle on the current page surface to capture route, project, and tab context before opening a tuning request.</p>
        }
        else
        {
            <div class="cda-shell-stat-card text-sm text-slate-700">
                <p class="cda-eyebrow tracking-[0.25em]">Target</p>
                <p class="mt-2 font-semibold text-slate-900">@CurrentRequest.ComponentName</p>
                <p class="mt-1 text-xs text-slate-500">@CurrentRequest.CapsuleKey</p>
                <p class="mt-1 text-xs text-slate-500">@CurrentRequest.Route</p>
            </div>

            <div>
                <label class="cda-field-label">Instruction</label>
                <InputTextArea Value="@TuningInstruction"
                               ValueChanged="HandleInstructionChangedAsync"
                               class="cda-input cda-input--textarea min-h-28"
                               data-testid="tuning-instruction" />
            </div>

            <Stack GapScale="LayoutGap.Small">
                <Split Breakpoint="LayoutBreakpoint.None"
                       Gap="LayoutGap.Small"
                       AlignItems="AlignItems.Center"
                       JustifyContent="JustifyContent.SpaceBetween"
                       Wrap="FlexWrap.Wrap">
                    <label class="text-sm font-medium text-slate-700">Attachments</label>
                    <Cluster Gap="LayoutGap.Small">
                        <label class="cda-shell-upload">
                            Add image
                            <InputFile class="hidden" accept="image/*" OnChange="HandleTuningFilesSelected" />
                        </label>
                        <Button ButtonStyle="ButtonStyle.Light"
                                Text="Paste clipboard image"
                                Size="ButtonSize.Small"
                                Click="PasteClipboardImage" />
                    </Cluster>
                </Split>

                @if (TuningAttachments.Count == 0)
                {
                    <p class="text-xs text-slate-500">Attach a screenshot or paste an image from the clipboard when visual evidence matters.</p>
                }
                else
                {
                    <Stack GapScale="LayoutGap.Small">
                        @foreach (var attachment in TuningAttachments)
                        {
                            <div class="cda-shell-attachment">
                                <span>@attachment.FileName (@attachment.Source)</span>
                                <button type="button" class="font-semibold text-rose-700" @onclick="() => RemoveTuningAttachment.InvokeAsync(attachment.FileName)">Remove</button>
                            </div>
                        }
                    </Stack>
                }
            </Stack>

            <Cluster Gap="LayoutGap.Small">
                <Button Text="Send request"
                        Disabled="@TuningBusy"
                        data-testid="tuning-send"
                        Click="SendTuningRequest" />
                <Button ButtonStyle="ButtonStyle.Light"
                        Text="Clear"
                        Click="ClearTuningRequest" />
                @if (PendingTuningRequest is { Status: "AwaitingApproval" })
                {
                    <Button ButtonStyle="ButtonStyle.Warning"
                            Text="Submit after review"
                            Disabled="@TuningBusy"
                            Click="SubmitPendingTuningRequest" />
                }
            </Cluster>
        }

        @if (!string.IsNullOrWhiteSpace(TuningMessage))
        {
            <p class="text-sm @(TuningMessage.StartsWith("Unable", StringComparison.OrdinalIgnoreCase) || TuningMessage.StartsWith("Add ", StringComparison.OrdinalIgnoreCase) ? "text-rose-700" : "text-emerald-700")">@TuningMessage</p>
        }

        @if (PendingTuningRequest is not null)
        {
            <div class="cda-shell-stat-card text-sm text-slate-700">
                <p class="cda-eyebrow">Latest request</p>
                <p class="mt-2 font-semibold text-slate-900">@PendingTuningRequest.ComponentName</p>
                <p class="mt-1 text-xs text-slate-500">@PendingTuningRequest.Status</p>
                <p class="mt-1 text-xs text-slate-500">@PendingTuningRequest.Summary</p>
                @if (PendingTuningRequest.AttachmentCount > 0)
                {
                    <p class="mt-1 text-xs text-slate-500">@($"{PendingTuningRequest.AttachmentCount} attachment(s) packaged")</p>
                }
            </div>
        }
    </Stack>
</SectionCard>

@code {
    [Parameter]
    public TuningBoundaryRequest? CurrentRequest { get; set; }

    [Parameter, EditorRequired]
    public string TuningInstruction { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> TuningInstructionChanged { get; set; }

    [Parameter]
    public IReadOnlyList<TuningAttachmentRequest> TuningAttachments { get; set; } = [];

    [Parameter]
    public bool TuningBusy { get; set; }

    [Parameter]
    public string? TuningMessage { get; set; }

    [Parameter]
    public DevelopmentTuningRequestResult? PendingTuningRequest { get; set; }

    [Parameter]
    public EventCallback SendTuningRequest { get; set; }

    [Parameter]
    public EventCallback ClearTuningRequest { get; set; }

    [Parameter]
    public EventCallback SubmitPendingTuningRequest { get; set; }

    [Parameter]
    public EventCallback<InputFileChangeEventArgs> HandleTuningFilesSelected { get; set; }

    [Parameter]
    public EventCallback PasteClipboardImage { get; set; }

    [Parameter]
    public EventCallback<string> RemoveTuningAttachment { get; set; }

    private Task HandleInstructionChangedAsync(string value)
    {
        TuningInstruction = value;
        return TuningInstructionChanged.InvokeAsync(value);
    }
}

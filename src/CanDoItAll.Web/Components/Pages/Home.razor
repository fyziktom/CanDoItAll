@page "/"
@page "/dashboard"
@implements IDisposable
@* codex-capsule
kind: page
name: Home
summary: Shows the dashboard entry point, workbench overview, and manager loop guidance.
owns: dashboard-summary, startup-guidance
deps: shared-shell-components
risks: stale-startup-copy, missing-next-step
tests: component:HomePageTests, e2e:smoke-dashboard
*@
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using CanDoItAll.Infrastructure.BackgroundJobs
@using CanDoItAll.Modules.Automation
@using CanDoItAll.Modules.Workbench
@using CanDoItAll.Modules.Validation
@using CanDoItAll.Modules.Projects
@using CanDoItAll.SharedKernel
@inject NavigationManager Navigation
@inject WorkbenchStateService Workbench
@inject ProjectsService ProjectsService
@inject ValidationService ValidationService
@inject AutomationWorkspaceService AutomationWorkspaceService

<PageTitle>Dashboard</PageTitle>

<PageScaffold MaxWidthClass="max-w-full">
    <Header>
        <PageHeader Eyebrow="Dashboard"
                    Title="Delivery control surface"
                    Description="Resume active work, reopen recent sessions, and move directly into the next project, validation, or prompt task.">
            <Actions>
                <Button Text="New project"
                        Click="@(() => Navigation.NavigateTo("/projects"))" />
                <Button ButtonStyle="ButtonStyle.Light"
                        Text="Open projects"
                        Click="@(() => Navigation.NavigateTo("/projects"))" />
            </Actions>
        </PageHeader>
    </Header>

    <ChildContent>
        <SummaryTiles>
            <SummaryTile Label="Projects" Value="@projectCount.ToString()" HelperText="Saved project workspaces available to reopen." />
            <SummaryTile Label="Open work items" Value="@openWorkItems.Count.ToString()" HelperText="Tabs currently active in the recoverable workbench." Tone="info" />
            <SummaryTile Label="Validation runs" Value="@validationRunCount.ToString()" HelperText="Persisted review runs available for follow-up." />
            <SummaryTile Label="Failed jobs" Value="@failedJobs.Count.ToString()" HelperText="Operational issues that likely need attention." Tone="@(failedJobs.Count > 0 ? "warning" : "success")" />
        </SummaryTiles>

        <Grid Gap="LayoutGap.XXLarge"
              ColumnTemplateXl="minmax(0,1.05fr) minmax(0,0.95fr)">
            <SectionCard Title="Quick actions" Description="Go directly to the next likely task instead of starting from a documentation-style overview.">
                <Grid Gap="LayoutGap.Medium" ColumnsSm="2">
                    <div class="h-full">
                        <SelectionListItem Eyebrow="Projects"
                                           Title="Start or reopen project work"
                                           Summary="Create a new project or continue a staged authoring session."
                                           OnSelect="@(() => Navigation.NavigateTo("/projects"))" />
                    </div>
                    <div class="h-full">
                        <SelectionListItem Eyebrow="Prompt factory"
                                           Title="Open a prompt session"
                                           Summary="Move into the focused workbench for prompt assembly and review."
                                           OnSelect="@(() => Navigation.NavigateTo("/prompt-factory"))" />
                    </div>
                    <div class="h-full">
                        <SelectionListItem Eyebrow="Validation"
                                           Title="Run a new validation"
                                           Summary="Launch a deterministic review and capture findings or decisions."
                                           OnSelect="@(() => Navigation.NavigateTo("/validation"))" />
                    </div>
                    <div class="h-full">
                        <SelectionListItem Eyebrow="Settings"
                                           Title="Check providers and secrets"
                                           Summary="Confirm workspace defaults, provider health, and secret-backed connections."
                                           OnSelect="@(() => Navigation.NavigateTo("/settings"))" />
                    </div>
                </Grid>
            </SectionCard>

            <SectionCard Title="Attention queue" Description="Surface the follow-up items that should interrupt new work.">
                @if (failedJobs.Count == 0 && recentTabs.Count == 0)
                {
                    <EmptyState Eyebrow="Stable workspace"
                                Title="No immediate blockers"
                                Description="Background jobs are quiet and there are no recent work items waiting to be reopened." />
                }
                else
                {
                    <Stack GapScale="LayoutGap.Medium">
                        @foreach (var job in failedJobs.Take(3))
                        {
                            <div class="cda-panel-card border-amber-200 bg-amber-50/80">
                                <Split Breakpoint="LayoutBreakpoint.None"
                                       Gap="LayoutGap.Medium"
                                       JustifyContent="JustifyContent.SpaceBetween"
                                       Wrap="FlexWrap.Wrap">
                                    <div>
                                        <p class="text-sm font-semibold text-slate-950">@job.Description</p>
                                        <p class="mt-1 text-xs text-slate-600">@job.JobType / @job.CorrelationId</p>
                                    </div>
                                    <StatusBadge Tone="warning" Text="@job.State.ToString()" />
                                </Split>
                                @if (!string.IsNullOrWhiteSpace(job.ErrorSummary))
                                {
                                    <p class="mt-3 text-sm leading-6 text-amber-900">@job.ErrorSummary</p>
                                }
                            </div>
                        }

                        @foreach (var recent in recentTabs.Take(2))
                        {
                            <SelectionListItem Eyebrow="Recent tab"
                                               Title="@recent.Title"
                                               Meta="@recent.Route"
                                               OnSelect="@(() => Navigation.NavigateTo(recent.Route))" />
                        }
                    </Stack>
                }
            </SectionCard>
        </Grid>

        <Grid Gap="LayoutGap.XXLarge"
              ColumnTemplateXl="minmax(0,1.05fr) minmax(0,0.95fr)">
            <SectionCard Title="Resume work" Description="These tabs are already live in the current workspace session.">
                @if (openWorkItems.Count == 0)
                {
                    <EmptyState Eyebrow="No live items"
                                Title="Nothing is currently open"
                                Description="Start a project, prompt session, validation, or test plan and it will appear here for quick return." />
                }
                else
                {
                    <Stack GapScale="LayoutGap.Medium">
                        @foreach (var tab in openWorkItems.Take(5))
                        {
                            <SelectionListItem Title="@tab.Title"
                                               Meta="@($"{tab.TabGroup} / {tab.Route}")"
                                               OnSelect="@(() => Navigation.NavigateTo(tab.Route))">
                                <Status>
                                    @if (!string.IsNullOrWhiteSpace(tab.ProjectName))
                                    {
                                        <StatusBadge Tone="info" Text="@tab.ProjectName" />
                                    }
                                </Status>
                            </SelectionListItem>
                        }
                    </Stack>
                }
            </SectionCard>

            <SectionCard Title="System footing" Description="Keep the platform context available, but subordinate it to task entry points.">
                <Stack GapScale="LayoutGap.Medium"
                       Class="text-sm leading-6 text-slate-600">
                    <p>The workbench restores tabs from browser storage, keeps route groups recoverable, and leaves room for the protected canvas-heavy surfaces to stay focused.</p>
                    <p>Generated artifacts still live under `.artifacts/`, the development runtime endpoint remains available, and tuning continues to attach only to explicit component boundaries.</p>
                    <Cluster Gap="LayoutGap.Small">
                        <StatusBadge Tone="success" Text="Workbench restore active" />
                        <StatusBadge Tone="info" Text="Module seams active" />
                        <StatusBadge Tone="neutral" Text="Focused shell enabled" />
                    </Cluster>
                </Stack>
            </SectionCard>
        </Grid>
    </ChildContent>
</PageScaffold>

@code {
    private int projectCount;
    private int validationRunCount;
    private IReadOnlyList<BackgroundJobSummary> failedJobs = [];
    private IReadOnlyList<WorkbenchTabState> openWorkItems = [];
    private IReadOnlyList<WorkbenchTabState> recentTabs = [];

    protected override async Task OnInitializedAsync()
    {
        Workbench.Changed += HandleWorkbenchChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        projectCount = (await ProjectsService.ListAsync()).Count;
        validationRunCount = (await ValidationService.ListRunsAsync()).Count;
        failedJobs = (await AutomationWorkspaceService.ListJobsAsync())
            .Where(job => job.State == BackgroundJobState.Failed)
            .OrderByDescending(job => job.UpdatedAtUtc)
            .ToList();

        openWorkItems = Workbench.Tabs
            .Where(tab => !string.Equals(tab.Route, "/", StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(tab => tab.IsDirty)
            .ThenByDescending(tab => tab.LastActivatedAtUtc ?? DateTimeOffset.MinValue)
            .ToList();

        recentTabs = Workbench.RecentTabs
            .OrderByDescending(tab => tab.ClosedAtUtc ?? DateTimeOffset.MinValue)
            .ToList();
    }

    private void HandleWorkbenchChanged()
    {
        openWorkItems = Workbench.Tabs
            .Where(tab => !string.Equals(tab.Route, "/", StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(tab => tab.IsDirty)
            .ThenByDescending(tab => tab.LastActivatedAtUtc ?? DateTimeOffset.MinValue)
            .ToList();

        recentTabs = Workbench.RecentTabs
            .OrderByDescending(tab => tab.ClosedAtUtc ?? DateTimeOffset.MinValue)
            .ToList();

        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Workbench.Changed -= HandleWorkbenchChanged;
    }
}



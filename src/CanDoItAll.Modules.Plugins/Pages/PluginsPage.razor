@page "/plugins"
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using CanDoItAll.AgentFramework.Models
@using CanDoItAll.Plugins.Abstractions
@using CanDoItAll.SharedKernel.Configuration
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject PluginCatalogService PluginCatalog
@inject PluginSettingsService PluginSettings
@inject PluginOAuthService PluginOAuth
@inject PluginPackageService PluginPackages
@inject PluginLogStore PluginLogs
@inject PluginRuntimeRestartService PluginRestart
@inject PluginPackageOptions PluginPackageOptions
@inject NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JsRuntime

<PageTitle>Plugins</PageTitle>

<PageScaffold MaxWidthClass="max-w-full">
    <Header>
        <PageHeader Eyebrow="Plugins"
                    Title="Plugin catalog"
                    Description="Review plugin manifests, runtime packages, grants, connection settings, OAuth status, and logs.">
            <Actions>
                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap" JustifyContent="JustifyContent.End">
                    <StatusBadge Tone="info" Text="@($"{packageCatalog.Count} packages")" />
                    <Button Text="Install packages"
                            Icon="inventory_2"
                            ButtonStyle="ButtonStyle.Light"
                            data-testid="plugin-packages-open"
                            Click="OpenPackageDialog" />
                    <Button Text="Refresh" ButtonStyle="ButtonStyle.Light" Click="LoadAsync" />
                </Cluster>
            </Actions>
        </PageHeader>
    </Header>

    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <Alert AlertStyle="@statusAlertStyle" Class="mb-4">
                @statusMessage
            </Alert>
        }

        @if (restartStatus.IsRestartRequired)
        {
            <Alert AlertStyle="AlertStyle.Warning" Class="mb-4">
                <Split Gap="LayoutGap.Medium" AlignItems="AlignItems.Center">
                    <Stack GapScale="LayoutGap.Tiny">
                        <strong>Plugin runtime restart required</strong>
                        <span>@restartStatus.Reason</span>
                    </Stack>
                    <Button Text="Restart application"
                            Icon="restart_alt"
                            ButtonStyle="ButtonStyle.Warning"
                            Size="ButtonSize.Small"
                            data-testid="plugin-runtime-restart"
                            Disabled="@restartStatus.IsRestartRequested"
                            IsBusy="@IsPageBusy(RestartAction)"
                            Click="RequestRestartAsync" />
                </Split>
            </Alert>
        }

        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap" Class="mb-4">
            <StatusBadge Tone="neutral" Text="@($"{catalog.Count} catalog")" />
            <StatusBadge Tone="info" Text="@($"{catalog.Count(item => item.IsInstalled)} installed")" />
            <StatusBadge Tone="success" Text="@($"{catalog.Count(item => item.IsEnabled)} enabled")" />
            <StatusBadge Tone="info" Text="@($"{packageCatalog.Count} packages")" />
            <StatusBadge Tone="warning" Text="@($"{catalog.Count(item => item.Availability == PluginCatalogAvailabilityKind.Unavailable)} unavailable")" />
        </Cluster>

        @if (catalog.Count == 0)
        {
            <EmptyState Eyebrow="No plugins"
                        Title="No plugins are registered"
                        Description="Catalog entries appear here after app sources or runtime packages provide manifests." />
        }
        else if (SelectedPlugin is { } selectedPlugin)
        {
            var selectedSettings = ResolveSettings(selectedPlugin);
            <ListDetailShell ListPaneWidth="24rem" DetailPaneClass="min-h-[38rem]" ListPaneClass="min-h-[38rem]">
                <ListHeader>
                    <ListPanelHeader Title="Available plugins"
                                     Description="Select a plugin to inspect manifest data, settings, grants, and live connections."
                                     Count="@($"{catalog.Count} plugin(s)")" />
                </ListHeader>

                <ListContent>
                    <Stack GapScale="LayoutGap.Medium">
                        @foreach (var plugin in catalog)
                        {
                            <SelectionListItem Title="@plugin.DisplayName"
                                               Eyebrow="@plugin.SourceKind.ToString()"
                                               Meta="@plugin.PluginId.Value"
                                               Summary="@plugin.Description"
                                               DataTestId="@PluginsPageHelpers.BuildPluginListTestId(plugin)"
                                               IsSelected="@(plugin.PluginId == selectedPlugin.PluginId)"
                                               OnSelect="@(() => SelectPluginAsync(plugin))">
                                <ChildContent>
                                    <Cluster Gap="LayoutGap.Small">
                                        @PluginsPageHelpers.RenderPluginIcon(plugin.Icon, "h-5 w-5")
                                        <span class="text-xs text-[var(--cda-text-muted)]">@PluginsPageHelpers.ResolveIconLabel(plugin.Icon)</span>
                                    </Cluster>
                                </ChildContent>
                                <Status>
                                    <StatusBadge Tone="@PluginsPageHelpers.ResolveInstallationTone(plugin)" Text="@plugin.InstallationState.ToString()" />
                                </Status>
                            </SelectionListItem>
                        }
                    </Stack>
                </ListContent>

                <DetailHeader>
                    <Split Gap="LayoutGap.Medium" AlignItems="AlignItems.Start">
                        <Stack GapScale="LayoutGap.Tiny">
                            <Cluster Gap="LayoutGap.Small">
                                @PluginsPageHelpers.RenderPluginIcon(selectedPlugin.Icon, "h-8 w-8")
                                <span class="cda-eyebrow">@PluginsPageHelpers.ResolveIconLabel(selectedPlugin.Icon)</span>
                            </Cluster>
                            <Cluster Gap="LayoutGap.Small">
                                <StatusBadge Tone="@PluginsPageHelpers.ResolveAvailabilityTone(selectedPlugin)" Text="@selectedPlugin.Availability.ToString()" />
                                <StatusBadge Tone="@PluginsPageHelpers.ResolveInstallationTone(selectedPlugin)" Text="@selectedPlugin.InstallationState.ToString()" />
                                <StatusBadge Tone="neutral" Text="@selectedPlugin.SourceKind.ToString()" />
                            </Cluster>
                            <h2 class="cda-title-xl">@selectedPlugin.DisplayName</h2>
                            <p class="cda-body-muted">@selectedPlugin.Description</p>
                        </Stack>

                        <Cluster Gap="LayoutGap.Tiny" Class="shrink-0">
                            @if (!selectedPlugin.IsInstalled)
                            {
                                <Button Text="Install and enable"
                                        Icon="download"
                                        ButtonStyle="ButtonStyle.Primary"
                                        Size="ButtonSize.Small"
                                        IsBusy="@IsBusy(selectedPlugin.PluginId, InstallAction)"
                                        Click="@(() => InstallAsync(selectedPlugin))" />
                            }
                            else if (selectedPlugin.IsEnabled)
                            {
                                <Button Text="Disable"
                                        Icon="block"
                                        ButtonStyle="ButtonStyle.Warning"
                                        Variant="Variant.Outlined"
                                        Size="ButtonSize.Small"
                                        IsBusy="@IsBusy(selectedPlugin.PluginId, DisableAction)"
                                        Click="@(() => DisableAsync(selectedPlugin))" />
                            }
                            else
                            {
                                <Button Text="Enable"
                                        Icon="play_arrow"
                                        ButtonStyle="ButtonStyle.Success"
                                        Size="ButtonSize.Small"
                                        IsBusy="@IsBusy(selectedPlugin.PluginId, EnableAction)"
                                        Click="@(() => EnableAsync(selectedPlugin))" />
                            }
                        </Cluster>
                    </Split>
                </DetailHeader>

                <DetailContent>
                    @if (selectedSettings is null)
                    {
                        <Alert AlertStyle="AlertStyle.Warning">
                            Plugin settings could not be loaded for @selectedPlugin.PluginId.
                        </Alert>
                    }
                    else
                    {
                        <Tabs @bind-SelectedIndex="selectedPluginTabIndex"
                              Variant="TabsVariant.WorkspaceSecondary"
                              OverflowMode="TabsOverflowMode.Wrap"
                              AriaLabel="Plugin detail sections">
                            <TabItems>
                                <TabsItem Text="Main info" Icon="info" data-testid="plugins-tab-main">
                                    <Stack GapScale="LayoutGap.Large">
                                        <FormSection Title="Plugin identity" Description="Manifest data that determines where this plugin comes from and what it can request.">
                                            <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                                <Stack GapScale="LayoutGap.Tiny">
                                                    <p class="cda-eyebrow">Plugin id</p>
                                                    <p class="break-all text-sm font-medium text-[var(--cda-text)]">@selectedPlugin.PluginId.Value</p>
                                                </Stack>
                                                <Stack GapScale="LayoutGap.Tiny">
                                                    <p class="cda-eyebrow">Version</p>
                                                    <p class="text-sm font-medium text-[var(--cda-text)]">@selectedPlugin.Version</p>
                                                </Stack>
                                                <Stack GapScale="LayoutGap.Tiny">
                                                    <p class="cda-eyebrow">Vendor</p>
                                                    <p class="text-sm font-medium text-[var(--cda-text)]">@selectedPlugin.Vendor</p>
                                                </Stack>
                                                <Stack GapScale="LayoutGap.Tiny">
                                                    <p class="cda-eyebrow">Trust</p>
                                                    <p class="text-sm font-medium text-[var(--cda-text)]">@selectedPlugin.TrustLevel</p>
                                                </Stack>
                                            </Grid>

                                            <Stack GapScale="LayoutGap.Tiny">
                                                <p class="cda-eyebrow">Capabilities</p>
                                                <Cluster Gap="LayoutGap.Tiny">
                                                    @foreach (var capability in PluginsPageHelpers.ResolveDeclaredCapabilities(selectedPlugin))
                                                    {
                                                        <StatusBadge Tone="info" Text="@capability.ToString()" />
                                                    }
                                                </Cluster>
                                            </Stack>
                                        </FormSection>

                                        @if (!string.IsNullOrWhiteSpace(selectedPlugin.UnavailableReason))
                                        {
                                            <Alert AlertStyle="AlertStyle.Warning">
                                                @selectedPlugin.UnavailableReason
                                            </Alert>
                                        }
                                    </Stack>
                                </TabsItem>

                                <TabsItem Text="Settings" Icon="tune" BadgeText="@PluginsPageHelpers.ResolveSettingsBadge(selectedSettings)" data-testid="plugins-tab-settings">
                                    @if (selectedSettings.ConnectionDescriptors.Count == 0)
                                    {
                                        <EmptyState Eyebrow="Settings"
                                                    Title="No connection settings"
                                                    Description="This plugin does not expose configurable connection descriptors." />
                                    }
                                    else
                                    {
                                        <Stack GapScale="LayoutGap.Large">
                                            @foreach (var connectionDescriptor in selectedSettings.ConnectionDescriptors)
                                            {
                                                var editor = ResolveConnectionEditor(selectedPlugin.PluginId, selectedSettings, connectionDescriptor);
                                                <FormSection Title="@connectionDescriptor.DisplayName"
                                                             Description="@connectionDescriptor.Description">
                                                    <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                                        <div>
                                                            <label class="cda-field-label">Connection name</label>
                                                            <input class="cda-input"
                                                                   value="@editor.DisplayName"
                                                                   data-testid="@PluginsPageHelpers.BuildConnectionNameTestId(selectedPlugin.PluginId, connectionDescriptor)"
                                                                   @onchange="args => HandleConnectionDisplayNameChanged(editor, args.Value?.ToString())" />
                                                        </div>
                                                        <div>
                                                            <label class="cda-field-label">State</label>
                                                            <label class="cda-inline-option">
                                                                <input type="checkbox"
                                                                       checked="@editor.IsEnabled"
                                                                       data-testid="@PluginsPageHelpers.BuildConnectionEnabledTestId(selectedPlugin.PluginId, connectionDescriptor)"
                                                                       @onchange="args => HandleConnectionEnabledChanged(editor, PluginsPageHelpers.ResolveCheckboxValue(args))" />
                                                                Enabled
                                                            </label>
                                                        </div>
                                                    </Grid>

                                                    @if (connectionDescriptor.SettingsSchema.Fields.Count == 0)
                                                    {
                                                        <p class="cda-body-muted">This connection does not define additional settings.</p>
                                                    }
                                                    else
                                                    {
                                                        <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                                            @foreach (var field in connectionDescriptor.SettingsSchema.Fields)
                                                            {
                                                                var fieldValue = editor.State.GetText(field.Key);
                                                                <div>
                                                                    <label class="cda-field-label">
                                                                        @field.Label
                                                                        @if (field.IsRequired)
                                                                        {
                                                                            <span class="ml-1 text-xs font-medium text-[var(--cda-danger)]">Required</span>
                                                                        }
                                                                    </label>

                                                                    @switch (field.FieldType)
                                                                    {
                                                                        case ConfigurationFieldType.Boolean:
                                                                            <label class="cda-inline-option">
                                                                                <input type="checkbox"
                                                                                       checked="@editor.State.GetBoolean(field.Key)"
                                                                                       data-testid="@PluginsPageHelpers.BuildConnectionFieldTestId(selectedPlugin.PluginId, connectionDescriptor, field)"
                                                                                       @onchange="args => HandleConnectionSettingChanged(editor, field.Key, PluginsPageHelpers.ResolveCheckboxValue(args) ? bool.TrueString : bool.FalseString)" />
                                                                                @field.HelpText
                                                                            </label>
                                                                            break;
                                                                        case ConfigurationFieldType.Json:
                                                                        case ConfigurationFieldType.MultilineText:
                                                                            <textarea class="cda-input cda-input--textarea min-h-24"
                                                                                      data-testid="@PluginsPageHelpers.BuildConnectionFieldTestId(selectedPlugin.PluginId, connectionDescriptor, field)"
                                                                                      @onchange="args => HandleConnectionSettingChanged(editor, field.Key, args.Value?.ToString())">@fieldValue</textarea>
                                                                            break;
                                                                        case ConfigurationFieldType.Select:
                                                                            <select class="cda-input"
                                                                                    value="@fieldValue"
                                                                                    data-testid="@PluginsPageHelpers.BuildConnectionFieldTestId(selectedPlugin.PluginId, connectionDescriptor, field)"
                                                                                    @onchange="args => HandleConnectionSettingChanged(editor, field.Key, args.Value?.ToString())">
                                                                                <option value="">Select value</option>
                                                                                @foreach (var option in field.Options)
                                                                                {
                                                                                    <option value="@option.Value">@option.Label</option>
                                                                                }
                                                                            </select>
                                                                            break;
                                                                        default:
                                                                            <input class="cda-input"
                                                                                   type="@PluginsPageHelpers.ResolveInputType(field)"
                                                                                   value="@fieldValue"
                                                                                   placeholder="@(PluginsPageHelpers.ResolveFieldPlaceholder(selectedSettings, field, Navigation.ToAbsoluteUri("/api/plugins/oauth/callback").ToString()))"
                                                                                   data-testid="@PluginsPageHelpers.BuildConnectionFieldTestId(selectedPlugin.PluginId, connectionDescriptor, field)"
                                                                                   @onchange="args => HandleConnectionSettingChanged(editor, field.Key, args.Value?.ToString())" />
                                                                            break;
                                                                    }

                                                                    @if (field.FieldType != ConfigurationFieldType.Boolean && !string.IsNullOrWhiteSpace(field.HelpText))
                                                                    {
                                                                        <p class="cda-body-muted mt-2">@field.HelpText</p>
                                                                    }

                                                                    @foreach (var issue in PluginsPageHelpers.ResolveValidationIssues(editor, field))
                                                                    {
                                                                        <p class="workflow-canvas-error">@issue.Message</p>
                                                                    }
                                                                </div>
                                                            }
                                                        </Grid>
                                                    }

                                                    <Cluster Gap="LayoutGap.Small" JustifyContent="JustifyContent.End">
                                                        <Button Text="Save settings"
                                                                Icon="save"
                                                                ButtonStyle="ButtonStyle.Primary"
                                                                Size="ButtonSize.Small"
                                                                data-testid="@PluginsPageHelpers.BuildConnectionSaveTestId(selectedPlugin.PluginId, connectionDescriptor)"
                                                                IsBusy="@IsBusy(selectedPlugin.PluginId, PluginsPageHelpers.ConnectionSaveBusyKey(connectionDescriptor))"
                                                                Click="@(() => SaveConnectionSettingsAsync(selectedPlugin, selectedSettings, connectionDescriptor))" />
                                                    </Cluster>
                                                </FormSection>
                                            }
                                        </Stack>
                                    }
                                </TabsItem>

                                <TabsItem Text="Connections" Icon="link" BadgeText="@selectedSettings.Connections.Count.ToString()" data-testid="plugins-tab-connections">
                                    @if (!selectedSettings.ConnectionDescriptors.Any(item => item.AuthKind == PluginConnectionAuthKind.OAuth2))
                                    {
                                        <EmptyState Eyebrow="Connections"
                                                    Title="No OAuth connections"
                                                    Description="This plugin does not expose OAuth-based connections." />
                                    }
                                    else
                                    {
                                        <Stack GapScale="LayoutGap.Medium">
                                            @foreach (var connectionDescriptor in selectedSettings.ConnectionDescriptors.Where(item => item.AuthKind == PluginConnectionAuthKind.OAuth2))
                                            {
                                                var connection = PluginsPageHelpers.ResolveConnection(selectedSettings, connectionDescriptor);
                                                var editor = ResolveConnectionEditor(selectedPlugin.PluginId, selectedSettings, connectionDescriptor);
                                                var oauthStatus = ResolveOAuthStatus(selectedPlugin.PluginId, connection?.Id, connectionDescriptor.Key);
                                                var canStartOAuth = PluginsPageHelpers.CanStartOAuth(selectedPlugin, selectedSettings, connectionDescriptor, editor, ConnectionSettingsValidator);
                                                <div class="grid gap-3 rounded-lg border border-[var(--cda-border-subtle)] bg-[var(--cda-surface-muted)] p-3 md:grid-cols-[minmax(0,1fr)_auto]">
                                                    <Stack GapScale="LayoutGap.Tiny">
                                                        <Cluster Gap="LayoutGap.Small">
                                                            <StatusBadge Tone="@PluginsPageHelpers.ResolveOAuthTone(oauthStatus?.Status)" Text="@(oauthStatus?.Status.ToString() ?? "NotConnected")" />
                                                            <StatusBadge Tone="neutral" Text="@connectionDescriptor.Key.Value" />
                                                        </Cluster>
                                                        <span class="text-sm font-medium text-[var(--cda-text)]">@connectionDescriptor.DisplayName</span>
                                                        <span class="text-sm text-[var(--cda-text-muted)]">@connectionDescriptor.Description</span>
                                                        @if (oauthStatus is not null && oauthStatus.GrantedScopes.Count > 0)
                                                        {
                                                            <span class="text-xs text-[var(--cda-text-muted)]">@string.Join(", ", oauthStatus.GrantedScopes)</span>
                                                        }
                                                        @if (oauthStatus is not null && !string.IsNullOrWhiteSpace(oauthStatus.LastErrorDescription))
                                                        {
                                                            <span class="text-sm text-[var(--cda-danger)]">@oauthStatus.LastErrorDescription</span>
                                                        }
                                                        @if (!canStartOAuth)
                                                        {
                                                            <span class="text-sm text-[var(--cda-warning)]">@PluginsPageHelpers.ResolveOAuthActionHint(selectedPlugin, selectedSettings, connectionDescriptor, editor, ConnectionSettingsValidator)</span>
                                                        }
                                                    </Stack>
                                                    <Cluster Gap="LayoutGap.Tiny" Class="self-start">
                                                        <Button Text="@PluginsPageHelpers.ResolveOAuthActionText(oauthStatus?.Status)"
                                                                Icon="login"
                                                                ButtonStyle="ButtonStyle.Primary"
                                                                Size="ButtonSize.Small"
                                                                data-testid="@PluginsPageHelpers.BuildOAuthLoginTestId(selectedPlugin.PluginId, connectionDescriptor)"
                                                                Disabled="@(!canStartOAuth)"
                                                                IsBusy="@IsBusy(selectedPlugin.PluginId, PluginsPageHelpers.OAuthBusyKey(connectionDescriptor, "login"))"
                                                                Click="@(() => StartOAuthAsync(selectedPlugin, selectedSettings, connectionDescriptor))" />
                                                        <Button Text="Disconnect"
                                                                Icon="link_off"
                                                                ButtonStyle="ButtonStyle.Warning"
                                                                Variant="Variant.Outlined"
                                                                Size="ButtonSize.Small"
                                                                Disabled="@(connection is null || oauthStatus?.Status != PluginOAuthConnectionStatusKind.Connected)"
                                                                IsBusy="@IsBusy(selectedPlugin.PluginId, PluginsPageHelpers.OAuthBusyKey(connectionDescriptor, "disconnect"))"
                                                                Click="@(() => DisconnectOAuthAsync(selectedPlugin, connection))" />
                                                    </Cluster>
                                                </div>
                                            }
                                        </Stack>
                                    }
                                </TabsItem>

                                <TabsItem Text="Logs" Icon="receipt_long" BadgeText="@((installationLogs.Count + runtimeLogs.Count).ToString())" data-testid="plugins-tab-logs">
                                    <Stack GapScale="LayoutGap.Medium">
                                        <Cluster Gap="LayoutGap.Small" JustifyContent="JustifyContent.SpaceBetween">
                                            <Cluster Gap="LayoutGap.Tiny">
                                                <Button Text="Selected plugin"
                                                        Icon="filter_alt"
                                                        ButtonStyle="@(showAllPluginLogs ? ButtonStyle.Light : ButtonStyle.Primary)"
                                                        Size="ButtonSize.Small"
                                                        data-testid="plugins-logs-selected-filter"
                                                        Click="@(() => SetLogScopeAsync(showAll: false))" />
                                                <Button Text="All plugins"
                                                        Icon="public"
                                                        ButtonStyle="@(showAllPluginLogs ? ButtonStyle.Primary : ButtonStyle.Light)"
                                                        Size="ButtonSize.Small"
                                                        data-testid="plugins-logs-all-filter"
                                                        Click="@(() => SetLogScopeAsync(showAll: true))" />
                                            </Cluster>
                                            <StatusBadge Tone="info" Text="@(showAllPluginLogs ? "All plugins" : selectedPlugin.DisplayName)" />
                                        </Cluster>

                                        <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                            <FormSection Title="Installation logs" Description="Package and plugin lifecycle records, newest first.">
                                                @PluginsPageHelpers.RenderLogList(installationLogs, "installation")
                                            </FormSection>
                                            <FormSection Title="Runtime logs" Description="Plugin executor and runtime event records, newest first.">
                                                @PluginsPageHelpers.RenderLogList(runtimeLogs, "runtime")
                                            </FormSection>
                                        </Grid>
                                    </Stack>
                                </TabsItem>

                                <TabsItem Text="Grants" Icon="verified_user" BadgeText="@selectedSettings.Grants.Count.ToString()" data-testid="plugins-tab-grants">
                                    @if (selectedSettings.Grants.Count == 0)
                                    {
                                        <EmptyState Eyebrow="Grants"
                                                    Title="No capability grants"
                                                    Description="This plugin does not request host capabilities." />
                                    }
                                    else
                                    {
                                        <Stack GapScale="LayoutGap.Medium">
                                            @foreach (var grant in selectedSettings.Grants)
                                            {
                                                <div class="grid gap-3 rounded-lg border border-[var(--cda-border-subtle)] bg-[var(--cda-surface-muted)] p-3 md:grid-cols-[minmax(0,1fr)_auto]">
                                                    <Stack GapScale="LayoutGap.Tiny">
                                                        <Cluster Gap="LayoutGap.Small">
                                                            <StatusBadge Tone="@PluginsPageHelpers.ResolveGrantTone(grant.State)" Text="@grant.State.ToString()" />
                                                            <StatusBadge Tone="@PluginsPageHelpers.ResolveRiskTone(grant.RiskKind)" Text="@grant.RiskKind.ToString()" />
                                                            <StatusBadge Tone="neutral" Text="@grant.Capability.ToString()" />
                                                        </Cluster>
                                                        <span class="text-sm font-medium text-[var(--cda-text)]">@PluginsPageHelpers.ResolveGrantName(grant)</span>
                                                        @if (!string.IsNullOrWhiteSpace(grant.Reason))
                                                        {
                                                            <span class="text-sm text-[var(--cda-text-muted)]">@grant.Reason</span>
                                                        }
                                                    </Stack>
                                                    <Cluster Gap="LayoutGap.Tiny" Class="self-start">
                                                        <Button Text="Grant"
                                                                Icon="check"
                                                                ButtonStyle="ButtonStyle.Success"
                                                                Size="ButtonSize.Small"
                                                                Disabled="@(grant.State == PluginGrantState.Granted)"
                                                                IsBusy="@IsBusy(selectedPlugin.PluginId, PluginsPageHelpers.GrantBusyKey(grant, "grant"))"
                                                                Click="@(() => UpdateGrantAsync(selectedPlugin, grant, PluginGrantState.Granted))" />
                                                        <Button Text="Deny"
                                                                Icon="close"
                                                                ButtonStyle="ButtonStyle.Danger"
                                                                Variant="Variant.Outlined"
                                                                Size="ButtonSize.Small"
                                                                Disabled="@(grant.State == PluginGrantState.Denied)"
                                                                IsBusy="@IsBusy(selectedPlugin.PluginId, PluginsPageHelpers.GrantBusyKey(grant, "deny"))"
                                                                Click="@(() => UpdateGrantAsync(selectedPlugin, grant, PluginGrantState.Denied))" />
                                                        <Button Text="Revoke"
                                                                Icon="undo"
                                                                ButtonStyle="ButtonStyle.Warning"
                                                                Variant="Variant.Outlined"
                                                                Size="ButtonSize.Small"
                                                                Disabled="@(grant.State == PluginGrantState.Revoked)"
                                                                IsBusy="@IsBusy(selectedPlugin.PluginId, PluginsPageHelpers.GrantBusyKey(grant, "revoke"))"
                                                                Click="@(() => UpdateGrantAsync(selectedPlugin, grant, PluginGrantState.Revoked))" />
                                                    </Cluster>
                                                </div>
                                            }
                                        </Stack>
                                    }
                                </TabsItem>
                            </TabItems>
                        </Tabs>
                    }
                </DetailContent>
            </ListDetailShell>
        }
    </ChildContent>
</PageScaffold>

<Dialog IsOpen="@showPackageDialog"
        Eyebrow="Plugin packages"
        Title="Install runtime packages"
        Subtitle="Install from the configured catalogue or upload a package archive."
        Size="ModalSize.Wide"
        TestId="plugin-packages-dialog"
        OnClose="ClosePackageDialog">
    <HeaderActions>
        <StatusBadge Tone="info" Text="@($"{packageCatalog.Count} packages")" />
    </HeaderActions>
    <ChildContent>
        <Grid Gap="LayoutGap.Large" ColumnsMd="2">
            <Stack GapScale="LayoutGap.Medium">
                <Cluster Gap="LayoutGap.Small" JustifyContent="JustifyContent.SpaceBetween">
                    <h2 class="cda-title-md">Catalogue</h2>
                    <StatusBadge Tone="info" Text="@($"{packageCatalog.Count} package(s)")" />
                </Cluster>

                @if (packageCatalog.Count == 0)
                {
                    <EmptyState Eyebrow="Packages"
                                Title="No package catalogue entries"
                                Description="Configured package archives appear here after the catalogue folder contains valid plugin packages." />
                }
                else
                {
                    <Stack GapScale="LayoutGap.Small">
                        @foreach (var package in packageCatalog)
                        {
                            <div class="grid gap-3 rounded-lg border border-[var(--cda-border-subtle)] bg-[var(--cda-surface-muted)] p-3 md:grid-cols-[minmax(0,1fr)_auto]">
                                <Stack GapScale="LayoutGap.Tiny">
                                    <Cluster Gap="LayoutGap.Small">
                                        <StatusBadge Tone="@PluginsPageHelpers.ResolvePackageTone(package)" Text="@(package.IsInstalled ? "Installed" : "Available")" />
                                        <StatusBadge Tone="neutral" Text="@package.CatalogSourceKind.ToString()" />
                                        @if (package.RequiresRestart)
                                        {
                                            <StatusBadge Tone="warning" Text="Restart" />
                                        }
                                    </Cluster>
                                    <span class="text-sm font-medium text-[var(--cda-text)]">@package.DisplayName</span>
                                    <span class="break-all text-xs text-[var(--cda-text-muted)]">@package.PackageId.Value</span>
                                    <span class="text-sm text-[var(--cda-text-muted)]">@package.Description</span>
                                </Stack>
                                <Cluster Gap="LayoutGap.Tiny" Class="self-start">
                                    <Button Text="Install"
                                            Icon="download"
                                            ButtonStyle="ButtonStyle.Primary"
                                            Size="ButtonSize.Small"
                                            data-testid="@PluginsPageHelpers.BuildPackageInstallTestId(package)"
                                            Disabled="@package.IsInstalled"
                                            IsBusy="@IsPackageBusy(package, PackageInstallAction)"
                                            Click="@(() => InstallPackageAsync(package))" />
                                </Cluster>
                            </div>
                        }
                    </Stack>
                }
            </Stack>

            <Stack GapScale="LayoutGap.Medium">
                <h2 class="cda-title-md">Upload zip</h2>
                <div>
                    <label class="cda-field-label" for="plugin-package-upload">Package archive</label>
                    <InputFile id="plugin-package-upload"
                               class="cda-input"
                               accept=".zip,application/zip"
                               data-testid="plugin-package-upload"
                               OnChange="UploadPackageAsync" />
                </div>
                @if (!string.IsNullOrWhiteSpace(packageUploadFileName))
                {
                    <p class="cda-body-muted break-all">@packageUploadFileName</p>
                }
            </Stack>
        </Grid>
    </ChildContent>
    <Footer>
        <Cluster Gap="LayoutGap.Small" JustifyContent="JustifyContent.End">
            <Button Text="Close"
                    ButtonStyle="ButtonStyle.Light"
                    Click="ClosePackageDialog" />
        </Cluster>
    </Footer>
</Dialog>

@code {
    private const string InstallAction = "install";
    private const string EnableAction = "enable";
    private const string DisableAction = "disable";
    private const string PackageInstallAction = "package-install";
    private const string PackageUploadAction = "package-upload";
    private const string RestartAction = "restart";
    private const string UiActor = "ui";

    private static readonly ConfigurationSchemaValidator ConnectionSettingsValidator = new();

    private readonly HashSet<string> busyActions = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, PluginConnectionEditorState> connectionEditors = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<PluginCatalogItem> catalog = [];
    private IReadOnlyList<PluginPackageCatalogItem> packageCatalog = [];
    private IReadOnlyList<PluginLogItem> installationLogs = [];
    private IReadOnlyList<PluginLogItem> runtimeLogs = [];
    private IReadOnlyDictionary<string, PluginSettingsDetail> settingsByPluginId = new Dictionary<string, PluginSettingsDetail>(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyDictionary<string, IReadOnlyList<PluginOAuthConnectionStatusItem>> oauthStatusesByPluginId = new Dictionary<string, IReadOnlyList<PluginOAuthConnectionStatusItem>>(StringComparer.OrdinalIgnoreCase);
    private PluginRuntimeRestartStatus restartStatus = new(false, false, string.Empty, null, string.Empty, null, Environment.ProcessId);
    private string? selectedPluginId;
    private bool showAllPluginLogs;
    private bool showPackageDialog;
    private int selectedPluginTabIndex;
    private string statusMessage = string.Empty;
    private AlertStyle statusAlertStyle = AlertStyle.Info;
    private string packageUploadFileName = string.Empty;

    private PluginCatalogItem? SelectedPlugin
        => catalog.FirstOrDefault(item => string.Equals(item.PluginId.Value, selectedPluginId, StringComparison.OrdinalIgnoreCase)) ??
           catalog.FirstOrDefault();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var previousSelectedPluginId = selectedPluginId;
        catalog = await PluginCatalog.ListCatalogAsync();
        packageCatalog = await PluginPackages.ListPackagesAsync();
        restartStatus = await PluginRestart.GetStatusAsync();
        selectedPluginId = catalog.Any(item => string.Equals(item.PluginId.Value, previousSelectedPluginId, StringComparison.OrdinalIgnoreCase))
            ? previousSelectedPluginId
            : catalog.FirstOrDefault()?.PluginId.Value;

        var settings = new Dictionary<string, PluginSettingsDetail>(StringComparer.OrdinalIgnoreCase);
        var oauthStatuses = new Dictionary<string, IReadOnlyList<PluginOAuthConnectionStatusItem>>(StringComparer.OrdinalIgnoreCase);
        foreach (var plugin in catalog)
        {
            var detail = await PluginSettings.GetSettingsAsync(plugin.PluginId);
            if (detail is not null)
            {
                settings[plugin.PluginId.Value] = detail;
            }

            oauthStatuses[plugin.PluginId.Value] = await PluginOAuth.ListStatusesAsync(plugin.PluginId);
        }

        settingsByPluginId = settings;
        oauthStatusesByPluginId = oauthStatuses;
        await LoadPluginLogsAsync();
        InitializeConnectionEditors();
    }

    private async Task SelectPluginAsync(PluginCatalogItem plugin)
    {
        selectedPluginId = plugin.PluginId.Value;
        selectedPluginTabIndex = 0;
        await LoadPluginLogsAsync();
    }

    private async Task SetLogScopeAsync(bool showAll)
    {
        showAllPluginLogs = showAll;
        await LoadPluginLogsAsync();
    }

    private Task OpenPackageDialog()
    {
        showPackageDialog = true;
        return Task.CompletedTask;
    }

    private Task ClosePackageDialog()
    {
        showPackageDialog = false;
        return Task.CompletedTask;
    }

    private async Task LoadPluginLogsAsync()
    {
        var pluginFilter = showAllPluginLogs ? null : SelectedPlugin?.PluginId;
        installationLogs = await PluginLogs.ListAsync(new PluginLogQuery(
            PluginLogStreamKind.Installation,
            pluginFilter,
            Take: 50));
        runtimeLogs = await PluginLogs.ListAsync(new PluginLogQuery(
            PluginLogStreamKind.Runtime,
            pluginFilter,
            Take: 50));
    }

    private Task InstallAsync(PluginCatalogItem plugin)
        => RunPluginActionAsync(plugin.PluginId, InstallAction, async () =>
        {
            var result = await PluginCatalog.InstallAsync(plugin.PluginId, new PluginInstallRequest(Enable: true, Actor: UiActor));
            ApplyStatus(result, $"Installed {plugin.DisplayName}.");
        });

    private Task EnableAsync(PluginCatalogItem plugin)
        => RunPluginActionAsync(plugin.PluginId, EnableAction, async () =>
        {
            var result = await PluginCatalog.SetEnabledAsync(plugin.PluginId, isEnabled: true, new PluginInstallationUpdateRequest(UiActor));
            ApplyStatus(result, $"Enabled {plugin.DisplayName}.");
        });

    private Task DisableAsync(PluginCatalogItem plugin)
        => RunPluginActionAsync(plugin.PluginId, DisableAction, async () =>
        {
            var result = await PluginCatalog.SetEnabledAsync(plugin.PluginId, isEnabled: false, new PluginInstallationUpdateRequest(UiActor));
            ApplyStatus(result, $"Disabled {plugin.DisplayName}.");
        });

    private Task InstallPackageAsync(PluginPackageCatalogItem package)
        => RunPackageActionAsync(package.PackageId, PackageInstallAction, async () =>
        {
            var result = await PluginPackages.InstallFromCatalogAsync(
                package.PackageId,
                new PluginPackageInstallRequest(Enable: true, Actor: UiActor));
            ApplyStatus(result, result.Value?.RestartRequired == true
                ? $"Installed {package.DisplayName}. Restart is required before runtime assemblies are active."
                : $"Installed {package.DisplayName}.");
        });

    private async Task UploadPackageAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        packageUploadFileName = file.Name;
        await RunPageActionAsync(PackageUploadAction, async () =>
        {
            await using var stream = file.OpenReadStream(PluginPackageOptions.MaxPackageBytes);
            var result = await PluginPackages.InstallUploadedPackageAsync(
                stream,
                file.Name,
                new PluginPackageInstallRequest(Enable: true, Actor: UiActor));
            ApplyStatus(result, result.Value?.RestartRequired == true
                ? $"Uploaded {file.Name}. Restart is required before runtime assemblies are active."
                : $"Uploaded {file.Name}.");
        });
    }

    private Task RequestRestartAsync()
        => RunPageActionAsync(RestartAction, async () =>
        {
            var result = await PluginRestart.RequestRestartAsync(new PluginRuntimeRestartRequest(UiActor));
            ApplyStatus(result, "Restart requested.");
        });

    private Task UpdateGrantAsync(
        PluginCatalogItem plugin,
        PluginCapabilityGrantItem grant,
        PluginGrantState state)
        => RunPluginActionAsync(plugin.PluginId, PluginsPageHelpers.GrantBusyKey(grant, state.ToString()), async () =>
        {
            var request = new PluginGrantUpdateRequest(
                grant.Capability,
                state,
                grant.RecipeId?.Value,
                grant.ScopeKind,
                grant.ScopeKey,
                grant.RiskKind,
                $"{state} from plugin settings UI.");
            var result = await PluginSettings.UpdateGrantAsync(plugin.PluginId, request, UiActor);
            ApplyStatus(result, $"{state} {PluginsPageHelpers.ResolveGrantName(grant)} for {plugin.DisplayName}.");
        });

    private async Task SaveConnectionSettingsAsync(
        PluginCatalogItem plugin,
        PluginSettingsDetail settings,
        PluginConnectionDescriptor descriptor)
    {
        var editor = ResolveConnectionEditor(plugin.PluginId, settings, descriptor);
        var settingsState = editor.State.Clone();
        settingsState.KeepOnly(descriptor.SettingsSchema.Fields.Select(field => field.Key));
        var validation = ConnectionSettingsValidator.Validate(descriptor.SettingsSchema, settingsState);
        editor.Validation = validation;
        if (!validation.Succeeded)
        {
            statusAlertStyle = AlertStyle.Danger;
            statusMessage = string.Join(" ", validation.Issues.Select(issue => issue.Message));
            return;
        }

        await RunPluginActionAsync(plugin.PluginId, PluginsPageHelpers.ConnectionSaveBusyKey(descriptor), async () =>
        {
            var result = await PluginSettings.SaveConnectionAsync(
                plugin.PluginId,
                new PluginConnectionSaveRequest(
                    editor.ConnectionId,
                    descriptor.Key,
                    editor.DisplayName,
                    settingsState.ToJson(),
                    editor.IsEnabled),
                UiActor);
            ApplyStatus(result, $"Saved {descriptor.DisplayName} settings for {plugin.DisplayName}.");
        });
    }

    private Task StartOAuthAsync(
        PluginCatalogItem plugin,
        PluginSettingsDetail settings,
        PluginConnectionDescriptor connectionDescriptor)
        => RunPluginActionAsync(plugin.PluginId, PluginsPageHelpers.OAuthBusyKey(connectionDescriptor, "login"), async () =>
        {
            var connection = PluginsPageHelpers.ResolveConnection(settings, connectionDescriptor);
            var result = await PluginOAuth.StartAsync(
                plugin.PluginId,
                new PluginOAuthStartRequest(
                    connectionDescriptor.Key,
                    connection?.Id,
                    connectionDescriptor.DisplayName,
                    "/plugins"),
                Navigation.ToAbsoluteUri("/"),
                UiActor);
            if (result.IsFailure)
            {
                ApplyStatus(result, string.Empty);
                return;
            }

            await JsRuntime.InvokeVoidAsync("open", result.Value!.AuthorizationUrl, "_blank", "noopener,noreferrer");
            statusAlertStyle = AlertStyle.Info;
            statusMessage = "OAuth login opened in a new browser tab.";
        });

    private Task DisconnectOAuthAsync(
        PluginCatalogItem plugin,
        PluginConnectionItem? connection)
        => connection is null
            ? Task.CompletedTask
            : RunPluginActionAsync(plugin.PluginId, $"oauth-disconnect:{connection.Id.Value:D}", async () =>
            {
                var result = await PluginOAuth.DisconnectAsync(plugin.PluginId, connection.Id);
                ApplyStatus(result, $"Disconnected {connection.DisplayName}.");
            });

    private async Task RunPluginActionAsync(
        PluginId pluginId,
        string action,
        Func<Task> operation)
        => await RunBusyActionAsync(PluginsPageHelpers.BusyKey(pluginId, action), operation);

    private async Task RunPackageActionAsync(
        PluginPackageId packageId,
        string action,
        Func<Task> operation)
        => await RunBusyActionAsync(PluginsPageHelpers.PackageBusyKey(packageId, action), operation);

    private async Task RunPageActionAsync(
        string action,
        Func<Task> operation)
        => await RunBusyActionAsync(PluginsPageHelpers.PageBusyKey(action), operation);

    private async Task RunBusyActionAsync(
        string key,
        Func<Task> operation)
    {
        if (!busyActions.Add(key))
        {
            return;
        }

        statusMessage = string.Empty;
        try
        {
            await operation();
            await LoadAsync();
        }
        catch (Exception exception)
        {
            statusAlertStyle = AlertStyle.Danger;
            statusMessage = exception.Message;
        }
        finally
        {
            busyActions.Remove(key);
        }
    }

    private void ApplyStatus<T>(CanDoItAll.SharedKernel.Result<T> result, string successMessage)
    {
        if (result.IsSuccess)
        {
            statusAlertStyle = AlertStyle.Success;
            statusMessage = successMessage;
            return;
        }

        statusAlertStyle = AlertStyle.Danger;
        statusMessage = string.Join(" ", result.Errors.Select(error => error.Message));
    }

    private PluginSettingsDetail? ResolveSettings(PluginCatalogItem plugin)
        => settingsByPluginId.TryGetValue(plugin.PluginId.Value, out var settings)
            ? settings
            : null;

    private void InitializeConnectionEditors()
    {
        var validKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var plugin in catalog)
        {
            if (!settingsByPluginId.TryGetValue(plugin.PluginId.Value, out var settings))
            {
                continue;
            }

            foreach (var descriptor in settings.ConnectionDescriptors)
            {
                var editorKey = PluginsPageHelpers.ConnectionEditorKey(plugin.PluginId, descriptor.Key);
                validKeys.Add(editorKey);
                var connection = PluginsPageHelpers.ResolveConnection(settings, descriptor);
                connectionEditors[editorKey] = PluginConnectionEditorState.Create(descriptor, connection);
            }
        }

        foreach (var staleKey in connectionEditors.Keys.Where(key => !validKeys.Contains(key)).ToArray())
        {
            connectionEditors.Remove(staleKey);
        }
    }

    private PluginConnectionEditorState ResolveConnectionEditor(
        PluginId pluginId,
        PluginSettingsDetail settings,
        PluginConnectionDescriptor descriptor)
    {
        var key = PluginsPageHelpers.ConnectionEditorKey(pluginId, descriptor.Key);
        if (!connectionEditors.TryGetValue(key, out var editor))
        {
            editor = PluginConnectionEditorState.Create(descriptor, PluginsPageHelpers.ResolveConnection(settings, descriptor));
            connectionEditors[key] = editor;
        }

        return editor;
    }

    private void HandleConnectionDisplayNameChanged(PluginConnectionEditorState editor, string? value)
    {
        editor.DisplayName = string.IsNullOrWhiteSpace(value)
            ? editor.ConnectionKey.Value
            : value.Trim();
        editor.IsDirty = true;
    }

    private static void HandleConnectionEnabledChanged(PluginConnectionEditorState editor, bool value)
    {
        editor.IsEnabled = value;
        editor.IsDirty = true;
    }

    private static void HandleConnectionSettingChanged(PluginConnectionEditorState editor, string key, string? value)
    {
        var state = editor.State.Clone();
        state.SetText(key, value);
        editor.State = state;
        editor.Validation = ConfigurationValidationResult.Success;
        editor.IsDirty = true;
    }

    private bool IsBusy(PluginId pluginId, string action)
        => busyActions.Contains(PluginsPageHelpers.BusyKey(pluginId, action));

    private bool IsPackageBusy(PluginPackageCatalogItem package, string action)
        => busyActions.Contains(PluginsPageHelpers.PackageBusyKey(package.PackageId, action));

    private bool IsPageBusy(string action)
        => busyActions.Contains(PluginsPageHelpers.PageBusyKey(action));

    private PluginOAuthConnectionStatusItem? ResolveOAuthStatus(
        PluginId pluginId,
        PluginConnectionId? connectionId,
        PluginConnectionKey connectionKey)
    {
        if (!oauthStatusesByPluginId.TryGetValue(pluginId.Value, out var statuses))
        {
            return null;
        }

        if (connectionId is { } id)
        {
            return statuses.SingleOrDefault(item => item.ConnectionId == id);
        }

        return statuses
            .Where(item => item.ConnectionKey == connectionKey)
            .OrderByDescending(item => item.UpdatedAtUtc)
            .FirstOrDefault();
    }

}

@namespace CanDoItAll.Space3D.Mouse.Sandbox.Components
@inherits LayoutComponentBase

<ThemeHost>
    <div class="webgl-shell">
        <div class="webgl-shell__aurora webgl-shell__aurora--left" aria-hidden="true"></div>
        <div class="webgl-shell__aurora webgl-shell__aurora--right" aria-hidden="true"></div>

        <header class="webgl-shell__header">
            <a class="webgl-shell__brand" href="/">
                <span class="webgl-shell__eyebrow">CanDoItAll</span>
                <strong class="webgl-shell__title">Space3D Mouse Sandbox</strong>
            </a>
            <p class="webgl-shell__summary">Sandbox host for the BNO085 BLE MIDI mouse driver, reusable components, and live scene-alignment validation inside CanDoItAll.</p>
        </header>

        <main class="webgl-shell__body">
            @Body
        </main>
    </div>
</ThemeHost>

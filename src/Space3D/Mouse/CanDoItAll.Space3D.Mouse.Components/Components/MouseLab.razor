    private Task ChangeAxisInversionAsync(string axisKey, ChangeEventArgs args)
    {
        var inverted = args.Value is bool value
            ? value
            : string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

        sceneTransform.SetAxisInverted(axisKey, inverted);
        statusMessage = inverted
            ? $"Scene {axisKey} is now inverted."
            : $"Scene {axisKey} inversion removed.";
        RebuildSurface();
        return RequestUiRefreshAsync(force: true);

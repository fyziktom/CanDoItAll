    private string ButtonsLabel
    {
        get
        {
            if (latestTelemetry is null)
            {
                return "--";
            }

            var parts = new List<string>();
            if ((latestTelemetry.PressedButtons & 0x01) != 0)
            {
                parts.Add("A");
            }

            if ((latestTelemetry.PressedButtons & 0x02) != 0)
            {
                parts.Add("B");
            }

            if ((latestTelemetry.PressedButtons & 0x04) != 0)
            {
                parts.Add("ADC");
            }

            if (parts.Count == 0)
            {
                parts.Add("none");
            }

            return $"{string.Join("+", parts)} (0x{latestTelemetry.PressedButtons:X2})";
        }
    }


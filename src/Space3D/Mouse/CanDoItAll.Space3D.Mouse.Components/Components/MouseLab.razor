            : $"yaw {sceneTelemetry.ForwardAzimuthDeg:+0.0;-0.0;+0.0} deg | pitch {sceneTelemetry.ForwardElevationDeg:+0.0;-0.0;+0.0} deg | roll {sceneTelemetry.RollDeg:+0.0;-0.0;+0.0} deg";

    private string SelectedNodeTitle
        => surface.Nodes.FirstOrDefault(node => string.Equals(node.Id, selectedNodeId, StringComparison.Ordinal))?.Title ?? "None";

    private Task HandleSelectedInspectorTabChangedAsync(int index)
    {
        selectedInspectorTabIndex = index;
        return Task.CompletedTask;
    }

    private string BleDebugLogText
        => bleDebugLog.Count == 0
            ? "No captured BLE packets yet. Use Capture 96 Packets, then reconnect or move the module for a few seconds."
            : string.Join(Environment.NewLine, bleDebugLog);

    private string BleDebugCapturePathLabel
        => string.IsNullOrWhiteSpace(BleDebugCaptureFilePath)
            ? "disabled"
            : BleDebugCaptureFilePath;

    private void PersistBleDebugLog()
    {
        if (string.IsNullOrWhiteSpace(BleDebugCaptureFilePath))
        {
            bleDebugFileStatus = "not persisted";
            return;
        }

        try
        {
            var directory = System.IO.Path.GetDirectoryName(BleDebugCaptureFilePath);
            if (!string.IsNullOrWhiteSpace(directory))
            {
                System.IO.Directory.CreateDirectory(directory);
            }

            System.IO.File.WriteAllLines(BleDebugCaptureFilePath, bleDebugLog);
            bleDebugFileStatus = $"{bleDebugLog.Count} lines written";
        }
        catch (Exception exception)
        {
            bleDebugFileStatus = $"write failed: {exception.Message}";
        }
    }

    private static string FormatVector(SceneVector? vector)
        => vector is null
            ? "--"
            : $"{vector.Value.X:+0.000;-0.000;+0.000}, {vector.Value.Y:+0.000;-0.000;+0.000}, {vector.Value.Z:+0.000;-0.000;+0.000}";

    private static string FormatNumber(double value)
        => value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    private static bool TryParseDouble(string? valueText, out double value)
        => double.TryParse(valueText, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out value) ||
           double.TryParse(valueText, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.CurrentCulture, out value);

    private static string FormatQuaternion(System.Numerics.Quaternion? quaternion)
        => quaternion is null
            ? "--"
            : $"{quaternion.Value.W:+0.000;-0.000;+0.000}, {quaternion.Value.X:+0.000;-0.000;+0.000}, {quaternion.Value.Y:+0.000;-0.000;+0.000}, {quaternion.Value.Z:+0.000;-0.000;+0.000}";

    private static string FormatFrameHex(IReadOnlyList<int>? bytes)
    {
        if (bytes is null || bytes.Count == 0)
        {
            return "--";
        }

        const int maxShownBytes = 56;
        var shownBytes = bytes
            .Take(maxShownBytes)
            .Select(value => $"{value & 0xFF:X2}");
        var suffix = bytes.Count > maxShownBytes ? " ..." : string.Empty;
        return string.Join(" ", shownBytes) + suffix;
    }

    private static string FormatAngle(double degrees)
        => $"{degrees:+0;-0;+0} deg";

    private static string FormatAngleInput(double degrees)
        => degrees.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static bool TryParseAngle(string? valueText, out double degrees)
        => double.TryParse(valueText, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out degrees) ||
           double.TryParse(valueText, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.CurrentCulture, out degrees);

    private static bool IsNeutralCaptureStable(MouseTelemetrySnapshot pose)
        => pose.GyroMagnitudeDps <= NeutralCaptureGyroThresholdDps &&
           pose.LinearAccelMagnitudeG <= NeutralCaptureAccelThresholdG;

    private static string FormatMillivolts(int millivolts)
        => $"{(millivolts / 1000d):0.00} V";

    private static int[] BuildDemoFrame()
    {
        var orientation = System.Numerics.Quaternion.CreateFromYawPitchRoll(
            yaw: DegreesToRadians(34f),
            pitch: DegreesToRadians(-18f),
            roll: DegreesToRadians(11f));

        var bytes = new byte[48];
        var index = 0;
        bytes[index++] = 0xF0;
        bytes[index++] = 0x7D;
        bytes[index++] = (byte)'I';
        bytes[index++] = (byte)'D';
        bytes[index++] = (byte)'R';
        bytes[index++] = (byte)'M';
        bytes[index++] = 0x01;
        bytes[index++] = 0x03;
        bytes[index++] = 0x09;
        bytes[index++] = 0x31;
        bytes[index++] = 0x00;
        bytes[index++] = 0x01;
        bytes[index++] = 0x5F;
        bytes[index++] = 0x3F;
        bytes[index++] = 0x04;
        bytes[index++] = 0x03;
        AppendUnsigned14(bytes, ref index, 612);
        AppendUnsigned14(bytes, ref index, 493);
        bytes[index++] = 0x04;
        bytes[index++] = 0x07;
        AppendUnsigned14(bytes, ref index, 598);
        AppendUnsigned14(bytes, ref index, 482);
        AppendSigned14(bytes, ref index, QuantizeSigned(orientation.W, 4096f));
        AppendSigned14(bytes, ref index, QuantizeSigned(orientation.X, 4096f));
        AppendSigned14(bytes, ref index, QuantizeSigned(orientation.Y, 4096f));
        AppendSigned14(bytes, ref index, QuantizeSigned(orientation.Z, 4096f));
        AppendSigned14(bytes, ref index, QuantizeSigned(46f, 2f));
        AppendSigned14(bytes, ref index, QuantizeSigned(-62f, 2f));
        AppendSigned14(bytes, ref index, QuantizeSigned(18f, 2f));
        AppendSigned14(bytes, ref index, QuantizeSigned(0.08f, 1024f));
        AppendSigned14(bytes, ref index, QuantizeSigned(-0.03f, 1024f));
        AppendSigned14(bytes, ref index, QuantizeSigned(0.11f, 1024f));

        bytes[index++] = ComputeCrc7(bytes, 1, index - 1);
        bytes[index++] = 0xF7;
        return bytes.Select(value => (int)value).ToArray();
    }

    private static void AppendUnsigned14(byte[] buffer, ref int index, int value)
    {
        buffer[index++] = (byte)(value & 0x7F);
        buffer[index++] = (byte)((value >> 7) & 0x7F);
    }

    private static void AppendSigned14(byte[] buffer, ref int index, int value)
        => AppendUnsigned14(buffer, ref index, Math.Clamp(value + 8192, 0, 16383));

    private static int QuantizeSigned(float value, float scale)
        => (int)Math.Round(value * scale, MidpointRounding.AwayFromZero);

    private static byte ComputeCrc7(byte[] bytes, int offset, int length)
    {
        byte crc = 0;
        for (var index = offset; index < (offset + length); index++)
        {
            crc ^= (byte)(bytes[index] & 0x7F);
        }

        return (byte)(crc & 0x7F);
    }

    private static float DegreesToRadians(float degrees)
        => degrees * MathF.PI / 180f;

    public async ValueTask DisposeAsync()
    {
        if (bleBridgeModule is not null)
        {
            try
            {
                await bleBridgeModule.InvokeVoidAsync("dispose");
                await bleBridgeModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        objectReference?.Dispose();
    }

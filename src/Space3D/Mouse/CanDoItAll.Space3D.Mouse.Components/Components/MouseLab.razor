    private bool ApplyModuleCalibrationChange(MouseTelemetrySnapshot pose)
    {
        var moduleCalibrationChanged =
            lastModuleCalibrationGeneration is not null &&
            (lastModuleCalibrationGeneration.Value != pose.CalibrationGeneration ||
             lastModuleCalibrationValid != pose.CalibrationValid);
        var firstCalibratedFrame =
            lastModuleCalibrationGeneration is null &&
            pose.CalibrationValid &&
            pose.PoseValid &&
            !sceneTransform.HasReference;

        lastModuleCalibrationGeneration = pose.CalibrationGeneration;
        lastModuleCalibrationValid = pose.CalibrationValid;

        if (moduleCalibrationChanged && !pose.CalibrationValid)
        {
            pendingModuleCalibrationGeneration = null;
            sceneTransform.ClearReference();
            statusMessage = "Module calibration cleared; scene neutral was cleared too.";
            return true;
        }

        if (moduleCalibrationChanged || firstCalibratedFrame)
        {
            pendingModuleCalibrationGeneration = pose.CalibrationGeneration;
        }

        if (pendingModuleCalibrationGeneration is not int pendingGeneration ||
            !pose.CalibrationValid ||
            pose.CalibrationGeneration != pendingGeneration)
        {
            return moduleCalibrationChanged || firstCalibratedFrame;
        }

        if (!pose.PoseValid)
        {
            statusMessage = "Module calibration changed; waiting for the next valid pose to lock scene neutral.";
            return true;
        }

        if (!IsNeutralCaptureStable(pose))
        {
            statusMessage = "Module calibration changed; hold the module still so host neutral can lock at the true center.";
            return true;
        }

        if (sceneTransform.CaptureReference(pose))
        {
            pendingModuleCalibrationGeneration = null;
            statusMessage = "Module calibration detected: scene neutral and cursor position reset to origin.";
            return true;
        }

        statusMessage = "Module calibration changed, but scene neutral could not be captured from this frame.";
        return true;
    }


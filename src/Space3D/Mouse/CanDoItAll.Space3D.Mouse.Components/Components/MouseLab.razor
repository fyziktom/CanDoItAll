    [JSInvokable]
    public async Task OnBleSysExFrame(int[] data)
    {
        bleDiagnostics.FrameCount = Math.Max(bleDiagnostics.FrameCount + 1, receivedFrameCount + parseFailureCount + 1);
        if (Space3DMouseProtocol.TryParseTelemetry(data, out var pose, out var rejectReason))
        {
            if (lastFrameAt is DateTimeOffset previousFrameAt)
            {
                lastTelemetryIntervalMs = Math.Max(0d, (pose.ReceivedAt - previousFrameAt).TotalMilliseconds);
            }

            latestTelemetry = pose;
            receivedFrameCount++;
            lastFrameAt = pose.ReceivedAt;
            lastRejectedFrameReason = "--";
            if (!ApplyModuleCalibrationChange(pose))
            {
                statusMessage = "Live 3D-mouse telemetry received.";
            }

            RebuildSurface();
            if (TelemetryReceived.HasDelegate)
            {
                await TelemetryReceived.InvokeAsync(pose);
            }

            await RequestUiRefreshAsync();
            return;
        }

        parseFailureCount++;
        lastRejectedFrameLength = data?.Length ?? 0;
        lastRejectedFrameHex = FormatFrameHex(data);
        lastRejectedFrameReason = string.IsNullOrWhiteSpace(rejectReason) ? "Parser rejected the frame." : rejectReason;
        statusMessage = $"BLE frame rejected by 3D mouse parser. {lastRejectedFrameReason}";
        await RequestUiRefreshAsync();
    }

    [JSInvokable]
    public Task OnBleError(string error)
    {
        statusMessage = string.IsNullOrWhiteSpace(error) ? "BLE bridge error." : error;
        return RequestUiRefreshAsync(force: true);
    }

    public async Task ConnectAsync()
    {
        if (bleBridgeModule is null)
        {
            statusMessage = "BLE bridge is not initialized yet. Wait for the lab panel to finish loading, then try Connect BLE again.";
            await RequestUiRefreshAsync(force: true);
            return;
        }

        connectBusy = true;
        statusMessage = "Connecting through the browser BLE-MIDI flow...";
        StateHasChanged();

        try
        {
            bleDiagnostics = await bleBridgeModule.InvokeAsync<BleBridgeDiagnostics>("connect");
            statusMessage = bleDiagnostics.NotificationsActive
                ? "BLE connected. Waiting for 3D-mouse telemetry."
                : "Connect request completed.";
        }
        catch (JSException exception)
        {
            statusMessage = string.IsNullOrWhiteSpace(exception.Message)
                ? "Browser BLE connect request failed."
                : exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            statusMessage = string.IsNullOrWhiteSpace(exception.Message)
                ? "Browser BLE connect request failed before it reached the bridge."
                : exception.Message;
        }
        catch (OperationCanceledException exception)
        {
            statusMessage = string.IsNullOrWhiteSpace(exception.Message)
                ? "Browser BLE connect request was canceled."
                : exception.Message;
        }
        finally
        {
            connectBusy = false;
            RebuildSurface();
            await RequestUiRefreshAsync(force: true);
        }
    }

    public async Task DisconnectAsync()
    {
        if (bleBridgeModule is null)
        {
            statusMessage = "BLE bridge is not initialized, so there is no active browser connection to disconnect.";
            await RequestUiRefreshAsync(force: true);
            return;
        }

        try
        {
            bleDiagnostics = await bleBridgeModule.InvokeAsync<BleBridgeDiagnostics>("disconnect");
            statusMessage = "BLE disconnected.";
        }
        catch (JSException exception)
        {
            statusMessage = string.IsNullOrWhiteSpace(exception.Message)
                ? "Browser BLE disconnect request failed."
                : exception.Message;
        }
        finally
        {
            RebuildSurface();
            await RequestUiRefreshAsync(force: true);
        }
    }


    private Task CaptureSceneCalibrationAsync()
    {
        if (latestTelemetry is null || !latestTelemetry.PoseValid)
        {
            statusMessage = "Capture a valid live pose after device calibration.";
            RebuildSurface();
            return RequestUiRefreshAsync(force: true);
        }

        if (!IsNeutralCaptureStable(latestTelemetry))
        {
            statusMessage = "Hold the module still before capture so neutral lands at the center of the sphere.";
            RebuildSurface();
            return RequestUiRefreshAsync(force: true);
        }

        var captured = sceneTransform.CaptureReference(latestTelemetry);
        if (captured)
        {
            uiState.Camera = MouseLabSceneFactory.CreateYForwardCameraState();
            uiState.CameraRevision++;
            statusMessage = "Scene neutral locked: cursor moved to origin, orientation deltas reset, and camera now looks toward +Y.";
        }
        else
        {
            statusMessage = "Capture a valid live pose after device calibration.";
        }

        RebuildSurface();
        return RequestUiRefreshAsync(force: true);
    }


@namespace CanDoItAll.Space3D.Mouse.Components
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="visualizer-shell">
    <PageScaffold Mode="PageScaffoldMode.FocusWorkbench"
                  MaxWidthClass="max-w-[1880px]">
        <Header>
            <section class="visualizer-page-header">
                <PageHeader Eyebrow="CanDoItAll Space3D mouse"
                            Title="BNO085 alignment lab over BLE MIDI"
                            Compact="true">
                    <Actions>
                        <div class="visualizer-actions">
                            <button class="visualizer-button visualizer-button--primary"
                                    @onclick="ConnectAsync"
                                    disabled="@(!CanConnectBle)">
                                @(connectBusy ? "Connecting..." : "Connect BLE")
                            </button>
                            <button class="visualizer-button"
                                    @onclick="DisconnectAsync"
                                    disabled="@(!CanDisconnectBle)">
                                Disconnect
                            </button>
                            <button class="visualizer-button"
                                    @onclick="CaptureSceneCalibrationAsync"
                                    disabled="@(latestTelemetry is null || !latestTelemetry.PoseValid)">
                                Capture Neutral
                            </button>
                            <button class="visualizer-button"
                                    @onclick="ClearSceneCalibrationAsync"
                                    disabled="@(!sceneTransform.HasReference)">
                                Clear Neutral
                            </button>
                        </div>
                    </Actions>
                </PageHeader>

                <details class="visualizer-hint">
                    <summary>Mount and motion hint</summary>
                    <p>
                        This lab keeps only the live cursor, four plane markers, and XYZ axes so you can judge
                        orientation matching without scene clutter. The default mount assumption treats the M5StickC
                        grip as right=`-X`, pointing forward=`+Y`, and up=`+Z`; after neutral capture the cursor uses
                        neutral-relative yaw and pitch on the front hemisphere, while roll remains visible in the local
                        orientation arrows and angle readout.
                    </p>
                </details>
            </section>
        </Header>

        <ChildContent>
            <div class="visualizer-workbench-grid">
                <section class="visualizer-stage-card visualizer-stage-card--hero">
                    <div class="visualizer-stage-card__header visualizer-stage-card__header--tight">
                        <div class="visualizer-stage-card__copy">
                            <p class="visualizer-card-kicker">Live workbench</p>
                            <h2>3D mouse lab space</h2>
                        </div>
                        <div class="visualizer-stage-card__meta">
                            <span class="@StatusChipClass">@ConnectionLabel</span>
                            <span class="visualizer-status-item">Frames @receivedFrameCount</span>
                            <span class="visualizer-status-item">Source @OrientationSourceLabel</span>
                            <span class="visualizer-status-item">Selection @SelectedNodeTitle</span>
                        </div>
                    </div>

                    <div class="visualizer-stage-tools">
                        <button class="visualizer-button visualizer-button--compact"
                                @onclick="FitViewAsync">
                            Fit View
                        </button>
                        <button class="visualizer-button visualizer-button--compact"
                                @onclick="ResetCameraAsync">
                            Reset Camera
                        </button>
                        <button class="visualizer-button visualizer-button--compact"
                                @onclick='() => FocusNodeAsync(MouseLabSceneFactory.PointerNodeId)'>
                            Focus Pointer
                        </button>
                        <button class="visualizer-button visualizer-button--compact"
                                @onclick="LoadDemoFrameAsync">
                            Load Demo Frame
                        </button>
                    </div>

                    <details class="visualizer-hint visualizer-hint--inline">
                        <summary>Stage hint</summary>
                        <p>
                            Origin is the sphere center. After calibration the cursor starts at the front pole on `+Y`
                            and then moves on the front hemisphere from yaw and pitch deltas; smaller arrows show full
                            local module rotation including roll.
                        </p>
                    </details>

                    <div class="visualizer-stage-frame">
                        <WebGlWorkbench @ref="workbench"
                                        Surface="@surface"
                                        SelectionChanged="HandleSelectionChanged"
                                        StateChanged="HandleWorkbenchStateChanged" />
                    </div>
                </section>

                <aside class="visualizer-rail">
                    <section class="visualizer-card visualizer-card--rail">
                        <div class="visualizer-card__header">
                            <div>
                                <h2>Inspector</h2>
                                <span>Tabs keep one focused data panel visible.</span>
                            </div>
                            <div class="visualizer-rail-stats">
                                <span class="visualizer-status-item">Packets @rawPacketCount</span>
                                <span class="visualizer-status-item">Parse @parseFailureCount</span>
                            </div>
                        </div>

                        <Tabs SelectedIndex="@selectedInspectorTabIndex"
                              SelectedIndexChanged="HandleSelectedInspectorTabChangedAsync"
                              Variant="TabsVariant.WorkspaceSecondary"
                              BorderMode="TabsBorderMode.Soft"
                              Tone="TabsTone.Secondary"
                              OverflowMode="TabsOverflowMode.Wrap"
                              PanelOverflowMode="TabsPanelOverflowMode.Auto"
                              Class="visualizer-tabs"
                              AriaLabel="3D mouse diagnostics tabs">
                            <TabItems>
                                <TabsItem Text="Link">
                                    <div class="visualizer-tab-panel">
                                        <details class="visualizer-hint">
                                            <summary>What this tab shows</summary>
                                            <p>BLE device state, notification health, rejected frames, and the last transport error.</p>
                                        </details>

                                        <dl class="visualizer-metrics">
                                            <div>
                                                <dt>Device</dt>
                                                <dd>@(bleDiagnostics.SelectedDeviceName is { Length: > 0 } ? bleDiagnostics.SelectedDeviceName : "No device")</dd>
                                            </div>
                                            <div>
                                                <dt>State</dt>
                                                <dd>@ConnectionLabel</dd>
                                            </div>
                                            <div>
                                                <dt>Remembered</dt>
                                                <dd>@(bleDiagnostics.HasRememberedDevice ? "Yes" : "No")</dd>
                                            </div>
                                            <div>
                                                <dt>Notifications</dt>
                                                <dd>@(bleDiagnostics.NotificationsActive ? "Active" : "Inactive")</dd>
                                            </div>
                                            <div>
                                                <dt>Last frame</dt>
                                                <dd>@LastFrameLabel</dd>
                                            </div>
                                            <div>
                                                <dt>Source</dt>
                                                <dd>@OrientationSourceLabel</dd>
                                            </div>
                                            <div>
                                                <dt>Last error</dt>
                                                <dd>@(string.IsNullOrWhiteSpace(bleDiagnostics.LastError) ? "None" : bleDiagnostics.LastError)</dd>
                                            </div>
                                            <div>
                                                <dt>Rejected length</dt>
                                                <dd>@(lastRejectedFrameLength == 0 ? "--" : lastRejectedFrameLength)</dd>
                                            </div>
                                            <div>
                                                <dt>Rejected reason</dt>
                                                <dd>@lastRejectedFrameReason</dd>
                                            </div>
                                            <div>
                                                <dt>Rejected frame</dt>
                                                <dd>@lastRejectedFrameHex</dd>
                                            </div>
                                        </dl>

                                        <p class="visualizer-note">@statusMessage</p>
                                    </div>
                                </TabsItem>

                                <TabsItem Text="Capture">
                                    <div class="visualizer-tab-panel">
                                        <details class="visualizer-hint">
                                            <summary>When to use capture</summary>
                                            <p>Grab a short packet burst when parser behavior looks wrong, then copy the log for analysis.</p>
                                        </details>

                                        <div class="visualizer-inline-actions">
                                            <button class="visualizer-button visualizer-button--compact"
                                                    @onclick="StartBleDebugCaptureAsync">
                                                Capture 96 Packets
                                            </button>
                                            <button class="visualizer-button visualizer-button--compact"
                                                    @onclick="StopBleDebugCaptureAsync"
                                                    disabled="@(!bleDebugCaptureEnabled)">
                                                Stop Capture
                                            </button>
                                            <button class="visualizer-button visualizer-button--compact"
                                                    @onclick="CopyBleDebugLogAsync"
                                                    disabled="@(bleDebugLog.Count == 0)">
                                                Copy Debug
                                            </button>
                                            <button class="visualizer-button visualizer-button--compact"
                                                    @onclick="ClearBleDebugLogAsync"
                                                    disabled="@(bleDebugLog.Count == 0)">
                                                Clear
                                            </button>
                                        </div>

                                        <dl class="visualizer-metrics">
                                            <div>
                                                <dt>Capture state</dt>
                                                <dd>@(bleDebugCaptureEnabled ? "armed" : "stopped")</dd>
                                            </div>
                                            <div>
                                                <dt>Packets captured</dt>
                                                <dd>@bleDebugPacketCaptureCount</dd>
                                            </div>
                                            <div>
                                                <dt>Log lines</dt>
                                                <dd>@bleDebugLog.Count</dd>
                                            </div>
                                        </dl>

                                        <p class="visualizer-note visualizer-note--dense">
                                            File: @BleDebugCapturePathLabel | @bleDebugFileStatus
                                        </p>
                                        <pre class="visualizer-debug-log">@BleDebugLogText</pre>
                                    </div>
                                </TabsItem>

                                <TabsItem Text="Align">
                                    <div class="visualizer-tab-panel">
                                        <details class="visualizer-hint">
                                            <summary>Alignment hint</summary>
                                            <p>Firmware default assumes scene X=-device X, scene Y=device Y, and scene Z=device Z.</p>
                                        </details>

                                        <div class="visualizer-inline-actions">
                                            <button class="visualizer-button visualizer-button--compact"
                                                    @onclick="ApplyDefaultAxesAsync">
                                                Firmware Default
                                            </button>
                                            <button class="visualizer-button visualizer-button--compact"
                                                    @onclick="ResetRotationAsync">
                                                Reset Rotation
                                            </button>
                                            <button class="visualizer-button visualizer-button--compact"
                                                    @onclick="CaptureSceneCalibrationAsync"
                                                    disabled="@(latestTelemetry is null || !latestTelemetry.PoseValid)">
                                                Capture Neutral
                                            </button>
                                            <button class="visualizer-button visualizer-button--compact"
                                                    @onclick="ClearSceneCalibrationAsync"
                                                    disabled="@(!sceneTransform.HasReference)">
                                                Clear Neutral
                                            </button>
                                        </div>

                                        <div class="visualizer-axis-grid">
                                            <div class="visualizer-axis-row">
                                                <span class="visualizer-axis-row__label">Scene X</span>
                                                <select class="visualizer-select"
                                                        value="@sceneTransform.SceneX.Source"
                                                        @onchange="ChangeSceneXAxisSourceAsync">
                                                    @foreach (var source in AxisSources)
                                                    {
                                                        <option value="@source">@source</option>
                                                    }
                                                </select>
                                                <label class="visualizer-check">
                                                    <input type="checkbox"
                                                           checked="@sceneTransform.SceneX.Inverted"
                                                           @onchange="ChangeSceneXAxisInversionAsync" />
                                                    invert
                                                </label>
                                            </div>
                                            <div class="visualizer-axis-row">
                                                <span class="visualizer-axis-row__label">Scene Y</span>
                                                <select class="visualizer-select"
                                                        value="@sceneTransform.SceneY.Source"
                                                        @onchange="ChangeSceneYAxisSourceAsync">
                                                    @foreach (var source in AxisSources)
                                                    {
                                                        <option value="@source">@source</option>
                                                    }
                                                </select>
                                                <label class="visualizer-check">
                                                    <input type="checkbox"
                                                           checked="@sceneTransform.SceneY.Inverted"
                                                           @onchange="ChangeSceneYAxisInversionAsync" />
                                                    invert
                                                </label>
                                            </div>
                                            <div class="visualizer-axis-row">
                                                <span class="visualizer-axis-row__label">Scene Z</span>
                                                <select class="visualizer-select"
                                                        value="@sceneTransform.SceneZ.Source"
                                                        @onchange="ChangeSceneZAxisSourceAsync">
                                                    @foreach (var source in AxisSources)
                                                    {
                                                        <option value="@source">@source</option>
                                                    }
                                                </select>
                                                <label class="visualizer-check">
                                                    <input type="checkbox"
                                                           checked="@sceneTransform.SceneZ.Inverted"
                                                           @onchange="ChangeSceneZAxisInversionAsync" />
                                                    invert
                                                </label>
                                            </div>
                                        </div>

                                        <div class="visualizer-rotation-grid">
                                            <div class="visualizer-rotation-row">
                                                <span class="visualizer-axis-row__label">Rotate X</span>
                                                <div class="visualizer-rotation-stepper">
                                                    <button class="visualizer-button visualizer-button--mini" @onclick='() => NudgeRotationAsync("X", -15d)'>-15</button>
                                                    <button class="visualizer-button visualizer-button--mini" @onclick='() => NudgeRotationAsync("X", 15d)'>+15</button>
                                                </div>
                                                <input class="visualizer-number"
                                                       type="number"
                                                       step="5"
                                                       value="@FormatAngleInput(sceneTransform.RotationXDeg)"
                                                       @onchange="ChangeRotationXAsync" />
                                            </div>
                                            <div class="visualizer-rotation-row">
                                                <span class="visualizer-axis-row__label">Rotate Y</span>
                                                <div class="visualizer-rotation-stepper">
                                                    <button class="visualizer-button visualizer-button--mini" @onclick='() => NudgeRotationAsync("Y", -15d)'>-15</button>
                                                    <button class="visualizer-button visualizer-button--mini" @onclick='() => NudgeRotationAsync("Y", 15d)'>+15</button>
                                                </div>
                                                <input class="visualizer-number"
                                                       type="number"
                                                       step="5"
                                                       value="@FormatAngleInput(sceneTransform.RotationYDeg)"
                                                       @onchange="ChangeRotationYAsync" />
                                            </div>
                                            <div class="visualizer-rotation-row">
                                                <span class="visualizer-axis-row__label">Rotate Z</span>
                                                <div class="visualizer-rotation-stepper">
                                                    <button class="visualizer-button visualizer-button--mini" @onclick='() => NudgeRotationAsync("Z", -15d)'>-15</button>
                                                    <button class="visualizer-button visualizer-button--mini" @onclick='() => NudgeRotationAsync("Z", 15d)'>+15</button>
                                                </div>
                                                <input class="visualizer-number"
                                                       type="number"
                                                       step="5"
                                                       value="@FormatAngleInput(sceneTransform.RotationZDeg)"
                                                       @onchange="ChangeRotationZAsync" />
                                            </div>
                                        </div>

                                        <p class="visualizer-note visualizer-note--dense">@sceneTransform.MappingSummary</p>
                                    </div>
                                </TabsItem>

                                <TabsItem Text="Pose">
                                    <div class="visualizer-tab-panel">
                                        <details class="visualizer-hint">
                                            <summary>Pose hint</summary>
                                            <p>This is the mapped scene frame after axis remap, rotation offsets, and optional neutral capture.</p>
                                        </details>

                                        <dl class="visualizer-metrics visualizer-metrics--vector">
                                            <div>
                                                <dt>Quaternion</dt>
                                                <dd>@FormatQuaternion(latestTelemetry?.RelativeOrientation)</dd>
                                            </div>
                                            <div>
                                                <dt>Forward</dt>
                                                <dd>@FormatVector(sceneTelemetry?.ForwardAxis)</dd>
                                            </div>
                                            <div>
                                                <dt>Right</dt>
                                                <dd>@FormatVector(sceneTelemetry?.RightAxis)</dd>
                                            </div>
                                            <div>
                                                <dt>Up</dt>
                                                <dd>@FormatVector(sceneTelemetry?.UpAxis)</dd>
                                            </div>
                                            <div>
                                                <dt>Pointer angles</dt>
                                                <dd>@PointerAnglesLabel</dd>
                                            </div>
                                            <div>
                                                <dt>Position</dt>
                                                <dd>@FormatVector(sceneTelemetry?.PointerPosition)</dd>
                                            </div>
                                        </dl>
                                    </div>
                                </TabsItem>

                                <TabsItem Text="Angles">
                                    <div class="visualizer-tab-panel">
                                        <details class="visualizer-hint">
                                            <summary>Angle hint</summary>
                                            <p>Yaw and pitch drive the cursor surface position. Roll stays diagnostic so you can verify local device rotation.</p>
                                        </details>

                                        <dl class="visualizer-metrics visualizer-metrics--vector">
                                            <div>
                                                <dt>Gyro dps</dt>
                                                <dd>@FormatVector(sceneTelemetry?.Gyro)</dd>
                                            </div>
                                            <div>
                                                <dt>Linear accel g</dt>
                                                <dd>@FormatVector(sceneTelemetry?.LinearAccel)</dd>
                                            </div>
                                            <div>
                                                <dt>Yaw</dt>
                                                <dd>@(sceneTelemetry is null ? "--" : $"{sceneTelemetry.ForwardAzimuthDeg:+0.0;-0.0;+0.0} deg")</dd>
                                            </div>
                                            <div>
                                                <dt>Pitch</dt>
                                                <dd>@(sceneTelemetry is null ? "--" : $"{sceneTelemetry.ForwardElevationDeg:+0.0;-0.0;+0.0} deg")</dd>
                                            </div>
                                            <div>
                                                <dt>Roll</dt>
                                                <dd>@(sceneTelemetry is null ? "--" : $"{sceneTelemetry.RollDeg:+0.0;-0.0;+0.0} deg")</dd>
                                            </div>
                                            <div>
                                                <dt>Gyro magnitude</dt>
                                                <dd>@(sceneTelemetry is null ? "--" : $"{sceneTelemetry.GyroMagnitudeDps:0.0} dps")</dd>
                                            </div>
                                            <div>
                                                <dt>Cursor magnitude</dt>
                                                <dd>@(sceneTelemetry is null ? "--" : $"{sceneTelemetry.PointerPosition.Length:0.000}")</dd>
                                            </div>
                                        </dl>
                                    </div>
                                </TabsItem>

                                <TabsItem Text="Control">
                                    <div class="visualizer-tab-panel">
                                        <div class="visualizer-inline-actions">
                                            <select class="visualizer-select"
                                                    value="@controlSettings.ProfileName"
                                                    @onchange="HandleControlProfileChangedAsync">
                                                @foreach (var profileName in ControlProfiles)
                                                {
                                                    <option value="@profileName">@profileName</option>
                                                }
                                            </select>
                                            <button class="visualizer-button visualizer-button--compact"
                                                    @onclick="ResetControlProfileAsync">
                                                Reset Profile
                                            </button>
                                            <button class="visualizer-button visualizer-button--compact"
                                                    @onclick="ExportControlSettingsAsync">
                                                Export JSON
                                            </button>
                                        </div>

                                        <div class="visualizer-axis-grid">
                                            <label class="visualizer-axis-row">
                                                <span class="visualizer-axis-row__label">Accel tau</span>
                                                <input class="visualizer-input" type="number" step="5" value="@FormatNumber(controlSettings.AccelSmoothingTauMs)" @onchange="HandleAccelTauChangedAsync" />
                                            </label>
                                            <label class="visualizer-axis-row">
                                                <span class="visualizer-axis-row__label">Gyro tau</span>
                                                <input class="visualizer-input" type="number" step="5" value="@FormatNumber(controlSettings.GyroSmoothingTauMs)" @onchange="HandleGyroTauChangedAsync" />
                                            </label>
                                            <label class="visualizer-axis-row">
                                                <span class="visualizer-axis-row__label">Accel dz</span>
                                                <input class="visualizer-input" type="number" step="0.005" value="@FormatNumber(controlSettings.AccelDeadzoneG)" @onchange="HandleAccelDeadzoneChangedAsync" />
                                            </label>
                                            <label class="visualizer-axis-row">
                                                <span class="visualizer-axis-row__label">Gyro dz</span>
                                                <input class="visualizer-input" type="number" step="0.1" value="@FormatNumber(controlSettings.GyroDeadzoneDps)" @onchange="HandleGyroDeadzoneChangedAsync" />
                                            </label>
                                            <label class="visualizer-axis-row">
                                                <span class="visualizer-axis-row__label">Joy dz</span>
                                                <input class="visualizer-input" type="number" step="0.1" value="@FormatNumber(controlSettings.JoystickDeadzoneDeg)" @onchange="HandleJoystickDeadzoneChangedAsync" />
                                            </label>
                                            <label class="visualizer-axis-row">
                                                <span class="visualizer-axis-row__label">Joy max</span>
                                                <input class="visualizer-input" type="number" step="1" value="@FormatNumber(controlSettings.JoystickFullScaleDeg)" @onchange="HandleJoystickFullScaleChangedAsync" />
                                            </label>
                                            <label class="visualizer-axis-row">
                                                <span class="visualizer-axis-row__label">Pan</span>
                                                <input class="visualizer-input" type="number" step="25" value="@FormatNumber(controlSettings.PanPixelsPerSecondAtFullInput)" @onchange="HandlePanSensitivityChangedAsync" />
                                            </label>
                                            <label class="visualizer-axis-row">
                                                <span class="visualizer-axis-row__label">Zoom</span>
                                                <input class="visualizer-input" type="number" step="0.1" value="@FormatNumber(controlSettings.ZoomLogRatePerSecondAtFullInput)" @onchange="HandleZoomSensitivityChangedAsync" />
                                            </label>
                                            <label class="visualizer-axis-row">
                                                <span class="visualizer-axis-row__label">Orbit</span>
                                                <input class="visualizer-input" type="number" step="5" value="@FormatNumber(controlSettings.OrbitDegreesPerSecondAtFullInput)" @onchange="HandleOrbitSensitivityChangedAsync" />
                                            </label>
                                            <label class="visualizer-axis-row">
                                                <span class="visualizer-axis-row__label">Precision</span>
                                                <input class="visualizer-input" type="number" step="0.05" value="@FormatNumber(controlSettings.PrecisionMultiplier)" @onchange="HandlePrecisionMultiplierChangedAsync" />
                                            </label>
                                        </div>

                                        <details class="visualizer-hint">
                                            <summary>Diagnostics</summary>
                                            <dl class="visualizer-metrics visualizer-metrics--vector">
                                                <div>
                                                    <dt>Raw accel</dt>
                                                    <dd>@FormatVector(sceneTelemetry?.LinearAccel)</dd>
                                                </div>
                                                <div>
                                                    <dt>Filtered accel</dt>
                                                    <dd>@FormatVector(filteredState?.FilteredAccel)</dd>
                                                </div>
                                                <div>
                                                    <dt>Accel bias</dt>
                                                    <dd>@FormatVector(filteredState?.AccelBias)</dd>
                                                </div>
                                                <div>
                                                    <dt>Raw gyro</dt>
                                                    <dd>@FormatVector(sceneTelemetry?.Gyro)</dd>
                                                </div>
                                                <div>
                                                    <dt>Filtered gyro</dt>
                                                    <dd>@FormatVector(filteredState?.FilteredGyro)</dd>
                                                </div>
                                                <div>
                                                    <dt>Still</dt>
                                                    <dd>@(filteredState?.Still == true ? "yes" : "no")</dd>
                                                </div>
                                                <div>
                                                    <dt>Button action</dt>
                                                    <dd>@LogicalButtonActionLabel</dd>
                                                </div>
                                                <div>
                                                    <dt>Frame interval</dt>
                                                    <dd>@FrameIntervalLabel</dd>
                                                </div>
                                                <div>
                                                    <dt>Source mag</dt>
                                                    <dd>@SourceMagnetometerLabel</dd>
                                                </div>
                                            </dl>
                                        </details>

                                        <details class="visualizer-hint">
                                            <summary>Firmware serial commands</summary>
                                            <pre class="visualizer-debug-log">@FirmwareSerialCommandHint</pre>
                                        </details>

                                        <textarea class="visualizer-debug-log"
                                                  rows="5"
                                                  value="@controlSettingsJson"
                                                  @onchange="HandleControlSettingsJsonChangedAsync"></textarea>
                                        <button class="visualizer-button visualizer-button--compact"
                                                @onclick="ImportControlSettingsAsync">
                                            Import JSON
                                        </button>
                                    </div>
                                </TabsItem>

                                <TabsItem Text="Sensor">
                                    <div class="visualizer-tab-panel">
                                        <details class="visualizer-hint">
                                            <summary>Sensor hint</summary>
                                            <p>Use this pane for counters, button states, ADC readings, and sensor validity flags.</p>
                                        </details>

                                        <dl class="visualizer-metrics">
                                            <div>
                                                <dt>Frames</dt>
                                                <dd>@receivedFrameCount</dd>
                                            </div>
                                            <div>
                                                <dt>BLE raw</dt>
                                                <dd>@bleDiagnostics.FrameCount</dd>
                                            </div>
                                            <div>
                                                <dt>Packets</dt>
                                                <dd>@rawPacketCount</dd>
                                            </div>
                                            <div>
                                                <dt>Parse fail</dt>
                                                <dd>@parseFailureCount</dd>
                                            </div>
                                            <div>
                                                <dt>Capture</dt>
                                                <dd>@(bleDebugCaptureEnabled ? "On" : "Off")</dd>
                                            </div>
                                            <div>
                                                <dt>Pressed buttons</dt>
                                                <dd>@ButtonsLabel</dd>
                                            </div>
                                            <div>
                                                <dt>Logical button</dt>
                                                <dd>@LogicalButtonLabel</dd>
                                            </div>
                                            <div>
                                                <dt>Button action</dt>
                                                <dd>@LogicalButtonActionLabel</dd>
                                            </div>
                                            <div>
                                                <dt>ADC state</dt>
                                                <dd>@AdcStateLabel</dd>
                                            </div>
                                            <div>
                                                <dt>ADC voltage</dt>
                                                <dd>@AdcVoltageLabel</dd>
                                            </div>
                                            <div>
                                                <dt>ADC raw</dt>
                                                <dd>@AdcRawLabel</dd>
                                            </div>
                                            <div>
                                                <dt>ADC event</dt>
                                                <dd>@AdcEventLabel</dd>
                                            </div>
                                            <div>
                                                <dt>Pose flags</dt>
                                                <dd>@PoseFlagsLabel</dd>
                                            </div>
                                            <div>
                                                <dt>Accuracy</dt>
                                                <dd>@AccuracyLabel</dd>
                                            </div>
                                        </dl>
                                    </div>
                                </TabsItem>
                            </TabItems>
                        </Tabs>
                    </section>
                </aside>
            </div>
        </ChildContent>
    </PageScaffold>
</div>

@code {
    private static readonly SceneAxisSource[] AxisSources = Enum.GetValues<SceneAxisSource>();
    private static readonly TimeSpan MinUiRefreshInterval = TimeSpan.FromMilliseconds(20d);
    private const int BleDebugCapturePacketLimit = 96;
    private const string BleBridgeModulePath = "/_content/CanDoItAll.Space3D.Mouse.Components/js/space3dMouseBle.js?v=20260423";

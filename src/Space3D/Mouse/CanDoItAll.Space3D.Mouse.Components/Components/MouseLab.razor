    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        objectReference = DotNetObjectReference.Create(this);
        bleBridgeModule = await JS.InvokeAsync<IJSObjectReference>("import", BleBridgeModulePath);
        bleDiagnostics = await bleBridgeModule.InvokeAsync<BleBridgeDiagnostics>("initialize", objectReference);
        await LoadControlSettingsFromStorageAsync();
        statusMessage = bleDiagnostics.Supported
            ? "Bridge ready. Use Connect BLE to request or reuse the 3D mouse."
            : "Web Bluetooth is not available in this browser.";
        await RequestUiRefreshAsync(force: true);
    }


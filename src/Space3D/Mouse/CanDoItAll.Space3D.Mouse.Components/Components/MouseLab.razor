    private Task ChangeRotationAsync(string axisKey, ChangeEventArgs args)
    {
        var valueText = args.Value?.ToString();
        if (TryParseAngle(valueText, out var degrees))
        {
            sceneTransform.SetRotation(axisKey, degrees);
            statusMessage = $"Scene {axisKey} rotation set to {FormatAngle(sceneTransform.GetRotation(axisKey))}.";
            RebuildSurface();
        }
        else
        {
            statusMessage = $"Scene {axisKey} rotation expects a numeric degree value.";
        }

        return RequestUiRefreshAsync(force: true);
    }

    private async Task RequestUiRefreshAsync(bool force = false)
    {
        var now = DateTimeOffset.UtcNow;
        if (!force && (now - lastUiRefreshAt) < MinUiRefreshInterval)
        {
            return;
        }

        lastUiRefreshAt = now;
        await InvokeAsync(StateHasChanged);
        if (force && ConnectionStateChanged.HasDelegate)
        {
            await ConnectionStateChanged.InvokeAsync();
        }
    }


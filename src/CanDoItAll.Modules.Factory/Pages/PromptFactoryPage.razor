        => PersistCanvasUiStateAsync();

    private async Task HandleCanvasStateChangedAsync(string stateJson)
    {
        var uiState = CanvasWorkbenchUiState.Parse(stateJson);
        selectedCanvasNodeIds = uiState.SelectedNodeIds.Count > 0 ? uiState.SelectedNodeIds.ToList() : ["session-root"];
        activeInspectorTab = string.IsNullOrWhiteSpace(uiState.ActiveInspectorTab) ? activeInspectorTab : uiState.ActiveInspectorTab;
        editor.CanvasUiStateJson = uiState.ToJson();
        editor.SelectedNodeId = TryParsePromptCanvasNodeId(selectedCanvasNodeId, out var nodeId) ? nodeId : null;
        SyncSelectedPromptNodeDraft();
        await PersistCanvasUiStateAsync();
    }

    private async Task PersistCanvasUiStateAsync()
    {
        var uiState = CanvasWorkbenchUiState.Parse(editor.CanvasUiStateJson);
        uiState.SelectedNodeIds = [.. selectedCanvasNodeIds];
        uiState.ActiveInspectorTab = activeInspectorTab;
        editor.CanvasUiStateJson = uiState.ToJson();
        if (editor.SessionId.HasValue)
        {
            await PromptFactoryService.SaveCanvasUiStateAsync(editor.SessionId.Value, editor.CanvasUiStateJson, editor.SelectedNodeId);
        }

        RefreshCanvasSurface();
    }

    private async Task HandleCanvasContextActionAsync(CanvasWorkbenchContextActionRequest request)
        => await HandleCanvasActionAsync(request.ActionId, request.NodeId);

    private async Task HandleCanvasCreateActionAsync(CanvasWorkbenchCreateActionRequest request)
    {
        if (await HandleCatalogCreateActionAsync(request))
        {
            return;
        }

        await HandleCanvasActionAsync(request.ActionId, request.SourceNodeId);
    }

    private async Task HandleCanvasNodeOpenedAsync(string nodeId)
    {
        if (TryParsePromptCanvasNodeId(nodeId, out var promptNodeId) &&
            editor.Nodes.FirstOrDefault(node => node.Id == promptNodeId)?.PromptArtifactId is Guid promptArtifactId)
        {
            OpenPromptArtifact(promptArtifactId);
            return;
        }

        await SelectCanvasNodeAsync(nodeId);
    }

    private async Task HandleCanvasActionAsync(string actionId, string? sourceNodeId)
    {
        if (await HandleCatalogContextActionAsync(actionId))
        {
            return;
        }

        switch (actionId)
        {
            case "build-flow":
                await BuildAsync();
                break;
            case "apply-recommendations":
                await ApplyRecommendationsAsync();
                break;
            case "save-session":
                await SaveSessionStateAsync();
                break;
            case "branch":
            case "branch-selected":
                if (TryParsePromptCanvasNodeId(sourceNodeId ?? selectedCanvasNodeId, out var branchNodeId))
                {
                    await BranchAsync(branchNodeId);
                }
                break;
            case "mark-used":
                if (TryParsePromptCanvasNodeId(sourceNodeId ?? selectedCanvasNodeId, out var usedNodeId))
                {
                    await SetPromptNodeStateAsync(usedNodeId, PromptRunNodeState.Used);
                }
                break;
            case "validate-node":
                if (TryParsePromptCanvasNodeId(sourceNodeId ?? selectedCanvasNodeId, out var validatedNodeId))
                {
                    await SetPromptNodeStateAsync(validatedNodeId, PromptRunNodeState.Validated);
                }
                break;
            case "skip-node":
                if (TryParsePromptCanvasNodeId(sourceNodeId ?? selectedCanvasNodeId, out var skippedNodeId))
                {
                    await SetPromptNodeStateAsync(skippedNodeId, PromptRunNodeState.Skipped);
                }
                break;
            case "open-prompt":
                if (TryParsePromptCanvasNodeId(sourceNodeId ?? selectedCanvasNodeId, out var openNodeId) &&
                    editor.Nodes.FirstOrDefault(node => node.Id == openNodeId)?.PromptArtifactId is Guid promptArtifactId)
                {
                    OpenPromptArtifact(promptArtifactId);
                }
                break;
        }
    }

    private async Task SetInspectorTabAsync(string tab)
    {
        activeInspectorTab = tab;
        editor.WizardStepIndex = tab switch
        {
            "governance" => 1,
            "assembly" => 2,
            "review" => 3,
            _ => 0
        };
        await PersistCanvasUiStateAsync();
    }


                    }
                    <div class="cw-form-field">
                        <label>Prompt preview</label>
                        <textarea class="cw-textarea" @bind="editor.GeneratedPrompt"></textarea>
                    </div>
                    <div class="cw-button-row">
                        <button type="button" class="cw-button" data-tone="ghost" @onclick="CopyAsync">Copy</button>
                        <button type="button" class="cw-button" data-tone="ghost" @onclick="ExportAsync">Export</button>
                        <button type="button" class="cw-button" data-tone="primary" @onclick="SaveDraftAsync">Save draft</button>
                        <button type="button" class="cw-button" data-tone="mint" @onclick="SaveFinalAsync">Save final</button>
                        <button type="button" class="cw-button" data-tone="warn" @onclick="SendAsync">Send</button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(message))
                    {
                        <p class="@(isError ? "text-sm text-rose-700" : "text-sm text-emerald-700")">@message</p>

    {
        selectedCanvasNodeIds = args.SelectedNodeIds.Count > 0 ? args.SelectedNodeIds.ToList() : ["session-root"];
        editor.SelectedNodeId = TryParsePromptCanvasNodeId(args.PrimaryNodeId, out var nodeId) ? nodeId : null;
        SyncSelectedPromptNodeDraft();

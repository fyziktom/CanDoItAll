    }

    private async Task SaveSelectedPromptNodeAsync()
    {
        if (selectedPromptNode is null)
        {
            return;
        }

        RememberHistoryCheckpoint();
        var saveResult = await PromptFactoryService.UpdateNodeAsync(selectedPromptNode.Id, selectedPromptNodeTitle, selectedPromptNodeNotes);
        if (saveResult.IsFailure)
        {
            SetError(saveResult.Errors);
            return;
        }

        await SetPromptNodeStateAsync(selectedPromptNode.Id, selectedPromptNodeState, suppressMessage: true, captureHistory: false);
        editor = await PromptFactoryService.GetEditorAsync(editor.SessionId, editor.PromptRunId);
        HydrateCanvasSelection($"node:{selectedPromptNode.Id:N}");
        RefreshCanvasSurface();
        SyncSelectedPromptNodeDraft();
        SetMessage("Prompt step saved.");
    }

    private async Task SetPromptNodeStateAsync(Guid nodeId, PromptRunNodeState state, bool suppressMessage = false, bool captureHistory = true)
    {
        if (captureHistory)
        {
            RememberHistoryCheckpoint();
        }

        var result = await PromptFactoryService.SetNodeStateAsync(nodeId, state);
        if (result.IsFailure)
        {
            SetError(result.Errors);
            return;
        }

        editor = await PromptFactoryService.GetEditorAsync(editor.SessionId, editor.PromptRunId);
        HydrateCanvasSelection($"node:{nodeId:N}");
        RefreshCanvasSurface();
        SyncSelectedPromptNodeDraft();
        if (!suppressMessage)
        {
            SetMessage($"Prompt step marked {state}.");
        }
    }


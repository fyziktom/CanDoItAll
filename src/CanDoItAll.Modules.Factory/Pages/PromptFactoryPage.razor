@page "/prompt-factory"
@* codex-capsule
kind: page
name: PromptFactoryPage
summary: Builds prompt sessions from projects, flow templates, shared blocks, and provider settings through a canvas-first workbench.
owns: prompt-session-canvas, prompt-node-inspector, prompt-preview
deps: PromptFactoryService, ProjectsService, ResourcesService, WorkspaceService
risks: missing-project-context, stale-run-routing, unsaved-node-edits
tests: component:PromptFactoryPageTests, e2e:prompt-factory-smoke
*@
@using CanDoItAll.Components.CanvasLib
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Modules.Factory.CanvasAdapters
@using CanDoItAll.Modules.Projects
@using CanDoItAll.Modules.Resources
@using CanDoItAll.Modules.Workspace
@using CanDoItAll.SharedKernel
@inject PromptFactoryService PromptFactoryService
@inject ProjectsService ProjectsService
@inject ResourcesService ResourcesService
@inject WorkspaceService WorkspaceService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Prompt Factory</PageTitle>

<div class="space-y-6">
    <PageHeader Eyebrow="Prompt Factory"
                Title="Prompt session workbench"
                Compact="true" />

    @if (canvasSurface is not null)
    {
        <section class="cw-panel-card pf-page-tabs">
            <div class="pf-page-tabs__header">
                <div class="pf-page-tabs__copy">
                    <p class="cw-panel-kicker">Prompt Factory tabs</p>
                    <h3 class="cw-panel-title">@ResolveSupportLaneTitle()</h3>
                </div>
                <p class="cw-panel-copy">@ResolveSupportLaneDescription()</p>
            </div>
            <div class="pf-page-tablist" role="tablist" aria-label="Prompt Factory workspaces">
                @foreach (var item in SupportLaneTabs)
                {
                    var isSelected = string.Equals(item.Key, supportLaneTab, StringComparison.Ordinal);
                    <button type="button"
                            id="@($"{item.Key}-tab")"
                            role="tab"
                            aria-selected="@(isSelected ? "true" : "false")"
                            aria-controls="@($"{item.Key}-panel")"
                            class="pf-page-tab @(isSelected ? "is-active" : string.Empty)"
                            @onclick="@(() => SetSupportLaneTabAsync(item.Key))">
                        <span>@item.Label</span>
                        @if (!string.IsNullOrWhiteSpace(item.Count))
                        {
                            <span class="pf-page-tab__count">@item.Count</span>
                        }
                    </button>
                }
            </div>
        </section>

        @if (IsSupportLaneTab(SupportLaneTabCanvas))
        {
            <div class="pf-workbench-shell is-canvas-mode"
                 id="@($"{SupportLaneTabCanvas}-panel")"
                 role="tabpanel"
                 aria-labelledby="@($"{SupportLaneTabCanvas}-tab")">
            <CanvasWorkbenchStage Eyebrow="Prompt flow canvas"
                                  Title="@ResolveStageTitle()"
                                  Stats="stageStats">
            <HeaderActions>
                <HelpPopover RootClass="pf-help-popover pf-help-popover--header"
                             AriaLabel="Show canvas stage help"
                             Title="Show canvas stage help"
                             Heading="Canvas stage"
                             Body="@ResolveCanvasHeaderHelpBody()"
                             Tip="@ResolveCanvasHeaderHelpTip()" />
            </HeaderActions>
            <Canvas>
                <CanvasWorkbench Surface="canvasSurface"
                                 @ref="workbenchRef"
                                 SelectionChanged="HandleCanvasSelectionChangedAsync"
                                 NodesMoved="HandleCanvasNodesMovedAsync"
                                 ContextActionRequested="HandleCanvasContextActionAsync"
                                 CreateActionInvoked="HandleCanvasCreateActionAsync"
                                 NodeOpened="HandleCanvasNodeOpenedAsync"
                                 StateChanged="HandleCanvasStateChangedAsync">
                    <ToolbarLeftContent>
                        <div class="pf-history-toolbar" role="group" aria-label="History controls">
                            <button type="button"
                                    class="cw-toolbar-action cw-toolbar-action--icon"
                                    data-testid="prompt-factory-undo"
                                    title="Undo (Ctrl/Cmd + Z)"
                                    aria-label="Undo"
                                    disabled="@(!CanUndo)"
                                    @onclick="UndoAsync">
                                <span class="cw-toolbar-symbol" aria-hidden="true">â†¶</span>
                                <span class="sr-only">Undo</span>
                            </button>
                            <button type="button"
                                    class="cw-toolbar-action cw-toolbar-action--icon"
                                    data-testid="prompt-factory-redo"
                                    title="Redo (Ctrl/Cmd + Shift + Z or Ctrl/Cmd + Y)"
                                    aria-label="Redo"
                                    disabled="@(!CanRedo)"
                                    @onclick="RedoAsync">
                                <span class="cw-toolbar-symbol" aria-hidden="true">â†·</span>
                                <span class="sr-only">Redo</span>
                            </button>
                            <button type="button"
                                    class="cw-toolbar-action pf-toolbar-toggle @(ComponentsToolboxWindowState.IsVisible ? "is-active" : string.Empty)"
                                    data-testid="prompt-factory-components-toolbox-toggle"
                                    title="Show or hide the components toolbox"
                                    @onclick='@(() => ToggleCanvasWindowAsync(ComponentsToolboxWindowKey))'>
                                Components
                            </button>
                        </div>
                    </ToolbarLeftContent>
                    <OverlayContent>
                        @if (canvasRecommendationOverlay.IsVisible)
                        {
                            <section class="pf-recommendation-overlay"
                                     aria-label="Recommendation overlay"
                                     data-testid="prompt-factory-recommendation-overlay">
                                <div class="pf-recommendation-overlay__header">
                                    <p class="cw-panel-kicker">@canvasRecommendationOverlay.Title</p>
                                    <h3 class="cw-panel-title">Next canvas moves</h3>
                                    <p class="cw-panel-copy">@canvasRecommendationOverlay.Description</p>
                                </div>
                                <div class="pf-recommendation-overlay__list">
                                    @foreach (var item in canvasRecommendationOverlay.Items)
                                    {
                                        <article class="pf-recommendation-overlay__item"
                                                 data-recommendation-tone="@item.Tone">
                                            <strong>@item.Label</strong>
                                            <span>@item.Detail</span>
                                        </article>
                                    }
                                </div>
                                <div class="pf-recommendation-overlay__actions">
                                    @if (canvasRecommendationOverlay.CanApplyRecommendations)
                                    {
                                        <button type="button"
                                                class="cw-button"
                                                data-tone="accent"
                                                @onclick="ApplyCanvasRecommendationsAsync">
                                            Apply recommendations
                                        </button>
                                    }
                                    @if (canvasRecommendationOverlay.CanBuildFlow)
                                    {
                                        <button type="button"
                                                class="cw-button"
                                                data-tone="ghost"
                                                @onclick="BuildCanvasFlowAsync">
                                            Build flow
                                        </button>
                                    }
                                </div>
                            </section>
                        }

                        @if (ComponentsToolboxWindowState.IsVisible)
                        {
                            <CanvasFloatingWindow WindowId="@ComponentsToolboxWindowKey"
                                                  TestId="prompt-factory-components-toolbox-window"
                                                  AriaLabel="Prompt Factory components toolbox"
                                                  Kicker="Components toolbox"
                                                  Title="Prompt components"
                                                  Summary="Search the shared library, preview component text, and add one block at a time without the old cascading submenu."
                                                  DefaultPlacement="top-left"
                                                  DefaultWidth="452"
                                                  DefaultHeight="620"
                                                  MinWidth="340"
                                                  MinHeight="260"
                                                  MaxWidth="560"
                                                  State="@ComponentsToolboxWindowState"
                                                  StateChanged="HandleComponentsToolboxWindowStateChangedAsync">
                                <section class="cw-context-toolbox pf-components-toolbox"
                                         data-testid="prompt-factory-components-toolbox">
                                    <div class="cw-context-toolbox__header">
                                        <div class="cw-context-toolbox__header-copy">
                                            <p class="cw-context-toolbox__eyebrow">Visual Studio style</p>
                                            <h3 class="cw-context-toolbox__title">Shared library explorer</h3>
                                            <p class="cw-context-toolbox__copy">Search stays pinned. Sections and groups stay dense. The preview lane follows the Eye trigger instead of opening the old cascading submenu.</p>
                                        </div>
                                        <span class="cw-context-toolbox__count">@($"{ComponentToolboxSections.Sum(section => section.Groups.Sum(group => group.Blocks.Count))} items")</span>
                                    </div>

                                    <input class="cw-context-toolbox__search pf-toolbar__search"
                                           type="search"
                                           placeholder="Search components, groups, tags, or stack profiles"
                                           @bind="componentToolboxSearchText"
                                           @bind:event="oninput" />

                                    <div class="cw-context-toolbox__body pf-components-toolbox__body">
                                        <div class="cw-context-toolbox__sections">
                                            @if (ComponentToolboxSections.Count == 0)
                                            {
                                                <div class="cw-context-toolbox__empty">
                                                    <strong>No components match the current search.</strong>
                                                    <span>Clear the search to restore the full library.</span>
                                                </div>
                                            }
                                            else
                                            {
                                                @foreach (var sectionItem in ComponentToolboxSections)
                                                {
                                                    <details class="cw-context-toolbox__section" open>
                                                        <summary class="cw-context-toolbox__section-summary">
                                                            <span class="cw-context-toolbox__section-copy">
                                                                <strong>@sectionItem.Label</strong>
                                                                <small>@sectionItem.Description</small>
                                                            </span>
                                                            <span class="cw-context-toolbox__section-badge tone-accent">@($"{sectionItem.Groups.Sum(group => group.Blocks.Count)}")</span>
                                                        </summary>
                                                        <div class="cw-context-toolbox__section-body">
                                                            @foreach (var group in sectionItem.Groups)
                                                            {
                                                                <details class="cw-context-toolbox__group" open>
                                                                    <summary class="cw-context-toolbox__group-summary">
                                                                        <strong>@group.Label</strong>
                                                                        <small>@group.Summary</small>
                                                                    </summary>
                                                                    <div class="cw-context-toolbox__item-list">
                                                                        @foreach (var block in group.Blocks)
                                                                        {
                                                                            <div class="pf-components-toolbox__item-row">
                                                                                <button type="button"
                                                                                        class="cw-context-toolbox__item"
                                                                                        data-testid="@($"prompt-factory-component-{block.Key}")"
                                                                                        @onclick="@(() => AddComponentFromToolboxAsync(block))">
                                                                                    <span class="cw-context-toolbox__item-icon">
                                                                                        <span class="cw-context-menu__glyph">@ResolveToolboxBlockIcon(block)</span>
                                                                                    </span>
                                                                                    <span class="cw-context-toolbox__item-body">
                                                                                        <strong>@block.Name</strong>
                                                                                        <small>@block.Summary</small>
                                                                                    </span>
                                                                                </button>
                                                                                <button type="button"
                                                                                        class="pf-components-toolbox__preview-toggle"
                                                                                        title="Preview component text"
                                                                                        aria-label="@($"Preview {block.Name}")"
                                                                                        @onmouseenter="@(args => ShowComponentPreviewAsync(block, args))"
                                                                                        @onmouseleave="HideComponentPreviewAsync"
                                                                                        @onfocus="@(args => ShowComponentPreviewAsync(block, args))"
                                                                                        @onblur="HideComponentPreviewAsync">
                                                                                    Eye
                                                                                </button>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                </details>
                                                            }
                                                        </div>
                                                    </details>
                                                }
                                            }
                                        </div>
                                    </div>

                                    @if (HasComponentPreview && PreviewedComponentBlock is not null && componentPreviewPopover is not null)
                                    {
                                        <div class="cw-context-toolbox__preview pf-components-toolbox__popover"
                                             data-testid="prompt-factory-component-preview-popover"
                                             data-placement="@componentPreviewPopover.Placement"
                                             style="@ComponentPreviewPopoverStyle"
                                             @onmouseenter="@(args => HoldComponentPreviewAsync())"
                                             @onmouseleave="HideComponentPreviewAsync">
                                            <p class="cw-context-toolbox__preview-kicker">Eye preview</p>
                                            <h3 class="cw-context-toolbox__preview-title">@PreviewedComponentBlock.Name</h3>
                                            <p class="cw-context-toolbox__preview-copy">@PreviewedComponentSummary</p>
                                            <div class="cw-context-toolbox__preview-meta">
                                                <span class="cw-context-toolbox__preview-pill">@ResolveLibraryGroupLabel(PreviewedComponentBlock.GroupKey)</span>
                                                <span class="cw-context-toolbox__preview-pill">@PreviewedComponentBlock.BlockKind</span>
                                                <span class="cw-context-toolbox__preview-pill">@(PreviewedComponentBlock.TemplateTokens.Count > 0 ? "Parameterized" : "Static")</span>
                                            </div>
                                            <pre class="pf-components-toolbox__preview-content">@PreviewedComponentContent</pre>
                                        </div>
                                    }
                                </section>
                            </CanvasFloatingWindow>
                        }

                        <section @ref="floatingInspectorPanel"
                                 class="pf-floating-inspector @(isCanvasInspectorMinimized ? "is-minimized" : string.Empty)"
                                 aria-label="Canvas inspector">
                            <div class="pf-floating-inspector__header">
                                <div class="pf-floating-inspector__drag"
                                     @ref="floatingInspectorHandle"
                                     title="Drag inspector">
                                    <p class="cw-panel-kicker">Canvas inspector</p>
                                    <h3 class="cw-panel-title">@ResolveInspectorTitle()</h3>
                                </div>
                                <div class="pf-floating-inspector__actions">
                                    @if (!isCanvasInspectorMinimized)
                                    {
                                        <span class="pf-meta-badge pf-meta-badge--compact">@ResolveActiveWorkflowBadge()</span>
                                        <button type="button"
                                                class="pf-floating-inspector__action"
                                                title="Dock inspector to the right edge"
                                                @onclick="DockCanvasInspectorAsync">
                                            Dock
                                        </button>
                                    }
                                    <button type="button"
                                            class="pf-floating-inspector__action"
                                            title="@(isCanvasInspectorMinimized ? "Show inspector" : "Hide inspector")"
                                            @onclick="ToggleCanvasInspector">
                                        @(isCanvasInspectorMinimized ? "Show" : "Hide")
                                    </button>
                                </div>
                            </div>

                            @if (isCanvasInspectorMinimized)
                            {
                                <button type="button"
                                        class="pf-floating-inspector__restore"
                                        @onclick="ToggleCanvasInspector">
                                    Show selected item
                                </button>
                            }
                            else
                            {
                                <div class="pf-floating-inspector__body @(selectedComponentNode is not null ? "pf-floating-inspector__body--component" : string.Empty)">
                @if (selectedComponentNode is null && selectedComponentGroupNode is null)
                {
                    <div class="cw-panel-card pf-inspector-context">
                        <div class="pf-card-header pf-card-header--tight">
                            <div class="pf-card-header__copy">
                                <p class="cw-panel-kicker">Canvas inspector</p>
                                <h3 class="cw-panel-title">@ResolveInspectorTitle()</h3>
                                <p class="cw-panel-copy">@ResolveInspectorCopy()</p>
                            </div>
                            <span class="pf-meta-badge">@ResolveActiveWorkflowBadge()</span>
                        </div>
                        <div class="cw-chip-row">
                            <span class="cw-node__chip tone-accent">@ResolveInspectorSelectionPill()</span>
                            <span class="cw-node__chip">Use page tabs for setup, governance, assembly, and review</span>
                        </div>
                    </div>
                }

                @if (selectedCanvasNodeIds.Count > 1)
                {
                    <div class="pf-inspector-stack">
                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Multi-select</p>
                            <h3 class="cw-panel-title">@($"{selectedCanvasNodeIds.Count} flow elements selected")</h3>
                            <p class="cw-panel-copy">Use the canvas to batch-move the current set. Inspector actions stay intentionally conservative so prompt-state mutations remain explicit.</p>
                            <div class="cw-button-row">
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="ClearCanvasSelectionAsync">Clear selection</button>
                                <button type="button" class="cw-button" data-tone="accent" @onclick="SelectRootNodeAsync">Focus session</button>
                            </div>
                        </div>

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Selected items</p>
                            <div class="cw-list">
                                @foreach (var label in ResolveSelectedCanvasLabels())
                                {
                                    <div class="cw-list-item">
                                        <strong>@label.Title</strong>
                                        <span>@label.Subtitle</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                else if (selectedBlueprintNode is not null)
                {
                    <div class="pf-inspector-stack">
                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Blueprint</p>
                            <h3 class="cw-panel-title">@selectedBlueprintNode.Name</h3>
                            <p class="cw-panel-copy">@selectedBlueprintNode.Guidance</p>
                            <div class="cw-chip-row">
                                <span class="cw-node__chip tone-accent">@selectedBlueprintNode.PromptType</span>
                                @if (!string.IsNullOrWhiteSpace(selectedBlueprintNode.RecommendedFlowKey))
                                {
                                    <span class="cw-node__chip">Flow: @selectedBlueprintNode.RecommendedFlowKey</span>
                                }
                            </div>
                        </div>

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Selection</p>
                            <div class="cw-button-row">
                                <button type="button" class="cw-button" data-tone="accent" @onclick="ApplyRecommendationsAsync">Apply recommendations</button>
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="OpenSelectionPromptPreviewAsync">Preview selection</button>
                                <button type="button" class="cw-button" data-tone="warn" @onclick="@(() => HandleCanvasActionAsync("clear:blueprint", selectedCanvasNodeId))">Clear blueprint</button>
                            </div>
                        </div>
                    </div>
                }
                else if (selectedFlowNode is not null)
                {
                    <div class="pf-inspector-stack">
                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Flow template</p>
                            <h3 class="cw-panel-title">@selectedFlowNode.Name</h3>
                            <p class="cw-panel-copy">@selectedFlowNode.Summary</p>
                            <div class="cw-chip-row">
                                <span class="cw-node__chip tone-accent">@selectedFlowNode.AgentSequence.Count agent step(s)</span>
                                <span class="cw-node__chip">@selectedFlowNode.BlockKeys.Count block(s)</span>
                            </div>
                        </div>

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Selection</p>
                            <div class="cw-button-row">
                                <button type="button" class="cw-button" data-tone="mint" @onclick="BuildAsync">Build prompt</button>
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="OpenSelectionPromptPreviewAsync">Preview selection</button>
                                <button type="button" class="cw-button" data-tone="warn" @onclick="@(() => HandleCanvasActionAsync("clear:flow", selectedCanvasNodeId))">Clear flow</button>
                            </div>
                        </div>
                    </div>
                }
                else if (selectedComponentNode is not null)
                {
                    var customization = selectedComponentCustomization;
                    <div class="pf-inspector-stack pf-inspector-stack--editor">
                        <div class="cw-panel-card pf-inspector-card--compact">
                            <p class="cw-panel-kicker">Prompt component</p>
                            <h3 class="cw-panel-title">@selectedComponentNode.Name</h3>
                            <p class="cw-panel-copy">@selectedComponentNode.Summary</p>
                            <div class="cw-chip-row pf-chip-row--compact">
                                <span class="cw-node__chip tone-accent">@selectedComponentNode.BlockKind</span>
                                <span class="cw-node__chip">@ResolveLibraryGroupLabel(selectedComponentNode.GroupKey)</span>
                                <span class="cw-node__chip @(SelectedComponentIsModified ? "tone-warn" : "tone-success")">@(SelectedComponentIsModified ? "Session override" : "Template baseline")</span>
                                @if (customization?.TemplateValues.Count > 0)
                                {
                                    <span class="cw-node__chip tone-success">@($"{customization.TemplateValues.Count} specified")</span>
                                }
                            </div>
                        </div>

                        @if (customization?.TemplateValues.Count > 0)
                        {
                            <div class="cw-panel-card">
                                <p class="cw-panel-kicker">Specification</p>
                                <div class="cw-list">
                                    @foreach (var value in customization.TemplateValues)
                                    {
                                        <div class="cw-list-item">
                                            <strong>@value.Key</strong>
                                            <span>@value.Value</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="cw-panel-card pf-component-editor-card">
                            <div class="pf-card-header pf-card-header--tight">
                                <div class="pf-card-header__copy pf-card-header__copy--editor">
                                    <p class="cw-panel-kicker">Session prompt text</p>
                                    <h3 class="cw-panel-title">Effective component content</h3>
                                </div>
                                <span class="pf-accordion-meta pf-accordion-meta--small">@(SelectedComponentIsModified ? "Modified" : "Baseline")</span>
                            </div>
                            <div class="pf-editor-textarea-wrap">
                                <textarea class="cw-textarea pf-component-editor"
                                          @bind="SelectedComponentRenderedContent"></textarea>
                                <button type="button"
                                        class="pf-editor-expand-btn"
                                        title="Open in large editor"
                                        @onclick="OpenComponentEditorModal">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" y1="3" x2="14" y2="10"></line><line x1="3" y1="21" x2="10" y2="14"></line></svg>
                                </button>
                            </div>
                            <div class="cw-button-row pf-button-row--compact">
                                <button type="button" class="cw-button pf-button--compact" data-tone="ghost" @onclick="OpenSelectionPromptPreviewAsync">Preview</button>
                                <button type="button"
                                        class="cw-button pf-button--compact"
                                        data-tone="accent"
                                        disabled="@(!SelectedComponentIsModified)"
                                        @onclick="ResetSelectedComponentRenderedContent">Reset</button>
                                <button type="button" class="cw-button pf-button--compact" data-tone="warn" @onclick="@(() => HandleCanvasActionAsync($"component:remove:{selectedComponentNode.Key}", selectedCanvasNodeId))">Remove</button>
                            </div>
                        </div>
                    </div>
                }
                else if (selectedComponentGroupNode is not null)
                {
                    <div class="pf-inspector-stack">
                        <div class="cw-panel-card pf-inspector-card--compact">
                            <p class="cw-panel-kicker">Component group</p>
                            <h3 class="cw-panel-title">@selectedComponentGroupNode.Name</h3>
                            <p class="cw-panel-copy">@selectedComponentGroupNode.Purpose</p>
                            <div class="cw-chip-row pf-chip-row--compact">
                                <span class="cw-node__chip tone-accent">@($"{selectedComponentGroupNode.Components.Count(item => editor.SelectedBlockIds.Contains(item.Id))} selected")</span>
                            </div>
                        </div>

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Selected components</p>
                            <div class="cw-list">
                                @foreach (var component in selectedComponentGroupNode.Components.Where(item => editor.SelectedBlockIds.Contains(item.Id)).OrderBy(item => item.OrderIndex))
                                {
                                    <div class="cw-list-item">
                                        <strong>@component.Name</strong>
                                        <span>@component.BlockKind</span>
                                    </div>
                                }
                            </div>
                            <div class="cw-button-row">
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="OpenSelectionPromptPreviewAsync">Preview selection</button>
                            </div>
                        </div>
                    </div>
                }
                else if (selectedSetupNode is not null)
                {
                    <div class="pf-inspector-stack">
                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Session setup</p>
                            <h3 class="cw-panel-title">First-step wizard</h3>
                            <p class="cw-panel-copy">@ResolveSetupLeadCopy()</p>
                            <div class="cw-chip-row">
                                <span class="cw-node__chip tone-accent">@ResolveSetupStatusLabel()</span>
                                <span class="cw-node__chip">@ResolveSetupSummaryLine()</span>
                            </div>
                        </div>

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Selected node details</p>
                            <div class="cw-list">
                                <div class="cw-list-item">
                                    <strong>Intent</strong>
                                    <span>@(string.IsNullOrWhiteSpace(sessionSetup.IntentCategory) ? "Not set" : sessionSetup.IntentCategory)</span>
                                </div>
                                <div class="cw-list-item">
                                    <strong>Main language</strong>
                                    <span>@(string.IsNullOrWhiteSpace(sessionSetup.MainLanguage) ? "Not set" : sessionSetup.MainLanguage)</span>
                                </div>
                                <div class="cw-list-item">
                                    <strong>Application state</strong>
                                    <span>@(string.IsNullOrWhiteSpace(sessionSetup.ApplicationState) ? "Not set" : sessionSetup.ApplicationState)</span>
                                </div>
                                <div class="cw-list-item">
                                    <strong>Work repository</strong>
                                    <span>@(string.IsNullOrWhiteSpace(sessionSetup.WorkRepository) ? "Missing" : sessionSetup.WorkRepository)</span>
                                </div>
                            </div>
                            <div class="cw-button-row">
                                <button type="button" class="cw-button" data-tone="accent" @onclick="@(() => SetSupportLaneTabAsync(SupportLaneTabSetup))">Open Setup tab</button>
                                <button type="button" class="cw-button" data-tone="primary" @onclick="SaveSetupProfileAsync">Save setup</button>
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="OpenSelectionPromptPreviewAsync">Preview selection</button>
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="SelectRootNodeAsync">Focus session</button>
                            </div>
                        </div>
                    </div>
                }
                else if (selectedAttachmentNode is not null)
                {
                    <div class="pf-inspector-stack">
                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Prompt input</p>
                            <h3 class="cw-panel-title">@selectedAttachmentNode.Title</h3>
                            <p class="cw-panel-copy">@ResolveAttachmentLeadText(selectedAttachmentNode)</p>
                            <div class="cw-chip-row">
                                <span class="cw-node__chip tone-accent">@selectedAttachmentNode.Kind</span>
                                @if (!string.IsNullOrWhiteSpace(selectedAttachmentNode.MediaOriginalFileName))
                                {
                                    <span class="cw-node__chip">@selectedAttachmentNode.MediaOriginalFileName</span>
                                }
                            </div>
                        </div>

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Selection</p>
                            <div class="cw-button-row">
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="OpenSelectionPromptPreviewAsync">Preview selection</button>
                                <button type="button" class="cw-button" data-tone="warn" @onclick="@(() => HandleCanvasActionAsync($"input:remove:{selectedAttachmentNode.Id}", selectedCanvasNodeId))">Remove input</button>
                            </div>
                        </div>
                    </div>
                }
                else if (selectedPromptNode is not null)
                {
                    <div class="pf-inspector-stack">
                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Prompt step</p>
                            <h3 class="cw-panel-title">@selectedPromptNode.Title</h3>
                            <p class="cw-panel-copy">@selectedPromptNode.BranchLabel Â· step @selectedPromptNode.Sequence</p>
                            <div class="cw-chip-row">
                                <span class="cw-node__chip tone-accent">@selectedPromptNode.State</span>
                                @if (selectedPromptNode.ParentNodeId.HasValue)
                                {
                                    <span class="cw-node__chip">Derived branch</span>
                                }
                                @if (selectedPromptNode.PromptArtifactId.HasValue)
                                {
                                    <span class="cw-node__chip tone-success">Artifact linked</span>
                                }
                            </div>
                        </div>

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Editor</p>
                            <div class="cw-form-grid">
                                <div class="cw-form-field">
                                    <label>Title</label>
                                    <input class="cw-text-input" @bind="selectedPromptNodeTitle" />
                                </div>
                                <div class="cw-form-field">
                                    <label>State</label>
                                    <select class="cw-select" @bind="selectedPromptNodeState">
                                        @foreach (var state in Enum.GetValues<PromptRunNodeState>())
                                        {
                                            <option value="@state">@state</option>
                                        }
                                    </select>
                                </div>
                                <div class="cw-form-field">
                                    <label>Notes</label>
                                    <textarea class="cw-textarea" @bind="selectedPromptNodeNotes"></textarea>
                                </div>
                            </div>

                            <div class="cw-button-row">
                                <button type="button" class="cw-button" data-tone="primary" @onclick="SaveSelectedPromptNodeAsync">Save step</button>
                                <button type="button" class="cw-button" data-tone="accent" @onclick="@(() => BranchAsync(selectedPromptNode.Id))">Branch</button>
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="OpenSelectionPromptPreviewAsync">Preview selection</button>
                                <button type="button" class="cw-button" data-tone="mint" @onclick="@(() => SetPromptNodeStateAsync(selectedPromptNode.Id, PromptRunNodeState.Used))">Mark used</button>
                                <button type="button" class="cw-button" data-tone="mint" @onclick="@(() => SetPromptNodeStateAsync(selectedPromptNode.Id, PromptRunNodeState.Validated))">Validate</button>
                                <button type="button" class="cw-button" data-tone="warn" @onclick="@(() => SetPromptNodeStateAsync(selectedPromptNode.Id, PromptRunNodeState.Skipped))">Skip</button>
                                @if (selectedPromptNode.PromptArtifactId.HasValue)
                                {
                                    <button type="button" class="cw-button" data-tone="ghost" @onclick="@(() => OpenPromptArtifact(selectedPromptNode.PromptArtifactId.Value))">Open prompt</button>
                                }
                            </div>
                        </div>
                    </div>
                }
                else if (selectedBranchLabel is not null)
                {
                    <div class="pf-inspector-stack">
                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Branch</p>
                            <h3 class="cw-panel-title">@selectedBranchLabel</h3>
                            <p class="cw-panel-copy">@($"{selectedBranchNodes.Count} step(s) in this branch")</p>
                            <div class="cw-button-row">
                                <button type="button" class="cw-button" data-tone="accent" @onclick="BuildAsync">Build prompt</button>
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="OpenSelectionPromptPreviewAsync">Preview selection</button>
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="SelectRootNodeAsync">Focus session</button>
                            </div>
                        </div>

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Branch steps</p>
                            <div class="cw-list">
                                @foreach (var node in selectedBranchNodes)
                                {
                                    <button type="button" class="cw-list-item" @onclick="@(() => SelectPromptCanvasNodeAsync(node.Id))">
                                        <strong>@node.Title</strong>
                                        <span>@node.State Â· step @node.Sequence</span>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="pf-inspector-stack">
                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Session root</p>
                            <h3 class="cw-panel-title">@(!string.IsNullOrWhiteSpace(editor.SessionName) ? editor.SessionName : "Prompt session")</h3>
                            <p class="cw-panel-copy">@ResolveSessionInspectorCopy()</p>
                            <div class="cw-chip-row">
                                <span class="cw-node__chip tone-accent">@wizardSteps[CurrentWizardStep]</span>
                                <span class="cw-node__chip">@ResolveWizardStepMeta(CurrentWizardStep)</span>
                            </div>
                        </div>

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Quick actions</p>
                            <div class="cw-summary-grid">
                                <div class="cw-summary-tile">
                                    <span>Setup</span>
                                    <strong>@ResolveSetupStatusLabel()</strong>
                                </div>
                                <div class="cw-summary-tile">
                                    <span>Components</span>
                                    <strong>@editor.SelectedBlockIds.Count</strong>
                                </div>
                                <div class="cw-summary-tile">
                                    <span>Inputs</span>
                                    <strong>@VisibleSessionAttachments.Count</strong>
                                </div>
                                <div class="cw-summary-tile">
                                    <span>Warnings</span>
                                    <strong>@editor.Warnings.Count</strong>
                                </div>
                            </div>
                            <div class="cw-button-row">
                                <button type="button" class="cw-button" data-tone="accent" @onclick="@(() => SetSupportLaneTabAsync(SupportLaneTabSetup))">Open Setup tab</button>
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="@(() => SetSupportLaneTabAsync(SupportLaneTabGovernance))">Open Governance tab</button>
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="@(() => SetSupportLaneTabAsync(SupportLaneTabAssembly))">Open Assembly tab</button>
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="@(() => SetSupportLaneTabAsync(SupportLaneTabReview))">Open Review tab</button>
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="OpenSelectionPromptPreviewAsync">Preview selection</button>
                                <button type="button" class="cw-button" data-tone="primary" @onclick="SaveSessionStateAsync">Save session</button>
                            </div>
                        </div>
                    </div>
                }
                                </div>
                            }
                        </section>
                    </OverlayContent>
                </CanvasWorkbench>
            </Canvas>
            </CanvasWorkbenchStage>

            <div class="mt-5">
                <CanvasBoundaryCard TestHookId="prompt-factory-undo-redo-adapter"
                                           Label="Prompt Factory undo redo adapter"
                                           Title="Prompt editing history now resolves through one domain adapter"
                                           Summary="Canvas selection, inspector tab state, and prompt-session snapshots are captured together so shared history infrastructure can drive toolbar buttons and keyboard shortcuts."
                                           StatePill="@(CanUndo || CanRedo ? "History ready" : "Baseline")"
                                           Metrics="@UndoRedoMetrics">
                    <div class="grid gap-4 lg:grid-cols-[auto_1fr]">
                        <div class="flex items-start gap-3">
                            <button type="button"
                                    class="cw-button"
                                    data-tone="ghost"
                                    disabled="@(!CanUndo)"
                                    @onclick="UndoAsync">
                                Undo
                            </button>
                            <button type="button"
                                    class="cw-button"
                                    data-tone="accent"
                                    disabled="@(!CanRedo)"
                                    @onclick="RedoAsync">
                                Redo
                            </button>
                        </div>
                        <div class="grid gap-3 md:grid-cols-3">
                            <div class="rounded-[1.4rem] border border-slate-200 bg-white/85 px-4 py-4">
                                <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">Session</p>
                                <p class="mt-2 text-sm text-slate-950">@UndoRedoSessionLabel</p>
                            </div>
                            <div class="rounded-[1.4rem] border border-slate-200 bg-white/85 px-4 py-4">
                                <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">Selection</p>
                                <p class="mt-2 text-sm text-slate-950">@UndoRedoSelectionLabel</p>
                            </div>
                            <div class="rounded-[1.4rem] border border-slate-200 bg-white/85 px-4 py-4">
                                <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">Inspector tab</p>
                                <p class="mt-2 text-sm text-slate-950">@activeInspectorTab</p>
                            </div>
                        </div>
                    </div>
                </CanvasBoundaryCard>
            </div>

            <div class="mt-5 grid gap-5 xl:grid-cols-2 2xl:grid-cols-3">
                <ChipBadgePrimitive Snapshot="@ChipBadgePreviewSnapshot" />
                <ConnectorPathPrimitive Snapshot="@ConnectorPathPreviewSnapshot" />
                <ContainerPrimitive Snapshot="@ContainerPreviewSnapshot" />
                <ContextMenuHost Snapshot="@ContextMenuPreviewSnapshot" />
                <CreateActionPalette Snapshot="@CreateActionPalettePreviewSnapshot" />
                <FloatingInspectorHost Snapshot="@FloatingInspectorPreviewSnapshot" />
                <GroupFrameOverlay Snapshot="@GroupFramePreviewSnapshot" />
                <IconGlyphPrimitive Snapshot="@IconGlyphPreviewSnapshot" />
                <ImagePrimitive Snapshot="@ImagePreviewSnapshot" />
                <InlineEditorComposer Snapshot="@InlineEditorPreviewSnapshot" />
                <NodeCardComposer Snapshot="@NodeCardPreviewSnapshot" />
                <TextBlockPrimitive Snapshot="@TextBlockPreviewSnapshot" />
            </div>
            </div>
        }
        else
        {
            <div class="pf-support-tab-shell"
                 id="@($"{supportLaneTab}-panel")"
                 role="tabpanel"
                 aria-labelledby="@($"{supportLaneTab}-tab")">
                @if (IsContextStep)
                {
                    <section class="cw-panel-card pf-step-hero pf-wide-card">
                        <p class="cw-panel-kicker">Setup</p>
                        <h3 class="cw-panel-title">Frame the session before the prompt flow gets busy</h3>
                        <p class="cw-panel-copy">Use this setup lane to define intent, stack, and repositories before the canvas grows into a larger mindmap.</p>
                        <div class="cw-summary-grid">
                            <div class="cw-summary-tile">
                                <span>Session</span>
                                <strong>@(string.IsNullOrWhiteSpace(editor.SessionName) ? "Untitled session" : editor.SessionName)</strong>
                            </div>
                            <div class="cw-summary-tile">
                                <span>Project</span>
                                <strong>@ResolveSelectedProjectName()</strong>
                            </div>
                            <div class="cw-summary-tile">
                                <span>Blueprint</span>
                                <strong>@ResolveSelectedBlueprintName()</strong>
                            </div>
                            <div class="cw-summary-tile">
                                <span>Setup</span>
                                <strong>@ResolveSetupStatusLabel()</strong>
                            </div>
                        </div>
                        <div class="cw-button-row">
                            <button type="button" class="cw-button" data-tone="primary" @onclick="SaveSetupProfileAsync">Save setup</button>
                            <button type="button" class="cw-button" data-tone="ghost" @onclick="@(() => SetSupportLaneTabAsync(SupportLaneTabCanvas))">Open canvas</button>
                            <button type="button" class="cw-button" data-tone="ghost" @onclick="@(() => SetSupportLaneTabAsync(SupportLaneTabGovernance))">Continue to governance</button>
                        </div>
                    </section>

                    <section class="cw-panel-card pf-wide-card pf-setup-guide">
                        <div class="pf-card-header">
                            <div class="pf-card-header__copy">
                                <p class="cw-panel-kicker">First-step wizard</p>
                                <h3 class="cw-panel-title">Capture the working frame once, then reopen it from the canvas later</h3>
                                <p class="cw-panel-copy">The same setup is pinned into the prompt map as a dedicated node, so it stays available in normal and maximized canvas modes.</p>
                            </div>
                            <span class="pf-accordion-meta">@ResolveSetupStatusLabel()</span>
                        </div>

                        <div class="pf-two-column">
                            <div class="cw-form-grid">
                                <div class="cw-form-field">
                                    <label>Intent</label>
                                    <select class="cw-select" @bind="sessionSetup.IntentCategory">
                                        <option value="">Select intent</option>
                                        @foreach (var option in SetupIntentOptions)
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    </select>
                                </div>

                                @if (ShowProgrammingLanguageField)
                                {
                                    <div class="cw-form-field">
                                        <label>Main language</label>
                                        <select class="cw-select" @bind="sessionSetup.MainLanguage">
                                            <option value="">Select language</option>
                                            @foreach (var option in SetupProgrammingLanguageOptions)
                                            {
                                                <option value="@option">@option</option>
                                            }
                                        </select>
                                    </div>
                                }

                                <div class="cw-form-field">
                                    <label>Application state</label>
                                    <select class="cw-select" @bind="sessionSetup.ApplicationState">
                                        <option value="">Select state</option>
                                        @foreach (var option in SetupApplicationStateOptions)
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    </select>
                                </div>

                                <div class="cw-form-field">
                                    <label>Work repository</label>
                                    <input class="cw-text-input" @bind="sessionSetup.WorkRepository" placeholder="Main delivery repository" />
                                </div>

                                <div class="cw-form-field">
                                    <label>Info or source repositories</label>
                                    <input class="cw-text-input" @bind="sessionSetup.SourceRepositories" placeholder="Specs, docs, datasets, or supporting repos" />
                                </div>

                                <div class="cw-form-field">
                                    <label>Secondary languages</label>
                                    <input class="cw-text-input" @bind="sessionSetup.SecondaryLanguages" placeholder="Optional supporting languages or stacks" />
                                </div>
                            </div>

                            <div class="pf-section-stack">
                                <article class="pf-group-card">
                                    <strong>Guidance notes</strong>
                                    <textarea class="cw-textarea" @bind="sessionSetup.GuidanceNotes" placeholder="Explain what the AI should optimize for in this session."></textarea>
                                </article>

                                <article class="pf-group-card">
                                    <strong>Project snapshot</strong>
                                    <textarea class="cw-textarea" @bind="sessionSetup.ProjectSnapshot"></textarea>
                                </article>

                                <article class="pf-group-card">
                                    <strong>Why this matters</strong>
                                    <div class="pf-next-list">
                                        <div class="pf-next-step">Programming sessions can ask for the main language only when it matters.</div>
                                        <div class="pf-next-step">Repositories and source references keep the AI anchored to the real delivery context.</div>
                                        <div class="pf-next-step">The setup node remains available later, so re-framing does not require leaving the canvas.</div>
                                    </div>
                                </article>
                            </div>
                        </div>

                        <div class="cw-button-row">
                            <button type="button" class="cw-button" data-tone="primary" @onclick="SaveSetupProfileAsync">Save setup</button>
                            <button type="button" class="cw-button" data-tone="ghost" @onclick="@(() => SelectSetupNodeAsync())">Focus setup node</button>
                            <button type="button" class="cw-button" data-tone="accent" @onclick="@(() => SetSupportLaneTabAsync(SupportLaneTabGovernance))">Continue to governance</button>
                        </div>
                    </section>

                    <section class="cw-panel-card pf-wide-card pf-workspace-card">
                        <div class="pf-card-header">
                            <div class="pf-card-header__copy">
                                <p class="cw-panel-kicker">Context workspace</p>
                                <h3 class="cw-panel-title">Use one support view at a time</h3>
                                <p class="cw-panel-copy">@ResolveContextWorkspaceSummary()</p>
                            </div>
                            <div class="pf-tab-strip" role="tablist" aria-label="Context workspace views">
                                <button type="button"
                                        role="tab"
                                        aria-selected="@(IsContextView(ContextViewOverview) ? "true" : "false")"
                                        class="pf-tab-button @(IsContextView(ContextViewOverview) ? "is-active" : string.Empty)"
                                        @onclick="() => SetContextWorkspaceView(ContextViewOverview)">
                                    Overview
                                </button>
                                <button type="button"
                                        role="tab"
                                        aria-selected="@(IsContextView(ContextViewLibrary) ? "true" : "false")"
                                        class="pf-tab-button @(IsContextView(ContextViewLibrary) ? "is-active" : string.Empty)"
                                        @onclick="() => SetContextWorkspaceView(ContextViewLibrary)">
                                    Library
                                </button>
                                <button type="button"
                                        role="tab"
                                        aria-selected="@(IsContextView(ContextViewStarters) ? "true" : "false")"
                                        class="pf-tab-button @(IsContextView(ContextViewStarters) ? "is-active" : string.Empty)"
                                        @onclick="() => SetContextWorkspaceView(ContextViewStarters)">
                                    Starters
                                </button>
                            </div>
                        </div>

                        @if (IsContextView(ContextViewOverview))
                        {
                            <div class="pf-two-column">
                                <div class="pf-section-stack">
                                    <article class="pf-group-card">
                                        <strong>Current working frame</strong>
                                        <div class="cw-summary-grid">
                                            <div class="cw-summary-tile">
                                                <span>Provider</span>
                                                <strong>@ResolveSelectedProviderName()</strong>
                                            </div>
                                            <div class="cw-summary-tile">
                                                <span>Phase</span>
                                                <strong>@(string.IsNullOrWhiteSpace(editor.Phase) ? "Not set" : editor.Phase)</strong>
                                            </div>
                                            <div class="cw-summary-tile">
                                                <span>Inputs</span>
                                                <strong>@VisibleSessionAttachments.Count</strong>
                                            </div>
                                            <div class="cw-summary-tile">
                                                <span>Warnings</span>
                                                <strong>@editor.Warnings.Count</strong>
                                            </div>
                                        </div>
                                        <small>Pick blueprint and flow from the canvas or inspector first. Resource assembly and detailed governance move to later steps so the page stays short while the user is still orienting.</small>
                                    </article>

                                    <article class="pf-group-card">
                                        <strong>Prompt library pack</strong>
                                        <p>@($"{libraryCatalog.ComponentCount} components, {libraryCatalog.FlowCount} flows, and {libraryCatalog.BlueprintCount} blueprints are available to the wizard.")</p>
                                        <div class="cw-chip-row">
                                            <span class="cw-node__chip">@($"{OrderedLibraryGroups.Count} groups")</span>
                                            <span class="cw-node__chip">Grouped canvas menu</span>
                                            <span class="cw-node__chip">Prompt-library import active</span>
                                        </div>
                                    </article>
                                </div>

                                <div class="pf-section-stack">
                                    <article class="pf-group-card">
                                        <strong>Recommended next moves</strong>
                                        <div class="pf-next-list">
                                            <div class="pf-next-step">Confirm the project and provider in the inspector so the session has a delivery frame.</div>
                                            <div class="pf-next-step">Open <strong>Starters</strong> to apply a blueprint or flow directly instead of browsing long dropdowns.</div>
                                            <div class="pf-next-step">Continue to <strong>Governance</strong> only after the base prompt shape is set.</div>
                                        </div>
                                        <div class="cw-button-row">
                                            <button type="button" class="cw-button" data-tone="accent" @onclick="() => SetContextWorkspaceView(ContextViewStarters)">Open starters</button>
                                            <button type="button" class="cw-button" data-tone="ghost" @onclick="() => SetContextWorkspaceView(ContextViewLibrary)">Open library</button>
                                            <button type="button" class="cw-button" data-tone="ghost" @onclick="@(() => SetSupportLaneTabAsync(SupportLaneTabGovernance))">Go to governance</button>
                                        </div>
                                    </article>

                                    <article class="pf-group-card">
                                        <strong>Current selection path</strong>
                                        <p>The support lane now mirrors the active context in one glance instead of repeating every form below the canvas.</p>
                                        <div class="cw-chip-row">
                                            <span class="cw-node__chip">@($"Project: {ResolveSelectedProjectName()}")</span>
                                            <span class="cw-node__chip">@($"Blueprint: {ResolveSelectedBlueprintName()}")</span>
                                            <span class="cw-node__chip">@($"Flow: {ResolveSelectedFlowName()}")</span>
                                            <span class="cw-node__chip">@($"Provider: {ResolveSelectedProviderName()}")</span>
                                        </div>
                                    </article>
                                </div>
                            </div>
                        }
                        else if (IsContextView(ContextViewLibrary))
                        {
                            <div class="pf-toolbar">
                                <input class="cw-text-input pf-toolbar__search"
                                       placeholder="Search prompt library groups"
                                       @bind="catalogSearchText"
                                       @bind:event="oninput" />
                                <span class="pf-accordion-meta">@($"{FilteredLibraryGroups.Count} groups")</span>
                            </div>
                            @if (FilteredLibraryGroups.Count == 0)
                            {
                                <div class="pf-empty">No prompt-library groups match the current search.</div>
                            }
                            else
                            {
                                <div class="pf-scroll-panel pf-scroll-panel--tall">
                                    <div class="pf-group-grid">
                                        @foreach (var group in FilteredLibraryGroups)
                                        {
                                            <article class="pf-group-card">
                                                <strong>@group.Name</strong>
                                                <p>@group.Summary</p>
                                                <small>@group.Purpose</small>
                                                <div class="cw-chip-row">
                                                    <span class="cw-node__chip">@($"{group.ComponentCount} components")</span>
                                                    <span class="cw-node__chip">@group.UiMode</span>
                                                    <span class="cw-node__chip">@group.Key</span>
                                                </div>
                                            </article>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else if (IsContextView(ContextViewStarters))
                        {
                            <div class="pf-toolbar">
                                <input class="cw-text-input pf-toolbar__search"
                                       placeholder="Search blueprints and flows"
                                       @bind="starterSearchText"
                                       @bind:event="oninput" />
                                <span class="pf-accordion-meta">@($"{FilteredBlueprintStarters.Count} blueprints | {FilteredFlowStarters.Count} flows")</span>
                            </div>

                            <div class="pf-two-column">
                                <div class="pf-section-stack">
                                    <div class="pf-card-header">
                                        <div class="pf-card-header__copy">
                                            <p class="cw-panel-kicker">Blueprint starters</p>
                                            <h3 class="cw-panel-title">Apply a blueprint directly</h3>
                                            <p class="cw-panel-copy">Use starters to set the base prompt type without leaving the current page context.</p>
                                        </div>
                                    </div>
                                    @if (FilteredBlueprintStarters.Count == 0)
                                    {
                                        <div class="pf-empty">No blueprints match the current search.</div>
                                    }
                                    else
                                    {
                                        <div class="pf-scroll-panel pf-scroll-panel--tall">
                                            <div class="pf-select-stack">
                                                @foreach (var blueprint in FilteredBlueprintStarters)
                                                {
                                                    <article class="pf-action-card @(editor.BlueprintId == blueprint.Id ? "is-selected" : string.Empty)">
                                                        <div class="pf-action-card__header">
                                                            <div class="pf-action-card__body">
                                                                <strong>@blueprint.Name</strong>
                                                                <span>@blueprint.Summary</span>
                                                            </div>
                                                            <span class="pf-accordion-meta">@(editor.BlueprintId == blueprint.Id ? "Selected" : blueprint.PromptType)</span>
                                                        </div>
                                                        <div class="cw-chip-row">
                                                            <span class="cw-node__chip">@blueprint.Key</span>
                                                            <span class="cw-node__chip">@blueprint.PromptType</span>
                                                            @if (blueprint.RecommendedFlowTemplateId.HasValue)
                                                            {
                                                                <span class="cw-node__chip">Loads recommended flow</span>
                                                            }
                                                        </div>
                                                        <div class="cw-button-row">
                                                            @if (editor.BlueprintId == blueprint.Id)
                                                            {
                                                                <button type="button" class="cw-button" data-tone="ghost" disabled>Selected</button>
                                                            }
                                                            else
                                                            {
                                                                <button type="button" class="cw-button" data-tone="accent" @onclick="() => SelectBlueprintByKeyAsync(blueprint.Key)">Use blueprint</button>
                                                            }
                                                        </div>
                                                    </article>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="pf-section-stack">
                                    <div class="pf-card-header">
                                        <div class="pf-card-header__copy">
                                            <p class="cw-panel-kicker">Flow starters</p>
                                            <h3 class="cw-panel-title">Load a flow without hunting in the inspector</h3>
                                            <p class="cw-panel-copy">Starter flows front-load the most common delivery patterns and immediately load their block sets.</p>
                                        </div>
                                    </div>
                                    @if (FilteredFlowStarters.Count == 0)
                                    {
                                        <div class="pf-empty">No flow templates match the current search.</div>
                                    }
                                    else
                                    {
                                        <div class="pf-scroll-panel pf-scroll-panel--tall">
                                            <div class="pf-select-stack">
                                                @foreach (var template in FilteredFlowStarters)
                                                {
                                                    <article class="pf-action-card @(editor.FlowTemplateId == template.Id ? "is-selected" : string.Empty)">
                                                        <div class="pf-action-card__header">
                                                            <div class="pf-action-card__body">
                                                                <strong>@template.Name</strong>
                                                                <span>@($"{template.BlockIds.Count} blocks | {template.AgentSequence.Count} agents")</span>
                                                                <small>@($"{string.Join(" -> ", template.AgentSequence.Select(agent => agent.Phase).Take(4))}{(template.AgentSequence.Count > 4 ? " -> ..." : string.Empty)}")</small>
                                                            </div>
                                                            <span class="pf-accordion-meta">@(editor.FlowTemplateId == template.Id ? "Selected" : "Starter")</span>
                                                        </div>
                                                        <div class="cw-chip-row">
                                                            <span class="cw-node__chip">@template.Key</span>
                                                            <span class="cw-node__chip">@($"{template.BlockIds.Count} blocks")</span>
                                                            <span class="cw-node__chip">@($"{template.AgentSequence.Count} agents")</span>
                                                        </div>
                                                        <div class="cw-button-row">
                                                            @if (editor.FlowTemplateId == template.Id)
                                                            {
                                                                <button type="button" class="cw-button" data-tone="ghost" disabled>Selected</button>
                                                            }
                                                            else
                                                            {
                                                                <button type="button" class="cw-button" data-tone="accent" @onclick="() => SelectFlowByKeyAsync(template.Key)">Use flow</button>
                                                            }
                                                        </div>
                                                    </article>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </section>
                }
                else if (IsGovernanceStep)
                {
                    <section class="cw-panel-card pf-step-hero pf-wide-card">
                        <p class="cw-panel-kicker">Governance</p>
                        <h3 class="cw-panel-title">Curate reusable blocks without drowning in a single list</h3>
                        <p class="cw-panel-copy">The old screen forced every component, editor form, and template checklist onto one page. This version keeps selection fast, shows the current working set, and moves block authoring behind explicit admin toggles.</p>
                        <div class="cw-summary-grid">
                            <div class="cw-summary-tile">
                                <span>Selected blocks</span>
                                <strong>@editor.SelectedBlockIds.Count</strong>
                            </div>
                            <div class="cw-summary-tile">
                                <span>Available blocks</span>
                                <strong>@blocks.Count</strong>
                            </div>
                            <div class="cw-summary-tile">
                                <span>Groups</span>
                                <strong>@OrderedLibraryGroups.Count</strong>
                            </div>
                            <div class="cw-summary-tile">
                                <span>Mode</span>
                                <strong>@(editor.HasCustomizedBlocks ? "Customized session" : "Library defaults")</strong>
                            </div>
                        </div>
                        <div class="cw-button-row">
                            <button type="button" class="cw-button" data-tone="accent" @onclick="ApplyRecommendationsAsync">Apply recommendations</button>
                            <button type="button" class="cw-button" data-tone="primary" @onclick="SaveSessionStateAsync">Save session state</button>
                            <button type="button" class="cw-button" data-tone="ghost" @onclick="CreateNewBlock">New block</button>
                        </div>
                    </section>

                    <section class="cw-panel-card pf-wide-card pf-workspace-card">
                        <div class="pf-card-header">
                            <div class="pf-card-header__copy">
                                <p class="cw-panel-kicker">Governance workspace</p>
                                <h3 class="cw-panel-title">Keep one governance view open at a time</h3>
                                <p class="cw-panel-copy">@ResolveGovernanceWorkspaceSummary()</p>
                            </div>
                            <div class="pf-tab-strip" role="tablist" aria-label="Governance workspace views">
                                <button type="button"
                                        role="tab"
                                        aria-selected="@(IsGovernanceView(GovernanceViewSelection) ? "true" : "false")"
                                        class="pf-tab-button @(IsGovernanceView(GovernanceViewSelection) ? "is-active" : string.Empty)"
                                        @onclick="@(() => SetGovernanceWorkspaceView(GovernanceViewSelection))">
                                    Selection
                                </button>
                                <button type="button"
                                        role="tab"
                                        aria-selected="@(IsGovernanceView(GovernanceViewLibrary) ? "true" : "false")"
                                        class="pf-tab-button @(IsGovernanceView(GovernanceViewLibrary) ? "is-active" : string.Empty)"
                                        @onclick="@(() => SetGovernanceWorkspaceView(GovernanceViewLibrary))">
                                    Library
                                </button>
                                <button type="button"
                                        role="tab"
                                        aria-selected="@(IsGovernanceView(GovernanceViewBlocks) ? "true" : "false")"
                                        class="pf-tab-button @(IsGovernanceView(GovernanceViewBlocks) ? "is-active" : string.Empty)"
                                        @onclick="@(() => SetGovernanceWorkspaceView(GovernanceViewBlocks))">
                                    Block editor
                                </button>
                                <button type="button"
                                        role="tab"
                                        aria-selected="@(IsGovernanceView(GovernanceViewTemplates) ? "true" : "false")"
                                        class="pf-tab-button @(IsGovernanceView(GovernanceViewTemplates) ? "is-active" : string.Empty)"
                                        @onclick="@(() => SetGovernanceWorkspaceView(GovernanceViewTemplates))">
                                    Templates
                                </button>
                            </div>
                        </div>
                    </section>

                    @if (IsGovernanceView(GovernanceViewSelection))
                    {
                    <section class="cw-panel-card">
                        <p class="cw-panel-kicker">Selection filters</p>
                        <h3 class="cw-panel-title">Search and narrow the working set</h3>
                        <div class="pf-toolbar">
                            <input class="cw-text-input pf-toolbar__search" @bind="blockSearchText" placeholder="Search blocks, tags, or template tokens" />
                            <label class="pf-toggle">
                                <input type="checkbox" @bind="showSelectedBlocksOnly" />
                                <span>Selected only</span>
                            </label>
                        </div>
                        <p class="cw-panel-copy">Grouped accordions open the first group by default and expand during search, so the user can scan large libraries without a page-length checkbox wall.</p>
                    </section>

                    <section class="cw-panel-card">
                        <p class="cw-panel-kicker">Working set</p>
                        <h3 class="cw-panel-title">Selected blocks</h3>
                        @if (SelectedGovernanceBlocks.Count == 0)
                        {
                            <div class="pf-empty">No blocks are selected yet. Use the grouped list to build a focused governance set.</div>
                        }
                        else
                        {
                            <div class="pf-scroll-panel">
                                <div class="cw-list">
                                    @foreach (var block in SelectedGovernanceBlocks)
                                    {
                                        <div class="cw-list-item">
                                            <strong>@block.Name</strong>
                                            <span>@(string.IsNullOrWhiteSpace(block.Summary) ? ResolveBlockListSummary(block) : $"{ResolveBlockListSummary(block)} | {block.Summary}")</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </section>
                    }

                    @if (IsGovernanceView(GovernanceViewTemplates))
                    {
                    <section class="cw-panel-card">
                        <div class="pf-card-header">
                            <div class="pf-card-header__copy">
                                <p class="cw-panel-kicker">Template governance</p>
                                <h3 class="cw-panel-title">Flow templates stay visible, not overwhelming</h3>
                            </div>
                            <div class="cw-button-row">
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="CreateNewTemplate">New template</button>
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="@(() => templateAdminExpanded = !templateAdminExpanded)">@(templateAdminExpanded ? "Hide editor" : "Open editor")</button>
                            </div>
                        </div>
                        @if (templates.Count == 0)
                        {
                            <div class="pf-empty">No flow templates are available.</div>
                        }
                        else
                        {
                            <div class="pf-scroll-panel">
                                <div class="cw-list">
                                    @foreach (var template in templates.OrderBy(item => item.OrderIndex))
                                    {
                                        <div class="cw-list-item">
                                            <strong>@template.Name</strong>
                                            <span>@($"{template.BlockIds.Count} blocks | {template.AgentSequence.Count} agents")</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </section>
                    }

                    @if (IsGovernanceView(GovernanceViewLibrary))
                    {
                    <section class="cw-panel-card pf-wide-card">
                        <div class="pf-card-header">
                            <div class="pf-card-header__copy">
                                <p class="cw-panel-kicker">Grouped components</p>
                                <h3 class="cw-panel-title">Governance explorer</h3>
                                <p class="cw-panel-copy">Blocks are grouped by imported catalog sections. Each group keeps its own compact checklist and selection count.</p>
                            </div>
                        </div>
                        @if (GovernanceBlockGroups.Count == 0)
                        {
                            <div class="pf-empty">No blocks match the current filter.</div>
                        }
                        else
                        {
                            <div class="pf-scroll-panel pf-scroll-panel--tall">
                                <div class="cw-accordion-stack">
                                    @foreach (var group in GovernanceBlockGroups)
                                    {
                                        <details class="cw-accordion" open="@ShouldExpandGovernanceGroup(group)">
                                            <summary class="cw-accordion__summary">
                                                <span>
                                                    <strong>@group.Name</strong>
                                                    <small>@group.Purpose</small>
                                                </span>
                                                <span class="pf-accordion-meta">@($"{group.SelectedCount} selected / {group.Blocks.Count}")</span>
                                            </summary>
                                            <div class="cw-accordion__body">
                                                <div class="pf-select-stack">
                                                    @foreach (var block in group.Blocks)
                                                    {
                                                        var isSelected = editor.SelectedBlockIds.Contains(block.Id);
                                                        <label class="pf-checklist-item @(isSelected ? "is-selected" : string.Empty)">
                                                            <span class="pf-checklist-item__body">
                                                                <strong>@block.Name</strong>
                                                                <span>@(string.IsNullOrWhiteSpace(block.Summary) ? ResolveBlockListSummary(block) : $"{ResolveBlockListSummary(block)} | {block.Summary}")</span>
                                                            </span>
                                                            <input type="checkbox"
                                                                   checked="@isSelected"
                                                                   @onchange="args => ToggleBlock(block.Id, ReadCheckboxValue(args))" />
                                                        </label>
                                                    }
                                                </div>
                                            </div>
                                        </details>
                                    }
                                </div>
                            </div>
                        }
                    </section>
                    }

                    @if (IsGovernanceView(GovernanceViewBlocks))
                    {
                    <section class="cw-panel-card pf-wide-card">
                        <div class="pf-card-header">
                            <div class="pf-card-header__copy">
                                <p class="cw-panel-kicker">Block administration</p>
                                <h3 class="cw-panel-title">Edit reusable blocks only when needed</h3>
                                <p class="cw-panel-copy">The editor is intentionally hidden by default. That keeps curation and authoring separate, which cuts a large chunk of page height from the normal workflow.</p>
                            </div>
                            <div class="cw-button-row">
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="@(() => blockAdminExpanded = !blockAdminExpanded)">@(blockAdminExpanded ? "Hide block editor" : "Open block editor")</button>
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="CreateNewBlock">New block</button>
                                @foreach (var block in blocks.Take(4))
                                {
                                    <button type="button" class="cw-button" data-tone="ghost" @onclick="@(() => EditBlockAsync(block.Id))">@block.Name</button>
                                }
                            </div>
                        </div>
                        @if (blockAdminExpanded)
                        {
                            <div class="cw-form-grid">
                                <div class="cw-form-field">
                                    <label>Block name</label>
                                    <input class="cw-text-input" @bind="blockEditor.Name" />
                                </div>
                                <div class="cw-form-field">
                                    <label>Kind</label>
                                    <select class="cw-select" @bind="blockEditor.BlockKind">
                                        @foreach (var kind in Enum.GetValues<PromptBlockKind>())
                                        {
                                            <option value="@kind">@kind</option>
                                        }
                                    </select>
                                </div>
                                <div class="cw-form-field">
                                    <label>Summary</label>
                                    <textarea class="cw-textarea" @bind="blockEditor.Summary"></textarea>
                                </div>
                                <div class="cw-form-field">
                                    <label>Reusable content</label>
                                    <textarea class="cw-textarea" @bind="blockEditor.Content"></textarea>
                                </div>
                                <div class="cw-form-grid cw-form-grid--split">
                                    <div class="cw-form-field">
                                        <label>Prompt types</label>
                                        <input class="cw-text-input" @bind="blockEditor.PromptTypes" />
                                    </div>
                                    <div class="cw-form-field">
                                        <label>Blueprints</label>
                                        <input class="cw-text-input" @bind="blockEditor.Blueprints" />
                                    </div>
                                    <div class="cw-form-field">
                                        <label>Phases</label>
                                        <input class="cw-text-input" @bind="blockEditor.Phases" />
                                    </div>
                                </div>
                                <label class="pf-checklist-item">
                                    <span class="pf-checklist-item__body">
                                        <strong>Recommended by default</strong>
                                        <span>Make this block part of the seeded governance set.</span>
                                    </span>
                                    <input type="checkbox" @bind="blockEditor.IsRecommendedByDefault" />
                                </label>
                                <div class="cw-button-row">
                                    <button type="button" class="cw-button" data-tone="primary" @onclick="SaveBlockAsync">Save block</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="pf-empty">Open the block editor only when the user needs to author or modify shared components.</div>
                        }
                    </section>
                    }

                    @if (IsGovernanceView(GovernanceViewTemplates))
                    {
                    <section class="cw-panel-card pf-wide-card">
                        <div class="pf-card-header">
                            <div class="pf-card-header__copy">
                                <p class="cw-panel-kicker">Template administration</p>
                                <h3 class="cw-panel-title">Keep template editing behind an explicit action</h3>
                                <p class="cw-panel-copy">Template governance still exists, but it no longer expands into another full-length checklist unless the user opens it.</p>
                            </div>
                            <div class="cw-button-row">
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="@(() => templateAdminExpanded = !templateAdminExpanded)">@(templateAdminExpanded ? "Hide template editor" : "Open template editor")</button>
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="CreateNewTemplate">New template</button>
                                @foreach (var template in templates.Take(4))
                                {
                                    <button type="button" class="cw-button" data-tone="ghost" @onclick="@(() => EditTemplateAsync(template.Id))">@template.Name</button>
                                }
                            </div>
                        </div>
                        @if (templateAdminExpanded)
                        {
                            <div class="cw-form-grid">
                                <div class="cw-form-field">
                                    <label>Template name</label>
                                    <input class="cw-text-input" @bind="templateEditor.Name" />
                                </div>
                                <div class="cw-form-field">
                                    <label>Summary</label>
                                    <textarea class="cw-textarea" @bind="templateEditor.Summary"></textarea>
                                </div>
                                <div class="cw-form-field">
                                    <label>Recommended prompt types</label>
                                    <input class="cw-text-input" @bind="templateEditor.RecommendedPromptTypes" />
                                </div>
                                <div class="cw-form-field">
                                    <label>Included blocks</label>
                                    <div class="pf-scroll-panel">
                                        <div class="pf-select-stack">
                                            @foreach (var block in blocks)
                                            {
                                                var isSelected = templateEditor.SelectedBlockIds.Contains(block.Id);
                                                <label class="pf-checklist-item @(isSelected ? "is-selected" : string.Empty)">
                                                    <span class="pf-checklist-item__body">
                                                        <strong>@block.Name</strong>
                                                        <span>@ResolveBlockListSummary(block)</span>
                                                    </span>
                                                    <input type="checkbox"
                                                           checked="@isSelected"
                                                           @onchange="args => ToggleTemplateBlock(block.Id, ReadCheckboxValue(args))" />
                                                </label>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="cw-button-row">
                                    <button type="button" class="cw-button" data-tone="primary" @onclick="SaveTemplateAsync">Save template</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="pf-empty">Open the template editor when flow governance needs real authoring, not during normal block selection.</div>
                        }
                    </section>
                    }
                }
                else if (IsAssemblyStep)
                {
                    <section class="cw-panel-card pf-step-hero pf-wide-card">
                        <p class="cw-panel-kicker">Assembly</p>
                        <h3 class="cw-panel-title">Build from a compact context pack instead of another long page</h3>
                        <p class="cw-panel-copy">Assembly focuses on two things: the prompt-session inputs attached from the canvas and the project resources selected for context. Everything else is summarized so the user can build quickly.</p>
                        <div class="cw-summary-grid">
                            <div class="cw-summary-tile">
                                <span>Prompt inputs</span>
                                <strong>@VisibleSessionAttachments.Count</strong>
                            </div>
                            <div class="cw-summary-tile">
                                <span>Selected resources</span>
                                <strong>@editor.SelectedResourceIds.Count</strong>
                            </div>
                            <div class="cw-summary-tile">
                                <span>Selected blocks</span>
                                <strong>@editor.SelectedBlockIds.Count</strong>
                            </div>
                            <div class="cw-summary-tile">
                                <span>Warnings</span>
                                <strong>@editor.Warnings.Count</strong>
                            </div>
                        </div>
                        <div class="cw-button-row">
                            <button type="button" class="cw-button" data-tone="mint" data-testid="prompt-factory-build" @onclick="BuildAsync">Build prompt</button>
                            <button type="button" class="cw-button" data-tone="primary" @onclick="SaveSessionStateAsync">Save session state</button>
                            <button type="button" class="cw-button" data-tone="warn" data-testid="prompt-factory-reset-session" @onclick='@(() => HandleCanvasActionAsync("reset:session", "session-root"))'>Reset session</button>
                        </div>
                    </section>

                    <section class="cw-panel-card pf-wide-card pf-workspace-card">
                        <div class="pf-card-header">
                            <div class="pf-card-header__copy">
                                <p class="cw-panel-kicker">Assembly workspace</p>
                                <h3 class="cw-panel-title">Keep context packing in one lane</h3>
                                <p class="cw-panel-copy">@ResolveAssemblyWorkspaceSummary()</p>
                            </div>
                            <div class="pf-tab-strip" role="tablist" aria-label="Assembly workspace views">
                                <button type="button"
                                        role="tab"
                                        aria-selected="@(IsAssemblyView(AssemblyViewInputs) ? "true" : "false")"
                                        class="pf-tab-button @(IsAssemblyView(AssemblyViewInputs) ? "is-active" : string.Empty)"
                                        @onclick="@(() => SetAssemblyWorkspaceView(AssemblyViewInputs))">
                                    Inputs
                                </button>
                                <button type="button"
                                        role="tab"
                                        aria-selected="@(IsAssemblyView(AssemblyViewResources) ? "true" : "false")"
                                        class="pf-tab-button @(IsAssemblyView(AssemblyViewResources) ? "is-active" : string.Empty)"
                                        @onclick="@(() => SetAssemblyWorkspaceView(AssemblyViewResources))">
                                    Resources
                                </button>
                            </div>
                        </div>
                    </section>

                    @if (IsAssemblyView(AssemblyViewInputs))
                    {
                    <section class="cw-panel-card">
                        <p class="cw-panel-kicker">Prompt inputs</p>
                        <h3 class="cw-panel-title">Files, images, notes, and links attached to the session</h3>
                        <p class="cw-panel-copy">Inputs are added from the canvas right click menu. This panel mirrors the current set so users can review context without hunting across the tree.</p>
                        @if (VisibleSessionAttachments.Count == 0)
                        {
                            <div class="pf-empty">No prompt-session inputs are attached yet.</div>
                        }
                        else
                        {
                            <div class="pf-attachment-grid">
                                @foreach (var attachment in VisibleSessionAttachments)
                                {
                                    <article class="pf-attachment-card" data-kind="@ResolveAttachmentVisualKind(attachment)">
                                        <div class="pf-attachment-card__header">
                                            <strong>@ResolveAttachmentDisplayTitle(attachment)</strong>
                                            <span class="pf-attachment-card__pill">@ResolveAttachmentStatusPill(attachment)</span>
                                        </div>
                                        <p>@ResolveAttachmentLeadText(attachment)</p>
                                        <small>@ResolveAttachmentDisplaySubtitle(attachment)</small>
                                    </article>
                                }
                            </div>
                        }
                    </section>
                    }

                    @if (IsAssemblyView(AssemblyViewResources))
                    {
                    <section class="cw-panel-card">
                        <p class="cw-panel-kicker">Working set</p>
                        <h3 class="cw-panel-title">Selected project resources</h3>
                        @if (SelectedProjectResources.Count == 0)
                        {
                            <div class="pf-empty">No project resources are selected yet.</div>
                        }
                        else
                        {
                            <div class="pf-scroll-panel">
                                <div class="cw-list">
                                    @foreach (var resource in SelectedProjectResources)
                                    {
                                        <div class="cw-list-item">
                                            <strong>@resource.Name</strong>
                                            <span>@ResolveResourceListSummary(resource)</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </section>

                    <section class="cw-panel-card pf-wide-card">
                        <div class="pf-card-header">
                            <div class="pf-card-header__copy">
                                <p class="cw-panel-kicker">Project resources</p>
                                <h3 class="cw-panel-title">Searchable resource selection</h3>
                                <p class="cw-panel-copy">The resource picker is bounded by an internal scroll region, so large projects stop stretching the entire page.</p>

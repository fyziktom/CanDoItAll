                *@
            </Supporting>
        </CanvasWorkbenchStage>
    }
</div>

@if (showPromptPreviewDialog)
{
    <div class="pf-prompt-modal-backdrop" @onclick="ClosePromptPreviewDialogAsync">
        <div class="pf-prompt-modal"
             role="dialog"
             aria-modal="true"
             aria-label="Built prompt preview"
             data-testid="prompt-factory-prompt-modal"
             @onclick:stopPropagation="true">

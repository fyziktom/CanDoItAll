                            <div class="pf-scroll-panel">
                                <div class="cw-list">
                                    @foreach (var warning in editor.Warnings)
                                    {
                                        <div class="cw-list-item">
                                            <strong>Warning</strong>
                                            <span>@warning</span>
                                        </div>

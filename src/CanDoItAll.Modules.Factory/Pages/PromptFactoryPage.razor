@page "/prompt-factory"
@* codex-capsule
kind: page
name: PromptFactoryPage
summary: Builds prompt sessions from projects, flow templates, shared blocks, and provider settings through a canvas-first workbench.
owns: prompt-session-canvas, prompt-node-inspector, prompt-preview
deps: PromptFactoryService, ProjectsService, ResourcesService, WorkspaceService
risks: missing-project-context, stale-run-routing, unsaved-node-edits
tests: component:PromptFactoryPageTests, e2e:prompt-factory-smoke
*@
@using CanDoItAll.Components.CanvasLib
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.OverlayLib
@using CanDoItAll.Modules.Factory.CanvasAdapters
@using CanDoItAll.Modules.Factory.Pages.Components
@using CanDoItAll.Modules.Projects
@using CanDoItAll.Modules.Resources
@using CanDoItAll.Modules.Workspace
@using CanDoItAll.SharedKernel
@inject PromptFactoryService PromptFactoryService
@inject ProjectsService ProjectsService
@inject ResourcesService ResourcesService
@inject WorkspaceService WorkspaceService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject NotificationService NotificationService

<PageTitle>Prompt Factory</PageTitle>

<div class="space-y-6">
    <PageHeader Eyebrow="Prompt Factory"
                Title="Prompt session workbench"
                Compact="true" />

    @if (canvasSurface is not null)
    {
        <PromptFactorySupportLaneTabs Items="SupportLaneTabs"
                                      SelectedKey="supportLaneTab"
                                      SelectedKeyChanged="SetSupportLaneTabAsync"
                                      Title="@ResolveSupportLaneTitle()"
                                      Description="@ResolveSupportLaneDescription()" />

        @if (IsSupportLaneTab(SupportLaneTabCanvas))
        {
            <div class="pf-workbench-shell is-canvas-mode"
                 id="@($"{SupportLaneTabCanvas}-panel")"
                 role="tabpanel"
                 aria-labelledby="@($"{SupportLaneTabCanvas}-tab")">
            <CanvasWorkbenchStage Eyebrow="Prompt flow canvas"
                                  Title="@ResolveStageTitle()"
                                  Stats="stageStats">
            <HeaderActions>
                <HelpPopover RootClass="pf-help-popover pf-help-popover--header"
                             AriaLabel="Show canvas stage help"
                             Title="Show canvas stage help"
                             Heading="Canvas stage"
                             Body="@ResolveCanvasHeaderHelpBody()"
                             Tip="@ResolveCanvasHeaderHelpTip()" />
            </HeaderActions>
            <Canvas>
                <CanvasWorkbench Surface="canvasSurface"
                                 @ref="workbenchRef"
                                 SelectionChanged="HandleCanvasSelectionChangedAsync"
                                 NodesMoved="HandleCanvasNodesMovedAsync"
                                 ContextActionRequested="HandleCanvasContextActionAsync"
                                 CreateActionInvoked="HandleCanvasCreateActionAsync"
                                 NodeOpened="HandleCanvasNodeOpenedAsync"
                                 StateChanged="HandleCanvasStateChangedAsync">
                    <ToolbarLeftContent>
                        <PromptFactoryHistoryToolbar CanUndo="CanUndo"
                                                     CanRedo="CanRedo"
                                                     IsToolboxVisible="ComponentsToolboxWindowState.IsVisible"
                                                     Undo="UndoAsync"
                                                     Redo="RedoAsync"
                                                     ToggleToolbox="@(() => ToggleCanvasWindowAsync(ComponentsToolboxWindowKey))" />
                    </ToolbarLeftContent>
                    <OverlayContent>
                        <PromptFactoryRecommendationOverlay Overlay="canvasRecommendationOverlay"
                                                            ApplyRecommendations="ApplyCanvasRecommendationsAsync"
                                                            BuildFlow="BuildCanvasFlowAsync" />

                        @if (ComponentsToolboxWindowState.IsVisible)
                        {
                            <CanvasFloatingWindow WindowId="@ComponentsToolboxWindowKey"
                                                  TestId="prompt-factory-components-toolbox-window"
                                                  AriaLabel="Prompt Factory components toolbox"
                                                  Kicker="Components toolbox"
                                                  Title="Prompt components"
                                                  Summary="Search the shared library, preview component text, and add one block at a time without the old cascading submenu."
                                                  BodyClass="pf-components-toolbox-window__body"
                                                  DefaultPlacement="top-left"
                                                  DefaultWidth="452"
                                                  DefaultHeight="700"
                                                  MinWidth="340"
                                                  MinHeight="320"
                                                  MaxWidth="560"
                                                  MaxHeight="840"
                                                  State="@ComponentsToolboxWindowState"
                                                  StateChanged="HandleComponentsToolboxWindowStateChangedAsync">
                                <OverlayComponentToolbox TestId="prompt-factory-components-toolbox"
                                                         AriaLabel="Prompt Factory components toolbox"
                                                         Class="pf-components-toolbox"
                                                         Eyebrow="Visual Studio style"
                                                         Title="Shared library explorer"
                                                         Summary="Search stays pinned. Sections and groups stay dense. The preview lane follows the Eye trigger instead of opening the old cascading submenu."
                                                         SearchText="@componentToolboxSearchText"
                                                         SearchTextChanged="HandleComponentToolboxSearchChangedAsync"
                                                         SearchPlaceholder="Search components, groups, tags, or stack profiles"
                                                         SearchClass="pf-toolbar__search"
                                                         BodyClass="pf-components-toolbox__body"
                                                         SectionsClass="pf-components-toolbox__sections"
                                                         ItemRowClass="pf-components-toolbox__item-row"
                                                         Sections="@ComponentToolboxSections"
                                                         ItemSelected="HandleComponentToolboxItemSelectedAsync">
                                    <ItemTrailingContent Context="item">
                                        @{
                                            var block = ResolveToolboxBlock(item.ActionId);
                                        }
                                        @if (block is not null)
                                        {
                                            <button type="button"
                                                    class="pf-components-toolbox__preview-toggle"
                                                    title="Preview component text"
                                                    aria-label="@($"Preview {block.Name}")"
                                                    @onmouseenter="@(args => ShowComponentPreviewAsync(block, args))"
                                                    @onmouseleave="HideComponentPreviewAsync"
                                                    @onfocus="@(args => ShowComponentPreviewAsync(block, args))"
                                                    @onblur="HideComponentPreviewAsync">
                                                Eye
                                            </button>
                                        }
                                    </ItemTrailingContent>
                                </OverlayComponentToolbox>

                                    @if (HasComponentPreview && PreviewedComponentBlock is not null && componentPreviewPopover is not null)
                                    {
                                        <div class="cw-context-toolbox__preview pf-components-toolbox__popover"
                                             data-testid="prompt-factory-component-preview-popover"
                                             data-placement="@componentPreviewPopover.Placement"
                                             style="@ComponentPreviewPopoverStyle"
                                             @onmouseenter="@(args => HoldComponentPreviewAsync())"
                                             @onmouseleave="HideComponentPreviewAsync">
                                            <p class="cw-context-toolbox__preview-kicker">Eye preview</p>
                                            <h3 class="cw-context-toolbox__preview-title">@PreviewedComponentBlock.Name</h3>
                                            <p class="cw-context-toolbox__preview-copy">@PreviewedComponentSummary</p>
                                            <div class="cw-context-toolbox__preview-meta">
                                                <span class="cw-context-toolbox__preview-pill">@ResolveLibraryGroupLabel(PreviewedComponentBlock.GroupKey)</span>
                                                <span class="cw-context-toolbox__preview-pill">@PreviewedComponentBlock.BlockKind</span>
                                                <span class="cw-context-toolbox__preview-pill">@(PreviewedComponentBlock.TemplateTokens.Count > 0 ? "Parameterized" : "Static")</span>
                                            </div>
                                            <pre class="pf-components-toolbox__preview-content">@PreviewedComponentContent</pre>
                                        </div>
                                    }
                            </CanvasFloatingWindow>
                        }

                        <section @ref="floatingInspectorPanel"
                                 class="pf-floating-inspector @(isCanvasInspectorMinimized ? "is-minimized" : string.Empty)"
                                 aria-label="Canvas inspector">
                            <div class="pf-floating-inspector__header">
                                <div class="pf-floating-inspector__drag"
                                     @ref="floatingInspectorHandle"
                                     title="Drag inspector">
                                    <p class="cw-panel-kicker">Canvas inspector</p>
                                    <h3 class="cw-panel-title">@ResolveInspectorTitle()</h3>
                                </div>
                                <div class="pf-floating-inspector__actions">
                                    @if (!isCanvasInspectorMinimized)
                                    {
                                        <span class="pf-meta-badge pf-meta-badge--compact">@ResolveActiveWorkflowBadge()</span>
                                        <button type="button"
                                                class="pf-floating-inspector__action"
                                                title="Dock inspector to the right edge"
                                                @onclick="DockCanvasInspectorAsync">
                                            Dock
                                        </button>
                                    }
                                    <button type="button"
                                            class="pf-floating-inspector__action"
                                            title="@(isCanvasInspectorMinimized ? "Show inspector" : "Hide inspector")"
                                            @onclick="ToggleCanvasInspector">
                                        @(isCanvasInspectorMinimized ? "Show" : "Hide")
                                    </button>
                                </div>
                            </div>

                            @if (isCanvasInspectorMinimized)
                            {
                                <button type="button"
                                        class="pf-floating-inspector__restore"
                                        @onclick="ToggleCanvasInspector">
                                    Show selected item
                                </button>
                            }
                            else
                            {
                                <div class="pf-floating-inspector__body @(selectedComponentNode is not null ? "pf-floating-inspector__body--component" : string.Empty)">
                @if (selectedComponentNode is null && selectedComponentGroupNode is null)
                {
                    <div class="cw-panel-card pf-inspector-context">
                        <div class="pf-card-header pf-card-header--tight">
                            <div class="pf-card-header__copy">
                                <p class="cw-panel-kicker">Canvas inspector</p>
                                <h3 class="cw-panel-title">@ResolveInspectorTitle()</h3>
                                <p class="cw-panel-copy">@ResolveInspectorCopy()</p>
                            </div>
                            <span class="pf-meta-badge">@ResolveActiveWorkflowBadge()</span>
                        </div>
                        <div class="cw-chip-row">
                            <span class="cw-node__chip tone-accent">@ResolveInspectorSelectionPill()</span>
                            <span class="cw-node__chip">Use page tabs for setup, governance, assembly, and review</span>
                        </div>
                    </div>
                }

                @if (selectedCanvasNodeIds.Count > 1)
                {
                    <div class="pf-inspector-stack">
                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Multi-select</p>
                            <h3 class="cw-panel-title">@($"{selectedCanvasNodeIds.Count} flow elements selected")</h3>
                            <p class="cw-panel-copy">Use the canvas to batch-move the current set. Inspector actions stay intentionally conservative so prompt-state mutations remain explicit.</p>
                            <div class="cw-button-row">
                                <PromptFactoryActionButton Tone="ghost"
                                                           Text="Clear selection"
                                                           Click="ClearCanvasSelectionAsync" />
                                <PromptFactoryActionButton Tone="accent"
                                                           Text="Focus session"
                                                           Click="SelectRootNodeAsync" />
                            </div>
                        </div>

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Selected items</p>
                            <div class="cw-list">
                                @foreach (var label in ResolveSelectedCanvasLabels())
                                {
                                    <div class="cw-list-item">
                                        <strong>@label.Title</strong>
                                        <span>@label.Subtitle</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                else if (selectedBlueprintNode is not null)
                {
                    <div class="pf-inspector-stack">
                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Blueprint</p>
                            <h3 class="cw-panel-title">@selectedBlueprintNode.Name</h3>
                            <p class="cw-panel-copy">@selectedBlueprintNode.Guidance</p>
                            <div class="cw-chip-row">
                                <span class="cw-node__chip tone-accent">@selectedBlueprintNode.PromptType</span>
                                @if (!string.IsNullOrWhiteSpace(selectedBlueprintNode.RecommendedFlowKey))
                                {
                                    <span class="cw-node__chip">Flow: @selectedBlueprintNode.RecommendedFlowKey</span>
                                }
                            </div>
                        </div>

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Selection</p>
                            <div class="cw-button-row">
                                <PromptFactoryActionButton Tone="accent"
                                                           Text="Apply recommendations"
                                                           Click="ApplyRecommendationsAsync" />
                                <PromptFactoryActionButton Tone="ghost"
                                                           Text="Preview selection"
                                                           Click="OpenSelectionPromptPreviewAsync" />
                                <PromptFactoryActionButton Tone="warn"
                                                           Text="Clear blueprint"
                                                           Click="@(() => HandleCanvasActionAsync("clear:blueprint", selectedCanvasNodeId))" />
                            </div>
                        </div>
                    </div>
                }
                else if (selectedFlowNode is not null)
                {
                    <div class="pf-inspector-stack">
                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Flow template</p>
                            <h3 class="cw-panel-title">@selectedFlowNode.Name</h3>
                            <p class="cw-panel-copy">@selectedFlowNode.Summary</p>
                            <div class="cw-chip-row">
                                <span class="cw-node__chip tone-accent">@selectedFlowNode.AgentSequence.Count agent step(s)</span>
                                <span class="cw-node__chip">@selectedFlowNode.BlockKeys.Count block(s)</span>
                            </div>
                        </div>

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Selection</p>
                            <div class="cw-button-row">
                                <PromptFactoryActionButton Tone="mint"
                                                           Text="Build prompt"
                                                           Click="BuildAsync" />
                                <PromptFactoryActionButton Tone="ghost"
                                                           Text="Preview selection"
                                                           Click="OpenSelectionPromptPreviewAsync" />
                                <PromptFactoryActionButton Tone="warn"
                                                           Text="Clear flow"
                                                           Click="@(() => HandleCanvasActionAsync("clear:flow", selectedCanvasNodeId))" />
                            </div>
                        </div>
                    </div>
                }
                else if (selectedComponentNode is not null)
                {
                    var customization = selectedComponentCustomization;
                    <div class="pf-inspector-stack pf-inspector-stack--editor">
                        <div class="cw-panel-card pf-inspector-card--compact">
                            <p class="cw-panel-kicker">Prompt component</p>
                            <h3 class="cw-panel-title">@selectedComponentNode.Name</h3>
                            <p class="cw-panel-copy">@selectedComponentNode.Summary</p>
                            <div class="cw-chip-row pf-chip-row--compact">
                                <span class="cw-node__chip tone-accent">@selectedComponentNode.BlockKind</span>
                                <span class="cw-node__chip">@ResolveLibraryGroupLabel(selectedComponentNode.GroupKey)</span>
                                <span class="cw-node__chip @(SelectedComponentIsModified ? "tone-warn" : "tone-success")">@(SelectedComponentIsModified ? "Session override" : "Template baseline")</span>
                                @if (customization?.TemplateValues.Count > 0)
                                {
                                    <span class="cw-node__chip tone-success">@($"{customization.TemplateValues.Count} specified")</span>
                                }
                            </div>
                        </div>

                        @if (customization?.TemplateValues.Count > 0)
                        {
                            <div class="cw-panel-card">
                                <p class="cw-panel-kicker">Specification</p>
                                <div class="cw-list">
                                    @foreach (var value in customization.TemplateValues)
                                    {
                                        <div class="cw-list-item">
                                            <strong>@value.Key</strong>
                                            <span>@value.Value</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="cw-panel-card pf-component-editor-card">
                            <div class="pf-card-header pf-card-header--tight">
                                <div class="pf-card-header__copy pf-card-header__copy--editor">
                                    <p class="cw-panel-kicker">Session prompt text</p>
                                    <h3 class="cw-panel-title">Effective component content</h3>
                                </div>
                                <span class="pf-accordion-meta pf-accordion-meta--small">@(SelectedComponentIsModified ? "Modified" : "Baseline")</span>
                            </div>
                            <div class="pf-editor-textarea-wrap">
                                <textarea class="cw-textarea pf-component-editor"
                                          @bind="SelectedComponentRenderedContent"></textarea>
                                <button type="button"
                                        class="pf-editor-expand-btn"
                                        title="Open in large editor"
                                        @onclick="OpenComponentEditorModal">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" y1="3" x2="14" y2="10"></line><line x1="3" y1="21" x2="10" y2="14"></line></svg>
                                </button>
                            </div>
                            <div class="cw-button-row pf-button-row--compact">
                                <button type="button" class="cw-button pf-button--compact" data-tone="ghost" @onclick="OpenSelectionPromptPreviewAsync">Preview</button>
                                <button type="button"
                                        class="cw-button pf-button--compact"
                                        data-tone="accent"
                                        disabled="@(!SelectedComponentIsModified)"
                                        @onclick="ResetSelectedComponentRenderedContent">Reset</button>
                                <button type="button" class="cw-button pf-button--compact" data-tone="warn" @onclick="@(() => HandleCanvasActionAsync($"component:remove:{selectedComponentNode.Key}", selectedCanvasNodeId))">Remove</button>
                            </div>
                        </div>
                    </div>
                }
                else if (selectedComponentGroupNode is not null)
                {
                    <div class="pf-inspector-stack">
                        <div class="cw-panel-card pf-inspector-card--compact">
                            <p class="cw-panel-kicker">Component group</p>
                            <h3 class="cw-panel-title">@selectedComponentGroupNode.Name</h3>
                            <p class="cw-panel-copy">@selectedComponentGroupNode.Purpose</p>
                            <div class="cw-chip-row pf-chip-row--compact">
                                <span class="cw-node__chip tone-accent">@($"{selectedComponentGroupNode.Components.Count(item => editor.SelectedBlockIds.Contains(item.Id))} selected")</span>
                            </div>
                        </div>

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Selected components</p>
                            <div class="cw-list">
                                @foreach (var component in selectedComponentGroupNode.Components.Where(item => editor.SelectedBlockIds.Contains(item.Id)).OrderBy(item => item.OrderIndex))
                                {
                                    <div class="cw-list-item">
                                        <strong>@component.Name</strong>
                                        <span>@component.BlockKind</span>
                                    </div>
                                }
                            </div>
                            <div class="cw-button-row">
                                <button type="button" class="cw-button" data-tone="ghost" @onclick="OpenSelectionPromptPreviewAsync">Preview selection</button>
                            </div>
                        </div>
                    </div>
                }
                else if (selectedSetupNode is not null)
                {
                    <div class="pf-inspector-stack">
                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Session setup</p>
                            <h3 class="cw-panel-title">First-step wizard</h3>
                            <p class="cw-panel-copy">@ResolveSetupLeadCopy()</p>
                            <div class="cw-chip-row">
                                <span class="cw-node__chip tone-accent">@ResolveSetupStatusLabel()</span>
                                <span class="cw-node__chip">@ResolveSetupSummaryLine()</span>
                            </div>
                        </div>

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Selected node details</p>
                            <div class="cw-list">
                                <div class="cw-list-item">
                                    <strong>Intent</strong>
                                    <span>@(string.IsNullOrWhiteSpace(sessionSetup.IntentCategory) ? "Not set" : sessionSetup.IntentCategory)</span>
                                </div>
                                <div class="cw-list-item">
                                    <strong>Main language</strong>
                                    <span>@(string.IsNullOrWhiteSpace(sessionSetup.MainLanguage) ? "Not set" : sessionSetup.MainLanguage)</span>
                                </div>
                                <div class="cw-list-item">
                                    <strong>Application state</strong>
                                    <span>@(string.IsNullOrWhiteSpace(sessionSetup.ApplicationState) ? "Not set" : sessionSetup.ApplicationState)</span>
                                </div>
                                <div class="cw-list-item">
                                    <strong>Work repository</strong>
                                    <span>@(string.IsNullOrWhiteSpace(sessionSetup.WorkRepository) ? "Missing" : sessionSetup.WorkRepository)</span>
                                </div>
                            </div>
                            <div class="cw-button-row">
                                <PromptFactoryActionButton Tone="accent"
                                                           Text="Open Setup tab"
                                                           Click="@(() => SetSupportLaneTabAsync(SupportLaneTabSetup))" />
                                <PromptFactoryActionButton Tone="primary"
                                                           Text="Save setup"
                                                           Click="SaveSetupProfileAsync" />
                                <PromptFactoryActionButton Tone="ghost"
                                                           Text="Preview selection"
                                                           Click="OpenSelectionPromptPreviewAsync" />
                                <PromptFactoryActionButton Tone="ghost"
                                                           Text="Focus session"
                                                           Click="SelectRootNodeAsync" />
                            </div>
                        </div>
                    </div>
                }
                else if (selectedAttachmentNode is not null)
                {
                    <div class="pf-inspector-stack">
                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Prompt input</p>
                            <h3 class="cw-panel-title">@selectedAttachmentNode.Title</h3>
                            <p class="cw-panel-copy">@ResolveAttachmentLeadText(selectedAttachmentNode)</p>
                            <div class="cw-chip-row">
                                <span class="cw-node__chip tone-accent">@selectedAttachmentNode.Kind</span>
                                @if (!string.IsNullOrWhiteSpace(selectedAttachmentNode.MediaOriginalFileName))
                                {
                                    <span class="cw-node__chip">@selectedAttachmentNode.MediaOriginalFileName</span>
                                }
                            </div>
                        </div>

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Selection</p>
                            <div class="cw-button-row">
                                <PromptFactoryActionButton Tone="ghost"
                                                           Text="Preview selection"
                                                           Click="OpenSelectionPromptPreviewAsync" />
                                <PromptFactoryActionButton Tone="warn"
                                                           Text="Remove input"
                                                           Click="@(() => HandleCanvasActionAsync($"input:remove:{selectedAttachmentNode.Id}", selectedCanvasNodeId))" />
                            </div>
                        </div>
                    </div>
                }
                else if (selectedPromptNode is not null)
                {
                    <div class="pf-inspector-stack">
                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Prompt step</p>
                            <h3 class="cw-panel-title">@selectedPromptNode.Title</h3>
                            <p class="cw-panel-copy">@selectedPromptNode.BranchLabel Â· step @selectedPromptNode.Sequence</p>
                            <div class="cw-chip-row">
                                <span class="cw-node__chip tone-accent">@selectedPromptNode.State</span>
                                @if (selectedPromptNode.ParentNodeId.HasValue)
                                {
                                    <span class="cw-node__chip">Derived branch</span>
                                }
                                @if (selectedPromptNode.PromptArtifactId.HasValue)
                                {
                                    <span class="cw-node__chip tone-success">Artifact linked</span>
                                }
                            </div>
                        </div>

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Editor</p>
                            <div class="cw-form-grid">
                                <div class="cw-form-field">
                                    <label>Title</label>
                                    <input class="cw-text-input" @bind="selectedPromptNodeTitle" />
                                </div>
                                <div class="cw-form-field">
                                    <label>State</label>
                                    <select class="cw-select" @bind="selectedPromptNodeState">
                                        @foreach (var state in Enum.GetValues<PromptRunNodeState>())
                                        {
                                            <option value="@state">@state</option>
                                        }
                                    </select>
                                </div>
                                <div class="cw-form-field">
                                    <label>Notes</label>
                                    <textarea class="cw-textarea" @bind="selectedPromptNodeNotes"></textarea>
                                </div>
                            </div>

                            <div class="cw-button-row">
                                <PromptFactoryActionButton Tone="primary"
                                                           Text="Save step"
                                                           Click="SaveSelectedPromptNodeAsync" />
                                <PromptFactoryActionButton Tone="accent"
                                                           Text="Branch"
                                                           Click="@(() => BranchAsync(selectedPromptNode.Id))" />
                                <PromptFactoryActionButton Tone="ghost"
                                                           Text="Preview selection"
                                                           Click="OpenSelectionPromptPreviewAsync" />
                                <PromptFactoryActionButton Tone="mint"
                                                           Text="Mark used"
                                                           Click="@(() => SetPromptNodeStateAsync(selectedPromptNode.Id, PromptRunNodeState.Used))" />
                                <PromptFactoryActionButton Tone="mint"
                                                           Text="Validate"
                                                           Click="@(() => SetPromptNodeStateAsync(selectedPromptNode.Id, PromptRunNodeState.Validated))" />
                                <PromptFactoryActionButton Tone="warn"
                                                           Text="Skip"
                                                           Click="@(() => SetPromptNodeStateAsync(selectedPromptNode.Id, PromptRunNodeState.Skipped))" />
                                @if (selectedPromptNode.PromptArtifactId.HasValue)
                                {
                                    <PromptFactoryActionButton Tone="ghost"
                                                               Text="Open prompt"
                                                               Click="@(() => OpenPromptArtifact(selectedPromptNode.PromptArtifactId.Value))" />
                                }
                            </div>
                        </div>
                    </div>
                }
                else if (selectedBranchLabel is not null)
                {
                    <div class="pf-inspector-stack">
                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Branch</p>
                            <h3 class="cw-panel-title">@selectedBranchLabel</h3>
                            <p class="cw-panel-copy">@($"{selectedBranchNodes.Count} step(s) in this branch")</p>
                            <div class="cw-button-row">
                                <PromptFactoryActionButton Tone="accent"
                                                           Text="Build prompt"
                                                           Click="BuildAsync" />
                                <PromptFactoryActionButton Tone="ghost"
                                                           Text="Preview selection"
                                                           Click="OpenSelectionPromptPreviewAsync" />
                                <PromptFactoryActionButton Tone="ghost"
                                                           Text="Focus session"
                                                           Click="SelectRootNodeAsync" />
                            </div>
                        </div>

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Branch steps</p>
                            <div class="cw-list">
                                @foreach (var node in selectedBranchNodes)
                                {
                                    <button type="button" class="cw-list-item" @onclick="@(() => SelectPromptCanvasNodeAsync(node.Id))">
                                        <strong>@node.Title</strong>
                                        <span>@node.State Â· step @node.Sequence</span>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="pf-inspector-stack">
                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Session root</p>
                            <h3 class="cw-panel-title">@(!string.IsNullOrWhiteSpace(editor.SessionName) ? editor.SessionName : "Prompt session")</h3>
                            <p class="cw-panel-copy">@ResolveSessionInspectorCopy()</p>
                            <div class="cw-chip-row">
                                <span class="cw-node__chip tone-accent">@wizardSteps[CurrentWizardStep]</span>
                                <span class="cw-node__chip">@ResolveWizardStepMeta(CurrentWizardStep)</span>
                            </div>
                        </div>

                        <div class="cw-panel-card">
                            <p class="cw-panel-kicker">Quick actions</p>
                            <CompactStatStrip>
                                <CompactStat Text="@($"Setup {ResolveSetupStatusLabel()}")"
                                             Tone="info"
                                             TooltipText="@($"Setup status: {ResolveSetupStatusLabel()}")" />
                                <CompactStat Label="components"
                                             Value="@editor.SelectedBlockIds.Count.ToString()"
                                             Tone="success"
                                             TooltipText="@($"{editor.SelectedBlockIds.Count} selected prompt components.")" />
                                <CompactStat Label="inputs"
                                             Value="@VisibleSessionAttachments.Count.ToString()"
                                             TooltipText="@($"{VisibleSessionAttachments.Count} visible session inputs.")" />
                                <CompactStat Label="warnings"
                                             Value="@editor.Warnings.Count.ToString()"
                                             Tone="warning"
                                             TooltipText="@($"{editor.Warnings.Count} warnings need review.")" />
                            </CompactStatStrip>
                            <div class="cw-button-row">
                                <PromptFactoryActionButton Tone="accent"
                                                           Text="Open Setup tab"
                                                           Click="@(() => SetSupportLaneTabAsync(SupportLaneTabSetup))" />
                                <PromptFactoryActionButton Tone="ghost"
                                                           Text="Open Governance tab"
                                                           Click="@(() => SetSupportLaneTabAsync(SupportLaneTabGovernance))" />
                                <PromptFactoryActionButton Tone="ghost"
                                                           Text="Open Assembly tab"
                                                           Click="@(() => SetSupportLaneTabAsync(SupportLaneTabAssembly))" />
                                <PromptFactoryActionButton Tone="ghost"
                                                           Text="Open Review tab"
                                                           Click="@(() => SetSupportLaneTabAsync(SupportLaneTabReview))" />
                                <PromptFactoryActionButton Tone="ghost"
                                                           Text="Preview selection"
                                                           Click="OpenSelectionPromptPreviewAsync" />
                                <PromptFactoryActionButton Tone="primary"
                                                           Text="Save session"
                                                           Click="SaveSessionStateAsync" />
                            </div>
                        </div>
                    </div>
                }
                                </div>
                            }
                        </section>
                    </OverlayContent>
                </CanvasWorkbench>
            </Canvas>
            </CanvasWorkbenchStage>

            <div class="mt-5">
                <CanvasBoundaryCard TestHookId="prompt-factory-undo-redo-adapter"
                                           Label="Prompt Factory undo redo adapter"
                                           Title="Prompt editing history now resolves through one domain adapter"
                                           Summary="Canvas selection, inspector tab state, and prompt-session snapshots are captured together so shared history infrastructure can drive toolbar buttons and keyboard shortcuts."
                                           StatePill="@(CanUndo || CanRedo ? "History ready" : "Baseline")"
                                           Metrics="@UndoRedoMetrics">
                    <div class="grid gap-4 lg:grid-cols-[auto_1fr]">
                        <div class="flex items-start gap-3">
                            <button type="button"
                                    class="cw-button"
                                    data-tone="ghost"
                                    disabled="@(!CanUndo)"
                                    @onclick="UndoAsync">
                                Undo
                            </button>
                            <button type="button"
                                    class="cw-button"
                                    data-tone="accent"
                                    disabled="@(!CanRedo)"
                                    @onclick="RedoAsync">
                                Redo
                            </button>
                        </div>
                        <div class="grid gap-3 md:grid-cols-3">
                            <div class="rounded-[1.4rem] border border-slate-200 bg-white/85 px-4 py-4">
                                <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">Session</p>
                                <p class="mt-2 text-sm text-slate-950">@UndoRedoSessionLabel</p>
                            </div>
                            <div class="rounded-[1.4rem] border border-slate-200 bg-white/85 px-4 py-4">
                                <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">Selection</p>
                                <p class="mt-2 text-sm text-slate-950">@UndoRedoSelectionLabel</p>
                            </div>
                            <div class="rounded-[1.4rem] border border-slate-200 bg-white/85 px-4 py-4">
                                <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">Inspector tab</p>
                                <p class="mt-2 text-sm text-slate-950">@activeInspectorTab</p>
                            </div>
                        </div>
                    </div>
                </CanvasBoundaryCard>
            </div>

            <div class="mt-5 grid gap-5 xl:grid-cols-2 2xl:grid-cols-3">
                <ChipBadgePrimitive Snapshot="@ChipBadgePreviewSnapshot" />
                <ConnectorPathPrimitive Snapshot="@ConnectorPathPreviewSnapshot" />
                <ContainerPrimitive Snapshot="@ContainerPreviewSnapshot" />
                <ContextMenuHost Snapshot="@ContextMenuPreviewSnapshot" />
                <CreateActionPalette Snapshot="@CreateActionPalettePreviewSnapshot" />
                <FloatingInspectorHost Snapshot="@FloatingInspectorPreviewSnapshot" />
                <GroupFrameOverlay Snapshot="@GroupFramePreviewSnapshot" />
                <IconGlyphPrimitive Snapshot="@IconGlyphPreviewSnapshot" />
                <ImagePrimitive Snapshot="@ImagePreviewSnapshot" />
                <InlineEditorComposer Snapshot="@InlineEditorPreviewSnapshot" />
                <NodeCardComposer Snapshot="@NodeCardPreviewSnapshot" />
                <TextBlockPrimitive Snapshot="@TextBlockPreviewSnapshot" />
            </div>
            </div>
        }
        else
        {
            <div class="pf-support-tab-shell"
                 id="@($"{supportLaneTab}-panel")"
                 role="tabpanel"
                 aria-labelledby="@($"{supportLaneTab}-tab")">
                @if (IsContextStep)
                {
                    <section class="cw-panel-card pf-step-hero pf-wide-card">
                        <p class="cw-panel-kicker">Setup</p>
                        <h3 class="cw-panel-title">Frame the session before the prompt flow gets busy</h3>
                        <p class="cw-panel-copy">Use this setup lane to define intent, stack, and repositories before the canvas grows into a larger mindmap.</p>
                        <CompactStatStrip>
                            <CompactStat Text="@($"Session {(string.IsNullOrWhiteSpace(editor.SessionName) ? "Untitled" : editor.SessionName)}")"
                                         Tone="info"
                                         TooltipText="@($"Session: {(string.IsNullOrWhiteSpace(editor.SessionName) ? "Untitled session" : editor.SessionName)}")" />
                            <CompactStat Text="@($"Project {ResolveSelectedProjectName()}")"
                                         Tone="success"
                                         TooltipText="@($"Selected project: {ResolveSelectedProjectName()}")" />
                            <CompactStat Text="@($"Blueprint {ResolveSelectedBlueprintName()}")"
                                         TooltipText="@($"Selected blueprint: {ResolveSelectedBlueprintName()}")" />
                            <CompactStat Text="@($"Setup {ResolveSetupStatusLabel()}")"
                                         Tone="warning"
                                         TooltipText="@($"Setup status: {ResolveSetupStatusLabel()}")" />
                        </CompactStatStrip>
                        <div class="cw-button-row">
                            <PromptFactoryActionButton Tone="primary"
                                                       Text="Save setup"
                                                       Click="SaveSetupProfileAsync" />
                            <PromptFactoryActionButton Tone="ghost"
                                                       Text="Open canvas"
                                                       Click="@(() => SetSupportLaneTabAsync(SupportLaneTabCanvas))" />
                            <PromptFactoryActionButton Tone="ghost"
                                                       Text="Continue to governance"
                                                       Click="@(() => SetSupportLaneTabAsync(SupportLaneTabGovernance))" />
                        </div>
                    </section>

                    <section class="cw-panel-card pf-wide-card pf-setup-guide">
                        <div class="pf-card-header">
                            <div class="pf-card-header__copy">
                                <p class="cw-panel-kicker">First-step wizard</p>
                                <h3 class="cw-panel-title">Capture the working frame once, then reopen it from the canvas later</h3>
                                <p class="cw-panel-copy">The same setup is pinned into the prompt map as a dedicated node, so it stays available in normal and maximized canvas modes.</p>
                            </div>
                            <span class="pf-accordion-meta">@ResolveSetupStatusLabel()</span>
                        </div>

                        <div class="pf-two-column">
                            <div class="cw-form-grid">
                                <div class="cw-form-field">
                                    <label>Intent</label>
                                    <select class="cw-select" @bind="sessionSetup.IntentCategory">
                                        <option value="">Select intent</option>
                                        @foreach (var option in SetupIntentOptions)
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    </select>
                                </div>

                                @if (ShowProgrammingLanguageField)
                                {
                                    <div class="cw-form-field">
                                        <label>Main language</label>
                                        <select class="cw-select" @bind="sessionSetup.MainLanguage">
                                            <option value="">Select language</option>
                                            @foreach (var option in SetupProgrammingLanguageOptions)
                                            {
                                                <option value="@option">@option</option>
                                            }
                                        </select>
                                    </div>
                                }

                                <div class="cw-form-field">
                                    <label>Application state</label>
                                    <select class="cw-select" @bind="sessionSetup.ApplicationState">
                                        <option value="">Select state</option>
                                        @foreach (var option in SetupApplicationStateOptions)
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    </select>
                                </div>

                                <div class="cw-form-field">
                                    <label>Work repository</label>
                                    <input class="cw-text-input" @bind="sessionSetup.WorkRepository" placeholder="Main delivery repository" />
                                </div>

                                <div class="cw-form-field">
                                    <label>Info or source repositories</label>
                                    <input class="cw-text-input" @bind="sessionSetup.SourceRepositories" placeholder="Specs, docs, datasets, or supporting repos" />
                                </div>

                                <div class="cw-form-field">
                                    <label>Secondary languages</label>
                                    <input class="cw-text-input" @bind="sessionSetup.SecondaryLanguages" placeholder="Optional supporting languages or stacks" />
                                </div>
                            </div>

                            <div class="pf-section-stack">
                                <article class="pf-group-card">
                                    <strong>Guidance notes</strong>
                                    <textarea class="cw-textarea" @bind="sessionSetup.GuidanceNotes" placeholder="Explain what the AI should optimize for in this session."></textarea>
                                </article>

                                <article class="pf-group-card">
                                    <strong>Project snapshot</strong>
                                    <textarea class="cw-textarea" @bind="sessionSetup.ProjectSnapshot"></textarea>
                                </article>

                                <article class="pf-group-card">
                                    <strong>Why this matters</strong>
                                    <div class="pf-next-list">
                                        <div class="pf-next-step">Programming sessions can ask for the main language only when it matters.</div>
                                        <div class="pf-next-step">Repositories and source references keep the AI anchored to the real delivery context.</div>
                                        <div class="pf-next-step">The setup node remains available later, so re-framing does not require leaving the canvas.</div>
                                    </div>
                                </article>
                            </div>
                        </div>

                        <div class="cw-button-row">
                            <PromptFactoryActionButton Tone="primary"
                                                       Text="Save setup"
                                                       Click="SaveSetupProfileAsync" />
                            <PromptFactoryActionButton Tone="ghost"
                                                       Text="Focus setup node"
                                                       Click="@(() => SelectSetupNodeAsync())" />
                            <PromptFactoryActionButton Tone="accent"
                                                       Text="Continue to governance"
                                                       Click="@(() => SetSupportLaneTabAsync(SupportLaneTabGovernance))" />
                        </div>
                    </section>

                    <section class="cw-panel-card pf-wide-card pf-workspace-card">
                        <div class="pf-card-header">
                            <div class="pf-card-header__copy">
                                <p class="cw-panel-kicker">Context workspace</p>
                                <h3 class="cw-panel-title">Use one support view at a time</h3>
                                <p class="cw-panel-copy">@ResolveContextWorkspaceSummary()</p>
                            </div>
                            <div class="pf-tab-strip" role="tablist" aria-label="Context workspace views">
                                <button type="button"
                                        role="tab"
                                        aria-selected="@(IsContextView(ContextViewOverview) ? "true" : "false")"
                                        class="pf-tab-button @(IsContextView(ContextViewOverview) ? "is-active" : string.Empty)"
                                        @onclick="() => SetContextWorkspaceView(ContextViewOverview)">
                                    Overview
                                </button>
                                <button type="button"
                                        role="tab"
                                        aria-selected="@(IsContextView(ContextViewLibrary) ? "true" : "false")"
                                        class="pf-tab-button @(IsContextView(ContextViewLibrary) ? "is-active" : string.Empty)"
                                        @onclick="() => SetContextWorkspaceView(ContextViewLibrary)">
                                    Library
                                </button>
                                <button type="button"
                                        role="tab"
                                        aria-selected="@(IsContextView(ContextViewStarters) ? "true" : "false")"
                                        class="pf-tab-button @(IsContextView(ContextViewStarters) ? "is-active" : string.Empty)"
                                        @onclick="() => SetContextWorkspaceView(ContextViewStarters)">
                                    Starters
                                </button>
                            </div>
                        </div>

                        @if (IsContextView(ContextViewOverview))
                        {
                            <div class="pf-two-column">
                                <div class="pf-section-stack">
                                    <article class="pf-group-card">
                                        <strong>Current working frame</strong>
                                        <CompactStatStrip>
                                            <CompactStat Text="@($"Provider {ResolveSelectedProviderName()}")"
                                                         Tone="info"
                                                         TooltipText="@($"Selected provider: {ResolveSelectedProviderName()}")" />
                                            <CompactStat Text="@($"Phase {(string.IsNullOrWhiteSpace(editor.Phase) ? "Not set" : editor.Phase)}")"
                                                         TooltipText="@($"Phase: {(string.IsNullOrWhiteSpace(editor.Phase) ? "Not set" : editor.Phase)}")" />
                                            <CompactStat Label="inputs"
                                                         Value="@VisibleSessionAttachments.Count.ToString()"
                                                         Tone="success"
                                                         TooltipText="@($"{VisibleSessionAttachments.Count} visible session inputs.")" />
                                            <CompactStat Label="warnings"
                                                         Value="@editor.Warnings.Count.ToString()"
                                                         Tone="warning"
                                                         TooltipText="@($"{editor.Warnings.Count} warnings need review.")" />
                                        </CompactStatStrip>
                                        <small>Pick blueprint and flow from the canvas or inspector first. Resource assembly and detailed governance move to later steps so the page stays short while the user is still orienting.</small>
                                    </article>

                                    <article class="pf-group-card">
                                        <strong>Prompt library pack</strong>
                                        <p>@($"{libraryCatalog.ComponentCount} components, {libraryCatalog.FlowCount} flows, and {libraryCatalog.BlueprintCount} blueprints are available to the wizard.")</p>
                                        <div class="cw-chip-row">
                                            <span class="cw-node__chip">@($"{OrderedLibraryGroups.Count} groups")</span>
                                            <span class="cw-node__chip">Grouped canvas menu</span>
                                            <span class="cw-node__chip">Prompt-library import active</span>
                                        </div>
                                    </article>
                                </div>

                                <div class="pf-section-stack">
                                    <article class="pf-group-card">
                                        <strong>Recommended next moves</strong>
                                        <div class="pf-next-list">
                                            <div class="pf-next-step">Confirm the project and provider in the inspector so the session has a delivery frame.</div>
                                            <div class="pf-next-step">Open <strong>Starters</strong> to apply a blueprint or flow directly instead of browsing long dropdowns.</div>
                                            <div class="pf-next-step">Continue to <strong>Governance</strong> only after the base prompt shape is set.</div>
                                        </div>
                                        <div class="cw-button-row">
                                            <PromptFactoryActionButton Tone="accent"
                                                                       Text="Open starters"
                                                                       Click="@(() => SetContextWorkspaceView(ContextViewStarters))" />
                                            <PromptFactoryActionButton Tone="ghost"
                                                                       Text="Open library"
                                                                       Click="@(() => SetContextWorkspaceView(ContextViewLibrary))" />
                                            <PromptFactoryActionButton Tone="ghost"
                                                                       Text="Go to governance"
                                                                       Click="@(() => SetSupportLaneTabAsync(SupportLaneTabGovernance))" />
                                        </div>
                                    </article>

                                    <article class="pf-group-card">
                                        <strong>Current selection path</strong>
                                        <p>The support lane now mirrors the active context in one glance instead of repeating every form below the canvas.</p>
                                        <div class="cw-chip-row">
                                            <span class="cw-node__chip">@($"Project: {ResolveSelectedProjectName()}")</span>
                                            <span class="cw-node__chip">@($"Blueprint: {ResolveSelectedBlueprintName()}")</span>
                                            <span class="cw-node__chip">@($"Flow: {ResolveSelectedFlowName()}")</span>
                                            <span class="cw-node__chip">@($"Provider: {ResolveSelectedProviderName()}")</span>
                                        </div>
                                    </article>
                                </div>
                            </div>
                        }
                        else if (IsContextView(ContextViewLibrary))
                        {
                            <div class="pf-toolbar">
                                <input class="cw-text-input pf-toolbar__search"
                                       placeholder="Search prompt library groups"
                                       @bind="catalogSearchText"
                                       @bind:event="oninput" />
                                <span class="pf-accordion-meta">@($"{FilteredLibraryGroups.Count} groups")</span>
                            </div>
                            @if (FilteredLibraryGroups.Count == 0)
                            {
                                <div class="pf-empty">No prompt-library groups match the current search.</div>
                            }
                            else
                            {
                                <div class="pf-scroll-panel pf-scroll-panel--tall">
                                    <div class="pf-group-grid">
                                        @foreach (var group in FilteredLibraryGroups)
                                        {
                                            <article class="pf-group-card">
                                                <strong>@group.Name</strong>
                                                <p>@group.Summary</p>
                                                <small>@group.Purpose</small>
                                                <div class="cw-chip-row">
                                                    <span class="cw-node__chip">@($"{group.ComponentCount} components")</span>
                                                    <span class="cw-node__chip">@group.UiMode</span>
                                                    <span class="cw-node__chip">@group.Key</span>
                                                </div>
                                            </article>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else if (IsContextView(ContextViewStarters))
                        {
                            <div class="pf-toolbar">
                                <input class="cw-text-input pf-toolbar__search"
                                       placeholder="Search blueprints and flows"
                                       @bind="starterSearchText"
                                       @bind:event="oninput" />
                                <span class="pf-accordion-meta">@($"{FilteredBlueprintStarters.Count} blueprints | {FilteredFlowStarters.Count} flows")</span>
                            </div>

                            <div class="pf-two-column">
                                <div class="pf-section-stack">
                                    <div class="pf-card-header">
                                        <div class="pf-card-header__copy">
                                            <p class="cw-panel-kicker">Blueprint starters</p>
                                            <h3 class="cw-panel-title">Apply a blueprint directly</h3>
                                            <p class="cw-panel-copy">Use starters to set the base prompt type without leaving the current page context.</p>
                                        </div>
                                    </div>
                                    @if (FilteredBlueprintStarters.Count == 0)
                                    {
                                        <div class="pf-empty">No blueprints match the current search.</div>
                                    }
                                    else
                                    {
                                        <div class="pf-scroll-panel pf-scroll-panel--tall">
                                            <div class="pf-select-stack">
                                                @foreach (var blueprint in FilteredBlueprintStarters)
                                                {
                                                    <article class="pf-action-card @(editor.BlueprintId == blueprint.Id ? "is-selected" : string.Empty)">
                                                        <div class="pf-action-card__header">
                                                            <div class="pf-action-card__body">
                                                                <strong>@blueprint.Name</strong>
                                                                <span>@blueprint.Summary</span>
                                                            </div>
                                                            <span class="pf-accordion-meta">@(editor.BlueprintId == blueprint.Id ? "Selected" : blueprint.PromptType)</span>
                                                        </div>
                                                        <div class="cw-chip-row">
                                                            <span class="cw-node__chip">@blueprint.Key</span>
                                                            <span class="cw-node__chip">@blueprint.PromptType</span>
                                                            @if (blueprint.RecommendedFlowTemplateId.HasValue)
                                                            {
                                                                <span class="cw-node__chip">Loads recommended flow</span>
                                                            }
                                                        </div>
                                                        <div class="cw-button-row">
                                                            @if (editor.BlueprintId == blueprint.Id)
                                                            {
                                                                <PromptFactoryActionButton Tone="ghost"
                                                                                           Text="Selected"
                                                                                           Disabled="true" />
                                                            }
                                                            else
                                                            {
                                                                <PromptFactoryActionButton Tone="accent"
                                                                                           Text="Use blueprint"
                                                                                           Click="@(() => SelectBlueprintByKeyAsync(blueprint.Key))" />
                                                            }
                                                        </div>
                                                    </article>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="pf-section-stack">
                                    <div class="pf-card-header">
                                        <div class="pf-card-header__copy">
                                            <p class="cw-panel-kicker">Flow starters</p>
                                            <h3 class="cw-panel-title">Load a flow without hunting in the inspector</h3>
                                            <p class="cw-panel-copy">Starter flows front-load the most common delivery patterns and immediately load their block sets.</p>
                                        </div>
                                    </div>
                                    @if (FilteredFlowStarters.Count == 0)
                                    {
                                        <div class="pf-empty">No flow templates match the current search.</div>
                                    }
                                    else
                                    {
                                        <div class="pf-scroll-panel pf-scroll-panel--tall">
                                            <div class="pf-select-stack">
                                                @foreach (var template in FilteredFlowStarters)
                                                {
                                                    <article class="pf-action-card @(editor.FlowTemplateId == template.Id ? "is-selected" : string.Empty)">
                                                        <div class="pf-action-card__header">
                                                            <div class="pf-action-card__body">
                                                                <strong>@template.Name</strong>
                                                                <span>@($"{template.BlockIds.Count} blocks | {template.AgentSequence.Count} agents")</span>
                                                                <small>@($"{string.Join(" -> ", template.AgentSequence.Select(agent => agent.Phase).Take(4))}{(template.AgentSequence.Count > 4 ? " -> ..." : string.Empty)}")</small>
                                                            </div>
                                                            <span class="pf-accordion-meta">@(editor.FlowTemplateId == template.Id ? "Selected" : "Starter")</span>
                                                        </div>
                                                        <div class="cw-chip-row">
                                                            <span class="cw-node__chip">@template.Key</span>
                                                            <span class="cw-node__chip">@($"{template.BlockIds.Count} blocks")</span>
                                                            <span class="cw-node__chip">@($"{template.AgentSequence.Count} agents")</span>
                                                        </div>
                                                        <div class="cw-button-row">
                                                            @if (editor.FlowTemplateId == template.Id)
                                                            {
                                                                <PromptFactoryActionButton Tone="ghost"
                                                                                           Text="Selected"
                                                                                           Disabled="true" />
                                                            }
                                                            else
                                                            {
                                                                <PromptFactoryActionButton Tone="accent"
                                                                                           Text="Use flow"
                                                                                           Click="@(() => SelectFlowByKeyAsync(template.Key))" />
                                                            }
                                                        </div>
                                                    </article>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </section>
                }
                else if (IsGovernanceStep)
                {
                    <section class="cw-panel-card pf-step-hero pf-wide-card">
                        <p class="cw-panel-kicker">Governance</p>
                        <h3 class="cw-panel-title">Curate reusable blocks without drowning in a single list</h3>
                        <p class="cw-panel-copy">The old screen forced every component, editor form, and template checklist onto one page. This version keeps selection fast, shows the current working set, and moves block authoring behind explicit admin toggles.</p>
                        <CompactStatStrip>
                            <CompactStat Label="selected blocks"
                                         Value="@editor.SelectedBlockIds.Count.ToString()"
                                         Tone="success"
                                         TooltipText="@($"{editor.SelectedBlockIds.Count} selected reusable blocks.")" />
                            <CompactStat Label="available blocks"
                                         Value="@blocks.Count.ToString()"
                                         Tone="info"
                                         TooltipText="@($"{blocks.Count} library blocks are available.")" />
                            <CompactStat Label="groups"
                                         Value="@OrderedLibraryGroups.Count.ToString()"
                                         TooltipText="@($"{OrderedLibraryGroups.Count} library groups are available.")" />
                            <CompactStat Text="@(editor.HasCustomizedBlocks ? "Mode Customized session" : "Mode Library defaults")"
                                         Tone="warning"
                                         TooltipText="@(editor.HasCustomizedBlocks ? "This session has customized block choices." : "This session currently uses library defaults.")" />
                        </CompactStatStrip>
                        <div class="cw-button-row">
                            <PromptFactoryActionButton Tone="accent"
                                                       Text="Apply recommendations"
                                                       Click="ApplyRecommendationsAsync" />
                            <PromptFactoryActionButton Tone="primary"
                                                       Text="Save session state"
                                                       Click="SaveSessionStateAsync" />
                            <PromptFactoryActionButton Tone="ghost"
                                                       Text="New block"
                                                       Click="CreateNewBlock" />
                        </div>
                    </section>

                    <section class="cw-panel-card pf-wide-card pf-workspace-card">
                        <div class="pf-card-header">
                            <div class="pf-card-header__copy">
                                <p class="cw-panel-kicker">Governance workspace</p>
                                <h3 class="cw-panel-title">Keep one governance view open at a time</h3>
                                <p class="cw-panel-copy">@ResolveGovernanceWorkspaceSummary()</p>
                            </div>
                            <div class="pf-tab-strip" role="tablist" aria-label="Governance workspace views">
                                <button type="button"
                                        role="tab"
                                        aria-selected="@(IsGovernanceView(GovernanceViewSelection) ? "true" : "false")"
                                        class="pf-tab-button @(IsGovernanceView(GovernanceViewSelection) ? "is-active" : string.Empty)"
                                        @onclick="@(() => SetGovernanceWorkspaceView(GovernanceViewSelection))">
                                    Selection
                                </button>
                                <button type="button"
                                        role="tab"
                                        aria-selected="@(IsGovernanceView(GovernanceViewLibrary) ? "true" : "false")"
                                        class="pf-tab-button @(IsGovernanceView(GovernanceViewLibrary) ? "is-active" : string.Empty)"
                                        @onclick="@(() => SetGovernanceWorkspaceView(GovernanceViewLibrary))">
                                    Library
                                </button>
                                <button type="button"
                                        role="tab"
                                        aria-selected="@(IsGovernanceView(GovernanceViewBlocks) ? "true" : "false")"
                                        class="pf-tab-button @(IsGovernanceView(GovernanceViewBlocks) ? "is-active" : string.Empty)"
                                        @onclick="@(() => SetGovernanceWorkspaceView(GovernanceViewBlocks))">
                                    Block editor
                                </button>
                                <button type="button"
                                        role="tab"
                                        aria-selected="@(IsGovernanceView(GovernanceViewTemplates) ? "true" : "false")"
                                        class="pf-tab-button @(IsGovernanceView(GovernanceViewTemplates) ? "is-active" : string.Empty)"
                                        @onclick="@(() => SetGovernanceWorkspaceView(GovernanceViewTemplates))">
                                    Templates
                                </button>
                            </div>
                        </div>
                    </section>

                    @if (IsGovernanceView(GovernanceViewSelection))
                    {
                    <section class="cw-panel-card">
                        <p class="cw-panel-kicker">Selection filters</p>
                        <h3 class="cw-panel-title">Search and narrow the working set</h3>
                        <div class="pf-toolbar">
                            <input class="cw-text-input pf-toolbar__search" @bind="blockSearchText" placeholder="Search blocks, tags, or template tokens" />
                            <label class="pf-toggle">
                                <input type="checkbox" @bind="showSelectedBlocksOnly" />
                                <span>Selected only</span>
                            </label>
                        </div>
                        <p class="cw-panel-copy">Grouped accordions open the first group by default and expand during search, so the user can scan large libraries without a page-length checkbox wall.</p>
                    </section>

                    <section class="cw-panel-card">
                        <p class="cw-panel-kicker">Working set</p>
                        <h3 class="cw-panel-title">Selected blocks</h3>
                        @if (SelectedGovernanceBlocks.Count == 0)
                        {
                            <div class="pf-empty">No blocks are selected yet. Use the grouped list to build a focused governance set.</div>
                        }
                        else
                        {
                            <div class="pf-scroll-panel">
                                <div class="cw-list">
                                    @foreach (var block in SelectedGovernanceBlocks)
                                    {
                                        <div class="cw-list-item">
                                            <strong>@block.Name</strong>
                                            <span>@(string.IsNullOrWhiteSpace(block.Summary) ? ResolveBlockListSummary(block) : $"{ResolveBlockListSummary(block)} | {block.Summary}")</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </section>
                    }

                    @if (IsGovernanceView(GovernanceViewTemplates))
                    {
                    <section class="cw-panel-card">
                        <div class="pf-card-header">
                            <div class="pf-card-header__copy">
                                <p class="cw-panel-kicker">Template governance</p>
                                <h3 class="cw-panel-title">Flow templates stay visible, not overwhelming</h3>
                            </div>
                            <div class="cw-button-row">
                                <PromptFactoryActionButton Tone="ghost"
                                                           Text="New template"
                                                           Click="CreateNewTemplate" />
                                <PromptFactoryActionButton Tone="ghost"
                                                           Text="@(templateAdminExpanded ? "Hide editor" : "Open editor")"
                                                           Click="@(() => templateAdminExpanded = !templateAdminExpanded)" />
                            </div>
                        </div>
                        @if (templates.Count == 0)
                        {
                            <div class="pf-empty">No flow templates are available.</div>
                        }
                        else
                        {
                            <div class="pf-scroll-panel">
                                <div class="cw-list">
                                    @foreach (var template in templates.OrderBy(item => item.OrderIndex))
                                    {
                                        <div class="cw-list-item">
                                            <strong>@template.Name</strong>
                                            <span>@($"{template.BlockIds.Count} blocks | {template.AgentSequence.Count} agents")</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </section>
                    }

                    @if (IsGovernanceView(GovernanceViewLibrary))
                    {
                    <section class="cw-panel-card pf-wide-card">
                        <div class="pf-card-header">
                            <div class="pf-card-header__copy">
                                <p class="cw-panel-kicker">Grouped components</p>
                                <h3 class="cw-panel-title">Governance explorer</h3>
                                <p class="cw-panel-copy">Blocks are grouped by imported catalog sections. Each group keeps its own compact checklist and selection count.</p>
                            </div>
                        </div>
                        @if (GovernanceBlockGroups.Count == 0)
                        {
                            <div class="pf-empty">No blocks match the current filter.</div>
                        }
                        else
                        {
                            <div class="pf-scroll-panel pf-scroll-panel--tall">
                                <div class="cw-accordion-stack">
                                    @foreach (var group in GovernanceBlockGroups)
                                    {
                                        <details class="cw-accordion" open="@ShouldExpandGovernanceGroup(group)">
                                            <summary class="cw-accordion__summary">
                                                <span>
                                                    <strong>@group.Name</strong>
                                                    <small>@group.Purpose</small>
                                                </span>
                                                <span class="pf-accordion-meta">@($"{group.SelectedCount} selected / {group.Blocks.Count}")</span>
                                            </summary>
                                            <div class="cw-accordion__body">
                                                <div class="pf-select-stack">
                                                    @foreach (var block in group.Blocks)
                                                    {
                                                        var isSelected = editor.SelectedBlockIds.Contains(block.Id);
                                                        <label class="pf-checklist-item @(isSelected ? "is-selected" : string.Empty)">
                                                            <span class="pf-checklist-item__body">
                                                                <strong>@block.Name</strong>
                                                                <span>@(string.IsNullOrWhiteSpace(block.Summary) ? ResolveBlockListSummary(block) : $"{ResolveBlockListSummary(block)} | {block.Summary}")</span>
                                                            </span>
                                                            <input type="checkbox"
                                                                   checked="@isSelected"
                                                                   @onchange="args => ToggleBlock(block.Id, PromptFactoryPageHelpers.ReadCheckboxValue(args))" />
                                                        </label>
                                                    }
                                                </div>
                                            </div>
                                        </details>
                                    }
                                </div>
                            </div>
                        }
                    </section>
                    }

                    @if (IsGovernanceView(GovernanceViewBlocks))
                    {
                    <section class="cw-panel-card pf-wide-card">
                        <div class="pf-card-header">
                            <div class="pf-card-header__copy">
                                <p class="cw-panel-kicker">Block administration</p>
                                <h3 class="cw-panel-title">Edit reusable blocks only when needed</h3>
                                <p class="cw-panel-copy">The editor is intentionally hidden by default. That keeps curation and authoring separate, which cuts a large chunk of page height from the normal workflow.</p>
                            </div>
                            <div class="cw-button-row">
                                <PromptFactoryActionButton Tone="ghost"
                                                           Text="@(blockAdminExpanded ? "Hide block editor" : "Open block editor")"
                                                           Click="@(() => blockAdminExpanded = !blockAdminExpanded)" />
                                <PromptFactoryActionButton Tone="ghost"
                                                           Text="New block"
                                                           Click="CreateNewBlock" />
                                @foreach (var block in blocks.Take(4))
                                {
                                    <PromptFactoryActionButton Tone="ghost"
                                                               Text="@block.Name"
                                                               Click="@(() => EditBlockAsync(block.Id))" />
                                }
                            </div>
                        </div>
                        @if (blockAdminExpanded)
                        {
                            <div class="cw-form-grid">
                                <div class="cw-form-field">
                                    <label>Block name</label>
                                    <input class="cw-text-input" @bind="blockEditor.Name" />
                                </div>
                                <div class="cw-form-field">
                                    <label>Kind</label>
                                    <select class="cw-select" @bind="blockEditor.BlockKind">
                                        @foreach (var kind in Enum.GetValues<PromptBlockKind>())
                                        {
                                            <option value="@kind">@kind</option>
                                        }
                                    </select>
                                </div>
                                <div class="cw-form-field">
                                    <label>Summary</label>
                                    <textarea class="cw-textarea" @bind="blockEditor.Summary"></textarea>
                                </div>
                                <div class="cw-form-field">
                                    <label>Reusable content</label>
                                    <textarea class="cw-textarea" @bind="blockEditor.Content"></textarea>
                                </div>
                                <div class="cw-form-grid cw-form-grid--split">
                                    <div class="cw-form-field">
                                        <label>Prompt types</label>
                                        <input class="cw-text-input" @bind="blockEditor.PromptTypes" />
                                    </div>
                                    <div class="cw-form-field">
                                        <label>Blueprints</label>
                                        <input class="cw-text-input" @bind="blockEditor.Blueprints" />
                                    </div>
                                    <div class="cw-form-field">
                                        <label>Phases</label>
                                        <input class="cw-text-input" @bind="blockEditor.Phases" />
                                    </div>
                                </div>
                                <label class="pf-checklist-item">
                                    <span class="pf-checklist-item__body">
                                        <strong>Recommended by default</strong>
                                        <span>Make this block part of the seeded governance set.</span>
                                    </span>
                                    <input type="checkbox" @bind="blockEditor.IsRecommendedByDefault" />
                                </label>
                                <div class="cw-button-row">
                                    <PromptFactoryActionButton Tone="primary"
                                                               Text="Save block"
                                                               Click="SaveBlockAsync" />
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="pf-empty">Open the block editor only when the user needs to author or modify shared components.</div>
                        }
                    </section>
                    }

                    @if (IsGovernanceView(GovernanceViewTemplates))
                    {
                    <section class="cw-panel-card pf-wide-card">
                        <div class="pf-card-header">
                            <div class="pf-card-header__copy">
                                <p class="cw-panel-kicker">Template administration</p>
                                <h3 class="cw-panel-title">Keep template editing behind an explicit action</h3>
                                <p class="cw-panel-copy">Template governance still exists, but it no longer expands into another full-length checklist unless the user opens it.</p>
                            </div>
                            <div class="cw-button-row">
                                <PromptFactoryActionButton Tone="ghost"
                                                           Text="@(templateAdminExpanded ? "Hide template editor" : "Open template editor")"
                                                           Click="@(() => templateAdminExpanded = !templateAdminExpanded)" />
                                <PromptFactoryActionButton Tone="ghost"
                                                           Text="New template"
                                                           Click="CreateNewTemplate" />
                                @foreach (var template in templates.Take(4))
                                {
                                    <PromptFactoryActionButton Tone="ghost"
                                                               Text="@template.Name"
                                                               Click="@(() => EditTemplateAsync(template.Id))" />
                                }
                            </div>
                        </div>
                        @if (templateAdminExpanded)
                        {
                            <div class="cw-form-grid">
                                <div class="cw-form-field">
                                    <label>Template name</label>
                                    <input class="cw-text-input" @bind="templateEditor.Name" />
                                </div>
                                <div class="cw-form-field">
                                    <label>Summary</label>
                                    <textarea class="cw-textarea" @bind="templateEditor.Summary"></textarea>
                                </div>
                                <div class="cw-form-field">
                                    <label>Recommended prompt types</label>
                                    <input class="cw-text-input" @bind="templateEditor.RecommendedPromptTypes" />
                                </div>
                                <div class="cw-form-field">
                                    <label>Included blocks</label>
                                    <div class="pf-scroll-panel">
                                        <div class="pf-select-stack">
                                            @foreach (var block in blocks)
                                            {
                                                var isSelected = templateEditor.SelectedBlockIds.Contains(block.Id);
                                                <label class="pf-checklist-item @(isSelected ? "is-selected" : string.Empty)">
                                                    <span class="pf-checklist-item__body">
                                                        <strong>@block.Name</strong>
                                                        <span>@ResolveBlockListSummary(block)</span>
                                                    </span>
                                                    <input type="checkbox"
                                                           checked="@isSelected"
                                                           @onchange="args => ToggleTemplateBlock(block.Id, PromptFactoryPageHelpers.ReadCheckboxValue(args))" />
                                                </label>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="cw-button-row">
                                    <PromptFactoryActionButton Tone="primary"
                                                               Text="Save template"
                                                               Click="SaveTemplateAsync" />
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="pf-empty">Open the template editor when flow governance needs real authoring, not during normal block selection.</div>
                        }
                    </section>
                    }
                }
                else if (IsAssemblyStep)
                {
                    <section class="cw-panel-card pf-step-hero pf-wide-card">
                        <p class="cw-panel-kicker">Assembly</p>
                        <h3 class="cw-panel-title">Build from a compact context pack instead of another long page</h3>
                        <p class="cw-panel-copy">Assembly focuses on two things: the prompt-session inputs attached from the canvas and the project resources selected for context. Everything else is summarized so the user can build quickly.</p>
                        <CompactStatStrip>
                            <CompactStat Label="prompt inputs"
                                         Value="@VisibleSessionAttachments.Count.ToString()"
                                         Tone="info"
                                         TooltipText="@($"{VisibleSessionAttachments.Count} prompt inputs are attached.")" />
                            <CompactStat Label="selected resources"
                                         Value="@editor.SelectedResourceIds.Count.ToString()"
                                         Tone="success"
                                         TooltipText="@($"{editor.SelectedResourceIds.Count} resources are selected.")" />
                            <CompactStat Label="selected blocks"
                                         Value="@editor.SelectedBlockIds.Count.ToString()"
                                         TooltipText="@($"{editor.SelectedBlockIds.Count} blocks are selected.")" />
                            <CompactStat Label="warnings"
                                         Value="@editor.Warnings.Count.ToString()"
                                         Tone="warning"
                                         TooltipText="@($"{editor.Warnings.Count} warnings need review.")" />
                        </CompactStatStrip>
                        <div class="cw-button-row">
                            <button type="button" class="cw-button" data-tone="mint" data-testid="prompt-factory-build" @onclick="BuildAsync">Build prompt</button>
                            <button type="button" class="cw-button" data-tone="primary" @onclick="SaveSessionStateAsync">Save session state</button>
                            <button type="button" class="cw-button" data-tone="warn" data-testid="prompt-factory-reset-session" @onclick='@(() => HandleCanvasActionAsync("reset:session", "session-root"))'>Reset session</button>
                        </div>
                    </section>

                    <section class="cw-panel-card pf-wide-card pf-workspace-card">
                        <div class="pf-card-header">
                            <div class="pf-card-header__copy">
                                <p class="cw-panel-kicker">Assembly workspace</p>
                                <h3 class="cw-panel-title">Keep context packing in one lane</h3>
                                <p class="cw-panel-copy">@ResolveAssemblyWorkspaceSummary()</p>
                            </div>
                            <div class="pf-tab-strip" role="tablist" aria-label="Assembly workspace views">
                                <button type="button"
                                        role="tab"
                                        aria-selected="@(IsAssemblyView(AssemblyViewInputs) ? "true" : "false")"
                                        class="pf-tab-button @(IsAssemblyView(AssemblyViewInputs) ? "is-active" : string.Empty)"
                                        @onclick="@(() => SetAssemblyWorkspaceView(AssemblyViewInputs))">
                                    Inputs
                                </button>
                                <button type="button"
                                        role="tab"
                                        aria-selected="@(IsAssemblyView(AssemblyViewResources) ? "true" : "false")"
                                        class="pf-tab-button @(IsAssemblyView(AssemblyViewResources) ? "is-active" : string.Empty)"
                                        @onclick="@(() => SetAssemblyWorkspaceView(AssemblyViewResources))">
                                    Resources
                                </button>
                            </div>
                        </div>
                    </section>

                    @if (IsAssemblyView(AssemblyViewInputs))
                    {
                    <section class="cw-panel-card">
                        <p class="cw-panel-kicker">Prompt inputs</p>
                        <h3 class="cw-panel-title">Files, images, notes, and links attached to the session</h3>
                        <p class="cw-panel-copy">Inputs are added from the canvas right click menu. This panel mirrors the current set so users can review context without hunting across the tree.</p>
                        @if (VisibleSessionAttachments.Count == 0)
                        {
                            <div class="pf-empty">No prompt-session inputs are attached yet.</div>
                        }
                        else
                        {
                            <div class="pf-attachment-grid">
                                @foreach (var attachment in VisibleSessionAttachments)
                                {
                                    var storageSummary = BuildAttachmentStorageSummary(attachment);
                                    <article class="pf-attachment-card" data-kind="@ResolveAttachmentVisualKind(attachment)">
                                        <div class="pf-attachment-card__header">
                                            <strong>@ResolveAttachmentDisplayTitle(attachment)</strong>
                                            <span class="pf-attachment-card__pill">@ResolveAttachmentStatusPill(attachment)</span>
                                        </div>
                                        <p>@ResolveAttachmentLeadText(attachment)</p>
                                        <small>@ResolveAttachmentDisplaySubtitle(attachment)</small>
                                        @if (storageSummary is not null)
                                        {
                                            <StorageSummaryCard Model="@storageSummary" />
                                        }
                                    </article>
                                }
                            </div>
                        }
                    </section>
                    }

                    @if (IsAssemblyView(AssemblyViewResources))
                    {
                    <section class="cw-panel-card">
                        <p class="cw-panel-kicker">Working set</p>
                        <h3 class="cw-panel-title">Selected project resources</h3>
                        @if (SelectedProjectResources.Count == 0)
                        {
                            <div class="pf-empty">No project resources are selected yet.</div>
                        }
                        else
                        {
                            <div class="pf-scroll-panel">
                                <div class="cw-list">
                                    @foreach (var resource in SelectedProjectResources)
                                    {
                                        <div class="cw-list-item">
                                            <strong>@resource.Name</strong>
                                            <span>@ResolveResourceListSummary(resource)</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </section>

                    <section class="cw-panel-card pf-wide-card">
                        <div class="pf-card-header">
                            <div class="pf-card-header__copy">
                                <p class="cw-panel-kicker">Project resources</p>
                                <h3 class="cw-panel-title">Searchable resource selection</h3>
                                <p class="cw-panel-copy">The resource picker is bounded by an internal scroll region, so large projects stop stretching the entire page.</p>
                            </div>
                            <label class="pf-toggle">
                                <input type="checkbox" @bind="showSelectedResourcesOnly" />
                                <span>Selected only</span>
                            </label>
                        </div>
                        <div class="pf-toolbar">
                            <input class="cw-text-input pf-toolbar__search" @bind="resourceSearchText" placeholder="Search resources by name, kind, or validation" />
                        </div>
                        @if (projectResources.Count == 0)
                        {
                            <div class="pf-empty">Select a project to load linked resources for the prompt session.</div>
                        }
                        else if (FilteredProjectResources.Count == 0)
                        {
                            <div class="pf-empty">No project resources match the current filter.</div>
                        }
                        else
                        {
                            <div class="pf-scroll-panel pf-scroll-panel--tall">
                                <div class="pf-select-stack">
                                    @foreach (var resource in FilteredProjectResources)
                                    {
                                        var isSelected = editor.SelectedResourceIds.Contains(resource.Id);
                                        <label class="pf-checklist-item @(isSelected ? "is-selected" : string.Empty)">
                                            <span class="pf-checklist-item__body">
                                                <strong>@resource.Name</strong>
                                                <span>@ResolveResourceListSummary(resource)</span>
                                            </span>
                                            <input type="checkbox"
                                                   checked="@isSelected"
                                                   @onchange="args => ToggleResource(resource.Id, PromptFactoryPageHelpers.ReadCheckboxValue(args))" />
                                        </label>
                                    }
                                </div>
                            </div>
                        }
                    </section>
                    }
                }
                else if (IsReviewStep)
                {
                    <section class="cw-panel-card pf-step-hero pf-wide-card">
                        <p class="cw-panel-kicker">Review</p>
                        <h3 class="cw-panel-title">Keep warnings, preview, and delivery actions in one lane</h3>
                        <p class="cw-panel-copy">Review is now a short finish screen. Users see readiness, preview length, and all delivery actions together instead of scrolling back through selection tools they no longer need.</p>
                        <CompactStatStrip>
                            <CompactStat Label="warnings"
                                         Value="@editor.Warnings.Count.ToString()"
                                         Tone="warning"
                                         TooltipText="@($"{editor.Warnings.Count} warnings need review.")" />
                            <CompactStat Text="@($"Prompt {(string.IsNullOrWhiteSpace(editor.GeneratedPrompt) ? "Not built" : $"{editor.GeneratedPrompt.Length:N0} chars")}")"
                                         Tone="info"
                                         TooltipText="@($"Prompt size: {(string.IsNullOrWhiteSpace(editor.GeneratedPrompt) ? "Not built" : $"{editor.GeneratedPrompt.Length:N0} characters")}")" />
                            <CompactStat Text="@($"Draft {(string.IsNullOrWhiteSpace(editor.DraftTitle) ? "Not named" : editor.DraftTitle)}")"
                                         TooltipText="@($"Draft title: {(string.IsNullOrWhiteSpace(editor.DraftTitle) ? "Draft not named" : editor.DraftTitle)}")" />
                            <CompactStat Label="steps"
                                         Value="@editor.Nodes.Count.ToString()"
                                         Tone="success"
                                         TooltipText="@($"{editor.Nodes.Count} prompt flow steps.")" />
                        </CompactStatStrip>
                        <div class="cw-button-row">
                            <PromptFactoryActionButton Tone="accent"
                                                       Text="Build prompt"
                                                       Click="BuildAsync" />
                            <PromptFactoryActionButton Tone="ghost"
                                                       Text="Copy"
                                                       Click="CopyAsync" />
                            <PromptFactoryActionButton Tone="ghost"
                                                       Text="Export"
                                                       Click="ExportAsync" />
                            <PromptFactoryActionButton Tone="primary"
                                                       Text="Save draft"
                                                       Click="SaveDraftAsync" />
                            <PromptFactoryActionButton Tone="mint"
                                                       Text="Save final"
                                                       Click="SaveFinalAsync" />
                            <PromptFactoryActionButton Tone="warn"
                                                       Text="Send"
                                                       Click="SendAsync" />
                        </div>
                    </section>

                    <section class="cw-panel-card pf-wide-card pf-workspace-card">
                        <div class="pf-card-header">
                            <div class="pf-card-header__copy">
                                <p class="cw-panel-kicker">Review workspace</p>
                                <h3 class="cw-panel-title">Finish in one focused support frame</h3>
                                <p class="cw-panel-copy">@ResolveReviewWorkspaceSummary()</p>
                            </div>
                            <div class="pf-tab-strip" role="tablist" aria-label="Review workspace views">
                                <button type="button"
                                        role="tab"
                                        aria-selected="@(IsReviewView(ReviewViewReadiness) ? "true" : "false")"
                                        class="pf-tab-button @(IsReviewView(ReviewViewReadiness) ? "is-active" : string.Empty)"
                                        @onclick="@(() => SetReviewWorkspaceView(ReviewViewReadiness))">
                                    Readiness
                                </button>
                                <button type="button"
                                        role="tab"
                                        aria-selected="@(IsReviewView(ReviewViewPreview) ? "true" : "false")"
                                        class="pf-tab-button @(IsReviewView(ReviewViewPreview) ? "is-active" : string.Empty)"
                                        @onclick="@(() => SetReviewWorkspaceView(ReviewViewPreview))">
                                    Preview
                                </button>
                                <button type="button"
                                        role="tab"
                                        aria-selected="@(IsReviewView(ReviewViewDelivery) ? "true" : "false")"
                                        class="pf-tab-button @(IsReviewView(ReviewViewDelivery) ? "is-active" : string.Empty)"
                                        @onclick="@(() => SetReviewWorkspaceView(ReviewViewDelivery))">
                                    Delivery
                                </button>
                            </div>
                        </div>
                    </section>

                    @if (IsReviewView(ReviewViewReadiness))
                    {
                    <section class="cw-panel-card">
                        <p class="cw-panel-kicker">Warnings and readiness</p>
                        <h3 class="cw-panel-title">Final checks</h3>
                        @if (editor.Warnings.Count == 0)
                        {
                            <div class="pf-empty">No warnings were generated. The session looks ready for draft, final save, or send.</div>
                        }
                        else
                        {
                            <div class="pf-scroll-panel">
                                <div class="cw-list">
                                    @foreach (var warning in editor.Warnings)
                                    {
                                        <div class="cw-list-item">
                                            <strong>Warning</strong>
                                            <span>@warning</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </section>
                    }

                    @if (IsReviewView(ReviewViewDelivery))
                    {
                    <section class="cw-panel-card">
                        <p class="cw-panel-kicker">Delivery context</p>
                        <h3 class="cw-panel-title">What will ship</h3>
                        <CompactStatStrip>
                            <CompactStat Label="blocks"
                                         Value="@editor.SelectedBlockIds.Count.ToString()"
                                         Tone="success"
                                         TooltipText="@($"{editor.SelectedBlockIds.Count} selected blocks will ship.")" />
                            <CompactStat Label="resources"
                                         Value="@editor.SelectedResourceIds.Count.ToString()"
                                         Tone="info"
                                         TooltipText="@($"{editor.SelectedResourceIds.Count} selected resources will ship.")" />
                            <CompactStat Label="inputs"
                                         Value="@VisibleSessionAttachments.Count.ToString()"
                                         TooltipText="@($"{VisibleSessionAttachments.Count} prompt inputs will ship.")" />
                            <CompactStat Text="@($"Provider {ResolveSelectedProviderName()}")"
                                         Tone="warning"
                                         TooltipText="@($"Selected provider: {ResolveSelectedProviderName()}")" />
                        </CompactStatStrip>
                    </section>
                    }

                    @if (IsReviewView(ReviewViewPreview))
                    {
                    <section class="cw-panel-card pf-wide-card">
                        <p class="cw-panel-kicker">Prompt review</p>
                        <h3 class="cw-panel-title">Generated prompt</h3>
                        <div class="cw-form-field">
                            <label>Prompt preview</label>
                            <textarea class="cw-textarea pf-prompt-preview" @bind="editor.GeneratedPrompt"></textarea>
                        </div>
                    </section>
                    }
                }

            </div>
        }
    }
</div>

<PromptFactoryDialogs ShowPromptPreviewDialog="showPromptPreviewDialog"
                      PromptPreviewKicker="@promptPreviewKicker"
                      PromptPreviewTitle="@promptPreviewTitle"
                      PromptPreviewDescription="@promptPreviewDescription"
                      PromptPreviewText="@promptPreviewText"
                      ClosePromptPreviewDialog="ClosePromptPreviewDialogAsync"
                      CopyPrompt="@(() => CopyAsync(promptPreviewText))"
                      ShowComponentEditorModal="showComponentEditorModal"
                      SelectedComponentName="@selectedComponentNode?.Name"
                      SelectedComponentRenderedContent="@SelectedComponentRenderedContent"
                      SelectedComponentRenderedContentChanged="@(value => { SelectedComponentRenderedContent = value; })"
                      SelectedComponentIsModified="SelectedComponentIsModified"
                      ResetSelectedComponentRenderedContent="ResetSelectedComponentRenderedContent"
                      CloseComponentEditor="CloseComponentEditorModal"
                      ShowImpactDialog="showImpactDialog"
                      ImpactDialogTitle="@impactDialogTitle"
                      ImpactDialogBody="@impactDialogBody"
                      ImpactDialogConfirmLabel="@impactDialogConfirmLabel"
                      CloseImpactDialog="CloseImpactDialogAsync"
                      ConfirmImpactDialog="ConfirmImpactDialogAsync" />

@code {
    private static readonly string[] wizardSteps = ["Context", "Governance", "Assembly", "Review"];

    [SupplyParameterFromQuery(Name = "sessionId")]
    public Guid? SessionIdQuery { get; set; }

    [SupplyParameterFromQuery(Name = "runId")]
    public Guid? RunIdQuery { get; set; }

    private IReadOnlyList<ProjectSummary> projects = [];
    private IReadOnlyList<ResourceSummary> projectResources = [];
    private IReadOnlyList<ProviderProfileSummary> providers = [];
    private IReadOnlyList<PromptBlockSummary> blocks = [];
    private IReadOnlyList<PromptFlowTemplateSummary> templates = [];
    private IReadOnlyList<PromptBlueprintSummary> blueprints = [];
    private PromptFactoryEditorModel editor = new();
    private PromptBlockEditorModel blockEditor = new();
    private PromptFlowTemplateEditorModel templateEditor = new();
    private CanvasWorkbenchSurface? canvasSurface;
    private readonly PromptFactorySessionGraphAdapter sessionGraphAdapter = new();
    private readonly PromptFactoryUndoRedoAdapter undoRedoAdapter = new();
    private List<string> selectedCanvasNodeIds = [];
    private string activeInspectorTab = "context";
    private const int CanvasUiStatePersistDelayMs = 420;
    private CancellationTokenSource? pendingCanvasUiStatePersistCts;
    private string selectedPromptNodeTitle = string.Empty;
    private string selectedPromptNodeNotes = string.Empty;
    private PromptRunNodeState selectedPromptNodeState = PromptRunNodeState.Prepared;

    private IReadOnlyList<CanvasWorkbenchStat> stageStats =>
    [
        new() { Label = "Steps", Value = editor.Nodes.Count.ToString(), Tone = "neutral" },
        new() { Label = "Components", Value = editor.SelectedBlockIds.Count.ToString(), Tone = "accent" },
        new() { Label = "Inputs", Value = VisibleSessionAttachments.Count.ToString(), Tone = "mint" },
        new() { Label = "Resources", Value = editor.SelectedResourceIds.Count.ToString(), Tone = "mint" },
        new() { Label = "Warnings", Value = editor.Warnings.Count.ToString(), Tone = "warn" }
    ];

    private RecommendationOverlaySummary canvasRecommendationOverlay
        => PromptFactoryPageHelpers.ResolveRecommendationOverlay(BuildCanvasGraphRequest(new CanvasWorkbenchUiState()));

    private string? selectedCanvasNodeId => selectedCanvasNodeIds.FirstOrDefault();

    private PromptRunNodeSummary? selectedPromptNode => PromptFactoryPageHelpers.TryParsePromptCanvasNodeId(selectedCanvasNodeId, out var nodeId)
        ? editor.Nodes.FirstOrDefault(node => node.Id == nodeId)
        : null;

    private string? selectedBranchLabel => selectedCanvasNodeId is { } canvasNodeId && canvasNodeId.StartsWith("branch:", StringComparison.Ordinal)
        ? PromptFactoryPageHelpers.ResolveBranchLabel(canvasNodeId)
        : null;

    private IReadOnlyList<PromptRunNodeSummary> selectedBranchNodes => selectedBranchLabel is null
        ? []
        : editor.Nodes
            .Where(node => string.Equals(node.BranchLabel, selectedBranchLabel, StringComparison.OrdinalIgnoreCase) ||
                           string.Equals(node.BranchKey, selectedBranchLabel, StringComparison.OrdinalIgnoreCase))
            .OrderBy(node => node.Sequence)
            .ToList();

    protected override async Task OnParametersSetAsync()
        => await LoadAsync(SessionIdQuery, RunIdQuery);

    private async Task LoadAsync(Guid? sessionId = null, Guid? runId = null)
    {
        projects = await ProjectsService.ListAsync();
        providers = await WorkspaceService.ListProviderProfilesAsync();
        blocks = await PromptFactoryService.ListBlocksAsync();
        templates = await PromptFactoryService.ListTemplatesAsync();
        blueprints = await PromptFactoryService.ListBlueprintsAsync();
        libraryCatalog = await PromptFactoryService.GetLibraryCatalogAsync();
        editor = await PromptFactoryService.GetEditorAsync(sessionId, runId);
        if (string.IsNullOrWhiteSpace(editor.SessionName))
        {
            editor.SessionName = "Prompt session";
        }

        if (string.IsNullOrWhiteSpace(editor.DraftTitle))
        {
            editor.DraftTitle = "Prompt Factory Draft";
        }

        if (string.IsNullOrWhiteSpace(editor.CanvasUiStateJson))
        {
            editor.CanvasUiStateJson = "{}";
        }

        await LoadResourcesAsync();
        await LoadProjectContextAsync();
        HydrateCanvasSelection();
        EnsureSetupFocusForNewSession();
        RefreshCanvasSurface();
        SyncSelectedPromptNodeDraft();
        if (ShowPromptPreviewQuery && !string.IsNullOrWhiteSpace(editor.GeneratedPrompt))
        {
            OpenFinalPromptPreview();
        }
        else
        {
            showPromptPreviewDialog = false;
        }
    }

    private void HydrateCanvasSelection(string? preferredCanvasNodeId = null)
    {
        var uiState = CanvasWorkbenchUiState.Parse(editor.CanvasUiStateJson);
        activeInspectorTab = string.IsNullOrWhiteSpace(uiState.ActiveInspectorTab) ? "context" : uiState.ActiveInspectorTab;

        if (!string.IsNullOrWhiteSpace(preferredCanvasNodeId))
        {
            selectedCanvasNodeIds = [preferredCanvasNodeId];
        }
        else if (uiState.SelectedNodeIds.Count > 0)
        {
            selectedCanvasNodeIds = uiState.SelectedNodeIds.ToList();
        }
        else if (editor.SelectedNodeId.HasValue)
        {
            selectedCanvasNodeIds = [$"node:{editor.SelectedNodeId.Value:N}"];
        }
        else if (ShouldAutoFocusSetupNode())
        {
            selectedCanvasNodeIds = [SetupCanvasNodeId];
        }
        else
        {
            selectedCanvasNodeIds = ["session-root"];
        }
    }

    private void RefreshCanvasSurface()
    {
        UpsertSetupAttachment();
        var uiState = sessionGraphAdapter.BuildUiState(editor.CanvasUiStateJson, selectedCanvasNodeIds, activeInspectorTab);
        editor.CanvasUiStateJson = uiState.ToJson();
        canvasSurface = sessionGraphAdapter.BuildSurface(BuildCanvasGraphRequest(uiState));
    }

    private PromptFactorySessionGraphRequest BuildCanvasGraphRequest(CanvasWorkbenchUiState uiState)
        => PromptFactoryPageHelpers.BuildGraphRequest(
            editor,
            libraryCatalog,
            blueprints,
            templates,
            blocks,
            VisibleSessionAttachments,
            sessionSetup,
            uiState,
            ResolveSetupSummaryLine(),
            ResolveSetupLeadCopy(),
            ResolveSetupStatusLabel(),
            SetupIsReady,
            MissingSetupFieldCount);

    private Task ApplyCanvasRecommendationsAsync() => ApplyRecommendationsAsync();

    private Task BuildCanvasFlowAsync() => BuildAsync();

    private string ResolveStageTitle()
        => string.IsNullOrWhiteSpace(editor.SessionName) ? "Prompt flow canvas" : editor.SessionName;

    private string UndoRedoSessionLabel
        => string.IsNullOrWhiteSpace(editor.SessionName) ? "Unsaved session" : editor.SessionName;

    private string UndoRedoSelectionLabel
        => string.IsNullOrWhiteSpace(selectedCanvasNodeId) ? "session-root" : selectedCanvasNodeId;

    private IReadOnlyList<string> UndoRedoMetrics =>
    [
        CanUndo ? "Undo available" : "Undo stack empty",
        CanRedo ? "Redo available" : "Redo stack empty",
        $"{selectedCanvasNodeIds.Count} selected canvas item(s)",
        $"{editor.Nodes.Count} run node(s)"
    ];

    private SelectionModel CanvasPrimitiveSelection
        => canvasSurface is null
            ? SelectionModel.Empty
            : SelectionModel.From(selectedCanvasNodeIds, selectedCanvasNodeId);

    private ChipBadgePrimitiveSnapshot ChipBadgePreviewSnapshot
        => canvasSurface is null ? new() : ChipBadgePrimitiveFactory.CreateForWorkbench(canvasSurface);

    private ConnectorPathPrimitiveSnapshot ConnectorPathPreviewSnapshot
        => canvasSurface is null ? new() : ConnectorPathPrimitiveFactory.CreateForWorkbench(canvasSurface);

    private ContainerPrimitiveSnapshot ContainerPreviewSnapshot
        => canvasSurface is null ? new() : ContainerPrimitiveFactory.CreateForWorkbench(canvasSurface, CanvasPrimitiveSelection);

    private ContextMenuHostSnapshot ContextMenuPreviewSnapshot
        => canvasSurface is null ? new() : ContextMenuHostFactory.CreateForWorkbench(canvasSurface, CanvasPrimitiveSelection);

    private CreateActionPaletteSnapshot CreateActionPalettePreviewSnapshot
        => canvasSurface is null ? new() : CreateActionPaletteFactory.CreateForWorkbench(canvasSurface);

    private FloatingInspectorHostSnapshot FloatingInspectorPreviewSnapshot
        => canvasSurface is null ? new() : FloatingInspectorHostFactory.CreateForWorkbench(canvasSurface, CanvasPrimitiveSelection);

    private GroupFrameOverlaySnapshot GroupFramePreviewSnapshot
        => canvasSurface is null ? new() : GroupFrameOverlayFactory.CreateForWorkbench(canvasSurface);

    private IconGlyphPrimitiveSnapshot IconGlyphPreviewSnapshot
        => canvasSurface is null ? new() : IconGlyphPrimitiveFactory.CreateForWorkbench(canvasSurface);

    private ImagePrimitiveSnapshot ImagePreviewSnapshot
        => canvasSurface is null ? new() : ImagePrimitiveFactory.CreateForWorkbench(canvasSurface);

    private InlineEditorComposerSnapshot InlineEditorPreviewSnapshot
        => canvasSurface is null ? new() : InlineEditorComposerFactory.CreateForWorkbench(canvasSurface, CanvasPrimitiveSelection);

    private NodeCardComposerSnapshot NodeCardPreviewSnapshot
        => canvasSurface is null ? new() : NodeCardComposerFactory.CreateForWorkbench(canvasSurface, CanvasPrimitiveSelection);

    private TextBlockPrimitiveSnapshot TextBlockPreviewSnapshot
        => canvasSurface is null ? new() : TextBlockPrimitiveFactory.CreateForWorkbench(canvasSurface);

    private IEnumerable<(string Title, string Subtitle)> ResolveSelectedCanvasLabels()
    {
        foreach (var selectedId in selectedCanvasNodeIds)
        {
            if (selectedId == BlueprintCanvasNodeId && selectedBlueprintNode is not null)
            {
                yield return (selectedBlueprintNode.Name, selectedBlueprintNode.PromptType);
                continue;
            }

            if (selectedId == FlowCanvasNodeId && selectedFlowNode is not null)
            {
                yield return (selectedFlowNode.Name, $"{selectedFlowNode.AgentSequence.Count} agent step(s)");
                continue;
            }

            if (TryParseSelectedComponentNodeId(selectedId, out var blockKey) &&
                blocks.FirstOrDefault(item => string.Equals(item.Key, blockKey, StringComparison.OrdinalIgnoreCase)) is { } selectedBlock)
            {
                yield return (selectedBlock.Name, ResolveLibraryGroupLabel(selectedBlock.GroupKey));
                continue;
            }

            if (TryParseSelectedInputNodeId(selectedId, out var attachmentId) &&
                editor.SessionAttachments.FirstOrDefault(item => string.Equals(item.Id, attachmentId, StringComparison.OrdinalIgnoreCase)) is { } selectedAttachment)
            {
                yield return (selectedAttachment.Title, selectedAttachment.Kind);
                continue;
            }

            if (TryParseComponentGroupNodeId(selectedId, out var groupKey))
            {
                yield return (ResolveLibraryGroupLabel(groupKey), "Component group");
                continue;
            }

            if (PromptFactoryPageHelpers.TryParsePromptCanvasNodeId(selectedId, out var nodeId) &&
                editor.Nodes.FirstOrDefault(node => node.Id == nodeId) is { } promptNode)
            {
                yield return (promptNode.Title, $"{promptNode.BranchLabel} Â· {promptNode.State}");
                continue;
            }

            if (selectedId == "session-root")
            {
                yield return ("Prompt session", string.IsNullOrWhiteSpace(editor.Phase) ? "Session root" : editor.Phase);
                continue;
            }

            yield return (PromptFactoryPageHelpers.ResolveBranchLabel(selectedId), "Branch group");
        }
    }

    private async Task HandleProjectChangedAsync()
    {
        if (editor.ProjectId.HasValue && string.IsNullOrWhiteSpace(editor.Phase))
        {
            var project = await ProjectsService.GetAsync(editor.ProjectId.Value);
            editor.Phase = project.CurrentPhase;
        }

        await LoadResourcesAsync();
        await LoadProjectContextAsync();
        RefreshCanvasSurface();
    }

    private async Task HandleProjectSelectionChangedAsync(ChangeEventArgs args)
    {
        editor.ProjectId = PromptFactoryPageHelpers.ParseOptionalGuid(args.Value);
        await HandleProjectChangedAsync();
    }

    private async Task HandleBlueprintChangedAsync()
    {
        var blueprint = blueprints.FirstOrDefault(item => item.Id == editor.BlueprintId);
        if (blueprint?.RecommendedFlowTemplateId is not null)
        {
            editor.FlowTemplateId = blueprint.RecommendedFlowTemplateId;
        }

        await ApplyRecommendationsAsync();
    }

    private async Task HandleBlueprintSelectionChangedAsync(ChangeEventArgs args)
    {
        editor.BlueprintId = PromptFactoryPageHelpers.ParseOptionalGuid(args.Value);
        await HandleBlueprintChangedAsync();
    }

    private Task HandleFlowTemplateSelectionChangedAsync(ChangeEventArgs args)
    {
        editor.FlowTemplateId = PromptFactoryPageHelpers.ParseOptionalGuid(args.Value);
        RefreshCanvasSurface();
        return Task.CompletedTask;
    }

    private Task HandleProviderSelectionChangedAsync(ChangeEventArgs args)
    {
        editor.ProviderProfileId = PromptFactoryPageHelpers.ParseOptionalGuid(args.Value);
        RefreshCanvasSurface();
        return Task.CompletedTask;
    }

    private async Task LoadResourcesAsync()
    {
        var resources = await ResourcesService.ListAsync();
        projectResources = editor.ProjectId.HasValue
            ? resources.Where(resource => resource.ProjectId == editor.ProjectId.Value).ToList()
            : [];
    }

    private async Task ApplyRecommendationsAsync()
    {
        var recommendedBlockIds = (await PromptFactoryService.GetRecommendedBlockIdsAsync(editor.BlueprintId, editor.FlowTemplateId, editor.Phase)).ToList();
        if (TryBuildSelectionImpactMessage(recommendedBlockIds, "Applying recommendations", out var dialogBody))
        {
            OpenImpactDialog(
                "Apply recommendations?",
                dialogBody,
                "Apply recommendations",
                () => ApplyRecommendedBlockSelectionAsync(recommendedBlockIds, "Recommended shared blocks applied."));
            return;
        }

        await ApplyRecommendedBlockSelectionAsync(recommendedBlockIds, "Recommended shared blocks applied.");
    }

    private Task ApplyRecommendedBlockSelectionAsync(IReadOnlyList<Guid> recommendedBlockIds, string successMessage)
    {
        RememberHistoryCheckpoint();
        editor.SelectedBlockIds = recommendedBlockIds.ToList();
        editor.HasCustomizedBlocks = false;
        TrimComponentCustomizations();
        RefreshCanvasSurface();
        SetMessage(successMessage);
        return Task.CompletedTask;
    }

    private async Task SaveSessionStateAsync()
    {
        var result = await PromptFactoryService.SaveSessionStateAsync(editor);
        if (result.IsFailure)
        {
            SetError(result.Errors);
            return;
        }

        editor = result.Value!;
        await LoadResourcesAsync();
        await LoadProjectContextAsync();
        HydrateCanvasSelection();
        RefreshCanvasSurface();
        SyncSelectedPromptNodeDraft();
        NavigateToSession(editor.SessionId);
        SetMessage("Prompt session state saved.");
    }

    private async Task BuildAsync()
    {
        RememberHistoryCheckpoint();
        var result = await PromptFactoryService.BuildAsync(editor);
        if (result.IsFailure)
        {
            SetError(result.Errors);
            return;
        }

        editor = result.Value!;
        await LoadResourcesAsync();
        await LoadProjectContextAsync();
        HydrateCanvasSelection(editor.Nodes.Count > 0 ? $"node:{editor.Nodes[0].Id:N}" : "session-root");
        RefreshCanvasSurface();
        SyncSelectedPromptNodeDraft();
        OpenFinalPromptPreview();
        if (editor.SessionId.HasValue && SessionIdQuery != editor.SessionId)
        {
            NavigateToSession(editor.SessionId, showPromptPreview: true);
        }
        SetMessage("Prompt built.");
    }

    private async Task SaveDraftAsync()
    {
        var result = await PromptFactoryService.SaveDraftAsync(editor);
        if (result.IsSuccess)
        {
            SetMessage("Draft saved to the prompt library.");
        }
        else
        {
            SetError(result.Errors);
        }
    }

    private async Task SaveFinalAsync()
    {
        var result = await PromptFactoryService.SaveFinalAsync(editor);
        if (result.IsSuccess)
        {
            SetMessage("Final prompt saved.");
        }
        else
        {
            SetError(result.Errors);
        }
    }

    private Task CopyAsync()
        => CopyAsync(null);

    private async Task CopyAsync(string? text)
    {
        var value = text ?? (showPromptPreviewDialog ? promptPreviewText : editor.GeneratedPrompt) ?? string.Empty;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", value);
        SetMessage("Prompt copied to the clipboard.");
    }

    private async Task ExportAsync()
    {
        var result = await PromptFactoryService.ExportAsync(editor);
        if (result.IsSuccess)
        {
            SetMessage($"Prompt exported to {result.Value}.");
        }
        else
        {
            SetError(result.Errors);
        }
    }

    private async Task SendAsync()
    {
        var result = await PromptFactoryService.SendAsync(editor);
        if (result.IsSuccess)
        {
            SetMessage($"Provider response received from {result.Value!.ProviderName}.");
        }
        else
        {
            SetError(result.Errors);
        }
    }

    private async Task BranchAsync(Guid nodeId)
    {
        RememberHistoryCheckpoint();
        var result = await PromptFactoryService.BranchNodeAsync(nodeId);
        if (result.IsFailure)
        {
            SetError(result.Errors);
            return;
        }

        editor = await PromptFactoryService.GetEditorAsync(editor.SessionId, editor.PromptRunId);
        HydrateCanvasSelection($"node:{result.Value!.Id:N}");
        RefreshCanvasSurface();
        SyncSelectedPromptNodeDraft();
        NavigateToSession(editor.SessionId);
        SetMessage("Prompt branch created.");
    }

    private async Task SaveSelectedPromptNodeAsync()
    {
        if (selectedPromptNode is null)
        {
            return;
        }

        RememberHistoryCheckpoint();
        var saveResult = await PromptFactoryService.UpdateNodeAsync(selectedPromptNode.Id, selectedPromptNodeTitle, selectedPromptNodeNotes);
        if (saveResult.IsFailure)
        {
            SetError(saveResult.Errors);
            return;
        }

        await SetPromptNodeStateAsync(selectedPromptNode.Id, selectedPromptNodeState, suppressMessage: true, captureHistory: false);
        editor = await PromptFactoryService.GetEditorAsync(editor.SessionId, editor.PromptRunId);
        HydrateCanvasSelection($"node:{selectedPromptNode.Id:N}");
        RefreshCanvasSurface();
        SyncSelectedPromptNodeDraft();
        SetMessage("Prompt step saved.");
    }

    private async Task SetPromptNodeStateAsync(Guid nodeId, PromptRunNodeState state, bool suppressMessage = false, bool captureHistory = true)
    {
        if (captureHistory)
        {
            RememberHistoryCheckpoint();
        }

        var result = await PromptFactoryService.SetNodeStateAsync(nodeId, state);
        if (result.IsFailure)
        {
            SetError(result.Errors);
            return;
        }

        editor = await PromptFactoryService.GetEditorAsync(editor.SessionId, editor.PromptRunId);
        HydrateCanvasSelection($"node:{nodeId:N}");
        RefreshCanvasSurface();
        SyncSelectedPromptNodeDraft();
        if (!suppressMessage)
        {
            SetMessage($"Prompt step marked {state}.");
        }
    }

    private async Task HandleCanvasSelectionChangedAsync(CanvasWorkbenchSelectionChangedEventArgs args)
    {
        var uiState = sessionGraphAdapter.BuildUiState(
            editor.CanvasUiStateJson,
            args.SelectedNodeIds.Count > 0 ? args.SelectedNodeIds : ["session-root"],
            activeInspectorTab);
        ApplyCanvasUiStateLocally(uiState);
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleCanvasNodesMovedAsync(CanvasWorkbenchNodesMovedEventArgs args)
    {
        var uiState = sessionGraphAdapter.BuildUiState(editor.CanvasUiStateJson, selectedCanvasNodeIds, activeInspectorTab);
        foreach (var position in args.Positions)
        {
            uiState.ManualPositions[position.NodeId] = new CanvasWorkbenchPoint
            {
                X = position.X,
                Y = position.Y
            };
        }

        ApplyCanvasUiStateLocally(uiState);
        ScheduleCanvasUiStatePersistence();
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleCanvasStateChangedAsync(string stateJson)
    {
        var uiState = CanvasWorkbenchUiState.Parse(stateJson);
        ApplyCanvasUiStateLocally(uiState);
        ScheduleCanvasUiStatePersistence();
        await InvokeAsync(StateHasChanged);
    }

    private async Task PersistCanvasUiStateAsync()
    {
        await PersistCanvasUiStateAsync(sessionGraphAdapter.BuildUiState(editor.CanvasUiStateJson, selectedCanvasNodeIds, activeInspectorTab));
    }

    private async Task PersistCanvasUiStateAsync(CanvasWorkbenchUiState uiState)
    {
        CancelPendingCanvasUiStatePersistence();
        ApplyCanvasUiStateLocally(uiState);
        if (editor.SessionId.HasValue)
        {
            await PromptFactoryService.SaveCanvasUiStateAsync(editor.SessionId.Value, editor.CanvasUiStateJson, editor.SelectedNodeId);
        }

        RefreshCanvasSurface();
    }

    private void ApplyCanvasUiStateLocally(CanvasWorkbenchUiState uiState)
    {
        uiState.SelectedNodeIds = uiState.SelectedNodeIds.Count > 0 ? [.. uiState.SelectedNodeIds] : ["session-root"];
        uiState.ActiveInspectorTab = string.IsNullOrWhiteSpace(uiState.ActiveInspectorTab)
            ? (string.IsNullOrWhiteSpace(activeInspectorTab) ? "context" : activeInspectorTab)
            : uiState.ActiveInspectorTab;
        selectedCanvasNodeIds = uiState.SelectedNodeIds.ToList();
        activeInspectorTab = uiState.ActiveInspectorTab;
        editor.CanvasUiStateJson = uiState.ToJson();
        if (canvasSurface is not null)
        {
            canvasSurface.UiState = uiState;
        }

        editor.SelectedNodeId = PromptFactoryPageHelpers.TryParsePromptCanvasNodeId(selectedCanvasNodeId, out var nodeId) ? nodeId : null;
        SyncSelectedPromptNodeDraft();
    }

    private void ScheduleCanvasUiStatePersistence()
    {
        if (!editor.SessionId.HasValue || string.IsNullOrWhiteSpace(editor.CanvasUiStateJson))
        {
            CancelPendingCanvasUiStatePersistence();
            return;
        }

        CancelPendingCanvasUiStatePersistence();
        var persistCts = new CancellationTokenSource();
        pendingCanvasUiStatePersistCts = persistCts;
        _ = PersistCanvasUiStateWhenIdleAsync(
            persistCts,
            editor.SessionId.Value,
            editor.CanvasUiStateJson,
            editor.SelectedNodeId);
    }

    private async Task PersistCanvasUiStateWhenIdleAsync(
        CancellationTokenSource persistCts,
        Guid sessionId,
        string stateJson,
        Guid? selectedNodeId)
    {
        try
        {
            await Task.Delay(CanvasUiStatePersistDelayMs, persistCts.Token);
            if (persistCts.IsCancellationRequested || string.IsNullOrWhiteSpace(stateJson))
            {
                return;
            }

            await PromptFactoryService.SaveCanvasUiStateAsync(sessionId, stateJson, selectedNodeId);
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            if (ReferenceEquals(pendingCanvasUiStatePersistCts, persistCts))
            {
                pendingCanvasUiStatePersistCts = null;
            }

            persistCts.Dispose();
        }
    }

    private void CancelPendingCanvasUiStatePersistence()
    {
        var persistCts = pendingCanvasUiStatePersistCts;
        pendingCanvasUiStatePersistCts = null;
        if (persistCts is null)
        {
            return;
        }

        persistCts.Cancel();
        persistCts.Dispose();
    }

    private async Task HandleCanvasContextActionAsync(CanvasWorkbenchContextActionRequest request)
        => await HandleCanvasActionAsync(request.ActionId, request.NodeId);

    private async Task HandleCanvasCreateActionAsync(CanvasWorkbenchCreateActionRequest request)
    {
        if (await HandleCatalogCreateActionAsync(request))
        {
            return;
        }

        await HandleCanvasActionAsync(request.ActionId, request.SourceNodeId);
    }

    private async Task HandleCanvasNodeOpenedAsync(string nodeId)
    {
        if (PromptFactoryPageHelpers.TryParsePromptCanvasNodeId(nodeId, out var promptNodeId) &&
            editor.Nodes.FirstOrDefault(node => node.Id == promptNodeId)?.PromptArtifactId is Guid promptArtifactId)
        {
            OpenPromptArtifact(promptArtifactId);
            return;
        }

        await SelectCanvasNodeAsync(nodeId);
    }

    private async Task HandleCanvasActionAsync(string actionId, string? sourceNodeId)
    {
        if (await HandleCatalogContextActionAsync(actionId))
        {
            return;
        }

        switch (actionId)
        {
            case "build-flow":
                await BuildAsync();
                break;
            case "apply-recommendations":
                await ApplyRecommendationsAsync();
                break;
            case "save-session":
                await SaveSessionStateAsync();
                break;
            case "branch":
            case "branch-selected":
                if (PromptFactoryPageHelpers.TryParsePromptCanvasNodeId(sourceNodeId ?? selectedCanvasNodeId, out var branchNodeId))
                {
                    await BranchAsync(branchNodeId);
                }
                break;
            case "mark-used":
                if (PromptFactoryPageHelpers.TryParsePromptCanvasNodeId(sourceNodeId ?? selectedCanvasNodeId, out var usedNodeId))
                {
                    await SetPromptNodeStateAsync(usedNodeId, PromptRunNodeState.Used);
                }
                break;
            case "validate-node":
                if (PromptFactoryPageHelpers.TryParsePromptCanvasNodeId(sourceNodeId ?? selectedCanvasNodeId, out var validatedNodeId))
                {
                    await SetPromptNodeStateAsync(validatedNodeId, PromptRunNodeState.Validated);
                }
                break;
            case "skip-node":
                if (PromptFactoryPageHelpers.TryParsePromptCanvasNodeId(sourceNodeId ?? selectedCanvasNodeId, out var skippedNodeId))
                {
                    await SetPromptNodeStateAsync(skippedNodeId, PromptRunNodeState.Skipped);
                }
                break;
            case "open-prompt":
                if (PromptFactoryPageHelpers.TryParsePromptCanvasNodeId(sourceNodeId ?? selectedCanvasNodeId, out var openNodeId) &&
                    editor.Nodes.FirstOrDefault(node => node.Id == openNodeId)?.PromptArtifactId is Guid promptArtifactId)
                {
                    OpenPromptArtifact(promptArtifactId);
                }
                break;
        }
    }

    private async Task SetInspectorTabAsync(string tab)
    {
        activeInspectorTab = tab;
        editor.WizardStepIndex = tab switch
        {
            "governance" => 1,
            "assembly" => 2,
            "review" => 3,
            _ => 0
        };
        await PersistCanvasUiStateAsync();
    }

    private async Task SelectRootNodeAsync()
        => await SelectCanvasNodeAsync("session-root");

    private async Task ClearCanvasSelectionAsync()
        => await SelectCanvasNodeAsync("session-root");

    private async Task SelectPromptCanvasNodeAsync(Guid nodeId)
        => await SelectCanvasNodeAsync($"node:{nodeId:N}");

    private async Task SelectCanvasNodeAsync(string canvasNodeId)
    {
        selectedCanvasNodeIds = [canvasNodeId];
        editor.SelectedNodeId = PromptFactoryPageHelpers.TryParsePromptCanvasNodeId(canvasNodeId, out var nodeId) ? nodeId : null;
        SyncSelectedPromptNodeDraft();
        await PersistCanvasUiStateAsync();
    }

    private void SyncSelectedPromptNodeDraft()
    {
        if (selectedPromptNode is null)
        {
            selectedPromptNodeTitle = string.Empty;
            selectedPromptNodeNotes = string.Empty;
            selectedPromptNodeState = PromptRunNodeState.Prepared;
            return;
        }

        selectedPromptNodeTitle = selectedPromptNode.Title;
        selectedPromptNodeNotes = selectedPromptNode.Notes;
        selectedPromptNodeState = selectedPromptNode.State;
    }

    private async Task MoveToStepAsync(int stepIndex)
    {
        editor.WizardStepIndex = Math.Clamp(stepIndex, 0, wizardSteps.Length - 1);
        activeInspectorTab = editor.WizardStepIndex switch
        {
            1 => "governance",
            2 => "assembly",
            3 => "review",
            _ => "context"
        };

        await PersistCanvasUiStateAsync();
        if (editor.SessionId.HasValue)
        {
            await PromptFactoryService.SaveSessionStateAsync(editor);
        }
    }

    private void ToggleBlock(Guid id, bool isSelected)
    {
        RememberHistoryCheckpoint();
        editor.HasCustomizedBlocks = true;
        if (isSelected)
        {
            if (!editor.SelectedBlockIds.Contains(id))
            {
                editor.SelectedBlockIds.Add(id);
            }

            return;
        }

        editor.SelectedBlockIds.Remove(id);
        RefreshCanvasSurface();
    }

    private void ToggleResource(Guid id, bool isSelected)
    {
        RememberHistoryCheckpoint();
        if (isSelected)
        {
            if (!editor.SelectedResourceIds.Contains(id))
            {
                editor.SelectedResourceIds.Add(id);
            }

            return;
        }

        editor.SelectedResourceIds.Remove(id);
        RefreshCanvasSurface();
    }

    private async Task EditBlockAsync(Guid blockId)
    {
        blockEditor = await PromptFactoryService.GetBlockEditorAsync(blockId);
        blockAdminExpanded = true;
    }

    private async Task SaveBlockAsync()
    {
        var result = await PromptFactoryService.SaveBlockAsync(blockEditor);
        if (result.IsFailure)
        {
            SetError(result.Errors);
            return;
        }

        blocks = await PromptFactoryService.ListBlocksAsync();
        blockEditor = await PromptFactoryService.GetBlockEditorAsync(result.Value);
        SetMessage("Shared block saved.");
    }

    private void CreateNewBlock()
    {
        blockEditor = new PromptBlockEditorModel();
        blockAdminExpanded = true;
    }

    private async Task EditTemplateAsync(Guid templateId)
    {
        templateEditor = await PromptFactoryService.GetTemplateEditorAsync(templateId);
        templateAdminExpanded = true;
    }

    private async Task SaveTemplateAsync()
    {
        var result = await PromptFactoryService.SaveTemplateAsync(templateEditor);
        if (result.IsFailure)
        {
            SetError(result.Errors);
            return;
        }

        templates = await PromptFactoryService.ListTemplatesAsync();
        templateEditor = await PromptFactoryService.GetTemplateEditorAsync(result.Value);

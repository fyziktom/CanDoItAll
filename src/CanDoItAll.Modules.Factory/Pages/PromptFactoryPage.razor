                        <div class="cw-list">
                            @foreach (var block in blocks)
                            {
                                <label class="cw-list-item">
                                    <strong>@block.Name</strong>
                                    <span>@block.BlockKind</span>
                                    <input type="checkbox"
                                           checked="@templateEditor.SelectedBlockIds.Contains(block.Id)"
                                           @onchange="args => ToggleTemplateBlock(block.Id, ReadCheckboxValue(args))" />

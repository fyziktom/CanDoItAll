                    @if (IsReviewView(ReviewViewDelivery))
                    {
                    <section class="cw-panel-card">
                        <p class="cw-panel-kicker">Delivery context</p>
                        <h3 class="cw-panel-title">What will ship</h3>
                        <div class="cw-summary-grid">
                            <div class="cw-summary-tile">
                                <span>Blocks</span>
                                <strong>@editor.SelectedBlockIds.Count</strong>
                            </div>
                            <div class="cw-summary-tile">
                                <span>Resources</span>
                                <strong>@editor.SelectedResourceIds.Count</strong>
                            </div>
                            <div class="cw-summary-tile">
                                <span>Inputs</span>
                                <strong>@editor.SessionAttachments.Count</strong>
                            </div>
                            <div class="cw-summary-tile">
                                <span>Provider</span>
                                <strong>@ResolveSelectedProviderName()</strong>
                            </div>
                        </div>
                    </section>
                    }

                    @if (IsReviewView(ReviewViewPreview))
                    {
                    <section class="cw-panel-card pf-wide-card">
                        <p class="cw-panel-kicker">Prompt review</p>
                        <h3 class="cw-panel-title">Generated prompt</h3>
                        <div class="cw-form-field">
                            <label>Prompt preview</label>
                            <textarea class="cw-textarea pf-prompt-preview" @bind="editor.GeneratedPrompt"></textarea>
                        </div>
                    </section>
                    }
                }

                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <section class="cw-panel-card pf-wide-card">
                        <p class="cw-panel-kicker">Latest action</p>
                        <p class="@(isError ? "text-sm text-rose-700" : "text-sm text-emerald-700")">@message</p>
                    </section>
                }

                @* Legacy supporting layout retired after staged UX redesign.
                {
                <div class="cw-panel-card">
                    <p class="cw-panel-kicker">Governed blocks</p>
                    <h3 class="cw-panel-title">Prompt block selection</h3>
                    <div class="cw-button-row">
                        <button type="button" class="cw-button" data-tone="accent" @onclick="ApplyRecommendationsAsync">Apply recommendations</button>
                        <button type="button" class="cw-button" data-tone="ghost" @onclick="CreateNewBlock">New block</button>
                    </div>

                    <div class="cw-list">
                        @foreach (var block in blocks)
                        {
                            <label class="cw-list-item">
                                <strong>@block.Name</strong>
                                <span>@block.BlockKind · @block.Summary</span>
                                <input type="checkbox"
                                       checked="@editor.SelectedBlockIds.Contains(block.Id)"
                                       @onchange="args => ToggleBlock(block.Id, ReadCheckboxValue(args))" />
                            </label>
                        }
                    </div>

                    <div class="cw-form-grid">
                        <div class="cw-form-field">
                            <label>Block name</label>
                            <input class="cw-text-input" @bind="blockEditor.Name" />

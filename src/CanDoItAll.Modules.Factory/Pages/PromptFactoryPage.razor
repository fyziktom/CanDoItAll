    private void ToggleTemplateBlock(Guid id, bool isSelected)
    {
        if (isSelected)
        {
            if (!templateEditor.SelectedBlockIds.Contains(id))
            {
                templateEditor.SelectedBlockIds.Add(id);
            }

            return;
        }

        templateEditor.SelectedBlockIds.Remove(id);
    }

    private void NavigateToSession(Guid? sessionId, bool showPromptPreview = false)
    {
        if (!sessionId.HasValue)
        {
            return;
        }

        var targetRoute = BuildPromptFactoryRoute(sessionId.Value, showPromptPreview);
        var absoluteTargetRoute = Navigation.ToAbsoluteUri(targetRoute).ToString();
        if (!string.Equals(Navigation.Uri, absoluteTargetRoute, StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo(targetRoute);
        }
    }

    private void OpenPromptArtifact(Guid promptId) => Navigation.NavigateTo($"/prompt-gallery?promptId={promptId}");

    private void SetMessage(string value)
    {
        message = value;
        isError = false;
    }

    private void SetError(IEnumerable<Error> errors)
    {
        message = string.Join(" ", errors.Select(error => error.Message));
        isError = true;
    }

    private static bool TryParsePromptCanvasNodeId(string? canvasNodeId, out Guid nodeId)
    {
        nodeId = Guid.Empty;
        return !string.IsNullOrWhiteSpace(canvasNodeId) &&
               canvasNodeId.StartsWith("node:", StringComparison.Ordinal) &&
               Guid.TryParse(canvasNodeId["node:".Length..], out nodeId);
    }

    private static string ResolveBranchLabel(string canvasNodeId)
        => canvasNodeId.StartsWith("branch:", StringComparison.Ordinal)
            ? canvasNodeId["branch:".Length..].Replace('-', ' ')
            : "Branch";

    private static string ResolvePromptNodeAccent(PromptRunNodeState state) => state switch
    {
        PromptRunNodeState.Validated => "#059669",
        PromptRunNodeState.Used => "#0284c7",
        PromptRunNodeState.Failed => "#e11d48",
        PromptRunNodeState.Skipped or PromptRunNodeState.Superseded => "#f97316",
        _ => "#7c3aed"
    };

    private static string ResolvePromptNodePalette(PromptRunNodeState state) => state switch
    {
        PromptRunNodeState.Validated => "mint",
        PromptRunNodeState.Used => "sky",
        PromptRunNodeState.Failed => "rose",
        PromptRunNodeState.Skipped or PromptRunNodeState.Superseded => "amber",
        _ => "violet"
    };

    private static bool ReadCheckboxValue(ChangeEventArgs args) => args.Value switch
    {
        bool value => value,
        string text when bool.TryParse(text, out var value) => value,
        _ => false
    };
}

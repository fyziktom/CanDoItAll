    private string? selectedCanvasNodeId => selectedCanvasNodeIds.FirstOrDefault();

    private PromptRunNodeSummary? selectedPromptNode => TryParsePromptCanvasNodeId(selectedCanvasNodeId, out var nodeId)
        ? editor.Nodes.FirstOrDefault(node => node.Id == nodeId)
        : null;

    private string? selectedBranchLabel => selectedCanvasNodeId is { } canvasNodeId && canvasNodeId.StartsWith("branch:", StringComparison.Ordinal)
        ? ResolveBranchLabel(canvasNodeId)
        : null;

    private IReadOnlyList<PromptRunNodeSummary> selectedBranchNodes => selectedBranchLabel is null
        ? []
        : editor.Nodes
            .Where(node => string.Equals(node.BranchLabel, selectedBranchLabel, StringComparison.OrdinalIgnoreCase) ||
                           string.Equals(node.BranchKey, selectedBranchLabel, StringComparison.OrdinalIgnoreCase))
            .OrderBy(node => node.Sequence)
            .ToList();

    protected override async Task OnParametersSetAsync()
        => await LoadAsync(SessionIdQuery, RunIdQuery);

    private async Task LoadAsync(Guid? sessionId = null, Guid? runId = null)
    {
        projects = await ProjectsService.ListAsync();
        providers = await WorkspaceService.ListProviderProfilesAsync();
        blocks = await PromptFactoryService.ListBlocksAsync();
        templates = await PromptFactoryService.ListTemplatesAsync();
        blueprints = await PromptFactoryService.ListBlueprintsAsync();
        libraryCatalog = await PromptFactoryService.GetLibraryCatalogAsync();
        editor = await PromptFactoryService.GetEditorAsync(sessionId, runId);
        if (string.IsNullOrWhiteSpace(editor.SessionName))
        {
            editor.SessionName = "Prompt session";
        }

        if (string.IsNullOrWhiteSpace(editor.DraftTitle))
        {
            editor.DraftTitle = "Prompt Factory Draft";
        }

        if (string.IsNullOrWhiteSpace(editor.CanvasUiStateJson))
        {
            editor.CanvasUiStateJson = "{}";
        }

        await LoadResourcesAsync();
        HydrateCanvasSelection();
        RefreshCanvasSurface();
        SyncSelectedPromptNodeDraft();
        showPromptPreviewDialog = ShowPromptPreviewQuery && !string.IsNullOrWhiteSpace(editor.GeneratedPrompt);
    }

    private void HydrateCanvasSelection(string? preferredCanvasNodeId = null)
    {
        var uiState = CanvasWorkbenchUiState.Parse(editor.CanvasUiStateJson);
        activeInspectorTab = string.IsNullOrWhiteSpace(uiState.ActiveInspectorTab) ? "context" : uiState.ActiveInspectorTab;

        if (!string.IsNullOrWhiteSpace(preferredCanvasNodeId))
        {
            selectedCanvasNodeIds = [preferredCanvasNodeId];
        }
        else if (uiState.SelectedNodeIds.Count > 0)
        {
            selectedCanvasNodeIds = uiState.SelectedNodeIds.ToList();
        }
        else if (editor.SelectedNodeId.HasValue)
        {
            selectedCanvasNodeIds = [$"node:{editor.SelectedNodeId.Value:N}"];
        }
        else
        {
            selectedCanvasNodeIds = ["session-root"];
        }
    }

    private void RefreshCanvasSurface()
    {
        var uiState = CanvasWorkbenchUiState.Parse(editor.CanvasUiStateJson);
        uiState.SelectedNodeIds = [.. selectedCanvasNodeIds];
        uiState.ActiveInspectorTab = activeInspectorTab;
        editor.CanvasUiStateJson = uiState.ToJson();
        var sessionActions = PromptFactoryCanvasCatalog.BuildSessionContextActions(libraryCatalog).ToList();

        canvasSurface = new CanvasWorkbenchSurface
        {
            SurfaceId = editor.SessionId.HasValue ? $"prompt-session:{editor.SessionId.Value:N}" : "prompt-session:draft",
            Mode = "authoring",
            UiState = uiState,
            Chrome = new CanvasWorkbenchChrome
            {
                HintText = "Click to inspect a step, Alt-drag to multi-select, drag to move, and use the same shared canvas vocabulary as project structure.",
                FocusActionLabel = "Focus session",
                QuickCreateActions = sessionActions
            },
            Nodes = BuildCanvasNodes(),
            Links = BuildCanvasLinks()
        };
    }

    private List<CanvasWorkbenchNode> BuildCanvasNodes()
    {
        var nodes = new List<CanvasWorkbenchNode>
        {
            new()
            {
                Id = "session-root",
                Family = "root",
                Kind = "session",
                Icon = "PF",
                Title = string.IsNullOrWhiteSpace(editor.SessionName) ? "Prompt session" : editor.SessionName,
                Subtitle = string.IsNullOrWhiteSpace(editor.Phase) ? "Phase not selected" : editor.Phase,
                LeadText = string.IsNullOrWhiteSpace(editor.DraftTitle) ? "Build the session to materialize prompt steps." : editor.DraftTitle,
                Status = "Session",
                StatusPill = string.IsNullOrWhiteSpace(editor.Phase) ? "Draft" : editor.Phase,
                AccentColor = "#111827",
                PaletteKey = "violet",
                IsRequired = true,
                IsCollapsible = true,
                X = 210,
                Y = 250,
                Chips =
                [
                    new CanvasWorkbenchChip { Text = editor.ProjectId.HasValue ? "Project linked" : "No project", Tone = editor.ProjectId.HasValue ? "success" : "warning" },
                    new CanvasWorkbenchChip { Text = editor.ProviderProfileId.HasValue ? "Provider set" : "Provider pending", Tone = editor.ProviderProfileId.HasValue ? "accent" : "warning" }
                ],
                FooterChips =
                [
                    new CanvasWorkbenchChip { Text = $"{editor.SelectedBlockIds.Count} components", Tone = "accent" },
                    new CanvasWorkbenchChip { Text = $"{editor.SessionAttachments.Count} inputs", Tone = "success" }
                ],
                ContextActions = PromptFactoryCanvasCatalog.BuildSessionContextActions(libraryCatalog).ToList()
            }
        };

        var selectionGraph = BuildSelectionGraph();
        nodes.AddRange(selectionGraph.Nodes);

        var positions = new Dictionary<string, (double X, double Y)>
        {
            ["session-root"] = (210, 250)
        };

        var groupedNodes = editor.Nodes.Count == 0
            ? [new { BranchKey = "main", BranchLabel = "Main", Items = new List<PromptRunNodeSummary>() }]
            : editor.Nodes
                .GroupBy(node => node.BranchKey)
                .OrderBy(group => string.Equals(group.Key, "main", StringComparison.OrdinalIgnoreCase) ? 0 : 1)
                .ThenBy(group => group.Key, StringComparer.OrdinalIgnoreCase)
                .Select(group => new
                {
                    BranchKey = group.Key,
                    BranchLabel = string.IsNullOrWhiteSpace(group.First().BranchLabel) ? group.Key : group.First().BranchLabel,
                    Items = group.OrderBy(item => item.Sequence).ToList()
                })
                .ToArray();

        var branchOffset = 0;
        foreach (var branch in groupedNodes)
        {
            var groupId = $"branch:{branch.BranchKey}";
            string parentCanvasId = "session-root";
            double baseX = 1040;
            double baseY = 200 + (branchOffset * 140);

            var firstBranchItem = branch.Items.FirstOrDefault(item => item.ParentNodeId.HasValue);
            if (firstBranchItem?.ParentNodeId is Guid parentNodeId &&
                positions.TryGetValue($"node:{parentNodeId:N}", out var parentPosition))
            {
                parentCanvasId = $"node:{parentNodeId:N}";
                baseX = parentPosition.X + 120;
                baseY = parentPosition.Y + 190 + (branchOffset * 20);
            }
            else if (string.Equals(branch.BranchKey, "main", StringComparison.OrdinalIgnoreCase))
            {
                branchOffset = 0;
            }

            positions[groupId] = (baseX, baseY);
            nodes.Add(new CanvasWorkbenchNode
            {
                Id = groupId,
                ParentId = parentCanvasId,
                Family = "group",
                Kind = "branch",
                Icon = "BR",
                Title = branch.BranchLabel,
                Subtitle = branch.BranchKey,
                LeadText = branch.Items.Count == 0 ? "Build the prompt to materialize steps in this branch." : $"{branch.Items.Count} step(s) in this branch.",
                Status = "Branch",
                StatusPill = branch.Items.Count == 0 ? "Ready" : $"{branch.Items.Count} steps",
                AccentColor = "#8b5cf6",
                PaletteKey = "violet",
                IsRequired = true,
                IsCollapsible = branch.Items.Count > 0,
                X = baseX,
                Y = baseY,
                Chips =
                [
                    new CanvasWorkbenchChip { Text = string.Equals(branch.BranchKey, "main", StringComparison.OrdinalIgnoreCase) ? "Primary" : "Follow-up", Tone = "accent" }
                ],
                FooterChips =
                [
                    new CanvasWorkbenchChip { Text = branch.Items.Count == 0 ? "No steps yet" : $"{branch.Items.Count} steps", Tone = branch.Items.Count == 0 ? "warning" : "success" }
                ],
                ContextActions =
                [
                    new CanvasWorkbenchAction { ActionId = "build-flow", Label = "Build", Icon = "flow", Tone = "mint" },
                    new CanvasWorkbenchAction { ActionId = "branch-selected", Label = "Branch", Icon = "fork", Tone = "warn" }
                ]
            });

            var stepIndex = 0;
            foreach (var node in branch.Items)
            {
                var nodeId = $"node:{node.Id:N}";
                var x = baseX + 290 + (stepIndex * 238);
                var y = baseY + (string.Equals(branch.BranchKey, "main", StringComparison.OrdinalIgnoreCase) ? 0 : stepIndex * 84);
                positions[nodeId] = (x, y);

                nodes.Add(new CanvasWorkbenchNode
                {
                    Id = nodeId,
                    ParentId = groupId,
                    Family = "item",
                    Kind = "prompt step",
                    Icon = "ST",
                    Title = node.Title,
                    Subtitle = $"{node.BranchLabel} · step {node.Sequence}",
                    LeadText = string.IsNullOrWhiteSpace(node.Notes) ? "Prompt step ready for review." : node.Notes,
                    Status = node.State.ToString(),
                    BranchLabel = node.BranchLabel,
                    AccentColor = ResolvePromptNodeAccent(node.State),
                    PaletteKey = ResolvePromptNodePalette(node.State),
                    StatusPill = node.State.ToString(),
                    IsRequired = true,
                    X = x,
                    Y = y,
                    Chips =
                    [
                        new CanvasWorkbenchChip { Text = node.BranchKey, Tone = "accent" }
                    ],
                    FooterChips =
                    [
                        new CanvasWorkbenchChip { Text = node.PromptArtifactId.HasValue ? "Artifact" : "Draft only", Tone = node.PromptArtifactId.HasValue ? "success" : "warning" },
                        new CanvasWorkbenchChip { Text = node.ParentNodeId.HasValue ? "Derived" : "Primary", Tone = "neutral" }
                    ],
                    ContextActions = BuildPromptNodeActions(node)
                });

                stepIndex++;
            }

            branchOffset++;
        }

        return nodes;
    }

    private List<CanvasWorkbenchLink> BuildCanvasLinks()
    {
        var selectionGraph = BuildSelectionGraph();
        var links = selectionGraph.Links.ToList();
        links.Add(new CanvasWorkbenchLink { SourceId = "session-root", TargetId = "branch:main", Kind = "contains", IsUserAuthored = false });

        foreach (var node in editor.Nodes)
        {
            var nodeCanvasId = $"node:{node.Id:N}";
            var branchCanvasId = $"branch:{node.BranchKey}";
            links.Add(new CanvasWorkbenchLink
            {
                SourceId = branchCanvasId,
                TargetId = nodeCanvasId,
                Kind = "contains",
                IsUserAuthored = false
            });

            if (node.ParentNodeId.HasValue)
            {
                links.Add(new CanvasWorkbenchLink
                {
                    SourceId = $"node:{node.ParentNodeId.Value:N}",
                    TargetId = branchCanvasId,
                    Kind = "derived",
                    IsUserAuthored = true
                });
            }
        }

        return links
            .GroupBy(link => $"{link.SourceId}|{link.TargetId}|{link.Kind}", StringComparer.Ordinal)
            .Select(group => group.First())
            .ToList();
    }

    private static List<CanvasWorkbenchAction> BuildPromptNodeActions(PromptRunNodeSummary node) =>
    [
        new() { ActionId = "branch", Label = "Branch", Icon = "fork", Tone = "accent" },
        new() { ActionId = "mark-used", Label = "Used", Icon = "use", Tone = "mint" },
        new() { ActionId = "validate-node", Label = "Validate", Icon = "qa", Tone = "mint" },
        new() { ActionId = "skip-node", Label = "Skip", Icon = "skip", Tone = "warn" },
        new() { ActionId = "open-prompt", Label = "Open", Icon = "open", Tone = "ghost" }
    ];

    private string ResolveStageTitle()
        => string.IsNullOrWhiteSpace(editor.SessionName) ? "Prompt flow canvas" : editor.SessionName;

    private IEnumerable<(string Title, string Subtitle)> ResolveSelectedCanvasLabels()
    {
        foreach (var selectedId in selectedCanvasNodeIds)
        {
            if (selectedId == BlueprintCanvasNodeId && selectedBlueprintNode is not null)
            {
                yield return (selectedBlueprintNode.Name, selectedBlueprintNode.PromptType);
                continue;
            }

            if (selectedId == FlowCanvasNodeId && selectedFlowNode is not null)
            {
                yield return (selectedFlowNode.Name, $"{selectedFlowNode.AgentSequence.Count} agent step(s)");
                continue;
            }

            if (TryParseSelectedComponentNodeId(selectedId, out var blockKey) &&
                blocks.FirstOrDefault(item => string.Equals(item.Key, blockKey, StringComparison.OrdinalIgnoreCase)) is { } selectedBlock)
            {
                yield return (selectedBlock.Name, ResolveLibraryGroupLabel(selectedBlock.GroupKey));
                continue;
            }

            if (TryParseSelectedInputNodeId(selectedId, out var attachmentId) &&
                editor.SessionAttachments.FirstOrDefault(item => string.Equals(item.Id, attachmentId, StringComparison.OrdinalIgnoreCase)) is { } selectedAttachment)
            {
                yield return (selectedAttachment.Title, selectedAttachment.Kind);
                continue;
            }

            if (TryParseComponentGroupNodeId(selectedId, out var groupKey))
            {
                yield return (ResolveLibraryGroupLabel(groupKey), "Component group");
                continue;
            }

            if (TryParsePromptCanvasNodeId(selectedId, out var nodeId) &&
                editor.Nodes.FirstOrDefault(node => node.Id == nodeId) is { } promptNode)
            {
                yield return (promptNode.Title, $"{promptNode.BranchLabel} · {promptNode.State}");
                continue;
            }

            if (selectedId == "session-root")
            {
                yield return ("Prompt session", string.IsNullOrWhiteSpace(editor.Phase) ? "Session root" : editor.Phase);
                continue;
            }

            yield return (ResolveBranchLabel(selectedId), "Branch group");
        }
    }

    private async Task HandleProjectChangedAsync()
    {
        if (editor.ProjectId.HasValue && string.IsNullOrWhiteSpace(editor.Phase))
        {
            var project = await ProjectsService.GetAsync(editor.ProjectId.Value);
            editor.Phase = project.CurrentPhase;
        }

        await LoadResourcesAsync();
        RefreshCanvasSurface();
    }

    private async Task HandleProjectSelectionChangedAsync(ChangeEventArgs args)
    {
        editor.ProjectId = ParseOptionalGuid(args.Value);
        await HandleProjectChangedAsync();
    }

    private async Task HandleBlueprintChangedAsync()
    {
        var blueprint = blueprints.FirstOrDefault(item => item.Id == editor.BlueprintId);
        if (blueprint?.RecommendedFlowTemplateId is not null)
        {
            editor.FlowTemplateId = blueprint.RecommendedFlowTemplateId;
        }

        await ApplyRecommendationsAsync();
    }

    private async Task HandleBlueprintSelectionChangedAsync(ChangeEventArgs args)
    {
        editor.BlueprintId = ParseOptionalGuid(args.Value);
        await HandleBlueprintChangedAsync();
    }

    private Task HandleFlowTemplateSelectionChangedAsync(ChangeEventArgs args)
    {
        editor.FlowTemplateId = ParseOptionalGuid(args.Value);
        RefreshCanvasSurface();
        return Task.CompletedTask;
    }

    private Task HandleProviderSelectionChangedAsync(ChangeEventArgs args)
    {
        editor.ProviderProfileId = ParseOptionalGuid(args.Value);
        RefreshCanvasSurface();
        return Task.CompletedTask;
    }

    private static Guid? ParseOptionalGuid(object? value)
        => value is null || string.IsNullOrWhiteSpace(value.ToString())
            ? null
            : Guid.TryParse(value.ToString(), out var parsed)
                ? parsed
                : null;

    private async Task LoadResourcesAsync()
    {
        var resources = await ResourcesService.ListAsync();
        projectResources = editor.ProjectId.HasValue
            ? resources.Where(resource => resource.ProjectId == editor.ProjectId.Value).ToList()
            : [];
    }

    private async Task ApplyRecommendationsAsync()
    {
        RememberHistoryCheckpoint();
        editor.SelectedBlockIds = (await PromptFactoryService.GetRecommendedBlockIdsAsync(editor.BlueprintId, editor.FlowTemplateId, editor.Phase)).ToList();
        editor.HasCustomizedBlocks = false;
        RefreshCanvasSurface();
        SetMessage("Recommended shared blocks applied.");
    }

    private async Task SaveSessionStateAsync()
    {
        var result = await PromptFactoryService.SaveSessionStateAsync(editor);
        if (result.IsFailure)
        {
            SetError(result.Errors);
            return;
        }

        editor = result.Value!;
        await LoadResourcesAsync();
        HydrateCanvasSelection();
        RefreshCanvasSurface();
        SyncSelectedPromptNodeDraft();
        NavigateToSession(editor.SessionId);
        SetMessage("Prompt session state saved.");
    }

    private async Task BuildAsync()
    {
        RememberHistoryCheckpoint();
        var result = await PromptFactoryService.BuildAsync(editor);
        if (result.IsFailure)
        {
            SetError(result.Errors);
            return;
        }

        editor = result.Value!;
        await LoadResourcesAsync();
        HydrateCanvasSelection(editor.Nodes.Count > 0 ? $"node:{editor.Nodes[0].Id:N}" : "session-root");
        RefreshCanvasSurface();
        SyncSelectedPromptNodeDraft();
        showPromptPreviewDialog = !string.IsNullOrWhiteSpace(editor.GeneratedPrompt);
        if (editor.SessionId.HasValue && SessionIdQuery != editor.SessionId)
        {
            NavigateToSession(editor.SessionId, showPromptPreview: true);
        }
        SetMessage("Prompt built.");
    }


                            <div class="cw-summary-tile">
                                <span>Selected resources</span>
                                <strong>@editor.SelectedResourceIds.Count</strong>
                            </div>
                            <div class="cw-summary-tile">
                                <span>Selected blocks</span>
                                <strong>@editor.SelectedBlockIds.Count</strong>

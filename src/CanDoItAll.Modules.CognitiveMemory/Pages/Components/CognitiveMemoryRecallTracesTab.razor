@namespace CanDoItAll.Modules.CognitiveMemory.Pages

@if (Page.snapshot is { } snapshot)
{
                        <Grid Gap="LayoutGap.Large"
                              Class="cognitive-memory-layout"
                              ColumnTemplateXl="minmax(20rem,0.8fr) minmax(0,1.2fr)"
                              data-testid="cognitive-memory-trace-viewer">
                            <SurfaceCard>
                                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Trace list" />
                                <h2 class="cognitive-memory-card-title">Recent recall traces</h2>
                                @if (snapshot.RecallTraces.Count == 0)
                                {
                                    <EmptyState Eyebrow="No traces"
                                                Title="No recall traces yet"
                                                Description="Run recall-backed workflows to populate staged trace evidence." />
                                }
                                else
                                {
                                    <Stack GapScale="LayoutGap.Small" Class="mt-4">
                                        @foreach (var trace in snapshot.RecallTraces)
                                        {
                                            <SelectionListItem Title="@($"{CognitiveMemoryPage.FormatLabel(trace.RecallMode)} / {CognitiveMemoryPage.FormatLabel(trace.Outcome)}")"
                                                               Meta="@CognitiveMemoryPage.FormatDate(trace.StartedAtUtc)"
                                                               Summary="@($"{trace.IncludedRecordCount} included, {trace.ExcludedRecordCount} excluded, {trace.InhibitedCandidateCount} inhibited")"
                                                               Dense="true"
                                                               IsSelected="@(Page.selectedRecallTraceId == trace.Id)"
                                                               DataTestId="@($"cognitive-memory-trace-{trace.Id:N}")"
                                                               OnSelect="@(() => Page.SelectRecallTrace(trace.Id))">
                                                <Status>
                                                    <StatusBadge Tone="@CognitiveMemoryPage.RunTone(trace.Outcome)" Text="@CognitiveMemoryPage.FormatLabel(trace.Outcome)" />
                                                </Status>
                                            </SelectionListItem>
                                        }
                                    </Stack>
                                    @Page.CollectionPager(CognitiveMemoryReviewUiCollectionKind.RecallTraces)
                                }
                            </SurfaceCard>

                            <SurfaceCard>
                                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Trace detail" />
                                <h2 class="cognitive-memory-card-title">Stage, candidate, and source evidence</h2>
                                @Page.RecallTraceDetail()
                            </SurfaceCard>
                        </Grid>
}

@code {
    [CascadingParameter]
    internal CognitiveMemoryPage Page { get; set; } = default!;
}


@namespace CanDoItAll.Modules.CognitiveMemory.Pages

@if (Page.snapshot is { })
{
    <Grid Gap="LayoutGap.Large"
          Class="cognitive-memory-layout cognitive-memory-curator"
          ColumnTemplateXl="minmax(22rem,0.75fr) minmax(0,1.25fr)"
          data-testid="cognitive-memory-curator-tab">
        <SurfaceCard data-testid="cognitive-memory-curator-session-card">
            <Split Gap="LayoutGap.Small"
                   AlignItems="AlignItems.Start">
                <div>
                    <TextBlock TextStyle="TextStyle.Eyebrow" Value="Curator" />
                    <h2 class="cognitive-memory-card-title">Conversation session</h2>
                </div>
                <StatusBadge Tone="@(Page.HasActiveCuratorSession ? "info" : "secondary")"
                             Text="@(Page.HasActiveCuratorSession ? "Active" : "No session")" />
            </Split>

            <Stack GapScale="LayoutGap.Medium" Class="mt-4">
                <div class="cognitive-memory-facts">
                    @CognitiveMemoryPage.RenderFactFragment("Project", Page.CuratorProjectScopeText)
                    @CognitiveMemoryPage.RenderFactFragment("Session", Page.ActiveCuratorSessionTitle)
                    @CognitiveMemoryPage.RenderFactFragment("State", Page.ActiveCuratorSessionMeta)
                </div>

                <label class="cognitive-memory-field">
                    <span>Session title</span>
                    <InputText class="cda-input"
                               @bind-Value="Page.curatorSessionTitle"
                               data-testid="cognitive-memory-curator-session-title" />
                </label>

                <label class="cognitive-memory-field">
                    <span>Runtime mode</span>
                    <InputSelect class="cda-input"
                                 @bind-Value="Page.curatorRuntimeMode"
                                 data-testid="cognitive-memory-curator-mode">
                        @foreach (var mode in Enum.GetValues<CognitiveMemoryCuratorRuntimeMode>())
                        {
                            <option value="@mode">@CognitiveMemoryPage.FormatLabel(mode)</option>
                        }
                    </InputSelect>
                </label>

                <label class="cognitive-memory-field">
                    <span>Response length</span>
                    <InputSelect class="cda-input"
                                 @bind-Value="Page.curatorConversationDepth"
                                 data-testid="cognitive-memory-curator-depth">
                        @foreach (var depth in Enum.GetValues<CognitiveMemoryCuratorConversationDepth>())
                        {
                            <option value="@depth">@CognitiveMemoryPage.FormatLabel(depth)</option>
                        }
                    </InputSelect>
                </label>

                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                    <Button Text="Start"
                            Icon="play_arrow"
                            ButtonStyle="ButtonStyle.Primary"
                            Size="ButtonSize.Small"
                            Disabled="@(!Page.CanStartCurator)"
                            IsBusy="@Page.isBusy"
                            Click="Page.StartCuratorSessionAsync"
                            data-testid="cognitive-memory-curator-start" />
                    <Button Text="Refresh"
                            Icon="refresh"
                            ButtonStyle="ButtonStyle.Light"
                            Size="ButtonSize.Small"
                            Disabled="@Page.isBusy"
                            Click="Page.RefreshAsync"
                            data-testid="cognitive-memory-curator-refresh" />
                </Cluster>
            </Stack>
        </SurfaceCard>

        <SurfaceCard data-testid="cognitive-memory-curator-compose-card">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Dialogue" />
            <h2 class="cognitive-memory-card-title">Talk with the curator</h2>
            <Stack GapScale="LayoutGap.Medium" Class="mt-4">
                <label class="cognitive-memory-field">
                    <span>Message</span>
                    <InputTextArea class="cda-input cda-input--textarea cognitive-memory-curator-message"
                                   @bind-Value="Page.curatorMessage"
                                   data-testid="cognitive-memory-curator-message" />
                </label>
                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                    <Button Text="Send"
                            Icon="send"
                            ButtonStyle="ButtonStyle.Primary"
                            Size="ButtonSize.Small"
                            Disabled="@(!Page.CanSendCurator)"
                            IsBusy="@Page.isBusy"
                            Click="Page.SendCuratorMessageFromUiAsync"
                            data-testid="cognitive-memory-curator-send" />
                    <Button Text="Audio mode"
                            Icon="hearing"
                            ButtonStyle="@(Page.curatorVoiceModeEnabled ? ButtonStyle.Info : ButtonStyle.Light)"
                            Size="ButtonSize.Small"
                            Disabled="@Page.isBusy"
                            Click="Page.ToggleCuratorVoiceModeAsync"
                            data-testid="cognitive-memory-curator-voice-mode" />
                    <Button Text="@(Page.curatorVoiceRecording ? "Stop recording" : "Talk")"
                            Icon="@(Page.curatorVoiceRecording ? "stop" : "mic")"
                            ButtonStyle="ButtonStyle.Light"
                            Size="ButtonSize.Small"
                            Disabled="@(!Page.curatorVoiceModeEnabled || !Page.CanUseCuratorVoice)"
                            IsBusy="@Page.curatorVoiceTranscribing"
                            Click="Page.ToggleCuratorRecordingAsync"
                            data-testid="cognitive-memory-curator-voice-record" />
                    <StatusBadge Tone="info"
                                 Text="@Page.curatorStatus"
                                 data-testid="cognitive-memory-curator-status" />
                    <StatusBadge Tone="@Page.curatorVoiceStatusTone"
                                 Text="@Page.curatorVoiceStatus"
                                 data-testid="cognitive-memory-curator-voice-status" />
                </Cluster>
            </Stack>
        </SurfaceCard>
    </Grid>

    <Grid Gap="LayoutGap.Large"
          Class="cognitive-memory-layout cognitive-memory-curator-result-grid"
          ColumnTemplateXl="minmax(0,1.2fr) minmax(22rem,0.8fr)">
        <SurfaceCard data-testid="cognitive-memory-curator-transcript">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Transcript" />
            <h2 class="cognitive-memory-card-title">Conversation</h2>
            @if (Page.curatorTurns.Count == 0)
            {
                <EmptyState Eyebrow="No turns"
                            Title="No curator conversation yet"
                            Description="Curator turns appear here after text or voice messages are sent." />
            }
            else
            {
                <div class="cognitive-memory-list mt-4">
                    @foreach (var turn in Page.curatorTurns)
                    {
                        <article class="cognitive-memory-row cognitive-memory-curator-turn"
                                 data-testid="@($"cognitive-memory-curator-turn-{turn.Sequence}")">
                            <strong>@($"Turn {turn.Sequence} / {CognitiveMemoryPage.FormatLabel(turn.RuntimeMode)} / {CognitiveMemoryPage.FormatLabel(turn.ConversationDepth)}")</strong>
                            <small>@($"{turn.IncludedMemoryRecordCount} included memory record(s) / {CognitiveMemoryPage.FormatDate(turn.CreatedAtUtc)}")</small>
                            <p class="cognitive-memory-review-memory-text">@turn.UserMessage</p>
                            <p class="cognitive-memory-review-memory-text">@turn.CuratorResponse</p>
                            @if (turn.RecallTraceId is { } traceId)
                            {
                                <small>@($"Trace {CognitiveMemoryPage.FormatShortId(traceId)}")</small>
                            }
                            @if (turn.Warnings.Count > 0)
                            {
                                <section class="cognitive-memory-section">
                                    <h3>Warnings</h3>
                                    <div class="cognitive-memory-list">
                                        @foreach (var warning in turn.Warnings)
                                        {
                                            <div class="cognitive-memory-row">
                                                <strong>Warning</strong>
                                                <span>@warning</span>
                                            </div>
                                        }
                                    </div>
                                </section>
                            }
                            @if (turn.Captures.Count > 0)
                            {
                                <section class="cognitive-memory-section">
                                    <h3>Captured improvements</h3>
                                    <div class="cognitive-memory-list">
                                        @foreach (var capture in turn.Captures)
                                        {
                                            <div class="cognitive-memory-row">
                                                <strong>@CognitiveMemoryPage.FormatLabel(capture.CaptureKind)</strong>
                                                <StatusBadge Tone="@CognitiveMemoryPage.CuratorCaptureTone(capture.Status)"
                                                             Text="@CognitiveMemoryPage.FormatLabel(capture.Status)" />
                                                <span>@CognitiveMemoryPage.FirstNonEmpty(capture.Summary, "No capture summary.")</span>
                                            </div>
                                        }
                                    </div>
                                </section>
                            }
                        </article>
                    }
                </div>
            }
        </SurfaceCard>

        <SurfaceCard data-testid="cognitive-memory-curator-captures">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Memory updates" />
            <h2 class="cognitive-memory-card-title">Trusted capture state</h2>
            @if (Page.lastCuratorSendResult is null)
            {
                <EmptyState Eyebrow="No capture"
                            Title="No curator turn processed"
                            Description="Capture status appears after the latest curator turn is processed." />
            }
            else if (Page.lastCuratorSendResult.CapturedImprovements.Count == 0)
            {
                <div class="cognitive-memory-list mt-4">
                    <div class="cognitive-memory-row">
                        <strong>No memory change captured</strong>
                        <span>@($"Trace {CognitiveMemoryPage.FormatShortId(Page.lastCuratorSendResult.RecallTraceId)} used {Page.lastCuratorSendResult.IncludedMemoryRecordIds.Count} included memory record(s).")</span>
                    </div>
                </div>
            }
            else
            {
                <div class="cognitive-memory-list mt-4">
                    @foreach (var capture in Page.lastCuratorSendResult.CapturedImprovements)
                    {
                        <article class="cognitive-memory-row">
                            <strong>@CognitiveMemoryPage.FormatLabel(capture.CaptureKind)</strong>
                            <StatusBadge Tone="@CognitiveMemoryPage.CuratorCaptureTone(capture.Status)"
                                         Text="@CognitiveMemoryPage.FormatLabel(capture.Status)" />
                            <span>@CognitiveMemoryPage.FirstNonEmpty(capture.Summary, "No capture summary.")</span>
                            <small>@($"Confidence {capture.ConfidenceScore:0.00} / priority {capture.PriorityScore:0.00}")</small>
                            @if (capture.AppliedMemoryRecordId is { } appliedMemoryRecordId)
                            {
                                <small>@($"Applied memory {CognitiveMemoryPage.FormatShortId(appliedMemoryRecordId)}")</small>
                            }
                        </article>
                    }
                </div>
            }
        </SurfaceCard>
    </Grid>
}

@code {
    [CascadingParameter]
    internal CognitiveMemoryPage Page { get; set; } = default!;
}

@namespace CanDoItAll.Modules.CognitiveMemory.Pages

@if (Page.snapshot is { } snapshot)
{
                        <Grid Gap="LayoutGap.Large"
                              Class="cognitive-memory-layout cognitive-memory-probe-workbench"
                              ColumnTemplateXl="minmax(22rem,0.75fr) minmax(0,1.25fr)"
                              data-testid="cognitive-memory-probe-workbench">
                            <SurfaceCard data-testid="cognitive-memory-probe-session-card">
                                <Split Gap="LayoutGap.Small"
                                       AlignItems="AlignItems.Start">
                                    <div>
                                        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Dialogue workbench" />
                                        <h2 class="cognitive-memory-card-title">Project memory probe</h2>
                                    </div>
                                    <StatusBadge Tone="@(Page.HasActiveProbeSession ? "info" : "secondary")"
                                                 Text="@(Page.HasActiveProbeSession ? "Active" : "No session")" />
                                </Split>

                                <Stack GapScale="LayoutGap.Medium" Class="mt-4">
                                    <div class="cognitive-memory-facts">
                                        @CognitiveMemoryPage.RenderFactFragment("Project", Page.ProbeProjectScopeText)
                                        @CognitiveMemoryPage.RenderFactFragment("Session", Page.ActiveProbeSessionTitle)
                                        @CognitiveMemoryPage.RenderFactFragment("State", Page.ActiveProbeSessionMeta)
                                    </div>

                                    <label class="cognitive-memory-field">
                                        <span>Session title</span>
                                        <InputText class="cda-input"
                                                   @bind-Value="Page.probeSessionTitle"
                                                   data-testid="cognitive-memory-probe-session-title" />
                                    </label>

                                    <Grid Gap="LayoutGap.Medium"
                                          ColumnTemplateXl="minmax(0,1fr) minmax(0,1fr)">
                                        <label class="cognitive-memory-field">
                                            <span>Recall mode</span>
                                            <InputSelect class="cda-input"
                                                         @bind-Value="Page.probeRecallMode"
                                                         data-testid="cognitive-memory-probe-recall-mode">
                                                @foreach (var mode in Enum.GetValues<CognitiveMemoryRecallMode>().Where(mode => mode != CognitiveMemoryRecallMode.Unknown))
                                                {
                                                    <option value="@mode">@CognitiveMemoryPage.FormatLabel(mode)</option>
                                                }
                                            </InputSelect>
                                        </label>
                                        <label class="cognitive-memory-field">
                                            <span>Intent</span>
                                            <InputSelect class="cda-input"
                                                         @bind-Value="Page.probeIntent"
                                                         data-testid="cognitive-memory-probe-intent">
                                                @foreach (var intent in Enum.GetValues<CognitiveMemoryRecallIntentKind>().Where(intent => intent != CognitiveMemoryRecallIntentKind.Unknown))
                                                {
                                                    <option value="@intent">@CognitiveMemoryPage.FormatLabel(intent)</option>
                                                }
                                            </InputSelect>
                                        </label>
                                    </Grid>

                                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                        <Button Text="Start"
                                                Icon="play_arrow"
                                                ButtonStyle="ButtonStyle.Primary"
                                                Size="ButtonSize.Small"
                                                Disabled="@(!Page.CanStartProbe)"
                                                IsBusy="@Page.isBusy"
                                                Click="Page.StartProbeSessionAsync"
                                                data-testid="cognitive-memory-probe-start" />
                                        <Button Text="Refresh"
                                                Icon="refresh"
                                                ButtonStyle="ButtonStyle.Light"
                                                Size="ButtonSize.Small"
                                                Disabled="@Page.isBusy"
                                                Click="Page.RefreshAsync"
                                                data-testid="cognitive-memory-probe-refresh" />
                                    </Cluster>

                                    @if (snapshot.ProbeSessions.Count > 0)
                                    {
                                        <section class="cognitive-memory-section">
                                            <h3>Recent sessions</h3>
                                            <div class="cognitive-memory-list">
                                                @foreach (var session in snapshot.ProbeSessions)
                                                {
                                                    <button type="button"
                                                            class="cognitive-memory-row cognitive-memory-row-button"
                                                            @onclick="() => Page.ReuseProbeSession(session.Id)"
                                                            data-testid="@($"cognitive-memory-probe-reuse-{session.Id:N}")">
                                                        <strong>@session.Title</strong>
                                                        <span>@($"{CognitiveMemoryPage.FormatLabel(session.Status)} / {CognitiveMemoryPage.FormatLabel(session.RecallMode)} / {session.TurnCount} turn(s)")</span>
                                                        <small>@CognitiveMemoryPage.FormatDate(session.UpdatedAtUtc)</small>
                                                    </button>
                                                }
                                            </div>
                                            @Page.CollectionPager(CognitiveMemoryReviewUiCollectionKind.ProbeSessions)
                                        </section>
                                    }
                                </Stack>
                            </SurfaceCard>

                            <SurfaceCard data-testid="cognitive-memory-probe-dialogue-card">
                                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Question" />
                                <h2 class="cognitive-memory-card-title">Ask memory</h2>
                                <Stack GapScale="LayoutGap.Medium" Class="mt-4">
                                    <label class="cognitive-memory-field">
                                        <span>Question</span>
                                        <InputTextArea class="cda-input cda-input--textarea cognitive-memory-probe-question"
                                                       @bind-Value="Page.probeQuestion"
                                                       data-testid="cognitive-memory-probe-question" />
                                    </label>
                                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                        <Button Text="Ask"
                                                Icon="send"
                                                ButtonStyle="ButtonStyle.Primary"
                                                Size="ButtonSize.Small"
                                                Disabled="@(!Page.CanAskProbe)"
                                                IsBusy="@Page.isBusy"
                                                Click="Page.AskProbeAsync"
                                                data-testid="cognitive-memory-probe-ask" />
                                        <Button Text="Audio mode"
                                                Icon="hearing"
                                                ButtonStyle="@(Page.probeVoiceModeEnabled ? ButtonStyle.Info : ButtonStyle.Light)"
                                                Size="ButtonSize.Small"
                                                Disabled="@Page.isBusy"
                                                Click="Page.ToggleProbeVoiceModeAsync"
                                                data-testid="cognitive-memory-probe-voice-mode" />
                                        <Button Text="@(Page.probeVoiceRecording && Page.probeVoiceCaptureTarget == CognitiveMemoryPage.CognitiveMemoryProbeVoiceCaptureTarget.Question ? "Stop recording" : "Ask by voice")"
                                                Icon="@(Page.probeVoiceRecording && Page.probeVoiceCaptureTarget == CognitiveMemoryPage.CognitiveMemoryProbeVoiceCaptureTarget.Question ? "stop" : "mic")"
                                                ButtonStyle="ButtonStyle.Light"
                                                Size="ButtonSize.Small"
                                                Disabled="@(!Page.probeVoiceModeEnabled || !Page.CanUseProbeVoice)"
                                                IsBusy="@Page.probeVoiceTranscribing"
                                                Click="Page.ToggleProbeQuestionRecordingAsync"
                                                data-testid="cognitive-memory-probe-voice-question" />
                                        <StatusBadge Tone="info" Text="@Page.probeStatus" />
                                        <StatusBadge Tone="@Page.probeVoiceStatusTone"
                                                     Text="@Page.probeVoiceStatus"
                                                     data-testid="cognitive-memory-probe-voice-status" />
                                    </Cluster>
                                </Stack>
                            </SurfaceCard>
                        </Grid>

                        <Grid Gap="LayoutGap.Large"
                              Class="cognitive-memory-layout cognitive-memory-probe-result-grid"
                              ColumnTemplateXl="minmax(0,1.2fr) minmax(22rem,0.8fr)">
                            <SurfaceCard data-testid="cognitive-memory-probe-answer-card">
                                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Answer evidence" />
                                <h2 class="cognitive-memory-card-title">Context returned to probing</h2>
                                @if (Page.lastProbeAskResult is null)
                                {
                                    <EmptyState Eyebrow="No answer"
                                                Title="No probe answer yet"
                                                Description="Ask a project question to inspect the context pack, source refs, and trace stages." />
                                }
                                else
                                {
                                    var contextPack = Page.lastProbeAskResult.RecallResult.ContextPack;
                                    <div class="cognitive-memory-detail-stack" data-testid="cognitive-memory-probe-answer">
                                        <div class="cognitive-memory-facts">
                                            @CognitiveMemoryPage.RenderFactFragment("Turn", Page.lastProbeAskResult.Turn.Sequence.ToString())
                                            @CognitiveMemoryPage.RenderFactFragment("Trace", CognitiveMemoryPage.FormatShortId(Page.lastProbeAskResult.RecallResult.TraceId))
                                            @CognitiveMemoryPage.RenderFactFragment("Sections", contextPack.Sections.Count.ToString())
                                            @CognitiveMemoryPage.RenderFactFragment("Sources", contextPack.SourceRefs.Count(sourceRef => sourceRef.IncludedInContext).ToString())
                                        </div>
                                        <p class="cognitive-memory-review-memory-text">@CognitiveMemoryPage.FirstNonEmpty(contextPack.Summary, Page.lastProbeAskResult.Turn.AnswerSummary, "No answer summary was returned.")</p>
                                        @if (Page.lastProbeAskResult.RecallResult.Warnings.Count > 0)
                                        {
                                            <section class="cognitive-memory-section" data-testid="cognitive-memory-probe-warnings">
                                                <h3>Warnings</h3>
                                                <div class="cognitive-memory-list">
                                                    @foreach (var warning in Page.lastProbeAskResult.RecallResult.Warnings)
                                                    {
                                                        <div class="cognitive-memory-row">
                                                            <strong>Warning</strong>
                                                            <span>@warning</span>
                                                        </div>
                                                    }
                                                </div>
                                            </section>
                                        }
                                        <section class="cognitive-memory-section" data-testid="cognitive-memory-probe-sections">
                                            <h3>Context sections</h3>
                                            <div class="cognitive-memory-list">
                                                @foreach (var section in contextPack.Sections)
                                                {
                                                    <article class="cognitive-memory-row cognitive-memory-probe-section">
                                                        <strong>@CognitiveMemoryPage.FirstNonEmpty(section.Title, CognitiveMemoryPage.FormatLabel(section.SectionKind))</strong>
                                                        <span>@CognitiveMemoryPage.FormatLabel(section.SectionKind)</span>
                                                        <p class="cognitive-memory-review-memory-text">@CognitiveMemoryPage.FirstNonEmpty(section.Content, "No section content.")</p>
                                                    </article>
                                                }
                                            </div>
                                        </section>
                                    </div>
                                }
                            </SurfaceCard>

                            <SurfaceCard data-testid="cognitive-memory-probe-feedback-card">
                                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Feedback" />
                                <h2 class="cognitive-memory-card-title">Correction and review signal</h2>
                                <Stack GapScale="LayoutGap.Medium" Class="mt-4">
                                    <Grid Gap="LayoutGap.Medium"
                                          ColumnTemplateXl="minmax(0,1fr) minmax(0,1fr)">
                                        <label class="cognitive-memory-field">
                                            <span>Action</span>
                                            <InputSelect class="cda-input"
                                                         @bind-Value="Page.probeFeedbackAction"
                                                         data-testid="cognitive-memory-probe-feedback-action">
                                                @foreach (var action in Enum.GetValues<CognitiveMemoryProbeFeedbackAction>())
                                                {
                                                    <option value="@action">@CognitiveMemoryPage.FormatLabel(action)</option>
                                                }
                                            </InputSelect>
                                        </label>
                                        <label class="cognitive-memory-field">
                                            <span>Risk</span>
                                            <InputSelect class="cda-input"
                                                         @bind-Value="Page.probeFeedbackRiskLevel"
                                                         data-testid="cognitive-memory-probe-feedback-risk">
                                                @foreach (var risk in Enum.GetValues<CognitiveMemoryRiskLevel>())
                                                {
                                                    <option value="@risk">@CognitiveMemoryPage.FormatLabel(risk)</option>
                                                }
                                            </InputSelect>
                                        </label>
                                    </Grid>
                                    <label class="cognitive-memory-field">
                                        <span>Notes</span>
                                        <InputTextArea class="cda-input cda-input--textarea cognitive-memory-notes"
                                                       @bind-Value="Page.probeFeedbackNotes"
                                                       data-testid="cognitive-memory-probe-feedback-notes" />
                                    </label>
                                    <label class="cognitive-memory-field">
                                        <span>Correction</span>
                                        <InputTextArea class="cda-input cda-input--textarea cognitive-memory-notes"
                                                       @bind-Value="Page.probeCorrectionText"
                                                       data-testid="cognitive-memory-probe-correction" />
                                    </label>
                                    <div class="cognitive-memory-checks">
                                        <label>
                                            <InputCheckbox @bind-Value="Page.probeRequestHumanReview"
                                                           data-testid="cognitive-memory-probe-request-review" />
                                            <span>Human review</span>
                                        </label>
                                        <label>
                                            <InputCheckbox @bind-Value="Page.probeCreateRegressionTest"
                                                           data-testid="cognitive-memory-probe-create-regression" />
                                            <span>Regression test</span>
                                        </label>
                                    </div>
                                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                        <Button Text="Save feedback"
                                                Icon="fact_check"
                                                ButtonStyle="ButtonStyle.Success"
                                                Size="ButtonSize.Small"
                                                Disabled="@(!Page.CanSendProbeFeedback)"
                                                IsBusy="@Page.isBusy"
                                                Click="Page.SubmitProbeFeedbackAsync"
                                                data-testid="cognitive-memory-probe-submit-feedback" />
                                        <Button Text="@(Page.probeVoiceRecording && Page.probeVoiceCaptureTarget == CognitiveMemoryPage.CognitiveMemoryProbeVoiceCaptureTarget.Correction ? "Stop recording" : "Record correction")"
                                                Icon="@(Page.probeVoiceRecording && Page.probeVoiceCaptureTarget == CognitiveMemoryPage.CognitiveMemoryProbeVoiceCaptureTarget.Correction ? "stop" : "mic")"
                                                ButtonStyle="ButtonStyle.Light"
                                                Size="ButtonSize.Small"
                                                Disabled="@(!Page.probeVoiceModeEnabled || Page.lastProbeAskResult is null || !Page.CanUseProbeVoice)"
                                                IsBusy="@Page.probeVoiceTranscribing"
                                                Click="Page.ToggleProbeCorrectionRecordingAsync"
                                                data-testid="cognitive-memory-probe-voice-correction" />
                                        @if (Page.probeVoiceAwaitingConfirmation)
                                        {
                                            <Button Text="@(Page.probeVoiceRecording && Page.probeVoiceCaptureTarget == CognitiveMemoryPage.CognitiveMemoryProbeVoiceCaptureTarget.Confirmation ? "Stop recording" : "Confirm by voice")"
                                                    Icon="@(Page.probeVoiceRecording && Page.probeVoiceCaptureTarget == CognitiveMemoryPage.CognitiveMemoryProbeVoiceCaptureTarget.Confirmation ? "stop" : "task_alt")"
                                                    ButtonStyle="ButtonStyle.Warning"
                                                    Size="ButtonSize.Small"
                                                    Disabled="@(!Page.probeVoiceModeEnabled || !Page.CanUseProbeVoice)"
                                                    IsBusy="@Page.probeVoiceTranscribing"
                                                    Click="Page.ToggleProbeConfirmationRecordingAsync"
                                                    data-testid="cognitive-memory-probe-voice-confirm" />
                                            <StatusBadge Tone="warning"
                                                         Text="Awaiting confirmation"
                                                         data-testid="cognitive-memory-probe-voice-awaiting-confirmation" />
                                        }
                                        @if (Page.lastProbeFeedback is not null)
                                        {
                                            <StatusBadge Tone="success"
                                                         Text="@($"Saved {CognitiveMemoryPage.FormatShortId(Page.lastProbeFeedback.Id)}")"
                                                         data-testid="cognitive-memory-probe-feedback-saved" />
                                        }
                                    </Cluster>

                                    @if (Page.lastProbeAskResult is not null)
                                    {
                                        <section class="cognitive-memory-section" data-testid="cognitive-memory-probe-sources">
                                            <h3>Source refs</h3>
                                            @if (Page.lastProbeAskResult.RecallResult.ContextPack.SourceRefs.Count == 0)
                                            {
                                                <p class="cognitive-memory-muted">No source references were returned.</p>
                                            }
                                            else
                                            {
                                                <div class="cognitive-memory-list">
                                                    @foreach (var sourceRef in Page.lastProbeAskResult.RecallResult.ContextPack.SourceRefs)
                                                    {
                                                        <div class="cognitive-memory-row">
                                                            <strong>@(string.IsNullOrWhiteSpace(sourceRef.SourceSystem) ? "Source" : sourceRef.SourceSystem)</strong>
                                                            <span>@CognitiveMemoryPage.FirstNonEmpty(sourceRef.Summary, sourceRef.Locator, "No source summary.")</span>
                                                            <small>@($"{CognitiveMemoryPage.FormatLabel(sourceRef.AccessLevel)} / {CognitiveMemoryPage.FormatLabel(sourceRef.RedactionState)} / {(sourceRef.IncludedInContext ? "included" : CognitiveMemoryPage.FormatLabel(sourceRef.ExclusionReasonKind))}")</small>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </section>
                                        <section class="cognitive-memory-section" data-testid="cognitive-memory-probe-trace-stages">
                                            <h3>Trace stages</h3>
                                            <div class="cognitive-memory-list">
                                                @foreach (var stage in Page.lastProbeAskResult.RecallResult.Stages)
                                                {
                                                    <div class="cognitive-memory-row">
                                                        <strong>@($"{CognitiveMemoryPage.FormatLabel(stage.StageKind)} / {CognitiveMemoryPage.FormatLabel(stage.ChannelKind)}")</strong>
                                                        <span>@($"{CognitiveMemoryPage.FormatLabel(stage.Status)}: {stage.SelectedCount} selected from {stage.CandidateCount}")</span>
                                                        @if (!string.IsNullOrWhiteSpace(stage.FailureMessage))
                                                        {
                                                            <small>@stage.FailureMessage</small>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </section>
                                    }
                                </Stack>
                            </SurfaceCard>
                        </Grid>
}

@code {
    [CascadingParameter]
    internal CognitiveMemoryPage Page { get; set; } = default!;
}



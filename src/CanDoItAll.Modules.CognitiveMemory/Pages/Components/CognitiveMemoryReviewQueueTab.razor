@namespace CanDoItAll.Modules.CognitiveMemory.Pages

@if (Page.snapshot is { } snapshot)
{
                        <Grid Gap="LayoutGap.Large"
                              Class="cognitive-memory-layout"
                              ColumnTemplateXl="minmax(20rem,0.85fr) minmax(0,1.15fr)"
                              data-testid="cognitive-memory-review-queue">
                            <SurfaceCard>
                                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Queue" />
                                <h2 class="cognitive-memory-card-title">Review items</h2>
                                @Page.ReviewQueueList()
                            </SurfaceCard>

                            <SurfaceCard data-testid="cognitive-memory-review-detail">
                                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Decision" />
                                <h2 class="cognitive-memory-card-title">Selected review item</h2>
                                @Page.ReviewDecisionPanel()
                            </SurfaceCard>
                        </Grid>
}

@code {
    [CascadingParameter]
    internal CognitiveMemoryPage Page { get; set; } = default!;
}


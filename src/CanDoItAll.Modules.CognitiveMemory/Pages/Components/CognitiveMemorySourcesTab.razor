@namespace CanDoItAll.Modules.CognitiveMemory.Pages

@if (Page.snapshot is { } snapshot)
{
                        <Grid Gap="LayoutGap.Large"
                              Class="cognitive-memory-layout"
                              ColumnTemplateXl="minmax(23rem,0.85fr) minmax(0,1.15fr)"
                              data-testid="cognitive-memory-external-sources">
                            <SurfaceCard data-testid="cognitive-memory-file-ingestion">
                                <TextBlock TextStyle="TextStyle.Eyebrow" Value="File source" />
                                <h2 class="cognitive-memory-card-title">Drop a source document</h2>
                                <Stack GapScale="LayoutGap.Medium" Class="mt-4">
                                    <label class="cognitive-memory-file-drop">
                                        <span>Select file</span>
                                        <InputFile OnChange="Page.UploadExternalSourceAsync"
                                                   data-testid="cognitive-memory-file-input" />
                                    </label>
                                </Stack>
                            </SurfaceCard>

                            <SurfaceCard data-testid="cognitive-memory-link-ingestion">
                                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Website source" />
                                <h2 class="cognitive-memory-card-title">Ingest a website link</h2>
                                <Stack GapScale="LayoutGap.Medium" Class="mt-4">
                                    <label class="cognitive-memory-field">
                                        <span>URL</span>
                                        <InputText class="cda-input"
                                                   @bind-Value="Page.externalSourceUrl"
                                                   data-testid="cognitive-memory-url-input" />
                                    </label>
                                    <Button Text="Ingest link"
                                            Icon="link"
                                            ButtonStyle="ButtonStyle.Primary"
                                            Size="ButtonSize.Small"
                                            Click="Page.IngestExternalLinkAsync"
                                            Disabled="@Page.isBusy"
                                            IsBusy="@Page.isBusy"
                                            data-testid="cognitive-memory-ingest-link" />
                                </Stack>
                            </SurfaceCard>

                            <SurfaceCard data-testid="cognitive-memory-external-progress">
                                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Progress" />
                                <h2 class="cognitive-memory-card-title">External source status</h2>
                                <div class="cognitive-memory-progress">
                                    <progress value="@Page.externalSourceProgress" max="100"></progress>
                                    <span>@Page.externalSourceStatus</span>
                                </div>
                                @if (Page.lastExternalSourceResult is not null)
                                {
                                    <div class="cognitive-memory-facts mt-4">
                                        <div class="cognitive-memory-fact">
                                            <span>Operation</span>
                                            <strong>@CognitiveMemoryPage.FormatShortId(Page.lastExternalSourceResult.OperationId)</strong>
                                        </div>
                                        <div class="cognitive-memory-fact">
                                            <span>Item</span>
                                            <strong>@(Page.lastExternalSourceResult.SourceItemId.HasValue ? CognitiveMemoryPage.FormatShortId(Page.lastExternalSourceResult.SourceItemId.Value) : "n/a")</strong>
                                        </div>
                                        <div class="cognitive-memory-fact">
                                            <span>Evidence</span>
                                            <strong>@(Page.lastExternalSourceResult.EvidenceAnchorId.HasValue ? CognitiveMemoryPage.FormatShortId(Page.lastExternalSourceResult.EvidenceAnchorId.Value) : "n/a")</strong>
                                        </div>
                                    </div>
                                }
                            </SurfaceCard>
                        </Grid>
}

@code {
    [CascadingParameter]
    internal CognitiveMemoryPage Page { get; set; } = default!;
}


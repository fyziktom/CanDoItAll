@page "/cognitive-memory"
@page "/memory"
@namespace CanDoItAll.Modules.CognitiveMemory.Pages
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Rendering

<PageTitle>Cognitive Memory</PageTitle>

<PageScaffold MaxWidthClass="max-w-full" data-testid="cognitive-memory-page">
    <Header>
        <PageHeader Eyebrow="Cognitive Memory"
                    Title="Memory review"
                    Description="Inspect recall evidence, review decisions, probing, self-regulation, answer gates, learning proposals, projection health, and worker safety.">
            <Actions>
                <Button Icon="refresh"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Class="cda-button--quick"
                        title="Refresh memory review"
                        aria-label="Refresh memory review"
                        Click="RefreshAsync"
                        Disabled="@isBusy"
                        IsBusy="@isBusy"
                        data-testid="cognitive-memory-refresh" />
            </Actions>
        </PageHeader>
    </Header>

    <Lead>
        <Cluster Gap="LayoutGap.Small"
                 Wrap="FlexWrap.Wrap"
                 Class="cognitive-memory-summary"
                 data-testid="cognitive-memory-summary">
            <SummaryTile Label="Memory items"
                         Value="@SummaryValue(snapshot?.Summary.MemoryRecordCount)"
                         HelperText="Canonical memory records available to inspect."
                         Tone="info"
                         Badge="true"
                         Compact="true"
                         ShowHelperTextAsTooltip="true" />
            <SummaryTile Label="Pending review"
                         Value="@SummaryValue(snapshot?.Summary.PendingReviewCount)"
                         HelperText="Review items waiting for an explicit operator decision."
                         Tone="warning"
                         Badge="true"
                         Compact="true"
                         ShowHelperTextAsTooltip="true" />
            <SummaryTile Label="Recall traces"
                         Value="@SummaryValue(snapshot?.Summary.RecallTraceCount)"
                         HelperText="Trace records explaining staged retrieval and context-pack selection."
                         Tone="secondary"
                         Badge="true"
                         Compact="true"
                         ShowHelperTextAsTooltip="true" />
            <SummaryTile Label="Projection issues"
                         Value="@SummaryValue(snapshot?.Summary.ProjectionIssueCount)"
                         HelperText="Projection records that failed or require rebuild."
                         Tone="@(snapshot?.Summary.ProjectionIssueCount > 0 ? "danger" : "success")"
                         Badge="true"
                         Compact="true"
                         ShowHelperTextAsTooltip="true" />
            <SummaryTile Label="Procedure review"
                         Value="@SummaryValue(snapshot?.Summary.ProcedureReviewCount)"
                         HelperText="Procedure skills that are draft, observed, high-risk, or waiting for validation."
                         Tone="@(snapshot?.Summary.ProcedureReviewCount > 0 ? "warning" : "success")"
                         Badge="true"
                         Compact="true"
                         ShowHelperTextAsTooltip="true" />
            <SummaryTile Label="Simulation review"
                         Value="@SummaryValue(snapshot?.Summary.SimulationReviewCount)"
                         HelperText="Speculative procedure simulations that require review."
                         Tone="@(snapshot?.Summary.SimulationReviewCount > 0 ? "warning" : "success")"
                         Badge="true"
                         Compact="true"
                         ShowHelperTextAsTooltip="true" />
            <SummaryTile Label="Answer gates"
                         Value="@SummaryValue(snapshot?.Summary.AnswerGateInterventionCount)"
                         HelperText="Answer-gate decisions that warned, requested evidence, review, learning, or abstention."
                         Tone="@(snapshot?.Summary.AnswerGateInterventionCount > 0 ? "warning" : "success")"
                         Badge="true"
                         Compact="true"
                         ShowHelperTextAsTooltip="true" />
            <SummaryTile Label="Learning proposals"
                         Value="@SummaryValue(snapshot?.Summary.LearningProposalCount)"
                         HelperText="Epistemic Drive learning proposals waiting for approval."
                         Tone="@(snapshot?.Summary.LearningProposalCount > 0 ? "warning" : "success")"
                         Badge="true"
                         Compact="true"
                         ShowHelperTextAsTooltip="true" />
            <SummaryTile Label="Worker issues"
                         Value="@SummaryValue(snapshot?.Summary.DistributedIssueCount)"
                         HelperText="Distributed jobs or worker results rejected by lease, hash, schema, version, or policy checks."
                         Tone="@(snapshot?.Summary.DistributedIssueCount > 0 ? "danger" : "success")"
                         Badge="true"
                         Compact="true"
                         ShowHelperTextAsTooltip="true" />
        </Cluster>
    </Lead>

    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <SurfaceCard Soft="true" data-testid="cognitive-memory-error">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Action required" />
                <h2 class="cognitive-memory-card-title">Memory review refresh failed</h2>
                <p class="cognitive-memory-muted">@errorMessage</p>
            </SurfaceCard>
        }

        @if (isLoading)
        {
            <SurfaceCard data-testid="cognitive-memory-loading">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Loading" />
                <h2 class="cognitive-memory-card-title">Refreshing memory evidence</h2>
                <p class="cognitive-memory-muted">Loading review items, recall traces, consolidation runs, projection states, replay jobs, and procedure skills.</p>
            </SurfaceCard>
        }
        else if (snapshot is null)
        {
            <EmptyState Eyebrow="No snapshot"
                        Title="Memory review data is unavailable"
                        Description="Refresh the page after the runtime database is ready." />
        }
        else
        {
            <div class="cognitive-memory-tab-scope">
                <Tabs @bind-SelectedIndex="activeTabIndex"
                      RenderMode="TabRenderMode.Server"
                      Variant="TabsVariant.WorkspacePrimary"
                      OverflowMode="TabsOverflowMode.Wrap"
                      AriaLabel="Cognitive Memory review tabs"
                      data-testid="cognitive-memory-tabs">
                    <TabsItem Text="Dashboard"
                              Icon="dashboard"
                              data-testid="cognitive-memory-tab-dashboard">
                        <Grid Gap="LayoutGap.Large"
                              Class="cognitive-memory-layout"
                              ColumnTemplateXl="minmax(22rem,0.85fr) minmax(0,1.15fr)">
                            <SurfaceCard data-testid="cognitive-memory-dashboard-review">
                                <Split Gap="LayoutGap.Small"
                                       AlignItems="AlignItems.Start">
                                    <div>
                                        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Review queue" />
                                        <h2 class="cognitive-memory-card-title">Pending evidence decisions</h2>
                                    </div>
                                    <StatusBadge Tone="@ReviewQueueTone" Text="@($"{snapshot.Summary.PendingReviewCount} pending")" />
                                </Split>
                                @ReviewQueueList()
                            </SurfaceCard>

                            <SurfaceCard data-testid="cognitive-memory-dashboard-trace">
                                <Split Gap="LayoutGap.Small"
                                       AlignItems="AlignItems.Start">
                                    <div>
                                        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Recall trace" />
                                        <h2 class="cognitive-memory-card-title">Why memory entered context</h2>
                                    </div>
                                    <StatusBadge Tone="info" Text="@($"{snapshot.RecallTraces.Count} loaded")" />
                                </Split>
                                @RecallTraceDetail(Compact: true)
                            </SurfaceCard>
                        </Grid>

                        <Grid Gap="LayoutGap.Large"
                              Class="cognitive-memory-layout"
                              ColumnTemplateXl="minmax(0,1fr) minmax(0,1fr)">
                            @ProjectionHealthPanel()
                            @ProcedurePanel()
                        </Grid>
                    </TabsItem>

                    <TabsItem Text="Probe workbench"
                              Icon="forum"
                              BadgeText="@snapshot.Summary.ProbeSessionCount.ToString()"
                              data-testid="cognitive-memory-tab-probe-workbench">
                        <Grid Gap="LayoutGap.Large"
                              Class="cognitive-memory-layout cognitive-memory-probe-workbench"
                              ColumnTemplateXl="minmax(22rem,0.75fr) minmax(0,1.25fr)"
                              data-testid="cognitive-memory-probe-workbench">
                            <SurfaceCard data-testid="cognitive-memory-probe-session-card">
                                <Split Gap="LayoutGap.Small"
                                       AlignItems="AlignItems.Start">
                                    <div>
                                        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Dialogue workbench" />
                                        <h2 class="cognitive-memory-card-title">Project memory probe</h2>
                                    </div>
                                    <StatusBadge Tone="@(HasActiveProbeSession ? "info" : "secondary")"
                                                 Text="@(HasActiveProbeSession ? "Active" : "No session")" />
                                </Split>

                                <Stack GapScale="LayoutGap.Medium" Class="mt-4">
                                    <div class="cognitive-memory-facts">
                                        @RenderFactFragment("Project", ProbeProjectScopeText)
                                        @RenderFactFragment("Session", ActiveProbeSessionTitle)
                                        @RenderFactFragment("State", ActiveProbeSessionMeta)
                                    </div>

                                    <label class="cognitive-memory-field">
                                        <span>Session title</span>
                                        <InputText class="cda-input"
                                                   @bind-Value="probeSessionTitle"
                                                   data-testid="cognitive-memory-probe-session-title" />
                                    </label>

                                    <Grid Gap="LayoutGap.Medium"
                                          ColumnTemplateLg="minmax(0,1fr) minmax(0,1fr)">
                                        <label class="cognitive-memory-field">
                                            <span>Recall mode</span>
                                            <InputSelect class="cda-input"
                                                         @bind-Value="probeRecallMode"
                                                         data-testid="cognitive-memory-probe-recall-mode">
                                                @foreach (var mode in Enum.GetValues<CognitiveMemoryRecallMode>().Where(mode => mode != CognitiveMemoryRecallMode.Unknown))
                                                {
                                                    <option value="@mode">@FormatLabel(mode)</option>
                                                }
                                            </InputSelect>
                                        </label>
                                        <label class="cognitive-memory-field">
                                            <span>Intent</span>
                                            <InputSelect class="cda-input"
                                                         @bind-Value="probeIntent"
                                                         data-testid="cognitive-memory-probe-intent">
                                                @foreach (var intent in Enum.GetValues<CognitiveMemoryRecallIntentKind>().Where(intent => intent != CognitiveMemoryRecallIntentKind.Unknown))
                                                {
                                                    <option value="@intent">@FormatLabel(intent)</option>
                                                }
                                            </InputSelect>
                                        </label>
                                    </Grid>

                                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                        <Button Text="Start"
                                                Icon="play_arrow"
                                                ButtonStyle="ButtonStyle.Primary"
                                                Size="ButtonSize.Small"
                                                Disabled="@(!CanStartProbe)"
                                                IsBusy="@isBusy"
                                                Click="StartProbeSessionAsync"
                                                data-testid="cognitive-memory-probe-start" />
                                        <Button Text="Refresh"
                                                Icon="refresh"
                                                ButtonStyle="ButtonStyle.Light"
                                                Size="ButtonSize.Small"
                                                Disabled="@isBusy"
                                                Click="RefreshAsync"
                                                data-testid="cognitive-memory-probe-refresh" />
                                    </Cluster>

                                    @if (snapshot.ProbeSessions.Count > 0)
                                    {
                                        <section class="cognitive-memory-section">
                                            <h3>Recent sessions</h3>
                                            <div class="cognitive-memory-list">
                                                @foreach (var session in snapshot.ProbeSessions.Take(4))
                                                {
                                                    <button type="button"
                                                            class="cognitive-memory-row cognitive-memory-row-button"
                                                            @onclick="() => ReuseProbeSession(session.Id)"
                                                            data-testid="@($"cognitive-memory-probe-reuse-{session.Id:N}")">
                                                        <strong>@session.Title</strong>
                                                        <span>@($"{FormatLabel(session.Status)} / {FormatLabel(session.RecallMode)} / {session.TurnCount} turn(s)")</span>
                                                        <small>@FormatDate(session.UpdatedAtUtc)</small>
                                                    </button>
                                                }
                                            </div>
                                        </section>
                                    }
                                </Stack>
                            </SurfaceCard>

                            <SurfaceCard data-testid="cognitive-memory-probe-dialogue-card">
                                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Question" />
                                <h2 class="cognitive-memory-card-title">Ask memory</h2>
                                <Stack GapScale="LayoutGap.Medium" Class="mt-4">
                                    <label class="cognitive-memory-field">
                                        <span>Question</span>
                                        <InputTextArea class="cda-input cda-input--textarea cognitive-memory-probe-question"
                                                       @bind-Value="probeQuestion"
                                                       data-testid="cognitive-memory-probe-question" />
                                    </label>
                                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                        <Button Text="Ask"
                                                Icon="send"
                                                ButtonStyle="ButtonStyle.Primary"
                                                Size="ButtonSize.Small"
                                                Disabled="@(!CanAskProbe)"
                                                IsBusy="@isBusy"
                                                Click="AskProbeAsync"
                                                data-testid="cognitive-memory-probe-ask" />
                                        <StatusBadge Tone="info" Text="@probeStatus" />
                                    </Cluster>
                                </Stack>
                            </SurfaceCard>
                        </Grid>

                        <Grid Gap="LayoutGap.Large"
                              Class="cognitive-memory-layout cognitive-memory-probe-result-grid"
                              ColumnTemplateXl="minmax(0,1.2fr) minmax(22rem,0.8fr)">
                            <SurfaceCard data-testid="cognitive-memory-probe-answer-card">
                                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Answer evidence" />
                                <h2 class="cognitive-memory-card-title">Context returned to probing</h2>
                                @if (lastProbeAskResult is null)
                                {
                                    <EmptyState Eyebrow="No answer"
                                                Title="No probe answer yet"
                                                Description="Ask a project question to inspect the context pack, source refs, and trace stages." />
                                }
                                else
                                {
                                    var contextPack = lastProbeAskResult.RecallResult.ContextPack;
                                    <div class="cognitive-memory-detail-stack" data-testid="cognitive-memory-probe-answer">
                                        <div class="cognitive-memory-facts">
                                            @RenderFactFragment("Turn", lastProbeAskResult.Turn.Sequence.ToString())
                                            @RenderFactFragment("Trace", FormatShortId(lastProbeAskResult.RecallResult.TraceId))
                                            @RenderFactFragment("Sections", contextPack.Sections.Count.ToString())
                                            @RenderFactFragment("Sources", contextPack.SourceRefs.Count(sourceRef => sourceRef.IncludedInContext).ToString())
                                        </div>
                                        <p class="cognitive-memory-review-memory-text">@FirstNonEmpty(contextPack.Summary, lastProbeAskResult.Turn.AnswerSummary, "No answer summary was returned.")</p>
                                        @if (lastProbeAskResult.RecallResult.Warnings.Count > 0)
                                        {
                                            <section class="cognitive-memory-section" data-testid="cognitive-memory-probe-warnings">
                                                <h3>Warnings</h3>
                                                <div class="cognitive-memory-list">
                                                    @foreach (var warning in lastProbeAskResult.RecallResult.Warnings)
                                                    {
                                                        <div class="cognitive-memory-row">
                                                            <strong>Warning</strong>
                                                            <span>@warning</span>
                                                        </div>
                                                    }
                                                </div>
                                            </section>
                                        }
                                        <section class="cognitive-memory-section" data-testid="cognitive-memory-probe-sections">
                                            <h3>Context sections</h3>
                                            <div class="cognitive-memory-list">
                                                @foreach (var section in contextPack.Sections)
                                                {
                                                    <article class="cognitive-memory-row cognitive-memory-probe-section">
                                                        <strong>@FirstNonEmpty(section.Title, FormatLabel(section.SectionKind))</strong>
                                                        <span>@FormatLabel(section.SectionKind)</span>
                                                        <p class="cognitive-memory-review-memory-text">@FirstNonEmpty(section.Content, "No section content.")</p>
                                                    </article>
                                                }
                                            </div>
                                        </section>
                                    </div>
                                }
                            </SurfaceCard>

                            <SurfaceCard data-testid="cognitive-memory-probe-feedback-card">
                                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Feedback" />
                                <h2 class="cognitive-memory-card-title">Correction and review signal</h2>
                                <Stack GapScale="LayoutGap.Medium" Class="mt-4">
                                    <Grid Gap="LayoutGap.Medium"
                                          ColumnTemplateLg="minmax(0,1fr) minmax(0,1fr)">
                                        <label class="cognitive-memory-field">
                                            <span>Action</span>
                                            <InputSelect class="cda-input"
                                                         @bind-Value="probeFeedbackAction"
                                                         data-testid="cognitive-memory-probe-feedback-action">
                                                @foreach (var action in Enum.GetValues<CognitiveMemoryProbeFeedbackAction>())
                                                {
                                                    <option value="@action">@FormatLabel(action)</option>
                                                }
                                            </InputSelect>
                                        </label>
                                        <label class="cognitive-memory-field">
                                            <span>Risk</span>
                                            <InputSelect class="cda-input"
                                                         @bind-Value="probeFeedbackRiskLevel"
                                                         data-testid="cognitive-memory-probe-feedback-risk">
                                                @foreach (var risk in Enum.GetValues<CognitiveMemoryRiskLevel>())
                                                {
                                                    <option value="@risk">@FormatLabel(risk)</option>
                                                }
                                            </InputSelect>
                                        </label>
                                    </Grid>
                                    <label class="cognitive-memory-field">
                                        <span>Notes</span>
                                        <InputTextArea class="cda-input cda-input--textarea cognitive-memory-notes"
                                                       @bind-Value="probeFeedbackNotes"
                                                       data-testid="cognitive-memory-probe-feedback-notes" />
                                    </label>
                                    <label class="cognitive-memory-field">
                                        <span>Correction</span>
                                        <InputTextArea class="cda-input cda-input--textarea cognitive-memory-notes"
                                                       @bind-Value="probeCorrectionText"
                                                       data-testid="cognitive-memory-probe-correction" />
                                    </label>
                                    <div class="cognitive-memory-checks">
                                        <label>
                                            <InputCheckbox @bind-Value="probeRequestHumanReview"
                                                           data-testid="cognitive-memory-probe-request-review" />
                                            <span>Human review</span>
                                        </label>
                                        <label>
                                            <InputCheckbox @bind-Value="probeCreateRegressionTest"
                                                           data-testid="cognitive-memory-probe-create-regression" />
                                            <span>Regression test</span>
                                        </label>
                                    </div>
                                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                        <Button Text="Save feedback"
                                                Icon="fact_check"
                                                ButtonStyle="ButtonStyle.Success"
                                                Size="ButtonSize.Small"
                                                Disabled="@(!CanSendProbeFeedback)"
                                                IsBusy="@isBusy"
                                                Click="SubmitProbeFeedbackAsync"
                                                data-testid="cognitive-memory-probe-submit-feedback" />
                                        @if (lastProbeFeedback is not null)
                                        {
                                            <StatusBadge Tone="success"
                                                         Text="@($"Saved {FormatShortId(lastProbeFeedback.Id)}")"
                                                         data-testid="cognitive-memory-probe-feedback-saved" />
                                        }
                                    </Cluster>

                                    @if (lastProbeAskResult is not null)
                                    {
                                        <section class="cognitive-memory-section" data-testid="cognitive-memory-probe-sources">
                                            <h3>Source refs</h3>
                                            @if (lastProbeAskResult.RecallResult.ContextPack.SourceRefs.Count == 0)
                                            {
                                                <p class="cognitive-memory-muted">No source references were returned.</p>
                                            }
                                            else
                                            {
                                                <div class="cognitive-memory-list">
                                                    @foreach (var sourceRef in lastProbeAskResult.RecallResult.ContextPack.SourceRefs)
                                                    {
                                                        <div class="cognitive-memory-row">
                                                            <strong>@(string.IsNullOrWhiteSpace(sourceRef.SourceSystem) ? "Source" : sourceRef.SourceSystem)</strong>
                                                            <span>@FirstNonEmpty(sourceRef.Summary, sourceRef.Locator, "No source summary.")</span>
                                                            <small>@($"{FormatLabel(sourceRef.AccessLevel)} / {FormatLabel(sourceRef.RedactionState)} / {(sourceRef.IncludedInContext ? "included" : FormatLabel(sourceRef.ExclusionReasonKind))}")</small>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </section>
                                        <section class="cognitive-memory-section" data-testid="cognitive-memory-probe-trace-stages">
                                            <h3>Trace stages</h3>
                                            <div class="cognitive-memory-list">
                                                @foreach (var stage in lastProbeAskResult.RecallResult.Stages)
                                                {
                                                    <div class="cognitive-memory-row">
                                                        <strong>@($"{FormatLabel(stage.StageKind)} / {FormatLabel(stage.ChannelKind)}")</strong>
                                                        <span>@($"{FormatLabel(stage.Status)}: {stage.SelectedCount} selected from {stage.CandidateCount}")</span>
                                                        @if (!string.IsNullOrWhiteSpace(stage.FailureMessage))
                                                        {
                                                            <small>@stage.FailureMessage</small>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </section>
                                    }
                                </Stack>
                            </SurfaceCard>
                        </Grid>
                    </TabsItem>

                    <TabsItem Text="Settings"
                              Icon="tune"
                              data-testid="cognitive-memory-tab-settings">
                        <Grid Gap="LayoutGap.Large"
                              Class="cognitive-memory-layout"
                              ColumnTemplateXl="minmax(23rem,0.85fr) minmax(0,1.15fr)"
                              data-testid="cognitive-memory-settings">
                            <SurfaceCard data-testid="cognitive-memory-automation-settings">
                                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Automatic sorting" />
                                <h2 class="cognitive-memory-card-title">Schedule and consolidation triggers</h2>
                                <Stack GapScale="LayoutGap.Medium" Class="mt-4">
                                    <label class="cognitive-memory-field">
                                        <span>Mode</span>
                                        <InputSelect class="cda-input"
                                                     @bind-Value="automationScheduleMode"
                                                     data-testid="cognitive-memory-schedule-mode">
                                            <option value="@CognitiveMemoryAutomationScheduleMode.ManualOnly">Manual only</option>
                                            <option value="@CognitiveMemoryAutomationScheduleMode.Nightly">Nightly</option>
                                            <option value="@CognitiveMemoryAutomationScheduleMode.IdleTimeout">When app is idle</option>
                                            <option value="@CognitiveMemoryAutomationScheduleMode.ScheduledMoments">Scheduled moments</option>
                                        </InputSelect>
                                    </label>
                                    <Grid Gap="LayoutGap.Medium"
                                          ColumnTemplateLg="minmax(0,1fr) minmax(0,1fr)">
                                        <label class="cognitive-memory-field">
                                            <span>Night time</span>
                                            <InputText class="cda-input"
                                                       @bind-Value="nightlyLocalTime"
                                                       data-testid="cognitive-memory-nightly-time" />
                                        </label>
                                        <label class="cognitive-memory-field">
                                            <span>Idle minutes</span>
                                            <InputNumber class="cda-input"
                                                         @bind-Value="idleMinutes"
                                                         data-testid="cognitive-memory-idle-minutes" />
                                        </label>
                                    </Grid>
                                    <label class="cognitive-memory-field">
                                        <span>Scheduled moments</span>
                                        <textarea class="cda-input cda-input--textarea cognitive-memory-notes"
                                                  @bind="scheduledLocalTimesText"
                                                  data-testid="cognitive-memory-scheduled-times"></textarea>
                                    </label>
                                    <div class="cognitive-memory-checks">
                                        <label>
                                            <InputCheckbox @bind-Value="autoIngestProjectStructure" />
                                            <span>Project structure</span>
                                        </label>
                                        <label>
                                            <InputCheckbox @bind-Value="autoIngestProcessRuntime" />
                                            <span>Processes</span>
                                        </label>
                                        <label>
                                            <InputCheckbox @bind-Value="autoConsolidateAfterIngestion" />
                                            <span>Consolidate after ingest</span>
                                        </label>
                                    </div>
                                    <Button Text="Save settings"
                                            Icon="save"
                                            ButtonStyle="ButtonStyle.Primary"
                                            Size="ButtonSize.Small"
                                            Click="SaveAutomationSettingsAsync"
                                            Disabled="@isBusy"
                                            IsBusy="@isBusy"
                                            data-testid="cognitive-memory-save-settings" />
                                </Stack>
                            </SurfaceCard>

                            <SurfaceCard data-testid="cognitive-memory-model-access-settings">
                                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Model access" />
                                <h2 class="cognitive-memory-card-title">Provider and agent policy</h2>
                                <p class="cognitive-memory-muted">@modelAccessStatus</p>
                                <Stack GapScale="LayoutGap.Medium" Class="mt-4">
                                    <label class="cognitive-memory-field">
                                        <span>Mode</span>
                                        <InputSelect class="cda-input"
                                                     @bind-Value="modelAccessMode"
                                                     data-testid="cognitive-memory-model-access-mode">
                                            <option value="@CognitiveMemoryModelAccessMode.AnyEnabledProvider">Any enabled provider</option>
                                            <option value="@CognitiveMemoryModelAccessMode.LocalProvidersOnly">Local providers only</option>
                                            <option value="@CognitiveMemoryModelAccessMode.SelectedProvidersOnly">Selected providers only</option>
                                            <option value="@CognitiveMemoryModelAccessMode.Disabled">Disabled</option>
                                        </InputSelect>
                                    </label>
                                    <Grid Gap="LayoutGap.Medium"
                                          ColumnTemplateLg="minmax(0,1fr) minmax(0,1fr)">
                                        <label class="cognitive-memory-field">
                                            <span>Default provider</span>
                                            <InputSelect class="cda-input"
                                                         @bind-Value="defaultProviderProfileIdText"
                                                         data-testid="cognitive-memory-default-provider">
                                                <option value="">No preference</option>
                                                @foreach (var provider in modelProviderOptions)
                                                {
                                                    <option value="@provider.Id.ToString("D")">@provider.Name (@FormatLabel(provider.Kind))</option>
                                                }
                                            </InputSelect>
                                        </label>
                                        <label class="cognitive-memory-field">
                                            <span>Default agent</span>
                                            <InputSelect class="cda-input"
                                                         @bind-Value="defaultAgentIdText"
                                                         data-testid="cognitive-memory-default-agent">
                                                <option value="">No preference</option>
                                                @foreach (var agent in modelAgentOptions)
                                                {
                                                    <option value="@agent.Id.ToString("D")">@agent.Name (@FormatLabel(agent.Workload))</option>
                                                }
                                            </InputSelect>
                                        </label>
                                    </Grid>
                                    <section class="cognitive-memory-section">
                                        <h3>Allowed providers</h3>
                                        @if (modelProviderOptions.Count == 0)
                                        {
                                            <p class="cognitive-memory-muted">No chat providers are configured.</p>
                                        }
                                        else
                                        {
                                            <div class="cognitive-memory-provider-list">

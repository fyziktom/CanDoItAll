    internal RenderFragment AdvancedCollectionPanel(
        CognitiveMemoryReviewUiCollectionKind collectionKind,
        string testId,
        string eyebrow,
        string title,
        string emptyEyebrow,
        string emptyTitle,
        string emptyDescription,
        int count,
        Action<RenderTreeBuilder, int> renderRows)
        => builder =>
        {
            builder.OpenComponent<SurfaceCard>(0);
            builder.AddAttribute(1, "data-testid", testId);
            builder.AddAttribute(2, nameof(SurfaceCard.ChildContent), (RenderFragment)(contentBuilder =>
            {
                contentBuilder.OpenComponent<TextBlock>(0);
                contentBuilder.AddAttribute(1, nameof(TextBlock.TextStyle), TextStyle.Eyebrow);
                contentBuilder.AddAttribute(2, nameof(TextBlock.Value), eyebrow);
                contentBuilder.CloseComponent();
                contentBuilder.OpenElement(3, "h2");
                contentBuilder.AddAttribute(4, "class", "cognitive-memory-card-title");
                contentBuilder.AddContent(5, title);
                contentBuilder.CloseElement();
                if (count == 0)
                {
                    contentBuilder.OpenComponent<EmptyState>(6);
                    contentBuilder.AddAttribute(7, nameof(EmptyState.Eyebrow), emptyEyebrow);
                    contentBuilder.AddAttribute(8, nameof(EmptyState.Title), emptyTitle);
                    contentBuilder.AddAttribute(9, nameof(EmptyState.Description), emptyDescription);
                    contentBuilder.CloseComponent();
                    return;
                }

                renderRows(contentBuilder, 10);
                contentBuilder.AddContent(20, CollectionPager(collectionKind));
            }));
            builder.CloseComponent();
        };
}

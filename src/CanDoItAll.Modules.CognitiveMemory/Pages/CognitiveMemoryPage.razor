                                                Disabled="@isBusy"
                                                IsBusy="@isBusy"
                                                data-testid="cognitive-memory-ingest-projects" />
                                        <Button Text="Ingest processes"
                                                Icon="route"
                                                ButtonStyle="ButtonStyle.Light"
                                                Size="ButtonSize.Small"
                                                Click="IngestProcessesAsync"
                                                Disabled="@isBusy"
                                                IsBusy="@isBusy"
                                                data-testid="cognitive-memory-ingest-processes" />

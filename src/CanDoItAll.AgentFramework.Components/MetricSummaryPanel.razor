<SectionCard Title="Metrics"
             Description="Recent run outcomes, token estimates, and provider usage for the selected agent.">
    <CompactStatStrip>
        <CompactStat Label="runs" Value="@Metrics.Count.ToString()" TooltipText="Run metrics recorded for the selected agent." />
        <CompactStat Label="succeeded" Value="@Metrics.Count(item => item.Outcome == RunOutcome.Succeeded).ToString()" TooltipText="Runs that completed successfully." Tone="success" />
        <CompactStat Label="failed" Value="@Metrics.Count(item => item.Outcome == RunOutcome.Failed).ToString()" TooltipText="Runs that ended in failure." Tone="danger" />
        <CompactStat Label="input tokens" Value="@Metrics.Sum(item => item.InputTokens).ToString()" TooltipText="Estimated input tokens across recorded metrics." Tone="info" />
        <CompactStat Label="output tokens" Value="@Metrics.Sum(item => item.OutputTokens).ToString()" TooltipText="Estimated output tokens across recorded metrics." Tone="info" />
        <CompactStat Label="tool calls" Value="@Metrics.Sum(item => item.ToolCalls).ToString()" TooltipText="Tool invocations across recorded metrics." Tone="warning" />
    </CompactStatStrip>

    @if (Metrics.Count == 0)
    {
        <EmptyState Eyebrow="Metrics"
                    Title="No metrics recorded yet"
                    Description="Send a prompt to the selected agent and the sandbox will capture run metrics here." />
    }
    else
    {
        <Stack GapScale="LayoutGap.Small">
            @foreach (var metric in Metrics.OrderByDescending(item => item.CreatedAtUtc).Take(10))
            {
                <SelectionListItem Title="@metric.ProviderName"
                                   Eyebrow="@metric.Outcome.ToString()"
                                   Meta="@($"{metric.Model} / {metric.DurationMs} ms")"
                                   Summary="@($"Input {metric.InputTokens}, output {metric.OutputTokens}, tools {metric.ToolCalls}")">
                    <Status>
                        <StatusBadge Tone="@(metric.Outcome == RunOutcome.Succeeded ? "success" : "danger")"
                                     Text="@metric.CreatedAtUtc.LocalDateTime.ToString("g")" />
                    </Status>
                </SelectionListItem>
            }
        </Stack>
    }
</SectionCard>

@code {
    [Parameter]
    public required IReadOnlyList<AgentRunMetric> Metrics { get; set; }
}

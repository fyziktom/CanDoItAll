@namespace CanDoItAll.Modules.Processes

<div class="processes-workspace-root">
<PageTitle>@PageTitleText</PageTitle>

<PageScaffold FillHeight="true"
              MaxWidthClass="max-w-full"
              Class="processes-page-scaffold"
              data-testid="processes-page-scaffold">
    <Header>
        <PageHeader Eyebrow="@PageEyebrow"
                    Title=""
                    Description=""
                    Compact="true">
            <Actions>
                <Button Text="New definition"
                        Click="CreateNewAsync"
                        data-testid="processes-new-definition-button" />
                <Button Text="Templates"
                        ButtonStyle="ButtonStyle.Light"
                        Click="OpenTemplateLibraryAsync"
                        data-testid="processes-templates-button" />
            </Actions>
        </PageHeader>
    </Header>

    <ChildContent>
        <Stack GapScale="LayoutGap.Medium"
               Class="min-h-0 flex-1"
               data-testid="processes-workspace-shell">
            <SummaryTiles GapScale="LayoutGap.Small"
                          ColumnsMd="4">
                <SummaryTile Label="Definitions"
                             Value="@definitions.Count.ToString()"
                             HelperText="Persisted process definitions."
                             Badge="true"
                             Compact="true"
                             ShowHelperTextAsTooltip="true" />
                <SummaryTile Label="Visible"
                             Value="@FilteredDefinitions.Count.ToString()"
                             HelperText="Definitions matching the current search."
                             Badge="true"
                             Compact="true"
                             Tone="info"
                             ShowHelperTextAsTooltip="true" />
                <SummaryTile Label="Active runs"
                             Value="@definitions.Sum(item => item.ActiveRunCount).ToString()"
                             HelperText="Runs still active across the visible library."
                             Badge="true"
                             Compact="true"
                             ShowHelperTextAsTooltip="true" />
                <SummaryTile Label="Improvements"
                             Value="@analytics.ImprovementCandidateCount.ToString()"
                             HelperText="Improvement signals linked to the current scope."
                             Badge="true"
                             Compact="true"
                             Tone="warning"
                             ShowHelperTextAsTooltip="true" />
            </SummaryTiles>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <SurfaceCard Soft="true"
                             data-testid="processes-message-card">
                    <p class="cda-eyebrow">Workspace status</p>
                    <p class="mt-2 text-sm leading-6 @(isError ? "text-rose-700" : "text-slate-700")">@message</p>
                </SurfaceCard>
            }

            <ListDetailShell ListPaneWidth="28rem"
                             Dense="true"
                             ListPaneClass="h-full min-h-0"
                             DetailPaneClass="h-full min-h-0">
            <ListHeader>
                <ListPanelHeader Title="Process definitions"
                                 Description=""
                                 Dense="true"
                                 HelpText="Browse saved process contracts, filter the library, and keep selection in sync with the detail workspace without expanding the list header."
                                 Count="@($"{FilteredDefinitions.Count} definition(s)")">
                    <Filters>
                        <FilterBar>
                            <input @bind="definitionSearch"
                                   @bind:event="oninput"
                                   class="cda-input min-w-[16rem] flex-1"
                                   placeholder="Search name, summary, or value statement"
                                   data-testid="processes-definition-search" />
                            <Button Text="Clear search"
                                    ButtonStyle="ButtonStyle.Light"
                                    Size="ButtonSize.Small"
                                    Click="@(() => definitionSearch = string.Empty)" />
                            <Button Text="New"
                                    ButtonStyle="ButtonStyle.Light"
                                    Size="ButtonSize.Small"
                                    Click="CreateNewAsync" />
                        </FilterBar>
                    </Filters>
                </ListPanelHeader>
            </ListHeader>

                <ListContent>
                    <div class="h-full overflow-y-auto pr-1"
                         style="scrollbar-gutter:stable;"
                         data-testid="processes-definition-list-scroll">
                        @if (FilteredDefinitions.Count == 0)
                        {
                            <EmptyState Eyebrow="No definitions"
                                        Title="Create the first process definition"
                                        Description="Role-first process definitions appear here after they have been saved. Use the detail pane to define the contract, roles, steps, runtime expectations, and import-export envelope.">
                                <Actions>
                                    <Button Text="New definition"
                                            Click="CreateNewAsync" />
                                    <Button Text="Templates"
                                            ButtonStyle="ButtonStyle.Light"
                                            Click="OpenTemplateLibraryAsync"
                                            data-testid="processes-empty-templates-button" />
                                </Actions>
                            </EmptyState>
                        }
                        else
                        {
                            <Stack GapScale="LayoutGap.Small">
                                @foreach (var definition in FilteredDefinitions)
                                {
                                    <SelectionListItem Title="@definition.Name"
                                                       Eyebrow="@(string.IsNullOrWhiteSpace(definition.ProjectName) ? "Global process" : definition.ProjectName)"
                                                       Meta="@BuildDefinitionSummary(definition)"
                                                       Summary="@definition.Summary"
                                                       Dense="true"
                                                       IsSelected="@(selectedProcessId == definition.Id)"
                                                       OnSelect="@(() => SelectDefinitionAsync(definition.Id))">
                                        <Status>
                                            <Cluster Gap="LayoutGap.Small">
                                                <StatusBadge Tone="@ResolveDefinitionStatusTone(definition.Status)"
                                                             Text="@definition.Status.ToString()" />
                                                <StatusBadge Tone="info"
                                                             Text="@($"{definition.ActiveRunCount} active run(s)")" />
                                            </Cluster>
                                        </Status>
                                    </SelectionListItem>
                                }
                            </Stack>
                        }
                    </div>
                </ListContent>

            <DetailHeader>
                <Stack GapScale="LayoutGap.Small">
                    <SurfaceCard>
                        <Split Gap="LayoutGap.Small">
                            <Stack GapScale="LayoutGap.Tiny">
                                <p class="cda-eyebrow">Process workspace</p>
                                <div class="inline-flex min-w-0 items-center gap-2">
                                    <h2 class="text-xl font-semibold text-slate-950">@EditorTitle</h2>
                                    <HelpPopover RootClass="@CompactHelpPopoverRootClass"
                                                 ToggleClass="@CompactHelpPopoverToggleClass"
                                                 OpenOnHover="true"
                                                 AriaLabel="Show process workspace help"
                                                 Title="Show process workspace help"
                                                 Heading="Process workspace"
                                                 Body="@(selectedProcessId.HasValue
                                                     ? "Change the durable process contract, then validate the same definition through runtime runs, deviations, and captured evidence."
                                                     : "Start with the definition contract first. Roles, steps, runtime runs, and governance artifacts attach to the saved process identity.")" />
                                </div>
                            </Stack>
                            <Cluster Gap="LayoutGap.Small">
                                <StatusBadge Tone="@SelectedDefinitionTone" Text="@editor.Status.ToString()" />
                                <StatusBadge Tone="neutral" Text="@($"{editor.Roles.Count} role(s)")" />
                                <StatusBadge Tone="info" Text="@($"{editor.Steps.Count} step(s)")" />
                                @if (SelectedDefinitionSummary is not null)
                                {
                                    <StatusBadge Tone="warning" Text="@($"{SelectedDefinitionSummary.UnfilledRoleCount} open assignment(s)")" />
                                }
                            </Cluster>
                        </Split>
                    </SurfaceCard>
                </Stack>
            </DetailHeader>

                <DetailContent>
                    <Tabs SelectedIndex="@SelectedDetailTabIndex"
                          SelectedIndexChanged="HandleDetailTabChanged"
                          Variant="@(TabsVariant.WorkspaceSecondary)"
                          BorderMode="@(TabsBorderMode.Soft)"
                          OverflowMode="@(TabsOverflowMode.Scroll)"
                          PanelOverflowMode="@(TabsPanelOverflowMode.Auto)"
                          FillHeight="true"
                          Class="h-full min-h-0 w-full min-w-0"
                          AriaLabel="Process workspace detail panels"
                          data-testid="processes-detail-tabs">
                    <TabItems>
                        <TabsItem Text="Definition">
                        <ProcessDefinitionForm Model="@editor"
                                               ScopeLabel="@(ProjectId.HasValue ? projectName : "Global process library")"
                                               Save="SaveAsync"
                                               Publish="PublishAsync"
                                               Delete="DeleteAsync" />
                        </TabsItem>
                        <TabsItem Text="Roles">
                        <FormSection Title="Role requirements"
                                     Description=""
                                     HelpText="Define who the process needs first. Exact person, supplier, or agent binding happens later at runtime without changing the process contract.">
                            <Actions>
                                <Button Text="Add role"
                                        ButtonStyle="ButtonStyle.Light"
                                        Click="AddRole"
                                        data-testid="processes-add-role-button" />
                                <Button Text="Templates"
                                        ButtonStyle="ButtonStyle.Light"
                                        Click="OpenTemplateLibraryAsync"
                                        data-testid="processes-role-templates-button" />
                            </Actions>
                            <ChildContent>
                                @if (editor.Roles.Count == 0)
                                {
                                    <EmptyState Eyebrow="No role requirements"
                                                Title="Add the first role"
                                                Description="Role definitions capture purpose, staffing intent, fallback policy, and the expected executor kind before any runtime assignment happens." />
                                }
                                else
                                {
                                    <Stack GapScale="LayoutGap.Medium">
                                        @foreach (var role in editor.Roles)
                                        {
                                            <ProcessRoleEditorForm Model="@role"
                                                                   Remove="@(() => RemoveRole(role))" />
                                        }
                                    </Stack>
                                }

                                <Cluster Gap="LayoutGap.Small">
                                    <Button Text="Save definition"
                                            Click="SaveAsync" />
                                    <Button Text="Publish"
                                            ButtonStyle="ButtonStyle.Light"
                                            Click="PublishAsync" />
                                </Cluster>
                            </ChildContent>
                        </FormSection>
                        </TabsItem>
                        <TabsItem Text="Steps">
                        <ProcessWorkspaceStepsTab Presenter="@StepsTabPresenter" />
                        </TabsItem>
                        <TabsItem Text="Runs">
                        <ProcessWorkspaceRunsTab Presenter="@RunsTabPresenter" />

                        </TabsItem>
                        <TabsItem Text="Analytics">
                        <SummaryTiles GapScale="LayoutGap.Small"
                                      ColumnsMd="4">
                            <SummaryTile Label="Runs"
                                         Value="@analytics.TotalRuns.ToString()"
                                         HelperText="@($"{analytics.ActiveRuns} active / {analytics.CompletedRuns} completed")"
                                         Badge="true"
                                         Compact="true"
                                         ShowHelperTextAsTooltip="true" />
                            <SummaryTile Label="Capability gaps"
                                         Value="@analytics.CapabilityGapCount.ToString()"
                                         HelperText="Assignments or execution capacity gaps detected."
                                         Badge="true"
                                         Compact="true"
                                         Tone="danger"
                                         ShowHelperTextAsTooltip="true" />
                            <SummaryTile Label="Conformance"
                                         Value="@analytics.ConformanceObservationCount.ToString()"
                                         HelperText="@($"{analytics.SafeNonActionCount} safe non-actions recorded")"
                                         Badge="true"
                                         Compact="true"
                                         Tone="warning"
                                         ShowHelperTextAsTooltip="true" />
                            <SummaryTile Label="Actual cost"
                                         Value="@analytics.ActualCost.ToString("C")"
                                         HelperText="@($"{analytics.EstimatedCost:C} estimated in scope")"
                                         Badge="true"
                                         Compact="true"
                                         Tone="info"
                                         ShowHelperTextAsTooltip="true" />
                        </SummaryTiles>

                        <SectionCard Title="Improvement candidates"
                                     Description=""
                                     HelpText="Persist improvement opportunities, training signals, and governance review needs instead of leaving them as loose notes after runtime defects appear.">
                            @if (improvements.Count == 0)
                            {
                                <EmptyState Eyebrow="No improvement candidates"
                                            Title="Nothing recorded yet"
                                            Description="Improvement candidates populate when runtime blocking, refusal, or conformance issues reveal process design weaknesses." />
                            }
                            else
                            {
                                <Stack GapScale="LayoutGap.Medium">
                                    @foreach (var improvement in improvements)
                                    {
                                        <SurfaceCard>
                                            <Split Gap="LayoutGap.Medium">
                                                <div>
                                                    <p class="text-sm font-semibold text-slate-950">@improvement.Title</p>
                                                    <p class="tracking-[0.18em] mt-1 text-xs uppercase text-slate-500">@improvement.Category / @improvement.Status</p>
                                                </div>
                                                <Cluster Gap="LayoutGap.Small">
                                                    @if (improvement.IsTrainingOpportunity)
                                                    {
                                                        <StatusBadge Tone="info" Text="Training" />
                                                    }
                                                    @if (improvement.RequiresGovernanceReview)
                                                    {
                                                        <StatusBadge Tone="warning" Text="Governance review" />
                                                    }
                                                </Cluster>
                                            </Split>
                                            <p class="mt-3 text-sm leading-6 text-slate-600">@improvement.ProblemSummary</p>
                                        </SurfaceCard>
                                    }
                                </Stack>
                            }
                        </SectionCard>
                        </TabsItem>
                        <TabsItem Text="Exchange">
                        <SectionCard Title="Definition exchange"
                                     Description=""
                                     HelpText="Export and import process definition envelopes so architecture can review them, seed them, or move them between environments without copying implementation-only data.">
                            <Grid Gap="LayoutGap.Large"
                                  ColumnTemplateLg="minmax(0,1fr) minmax(0,1fr)">
                                <SurfaceCard>
                                    <p class="cda-eyebrow">Export</p>
                                    <h3 class="mt-1 text-lg font-semibold text-slate-950">Definition envelope</h3>
                                    <Cluster Gap="LayoutGap.Small"
                                             Class="mt-4">
                                        <Button Text="Export current definition"
                                                Click="ExportAsync"
                                                data-testid="processes-export-button" />
                                    </Cluster>
                                    <div class="mt-4">
                                        <label class="cda-field-label">Export JSON</label>
                                        <InputTextArea @bind-Value="exportJson"
                                                       class="cda-input cda-input--textarea cda-input--mono min-h-72"
                                                       data-testid="processes-export-json" />
                                    </div>
                                </SurfaceCard>

                                <SurfaceCard>
                                    <p class="cda-eyebrow">Import</p>
                                    <h3 class="mt-1 text-lg font-semibold text-slate-950">Import envelope</h3>
                                    <div class="mt-4">
                                        <label class="cda-field-label">Import JSON</label>
                                        <InputTextArea @bind-Value="importJson"
                                                       class="cda-input cda-input--textarea cda-input--mono min-h-72"
                                                       data-testid="processes-import-json" />
                                    </div>
                                    <Cluster Gap="LayoutGap.Small"
                                             Class="mt-4">
                                        <Button Text="Import definition"
                                                Click="ImportAsync"
                                                data-testid="processes-import-button" />
                                    </Cluster>
                                </SurfaceCard>
                            </Grid>
                        </SectionCard>
                        </TabsItem>
                    </TabItems>
                    </Tabs>
                </DetailContent>
            </ListDetailShell>
        </Stack>
    </ChildContent>
</PageScaffold>
</div>

<ProcessTemplateLibraryDialog IsOpen="@templateLibraryOpen"
                              ScopeLabel="@TemplateLibraryScopeLabel"
                              ArtifactTargets="@TemplateArtifactTargets"
                              SelectedArtifactTargetStepId="@templateLibraryArtifactTargetStepId"
                              SelectedArtifactTargetStepIdChanged="@((Guid? stepId) => templateLibraryArtifactTargetStepId = stepId)"
                              Close="CloseTemplateLibraryAsync"
                              AddProcessTemplate="AddProcessTemplateAsync"
                              AddRoleTemplate="AddRoleTemplateAsync"
                              AddArtifactTemplate="AddArtifactTemplateAsync" />

@if (canvasActionDialog is not null)
{
    <Dialog IsOpen="true"
            Eyebrow="Process canvas"
            Title="@canvasActionDialog.Title"
            Subtitle="@canvasActionDialog.Summary"
            Size="ModalSize.Medium"
            TestId="processes-canvas-action-dialog"
            OnClose="CloseCanvasActionDialogAsync">
        <ChildContent>
            <Stack GapScale="LayoutGap.Medium">
                @if (canvasActionDialog.IsRuntime)
                {
                    <Button Text="Start step"
                            ButtonStyle="ButtonStyle.Light"
                            Disabled="@(!CanApplyRuntimeStatus(SelectedCanvasRuntimeStep, ProcessStepRunStatus.InProgress))"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.RuntimeStart))" />
                    <Button Text="Complete step"
                            Disabled="@(!CanApplyRuntimeStatus(SelectedCanvasRuntimeStep, ProcessStepRunStatus.Completed))"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.RuntimeComplete))" />
                    <Button Text="Block step"
                            ButtonStyle="ButtonStyle.Light"
                            Disabled="@(!CanApplyRuntimeStatus(SelectedCanvasRuntimeStep, ProcessStepRunStatus.Blocked))"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.RuntimeBlock))" />
                    <Button Text="Wait for approval"
                            ButtonStyle="ButtonStyle.Light"
                            Disabled="@(!CanApplyRuntimeStatus(SelectedCanvasRuntimeStep, ProcessStepRunStatus.WaitingApproval))"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.RuntimeApproval))" />
                    <Button Text="Refuse safely"
                            ButtonStyle="ButtonStyle.Light"
                            Disabled="@(!CanApplyRuntimeStatus(SelectedCanvasRuntimeStep, ProcessStepRunStatus.Refused))"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.RuntimeRefuse))" />
                    <Button Text="Mark failed"
                            ButtonStyle="ButtonStyle.Light"
                            Disabled="@(!CanApplyRuntimeStatus(SelectedCanvasRuntimeStep, ProcessStepRunStatus.Failed))"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.RuntimeFail))" />
                    <Button Text="Prepare artifact capture"
                            ButtonStyle="ButtonStyle.Light"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.RuntimeRecordArtifact))" />
                }
                else
                {
                    <Button Text="Edit step"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.EditDefinitionStep))" />
                    <Button Text="Add dependent step"
                            ButtonStyle="ButtonStyle.Light"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.AddDependentStep))" />
                    <Button Text="Add branch outcome"
                            ButtonStyle="ButtonStyle.Light"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.AddBranchOutcome))" />
                    <Button Text="Add role binding"
                            ButtonStyle="ButtonStyle.Light"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.AddRoleBinding))" />
                    <Button Text="Add artifact expectation"
                            ButtonStyle="ButtonStyle.Light"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.AddArtifactExpectation))" />
                    <Button Text="Remove step"
                            ButtonStyle="ButtonStyle.Light"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.RemoveDefinitionStep))" />
                }
            </Stack>
        </ChildContent>
    </Dialog>
}

@namespace CanDoItAll.Modules.Processes

@using CanDoItAll.Components.Common

<div class="processes-workspace-root">
<PageTitle>@PageTitleText</PageTitle>

<PageScaffold FillHeight="true"
              MaxWidthClass="max-w-full"
              Class="processes-page-scaffold"
              data-testid="processes-page-scaffold">
    <Header>
        <Toolbar Class="processes-command-strip"
                 data-testid="processes-command-strip">
            <ToolbarRow Class="processes-command-strip__row">
                <Cluster Gap="LayoutGap.Small"
                         Class="min-w-0">
                    <p class="cda-eyebrow whitespace-nowrap">@PageEyebrow</p>
                    <StatusBadge Tone="neutral"
                                 Text="@DefinitionCountText" />
                    <StatusBadge Tone="info"
                                 Text="@VisibleDefinitionCountText" />
                    <StatusBadge Tone="info"
                                 Text="@ActiveRunCountText" />
                    <StatusBadge Tone="warning"
                                 Text="@BlockedRunCountText" />
                    <StatusBadge Tone="danger"
                                 Text="@FailedRunCountText" />
                    <StatusBadge Tone="warning"
                                 Text="@ImprovementCountText" />
                </Cluster>

                <ToolbarActions Class="processes-command-strip__actions">
                    <Button Icon="cloud_sync"
                            Class="cda-button--quick"
                            ButtonStyle="ButtonStyle.Light"
                            Size="ButtonSize.Small"
                            title="Feed defaults"
                            aria-label="Feed defaults"
                            Click="FeedDefaultsAsync"
                            Disabled="@isFeedingDefaults"
                            IsBusy="@isFeedingDefaults"
                            data-testid="processes-feed-defaults-button" />
                    <Button Icon="add"
                            Class="cda-button--quick"
                            Size="ButtonSize.Small"
                            title="New definition"
                            aria-label="New definition"
                            Click="CreateNewAsync"
                            data-testid="processes-new-definition-button" />
                    <Button Icon="category"
                            Class="cda-button--quick"
                            ButtonStyle="ButtonStyle.Light"
                            Size="ButtonSize.Small"
                            title="Templates"
                            aria-label="Templates"
                            Click="OpenTemplateLibraryAsync"
                            data-testid="processes-templates-button" />
                </ToolbarActions>
            </ToolbarRow>
        </Toolbar>
    </Header>

    <ChildContent>
        <Stack GapScale="LayoutGap.Medium"
               Class="min-h-0 flex-1"
               data-testid="processes-workspace-shell">
            <ListDetailShell ListPaneWidth="28rem"
                             Dense="true"
                             ListPaneClass="h-full min-h-0"
                             DetailPaneClass="h-full min-h-0">
            <ListHeader>
                <ListPanelHeader Title="Process definitions"
                                 Description=""
                                 Dense="true"
                                 HelpText="Browse saved process contracts, filter the library, and keep selection in sync with the detail workspace without expanding the list header."
                                 Count="@($"{FilteredDefinitions.Count} definition(s)")">
                    <Filters>
                        <FilterBar>
                            <input @bind="definitionSearch"
                                   @bind:event="oninput"
                                   class="cda-input min-w-[16rem] flex-1"
                                   placeholder="Search name, summary, or value statement"
                                   data-testid="processes-definition-search" />
                            <Button Icon="close"
                                    Class="cda-button--quick"
                                    ButtonStyle="ButtonStyle.Light"
                                    Size="ButtonSize.Small"
                                    title="Clear search"
                                    aria-label="Clear search"
                                    Click="@(() => definitionSearch = string.Empty)" />
                            <Button Icon="add"
                                    Class="cda-button--quick"
                                    ButtonStyle="ButtonStyle.Light"
                                    Size="ButtonSize.Small"
                                    title="New definition"
                                    aria-label="New definition"
                                    Click="CreateNewAsync" />
                        </FilterBar>
                    </Filters>
                </ListPanelHeader>
            </ListHeader>

                <ListContent>
                    <div class="h-full overflow-y-auto pr-1"
                         style="scrollbar-gutter:stable;"
                         data-testid="processes-definition-list-scroll">
                        @if (FilteredDefinitions.Count == 0)
                        {
                            <EmptyState Eyebrow="No definitions"
                                        Title="Create the first process definition"
                                        Description="Role-first process definitions appear here after they have been saved. Use the detail pane to define the contract, roles, steps, runtime expectations, and import-export envelope.">
                                <Actions>
                                    <Button Text="New definition"
                                            Click="CreateNewAsync" />
                                    <Button Text="Templates"
                                            ButtonStyle="ButtonStyle.Light"
                                            Click="OpenTemplateLibraryAsync"
                                            data-testid="processes-empty-templates-button" />
                                </Actions>
                            </EmptyState>
                        }
                        else
                        {
                            <TreeView Items="@ProcessDefinitionTreeNodes"
                                      Style="TreeViewStyle.Workbench"
                                      AriaLabel="Process definitions by scope"
                                      EmptyText="No process definitions match the current filters."
                                      OnSelect="HandleProcessTreeSelectAsync"
                                      OnToggle="HandleProcessTreeToggleAsync" />
                        }
                    </div>
                </ListContent>

            <DetailHeader>
                <Stack GapScale="LayoutGap.Small">
                    <SurfaceCard Class="processes-workspace-identity">
                        <Split Breakpoint="LayoutBreakpoint.None"
                               AlignItems="AlignItems.Center"
                               Gap="LayoutGap.Small"
                               Wrap="FlexWrap.Wrap">
                            <Cluster Gap="LayoutGap.Small"
                                     Wrap="FlexWrap.NoWrap"
                                     Class="processes-workspace-identity__copy">
                                <p class="cda-eyebrow">Process</p>
                                <h2 class="processes-workspace-identity__title">@EditorTitle</h2>
                                <HelpPopover RootClass="@CompactHelpPopoverRootClass"
                                             ToggleClass="@CompactHelpPopoverToggleClass"
                                             OpenOnHover="true"
                                             AriaLabel="Show process help"
                                             Title="Show process help"
                                             Heading="Process"
                                             Body="@(selectedProcessId.HasValue
                                                 ? "Change the durable process contract, then validate the same definition through runtime runs, deviations, and captured evidence."
                                                 : "Start with the definition contract first. Roles, steps, runtime runs, and governance artifacts attach to the saved process identity.")" />
                            </Cluster>
                            <Cluster Gap="LayoutGap.Small"
                                     Wrap="FlexWrap.Wrap"
                                     Class="processes-workspace-identity__badges">
                                <StatusBadge Tone="@SelectedDefinitionTone" Text="@editor.Status.ToString()" />
                                <StatusBadge Tone="neutral" Text="@($"{editor.Roles.Count} role(s)")" />
                                <StatusBadge Tone="info" Text="@($"{editor.Steps.Count} step(s)")" />
                                @if (SelectedDefinitionSummary is not null)
                                {
                                    <StatusBadge Tone="warning" Text="@($"{SelectedDefinitionSummary.UnfilledRoleCount} open assignment(s)")" />
                                }
                            </Cluster>
                        </Split>
                    </SurfaceCard>
                </Stack>
            </DetailHeader>

                <DetailContent>
                    <Tabs SelectedIndex="@SelectedDetailTabIndex"
                          SelectedIndexChanged="HandleDetailTabChanged"
                          Variant="@(TabsVariant.WorkspaceSecondary)"
                          BorderMode="@(TabsBorderMode.Soft)"
                          OverflowMode="@(TabsOverflowMode.Scroll)"
                          PanelOverflowMode="@(TabsPanelOverflowMode.Auto)"
                          FillHeight="true"
                          Class="h-full min-h-0 w-full min-w-0"
                          AriaLabel="Process workspace detail panels"
                          data-testid="processes-detail-tabs">
                    <TabItems>
                        <TabsItem Text="Definition">
                        <ProcessDefinitionForm Model="@editor"
                                               ScopeLabel="@(ProjectId.HasValue ? projectName : "Global process library")"
                                               ManagerAgentOptions="@managerAgentOptions"
                                               Save="SaveAsync"
                                               Publish="PublishAsync"
                                               Delete="DeleteAsync" />
                        </TabsItem>
                        <TabsItem Text="Roles">
                        <FormSection Title="Role requirements"
                                     Description=""
                                     HelpText="Define who the process needs first. Exact person, supplier, or agent binding happens later at runtime without changing the process contract.">
                            <Actions>
                                <Button Icon="add"
                                        Class="cda-button--quick"
                                        ButtonStyle="ButtonStyle.Light"
                                        title="Add role"
                                        aria-label="Add role"
                                        Click="AddRole"
                                        data-testid="processes-add-role-button" />
                                <Button Icon="category"
                                        Class="cda-button--quick"
                                        ButtonStyle="ButtonStyle.Light"
                                        title="Templates"
                                        aria-label="Templates"
                                        Click="OpenTemplateLibraryAsync"
                                        data-testid="processes-role-templates-button" />
                            </Actions>
                            <ChildContent>
                                @if (editor.Roles.Count == 0)
                                {
                                    <EmptyState Eyebrow="No role requirements"
                                                Title="Add the first role"
                                                Description="Role definitions capture purpose, staffing intent, fallback policy, and the expected executor kind before any runtime assignment happens." />
                                }
                                else
                                {
                                    <Grid Gap="LayoutGap.Medium"
                                          ColumnsMd="2"
                                          ColumnsXl="3"
                                          Class="processes-role-card-grid"
                                          data-testid="processes-role-card-grid">
                                        @foreach (var role in editor.Roles)
                                        {
                                            <article class="processes-role-card"
                                                     data-testid="processes-role-card">
                                                <Stack GapScale="LayoutGap.Small"
                                                       AlignItems="AlignItems.Stretch">
                                                    <div class="processes-role-card__identity">
                                                        <div class="processes-role-card__avatar"
                                                             aria-hidden="true">
                                                            @BuildRoleInitials(role)
                                                        </div>
                                                        <div class="processes-role-card__copy">
                                                            <Cluster Gap="LayoutGap.XSmall"
                                                                     Wrap="FlexWrap.Wrap"
                                                                     Class="processes-role-card__badges">
                                                                <StatusBadge Tone="@(role.IsRequired ? "neutral" : "info")"
                                                                             Text="@(role.IsRequired ? "Required" : "Optional")" />
                                                                @if (role.RequiresExplicitApproval)
                                                                {
                                                                    <StatusBadge Tone="warning"
                                                                                 Text="Approval" />
                                                                }
                                                                @if (role.AllowsFallback)
                                                                {
                                                                    <StatusBadge Tone="success"
                                                                                 Text="Fallback" />
                                                                }
                                                            </Cluster>

                                                            <p class="processes-role-card__name">@ResolveRoleDisplayName(role)</p>
                                                            <p class="processes-role-card__kind">@ResolveRoleExecutorKind(role)</p>
                                                        </div>
                                                    </div>

                                                    <p class="processes-role-card__summary">@ResolveRoleSummary(role)</p>

                                                    <Cluster Gap="LayoutGap.XSmall"
                                                             Wrap="FlexWrap.Wrap"
                                                             Class="processes-role-card__tags">
                                                        <StatusBadge Tone="neutral"
                                                                     Text="@ResolveRoleKey(role)" />
                                                        <StatusBadge Tone="info"
                                                                     Text="@($"{role.DefaultAllocationPercent}% allocation")" />
                                                        @if (role.PreferredProjectAssignmentRole.HasValue)
                                                        {
                                                            <StatusBadge Tone="neutral"
                                                                         Text="@role.PreferredProjectAssignmentRole.Value.ToString()" />
                                                        }
                                                    </Cluster>

                                                    <div class="processes-role-card__footer">
                                                        <span>@ResolveRoleTemplateLabel(role)</span>
                                                        <Button Icon="edit"
                                                                Size="ButtonSize.Small"
                                                                Class="cda-button--quick"
                                                                ButtonStyle="ButtonStyle.Light"
                                                                title="Edit role"
                                                                aria-label="Edit role"
                                                                Click="@(() => OpenRoleDetails(role))"
                                                                data-testid="processes-role-details-button" />
                                                    </div>
                                                </Stack>
                                            </article>
                                        }
                                    </Grid>
                                }

                                <Cluster Gap="LayoutGap.Small">
                                    <Button Icon="save"
                                            Class="cda-button--quick"
                                            title="Save definition"
                                            aria-label="Save definition"
                                            Click="SaveAsync" />
                                    <Button Icon="publish"
                                            Class="cda-button--quick"
                                            ButtonStyle="ButtonStyle.Light"
                                            title="Publish definition"
                                            aria-label="Publish definition"
                                            Click="PublishAsync" />
                                </Cluster>
                            </ChildContent>
                        </FormSection>
                        </TabsItem>
                        <TabsItem Text="Steps">
                        <ProcessWorkspaceStepsTab Presenter="@StepsTabPresenter" />
                        </TabsItem>
                        <TabsItem Text="Runs">
                        <ProcessWorkspaceRunsTab Presenter="@RunsTabPresenter" />

                        </TabsItem>
                        <TabsItem Text="Analytics">
                        <ProcessWorkspaceAnalyticsTab Presenter="@AnalyticsTabPresenter" />
                        </TabsItem>
                        <TabsItem Text="Exchange">
                        <SectionCard Title="Definition exchange"
                                     Description=""
                                     HelpText="Export and import process definition envelopes so architecture can review them, seed them, or move them between environments without copying implementation-only data.">
                            <Grid Gap="LayoutGap.Large"
                                  ColumnTemplateLg="minmax(0,1fr) minmax(0,1fr)">
                                <SurfaceCard>
                                    <p class="cda-eyebrow">Export</p>
                                    <h3 class="mt-1 text-lg font-semibold text-slate-950">Definition envelope</h3>
                                    <Cluster Gap="LayoutGap.Small"
                                             Class="mt-4">
                                        <Button Icon="file_download"
                                                Class="cda-button--quick"
                                                title="Export current definition"
                                                aria-label="Export current definition"
                                                Click="ExportAsync"
                                                data-testid="processes-export-button" />
                                    </Cluster>
                                    <div class="mt-4">
                                        <label class="cda-field-label">Export JSON</label>
                                        <InputTextArea @bind-Value="exportJson"
                                                       class="cda-input cda-input--textarea cda-input--mono min-h-72"
                                                       data-testid="processes-export-json" />
                                    </div>
                                </SurfaceCard>

                                <SurfaceCard>
                                    <p class="cda-eyebrow">Import</p>
                                    <h3 class="mt-1 text-lg font-semibold text-slate-950">Import envelope</h3>
                                    <div class="mt-4">
                                        <label class="cda-field-label">Import JSON</label>
                                        <InputTextArea @bind-Value="importJson"
                                                       class="cda-input cda-input--textarea cda-input--mono min-h-72"
                                                       data-testid="processes-import-json" />
                                    </div>
                                    <Cluster Gap="LayoutGap.Small"
                                             Class="mt-4">
                                        <Button Icon="file_upload"
                                                Class="cda-button--quick"
                                                title="Import definition"
                                                aria-label="Import definition"
                                                Click="ImportAsync"
                                                data-testid="processes-import-button" />
                                    </Cluster>
                                </SurfaceCard>
                            </Grid>
                        </SectionCard>
                        </TabsItem>
                        <TabsItem Text="Manager chat">
                        <Stack GapScale="LayoutGap.Medium"
                               Class="h-full min-h-0"
                               data-testid="processes-manager-chat-tab">
                            <SurfaceCard Soft="true"
                                         data-testid="processes-manager-chat-context">
                                <Split Gap="LayoutGap.Medium"
                                       AlignItems="AlignItems.Center"
                                       Wrap="FlexWrap.Wrap">
                                    <Stack GapScale="LayoutGap.Tiny">
                                        <p class="cda-eyebrow">Process manager</p>
                                        <h3 class="text-lg font-semibold text-slate-950">@ManagerChatManagerLabel</h3>
                                        <Cluster Gap="LayoutGap.Small"
                                                 Wrap="FlexWrap.Wrap">
                                            <StatusBadge Tone="info"
                                                         Text="@ManagerChatSelectedRunLabel" />
                                            @if (managerChatAgent is not null)
                                            {
                                                <StatusBadge Tone="neutral"
                                                             Text="@managerChatAgent.Model" />
                                            }
                                        </Cluster>
                                    </Stack>
                                    <Cluster Gap="LayoutGap.Small"
                                             Wrap="FlexWrap.Wrap">
                                        <Button Text="Choose run"
                                                Icon="history"
                                                ButtonStyle="ButtonStyle.Light"
                                                Size="ButtonSize.Small"
                                                Click="OpenManagerChatRunSelectorAsync"
                                                data-testid="processes-manager-chat-choose-run" />
                                        <Button Text="Reload"
                                                Icon="refresh"
                                                ButtonStyle="ButtonStyle.Light"
                                                Size="ButtonSize.Small"
                                                Disabled="@managerChatIsLoading"
                                                IsBusy="@managerChatIsLoading"
                                                Click="@(() => LoadManagerChatAsync())"
                                                data-testid="processes-manager-chat-reload" />
                                    </Cluster>
                                </Split>
                            </SurfaceCard>

                            @if (managerChatIsLoading)
                            {
                                <LoadingState Title="Loading manager chat"
                                              Description="Resolving the responsible manager agent and chat workspace." />
                            }
                            else if (!string.IsNullOrWhiteSpace(managerChatLoadError))
                            {
                                <EmptyState Eyebrow="Manager chat unavailable"
                                            Title="Connect a manager agent before chatting"
                                            Description="@managerChatLoadError">
                                    <Actions>
                                        <Button Text="Reload"
                                                ButtonStyle="ButtonStyle.Light"
                                                Click="@(() => LoadManagerChatAsync())" />
                                        <Button Text="Choose run"
                                                ButtonStyle="ButtonStyle.Light"
                                                Click="OpenManagerChatRunSelectorAsync" />
                                    </Actions>
                                </EmptyState>
                            }
                            else if (managerChatAgent is null)
                            {
                                <EmptyState Eyebrow="Manager chat"
                                            Title="No manager agent is open"
                                            Description="Resolve a bound process manager agent before starting a manager conversation.">
                                    <Actions>
                                        <Button Text="Reload"
                                                ButtonStyle="ButtonStyle.Light"
                                                Click="@(() => LoadManagerChatAsync())" />
                                    </Actions>
                                </EmptyState>
                            }
                            else
                            {
                                <ChatWorkspacePanel Agent="@managerChatAgent"
                                                    Session="@managerChatWorkspace?.SelectedSession"
                                                    ActiveRun="@managerChatWorkspace?.SelectedRun"
                                                    ExecutionLog="@managerChatExecutionLog"
                                                    DraftPrompt="@managerChatDraftPrompt"
                                                    DraftPromptChanged="HandleManagerChatDraftPromptChangedAsync"
                                                    IsBusy="@managerChatIsBusy"
                                                    ComposerKey="@managerChatComposerKey"
                                                    RunStateText="@managerChatRunStateText"
                                                    RunStateTone="@managerChatRunStateTone"
                                                    PendingUserPrompt="@managerChatPendingPrompt"
                                                    DraftAttachmentPaths="@managerChatDraftAttachmentPaths"
                                                    SendRequested="SendManagerChatMessageAsync"
                                                    ApprovalDecisionRequested="HandleManagerChatApprovalDecisionAsync"
                                                    ApprovalDecisionForConversationRequested="ApproveManagerChatConversationAsync"
                                                    AttachmentRequested="StageManagerChatRunArtifactsAsync"
                                                    SessionTitleChanged="RenameManagerChatSessionAsync">
                                    <HeaderActions>
                                        <Button Icon="history"
                                                Text="Run"
                                                ButtonStyle="ButtonStyle.Light"
                                                Size="ButtonSize.Small"
                                                Click="OpenManagerChatRunSelectorAsync"
                                                data-testid="processes-manager-chat-header-run" />
                                        <Button Icon="runtime"
                                                Text="Runtime details"
                                                ButtonStyle="ButtonStyle.Light"
                                                Size="ButtonSize.Small"
                                                Disabled="@(!CanOpenManagerChatRuntimeDetails)"
                                                Click="OpenManagerChatRuntimeDetailsAsync"
                                                data-testid="processes-manager-chat-runtime-details" />
                                    </HeaderActions>
                                </ChatWorkspacePanel>
                            }
                        </Stack>
                        </TabsItem>
                    </TabItems>
                    </Tabs>
                </DetailContent>
            </ListDetailShell>
        </Stack>
    </ChildContent>
</PageScaffold>
</div>

<ProcessTemplateLibraryDialog IsOpen="@templateLibraryOpen"
                              ScopeLabel="@TemplateLibraryScopeLabel"
                              ArtifactTargets="@TemplateArtifactTargets"
                              SelectedArtifactTargetStepId="@templateLibraryArtifactTargetStepId"
                              SelectedArtifactTargetStepIdChanged="@((Guid? stepId) => templateLibraryArtifactTargetStepId = stepId)"
                              Close="CloseTemplateLibraryAsync"
                              AddProcessTemplate="AddProcessTemplateAsync"
                              AddRoleTemplate="AddRoleTemplateAsync"
                              AddArtifactTemplate="AddArtifactTemplateAsync" />

@if (roleDialogModel is not null)
{
    <Dialog IsOpen="true"
            Eyebrow="Role requirement"
            Title="@RoleDialogTitle"
            Subtitle="@RoleDialogSubtitle"
            Size="ModalSize.Wide"
            ShowCloseButton="false"
            TestId="processes-role-details-dialog"
            OnClose="CloseRoleDialogAsync">
        <HeaderActions>
            <Button ButtonStyle="ButtonStyle.Light"
                    Icon="close"
                    Class="cda-button--quick"
                    title="Close"
                    aria-label="Close"
                    Click="CloseRoleDialogAsync" />
        </HeaderActions>
        <ChildContent>
            <Stack GapScale="LayoutGap.Medium">
                <SurfaceCard Soft="true"
                             data-testid="processes-role-template-picker">
                    <Grid Gap="LayoutGap.Medium"
                          ColumnTemplateLg="minmax(0,1fr) auto"
                          AlignItems="AlignItems.End">
                        <FormField Text="Start from template">
                            <InputSelect @bind-Value="selectedRoleTemplateItemId"
                                         class="cda-input"
                                         data-testid="processes-role-template-select">
                                <option value="">Choose a role template</option>
                                @foreach (var template in RoleTemplateOptions)
                                {
                                    <option value="@template.ItemId">@($"{template.Title} / {template.ScopeLabel}")</option>
                                }
                            </InputSelect>
                        </FormField>
                        <Button Text="Apply template"
                                ButtonStyle="ButtonStyle.Light"
                                Disabled="@string.IsNullOrWhiteSpace(selectedRoleTemplateItemId)"
                                Click="ApplySelectedRoleTemplate"
                                data-testid="processes-role-template-apply" />
                    </Grid>
                </SurfaceCard>

                @if (!string.IsNullOrWhiteSpace(roleDialogError))
                {
                    <SurfaceCard Soft="true"
                                 Class="border-red-200 bg-red-50 text-red-700"
                                 data-testid="processes-role-dialog-error">
                        <p class="text-sm font-semibold">@roleDialogError</p>
                    </SurfaceCard>
                }

                <ProcessRoleEditorForm Model="@roleDialogModel"
                                       ShowHeader="false"
                                       ShowRemove="false"
                                       WorkflowOptions="@workflowOptions"
                                       TestId="processes-role-details-form" />
            </Stack>
        </ChildContent>
        <Footer>
            <Split Breakpoint="LayoutBreakpoint.None"
                   Gap="LayoutGap.Medium"
                   AlignItems="AlignItems.Center"
                   JustifyContent="JustifyContent.SpaceBetween"
                   Wrap="FlexWrap.Wrap">
                <Cluster Gap="LayoutGap.Small">
                    @if (!roleDialogIsNew)
                    {
                        <Button Icon="delete"
                                Class="cda-button--quick"
                                ButtonStyle="ButtonStyle.Light"
                                title="Remove role"
                                aria-label="Remove role"
                                Click="RemoveRoleFromDialog"
                                data-testid="processes-role-dialog-remove" />
                    }
                </Cluster>
                <Cluster Gap="LayoutGap.Small"
                         JustifyContent="JustifyContent.End">
                    <Button Text="Cancel"
                            ButtonStyle="ButtonStyle.Light"
                            Click="CloseRoleDialogAsync" />
                    <Button Icon="save"
                            Class="cda-button--quick"
                            title="Save role"
                            aria-label="Save role"
                            Click="SaveRoleDialog"
                            data-testid="processes-role-dialog-save" />
                </Cluster>
            </Split>
        </Footer>
    </Dialog>
}

@if (canvasActionDialog is not null)
{
    <Dialog IsOpen="true"
            Eyebrow="Process canvas"
            Title="@canvasActionDialog.Title"
            Subtitle="@canvasActionDialog.Summary"
            Size="ModalSize.Medium"
            TestId="processes-canvas-action-dialog"
            OnClose="CloseCanvasActionDialogAsync">
        <ChildContent>
            <Stack GapScale="LayoutGap.Medium">
                @if (canvasActionDialog.IsRuntime)
                {
                    @if (SelectedCanvasRuntimeStep?.SubprocessRun is not null)
                    {
                        <Button Text="Open subprocess run"
                                ButtonStyle="ButtonStyle.Light"
                                Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.RuntimeOpenSubprocessRun))" />
                    }
                    <Button Text="Start step"
                            ButtonStyle="ButtonStyle.Light"
                            Disabled="@(!CanApplyRuntimeStatus(SelectedCanvasRuntimeStep, ProcessStepRunStatus.InProgress))"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.RuntimeStart))" />
                    <Button Text="Complete step"
                            Disabled="@(!CanApplyRuntimeStatus(SelectedCanvasRuntimeStep, ProcessStepRunStatus.Completed))"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.RuntimeComplete))" />
                    <Button Text="Block step"
                            ButtonStyle="ButtonStyle.Light"
                            Disabled="@(!CanApplyRuntimeStatus(SelectedCanvasRuntimeStep, ProcessStepRunStatus.Blocked))"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.RuntimeBlock))" />
                    <Button Text="Wait for approval"
                            ButtonStyle="ButtonStyle.Light"
                            Disabled="@(!CanApplyRuntimeStatus(SelectedCanvasRuntimeStep, ProcessStepRunStatus.WaitingApproval))"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.RuntimeApproval))" />
                    <Button Text="Refuse safely"
                            ButtonStyle="ButtonStyle.Light"
                            Disabled="@(!CanApplyRuntimeStatus(SelectedCanvasRuntimeStep, ProcessStepRunStatus.Refused))"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.RuntimeRefuse))" />
                    <Button Text="Mark failed"
                            ButtonStyle="ButtonStyle.Light"
                            Disabled="@(!CanApplyRuntimeStatus(SelectedCanvasRuntimeStep, ProcessStepRunStatus.Failed))"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.RuntimeFail))" />
                    <Button Text="Prepare artifact capture"
                            ButtonStyle="ButtonStyle.Light"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.RuntimeRecordArtifact))" />
                }
                else
                {
                    @if (SelectedCanvasDefinitionStep?.StepKind == ProcessStepKind.Subprocess &&
                         SelectedCanvasDefinitionStep.SubprocessDefinitionId.HasValue)
                    {
                        <Button Text="Open subprocess definition"
                                ButtonStyle="ButtonStyle.Light"
                                Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.OpenSubprocessDefinition))" />
                    }
                    <Button Text="Edit step"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.EditDefinitionStep))" />
                    <Button Text="Add dependent step"
                            ButtonStyle="ButtonStyle.Light"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.AddDependentStep))" />
                    <Button Text="Add subprocess step"
                            ButtonStyle="ButtonStyle.Light"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.AddSubprocessStep))" />
                    <Button Text="Add branch outcome"
                            ButtonStyle="ButtonStyle.Light"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.AddBranchOutcome))" />
                    <Button Text="Add role binding"
                            ButtonStyle="ButtonStyle.Light"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.AddRoleBinding))" />
                    <Button Text="Add artifact expectation"
                            ButtonStyle="ButtonStyle.Light"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.AddArtifactExpectation))" />
                    <Button Text="Remove step"
                            ButtonStyle="ButtonStyle.Light"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.RemoveDefinitionStep))" />
                }
            </Stack>
        </ChildContent>
    </Dialog>
}

@if (managerChatRunSelectorOpen)
{
    <Dialog IsOpen="true"
            Eyebrow="Manager chat"
            Title="Select process run"
            Subtitle="Choose the run the manager should discuss in this chat."
            Size="ModalSize.Wide"
            TestId="processes-manager-chat-run-selector"
            OnClose="CloseManagerChatRunSelectorAsync">
        <ChildContent>
            <Stack GapScale="LayoutGap.Medium">
                <Cluster Gap="LayoutGap.Small"
                         Wrap="FlexWrap.Wrap">
                    <Button Text="No specific run"
                            ButtonStyle="@(managerChatSelectedRunId.HasValue ? ButtonStyle.Light : ButtonStyle.Primary)"
                            Click="@(() => SelectManagerChatRunAsync(null))"
                            data-testid="processes-manager-chat-run-none" />
                    <Button Text="Refresh runs"
                            ButtonStyle="ButtonStyle.Light"
                            Disabled="@managerChatIsLoading"
                            IsBusy="@managerChatIsLoading"
                            Click="@(() => LoadManagerChatAsync())" />
                </Cluster>

                @if (runs.Count == 0)
                {
                    <EmptyState Eyebrow="No runs"
                                Title="No runs are available for this process"
                                Description="Start a run from the Runs tab, then return here to discuss it with the manager." />
                }
                else
                {
                    <div class="max-h-[60vh] overflow-y-auto pr-1"
                         style="scrollbar-gutter:stable;"
                         data-testid="processes-manager-chat-run-list">
                        <Stack GapScale="LayoutGap.Small">
                            @foreach (var run in runs.OrderByDescending(item => item.UpdatedAtUtc))
                            {
                                var isSelectedManagerChatRun = managerChatSelectedRunId == run.Id;
                                <SelectionListItem Title="@run.Name"
                                                   Eyebrow="@run.Status.ToString()"
                                                   Meta="@BuildRunSummary(run)"
                                                   Summary="@(string.IsNullOrWhiteSpace(run.ManagerAgentName) ? "Default process manager" : run.ManagerAgentName)"
                                                   Dense="true"
                                                   IsSelected="@isSelectedManagerChatRun"
                                                   OnSelect="@(() => SelectManagerChatRunAsync(run.Id))">
                                    <Status>
                                        <Cluster Gap="LayoutGap.Small"
                                                 Wrap="FlexWrap.Wrap">
                                            <StatusBadge Tone="@ResolveRunTone(run.Status)"
                                                         Text="@run.Status.ToString()" />
                                            <StatusBadge Tone="neutral"
                                                         Text="@($"{run.CompletedStepCount}/{run.TotalStepCount} steps")" />
                                            @if (run.BlockedStepCount > 0)
                                            {
                                                <StatusBadge Tone="warning"
                                                             Text="@($"{run.BlockedStepCount} blocked")" />
                                            }
                                            @if (run.CapabilityGapCount > 0)
                                            {
                                                <StatusBadge Tone="danger"
                                                             Text="@($"{run.CapabilityGapCount} gaps")" />
                                            }
                                            <StatusBadge Tone="neutral"
                                                         Text="@run.UpdatedAtUtc.LocalDateTime.ToString("g")" />
                                        </Cluster>
                                    </Status>
                                </SelectionListItem>
                            }
                        </Stack>
                    </div>
                }
            </Stack>
        </ChildContent>
    </Dialog>
}

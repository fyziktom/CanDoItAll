@namespace CanDoItAll.Modules.Processes

<PageTitle>@PageTitleText</PageTitle>

<PageScaffold>
    <Header>
        <PageHeader Eyebrow="@PageEyebrow"
                    Title="@PageTitleText"
                    Description="Author role-first process definitions, start governed runs, and keep assignments, evidence, conformance, and improvement signals on the same durable model.">
            <Actions>
                <Button Text="New definition"
                        Click="CreateNewAsync"
                        data-testid="processes-new-definition-button" />
                <Button Text="Templates"
                        ButtonStyle="ButtonStyle.Light"
                        Click="OpenTemplateLibraryAsync"
                        data-testid="processes-templates-button" />
            </Actions>
        </PageHeader>
    </Header>

    <ChildContent>
        <SummaryTiles>
            <SummaryTile Label="Definitions"
                         Value="@definitions.Count.ToString()"
                         HelperText="Persisted process definitions." />
            <SummaryTile Label="Visible"
                         Value="@FilteredDefinitions.Count.ToString()"
                         HelperText="Definitions matching the current search."
                         Tone="info" />
            <SummaryTile Label="Active runs"
                         Value="@definitions.Sum(item => item.ActiveRunCount).ToString()"
                         HelperText="Runs still active across the visible library." />
            <SummaryTile Label="Improvements"
                         Value="@analytics.ImprovementCandidateCount.ToString()"
                         HelperText="Improvement signals linked to the current scope."
                         Tone="warning" />
        </SummaryTiles>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <SurfaceCard Soft="true"
                         data-testid="processes-message-card">
                <p class="cda-eyebrow">Workspace status</p>
                <p class="mt-2 text-sm leading-6 @(isError ? "text-rose-700" : "text-slate-700")">@message</p>
            </SurfaceCard>
        }

        <ListDetailShell ListPaneWidth="28rem">
            <ListHeader>
                <ListPanelHeader Title="Process definitions"
                                 Description="Keep the process contract, role design, runtime runs, and governance artifacts inside one workspace instead of splitting authoring and execution into different tools."
                                 Count="@($"{FilteredDefinitions.Count} definition(s)")">
                    <Filters>
                        <FilterBar ResultText="@($"{FilteredDefinitions.Count} matching definition(s)")">
                            <input @bind="definitionSearch"
                                   @bind:event="oninput"
                                   class="cda-input min-w-[16rem] flex-1"
                                   placeholder="Search name, summary, or value statement"
                                   data-testid="processes-definition-search" />
                            <Button Text="Clear search"
                                    ButtonStyle="ButtonStyle.Light"
                                    Size="ButtonSize.Small"
                                    Click="@(() => definitionSearch = string.Empty)" />
                            <Button Text="New"
                                    ButtonStyle="ButtonStyle.Light"
                                    Size="ButtonSize.Small"
                                    Click="CreateNewAsync" />
                        </FilterBar>
                    </Filters>
                </ListPanelHeader>
            </ListHeader>

            <ListContent>
                @if (FilteredDefinitions.Count == 0)
                {
                    <EmptyState Eyebrow="No definitions"
                                Title="Create the first process definition"
                                Description="Role-first process definitions appear here after they have been saved. Use the detail pane to define the contract, roles, steps, runtime expectations, and import-export envelope.">
                        <Actions>
                            <Button Text="New definition"
                                    Click="CreateNewAsync" />
                            <Button Text="Templates"
                                    ButtonStyle="ButtonStyle.Light"
                                    Click="OpenTemplateLibraryAsync"
                                    data-testid="processes-empty-templates-button" />
                        </Actions>
                    </EmptyState>
                }
                else
                {
                    <Stack GapScale="LayoutGap.Medium">
                        @foreach (var definition in FilteredDefinitions)
                        {
                            <SelectionListItem Title="@definition.Name"
                                               Eyebrow="@(string.IsNullOrWhiteSpace(definition.ProjectName) ? "Global process" : definition.ProjectName)"
                                               Meta="@BuildDefinitionSummary(definition)"
                                               Summary="@definition.Summary"
                                               IsSelected="@(selectedProcessId == definition.Id)"
                                               OnSelect="@(() => SelectDefinitionAsync(definition.Id))">
                                <Status>
                                    <Cluster Gap="LayoutGap.Small">
                                        <StatusBadge Tone="@ResolveDefinitionStatusTone(definition.Status)"
                                                     Text="@definition.Status.ToString()" />
                                        <StatusBadge Tone="info"
                                                     Text="@($"{definition.ActiveRunCount} active run(s)")" />
                                    </Cluster>
                                </Status>
                            </SelectionListItem>
                        }
                    </Stack>
                }
            </ListContent>

            <DetailHeader>
                <Stack GapScale="LayoutGap.Medium">
                    <SurfaceCard>
                        <Split Gap="LayoutGap.Medium">
                            <Stack GapScale="LayoutGap.Tiny">
                                <p class="cda-eyebrow">Process workspace</p>
                                <h2 class="text-xl font-semibold text-slate-950">@EditorTitle</h2>
                                <p class="text-sm leading-6 text-slate-600">
                                    @(selectedProcessId.HasValue
                                        ? "Change the durable process contract, then validate the same definition through runtime runs, deviations, and captured evidence."
                                        : "Start with the definition contract first. Roles, steps, runtime runs, and governance artifacts attach to the saved process identity.")
                                </p>
                            </Stack>
                            <Cluster Gap="LayoutGap.Small">
                                <StatusBadge Tone="@SelectedDefinitionTone" Text="@editor.Status.ToString()" />
                                <StatusBadge Tone="neutral" Text="@($"{editor.Roles.Count} role(s)")" />
                                <StatusBadge Tone="info" Text="@($"{editor.Steps.Count} step(s)")" />
                                @if (SelectedDefinitionSummary is not null)
                                {
                                    <StatusBadge Tone="warning" Text="@($"{SelectedDefinitionSummary.UnfilledRoleCount} open assignment(s)")" />
                                }
                            </Cluster>
                        </Split>
                    </SurfaceCard>
                </Stack>
            </DetailHeader>

            <DetailContent>
                <Tabs SelectedIndex="@SelectedDetailTabIndex"
                      SelectedIndexChanged="HandleDetailTabChanged"
                      Variant="@(TabsVariant.WorkspaceSecondary)"
                      BorderMode="@(TabsBorderMode.Soft)"
                      AriaLabel="Process workspace detail panels">
                    <TabItems>
                        <TabsItem Text="Definition">
                        <ProcessDefinitionForm Model="@editor"
                                               ScopeLabel="@(ProjectId.HasValue ? projectName : "Global process library")"
                                               Save="SaveAsync"
                                               Publish="PublishAsync"
                                               Delete="DeleteAsync" />
                        </TabsItem>
                        <TabsItem Text="Roles">
                        <FormSection Title="Role requirements"
                                     Description="Define who the process needs first. Exact person, supplier, or agent binding happens later at runtime without changing the process contract.">
                            <Actions>
                                <Button Text="Add role"
                                        ButtonStyle="ButtonStyle.Light"
                                        Click="AddRole"
                                        data-testid="processes-add-role-button" />
                                <Button Text="Templates"
                                        ButtonStyle="ButtonStyle.Light"
                                        Click="OpenTemplateLibraryAsync"
                                        data-testid="processes-role-templates-button" />
                            </Actions>
                            <ChildContent>
                                @if (editor.Roles.Count == 0)
                                {
                                    <EmptyState Eyebrow="No role requirements"
                                                Title="Add the first role"
                                                Description="Role definitions capture purpose, staffing intent, fallback policy, and the expected executor kind before any runtime assignment happens." />
                                }
                                else
                                {
                                    <Stack GapScale="LayoutGap.Medium">
                                        @foreach (var role in editor.Roles)
                                        {
                                            <ProcessRoleEditorForm Model="@role"
                                                                   Remove="@(() => RemoveRole(role))" />
                                        }
                                    </Stack>
                                }

                                <Cluster Gap="LayoutGap.Small">
                                    <Button Text="Save definition"
                                            Click="SaveAsync" />
                                    <Button Text="Publish"
                                            ButtonStyle="ButtonStyle.Light"
                                            Click="PublishAsync" />
                                </Cluster>
                            </ChildContent>
                        </FormSection>
                        </TabsItem>
                        <TabsItem Text="Steps">
                        <CanvasWorkbenchStage Eyebrow="Definition canvas"
                                              Title="Process definition map"
                                              Description="Review the structural shape of the definition, right-click into templates, and keep the selection inspector plus authoring windows aligned with the shared canvas workflow.">
                            <Canvas>
                                @if (canvasSurface is null)
                                {
                                    <SurfaceCard Soft="true">
                                        <p class="text-sm text-slate-600">The process canvas appears after the workspace surface is prepared.</p>
                                    </SurfaceCard>
                                }
                                else
                                {
                                    <CanvasWorkbench Surface="canvasSurface"
                                                     @ref="workbenchRef"
                                                     StateChanged="HandleCanvasStateChangedAsync"
                                                     SelectionChanged="HandleCanvasSelectionChangedAsync"
                                                     NodesMoved="HandleCanvasNodesMovedAsync"
                                                     ContextActionRequested="HandleCanvasContextActionAsync"
                                                     CreateActionInvoked="HandleCanvasCreateActionAsync"
                                                     NodeEdited="HandleCanvasNodeEditedAsync"
                                                     NodeOpened="HandleCanvasNodeOpenedAsync">
                                        <ToolbarLeftContent>
                                            <ProcessCanvasToolbarActions SelectionWindowVisible="@canvasSelectionWindowState.IsVisible"
                                                                         ActiveTool="@definitionCanvasTool"
                                                                         ToolboxWindowVisible="@canvasToolboxWindowState.IsVisible"
                                                                         SelectToolClicked="SelectDefinitionCanvasToolAsync"
                                                                         DeleteToolClicked="DeleteDefinitionCanvasToolAsync"
                                                                         ToggleSelectionWindow="ToggleCanvasSelectionWindowAsync"
                                                                         ToggleToolboxWindow="ToggleCanvasToolboxWindowAsync" />
                                        </ToolbarLeftContent>
                                        <OverlayContent>
                                            @if (canvasToolboxWindowState.IsVisible)
                                            {
                                                <ProcessCanvasToolboxWindow WindowId="@CanvasToolboxWindowId"
                                                                            TestId="processes-canvas-toolbox-window"
                                                                            AriaLabel="Process templates toolbox"
                                                                            Kicker="Process toolbox"
                                                                            Title="Process components library"
                                                                            Summary="Open role and step templates without duplicating the form logic outside the canvas workflow."
                                                                            State="@canvasToolboxWindowState"
                                                                            StateChanged="HandleCanvasToolboxWindowStateChangedAsync"
                                                                            Groups="@DefinitionToolboxGroups"
                                                                            SearchText="@canvasToolboxSearchText"
                                                                            SearchTextChanged="@((string? value) => canvasToolboxSearchText = value ?? string.Empty)"
                                                                            OpenAction="@(actionId => ExecuteCanvasActionAsync(actionId, selectedCanvasNodeId, 0, 0))" />
                                            }
                                            @if (canvasSelectionWindowState.IsVisible)
                                            {
                                                <CanvasFloatingWindow WindowId="@CanvasSelectionWindowId"
                                                                      TestId="processes-canvas-selection-window"
                                                                      AriaLabel="Process canvas selection"
                                                                      Kicker="Selection"
                                                                      Title="@CanvasSelectionWindowTitle"
                                                                      Summary="@CanvasSelectionWindowSummary"
                                                                      DefaultPlacement="top-right"
                                                                      DefaultWidth="360"
                                                                      DefaultHeight="360"
                                                                      MinWidth="320"
                                                                      MinHeight="220"
                                                                      MaxWidth="520"
                                                                      State="@canvasSelectionWindowState"
                                                                      StateChanged="HandleCanvasSelectionWindowStateChangedAsync">
                                                    <ProcessCanvasSelectionPanel DefinitionStep="@SelectedCanvasDefinitionStep"
                                                                                 DefinitionRole="@SelectedCanvasDefinitionRole"
                                                                                 OpenToolbox="OpenCanvasToolboxAsync"
                                                                                 ClearSelection="ClearCanvasSelectionAsync"
                                                                                 EditDefinitionStep="@(async () => { OpenDefinitionStepEditor(); await Task.CompletedTask; })"
                                                                                 EditDefinitionRole="@(async () => { OpenDefinitionRoleEditor(); await Task.CompletedTask; })"
                                                                                 AddDependentStep="@(async () => { OpenCanvasStepEditor(ProcessCanvasActionIds.CreateStepImplementation, SelectedCanvasDefinitionStep, 0, 0); await Task.CompletedTask; })"
                                                                                 AddBranchOutcome="AddBranchOutcomeToSelectedStepAsync"
                                                                                 AddRoutedStep="AddRoutedStepFromSelectedStepAsync"
                                                                                 AddRoleBinding="@(async () => { AddRoleBindingToSelectedStep(); await Task.CompletedTask; })"
                                                                                 AddArtifactExpectation="@(async () => { AddArtifactExpectationToSelectedStep(); await Task.CompletedTask; })"
                                                                                 OpenActionDialog="OpenCanvasActionDialogAsync" />
                                                </CanvasFloatingWindow>
                                            }
                                            @if (IsCanvasEditorOpen)
                                            {
                                                <CanvasFloatingWindow WindowId="@CanvasEditorWindowId"
                                                                      TestId="processes-canvas-editor-window"
                                                                      AriaLabel="Process canvas editor"
                                                                      Kicker="Canvas editor"
                                                                      Title="@CanvasEditorWindowTitle"
                                                                      Summary="@CanvasEditorWindowSummary"
                                                                      DefaultPlacement="bottom-right"
                                                                      DefaultWidth="540"
                                                                      DefaultHeight="620"
                                                                      MinWidth="380"
                                                                      MinHeight="320"
                                                                      MaxWidth="760"
                                                                      State="@canvasEditorWindowState"
                                                                      StateChanged="HandleCanvasEditorWindowStateChangedAsync">
                                                    <Stack GapScale="LayoutGap.Large">
                                                        @if (IsCanvasEditorCreateMode)
                                                        {
                                                            <FormField Text="Template">
                                                                <select class="cda-input"
                                                                        value="@canvasTemplateActionId"
                                                                        @onchange="HandleCanvasTemplateChangedAsync"
                                                                        data-testid="processes-canvas-template-select">
                                                                    @if (canvasRoleDraft is not null)
                                                                    {
                                                                        @foreach (var template in CanvasRoleTemplates)
                                                                        {
                                                                            <option value="@template.ActionId">@template.Label</option>
                                                                        }
                                                                    }
                                                                    else if (canvasStepDraft is not null)
                                                                    {
                                                                        @foreach (var template in CanvasStepTemplates)
                                                                        {
                                                                            <option value="@template.ActionId">@template.Label</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </FormField>
                                                        }

                                                        @if (canvasRoleDraft is not null)
                                                        {
                                                            <ProcessRoleEditorForm Model="@canvasRoleDraft"
                                                                                   ShowRemove="false"
                                                                                   TestId="processes-canvas-role-editor" />
                                                        }
                                                        else if (canvasStepDraft is not null)
                                                        {
                                                            <ProcessStepEditorForm Model="@canvasStepDraft"
                                                                                   AvailableRoles="@editor.Roles"
                                                                                   DependencyOptions="@CanvasEditorDependencyOptions"
                                                                                   ShowRemove="false"
                                                                                   TestId="processes-canvas-step-editor"
                                                                                   AddBranchOutcome="AddCanvasBranchOutcomeAsync"
                                                                                   RemoveBranchOutcome="RemoveCanvasBranchOutcomeAsync"
                                                                                   AddRoleAssignment="AddCanvasRoleAssignmentAsync"
                                                                                   RemoveRoleAssignment="RemoveCanvasRoleAssignmentAsync"
                                                                                   AddArtifact="AddCanvasArtifactExpectationAsync"
                                                                                   RemoveArtifact="RemoveCanvasArtifactExpectationAsync" />
                                                        }

                                                        <Cluster Gap="LayoutGap.Small">
                                                            <Button Text="Cancel"
                                                                    ButtonStyle="ButtonStyle.Light"
                                                                    Click="CloseCanvasEditorAsync" />
                                                            <Button Text="Apply"
                                                                    Click="SaveCanvasEditorAsync"
                                                                    data-testid="processes-canvas-editor-apply" />
                                                        </Cluster>
                                                    </Stack>
                                                </CanvasFloatingWindow>
                                            }
                                        </OverlayContent>
                                    </CanvasWorkbench>
                                }
                            </Canvas>
                        </CanvasWorkbenchStage>

                        <FormSection Title="Workflow steps"
                                     Description="Shape the executable path, explicit dependencies, role bindings, and evidence expectations before the first runtime run starts.">
                            <Actions>
                                <Button Text="Add step"
                                        ButtonStyle="ButtonStyle.Light"
                                        Click="AddStep"
                                        data-testid="processes-add-step-button" />
                            </Actions>
                            <ChildContent>
                                @if (editor.Steps.Count == 0)
                                {
                                    <EmptyState Eyebrow="No steps"
                                                Title="Add the first workflow step"
                                                Description="Steps define the order, dependency chain, role bindings, and required artifacts for the process definition." />
                                }
                                else
                                {
                                    <Stack GapScale="LayoutGap.Medium">
                                        @foreach (var step in editor.Steps)
                                        {
                                            <ProcessStepEditorForm Model="@step"
                                                                   AvailableRoles="@editor.Roles"
                                                                   DependencyOptions="@(editor.Steps.Where(candidate => candidate != step).ToList())"
                                                                   Remove="@(() => RemoveStep(step))"
                                                                   AddBranchOutcome="@(() => AddBranchOutcome(step))"
                                                                   RemoveBranchOutcome="@((ProcessStepBranchOutcomeEditorModel branchOutcome) => RemoveBranchOutcome(step, branchOutcome))"
                                                                   AddRoleAssignment="@(() => AddRoleAssignment(step))"
                                                                   RemoveRoleAssignment="@((ProcessStepRoleRequirementEditorModel assignment) => RemoveRoleAssignment(step, assignment))"
                                                                   AddArtifact="@(() => AddArtifact(step))"
                                                                   RemoveArtifact="@((ProcessArtifactExpectationEditorModel artifact) => RemoveArtifact(step, artifact))" />
                                        }
                                    </Stack>
                                }

                                <Cluster Gap="LayoutGap.Small">
                                    <Button Text="Save definition"
                                            Click="SaveAsync" />
                                    <Button Text="Publish"
                                            ButtonStyle="ButtonStyle.Light"
                                            Click="PublishAsync" />
                                </Cluster>
                            </ChildContent>
                        </FormSection>
                        </TabsItem>
                        <TabsItem Text="Runs">
                        <CanvasWorkbenchStage Eyebrow="Runtime canvas"
                                              Title="@(SelectedRun?.Name ?? "Runtime map")"
                                              Description="Inspect the live runtime path, keep the selection detail window in sync, and drive explicit runtime actions from the same canvas rhythm used in structure workbench flows.">
                            <Canvas>
                                @if (SelectedRun is null)
                                {
                                    <SurfaceCard Soft="true">
                                        <p class="text-sm text-slate-600">Select a run to inspect the runtime canvas before updating status, branch outcomes, or runtime evidence.</p>
                                    </SurfaceCard>
                                }
                                else if (canvasSurface is null)
                                {
                                    <SurfaceCard Soft="true">
                                        <p class="text-sm text-slate-600">Runtime canvas data is loading.</p>
                                    </SurfaceCard>
                                }
                                else
                                {
                                    <CanvasWorkbench Surface="canvasSurface"
                                                     @ref="workbenchRef"
                                                     StateChanged="HandleCanvasStateChangedAsync"
                                                     SelectionChanged="HandleCanvasSelectionChangedAsync"
                                                     ContextActionRequested="HandleCanvasContextActionAsync"
                                                     NodeOpened="HandleCanvasNodeOpenedAsync">
                                        <ToolbarLeftContent>
                                            <ProcessCanvasToolbarActions SelectionWindowVisible="@canvasSelectionWindowState.IsVisible"
                                                                         ShowAuthoringTools="false"
                                                                         ShowToolbox="false"
                                                                         SelectionTestId="processes-runtime-toggle-selection"
                                                                         ToggleSelectionWindow="ToggleCanvasSelectionWindowAsync" />
                                        </ToolbarLeftContent>
                                        <OverlayContent>
                                            @if (canvasSelectionWindowState.IsVisible)
                                            {
                                                <CanvasFloatingWindow WindowId="@CanvasSelectionWindowId"
                                                                      TestId="processes-runtime-selection-window"
                                                                      AriaLabel="Process runtime selection"
                                                                      Kicker="Runtime selection"
                                                                      Title="@CanvasSelectionWindowTitle"
                                                                      Summary="@CanvasSelectionWindowSummary"
                                                                      DefaultPlacement="top-right"
                                                                      DefaultWidth="360"
                                                                      DefaultHeight="360"
                                                                      MinWidth="320"
                                                                      MinHeight="220"
                                                                      MaxWidth="520"
                                                                      State="@canvasSelectionWindowState"
                                                                      StateChanged="HandleCanvasSelectionWindowStateChangedAsync">
                                                    <ProcessCanvasSelectionPanel IsRuntime="true"
                                                                                 RuntimeStep="@SelectedCanvasRuntimeStep"
                                                                                 SelectedRuntimeBranchOutcomeId="@(SelectedCanvasRuntimeStep is null ? null : ResolveSelectedBranchOutcomeId(SelectedCanvasRuntimeStep.Id))"
                                                                                 SelectedRuntimeBranchOutcomeIdChanged="@(value => SelectedCanvasRuntimeStep is null ? Task.CompletedTask : UpdateRuntimeBranchOutcomeSelectionAsync(SelectedCanvasRuntimeStep.Id, value))"
                                                                                 ClearSelection="ClearCanvasSelectionAsync"
                                                                                 OpenActionDialog="OpenCanvasActionDialogAsync"
                                                                                 StartRuntimeStep="@(async () => await ApplySelectedRuntimeStatusAsync(ProcessStepRunStatus.InProgress))"
                                                                                 CompleteRuntimeStep="@(async () => await ApplySelectedRuntimeStatusAsync(ProcessStepRunStatus.Completed))"
                                                                                 BlockRuntimeStep="@(async () => await ApplySelectedRuntimeStatusAsync(ProcessStepRunStatus.Blocked))"
                                                                                 RequestRuntimeApproval="@(async () => await ApplySelectedRuntimeStatusAsync(ProcessStepRunStatus.WaitingApproval))"
                                                                                 RefuseRuntimeStep="@(async () => await ApplySelectedRuntimeStatusAsync(ProcessStepRunStatus.Refused))"
                                                                                 FailRuntimeStep="@(async () => await ApplySelectedRuntimeStatusAsync(ProcessStepRunStatus.Failed))"
                                                                                 RecordRuntimeArtifact="@(async () => { PrepareSelectedRuntimeArtifactCapture(); await Task.CompletedTask; })" />
                                                </CanvasFloatingWindow>
                                            }
                                        </OverlayContent>
                                    </CanvasWorkbench>
                                }
                            </Canvas>
                        </CanvasWorkbenchStage>

                        <SectionCard Title="Run lifecycle"
                                     Description="Start process runs from the selected definition, then keep runtime state, assignments, and evidence attached to the same durable process identity.">
                            @if (!selectedProcessId.HasValue)
                            {
                                <EmptyState Eyebrow="Definition required"
                                            Title="Save a process definition first"
                                            Description="Runtime execution starts only after the process contract, roles, and steps exist on a durable definition." />
                            }
                            else
                            {
                                <Grid Gap="LayoutGap.Large"
                                      ColumnsMd="3">
                                    <div>
                                        <label class="cda-field-label">Run name</label>
                                        <InputText @bind-Value="runNameDraft"
                                                   class="cda-input"
                                                   data-testid="processes-run-name-input" />
                                    </div>
                                    <div>
                                        <label class="cda-field-label">Operating mode</label>
                                        <InputSelect @bind-Value="runOperatingMode"
                                                     class="cda-input"
                                                     data-testid="processes-operating-mode-select">
                                            @foreach (var operatingMode in Enum.GetValues<ProcessOperatingMode>())
                                            {
                                                <option value="@operatingMode">@operatingMode</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <div class="flex items-end">
                                        <Button Text="Start run"
                                                Click="StartRunAsync"
                                                data-testid="processes-start-run-button" />
                                    </div>
                                </Grid>

                                @if (runs.Count == 0)
                                {
                                    <EmptyState Eyebrow="No runtime runs"
                                                Title="Start the first run"
                                                Description="Runs bring the definition to life and populate assignments, work briefs, decision records, evidence, and conformance observations." />
                                }
                                else
                                {
                                    <Stack GapScale="LayoutGap.Medium"
                                           Class="mt-5">
                                        @foreach (var run in runs)
                                        {
                                            <SelectionListItem Title="@run.Name"
                                                               Eyebrow="@run.OperatingMode.ToString()"
                                                               Meta="@BuildRunSummary(run)"
                                                               Summary="@($"{run.EstimatedCost:C} estimated / {run.ActualCost:C} actual")"
                                                               IsSelected="@(selectedRunId == run.Id)"
                                                               OnSelect="@(() => SelectRunAsync(run.Id))">
                                                <Status>
                                                    <Cluster Gap="LayoutGap.Small">
                                                        <StatusBadge Tone="@ResolveRunTone(run.Status)"
                                                                     Text="@run.Status.ToString()" />
                                                        <StatusBadge Tone="neutral"
                                                                     Text="@($"{run.BlockedStepCount} blocked")" />
                                                    </Cluster>
                                                </Status>
                                            </SelectionListItem>
                                        }
                                    </Stack>
                                }
                            }
                        </SectionCard>

                        @if (SelectedRun is not null)
                        {
                            <SummaryTiles>
                                <SummaryTile Label="Completed steps"
                                             Value="@SelectedRun.CompletedStepCount.ToString()"
                                             HelperText="@($"{SelectedRun.TotalStepCount} total steps in this run.")" />
                                <SummaryTile Label="Blocked steps"
                                             Value="@SelectedRun.BlockedStepCount.ToString()"
                                             HelperText="Steps currently blocked in runtime."
                                             Tone="warning" />
                                <SummaryTile Label="Capability gaps"
                                             Value="@SelectedRun.CapabilityGapCount.ToString()"
                                             HelperText="Assignments or execution gaps detected."
                                             Tone="danger" />
                                <SummaryTile Label="Actual cost"
                                             Value="@SelectedRun.ActualCost.ToString("C")"
                                             HelperText="@($"{SelectedRun.EstimatedCost:C} estimated for this run.")"
                                             Tone="info" />
                            </SummaryTiles>

                            <SectionCard Title="Step execution"
                                         Description="Update runtime state explicitly so blocked work, safe refusals, approvals, and failures become durable evidence instead of disappearing into chat.">
                                @if (stepRuns.Count == 0)
                                {
                                    <EmptyState Eyebrow="No step runs"
                                                Title="No runtime step data yet"
                                                Description="Step runs populate after the selected run is loaded from storage." />
                                }
                                else
                                {
                                    <Stack GapScale="LayoutGap.Medium">
                                        @foreach (var stepRun in stepRuns)
                                        {
                                            <SurfaceCard data-testid="processes-step-run-card">
                                                <Split Gap="LayoutGap.Medium">
                                                    <Stack GapScale="LayoutGap.Tiny">
                                                        <p class="cda-eyebrow">Step @(stepRun.Sequence + 1)</p>
                                                        <h3 class="text-lg font-semibold text-slate-950">@stepRun.Title</h3>
                                                        <p class="text-sm leading-6 text-slate-600">Executor: @(string.IsNullOrWhiteSpace(stepRun.CurrentExecutorName) ? "Unassigned" : stepRun.CurrentExecutorName)</p>
                                                    </Stack>
                                                    <Cluster Gap="LayoutGap.Small">
                                                        <StatusBadge Tone="@ResolveStepTone(stepRun.Status)"
                                                                     Text="@stepRun.Status.ToString()" />
                                                        <StatusBadge Tone="neutral"
                                                                     Text="@stepRun.StepKind.ToString()" />
                                                    </Cluster>
                                                </Split>

                                                <Grid Gap="LayoutGap.Medium"
                                                      ColumnsMd="4"
                                                      Class="mt-5">
                                                    <MetricCard Label="Wait" Value="@($"{stepRun.WaitMinutes}m")" />
                                                    <MetricCard Label="Touch" Value="@($"{stepRun.TouchMinutes}m")" />
                                                    <MetricCard Label="Blocked" Value="@($"{stepRun.BlockedMinutes}m")" />
                                                    <MetricCard Label="Rework" Value="@stepRun.ReworkCount.ToString()" />
                                                </Grid>

                                                @if (stepRun.AvailableBranchOutcomes.Count > 0)
                                                {
                                                    <div class="mt-5">
                                                        <label class="cda-field-label">Branch outcome</label>
                                                        <InputSelect TValue="Guid?"
                                                                     Value="@(ResolveSelectedBranchOutcomeId(stepRun.Id))"
                                                                     ValueChanged="@(value => UpdateRuntimeBranchOutcomeSelectionAsync(stepRun.Id, value))"
                                                                     class="cda-input"
                                                                     data-testid="processes-branch-outcome-select">
                                                            <option value="">Select outcome</option>
                                                            @foreach (var outcome in stepRun.AvailableBranchOutcomes)
                                                            {
                                                                <option value="@outcome.Id">@outcome.Title</option>
                                                            }
                                                        </InputSelect>
                                                    </div>
                                                }

                                                <Cluster Gap="LayoutGap.Small"
                                                         Class="mt-5">
                                                    <Button Text="Start"
                                                            ButtonStyle="ButtonStyle.Light"
                                                            Disabled="@(!CanApplyRuntimeStatus(stepRun, ProcessStepRunStatus.InProgress))"
                                                            Click="@(() => ApplyStepStatusAsync(stepRun.Id, ProcessStepRunStatus.InProgress))" />
                                                    <Button Text="Complete"
                                                            Disabled="@(!CanApplyRuntimeStatus(stepRun, ProcessStepRunStatus.Completed))"
                                                            Click="@(() => ApplyStepStatusAsync(stepRun.Id, ProcessStepRunStatus.Completed))" />
                                                    <Button Text="Block"
                                                            ButtonStyle="ButtonStyle.Light"
                                                            Disabled="@(!CanApplyRuntimeStatus(stepRun, ProcessStepRunStatus.Blocked))"
                                                            Click="@(() => ApplyStepStatusAsync(stepRun.Id, ProcessStepRunStatus.Blocked))" />
                                                    <Button Text="Approval"
                                                            ButtonStyle="ButtonStyle.Light"
                                                            Disabled="@(!CanApplyRuntimeStatus(stepRun, ProcessStepRunStatus.WaitingApproval))"
                                                            Click="@(() => ApplyStepStatusAsync(stepRun.Id, ProcessStepRunStatus.WaitingApproval))" />
                                                    <Button Text="Refuse"
                                                            ButtonStyle="ButtonStyle.Light"
                                                            Disabled="@(!CanApplyRuntimeStatus(stepRun, ProcessStepRunStatus.Refused))"
                                                            Click="@(() => ApplyStepStatusAsync(stepRun.Id, ProcessStepRunStatus.Refused))" />
                                                    <Button Text="Fail"
                                                            ButtonStyle="ButtonStyle.Light"
                                                            Disabled="@(!CanApplyRuntimeStatus(stepRun, ProcessStepRunStatus.Failed))"
                                                            Click="@(() => ApplyStepStatusAsync(stepRun.Id, ProcessStepRunStatus.Failed))" />
                                                </Cluster>
                                            </SurfaceCard>
                                        }
                                    </Stack>
                                }
                            </SectionCard>

                            <SectionCard Title="Assignments and executor resolution"
                                         Description="Role-first runtime assignments can be rebound to project parties, suppliers, or future agents without changing the process definition.">
                                <Grid Gap="LayoutGap.Large"
                                      ColumnTemplateLg="minmax(0,0.8fr) minmax(0,1.2fr)">
                                    <div>
                                        @if (assignments.Count == 0)
                                        {
                                            <EmptyState Eyebrow="No assignments"
                                                        Title="No runtime assignments yet"
                                                        Description="Assignments populate when the run snapshots the process role requirements." />
                                        }
                                        else
                                        {
                                            <Stack GapScale="LayoutGap.Medium">
                                                @foreach (var assignment in assignments)
                                                {
                                                    <SelectionListItem Title="@ResolveRoleName(assignment.RoleRequirementId)"
                                                                       Eyebrow="@(assignment.StepDefinitionId.HasValue ? "Step-scoped assignment" : "Run-scoped assignment")"
                                                                       Meta="@assignment.ExecutorKind"
                                                                       Summary="@(string.IsNullOrWhiteSpace(assignment.DisplayName) ? assignment.BindingReason : $"{assignment.DisplayName} / {assignment.BindingReason}")"
                                                                       IsSelected="@(selectedAssignmentId == assignment.Id)"
                                                                       OnSelect="@(() => SelectAssignment(assignment.Id))">
                                                        <Status>
                                                            <Cluster Gap="LayoutGap.Small">
                                                                <StatusBadge Tone="@(assignment.IsCapabilityGap ? "danger" : "neutral")"
                                                                             Text="@(assignment.IsCapabilityGap ? "Gap" : "Bound")" />
                                                                <StatusBadge Tone="@(assignment.IsFallback ? "warning" : "info")"
                                                                             Text="@(assignment.IsFallback ? "Fallback" : "Primary")" />
                                                            </Cluster>
                                                        </Status>
                                                    </SelectionListItem>
                                                }
                                            </Stack>
                                        }
                                    </div>

                                    <SurfaceCard>
                                        @if (SelectedAssignment is null)
                                        {
                                            <EmptyState Eyebrow="No assignment selected"
                                                        Title="Choose an assignment to resolve"
                                                        Description="The selected role binding can be matched to a project party or later executor registry without rewriting the process definition." />
                                        }
                                        else
                                        {
                                            <Stack GapScale="LayoutGap.Medium">
                                                <div>
                                                    <label class="cda-field-label">Project party</label>
                                                    <InputSelect @bind-Value="assignmentPartyId"
                                                                 class="cda-input">
                                                        <option value="">None</option>
                                                        @foreach (var option in partyOptions)
                                                        {
                                                            <option value="@option.PartyId">@option.DisplayName</option>
                                                        }
                                                    </InputSelect>
                                                </div>
                                                <div>
                                                    <label class="cda-field-label">Display name</label>
                                                    <InputText @bind-Value="assignmentDisplayName"
                                                               class="cda-input" />
                                                </div>
                                                <div>
                                                    <label class="cda-field-label">Executor kind</label>
                                                    <InputText @bind-Value="assignmentExecutorKind"
                                                               class="cda-input" />
                                                </div>
                                                <div>
                                                    <label class="cda-field-label">Binding reason</label>
                                                    <InputTextArea @bind-Value="assignmentBindingReason"
                                                                   class="cda-input cda-input--textarea min-h-24" />
                                                </div>
                                                <label class="inline-flex items-center gap-2 text-sm text-slate-700">
                                                    <InputCheckbox @bind-Value="assignmentIsFallback" />
                                                    Treat this as fallback binding
                                                </label>
                                                <Button Text="Resolve assignment"
                                                        Click="ResolveSelectedAssignmentAsync"
                                                        data-testid="processes-resolve-assignment-button" />
                                            </Stack>
                                        }
                                    </SurfaceCard>
                                </Grid>
                            </SectionCard>

                            <SectionCard Title="Artifacts, decisions, and briefs"
                                         Description="Process runtime proof stays reviewable only if work briefs, decisions, evidence, and conformance observations remain attached to the same run.">
                                <Grid Gap="LayoutGap.Large"
                                      ColumnTemplateLg="minmax(0,1.05fr) minmax(0,0.95fr)">
                                    <Stack GapScale="LayoutGap.Large">
                                        <SurfaceCard>
                                            <p class="cda-eyebrow">Record artifact</p>
                                            <h3 class="mt-1 text-lg font-semibold text-slate-950">Runtime evidence</h3>

                                            <Grid Gap="LayoutGap.Medium"
                                                  ColumnsMd="2"
                                                  Class="mt-4">
                                                <div>
                                                    <label class="cda-field-label">Step run</label>
                                                    <InputSelect @bind-Value="artifactStepRunId"
                                                                 class="cda-input">
                                                        <option value="">Run level</option>
                                                        @foreach (var stepRun in stepRuns)
                                                        {
                                                            <option value="@stepRun.Id">@stepRun.Title</option>
                                                        }
                                                    </InputSelect>
                                                </div>
                                                <div>
                                                    <label class="cda-field-label">Artifact kind</label>
                                                    <InputSelect @bind-Value="artifactKind"
                                                                 class="cda-input">
                                                        @foreach (var artifactKindValue in Enum.GetValues<ProcessArtifactKind>())
                                                        {
                                                            <option value="@artifactKindValue">@artifactKindValue</option>
                                                        }
                                                    </InputSelect>
                                                </div>
                                            </Grid>

                                            <div class="mt-4">
                                                <label class="cda-field-label">Title</label>
                                                <InputText @bind-Value="artifactTitle"
                                                           class="cda-input"
                                                           data-testid="processes-artifact-title-input" />
                                            </div>

                                            <Cluster Gap="LayoutGap.Small"
                                                     Class="mt-4">
                                                <Button Text="Record artifact"
                                                        Click="RecordArtifactAsync"
                                                        data-testid="processes-record-artifact-button" />
                                            </Cluster>
                                        </SurfaceCard>

                                        <SurfaceCard>
                                            <p class="cda-eyebrow">Work briefs</p>
                                            <h3 class="mt-1 text-lg font-semibold text-slate-950">Executor handoff context</h3>
                                            @if (workBriefs.Count == 0)
                                            {
                                                <EmptyState Eyebrow="No work briefs"
                                                            Title="No handoff context recorded"
                                                            Description="Work briefs appear when the run creates executor-facing task packages." />
                                            }
                                            else
                                            {
                                                <Stack GapScale="LayoutGap.Small"
                                                       Class="mt-4">
                                                    @foreach (var brief in workBriefs)
                                                    {
                                                        <SurfaceCard Soft="true">
                                                            <p class="text-sm font-semibold text-slate-950">@brief.Title</p>
                                                            <p class="mt-2 text-sm leading-6 text-slate-600">@brief.WorkBriefText</p>
                                                        </SurfaceCard>
                                                    }
                                                </Stack>
                                            }
                                        </SurfaceCard>
                                    </Stack>

                                    <Stack GapScale="LayoutGap.Large">
                                        <SurfaceCard>
                                            <p class="cda-eyebrow">Decision records</p>
                                            <h3 class="mt-1 text-lg font-semibold text-slate-950">Durable runtime decisions</h3>
                                            @if (decisions.Count == 0)
                                            {
                                                <EmptyState Eyebrow="No decisions"
                                                            Title="No decision records stored"
                                                            Description="Assignment, approval, refusal, and escalation decisions appear here when captured during runtime." />
                                            }
                                            else
                                            {
                                                <Stack GapScale="LayoutGap.Small"
                                                       Class="mt-4">
                                                    @foreach (var decision in decisions)
                                                    {
                                                        <SurfaceCard Soft="true">
                                                            <p class="text-sm font-semibold text-slate-950">@decision.Title</p>
                                                            <p class="mt-1 text-xs uppercase tracking-[0.18em] text-slate-500">@decision.DecisionKind / @decision.Outcome</p>
                                                            <p class="mt-3 text-sm leading-6 text-slate-600">@decision.Reason</p>
                                                        </SurfaceCard>
                                                    }
                                                </Stack>
                                            }
                                        </SurfaceCard>

                                        <SurfaceCard>
                                            <p class="cda-eyebrow">Conformance observations</p>
                                            <h3 class="mt-1 text-lg font-semibold text-slate-950">Deviations and safe non-actions</h3>
                                            @if (conformanceObservations.Count == 0)
                                            {
                                                <EmptyState Eyebrow="No observations"
                                                            Title="No conformance records yet"
                                                            Description="Observations appear when blocked, refused, or otherwise non-conforming runtime states are recorded." />
                                            }
                                            else
                                            {
                                                <Stack GapScale="LayoutGap.Small"
                                                       Class="mt-4">
                                                    @foreach (var observation in conformanceObservations)
                                                    {
                                                        <SurfaceCard Soft="true">
                                                            <Split Gap="LayoutGap.Medium">
                                                                <div>
                                                                    <p class="text-sm font-semibold text-slate-950">@observation.Category</p>
                                                                    <p class="mt-1 text-sm leading-6 text-slate-600">@observation.Observation</p>
                                                                </div>
                                                                <StatusBadge Tone="@ResolveConformanceTone(observation.Severity)"
                                                                             Text="@observation.Severity.ToString()" />
                                                            </Split>
                                                        </SurfaceCard>
                                                    }
                                                </Stack>
                                            }
                                        </SurfaceCard>
                                    </Stack>
                                </Grid>
                            </SectionCard>
                        }
                        </TabsItem>
                        <TabsItem Text="Analytics">
                        <SummaryTiles>
                            <SummaryTile Label="Runs"
                                         Value="@analytics.TotalRuns.ToString()"
                                         HelperText="@($"{analytics.ActiveRuns} active / {analytics.CompletedRuns} completed")" />
                            <SummaryTile Label="Capability gaps"
                                         Value="@analytics.CapabilityGapCount.ToString()"
                                         HelperText="Assignments or execution capacity gaps detected."
                                         Tone="danger" />
                            <SummaryTile Label="Conformance"
                                         Value="@analytics.ConformanceObservationCount.ToString()"
                                         HelperText="@($"{analytics.SafeNonActionCount} safe non-actions recorded")"
                                         Tone="warning" />
                            <SummaryTile Label="Actual cost"
                                         Value="@analytics.ActualCost.ToString("C")"
                                         HelperText="@($"{analytics.EstimatedCost:C} estimated in scope")"
                                         Tone="info" />
                        </SummaryTiles>

                        <SectionCard Title="Improvement candidates"
                                     Description="Persist improvement opportunities, training signals, and governance review needs instead of leaving them as loose notes after runtime defects appear.">
                            @if (improvements.Count == 0)
                            {
                                <EmptyState Eyebrow="No improvement candidates"
                                            Title="Nothing recorded yet"
                                            Description="Improvement candidates populate when runtime blocking, refusal, or conformance issues reveal process design weaknesses." />
                            }
                            else
                            {
                                <Stack GapScale="LayoutGap.Medium">
                                    @foreach (var improvement in improvements)
                                    {
                                        <SurfaceCard>
                                            <Split Gap="LayoutGap.Medium">
                                                <div>
                                                    <p class="text-sm font-semibold text-slate-950">@improvement.Title</p>
                                                    <p class="mt-1 text-xs uppercase tracking-[0.18em] text-slate-500">@improvement.Category / @improvement.Status</p>
                                                </div>
                                                <Cluster Gap="LayoutGap.Small">
                                                    @if (improvement.IsTrainingOpportunity)
                                                    {
                                                        <StatusBadge Tone="info" Text="Training" />
                                                    }
                                                    @if (improvement.RequiresGovernanceReview)
                                                    {
                                                        <StatusBadge Tone="warning" Text="Governance review" />
                                                    }
                                                </Cluster>
                                            </Split>
                                            <p class="mt-3 text-sm leading-6 text-slate-600">@improvement.ProblemSummary</p>
                                        </SurfaceCard>
                                    }
                                </Stack>
                            }
                        </SectionCard>
                        </TabsItem>
                        <TabsItem Text="Exchange">
                        <SectionCard Title="Definition exchange"
                                     Description="Export and import process definition envelopes so architecture can review them, seed them, or move them between environments without copying implementation-only data.">
                            <Grid Gap="LayoutGap.Large"
                                  ColumnTemplateLg="minmax(0,1fr) minmax(0,1fr)">
                                <SurfaceCard>
                                    <p class="cda-eyebrow">Export</p>
                                    <h3 class="mt-1 text-lg font-semibold text-slate-950">Definition envelope</h3>
                                    <Cluster Gap="LayoutGap.Small"
                                             Class="mt-4">
                                        <Button Text="Export current definition"
                                                Click="ExportAsync"
                                                data-testid="processes-export-button" />
                                    </Cluster>
                                    <div class="mt-4">
                                        <label class="cda-field-label">Export JSON</label>
                                        <InputTextArea @bind-Value="exportJson"
                                                       class="cda-input cda-input--textarea cda-input--mono min-h-72"
                                                       data-testid="processes-export-json" />
                                    </div>
                                </SurfaceCard>

                                <SurfaceCard>
                                    <p class="cda-eyebrow">Import</p>
                                    <h3 class="mt-1 text-lg font-semibold text-slate-950">Import envelope</h3>
                                    <div class="mt-4">
                                        <label class="cda-field-label">Import JSON</label>
                                        <InputTextArea @bind-Value="importJson"
                                                       class="cda-input cda-input--textarea cda-input--mono min-h-72"
                                                       data-testid="processes-import-json" />
                                    </div>
                                    <Cluster Gap="LayoutGap.Small"
                                             Class="mt-4">
                                        <Button Text="Import definition"
                                                Click="ImportAsync"
                                                data-testid="processes-import-button" />
                                    </Cluster>
                                </SurfaceCard>
                            </Grid>
                        </SectionCard>
                        </TabsItem>
                    </TabItems>
                </Tabs>
            </DetailContent>
        </ListDetailShell>
    </ChildContent>
</PageScaffold>

<ProcessTemplateLibraryDialog IsOpen="@templateLibraryOpen"
                              ScopeLabel="@TemplateLibraryScopeLabel"
                              ArtifactTargets="@TemplateArtifactTargets"
                              SelectedArtifactTargetStepId="@templateLibraryArtifactTargetStepId"
                              SelectedArtifactTargetStepIdChanged="@((Guid? stepId) => templateLibraryArtifactTargetStepId = stepId)"
                              Close="CloseTemplateLibraryAsync"
                              AddProcessTemplate="AddProcessTemplateAsync"
                              AddRoleTemplate="AddRoleTemplateAsync"
                              AddArtifactTemplate="AddArtifactTemplateAsync" />

@if (canvasActionDialog is not null)
{
    <Dialog IsOpen="true"
            Eyebrow="Process canvas"
            Title="@canvasActionDialog.Title"
            Subtitle="@canvasActionDialog.Summary"
            Size="ModalSize.Medium"
            TestId="processes-canvas-action-dialog"
            OnClose="CloseCanvasActionDialogAsync">
        <ChildContent>
            <Stack GapScale="LayoutGap.Medium">
                @if (canvasActionDialog.IsRuntime)
                {
                    <Button Text="Start step"
                            ButtonStyle="ButtonStyle.Light"
                            Disabled="@(!CanApplyRuntimeStatus(SelectedCanvasRuntimeStep, ProcessStepRunStatus.InProgress))"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.RuntimeStart))" />
                    <Button Text="Complete step"
                            Disabled="@(!CanApplyRuntimeStatus(SelectedCanvasRuntimeStep, ProcessStepRunStatus.Completed))"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.RuntimeComplete))" />
                    <Button Text="Block step"
                            ButtonStyle="ButtonStyle.Light"
                            Disabled="@(!CanApplyRuntimeStatus(SelectedCanvasRuntimeStep, ProcessStepRunStatus.Blocked))"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.RuntimeBlock))" />
                    <Button Text="Wait for approval"
                            ButtonStyle="ButtonStyle.Light"
                            Disabled="@(!CanApplyRuntimeStatus(SelectedCanvasRuntimeStep, ProcessStepRunStatus.WaitingApproval))"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.RuntimeApproval))" />
                    <Button Text="Refuse safely"
                            ButtonStyle="ButtonStyle.Light"
                            Disabled="@(!CanApplyRuntimeStatus(SelectedCanvasRuntimeStep, ProcessStepRunStatus.Refused))"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.RuntimeRefuse))" />
                    <Button Text="Mark failed"
                            ButtonStyle="ButtonStyle.Light"
                            Disabled="@(!CanApplyRuntimeStatus(SelectedCanvasRuntimeStep, ProcessStepRunStatus.Failed))"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.RuntimeFail))" />
                    <Button Text="Prepare artifact capture"
                            ButtonStyle="ButtonStyle.Light"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.RuntimeRecordArtifact))" />
                }
                else
                {
                    <Button Text="Edit step"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.EditDefinitionStep))" />
                    <Button Text="Add dependent step"
                            ButtonStyle="ButtonStyle.Light"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.AddDependentStep))" />
                    <Button Text="Add branch outcome"
                            ButtonStyle="ButtonStyle.Light"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.AddBranchOutcome))" />
                    <Button Text="Add role binding"
                            ButtonStyle="ButtonStyle.Light"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.AddRoleBinding))" />
                    <Button Text="Add artifact expectation"
                            ButtonStyle="ButtonStyle.Light"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.AddArtifactExpectation))" />
                    <Button Text="Remove step"
                            ButtonStyle="ButtonStyle.Light"
                            Click="@(() => ExecuteCanvasDialogActionAsync(ProcessCanvasActionIds.RemoveDefinitionStep))" />
                }
            </Stack>
        </ChildContent>
    </Dialog>
}

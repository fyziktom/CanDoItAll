@namespace CanDoItAll.Modules.Processes
@using CanDoItAll.Processes.Projections

<div class="mt-6 border-t border-slate-200 pt-5" data-testid="processes-definition-role-editor">
    <Split Gap="LayoutGap.Small">
        <Stack GapScale="LayoutGap.Tiny">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Roles" />
            <h3 class="text-sm font-semibold text-slate-900">Role editor</h3>
            <p class="text-sm leading-6 text-slate-600">Edit role identity, executor preference, staffing, template override, and step bindings through typed projections.</p>
        </Stack>
        <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
            <StatusBadge Tone="info" Text="@($"{RoleEditor.Roles.Count} role(s)")" />
            <StatusBadge Tone="@ResolveLintTone(RoleEditor.Lint)" Text="@ResolveLintText(RoleEditor.Lint)" />
        </Cluster>
    </Split>

    @if (!string.IsNullOrWhiteSpace(commandNotice) || RoleEditor.LastCommandReceipt is not null)
    {
        <p class="mt-3 text-xs font-semibold text-slate-500" data-testid="processes-role-editor-receipt">
            @(RoleEditor.LastCommandReceipt is null ? commandNotice : $"{RoleEditor.LastCommandReceipt.Status}: {RoleEditor.LastCommandReceipt.Summary}")
        </p>
    }

    <Grid Gap="LayoutGap.Large" ColumnsLg="3" Class="mt-5" data-testid="processes-role-editor-sections">
        <Stack GapScale="LayoutGap.Small" data-testid="processes-role-list">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Role list" />
            @if (RoleEditor.Roles.Count == 0)
            {
                <EmptyState Eyebrow="No roles"
                            Title="No roles are defined"
                            Description="Add a role from a template before editing step bindings." />
            }
            else
            {
                @foreach (var role in RoleEditor.Roles)
                {
                    <Button Text="@role.DisplayName"
                            Icon="badge"
                            Size="ButtonSize.Small"
                            ButtonStyle="@(role.RoleKey == selectedRoleKey ? ButtonStyle.Primary : ButtonStyle.Light)"
                            Disabled="@Disabled"
                            Click="@(() => SelectRole(role.RoleKey))"
                            data-testid="@BuildRoleItemTestId(role.RoleKey)" />
                    <p class="text-xs leading-5 text-slate-500">@role.Summary</p>
                    <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                        <StatusBadge Tone="neutral" Text="@role.Draft.PreferredExecutorKind.ToString()" />
                        <StatusBadge Tone="info" Text="@($"{role.StepBindingCount} binding(s)")" />
                    </Cluster>
                }
            }
        </Stack>

        <Stack GapScale="LayoutGap.Small" data-testid="processes-role-editor-form">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Role details" />
            <label class="text-xs font-semibold text-slate-500" for="processes-role-display-name-input">Display name</label>
            <input id="processes-role-display-name-input"
                   class="min-h-9 w-full rounded-md border border-slate-300 px-3 text-sm text-slate-900 shadow-sm"
                   value="@roleDisplayName"
                   @oninput="args => roleDisplayName = ReadChangeValue(args)"
                   data-testid="processes-role-display-name" />

            <label class="text-xs font-semibold text-slate-500" for="processes-role-purpose-input">Purpose</label>
            <textarea id="processes-role-purpose-input"
                      class="min-h-9 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm"
                      value="@rolePurpose"
                      @oninput="args => rolePurpose = ReadChangeValue(args)"
                      data-testid="processes-role-purpose"></textarea>

            <label class="text-xs font-semibold text-slate-500" for="processes-role-staffing-input">Staffing intent</label>
            <textarea id="processes-role-staffing-input"
                      class="min-h-9 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm"
                      value="@roleStaffingIntent"
                      @oninput="args => roleStaffingIntent = ReadChangeValue(args)"
                      data-testid="processes-role-staffing-intent"></textarea>

            <Grid Gap="LayoutGap.Small" ColumnsMd="2">
                <Stack GapScale="LayoutGap.Tiny">
                    <label class="text-xs font-semibold text-slate-500" for="processes-role-executor-kind-input">Executor kind</label>
                    <select id="processes-role-executor-kind-input"
                            class="min-h-9 w-full rounded-md border border-slate-300 px-3 text-sm text-slate-900 shadow-sm"
                            value="@roleExecutorKind"
                            @onchange="args => roleExecutorKind = ParseExecutorKind(args)"
                            data-testid="processes-role-executor-kind">
                        @foreach (var option in ExecutorKindOptions)
                        {
                            <option value="@option">@option.ToString()</option>
                        }
                    </select>
                </Stack>
                <Stack GapScale="LayoutGap.Tiny">
                    <label class="text-xs font-semibold text-slate-500" for="processes-role-project-assignment-input">Project role</label>
                    <select id="processes-role-project-assignment-input"
                            class="min-h-9 w-full rounded-md border border-slate-300 px-3 text-sm text-slate-900 shadow-sm"
                            value="@roleProjectAssignment"
                            @onchange="args => roleProjectAssignment = ParseProjectAssignment(args)"
                            data-testid="processes-role-project-assignment">
                        @foreach (var option in ProjectAssignmentOptions)
                        {
                            <option value="@option">@option.ToString()</option>
                        }
                    </select>
                </Stack>
            </Grid>

            <label class="text-xs font-semibold text-slate-500" for="processes-role-allocation-input">Default allocation percent</label>
            <input id="processes-role-allocation-input"
                   type="number"
                   min="0"
                   max="100"
                   class="min-h-9 w-full rounded-md border border-slate-300 px-3 text-sm text-slate-900 shadow-sm"
                   value="@roleDefaultAllocationPercent"
                   @oninput="args => roleDefaultAllocationPercent = ParseInt(args)"
                   data-testid="processes-role-allocation" />

            <Cluster Gap="LayoutGap.Medium" Class="flex-wrap">
                <label class="inline-flex items-center gap-2 text-sm text-slate-700">
                    <input type="checkbox"
                           checked="@roleIsRequired"
                           @onchange="args => roleIsRequired = ParseBool(args)"
                           data-testid="processes-role-required" />
                    Required
                </label>
                <label class="inline-flex items-center gap-2 text-sm text-slate-700">
                    <input type="checkbox"
                           checked="@roleAllowsFallback"
                           @onchange="args => roleAllowsFallback = ParseBool(args)"
                           data-testid="processes-role-fallback" />
                    Fallback
                </label>
                <label class="inline-flex items-center gap-2 text-sm text-slate-700">
                    <input type="checkbox"
                           checked="@roleRequiresApproval"
                           @onchange="args => roleRequiresApproval = ParseBool(args)"
                           data-testid="processes-role-approval" />
                    Approval
                </label>
            </Cluster>
        </Stack>

        <Stack GapScale="LayoutGap.Small" data-testid="processes-role-template-and-bindings">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Template" />
            <label class="text-xs font-semibold text-slate-500" for="processes-role-template-action-input">Apply template</label>
            <select id="processes-role-template-action-input"
                    class="min-h-9 w-full rounded-md border border-slate-300 px-3 text-sm text-slate-900 shadow-sm"
                    value="@selectedTemplateActionKey"
                    @onchange="args => selectedTemplateActionKey = ReadChangeValue(args)"
                    data-testid="processes-role-template-action">
                @foreach (var template in RoleEditor.TemplateActions)
                {
                    <option value="@template.ActionKey.Value">@template.Label</option>
                }
            </select>

            <label class="text-xs font-semibold text-slate-500" for="processes-role-template-source-input">Template source</label>
            <input id="processes-role-template-source-input"
                   class="min-h-9 w-full rounded-md border border-slate-300 px-3 text-sm text-slate-900 shadow-sm"
                   value="@roleTemplateSourceKey"
                   @oninput="args => roleTemplateSourceKey = ReadChangeValue(args)"
                   data-testid="processes-role-template-source" />

            <label class="text-xs font-semibold text-slate-500" for="processes-role-template-snapshot-input">Template snapshot</label>
            <input id="processes-role-template-snapshot-input"
                   class="min-h-9 w-full rounded-md border border-slate-300 px-3 text-sm text-slate-900 shadow-sm"
                   value="@roleTemplateSnapshotName"
                   @oninput="args => roleTemplateSnapshotName = ReadChangeValue(args)"
                   data-testid="processes-role-template-snapshot" />

            <label class="text-xs font-semibold text-slate-500" for="processes-role-snapshot-summary-input">Snapshot summary</label>
            <textarea id="processes-role-snapshot-summary-input"
                      class="min-h-9 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm"
                      value="@roleSnapshotSummary"
                      @oninput="args => roleSnapshotSummary = ReadChangeValue(args)"
                      data-testid="processes-role-snapshot-summary"></textarea>

            <div class="rounded-md border border-slate-200 bg-slate-50 p-3" data-testid="processes-role-step-bindings">
                <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                    <StatusBadge Tone="neutral" Text="@($"{RoleEditor.StepRoleBindings.Count} step binding(s)")" />
                    <StatusBadge Tone="info" Text="@roleOverrideStatus.ToString()" />
                </Cluster>
                @foreach (var binding in RoleEditor.StepRoleBindings.Where(binding => binding.RoleKey == selectedRoleKey).Take(4))
                {
                    <div class="mt-3 border-t border-slate-200 pt-3">
                        <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                            <StatusBadge Tone="neutral" Text="@binding.ResponsibilityKind.ToString()" />
                            <span class="text-xs font-semibold text-slate-500">@binding.StepTitle</span>
                            <span class="text-xs text-slate-500">fallback @binding.FallbackOrder</span>
                        </Cluster>
                        <p class="mt-2 text-xs leading-5 text-slate-500">@binding.RebindPolicySummary</p>
                    </div>
                }
            </div>
        </Stack>
    </Grid>

    @if (RoleEditor.Lint.HasWarningsOrErrors)
    {
        <div class="mt-5 rounded-md border border-slate-200 bg-slate-50 p-3" data-testid="processes-role-lint-panel">
            @foreach (var issue in RoleEditor.Lint.Issues)
            {
                <div class="border-t border-slate-200 py-3 first:border-t-0 first:pt-0 last:pb-0">
                    <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                        <StatusBadge Tone="@ResolveLintIssueTone(issue.Severity)" Text="@issue.Severity.ToString()" />
                        <span class="text-xs font-semibold text-slate-500">@issue.Section.ToString()</span>
                        <span class="text-xs text-slate-500">@issue.Code</span>
                    </Cluster>
                    <p class="mt-2 text-sm leading-6 text-slate-700">@issue.Message</p>
                    <p class="text-xs leading-5 text-slate-500">@issue.Suggestion</p>
                </div>
            }
        </div>
    }

    <Cluster Gap="LayoutGap.Small" Class="mt-5 flex-wrap justify-end">
        @foreach (var command in RoleEditor.Commands)
        {
            <Button Text="@command.Text"
                    Icon="@command.Icon"
                    ButtonStyle="@ResolveCommandButtonStyle(command.Kind)"
                    Size="ButtonSize.Small"
                    Disabled="@(!command.IsEnabled || Disabled)"
                    IsBusy="@Disabled"
                    Click="@(() => ExecuteAsync(command.Kind))"
                    title="@command.DisabledReason"
                    data-testid="@BuildRoleCommandTestId(command.Kind)" />
        }
    </Cluster>
</div>

@code {
    [Parameter, EditorRequired]
    public ProcessDefinitionRoleEditorProjection RoleEditor { get; set; } = default!;

    [Parameter, EditorRequired]
    public ProcessWorkspaceShellScope Scope { get; set; } = default!;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<ProcessDefinitionRoleEditorCommand> ExecuteCommand { get; set; }

    private ProcessDefinitionRoleEditorVersionToken? syncedVersionToken;
    private ProcessDefinitionRoleKey? selectedRoleKey;
    private string? commandNotice;
    private string selectedTemplateActionKey = string.Empty;
    private string roleDisplayName = string.Empty;
    private string rolePurpose = string.Empty;
    private string roleStaffingIntent = string.Empty;
    private string roleTemplateSourceKey = string.Empty;
    private string roleTemplateSnapshotName = string.Empty;
    private string roleSnapshotSummary = string.Empty;
    private ProcessDefinitionRoleExecutorKind roleExecutorKind = ProcessDefinitionRoleExecutorKind.Person;
    private ProcessDefinitionRoleProjectAssignmentKind roleProjectAssignment = ProcessDefinitionRoleProjectAssignmentKind.Unspecified;
    private ProcessDefinitionRoleTemplateOverrideStatus roleOverrideStatus = ProcessDefinitionRoleTemplateOverrideStatus.None;
    private bool roleIsRequired;
    private bool roleAllowsFallback;
    private bool roleRequiresApproval;
    private int roleDefaultAllocationPercent;

    private static readonly ProcessDefinitionRoleExecutorKind[] ExecutorKindOptions =
    [
        ProcessDefinitionRoleExecutorKind.Person,
        ProcessDefinitionRoleExecutorKind.Agent,
        ProcessDefinitionRoleExecutorKind.PersonOrAgent,
        ProcessDefinitionRoleExecutorKind.AiAgent,
        ProcessDefinitionRoleExecutorKind.Workflow
    ];

    private static readonly ProcessDefinitionRoleProjectAssignmentKind[] ProjectAssignmentOptions =
    [
        ProcessDefinitionRoleProjectAssignmentKind.Unspecified,
        ProcessDefinitionRoleProjectAssignmentKind.Manager,
        ProcessDefinitionRoleProjectAssignmentKind.TechnicalContact,
        ProcessDefinitionRoleProjectAssignmentKind.Reviewer,
        ProcessDefinitionRoleProjectAssignmentKind.TeamMember,
        ProcessDefinitionRoleProjectAssignmentKind.CustomerContact,
        ProcessDefinitionRoleProjectAssignmentKind.AiAgent,
        ProcessDefinitionRoleProjectAssignmentKind.Developer,
        ProcessDefinitionRoleProjectAssignmentKind.Architect
    ];

    protected override void OnParametersSet()
    {
        if (syncedVersionToken == RoleEditor.VersionToken &&
            selectedRoleKey == RoleEditor.SelectedRoleKey)
        {
            return;
        }

        syncedVersionToken = RoleEditor.VersionToken;
        selectedRoleKey = RoleEditor.SelectedRoleKey;
        commandNotice = RoleEditor.LastCommandReceipt?.Summary;
        selectedTemplateActionKey = RoleEditor.TemplateActions.FirstOrDefault()?.ActionKey.Value ?? string.Empty;
        SyncSelectedRole();
    }

    private void SelectRole(ProcessDefinitionRoleKey roleKey)
    {
        selectedRoleKey = roleKey;
        SyncSelectedRole();
    }

    private void SyncSelectedRole()
    {
        var role = selectedRoleKey is { } roleKey
            ? RoleEditor.Roles.FirstOrDefault(candidate => candidate.RoleKey == roleKey)
            : RoleEditor.SelectedRole;
        if (role is null)
        {
            return;
        }

        var draft = role.Draft;
        roleDisplayName = draft.DisplayName;
        rolePurpose = draft.Purpose;
        roleStaffingIntent = draft.StaffingIntent;
        roleExecutorKind = draft.PreferredExecutorKind == ProcessDefinitionRoleExecutorKind.Unspecified
            ? ProcessDefinitionRoleExecutorKind.Person
            : draft.PreferredExecutorKind;
        roleProjectAssignment = draft.PreferredProjectAssignmentRole;
        roleIsRequired = draft.IsRequired;
        roleAllowsFallback = draft.AllowsFallback;
        roleRequiresApproval = draft.RequiresExplicitApproval;
        roleDefaultAllocationPercent = draft.DefaultAllocationPercent;
        roleTemplateSourceKey = draft.RoleTemplateSourceKey;
        roleTemplateSnapshotName = draft.RoleTemplateSnapshotName;
        roleSnapshotSummary = draft.SnapshotSummary;
        roleOverrideStatus = draft.OverrideStatus;
    }

    private async Task ExecuteAsync(ProcessDefinitionRoleCommandKind commandKind)
    {
        var draft = CreateDraft();
        ProcessDefinitionRoleTemplateActionKey? templateActionKey = string.IsNullOrWhiteSpace(selectedTemplateActionKey)
            ? null
            : new ProcessDefinitionRoleTemplateActionKey(selectedTemplateActionKey);
        var command = new ProcessDefinitionRoleEditorCommand(
            Scope,
            RoleEditor.DefinitionKey,
            commandKind,
            RoleEditor.VersionToken,
            draft,
            templateActionKey);
        await ExecuteCommand.InvokeAsync(command);
    }

    private ProcessDefinitionRoleDraftProjection CreateDraft()
    {
        var roleKey = selectedRoleKey ?? RoleEditor.SelectedRole?.RoleKey ?? new ProcessDefinitionRoleKey("role-draft");
        return new ProcessDefinitionRoleDraftProjection(
            roleKey,
            roleDisplayName,
            rolePurpose,
            roleStaffingIntent,
            roleExecutorKind,
            new ProcessDefinitionWorkflowPreferenceProjection(
                ProcessDefinitionRoleWorkflowPreferenceKind.AnyActiveWorkflow,
                WorkflowDefinitionId: null,
                WorkflowVersionId: null,
                "Any active workflow"),
            roleProjectAssignment,
            roleIsRequired,
            roleAllowsFallback,
            roleRequiresApproval,
            roleDefaultAllocationPercent,
            roleTemplateSourceKey,
            roleTemplateSnapshotName,
            roleSnapshotSummary,
            roleOverrideStatus,
            string.IsNullOrWhiteSpace(roleTemplateSourceKey)
                ? "Local role override without a global template source."
                : $"Local override tracks {roleTemplateSourceKey}.");
    }

    private static string ReadChangeValue(ChangeEventArgs args)
        => args.Value?.ToString() ?? string.Empty;

    private static bool ParseBool(ChangeEventArgs args)
        => args.Value is bool value && value;

    private static int ParseInt(ChangeEventArgs args)
        => int.TryParse(ReadChangeValue(args), out var parsed) ? parsed : 0;

    private static ProcessDefinitionRoleExecutorKind ParseExecutorKind(ChangeEventArgs args)
        => Enum.TryParse<ProcessDefinitionRoleExecutorKind>(ReadChangeValue(args), out var parsed)
            ? parsed
            : ProcessDefinitionRoleExecutorKind.Person;

    private static ProcessDefinitionRoleProjectAssignmentKind ParseProjectAssignment(ChangeEventArgs args)
        => Enum.TryParse<ProcessDefinitionRoleProjectAssignmentKind>(ReadChangeValue(args), out var parsed)
            ? parsed
            : ProcessDefinitionRoleProjectAssignmentKind.Unspecified;

    private static string ResolveLintTone(ProcessDefinitionRoleLintProjection lint)
    {
        if (lint.HasBlockingIssues)
        {
            return "danger";
        }

        return lint.HasWarningsOrErrors ? "warning" : "success";
    }

    private static string ResolveLintText(ProcessDefinitionRoleLintProjection lint)
    {
        if (lint.HasBlockingIssues)
        {
            return $"{lint.Issues.Count(issue => issue.Severity == ProcessDefinitionRoleLintSeverity.Error)} blocking";
        }

        return lint.HasWarningsOrErrors ? $"{lint.Issues.Count} role lint issue(s)" : "Role lint clear";
    }

    private static string ResolveLintIssueTone(ProcessDefinitionRoleLintSeverity severity)
        => severity switch
        {
            ProcessDefinitionRoleLintSeverity.Error => "danger",
            ProcessDefinitionRoleLintSeverity.Warning => "warning",
            ProcessDefinitionRoleLintSeverity.Info => "info",
            _ => "neutral"
        };

    private static ButtonStyle ResolveCommandButtonStyle(ProcessDefinitionRoleCommandKind kind)
        => kind switch
        {
            ProcessDefinitionRoleCommandKind.AddRole => ButtonStyle.Primary,
            ProcessDefinitionRoleCommandKind.SaveRole => ButtonStyle.Success,
            ProcessDefinitionRoleCommandKind.ApplyTemplate => ButtonStyle.Info,
            ProcessDefinitionRoleCommandKind.DeleteRole => ButtonStyle.Danger,
            _ => ButtonStyle.Light
        };

    private static string BuildRoleCommandTestId(ProcessDefinitionRoleCommandKind kind)
        => kind switch
        {
            ProcessDefinitionRoleCommandKind.AddRole => "processes-role-add",
            ProcessDefinitionRoleCommandKind.SaveRole => "processes-role-save",
            ProcessDefinitionRoleCommandKind.ApplyTemplate => "processes-role-apply-template",
            ProcessDefinitionRoleCommandKind.DeleteRole => "processes-role-delete",
            _ => $"processes-role-command-{kind.ToString().ToLowerInvariant()}"
        };

    private static string BuildRoleItemTestId(ProcessDefinitionRoleKey roleKey)
    {
        var normalized = new string(roleKey.Value
            .Select(character => char.IsLetterOrDigit(character) ? char.ToLowerInvariant(character) : '-')
            .ToArray());
        return $"processes-role-{normalized}";
    }
}

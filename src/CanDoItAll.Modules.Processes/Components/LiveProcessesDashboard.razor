            @if (agent.ClaimedAtUtc.HasValue)
            {
                <StatusBadge Tone="neutral" Text="@($"claimed {agent.ClaimedAtUtc.Value.LocalDateTime:g}")" />
            }
            @if (agent.LeaseExpiresAtUtc.HasValue)
            {
                <StatusBadge Tone="warning" Text="@($"lease {agent.LeaseExpiresAtUtc.Value.LocalDateTime:g}")" />

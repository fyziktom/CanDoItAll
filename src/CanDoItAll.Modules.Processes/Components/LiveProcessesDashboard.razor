    private RenderFragment RenderProcessTimeline(ProcessWorkspaceRunDetails details)
    {
        return @<div class="live-processes-detail-panel">
            @if (details.AttemptTimeline.Count == 0)
            {
                <EmptyState Eyebrow="No timeline"
                            Title="No timeline entries are available"
                            Description="Timeline entries appear after process steps, outbox records, approvals, or escalations change state." />
            }
            else
            {
                <div class="live-processes-timeline-list">
                    @foreach (var item in details.AttemptTimeline.Take(80))

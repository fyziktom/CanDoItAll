    private static bool ShouldShowStepContractBlocker(ProcessStepRunViewModel step)
    {
        return step.Status is ProcessStepRunStatus.Blocked or ProcessStepRunStatus.Failed or ProcessStepRunStatus.Refused ||
               step.BlockReasonCode != ProcessStepBlockReasonCode.None ||
               step.AllowedOperations.Count == 0 ||
               !step.OperationTargetScope.HasValue ||
               !string.IsNullOrWhiteSpace(step.BlockedReason) ||
               !string.IsNullOrWhiteSpace(step.ExceptionSummary) ||
               !string.IsNullOrWhiteSpace(step.RefusalReason);
    }

    private static bool IsPolicyDeniedStep(ProcessStepRunViewModel step)
    {
        return step.BlockReasonCode == ProcessStepBlockReasonCode.PolicyDeniedExternalPath ||
               ContainsPolicyDenySignal(step.BlockedReason) ||
               ContainsPolicyDenySignal(step.ExceptionSummary) ||
               ContainsPolicyDenySignal(step.RefusalReason);
    }

    private static bool ContainsPolicyDenySignal(string value)
    {
        return !string.IsNullOrWhiteSpace(value) &&
               (value.Contains("policy", StringComparison.OrdinalIgnoreCase) ||
                value.Contains("denied", StringComparison.OrdinalIgnoreCase) ||
                value.Contains("not allowed", StringComparison.OrdinalIgnoreCase));
    }

    private static string BuildStepContractBlockerDescription(ProcessStepRunViewModel step)
    {
        if (step.AllowedOperations.Count == 0 || !step.OperationTargetScope.HasValue)
        {
            return "The step is missing part of its typed operation contract.";
        }

        if (IsPolicyDeniedStep(step))
        {
            return "The tool request was denied against the typed operation contract.";
        }

        return "Typed operation contract, blocker reason, and recovery state for this step.";
    }

    private static string ResolveStepContractTone(ProcessStepRunViewModel step)
    {
        if (step.AllowedOperations.Count == 0 || !step.OperationTargetScope.HasValue || IsPolicyDeniedStep(step))
        {
            return "danger";
        }

        return step.Status == ProcessStepRunStatus.Blocked ? "warning" : "info";
    }

    private static string ResolveStepContractStatus(ProcessStepRunViewModel step)
    {
        if (step.AllowedOperations.Count == 0)
        {
            return "Operations missing";
        }

        if (!step.OperationTargetScope.HasValue)
        {
            return "Scope missing";
        }

        return IsPolicyDeniedStep(step) ? "Denied" : "Declared";
    }

    private static string FormatAllowedOperations(IReadOnlyList<ProcessStepOperation> operations)
    {

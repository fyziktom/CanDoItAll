        <Cluster Gap="LayoutGap.XSmall" Class="live-processes-agent-card__badges flex-wrap">
            <StatusBadge Tone="neutral" Text="@agent.RunLabel" />
            <StatusBadge Tone="info" Text="@agent.StepKey" />
            <StatusBadge Tone="@ResolveObservationTone(agent)" Text="@ResolveObservationLabel(agent)" />
            @if (agent.ExecutionRunId.HasValue)
            {
                <StatusBadge Tone="neutral" Text="@($"run {agent.ExecutionRunId.Value.ToString("N")[..8]}")" />

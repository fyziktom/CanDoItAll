    private async Task StageManagerChatRunArtifactsAsync()
    {
        if (managerChatRun is null)
        {
            return;
        }

        try
        {
            var snapshot = await ObservationService.GetRunSnapshotAsync(
                new ProcessRunObservationQuery(managerChatRun.RunId, ProjectId),
                refreshCancellation?.Token ?? CancellationToken.None);
            var artifactPaths = snapshot.Details.Artifacts
                .Select(item => item.ManagedStoragePath)
                .Concat(snapshot.Details.ExecutionRuns.SelectMany(item => item.Artifacts.Select(artifact => artifact.RelativePath)))
                .Where(path => !string.IsNullOrWhiteSpace(path))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Take(50)
                .ToArray();
            if (artifactPaths.Length == 0)
            {
                managerChatErrorMessage = "The selected process run does not have artifacts to stage.";
                return;
            }

            managerChatDraftAttachmentPaths = artifactPaths;
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            managerChatErrorMessage = $"Unable to stage process artifacts. {exception.Message}";
        }
    }

    private async Task RunManagerChatOperationAsync(
        Func<CancellationToken, Task> operation,
        Action? onError = null)
    {
        managerChatBusy = true;
        managerChatErrorMessage = null;
        try
        {
            await operation(refreshCancellation?.Token ?? CancellationToken.None);
            if (managerChatProjection is { IsAvailable: false })
            {
                managerChatErrorMessage = managerChatProjection.ErrorMessage;
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            onError?.Invoke();
            managerChatErrorMessage = exception.Message;
        }
        finally
        {
            managerChatBusy = false;
        }
    }

    private void HandleManagerChatExecutionUpdated(object? sender, ExecutionLogEntry entry)
    {
        if (!ShouldAcceptManagerChatExecutionEntry(entry))
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            if (!ShouldAcceptManagerChatExecutionEntry(entry) || managerChatProjection is null)
            {
                return;
            }

            var runState = ResolveManagerChatExecutionState(entry.State);
            managerChatProjection = managerChatProjection with
            {
                ExecutionLog = UpsertManagerChatExecutionLogEntry(managerChatProjection.ExecutionLog, entry),
                RunStateText = runState.Text,
                RunStateTone = runState.Tone
            };

            StateHasChanged();
        });
    }

    private void PruneSuppressions()
    {
        if (snapshot is null || suppressedRuns.Count == 0)
        {
            return;
        }

        var statusesByRunId = snapshot.Runs.ToDictionary(item => item.RunId, item => item.Status);
        foreach (var suppression in suppressedRuns.ToArray())
        {
            if (suppression.Value.ExpiresAtUtc <= nowUtc ||
                !statusesByRunId.TryGetValue(suppression.Key, out var currentStatus) ||
                currentStatus != suppression.Value.Status)
            {
                suppressedRuns.Remove(suppression.Key);
            }
        }
    }

    private void RebuildVisibleProjection()
    {
        if (snapshot is null)
        {
            visibleRuns = [];
            visibleEscalations = [];
            visibleRunEvents = [];
            visibleAgents = [];
            runStatusesById = new Dictionary<Guid, ProcessRunStatus>();
            return;
        }

        PruneDismissedActivityCards();
        var statusesByRunId = snapshot.Runs.ToDictionary(item => item.RunId, item => item.Status);
        runStatusesById = statusesByRunId;
        visibleEscalations = snapshot.Escalations
            .Where(item => !dismissedActivityCardKeys.Contains(item.Key))
            .ToArray();
        var visibleEscalationRunIds = visibleEscalations
            .Select(item => item.RunId)
            .ToHashSet();
        visibleRunEvents = snapshot.RunEvents
            .Where(item => !dismissedActivityCardKeys.Contains(item.Key))
            .ToArray();
        visibleRuns = snapshot.Runs
            .Where(item => !IsSuppressed(item.RunId, item.Status))
            .Where(item => item.Status != ProcessRunStatus.Blocked || !visibleEscalationRunIds.Contains(item.RunId))
            .ToArray();
        visibleAgents = snapshot.ActiveAgents
            .Where(item =>
                !statusesByRunId.TryGetValue(item.RunId, out var status) ||
                !IsSuppressed(item.RunId, status))
            .ToArray();
    }

    private void PruneDismissedActivityCards()
    {
        if (snapshot is null || dismissedActivityCardKeys.Count == 0)
        {
            return;
        }

        var currentKeys = snapshot.Escalations
            .Select(item => item.Key)
            .Concat(snapshot.RunEvents.Select(item => item.Key))
            .ToHashSet(StringComparer.Ordinal);
        dismissedActivityCardKeys.RemoveWhere(key => !currentKeys.Contains(key));
    }

    private bool IsSuppressed(Guid runId, ProcessRunStatus status)
    {
        return suppressedRuns.TryGetValue(runId, out var suppression) &&
               suppression.Status == status &&
               suppression.ExpiresAtUtc > nowUtc;
    }

    private ProcessManagerChatProjectionQuery BuildManagerChatQuery(
        ProcessLiveRunCard run,
        Guid? chatSessionId)
    {
        return new ProcessManagerChatProjectionQuery(
            run.RunId,
            run.DefinitionId,
            run.DefinitionName,
            run.RunName,
            run.Status,
            run.CompletedStepCount,
            run.TotalStepCount,
            run.BlockedStepCount,
            run.CapabilityGapCount,
            run.ActiveExecutionCount,
            run.PendingApprovalCount,
            run.EstimatedCost,
            run.ActualCost,
            run.UpdatedAtUtc,
            run.ManagerAgentId,
            run.ManagerAgentName,
            ProjectId,
            chatSessionId)
        {
            TreeEstimatedCost = run.TreeEstimatedCost,
            TreeActualCost = run.TreeActualCost,
            DescendantRunCount = run.DescendantRunCount
        };
    }

    private string BuildManagerChatPromptWithAttachments()
    {
        if (managerChatDraftAttachmentPaths.Count == 0)
        {
            return managerChatDraftPrompt.Trim();
        }

        var attachmentText = string.Join(
            Environment.NewLine,
            managerChatDraftAttachmentPaths.Select(path => $"- {path}"));
        return $"""
Use these process artifacts as input:
{attachmentText}

User request:
{managerChatDraftPrompt.Trim()}
""";
    }

    private static string BuildEscalationManagerMessagePrompt(
        ProcessLiveEscalationCard escalation)
    {
        var step = string.IsNullOrWhiteSpace(escalation.StepTitle)
            ? "Run-level escalation"
            : escalation.StepTitle;
        return $"""
Operator requested manager review from Live Processes:
- Process run: {escalation.RunName}
- Definition: {escalation.DefinitionName}
- Escalation: {escalation.Title}
- Escalation kind: {escalation.Kind}
- Severity: {escalation.Severity}
- Step: {step}
- Reason: {ResolveMissingText(escalation.Reason)}

Reply with the next concrete action or remaining blocker. Do not treat this message as an approval decision.
""";

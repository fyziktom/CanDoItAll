                <SectionCard Title="Step artifacts"
                             Description="Process and execution artifacts scoped to this step.">
                    @if (artifacts.Count == 0)
                    {
                        <EmptyState Eyebrow="No artifacts"
                                    Title="No artifacts for this step"
                                    Description="Artifacts appear after the step records durable evidence or outputs." />
                    }
                    else
                    {
                        <div class="live-processes-detail-list">
                            @foreach (var artifact in artifacts)
                            {
                                <SelectionListItem @key="artifact.Key"
                                                   Title="@artifact.Title"
                                                   Eyebrow="@artifact.Source.ToString()"
                                                   Meta="@artifact.CreatedAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)"
                                                   Summary="@ResolveArtifactSummary(artifact)"
                                                   Dense="true"
                                                   OnSelect="@(() => OpenArtifactDetailDialog(artifact))" />
                            }
                        </div>
                    }
                </SectionCard>

                <SectionCard Title="Timeline"
                             Description="Step-scoped timeline entries ordered by most recent activity.">
                    @if (stageDetailSnapshot?.Timeline.Count > 0)
                    {
                        <div class="live-processes-timeline-list">
                            @foreach (var item in stageDetailSnapshot.Timeline.Take(60))
                            {
                                <div @key="BuildTimelineKey(item)"
                                     class="live-processes-timeline-item">
                                    <StatusBadge Tone="@item.Tone"
                                                 Text="@item.StatusText" />
                                    <div class="min-w-0">
                                        <h3>@item.Title</h3>
                                        <p>@item.Summary</p>
                                        <span>@item.OccurredAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <EmptyState Eyebrow="No timeline"
                                    Title="No step timeline entries"
                                    Description="Timeline entries appear after work starts on this step." />
                    }
                </SectionCard>
            }
        </Stack>;

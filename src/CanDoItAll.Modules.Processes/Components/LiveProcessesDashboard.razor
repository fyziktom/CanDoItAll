@namespace CanDoItAll.Modules.Processes
@using System.Globalization
@using CanDoItAll.AgentFramework.Core
@using CanDoItAll.AgentFramework.Models
@using CanDoItAll.Components.Common
@using CanDoItAll.Components.Charts
@implements IAsyncDisposable
@inject IProcessObservationService ObservationService
@inject IProcessManagerChatService ManagerChatService
@inject IAgentFrameworkWorkspaceService AgentWorkspaceService
@inject IProcessEscalationService EscalationService

<PageTitle>@PageTitleText</PageTitle>

<PageScaffold FillHeight="true"
              MaxWidthClass="max-w-full"
              Class="live-processes-page"
              data-testid="live-processes-page">
    <Header>
        <Toolbar Class="live-processes-command-strip"
                 data-testid="live-processes-command-strip">
            <ToolbarRow Class="live-processes-command-strip__row">
                <CompactStatStrip Class="min-w-0">
                    <p class="cda-eyebrow whitespace-nowrap">Processes</p>
                    <h1 class="live-processes-title">@PageTitleText</h1>
                    <CompactStat Tone="info"
                                 Text="@FormatCount(CurrentStats.RunningRunCount, "running", "running")"
                                 TooltipText="Process runs currently running in the live projection." />
                    <CompactStat Tone="warning"
                                 Text="@FormatCount(CurrentStats.BlockedRunCount, "blocked", "blocked")"
                                 TooltipText="Process runs currently blocked in the live projection." />
                    <CompactStat Tone="danger"
                                 Text="@FormatCount(CurrentStats.FailedRunCount, "failed", "failed")"
                                 TooltipText="Process runs currently failed in the live projection." />
                    <CompactStat Tone="neutral"
                                 Text="@LastRefreshText"
                                 TooltipText="Most recent live process refresh time." />
                </CompactStatStrip>

                <ToolbarActions Class="live-processes-command-strip__actions">
                    <select class="cda-input live-processes-select"
                            aria-label="History window"
                            value="@selectedWindow"
                            @onchange="HandleHistoryWindowChangedAsync">
                        @foreach (var historyWindow in HistoryWindows)
                        {
                            <option value="@historyWindow">@ResolveHistoryWindowLabel(historyWindow)</option>
                        }
                    </select>

                    <select class="cda-input live-processes-select live-processes-select--wide"
                            aria-label="Process filter"
                            value="@SelectedProcessFilterValue"
                            @onchange="HandleProcessFilterChangedAsync">
                        <option value="">All processes</option>
                        @foreach (var process in ProcessOptions)
                        {
                            <option value="@process.RunId.ToString("D")">
                                @BuildProcessOptionLabel(process)
                            </option>
                        }
                    </select>

                    <PageHeaderActionButton Icon="refresh"
                                            Label="Refresh"
                                            TooltipText="Refresh the live process projection."
                                            Disabled="@isRefreshing"
                                            IsBusy="@isRefreshing"
                                            Click="ForceRefreshAsync"
                                            data-testid="live-processes-refresh-button" />
                </ToolbarActions>
            </ToolbarRow>
        </Toolbar>
    </Header>

    <ChildContent>
        <Stack GapScale="LayoutGap.Medium"
               Class="live-processes-dashboard min-h-0 flex-1"
               data-testid="live-processes-dashboard">
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="live-processes-alert"
                     role="alert"
                     data-testid="live-processes-error">
                    <Icon Name="error" />
                    <span>@errorMessage</span>
                </div>
            }

            @if (isLoading && snapshot is null)
            {
                <LoadingState Eyebrow="Live processes"
                              Title="Loading process projection"
                              Description="Collecting current runs, active agents, metrics, and tool usage." />
            }
            else
            {
                <div class="live-processes-summary">
                    <CompactStatStrip>
                        <CompactStat Label="observed"
                                     Value="@CurrentStats.ObservedRunCount.ToString("N0", CultureInfo.CurrentCulture)"
                                     TooltipText="Observed runs in the current live process projection."
                                     Tone="info" />
                        <CompactStat Label="agents"
                                     Value="@CurrentStats.ActiveAgentCount.ToString("N0", CultureInfo.CurrentCulture)"
                                     TooltipText="Active agents observed in the current live process projection."
                                     Tone="success" />
                        <CompactStat Label="context"
                                     Value="@FormatTokens(CurrentStats.TotalTokens)"
                                     TooltipText="Total context tokens observed in the current live process projection."
                                     Tone="accent" />
                        <CompactStat Label="tool calls"
                                     Value="@CurrentStats.ToolCalls.ToString("N0", CultureInfo.CurrentCulture)"
                                     TooltipText="Tool calls observed in the current live process projection."
                                     Tone="warning" />
                        <CompactStat Label="time"
                                     Value="@FormatDuration(TimeSpan.FromMilliseconds(CurrentStats.DurationMs))"
                                     TooltipText="Total observed runtime duration." />
                        <CompactStat Label="cost"
                                     Value="@CurrentCostDisplay.Value"
                                     TooltipText="@CurrentCostDisplay.TooltipText"
                                     Tone="@CurrentCostDisplay.Tone" />
                    </CompactStatStrip>
                </div>

                <Tabs SelectedIndex="@selectedTabIndex"
                      SelectedIndexChanged="HandleTabChangedAsync"
                      Variant="TabsVariant.WorkspacePrimary"
                      RenderMode="TabRenderMode.Client"
                      OverflowMode="TabsOverflowMode.Auto"
                      PanelOverflowMode="TabsPanelOverflowMode.Auto"
                      FillHeight="true"
                      Class="live-processes-tabs"
                      data-testid="live-processes-tabs">
                    <TabsItem Text="Activity"
                              Icon="monitoring"
                              BadgeText="@ActivityCardCount.ToString(CultureInfo.InvariantCulture)">
                        @RenderActivityTab()
                    </TabsItem>

                    <TabsItem Text="Agents"
                              Icon="smart_toy"
                              BadgeText="@visibleAgents.Count.ToString(CultureInfo.InvariantCulture)">
                        @RenderAgentsTab()
                    </TabsItem>

                    <TabsItem Text="Graphs"
                              Icon="bar_chart">
                        @RenderGraphsTab()
                    </TabsItem>

                    <TabsItem Text="Tool analytics"
                              Icon="analytics"
                              BadgeText="@ToolUsage.Count.ToString(CultureInfo.InvariantCulture)">
                        @RenderToolAnalyticsTab()
                    </TabsItem>
                </Tabs>
            }
        </Stack>
    </ChildContent>
</PageScaffold>

<Dialog IsOpen="@suppressDialogOpen"
        Eyebrow="Projection"
        Title="Hide process card"
        Subtitle="@SuppressDialogSubtitle"
        Size="ModalSize.Compact"
        DenseChrome="true"
        OnClose="CloseSuppressDialogAsync"
        TestId="live-processes-suppress-dialog">
    <ChildContent>
        <Stack GapScale="LayoutGap.Medium">
            <p class="live-processes-dialog-copy">
                The process remains unchanged. The card returns when the status changes or the selected interval expires.
            </p>
            <div class="live-processes-duration-grid">
                <Button Text="10 minutes"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Click="@(() => ConfirmSuppressAsync(TimeSpan.FromMinutes(10)))" />
                <Button Text="30 minutes"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Click="@(() => ConfirmSuppressAsync(TimeSpan.FromMinutes(30)))" />
                <Button Text="1 hour"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Click="@(() => ConfirmSuppressAsync(TimeSpan.FromHours(1)))" />
                <Button Text="1 day"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Click="@(() => ConfirmSuppressAsync(TimeSpan.FromDays(1)))" />
            </div>
        </Stack>
    </ChildContent>
    <Footer>
        <Cluster JustifyContent="JustifyContent.End">
            <Button Text="Cancel"
                    ButtonStyle="ButtonStyle.Light"
                    Size="ButtonSize.Small"
                    Click="CloseSuppressDialogAsync" />
        </Cluster>
    </Footer>
</Dialog>

@if (processDetailDialogOpen)
{
    <Dialog IsOpen="true"
            Eyebrow="Process detail"
            Title="@ProcessDetailDialogTitle"
            Subtitle="@ProcessDetailDialogSubtitle"
            Size="ModalSize.Full"
            DenseChrome="true"
            OnClose="CloseProcessDetailDialogAsync"
            TestId="live-processes-process-detail-dialog">
        <ChildContent>
            @RenderProcessDetailDialog()
        </ChildContent>
        <Footer>
            <Cluster JustifyContent="JustifyContent.End">
                <Button Text="Refresh"
                        Icon="refresh"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Disabled="@processDetailLoading"
                        IsBusy="@processDetailLoading"
                        Click="@(() => ReloadProcessDetailDialogAsync(forceRefresh: true))" />
                <Button Text="Close"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Click="CloseProcessDetailDialogAsync" />
            </Cluster>
        </Footer>
    </Dialog>
}

@if (stageDetailDialogOpen)
{
    <Dialog IsOpen="true"
            Eyebrow="Step detail"
            Title="@StageDetailDialogTitle"
            Subtitle="@StageDetailDialogSubtitle"
            Size="ModalSize.Wide"
            DenseChrome="true"
            OnClose="CloseStageDetailDialogAsync"
            TestId="live-processes-stage-detail-dialog">
        <ChildContent>
            @RenderStageDetailDialog()
        </ChildContent>
        <Footer>
            <Cluster JustifyContent="JustifyContent.End">
                <Button Text="Close"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Click="CloseStageDetailDialogAsync" />
            </Cluster>
        </Footer>
    </Dialog>
}

@if (artifactDetailDialogOpen)
{
    <Dialog IsOpen="true"
            Eyebrow="Artifact detail"
            Title="@ArtifactDetailDialogTitle"
            Subtitle="@ArtifactDetailDialogSubtitle"
            Size="ModalSize.Wide"
            DenseChrome="true"
            OnClose="CloseArtifactDetailDialogAsync"
            TestId="live-processes-artifact-detail-dialog">
        <ChildContent>
            @RenderArtifactDetailDialog()
        </ChildContent>
        <Footer>
            <Cluster JustifyContent="JustifyContent.End">
                <Button Text="Close"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Click="CloseArtifactDetailDialogAsync" />
            </Cluster>
        </Footer>
    </Dialog>
}

@if (escalationDetailDialogOpen)
{
    <Dialog IsOpen="true"
            Eyebrow="Escalation"
            Title="@EscalationDetailDialogTitle"
            Subtitle="@EscalationDetailDialogSubtitle"
            Size="ModalSize.Wide"
            DenseChrome="true"
            OnClose="CloseEscalationDetailDialogAsync"
            TestId="live-processes-escalation-detail-dialog">
        <ChildContent>
            @RenderEscalationDetailDialog()
        </ChildContent>
        <Footer>
            <Cluster JustifyContent="JustifyContent.End">
                @if (escalationDetail is not null)
                {
                    var primaryAction = ProcessLiveEscalationActionPolicy.ResolvePrimaryAction(escalationDetail);
                    var secondaryAction = ProcessLiveEscalationActionPolicy.ResolveSecondaryAction(escalationDetail);
                    <Button Text="@primaryAction.Text"
                            Icon="@primaryAction.Icon"
                            ButtonStyle="@ResolveEscalationActionButtonStyle(primaryAction)"
                            Size="ButtonSize.Small"
                            Disabled="@IsActivityActionBusy(escalationDetail.Key)"
                            IsBusy="@IsActivityActionBusy(escalationDetail.Key)"
                            Click="@(() => ExecuteEscalationActionAsync(escalationDetail, primaryAction))" />
                    @if (secondaryAction is { } resolvedSecondaryAction)
                    {
                        <Button Text="@resolvedSecondaryAction.Text"
                                Icon="@resolvedSecondaryAction.Icon"
                                ButtonStyle="@ResolveEscalationActionButtonStyle(resolvedSecondaryAction)"
                                Size="ButtonSize.Small"
                                Disabled="@IsActivityActionBusy(escalationDetail.Key)"
                                Click="@(() => ExecuteEscalationActionAsync(escalationDetail, resolvedSecondaryAction))" />
                    }
                    <Button Text="Process details"
                            Icon="open_in_new"
                            ButtonStyle="ButtonStyle.Light"
                            Size="ButtonSize.Small"
                            Click="@(() => OpenProcessDetailDialogAsync(ResolveRunCard(escalationDetail)))" />
                }
                <Button Text="Close"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Click="CloseEscalationDetailDialogAsync" />
            </Cluster>
        </Footer>
    </Dialog>
}

@if (managerChatDialogOpen)
{
    <Dialog IsOpen="true"
            Eyebrow="Manager chat"
            Title="@ManagerChatDialogTitle"
            Subtitle="@ManagerChatDialogSubtitle"
            Size="ModalSize.Full"
            DenseChrome="true"
            OnClose="CloseManagerChatDialogAsync"
            TestId="live-processes-manager-chat-dialog">
        <ChildContent>
            @RenderManagerChatDialog()
        </ChildContent>
        <Footer>
            <Cluster JustifyContent="JustifyContent.End">
                <Button Text="Close"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Click="CloseManagerChatDialogAsync" />
            </Cluster>
        </Footer>
    </Dialog>
}

@code {
    private static readonly IReadOnlyList<ProcessLiveHistoryWindow> HistoryWindows =
    [
        ProcessLiveHistoryWindow.LiveHour,
        ProcessLiveHistoryWindow.OneDay,
        ProcessLiveHistoryWindow.SevenDays,
        ProcessLiveHistoryWindow.ThirtyDays
    ];

    private static readonly CdaChartOptions ContextChartOptions = new()
    {
        Type = CdaChartType.Area,
        XAxisType = CdaChartAxisType.DateTime,
        YAxisTitle = "Tokens",
        TooltipPrecision = 0,
        ValuePrecision = 0,
        FillOpacity = 0.22,
        Curve = CdaChartCurve.Straight,
        LegendPosition = CdaChartLegendPosition.Bottom,
        Palette = ["#2563eb", "#16a34a"]
    };

    private static readonly CdaChartOptions DurationChartOptions = new()
    {
        Type = CdaChartType.Bar,
        XAxisType = CdaChartAxisType.DateTime,
        YAxisTitle = "Minutes",
        Unit = "min",
        TooltipPrecision = 2,
        ValuePrecision = 2,
        ShowToolbar = false,
        EnableZoom = false,
        LegendPosition = CdaChartLegendPosition.Bottom,
        Palette = ["#7c3aed", "#0891b2"]
    };

    private static readonly CdaChartOptions MoneyChartOptions = new()
    {
        Type = CdaChartType.Bar,
        XAxisType = CdaChartAxisType.Category,
        YAxisTitle = "Cost",
        Unit = "$",
        TooltipPrecision = 2,
        ValuePrecision = 2,
        ShowToolbar = false,
        EnableZoom = false,
        RotateXAxisLabels = false,
        LegendPosition = CdaChartLegendPosition.Bottom,
        Palette = ["#0f766e", "#dc2626"]
    };

    private static readonly CdaChartOptions ToolUsageChartOptions = new()
    {
        Type = CdaChartType.Bar,
        XAxisType = CdaChartAxisType.Category,
        YAxisTitle = "Calls",
        TooltipPrecision = 0,
        ValuePrecision = 0,
        ShowToolbar = false,
        EnableZoom = false,
        RotateXAxisLabels = false,
        LegendPosition = CdaChartLegendPosition.Bottom,
        Palette = ["#f59e0b"]
    };

    private readonly Dictionary<Guid, SuppressedRunCard> suppressedRuns = [];
    private readonly HashSet<string> dismissedActivityCardKeys = new(StringComparer.Ordinal);
    private readonly HashSet<string> busyActivityCardKeys = new(StringComparer.Ordinal);

    private ProcessLiveObservationSnapshot? snapshot;
    private ProcessLiveHistoryWindow selectedWindow = ProcessLiveHistoryWindow.LiveHour;
    private Guid? selectedProcessRunId;
    private Guid? loadedProjectId;
    private CancellationTokenSource? refreshCancellation;
    private Task? refreshLoopTask;
    private bool hasLoaded;
    private bool isLoading = true;
    private bool isRefreshing;
    private bool suppressDialogOpen;
    private ProcessLiveRunCard? suppressTarget;
    private bool processDetailDialogOpen;
    private bool processDetailLoading;
    private int processDetailTabIndex;
    private ProcessLiveRunCard? processDetailRun;
    private ProcessObservationDialogPayload? processDetailPayload;
    private string? processDetailErrorMessage;
    private bool stageDetailDialogOpen;
    private bool stageDetailLoading;
    private ProcessStageObservationSnapshot? stageDetailSnapshot;
    private ProcessStepRunViewModel? stageDetailStep;
    private string? stageDetailErrorMessage;
    private bool artifactDetailDialogOpen;
    private LiveProcessArtifactDetail? artifactDetail;
    private bool escalationDetailDialogOpen;
    private ProcessLiveEscalationCard? escalationDetail;
    private bool managerChatDialogOpen;
    private bool managerChatLoading;
    private bool managerChatBusy;
    private ProcessLiveRunCard? managerChatRun;
    private ProcessManagerChatProjection? managerChatProjection;
    private string managerChatDraftPrompt = string.Empty;
    private string managerChatPendingPrompt = string.Empty;
    private IReadOnlyList<string> managerChatDraftAttachmentPaths = [];
    private int managerChatComposerKey;
    private string? managerChatErrorMessage;
    private string? errorMessage;
    private string? activityActionMessage;
    private DateTimeOffset nowUtc = DateTimeOffset.UtcNow;
    private IReadOnlyList<ProcessLiveRunCard> visibleRuns = [];
    private IReadOnlyList<ProcessLiveEscalationCard> visibleEscalations = [];
    private IReadOnlyList<ProcessLiveRunEventCard> visibleRunEvents = [];
    private IReadOnlyList<ProcessLiveAgentCard> visibleAgents = [];
    private IReadOnlyDictionary<Guid, ProcessRunStatus> runStatusesById = new Dictionary<Guid, ProcessRunStatus>();

    [Parameter]
    public Guid? ProjectId { get; set; }

    private string PageTitleText => ProjectId.HasValue ? "Project Live Processes" : "Live Processes";

    private ProcessLiveStats CurrentStats => snapshot?.Stats ?? ProcessLiveStats.Empty;

    private ProcessUsageCostDisplay CurrentCostDisplay
        => ProcessUsageDisplayAdapter.BuildCostDisplay(CurrentStats, CultureInfo.CurrentCulture);

    private IReadOnlyList<ProcessLiveProcessOption> ProcessOptions => snapshot?.ProcessOptions ?? [];

    private IReadOnlyList<ProcessLiveMetricPoint> MetricPoints => snapshot?.MetricPoints ?? [];

    private IReadOnlyList<ProcessLiveToolUsage> ToolUsage => snapshot?.ToolUsage ?? [];

    private int ActivityCardCount => visibleRuns.Count + visibleEscalations.Count + visibleRunEvents.Count;

    private string SelectedProcessFilterValue => selectedProcessRunId?.ToString("D") ?? string.Empty;

    private string LastRefreshText => snapshot is null
        ? "not loaded"
        : $"{snapshot.Staleness.Freshness} {FormatAge(snapshot.Staleness.AgeAt(nowUtc))}";

    private string SuppressDialogSubtitle => suppressTarget is null
        ? string.Empty
        : $"{suppressTarget.RunName} / {suppressTarget.Status}";

    private string ProcessDetailDialogTitle => processDetailRun?.RunName ?? "Process run";

    private string ProcessDetailDialogSubtitle => processDetailRun is null
        ? string.Empty
        : $"{processDetailRun.DefinitionName} / {processDetailRun.Status}";

    private string StageDetailDialogTitle => stageDetailStep?.Title ?? "Process step";

    private string StageDetailDialogSubtitle => stageDetailStep is null
        ? string.Empty
        : $"{stageDetailStep.Status} / {stageDetailStep.StepKind}";

    private string ArtifactDetailDialogTitle => artifactDetail?.Title ?? "Artifact";

    private string ArtifactDetailDialogSubtitle => artifactDetail is null
        ? string.Empty
        : $"{artifactDetail.Source} / {artifactDetail.Kind}";

    private string EscalationDetailDialogTitle => escalationDetail?.Title ?? "Process escalation";

    private string EscalationDetailDialogSubtitle => escalationDetail is null
        ? string.Empty
        : $"{escalationDetail.RunName} / {escalationDetail.Severity}";

    private string ManagerChatDialogTitle => managerChatProjection?.ManagerLabel ?? "Process manager";

    private string ManagerChatDialogSubtitle => managerChatProjection?.RunLabel ?? managerChatRun?.RunName ?? string.Empty;

    private IReadOnlyList<CdaChartSeries> ContextSeries
    {
        get
        {
            if (MetricPoints.Count == 0)
            {
                return [];
            }

            var series = new List<CdaChartSeries>
            {
                new()
                {
                    Name = "Input tokens",
                    Type = CdaChartType.Area,
                    Color = "#2563eb",
                    Points = MetricPoints
                        .Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, item.InputTokens))
                        .ToArray()
                },
                new()
                {
                    Name = "Output tokens",
                    Type = CdaChartType.Area,
                    Color = "#16a34a",
                    Points = MetricPoints
                        .Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, item.OutputTokens))
                        .ToArray()
                }
            };

            if (MetricPoints.Any(item => item.CachedInputTokens > 0))
            {
                series.Add(new CdaChartSeries
                {
                    Name = "Cached input tokens",
                    Type = CdaChartType.Line,
                    Color = "#d97706",
                    Points = MetricPoints
                        .Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, item.CachedInputTokens))
                        .ToArray()
                });
            }

            return series;
        }
    }

    private IReadOnlyList<CdaChartSeries> DurationSeries
    {
        get
        {
            if (MetricPoints.Count == 0)
            {
                return [];
            }

            return
            [
                new()
                {
                    Name = "Spent time",
                    Type = CdaChartType.Bar,
                    Color = "#7c3aed",
                    Points = MetricPoints
                        .Select(item => new CdaChartPoint(
                            item.TimestampUtc.UtcDateTime,
                            Math.Round(item.DurationMs / 60000m, 2)))
                        .ToArray()
                },
                new()
                {
                    Name = "Tool calls",
                    Type = CdaChartType.Line,
                    Color = "#0891b2",
                    Points = MetricPoints
                        .Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, item.ToolCalls))
                        .ToArray()
                }
            ];
        }
    }

    private IReadOnlyList<CdaChartSeries> MoneySeries
    {
        get
        {
            var runs = visibleRuns.Take(12).ToArray();
            if (runs.Length == 0)
            {
                return [];
            }

            var series = new List<CdaChartSeries>();
            if (ProcessUsageDisplayAdapter.ShouldShowPreciseActualCost(CurrentStats))
            {
                series.Add(new CdaChartSeries
                {
                    Name = "Actual",
                    Type = CdaChartType.Bar,
                    Color = "#0f766e",
                    Points = runs
                        .Select(item => new CdaChartPoint(TrimLabel(item.RunName, 24), item.ActualCost))
                        .ToArray()
                });
            }

            series.Add(new CdaChartSeries
            {
                Name = "Estimated",
                Type = CdaChartType.Bar,
                Color = "#dc2626",
                Points = runs
                    .Select(item => new CdaChartPoint(TrimLabel(item.RunName, 24), item.EstimatedCost))
                    .ToArray()
            });

            return series;
        }
    }

    private IReadOnlyList<CdaChartSeries> ToolUsageSeries
    {
        get
        {
            if (ToolUsage.Count == 0)
            {
                return [];
            }

            return
            [
                new()
                {
                    Name = "Tool calls",
                    Type = CdaChartType.Bar,
                    Color = "#f59e0b",
                    Points = ToolUsage
                        .Take(15)
                        .Select(item => new CdaChartPoint(TrimLabel(item.ToolName, 26), item.CallCount))
                        .ToArray()
                }
            ];
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (hasLoaded && loadedProjectId == ProjectId)
        {
            return;
        }

        loadedProjectId = ProjectId;
        selectedProcessRunId = null;
        suppressedRuns.Clear();
        hasLoaded = true;
        await RefreshAsync(forceRefresh: true);
    }

    protected override Task OnInitializedAsync()
    {
        AgentWorkspaceService.ExecutionUpdated += HandleManagerChatExecutionUpdated;
        refreshCancellation = new CancellationTokenSource();
        refreshLoopTask = RunRefreshLoopAsync(refreshCancellation.Token);
        return Task.CompletedTask;
    }

    private RenderFragment RenderActivityTab()
    {
        return @<div class="live-processes-tab-panel"
                     data-testid="live-processes-activity-tab">
            @if (!string.IsNullOrWhiteSpace(activityActionMessage))
            {
                <div class="live-processes-alert live-processes-alert--info"
                     role="status"
                     data-testid="live-processes-activity-message">
                    <Icon Name="check_circle" />
                    <span>@activityActionMessage</span>
                </div>
            }

            @if (ActivityCardCount == 0)
            {
                <EmptyState Eyebrow="No visible process cards"
                            Title="No live activity notifications"
                            Description="Hidden cards return when their process status, escalation state, or notification revision changes." />
            }
            else
            {
                <div class="live-processes-card-grid">
                    @foreach (var escalation in visibleEscalations)
                    {
                        @RenderLiveEscalationCard(escalation)
                    }

                    @foreach (var runEvent in visibleRunEvents)
                    {
                        @RenderLiveRunEventCard(runEvent)
                    }

                    @foreach (var run in visibleRuns)
                    {
                        @RenderLiveRunCard(run)
                    }
                </div>
            }
        </div>;
    }

    private RenderFragment RenderLiveRunCard(ProcessLiveRunCard run)
    {
        return @<article @key="run.RunId"
                         class="@ResolveRunCardClass(run)"
                         role="button"
                         tabindex="0"
                         @onclick="@(() => OpenProcessDetailDialogAsync(run))"
                         @onkeydown="@((KeyboardEventArgs args) => HandleRunCardKeyDownAsync(args, run))"
                         data-testid="live-process-run-card">
            <div class="live-processes-card__actions">
                <button type="button"
                        class="live-processes-card-action"
                        title="Chat with process manager"
                        aria-label="@($"Chat with manager for {run.RunName}")"
                        @onclick:stopPropagation="true"
                        @onclick="@(() => OpenManagerChatDialogAsync(run))">
                    <Icon Name="message" />
                </button>

                <button type="button"
                        class="live-processes-card-action live-processes-card-close"
                        title="Hide this process card"
                        aria-label="@($"Hide {run.RunName}")"
                        @onclick:stopPropagation="true"
                        @onclick="@(() => OpenSuppressDialog(run))">
                    <Icon Name="close" />
                </button>
            </div>

            <div class="live-processes-card__header">
                <div class="live-processes-card__identity">
                    <p class="cda-eyebrow">@run.DefinitionName</p>
                    <h2>@run.RunName</h2>
                </div>
                <StatusBadge Tone="@ResolveRunTone(run.Status)"
                             Text="@run.Status.ToString()" />
            </div>

            <div class="live-processes-progress"
                 aria-label="@BuildProgressText(run)">
                <span style="@BuildProgressStyle(run)"></span>
            </div>

            <div class="live-processes-card__metrics">
                <span>@BuildProgressText(run)</span>
                <span>@FormatAge(nowUtc - run.UpdatedAtUtc) since activity</span>
                @if (run.BlockedStepCount > 0)
                {
                    <span>@FormatCount(run.BlockedStepCount, "blocked step", "blocked steps")</span>
                }
                @if (run.ActiveExecutionCount > 0)
                {
                    <span>@FormatCount(run.ActiveExecutionCount, "active agent", "active agents")</span>
                }
                @if (run.PendingApprovalCount > 0)
                {
                    <span>@FormatCount(run.PendingApprovalCount, "approval", "approvals")</span>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(run.HealthSummary))
            {
                <p class="live-processes-card__summary">@run.HealthSummary</p>
            }

            <div class="live-processes-card__footer">
                <StatusBadge Tone="@ProcessUsageDisplayAdapter.BuildRunCostTone(CurrentStats)"
                             Text="@ProcessUsageDisplayAdapter.BuildRunCostText(CurrentStats, run, CultureInfo.CurrentCulture)" />
                <StatusBadge Tone="info"
                             Text="@($"{run.CompletedStepCount}/{run.TotalStepCount} steps")" />
                @if (run.DeadLetteredOutboxCount > 0)
                {
                    <StatusBadge Tone="danger"
                                 Text="@FormatCount(run.DeadLetteredOutboxCount, "dead letter", "dead letters")" />
                }
            </div>
        </article>;
    }

    private RenderFragment RenderLiveEscalationCard(ProcessLiveEscalationCard escalation)
    {
        return @<article @key="escalation.Key"
                         class="@ResolveEscalationCardClass(escalation)"
                         data-testid="live-process-escalation-card">
            <button type="button"
                    class="live-processes-card-action live-processes-card-close live-processes-notification-close"
                    title="Close this escalation notification"
                    aria-label="@($"Close escalation notification for {escalation.RunName}")"
                    @onclick="@(() => DismissActivityCard(escalation.Key))">
                <Icon Name="close" />
            </button>

            <div class="live-processes-notification-card__header">
                <span class="live-processes-notification-card__icon">
                    <Icon Name="@ResolveEscalationIcon(escalation.Kind)" />
                </span>
                <div class="live-processes-card__identity">
                    <p class="cda-eyebrow">@($"{escalation.DefinitionName} / {escalation.Kind}")</p>
                    <h2>@escalation.Title</h2>
                </div>
            </div>

            <p class="live-processes-card__summary">@ResolveEscalationSummary(escalation)</p>

            <div class="live-processes-card__metrics">
                <span>@escalation.RunName</span>
                @if (!string.IsNullOrWhiteSpace(escalation.StepTitle))
                {
                    <span>@escalation.StepTitle</span>
                }
                <span>@FormatAge(nowUtc - escalation.UpdatedAtUtc) since update</span>
            </div>

            <div class="live-processes-card__footer">
                <StatusBadge Tone="@ResolveEscalationSeverityTone(escalation.Severity)"
                             Text="@escalation.Severity.ToString()" />
                <StatusBadge Tone="@ResolveEscalationStatusTone(escalation.Status)"
                             Text="@escalation.Status.ToString()" />
            </div>

            <div class="live-processes-notification-card__actions">
                @{
                    var primaryAction = ProcessLiveEscalationActionPolicy.ResolvePrimaryAction(escalation);
                    var secondaryAction = ProcessLiveEscalationActionPolicy.ResolveSecondaryAction(escalation);
                }
                <Button Text="Details"
                        Icon="open_in_new"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Click="@(() => OpenEscalationDetailDialog(escalation))" />
                <Button Text="@primaryAction.Text"
                        Icon="@primaryAction.Icon"
                        ButtonStyle="@ResolveEscalationActionButtonStyle(primaryAction)"
                        Size="ButtonSize.Small"
                        Disabled="@IsActivityActionBusy(escalation.Key)"
                        IsBusy="@IsActivityActionBusy(escalation.Key)"
                        Click="@(() => ExecuteEscalationActionAsync(escalation, primaryAction))" />
                @if (secondaryAction is { } resolvedSecondaryAction)
                {
                    <Button Text="@resolvedSecondaryAction.Text"
                            Icon="@resolvedSecondaryAction.Icon"
                            ButtonStyle="@ResolveEscalationActionButtonStyle(resolvedSecondaryAction)"
                            Size="ButtonSize.Small"
                            Disabled="@IsActivityActionBusy(escalation.Key)"
                            Click="@(() => ExecuteEscalationActionAsync(escalation, resolvedSecondaryAction))" />
                }
            </div>
        </article>;
    }


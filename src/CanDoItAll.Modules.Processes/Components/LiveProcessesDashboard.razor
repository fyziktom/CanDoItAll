    private string RuntimeRunSelectValue
        => selectedRuntimeRunId.HasValue && SelectableRuns.Any(run => run.RunId.Value == selectedRuntimeRunId.Value)
            ? selectedRuntimeRunId.Value.ToString("D")
            : string.Empty;

    private string StatusFilterValue => statusFilter?.ToString() ?? string.Empty;

    private async Task ChangeRuntimeHistoryWindowAsync(ChangeEventArgs args)
    {
        if (Enum.TryParse<ProcessRuntimeHistoryWindow>(args.Value?.ToString(), out var parsed))
        {
            runtimeHistoryWindow = parsed;
            runtimeEventPage = 0;
            await LoadAsync(forceRefresh: false);
        }
    }

    private async Task ChangeStatusFilterAsync(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        statusFilter = Enum.TryParse<ProcessProjectedRunStatus>(value, out var parsed)
            ? parsed
            : null;
        runtimeEventPage = 0;
        selectedRuntimeRunId = ResolveRunIdForCurrentStatusFilter(shell?.Runtime.Runs ?? [], selectedRuntimeRunId);
        await LoadAsync(forceRefresh: false);
    }

    private async Task SelectRuntimeRunAsync(ChangeEventArgs args)
    {
        selectedRuntimeRunId = Guid.TryParse(args.Value?.ToString(), out var parsed) && parsed != Guid.Empty
            ? parsed
            : null;
        runtimeEventPage = 0;
        await LoadAsync(forceRefresh: false);
    }

    private async Task SelectRuntimeRunAsync(Guid runId)
    {
        selectedRuntimeRunId = runId == Guid.Empty ? null : runId;
        runtimeEventPage = 0;
        await LoadAsync(forceRefresh: false);
    }

    private Guid? ResolveRunIdForCurrentStatusFilter(IReadOnlyList<ProcessLiveProcessSnapshot> runs, Guid? requestedRunId)
    {
        if (statusFilter is null)
        {
            return requestedRunId;
        }

        if (!requestedRunId.HasValue)
        {
            return null;
        }

        if (requestedRunId.HasValue && runs.Any(run => run.RunId.Value == requestedRunId.Value && run.Status == statusFilter))
        {
            return requestedRunId;
        }

        return runs
            .Where(run => run.Status == statusFilter)
            .OrderByDescending(run => run.LastEventAtUtc)
            .Select(run => (Guid?)run.RunId.Value)
            .FirstOrDefault();
    }

    private async Task PreviousRuntimeEventPageAsync()
    {
        if (runtimeEventPage == 0)
        {
            return;
        }

        runtimeEventPage--;
        await LoadAsync(forceRefresh: false);
    }

    private async Task NextRuntimeEventPageAsync()
    {
        if (shell?.Runtime.HasMoreEvents != true)
        {
            return;
        }

        runtimeEventPage++;
        await LoadAsync(forceRefresh: false);
    }

    private Task OpenRunDetailDialogAsync(ProcessLiveProcessSnapshot run)
    {
        runDetailSnapshot = run;
        runDetailDialogOpen = true;
        return Task.CompletedTask;
    }

    private Task OpenChildRunAsync(Guid runId)
    {
        selectedRuntimeRunId = runId;
        runDetailSnapshot = shell?.Runtime.Runs.FirstOrDefault(run => run.RunId.Value == runId);
        if (runDetailSnapshot is null)
        {
            Navigation.NavigateTo(ProjectId.HasValue
                ? $"/projects/{ProjectId.Value:D}/processes/live?runId={runId:D}"
                : $"/processes/live?runId={runId:D}");
        }

        return Task.CompletedTask;
    }

    private Task CloseRunDetailDialogAsync()
    {
        runDetailDialogOpen = false;
        runDetailSnapshot = null;
        return Task.CompletedTask;
    }

    private Task OpenAgentDetailDialogAsync(ProcessRuntimeActiveAgentProjection agent)
    {
        agentDetailAgent = agent;
        agentDetailDialogOpen = true;
        return Task.CompletedTask;
    }

    private Task CloseAgentDetailDialogAsync()
    {
        agentDetailDialogOpen = false;
        agentDetailAgent = null;
        return Task.CompletedTask;
    }

    private Task OpenProcessControlAsync(Guid runId)
    {
        var route = ProjectId.HasValue
            ? $"/projects/{ProjectId.Value:D}/processes?runId={runId:D}"
            : $"/processes?runId={runId:D}";
        Navigation.NavigateTo(route);
        return Task.CompletedTask;
    }

    private async Task ExecuteOperatorActionAsync(ProcessRuntimeOperatorActionProjection action)
    {
        if (!action.IsEnabled || busyOperatorActionStepId.HasValue)
        {
            return;
        }

        busyOperatorActionStepId = action.StepInstanceId;
        operatorActionMessage = null;
        operatorActionError = null;

        try
        {
            var result = await ExecuteOperatorActionCommandAsync(action);
            if (!result.Succeeded)
            {
                operatorActionError = result.Diagnostics.Count == 0
                    ? $"{action.Label} was rejected by the runtime."
                    : string.Join(" ", result.Diagnostics);
                NotifyOperatorAction(
                    NotificationSeverity.Error,
                    $"{action.Label} rejected",
                    operatorActionError);
                return;
            }

            operatorActionMessage = $"{action.Label} accepted for {action.StepKey}. Dispatch has been queued.";
            NotifyOperatorAction(
                NotificationSeverity.Success,
                $"{action.Label} accepted",
                $"{action.StepKey} is queued for dispatch.");
            operatorActionNotes.Remove(action.StepInstanceId);
            selectedRuntimeRunId = action.RunId;
            runtimeEventPage = 0;
            await LoadAsync(forceRefresh: true);
            if (runDetailDialogOpen)
            {
                var refreshedRun = shell?.Runtime.Runs.FirstOrDefault(run => run.RunId.Value == action.RunId);
                if (refreshedRun is null || !RequiresOperatorAttention(refreshedRun))
                {
                    await CloseRunDetailDialogAsync();
                }
                else
                {
                    runDetailSnapshot = refreshedRun;
                }
            }
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            operatorActionError = exception.Message;
            NotifyOperatorAction(
                NotificationSeverity.Error,
                $"{action.Label} failed",
                operatorActionError);
        }
        finally
        {
            busyOperatorActionStepId = null;
        }
    }

    private async Task<ProcessRuntimeOperatorActionResult> ExecuteOperatorActionCommandAsync(
        ProcessRuntimeOperatorActionProjection action)
    {
        if (IsMockProjection)
        {
            mockResolvedOperatorActionStepIds.Add(action.StepInstanceId);
            return new ProcessRuntimeOperatorActionResult(
                new ProcessRunId(action.RunId),
                new ProcessStepInstanceId(action.StepInstanceId),
                action.Kind,
                ProcessRuntimeTransitionOutcome.Applied,
                ProcessRuntimeStatus.Active,
                []);
        }

        return await ProjectionClient.ExecuteRuntimeOperatorActionAsync(new ProcessRuntimeOperatorActionCommand(
            new ProcessRunId(action.RunId),
            new ProcessStepInstanceId(action.StepInstanceId),
            action.Kind,
            "live-processes",
            BuildOperatorActionReason(action)));
    }

    private void NotifyOperatorAction(
        NotificationSeverity severity,
        string summary,
        string detail)
    {
        Notifications.Notify(new NotificationMessage
        {
            Severity = severity,
            Summary = summary,
            Detail = detail,
            Duration = severity == NotificationSeverity.Error ? 14_000 : 9_000,
            TestId = "live-processes-operator-action-toast"
        });
    }

    private IReadOnlyList<ProcessRuntimeActiveAgentProjection> ResolveActiveAgents(Guid runId)
        => shell?.Runtime.ActiveAgents
            .Where(agent => agent.RunId == runId)
            .OrderByDescending(agent => agent.IsWorking)
            .ThenByDescending(agent => string.Equals(agent.Status, "Running", StringComparison.Ordinal))
            .ThenBy(agent => agent.ExecutorDisplayName, StringComparer.OrdinalIgnoreCase)
            .ToArray() ?? [];

    private IReadOnlyList<ProcessManagerMessageProjection> ResolveManagerMessages(ProcessRunId runId)
        => shell?.Runtime.ManagerMessages
            .Where(message => message.RunId == runId)
            .OrderByDescending(message => message.CreatedAtUtc)
            .ToArray() ?? [];

    private static ProcessRuntimeOperatorActionProjection? ResolvePrimaryOperatorAction(ProcessLiveProcessSnapshot run)
        => run.OperatorActions
            .Where(action => action.IsEnabled)
            .OrderByDescending(action => string.Equals(action.StepStatus, nameof(ProcessRuntimeStepStatus.Failed), StringComparison.Ordinal))
            .ThenByDescending(action => string.Equals(action.StepStatus, nameof(ProcessRuntimeStepStatus.Blocked), StringComparison.Ordinal))
            .ThenBy(action => action.StepKey, StringComparer.OrdinalIgnoreCase)
            .FirstOrDefault();

    private static ProcessRuntimeActiveAgentProjection? ResolvePrimaryAgent(
        IReadOnlyList<ProcessRuntimeActiveAgentProjection> activeAgents)
        => activeAgents
            .OrderByDescending(agent => agent.IsWorking && !agent.IsLeaseExpired)
            .ThenByDescending(agent => string.Equals(agent.Status, nameof(ProcessRuntimeStepStatus.Running), StringComparison.Ordinal))
            .ThenBy(agent => agent.StepKey, StringComparer.OrdinalIgnoreCase)
            .FirstOrDefault();

    private static string ResolveCurrentStepText(ProcessLiveProcessSnapshot run)
    {
        if (run.CurrentStep is not null)
        {
            return $"{run.CurrentStep.StepKey} / {run.CurrentStep.StepStatus}";
        }

        var childWait = run.WaitingOnChildRuns.FirstOrDefault();
        if (childWait is not null)
        {
            return $"{childWait.ParentStepKey} / waiting on child";
        }

        var action = ResolvePrimaryOperatorAction(run);
        if (action is not null)
        {
            return $"{action.StepKey} / {action.StepStatus}";
        }

        return "No current step";
    }

    private bool IsOperatorActionBusy(ProcessRuntimeOperatorActionProjection action)
        => busyOperatorActionStepId == action.StepInstanceId;

    private string GetOperatorActionNote(ProcessRuntimeOperatorActionProjection action)
        => operatorActionNotes.GetValueOrDefault(action.StepInstanceId, string.Empty);

    private void SetOperatorActionNote(ProcessRuntimeOperatorActionProjection action, string? value)
    {
        var normalized = value?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(normalized))
        {
            operatorActionNotes.Remove(action.StepInstanceId);
            return;
        }

        operatorActionNotes[action.StepInstanceId] = normalized;
    }

    private string BuildOperatorActionReason(ProcessRuntimeOperatorActionProjection action)
    {
        var instruction = FirstNonEmpty(
            action.RecommendedInstruction,
            $"LiveProcesses requested {action.Kind} for step '{action.StepKey}'.");
        var note = GetOperatorActionNote(action);
        return string.IsNullOrWhiteSpace(note)
            ? instruction
            : $"{instruction}{Environment.NewLine}{Environment.NewLine}Operator note:{Environment.NewLine}{note}";
    }

    private static string BuildRunTitle(ProcessLiveProcessSnapshot run)
        => $"Run {run.RunId.Value.ToString("N")[..8]}";

    private static string BuildRunSubtitle(ProcessLiveProcessSnapshot run)
        => $"{run.Status} / {run.LastEventAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)}";

    private static string BuildRunOptionText(ProcessLiveProcessSnapshot run)
        => $"{BuildRunTitle(run)} / {run.Status} / {run.LastEventAtUtc.LocalDateTime:g}";

    private string BuildRunCardSummary(ProcessLiveProcessSnapshot run)
    {
        var action = ResolvePrimaryOperatorAction(run);
        if (action is not null)
        {
            return FirstNonEmpty(
                action.ProblemSummary,
                $"Cause: {action.StepKey} is {action.StepStatus}. Next action: {action.Label.ToLowerInvariant()} for {action.RoleDisplayName}.");
        }

        var incident = run.Incidents.OrderByDescending(item => item.RaisedAtUtc).FirstOrDefault();
        if (incident is not null)
        {
            return $"Cause: {EnsureSentence(incident.SafeSummary)}";
        }

        var activeAgents = ResolveActiveAgents(run.RunId.Value);
        var workingAgent = activeAgents.FirstOrDefault(agent => agent.IsWorking && !agent.IsLeaseExpired);
        if (run.Status == ProcessProjectedRunStatus.Active && workingAgent is not null)
        {
            return $"Active: {EnsureSentence(ResolveAgentCardSummary(workingAgent))}";
        }

        var staleAgent = activeAgents.FirstOrDefault(agent => agent.IsLeaseExpired);
        if (staleAgent is not null)
        {
            return $"Attention: {ResolveAgentDisplayName(staleAgent)} has an expired lease on {staleAgent.StepKey}.";
        }

        var childWait = run.WaitingOnChildRuns.FirstOrDefault();
        if (childWait is not null)
        {
            return $"Waiting: {EnsureSentence(childWait.Summary)}";
        }

        if (run.CurrentStep is not null)
        {
            return $"Current: {EnsureSentence(run.CurrentStep.Summary)}";
        }

        var runtimeEvent = ResolveRunCardEvent(run.RecentEvents);
        return runtimeEvent is null
            ? "No recent runtime events are attached to this run."
            : $"{runtimeEvent.EventType}: {runtimeEvent.Summary}";
    }

    private string BuildAttentionSummary(ProcessLiveProcessSnapshot run)
    {
        var action = ResolvePrimaryOperatorAction(run);
        if (action is not null)
        {
            return $"{FirstNonEmpty(action.ProblemSummary, action.Summary)} {FirstNonEmpty(action.RequiredOperatorDecision, $"Next action: {action.Label} for {action.StepKey}.")}";
        }

        var managerMessage = ResolveManagerMessages(run.RunId).FirstOrDefault();
        if (managerMessage is not null)
        {
            return $"{managerMessage.Kind}: {EnsureSentence(managerMessage.Summary)}";
        }

        return BuildRunCardSummary(run);
    }

    private bool RequiresOperatorAttention(ProcessLiveProcessSnapshot run)
        => run.OperatorActions.Any(action => action.IsEnabled) ||
           run.Status == ProcessProjectedRunStatus.Failed ||
           run.Incidents.Count > 0 ||
           ResolveManagerMessages(run.RunId).Any(message => IsAttentionEventType(message.Kind));

    private static string ResolveRunStatusTone(ProcessProjectedRunStatus status)
        => status switch
        {
            ProcessProjectedRunStatus.Active => "success",
            ProcessProjectedRunStatus.NeedsAttention => "warning",
            ProcessProjectedRunStatus.Failed => "danger",
            ProcessProjectedRunStatus.Completed => "info",
            ProcessProjectedRunStatus.Cancelled => "neutral",
            _ => "neutral"
        };

    private static string ResolveActivityCardClass(ProcessLiveProcessSnapshot run)
        => run.Status switch
        {
            ProcessProjectedRunStatus.NeedsAttention => "live-processes-activity-card live-processes-activity-card--attention",
            ProcessProjectedRunStatus.Failed => "live-processes-activity-card live-processes-activity-card--failed",
            ProcessProjectedRunStatus.Active => "live-processes-activity-card live-processes-activity-card--active",
            _ => "live-processes-activity-card"
        };

    private static int CountWorkingAgents(IReadOnlyList<ProcessRuntimeActiveAgentProjection> agents)
        => agents.Count(agent => agent.IsWorking);

    private static int CountStaleAgentClaims(IReadOnlyList<ProcessRuntimeActiveAgentProjection> agents)
        => agents.Count(agent => agent.IsLeaseExpired);

    private static string ResolveAgentStatusText(ProcessRuntimeActiveAgentProjection agent)
        => agent.IsLeaseExpired ? "Lease expired" : agent.Status;

    private static string ResolveAgentStatusTone(ProcessRuntimeActiveAgentProjection agent)
        => agent.IsLeaseExpired
            ? "warning"
            : agent.Status switch
        {
            "WaitingOnTool" => "warning",
            "Preparing" => "info",
            "Persisting" => "info",
            "Completed" => "success",
            nameof(ProcessRuntimeStepStatus.Running) => "success",
            nameof(ProcessRuntimeStepStatus.Claimed) => "info",
            nameof(ProcessRuntimeStepStatus.Waiting) => "info",
            nameof(ProcessRuntimeStepStatus.Blocked) => "warning",
            nameof(ProcessRuntimeStepStatus.Failed) => "danger",
            _ => "neutral"
        };

    private static string ResolveAgentDisplayName(ProcessRuntimeActiveAgentProjection agent)
        => FirstNonEmpty(agent.AgentName, agent.ExecutorDisplayName, agent.ExecutorId, "Unknown agent");

    private static string ResolveAgentAvatarSeed(ProcessRuntimeActiveAgentProjection agent)
        => agent.AgentId?.ToString("N") ?? FirstNonEmpty(agent.ExecutorId, agent.ExecutorDisplayName, agent.StepInstanceId.ToString("N"));

    private static string ResolveAgentInitials(ProcessRuntimeActiveAgentProjection agent)
        => BuildInitials(ResolveAgentDisplayName(agent));

    private static string ResolveObservationLabel(ProcessRuntimeActiveAgentProjection agent)
        => string.IsNullOrWhiteSpace(agent.ObservationSource)
            ? "Runtime"
            : agent.ObservationSource.Contains("AgentFramework", StringComparison.OrdinalIgnoreCase)
                ? "Execution"
                : "Runtime claim";

    private static string ResolveObservationTone(ProcessRuntimeActiveAgentProjection agent)
        => string.IsNullOrWhiteSpace(agent.ExecutionState) && agent.ObservationSource.Contains("without", StringComparison.OrdinalIgnoreCase)
            ? "warning"
            : "info";

    private static string ResolveAgentCardSummary(ProcessRuntimeActiveAgentProjection agent)
        => FirstNonEmpty(agent.CurrentActivity, agent.Summary);

    private static string ResolveAgentCurrentActivity(ProcessRuntimeActiveAgentProjection agent)
        => FirstNonEmpty(agent.CurrentActivity, agent.Summary, "No active execution activity is available.");

    private static string BuildAgentDetailSubtitle(ProcessRuntimeActiveAgentProjection agent)
        => $"{agent.RoleKey} / {agent.StepKey} / {ResolveAgentStatusText(agent)}";

    private static string FormatAgentSignalAge(ProcessRuntimeActiveAgentProjection agent)
    {
        var observedAtUtc = agent.ExecutionUpdatedAtUtc ?? agent.UpdatedAtUtc;
        var age = DateTimeOffset.UtcNow - observedAtUtc.ToUniversalTime();
        if (age < TimeSpan.FromMinutes(1))
        {
            return "just now";
        }

        return age.TotalHours >= 1
            ? $"{age.TotalHours:N1} h ago"
            : $"{age.TotalMinutes:N0} min ago";
    }

    private static string BuildInitials(string value)
    {
        var words = value
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(word => word.Length > 0)
            .Take(2)
            .ToArray();
        if (words.Length == 0)
        {
            return "A";
        }

        return string.Concat(words.Select(word => char.ToUpperInvariant(word[0])));
    }

    private static LiveRunProgressModel BuildRunProgress(ProcessLiveProcessSnapshot run)
    {
        if (run.ExecutableStepCount > 0)
        {
            var percent = (int)Math.Round((double)run.CompletedStepCount / run.ExecutableStepCount * 100d, MidpointRounding.AwayFromZero);
            percent = Math.Clamp(percent, 0, 100);
            var label = string.IsNullOrWhiteSpace(run.ProgressLabel)
                ? $"{run.CompletedStepCount.ToString(CultureInfo.InvariantCulture)} of {run.ExecutableStepCount.ToString(CultureInfo.InvariantCulture)} steps complete"
                : run.ProgressLabel;
            var tooltip = $"{label}. {run.TerminalStepCount.ToString(CultureInfo.InvariantCulture)} of {run.ExecutableStepCount.ToString(CultureInfo.InvariantCulture)} executable steps are in a terminal state.";

            return new LiveRunProgressModel(
                percent,
                label,
                ResolveRunStatusTone(run.Status),
                ResolveProgressCssClass(run.Status),
                tooltip);
        }

        var eventBoost = Math.Min(18, run.RecentEvents.Count * 3);
        var hasOperatorAction = run.OperatorActions.Any(action => action.IsEnabled);

        return run.Status switch
        {
            ProcessProjectedRunStatus.Completed => new LiveRunProgressModel(
                100,
                "Completed",
                "success",
                "live-processes-run-state--success",
                "The run has reached a completed terminal state."),
            ProcessProjectedRunStatus.Cancelled => new LiveRunProgressModel(
                100,
                "Cancelled",
                "neutral",
                "live-processes-run-state--neutral",
                "The run was cancelled and is no longer active."),
            ProcessProjectedRunStatus.Failed => new LiveRunProgressModel(
                100,
                "Failed",
                "danger",
                "live-processes-run-state--danger",
                "The run failed and needs inspection before retry."),
            ProcessProjectedRunStatus.NeedsAttention when hasOperatorAction => new LiveRunProgressModel(
                Math.Clamp(68 + eventBoost, 68, 92),
                "Blocked decision",
                "warning",
                "live-processes-run-state--warning",
                "An actionable operator decision is available for this run."),
            ProcessProjectedRunStatus.NeedsAttention => new LiveRunProgressModel(
                Math.Clamp(58 + eventBoost, 58, 86),
                "Needs attention",
                "warning",
                "live-processes-run-state--warning",
                "The run has incidents or manager messages that need review."),
            ProcessProjectedRunStatus.Active when run.WaitingOnChildRuns.Count > 0 => new LiveRunProgressModel(
                Math.Clamp(48 + eventBoost, 48, 78),
                "Waiting child",
                "info",
                "live-processes-run-state--info",
                "The root run is active and waiting on a child process run."),
            ProcessProjectedRunStatus.Active when run.CurrentStep is not null => new LiveRunProgressModel(
                Math.Clamp(52 + eventBoost, 52, 84),
                "Current step",
                "success",
                "live-processes-run-state--success",
                $"The current step is {run.CurrentStep.StepKey}."),
            ProcessProjectedRunStatus.Active => new LiveRunProgressModel(
                Math.Clamp(38 + eventBoost, 38, 74),
                "Active",
                "success",
                "live-processes-run-state--success",
                "The run is active in the current projection window."),
            _ => new LiveRunProgressModel(
                Math.Clamp(12 + eventBoost, 12, 48),
                "Observed",
                "neutral",
                "live-processes-run-state--neutral",
                "The run has projection activity but no stronger status signal.")
        };
    }

    private static string ResolveProgressCssClass(ProcessProjectedRunStatus status)
        => status switch
        {
            ProcessProjectedRunStatus.Completed => "live-processes-run-state--success",
            ProcessProjectedRunStatus.Failed => "live-processes-run-state--danger",
            ProcessProjectedRunStatus.NeedsAttention => "live-processes-run-state--warning",
            ProcessProjectedRunStatus.Active => "live-processes-run-state--success",
            _ => "live-processes-run-state--neutral"
        };

    private string ResolveManagerSummary(ProcessLiveProcessSnapshot run)
    {
        if (ResolvePrimaryOperatorAction(run) is { } action)
        {
            return FirstNonEmpty(
                action.RequiredOperatorDecision,
                action.ProblemSummary,
                action.Summary,
                "Operator review is required before the run can continue.");
        }

        if (ResolveManagerMessages(run.RunId).FirstOrDefault() is { } managerMessage)
        {
            return $"{managerMessage.Kind}: {EnsureSentence(managerMessage.Summary)}";
        }

        if (run.Incidents.OrderByDescending(item => item.RaisedAtUtc).FirstOrDefault() is { } incident)
        {
            return EnsureSentence(incident.SafeSummary);
        }

        return run.CurrentStep is null
            ? "No manager message is attached to this run."
            : EnsureSentence(run.CurrentStep.Summary);
    }

    private static IReadOnlyList<ToolFamilySummary> BuildToolFamilySummaries(
        IReadOnlyList<ProcessRuntimeToolUsageProjection> tools)
    {
        if (tools.Count == 0)
        {
            return [];
        }

        return tools
            .GroupBy(ResolveToolFamily)
            .Select(group => CreateToolFamilySummary(
                group.Key,
                group
                    .OrderByDescending(tool => tool.CallCount)
                    .ThenBy(tool => tool.ToolName, StringComparer.OrdinalIgnoreCase)
                    .ToArray()))
            .OrderByDescending(summary => summary.CallCount)
            .ThenBy(summary => summary.Label, StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private static ToolFamilySummary ResolveToolFamilySummary(ProcessRuntimeToolUsageProjection tool)
        => CreateToolFamilySummary(ResolveToolFamily(tool), [tool]);

    private static ToolFamilySummary CreateToolFamilySummary(
        LiveProcessToolFamily family,
        IReadOnlyList<ProcessRuntimeToolUsageProjection> tools)
    {
        var metadata = ResolveToolFamilyMetadata(family);
        return new ToolFamilySummary(
            family,
            metadata.Label,
            metadata.Icon,
            metadata.Tone,
            metadata.CssClass,
            tools.Count,
            tools.Sum(tool => tool.CallCount),
            tools.Max(tool => tool.LastUsedAtUtc),
            tools);
    }

    private static LiveProcessToolFamily ResolveToolFamily(ProcessRuntimeToolUsageProjection tool)
    {
        var normalized = $"{tool.ToolName} {tool.Summary}".ToLowerInvariant();
        if (normalized.Contains("browser", StringComparison.Ordinal) ||
            normalized.Contains("playwright", StringComparison.Ordinal) ||
            normalized.Contains("screenshot", StringComparison.Ordinal) ||
            normalized.Contains("snapshot", StringComparison.Ordinal) ||
            normalized.Contains("console", StringComparison.Ordinal))
        {
            return LiveProcessToolFamily.Browser;
        }

        if (normalized.Contains("project_structure", StringComparison.Ordinal) ||
            normalized.Contains("project structure", StringComparison.Ordinal))
        {
            return LiveProcessToolFamily.ProjectStructure;
        }

        if (normalized.Contains("dotnet", StringComparison.Ordinal) ||
            normalized.Contains("msbuild", StringComparison.Ordinal) ||
            normalized.Contains("restore", StringComparison.Ordinal) ||
            normalized.Contains("build", StringComparison.Ordinal) ||
            normalized.Contains("test", StringComparison.Ordinal))
        {
            return LiveProcessToolFamily.DotNet;
        }

        if (normalized.Contains("workspace", StringComparison.Ordinal) ||
            normalized.Contains("pwsh", StringComparison.Ordinal) ||
            normalized.Contains("shell", StringComparison.Ordinal) ||
            normalized.Contains("file", StringComparison.Ordinal) ||
            normalized.Contains("directory", StringComparison.Ordinal))
        {
            return LiveProcessToolFamily.Workspace;
        }

        if (normalized.Contains("agent", StringComparison.Ordinal) ||
            normalized.Contains("model", StringComparison.Ordinal) ||
            normalized.Contains("prompt", StringComparison.Ordinal) ||
            normalized.Contains("completion", StringComparison.Ordinal))
        {
            return LiveProcessToolFamily.AgentRuntime;
        }

        if (normalized.Contains("storage", StringComparison.Ordinal) ||
            normalized.Contains("artifact", StringComparison.Ordinal) ||
            normalized.Contains("evidence", StringComparison.Ordinal))
        {
            return LiveProcessToolFamily.Storage;
        }

        if (normalized.Contains("process", StringComparison.Ordinal) ||
            normalized.Contains("step", StringComparison.Ordinal) ||
            normalized.Contains("manager", StringComparison.Ordinal))
        {
            return LiveProcessToolFamily.ProcessRuntime;
        }

        return LiveProcessToolFamily.Other;
    }

    private static (string Label, string Icon, string Tone, string CssClass) ResolveToolFamilyMetadata(
        LiveProcessToolFamily family)
        => family switch
        {
            LiveProcessToolFamily.Browser => ("Browser", "travel_explore", "info", "live-processes-tool-card--browser"),
            LiveProcessToolFamily.DotNet => (".NET", "terminal", "success", "live-processes-tool-card--dotnet"),
            LiveProcessToolFamily.ProjectStructure => ("Project structure", "account_tree", "accent", "live-processes-tool-card--structure"),
            LiveProcessToolFamily.Workspace => ("Workspace", "folder_open", "neutral", "live-processes-tool-card--workspace"),
            LiveProcessToolFamily.ProcessRuntime => ("Process runtime", "schema", "warning", "live-processes-tool-card--runtime"),
            LiveProcessToolFamily.AgentRuntime => ("Agent runtime", "smart_toy", "info", "live-processes-tool-card--agent"),
            LiveProcessToolFamily.Storage => ("Artifacts", "inventory_2", "neutral", "live-processes-tool-card--storage"),
            _ => ("Other", "extension", "neutral", "live-processes-tool-card--other")
        };

    private static string FirstNonEmpty(params string?[] values)
        => values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim() ?? string.Empty;

    private static string ResolveManagerMessageTone(ProcessManagerMessageProjection message)
        => IsAttentionEventType(message.Kind) ? "warning" : "info";

    private static string ResolveEventTone(ProcessTimelineEventProjection runtimeEvent)
        => runtimeEvent.Sensitivity == ProcessProjectedSensitivity.Restricted
            ? "warning"
            : runtimeEvent.EventType.StartsWith("Manager", StringComparison.Ordinal)
                ? "info"
                : IsAttentionEventType(runtimeEvent.EventType)
                    ? "warning"
                    : "neutral";

    private static ProcessLiveRunEventProjection? ResolveRunCardEvent(IReadOnlyList<ProcessLiveRunEventProjection> events)
        => events
            .OrderByDescending(item => IsAttentionEventType(item.EventType))
            .ThenByDescending(item => item.OccurredAtUtc)
            .FirstOrDefault();

    private static bool IsAttentionEventType(string eventType)
        => eventType.Contains("Blocked", StringComparison.OrdinalIgnoreCase) ||
           eventType.Contains("Failed", StringComparison.OrdinalIgnoreCase) ||
           eventType.Contains("Denied", StringComparison.OrdinalIgnoreCase) ||
           eventType.Contains("Rejected", StringComparison.OrdinalIgnoreCase) ||
           eventType.Contains("Escalated", StringComparison.OrdinalIgnoreCase) ||
           eventType.Contains("Incident", StringComparison.OrdinalIgnoreCase);

    private static string FormatHistoryWindow(ProcessRuntimeHistoryWindow window)
        => window switch
        {
            ProcessRuntimeHistoryWindow.LiveHour => "Last hour",
            ProcessRuntimeHistoryWindow.OneDay => "Last 24 hours",
            ProcessRuntimeHistoryWindow.SevenDays => "Last 7 days",
            ProcessRuntimeHistoryWindow.ThirtyDays => "Last 30 days",
            _ => window.ToString()
        };

    private static string FormatDuration(long durationMs)
    {
        if (durationMs <= 0)
        {
            return "0 min";
        }

        var duration = TimeSpan.FromMilliseconds(durationMs);
        return duration.TotalHours >= 1
            ? $"{duration.TotalHours:N1} h"
            : $"{duration.TotalMinutes:N1} min";
    }

    private static string FormatDuration(TimeSpan duration)
        => FormatDuration(checked((long)Math.Max(0, duration.TotalMilliseconds)));

    private static decimal ResolveRuntimeCost(ProcessRuntimeStatsProjection stats)
        => stats.ActualCost > 0 ? stats.ActualCost : stats.EstimatedCost;

    private string FormatCurrency(decimal value)
        => CurrencyFormatter.Format(value);

    private static string TrimLabel(string value, int maxLength)
    {
        if (value.Length <= maxLength)
        {
            return value;
        }

        return $"{value[..Math.Max(0, maxLength - 3)]}...";
    }

    private static string EnsureSentence(string value)
    {
        var trimmed = value.Trim();
        if (trimmed.Length == 0 ||
            trimmed.EndsWith(".", StringComparison.Ordinal) ||
            trimmed.EndsWith("!", StringComparison.Ordinal) ||
            trimmed.EndsWith("?", StringComparison.Ordinal))
        {
            return trimmed;
        }

        return $"{trimmed}.";
    }

    private RenderFragment RenderMetricCard(
        string label,
        string value,
        string tone,
        string summary) => @<SurfaceCard Soft="true">
        <TextBlock TextStyle="TextStyle.Eyebrow" Value="@label" />
        <h3 class="text-base font-semibold text-slate-900">@value</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">@summary</p>
        <StatusBadge Tone="@tone" Text="@label" />
    </SurfaceCard>;

    private static string FormatCount(int count, string singular, string plural)
        => count == 1
            ? $"1 {singular}"
            : $"{count.ToString("N0", CultureInfo.CurrentCulture)} {plural}";
}

    private RenderFragment RenderActiveAgentCard(ProcessRuntimeActiveAgentProjection agent) => @<article class="live-processes-agent-card"
                                                                                                         data-testid="live-processes-active-agent-card">
        <div class="live-processes-agent-card__header">
            <div class="live-processes-agent-card__avatar-row">
                <Avatar Alt="@ResolveAgentDisplayName(agent)"
                        ImageUrl="@agent.AgentAvatarImageUrl"
                        FallbackText="@ResolveAgentInitials(agent)"
                        DefaultImageSeed="@ResolveAgentAvatarSeed(agent)"
                        Size="AvatarSize.Large"
                        Shape="AvatarShape.Rounded" />
                <div class="live-processes-agent-card__identity">
                    <span class="live-processes-agent-card__name">@ResolveAgentDisplayName(agent)</span>
                    <span class="live-processes-agent-card__role">@agent.RoleKey</span>
                </div>
            </div>
            <StatusBadge Tone="@ResolveAgentStatusTone(agent)" Text="@ResolveAgentStatusText(agent)" />

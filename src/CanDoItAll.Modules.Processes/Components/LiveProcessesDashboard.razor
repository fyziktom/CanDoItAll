@namespace CanDoItAll.Modules.Processes
@using System.Globalization
@using CanDoItAll.Processes.Abstractions
@using CanDoItAll.Processes.Application
@using CanDoItAll.Processes.Projections
@using CanDoItAll.Processes.Runtime
@inject IProcessWorkspaceProjectionClient ProjectionClient
@inject NavigationManager Navigation

<PageTitle>@PageTitleText</PageTitle>

<PageScaffold FillHeight="true"
              MaxWidthClass="max-w-full"
              Class="live-processes-page"
              data-testid="live-processes-page">
    <Header>
        <Toolbar Class="live-processes-command-strip"
                 data-testid="live-processes-command-strip">
            <ToolbarRow Class="live-processes-command-strip__row">
                <CompactStatStrip Class="min-w-0">
                    <p class="cda-eyebrow whitespace-nowrap">Processes</p>
                    <h1 class="live-processes-title">@PageTitleText</h1>
                    <CompactStat Tone="info"
                                 Text="@FormatCount(shell?.LiveRuns.ActiveRunCount ?? 0, "active", "active")"
                                 TooltipText="Process runs currently active in the live projection." />
                    <CompactStat Tone="warning"
                                 Text="@FormatCount(shell?.LiveRuns.AttentionRunCount ?? 0, "attention", "attention")"
                                 TooltipText="Process runs currently needing operator attention." />
                    <CompactStat Tone="danger"
                                 Text="@FormatCount(shell?.LiveRuns.FailedRunCount ?? 0, "failed", "failed")"
                                 TooltipText="Process runs currently failed in the live projection." />
                    <CompactStat Tone="@ProjectionTone"
                                 Text="@ProjectionStatusText"
                                 TooltipText="@ProjectionTooltip" />
                </CompactStatStrip>

                <ToolbarActions Class="live-processes-command-strip__actions">
                    <PageHeaderActionButton Icon="refresh"
                                            Label="Refresh"
                                            TooltipText="Refresh the live process projection."
                                            Disabled="@isLoading"
                                            IsBusy="@isLoading"
                                            Click="ForceRefreshAsync"
                                            data-testid="live-processes-refresh-button" />
                    <PageHeaderActionButton Icon="account_tree"
                                            Label="Definitions"
                                            TooltipText="Open the process definitions workspace."
                                            Disabled="@isLoading"
                                            Click="OpenDefinitionsAsync"
                                            data-testid="live-processes-open-definitions" />
                </ToolbarActions>
            </ToolbarRow>
        </Toolbar>
    </Header>

    <ChildContent>
        <Stack GapScale="LayoutGap.Medium"
               Class="live-processes-dashboard min-h-0 flex-1"
               data-testid="live-processes-dashboard">
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="live-processes-alert"
                     role="alert"
                     data-testid="live-processes-error">
                    <Icon Name="error" />
                    <span>@errorMessage</span>
                </div>
            }
            else if (LaunchStarted)
            {
                <div class="live-processes-alert live-processes-alert--success"
                     role="status"
                     data-testid="live-processes-started-notification">
                    <Icon Name="check_circle" />
                    <span>Process started. Live run projection is loading.</span>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(operatorActionError))
            {
                <div class="live-processes-alert"
                     role="alert"
                     data-testid="live-processes-operator-action-error">
                    <Icon Name="error" />
                    <span>@operatorActionError</span>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(operatorActionMessage))
            {
                <div class="live-processes-alert live-processes-alert--success"
                     role="status"
                     data-testid="live-processes-operator-action-message">
                    <Icon Name="check_circle" />
                    <span>@operatorActionMessage</span>
                </div>
            }

            @if (isLoading && shell is null)
            {
                <LoadingState Eyebrow="Live processes"
                              Title="Loading process projection"
                              Description="Collecting the current live run projection through the process application boundary." />
            }
            else if (shell is not null)
            {
                <div class="live-processes-summary"
                     data-testid="live-processes-summary">
                    <CompactStatStrip>
                        <CompactStat Label="definitions"
                                     Value="@DefinitionCountText"
                                     TooltipText="@shell.DefinitionCatalog.Summary"
                                     Tone="info" />
                        <CompactStat Label="active"
                                     Value="@shell.LiveRuns.ActiveRunCount.ToString("N0", CultureInfo.CurrentCulture)"
                                     TooltipText="Active process runs in this scope."
                                     Tone="success" />
                        <CompactStat Label="attention"
                                     Value="@shell.LiveRuns.AttentionRunCount.ToString("N0", CultureInfo.CurrentCulture)"
                                     TooltipText="Runs that need operator attention."
                                     Tone="warning" />
                        <CompactStat Label="failed"
                                     Value="@shell.LiveRuns.FailedRunCount.ToString("N0", CultureInfo.CurrentCulture)"
                                     TooltipText="Failed runs in this scope."
                                     Tone="danger" />
                        <CompactStat Label="last event"
                                     Value="@LastEventText"
                                     TooltipText="Most recent live-run event observed by the projection." />
                        <CompactStat Label="backlog"
                                     Value="@shell.Refresh.BacklogEventCount.ToString("N0", CultureInfo.CurrentCulture)"
                                     TooltipText="@shell.Refresh.Summary"
                                     Tone="@ProjectionTone" />
                    </CompactStatStrip>
                </div>

                <div class="live-processes-tabs-frame"
                     data-testid="live-processes-tabs-frame">
                    <Tabs SelectedIndex="@selectedTabIndex"
                          SelectedIndexChanged="HandleTabChangedAsync"
                          Variant="TabsVariant.WorkspacePrimary"
                          RenderMode="TabRenderMode.Client"
                          OverflowMode="TabsOverflowMode.Auto"
                          PanelOverflowMode="TabsPanelOverflowMode.Auto"
                          FillHeight="true"
                          Class="live-processes-tabs"
                          data-testid="live-processes-tabs">
                        <TabsItem Text="Activity"
                                  Icon="monitoring"
                                  BadgeText="@shell.LiveRuns.ActiveRunCount.ToString(CultureInfo.InvariantCulture)">
                            @RenderActivityTab()
                        </TabsItem>

                    <TabsItem Text="Agents"
                              Icon="smart_toy"
                              BadgeText="@CountWorkingAgents(shell.Runtime.ActiveAgents).ToString(CultureInfo.InvariantCulture)">
                        @RenderAgentsTab()
                    </TabsItem>

                        <TabsItem Text="Graphs"
                                  Icon="bar_chart">
                            @RenderGraphsTab()
                        </TabsItem>

                        <TabsItem Text="Tool analytics"
                                  Icon="analytics"
                                  BadgeText="@shell.Refresh.BacklogEventCount.ToString(CultureInfo.InvariantCulture)">
                            @RenderToolAnalyticsTab()
                        </TabsItem>
                    </Tabs>
                </div>
            }
        </Stack>
    </ChildContent>
</PageScaffold>

@if (runDetailDialogOpen && runDetailSnapshot is not null)
{
    <Dialog IsOpen="true"
            Eyebrow="Live process"
            Title="@BuildRunTitle(runDetailSnapshot)"
            Subtitle="@BuildRunSubtitle(runDetailSnapshot)"
            Size="ModalSize.Full"
            DenseChrome="true"
            TestId="live-processes-run-detail-dialog"
            OnClose="CloseRunDetailDialogAsync">
        <ChildContent>
            @RenderRunDetailDialog(runDetailSnapshot)
        </ChildContent>
        <Footer>
            <Cluster JustifyContent="JustifyContent.End">
                <Button Text="Close"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Click="CloseRunDetailDialogAsync" />
            </Cluster>
        </Footer>
    </Dialog>
}

@if (agentDetailDialogOpen && agentDetailAgent is not null)
{
    <Dialog IsOpen="true"
            Eyebrow="Active agent"
            Title="@ResolveAgentDisplayName(agentDetailAgent)"
            Subtitle="@BuildAgentDetailSubtitle(agentDetailAgent)"
            Size="ModalSize.Wide"
            DenseChrome="true"
            TestId="live-processes-agent-detail-dialog"
            OnClose="CloseAgentDetailDialogAsync">
        <ChildContent>
            @RenderAgentDetailDialog(agentDetailAgent)
        </ChildContent>
        <Footer>
            <Cluster JustifyContent="JustifyContent.End" Gap="LayoutGap.Small">
                <Button Icon="open_in_new"
                        Text="Process"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Click="@(() => OpenProcessControlAsync(agentDetailAgent.RunId))" />
                <Button Text="Close"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Click="CloseAgentDetailDialogAsync" />
            </Cluster>
        </Footer>
    </Dialog>
}

@code {
    private static readonly ProcessRuntimeHistoryWindow[] RuntimeHistoryWindowOptions =
    [
        ProcessRuntimeHistoryWindow.LiveHour,
        ProcessRuntimeHistoryWindow.OneDay,
        ProcessRuntimeHistoryWindow.SevenDays,
        ProcessRuntimeHistoryWindow.ThirtyDays
    ];

    private static readonly ProcessProjectedRunStatus[] StatusFilterOptions =
    [
        ProcessProjectedRunStatus.Active,
        ProcessProjectedRunStatus.NeedsAttention,
        ProcessProjectedRunStatus.Failed,
        ProcessProjectedRunStatus.Completed,
        ProcessProjectedRunStatus.Cancelled
    ];

    private static readonly CdaChartOptions RuntimeActivityChartOptions = new()
    {
        Type = CdaChartType.Area,
        XAxisType = CdaChartAxisType.DateTime,
        YAxisTitle = "Events",
        TooltipPrecision = 0,
        ValuePrecision = 0,
        FillOpacity = 0.22,
        LegendPosition = CdaChartLegendPosition.Bottom,
        Palette = ["#2563eb", "#7c3aed", "#0891b2"]
    };

    private static readonly CdaChartOptions RuntimeToolUsageChartOptions = new()
    {
        Type = CdaChartType.Bar,
        XAxisType = CdaChartAxisType.Category,
        YAxisTitle = "Calls",
        TooltipPrecision = 0,
        ValuePrecision = 0,
        ShowToolbar = false,
        EnableZoom = false,
        RotateXAxisLabels = false,
        LegendPosition = CdaChartLegendPosition.Bottom,
        Palette = ["#f59e0b"]
    };

    [Parameter]
    public Guid? ProjectId { get; set; }

    [Parameter]
    public Guid? ProcessIdQuery { get; set; }

    [Parameter]
    public Guid? RunIdQuery { get; set; }

    [Parameter]
    public Guid? LaunchPlanIdQuery { get; set; }

    [Parameter]
    public bool LaunchStarted { get; set; }

    private ProcessWorkspaceShellProjection? shell;
    private bool isLoading;
    private string? errorMessage;
    private int selectedTabIndex;
    private Guid? selectedRuntimeRunId;
    private ProcessRuntimeHistoryWindow runtimeHistoryWindow = ProcessRuntimeHistoryWindow.LiveHour;
    private int runtimeEventPage;
    private const int RuntimeEventPageSize = 25;
    private ProcessProjectedRunStatus? statusFilter;
    private bool runDetailDialogOpen;
    private ProcessLiveProcessSnapshot? runDetailSnapshot;
    private bool agentDetailDialogOpen;
    private ProcessRuntimeActiveAgentProjection? agentDetailAgent;
    private Guid? busyOperatorActionStepId;
    private string? operatorActionMessage;
    private string? operatorActionError;
    private readonly Dictionary<Guid, string> operatorActionNotes = new();

    private string PageTitleText => ProjectId.HasValue ? "Project live processes" : "Live processes";

    private string DefinitionCountText
        => shell is null
            ? "0"
            : (shell.DefinitionCatalog.PublishedDefinitionCount + shell.DefinitionCatalog.DraftDefinitionCount).ToString("N0", CultureInfo.CurrentCulture);

    private string LastEventText
        => shell?.Runtime.Runs.Count > 0
            ? shell.Runtime.Runs.Max(run => run.LastEventAtUtc).LocalDateTime.ToString("g", CultureInfo.CurrentCulture)
            : "No events";

    private string ProjectionStatusText
        => shell?.Refresh.Status switch
        {
            ProcessWorkspaceProjectionStatus.Ready => "Ready",
            ProcessWorkspaceProjectionStatus.RefreshRequested => "Refresh requested",
            ProcessWorkspaceProjectionStatus.ProjectionStoreUnavailable => "Store pending",
            _ => "Loading"
        };

    private string ProjectionTooltip
        => shell?.Refresh.Summary ?? "Live process projection is loading.";

    private string ProjectionTone
        => shell?.Refresh.Status switch
        {
            ProcessWorkspaceProjectionStatus.Ready => "success",
            ProcessWorkspaceProjectionStatus.RefreshRequested => "info",
            ProcessWorkspaceProjectionStatus.ProjectionStoreUnavailable => "warning",
            _ => "neutral"
        };

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync(forceRefresh: false);
    }

    private Task ForceRefreshAsync()
        => LoadAsync(forceRefresh: true);

    private Task OpenDefinitionsAsync()
    {
        Navigation.NavigateTo(ProjectId.HasValue ? $"/projects/{ProjectId.Value:D}/processes" : "/processes");
        return Task.CompletedTask;
    }

    private async Task LoadAsync(bool forceRefresh)
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            shell = await LoadShellProjectionAsync(forceRefresh, selectedRuntimeRunId ?? RunIdQuery);
            var requestedRunId = shell.Runtime.SelectedRunId ?? selectedRuntimeRunId ?? RunIdQuery;
            var resolvedRunId = ResolveRunIdForCurrentStatusFilter(shell.Runtime.Runs, requestedRunId);

            if (resolvedRunId != requestedRunId)
            {
                selectedRuntimeRunId = resolvedRunId;
                runtimeEventPage = 0;
                shell = await LoadShellProjectionAsync(forceRefresh: false, selectedRuntimeRunId);
            }
            else
            {
                selectedRuntimeRunId = resolvedRunId;
            }
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            errorMessage = exception.Message;
            shell = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task<ProcessWorkspaceShellProjection> LoadShellProjectionAsync(bool forceRefresh, Guid? runId)
        => ProjectionClient.GetShellAsync(new ProcessWorkspaceShellRequest(
            ResolveScope(),
            new ProcessWorkspaceSelectionProjection(ProcessIdQuery, RunIdQuery, LaunchPlanIdQuery),
            new ProcessDefinitionCatalogQueryProjection(
                SearchText: null,
                SelectedDefinitionKey: null,
                ProcessDefinitionCatalogScopeKind.All,
                Take: 25),
            new ProcessTemplateCatalogQueryProjection(
                SearchText: null,
                ProcessTemplateCatalogCategoryKind.All,
                SelectedItemKey: null,
                ProcessTemplateCatalogPreviewTabKind.Overview,
                Take: 25),
            forceRefresh,
            new ProcessRuntimeWorkspaceQueryProjection(
                runtimeHistoryWindow,
                runtimeEventPage,
                RuntimeEventPageSize,
                runId)));

    private ProcessWorkspaceShellScope ResolveScope()
        => ProjectId.HasValue
            ? ProcessWorkspaceShellScope.ForProject(ProjectId.Value)
            : ProcessWorkspaceShellScope.Global;

    private Task HandleTabChangedAsync(int index)
    {
        selectedTabIndex = index;
        return Task.CompletedTask;
    }

    private IReadOnlyList<ProcessLiveProcessSnapshot> SelectableRuns
        => shell?.Runtime.Runs
            .Where(run => statusFilter is null || run.Status == statusFilter)
            .ToArray() ?? [];

    private IReadOnlyList<ProcessLiveProcessSnapshot> VisibleRuns
        => SelectableRuns
            .Where(run => !selectedRuntimeRunId.HasValue || run.RunId.Value == selectedRuntimeRunId.Value)
            .ToArray();

    private IReadOnlyList<ProcessRuntimeActiveAgentProjection> VisibleActiveAgents
        => shell?.Runtime.ActiveAgents
            .Where(agent => !selectedRuntimeRunId.HasValue || agent.RunId == selectedRuntimeRunId.Value)
            .OrderByDescending(agent => agent.IsWorking)
            .ThenByDescending(agent => string.Equals(agent.Status, "Running", StringComparison.Ordinal))
            .ThenBy(agent => agent.ExecutorDisplayName, StringComparer.OrdinalIgnoreCase)
            .ToArray() ?? [];

    private IReadOnlyList<ProcessLiveProcessSnapshot> ActivityCardRuns
        => VisibleRuns
            .Where(run =>
                run.IsActive ||
                run.Status is ProcessProjectedRunStatus.NeedsAttention or ProcessProjectedRunStatus.Failed ||
                run.Incidents.Count > 0)
            .OrderByDescending(run => run.Status == ProcessProjectedRunStatus.NeedsAttention)
            .ThenByDescending(run => run.Status == ProcessProjectedRunStatus.Failed)
            .ThenByDescending(run => run.IsActive)
            .ThenByDescending(run => run.LastEventAtUtc)
            .Take(12)
            .ToArray();

    private IReadOnlyList<ProcessLiveProcessSnapshot> AttentionRuns
        => VisibleRuns
            .Where(RequiresOperatorAttention)
            .OrderByDescending(run => run.Status == ProcessProjectedRunStatus.NeedsAttention)
            .ThenByDescending(run => run.Status == ProcessProjectedRunStatus.Failed)
            .ThenByDescending(run => run.Incidents.Count)
            .ThenByDescending(run => ResolveManagerMessages(run.RunId).Count)
            .ThenByDescending(run => run.LastEventAtUtc)
            .Take(6)
            .ToArray();

    private RenderFragment RenderActivityTab() => @<Stack GapScale="LayoutGap.Medium"
                                                          data-testid="live-processes-activity">
        @RenderRuntimeToolbar("live-processes-runtime-toolbar")
        @RenderAttentionPanel()
        @RenderActivityCards()
        <Grid Gap="LayoutGap.Medium"
              ColumnTemplateXl="minmax(0,0.9fr) minmax(0,1.1fr)">
            @RenderRunCards()
            @RenderEventLedger()
        </Grid>
    </Stack>;

    private RenderFragment RenderAgentsTab() => @<Stack GapScale="LayoutGap.Medium"
                                                        data-testid="live-processes-agents">
        <SurfaceCard Soft="true">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Manager context" />
            <h2 class="text-base font-semibold text-slate-900">@shell!.AgentEntry.Label</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">@shell.AgentEntry.ContextKey</p>
            <p class="mt-2 text-sm leading-6 text-slate-600">@shell.Runtime.AttentionSummary</p>
            <Cluster Gap="LayoutGap.Small"
                     Class="mt-4 flex-wrap">
                <StatusBadge Tone="@(shell.AgentEntry.IsAvailable ? "success" : "warning")"
                             Text="@(shell.AgentEntry.IsAvailable ? "Available" : "Unavailable")" />
                <StatusBadge Tone="info" Text="@FormatCount(CountWorkingAgents(VisibleActiveAgents), "working agent", "working agents")" />
                @if (CountStaleAgentClaims(VisibleActiveAgents) > 0)
                {
                    <StatusBadge Tone="warning" Text="@FormatCount(CountStaleAgentClaims(VisibleActiveAgents), "stale claim", "stale claims")" />
                }
                @if (!string.IsNullOrWhiteSpace(shell.AgentEntry.DisabledReason))
                {
                    <StatusBadge Tone="warning" Text="@shell.AgentEntry.DisabledReason" />
                }
            </Cluster>
        </SurfaceCard>
        @RenderActiveAgentGrid(VisibleActiveAgents, "live-processes-active-agents")
    </Stack>;

    private RenderFragment RenderGraphsTab() => @<Stack GapScale="LayoutGap.Medium"
                                                        data-testid="live-processes-graphs">
        @RenderRuntimeToolbar("live-processes-graphs-toolbar")
        <Grid Gap="LayoutGap.Medium" ColumnsLg="4">
            @RenderMetricCard("Events", shell!.Runtime.Stats.EventCount.ToString(CultureInfo.InvariantCulture), "info", "Paged runtime events in the selected history window.")
            @RenderMetricCard("Manager", shell.Runtime.Stats.ManagerEventCount.ToString(CultureInfo.InvariantCulture), "warning", "Manager signals and escalations.")
            @RenderMetricCard("Tool usage", shell.Runtime.Stats.ToolCallCount.ToString(CultureInfo.InvariantCulture), "neutral", "Runtime activity grouped by event/tool category.")
            @RenderMetricCard("Time", FormatDuration(shell.Runtime.Stats.DurationMs), "info", "Observed runtime span for the current page.")
        </Grid>
        <Grid Gap="LayoutGap.Medium"
              ColumnTemplateXl="minmax(0,1fr) minmax(0,1fr)">
            <CdaChart Title="Selected history"
                      Description="Events, manager signals, and tool activity."
                      Series="@RuntimeActivitySeries"
                      Options="@RuntimeActivityChartOptions"
                      Height="320"
                      EmptyText="No runtime events match the selected filters." />
            <CdaChart Title="Tool usage"
                      Description="Most active event/tool categories."
                      Series="@RuntimeToolUsageSeries"
                      Options="@RuntimeToolUsageChartOptions"
                      Height="320"
                      EmptyText="No runtime tool activity is present in this scope." />
        </Grid>
    </Stack>;

    private RenderFragment RenderToolAnalyticsTab() => @<Grid Gap="LayoutGap.Medium"
                                                              ColumnTemplateXl="minmax(0,0.8fr) minmax(0,1.2fr)"
                                                              data-testid="live-processes-tool-analytics">
        @RenderToolUsageLedger()
        @RenderEventLedger()
    </Grid>;

    private IReadOnlyList<CdaChartSeries> RuntimeActivitySeries
    {
        get
        {
            var points = shell?.Runtime.MetricPoints ?? [];
            if (points.Count == 0)
            {
                return [];
            }

            return
            [
                new CdaChartSeries
                {
                    Name = "Events",
                    Type = CdaChartType.Area,
                    Color = "#2563eb",
                    Points = points.Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, item.EventCount)).ToArray()
                },
                new CdaChartSeries
                {
                    Name = "Manager signals",
                    Type = CdaChartType.Line,
                    Color = "#7c3aed",
                    Points = points.Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, item.ManagerEventCount)).ToArray()
                },
                new CdaChartSeries
                {
                    Name = "Tool activity",
                    Type = CdaChartType.Line,
                    Color = "#0891b2",
                    Points = points.Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, item.ToolCallCount)).ToArray()
                }
            ];
        }
    }

    private IReadOnlyList<CdaChartSeries> RuntimeToolUsageSeries
    {
        get
        {
            var toolUsage = shell?.Runtime.ToolUsage.Take(15).ToArray() ?? [];
            if (toolUsage.Length == 0)
            {
                return [];
            }

            return
            [
                new CdaChartSeries
                {
                    Name = "Calls",
                    Type = CdaChartType.Bar,
                    Color = "#f59e0b",
                    Points = toolUsage.Select(item => new CdaChartPoint(TrimLabel(item.ToolName, 26), item.CallCount)).ToArray()
                }
            ];
        }
    }

    private RenderFragment RenderRuntimeToolbar(string testId) => @<SurfaceCard Soft="true"
                                                                                Class="live-processes-filter-strip"
                                                                                data-testid="@testId">
        <Grid Gap="LayoutGap.Medium"
              ColumnTemplateXl="minmax(14rem,0.55fr) minmax(14rem,0.55fr) minmax(16rem,1fr) auto"
              AlignItems="AlignItems.End">
            <Stack GapScale="LayoutGap.Tiny">
                <label class="text-xs font-semibold text-slate-500" for="@($"{testId}-window")">History</label>
                <select id="@($"{testId}-window")"
                        class="cda-input"
                        value="@runtimeHistoryWindow"
                        @onchange="ChangeRuntimeHistoryWindowAsync"
                        data-testid="live-processes-history-window">
                    @foreach (var option in RuntimeHistoryWindowOptions)
                    {
                        <option value="@option">@FormatHistoryWindow(option)</option>
                    }
                </select>
            </Stack>
            <Stack GapScale="LayoutGap.Tiny">
                <label class="text-xs font-semibold text-slate-500" for="@($"{testId}-status")">Status</label>
                <select id="@($"{testId}-status")"
                        class="cda-input"
                        value="@StatusFilterValue"
                        @onchange="ChangeStatusFilterAsync"
                        data-testid="live-processes-status-filter">
                    <option value="">All statuses</option>
                    @foreach (var option in StatusFilterOptions)
                    {
                        <option value="@option">@option.ToString()</option>
                    }
                </select>
            </Stack>
            <Stack GapScale="LayoutGap.Tiny">
                <label class="text-xs font-semibold text-slate-500" for="@($"{testId}-run")">Run</label>
                <select id="@($"{testId}-run")"
                        class="cda-input"
                        value="@RuntimeRunSelectValue"
                        @onchange="SelectRuntimeRunAsync"
                        data-testid="live-processes-run-filter">
                    @RenderRuntimeRunOptions()
                </select>
            </Stack>
            <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap justify-end">
                <Button Icon="chevron_left"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        title="Previous event page"
                        aria-label="Previous event page"
                        Disabled="@(runtimeEventPage == 0 || isLoading)"
                        Click="PreviousRuntimeEventPageAsync"
                        data-testid="live-processes-events-prev" />
                <StatusBadge Tone="neutral" Text="@($"Page {runtimeEventPage + 1}")" />
                <Button Icon="chevron_right"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        title="Next event page"
                        aria-label="Next event page"
                        Disabled="@(!shell!.Runtime.HasMoreEvents || isLoading)"
                        Click="NextRuntimeEventPageAsync"
                        data-testid="live-processes-events-next" />
            </Cluster>
        </Grid>
    </SurfaceCard>;

    private RenderFragment RenderAttentionPanel() => @<section class="live-processes-attention-panel"
                                                               data-testid="live-processes-attention-panel">
        @if (AttentionRuns.Count > 0)
        {
            <Split Gap="LayoutGap.Small">
                <Stack GapScale="LayoutGap.Tiny">
                    <TextBlock TextStyle="TextStyle.Eyebrow" Value="Needs attention" />
                    <h2 class="text-base font-semibold text-slate-900">@FormatCount(AttentionRuns.Count, "run needs operator action", "runs need operator action")</h2>
                </Stack>
                <StatusBadge Tone="warning" Text="@FormatHistoryWindow(shell!.Runtime.HistoryWindow)" />
            </Split>
            <div class="live-processes-attention-grid">
                @foreach (var run in AttentionRuns)
                {
                    <article class="live-processes-attention-card" data-testid="live-processes-attention-card">
                        <div class="live-processes-attention-card__body">
                            <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                                <StatusBadge Tone="@ResolveRunStatusTone(run.Status)" Text="@run.Status.ToString()" />
                                @if (run.Incidents.Count > 0)
                                {
                                    <StatusBadge Tone="warning" Text="@FormatCount(run.Incidents.Count, "incident", "incidents")" />
                                }
                                @if (ResolveManagerMessages(run.RunId).Count > 0)
                                {
                                    <StatusBadge Tone="info" Text="@FormatCount(ResolveManagerMessages(run.RunId).Count, "manager message", "manager messages")" />
                                }
                            </Cluster>
                            <h3 class="live-processes-attention-card__title">@BuildRunTitle(run)</h3>
                            <p class="live-processes-attention-card__summary">@BuildAttentionSummary(run)</p>
                            @if (ResolvePrimaryOperatorAction(run) is { } cardAction)
                            {
                                <div class="live-processes-attention-card__decision"
                                     data-testid="live-processes-attention-decision">
                                    <p>@cardAction.RequiredOperatorDecision</p>
                                    <TextArea Value="@GetOperatorActionNote(cardAction)"
                                              Change="@((string? value) => SetOperatorActionNote(cardAction, value))"
                                              Rows="3"
                                              Placeholder="Optional note for the manager or next agent"
                                              class="live-processes-operator-action-row__note"
                                              data-testid="live-processes-operator-note" />
                                </div>
                            }
                        </div>
                        <Cluster Gap="LayoutGap.XSmall" Class="live-processes-attention-card__actions">
                            @if (ResolvePrimaryOperatorAction(run) is { } action)
                            {
                                <Button Icon="replay"
                                        Text="@action.Label"
                                        ButtonStyle="ButtonStyle.Primary"
                                        Size="ButtonSize.Small"
                                        Disabled="@IsOperatorActionBusy(action)"
                                        IsBusy="@IsOperatorActionBusy(action)"
                                        Click="@(() => ExecuteOperatorActionAsync(action))"
                                        data-testid="live-processes-request-rework" />
                            }
                            <Button Icon="info"
                                    Text="Details"
                                    ButtonStyle="ButtonStyle.Light"
                                    Size="ButtonSize.Small"
                                    Click="@(() => OpenRunDetailDialogAsync(run))"
                                    data-testid="live-processes-attention-open-details" />
                            <Button Icon="forum"
                                    ButtonStyle="ButtonStyle.Light"
                                    Size="ButtonSize.Small"
                                    title="Open process control"
                                    aria-label="Open process control"
                                    Click="@(() => OpenProcessControlAsync(run.RunId.Value))" />
                        </Cluster>
                    </article>
                }
            </div>
        }
    </section>;

    private RenderFragment RenderRuntimeRunOptions() => @<text>
        @if (SelectableRuns.Count == 0)
        {
            <option value="">No runtime runs</option>
        }
        else
        {
            <option value="">All runs</option>
            @foreach (var run in SelectableRuns)
            {
                <option value="@run.RunId.Value.ToString("D")">@BuildRunOptionText(run)</option>
            }
        }
    </text>;

    private RenderFragment RenderActivityCards() => @<section class="live-processes-activity-strip"
                                                              data-testid="live-processes-activity-cards">
        <Split Gap="LayoutGap.Small">
            <Stack GapScale="LayoutGap.Tiny">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Current window" />
                <h2 class="text-base font-semibold text-slate-900">@shell!.Runtime.Summary</h2>
            </Stack>
            <StatusBadge Tone="info" Text="@FormatHistoryWindow(shell!.Runtime.HistoryWindow)" />
        </Split>
        @if (ActivityCardRuns.Count == 0)
        {
            <EmptyState Eyebrow="Live processes"
                        Title="No active or attention cards"
                        Description="No active, blocked, failed, or incident-bearing runs match this window." />
        }
        else
        {
            <div class="live-processes-activity-grid">
                @foreach (var run in ActivityCardRuns)
                {
                    @RenderActivityCard(run)
                }
            </div>
        }
    </section>;

    private RenderFragment RenderActivityCard(ProcessLiveProcessSnapshot run) => @<article class="@ResolveActivityCardClass(run)"
                                                                                          data-testid="live-processes-activity-card">
        <div class="live-processes-activity-card__body">
            <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                <StatusBadge Tone="@ResolveRunStatusTone(run.Status)" Text="@run.Status.ToString()" />
                @if (run.Incidents.Count > 0)
                {
                    <StatusBadge Tone="warning" Text="@FormatCount(run.Incidents.Count, "incident", "incidents")" />
                }
                @if (CountWorkingAgents(ResolveActiveAgents(run.RunId.Value)) > 0)
                {
                    <StatusBadge Tone="info" Text="@FormatCount(CountWorkingAgents(ResolveActiveAgents(run.RunId.Value)), "agent", "agents")" />
                }
                @if (CountStaleAgentClaims(ResolveActiveAgents(run.RunId.Value)) > 0)
                {
                    <StatusBadge Tone="warning" Text="@FormatCount(CountStaleAgentClaims(ResolveActiveAgents(run.RunId.Value)), "stale claim", "stale claims")" />
                }
            </Cluster>
            <h3 class="live-processes-activity-card__title">@BuildRunTitle(run)</h3>
            <p class="live-processes-activity-card__summary">@BuildRunCardSummary(run)</p>
            <p class="live-processes-activity-card__time">@run.LastEventAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)</p>
        </div>
        <Cluster Gap="LayoutGap.XSmall" Class="live-processes-activity-card__actions">
            @if (ResolvePrimaryOperatorAction(run) is { } action)
            {
                <Button Icon="replay"
                        ButtonStyle="ButtonStyle.Primary"
                        Size="ButtonSize.Small"
                        title="@action.Label"
                        aria-label="@action.Label"
                        Disabled="@IsOperatorActionBusy(action)"
                        IsBusy="@IsOperatorActionBusy(action)"
                        Click="@(() => ExecuteOperatorActionAsync(action))"
                        data-testid="live-processes-activity-request-rework" />
            }
            <Button Icon="open_in_new"
                    ButtonStyle="ButtonStyle.Light"
                    Size="ButtonSize.Small"
                    title="Open run details"
                    aria-label="Open run details"
                    Click="@(() => OpenRunDetailDialogAsync(run))" />
            <Button Icon="forum"
                    ButtonStyle="ButtonStyle.Light"
                    Size="ButtonSize.Small"
                    title="Open process control"
                    aria-label="Open process control"
                    Click="@(() => OpenProcessControlAsync(run.RunId.Value))" />
        </Cluster>
    </article>;

    private RenderFragment RenderRunCards() => @<Stack GapScale="LayoutGap.Small"
                                                       data-testid="live-processes-run-cards">
        @if (VisibleRuns.Count == 0)
        {
            <EmptyState Eyebrow="Live processes"
                        Title="No process cards match the filters"
                        Description="Widen the history window or clear the status filter." />
        }
        else
        {
            @foreach (var run in VisibleRuns)
            {
                <article class="live-processes-run-card @(run.RunId.Value == selectedRuntimeRunId ? "live-processes-run-card--selected" : string.Empty)"
                         data-testid="live-processes-run-card">
                    <button type="button"
                            class="live-processes-run-card__body"
                            @onclick="@(() => SelectRuntimeRunAsync(run.RunId.Value))">
                        <span class="live-processes-run-card__header">
                            <span class="live-processes-run-card__title">@BuildRunTitle(run)</span>
                            <StatusBadge Tone="@ResolveRunStatusTone(run.Status)" Text="@run.Status.ToString()" />
                        </span>
                        <span class="live-processes-run-card__summary">@BuildRunCardSummary(run)</span>
                        <span class="live-processes-run-card__badges">
                            <StatusBadge Tone="neutral" Text="@($"{run.RecentEvents.Count} recent")" />
                            <StatusBadge Tone="warning" Text="@($"{run.Incidents.Count} incident(s)")" />
                            @if (run.OperatorActions.Count > 0)
                            {
                                <StatusBadge Tone="warning" Text="@FormatCount(run.OperatorActions.Count, "action", "actions")" />
                            }
                            <StatusBadge Tone="info" Text="@run.LastEventAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)" />
                        </span>
                    </button>
                    <Button Icon="open_in_new"
                            ButtonStyle="ButtonStyle.Light"
                            Size="ButtonSize.Small"
                            Class="cda-button--quick live-processes-run-card__open"
                            title="Open run details"
                            aria-label="Open run details"
                            Click="@(() => OpenRunDetailDialogAsync(run))"
                            data-testid="live-processes-run-open-details" />
                </article>
            }
        }
    </Stack>;

    private RenderFragment RenderActiveAgentGrid(
        IReadOnlyList<ProcessRuntimeActiveAgentProjection> agents,
        string testId) => @<section class="live-processes-agent-section"
                                    data-testid="@testId">
        @if (agents.Count == 0)
        {
            <EmptyState Eyebrow="Active agents"
                        Title="No agents are currently claimed"
                        Description="A claimed or running process step will appear here with its run, role, and lease." />
        }
        else
        {
            <div class="live-processes-agent-grid">
                @foreach (var agent in agents)
                {
                    @RenderActiveAgentCard(agent)
                }
            </div>
        }
    </section>;

    private RenderFragment RenderActiveAgentCard(ProcessRuntimeActiveAgentProjection agent) => @<article class="live-processes-agent-card"
                                                                                                         data-testid="live-processes-active-agent-card">
        <div class="live-processes-agent-card__header">
            <div class="live-processes-agent-card__avatar-row">
                <Avatar Alt="@ResolveAgentDisplayName(agent)"
                        FallbackText="@ResolveAgentInitials(agent)"
                        DefaultImageSeed="@ResolveAgentAvatarSeed(agent)"
                        Size="AvatarSize.Large"
                        Shape="AvatarShape.Rounded" />
                <div class="live-processes-agent-card__identity">
                    <span class="live-processes-agent-card__name">@ResolveAgentDisplayName(agent)</span>
                    <span class="live-processes-agent-card__role">@agent.RoleKey</span>
                </div>
            </div>
            <StatusBadge Tone="@ResolveAgentStatusTone(agent)" Text="@ResolveAgentStatusText(agent)" />
        </div>
        <p class="live-processes-agent-card__summary">@ResolveAgentCardSummary(agent)</p>
        <Cluster Gap="LayoutGap.XSmall" Class="live-processes-agent-card__badges flex-wrap">
            <StatusBadge Tone="neutral" Text="@agent.RunLabel" />
            <StatusBadge Tone="info" Text="@agent.StepKey" />
            <StatusBadge Tone="@ResolveObservationTone(agent)" Text="@ResolveObservationLabel(agent)" />
            @if (agent.ExecutionRunId.HasValue)
            {
                <StatusBadge Tone="neutral" Text="@($"run {agent.ExecutionRunId.Value.ToString("N")[..8]}")" />
            }
            @if (agent.ClaimedAtUtc.HasValue)
            {
                <StatusBadge Tone="neutral" Text="@($"claimed {agent.ClaimedAtUtc.Value.LocalDateTime:g}")" />
            }
            @if (agent.LeaseExpiresAtUtc.HasValue)
            {
                <StatusBadge Tone="warning" Text="@($"lease {agent.LeaseExpiresAtUtc.Value.LocalDateTime:g}")" />
            }
        </Cluster>
        <Cluster Gap="LayoutGap.XSmall" Class="live-processes-agent-card__actions">
            <Button Icon="info"
                    Text="Details"
                    ButtonStyle="ButtonStyle.Light"
                    Size="ButtonSize.Small"
                    title="Open active agent details"
                    aria-label="Open active agent details"
                    Click="@(() => OpenAgentDetailDialogAsync(agent))"
                    data-testid="live-processes-agent-open-details" />
            <Button Icon="open_in_new"
                    ButtonStyle="ButtonStyle.Light"
                    Size="ButtonSize.Small"
                    Class="live-processes-agent-card__open"
                    title="Open process control"
                    aria-label="Open process control"
                    Click="@(() => OpenProcessControlAsync(agent.RunId))" />
        </Cluster>
    </article>;

    private RenderFragment RenderEventLedger() => @<SurfaceCard Soft="true"
                                                                data-testid="live-processes-event-ledger">
        <Split Gap="LayoutGap.Small">
            <Stack GapScale="LayoutGap.Tiny">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="History" />
                <h2 class="text-base font-semibold text-slate-900">@($"{shell!.Runtime.Events.Count} event(s)")</h2>
            </Stack>
            <StatusBadge Tone="neutral" Text="@FormatHistoryWindow(shell!.Runtime.HistoryWindow)" />
        </Split>
        @if (shell!.Runtime.Events.Count == 0)
        {
            <p class="mt-3 text-sm leading-6 text-slate-500">No runtime events match the selected history filters.</p>
        }
        else
        {
            <Stack GapScale="LayoutGap.Small" Class="mt-4">
                @foreach (var runtimeEvent in shell.Runtime.Events)
                {
                    <div class="live-processes-event-row" data-testid="live-processes-event-row">
                        <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                            <StatusBadge Tone="@ResolveEventTone(runtimeEvent)" Text="@runtimeEvent.EventType" />
                            <StatusBadge Tone="neutral" Text="@runtimeEvent.Sensitivity.ToString()" />
                            <span class="text-xs text-slate-500">@runtimeEvent.OccurredAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)</span>
                        </Cluster>
                        <p class="mt-2 text-sm leading-6 text-slate-700">@runtimeEvent.Summary</p>
                    </div>
                }
            </Stack>
        }
    </SurfaceCard>;

    private RenderFragment RenderToolUsageLedger() => @<SurfaceCard Soft="true"
                                                                    data-testid="live-processes-tool-ledger">
        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Tool usage" />
        @if (shell!.Runtime.ToolUsage.Count == 0)
        {
            <p class="mt-3 text-sm leading-6 text-slate-500">No runtime tool usage is present in this history window.</p>
        }
        else
        {
            <Stack GapScale="LayoutGap.Small" Class="mt-4">
                @foreach (var tool in shell.Runtime.ToolUsage)
                {
                    <div class="live-processes-event-row" data-testid="live-processes-tool-row">
                        <Split Gap="LayoutGap.Small">
                            <div>
                                <p class="text-sm font-semibold text-slate-900">@tool.ToolName</p>
                                <p class="mt-1 text-xs text-slate-500">@tool.Summary</p>
                            </div>
                            <StatusBadge Tone="warning" Text="@($"{tool.CallCount} calls")" />
                        </Split>
                    </div>
                }
            </Stack>
        }
    </SurfaceCard>;

    private RenderFragment RenderRunDetailDialog(ProcessLiveProcessSnapshot run) => @<Stack GapScale="LayoutGap.Medium"
                                                                                           data-testid="live-processes-run-detail-dialog-content">
        <CompactStatStrip>
            <CompactStat Tone="@ResolveRunStatusTone(run.Status)" Text="@run.Status.ToString()" TooltipText="Projected run status." />
            <CompactStat Tone="neutral" Text="@($"{run.RecentEvents.Count} recent")" TooltipText="Recent events kept in the live run snapshot." />
            <CompactStat Tone="warning" Text="@($"{run.Incidents.Count} incident(s)")" TooltipText="Manager incidents projected for this run." />
            <CompactStat Tone="info" Text="@FormatCount(CountWorkingAgents(ResolveActiveAgents(run.RunId.Value)), "agent", "agents")" TooltipText="Agents currently claimed or running on this run with a valid lease." />
            @if (CountStaleAgentClaims(ResolveActiveAgents(run.RunId.Value)) > 0)
            {
                <CompactStat Tone="warning" Text="@FormatCount(CountStaleAgentClaims(ResolveActiveAgents(run.RunId.Value)), "stale claim", "stale claims")" TooltipText="Claimed or running steps whose dispatch lease has expired." />
            }
            <CompactStat Tone="info" Text="@run.LastEventAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)" TooltipText="Latest runtime event time." />
        </CompactStatStrip>
        @RenderOperatorActions(run)
        @RenderActiveAgentGrid(ResolveActiveAgents(run.RunId.Value), "live-processes-run-detail-active-agents")
        <Grid Gap="LayoutGap.Medium" ColumnTemplateXl="repeat(3,minmax(0,1fr))">
            <SurfaceCard Soft="true">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Recent events" />
                @foreach (var runtimeEvent in run.RecentEvents.OrderByDescending(item => item.OccurredAtUtc))
                {
                    <div class="live-processes-event-row">
                        <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                            <StatusBadge Tone="@ResolveRunStatusTone(run.Status)" Text="@runtimeEvent.EventType" />
                            <span class="text-xs text-slate-500">@runtimeEvent.OccurredAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)</span>
                        </Cluster>
                        <p class="mt-2 text-sm leading-6 text-slate-600">@runtimeEvent.Summary</p>
                    </div>
                }
            </SurfaceCard>
            <SurfaceCard Soft="true">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Incidents" />
                @if (run.Incidents.Count == 0)
                {
                    <p class="mt-3 text-sm leading-6 text-slate-500">No incidents are attached to this run.</p>
                }
                else
                {
                    @foreach (var incident in run.Incidents.OrderByDescending(item => item.RaisedAtUtc))
                    {
                        <div class="live-processes-event-row">
                            <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                                <StatusBadge Tone="warning" Text="@incident.Severity" />
                                <StatusBadge Tone="neutral" Text="@incident.Status" />
                            </Cluster>
                            <p class="mt-2 text-sm font-semibold text-slate-900">@incident.Classification</p>
                            <p class="mt-1 text-sm leading-6 text-slate-600">@incident.SafeSummary</p>
                            <p class="mt-1 text-xs text-slate-500">@incident.DiagnosticReference</p>
                        </div>
                    }
                }
            </SurfaceCard>
            <SurfaceCard Soft="true">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Manager messages" />
                @if (ResolveManagerMessages(run.RunId).Count == 0)
                {
                    <p class="mt-3 text-sm leading-6 text-slate-500">No manager messages are attached to this run.</p>
                }
                else
                {
                    @foreach (var message in ResolveManagerMessages(run.RunId))
                    {
                        <div class="live-processes-event-row">
                            <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                                <StatusBadge Tone="@ResolveManagerMessageTone(message)" Text="@message.Kind" />
                                <span class="text-xs text-slate-500">@message.CreatedAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)</span>
                            </Cluster>
                            <p class="mt-2 text-sm leading-6 text-slate-600">@message.Summary</p>
                            @if (!string.IsNullOrWhiteSpace(message.RestrictedDiagnosticReference))
                            {
                                <p class="mt-1 text-xs text-slate-500">@message.RestrictedDiagnosticReference</p>
                            }
                        </div>
                    }
                }
            </SurfaceCard>
        </Grid>
    </Stack>;

    private RenderFragment RenderOperatorActions(ProcessLiveProcessSnapshot run) => @<SurfaceCard Soft="true"
                                                                                                   data-testid="live-processes-operator-actions">
        <Split Gap="LayoutGap.Small">
            <Stack GapScale="LayoutGap.Tiny">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Operator actions" />
                <h2 class="text-base font-semibold text-slate-900">@FormatCount(run.OperatorActions.Count, "available action", "available actions")</h2>
            </Stack>
            <StatusBadge Tone="@(run.OperatorActions.Count > 0 ? "warning" : "success")"
                         Text="@(run.OperatorActions.Count > 0 ? "Actionable" : "No action needed")" />
        </Split>
        @if (run.OperatorActions.Count == 0)
        {
            <p class="mt-3 text-sm leading-6 text-slate-500">No blocked or failed executable step is waiting for operator rework.</p>
        }
        else
        {
            <div class="live-processes-operator-action-grid">
                @foreach (var action in run.OperatorActions)
                {
                    <article class="live-processes-operator-action-row"
                             data-testid="live-processes-operator-action-row">
                        <div class="live-processes-operator-action-row__body">
                            <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                                <StatusBadge Tone="warning" Text="@action.StepStatus" />
                                <StatusBadge Tone="info" Text="@action.RoleDisplayName" />
                                <StatusBadge Tone="neutral" Text="@action.ExecutorDisplayName" />
                            </Cluster>
                            <p class="live-processes-operator-action-row__title">@action.StepKey</p>
                            <p class="live-processes-operator-action-row__summary">@action.Summary</p>
                            @if (!string.IsNullOrWhiteSpace(action.ProblemSummary))
                            {
                                <p class="live-processes-operator-action-row__problem">@action.ProblemSummary</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(action.RequiredOperatorDecision))
                            {
                                <p class="live-processes-operator-action-row__decision">@action.RequiredOperatorDecision</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(action.RecommendedInstruction))
                            {
                                <p class="live-processes-operator-action-row__instruction">@action.RecommendedInstruction</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(action.DisabledReason))
                            {
                                <p class="live-processes-operator-action-row__disabled">@action.DisabledReason</p>
                            }
                            <TextArea Value="@GetOperatorActionNote(action)"
                                      Change="@((string? value) => SetOperatorActionNote(action, value))"
                                      Rows="3"
                                      Placeholder="Optional note for the manager or next agent"
                                      class="live-processes-operator-action-row__note"
                                      data-testid="live-processes-dialog-operator-note" />
                        </div>
                        <Button Icon="replay"
                                Text="@action.Label"
                                ButtonStyle="ButtonStyle.Primary"
                                Size="ButtonSize.Small"
                                Disabled="@(!action.IsEnabled || IsOperatorActionBusy(action))"
                                IsBusy="@IsOperatorActionBusy(action)"
                                Click="@(() => ExecuteOperatorActionAsync(action))"
                                data-testid="live-processes-dialog-request-rework" />
                    </article>
                }
            </div>
        }
    </SurfaceCard>;

    private RenderFragment RenderAgentDetailDialog(ProcessRuntimeActiveAgentProjection agent) => @<Stack GapScale="LayoutGap.Medium"
                                                                                                       data-testid="live-processes-agent-detail-dialog-content">
        <Grid Gap="LayoutGap.Medium" ColumnTemplateLg="auto minmax(0,1fr)">
            <Avatar Alt="@ResolveAgentDisplayName(agent)"
                    FallbackText="@ResolveAgentInitials(agent)"
                    DefaultImageSeed="@ResolveAgentAvatarSeed(agent)"
                    Size="AvatarSize.Large"
                    Shape="AvatarShape.Rounded" />
            <Stack GapScale="LayoutGap.Small">
                <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                    <StatusBadge Tone="@ResolveAgentStatusTone(agent)" Text="@ResolveAgentStatusText(agent)" />
                    <StatusBadge Tone="@ResolveObservationTone(agent)" Text="@ResolveObservationLabel(agent)" />
                    <StatusBadge Tone="neutral" Text="@agent.RoleKey" />
                    <StatusBadge Tone="info" Text="@agent.StepKey" />
                </Cluster>
                <p class="live-processes-agent-detail__activity">@ResolveAgentCurrentActivity(agent)</p>
                @if (!string.IsNullOrWhiteSpace(agent.LastError))
                {
                    <p class="live-processes-agent-detail__error">@agent.LastError</p>
                }
            </Stack>
        </Grid>
        <CompactStatStrip>
            <CompactStat Tone="neutral" Text="@agent.RunId.ToString("D")" TooltipText="Process run id." />
            <CompactStat Tone="neutral" Text="@agent.StepInstanceId.ToString("D")" TooltipText="Process step instance id." />
            @if (agent.ExecutionRunId.HasValue)
            {
                <CompactStat Tone="info" Text="@agent.ExecutionRunId.Value.ToString("D")" TooltipText="AgentFramework execution run id." />
            }
            <CompactStat Tone="info" Text="@FormatAgentSignalAge(agent)" TooltipText="Time since the latest execution or claim signal." />
        </CompactStatStrip>
        <Grid Gap="LayoutGap.Medium" ColumnTemplateXl="repeat(3,minmax(0,1fr))">
            <SurfaceCard Soft="true">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Execution" />
                <p class="live-processes-agent-detail__row">@agent.ObservationSource</p>
                @if (!string.IsNullOrWhiteSpace(agent.ProviderName) || !string.IsNullOrWhiteSpace(agent.Model))
                {
                    <p class="live-processes-agent-detail__row">@FirstNonEmpty(agent.ProviderName, "Provider unavailable") / @FirstNonEmpty(agent.Model, "model unavailable")</p>
                }
                @if (!string.IsNullOrWhiteSpace(agent.ExecutionOutcome))
                {
                    <p class="live-processes-agent-detail__row">Outcome: @agent.ExecutionOutcome</p>
                }
            </SurfaceCard>
            <SurfaceCard Soft="true">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Recent activity" />
                @if (agent.RecentActivities.Count == 0)
                {
                    <p class="live-processes-agent-detail__row">No execution log entries are available.</p>
                }
                else
                {
                    @foreach (var activity in agent.RecentActivities.OrderByDescending(item => item.CreatedAtUtc))
                    {
                        <div class="live-processes-event-row">
                            <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                                <StatusBadge Tone="info" Text="@activity.Phase" />
                                <span class="text-xs text-slate-500">@activity.CreatedAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)</span>
                            </Cluster>
                            <p class="mt-2 text-sm leading-6 text-slate-600">@activity.Message</p>
                        </div>
                    }
                }
            </SurfaceCard>
            <SurfaceCard Soft="true">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Tools and artifacts" />
                @if (agent.RecentTools.Count == 0 && agent.Artifacts.Count == 0)
                {
                    <p class="live-processes-agent-detail__row">No tool receipts or artifacts are available.</p>
                }
                else
                {
                    @foreach (var tool in agent.RecentTools.OrderByDescending(item => item.CompletedAtUtc))
                    {
                        <div class="live-processes-event-row">
                            <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                                <StatusBadge Tone="warning" Text="@tool.ToolName" />
                                <span class="text-xs text-slate-500">@tool.CompletedAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)</span>
                            </Cluster>
                            <p class="mt-2 text-sm leading-6 text-slate-600">@FirstNonEmpty(tool.ExitSummary, tool.RequestSummary)</p>
                        </div>
                    }
                    @foreach (var artifact in agent.Artifacts.OrderByDescending(item => item.CreatedAtUtc))
                    {
                        <div class="live-processes-event-row">
                            <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                                <StatusBadge Tone="info" Text="@artifact.ArtifactKind" />
                                <span class="text-xs text-slate-500">@artifact.CreatedAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)</span>
                            </Cluster>
                            <p class="mt-2 text-sm font-semibold text-slate-900">@artifact.DisplayName</p>
                            <p class="mt-1 text-xs text-slate-500">@artifact.RelativePath</p>
                        </div>
                    }
                }
            </SurfaceCard>
        </Grid>
    </Stack>;

    private string RuntimeRunSelectValue
        => selectedRuntimeRunId.HasValue && SelectableRuns.Any(run => run.RunId.Value == selectedRuntimeRunId.Value)
            ? selectedRuntimeRunId.Value.ToString("D")
            : string.Empty;

    private string StatusFilterValue => statusFilter?.ToString() ?? string.Empty;

    private async Task ChangeRuntimeHistoryWindowAsync(ChangeEventArgs args)
    {
        if (Enum.TryParse<ProcessRuntimeHistoryWindow>(args.Value?.ToString(), out var parsed))
        {
            runtimeHistoryWindow = parsed;
            runtimeEventPage = 0;
            await LoadAsync(forceRefresh: false);
        }
    }

    private async Task ChangeStatusFilterAsync(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        statusFilter = Enum.TryParse<ProcessProjectedRunStatus>(value, out var parsed)
            ? parsed
            : null;
        runtimeEventPage = 0;
        selectedRuntimeRunId = ResolveRunIdForCurrentStatusFilter(shell?.Runtime.Runs ?? [], selectedRuntimeRunId);
        await LoadAsync(forceRefresh: false);
    }

    private async Task SelectRuntimeRunAsync(ChangeEventArgs args)
    {
        selectedRuntimeRunId = Guid.TryParse(args.Value?.ToString(), out var parsed) && parsed != Guid.Empty
            ? parsed
            : null;
        runtimeEventPage = 0;
        await LoadAsync(forceRefresh: false);
    }

    private async Task SelectRuntimeRunAsync(Guid runId)
    {
        selectedRuntimeRunId = runId == Guid.Empty ? null : runId;
        runtimeEventPage = 0;
        await LoadAsync(forceRefresh: false);
    }

    private Guid? ResolveRunIdForCurrentStatusFilter(IReadOnlyList<ProcessLiveProcessSnapshot> runs, Guid? requestedRunId)
    {
        if (statusFilter is null)
        {
            return requestedRunId;
        }

        if (requestedRunId.HasValue && runs.Any(run => run.RunId.Value == requestedRunId.Value && run.Status == statusFilter))
        {
            return requestedRunId;
        }

        return runs
            .Where(run => run.Status == statusFilter)
            .OrderByDescending(run => run.LastEventAtUtc)
            .Select(run => (Guid?)run.RunId.Value)
            .FirstOrDefault();
    }

    private async Task PreviousRuntimeEventPageAsync()
    {
        if (runtimeEventPage == 0)
        {
            return;
        }

        runtimeEventPage--;
        await LoadAsync(forceRefresh: false);
    }

    private async Task NextRuntimeEventPageAsync()
    {
        if (shell?.Runtime.HasMoreEvents != true)
        {
            return;
        }

        runtimeEventPage++;
        await LoadAsync(forceRefresh: false);
    }

    private Task OpenRunDetailDialogAsync(ProcessLiveProcessSnapshot run)
    {
        runDetailSnapshot = run;
        runDetailDialogOpen = true;
        return Task.CompletedTask;
    }

    private Task CloseRunDetailDialogAsync()
    {
        runDetailDialogOpen = false;
        runDetailSnapshot = null;
        return Task.CompletedTask;
    }

    private Task OpenAgentDetailDialogAsync(ProcessRuntimeActiveAgentProjection agent)
    {
        agentDetailAgent = agent;
        agentDetailDialogOpen = true;
        return Task.CompletedTask;
    }

    private Task CloseAgentDetailDialogAsync()
    {
        agentDetailDialogOpen = false;
        agentDetailAgent = null;
        return Task.CompletedTask;
    }

    private Task OpenProcessControlAsync(Guid runId)
    {
        var route = ProjectId.HasValue
            ? $"/projects/{ProjectId.Value:D}/processes?runId={runId:D}"
            : $"/processes?runId={runId:D}";
        Navigation.NavigateTo(route);
        return Task.CompletedTask;
    }

    private async Task ExecuteOperatorActionAsync(ProcessRuntimeOperatorActionProjection action)
    {
        if (!action.IsEnabled || busyOperatorActionStepId.HasValue)
        {
            return;
        }

        busyOperatorActionStepId = action.StepInstanceId;
        operatorActionMessage = null;
        operatorActionError = null;

        try
        {
            var result = await ProjectionClient.ExecuteRuntimeOperatorActionAsync(new ProcessRuntimeOperatorActionCommand(
                new ProcessRunId(action.RunId),
                new ProcessStepInstanceId(action.StepInstanceId),
                action.Kind,
                "live-processes",
                BuildOperatorActionReason(action)));
            if (!result.Succeeded)
            {
                operatorActionError = result.Diagnostics.Count == 0
                    ? $"{action.Label} was rejected by the runtime."
                    : string.Join(" ", result.Diagnostics);
                return;
            }

            operatorActionMessage = $"{action.Label} accepted for {action.StepKey}. Dispatch has been queued.";
            operatorActionNotes.Remove(action.StepInstanceId);
            selectedRuntimeRunId = action.RunId;
            runtimeEventPage = 0;
            await LoadAsync(forceRefresh: true);
            if (runDetailDialogOpen)
            {
                runDetailSnapshot = shell?.Runtime.Runs.FirstOrDefault(run => run.RunId.Value == action.RunId);
            }
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            operatorActionError = exception.Message;
        }
        finally
        {
            busyOperatorActionStepId = null;
        }
    }

    private IReadOnlyList<ProcessRuntimeActiveAgentProjection> ResolveActiveAgents(Guid runId)
        => shell?.Runtime.ActiveAgents
            .Where(agent => agent.RunId == runId)
            .OrderByDescending(agent => agent.IsWorking)
            .ThenByDescending(agent => string.Equals(agent.Status, "Running", StringComparison.Ordinal))
            .ThenBy(agent => agent.ExecutorDisplayName, StringComparer.OrdinalIgnoreCase)
            .ToArray() ?? [];

    private IReadOnlyList<ProcessManagerMessageProjection> ResolveManagerMessages(ProcessRunId runId)
        => shell?.Runtime.ManagerMessages
            .Where(message => message.RunId == runId)
            .OrderByDescending(message => message.CreatedAtUtc)
            .ToArray() ?? [];

    private static ProcessRuntimeOperatorActionProjection? ResolvePrimaryOperatorAction(ProcessLiveProcessSnapshot run)
        => run.OperatorActions
            .Where(action => action.IsEnabled)
            .OrderByDescending(action => string.Equals(action.StepStatus, nameof(ProcessRuntimeStepStatus.Failed), StringComparison.Ordinal))
            .ThenByDescending(action => string.Equals(action.StepStatus, nameof(ProcessRuntimeStepStatus.Blocked), StringComparison.Ordinal))
            .ThenBy(action => action.StepKey, StringComparer.OrdinalIgnoreCase)
            .FirstOrDefault();

    private bool IsOperatorActionBusy(ProcessRuntimeOperatorActionProjection action)
        => busyOperatorActionStepId == action.StepInstanceId;

    private string GetOperatorActionNote(ProcessRuntimeOperatorActionProjection action)
        => operatorActionNotes.GetValueOrDefault(action.StepInstanceId, string.Empty);

    private void SetOperatorActionNote(ProcessRuntimeOperatorActionProjection action, string? value)
    {
        var normalized = value?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(normalized))
        {
            operatorActionNotes.Remove(action.StepInstanceId);
            return;
        }

        operatorActionNotes[action.StepInstanceId] = normalized;
    }

    private string BuildOperatorActionReason(ProcessRuntimeOperatorActionProjection action)
    {
        var instruction = FirstNonEmpty(
            action.RecommendedInstruction,
            $"LiveProcesses requested {action.Kind} for step '{action.StepKey}'.");
        var note = GetOperatorActionNote(action);
        return string.IsNullOrWhiteSpace(note)
            ? instruction
            : $"{instruction}{Environment.NewLine}{Environment.NewLine}Operator note:{Environment.NewLine}{note}";
    }

    private static string BuildRunTitle(ProcessLiveProcessSnapshot run)
        => $"Run {run.RunId.Value.ToString("N")[..8]}";

    private static string BuildRunSubtitle(ProcessLiveProcessSnapshot run)
        => $"{run.Status} / {run.LastEventAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)}";

    private static string BuildRunOptionText(ProcessLiveProcessSnapshot run)
        => $"{BuildRunTitle(run)} / {run.Status} / {run.LastEventAtUtc.LocalDateTime:g}";

    private string BuildRunCardSummary(ProcessLiveProcessSnapshot run)
    {
        var action = ResolvePrimaryOperatorAction(run);
        if (action is not null)
        {
            return FirstNonEmpty(
                action.ProblemSummary,
                $"Cause: {action.StepKey} is {action.StepStatus}. Next action: {action.Label.ToLowerInvariant()} for {action.RoleDisplayName}.");
        }

        var incident = run.Incidents.OrderByDescending(item => item.RaisedAtUtc).FirstOrDefault();
        if (incident is not null)
        {
            return $"Cause: {EnsureSentence(incident.SafeSummary)}";
        }

        var activeAgents = ResolveActiveAgents(run.RunId.Value);
        var workingAgent = activeAgents.FirstOrDefault(agent => agent.IsWorking && !agent.IsLeaseExpired);
        if (run.Status == ProcessProjectedRunStatus.Active && workingAgent is not null)
        {
            return $"Active: {EnsureSentence(ResolveAgentCardSummary(workingAgent))}";
        }

        var staleAgent = activeAgents.FirstOrDefault(agent => agent.IsLeaseExpired);
        if (staleAgent is not null)
        {
            return $"Attention: {ResolveAgentDisplayName(staleAgent)} has an expired lease on {staleAgent.StepKey}.";
        }

        var runtimeEvent = ResolveRunCardEvent(run.RecentEvents);
        return runtimeEvent is null
            ? "No recent runtime events are attached to this run."
            : $"{runtimeEvent.EventType}: {runtimeEvent.Summary}";
    }

    private string BuildAttentionSummary(ProcessLiveProcessSnapshot run)
    {
        var action = ResolvePrimaryOperatorAction(run);
        if (action is not null)
        {
            return $"{FirstNonEmpty(action.ProblemSummary, action.Summary)} {FirstNonEmpty(action.RequiredOperatorDecision, $"Next action: {action.Label} for {action.StepKey}.")}";
        }

        var managerMessage = ResolveManagerMessages(run.RunId).FirstOrDefault();
        if (managerMessage is not null)
        {
            return $"{managerMessage.Kind}: {EnsureSentence(managerMessage.Summary)}";
        }

        return BuildRunCardSummary(run);
    }

    private bool RequiresOperatorAttention(ProcessLiveProcessSnapshot run)
        => run.OperatorActions.Any(action => action.IsEnabled) ||
           run.Status == ProcessProjectedRunStatus.Failed ||
           run.Incidents.Count > 0 ||
           ResolveManagerMessages(run.RunId).Any(message => IsAttentionEventType(message.Kind));

    private static string ResolveRunStatusTone(ProcessProjectedRunStatus status)
        => status switch
        {
            ProcessProjectedRunStatus.Active => "success",
            ProcessProjectedRunStatus.NeedsAttention => "warning",
            ProcessProjectedRunStatus.Failed => "danger",
            ProcessProjectedRunStatus.Completed => "info",
            ProcessProjectedRunStatus.Cancelled => "neutral",
            _ => "neutral"
        };

    private static string ResolveActivityCardClass(ProcessLiveProcessSnapshot run)
        => run.Status switch
        {
            ProcessProjectedRunStatus.NeedsAttention => "live-processes-activity-card live-processes-activity-card--attention",
            ProcessProjectedRunStatus.Failed => "live-processes-activity-card live-processes-activity-card--failed",
            ProcessProjectedRunStatus.Active => "live-processes-activity-card live-processes-activity-card--active",
            _ => "live-processes-activity-card"
        };

    private static int CountWorkingAgents(IReadOnlyList<ProcessRuntimeActiveAgentProjection> agents)
        => agents.Count(agent => agent.IsWorking);

    private static int CountStaleAgentClaims(IReadOnlyList<ProcessRuntimeActiveAgentProjection> agents)
        => agents.Count(agent => agent.IsLeaseExpired);

    private static string ResolveAgentStatusText(ProcessRuntimeActiveAgentProjection agent)
        => agent.IsLeaseExpired ? "Lease expired" : agent.Status;

    private static string ResolveAgentStatusTone(ProcessRuntimeActiveAgentProjection agent)
        => agent.IsLeaseExpired
            ? "warning"
            : agent.Status switch
        {
            "WaitingOnTool" => "warning",
            "Preparing" => "info",
            "Persisting" => "info",
            "Completed" => "success",
            nameof(ProcessRuntimeStepStatus.Running) => "success",
            nameof(ProcessRuntimeStepStatus.Claimed) => "info",
            nameof(ProcessRuntimeStepStatus.Waiting) => "info",
            nameof(ProcessRuntimeStepStatus.Blocked) => "warning",
            nameof(ProcessRuntimeStepStatus.Failed) => "danger",
            _ => "neutral"
        };

    private static string ResolveAgentDisplayName(ProcessRuntimeActiveAgentProjection agent)
        => FirstNonEmpty(agent.AgentName, agent.ExecutorDisplayName, agent.ExecutorId, "Unknown agent");

    private static string ResolveAgentAvatarSeed(ProcessRuntimeActiveAgentProjection agent)
        => agent.AgentId?.ToString("N") ?? FirstNonEmpty(agent.ExecutorId, agent.ExecutorDisplayName, agent.StepInstanceId.ToString("N"));

    private static string ResolveAgentInitials(ProcessRuntimeActiveAgentProjection agent)
        => BuildInitials(ResolveAgentDisplayName(agent));

    private static string ResolveObservationLabel(ProcessRuntimeActiveAgentProjection agent)
        => string.IsNullOrWhiteSpace(agent.ObservationSource)
            ? "Runtime"
            : agent.ObservationSource.Contains("AgentFramework", StringComparison.OrdinalIgnoreCase)
                ? "Execution"
                : "Runtime claim";

    private static string ResolveObservationTone(ProcessRuntimeActiveAgentProjection agent)
        => string.IsNullOrWhiteSpace(agent.ExecutionState) && agent.ObservationSource.Contains("without", StringComparison.OrdinalIgnoreCase)
            ? "warning"
            : "info";

    private static string ResolveAgentCardSummary(ProcessRuntimeActiveAgentProjection agent)
        => FirstNonEmpty(agent.CurrentActivity, agent.Summary);

    private static string ResolveAgentCurrentActivity(ProcessRuntimeActiveAgentProjection agent)
        => FirstNonEmpty(agent.CurrentActivity, agent.Summary, "No active execution activity is available.");

    private static string BuildAgentDetailSubtitle(ProcessRuntimeActiveAgentProjection agent)
        => $"{agent.RoleKey} / {agent.StepKey} / {ResolveAgentStatusText(agent)}";

    private static string FormatAgentSignalAge(ProcessRuntimeActiveAgentProjection agent)
    {
        var observedAtUtc = agent.ExecutionUpdatedAtUtc ?? agent.UpdatedAtUtc;
        var age = DateTimeOffset.UtcNow - observedAtUtc.ToUniversalTime();
        if (age < TimeSpan.FromMinutes(1))
        {
            return "just now";
        }

        return age.TotalHours >= 1
            ? $"{age.TotalHours:N1} h ago"
            : $"{age.TotalMinutes:N0} min ago";
    }

    private static string BuildInitials(string value)
    {
        var words = value
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(word => word.Length > 0)
            .Take(2)
            .ToArray();
        if (words.Length == 0)
        {
            return "A";
        }

        return string.Concat(words.Select(word => char.ToUpperInvariant(word[0])));
    }

    private static string FirstNonEmpty(params string?[] values)
        => values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim() ?? string.Empty;

    private static string ResolveManagerMessageTone(ProcessManagerMessageProjection message)
        => IsAttentionEventType(message.Kind) ? "warning" : "info";

    private static string ResolveEventTone(ProcessTimelineEventProjection runtimeEvent)
        => runtimeEvent.Sensitivity == ProcessProjectedSensitivity.Restricted
            ? "warning"
            : runtimeEvent.EventType.StartsWith("Manager", StringComparison.Ordinal)
                ? "info"
                : IsAttentionEventType(runtimeEvent.EventType)
                    ? "warning"
                    : "neutral";

    private static ProcessLiveRunEventProjection? ResolveRunCardEvent(IReadOnlyList<ProcessLiveRunEventProjection> events)
        => events
            .OrderByDescending(item => IsAttentionEventType(item.EventType))
            .ThenByDescending(item => item.OccurredAtUtc)
            .FirstOrDefault();

    private static bool IsAttentionEventType(string eventType)
        => eventType.Contains("Blocked", StringComparison.OrdinalIgnoreCase) ||
           eventType.Contains("Failed", StringComparison.OrdinalIgnoreCase) ||
           eventType.Contains("Denied", StringComparison.OrdinalIgnoreCase) ||
           eventType.Contains("Rejected", StringComparison.OrdinalIgnoreCase) ||
           eventType.Contains("Escalated", StringComparison.OrdinalIgnoreCase) ||
           eventType.Contains("Incident", StringComparison.OrdinalIgnoreCase);

    private static string FormatHistoryWindow(ProcessRuntimeHistoryWindow window)
        => window switch
        {
            ProcessRuntimeHistoryWindow.LiveHour => "Last hour",
            ProcessRuntimeHistoryWindow.OneDay => "Last 24 hours",
            ProcessRuntimeHistoryWindow.SevenDays => "Last 7 days",
            ProcessRuntimeHistoryWindow.ThirtyDays => "Last 30 days",
            _ => window.ToString()
        };

    private static string FormatDuration(long durationMs)
    {
        if (durationMs <= 0)
        {
            return "0 min";
        }

        var duration = TimeSpan.FromMilliseconds(durationMs);
        return duration.TotalHours >= 1
            ? $"{duration.TotalHours:N1} h"
            : $"{duration.TotalMinutes:N1} min";
    }

    private static string TrimLabel(string value, int maxLength)
    {
        if (value.Length <= maxLength)
        {
            return value;
        }

        return $"{value[..Math.Max(0, maxLength - 3)]}...";
    }

    private static string EnsureSentence(string value)
    {
        var trimmed = value.Trim();
        if (trimmed.Length == 0 ||
            trimmed.EndsWith(".", StringComparison.Ordinal) ||
            trimmed.EndsWith("!", StringComparison.Ordinal) ||
            trimmed.EndsWith("?", StringComparison.Ordinal))
        {
            return trimmed;
        }

        return $"{trimmed}.";
    }

    private RenderFragment RenderMetricCard(
        string label,
        string value,
        string tone,
        string summary) => @<SurfaceCard Soft="true">
        <TextBlock TextStyle="TextStyle.Eyebrow" Value="@label" />
        <h3 class="text-base font-semibold text-slate-900">@value</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">@summary</p>
        <StatusBadge Tone="@tone" Text="@label" />
    </SurfaceCard>;

    private static string FormatCount(int count, string singular, string plural)
        => count == 1
            ? $"1 {singular}"
            : $"{count.ToString("N0", CultureInfo.CurrentCulture)} {plural}";
}

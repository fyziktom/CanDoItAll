    private RenderFragment RenderProcessDetailDialog()
    {
        var details = processDetailPayload?.RunSnapshot?.Details;
        return @<Stack GapScale="LayoutGap.Medium"
                       Class="live-processes-dialog-body">
            @if (processDetailLoading)
            {
                <LoadingState Eyebrow="Process detail"
                              Title="Loading process run"
                              Description="Collecting steps, artifacts, timeline, outbox, and execution runs." />
            }
            else if (!string.IsNullOrWhiteSpace(processDetailErrorMessage))
            {
                <EmptyState Eyebrow="Process detail unavailable"
                            Title="Unable to load process details"
                            Description="@processDetailErrorMessage">
                    <Actions>
                        <Button Text="Try again"
                                ButtonStyle="ButtonStyle.Light"
                                Click="@(() => ReloadProcessDetailDialogAsync(forceRefresh: true))" />
                    </Actions>
                </EmptyState>
            }
            else if (details is null)
            {
                <EmptyState Eyebrow="No details"
                            Title="Process run details are not available"
                            Description="The live projection has the run card, but the detail snapshot could not be resolved." />
            }
            else
            {
                var artifactDetails = BuildArtifactDetails(details);
                <Tabs SelectedIndex="@processDetailTabIndex"
                      SelectedIndexChanged="HandleProcessDetailTabChangedAsync"
                      Variant="TabsVariant.WorkspacePrimary"
                      RenderMode="TabRenderMode.Client"
                      Class="live-processes-detail-tabs"
                      data-testid="live-processes-process-detail-tabs">
                    <TabsItem Text="Overview"
                              Icon="dashboard">
                        @RenderProcessOverview(details)
                    </TabsItem>

                    <TabsItem Text="Steps"
                              Icon="list"
                              BadgeText="@details.StepRuns.Count.ToString(CultureInfo.InvariantCulture)">
                        @RenderProcessSteps(details)
                    </TabsItem>

                    <TabsItem Text="Artifacts"
                              Icon="inventory_2"
                              BadgeText="@artifactDetails.Count.ToString(CultureInfo.InvariantCulture)">
                        @RenderProcessArtifacts(artifactDetails)
                    </TabsItem>

                    <TabsItem Text="Timeline"
                              Icon="timeline"
                              BadgeText="@details.AttemptTimeline.Count.ToString(CultureInfo.InvariantCulture)">
                        @RenderProcessTimeline(details)
                    </TabsItem>
                </Tabs>
            }
        </Stack>;
    }

    private RenderFragment RenderProcessOverview(ProcessWorkspaceRunDetails details)
    {
        return @<div class="live-processes-detail-panel">
            <CompactStatStrip>
                <CompactStat Label="steps"
                             Value="@($"{details.StepRuns.Count(item => item.Status == ProcessStepRunStatus.Completed)}/{details.StepRuns.Count}")"
                             TooltipText="Completed steps compared with total steps."
                             Tone="info" />
                <CompactStat Label="active"
                             Value="@details.Health.ActiveExecutionCount.ToString("N0", CultureInfo.CurrentCulture)"
                             TooltipText="Active executions in this run."
                             Tone="success" />
                <CompactStat Label="approvals"
                             Value="@details.Health.PendingApprovalCount.ToString("N0", CultureInfo.CurrentCulture)"
                             TooltipText="Pending approvals in this run."
                             Tone="warning" />
                <CompactStat Label="blocked"
                             Value="@details.Health.BlockedStepCount.ToString("N0", CultureInfo.CurrentCulture)"
                             TooltipText="Blocked steps in this run."
                             Tone="danger" />
                <CompactStat Label="artifacts"
                             Value="@details.Artifacts.Count.ToString("N0", CultureInfo.CurrentCulture)"
                             TooltipText="Artifacts attached to this run."
                             Tone="accent" />
                <CompactStat Label="outbox"
                             Value="@details.OutboxRecords.Count.ToString("N0", CultureInfo.CurrentCulture)"
                             TooltipText="Automation outbox records for this run." />
            </CompactStatStrip>

            <div class="live-processes-detail-grid">
                <SectionCard Title="Run health"
                             Description="@ResolveRunHealthDescription(details.Health)">
                    <div class="live-processes-detail-meta-grid">
                        @RenderDetailMetric("Latest attempts", details.Health.LatestAttemptCount.ToString("N0", CultureInfo.CurrentCulture))
                        @RenderDetailMetric("Waiting approval", details.Health.WaitingApprovalStepCount.ToString("N0", CultureInfo.CurrentCulture))
                        @RenderDetailMetric("Missing artifacts", details.Health.MissingArtifactCount.ToString("N0", CultureInfo.CurrentCulture))
                        @RenderDetailMetric("Dead letters", details.Health.DeadLetteredOutboxCount.ToString("N0", CultureInfo.CurrentCulture))
                        @RenderDetailMetric("Invariant diagnostics", details.Health.InvariantDiagnosticCount.ToString("N0", CultureInfo.CurrentCulture))
                        @RenderDetailMetric("Recommended action", details.Health.RecommendedAction.ToString())
                    </div>
                </SectionCard>

                <SectionCard Title="Recent execution"
                             Description="Latest agent execution runs associated with this process.">
                    @if (details.ExecutionRuns.Count == 0)
                    {
                        <EmptyState Eyebrow="No executions"
                                    Title="No agent execution runs"
                                    Description="Execution runs appear after automation dispatches agent work." />
                    }
                    else
                    {
                        <div class="live-processes-detail-list">
                            @foreach (var execution in details.ExecutionRuns.Take(6))
                            {
                                <div @key="execution.Id"
                                     class="live-processes-detail-row">
                                    <div class="min-w-0">
                                        <h3>@execution.Title</h3>
                                        <p>@ResolveExecutionSubtitle(execution)</p>
                                    </div>
                                    <StatusBadge Tone="@execution.StatusTone"
                                                 Text="@ResolveExecutionStatusText(execution)" />
                                </div>
                            }
                        </div>
                    }
                </SectionCard>
            </div>
        </div>;
    }

    private RenderFragment RenderProcessSteps(ProcessWorkspaceRunDetails details)
    {
        return @<div class="live-processes-detail-panel">
            @if (details.StepRuns.Count == 0)
            {
                <EmptyState Eyebrow="No steps"
                            Title="This run has no steps"
                            Description="Step details appear after a process run is created from a definition." />
            }
            else
            {
                <div class="live-processes-detail-list">
                    @foreach (var step in details.StepRuns.OrderBy(item => item.Sequence))
                    {
                        <SelectionListItem @key="step.Id"
                                           Title="@step.Title"
                                           Eyebrow="@step.StepKind.ToString()"
                                           Meta="@BuildStepMeta(step)"
                                           Summary="@ResolveStepSummary(step)"
                                           Dense="true"
                                           OnSelect="@(() => OpenStageDetailDialogAsync(step))"
                                           DataTestId="live-processes-step-item">
                            <Status>
                                <Cluster Gap="LayoutGap.Small"
                                         Wrap="FlexWrap.Wrap">
                                    <StatusBadge Tone="@ResolveStepTone(step.Status)"
                                                 Text="@step.Status.ToString()" />
                                    @if (step.Health.PendingApprovalCount > 0)
                                    {
                                        <StatusBadge Tone="warning"
                                                     Text="@FormatCount(step.Health.PendingApprovalCount, "approval", "approvals")" />
                                    }
                                    @if (step.Health.AttemptCount > 0)
                                    {
                                        <StatusBadge Tone="neutral"
                                                     Text="@FormatCount(step.Health.AttemptCount, "attempt", "attempts")" />
                                    }
                                </Cluster>
                            </Status>
                        </SelectionListItem>
                    }
                </div>
            }
        </div>;
    }


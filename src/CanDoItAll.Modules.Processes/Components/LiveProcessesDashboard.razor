    private async Task ReloadManagerChatDialogAsync()
    {
        if (managerChatRun is null)
        {
            return;
        }

        managerChatLoading = true;
        managerChatErrorMessage = null;
        try
        {
            managerChatProjection = await ManagerChatService.LoadAsync(
                BuildManagerChatQuery(managerChatRun, managerChatProjection?.Workspace?.SelectedSessionId),
                refreshCancellation?.Token ?? CancellationToken.None);
            if (!managerChatProjection.IsAvailable)
            {
                managerChatErrorMessage = managerChatProjection.ErrorMessage;
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            managerChatErrorMessage = exception.Message;
        }
        finally
        {
            managerChatLoading = false;
        }
    }

    private Task CloseManagerChatDialogAsync()
    {
        managerChatDialogOpen = false;
        managerChatRun = null;
        managerChatProjection = null;
        managerChatDraftPrompt = string.Empty;
        managerChatPendingPrompt = string.Empty;
        managerChatDraftAttachmentPaths = [];
        managerChatErrorMessage = null;
        return Task.CompletedTask;
    }

    private async Task StartManagerChatThreadAsync()
    {
        if (managerChatRun is null || managerChatProjection is null)
        {
            return;
        }

        await RunManagerChatOperationAsync(async token =>
        {
            managerChatProjection = await ManagerChatService.StartNewThreadAsync(
                BuildManagerChatQuery(managerChatRun, chatSessionId: null),
                token);
            managerChatDraftPrompt = string.Empty;
            managerChatPendingPrompt = string.Empty;
            managerChatDraftAttachmentPaths = [];
            managerChatComposerKey++;
        });
    }

    private async Task SelectManagerChatThreadAsync(Guid sessionId)
    {
        if (managerChatRun is null)
        {
            return;
        }

        await RunManagerChatOperationAsync(async token =>
        {
            managerChatProjection = await ManagerChatService.LoadAsync(
                BuildManagerChatQuery(managerChatRun, sessionId),
                token);
            managerChatDraftPrompt = string.Empty;
            managerChatPendingPrompt = string.Empty;
            managerChatDraftAttachmentPaths = [];
            managerChatComposerKey++;
        });
    }

    private Task HandleManagerChatDraftPromptChangedAsync(string value)
    {
        managerChatDraftPrompt = value;
        return Task.CompletedTask;
    }

    private async Task SendManagerChatMessageAsync()
    {
        if (managerChatRun is null || managerChatProjection is null)
        {
            return;
        }

        var prompt = BuildManagerChatPromptWithAttachments();
        if (string.IsNullOrWhiteSpace(prompt))
        {
            managerChatErrorMessage = "Write a manager chat prompt before sending it.";
            return;
        }

        var pendingPrompt = managerChatDraftPrompt;
        managerChatPendingPrompt = pendingPrompt;
        var previousDraft = managerChatDraftPrompt;
        managerChatDraftPrompt = string.Empty;
        managerChatComposerKey++;

        await RunManagerChatOperationAsync(
            async token =>
            {
                managerChatProjection = await ManagerChatService.SendMessageAsync(
                    new ProcessManagerChatMessageRequest(
                        BuildManagerChatQuery(managerChatRun, managerChatProjection.Workspace?.SelectedSessionId),
                        managerChatProjection.Workspace?.SelectedSessionId,
                        prompt),
                    token);
                managerChatDraftAttachmentPaths = [];
            },
            onError: () =>
            {
                managerChatDraftPrompt = previousDraft;
                managerChatComposerKey++;
            });

        managerChatPendingPrompt = string.Empty;
    }


    private static string ResolveStepHealthDescription(ProcessStepRunViewModel step)
    {
        if (!string.IsNullOrWhiteSpace(step.Health.ActionableReason))
        {
            return step.Health.ActionableReason;
        }

        if (!string.IsNullOrWhiteSpace(step.BlockedReason))
        {
            return step.BlockedReason;
        }

        if (!string.IsNullOrWhiteSpace(step.ExceptionSummary))
        {
            return step.ExceptionSummary;
        }

        return $"Recovery classification: {step.Health.RecoveryClassification}.";

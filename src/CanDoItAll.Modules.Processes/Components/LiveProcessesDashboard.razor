                escalation.DefinitionId,
                escalation.DefinitionName,
                escalation.RunName,
                escalation.RunStatus,
                escalation.UpdatedAtUtc,
                0,
                0,
                0,
                0,
                0m,
                0m,
                0,
                0,
                0,
                0,
                0,
                escalation.ManagerAgentId,
                escalation.ManagerAgentName,
                escalation.Reason);
    }


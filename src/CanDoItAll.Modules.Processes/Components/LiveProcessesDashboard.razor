    private bool ShouldAcceptManagerChatExecutionEntry(ExecutionLogEntry entry)
    {
        if (managerChatProjection?.ManagerAgent?.Id != entry.AgentId)
        {
            return false;
        }

        var selectedSessionId = managerChatProjection.Workspace?.SelectedSessionId;
        return !selectedSessionId.HasValue || entry.ChatSessionId == selectedSessionId.Value;
    }

    private static IReadOnlyList<ExecutionLogEntry> UpsertManagerChatExecutionLogEntry(
        IReadOnlyList<ExecutionLogEntry> entries,
        ExecutionLogEntry entry)
    {
        return entries
            .Where(item => item.Id != entry.Id)
            .Append(entry)
            .OrderByDescending(item => item.CreatedAtUtc)
            .ToArray();
    }

    private static (string Text, string Tone) ResolveManagerChatExecutionState(ExecutionState state)
    {
        return (
            state.ToString(),
            state switch
            {
                ExecutionState.Completed => "success",
                ExecutionState.WaitingOnTool => "warning",
                ExecutionState.Failed => "danger",
                ExecutionState.Running or ExecutionState.Preparing or ExecutionState.Persisting => "info",
                _ => "neutral"
            });
    }

    private IReadOnlyList<LiveProcessArtifactDetail> BuildArtifactDetails(ProcessWorkspaceRunDetails details)
    {
        var stepTitlesById = details.StepRuns.ToDictionary(item => item.Id, item => item.Title);
        var artifacts = new List<LiveProcessArtifactDetail>();

        foreach (var artifact in details.Artifacts)
        {
            artifacts.Add(new LiveProcessArtifactDetail(
                $"process:{artifact.Id:N}",
                artifact.Id,
                artifact.StepRunId,
                ExecutionRunId: null,
                ResolveMissingText(artifact.Title),
                artifact.ArtifactKind.ToString(),
                artifact.StepRunId.HasValue ? stepTitlesById.GetValueOrDefault(artifact.StepRunId.Value, string.Empty) : string.Empty,
                ResolveArtifactPath(artifact.ManagedStoragePath, artifact.ExternalReferenceKey),
                artifact.ProvenanceSummary,
                artifact.AllowedFutureUsageSummary,
                artifact.TrustStatus.ToString(),
                artifact.CreatedAtUtc,
                LiveProcessArtifactSource.Process));
        }

        foreach (var executionRun in details.ExecutionRuns)
        {
            foreach (var artifact in executionRun.Artifacts)
            {
                artifacts.Add(new LiveProcessArtifactDetail(
                    $"execution:{executionRun.Id:N}:{artifact.Id:N}",
                    artifact.Id,
                    executionRun.StepRunId,
                    executionRun.Id,
                    ResolveMissingText(artifact.DisplayName),
                    artifact.ArtifactKind,
                    executionRun.StepRunId.HasValue ? stepTitlesById.GetValueOrDefault(executionRun.StepRunId.Value, executionRun.StepTitle) : executionRun.StepTitle,
                    artifact.RelativePath,
                    artifact.ProducedBy,
                    artifact.Summary,
                    artifact.ContentType,
                    artifact.CreatedAtUtc,
                    LiveProcessArtifactSource.Execution));
            }
        }

        return artifacts
            .OrderByDescending(item => item.CreatedAtUtc)
            .ThenBy(item => item.Title, StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private IReadOnlyList<ProcessExecutionRunViewModel> ResolveStepExecutionRuns(Guid stepRunId)
    {
        return processDetailPayload?.RunSnapshot?.Details.ExecutionRuns
            .Where(item => item.StepRunId == stepRunId)
            .OrderByDescending(item => item.UpdatedAtUtc)
            .ToArray() ?? [];
    }

    private IReadOnlyList<LiveProcessArtifactDetail> ResolveStepArtifacts(Guid stepRunId)
    {
        var details = processDetailPayload?.RunSnapshot?.Details;
        return details is null
            ? []
            : BuildArtifactDetails(details)
                .Where(item => item.StepRunId == stepRunId)
                .ToArray();
    }


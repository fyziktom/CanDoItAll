    private RenderFragment RenderStageDetailDialog()
    {
        var step = stageDetailStep;
        return @<Stack GapScale="LayoutGap.Medium"
                       Class="live-processes-dialog-body">
            @if (stageDetailLoading)
            {
                <LoadingState Eyebrow="Step detail"
                              Title="Loading step details"
                              Description="Collecting step state and the filtered process timeline." />
            }
            else if (!string.IsNullOrWhiteSpace(stageDetailErrorMessage))
            {
                <EmptyState Eyebrow="Step detail unavailable"
                            Title="Unable to load step detail"
                            Description="@stageDetailErrorMessage" />
            }
            else if (step is null)
            {
                <EmptyState Eyebrow="No step"
                            Title="No step is selected"
                            Description="Select a process step from the run details dialog." />
            }
            else
            {
                var executions = ResolveStepExecutionRuns(step.Id);
                var artifacts = ResolveStepArtifacts(step.Id);
                <div class="live-processes-detail-grid">
                    <SectionCard Title="State"
                                 Description="@ResolveStepSummary(step)">
                        <div class="live-processes-detail-meta-grid">
                            @RenderDetailMetric("Status", step.Status.ToString())
                            @RenderDetailMetric("Executor", string.IsNullOrWhiteSpace(step.CurrentExecutorName) ? "Unassigned" : step.CurrentExecutorName)
                            @RenderDetailMetric("Wait", FormatDuration(TimeSpan.FromMinutes(step.WaitMinutes)))
                            @RenderDetailMetric("Touch", FormatDuration(TimeSpan.FromMinutes(step.TouchMinutes)))
                            @RenderDetailMetric("Blocked", FormatDuration(TimeSpan.FromMinutes(step.BlockedMinutes)))
                            @RenderDetailMetric("Rework", step.ReworkCount.ToString("N0", CultureInfo.CurrentCulture))
                            @RenderDetailMetric("Target scope", step.OperationTargetScope?.ToString() ?? "Not declared")
                            @RenderDetailMetric("Allowed operations", FormatAllowedOperations(step.AllowedOperations))
                        </div>
                    </SectionCard>

                    <SectionCard Title="Health"
                                 Description="@ResolveStepHealthDescription(step)">
                        <div class="live-processes-detail-meta-grid">
                            @RenderDetailMetric("Attempts", step.Health.AttemptCount.ToString("N0", CultureInfo.CurrentCulture))
                            @RenderDetailMetric("Latest attempt", string.IsNullOrWhiteSpace(step.Health.LatestAttemptStatus) ? "None" : step.Health.LatestAttemptStatus)
                            @RenderDetailMetric("Approvals", step.Health.PendingApprovalCount.ToString("N0", CultureInfo.CurrentCulture))
                            @RenderDetailMetric("Outbox", step.Health.PendingOutboxCount.ToString("N0", CultureInfo.CurrentCulture))
                            @RenderDetailMetric("Block code", step.BlockReasonCode.ToString())
                            @RenderDetailMetric("Next recovery", step.NextRecoveryAction.ToString())
                            @RenderDetailMetric("Recovery options", FormatRecoveryOptions(step.RecoveryOptions))
                        </div>
                    </SectionCard>
                </div>

                @if (ShouldShowStepContractBlocker(step))
                {
                    <SectionCard Title="Contract and blocker"
                                 Description="@BuildStepContractBlockerDescription(step)">
                        <div class="live-processes-detail-list">
                            @if (IsPolicyDeniedStep(step))
                            {
                                <div class="live-processes-detail-row">
                                    <div class="min-w-0">
                                        <h3>Tool policy denied the requested operation</h3>
                                        <p>Required operation and target scope must match the step contract before automation can continue.</p>
                                    </div>
                                    <StatusBadge Tone="danger"
                                                 Text="Policy denied" />
                                </div>
                            }
                            <div class="live-processes-detail-row">
                                <div class="min-w-0">
                                    <h3>Step contract</h3>
                                    <p>Allowed operations: @FormatAllowedOperations(step.AllowedOperations)</p>
                                    <p>Target scope: @(step.OperationTargetScope?.ToString() ?? "Not declared")</p>
                                </div>
                                <StatusBadge Tone="@ResolveStepContractTone(step)"
                                             Text="@ResolveStepContractStatus(step)" />
                            </div>
                            @if (!string.IsNullOrWhiteSpace(step.BlockedReason))
                            {
                                <div class="live-processes-detail-row">
                                    <div class="min-w-0">
                                        <h3>Blocked reason</h3>
                                        <p>@step.BlockedReason</p>
                                    </div>
                                    <StatusBadge Tone="warning"
                                                 Text="@step.BlockReasonCode.ToString()" />
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(step.ExceptionSummary))
                            {
                                <div class="live-processes-detail-row">
                                    <div class="min-w-0">
                                        <h3>Exception summary</h3>
                                        <p>@step.ExceptionSummary</p>
                                    </div>
                                    <StatusBadge Tone="danger"
                                                 Text="Exception" />
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(step.RefusalReason))
                            {
                                <div class="live-processes-detail-row">
                                    <div class="min-w-0">
                                        <h3>Refusal reason</h3>
                                        <p>@step.RefusalReason</p>
                                    </div>
                                    <StatusBadge Tone="danger"
                                                 Text="Refused" />
                                </div>
                            }
                        </div>
                    </SectionCard>
                }

                @if (step.ArtifactExpectations.Count > 0)
                {
                    <SectionCard Title="Artifact expectations"
                                 Description="Expected outputs and their satisfaction state for this step.">
                        <div class="live-processes-detail-list">
                            @foreach (var expectation in step.ArtifactExpectations)
                            {
                                <div @key="expectation.ArtifactExpectationId"
                                     class="live-processes-detail-row">
                                    <div class="min-w-0">
                                        <h3>@expectation.Title</h3>
                                        <p>@ResolveArtifactExpectationSummary(expectation)</p>
                                        @if (!string.IsNullOrWhiteSpace(expectation.Diagnostic))
                                        {
                                            <p>@expectation.Diagnostic</p>
                                        }
                                        @if (expectation.ValidationStatus.HasValue)
                                        {
                                            <p>Finalizer status: @expectation.ValidationStatus</p>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(expectation.ValidationAttemptedPath))
                                        {
                                            <p>Attempted path: @expectation.ValidationAttemptedPath</p>
                                        }

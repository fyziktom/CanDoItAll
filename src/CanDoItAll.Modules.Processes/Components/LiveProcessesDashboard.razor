    private async Task ExecuteEscalationActionAsync(
        ProcessLiveEscalationCard escalation,
        ProcessLiveEscalationActionDescriptor action)
    {
        if (!busyActivityCardKeys.Add(escalation.Key))
        {
            return;
        }

        activityActionMessage = null;
        errorMessage = null;
        try
        {
            var actionCompleted = action.Kind switch
            {
                ProcessLiveEscalationActionKind.DecideApproval => await DecideEscalationApprovalAsync(escalation, action),
                ProcessLiveEscalationActionKind.RequestRework => await RequestEscalationReworkAsync(escalation),
                ProcessLiveEscalationActionKind.Resolve => await ResolveEscalationAsync(escalation),
                ProcessLiveEscalationActionKind.MessageManager => await SendEscalationManagerMessageAsync(escalation),
                _ => false
            };

            if (actionCompleted)
            {
                await RefreshAsync(forceRefresh: true);
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        catch (Exception exception)
        {
            errorMessage = $"Escalation action failed. {exception.Message}";
        }
        finally
        {
            busyActivityCardKeys.Remove(escalation.Key);
        }
    }

    private async Task<bool> DecideEscalationApprovalAsync(
        ProcessLiveEscalationCard escalation,
        ProcessLiveEscalationActionDescriptor action)
    {
        if (action.ApprovalStatus is null ||
            !ProcessLiveEscalationActionPolicy.TryResolveSourceApproval(escalation, out var executionRunId, out var approvalId))
        {
            errorMessage = "This escalation is not bound to a pending execution approval.";
            return false;
        }

        var status = action.ApprovalStatus.Value;
        var cancellationToken = refreshCancellation?.Token ?? CancellationToken.None;
        await AgentWorkspaceService.ContinueExecutionRunAsync(
            executionRunId,
            approved: status == ProcessOperatorApprovalStatus.Approved,
            autoApprovePendingToolCalls: false,
            cancellationToken: cancellationToken);

        var recordResult = await EscalationService.RecordApprovalDecisionAsync(
            new ProcessOperatorApprovalDecisionRequest
            {
                ProcessRunId = escalation.RunId,
                StepRunId = escalation.StepRunId,
                ExecutionRunId = executionRunId,
                ExternalApprovalId = approvalId,
                Status = status,
                Summary = $"{status} from Live Processes for escalation '{escalation.Title}'.",
                DecidedBy = "live-processes"
            },
            cancellationToken);
        if (recordResult.IsFailure)
        {
            errorMessage = FormatErrors(recordResult.Errors);
            return false;
        }

        var resolveResult = await EscalationService.ResolveAsync(
            new ProcessEscalationResolutionRequest
            {
                EscalationId = escalation.EscalationId,
                Resolution = $"Approval {status} from Live Processes.",
                ResolvedBy = "live-processes"
            },
            cancellationToken);
        if (resolveResult.IsFailure)
        {
            errorMessage = FormatErrors(resolveResult.Errors);
            return false;
        }

        activityActionMessage = $"Approval {status}.";
        return true;
    }

    private async Task<bool> RequestEscalationReworkAsync(ProcessLiveEscalationCard escalation)
    {
        var result = await EscalationService.RequestReworkAsync(
            new ProcessEscalationReworkRequest
            {
                EscalationId = escalation.EscalationId,
                Directive = BuildEscalationReworkDirective(escalation),
                RequestedBy = "live-processes"
            },
            refreshCancellation?.Token ?? CancellationToken.None);
        if (result.IsFailure)
        {
            errorMessage = FormatErrors(result.Errors);
            return false;
        }

        activityActionMessage = result.Value.HasValue
            ? $"Escalation rework requested. Rework packet {result.Value.Value:D}."
            : "Escalation rework requested.";
        return true;
    }

    private async Task<bool> ResolveEscalationAsync(ProcessLiveEscalationCard escalation)
    {
        var result = await EscalationService.ResolveAsync(
            new ProcessEscalationResolutionRequest
            {
                EscalationId = escalation.EscalationId,
                Resolution = $"Operator resolved this {escalation.Kind} escalation from Live Processes.",
                ResolvedBy = "live-processes"
            },
            refreshCancellation?.Token ?? CancellationToken.None);
        if (result.IsFailure)
        {
            errorMessage = FormatErrors(result.Errors);
            return false;
        }

        activityActionMessage = "Escalation resolved.";
        return true;
    }

    private async Task<bool> SendEscalationManagerMessageAsync(ProcessLiveEscalationCard escalation)
    {
        var run = ResolveRunCard(escalation);
        var projection = await ManagerChatService.SendMessageAsync(
            new ProcessManagerChatMessageRequest(
                BuildManagerChatQuery(run, chatSessionId: null),
                ChatSessionId: null,
                BuildEscalationManagerMessagePrompt(escalation)),
            refreshCancellation?.Token ?? CancellationToken.None);
        if (!projection.IsAvailable)
        {
            errorMessage = projection.ErrorMessage;
            return false;
        }

        if (managerChatDialogOpen && managerChatRun?.RunId == run.RunId)
        {
            managerChatProjection = projection;
        }

        activityActionMessage = $"Manager message sent to {projection.ManagerLabel}.";
        return true;
    }

    private static string BuildEscalationReworkDirective(ProcessLiveEscalationCard escalation)
    {
        return $"""
Operator requested governed rework from Live Processes.
Escalation: {escalation.Title}
Escalation kind: {escalation.Kind}
Step: {ResolveMissingText(escalation.StepTitle)}
Reason: {ResolveMissingText(escalation.Reason)}
""";
    }


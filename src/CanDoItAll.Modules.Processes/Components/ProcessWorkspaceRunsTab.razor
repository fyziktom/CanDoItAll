<ProcessWorkspaceRunsLaunchSection Presenter="Presenter" />

<ProcessWorkspaceRunsActiveSection Presenter="Presenter" />

<ProcessWorkspaceRunsLifecycleSection Presenter="Presenter" />

@if (Presenter.SelectedRun is not null)
{
    <ProcessWorkspaceRunsSummarySection Presenter="Presenter" />
    <ProcessWorkspaceRunsExecutionSection Presenter="Presenter" />
    <ProcessWorkspaceRunsAssignmentsSection Presenter="Presenter" />
    <ProcessWorkspaceRunsMessagingSection Presenter="Presenter" />

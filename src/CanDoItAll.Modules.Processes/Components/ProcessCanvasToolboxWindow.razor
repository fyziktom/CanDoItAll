@namespace CanDoItAll.Modules.Processes
@using CanDoItAll.Components.CanvasLib
@using CanDoItAll.Components.OverlayLib

<CanvasFloatingWindow WindowId="@WindowId"
                      TestId="@TestId"
                      AriaLabel="@AriaLabel"
                      Kicker="@Kicker"
                      Title="@Title"
                      Summary="@Summary"
                      BodyClass="processes-canvas-toolbox-window__body"
                      DefaultPlacement="top-left"
                      DefaultWidth="@DefaultWidth"
                      DefaultHeight="@DefaultToolboxWindowHeight"
                      MinWidth="320"
                      MinHeight="320"
                      MaxWidth="560"
                      MaxHeight="800"
                      State="@ResolvedState"
                      StateChanged="StateChanged">
    <OverlayComponentToolbox TestId="processes-canvas-toolbox"
                             AriaLabel="Process templates toolbox"
                             Class="processes-canvas-toolbox"
                             Eyebrow="Role-first authoring"
                             Title="Process components library"
                             Summary="Open role and step templates without duplicating the form logic outside the canvas workflow."
                             SearchText="@SearchText"
                             SearchTextChanged="SearchTextChanged"
                             SearchPlaceholder="Search templates, roles, steps, review, or release"
                             BodyClass="processes-canvas-toolbox__body"
                             SectionsClass="processes-canvas-toolbox__sections"
                             Badges="@ToolboxBadges"
                             Sections="@ToolboxSections"
                             ItemSelected="OpenAction" />
</CanvasFloatingWindow>

@code {
    private const double LegacyDefaultToolboxWindowHeight = 540;
    private const double DefaultToolboxWindowHeight = 640;

    [Parameter, EditorRequired]
    public string WindowId { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string TestId { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string AriaLabel { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Kicker { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Summary { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public CanvasWorkbenchWindowState State { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback<CanvasWorkbenchWindowState> StateChanged { get; set; }

    [Parameter]
    public IReadOnlyList<ProcessCanvasToolboxGroup> Groups { get; set; } = [];

    [Parameter]
    public string SearchText { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string?> SearchTextChanged { get; set; }

    [Parameter]
    public double DefaultWidth { get; set; } = 420;

    private CanvasWorkbenchWindowState ResolvedState
        => UpgradeLegacyDefaultHeight(State, LegacyDefaultToolboxWindowHeight, DefaultToolboxWindowHeight);

    [Parameter]
    public EventCallback<string> OpenAction { get; set; }

    private int ActionCount => Groups.Sum(group => group.Actions.Count);

    private IReadOnlyList<OverlayToolboxBadge> ToolboxBadges
        =>
        [
            new OverlayToolboxBadge("Role-first authoring", "info"),
            new OverlayToolboxBadge($"{ActionCount} items", "label")
        ];

    private IReadOnlyList<OverlayToolboxSection> ToolboxSections
        =>
        [
            new OverlayToolboxSection(
                "processes",
                "Process templates",
                "Role and step templates",
                Groups.Select(group => new OverlayToolboxGroup(
                    group.Key,
                    group.Title,
                    group.Summary,
                    group.Actions.Select(action => new OverlayToolboxItem(
                        action.ActionId,
                        action.Label,
                        action.Summary,
                        Icon: ResolveItemIcon(action),
                        Tone: action.Tone,
                        DataTestId: $"processes-toolbox-{action.ActionId}")).ToList(),
                    Icon: ResolveGroupIcon(group.Key),
                    Tone: ResolveTone(group.Key),
                    IsExpanded: true)).ToList(),
                IsExpanded: true)
        ];

    private static string ResolveGroupIcon(string key)
        => key.Contains("role", StringComparison.OrdinalIgnoreCase) ? "person" : "route";

    private static string ResolveTone(string key)
        => key.Contains("role", StringComparison.OrdinalIgnoreCase) ? "neutral" : "accent";

    private static string ResolveItemIcon(ProcessCanvasToolboxAction action)
        => action.ActionId.Contains("role", StringComparison.OrdinalIgnoreCase) ? "person" : "route";

    private static CanvasWorkbenchWindowState UpgradeLegacyDefaultHeight(
        CanvasWorkbenchWindowState state,
        double legacyDefaultHeight,
        double defaultHeight)
    {
        var normalized = CanvasWorkbenchWindowState.Normalize(state);
        if (normalized.IsMinimized ||
            !normalized.Height.HasValue ||
            normalized.Height.Value > legacyDefaultHeight + 0.5)
        {
            return normalized;
        }

        var upgraded = normalized.Clone();
        upgraded.Height = defaultHeight;
        return CanvasWorkbenchWindowState.Normalize(upgraded);
    }
}

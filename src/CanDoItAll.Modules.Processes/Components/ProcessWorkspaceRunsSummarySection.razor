@namespace CanDoItAll.Modules.Processes

<CompactStatStrip>
    <CompactStat Label="completed steps"
                 Value="@Presenter.SelectedRun!.CompletedStepCount.ToString()"
                 TooltipText="@($"{Presenter.SelectedRun.TotalStepCount} total steps in this run.")" />
    <CompactStat Label="blocked steps"
                 Value="@Presenter.SelectedRun.BlockedStepCount.ToString()"
                 TooltipText="Steps currently blocked in runtime."
                 Tone="warning" />
    <CompactStat Label="capability gaps"
                 Value="@Presenter.SelectedRun.CapabilityGapCount.ToString()"
                 TooltipText="Assignments or execution gaps detected."
                 Tone="danger" />
    <CompactStat Label="actual cost"
                 Value="@Presenter.SelectedRun.ActualCost.ToString("C")"
                 TooltipText="@($"{Presenter.SelectedRun.EstimatedCost:C} estimated for this run.")"
                 Tone="info" />
</CompactStatStrip>

@code {
    [Parameter, EditorRequired]
    public ProcessWorkspace.ProcessWorkspaceRunsTabPresenter Presenter { get; set; } = default!;
}

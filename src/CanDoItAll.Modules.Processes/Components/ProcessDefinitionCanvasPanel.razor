        => kind switch
        {
            ProcessDefinitionCanvasPortKind.StructuralInput => StructuralInputPortId,
            ProcessDefinitionCanvasPortKind.StructuralOutput => StructuralOutputPortId,
            ProcessDefinitionCanvasPortKind.RoleBinding => RoleBindingPortId,
            ProcessDefinitionCanvasPortKind.ArtifactExpectation => ArtifactExpectationPortId,
            ProcessDefinitionCanvasPortKind.SubprocessBoundary => SubprocessBoundaryPortId,

    private static string ResolveNodeKeyText(ProcessDefinitionCanvasEditorNodeProjection node)
        => node.Kind == ProcessDefinitionCanvasNodeKind.Artifact && !string.IsNullOrWhiteSpace(node.ArtifactKey)
            ? node.ArtifactKey
            : node.StepKey?.Value ?? node.RoleKey?.Value ?? node.NodeKey.Value;

    private static string BuildCanvasCommandTestId(ProcessDefinitionCanvasCommandKind kind)
        => kind == ProcessDefinitionCanvasCommandKind.Recompose
            ? "processes-canvas-recompose"
            : $"processes-canvas-command-{kind.ToString().ToLowerInvariant()}";

    private static string BuildToolboxActionTestId(ProcessDefinitionCanvasToolboxActionKey key)
        => $"processes-canvas-toolbox-{NormalizeTestId(key.Value)}";

    private static string BuildNodeTestId(ProcessDefinitionCanvasNodeKey key)
        => $"processes-canvas-node-{NormalizeTestId(key.Value)}";

    private static string BuildEdgeTestId(ProcessDefinitionCanvasEdgeKey key)
        => $"processes-canvas-edge-{NormalizeTestId(key.Value)}";

    private static string NormalizeTestId(string value)
    {
        var normalized = new string(value
            .Select(character => char.IsLetterOrDigit(character) ? char.ToLowerInvariant(character) : '-')
            .ToArray());
        return normalized.Trim('-');
    }
}

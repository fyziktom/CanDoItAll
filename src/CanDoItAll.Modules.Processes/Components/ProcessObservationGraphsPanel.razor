@namespace CanDoItAll.Modules.Processes
@using System.Globalization
@using CanDoItAll.Components.Charts
@using CanDoItAll.Components.Common

<Stack GapScale="LayoutGap.Medium"
       Class="w-full"
       data-testid="@TestId">
    @if (Snapshot is null)
    {
        <EmptyState Eyebrow="@EmptyEyebrow"
                    Title="@EmptyTitle"
                    Description="@EmptyDescription" />
    }
    else
    {
        <CompactStatStrip>
            <CompactStat Label="runs"
                         Value="@Snapshot.Stats.ObservedRunCount.ToString("N0", CultureInfo.CurrentCulture)"
                         TooltipText="Runs included in this graph scope."
                         Tone="info" />
            <CompactStat Label="context"
                         Value="@Snapshot.Stats.TotalTokens.ToString("N0", CultureInfo.CurrentCulture)"
                         TooltipText="Input plus output tokens included in this graph scope."
                         Tone="accent" />
            <CompactStat Label="cached input"
                         Value="@Snapshot.Stats.CachedInputTokens.ToString("N0", CultureInfo.CurrentCulture)"
                         TooltipText="Cached input tokens reported by providers that expose cached usage."
                         Tone="warning" />
            <CompactStat Label="tool calls"
                         Value="@Snapshot.Stats.ToolCalls.ToString("N0", CultureInfo.CurrentCulture)"
                         TooltipText="Tool calls included in this graph scope."
                         Tone="neutral" />
            <CompactStat Label="cost"
                         Value="@Snapshot.Stats.ActualCost.ToString("C", CultureInfo.CurrentCulture)"
                         TooltipText="@($"{Snapshot.Stats.EstimatedCost:C} estimated in scope")"
                         Tone="danger" />
        </CompactStatStrip>

        <Grid Gap="LayoutGap.Medium"
              ColumnTemplateLg="minmax(0,1fr) minmax(0,1fr)"
              Class="w-full">
            <CdaChart Title="Context usage"
                      Description="@ContextDescription"
                      Series="@ContextSeries"
                      Options="@ContextChartOptions"
                      Height="320"
                      EmptyText="No context metrics in this graph scope." />

            <CdaChart Title="Spent time and tool calls"
                      Description="@DurationDescription"
                      Series="@DurationSeries"
                      Options="@DurationChartOptions"
                      Height="320"
                      EmptyText="No runtime metrics in this graph scope." />

            <CdaChart Title="Process cost"
                      Description="@CostDescription"
                      Series="@MoneySeries"
                      Options="@MoneyChartOptions"
                      Height="320"
                      EmptyText="No process cost data in this graph scope." />
        </Grid>
    }
</Stack>

@code {
    private static readonly CdaChartOptions ContextChartOptions = new()
    {
        Type = CdaChartType.Area,
        XAxisType = CdaChartAxisType.DateTime,
        YAxisTitle = "Tokens",
        TooltipPrecision = 0,
        ValuePrecision = 0,
        FillOpacity = 0.22,
        Curve = CdaChartCurve.Straight,
        LegendPosition = CdaChartLegendPosition.Bottom,
        Palette = ["#2563eb", "#16a34a", "#d97706"]
    };

    private static readonly CdaChartOptions DurationChartOptions = new()
    {
        Type = CdaChartType.Bar,
        XAxisType = CdaChartAxisType.DateTime,
        YAxisTitle = "Minutes",
        Unit = "min",
        TooltipPrecision = 2,
        ValuePrecision = 2,
        ShowToolbar = false,
        EnableZoom = false,
        LegendPosition = CdaChartLegendPosition.Bottom,
        Palette = ["#7c3aed", "#0891b2"]
    };

    private static readonly CdaChartOptions MoneyChartOptions = new()
    {
        Type = CdaChartType.Bar,
        XAxisType = CdaChartAxisType.Category,
        YAxisTitle = "Cost",
        Unit = "$",
        TooltipPrecision = 2,
        ValuePrecision = 2,
        ShowToolbar = false,
        EnableZoom = false,
        RotateXAxisLabels = false,
        LegendPosition = CdaChartLegendPosition.Bottom,
        Palette = ["#0f766e", "#dc2626"]
    };

    [Parameter]
    public ProcessLiveObservationSnapshot? Snapshot { get; set; }

    [Parameter]
    public string TestId { get; set; } = "process-observation-graphs-panel";

    [Parameter]
    public string EmptyEyebrow { get; set; } = "Graphs";

    [Parameter]
    public string EmptyTitle { get; set; } = "No graph data loaded";

    [Parameter]
    public string EmptyDescription { get; set; } = "Graph data appears after the selected scope is loaded.";

    [Parameter]
    public string ContextDescription { get; set; } = "Input, output, and cached input tokens.";

    [Parameter]
    public string DurationDescription { get; set; } = "Runtime duration and tool activity.";

    [Parameter]
    public string CostDescription { get; set; } = "Runs included in this graph scope.";

    private IReadOnlyList<ProcessLiveMetricPoint> MetricPoints => Snapshot?.MetricPoints ?? [];

    private IReadOnlyList<ProcessLiveRunCard> Runs => Snapshot?.Runs ?? [];

    private IReadOnlyList<CdaChartSeries> ContextSeries
    {
        get
        {
            if (MetricPoints.Count == 0)
            {
                return [];
            }

            var series = new List<CdaChartSeries>
            {
                new()
                {
                    Name = "Input tokens",
                    Type = CdaChartType.Area,
                    Color = "#2563eb",
                    Points = MetricPoints
                        .Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, item.InputTokens))
                        .ToArray()
                },
                new()
                {
                    Name = "Output tokens",
                    Type = CdaChartType.Area,
                    Color = "#16a34a",
                    Points = MetricPoints
                        .Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, item.OutputTokens))
                        .ToArray()
                }
            };

            if (MetricPoints.Any(item => item.CachedInputTokens > 0))
            {
                series.Add(new CdaChartSeries
                {
                    Name = "Cached input tokens",
                    Type = CdaChartType.Line,
                    Color = "#d97706",
                    Points = MetricPoints
                        .Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, item.CachedInputTokens))
                        .ToArray()
                });
            }

            return series;
        }
    }

    private IReadOnlyList<CdaChartSeries> DurationSeries
    {
        get
        {
            if (MetricPoints.Count == 0)
            {
                return [];
            }

            return
            [
                new()
                {
                    Name = "Spent time",
                    Type = CdaChartType.Bar,
                    Color = "#7c3aed",
                    Points = MetricPoints
                        .Select(item => new CdaChartPoint(
                            item.TimestampUtc.UtcDateTime,
                            Math.Round(item.DurationMs / 60000m, 2)))
                        .ToArray()
                },
                new()
                {
                    Name = "Tool calls",
                    Type = CdaChartType.Line,
                    Color = "#0891b2",
                    Points = MetricPoints
                        .Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, item.ToolCalls))
                        .ToArray()
                }
            ];
        }
    }

    private IReadOnlyList<CdaChartSeries> MoneySeries
    {
        get
        {
            var runs = Runs.Take(12).ToArray();
            if (runs.Length == 0)
            {
                return [];
            }

            return
            [
                new()
                {
                    Name = "Actual",
                    Type = CdaChartType.Bar,
                    Color = "#0f766e",
                    Points = runs
                        .Select(item => new CdaChartPoint(TrimLabel(item.RunName, 24), item.ActualCost))
                        .ToArray()
                },
                new()
                {
                    Name = "Estimated",
                    Type = CdaChartType.Bar,
                    Color = "#dc2626",
                    Points = runs
                        .Select(item => new CdaChartPoint(TrimLabel(item.RunName, 24), item.EstimatedCost))
                        .ToArray()
                }
            ];
        }
    }

    private static string TrimLabel(string value, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Item";
        }

        var trimmed = value.Trim();
        return trimmed.Length <= maxLength
            ? trimmed
            : string.Concat(trimmed.AsSpan(0, Math.Max(0, maxLength - 3)), "...");
    }
}

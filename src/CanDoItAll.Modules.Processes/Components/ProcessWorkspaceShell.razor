                <label class="text-xs font-semibold text-slate-500" for="processes-definition-change-summary-input">Change summary</label>
                <textarea id="processes-definition-change-summary-input"
                          class="min-h-9 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm"
                          value="@editorChangeSummary"
                          @oninput="args => editorChangeSummary = ReadChangeValue(args)"
                          data-testid="processes-definition-editor-change-summary"></textarea>

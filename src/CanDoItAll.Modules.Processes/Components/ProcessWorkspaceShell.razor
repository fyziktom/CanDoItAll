    private RenderFragment RenderRunsTab() => @<Stack GapScale="LayoutGap.Large"
                                                      Class="processes-runs-tab-shell"
                                                      data-testid="processes-runs-tab-shell">
        <SurfaceCard Soft="true"
                     data-testid="processes-selected-run-summary">
            <Split Gap="LayoutGap.Medium"
                   Wrap="FlexWrap.Wrap">
                <Stack GapScale="LayoutGap.Tiny">
                    <TextBlock TextStyle="TextStyle.Eyebrow" Value="Run focus" />
                    <h3 class="text-base font-semibold text-slate-900">Runtime workspace</h3>
                    <p class="text-sm leading-6 text-slate-600">@CurrentShell.LiveRuns.Summary</p>
                </Stack>
                <Cluster Gap="LayoutGap.XSmall"
                         Class="flex-wrap">
                    <StatusBadge Tone="success" Text="@($"{CurrentShell.LiveRuns.ActiveRunCount} active")" />
                    <StatusBadge Tone="warning" Text="@($"{CurrentShell.LiveRuns.AttentionRunCount} attention")" />
                    <StatusBadge Tone="danger" Text="@($"{CurrentShell.LiveRuns.FailedRunCount} failed")" />
                    <StatusBadge Tone="@ProjectionTone" Text="@ProjectionStatusText" />
                </Cluster>
            </Split>
        </SurfaceCard>

        <Tabs SelectedIndex="@selectedRunViewIndex"
              SelectedIndexChanged="HandleSelectedRunViewChangedAsync"
              Variant="TabsVariant.WorkspaceSecondary"
              BorderMode="TabsBorderMode.Soft"
              OverflowMode="TabsOverflowMode.Auto"
              PanelOverflowMode="TabsPanelOverflowMode.Auto"
              Class="w-full min-w-0"
              AriaLabel="Process runs workspace sections"
              data-testid="processes-runs-tabs">
            <TabsItem Text="Launch" Icon="rocket_launch">
                <EmptyState Eyebrow="Launch"
                            Title="Launch planning"
                            Description="Launch planning is kept with runtime runs, matching the original process workspace shape." />
            </TabsItem>
            <TabsItem Text="Activity" Icon="monitoring">
                <Grid Gap="LayoutGap.Medium"
                      ColumnsLg="3"
                      data-testid="processes-run-activity">
                    @RenderMetricCard("Active runs", CurrentShell.LiveRuns.ActiveRunCount.ToString(CultureInfo.InvariantCulture), "success", CurrentShell.LiveRuns.Summary)
                    @RenderMetricCard("Attention", CurrentShell.LiveRuns.AttentionRunCount.ToString(CultureInfo.InvariantCulture), "warning", "Runs that need operator review.")
                    @RenderMetricCard("Failed", CurrentShell.LiveRuns.FailedRunCount.ToString(CultureInfo.InvariantCulture), "danger", "Failed process runs in the current projection.")
                </Grid>
            </TabsItem>
            <TabsItem Text="Control" Icon="rule">
                <SurfaceCard Soft="true" data-testid="processes-operator-control-section">
                    <TextBlock TextStyle="TextStyle.Eyebrow" Value="Operator control" />
                    <h3 class="text-base font-semibold text-slate-900">Manager Resolution</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-600">Escalations, approvals, rework, dispatch receipts, and attempt timeline controls remain grouped under run control.</p>
                </SurfaceCard>
            </TabsItem>
            <TabsItem Text="Execution" Icon="terminal">
                <SurfaceCard Soft="true" data-testid="processes-runtime-host-readback">
                    <TextBlock TextStyle="TextStyle.Eyebrow" Value="Execution" />
                    <h3 class="text-base font-semibold text-slate-900">Runtime execution readback</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-600">Runtime canvas and technical execution telemetry are intentionally separated from definition authoring.</p>
                </SurfaceCard>
            </TabsItem>
            <TabsItem Text="Graphs" Icon="bar_chart">
                <div data-testid="processes-selected-run-graphs-tab">
                    @RenderGraphMetricGrid("Selected run graph projection")

                <label class="text-xs font-semibold text-slate-500" for="processes-definition-manager-override-input">Manager override</label>
                <textarea id="processes-definition-manager-override-input"
                          class="min-h-9 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm"
                          value="@editorManagerOverrideSummary"
                          @oninput="args => editorManagerOverrideSummary = ReadChangeValue(args)"
                          data-testid="processes-definition-editor-manager-override"></textarea>
                <label class="text-xs font-semibold text-slate-500" for="processes-definition-governance-notes-input">Governance notes</label>
                <textarea id="processes-definition-governance-notes-input"
                          class="min-h-9 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm"
                          value="@editorGovernanceNotes"

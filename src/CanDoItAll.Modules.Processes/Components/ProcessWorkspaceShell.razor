                <SurfaceCard Soft="true" data-testid="processes-run-evidence">
                    <TextBlock TextStyle="TextStyle.Eyebrow" Value="Evidence" />
                    <h3 class="text-base font-semibold text-slate-900">Artifacts and decisions</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-600">Evidence, artifact satisfaction, decisions, work briefs, and conformance observations stay attached to the selected run.</p>
                </SurfaceCard>

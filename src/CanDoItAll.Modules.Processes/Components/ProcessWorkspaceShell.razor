                          class="min-h-9 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm"
                          value="@editorSimulationReadinessSummary"
                          @oninput="args => editorSimulationReadinessSummary = ReadChangeValue(args)"
                          data-testid="processes-definition-editor-simulation-readiness"></textarea>

                <div class="rounded-md border border-slate-200 bg-slate-50 p-3" data-testid="processes-definition-lint-panel">
                    <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                        <StatusBadge Tone="@ResolveEditorLintTone(editor.Lint)" Text="@ResolveEditorLintText(editor.Lint)" />
                    </Cluster>
                    @if (!editor.Lint.HasWarningsOrErrors)
                    {
                        <p class="mt-2 text-sm leading-6 text-slate-600">No blocking lint issues.</p>
                    }
                    else
                    {
                        @foreach (var issue in editor.Lint.Issues)
                        {
                            <div class="mt-3 border-t border-slate-200 pt-3">
                                <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                                    <StatusBadge Tone="@ResolveLintIssueTone(issue.Severity)" Text="@issue.Severity.ToString()" />
                                    <span class="text-xs font-semibold text-slate-500">@issue.Section.ToString()</span>
                                    <span class="text-xs text-slate-500">@issue.Code</span>
                                </Cluster>
                                <p class="mt-2 text-sm leading-6 text-slate-700">@issue.Message</p>
                                <p class="text-xs leading-5 text-slate-500">@issue.Suggestion</p>
                            </div>
                        }
                    }
                </div>
            </Stack>
        </Grid>

        <Cluster Gap="LayoutGap.Small" Class="mt-5 flex-wrap justify-end">
            @foreach (var command in editor.Commands)
            {
                <Button Text="@command.Text"
                        Icon="@command.Icon"
                        ButtonStyle="@ResolveDefinitionEditorCommandButtonStyle(command.Kind)"
                        Size="ButtonSize.Small"
                        Disabled="@(!command.IsEnabled || isBusy)"
                        IsBusy="@isBusy"
                        Click="@(() => ExecuteDefinitionEditorCommandAsync(command.Kind))"
                        title="@command.DisabledReason"
                        data-testid="@BuildDefinitionEditorCommandTestId(command.Kind)" />
            }
        </Cluster>
    </div>;

    private void SyncDefinitionEditor(ProcessDefinitionEditorProjection? editor)
    {
        if (editor is null)
        {
            editorDefinitionKey = null;
            editorVersionToken = null;
            editorCommandNotice = null;
            return;
        }

        editorDefinitionKey = editor.DefinitionKey;
        editorVersionToken = editor.VersionToken;
        editorCommandNotice = editor.LastCommandReceipt?.Summary;
        editorName = editor.Identity.Name;
        editorCustomerName = editor.Identity.CustomerName;
        editorOwnerName = editor.Identity.OwnerName;
        editorSummary = editor.Identity.Summary;
        editorValueStatement = editor.Identity.ValueStatement;
        editorCriticality = editor.Governance.Criticality == ProcessDefinitionCriticalityLevel.Unspecified
            ? ProcessDefinitionCriticalityLevel.Standard
            : editor.Governance.Criticality;
        editorAutonomyLevel = editor.Governance.AutonomyLevel == ProcessDefinitionAutonomyLevel.Unspecified
            ? ProcessDefinitionAutonomyLevel.Assisted
            : editor.Governance.AutonomyLevel;
        editorOperatingMode = editor.Governance.OperatingMode == ProcessDefinitionOperatingModeKind.Unspecified
            ? ProcessDefinitionOperatingModeKind.AssistedExecution
            : editor.Governance.OperatingMode;
        editorWorkingStatus = editor.Status;
        editorManagerOverrideSummary = editor.Governance.ManagerOverrideSummary;
        editorGovernanceNotes = editor.Governance.GovernanceNotes;
        editorChangeSummary = editor.Governance.ChangeSummary;
        editorGovernancePolicySummary = editor.Governance.GovernancePolicySummary;
        editorInterfaceContractSummary = editor.Contracts.InterfaceContractSummary;
        editorConstitutionRuleSummary = editor.Contracts.ConstitutionRuleSummary;
        editorOperatingModeSummary = editor.Contracts.OperatingModeSummary;
        editorSimulationReadinessSummary = editor.Simulation.SimulationReadinessSummary;
        editorStepCount = editor.Simulation.StepCount;
        editorRequiredRoleCount = editor.Simulation.RequiredRoleCount;
        editorRequiredArtifactExpectationCount = editor.Simulation.RequiredArtifactExpectationCount;
    }

    private async Task ExecuteDefinitionEditorCommandAsync(ProcessDefinitionEditorCommandKind commandKind)
    {
        var editor = DefinitionCatalog.SelectedEditor;
        if (editor is null)
        {
            return;
        }

        isBusy = true;
        errorMessage = null;

        try
        {
            var result = await ProjectionClient.ExecuteDefinitionEditorCommandAsync(new ProcessDefinitionEditorCommand(
                ResolveScope(),
                editor.DefinitionKey,
                commandKind,
                editorVersionToken,
                CreateDefinitionEditorDraft(editor)));
            editorCommandNotice = result.Receipt.Summary;
            ApplyDefinitionEditorProjection(result.Projection);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ApplyDefinitionEditorProjection(ProcessDefinitionEditorProjection projection)
    {
        if (shell is not null)
        {
            var selectedEditor = projection;
            if (selectedEditor.RoleEditor is null && shell.DefinitionCatalog.SelectedEditor?.RoleEditor is { } roleEditor)
            {
                selectedEditor = selectedEditor with { RoleEditor = roleEditor };
            }

            if (selectedEditor.Canvas is null && shell.DefinitionCatalog.SelectedEditor?.Canvas is { } canvas)
            {
                selectedEditor = selectedEditor with { Canvas = canvas };
            }

            if (selectedEditor.StepEditor is null && shell.DefinitionCatalog.SelectedEditor?.StepEditor is { } stepEditor)
            {
                selectedEditor = selectedEditor with { StepEditor = stepEditor };
            }

            if (selectedEditor.TemplateCatalog is null && shell.DefinitionCatalog.SelectedEditor?.TemplateCatalog is { } templateCatalog)
            {
                selectedEditor = selectedEditor with { TemplateCatalog = templateCatalog };
            }

            shell = shell with
            {
                DefinitionCatalog = shell.DefinitionCatalog with
                {
                    SelectedDefinitionKey = selectedEditor.DefinitionKey,
                    SelectedEditor = selectedEditor
                }
            };
            SyncDefinitionEditor(selectedEditor);
            return;
        }

        SyncDefinitionEditor(projection);
    }


            </TabsItem>
            <TabsItem Text="Coordination" Icon="hub">
                <SurfaceCard Soft="true" data-testid="processes-run-coordination">
                    <TextBlock TextStyle="TextStyle.Eyebrow" Value="Coordination" />
                    <h3 class="text-base font-semibold text-slate-900">Assignments and direct role messaging</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-600">Run-scoped staffing and direct messaging remain in the runtime workspace rather than the definition form.</p>

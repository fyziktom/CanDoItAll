                          value="@editorSummary"
                          @oninput="args => editorSummary = ReadChangeValue(args)"
                          data-testid="processes-definition-editor-summary"></textarea>
                <label class="text-xs font-semibold text-slate-500" for="processes-definition-editor-value-input">Value statement</label>
                <textarea id="processes-definition-editor-value-input"
                          class="min-h-9 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm"
                          value="@editorValueStatement"
                          @oninput="args => editorValueStatement = ReadChangeValue(args)"

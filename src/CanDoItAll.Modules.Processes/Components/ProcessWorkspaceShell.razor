        if (Enum.TryParse<ProcessRuntimeHistoryWindow>(ReadChangeValue(args), out var parsed))
        {
            runtimeHistoryWindow = parsed;
            runtimeEventPage = 0;
            await LoadAsync(forceRefresh: false);
        }
    }

    private async Task SelectRuntimeRunAsync(ChangeEventArgs args)
    {
        var value = ReadChangeValue(args);
        selectedRuntimeRunId = Guid.TryParse(value, out var parsed) && parsed != Guid.Empty
            ? parsed
            : null;
        runtimeEventPage = 0;
        managerChatDraftPrompt = string.Empty;
        await LoadAsync(forceRefresh: false);
    }

    private async Task SelectRuntimeRunAsync(Guid runId)
    {
        selectedRuntimeRunId = runId == Guid.Empty ? null : runId;
        runtimeEventPage = 0;
        managerChatDraftPrompt = string.Empty;
        await LoadAsync(forceRefresh: false);

        try
        {
            var result = await ProjectionClient.ExecuteDefinitionRoleEditorCommandAsync(command);
            ApplyDefinitionRoleEditorProjection(result.Projection);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {

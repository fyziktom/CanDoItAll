    private void ApplyTemplateCatalogProjection(ProcessTemplateCatalogProjection projection)
    {
        if (shell?.DefinitionCatalog.SelectedEditor is null)
        {
            return;
        }

        var selectedEditor = shell.DefinitionCatalog.SelectedEditor with
        {
            TemplateCatalog = projection
        };
        shell = shell with
        {
            DefinitionCatalog = shell.DefinitionCatalog with
            {
                SelectedEditor = selectedEditor
            }
        };
        SyncTemplateCatalogQuery(projection);
    }

    private void ApplyDefinitionRoleEditorProjection(ProcessDefinitionRoleEditorProjection projection)
    {
        if (shell?.DefinitionCatalog.SelectedEditor is null)
        {
            return;
        }

        var selectedEditor = shell.DefinitionCatalog.SelectedEditor with
        {
            RoleEditor = projection
        };
        shell = shell with
        {
            DefinitionCatalog = shell.DefinitionCatalog with
            {
                SelectedEditor = selectedEditor
            }
        };
    }

    private async Task ExecuteDefinitionCanvasCommandAsync(ProcessDefinitionCanvasCommand command)
    {
        isBusy = true;
        errorMessage = null;

        try
        {
            var result = await ProjectionClient.ExecuteDefinitionCanvasCommandAsync(command);
            ApplyDefinitionCanvasProjection(result.Projection);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ApplyDefinitionCanvasProjection(ProcessDefinitionCanvasEditorProjection projection)
    {
        if (shell?.DefinitionCatalog.SelectedEditor is null)
        {
            return;
        }

        var selectedEditor = shell.DefinitionCatalog.SelectedEditor with
        {
            Canvas = projection
        };
        shell = shell with
        {
            DefinitionCatalog = shell.DefinitionCatalog with
            {
                SelectedEditor = selectedEditor
            }
        };
    }


                <label class="text-xs font-semibold text-slate-500" for="processes-definition-editor-customer-input">Customer</label>
                <input id="processes-definition-editor-customer-input"
                       class="min-h-9 w-full rounded-md border border-slate-300 px-3 text-sm text-slate-900 shadow-sm"
                       value="@editorCustomerName"
                       @oninput="args => editorCustomerName = ReadChangeValue(args)"
                       data-testid="processes-definition-editor-customer" />
                <label class="text-xs font-semibold text-slate-500" for="processes-definition-editor-summary-input">Summary</label>
                <textarea id="processes-definition-editor-summary-input"

@namespace CanDoItAll.Modules.Processes
@using System.Globalization
@inject IProcessWorkspaceProjectionClient ProjectionClient
@inject NavigationManager Navigation

<PageScaffold MaxWidthClass="max-w-full">
    <Header>
        <PageHeader Eyebrow="@ScopeEyebrow"
                    Title="@HeaderTitle"
                    Description="@HeaderDescription"
                    Compact="true">
            <Stats>
                <CompactStat Label="definitions"
                             Value="@DefinitionTotalText"
                             TooltipText="@DefinitionTooltip"
                             Tone="info" />
                <CompactStat Label="active runs"
                             Value="@LiveRunActiveText"
                             TooltipText="@LiveRunTooltip"
                             Tone="success" />
                <CompactStat Label="attention"
                             Value="@LiveRunAttentionText"
                             TooltipText="Runs projected as needing operator attention."
                             Tone="warning" />
                <CompactStat Label="projection"
                             Value="@ProjectionStatusText"
                             TooltipText="@ProjectionTooltip"
                             Tone="@ProjectionTone" />
            </Stats>
            <Actions>
                <PageHeaderActionButton Icon="refresh"
                                        Label="Refresh"
                                        TooltipText="Refresh process shell projections."
                                        Disabled="@isBusy"
                                        IsBusy="@isBusy"
                                        Click="RefreshAsync"
                                        data-testid="processes-refresh" />
                <PageHeaderActionButton Icon="smart_toy"
                                        Label="Agent context"
                                        TooltipText="@AgentContextTooltip"
                                        Disabled="@AgentContextDisabled"
                                        Click="OpenAgentContext"
                                        data-testid="processes-agent-context" />
            </Actions>
        </PageHeader>
    </Header>

    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <SurfaceCard Soft="true" data-testid="processes-shell-error">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Action required" />
                <h2 class="text-base font-semibold text-rose-900">Process shell projection failed</h2>
                <p class="mt-2 text-sm leading-6 text-rose-700">@errorMessage</p>
            </SurfaceCard>
        }

        @if (shell is null)
        {
            <SurfaceCard data-testid="processes-shell-loading">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Loading" />
                <h2 class="text-base font-semibold text-slate-900">Refreshing process workspace</h2>
            </SurfaceCard>
        }
        else
        {
            <Stack GapScale="LayoutGap.Medium"
                   Class="processes-workspace-root min-h-0"
                   data-testid="processes-shell">
                <Toolbar Class="processes-command-strip"
                         data-testid="processes-command-strip">
                    <ToolbarRow Class="processes-command-strip__row">
                        <CompactStatStrip Class="min-w-0">
                            <p class="cda-eyebrow whitespace-nowrap">@ScopeEyebrow</p>
                            <CompactStat Tone="info"
                                         Text="@($"{DefinitionTotalText} definition(s)")"
                                         TooltipText="@DefinitionTooltip" />
                            <CompactStat Tone="success"
                                         Text="@($"{LiveRunActiveText} active")"
                                         TooltipText="@LiveRunTooltip" />
                            <CompactStat Tone="warning"
                                         Text="@($"{LiveRunAttentionText} attention")"
                                         TooltipText="Runs projected as needing operator attention." />
                            <CompactStat Tone="@ProjectionTone"
                                         Text="@ProjectionStatusText"
                                         TooltipText="@ProjectionTooltip" />
                        </CompactStatStrip>

                        <ToolbarActions Class="processes-command-strip__actions">
                            @foreach (var command in shell.Commands)
                            {
                                <PageHeaderActionButton Icon="@command.Icon"
                                                        Label="@command.Text"
                                                        TooltipText="@(command.DisabledReason ?? command.Text)"
                                                        Disabled="@(!command.IsEnabled)"
                                                        Click="@(() => ExecuteCommandAsync(command))"
                                                        data-testid="@BuildCommandTestId(command.Kind)" />
                            }
                        </ToolbarActions>
                    </ToolbarRow>
                </Toolbar>

                @if (!string.IsNullOrWhiteSpace(agentContextNotice))
                {
                    <p class="text-xs font-semibold text-slate-500" data-testid="processes-agent-context-notice">@agentContextNotice</p>
                }

                <ListDetailShell ListPaneWidth="28rem"
                                 Dense="true"
                                 ListPaneClass="h-full min-h-0"
                                 DetailPaneClass="h-full min-h-0"
                                 data-testid="processes-workspace-list-detail">
                    <ListHeader>
                        <ListPanelHeader Title="Process definitions"
                                         Description=""
                                         Dense="true"
                                         HelpText="Browse process contracts, filter the library, and keep selection synchronized with the detail workspace."
                                         Count="@($"{DefinitionCatalog.Items.Count} definition(s)")">
                            <Filters>
                                <FilterBar>
                                    <input class="cda-input min-w-[16rem] flex-1"
                                           value="@pendingSearchText"
                                           @oninput="UpdateDefinitionSearchText"
                                           placeholder="Search definitions"
                                           aria-label="Search process definitions"
                                           data-testid="processes-definition-search" />
                                    <Button Icon="search"
                                            Class="cda-button--quick"
                                            ButtonStyle="ButtonStyle.Light"
                                            Size="ButtonSize.Small"
                                            title="Search definitions"
                                            aria-label="Search definitions"
                                            Disabled="@isBusy"
                                            Click="ApplyDefinitionSearchAsync"
                                            data-testid="processes-definition-search-submit" />
                                    <Button Icon="close"
                                            Class="cda-button--quick"
                                            ButtonStyle="ButtonStyle.Light"
                                            Size="ButtonSize.Small"
                                            title="Clear search"
                                            aria-label="Clear search"
                                            Disabled="@isBusy"
                                            Click="ClearDefinitionSearchAsync"
                                            data-testid="processes-definition-search-clear" />
                                </FilterBar>
                            </Filters>
                        </ListPanelHeader>
                    </ListHeader>

                    <ListContent>
                        @RenderDefinitionListPane()
                    </ListContent>

                    <DetailHeader>
                        @RenderDefinitionIdentityHeader()
                    </DetailHeader>

                    <DetailContent>
                        <Tabs @bind-SelectedIndex="activeTabIndex"
                              RenderMode="TabRenderMode.Server"
                              Variant="TabsVariant.WorkspaceSecondary"
                              BorderMode="TabsBorderMode.Soft"
                              OverflowMode="TabsOverflowMode.Auto"
                              PanelOverflowMode="TabsPanelOverflowMode.Auto"
                              FillHeight="true"
                              Class="h-full min-h-0 w-full min-w-0"
                              AriaLabel="Process workspace detail panels"
                              data-testid="processes-tabs">
                            @foreach (var tab in shell.Tabs)
                            {
                                <TabsItem Text="@tab.Text"
                                          Icon="@tab.Icon"
                                          BadgeText="@tab.CountText"
                                          Disabled="@(!tab.IsEnabled)"
                                          data-testid="@BuildTabTestId(tab.Key)">
                                    @RenderTab(tab)
                                </TabsItem>
                            }
                        </Tabs>
                    </DetailContent>
                </ListDetailShell>
            </Stack>
        }
    </ChildContent>
</PageScaffold>

@code {
    [Parameter]
    public Guid? ProjectId { get; set; }

    [Parameter]
    public Guid? ProcessIdQuery { get; set; }

    [Parameter]
    public Guid? RunIdQuery { get; set; }

    [Parameter]
    public Guid? LaunchPlanIdQuery { get; set; }

    [Parameter]
    public string? DefinitionSearchText { get; set; }

    [Parameter]
    public string? SelectedDefinitionKey { get; set; }

    [Parameter]
    public bool LiveRoute { get; set; }

    private ProcessWorkspaceShellProjection? shell;
    private int activeTabIndex;
    private bool isBusy;
    private string? errorMessage;
    private string? agentContextNotice;
    private string searchText = string.Empty;
    private string pendingSearchText = string.Empty;
    private string? selectedDefinitionKey;
    private ProcessDefinitionCatalogScopeKind selectedDefinitionScope = ProcessDefinitionCatalogScopeKind.All;
    private string? catalogCommandNotice;
    private ProcessDefinitionCatalogItemKey? editorDefinitionKey;
    private ProcessDefinitionEditorVersionToken? editorVersionToken;
    private string? editorCommandNotice;
    private string editorName = string.Empty;
    private string editorCustomerName = string.Empty;
    private string editorOwnerName = string.Empty;
    private string editorSummary = string.Empty;
    private string editorValueStatement = string.Empty;
    private string editorManagerOverrideSummary = string.Empty;
    private string editorGovernanceNotes = string.Empty;
    private string editorChangeSummary = string.Empty;
    private string editorGovernancePolicySummary = string.Empty;
    private string editorInterfaceContractSummary = string.Empty;
    private string editorConstitutionRuleSummary = string.Empty;
    private string editorOperatingModeSummary = string.Empty;
    private string editorSimulationReadinessSummary = string.Empty;
    private ProcessDefinitionCriticalityLevel editorCriticality = ProcessDefinitionCriticalityLevel.Standard;
    private ProcessDefinitionAutonomyLevel editorAutonomyLevel = ProcessDefinitionAutonomyLevel.Assisted;
    private ProcessDefinitionOperatingModeKind editorOperatingMode = ProcessDefinitionOperatingModeKind.AssistedExecution;
    private ProcessDefinitionAuthoringStatus editorWorkingStatus = ProcessDefinitionAuthoringStatus.TemplateDefault;
    private int editorStepCount;
    private int editorRequiredRoleCount;
    private int editorRequiredArtifactExpectationCount;
    private string templateSearchText = string.Empty;
    private ProcessTemplateCatalogCategoryKind selectedTemplateCategory = ProcessTemplateCatalogCategoryKind.All;
    private ProcessTemplateCatalogItemKey? selectedTemplateItemKey;
    private ProcessTemplateCatalogPreviewTabKind selectedTemplatePreviewTab = ProcessTemplateCatalogPreviewTabKind.Overview;

    private static readonly ProcessDefinitionCriticalityLevel[] CriticalityOptions =
    [
        ProcessDefinitionCriticalityLevel.Low,
        ProcessDefinitionCriticalityLevel.Standard,
        ProcessDefinitionCriticalityLevel.High,
        ProcessDefinitionCriticalityLevel.MissionCritical
    ];

    private static readonly ProcessDefinitionAutonomyLevel[] AutonomyOptions =
    [
        ProcessDefinitionAutonomyLevel.Manual,
        ProcessDefinitionAutonomyLevel.Assisted,
        ProcessDefinitionAutonomyLevel.Guarded,
        ProcessDefinitionAutonomyLevel.Delegated
    ];

    private static readonly ProcessDefinitionOperatingModeKind[] OperatingModeOptions =
    [
        ProcessDefinitionOperatingModeKind.Manual,
        ProcessDefinitionOperatingModeKind.AssistedExecution,
        ProcessDefinitionOperatingModeKind.GovernedLive
    ];

    private string ScopeEyebrow => ProjectId.HasValue ? "Project processes" : "Processes";

    private string HeaderTitle => shell?.Title ?? ScopeEyebrow;

    private string HeaderDescription
        => shell?.Subtitle ?? "Projection-first process workspace.";

    private string DefinitionTotalText
        => shell is null
            ? "0"
            : (shell.DefinitionCatalog.PublishedDefinitionCount + shell.DefinitionCatalog.DraftDefinitionCount).ToString(CultureInfo.InvariantCulture);

    private string DefinitionTooltip
        => shell?.DefinitionCatalog.Summary ?? "Definition catalog projection is loading.";

    private string LiveRunActiveText
        => shell?.LiveRuns.ActiveRunCount.ToString(CultureInfo.InvariantCulture) ?? "0";

    private string LiveRunAttentionText
        => shell?.LiveRuns.AttentionRunCount.ToString(CultureInfo.InvariantCulture) ?? "0";

    private string LiveRunTooltip
        => shell?.LiveRuns.Summary ?? "Live run projection is loading.";

    private string ProjectionStatusText
        => shell?.Refresh.Status switch
        {
            ProcessWorkspaceProjectionStatus.Ready => "Ready",
            ProcessWorkspaceProjectionStatus.RefreshRequested => "Refresh requested",
            ProcessWorkspaceProjectionStatus.ProjectionStoreUnavailable => "Store pending",
            _ => "Loading"
        };

    private string ProjectionTooltip
        => shell?.Refresh.Summary ?? "Projection freshness is loading.";

    private string ProjectionTone
        => shell?.Refresh.Status switch
        {
            ProcessWorkspaceProjectionStatus.Ready => "success",
            ProcessWorkspaceProjectionStatus.RefreshRequested => "info",
            ProcessWorkspaceProjectionStatus.ProjectionStoreUnavailable => "warning",
            _ => "neutral"
        };

    private bool AgentContextDisabled
        => isBusy || shell?.AgentEntry.IsAvailable != true;

    private string AgentContextTooltip
        => shell?.AgentEntry.DisabledReason ?? shell?.AgentEntry.ContextKey ?? "Process agent context is loading.";

    private ProcessDefinitionCatalogProjection DefinitionCatalog
        => shell?.DefinitionCatalog ?? throw new InvalidOperationException("Definition catalog is not loaded.");

    protected override async Task OnParametersSetAsync()
    {
        searchText = DefinitionSearchText?.Trim() ?? string.Empty;
        pendingSearchText = searchText;
        selectedDefinitionKey = string.IsNullOrWhiteSpace(SelectedDefinitionKey)
            ? null
            : SelectedDefinitionKey.Trim();
        await LoadAsync(forceRefresh: false);
    }

    private async Task RefreshAsync()
    {
        await LoadAsync(forceRefresh: true);
    }

    private async Task LoadAsync(bool forceRefresh)
    {
        isBusy = true;
        errorMessage = null;

        try
        {
            var request = new ProcessWorkspaceShellRequest(
                ResolveScope(),
                new ProcessWorkspaceSelectionProjection(ProcessIdQuery, RunIdQuery, LaunchPlanIdQuery),
                new ProcessDefinitionCatalogQueryProjection(
                    searchText,
                    string.IsNullOrWhiteSpace(selectedDefinitionKey)
                        ? null
                        : new ProcessDefinitionCatalogItemKey(selectedDefinitionKey),
                    selectedDefinitionScope,
                    Take: 50),
                new ProcessTemplateCatalogQueryProjection(
                    templateSearchText,
                    selectedTemplateCategory,
                    selectedTemplateItemKey,
                    selectedTemplatePreviewTab,
                    Take: 50),
                forceRefresh);

            shell = await ProjectionClient.GetShellAsync(request);
            activeTabIndex = ResolveActiveTabIndex(shell);
            SyncDefinitionEditor(shell.DefinitionCatalog.SelectedEditor);
            SyncTemplateCatalogQuery(shell.DefinitionCatalog.SelectedEditor?.TemplateCatalog);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            errorMessage = exception.Message;
            shell = null;
        }
        finally
        {
            isBusy = false;
        }
    }

    private ProcessWorkspaceShellScope ResolveScope()
        => ProjectId.HasValue
            ? ProcessWorkspaceShellScope.ForProject(ProjectId.Value)
            : ProcessWorkspaceShellScope.Global;

    private int ResolveActiveTabIndex(ProcessWorkspaceShellProjection projection)
    {
        var preferredTab = LiveRoute || RunIdQuery.HasValue
            ? ProcessWorkspaceTabKey.LiveRuns
            : LaunchPlanIdQuery.HasValue
                ? ProcessWorkspaceTabKey.LaunchPlans
                : ProcessWorkspaceTabKey.Definitions;
        var index = projection.Tabs
            .Select((tab, tabIndex) => new { tab.Key, Index = tabIndex })
            .FirstOrDefault(item => item.Key == preferredTab)?.Index;

        return index ?? 0;
    }

    private async Task ExecuteCommandAsync(ProcessWorkspaceCommandProjection command)
    {
        if (!command.IsEnabled)
        {
            return;
        }

        switch (command.Kind)
        {
            case ProcessWorkspaceCommandKind.RefreshProjections:
                await RefreshAsync();
                break;
            case ProcessWorkspaceCommandKind.OpenAgentContext:
                OpenAgentContext();
                break;
            case ProcessWorkspaceCommandKind.FeedDefaults:
                await FeedDefaultsAsync();
                break;
            case ProcessWorkspaceCommandKind.OpenLiveDashboard:
                Navigation.NavigateTo(ProjectId.HasValue
                    ? $"/projects/{ProjectId.Value:D}/processes/live"
                    : "/processes/live");
                break;
        }
    }

    private void OpenAgentContext()
    {
        if (shell?.AgentEntry.IsAvailable != true)
        {
            return;
        }

        agentContextNotice = shell.AgentEntry.ContextKey;
        Navigation.NavigateTo($"/agents?processContext={Uri.EscapeDataString(shell.AgentEntry.ContextKey)}");
    }

    private void UpdateDefinitionSearchText(ChangeEventArgs args)
    {
        pendingSearchText = args.Value?.ToString() ?? string.Empty;
    }

    private async Task ApplyDefinitionSearchAsync()
    {
        searchText = pendingSearchText.Trim();
        selectedDefinitionKey = null;
        selectedTemplateItemKey = null;
        await LoadAsync(forceRefresh: false);
    }

    private async Task ClearDefinitionSearchAsync()
    {
        pendingSearchText = string.Empty;
        searchText = string.Empty;
        selectedDefinitionKey = null;
        selectedTemplateItemKey = null;
        await LoadAsync(forceRefresh: false);
    }

    private async Task SelectDefinitionAsync(ProcessDefinitionCatalogItemKey key)
    {
        selectedDefinitionKey = key.Value;
        selectedTemplateItemKey = null;
        await LoadAsync(forceRefresh: false);
    }

    private async Task SelectDefinitionScopeAsync(ProcessDefinitionCatalogScopeKind scopeKind)
    {
        selectedDefinitionScope = scopeKind;
        selectedDefinitionKey = null;
        selectedTemplateItemKey = null;
        await LoadAsync(forceRefresh: false);
    }

    private async Task FeedDefaultsAsync()
    {
        isBusy = true;
        errorMessage = null;

        try
        {
            var receipt = await ProjectionClient.FeedDefaultDefinitionsAsync(
                new ProcessDefinitionFeedDefaultsCommand(ResolveScope()));
            catalogCommandNotice = $"{receipt.Summary} Refresh token: {receipt.RefreshToken.Value}.";
            await LoadAsync(forceRefresh: true);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private RenderFragment RenderTab(ProcessWorkspaceTabProjection tab) => @<SurfaceCard Soft="true" data-testid="@BuildTabPanelTestId(tab.Key)">
        <Split Gap="LayoutGap.Small">
            <Stack GapScale="LayoutGap.Tiny">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="@ResolveTabEyebrow(tab.Key)" />
                <h2 class="text-base font-semibold text-slate-900">@tab.Text</h2>
                <p class="text-sm leading-6 text-slate-600">@tab.Description</p>
            </Stack>
            <StatusBadge Tone="@ResolveTabTone(tab.Key)" Text="@ResolveTabStatus(tab.Key)" />
        </Split>

        <div class="mt-5">
            @switch (tab.Key)
            {
                case ProcessWorkspaceTabKey.Definitions:
                    @RenderDefinitionCatalog()
                    break;
                case ProcessWorkspaceTabKey.LaunchPlans:
                    <EmptyState Eyebrow="Launch projection"
                                Title="Launch planning status"
                                Description="Launch-plan projections are exposed through the shell; runtime launch commands are disabled until the command surface is connected." />
                    break;
                case ProcessWorkspaceTabKey.LiveRuns:
                    <EmptyState Eyebrow="Runtime projection"
                                Title="Live run status"
                                Description="@shell!.LiveRuns.Summary" />
                    break;
                case ProcessWorkspaceTabKey.History:
                    <EmptyState Eyebrow="Read-only projection"
                                Title="Runtime history status"
                                Description="Runtime history and legacy archive labels flow through projection contracts before detailed history views are enabled." />
                    break;
            }
        </div>
    </SurfaceCard>;

    private RenderFragment RenderDefinitionListPane() => @<Stack GapScale="LayoutGap.Medium"
                                                                 Class="h-full min-h-0 overflow-y-auto pr-1"
                                                                 data-testid="processes-definition-list-scroll">
        <Stack GapScale="LayoutGap.Small"
               data-testid="processes-definition-scopes">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Scope" />
            <Cluster Gap="LayoutGap.XSmall"
                     Class="flex-wrap">
                @foreach (var scope in DefinitionCatalog.ScopeGroups)
                {
                    <Button Text="@($"{scope.Label} ({scope.Count})")"
                            Icon="@ResolveScopeIcon(scope.ScopeKind)"
                            Size="ButtonSize.Small"
                            ButtonStyle="@(scope.IsSelected ? ButtonStyle.Primary : ButtonStyle.Light)"
                            Click="@(() => SelectDefinitionScopeAsync(scope.ScopeKind))"
                            title="@scope.Description"
                            data-testid="@BuildScopeTestId(scope.ScopeKind)" />
                }
            </Cluster>
        </Stack>

        @if (!string.IsNullOrWhiteSpace(catalogCommandNotice))
        {
            <p class="text-xs font-semibold text-slate-500" data-testid="processes-feed-defaults-receipt">@catalogCommandNotice</p>
        }

        <Stack GapScale="LayoutGap.Small"
               data-testid="processes-definition-results">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Definitions" />
            @if (DefinitionCatalog.Items.Count == 0)
            {
                <EmptyState Eyebrow="No matches"
                            Title="No definitions match the current search"
                            Description="Clear the search or use a broader definition term." />
            }
            else
            {
                @foreach (var item in DefinitionCatalog.Items)
                {
                    <button type="button"
                            class="processes-definition-list-item @(item.Key == DefinitionCatalog.SelectedDefinitionKey ? "processes-definition-list-item--selected" : string.Empty)"
                            @onclick="@(() => SelectDefinitionAsync(item.Key))"
                            data-testid="@BuildDefinitionItemTestId(item.Key)">
                        <span class="processes-definition-list-item__title">@item.Name</span>
                        <span class="processes-definition-list-item__summary">@item.Summary</span>
                        <span class="processes-definition-list-item__badges">
                            <StatusBadge Tone="@ResolveDefinitionTone(item.Status)" Text="@item.Status.ToString()" />
                            <StatusBadge Tone="neutral" Text="@item.Criticality" />
                        </span>
                    </button>
                }
            }
        </Stack>
    </Stack>;

    private RenderFragment RenderDefinitionIdentityHeader() => @<SurfaceCard Class="processes-workspace-identity">
        <Split Breakpoint="LayoutBreakpoint.None"
               AlignItems="AlignItems.Center"
               Gap="LayoutGap.Small"
               Wrap="FlexWrap.Wrap">
            <Cluster Gap="LayoutGap.Small"
                     Wrap="FlexWrap.NoWrap"
                     Class="processes-workspace-identity__copy">
                <p class="cda-eyebrow">Process</p>
                <h2 class="processes-workspace-identity__title">@(DefinitionCatalog.SelectedItem?.Name ?? HeaderTitle)</h2>
            </Cluster>
            <CompactStatStrip Class="processes-workspace-identity__badges">
                @if (DefinitionCatalog.SelectedItem is { } selected)
                {
                    <CompactStat Tone="@ResolveDefinitionTone(selected.Status)"
                                 Text="@selected.Status.ToString()"
                                 TooltipText="@($"Definition status: {selected.Status}.")" />
                    <CompactStat Tone="neutral"
                                 Text="@selected.Criticality"
                                 TooltipText="Definition criticality." />
                    <CompactStat Tone="info"
                                 Text="@selected.OperatingMode"
                                 TooltipText="Definition operating mode." />
                    @if (selected.CompatibilityIssueCount > 0)
                    {
                        <CompactStat Tone="warning"
                                     Text="@($"{selected.CompatibilityIssueCount} review")"
                                     TooltipText="Template compatibility issues for the selected definition." />
                    }
                }
                else
                {
                    <CompactStat Tone="neutral"
                                 Text="No selection"
                                 TooltipText="Select a process definition from the list." />
                }
            </CompactStatStrip>
        </Split>
    </SurfaceCard>;

    private RenderFragment RenderDefinitionCatalog() => @<div data-testid="processes-definition-catalog">
        @if (DefinitionCatalog.SelectedEditor is not null)
        {
            @RenderDefinitionEditor(DefinitionCatalog.SelectedEditor)
            @if (DefinitionCatalog.SelectedEditor.TemplateCatalog is not null)
            {
                <ProcessTemplateLibraryPanel TemplateCatalog="DefinitionCatalog.SelectedEditor.TemplateCatalog"
                                             Scope="ResolveScope()"
                                             Disabled="@isBusy"
                                             QueryChanged="ApplyTemplateCatalogQueryAsync"
                                             ExecuteImport="ExecuteTemplateImportCommandAsync" />
            }
            @if (DefinitionCatalog.SelectedEditor.Canvas is not null)
            {
                <ProcessDefinitionCanvasPanel Canvas="DefinitionCatalog.SelectedEditor.Canvas"
                                              Scope="ResolveScope()"
                                              Disabled="@isBusy"
                                              ExecuteCommand="ExecuteDefinitionCanvasCommandAsync" />
            }
            @if (DefinitionCatalog.SelectedEditor.StepEditor is not null)
            {
                <ProcessDefinitionStepEditorPanel StepEditor="DefinitionCatalog.SelectedEditor.StepEditor"
                                                  Scope="ResolveScope()"
                                                  Disabled="@isBusy"
                                                  ExecuteCommand="ExecuteDefinitionStepEditorCommandAsync" />
            }
            @if (DefinitionCatalog.SelectedEditor.RoleEditor is not null)
            {
                <ProcessDefinitionRoleEditorPanel RoleEditor="DefinitionCatalog.SelectedEditor.RoleEditor"
                                                  Scope="ResolveScope()"
                                                  Disabled="@isBusy"
                                                  ExecuteCommand="ExecuteDefinitionRoleEditorCommandAsync" />
            }
        }
    </div>;

    private RenderFragment RenderDefinitionEditor(ProcessDefinitionEditorProjection editor) => @<div class="mt-6 border-t border-slate-200 pt-5" data-testid="processes-definition-editor">
        <Split Gap="LayoutGap.Small">
            <Stack GapScale="LayoutGap.Tiny">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Authoring" />
                <h3 class="text-sm font-semibold text-slate-900">Definition editor</h3>
                <p class="text-sm leading-6 text-slate-600">Edit identity, governance, contract, and simulation-readiness fields through the process projection boundary.</p>
            </Stack>
            <Cluster Gap="LayoutGap.XSmall" Class="flex-wrap">
                <StatusBadge Tone="@ResolveEditorStatusTone(editor.Status)" Text="@editor.Status.ToString()" />
                <StatusBadge Tone="@ResolveEditorLintTone(editor.Lint)" Text="@ResolveEditorLintText(editor.Lint)" />
            </Cluster>
        </Split>

        @if (!string.IsNullOrWhiteSpace(editorCommandNotice) || editor.LastCommandReceipt is not null)
        {
            <p class="mt-3 text-xs font-semibold text-slate-500" data-testid="processes-definition-editor-receipt">
                @(editor.LastCommandReceipt is null ? editorCommandNotice : $"{editor.LastCommandReceipt.Status}: {editor.LastCommandReceipt.Summary}")
            </p>
        }

        <Grid Gap="LayoutGap.Large" ColumnsLg="2" Class="mt-5" data-testid="processes-definition-editor-sections">
            <Stack GapScale="LayoutGap.Small" data-testid="processes-definition-editor-identity">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Identity" />
                <label class="text-xs font-semibold text-slate-500" for="processes-definition-editor-name-input">Name</label>
                <input id="processes-definition-editor-name-input"
                       class="min-h-9 w-full rounded-md border border-slate-300 px-3 text-sm text-slate-900 shadow-sm"
                       value="@editorName"
                       @oninput="args => editorName = ReadChangeValue(args)"
                       data-testid="processes-definition-editor-name" />
                <label class="text-xs font-semibold text-slate-500" for="processes-definition-editor-owner-input">Owner</label>
                <input id="processes-definition-editor-owner-input"
                       class="min-h-9 w-full rounded-md border border-slate-300 px-3 text-sm text-slate-900 shadow-sm"
                       value="@editorOwnerName"
                       @oninput="args => editorOwnerName = ReadChangeValue(args)"
                       data-testid="processes-definition-editor-owner" />
                <label class="text-xs font-semibold text-slate-500" for="processes-definition-editor-customer-input">Customer</label>
                <input id="processes-definition-editor-customer-input"
                       class="min-h-9 w-full rounded-md border border-slate-300 px-3 text-sm text-slate-900 shadow-sm"
                       value="@editorCustomerName"
                       @oninput="args => editorCustomerName = ReadChangeValue(args)"
                       data-testid="processes-definition-editor-customer" />
                <label class="text-xs font-semibold text-slate-500" for="processes-definition-editor-summary-input">Summary</label>
                <textarea id="processes-definition-editor-summary-input"

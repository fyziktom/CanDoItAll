    private async Task OpenManagerChatTabAsync()
    {
        activeDetailTabIndex = ResolveDetailTabIndex(ProcessWorkspaceDetailTabKey.ManagerChat);
        await EnsureManagerChatLoadedAsync();
    }

    private async Task ReloadManagerChatAsync()
    {
        managerChatWorkspace = null;
        await EnsureManagerChatLoadedAsync(forceReload: true);
    }

    private async Task EnsureManagerChatLoadedAsync(bool forceReload = false)
    {
        if (!forceReload && managerChatWorkspace is not null && managerChatAgent is not null)
        {
            return;
        }

        var workspaceService = Services.GetService<IAgentFrameworkWorkspaceService>();
        if (workspaceService is null)
        {
            managerChatErrorMessage = "Agent workspace service is not registered for this module instance.";
            return;
        }

        managerChatIsLoading = true;
        managerChatErrorMessage = null;

        try
        {
            managerChatAgents = await workspaceService.ListAgentsAsync(includeTemplates: false);
            managerChatAgentId = ResolveManagerAgentId(managerChatAgents, managerChatAgentId);
            if (managerChatAgentId is null)
            {
                managerChatAgent = null;
                managerChatWorkspace = null;
                managerChatExecutionLog = [];
                managerChatErrorMessage = "No technical agent is available for process manager chat.";
                return;
            }

            managerChatAgent = managerChatAgents.First(agent => agent.Id == managerChatAgentId.Value);
            managerChatWorkspace = await workspaceService.GetChatAgentWorkspaceAsync(managerChatAgentId.Value, managerChatSessionId);
            managerChatSessionId = managerChatWorkspace.SelectedSessionId;
            var runtimeSnapshot = await workspaceService.GetChatRuntimeSnapshotAsync(managerChatAgentId.Value, managerChatSessionId);
            managerChatExecutionLog = runtimeSnapshot.ExecutionLog;
            ResolveManagerChatRunState();
            if (string.IsNullOrWhiteSpace(managerChatDraftPrompt))
            {
                managerChatDraftPrompt = BuildManagerChatPrompt();
                managerChatComposerKey++;
            }
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            managerChatErrorMessage = exception.Message;
            managerChatWorkspace = null;
        }
        finally
        {
            managerChatIsLoading = false;
        }
    }

    private async Task SelectManagerChatAgentAsync(ChangeEventArgs args)
    {
        managerChatAgentId = Guid.TryParse(ReadChangeValue(args), out var parsed) && parsed != Guid.Empty
            ? parsed
            : null;
        managerChatSessionId = null;
        managerChatWorkspace = null;
        await EnsureManagerChatLoadedAsync(forceReload: true);
    }

    private Task HandleManagerChatDraftPromptChangedAsync(string value)
    {
        managerChatDraftPrompt = value;
        return Task.CompletedTask;
    }

    private async Task SendManagerChatMessageAsync()
    {
        var workspaceService = Services.GetService<IAgentFrameworkWorkspaceService>();
        if (workspaceService is null || managerChatAgentId is null)
        {
            managerChatErrorMessage = "Select a manager agent before sending a message.";
            return;
        }

        var prompt = BuildManagerChatPromptWithContext();
        if (string.IsNullOrWhiteSpace(prompt))
        {
            managerChatErrorMessage = "Enter a manager prompt before sending.";
            return;
        }

        managerChatIsBusy = true;
        managerChatPendingPrompt = managerChatDraftPrompt;
        var previousDraft = managerChatDraftPrompt;
        managerChatDraftPrompt = string.Empty;
        managerChatComposerKey++;

        try
        {
            var result = await workspaceService.SendMessageAsync(managerChatAgentId.Value, managerChatSessionId, prompt);
            managerChatSessionId = result.ChatSessionId;
            managerChatDraftAttachmentPaths = [];
            managerChatWorkspace = await workspaceService.GetChatAgentWorkspaceAsync(managerChatAgentId.Value, managerChatSessionId);
            var runtimeSnapshot = await workspaceService.GetChatRuntimeSnapshotAsync(managerChatAgentId.Value, managerChatSessionId);
            managerChatExecutionLog = runtimeSnapshot.ExecutionLog;
            ResolveManagerChatRunState();
            managerChatErrorMessage = null;
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            managerChatDraftPrompt = previousDraft;
            managerChatComposerKey++;
            managerChatErrorMessage = exception.Message;
        }
        finally
        {
            managerChatPendingPrompt = string.Empty;
            managerChatIsBusy = false;
        }
    }

    private async Task HandleManagerChatApprovalDecisionAsync(bool approved)
    {
        await ContinueManagerChatApprovalAsync(approved, autoApprovePendingToolCalls: false);
    }

    private async Task ApproveManagerChatConversationAsync()
    {
        await ContinueManagerChatApprovalAsync(approved: true, autoApprovePendingToolCalls: true);
    }

    private async Task ContinueManagerChatApprovalAsync(bool approved, bool autoApprovePendingToolCalls)
    {
        var workspaceService = Services.GetService<IAgentFrameworkWorkspaceService>();
        if (workspaceService is null || managerChatAgentId is null || managerChatSessionId is null)
        {
            return;
        }

        managerChatIsBusy = true;
        try
        {
            await workspaceService.RespondToPendingApprovalsAsync(
                managerChatAgentId.Value,
                managerChatSessionId.Value,
                approved,
                autoApprovePendingToolCalls);
            managerChatWorkspace = await workspaceService.GetChatAgentWorkspaceAsync(managerChatAgentId.Value, managerChatSessionId);
            var runtimeSnapshot = await workspaceService.GetChatRuntimeSnapshotAsync(managerChatAgentId.Value, managerChatSessionId);
            managerChatExecutionLog = runtimeSnapshot.ExecutionLog;
            ResolveManagerChatRunState();
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            managerChatErrorMessage = exception.Message;
        }
        finally
        {
            managerChatIsBusy = false;
        }
    }

    private async Task RenameManagerChatSessionAsync(string title)
    {
        var workspaceService = Services.GetService<IAgentFrameworkWorkspaceService>();
        if (workspaceService is null || managerChatAgentId is null || managerChatSessionId is null)
        {
            return;
        }

        managerChatIsBusy = true;
        try
        {
            var session = await workspaceService.RenameChatSessionAsync(managerChatAgentId.Value, managerChatSessionId.Value, title);
            managerChatSessionId = session.Id;
            managerChatWorkspace = await workspaceService.GetChatAgentWorkspaceAsync(managerChatAgentId.Value, managerChatSessionId);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            managerChatErrorMessage = exception.Message;
        }
        finally
        {
            managerChatIsBusy = false;
        }
    }

    private async Task StageManagerChatRunArtifactsAsync()
    {
        var workspaceService = Services.GetService<IAgentFrameworkWorkspaceService>();
        if (workspaceService is null || managerChatWorkspace?.SelectedRun is null)
        {
            managerChatDraftAttachmentPaths = [];
            return;
        }

        var detail = await workspaceService.GetExecutionRunDetailAsync(managerChatWorkspace.SelectedRun.Id);
        managerChatDraftAttachmentPaths = detail.Artifacts
            .Select(item => item.RelativePath)
            .Where(item => !string.IsNullOrWhiteSpace(item))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private Guid? ResolveManagerAgentId(IReadOnlyList<AgentDefinition> agents, Guid? currentAgentId)
    {
        if (currentAgentId is { } current && agents.Any(agent => agent.Id == current))
        {
            return current;
        }

        return agents
            .OrderByDescending(agent => agent.Name.Contains("process", StringComparison.OrdinalIgnoreCase))
            .ThenByDescending(agent => agent.Name.Contains("manager", StringComparison.OrdinalIgnoreCase))
            .ThenBy(agent => agent.Name, StringComparer.OrdinalIgnoreCase)
            .Select(agent => (Guid?)agent.Id)
            .FirstOrDefault();
    }

    private void ResolveManagerChatRunState()
    {
        if (managerChatWorkspace?.SelectedRun is null)
        {
            managerChatRunStateText = string.Empty;
            managerChatRunStateTone = "neutral";
            return;
        }

        managerChatRunStateText = managerChatWorkspace.SelectedRun.State.ToString();
        managerChatRunStateTone = ResolveExecutionTone(managerChatWorkspace.SelectedRun.State);
    }

    private string BuildManagerChatPromptWithContext()
    {
        var prompt = managerChatDraftPrompt.Trim();
        if (string.IsNullOrWhiteSpace(prompt))
        {
            return string.Empty;
        }

        return $"{BuildManagerChatPrompt()}{Environment.NewLine}{Environment.NewLine}User request:{Environment.NewLine}{prompt}";
    }

    private string BuildManagerChatPrompt()
    {
        var selectedRun = CurrentShell.Runtime.SelectedRun;
        var runId = selectedRuntimeRunId ?? CurrentShell.Runtime.SelectedRunId;
        var recentEvents = CurrentShell.Runtime.Events.Take(8)
            .Select(runtimeEvent => $"- {runtimeEvent.OccurredAtUtc:u} {runtimeEvent.EventType}: {runtimeEvent.Summary}")
            .ToArray();
        var eventText = recentEvents.Length == 0
            ? "- No runtime events in the selected page."
            : string.Join(Environment.NewLine, recentEvents);

        return $"""
            Process manager context
            Scope: {CurrentShell.AgentEntry.ContextKey}
            Selected run: {(runId.HasValue ? runId.Value.ToString("D") : "none")}
            Status: {selectedRun?.Status.ToString() ?? "unknown"}
            Attention summary: {CurrentShell.Runtime.AttentionSummary}
            History window: {FormatHistoryWindow(CurrentShell.Runtime.HistoryWindow)}

            Recent runtime events:
            {eventText}
            """;
    }

    private static string BuildRunTitle(ProcessRunDetailProjection run)
        => $"Run {run.RunId.Value.ToString("N")[..8]}";

    private static string BuildRunTitle(ProcessLiveProcessSnapshot run)
        => $"Run {run.RunId.Value.ToString("N")[..8]}";

    private static string BuildRunSubtitle(ProcessLiveProcessSnapshot run)
        => $"{run.Status} / {run.LastEventAtUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)}";

    private static string BuildRunOptionText(ProcessLiveProcessSnapshot run)
        => $"{BuildRunTitle(run)} / {run.Status} / {run.LastEventAtUtc.LocalDateTime:g}";

    private static string BuildRunCardSummary(ProcessLiveProcessSnapshot run)
    {
        var incident = run.Incidents.OrderByDescending(item => item.RaisedAtUtc).FirstOrDefault();
        if (incident is not null)
        {
            return $"Cause: {EnsureSentence(incident.SafeSummary)}";
        }

        var runtimeEvent = ResolveRunCardEvent(run.RecentEvents);
        return runtimeEvent is null
            ? "No recent runtime events are attached to this run."
            : $"{runtimeEvent.EventType}: {runtimeEvent.Summary}";
    }

    private static string ResolveRunStatusTone(ProcessProjectedRunStatus status)
        => status switch
        {
            ProcessProjectedRunStatus.Active => "success",
            ProcessProjectedRunStatus.NeedsAttention => "warning",
            ProcessProjectedRunStatus.Failed => "danger",
            ProcessProjectedRunStatus.Completed => "info",
            ProcessProjectedRunStatus.Cancelled => "neutral",
            _ => "neutral"
        };

    private static string ResolveEventTone(ProcessTimelineEventProjection runtimeEvent)
        => runtimeEvent.Sensitivity == ProcessProjectedSensitivity.Restricted
            ? "warning"
            : runtimeEvent.EventType.StartsWith("Manager", StringComparison.Ordinal)
                ? "info"
                : IsAttentionEventType(runtimeEvent.EventType)
                    ? "warning"
                    : "neutral";

    private static string ResolveManagerMessageTone(ProcessManagerMessageProjection message)
        => message.Sensitivity == ProcessProjectedSensitivity.Restricted
            ? "warning"
            : message.Kind.Contains("Denied", StringComparison.OrdinalIgnoreCase) ||
              message.Kind.Contains("Rejected", StringComparison.OrdinalIgnoreCase) ||
              message.Kind.Contains("Escalated", StringComparison.OrdinalIgnoreCase)
                ? "warning"
                : "info";

    private static ProcessLiveRunEventProjection? ResolveRunCardEvent(IReadOnlyList<ProcessLiveRunEventProjection> events)
        => events
            .OrderByDescending(item => IsAttentionEventType(item.EventType))
            .ThenByDescending(item => item.OccurredAtUtc)
            .FirstOrDefault();

    private static bool IsAttentionEventType(string eventType)
        => eventType.Contains("Blocked", StringComparison.OrdinalIgnoreCase) ||
           eventType.Contains("Failed", StringComparison.OrdinalIgnoreCase) ||
           eventType.Contains("Released", StringComparison.OrdinalIgnoreCase) ||
           eventType.Contains("Denied", StringComparison.OrdinalIgnoreCase) ||
           eventType.Contains("Rejected", StringComparison.OrdinalIgnoreCase) ||
           eventType.Contains("Escalated", StringComparison.OrdinalIgnoreCase) ||
           eventType.Contains("Incident", StringComparison.OrdinalIgnoreCase);

    private static string ResolveExecutionTone(ExecutionState state)
        => state switch
        {
            ExecutionState.Completed => "success",
            ExecutionState.WaitingOnTool => "warning",
            ExecutionState.Failed => "danger",
            ExecutionState.Running or ExecutionState.Preparing or ExecutionState.Persisting => "info",
            _ => "neutral"
        };

    private static string FormatHistoryWindow(ProcessRuntimeHistoryWindow window)
        => window switch
        {
            ProcessRuntimeHistoryWindow.LiveHour => "Last hour",
            ProcessRuntimeHistoryWindow.OneDay => "Last 24 hours",
            ProcessRuntimeHistoryWindow.SevenDays => "Last 7 days",
            ProcessRuntimeHistoryWindow.ThirtyDays => "Last 30 days",
            _ => window.ToString()
        };

    private static string ResolveHistoryWindowText(ProcessRuntimeHistoryWindow window)
        => FormatHistoryWindow(window);

    private static string FormatCurrency(decimal value)
        => value == 0m
            ? "$0.00"
            : value.ToString("C2", CultureInfo.CurrentCulture);

    private static string FormatTokenCount(int value)
        => value.ToString("N0", CultureInfo.CurrentCulture);

    private static string FormatDuration(long durationMs)
    {
        if (durationMs <= 0)
        {
            return "0 min";
        }

        var duration = TimeSpan.FromMilliseconds(durationMs);
        return duration.TotalHours >= 1
            ? $"{duration.TotalHours:N1} h"
            : $"{duration.TotalMinutes:N1} min";
    }

    private static string TrimLabel(string value, int maxLength)
    {
        if (value.Length <= maxLength)
        {
            return value;
        }

        return $"{value[..Math.Max(0, maxLength - 3)]}...";
    }

    private static string EnsureSentence(string value)
    {
        var trimmed = value.Trim();
        if (trimmed.Length == 0 ||
            trimmed.EndsWith(".", StringComparison.Ordinal) ||
            trimmed.EndsWith("!", StringComparison.Ordinal) ||
            trimmed.EndsWith("?", StringComparison.Ordinal))
        {
            return trimmed;
        }

        return $"{trimmed}.";
    }


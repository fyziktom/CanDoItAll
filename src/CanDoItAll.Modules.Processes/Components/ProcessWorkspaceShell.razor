    private static string ResolveEditorLintTone(ProcessDefinitionEditorLintProjection lint)
    {
        if (lint.HasBlockingIssues)
        {
            return "danger";
        }

        return lint.HasWarningsOrErrors ? "warning" : "success";
    }

    private static string ResolveEditorLintText(ProcessDefinitionEditorLintProjection lint)
    {
        if (lint.HasBlockingIssues)
        {
            return $"{lint.Issues.Count(issue => issue.Severity == ProcessDefinitionEditorLintSeverity.Error)} blocking";
        }

        return lint.HasWarningsOrErrors ? $"{lint.Issues.Count} lint issue(s)" : "Lint clear";
    }

    private static string ResolveLintIssueTone(ProcessDefinitionEditorLintSeverity severity)
        => severity switch
        {
            ProcessDefinitionEditorLintSeverity.Error => "danger",
            ProcessDefinitionEditorLintSeverity.Warning => "warning",
            ProcessDefinitionEditorLintSeverity.Info => "info",
            _ => "neutral"
        };


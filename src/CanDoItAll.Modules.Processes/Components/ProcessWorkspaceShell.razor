            @RenderMetricCard("Cost", FormatCurrency(CurrentShell.Runtime.Stats.ActualCost), CurrentShell.Runtime.Stats.ActualCost > 0 ? "success" : "neutral", $"{title}: actual cost projected from runtime usage data when provider metrics are linked.")
            @RenderMetricCard("Tokens", FormatTokenCount(CurrentShell.Runtime.Stats.InputTokens + CurrentShell.Runtime.Stats.OutputTokens), CurrentShell.Runtime.Stats.InputTokens + CurrentShell.Runtime.Stats.OutputTokens > 0 ? "info" : "neutral", "Input, cached input, and output tokens for the selected history scope.")
            @RenderMetricCard("Time", FormatDuration(CurrentShell.Runtime.Stats.DurationMs), CurrentShell.Runtime.Stats.DurationMs > 0 ? "info" : "neutral", "Observed runtime span in the selected history page.")
            @RenderMetricCard("Tool usage", CurrentShell.Runtime.Stats.ToolCallCount.ToString(CultureInfo.InvariantCulture), CurrentShell.Runtime.Stats.ToolCallCount > 0 ? "warning" : "neutral", "Runtime dispatch, step, and manager events grouped as tool/activity usage.")
        </Grid>

        <Grid Gap="LayoutGap.Medium"
              ColumnTemplateXl="minmax(0,1fr) minmax(0,1fr)"
              Class="w-full">
            <CdaChart Title="Runtime activity"
                      Description="Events, manager signals, and grouped tool activity."
                      Series="@RuntimeActivitySeries"
                      Options="@RuntimeActivityChartOptions"
                      Height="320"
                      EmptyText="No runtime events match the selected history window." />
            <CdaChart Title="Token and cost telemetry"
                      Description="Provider usage appears when linked runtime metrics are projected."
                      Series="@RuntimeUsageSeries"
                      Options="@RuntimeUsageChartOptions"
                      Height="320"
                      EmptyText="No provider usage metrics are linked to this process run yet." />
            <CdaChart Title="Tool usage"
                      Description="Most active runtime event/tool categories."
                      Series="@RuntimeToolUsageSeries"
                      Options="@RuntimeToolUsageChartOptions"
                      Height="320"
                      EmptyText="No runtime tool activity is present in this scope." />
        </Grid>
    </Stack>;

    private static readonly CdaChartOptions RuntimeActivityChartOptions = new()

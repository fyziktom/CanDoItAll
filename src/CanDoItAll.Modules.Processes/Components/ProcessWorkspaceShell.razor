    private ProcessDefinitionEditorDraftProjection CreateDefinitionEditorDraft(ProcessDefinitionEditorProjection editor)
        => new(
            editor.DefinitionKey,
            new ProcessDefinitionEditorIdentityProjection(
                editorName,
                editor.Identity.ScopeLabel,
                editorCustomerName,
                editorOwnerName,
                editorSummary,
                editorValueStatement),
            new ProcessDefinitionEditorGovernanceProjection(
                editorCriticality,
                editorAutonomyLevel,
                editorOperatingMode,
                editorWorkingStatus,
                editorManagerOverrideSummary,
                editorGovernanceNotes,
                editorChangeSummary,
                editorGovernancePolicySummary),
            new ProcessDefinitionEditorContractProjection(
                editorInterfaceContractSummary,
                editorConstitutionRuleSummary,
                editorOperatingModeSummary),
            new ProcessDefinitionEditorSimulationProjection(
                editorSimulationReadinessSummary,
                editorStepCount,
                editorRequiredRoleCount,
                editorRequiredArtifactExpectationCount,
                !string.IsNullOrWhiteSpace(editorSimulationReadinessSummary) && editorStepCount > 0));

    private static string ReadChangeValue(ChangeEventArgs args)
        => args.Value?.ToString() ?? string.Empty;

    private static ProcessDefinitionCriticalityLevel ParseCriticality(ChangeEventArgs args)
        => Enum.TryParse<ProcessDefinitionCriticalityLevel>(ReadChangeValue(args), out var parsed)
            ? parsed
            : ProcessDefinitionCriticalityLevel.Standard;

    private static ProcessDefinitionAutonomyLevel ParseAutonomy(ChangeEventArgs args)
        => Enum.TryParse<ProcessDefinitionAutonomyLevel>(ReadChangeValue(args), out var parsed)
            ? parsed
            : ProcessDefinitionAutonomyLevel.Assisted;

    private static ProcessDefinitionOperatingModeKind ParseOperatingMode(ChangeEventArgs args)
        => Enum.TryParse<ProcessDefinitionOperatingModeKind>(ReadChangeValue(args), out var parsed)
            ? parsed
            : ProcessDefinitionOperatingModeKind.AssistedExecution;


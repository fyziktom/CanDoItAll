    private void SyncTemplateCatalogQuery(ProcessTemplateCatalogProjection? templateCatalog)
    {
        if (templateCatalog is null)
        {
            templateSearchText = string.Empty;
            selectedTemplateCategory = ProcessTemplateCatalogCategoryKind.All;
            selectedTemplateItemKey = null;
            selectedTemplatePreviewTab = ProcessTemplateCatalogPreviewTabKind.Overview;
            return;
        }

        templateSearchText = templateCatalog.Query.SearchText ?? string.Empty;
        selectedTemplateCategory = templateCatalog.Query.Category;
        selectedTemplateItemKey = templateCatalog.Query.SelectedItemKey;
        selectedTemplatePreviewTab = templateCatalog.Query.PreviewTab;
    }

    private async Task ApplyTemplateCatalogQueryAsync(ProcessTemplateCatalogQueryProjection query)
    {
        templateSearchText = query.SearchText ?? string.Empty;
        selectedTemplateCategory = query.Category;
        selectedTemplateItemKey = query.SelectedItemKey;
        selectedTemplatePreviewTab = query.PreviewTab;
        await LoadAsync(forceRefresh: false);
    }


        YAxisTitle = "Events",
        TooltipPrecision = 0,
        ValuePrecision = 0,
        FillOpacity = 0.22,
        LegendPosition = CdaChartLegendPosition.Bottom,
        Palette = ["#2563eb", "#7c3aed", "#0891b2"]
    };

    private static readonly CdaChartOptions RuntimeUsageChartOptions = new()
    {
        Type = CdaChartType.Bar,
        XAxisType = CdaChartAxisType.DateTime,
        YAxisTitle = "Usage",
        TooltipPrecision = 2,
        ValuePrecision = 2,
        ShowToolbar = false,
        EnableZoom = false,
        LegendPosition = CdaChartLegendPosition.Bottom,
        Palette = ["#16a34a", "#d97706", "#dc2626"]
    };

    private static readonly CdaChartOptions RuntimeToolUsageChartOptions = new()
    {
        Type = CdaChartType.Bar,
        XAxisType = CdaChartAxisType.Category,
        YAxisTitle = "Calls",
        TooltipPrecision = 0,
        ValuePrecision = 0,
        ShowToolbar = false,
        EnableZoom = false,
        RotateXAxisLabels = false,
        LegendPosition = CdaChartLegendPosition.Bottom,
        Palette = ["#f59e0b"]
    };

    private IReadOnlyList<CdaChartSeries> RuntimeActivitySeries
    {
        get
        {
            var points = CurrentShell.Runtime.MetricPoints;
            if (points.Count == 0)
            {
                return [];
            }

            return
            [
                new CdaChartSeries
                {
                    Name = "Runtime events",
                    Type = CdaChartType.Area,
                    Color = "#2563eb",
                    Points = points.Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, item.EventCount)).ToArray()
                },
                new CdaChartSeries
                {
                    Name = "Manager signals",
                    Type = CdaChartType.Line,
                    Color = "#7c3aed",
                    Points = points.Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, item.ManagerEventCount)).ToArray()
                },
                new CdaChartSeries
                {
                    Name = "Tool activity",
                    Type = CdaChartType.Line,
                    Color = "#0891b2",
                    Points = points.Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, item.ToolCallCount)).ToArray()
                }
            ];
        }
    }

    private IReadOnlyList<CdaChartSeries> RuntimeUsageSeries
    {
        get
        {
            var points = CurrentShell.Runtime.MetricPoints;
            if (points.Count == 0)
            {
                return [];
            }

            return
            [
                new CdaChartSeries
                {
                    Name = "Tokens",
                    Type = CdaChartType.Bar,
                    Color = "#16a34a",
                    Points = points.Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, item.InputTokens + item.OutputTokens)).ToArray()
                },
                new CdaChartSeries
                {
                    Name = "Minutes",
                    Type = CdaChartType.Line,
                    Color = "#d97706",
                    Points = points.Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, Math.Round(item.DurationMs / 60000m, 2))).ToArray()
                },
                new CdaChartSeries
                {
                    Name = "Cost",
                    Type = CdaChartType.Line,
                    Color = "#dc2626",
                    Points = points.Select(item => new CdaChartPoint(item.TimestampUtc.UtcDateTime, item.ActualCost > 0 ? item.ActualCost : item.EstimatedCost)).ToArray()
                }
            ];
        }
    }

    private IReadOnlyList<CdaChartSeries> RuntimeToolUsageSeries
    {
        get
        {
            var toolUsage = CurrentShell.Runtime.ToolUsage.Take(15).ToArray();
            if (toolUsage.Length == 0)
            {
                return [];
            }

            return
            [
                new CdaChartSeries
                {
                    Name = "Calls",
                    Type = CdaChartType.Bar,
                    Color = "#f59e0b",
                    Points = toolUsage.Select(item => new CdaChartPoint(TrimLabel(item.ToolName, 26), item.CallCount)).ToArray()
                }
            ];
        }
    }


@namespace CanDoItAll.Modules.Processes

@if (!IsRuntime && DefinitionStep is null && DefinitionRole is null && DefinitionArtifact is null)
{
    <EmptyState Eyebrow="Canvas selection"
                Title="Select a process step"
                Description="Click a step to inspect its contract, role bindings, and evidence expectations without leaving the canvas.">
        <Actions>
            <Button Text="Open toolbox"
                    ButtonStyle="ButtonStyle.Light"
                    Click="OpenToolbox" />
            <Button Text="Clear selection"
                    ButtonStyle="ButtonStyle.Light"
                    Click="ClearSelection" />
        </Actions>
    </EmptyState>
}
else if (IsRuntime && RuntimeStep is null)
{
    <EmptyState Eyebrow="Runtime selection"
                Title="Select a run step"
                Description="Click a runtime node to inspect the executor, status, and step-specific actions.">
        <Actions>
            <Button Text="Clear selection"
                    ButtonStyle="ButtonStyle.Light"
                    Click="ClearSelection" />
        </Actions>
    </EmptyState>
}
else if (!IsRuntime && DefinitionRole is not null)
{
    <Stack GapScale="LayoutGap.Medium">
        <SurfaceCard Soft="true">
            <Stack GapScale="LayoutGap.Small">
                <div>
                    <p class="cda-eyebrow">Role definition</p>
                    <h3 class="mt-1 text-lg font-semibold text-slate-950">@DefinitionRole.DisplayName</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-600">@DefinitionRoleLeadText</p>
                </div>
                <Cluster Gap="LayoutGap.Small">
                    <StatusBadge Tone="neutral" Text="@(DefinitionRole.IsRequired ? "Required" : "Optional")" />
                    <StatusBadge Tone="info" Text="@DefinitionRole.DefaultAllocationPercent.ToString()" />
                    <StatusBadge Tone="accent" Text="@(string.IsNullOrWhiteSpace(DefinitionRole.PreferredExecutorKind) ? "person" : DefinitionRole.PreferredExecutorKind)" />
                </Cluster>
            </Stack>
        </SurfaceCard>

        <SurfaceCard>
            <Stack GapScale="LayoutGap.Medium">
                <Button Text="Edit role"
                        Click="EditDefinitionRole"
                        data-testid="processes-canvas-selection-edit-role" />
                <Button Text="Open toolbox"
                        ButtonStyle="ButtonStyle.Light"
                        Click="OpenToolbox" />
                <Button Text="Clear selection"
                        ButtonStyle="ButtonStyle.Light"
                        Click="ClearSelection" />
            </Stack>
        </SurfaceCard>
    </Stack>
}
else if (!IsRuntime && DefinitionArtifact is not null)
{
    <Stack GapScale="LayoutGap.Medium">
        <SurfaceCard Soft="true">
            <Stack GapScale="LayoutGap.Small">
                <div>
                    <p class="cda-eyebrow">Artifact node</p>
                    <h3 class="mt-1 text-lg font-semibold text-slate-950">@DefinitionArtifactTitle</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-600">@DefinitionArtifactLeadText</p>
                </div>
                <Cluster Gap="LayoutGap.Small">
                    <StatusBadge Tone="accent" Text="@DefinitionArtifact.ArtifactKind.ToString()" />
                    <StatusBadge Tone="info" Text="@(DefinitionArtifact.IsRequired ? "Required" : "Optional")" />
                    <StatusBadge Tone="neutral" Text="@DefinitionArtifact.TrustRequirement.ToString()" />
                    <StatusBadge Tone="neutral" Text="@DefinitionArtifact.SensitivityLevel.ToString()" />
                </Cluster>
            </Stack>
        </SurfaceCard>

        <SurfaceCard>
            <Stack GapScale="LayoutGap.Medium">
                <Button Text="Open toolbox"
                        ButtonStyle="ButtonStyle.Light"
                        Click="OpenToolbox" />
                <Button Text="Clear selection"
                        ButtonStyle="ButtonStyle.Light"
                        Click="ClearSelection" />
            </Stack>
        </SurfaceCard>
    </Stack>
}
else if (!IsRuntime && DefinitionStep is not null)
{
    <Stack GapScale="LayoutGap.Medium">
        <SurfaceCard Soft="true">
            <Stack GapScale="LayoutGap.Small">
                <div>
                    <p class="cda-eyebrow">Definition step</p>
                    <h3 class="mt-1 text-lg font-semibold text-slate-950">@DefinitionStep.Title</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-600">@DefinitionLeadText</p>
                </div>
                <Cluster Gap="LayoutGap.Small">
                    <StatusBadge Tone="neutral" Text="@DefinitionStep.StepKind.ToString()" />
                    <StatusBadge Tone="info" Text="@($"{DefinitionStep.TargetLeadHours} h")" />
                    <StatusBadge Tone="warning" Text="@($"{DefinitionStep.RoleAssignments.Count} bindings")" />
                    <StatusBadge Tone="accent" Text="@($"{DefinitionStep.ArtifactExpectations.Count} artifacts")" />
                    <StatusBadge Tone="accent" Text="@($"{DefinitionStep.BranchOutcomes.Count} branches")" />
                </Cluster>
            </Stack>
        </SurfaceCard>

        <SurfaceCard>
            <Stack GapScale="LayoutGap.Medium">
                <Button Text="Edit step"
                        Click="EditDefinitionStep"
                        data-testid="processes-canvas-selection-edit-step" />
                <Button Text="Add dependent step"
                        ButtonStyle="ButtonStyle.Light"
                        Click="AddDependentStep"
                        data-testid="processes-canvas-selection-add-dependent-step" />
                <Button Text="Add branch outcome"
                        ButtonStyle="ButtonStyle.Light"
                        Click="AddBranchOutcome"
                        data-testid="processes-canvas-selection-add-branch-outcome" />
                <Button Text="Add role binding"
                        ButtonStyle="ButtonStyle.Light"
                        Click="AddRoleBinding"
                        data-testid="processes-canvas-selection-add-role-binding" />
                <Button Text="Add artifact expectation"
                        ButtonStyle="ButtonStyle.Light"
                        Click="AddArtifactExpectation"
                        data-testid="processes-canvas-selection-add-artifact" />
                <Button Text="More actions"
                        ButtonStyle="ButtonStyle.Light"
                        Click="OpenActionDialog"
                        data-testid="processes-canvas-selection-open-actions" />
            </Stack>
        </SurfaceCard>

        @if (DefinitionStep.BranchOutcomes.Count > 0)
        {
            <SurfaceCard>
                <Stack GapScale="LayoutGap.Medium">
                    <div>
                        <p class="cda-eyebrow">Branch routing</p>
                        <h3 class="mt-1 text-lg font-semibold text-slate-950">Outcome paths</h3>
                        <p class="mt-2 text-sm leading-6 text-slate-600">Create routed follow-up steps directly from a specific branch outcome so the dependency path stays explicit on the canvas.</p>
                    </div>

                    @foreach (var branchOutcome in DefinitionStep.BranchOutcomes)
                    {
                        <SurfaceCard Soft="true">
                            <Split Gap="LayoutGap.Medium">
                                <Stack GapScale="LayoutGap.Tiny">
                                    <p class="text-sm font-semibold text-slate-950">@branchOutcome.Title</p>
                                    @if (!string.IsNullOrWhiteSpace(branchOutcome.Description))
                                    {
                                        <p class="text-sm leading-6 text-slate-600">@branchOutcome.Description</p>
                                    }
                                </Stack>
                                <Button Text="Add routed step"
                                        ButtonStyle="ButtonStyle.Light"
                                        Click="@(() => AddRoutedStep.InvokeAsync(branchOutcome.Id))"
                                        data-testid="processes-canvas-selection-add-routed-step" />
                            </Split>
                        </SurfaceCard>
                    }
                </Stack>
            </SurfaceCard>
        }
    </Stack>
}
else if (RuntimeStep is not null)
{
    <Stack GapScale="LayoutGap.Medium">
        <SurfaceCard Soft="true">
            <Stack GapScale="LayoutGap.Small">
                <div>
                    <p class="cda-eyebrow">Runtime step</p>
                    <h3 class="mt-1 text-lg font-semibold text-slate-950">@RuntimeStep.Title</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-600">@RuntimeLeadText</p>
                </div>
                <Cluster Gap="LayoutGap.Small">
                    <StatusBadge Tone="@RuntimeTone" Text="@RuntimeStep.Status.ToString()" />
                    <StatusBadge Tone="neutral" Text="@RuntimeStep.StepKind.ToString()" />
                    <StatusBadge Tone="info" Text="@($"{RuntimeStep.Health.AttemptCount} attempts")" />
                    @if (!string.IsNullOrWhiteSpace(RuntimeStep.Health.LatestAttemptStatus))
                    {
                        <StatusBadge Tone="@RuntimeStep.Health.LatestAttemptTone" Text="@RuntimeStep.Health.LatestAttemptStatus" />
                    }
                </Cluster>
                @if (!string.IsNullOrWhiteSpace(RuntimeStep.Health.ActionableReason))
                {
                    <p class="text-sm leading-6 text-slate-600"
                       data-testid="processes-canvas-selection-health-reason">
                        @RuntimeStep.Health.ActionableReason
                    </p>
                }
                @if (RuntimeStep.ArtifactExpectations.Count > 0)
                {
                    <Stack GapScale="LayoutGap.Tiny">
                        <p class="cda-eyebrow">Artifact obligations</p>
                        @foreach (var artifact in RuntimeStep.ArtifactExpectations)
                        {
                            <Split Gap="LayoutGap.Small">
                                <p class="text-sm text-slate-700">@artifact.Title</p>
                                <StatusBadge Tone="@ResolveArtifactTone(artifact.Status)" Text="@artifact.Status.ToString()" />
                            </Split>
                        }
                    </Stack>
                }
                <CompactStatStrip>
                    <CompactStat Label="wait" Value="@($"{RuntimeStep.WaitMinutes}m")" TooltipText="Runtime wait minutes recorded for this step." />
                    <CompactStat Label="touch" Value="@($"{RuntimeStep.TouchMinutes}m")" TooltipText="Runtime touch minutes recorded for this step." Tone="info" />
                    <CompactStat Label="blocked" Value="@($"{RuntimeStep.BlockedMinutes}m")" TooltipText="Runtime blocked minutes recorded for this step." Tone="warning" />
                    <CompactStat Label="rework" Value="@RuntimeStep.ReworkCount.ToString()" TooltipText="Rework count recorded for this step." Tone="danger" />
                </CompactStatStrip>
            </Stack>
        </SurfaceCard>

        <SurfaceCard>
            <Stack GapScale="LayoutGap.Medium">
                @if (RuntimeStep.AvailableBranchOutcomes.Count > 0)
                {
                    <div>
                        <label class="cda-field-label">Branch outcome</label>
                        <InputSelect TValue="Guid?"
                                     Value="SelectedRuntimeBranchOutcomeId"
                                     ValueChanged="HandleSelectedRuntimeBranchOutcomeChanged"
                                     ValueExpression="@(() => SelectedRuntimeBranchOutcomeId)"
                                     class="cda-input">
                            <option value="">Select outcome</option>
                            @foreach (var outcome in RuntimeStep.AvailableBranchOutcomes)
                            {
                                <option value="@outcome.Id">@outcome.Title</option>
                            }
                        </InputSelect>
                    </div>
                }
                <Button Text="Start"
                        ButtonStyle="ButtonStyle.Light"
                        Disabled="@(!CanApplyRuntimeStatus(ProcessStepRunStatus.InProgress))"
                        Click="StartRuntimeStep" />
                <Button Text="Complete"
                        Disabled="@(!CanApplyRuntimeStatus(ProcessStepRunStatus.Completed))"
                        Click="CompleteRuntimeStep" />
                <Button Text="Block"
                        ButtonStyle="ButtonStyle.Light"
                        Disabled="@(!CanApplyRuntimeStatus(ProcessStepRunStatus.Blocked))"
                        Click="BlockRuntimeStep" />
                <Button Text="Approval"
                        ButtonStyle="ButtonStyle.Light"
                        Disabled="@(!CanApplyRuntimeStatus(ProcessStepRunStatus.WaitingApproval))"
                        Click="RequestRuntimeApproval" />
                <Button Text="Refuse"
                        ButtonStyle="ButtonStyle.Light"
                        Disabled="@(!CanApplyRuntimeStatus(ProcessStepRunStatus.Refused))"
                        Click="RefuseRuntimeStep" />
                <Button Text="Fail"
                        ButtonStyle="ButtonStyle.Light"
                        Disabled="@(!CanApplyRuntimeStatus(ProcessStepRunStatus.Failed))"
                        Click="FailRuntimeStep" />
                <Button Text="Record artifact"
                        ButtonStyle="ButtonStyle.Light"
                        Click="RecordRuntimeArtifact" />
                @if (RuntimeStep.Health.CanManualRerun)
                {
                    <Button Text="Rerun agent step"
                            ButtonStyle="ButtonStyle.Light"
                            Click="RerunRuntimeStep"
                            data-testid="processes-canvas-selection-rerun-agent-step" />
                }
                <Button Text="More actions"
                        ButtonStyle="ButtonStyle.Light"
                        Click="OpenActionDialog" />
            </Stack>
        </SurfaceCard>
    </Stack>
}

@code {
    [Parameter]
    public bool IsRuntime { get; set; }

    [Parameter]
    public ProcessStepEditorModel? DefinitionStep { get; set; }

    [Parameter]
    public ProcessRoleEditorModel? DefinitionRole { get; set; }

    [Parameter]
    public ProcessArtifactExpectationEditorModel? DefinitionArtifact { get; set; }

    [Parameter]
    public ProcessStepRunViewModel? RuntimeStep { get; set; }

    [Parameter]
    public Guid? SelectedRuntimeBranchOutcomeId { get; set; }

    [Parameter]
    public EventCallback<Guid?> SelectedRuntimeBranchOutcomeIdChanged { get; set; }

    [Parameter]
    public EventCallback OpenToolbox { get; set; }

    [Parameter]
    public EventCallback ClearSelection { get; set; }

    [Parameter]
    public EventCallback EditDefinitionStep { get; set; }

    [Parameter]
    public EventCallback EditDefinitionRole { get; set; }

    [Parameter]
    public EventCallback AddDependentStep { get; set; }

    [Parameter]
    public EventCallback AddBranchOutcome { get; set; }

    [Parameter]
    public EventCallback<Guid?> AddRoutedStep { get; set; }

    [Parameter]
    public EventCallback AddRoleBinding { get; set; }

    [Parameter]
    public EventCallback AddArtifactExpectation { get; set; }

    [Parameter]
    public EventCallback OpenActionDialog { get; set; }

    [Parameter]
    public EventCallback StartRuntimeStep { get; set; }

    [Parameter]
    public EventCallback CompleteRuntimeStep { get; set; }

    [Parameter]
    public EventCallback BlockRuntimeStep { get; set; }

    [Parameter]
    public EventCallback RequestRuntimeApproval { get; set; }

    [Parameter]
    public EventCallback RefuseRuntimeStep { get; set; }

    [Parameter]
    public EventCallback FailRuntimeStep { get; set; }

    [Parameter]
    public EventCallback RecordRuntimeArtifact { get; set; }

    [Parameter]
    public EventCallback RerunRuntimeStep { get; set; }

    private string DefinitionLeadText
        => DefinitionStep is null
            ? string.Empty
            : string.IsNullOrWhiteSpace(DefinitionStep.OutputContractSummary)
                ? DefinitionStep.Notes
                : DefinitionStep.OutputContractSummary;

    private string DefinitionRoleLeadText
        => DefinitionRole is null
            ? string.Empty
            : string.IsNullOrWhiteSpace(DefinitionRole.Purpose)
                ? DefinitionRole.StaffingIntent
                : DefinitionRole.Purpose;

    private string DefinitionArtifactLeadText
        => DefinitionArtifact is null
            ? string.Empty
            : !string.IsNullOrWhiteSpace(DefinitionArtifact.ValidationRequirementSummary)
                ? DefinitionArtifact.ValidationRequirementSummary
                : DefinitionArtifact.AllowedFutureUsageSummary;

    private string DefinitionArtifactTitle
        => DefinitionArtifact is null || string.IsNullOrWhiteSpace(DefinitionArtifact.Title)
            ? "Untitled artifact"
            : DefinitionArtifact.Title;

    private string RuntimeLeadText
        => RuntimeStep is null
            ? string.Empty
            : string.IsNullOrWhiteSpace(RuntimeStep.BlockedReason)
                ? string.IsNullOrWhiteSpace(RuntimeStep.DecisionSummary)
                    ? !string.IsNullOrWhiteSpace(RuntimeStep.SelectedBranchOutcomeTitle)
                        ? $"Selected branch outcome: {RuntimeStep.SelectedBranchOutcomeTitle}"
                        : string.IsNullOrWhiteSpace(RuntimeStep.CurrentExecutorName)
                        ? "No executor assigned yet."
                        : $"Executor: {RuntimeStep.CurrentExecutorName}"
                    : RuntimeStep.DecisionSummary
                : RuntimeStep.BlockedReason;

    private string RuntimeTone
        => RuntimeStep?.Status switch
        {
            ProcessStepRunStatus.Completed => "mint",
            ProcessStepRunStatus.InProgress => "info",
            ProcessStepRunStatus.Blocked => "danger",
            ProcessStepRunStatus.Refused => "warning",
            ProcessStepRunStatus.WaitingApproval => "accent",
            ProcessStepRunStatus.Failed => "danger",
            _ => "neutral"
        };

    private static string ResolveArtifactTone(ProcessArtifactExpectationSatisfactionStatus status)
    {
        return status switch
        {
            ProcessArtifactExpectationSatisfactionStatus.Satisfied => "mint",
            ProcessArtifactExpectationSatisfactionStatus.AutoProjected => "info",
            ProcessArtifactExpectationSatisfactionStatus.Missing => "warning",
            ProcessArtifactExpectationSatisfactionStatus.ProjectionFailed or
                ProcessArtifactExpectationSatisfactionStatus.ContentUnavailable => "danger",
            _ => "neutral"
        };
    }

    private Task HandleSelectedRuntimeBranchOutcomeChanged(Guid? branchOutcomeId)
    {
        return SelectedRuntimeBranchOutcomeIdChanged.InvokeAsync(branchOutcomeId);
    }

    private bool CanApplyRuntimeStatus(ProcessStepRunStatus targetStatus)
    {
        return RuntimeStep is not null &&
            RuntimeStep.Status != targetStatus &&
            ProcessStepRunTransitions.IsAllowed(RuntimeStep.Status, targetStatus);
    }
}

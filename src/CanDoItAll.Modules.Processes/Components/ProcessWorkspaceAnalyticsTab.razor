@namespace CanDoItAll.Modules.Processes

@using CanDoItAll.Components.Common

@{
    var analytics = Presenter.Analytics;
    var filteredRuns = Presenter.FilteredRuns;
    var filteredImprovements = Presenter.FilteredImprovements;
}

<Stack GapScale="LayoutGap.Medium"
       Class="w-full">
    <SummaryTiles GapScale="LayoutGap.Small"
                  ColumnsMd="4">
        <SummaryTile Label="Runs"
                     Value="@analytics.TotalRuns.ToString()"
                     HelperText="@($"{analytics.ActiveRuns} active / {analytics.CompletedRuns} completed")"
                     Badge="true"
                     Compact="true"
                     ShowHelperTextAsTooltip="true" />
        <SummaryTile Label="Capability gaps"
                     Value="@analytics.CapabilityGapCount.ToString()"
                     HelperText="Assignments or execution capacity gaps detected."
                     Badge="true"
                     Compact="true"
                     Tone="danger"
                     ShowHelperTextAsTooltip="true" />
        <SummaryTile Label="Conformance"
                     Value="@analytics.ConformanceObservationCount.ToString()"
                     HelperText="@($"{analytics.SafeNonActionCount} safe non-actions recorded")"
                     Badge="true"
                     Compact="true"
                     Tone="warning"
                     ShowHelperTextAsTooltip="true" />
        <SummaryTile Label="Actual cost"
                     Value="@analytics.ActualCost.ToString("C")"
                     HelperText="@($"{analytics.EstimatedCost:C} estimated in scope")"
                     Badge="true"
                     Compact="true"
                     Tone="info"
                     ShowHelperTextAsTooltip="true" />
    </SummaryTiles>

    <SectionCard Title="Run analytics ledger"
                 Description=""
                 HelpText="Browse run summaries without loading a selected run's step graph, assignments, decisions, and evidence until the run is opened.">
        @if (!Presenter.HasSelectedProcess)
        {
            <EmptyState Eyebrow="Definition required"
                        Title="Select a process definition"
                        Description="Run analytics are scoped to the selected durable process definition." />
        }
        else if (Presenter.Runs.Count == 0)
        {
            <EmptyState Eyebrow="No runtime runs"
                        Title="No run summaries yet"
                        Description="Analytics listings appear after a launch creates durable runtime runs for this process." />
        }
        else
        {
            <FilterBar ResultText="@Presenter.RunResultText"
                       Class="processes-run-filter-bar">
                <input @bind="Presenter.RunSearch"
                       @bind:event="oninput"
                       class="cda-input processes-run-filter-input"
                       placeholder="Search run name"
                       data-testid="processes-analytics-run-search" />
                <InputSelect TValue="ProcessRunStatus?"
                             @bind-Value="Presenter.RunStatusFilter"
                             class="cda-input processes-run-filter-select"
                             data-testid="processes-analytics-run-state-filter">
                    <option value="">Any state</option>
                    @foreach (var status in Presenter.RunStatusFilterOptions)
                    {
                        <option value="@status">@status</option>
                    }
                </InputSelect>
                <InputSelect TValue="ProcessOperatingMode?"
                             @bind-Value="Presenter.RunOperatingModeFilter"
                             class="cda-input processes-run-filter-select"
                             data-testid="processes-analytics-run-mode-filter">
                    <option value="">Any mode</option>
                    @foreach (var mode in Presenter.RunOperatingModeFilterOptions)
                    {
                        <option value="@mode">@mode</option>
                    }
                </InputSelect>
                <InputSelect TValue="ProcessWorkspace.ProcessRunUpdatedTimeFilter"
                             @bind-Value="Presenter.RunUpdatedTimeFilter"
                             class="cda-input processes-run-filter-select"
                             data-testid="processes-analytics-run-time-filter">
                    @foreach (var filter in Presenter.RunUpdatedTimeFilterOptions)
                    {
                        <option value="@filter">@Presenter.ResolveRunUpdatedTimeFilterText(filter)</option>
                    }
                </InputSelect>
                <input @bind="Presenter.RunTagFilter"
                       @bind:event="oninput"
                       class="cda-input processes-run-filter-input"
                       placeholder="Filter tags"
                       data-testid="processes-analytics-run-tag-filter" />
                <Button Text="Clear"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Click="Presenter.ClearRunFilters" />
            </FilterBar>

            @if (filteredRuns.Count == 0)
            {
                <EmptyState Eyebrow="No matching runs"
                            Title="Adjust the filters"
                            Description="No run summaries match the current analytics filters." />
            }
            else
            {
                <Grid Gap="LayoutGap.Small"
                      ColumnTemplate="repeat(auto-fill,minmax(15.5rem,20rem))"
                      JustifyContent="JustifyContent.Start"
                      Class="processes-run-history-grid mt-5">
                    @foreach (var run in filteredRuns)
                    {
                        <SelectionListItem @key="run.Id"
                                           Title="@run.Name"
                                           Eyebrow="@run.OperatingMode.ToString()"
                                           Meta="@Presenter.BuildRunSummary(run)"
                                           Summary="@Presenter.BuildRunCostText(run)"
                                           DataTestId="@($"processes-analytics-run-item-{run.Id}")"
                                           Dense="true"
                                           Class="processes-run-analytics-card"
                                           OnSelect="@(() => Presenter.OpenRunStepsDialogAsync(run.Id))">
                            <Status>
                                <Cluster Gap="LayoutGap.Small">
                                    <StatusBadge Tone="@Presenter.ResolveRunTone(run.Status)"
                                                 Text="@run.Status.ToString()" />
                                    <StatusBadge Tone="neutral"
                                                 Text="@($"{run.BlockedStepCount} blocked")" />
                                </Cluster>
                            </Status>
                            <ChildContent>
                                <Cluster Gap="LayoutGap.Small"
                                         Class="processes-run-card-tags">
                                    @foreach (var tag in Presenter.BuildRunTags(run))
                                    {
                                        <StatusBadge @key="tag.Text"
                                                     Tone="@tag.Tone"
                                                     Text="@tag.Text" />
                                    }
                                </Cluster>
                                <p class="processes-run-card-updated">@Presenter.BuildRunUpdatedText(run)</p>
                            </ChildContent>
                        </SelectionListItem>
                    }
                </Grid>
            }
        }
    </SectionCard>

    <SectionCard Title="Improvement candidates"
                 Description=""
                 HelpText="Persist improvement opportunities, training signals, and governance review needs instead of leaving them as loose notes after runtime defects appear.">
        @if (Presenter.Improvements.Count == 0)
        {
            <EmptyState Eyebrow="No improvement candidates"
                        Title="Nothing recorded yet"
                        Description="Improvement candidates populate when runtime blocking, refusal, or conformance issues reveal process design weaknesses." />
        }
        else
        {
            <FilterBar ResultText="@Presenter.ImprovementResultText"
                       Class="processes-run-filter-bar">
                <input @bind="Presenter.ImprovementSearch"
                       @bind:event="oninput"
                       class="cda-input processes-run-filter-input"
                       placeholder="Search candidates"
                       data-testid="processes-improvement-search" />
                <InputSelect TValue="ProcessImprovementStatus?"
                             @bind-Value="Presenter.ImprovementStatusFilter"
                             class="cda-input processes-run-filter-select"
                             data-testid="processes-improvement-state-filter">
                    <option value="">Any state</option>
                    @foreach (var status in Presenter.ImprovementStatusFilterOptions)
                    {
                        <option value="@status">@status</option>
                    }
                </InputSelect>
                <InputSelect TValue="ProcessWorkspace.ProcessImprovementSignalFilter"
                             @bind-Value="Presenter.ImprovementSignalFilter"
                             class="cda-input processes-run-filter-select"
                             data-testid="processes-improvement-signal-filter">
                    @foreach (var filter in Presenter.ImprovementSignalFilterOptions)
                    {
                        <option value="@filter">@Presenter.ResolveImprovementSignalFilterText(filter)</option>
                    }
                </InputSelect>
                <Button Text="Clear"
                        ButtonStyle="ButtonStyle.Light"
                        Size="ButtonSize.Small"
                        Click="Presenter.ClearImprovementFilters" />
            </FilterBar>

            @if (filteredImprovements.Count == 0)
            {
                <EmptyState Eyebrow="No matching candidates"
                            Title="Adjust the filters"
                            Description="No improvement candidates match the current search, state, and signal filters." />
            }
            else
            {
                <Grid Gap="LayoutGap.Small"
                      ColumnTemplate="repeat(auto-fill,minmax(18rem,1fr))"
                      JustifyContent="JustifyContent.Start"
                      Class="processes-improvement-grid mt-5">
                    @foreach (var improvement in filteredImprovements)
                    {
                        <SurfaceCard @key="improvement.Id"
                                     Class="processes-improvement-card">
                            <Split Gap="LayoutGap.Small"
                                   Breakpoint="LayoutBreakpoint.None"
                                   Wrap="FlexWrap.Wrap">
                                <Stack GapScale="LayoutGap.Tiny"
                                       Class="min-w-0 flex-1">
                                    <p class="processes-improvement-card__title">@improvement.Title</p>
                                    <p class="processes-improvement-card__category">@improvement.Category / @improvement.Status</p>
                                </Stack>
                                <Cluster Gap="LayoutGap.Small"
                                         Class="processes-improvement-card__badges">
                                    @foreach (var tag in Presenter.BuildImprovementTags(improvement))
                                    {
                                        <StatusBadge @key="tag.Text"
                                                     Tone="@tag.Tone"
                                                     Text="@tag.Text" />
                                    }
                                </Cluster>
                            </Split>
                            <p class="processes-improvement-card__summary">@improvement.ProblemSummary</p>
                        </SurfaceCard>
                    }
                </Grid>
            }
        }
    </SectionCard>
</Stack>

@code {
    [Parameter, EditorRequired]
    public ProcessWorkspace.ProcessWorkspaceAnalyticsTabPresenter Presenter { get; set; } = default!;
}

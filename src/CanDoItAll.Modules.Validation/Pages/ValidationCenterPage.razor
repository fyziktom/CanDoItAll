@page "/validation"
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using CanDoItAll.Modules.Projects
@inject ValidationService ValidationService
@inject ProjectsService ProjectsService

<PageTitle>Validation Center</PageTitle>

<PageScaffold>
    <Header>
        <PageHeader Eyebrow="Validation"
                    Title="Validation center"
                    Description="Run deterministic reviews, store findings, and keep final review decisions attached to each run.">
            <Actions>
                <Button Text="New validation" Click="CreateNewAsync" />
            </Actions>
        </PageHeader>
    </Header>

    <ChildContent>
        <SummaryTiles>
            <SummaryTile Label="Runs" Value="@runs.Count.ToString()" HelperText="Persisted validation runs." />
            <SummaryTile Label="Visible" Value="@FilteredRuns.Count.ToString()" HelperText="Runs matching the current filters." Tone="info" />
            <SummaryTile Label="Findings" Value="@runs.Sum(item => item.FindingCount).ToString()" HelperText="Stored findings across all runs." />
            <SummaryTile Label="Needs review" Value="@runs.Count(item => item.Decision != ValidationDecision.Approved).ToString()" HelperText="Runs not yet approved." Tone="warning" />
        </SummaryTiles>

        <ListDetailShell ListPaneWidth="25rem">
            <ListHeader>
                <ListPanelHeader Title="Validation runs"
                                 Description="Select a run to inspect it, or start a new review with the shared editor."
                                 Count="@($"{FilteredRuns.Count} run(s)")">
                    <Filters>
                        <FilterBar ResultText="@($"{FilteredRuns.Count} matching run(s)")">
                            <input @bind="runSearch" @bind:event="oninput" class="cda-input min-w-[14rem] flex-1" placeholder="Search validations" />
                            <InputSelect @bind-Value="typeFilter" class="cda-input">
                                <option value="">All types</option>
                                @foreach (var type in Enum.GetValues<ValidationType>())
                                {
                                    <option value="@type.ToString()">@type</option>
                                }
                            </InputSelect>
                            <InputSelect @bind-Value="decisionFilter" class="cda-input">
                                <option value="">All decisions</option>
                                @foreach (var decision in Enum.GetValues<ValidationDecision>())
                                {
                                    <option value="@decision.ToString()">@decision</option>
                                }
                            </InputSelect>
                            <Button Text="Reset" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="ResetFilters" />
                        </FilterBar>
                    </Filters>
                </ListPanelHeader>
            </ListHeader>

            <ListContent>
                @if (FilteredRuns.Count == 0)
                {
                    <EmptyState Eyebrow="No validation runs"
                                Title="Run the first review"
                                Description="Validation runs appear here after the editor executes a deterministic review.">
                        <Actions>
                            <Button Text="New validation" Click="CreateNewAsync" />
                        </Actions>
                    </EmptyState>
                }
                else
                {
                    <Stack GapScale="LayoutGap.Medium">
                        @foreach (var run in FilteredRuns)
                        {
                            <SelectionListItem Title="@run.ArtifactTitle"
                                               Eyebrow="@run.ValidationType.ToString()"
                                               Meta="@($"{run.Decision} / {run.FindingCount} finding(s)")"
                                               Summary="@BuildRunSummary(run)"
                                               IsSelected="@(editor.Id == run.Id)"
                                               OnSelect="@(() => EditAsync(run.Id))">
                                <Status>
                                    <StatusBadge Tone="@ResolveDecisionTone(run.Decision)" Text="@run.Decision.ToString()" />
                                </Status>
                            </SelectionListItem>
                        }
                    </Stack>
                }
            </ListContent>

            <DetailHeader>
                <Stack GapScale="LayoutGap.Medium">
                    <Split Gap="LayoutGap.Medium">
                        <Stack GapScale="LayoutGap.Tiny">
                            <p class="cda-eyebrow">Run editor</p>
                            <h2 class="text-xl font-semibold text-slate-950">@EditorTitle</h2>
                            <p class="text-sm leading-6 text-slate-600">Configure the review, run it, then inspect the stored summary and findings without leaving the detail pane.</p>
                        </Stack>
                        <Cluster Gap="LayoutGap.Small">
                            <StatusBadge Tone="@ResolveDecisionTone(editor.Decision)" Text="@editor.Decision.ToString()" />
                            <StatusBadge Tone="neutral" Text="@editor.ValidationType.ToString()" />
                            <StatusBadge Tone="info" Text="@($"{editor.Findings.Count} finding(s)")" />
                        </Cluster>
                    </Split>

                    <SecondaryTabs Items="DetailTabs" SelectedKey="@detailTab" SelectedKeyChanged="HandleDetailTabChanged" />
                </Stack>
            </DetailHeader>

            <DetailContent>
                <EditForm Model="editor" OnValidSubmit="RunAsync">
                    <Stack Class="min-h-full" GapScale="LayoutGap.XXLarge">
                        @if (string.Equals(detailTab, "overview", StringComparison.Ordinal))
                        {
                            <FormSection Title="Run setup" Description="Choose the project, checklist, and artifact metadata before launching the deterministic review.">
                                <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                    <div>
                                        <label class="cda-field-label">Project</label>
                                        <InputSelect @bind-Value="editor.ProjectId" class="cda-input">
                                            <option value="">None</option>
                                            @foreach (var project in projects)
                                            {
                                                <option value="@project.Id">@project.Name</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <div>
                                        <label class="cda-field-label">Validation type</label>
                                        <InputSelect @bind-Value="editor.ValidationType" class="cda-input">
                                            @foreach (var type in Enum.GetValues<ValidationType>())
                                            {
                                                <option value="@type">@type</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </Grid>

                                <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                    <div>
                                        <label class="cda-field-label">Checklist</label>
                                        <InputSelect @bind-Value="editor.ChecklistId" class="cda-input">
                                            @foreach (var checklist in checklists.Where(item => item.ValidationType == editor.ValidationType))
                                            {
                                                <option value="@checklist.Id">@($"{checklist.Name} ({checklist.VersionLabel})")</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <div>
                                        <label class="cda-field-label">Artifact route</label>
                                        <InputText @bind-Value="editor.ArtifactRoute" class="cda-input" />
                                    </div>
                                </Grid>

                                <div>
                                    <label class="cda-field-label">Artifact title</label>
                                    <InputText @bind-Value="editor.ArtifactTitle" class="cda-input" />
                                </div>
                            </FormSection>

                            <FormSection Title="Source content" Description="Paste or stage the content that the deterministic checks should evaluate.">
                                <div>
                                    <label class="cda-field-label">Source content</label>
                                    <InputTextArea @bind-Value="editor.SourceContent" class="cda-input cda-input--textarea cda-input--mono min-h-72" />
                                </div>

                                @if (!string.IsNullOrWhiteSpace(editor.Summary))
                                {
                                    <div class="rounded-[1.2rem] bg-white px-4 py-3">
                                        <p class="cda-eyebrow cda-eyebrow--tight">Latest summary</p>
                                        <p class="mt-2 text-sm leading-6 text-slate-700">@editor.Summary</p>
                                    </div>
                                }
                            </FormSection>
                        }
                        else
                        {
                            <FormSection Title="Review decision" Description="Findings and the final review decision stay attached to the run after execution.">
                                @if (editor.Id.HasValue)
                                {
                                    <div class="max-w-xs">
                                        <label class="cda-field-label">Decision</label>
                                        <InputSelect @bind-Value="editor.Decision" class="cda-input" @onchange="SetDecisionAsync">
                                            @foreach (var decision in Enum.GetValues<ValidationDecision>())
                                            {
                                                <option value="@decision">@decision</option>
                                            }
                                        </InputSelect>
                                    </div>
                                }
                                else
                                {
                                    <EmptyState Eyebrow="Run required"
                                                Title="No stored findings yet"
                                                Description="Execute the validation first so the findings and final decision can be reviewed here." />
                                }
                            </FormSection>

                            <FormSection Title="Findings" Description="Validation findings remain visible together with severity, rule code, and recommended next actions.">
                                @if (editor.Findings.Count == 0)
                                {
                                    <EmptyState Eyebrow="No findings"
                                                Title="Nothing to review yet"
                                                Description="The findings list will populate after the validation run completes." />
                                }
                                else
                                {
                                    <Stack GapScale="LayoutGap.Medium">
                                        @foreach (var finding in editor.Findings)
                                        {
                                            <div class="cda-panel-card">
                                                <Split Breakpoint="LayoutBreakpoint.None"
                                                       Gap="LayoutGap.Medium"
                                                       AlignItems="AlignItems.Center"
                                                       JustifyContent="JustifyContent.SpaceBetween"
                                               Wrap="FlexWrap.Wrap">
                                                    <div>
                                                        <p class="text-sm font-semibold text-slate-950">@finding.Title</p>
                                                        <p class="cda-eyebrow cda-eyebrow--tight mt-1">@finding.RuleCode</p>
                                                    </div>
                                                    <StatusBadge Tone="@ResolveFindingTone(finding.Severity)" Text="@finding.Severity.ToString()" />
                                                </Split>
                                                <p class="mt-3 text-sm leading-6 text-slate-600">@finding.Detail</p>
                                                <p class="mt-3 text-sm text-sky-700">@finding.RecommendedAction</p>
                                            </div>
                                        }
                                    </Stack>
                                }
                            </FormSection>
                        }

                        <StickyActionFooter StatusLabel="Validation status" StatusMessage="@message" StatusTone="success">
                            <SecondaryActions>
                                <Button Text="Reset" ButtonStyle="ButtonStyle.Light" Click="CreateNewAsync" />
                            </SecondaryActions>
                            <PrimaryActions>
                                <Button Text="Run validation" Type="submit" data-testid="validation-run-button" />
                            </PrimaryActions>
                        </StickyActionFooter>
                    </Stack>
                </EditForm>
            </DetailContent>
        </ListDetailShell>
    </ChildContent>
</PageScaffold>

@code {
    [SupplyParameterFromQuery(Name = "runId")]
    public Guid? RunIdQuery { get; set; }

    [SupplyParameterFromQuery(Name = "projectId")]
    public Guid? ProjectIdQuery { get; set; }

    private IReadOnlyList<ProjectSummary> projects = [];
    private IReadOnlyList<ValidationChecklistSummary> checklists = [];
    private IReadOnlyList<ValidationRunSummary> runs = [];
    private ValidationRunEditorModel editor = new();
    private string? message;
    private string runSearch = string.Empty;
    private string typeFilter = string.Empty;
    private string decisionFilter = string.Empty;
    private string detailTab = "overview";

    private IReadOnlyList<ValidationRunSummary> FilteredRuns => runs
        .Where(run =>
            (string.IsNullOrWhiteSpace(runSearch) ||
             run.ArtifactTitle.Contains(runSearch, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(typeFilter) || string.Equals(run.ValidationType.ToString(), typeFilter, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(decisionFilter) || string.Equals(run.Decision.ToString(), decisionFilter, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(run => run.UpdatedAtUtc)
        .ToList();

    private IReadOnlyList<SecondaryTabItem> DetailTabs =>
    [
        new("overview", "Overview"),
        new("findings", "Findings", editor.Findings.Count.ToString())
    ];

    private string EditorTitle => string.IsNullOrWhiteSpace(editor.ArtifactTitle) ? "New validation run" : editor.ArtifactTitle;

    protected override async Task OnParametersSetAsync() => await LoadAsync(RunIdQuery, ProjectIdQuery);

    private async Task LoadAsync(Guid? runId = null, Guid? projectId = null)
    {
        projects = await ProjectsService.ListAsync();
        checklists = await ValidationService.ListChecklistsAsync();
        runs = await ValidationService.ListRunsAsync();
        editor = runId.HasValue ? await ValidationService.GetRunAsync(runId.Value) : await ValidationService.GetRunAsync(null);

        if (!runId.HasValue && projectId.HasValue)
        {
            editor.ProjectId = projectId;
        }

        detailTab = editor.Findings.Count > 0 ? "findings" : "overview";
    }

    private async Task CreateNewAsync()
    {
        editor = await ValidationService.GetRunAsync(null);
        editor.ProjectId ??= ProjectIdQuery;
        message = null;
        detailTab = "overview";
    }

    private async Task EditAsync(Guid id)
    {
        editor = await ValidationService.GetRunAsync(id);
        message = null;
        detailTab = editor.Findings.Count > 0 ? "findings" : "overview";
    }

    private async Task RunAsync()
    {
        var result = await ValidationService.RunAsync(editor);
        message = result.IsSuccess ? "Validation completed." : string.Join(" ", result.Errors.Select(error => error.Message));
        runs = await ValidationService.ListRunsAsync();
        if (result.IsSuccess)
        {
            editor = await ValidationService.GetRunAsync(result.Value);
            detailTab = "findings";
        }
    }

    private async Task SetDecisionAsync(ChangeEventArgs _)
    {
        if (!editor.Id.HasValue)
        {
            return;
        }

        await ValidationService.SetDecisionAsync(editor.Id.Value, editor.Decision);
        runs = await ValidationService.ListRunsAsync();
        message = $"Decision updated to {editor.Decision}.";
    }

    private Task HandleDetailTabChanged(string key)
    {
        detailTab = key;
        return Task.CompletedTask;
    }

    private void ResetFilters()
    {
        runSearch = string.Empty;
        typeFilter = string.Empty;
        decisionFilter = string.Empty;
    }

    private static string BuildRunSummary(ValidationRunSummary run)
        => $"Updated {run.UpdatedAtUtc.LocalDateTime:g}";

    private static string ResolveFindingTone(ValidationFindingSeverity severity) => severity switch
    {
        ValidationFindingSeverity.Error => "danger",
        ValidationFindingSeverity.Warning => "warning",
        _ => "info"
    };

    private static string ResolveDecisionTone(ValidationDecision decision) => decision switch
    {
        ValidationDecision.Approved => "success",
        ValidationDecision.Rejected => "danger",
        ValidationDecision.NeedsChanges => "warning",
        _ => "neutral"
    };
}



@namespace CanDoItAll.Components.CanvasLib
@using CanDoItAll.Components.CanvasLib

<div class="cw-settings-preview cw-skeleton-preview-shell"
     data-testid="@Snapshot.TestHookId"
     aria-busy="@Snapshot.IsVisible"
     data-visible="@(Snapshot.IsVisible ? "true" : "false")">
    <p class="cw-settings-label">@Snapshot.Label</p>
    <div class="cw-theme-summary">
        <div>
            <p class="cw-theme-summary__title">@Snapshot.Title</p>
            <p class="cw-panel-copy">@Snapshot.Summary</p>
        </div>
        <span class="cw-theme-pill">@Snapshot.StatePill</span>
    </div>

    <div class="cw-skeleton-preview">
        <div class="cw-skeleton-toolbar">
            <span class="cw-skeleton-bar cw-skeleton-bar--sm"></span>
            <span class="cw-skeleton-bar cw-skeleton-bar--md"></span>
            <span class="cw-skeleton-bar cw-skeleton-bar--sm"></span>
        </div>

        <div class="cw-skeleton-stage-grid">
            <div class="cw-skeleton-stage-column">
                @for (var index = 0; index < Snapshot.StageCardCount; index++)
                {
                    <div class="cw-skeleton-card">
                        <span class="cw-skeleton-bar cw-skeleton-bar--sm"></span>
                        <span class="cw-skeleton-bar cw-skeleton-bar--lg"></span>
                        <span class="cw-skeleton-bar cw-skeleton-bar--md"></span>
                    </div>
                }
            </div>

            <div class="cw-skeleton-inspector-column">
                @for (var index = 0; index < Snapshot.InspectorBlockCount; index++)
                {
                    <div class="cw-skeleton-panel">
                        <span class="cw-skeleton-bar cw-skeleton-bar--sm"></span>
                        <span class="cw-skeleton-bar cw-skeleton-bar--md"></span>
                        <span class="cw-skeleton-bar cw-skeleton-bar--md"></span>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="cw-theme-metrics">
        @foreach (var metric in Snapshot.Metrics)
        {
            <span class="cw-theme-metric">@metric</span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public SkeletonStateOverlaySnapshot Snapshot { get; set; } = default!;
}



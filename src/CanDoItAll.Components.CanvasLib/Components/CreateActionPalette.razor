@namespace CanDoItAll.Components.CanvasLib
@implements IAsyncDisposable
@using CanDoItAll.Components.CanvasLib
@inject IJSRuntime JsRuntime

<CanvasBoundaryCard TestHookId="@Snapshot.TestHookId"
                           Label="@Snapshot.Label"
                           Title="@Snapshot.Title"
                           Summary="@Snapshot.Summary"
                           StatePill="@Snapshot.StatePill"
                           Metrics="@Snapshot.Metrics">
    <div class="cw-preview-palette" @ref="host">
        <div class="cw-preview-palette__section">
            <span class="cw-preview-palette__label">Quick create</span>
            <div class="cw-preview-chip-row">
                @foreach (var action in Snapshot.QuickActions)
                {
                    <span class="cw-preview-chip" data-tone="@action.Tone">@action.Label</span>
                }
            </div>
        </div>
        <div class="cw-preview-palette__section">
            <span class="cw-preview-palette__label">Context groups</span>
            <div class="cw-preview-chip-row">
                @foreach (var action in Snapshot.GroupActions)
                {
                    <span class="cw-preview-chip" data-tone="@action.Tone">@action.Label</span>
                }
            </div>
        </div>
    </div>
</CanvasBoundaryCard>

@code {
    private readonly CanvasSceneHost sceneHost = new();
    private ElementReference host;
    private string? pendingSnapshotKey;

    [Parameter, EditorRequired]
    public CreateActionPaletteSnapshot Snapshot { get; set; } = default!;

    protected override void OnParametersSet()
    {
        pendingSnapshotKey = SerializationPersistencePack.Serialize(Snapshot);
        sceneHost.QueueSync(
            pendingSnapshotKey,
            !string.Equals(sceneHost.AppliedStateKey, pendingSnapshotKey, StringComparison.Ordinal));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var bridge = new JsInteropBridge(JsRuntime);
        if (sceneHost.ShouldCreate())
        {
            await bridge.InvokeVoidAsync("CanDoItAll.createActionPalette.create", host, Snapshot);
            sceneHost.MarkApplied();
            return;
        }

        if (!sceneHost.ShouldUpdate())
        {
            return;
        }

        await bridge.InvokeVoidAsync("CanDoItAll.createActionPalette.update", host, Snapshot);
        sceneHost.MarkApplied();
    }

    public async ValueTask DisposeAsync()
    {
        if (!sceneHost.IsInitialized)
        {
            return;
        }

        try
        {
            await new JsInteropBridge(JsRuntime).InvokeVoidAsync("CanDoItAll.createActionPalette.dispose", host);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }
}



@namespace CanDoItAll.Components.CanvasLib
@implements IAsyncDisposable
@using CanDoItAll.Components.CanvasLib
@inject IJSRuntime JsRuntime

<CanvasBoundaryCard TestHookId="@Snapshot.TestHookId"
                           Label="@Snapshot.Label"
                           Title="@Snapshot.Title"
                           Summary="@Snapshot.Summary"
                           StatePill="@Snapshot.StatePill"
                           Metrics="@Snapshot.Metrics">
    <article class="cw-preview-node-card" style="@($"--cw-preview-accent:{Snapshot.AccentColor};")" @ref="host">
        <div class="cw-preview-node-card__header">
            <Icon Name="@Snapshot.Icon" class="cw-preview-node-card__icon" />
            <div>
                <p class="cw-preview-node-card__title">@Snapshot.CardTitle</p>
                <p class="cw-preview-node-card__subtitle">@Snapshot.CardSubtitle</p>
            </div>
            <span class="cw-preview-node-card__status">@Snapshot.StatusPill</span>
        </div>

        <p class="cw-preview-node-card__lead">@Snapshot.LeadText</p>

        @if (Snapshot.Chips.Count > 0)
        {
            <div class="cw-preview-chip-row">
                @foreach (var chip in Snapshot.Chips)
                {
                    <span class="cw-preview-chip" data-tone="@chip.Tone">@chip.Text</span>
                }
            </div>
        }
    </article>
</CanvasBoundaryCard>

@code {
    private readonly CanvasSceneHost sceneHost = new();
    private ElementReference host;
    private string? pendingSnapshotKey;

    [Parameter, EditorRequired]
    public NodeCardComposerSnapshot Snapshot { get; set; } = default!;

    protected override void OnParametersSet()
    {
        pendingSnapshotKey = SerializationPersistencePack.Serialize(Snapshot);
        sceneHost.QueueSync(
            pendingSnapshotKey,
            !string.Equals(sceneHost.AppliedStateKey, pendingSnapshotKey, StringComparison.Ordinal));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var bridge = new JsInteropBridge(JsRuntime);
        if (sceneHost.ShouldCreate())
        {
            await bridge.InvokeVoidAsync("CanDoItAll.nodeCardComposer.create", host, Snapshot);
            sceneHost.MarkApplied();
            return;
        }

        if (!sceneHost.ShouldUpdate())
        {
            return;
        }

        await bridge.InvokeVoidAsync("CanDoItAll.nodeCardComposer.update", host, Snapshot);
        sceneHost.MarkApplied();
    }

    public async ValueTask DisposeAsync()
    {
        if (!sceneHost.IsInitialized)
        {
            return;
        }

        try
        {
            await new JsInteropBridge(JsRuntime).InvokeVoidAsync("CanDoItAll.nodeCardComposer.dispose", host);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }
}



@namespace CanDoItAll.Components.CanvasLib
@implements IAsyncDisposable
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.CanvasLib
@inject IJSRuntime JsRuntime

<section class="cw-floating-window @(State.IsMinimized ? "is-minimized" : string.Empty)"
         data-testid="@TestId"
         aria-label="@AriaLabel"
         @ref="host"
         @onclick:stopPropagation="true">
    @if (State.IsMinimized)
    {
        <div class="cw-floating-window__chip">
            <div class="cw-floating-window__drag" data-cw-window-drag="true">
                @if (!string.IsNullOrWhiteSpace(Kicker))
                {
                    <p class="cw-panel-kicker">@Kicker</p>
                }
                <strong class="cw-floating-window__chip-title">@Title</strong>
            </div>
            <div class="cw-floating-window__chip-actions">
                <button type="button"
                        class="cw-floating-window__action"
                        aria-label="@RestoreLabel"
                        title="@RestoreLabel"
                        @onclick="RestoreWindowAsync">
                    <Icon Name="expand" />
                </button>
                <button type="button"
                        class="cw-floating-window__action"
                        aria-label="@HideLabel"
                        title="@HideLabel"
                        @onclick="HideWindowAsync">
                    <Icon Name="visibility_off" />
                </button>
            </div>
        </div>
    }
    else
    {
        <header class="cw-floating-window__header">
            <div class="cw-floating-window__drag" data-cw-window-drag="true">
                @if (!string.IsNullOrWhiteSpace(Kicker))
                {
                    <p class="cw-panel-kicker">@Kicker</p>
                }
                <h3 class="cw-floating-window__title">@Title</h3>
                @if (!string.IsNullOrWhiteSpace(Summary))
                {
                    <p class="cw-floating-window__summary">@Summary</p>
                }
            </div>

            <div class="cw-floating-window__actions">
                <button type="button"
                        class="cw-floating-window__action"
                        aria-label="@MinimizeLabel"
                        title="@MinimizeLabel"
                        @onclick="MinimizeWindowAsync">
                    <Icon Name="minimize" />
                </button>
                <button type="button"
                        class="cw-floating-window__action"
                        aria-label="@NormalizeLabel"
                        title="@NormalizeLabel"
                        disabled="@IsNormalized"
                        @onclick="NormalizeWindowAsync">
                    <Icon Name="restart_alt" />
                </button>
                <button type="button"
                        class="cw-floating-window__action"
                        aria-label="@HideLabel"
                        title="@HideLabel"
                        @onclick="HideWindowAsync">
                    <Icon Name="visibility_off" />
                </button>
            </div>
        </header>

        <div class="cw-floating-window__body @BodyClass">
            @ChildContent
        </div>
    }
</section>

@code {
    private readonly CanvasSceneHost sceneHost = new();
    private ElementReference host;
    private DotNetObjectReference<CanvasFloatingWindow>? objectReference;
    private string? pendingStateKey;

    [Parameter, EditorRequired]
    public string WindowId { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Kicker { get; set; } = string.Empty;

    [Parameter]
    public string Summary { get; set; } = string.Empty;

    [Parameter]
    public string AriaLabel { get; set; } = "Canvas window";

    [Parameter]
    public string BodyClass { get; set; } = string.Empty;

    [Parameter]
    public string TestId { get; set; } = string.Empty;

    [Parameter]
    public string DefaultPlacement { get; set; } = "top-right";

    [Parameter]
    public double DefaultWidth { get; set; } = 360;

    [Parameter]
    public double DefaultHeight { get; set; } = 480;

    [Parameter]
    public double MinWidth { get; set; } = 280;

    [Parameter]
    public double MinHeight { get; set; } = 180;

    [Parameter]
    public double? MaxWidth { get; set; }

    [Parameter]
    public double? MaxHeight { get; set; }

    [Parameter]
    public bool AllowResize { get; set; } = true;

    [Parameter]
    public string RestoreLabel { get; set; } = "Expand window";

    [Parameter]
    public string MinimizeLabel { get; set; } = "Minimize window";

    [Parameter]
    public string NormalizeLabel { get; set; } = "Restart window position and size";

    [Parameter]
    public string HideLabel { get; set; } = "Hide window";

    [Parameter, EditorRequired]
    public CanvasWorkbenchWindowState State { get; set; } = new();

    [Parameter]
    public EventCallback<CanvasWorkbenchWindowState> StateChanged { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;

    protected override void OnParametersSet()
    {
        pendingStateKey = SerializationPersistencePack.Serialize(BuildInteropPayload());
        sceneHost.QueueSync(
            pendingStateKey,
            !string.Equals(sceneHost.AppliedStateKey, pendingStateKey, StringComparison.Ordinal));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        objectReference ??= DotNetObjectReference.Create(this);
        var bridge = new JsInteropBridge(JsRuntime);
        if (sceneHost.ShouldCreate())
        {
            await bridge.InvokeVoidAsync("CanDoItAll.canvasFloatingWindow.create", host, objectReference, BuildInteropPayload());
            sceneHost.MarkApplied();
            return;
        }

        if (!sceneHost.ShouldUpdate())
        {
            return;
        }

        await bridge.InvokeVoidAsync("CanDoItAll.canvasFloatingWindow.update", host, BuildInteropPayload());
        sceneHost.MarkApplied();
    }

    [JSInvokable]
    public Task OnGeometryChanged(double? left, double? top, double? width, double? height)
    {
        var next = CanvasWorkbenchWindowState.Normalize(
            new CanvasWorkbenchWindowState
            {
                IsVisible = true,
                IsMinimized = State.IsMinimized,
                Left = left,
                Top = top,
                Width = State.IsMinimized ? State.Width : width,
                Height = State.IsMinimized ? State.Height : height
            });

        return PublishStateAsync(next);
    }

    private Task MinimizeWindowAsync()
    {
        var next = State.Clone();
        next.IsVisible = true;
        next.IsMinimized = true;
        return PublishStateAsync(next);
    }

    private Task RestoreWindowAsync()
    {
        var next = State.Clone();
        next.IsVisible = true;
        next.IsMinimized = false;
        return PublishStateAsync(next);
    }

    private Task NormalizeWindowAsync()
        => PublishStateAsync(new CanvasWorkbenchWindowState { IsVisible = true });

    private Task HideWindowAsync()
    {
        var next = State.Clone();
        next.IsVisible = false;
        next.IsMinimized = false;
        return PublishStateAsync(next);
    }

    private bool IsNormalized => !State.IsMinimized && !State.HasCustomGeometry;

    private object BuildInteropPayload()
        => new
        {
            windowId = WindowId,
            placement = DefaultPlacement,
            defaultWidth = DefaultWidth,
            defaultHeight = DefaultHeight,
            minWidth = MinWidth,
            minHeight = MinHeight,
            maxWidth = MaxWidth,
            maxHeight = MaxHeight,
            allowResize = AllowResize,
            state = State
        };

    private Task PublishStateAsync(CanvasWorkbenchWindowState state)
    {
        var normalized = CanvasWorkbenchWindowState.Normalize(state);
        if (AreEquivalent(State, normalized))
        {
            return Task.CompletedTask;
        }

        return StateChanged.InvokeAsync(normalized);
    }

    private static bool AreEquivalent(CanvasWorkbenchWindowState left, CanvasWorkbenchWindowState right)
        => left.IsVisible == right.IsVisible &&
           left.IsMinimized == right.IsMinimized &&
           Nullable.Equals(left.Left, right.Left) &&
           Nullable.Equals(left.Top, right.Top) &&
           Nullable.Equals(left.Width, right.Width) &&
           Nullable.Equals(left.Height, right.Height);

    public async ValueTask DisposeAsync()
    {
        if (!sceneHost.IsInitialized)
        {
            objectReference?.Dispose();
            return;
        }

        try
        {
            await new JsInteropBridge(JsRuntime).InvokeVoidAsync("CanDoItAll.canvasFloatingWindow.dispose", host);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }

        objectReference?.Dispose();
    }
}



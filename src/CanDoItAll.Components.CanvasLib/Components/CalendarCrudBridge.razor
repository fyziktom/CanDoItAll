@namespace CanDoItAll.Components.CanvasLib
@implements IAsyncDisposable
@using CanDoItAll.Components.CanvasLib
@inject IJSRuntime JsRuntime

<CanvasBoundaryCard TestHookId="@Snapshot.TestHookId"
                           Label="@Snapshot.Label"
                           Title="@Snapshot.Title"
                           Summary="@Snapshot.Summary"
                           StatePill="@Snapshot.StatePill"
                           Metrics="@Snapshot.Metrics">
    <div class="space-y-3" @ref="host">
        @foreach (var operation in Snapshot.Operations)
        {
            <div class="rounded-2xl border border-slate-200 bg-white/80 px-4 py-3">
                <div class="flex items-center justify-between gap-3">
                    <strong class="text-sm text-slate-950">@operation.Label</strong>
                    <span class="rounded-full px-2 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] @(operation.IsEnabled ? "bg-emerald-100 text-emerald-700" : "bg-slate-100 text-slate-500")">
                        @(operation.IsEnabled ? "Enabled" : "Idle")
                    </span>
                </div>
                <p class="mt-2 text-sm text-slate-600">@operation.Description</p>
            </div>
        }
    </div>
</CanvasBoundaryCard>

@code {
    private readonly CanvasSceneHost sceneHost = new();
    private ElementReference host;
    private string? pendingSnapshotKey;

    [Parameter, EditorRequired]
    public CalendarCrudBridgeSnapshot Snapshot { get; set; } = default!;

    protected override void OnParametersSet()
    {
        pendingSnapshotKey = SerializationPersistencePack.Serialize(Snapshot);
        sceneHost.QueueSync(
            pendingSnapshotKey,
            !string.Equals(sceneHost.AppliedStateKey, pendingSnapshotKey, StringComparison.Ordinal));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var bridge = new JsInteropBridge(JsRuntime);
        if (sceneHost.ShouldCreate())
        {
            await bridge.InvokeVoidAsync("CanDoItAll.calendarCrudBridge.create", host, Snapshot);
            sceneHost.MarkApplied();
            return;
        }

        if (!sceneHost.ShouldUpdate())
        {
            return;
        }

        await bridge.InvokeVoidAsync("CanDoItAll.calendarCrudBridge.update", host, Snapshot);
        sceneHost.MarkApplied();
    }

    public async ValueTask DisposeAsync()
    {
        if (!sceneHost.IsInitialized)
        {
            return;
        }

        try
        {
            await new JsInteropBridge(JsRuntime).InvokeVoidAsync("CanDoItAll.calendarCrudBridge.dispose", host);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }
}



    private async Task PublishUiStateAsync()
    {
        var json = sceneHost.IsInitialized
            ? await JsRuntime.InvokeAsync<string>("CanDoItAll.canvasWorkbench.getState", host)
            : Surface.UiState.ToJson();

        var state = CanvasWorkbenchUiState.Parse(json);
        state.IsMaximized = isMaximized;
        zoomPercent = ClampZoomPercent(state.Zoom);
        await StateChanged.InvokeAsync(state.ToJson());
    }

    private T? Deserialize<T>(string json)
        => SerializationPersistencePack.Deserialize<T>(json);

    private static bool TryAcceptDispatchId(long dispatchId, ref long lastAcceptedDispatchId)
    {
        if (dispatchId <= 0)
        {
            return true;
        }

        if (dispatchId <= lastAcceptedDispatchId)
        {
            return false;
        }

        lastAcceptedDispatchId = dispatchId;
        return true;
    }

    private static int ClampZoomPercent(double zoom)
        => (int)Math.Round(Math.Clamp(zoom, MinZoomPercent / 100d, MaxZoomPercent / 100d) * 100);

    private static int ClampMenuScalePercent(double scale)
        => (int)Math.Round(Math.Clamp(scale, 0.8, 1.4) * 100);

    private string PreviewMenuScaleStyle
        => $"--cw-preview-menu-scale:{(menuScalePercent / 100d).ToString("0.##", CultureInfo.InvariantCulture)};";

    private string ThemeStyle => ThemeTokens.ToInlineStyle();

    private IReadOnlyList<CanvasThemeSwatch> ThemeSwatches => ThemeTokens.BuildPreviewSwatches();

    private IReadOnlyList<string> ThemeMetrics => ThemeTokens.BuildMetrics();

    private SelectionModel CurrentSelection
        => SelectionModel.From(Surface.UiState.SelectedNodeIds).RemoveMissing(Surface.Nodes.Select(node => node.Id));

    private string PrimarySelectionLabel
        => CurrentSelection.PrimaryNodeId is null
            ? "No primary selection"
            : ResolveNodeLabel(CurrentSelection.PrimaryNodeId);

    private string SelectionSummaryLabel
        => CurrentSelection.SelectedNodeIds.Count == 0
            ? "SelectionModel is ready for additive, toggle, and replace semantics."
            : $"{CurrentSelection.SelectedNodeIds.Count} ordered node ids are mirrored into the shared workbench state.";

    private string SelectionOrderLabel
        => CurrentSelection.SelectedNodeIds.Count == 0
            ? "Selection is currently empty."
            : string.Join(" -> ", CurrentSelection.SelectedNodeIds.Select(ResolveNodeLabel));
    private AccessibilityMirrorSnapshot AccessibilitySnapshot
        => AccessibilityMirrorLayerFactory.CreateForWorkbench(Surface, Surface.UiState.ShowDiagnostics);
    private string SerializeSurfaceData(CanvasWorkbenchSurface surface)
        => SerializationPersistencePack.Serialize(
            new
            {
                surface.SurfaceId,
                surface.Mode,
                surface.DependencySourceId,
                surface.Nodes,
                surface.Links,
                surface.Chrome
            });

    private Task DispatchContextActionAsync(CanvasWorkbenchContextActionRequest request)
        => ContextActionRequested.InvokeAsync(request);

    private string ResolveNodeLabel(string nodeId)
    {
        var node = Surface.Nodes.FirstOrDefault(candidate => string.Equals(candidate.Id, nodeId, StringComparison.Ordinal));
        if (node is null)
        {
            return nodeId;
        }

        if (!string.IsNullOrWhiteSpace(node.Title))
        {
            return node.Title;
        }

        if (!string.IsNullOrWhiteSpace(node.InlineText))
        {
            return node.InlineText;
        }

        return string.IsNullOrWhiteSpace(node.Kind)
            ? node.Id
            : node.Kind;
    }

    private void MarkSurfaceApplied()
        => sceneHost.MarkApplied();

    private static bool IsExpectedJsInteropCancellation(Exception exception)
        => exception is OperationCanceledException or JSDisconnectedException;

    private CanvasWorkbenchRenderOptions BuildRenderOptions(bool includeAutoFit)
        => new(
            isMaximized,
            includeAutoFit && ShouldAutoFitInitialView(),
            [.. Surface.UiState.SelectedNodeIds],
            Surface.UiState.SelectedNodeIds.FirstOrDefault());

    private bool ShouldAutoFitInitialView()
    {
        if (Surface.Nodes.Count == 0)
        {
            return false;
        }

        if (Surface.UiState.ManualPositions.Count > 0)
        {
            return false;
        }

        var usesDefaultViewport = Math.Abs(Surface.UiState.Zoom - 1d) < 0.001d
            && Math.Abs(Surface.UiState.PanX - 90d) < 0.001d
            && Math.Abs(Surface.UiState.PanY - 110d) < 0.001d;

        return usesDefaultViewport;
    }

    public async Task OpenCreateDialogAsync(CanvasWorkbenchAction action, CanvasWorkbenchCreateActionRequest request)
    {
        if (!sceneHost.IsInitialized)
        {
            await CreateActionInvoked.InvokeAsync(request);
            return;
        }

        if (action.RequiresInput)
        {
            await JsRuntime.InvokeVoidAsync("CanDoItAll.canvasWorkbench.openCreateComposer", host, action, request);
            return;
        }

        await CreateActionInvoked.InvokeAsync(request);
    }

    public async Task SelectNodesAsync(IReadOnlyList<string> nodeIds, string? primaryNodeId = null)
    {
        if (!sceneHost.IsInitialized || nodeIds.Count == 0)
        {
            return;
        }

        var resolvedPrimaryNodeId = string.IsNullOrWhiteSpace(primaryNodeId)
            ? nodeIds[0]
            : primaryNodeId;
        await JsRuntime.InvokeVoidAsync("CanDoItAll.canvasWorkbench.selectNodes", host, nodeIds, resolvedPrimaryNodeId);
    }

    public async Task<IReadOnlyList<string>> GetSelectedNodeIdsAsync()
    {
        if (!sceneHost.IsInitialized)
        {
            return Surface.UiState.SelectedNodeIds;
        }

        var stateJson = await JsRuntime.InvokeAsync<string>("CanDoItAll.canvasWorkbench.getState", host);
        return CanvasWorkbenchUiState.Parse(stateJson).SelectedNodeIds;
    }


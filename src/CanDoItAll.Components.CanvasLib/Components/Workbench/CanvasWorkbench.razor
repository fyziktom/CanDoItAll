        return await JsRuntime.InvokeAsync<string?>("CanDoItAll.canvasWorkbench.exportImageData", host);
    }

    public async ValueTask DisposeAsync()
    {
        if (sceneHost.IsInitialized)
        {
            try
            {
                await JsRuntime.InvokeVoidAsync("CanDoItAll.canvasWorkbench.setMaximized", host, false);
                await JsRuntime.InvokeVoidAsync("CanDoItAll.canvasWorkbench.dispose", host);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (OperationCanceledException)
            {
            }
            catch (JSException)
            {
            }
        }

        objectReference?.Dispose();
    }


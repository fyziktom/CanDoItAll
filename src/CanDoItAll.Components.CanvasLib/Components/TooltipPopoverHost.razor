@namespace CanDoItAll.Components.CanvasLib
@implements IAsyncDisposable
@using CanDoItAll.Components.CanvasLib
@inject IJSRuntime JsRuntime

<div class="cw-settings-preview" data-testid="@Snapshot.TestHookId" @ref="host">
    <p class="cw-settings-label">@Snapshot.Label</p>
    <div class="cw-theme-summary">
        <div>
            <p class="cw-theme-summary__title">@Snapshot.Title</p>
            <p class="cw-panel-copy">@Snapshot.Summary</p>
        </div>
        <span class="cw-theme-pill">@Snapshot.StatePill</span>
    </div>

    <div class="cw-theme-metrics">
        @foreach (var metric in Snapshot.Metrics)
        {
            <span class="cw-theme-metric">@metric</span>
        }
    </div>
</div>

@code {
    private readonly CanvasSceneHost sceneHost = new();
    private ElementReference host;
    private string? pendingSnapshotKey;

    [Parameter, EditorRequired]
    public TooltipPopoverHostSnapshot Snapshot { get; set; } = default!;

    protected override void OnParametersSet()
    {
        pendingSnapshotKey = SerializationPersistencePack.Serialize(Snapshot);
        sceneHost.QueueSync(
            pendingSnapshotKey,
            !string.Equals(sceneHost.AppliedStateKey, pendingSnapshotKey, StringComparison.Ordinal));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var bridge = new JsInteropBridge(JsRuntime);
        if (sceneHost.ShouldCreate())
        {
            await bridge.InvokeVoidAsync("CanDoItAll.tooltipPopoverHost.create", host, Snapshot);
            sceneHost.MarkApplied();
            return;
        }

        if (!sceneHost.ShouldUpdate())
        {
            return;
        }

        await bridge.InvokeVoidAsync("CanDoItAll.tooltipPopoverHost.update", host, Snapshot);
        sceneHost.MarkApplied();
    }

    public async ValueTask DisposeAsync()
    {
        if (!sceneHost.IsInitialized)
        {
            return;
        }

        try
        {
            await new JsInteropBridge(JsRuntime).InvokeVoidAsync("CanDoItAll.tooltipPopoverHost.dispose", host);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }
}



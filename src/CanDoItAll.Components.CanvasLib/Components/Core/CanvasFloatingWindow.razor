@namespace CanDoItAll.Components.CanvasLib
@using CanDoItAll.Components.OverlayLib

<OverlayWindow WindowId="@WindowId"
               Title="@Title"
               Kicker="@Kicker"
               Summary="@Summary"
               AriaLabel="@AriaLabel"
               BodyClass="@BodyClass"
               TestId="@TestId"
               DefaultPlacement="@DefaultPlacement"
               ContainerSelector="@ContainerSelector"
               SafeTopSelector="@SafeTopSelector"
               InteropApiRoot="CanDoItAll.canvasFloatingWindow"
               DefaultWidth="@DefaultWidth"
               DefaultHeight="@DefaultHeight"
               MinWidth="@MinWidth"
               MinHeight="@MinHeight"
               MaxWidth="@MaxWidth"
               MaxHeight="@MaxHeight"
               AllowResize="@AllowResize"
               RestoreLabel="@RestoreLabel"
               MinimizeLabel="@MinimizeLabel"
               NormalizeLabel="@NormalizeLabel"
               HideLabel="@HideLabel"
               ShowHeader="@ShowHeader"
               State="@State.ToOverlayWindowState()"
               StateChanged="HandleOverlayStateChangedAsync">
    @ChildContent
</OverlayWindow>

@code {
    [Parameter, EditorRequired]
    public string WindowId { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Kicker { get; set; } = string.Empty;

    [Parameter]
    public string Summary { get; set; } = string.Empty;

    [Parameter]
    public string AriaLabel { get; set; } = "Canvas window";

    [Parameter]
    public string BodyClass { get; set; } = string.Empty;

    [Parameter]
    public string TestId { get; set; } = string.Empty;

    [Parameter]
    public string DefaultPlacement { get; set; } = "top-right";

    [Parameter]
    public string ContainerSelector { get; set; } = ".cw-stage-surface";

    [Parameter]
    public string SafeTopSelector { get; set; } = ".cw-toolbar";

    [Parameter]
    public double DefaultWidth { get; set; } = 360;

    [Parameter]
    public double DefaultHeight { get; set; } = 480;

    [Parameter]
    public double MinWidth { get; set; } = 280;

    [Parameter]
    public double MinHeight { get; set; } = 180;

    [Parameter]
    public double? MaxWidth { get; set; }

    [Parameter]
    public double? MaxHeight { get; set; }

    [Parameter]
    public bool AllowResize { get; set; } = true;

    [Parameter]
    public string RestoreLabel { get; set; } = "Expand window";

    [Parameter]
    public string MinimizeLabel { get; set; } = "Minimize window";

    [Parameter]
    public string NormalizeLabel { get; set; } = "Restart window position and size";

    [Parameter]
    public string HideLabel { get; set; } = "Hide window";

    [Parameter]
    public bool ShowHeader { get; set; } = true;

    [Parameter, EditorRequired]
    public CanvasWorkbenchWindowState State { get; set; } = new();

    [Parameter]
    public EventCallback<CanvasWorkbenchWindowState> StateChanged { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;

    public Task OnGeometryChanged(double? left, double? top, double? width, double? height)
    {
        var next = CanvasWorkbenchWindowState.Normalize(
            new CanvasWorkbenchWindowState
            {
                IsVisible = true,
                IsMinimized = State.IsMinimized,
                Left = left,
                Top = top,
                Width = State.IsMinimized ? State.Width : width,
                Height = State.IsMinimized ? State.Height : height
            });

        return PublishStateAsync(next);
    }

    private Task HandleOverlayStateChangedAsync(OverlayWindowState state)
        => PublishStateAsync(CanvasWorkbenchWindowState.FromOverlayWindowState(state));

    private Task PublishStateAsync(CanvasWorkbenchWindowState state)
    {
        var normalized = CanvasWorkbenchWindowState.Normalize(state);
        if (AreEquivalent(State, normalized))
        {
            return Task.CompletedTask;
        }

        return StateChanged.InvokeAsync(normalized);
    }

    private static bool AreEquivalent(CanvasWorkbenchWindowState left, CanvasWorkbenchWindowState right)
        => left.IsVisible == right.IsVisible &&
           left.IsMinimized == right.IsMinimized &&
           Nullable.Equals(left.Left, right.Left) &&
           Nullable.Equals(left.Top, right.Top) &&
           Nullable.Equals(left.Width, right.Width) &&
           Nullable.Equals(left.Height, right.Height);
}


<div class="flex flex-col gap-3 border-b border-slate-200 pb-4 md:flex-row md:items-end md:justify-between">
    <div class="space-y-1">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-500">@Eyebrow</p>
        <h1 class="text-3xl font-semibold tracking-tight text-slate-950">@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="max-w-3xl text-sm leading-6 text-slate-600">@Description</p>
        }
    </div>

    @if (Actions is not null)
    {
        <div class="flex flex-wrap items-center gap-2">
            @Actions
        </div>
    }
</div>

@code {
    [Parameter]
    public string Eyebrow { get; set; } = "Workspace";

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }
}

<div class="@(Compact ? "flex items-center justify-between gap-3" : "flex flex-col gap-3 border-b border-slate-200 pb-4 md:flex-row md:items-end md:justify-between")">
    <div class="@(Compact ? "flex min-w-0 items-center gap-3" : "space-y-1")">
        <p class="@(Compact ? "text-[10px]" : "text-xs") font-semibold uppercase tracking-[0.3em] text-slate-500">@Eyebrow</p>
        <h1 class="@(Compact ? "text-lg" : "text-3xl") font-semibold tracking-tight text-slate-950">@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Description) && !Compact)
        {
            <p class="max-w-3xl text-sm leading-6 text-slate-600">@Description</p>
        }
    </div>

    @if (Actions is not null)
    {
        <div class="flex flex-shrink-0 flex-wrap items-center gap-2">
            @Actions
        </div>
    }
</div>

@code {
    [Parameter]
    public string Eyebrow { get; set; } = "Workspace";

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public bool Compact { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }
}


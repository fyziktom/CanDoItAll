    private string SerializeSurfaceData(CanvasWorkbenchSurface surface)
        => SerializationPersistencePack.Serialize(
            new
            {
                surface.SurfaceId,
                surface.Mode,
                surface.Nodes,
                surface.Links,
                surface.Chrome
            });

    private string ResolveNodeLabel(string nodeId)
    {
        var node = Surface.Nodes.FirstOrDefault(candidate => string.Equals(candidate.Id, nodeId, StringComparison.Ordinal));
        if (node is null)
        {
            return nodeId;
        }

        if (!string.IsNullOrWhiteSpace(node.Title))
        {
            return node.Title;
        }

        if (!string.IsNullOrWhiteSpace(node.InlineText))
        {
            return node.InlineText;
        }

        return string.IsNullOrWhiteSpace(node.Kind)
            ? node.Id
            : node.Kind;
    }

    private void MarkSurfaceApplied()
        => sceneHost.MarkApplied();

    private bool ShouldAutoFitInitialView()
    {
        if (Surface.Nodes.Count == 0)
        {
            return false;
        }

        if (Surface.UiState.ManualPositions.Count > 0)
        {
            return false;
        }

        var usesDefaultViewport = Math.Abs(Surface.UiState.Zoom - 1d) < 0.001d
            && Math.Abs(Surface.UiState.PanX - 90d) < 0.001d
            && Math.Abs(Surface.UiState.PanY - 110d) < 0.001d;

        return usesDefaultViewport;
    }

    public async Task OpenCreateDialogAsync(CanvasWorkbenchAction action, CanvasWorkbenchCreateActionRequest request)
    {
        if (!sceneHost.IsInitialized)
        {
            await CreateActionInvoked.InvokeAsync(request);
            return;
        }

        if (action.RequiresInput)
        {
            await JsRuntime.InvokeVoidAsync("CanDoItAll.canvasWorkbench.openCreateComposer", host, action, request);
            return;
        }

        await CreateActionInvoked.InvokeAsync(request);
    }

    public async ValueTask DisposeAsync()
    {
        if (sceneHost.IsInitialized)
        {
            try
            {
                await JsRuntime.InvokeVoidAsync("CanDoItAll.canvasWorkbench.setMaximized", host, false);
                await JsRuntime.InvokeVoidAsync("CanDoItAll.canvasWorkbench.dispose", host);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }
        }

        objectReference?.Dispose();
    }

@implements IAsyncDisposable
@using System.Globalization
@using CanDoItAll.ComponentKit.Canvas
@using CanDoItAll.ComponentKit.Components
@inject IJSRuntime JsRuntime

<div class="cw-workbench-shell @(isMaximized ? "is-maximized" : string.Empty)"
     style="@ThemeStyle"
     data-theme-key="@ThemeTokens.ThemeKey">
    <div class="cw-workbench-frame">
        <div class="cw-toolbar">
            <div class="cw-toolbar-group cw-toolbar-group--left">
                @if (Surface.Chrome.ShowQuickCreateRail && Surface.Chrome.QuickCreateActions.Count > 0)
                {
                    <button type="button"
                            class="cw-toolbar-action cw-toolbar-action--primary"
                            @ref="quickCreateButton"
                            aria-label="Open quick create actions"
                            title="Open quick create actions"
                            @onclick="OpenQuickCreateMenuAsync">
                        <span class="cw-toolbar-symbol" aria-hidden="true">+</span>
                        <span class="sr-only">Open quick create actions</span>
                    </button>
                }

                @if (Surface.Chrome.ShowFocusAction)
                {
                    <button type="button"
                            class="cw-toolbar-action cw-toolbar-action--icon"
                            aria-label="@Surface.Chrome.FocusActionLabel"
                            title="@Surface.Chrome.FocusActionLabel"
                            @onclick="FocusPrimaryNodeAsync">
                        <span class="cw-toolbar-symbol" aria-hidden="true">◎</span>
                        <span class="sr-only">@Surface.Chrome.FocusActionLabel</span>
                    </button>
                }

                @ToolbarLeftContent
            </div>

            <div class="cw-toolbar-group">
                <button type="button"
                        class="cw-toolbar-action cw-toolbar-action--icon"
                        aria-label="Fit canvas"
                        title="Fit canvas"
                        @onclick="FitViewAsync">
                    <span class="cw-toolbar-symbol" aria-hidden="true">◫</span>
                    <span class="sr-only">Fit canvas</span>
                </button>
                <button type="button"
                        class="cw-toolbar-action cw-toolbar-action--icon"
                        aria-label="Toggle maximize"
                        title="@(isMaximized ? "Dock canvas" : "Maximize canvas")"
                        @onclick="ToggleMaximizeAsync">
                    <span class="cw-toolbar-symbol" aria-hidden="true">@(isMaximized ? "⤡" : "⤢")</span>
                    <span class="sr-only">@(isMaximized ? "Dock canvas" : "Maximize canvas")</span>
                </button>
                <button type="button"
                        class="cw-toolbar-action cw-toolbar-action--icon"
                        aria-label="Toggle minimap"
                        title="Toggle minimap"
                        @onclick="ToggleMinimapAsync">
                    <span class="cw-toolbar-symbol" aria-hidden="true">M</span>
                    <span class="sr-only">Toggle minimap</span>
                </button>
                <button type="button"
                        class="cw-toolbar-action cw-toolbar-action--icon"
                        aria-label="Toggle diagnostics"
                        title="Toggle diagnostics"
                        @onclick="ToggleDiagnosticsAsync">
                    <span class="cw-toolbar-symbol" aria-hidden="true">D</span>
                    <span class="sr-only">Toggle diagnostics</span>
                </button>
                <button type="button"
                        class="cw-toolbar-action cw-toolbar-action--icon"
                        aria-label="Toggle help"
                        title="Canvas help"
                        @onclick="ToggleHelp">
                    <span class="cw-toolbar-symbol" aria-hidden="true">?</span>
                    <span class="sr-only">Canvas help</span>
                </button>
                <button type="button"
                        class="cw-toolbar-action cw-toolbar-action--icon"
                        aria-label="Toggle settings"
                        title="Canvas settings"
                        @onclick="ToggleSettings">
                    <span class="cw-toolbar-symbol" aria-hidden="true">⚙</span>
                    <span class="sr-only">Canvas settings</span>
                </button>

                <div class="cw-zoom-rail">
                    <button type="button"
                            class="cw-toolbar-action cw-toolbar-action--ghost cw-toolbar-action--icon"
                            aria-label="Zoom out"
                            title="Zoom out"
                            @onclick="ZoomOutAsync">
                        <span class="cw-toolbar-symbol" aria-hidden="true">−</span>
                        <span class="sr-only">Zoom out</span>
                    </button>
                    <input class="cw-zoom-slider"
                           type="range"
                           min="15"
                           max="175"
                           step="5"
                           value="@zoomPercent"
                           aria-label="Canvas zoom"
                           @onchange="HandleZoomChangedAsync" />
                    <button type="button"
                            class="cw-toolbar-action cw-toolbar-action--ghost cw-toolbar-action--icon"
                            aria-label="Zoom in"
                            title="Zoom in"
                            @onclick="ZoomInAsync">
                        <span class="cw-toolbar-symbol" aria-hidden="true">+</span>
                        <span class="sr-only">Zoom in</span>
                    </button>
                    <span class="cw-zoom-pill">@($"{zoomPercent}%")</span>
                </div>
            </div>
        </div>

        <div class="cw-stage-surface">
            <div @ref="host"
                 class="cw-canvas-host"
                 tabindex="0"
                 aria-label="Canvas workbench">
            </div>

            @if (!string.IsNullOrWhiteSpace(Surface.Chrome.HintText))
            {
                <div class="cw-hint-pill">@Surface.Chrome.HintText</div>
            }

            @OverlayContent
            <AccessibilityMirrorLayer Snapshot="@AccessibilitySnapshot" />
        </div>

        @if (helpOpen)
        {
            <div class="cw-help-overlay">
                <div class="cw-help-card" role="dialog" aria-modal="false" aria-label="Canvas shortcuts and gestures">
                    <div class="cw-help-card__header">
                        <div>
                            <p class="cw-help-kicker">Canvas help</p>
                            <h3>Interaction vocabulary</h3>
                        </div>

                        <button type="button" class="cw-toolbar-action" aria-label="Close help" @onclick="ToggleHelp">Close</button>
                    </div>

                    <div class="cw-help-grid">
                        <p><strong>Click</strong> selects the focused node.</p>
                        <p><strong>Right-click</strong> opens node-aware actions.</p>
                        <p><strong>Alt + drag</strong> draws a marquee for multi-selection.</p>
                        <p><strong>Ctrl/Cmd + drag</strong> moves the current node set.</p>
                        <p><strong>Drag empty space</strong> pans the scene.</p>
                        <p><strong>Mouse wheel</strong> zooms under the pointer.</p>
                        <p><strong>Double-click</strong> collapses groups or opens artifacts.</p>
                        <p><strong>Ctrl/Cmd + C</strong> copies the current selection to the shared canvas clipboard.</p>
                        <p><strong>Ctrl/Cmd + V</strong> sends clipboard content back through the shared workbench bridge.</p>
                        <p><strong>m, d, +, -, 0, ?, h, Escape</strong> control minimap, diagnostics, zoom, help, and selection.</p>
                    </div>
                </div>
            </div>
        }

        @if (settingsOpen)
        {
            <div class="cw-help-overlay">
                <div class="cw-help-card cw-settings-card" role="dialog" aria-modal="false" aria-label="Canvas settings">
                    <div class="cw-help-card__header">
                        <div>
                            <p class="cw-help-kicker">Canvas settings</p>
                            <h3>Radial menu tuning</h3>
                        </div>

                        <button type="button" class="cw-toolbar-action" aria-label="Close settings" @onclick="ToggleSettings">Close</button>
                    </div>

                    <div class="cw-settings-grid">
                        <div class="cw-settings-group">
                            <div>
                                <p class="cw-settings-label">Menu item size</p>
                                <p class="cw-panel-copy">Tune the right-click hex size and keep the preview aligned with the live canvas menu.</p>
                            </div>

                            <div class="cw-zoom-rail cw-settings-rail">
                                <button type="button" class="cw-toolbar-action cw-toolbar-action--ghost" aria-label="Decrease menu item size" @onclick="DecreaseMenuScaleAsync">-</button>
                                <input class="cw-zoom-slider"
                                       type="range"
                                       min="80"
                                       max="140"
                                       step="5"
                                       value="@menuScalePercent"
                                       aria-label="Canvas menu item size"
                                       @oninput="HandleMenuScaleChangedAsync" />
                                <button type="button" class="cw-toolbar-action cw-toolbar-action--ghost" aria-label="Increase menu item size" @onclick="IncreaseMenuScaleAsync">+</button>
                                <span class="cw-zoom-pill">@($"{menuScalePercent}%")</span>
                            </div>
                        </div>

                        <div class="cw-settings-preview">
                            <p class="cw-settings-label">Preview</p>
                            <div class="cw-menu-preview-shell" style="@PreviewMenuScaleStyle">
                                <div class="cw-menu-preview-orbit">
                                    <div class="cw-menu-preview-core">
                                        <span class="cw-menu-preview-core-dot"></span>
                                    </div>
                                    <div class="cw-menu-preview-item tone-accent">
                                        <span class="cw-menu-preview-item__icon">↗</span>
                                        <span class="cw-menu-preview-item__label">Open</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="cw-settings-preview cw-theme-preview" data-testid="canvas-theme-token-pack">
                            <p class="cw-settings-label">Theme pack</p>
                            <div class="cw-theme-summary">
                                <div>
                                    <p class="cw-theme-summary__title">@ThemeTokens.ThemeName</p>
                                    <p class="cw-panel-copy">Shared color, radius, and shadow tokens now come from the typed theme pack instead of only living in CSS.</p>
                                </div>
                                <span class="cw-theme-pill">@ThemeTokens.ThemeKey</span>
                            </div>

                            <div class="cw-theme-swatch-grid">
                                @foreach (var swatch in ThemeSwatches)
                                {
                                    <div class="cw-theme-swatch">
                                        <span class="cw-theme-swatch__chip" style="@($"--cw-token-swatch:{swatch.Value};")"></span>
                                        <div>
                                            <strong>@swatch.Label</strong>
                                            <p>@swatch.Description</p>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="cw-theme-metrics">
                                @foreach (var metric in ThemeMetrics)
                                {
                                    <span class="cw-theme-metric">@metric</span>
                                }
                            </div>
                        </div>

                        <div class="cw-settings-preview cw-selection-preview" data-testid="selection-model-preview">
                            <p class="cw-settings-label">Selection snapshot</p>
                            <div class="cw-selection-preview__summary">
                                <div>
                                    <p class="cw-theme-summary__title">@PrimarySelectionLabel</p>
                                    <p class="cw-panel-copy">@SelectionSummaryLabel</p>
                                </div>
                                <span class="cw-theme-pill">@($"{CurrentSelection.SelectedNodeIds.Count} selected")</span>
                            </div>

                            <div class="cw-selection-preview__order">
                                <span class="cw-selection-preview__label">Ordered ids</span>
                                <p>@SelectionOrderLabel</p>
                            </div>
                        </div>

                        <ChipBadgePrimitive Snapshot="@ChipBadgeSnapshot" />

                        <IconGlyphPrimitive Snapshot="@IconGlyphSnapshot" />

                        <TextBlockPrimitive Snapshot="@TextBlockSnapshot" />

                        <ContainerPrimitive Snapshot="@ContainerSnapshot" />

                        <ImagePrimitive Snapshot="@ImageSnapshot" />

                        <NodeCardComposer Snapshot="@NodeCardSnapshot" />

                        <ConnectorPathPrimitive Snapshot="@ConnectorPathSnapshot" />

                        <ContextMenuHost Snapshot="@ContextMenuSnapshot" />

                        <CreateActionPalette Snapshot="@CreatePaletteSnapshot" />

                        <FloatingInspectorHost Snapshot="@FloatingInspectorSnapshot" />

                        <GroupFrameOverlay Snapshot="@GroupFrameSnapshot" />

                        <InlineEditorComposer Snapshot="@InlineEditorSnapshot" />

                        <DragDropController Snapshot="@DragDropSnapshot" />

                        <GridBackdrop Snapshot="@GridBackdropSnapshot" />

                        <HitTestService Snapshot="@HitTestSnapshot" />

                        <HoverFocusRouter Snapshot="@HoverFocusSnapshot" />

                        <KeyboardShortcutRouter Snapshot="@KeyboardShortcutSnapshot" />

                        <LayoutEngine Snapshot="@LayoutSnapshot" />

                        <CanvasSceneHostPreview Snapshot="@CanvasSceneHostSnapshot" />

                        <CommandHistoryStorePreview Snapshot="@CommandHistorySnapshot" />

                        <InvalidationSchedulerPreview Snapshot="@InvalidationSnapshot" />

                        <JsInteropBridgePreview Snapshot="@JsInteropSnapshot" />

                        <LayerStackPreview Snapshot="@LayerStackSnapshot" />

                        <SceneNodeModelPreview Snapshot="@SceneNodeSnapshot" />

                        <SerializationPersistencePackPreview Snapshot="@SerializationSnapshot" />

                        <ViewportControllerPreview Snapshot="@ViewportControllerSnapshot" />

                        <TextMeasureServicePreview Snapshot="@TextMeasureSnapshot" />

                        <AnimationTimelinePreview Snapshot="@AnimationTimelineSnapshot" />

                        <DiagnosticsOverlay Snapshot="@DiagnosticsSnapshot" />

                        <MinimapOverview Snapshot="@MinimapSnapshot" />

                        <ClipboardBridge Snapshot="@ClipboardSnapshot" />

                        <EmptyStateOverlay Snapshot="@EmptyStateSnapshot" />

                        <SkeletonStateOverlay Snapshot="@SkeletonSnapshot" />

                        <TooltipPopoverHost Snapshot="@TooltipPopoverSnapshot" />

                        <MarqueeSelectionOverlay Snapshot="@MarqueeSelectionSnapshot" />

                        <SnapGuideSystem Snapshot="@SnapGuideSnapshot" />

                        <ConnectorAnchorOverlay Snapshot="@ConnectorAnchorSnapshot" />

                        <TransformHandlesOverlay Snapshot="@TransformHandlesSnapshot" />
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private const int MinZoomPercent = 15;
    private const int MaxZoomPercent = 175;
    private static readonly CanvasThemeTokenPack ThemeTokens = CanvasThemeTokenPack.Default;
    private readonly CanvasSceneHost sceneHost = new();
    private ElementReference host;
    private ElementReference quickCreateButton;
    private DotNetObjectReference<CanvasWorkbench>? objectReference;
    private bool helpOpen;
    private bool settingsOpen;
    private bool isMaximized;
    private int zoomPercent = 100;
    private int menuScalePercent = 100;
    private string? pendingDataKey;
    private string? pendingUiStateKey;
    private string? clientUiStateKey;

    [Parameter, EditorRequired]
    public CanvasWorkbenchSurface Surface { get; set; } = default!;

    [Parameter]
    public EventCallback<CanvasWorkbenchSelectionChangedEventArgs> SelectionChanged { get; set; }

    [Parameter]
    public EventCallback<CanvasWorkbenchNodesMovedEventArgs> NodesMoved { get; set; }

    [Parameter]
    public EventCallback<CanvasWorkbenchContextActionRequest> ContextActionRequested { get; set; }

    [Parameter]
    public EventCallback<CanvasWorkbenchCreateActionRequest> CreateActionInvoked { get; set; }

    [Parameter]
    public EventCallback<CanvasWorkbenchNodeEditRequest> NodeEdited { get; set; }

    [Parameter]
    public EventCallback<string> NodeOpened { get; set; }

    [Parameter]
    public EventCallback<string> StateChanged { get; set; }

    [Parameter]
    public EventCallback<CanvasWorkbenchClipboardRequest> ClipboardRequested { get; set; }

    [Parameter]
    public RenderFragment? ToolbarLeftContent { get; set; }

    [Parameter]
    public RenderFragment? OverlayContent { get; set; }

    protected override void OnParametersSet()
    {
        isMaximized = Surface.UiState.IsMaximized;
        zoomPercent = ClampZoomPercent(Surface.UiState.Zoom);
        menuScalePercent = ClampMenuScalePercent(Surface.UiState.MenuActionScale);
        pendingDataKey = SerializeSurfaceData(Surface);
        pendingUiStateKey = Surface.UiState.ToJson();

        var dataChanged = !string.Equals(sceneHost.AppliedStateKey, pendingDataKey, StringComparison.Ordinal);
        var uiChangedOutsideClient = !string.Equals(clientUiStateKey, pendingUiStateKey, StringComparison.Ordinal);
        sceneHost.QueueSync(pendingDataKey, dataChanged || uiChangedOutsideClient);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        objectReference ??= DotNetObjectReference.Create(this);
        var bridge = new JsInteropBridge(JsRuntime);
        if (sceneHost.ShouldCreate())
        {
            await bridge.InvokeVoidAsync("CanDoItAll.canvasWorkbench.create", host, objectReference, Surface);
            await bridge.InvokeVoidAsync("CanDoItAll.canvasWorkbench.setMaximized", host, isMaximized);
            if (ShouldAutoFitInitialView())
            {
                await bridge.InvokeVoidAsync("CanDoItAll.canvasWorkbench.fitView", host);
            }
            MarkSurfaceApplied();
            return;
        }

        if (!sceneHost.ShouldUpdate())
        {
            return;
        }

        await bridge.InvokeVoidAsync("CanDoItAll.canvasWorkbench.update", host, Surface);
        await bridge.InvokeVoidAsync("CanDoItAll.canvasWorkbench.setMaximized", host, isMaximized);
        MarkSurfaceApplied();
    }

    [JSInvokable]
    public async Task OnSelectionChanged(string? primaryNodeId, string selectedNodeIdsJson)
    {
        var selectedNodeIds = Deserialize<List<string>>(selectedNodeIdsJson) ?? [];
        await SelectionChanged.InvokeAsync(new CanvasWorkbenchSelectionChangedEventArgs(primaryNodeId, selectedNodeIds));
    }

    [JSInvokable]
    public async Task OnNodesMoved(string positionsJson)
    {
        var positions = Deserialize<List<CanvasWorkbenchNodePositionChange>>(positionsJson) ?? [];
        await NodesMoved.InvokeAsync(new CanvasWorkbenchNodesMovedEventArgs(positions));
    }

    [JSInvokable]
    public Task OnContextAction(string? nodeId, string actionId, double x, double y)
        => ContextActionRequested.InvokeAsync(new CanvasWorkbenchContextActionRequest(nodeId, actionId, x, y));

    [JSInvokable]
    public Task OnCreateAction(string requestJson)
    {
        var request = Deserialize<CanvasWorkbenchCreateActionRequest>(requestJson);
        return request is null
            ? Task.CompletedTask
            : CreateActionInvoked.InvokeAsync(request);
    }

    [JSInvokable]
    public Task OnNodeEdited(string requestJson)
    {
        var request = Deserialize<CanvasWorkbenchNodeEditRequest>(requestJson);
        return request is null
            ? Task.CompletedTask
            : NodeEdited.InvokeAsync(request);
    }

    [JSInvokable]
    public Task OnNodeOpened(string nodeId)
        => NodeOpened.InvokeAsync(nodeId);

    [JSInvokable]
    public async Task OnStateChanged(string stateJson)
    {
        var state = CanvasWorkbenchUiState.Parse(stateJson);
        state.IsMaximized = isMaximized;
        clientUiStateKey = state.ToJson();
        zoomPercent = ClampZoomPercent(state.Zoom);
        menuScalePercent = ClampMenuScalePercent(state.MenuActionScale);
        await StateChanged.InvokeAsync(clientUiStateKey);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnClipboardAction(string actionId, string payloadJson)
        => ClipboardRequested.InvokeAsync(new CanvasWorkbenchClipboardRequest(actionId, payloadJson));

    [JSInvokable]
    public async Task OnHelpToggled(bool isOpen)
    {
        helpOpen = isOpen;
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleHelp()
    {
        helpOpen = !helpOpen;
        if (helpOpen)
        {
            settingsOpen = false;
        }
    }

    private void ToggleSettings()
    {
        settingsOpen = !settingsOpen;
        if (settingsOpen)
        {
            helpOpen = false;
        }
    }

    private async Task ToggleMaximizeAsync()
    {
        isMaximized = !isMaximized;
        if (sceneHost.IsInitialized)
        {
            await JsRuntime.InvokeVoidAsync("CanDoItAll.canvasWorkbench.setMaximized", host, isMaximized);
        }

        await PublishUiStateAsync();
        if (sceneHost.IsInitialized)
        {
            await JsRuntime.InvokeVoidAsync("CanDoItAll.canvasWorkbench.resize", host);
        }
    }

    private async Task FitViewAsync()
    {
        if (!sceneHost.IsInitialized)
        {
            return;
        }

        await JsRuntime.InvokeVoidAsync("CanDoItAll.canvasWorkbench.fitView", host);
    }

    private async Task FocusPrimaryNodeAsync()
    {
        var targetNodeId = Surface.Nodes.FirstOrDefault(node => string.Equals(node.Family, "root", StringComparison.OrdinalIgnoreCase))?.Id
            ?? Surface.Nodes.FirstOrDefault(node => string.IsNullOrWhiteSpace(node.ParentId))?.Id
            ?? Surface.UiState.SelectedNodeIds.FirstOrDefault()
            ?? Surface.Nodes.FirstOrDefault()?.Id;
        if (!sceneHost.IsInitialized || string.IsNullOrWhiteSpace(targetNodeId))
        {
            return;
        }

        await JsRuntime.InvokeVoidAsync("CanDoItAll.canvasWorkbench.focusNode", host, targetNodeId);
    }

    private Task ZoomInAsync() => SetZoomPercentAsync(Math.Min(MaxZoomPercent, zoomPercent + 10));

    private Task ZoomOutAsync() => SetZoomPercentAsync(Math.Max(MinZoomPercent, zoomPercent - 10));

    private Task IncreaseMenuScaleAsync() => SetMenuScalePercentAsync(Math.Min(140, menuScalePercent + 5));

    private Task DecreaseMenuScaleAsync() => SetMenuScalePercentAsync(Math.Max(80, menuScalePercent - 5));

    private async Task HandleZoomChangedAsync(ChangeEventArgs args)
    {
        if (args.Value is null || !int.TryParse(args.Value.ToString(), out var parsed))
        {
            return;
        }

        await SetZoomPercentAsync(parsed);
    }

    private async Task SetZoomPercentAsync(int value)
    {
        zoomPercent = Math.Clamp(value, MinZoomPercent, MaxZoomPercent);
        if (sceneHost.IsInitialized)
        {
            await JsRuntime.InvokeVoidAsync("CanDoItAll.canvasWorkbench.setZoomPercent", host, zoomPercent);
        }
    }

    private async Task HandleMenuScaleChangedAsync(ChangeEventArgs args)
    {
        if (args.Value is null || !int.TryParse(args.Value.ToString(), out var parsed))
        {
            return;
        }

        await SetMenuScalePercentAsync(parsed);
    }

    private async Task SetMenuScalePercentAsync(int value)
    {
        menuScalePercent = Math.Clamp(value, 80, 140);
        if (sceneHost.IsInitialized)
        {
            await JsRuntime.InvokeVoidAsync("CanDoItAll.canvasWorkbench.setMenuScalePercent", host, menuScalePercent);
        }
    }

    private async Task OpenQuickCreateMenuAsync()
    {
        if (!sceneHost.IsInitialized || !Surface.Chrome.ShowQuickCreateRail || Surface.Chrome.QuickCreateActions.Count == 0)
        {
            return;
        }

        await JsRuntime.InvokeVoidAsync("CanDoItAll.canvasWorkbench.openQuickCreateMenu", host, quickCreateButton);
    }

    private async Task ToggleMinimapAsync()
    {
        if (!sceneHost.IsInitialized)
        {
            return;
        }

        await JsRuntime.InvokeVoidAsync("CanDoItAll.canvasWorkbench.toggleMinimap", host);
    }

    private async Task ToggleDiagnosticsAsync()
    {
        if (!sceneHost.IsInitialized)
        {
            return;
        }

        await JsRuntime.InvokeVoidAsync("CanDoItAll.canvasWorkbench.toggleDiagnostics", host);
    }

    private async Task PublishUiStateAsync()
    {
        var json = sceneHost.IsInitialized
            ? await JsRuntime.InvokeAsync<string>("CanDoItAll.canvasWorkbench.getState", host)
            : Surface.UiState.ToJson();

        var state = CanvasWorkbenchUiState.Parse(json);
        state.IsMaximized = isMaximized;
        zoomPercent = ClampZoomPercent(state.Zoom);
        await StateChanged.InvokeAsync(state.ToJson());
    }

    private T? Deserialize<T>(string json)
        => SerializationPersistencePack.Deserialize<T>(json);

    private static int ClampZoomPercent(double zoom)
        => (int)Math.Round(Math.Clamp(zoom, MinZoomPercent / 100d, MaxZoomPercent / 100d) * 100);

    private static int ClampMenuScalePercent(double scale)
        => (int)Math.Round(Math.Clamp(scale, 0.8, 1.4) * 100);

    private string PreviewMenuScaleStyle
        => $"--cw-preview-menu-scale:{(menuScalePercent / 100d).ToString("0.##", CultureInfo.InvariantCulture)};";

    private string ThemeStyle => ThemeTokens.ToInlineStyle();

    private IReadOnlyList<CanvasThemeSwatch> ThemeSwatches => ThemeTokens.BuildPreviewSwatches();

    private IReadOnlyList<string> ThemeMetrics => ThemeTokens.BuildMetrics();

    private SelectionModel CurrentSelection
        => SelectionModel.From(Surface.UiState.SelectedNodeIds).RemoveMissing(Surface.Nodes.Select(node => node.Id));

    private string PrimarySelectionLabel
        => CurrentSelection.PrimaryNodeId is null
            ? "No primary selection"
            : ResolveNodeLabel(CurrentSelection.PrimaryNodeId);

    private string SelectionSummaryLabel
        => CurrentSelection.SelectedNodeIds.Count == 0
            ? "SelectionModel is ready for additive, toggle, and replace semantics."
            : $"{CurrentSelection.SelectedNodeIds.Count} ordered node ids are mirrored into the shared workbench state.";

    private string SelectionOrderLabel
        => CurrentSelection.SelectedNodeIds.Count == 0
            ? "Selection is currently empty."
            : string.Join(" -> ", CurrentSelection.SelectedNodeIds.Select(ResolveNodeLabel));

    private ChipBadgePrimitiveSnapshot ChipBadgeSnapshot
        => ChipBadgePrimitiveFactory.CreateForWorkbench(Surface);

    private IconGlyphPrimitiveSnapshot IconGlyphSnapshot
        => IconGlyphPrimitiveFactory.CreateForWorkbench(Surface);

    private TextBlockPrimitiveSnapshot TextBlockSnapshot
        => TextBlockPrimitiveFactory.CreateForWorkbench(Surface);

    private ContainerPrimitiveSnapshot ContainerSnapshot
        => ContainerPrimitiveFactory.CreateForWorkbench(Surface, CurrentSelection);

    private ImagePrimitiveSnapshot ImageSnapshot
        => ImagePrimitiveFactory.CreateForWorkbench(Surface);

    private NodeCardComposerSnapshot NodeCardSnapshot
        => NodeCardComposerFactory.CreateForWorkbench(Surface, CurrentSelection);

    private ConnectorPathPrimitiveSnapshot ConnectorPathSnapshot
        => ConnectorPathPrimitiveFactory.CreateForWorkbench(Surface);

    private ContextMenuHostSnapshot ContextMenuSnapshot
        => ContextMenuHostFactory.CreateForWorkbench(Surface, CurrentSelection);

    private CreateActionPaletteSnapshot CreatePaletteSnapshot
        => CreateActionPaletteFactory.CreateForWorkbench(Surface);

    private FloatingInspectorHostSnapshot FloatingInspectorSnapshot
        => FloatingInspectorHostFactory.CreateForWorkbench(Surface, CurrentSelection);

    private GroupFrameOverlaySnapshot GroupFrameSnapshot
        => GroupFrameOverlayFactory.CreateForWorkbench(Surface);

    private InlineEditorComposerSnapshot InlineEditorSnapshot
        => InlineEditorComposerFactory.CreateForWorkbench(Surface, CurrentSelection);

    private DragDropControllerSnapshot DragDropSnapshot
        => DragDropControllerFactory.CreateForWorkbench(Surface, CurrentSelection);

    private GridBackdropSnapshot GridBackdropSnapshot
        => GridBackdropFactory.CreateForWorkbench(Surface);

    private HitTestServiceSnapshot HitTestSnapshot
        => HitTestServiceFactory.CreateForWorkbench(Surface, CurrentSelection);

    private HoverFocusRouterSnapshot HoverFocusSnapshot
        => HoverFocusRouterFactory.CreateForWorkbench(Surface, CurrentSelection);

    private KeyboardShortcutRouterSnapshot KeyboardShortcutSnapshot
        => KeyboardShortcutRouterFactory.CreateForWorkbench(Surface, CurrentSelection);


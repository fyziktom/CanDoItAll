@if (Items.Count > 0)
{
    <div class="space-y-4">
        @if (Header is not null)
        {
            <div>
                @Header
            </div>
        }

        <div class="flex flex-wrap gap-2">
            @foreach (var item in Items)
            {
                var isSelected = string.Equals(item.Key, SelectedKey, StringComparison.Ordinal);
                <button type="button"
                        class="rounded-full border px-4 py-2 text-sm font-semibold transition @(isSelected ? "border-slate-900 bg-slate-900 text-white" : "border-slate-200 bg-white text-slate-700 hover:border-slate-300 hover:bg-slate-50")"
                        @onclick="() => SelectedKeyChanged.InvokeAsync(item.Key)">
                    <span>@item.Label</span>
                    @if (!string.IsNullOrWhiteSpace(item.Count))
                    {
                        <span class="ml-2 rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.18em] @(isSelected ? "bg-white/15 text-white" : "bg-slate-100 text-slate-500")">@item.Count</span>
                    }
                </button>
            }
        </div>

        @if (ActiveItem?.Description is { Length: > 0 } description)
        {
            <p class="text-sm leading-6 text-slate-600">@description</p>
        }
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<SecondaryTabItem> Items { get; set; } = [];

    [Parameter]
    public string SelectedKey { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> SelectedKeyChanged { get; set; }

    [Parameter]
    public RenderFragment? Header { get; set; }

    private SecondaryTabItem? ActiveItem => Items.FirstOrDefault(item => string.Equals(item.Key, SelectedKey, StringComparison.Ordinal));
}

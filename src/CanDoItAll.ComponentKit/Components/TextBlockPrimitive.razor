@implements IAsyncDisposable
@using CanDoItAll.ComponentKit.Canvas
@inject IJSRuntime JsRuntime

<CanvasBoundaryPreviewCard TestHookId="@Snapshot.TestHookId"
                           Label="@Snapshot.Label"
                           Title="@Snapshot.Title"
                           Summary="@Snapshot.Summary"
                           StatePill="@Snapshot.StatePill"
                           Metrics="@Snapshot.Metrics">
    <div class="cw-preview-text-stack" @ref="host">
        @foreach (var sample in Snapshot.Samples)
        {
            <div class="cw-preview-text-sample">
                <span class="cw-preview-text-sample__label">@sample.Label</span>
                <p class="cw-preview-text-sample__value">@sample.DisplayText</p>
                <span class="cw-preview-text-sample__meta">@(sample.IsTruncated ? $"{sample.LineCount} lines, truncated" : $"{sample.LineCount} lines")</span>
            </div>
        }
    </div>
</CanvasBoundaryPreviewCard>

@code {
    private readonly CanvasSceneHost sceneHost = new();
    private ElementReference host;
    private string? pendingSnapshotKey;

    [Parameter, EditorRequired]
    public TextBlockPrimitiveSnapshot Snapshot { get; set; } = default!;

    protected override void OnParametersSet()
    {
        pendingSnapshotKey = SerializationPersistencePack.Serialize(Snapshot);
        sceneHost.QueueSync(
            pendingSnapshotKey,
            !string.Equals(sceneHost.AppliedStateKey, pendingSnapshotKey, StringComparison.Ordinal));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var bridge = new JsInteropBridge(JsRuntime);
        if (sceneHost.ShouldCreate())
        {
            await bridge.InvokeVoidAsync("CanDoItAll.textBlockPrimitive.create", host, Snapshot);
            sceneHost.MarkApplied();
            return;
        }

        if (!sceneHost.ShouldUpdate())
        {
            return;
        }

        await bridge.InvokeVoidAsync("CanDoItAll.textBlockPrimitive.update", host, Snapshot);
        sceneHost.MarkApplied();
    }

    public async ValueTask DisposeAsync()
    {
        if (!sceneHost.IsInitialized)
        {
            return;
        }

        try
        {
            await new JsInteropBridge(JsRuntime).InvokeVoidAsync("CanDoItAll.textBlockPrimitive.dispose", host);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }
}

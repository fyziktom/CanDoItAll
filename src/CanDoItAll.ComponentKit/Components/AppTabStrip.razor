@using CanDoItAll.SharedKernel

<div class="space-y-3 rounded-[1.75rem] border border-white/80 bg-white/75 p-3 shadow-lg shadow-slate-200/40 backdrop-blur">
    <div class="flex flex-col gap-3 xl:flex-row xl:items-center xl:justify-between">
        <div class="flex min-w-0 flex-wrap gap-2">
            @foreach (var tab in InlineTabs)
            {
                @RenderTab(tab)
            }
        </div>

        <div class="flex flex-wrap items-center gap-2">
            @if (Items.Count > InlineTabLimit || RecentTabs.Count > 0)
            {
                <input @bind="searchText"
                       @bind:event="oninput"
                       placeholder="Search tabs"
                       class="w-44 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 outline-none transition focus:border-slate-400" />
            }

            @if (OverflowTabs.Count > 0)
            {
                <details class="group relative">
                    <summary class="cursor-pointer list-none rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-semibold text-slate-700">
                        Overflow @($"({OverflowTabs.Count})")
                    </summary>
                    <div class="absolute right-0 z-20 mt-2 w-80 rounded-2xl border border-slate-200 bg-white p-3 shadow-2xl shadow-slate-900/10">
                        <div class="space-y-2">
                            @foreach (var tab in OverflowTabs)
                            {
                                <button type="button"
                                        class="flex w-full items-center justify-between rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-left text-sm text-slate-700 transition hover:border-slate-300 hover:bg-slate-100"
                                        @onclick="() => Activate.InvokeAsync(tab.TabId)">
                                    <span class="min-w-0">
                                        <span class="block truncate font-semibold text-slate-900">@tab.Title</span>
                                        <span class="block truncate text-xs text-slate-500">@tab.TabGroup · @tab.Route</span>
                                    </span>
                                    @if (tab.IsSleeping)
                                    {
                                        <span class="rounded-full bg-slate-200 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-slate-700">zZ</span>
                                    }
                                </button>
                            }
                        </div>
                    </div>
                </details>
            }

            @if (RecentTabs.Count > 0)
            {
                <details class="group relative">
                    <summary class="cursor-pointer list-none rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-semibold text-slate-700">
                        Reopen
                    </summary>
                    <div class="absolute right-0 z-20 mt-2 w-72 rounded-2xl border border-slate-200 bg-white p-3 shadow-2xl shadow-slate-900/10">
                        <div class="space-y-2">
                            @foreach (var recent in FilteredRecentTabs)
                            {
                                <button type="button"
                                        class="flex w-full items-center justify-between rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-left text-sm text-slate-700 transition hover:border-slate-300 hover:bg-slate-100"
                                        title="Reopen recent tab"
                                        @onclick="() => ReopenRecent.InvokeAsync(recent.TabId)">
                                    <span class="min-w-0">
                                        <span class="block truncate font-semibold text-slate-900">@recent.Title</span>
                                        <span class="block truncate text-xs text-slate-500">@recent.TabGroup · @recent.Route</span>
                                    </span>
                                    <span class="text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-500">restore</span>
                                </button>
                            }
                        </div>
                    </div>
                </details>
            }
        </div>
    </div>

    @if (ActiveTab is not null)
    {
        <div class="flex flex-col gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 xl:flex-row xl:items-center xl:justify-between">
            <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                    <p class="text-sm font-semibold text-slate-900">@ActiveTab.Title</p>
                    <span class="rounded-full bg-white px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.22em] text-slate-500">@ActiveTab.TabGroup</span>
                    @if (!string.IsNullOrWhiteSpace(ActiveTab.ProjectName))
                    {
                        <span class="rounded-full bg-sky-50 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.22em] text-sky-700">@ActiveTab.ProjectName</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(ActiveTab.PhaseName))
                    {
                        <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.22em] text-emerald-700">@ActiveTab.PhaseName</span>
                    }
                </div>
                <p class="mt-1 truncate text-xs text-slate-500">@ActiveTab.Route</p>
            </div>

            <div class="flex flex-wrap items-center gap-2">
                <button type="button"
                        class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700"
                        title="Close other tabs"
                        @onclick="() => CloseOthers.InvokeAsync(ActiveTab.TabId)">
                    Close others
                </button>
                <button type="button"
                        class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700"
                        title="Close tabs to the right"
                        @onclick="() => CloseRight.InvokeAsync(ActiveTab.TabId)">
                    Close right
                </button>
                <button type="button"
                        class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700"
                        title="Close background tabs"
                        @onclick="() => CloseBackground.InvokeAsync(ActiveTab.TabId)">
                    Close background
                </button>
            </div>
        </div>
    }
</div>

@code {
    private const int InlineTabLimit = 6;
    private string searchText = string.Empty;

    [Parameter]
    public IReadOnlyList<WorkbenchTabState> Items { get; set; } = [];

    [Parameter]
    public IReadOnlyList<WorkbenchTabState> RecentTabs { get; set; } = [];

    [Parameter]
    public string? ActiveTabId { get; set; }

    [Parameter]
    public EventCallback<string> Activate { get; set; }

    [Parameter]
    public EventCallback<string> Close { get; set; }

    [Parameter]
    public EventCallback<string> MoveLeft { get; set; }

    [Parameter]
    public EventCallback<string> MoveRight { get; set; }

    [Parameter]
    public EventCallback<string> TogglePin { get; set; }

    [Parameter]
    public EventCallback<string> ToggleSleep { get; set; }

    [Parameter]
    public EventCallback<string> CloseOthers { get; set; }

    [Parameter]
    public EventCallback<string> CloseRight { get; set; }

    [Parameter]
    public EventCallback<string> CloseBackground { get; set; }

    [Parameter]
    public EventCallback<string> ReopenRecent { get; set; }

    private WorkbenchTabState? ActiveTab => Items.FirstOrDefault(tab => string.Equals(tab.TabId, ActiveTabId, StringComparison.Ordinal));

    private IReadOnlyList<WorkbenchTabState> FilteredTabs
        => string.IsNullOrWhiteSpace(searchText)
            ? Items
            : Items.Where(tab =>
                    tab.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    tab.Route.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(tab.ProjectName, searchText, StringComparison.OrdinalIgnoreCase))
                .ToList();

    private IReadOnlyList<WorkbenchTabState> InlineTabs => FilteredTabs.Take(InlineTabLimit).ToList();

    private IReadOnlyList<WorkbenchTabState> OverflowTabs => FilteredTabs.Skip(InlineTabLimit).ToList();

    private IReadOnlyList<WorkbenchTabState> FilteredRecentTabs
        => string.IsNullOrWhiteSpace(searchText)
            ? RecentTabs
            : RecentTabs.Where(tab =>
                    tab.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    tab.Route.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                .ToList();

    private RenderFragment RenderTab(WorkbenchTabState tab) => @<div class="inline-flex items-center gap-2 rounded-xl border px-3 py-2 text-sm transition @(IsActive(tab) ? "border-slate-900 bg-slate-900 text-white" : "border-slate-200 bg-slate-50 text-slate-700 hover:border-slate-300 hover:bg-slate-100")">
        <button type="button" class="inline-flex min-w-0 items-center gap-2" @onclick="() => Activate.InvokeAsync(tab.TabId)">
            <span class="max-w-44 truncate font-medium">@tab.Title</span>
            @if (tab.IsDirty)
            {
                <span class="h-2 w-2 rounded-full bg-amber-400"></span>
            }
            @if (tab.IsPinned)
            {
                <span class="rounded-full bg-sky-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-sky-700">pin</span>
            }
            @if (tab.IsSleeping)
            {
                <span class="rounded-full bg-slate-200 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-slate-700">zZ</span>
            }
        </button>

        <div class="inline-flex items-center gap-1 text-[10px] font-semibold">
            <button type="button" class="rounded-lg px-1.5 py-1 opacity-70 transition hover:opacity-100" title="Move left" @onclick="() => MoveLeft.InvokeAsync(tab.TabId)">&#x2039;</button>
            <button type="button" class="rounded-lg px-1.5 py-1 opacity-70 transition hover:opacity-100" title="Move right" @onclick="() => MoveRight.InvokeAsync(tab.TabId)">&#x203A;</button>
            <button type="button" class="rounded-lg px-1.5 py-1 opacity-70 transition hover:opacity-100" title="Pin tab" @onclick="() => TogglePin.InvokeAsync(tab.TabId)">pin</button>
            <button type="button" class="rounded-lg px-1.5 py-1 opacity-70 transition hover:opacity-100" title="Sleep or wake tab" @onclick="() => ToggleSleep.InvokeAsync(tab.TabId)">zZ</button>
            @if (tab.CanClose)
            {
                <button type="button" class="rounded-lg px-1.5 py-1 opacity-70 transition hover:opacity-100" title="Close tab" @onclick="() => Close.InvokeAsync(tab.TabId)">x</button>
            }
        </div>
    </div>;

    private bool IsActive(WorkbenchTabState tab)
        => string.Equals(tab.TabId, ActiveTabId, StringComparison.Ordinal);
}

@using CanDoItAll.Modules.Security
@using CanDoItAll.Modules.Workspace

<div>
    <label class="cda-field-label">@Field.Label</label>
@switch (Field.FieldType)
    {
        case ConnectorConfigFieldType.Number:
            <InputNumber TValue="int?"
                         Value="NumberValue"
                         ValueChanged="HandleNumberChanged"
                         ValueExpression="() => NumberValue"
                         class="@InputClass"
                         data-testid="@TestId" />
            break;
        case ConnectorConfigFieldType.Boolean:
            <label class="cda-inline-option">
                <InputCheckbox Value="BooleanValue"
                               ValueChanged="HandleBooleanChanged"
                               ValueExpression="() => BooleanValue"
                               data-testid="@TestId" />
                @Field.HelpText
            </label>
            break;
        case ConnectorConfigFieldType.Json:
            <InputTextArea Value="TextValue"
                           ValueChanged="HandleTextChanged"
                           ValueExpression="() => TextValue"
                           class="@($"{InputClass} cda-input--textarea min-h-24")"
                           data-testid="@TestId" />
            break;
        case ConnectorConfigFieldType.SecretReference:
            <InputSelect TValue="string"
                         Value="TextValue"
                         ValueChanged="EventCallback.Factory.Create<string>(this, HandleTextChanged)"
                         ValueExpression="() => TextValue"
                         class="@InputClass"
                         data-testid="@TestId">
                <option value="">None</option>
                @foreach (var secret in Secrets)
                {
                    <option value="@secret.Id">@secret.Name</option>
                }
            </InputSelect>
            break;
        default:
            <InputText Value="TextValue"
                       ValueChanged="HandleTextChanged"
                       ValueExpression="() => TextValue"
                       class="@InputClass"
                       data-testid="@TestId" />
            break;
    }

    @if (Field.FieldType is not ConnectorConfigFieldType.Boolean &&
         !string.IsNullOrWhiteSpace(Field.HelpText))
    {
        <p class="cda-body-muted mt-2">@Field.HelpText</p>
    }
</div>

@code {
    [Parameter]
    public required ConnectorConfigFieldDescriptor Field { get; set; }

    [Parameter]
    public required ConnectorConfigState State { get; set; }

    [Parameter]
    public IReadOnlyList<SecretListItem> Secrets { get; set; } = [];

    [Parameter]
    public string InputClass { get; set; } = "cda-input";

    [Parameter]
    public string? TestId { get; set; }

    private string TextValue
    {
        get => State.GetText(Field.Key);
        set => State.SetText(Field.Key, value);
    }

    private int? NumberValue
    {
        get => State.GetNumber(Field.Key);
        set => State.SetNumber(Field.Key, value);
    }

    private bool BooleanValue
    {
        get => State.GetBoolean(Field.Key);
        set => State.SetBoolean(Field.Key, value);
    }

    private void HandleTextChanged(string value)
    {
        TextValue = value;
    }

    private void HandleNumberChanged(int? value)
    {
        NumberValue = value;
    }

    private void HandleBooleanChanged(bool value)
    {
        BooleanValue = value;
    }
}

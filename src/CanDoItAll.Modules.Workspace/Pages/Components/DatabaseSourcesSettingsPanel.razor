@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using CanDoItAll.Infrastructure.ControlPlane
@using CanDoItAll.SharedKernel
@inject DatabaseProfileWorkspaceService DatabaseProfileWorkspaceService
@inject NotificationService NotificationService

<ListDetailShell ListPaneWidth="27rem">
    <ListHeader>
        <ListPanelHeader Title="Data sources"
                         Description="Database profiles drive the runtime workspace, managed files, and workbench isolation. Save the profile first, then create or test the actual database."
                         Count="@($"{FilteredProfiles.Count} profile(s)")">
            <Actions>
                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                    <Button Text="Managed SQLite"
                            ButtonStyle="ButtonStyle.Light"
                            Size="ButtonSize.Small"
                            Disabled="@IsDatabaseUiLocked"
                            Click="ResetManagedSqliteProfileAsync"
                            data-testid="database-profile-new-managed" />
                    <Button Text="Open SQLite"
                            ButtonStyle="ButtonStyle.Light"
                            Size="ButtonSize.Small"
                            Disabled="@IsDatabaseUiLocked"
                            Click="ResetExternalSqliteProfileAsync"
                            data-testid="database-profile-new-external" />
                    <Button Text="PostgreSQL"
                            ButtonStyle="ButtonStyle.Light"
                            Size="ButtonSize.Small"
                            Disabled="@IsDatabaseUiLocked"
                            Click="ResetPostgreSqlProfileAsync"
                            data-testid="database-profile-new-postgres" />
                </Cluster>
            </Actions>
            <Filters>
                <FilterBar ResultText="@($"{FilteredProfiles.Count} matching profile(s)")">
                    <input @bind="profileSearch"
                           @bind:event="oninput"
                           class="cda-input min-w-[14rem] flex-1"
                           placeholder="Search data sources"
                           data-testid="database-profile-search" />
                    <Button Text="Reset"
                            ButtonStyle="ButtonStyle.Light"
                            Size="ButtonSize.Small"
                            Click="ResetProfileSearch" />
                </FilterBar>
            </Filters>
        </ListPanelHeader>
    </ListHeader>

    <ListContent>
        @if (currentSelection is not null)
        {
            <div class="mb-4 rounded-[1.5rem] border border-slate-200 bg-slate-50/90 p-4"
                 data-testid="database-data-sources-summary">
                <Split Breakpoint="LayoutBreakpoint.None"
                       Gap="LayoutGap.Medium"
                       AlignItems="AlignItems.Start"
                       JustifyContent="JustifyContent.SpaceBetween"
                       Wrap="FlexWrap.Wrap">
                    <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
                        <p class="cda-eyebrow">Current runtime selection</p>
                        <p class="text-base font-semibold text-slate-950">@currentSelection.DisplayName</p>
                        <p class="text-sm leading-6 text-slate-600">@currentSelection.Descriptor</p>
                    </Stack>

                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                        <StatusBadge Tone="info" Text="@DescribeProvider(currentSelection.ProviderKind)" />
                        <StatusBadge Tone="neutral" Text="@DescribeSource(currentSelection.SourceKind)" />
                        @if (currentSelection.IsRuntimeLocked)
                        {
                            <StatusBadge Tone="warning" Text="Config lock" />
                        }
                    </Cluster>
                </Split>

                <p class="mt-3 text-xs text-slate-500">Workspace root: @currentSelection.WorkspaceRoot</p>
                <p class="mt-1 text-xs text-slate-500">Selection source: @DescribeResolutionSource(currentSelection.ResolutionSource)</p>
            </div>
        }

        @if (IsDatabaseUiLocked)
        {
            <div class="mb-4 rounded-[1.4rem] border border-amber-300 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-950"
                 data-testid="database-data-sources-locked-message">
                This session is running under an explicit startup database override. Profile management stays read-only here so the UI does not pretend it can switch away from configuration-owned state.
            </div>
        }

        @if (FilteredProfiles.Count == 0)
        {
            <EmptyState Eyebrow="No saved profiles"
                        Title="Start with a managed SQLite profile"
                        Description="Create a managed SQLite profile for local work or save an external SQLite/PostgreSQL profile for later activation." />
        }
        else
        {
            <Stack GapScale="LayoutGap.Medium" data-testid="database-profile-list">
                @foreach (var profile in FilteredProfiles)
                {
                    <SelectionListItem Title="@profile.DisplayName"
                                       Eyebrow="@DescribeProvider(profile.ProviderKind)"
                                       Meta="@DescribeSource(profile.SourceKind)"
                                       Summary="@BuildProfileSummary(profile)"
                                       DataTestId="@($"database-profile-row-{profile.Id:N}")"
                                       IsSelected="@(databaseProfileModel.Id == profile.Id)"
                                       OnSelect="@(() => EditProfileAsync(profile.Id))">
                        <Status>
                            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                @if (profile.IsActive)
                                {
                                    <StatusBadge Tone="success" Text="Active" />
                                }

                                @if (profile.IsRuntimeLocked)
                                {
                                    <StatusBadge Tone="warning" Text="Locked" />
                                }

                                @if (TryGetSchemaHealth(profile.Id) is { } rowSchemaHealth)
                                {
                                    <StatusBadge Tone="@DescribeSchemaTone(rowSchemaHealth)" Text="@DescribeSchemaStatus(rowSchemaHealth)" />
                                }

                                <StatusBadge Tone="neutral" Text="@DescribeSource(profile.SourceKind)" />
                            </Cluster>
                        </Status>
                    </SelectionListItem>
                }
            </Stack>
        }
    </ListContent>

    <DetailHeader>
        <Stack GapScale="LayoutGap.Tiny">
            <p class="cda-eyebrow">Data source editor</p>
            <h2 class="cda-title-xl">@(databaseProfileModel.Id.HasValue ? databaseProfileModel.DisplayName : "New data source")</h2>
            <p class="cda-body-muted">@DescribeEditorLead(databaseProfileModel)</p>
        </Stack>
    </DetailHeader>

    <DetailContent>
        <EditForm Model="databaseProfileModel" OnValidSubmit="SaveProfileAsync">
            <fieldset disabled="@IsDatabaseUiLocked" class="contents">
                <Stack Class="min-h-full" GapScale="LayoutGap.XXLarge">
                    @if (SelectedSchemaHealth is { RequiresAction: true } selectedSchemaHealth)
                    {
                        <Alert AlertStyle="@ResolveSchemaAlertStyle(selectedSchemaHealth)"
                               Variant="Variant.Outlined"
                               data-testid="database-profile-schema-alert">
                            <Split Breakpoint="LayoutBreakpoint.None"
                                   Gap="LayoutGap.Medium"
                                   AlignItems="AlignItems.Start"
                                   JustifyContent="JustifyContent.SpaceBetween"
                                   Wrap="FlexWrap.Wrap">
                                <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
                                    <p class="font-semibold">Database schema needs attention</p>
                                    <p>@selectedSchemaHealth.Summary</p>
                                    @if (HasSchemaDetails(selectedSchemaHealth))
                                    {
                                        <p class="text-xs opacity-80">@DescribeSchemaDetails(selectedSchemaHealth)</p>
                                    }
                                </Stack>

                                @if (selectedSchemaHealth.CanApplySchema)
                                {
                                    <Button Text="Apply current schema"
                                            Icon="database"
                                            ButtonStyle="ButtonStyle.Warning"
                                            Size="ButtonSize.Small"
                                            Disabled="@(databaseBusy || IsDatabaseUiLocked || schemaBusyProfileId == databaseProfileModel.Id)"
                                            IsBusy="@(schemaBusyProfileId == databaseProfileModel.Id)"
                                            Click="ApplySelectedSchemaAsync"
                                            data-testid="database-profile-apply-schema" />
                                }
                            </Split>
                        </Alert>
                    }

                    <FormSection Title="Profile identity"
                                 Description="Choose a clear name first. Managed SQLite keeps storage under the control plane, while external SQLite and PostgreSQL expect explicit workspace roots.">
                        <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                            <div>
                                <label class="cda-field-label">Profile name</label>
                                <InputText @bind-Value="databaseProfileModel.DisplayName"
                                           class="cda-input"
                                           data-testid="database-profile-name" />
                            </div>

                            <div>
                                <label class="cda-field-label">Workspace root</label>
                                <InputText @bind-Value="databaseProfileModel.WorkspaceRoot"
                                           class="cda-input"
                                           disabled="@(databaseProfileModel.SourceKind == DatabaseProfileSourceKind.ManagedSqlite)"
                                           data-testid="database-profile-workspace-root" />
                            </div>
                        </Grid>

                        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                            <StatusBadge Tone="info" Text="@DescribeProvider(databaseProfileModel.ProviderKind)" />
                            <StatusBadge Tone="neutral" Text="@DescribeSource(databaseProfileModel.SourceKind)" />
                            @if (databaseProfileModel.Id.HasValue && IsSelectedProfileActive)
                            {
                                <StatusBadge Tone="success" Text="Active runtime profile" />
                            }
                        </Cluster>
                    </FormSection>

                    @if (databaseProfileModel.ProviderKind == DatabaseProviderKind.Sqlite)
                    {
                        <FormSection Title="SQLite source"
                                     Description="Managed SQLite profiles get a control-plane-owned database path. External files keep the workspace root explicit, and snapshot-backed profiles materialize into a local working copy under the control plane.">
                            @if (databaseProfileModel.SourceKind == DatabaseProfileSourceKind.ManagedSqlite)
                            {
                                <div class="rounded-[1.25rem] border border-sky-200 bg-sky-50 px-4 py-3 text-sm leading-6 text-sky-950"
                                     data-testid="database-profile-managed-sqlite-info">
                                    Managed SQLite creates the database file under the control plane after you save the profile and use Create empty.
                                </div>
                            }
                            else if (databaseProfileModel.SourceKind is DatabaseProfileSourceKind.ExternalSqliteFile or DatabaseProfileSourceKind.ImportedSqlite)
                            {
                                <div>
                                    <label class="cda-field-label">SQLite file path</label>
                                    <InputText @bind-Value="databaseProfileModel.SqliteDatabasePath"
                                               class="cda-input"
                                               data-testid="database-profile-sqlite-path" />
                                </div>
                            }
                            else if (databaseProfileModel.SourceKind is DatabaseProfileSourceKind.SnapshotCache or DatabaseProfileSourceKind.IpfsSnapshot)
                            {
                                <div class="rounded-[1.25rem] border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm leading-6 text-emerald-950"
                                     data-testid="database-profile-snapshot-info">
                                    Snapshot-backed profiles keep their SQLite working copy and storage roots under the control plane so clone/import results can diverge safely from the source.
                                </div>

                                <div>
                                    <label class="cda-field-label">Materialized SQLite path</label>
                                    <InputText @bind-Value="databaseProfileModel.SqliteDatabasePath"
                                               class="cda-input"
                                               disabled="true"
                                               data-testid="database-profile-snapshot-path" />
                                </div>
                            }
                            else
                            {
                                <div class="rounded-[1.25rem] border border-amber-300 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-950">
                                    This SQLite source kind is not editable from the settings form.
                                </div>
                            }
                        </FormSection>
                    }
                    else if (databaseProfileModel.ProviderKind == DatabaseProviderKind.PostgreSql)
                    {
                        <FormSection Title="PostgreSQL connection"
                                     Description="Save the profile first, then use Test connection to verify the target database or Create empty to provision it before activation.">
                            <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                <div>
                                    <label class="cda-field-label">Host</label>
                                    <InputText @bind-Value="databaseProfileModel.PostgresHost"
                                               class="cda-input"
                                               data-testid="database-profile-postgres-host" />
                                </div>

                                <div>
                                    <label class="cda-field-label">Port</label>
                                    <InputNumber @bind-Value="databaseProfileModel.PostgresPort"
                                                 class="cda-input"
                                                 data-testid="database-profile-postgres-port" />
                                </div>
                            </Grid>

                            <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                <div>
                                    <label class="cda-field-label">Database</label>
                                    <InputText @bind-Value="databaseProfileModel.PostgresDatabaseName"
                                               class="cda-input"
                                               data-testid="database-profile-postgres-database" />
                                </div>

                                <div>
                                    <label class="cda-field-label">Admin database</label>
                                    <InputText @bind-Value="databaseProfileModel.PostgresAdminDatabaseName"
                                               class="cda-input"
                                               data-testid="database-profile-postgres-admin-database" />
                                </div>
                            </Grid>

                            <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                <div>
                                    <label class="cda-field-label">Username</label>
                                    <InputText @bind-Value="databaseProfileModel.PostgresUsername"
                                               class="cda-input"
                                               data-testid="database-profile-postgres-user" />
                                </div>

                                <div>
                                    <label class="cda-field-label">Password</label>
                                    <InputText @bind-Value="databaseProfileModel.PostgresPassword"
                                               type="password"
                                               class="cda-input"
                                               data-testid="database-profile-postgres-password" />
                                </div>
                            </Grid>

                            <label class="cda-inline-option">
                                <InputCheckbox @bind-Value="databaseProfileModel.PostgresTrustServerCertificate"
                                               data-testid="database-profile-postgres-trust-server-certificate" />
                                Trust server certificate
                            </label>
                        </FormSection>
                    }
                    else
                    {
                        <FormSection Title="In-memory runtime"
                                     Description="In-memory profiles are primarily useful for test harnesses and explicit runtime overrides.">
                            <div>
                                <label class="cda-field-label">Database name</label>
                                <InputText @bind-Value="databaseProfileModel.SqliteDatabasePath"
                                           class="cda-input"
                                           data-testid="database-profile-inmemory-name" />
                            </div>
                        </FormSection>
                    }

                    <FormSection Title="Clone and snapshots"
                                 Description="These actions always use the active runtime profile as the source and include managed files, exports, and evidence. Clone/import creates a new local working copy that can diverge safely after activation.">
                        <Stack GapScale="LayoutGap.Large">
                            @if (currentSelection is not null)
                            {
                                <div class="rounded-[1.25rem] border border-slate-200 bg-slate-50 px-4 py-3"
                                     data-testid="database-snapshot-source-summary">
                                    <Split Breakpoint="LayoutBreakpoint.None"
                                           Gap="LayoutGap.Medium"
                                           AlignItems="AlignItems.Start"
                                           JustifyContent="JustifyContent.SpaceBetween"
                                           Wrap="FlexWrap.Wrap">
                                        <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
                                            <p class="cda-eyebrow">Snapshot source</p>
                                            <p class="text-base font-semibold text-slate-950">@currentSelection.DisplayName</p>
                                            <p class="text-sm leading-6 text-slate-600">@currentSelection.Descriptor</p>
                                        </Stack>

                                        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                            <StatusBadge Tone="info" Text="@DescribeProvider(currentSelection.ProviderKind)" />
                                            <StatusBadge Tone="neutral" Text="@DescribeSource(currentSelection.SourceKind)" />
                                        </Cluster>
                                    </Split>
                                </div>

                                <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                    <div>
                                        <label class="cda-field-label">Clone profile name</label>
                                        <InputText @bind-Value="cloneDisplayName"
                                                   class="cda-input"
                                                   data-testid="database-clone-name" />
                                    </div>

                                    <div>
                                        <label class="cda-field-label">Materialized profile name</label>
                                        <InputText @bind-Value="snapshotProfileName"
                                                   class="cda-input"
                                                   data-testid="database-snapshot-profile-name" />
                                    </div>
                                </Grid>

                                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                    <Button Text="Create clone"
                                            ButtonStyle="ButtonStyle.Info"
                                            Type="button"
                                            Disabled="@(databaseBusy || IsDatabaseUiLocked || string.IsNullOrWhiteSpace(cloneDisplayName))"
                                            Click="CreateCloneAsync"
                                            data-testid="database-clone-create" />
                                    <Button Text="Save local snapshot"
                                            ButtonStyle="ButtonStyle.Light"
                                            Type="button"
                                            Disabled="@(databaseBusy || IsDatabaseUiLocked)"
                                            Click="CreateLocalSnapshotAsync"
                                            data-testid="database-snapshot-local-create" />
                                    <Button Text="Publish to IPFS"
                                            ButtonStyle="ButtonStyle.Light"
                                            Type="button"
                                            Disabled="@(databaseBusy || IsDatabaseUiLocked)"
                                            Click="CreateIpfsSnapshotAsync"
                                            data-testid="database-snapshot-ipfs-create" />
                                </Cluster>

                                <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                    <div>
                                        <label class="cda-field-label">Local snapshot package</label>
                                        <InputText @bind-Value="snapshotPackagePath"
                                                   class="cda-input"
                                                   placeholder="C:\path\to\snapshot.cda-snapshot.zip"
                                                   data-testid="database-snapshot-package-path" />
                                    </div>

                                    <div>
                                        <label class="cda-field-label">IPFS CID</label>
                                        <InputText @bind-Value="snapshotCid"
                                                   class="cda-input"
                                                   placeholder="bafy..."
                                                   data-testid="database-snapshot-cid" />
                                    </div>
                                </Grid>

                                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                    <Button Text="Restore local snapshot"
                                            ButtonStyle="ButtonStyle.Info"
                                            Type="button"
                                            Disabled="@(databaseBusy || IsDatabaseUiLocked || string.IsNullOrWhiteSpace(snapshotProfileName) || string.IsNullOrWhiteSpace(snapshotPackagePath))"
                                            Click="RestoreLocalSnapshotAsync"
                                            data-testid="database-snapshot-local-restore" />
                                    <Button Text="Restore IPFS snapshot"
                                            ButtonStyle="ButtonStyle.Info"
                                            Type="button"
                                            Disabled="@(databaseBusy || IsDatabaseUiLocked || string.IsNullOrWhiteSpace(snapshotProfileName) || string.IsNullOrWhiteSpace(snapshotCid))"
                                            Click="RestoreIpfsSnapshotAsync"
                                            data-testid="database-snapshot-ipfs-restore" />
                                </Cluster>

                                @if (!string.IsNullOrWhiteSpace(latestSnapshotPackagePath) || !string.IsNullOrWhiteSpace(latestSnapshotCid))
                                {
                                    <div class="rounded-[1.25rem] border border-sky-200 bg-sky-50 px-4 py-3 text-sm leading-6 text-sky-950"
                                         data-testid="database-snapshot-latest">
                                        @if (!string.IsNullOrWhiteSpace(latestSnapshotPackagePath))
                                        {
                                            <p>Latest package: @latestSnapshotPackagePath</p>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(latestSnapshotCid))
                                        {
                                            <p>Latest IPFS CID: @latestSnapshotCid</p>
                                        }
                                    </div>
                                }
                            }
                        </Stack>
                    </FormSection>

                    @if (!databaseProfileModel.Id.HasValue)
                    {
                        <div class="rounded-[1.25rem] border border-slate-200 bg-slate-50 px-4 py-3 text-sm leading-6 text-slate-700">
                            Save the profile before testing a PostgreSQL connection, creating an empty database, or activating this data source.
                        </div>
                    }

                    <StickyActionFooter StatusLabel="Data sources"
                                        StatusTone="success">
                        <SecondaryActions>
                            <Button Text="Reset draft"
                                    ButtonStyle="ButtonStyle.Light"
                                    Disabled="@(databaseBusy || IsDatabaseUiLocked)"
                                    Click="ResetCurrentProfileAsync"
                                    data-testid="database-profile-reset" />
                            @if (databaseProfileModel.Id.HasValue && SupportsConnectionTest)
                            {
                                <Button Text="Test connection"
                                        ButtonStyle="ButtonStyle.Info"
                                        Disabled="@(databaseBusy || IsDatabaseUiLocked)"
                                        Click="TestConnectionAsync"
                                        data-testid="database-profile-test-connection" />
                            }
                            @if (databaseProfileModel.Id.HasValue && SupportsCreateEmpty)
                            {
                                <Button Text="Create empty"
                                        ButtonStyle="ButtonStyle.Info"
                                        Disabled="@(databaseBusy || IsDatabaseUiLocked)"
                                        Click="CreateEmptyAsync"
                                        data-testid="database-profile-create-empty" />
                            }
                            @if (databaseProfileModel.Id.HasValue)
                            {
                                <Button Text="Transfer settings"
                                        ButtonStyle="ButtonStyle.Light"
                                        Disabled="@(databaseBusy || IsDatabaseUiLocked)"
                                        Click="@(() => OpenTransferDialogAsync(databaseProfileModel.Id.Value))"
                                        data-testid="database-profile-transfer-settings" />
                            }
                        </SecondaryActions>
                        <PrimaryActions>
                            <Button Text="Save data source"
                                    Type="submit"
                                    Disabled="@(databaseBusy || IsDatabaseUiLocked)"
                                    data-testid="database-profile-save" />
                            @if (databaseProfileModel.Id.HasValue)
                            {
                                <Button Text="@(IsSelectedProfileActive ? "Active now" : "Activate")"
                                        ButtonStyle="ButtonStyle.Warning"
                                        Disabled="@(databaseBusy || IsDatabaseUiLocked || IsSelectedProfileActive)"
                                        Click="ActivateProfileAsync"
                                        data-testid="database-profile-activate" />
                            }
                        </PrimaryActions>
                        <DangerActions>
                            @if (databaseProfileModel.Id.HasValue)
                            {
                                <Button Text="Delete"
                                        ButtonStyle="ButtonStyle.Danger"
                                        Disabled="@(databaseBusy || IsDatabaseUiLocked)"
                                        Click="DeleteProfileAsync"
                                        data-testid="database-profile-delete" />
                            }
                        </DangerActions>
                    </StickyActionFooter>
                </Stack>
            </fieldset>
        </EditForm>
    </DetailContent>
</ListDetailShell>

<Dialog IsOpen="@transferDialogOpen"
        Title="Transfer database settings"
        Eyebrow="Data sources"
        Subtitle="@TransferDialogSubtitle"
        Size="ModalSize.Wide"
        TestId="database-transfer-dialog"
        OnClose="CloseTransferDialog">
    <ChildContent>
        <Stack GapScale="LayoutGap.Large">
            @if (!string.IsNullOrWhiteSpace(transferMessage))
            {
                <div class="@TransferMessageClass"
                     data-testid="database-transfer-message">
                    @transferMessage
                </div>
            }

            @if (transferTargetSchemaHealth is { RequiresAction: true } targetSchemaHealth)
            {
                <Alert AlertStyle="@ResolveSchemaAlertStyle(targetSchemaHealth)"
                       Variant="Variant.Outlined"
                       data-testid="database-transfer-target-schema-alert">
                    <Split Breakpoint="LayoutBreakpoint.None"
                           Gap="LayoutGap.Medium"
                           AlignItems="AlignItems.Start"
                           JustifyContent="JustifyContent.SpaceBetween"
                           Wrap="FlexWrap.Wrap">
                        <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
                            <p class="font-semibold">Target database schema needs attention</p>
                            <p>@targetSchemaHealth.Summary</p>
                            @if (HasSchemaDetails(targetSchemaHealth))
                            {
                                <p class="text-xs opacity-80">@DescribeSchemaDetails(targetSchemaHealth)</p>
                            }
                        </Stack>

                        @if (targetSchemaHealth.CanApplySchema && transferTargetProfileId.HasValue)
                        {
                            <Button Text="Apply target schema"
                                    Icon="database"
                                    ButtonStyle="ButtonStyle.Warning"
                                    Size="ButtonSize.Small"
                                    Disabled="@(transferBusy || schemaBusyProfileId == transferTargetProfileId)"
                                    IsBusy="@(schemaBusyProfileId == transferTargetProfileId)"
                                    Click="ApplyTransferTargetSchemaAsync"
                                    data-testid="database-transfer-target-apply-schema" />
                        }
                    </Split>
                </Alert>
            }

            @if (transferSourceSchemaHealth is { RequiresAction: true } sourceSchemaHealth)
            {
                <Alert AlertStyle="@ResolveSchemaAlertStyle(sourceSchemaHealth)"
                       Variant="Variant.Outlined"
                       data-testid="database-transfer-source-schema-alert">
                    <Split Breakpoint="LayoutBreakpoint.None"
                           Gap="LayoutGap.Medium"
                           AlignItems="AlignItems.Start"
                           JustifyContent="JustifyContent.SpaceBetween"
                           Wrap="FlexWrap.Wrap">
                        <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
                            <p class="font-semibold">Source database schema needs attention</p>
                            <p>@sourceSchemaHealth.Summary</p>
                            @if (HasSchemaDetails(sourceSchemaHealth))
                            {
                                <p class="text-xs opacity-80">@DescribeSchemaDetails(sourceSchemaHealth)</p>
                            }
                        </Stack>

                        @if (sourceSchemaHealth.CanApplySchema && transferSourceProfileId.HasValue)
                        {
                            <Button Text="Apply source schema"
                                    Icon="database"
                                    ButtonStyle="ButtonStyle.Warning"
                                    Size="ButtonSize.Small"
                                    Disabled="@(transferBusy || schemaBusyProfileId == transferSourceProfileId)"
                                    IsBusy="@(schemaBusyProfileId == transferSourceProfileId)"
                                    Click="ApplyTransferSourceSchemaAsync"
                                    data-testid="database-transfer-source-apply-schema" />
                        }
                    </Split>
                </Alert>
            }

            <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                <div class="rounded-[1.25rem] border border-slate-200 bg-slate-50 px-4 py-3"
                     data-testid="database-transfer-target-summary">
                    <Stack GapScale="LayoutGap.Tiny">
                        <p class="cda-eyebrow">Target database</p>
                        <p class="text-base font-semibold text-slate-950">@TransferTargetName</p>
                        <p class="text-sm leading-6 text-slate-600 break-all">@TransferTargetDescriptor</p>
                    </Stack>
                </div>

                <div>
                    <label class="cda-field-label">Copy settings from</label>
                    <select class="cda-input"
                            value="@transferSourceProfileId?.ToString()"
                            disabled="@(transferBusy || transferSources.Count == 0)"
                            @onchange="ChangeTransferSourceAsync"
                            data-testid="database-transfer-source-select">
                        <option value="">Select source database</option>
                        @foreach (var source in transferSources)
                        {
                            <option value="@source.ProfileId">@source.DisplayName (@DescribeSource(source.SourceKind))</option>
                        }
                    </select>
                    @if (transferSources.Count == 0)
                    {
                        <p class="mt-2 text-sm leading-6 text-slate-600">No other saved database profiles are available as a source.</p>
                    }
                </div>
            </Grid>

            @if (transferItems.Count > 0)
            {
                <Stack GapScale="LayoutGap.Small" data-testid="database-transfer-items">
                    @foreach (var item in transferItems)
                    {
                        <label class="rounded-[1.25rem] border border-slate-200 bg-white px-4 py-3"
                               data-testid="@($"database-transfer-item-{item.Descriptor.Key}")">
                            <Split Breakpoint="LayoutBreakpoint.None"
                                   Gap="LayoutGap.Medium"
                                   AlignItems="AlignItems.Start"
                                   JustifyContent="JustifyContent.SpaceBetween"
                                   Wrap="FlexWrap.Wrap">
                                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.NoWrap" AlignItems="AlignItems.Start">
                                    <input type="checkbox"
                                           class="mt-1 h-4 w-4 rounded border-slate-300"
                                           checked="@selectedTransferItemKeys.Contains(item.Descriptor.Key)"
                                           disabled="@(transferBusy || !item.IsAvailable)"
                                           @onchange="@((args) => ToggleTransferItem(item.Descriptor.Key, args))" />
                                    <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
                                        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                            <span class="font-semibold text-slate-950">@item.Descriptor.Label</span>
                                            @if (item.Descriptor.IsSensitive)
                                            {
                                                <StatusBadge Tone="warning" Text="Encrypted" />
                                            }
                                            @if (!item.IsAvailable)
                                            {
                                                <StatusBadge Tone="neutral" Text="Empty source" />
                                            }
                                        </Cluster>
                                        <p class="text-sm leading-6 text-slate-600">@item.Descriptor.Description</p>
                                        <p class="text-sm leading-6 text-slate-600">@item.Summary</p>
                                        @if (!string.IsNullOrWhiteSpace(item.Warning))
                                        {
                                            <p class="text-sm leading-6 text-amber-700">@item.Warning</p>
                                        }
                                    </Stack>
                                </Cluster>

                                <Stack GapScale="LayoutGap.Tiny" Class="text-right text-xs leading-5 text-slate-500">
                                    <span>Source: @item.SourceRecordCount</span>
                                    <span>Target: @item.TargetRecordCount</span>
                                </Stack>
                            </Split>
                        </label>
                    }
                </Stack>
            }
            else if (transferSourceProfileId.HasValue && !transferBusy && !TransferSchemaRequiresAction)
            {
                <EmptyState Eyebrow="No transfer items"
                            Title="No settings groups are available"
                            Description="The selected source database did not return transferable settings." />
            }
        </Stack>
    </ChildContent>
    <Footer>
        <Split Breakpoint="LayoutBreakpoint.None"
               Gap="LayoutGap.Medium"
               AlignItems="AlignItems.Center"
               JustifyContent="JustifyContent.SpaceBetween"
               Wrap="FlexWrap.Wrap">
            <p class="text-sm leading-6 text-slate-600">Encrypted values are copied as protected payloads and are not shown here.</p>
            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                <Button Text="Close"
                        ButtonStyle="ButtonStyle.Light"
                        Disabled="@transferBusy"
                        Click="CloseTransferDialog" />
                <Button Text="Transfer selected"
                        ButtonStyle="ButtonStyle.Info"
                        Disabled="@(!CanTransferSelected)"
                        Click="TransferSelectedSettingsAsync"
                        data-testid="database-transfer-apply" />
            </Cluster>
        </Split>
    </Footer>
</Dialog>

@code {
    private DatabaseProfileEditorModel databaseProfileModel = NewManagedSqliteProfile();
    private IReadOnlyList<DatabaseProfileSummary> databaseProfiles = [];
    private DatabaseSelectionStateModel? currentSelection;
    private IReadOnlyList<DatabaseTransferSourceSummary> transferSources = [];
    private IReadOnlyList<DatabaseTransferItemPreview> transferItems = [];
    private readonly HashSet<string> selectedTransferItemKeys = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<Guid, DatabaseProfileSchemaHealth> schemaHealthByProfileId = [];
    private string profileSearch = string.Empty;
    private string cloneDisplayName = string.Empty;
    private string snapshotProfileName = string.Empty;
    private string snapshotPackagePath = string.Empty;
    private string snapshotCid = string.Empty;
    private string? latestSnapshotPackagePath;
    private string? latestSnapshotCid;
    private string? databaseMessage;
    private string databaseMessageTone = "neutral";
    private string? transferMessage;
    private string transferMessageTone = "neutral";
    private Guid? transferTargetProfileId;
    private Guid? transferSourceProfileId;
    private Guid? schemaBusyProfileId;
    private DatabaseProfileSchemaHealth? transferTargetSchemaHealth;
    private DatabaseProfileSchemaHealth? transferSourceSchemaHealth;
    private bool databaseBusy;
    private bool transferDialogOpen;
    private bool transferBusy;

    private bool IsDatabaseUiLocked => currentSelection?.IsRuntimeLocked == true;

    private bool IsSelectedProfileActive
        => databaseProfileModel.Id.HasValue &&
           currentSelection is not null &&
           currentSelection.ActiveProfileId == databaseProfileModel.Id.Value;

    private bool SupportsConnectionTest => databaseProfileModel.ProviderKind == DatabaseProviderKind.PostgreSql;

    private bool SupportsCreateEmpty
        => databaseProfileModel.ProviderKind == DatabaseProviderKind.PostgreSql ||
           (databaseProfileModel.ProviderKind == DatabaseProviderKind.Sqlite &&
            databaseProfileModel.SourceKind is DatabaseProfileSourceKind.ManagedSqlite or DatabaseProfileSourceKind.ExternalSqliteFile or DatabaseProfileSourceKind.ImportedSqlite);

    private DatabaseProfileSchemaHealth? SelectedSchemaHealth
        => databaseProfileModel.Id.HasValue &&
           schemaHealthByProfileId.TryGetValue(databaseProfileModel.Id.Value, out var schemaHealth)
            ? schemaHealth
            : null;

    private bool CanTransferSelected
        => transferDialogOpen &&
           !transferBusy &&
           transferTargetProfileId.HasValue &&
           transferSourceProfileId.HasValue &&
           selectedTransferItemKeys.Count > 0 &&
           !TransferSchemaRequiresAction;

    private bool TransferSchemaRequiresAction
        => transferTargetSchemaHealth?.RequiresAction == true ||
           transferSourceSchemaHealth?.RequiresAction == true;

    private string TransferDialogSubtitle
        => transferTargetProfileId.HasValue
            ? "Choose a source database and the settings groups to copy into the selected target."
            : "Choose a target database before transferring settings.";

    private string TransferTargetName
        => databaseProfiles.FirstOrDefault(profile => profile.Id == transferTargetProfileId)?.DisplayName
           ?? databaseProfileModel.DisplayName
           ?? "Selected database";

    private string TransferTargetDescriptor
        => databaseProfiles.FirstOrDefault(profile => profile.Id == transferTargetProfileId)?.Descriptor
           ?? "Save or select a database profile first.";

    private string TransferMessageClass
    {
        get
        {
            var toneClass = transferMessageTone switch
            {
                "success" => "border-emerald-200 bg-emerald-50 text-emerald-950",
                "warning" => "border-amber-300 bg-amber-50 text-amber-950",
                "danger" => "border-rose-200 bg-rose-50 text-rose-950",
                "info" => "border-sky-200 bg-sky-50 text-sky-950",
                _ => "border-slate-200 bg-slate-50 text-slate-700"
            };

            return $"rounded-[1.35rem] border px-4 py-3 text-sm leading-6 {toneClass}";
        }
    }

    private IReadOnlyList<DatabaseProfileSummary> FilteredProfiles => databaseProfiles
        .Where(profile =>
            string.IsNullOrWhiteSpace(profileSearch) ||
            profile.DisplayName.Contains(profileSearch, StringComparison.OrdinalIgnoreCase) ||
            profile.Descriptor.Contains(profileSearch, StringComparison.OrdinalIgnoreCase))
        .OrderBy(profile => profile.DisplayName)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync(preferCurrentSelection: true);
    }

    private async Task ReloadAsync(Guid? selectedProfileId = null, bool preferCurrentSelection = false)
    {
        databaseProfiles = await DatabaseProfileWorkspaceService.ListProfilesAsync();
        currentSelection = await DatabaseProfileWorkspaceService.GetCurrentSelectionAsync();
        RefreshSnapshotDrafts();

        if (selectedProfileId.HasValue)
        {
            databaseProfileModel = await DatabaseProfileWorkspaceService.GetProfileAsync(selectedProfileId.Value);
            await RefreshSelectedSchemaHealthAsync();
            return;
        }

        if (IsDatabaseUiLocked)
        {
            databaseProfileModel = await DatabaseProfileWorkspaceService.GetCurrentEditorAsync();
            await RefreshSelectedSchemaHealthAsync();
            return;
        }

        if (preferCurrentSelection &&
            currentSelection is not null &&
            databaseProfiles.Any(profile => profile.Id == currentSelection.ActiveProfileId))
        {
            databaseProfileModel = await DatabaseProfileWorkspaceService.GetProfileAsync(currentSelection.ActiveProfileId);
            await RefreshSelectedSchemaHealthAsync();
            return;
        }

        if (databaseProfileModel.Id.HasValue &&
            databaseProfiles.Any(profile => profile.Id == databaseProfileModel.Id.Value))
        {
            databaseProfileModel = await DatabaseProfileWorkspaceService.GetProfileAsync(databaseProfileModel.Id.Value);
            await RefreshSelectedSchemaHealthAsync();
            return;
        }

        databaseProfileModel = NewManagedSqliteProfile(currentSelection);
    }

    private async Task EditProfileAsync(Guid id)
    {
        databaseMessage = null;
        databaseProfileModel = await DatabaseProfileWorkspaceService.GetProfileAsync(id);
        await RefreshSelectedSchemaHealthAsync();
    }

    private Task ResetManagedSqliteProfileAsync()
    {
        databaseMessage = null;
        databaseProfileModel = NewManagedSqliteProfile(currentSelection);
        return Task.CompletedTask;
    }

    private Task ResetExternalSqliteProfileAsync()
    {
        databaseMessage = null;
        databaseProfileModel = NewExternalSqliteProfile(currentSelection);
        return Task.CompletedTask;
    }

    private Task ResetPostgreSqlProfileAsync()
    {
        databaseMessage = null;
        databaseProfileModel = NewPostgreSqlProfile(currentSelection);
        return Task.CompletedTask;
    }

    private Task ResetCurrentProfileAsync()
    {
        databaseMessage = null;
        if (databaseProfileModel.Id.HasValue)
        {
            return EditProfileAsync(databaseProfileModel.Id.Value);
        }

        databaseProfileModel = databaseProfileModel.ProviderKind switch
        {
            DatabaseProviderKind.Sqlite when databaseProfileModel.SourceKind == DatabaseProfileSourceKind.ManagedSqlite
                => NewManagedSqliteProfile(currentSelection),
            DatabaseProviderKind.Sqlite
                => NewExternalSqliteProfile(currentSelection),
            DatabaseProviderKind.PostgreSql
                => NewPostgreSqlProfile(currentSelection),
            _ => NewManagedSqliteProfile(currentSelection)
        };
        return Task.CompletedTask;
    }

    private async Task SaveProfileAsync()
    {
        databaseBusy = true;
        databaseMessage = null;

        var result = await DatabaseProfileWorkspaceService.SaveProfileAsync(databaseProfileModel);
        databaseBusy = false;
        if (result.IsFailure)
        {
            SetDatabaseMessage(DescribeErrors(result.Errors), "danger");
            return;
        }

        await ReloadAsync(result.Value);
        SetDatabaseMessage("Data source saved.", "success");
    }

    private async Task TestConnectionAsync()
    {
        if (!databaseProfileModel.Id.HasValue)
        {
            SetDatabaseMessage("Save the profile before testing the connection.", "warning");
            return;
        }

        databaseBusy = true;
        var result = await DatabaseProfileWorkspaceService.TestConnectionAsync(databaseProfileModel.Id.Value);
        databaseBusy = false;
        SetDatabaseMessage(
            result.IsSuccess ? "PostgreSQL connection succeeded." : DescribeErrors(result.Errors),
            result.IsSuccess ? "success" : "danger");
    }

    private async Task CreateEmptyAsync()
    {
        if (!databaseProfileModel.Id.HasValue)
        {
            SetDatabaseMessage("Save the profile before creating the database.", "warning");
            return;
        }

        var targetProfileId = databaseProfileModel.Id.Value;
        databaseBusy = true;
        var result = await DatabaseProfileWorkspaceService.CreateEmptyAsync(targetProfileId);
        databaseBusy = false;
        if (result.IsFailure)
        {
            SetDatabaseMessage(DescribeErrors(result.Errors), "danger");
            return;
        }

        await ReloadAsync(targetProfileId);
        SetDatabaseMessage("Empty database created and schema bootstrapped. Choose any baseline settings to transfer.", "success");
        await OpenTransferDialogAsync(targetProfileId);
    }

    private async Task ApplySelectedSchemaAsync()
    {
        if (!databaseProfileModel.Id.HasValue)
        {
            SetDatabaseMessage("Save the profile before applying the schema.", "warning");
            return;
        }

        var profileId = databaseProfileModel.Id.Value;
        databaseBusy = true;
        var result = await ApplySchemaForProfileAsync(profileId);
        databaseBusy = false;
        if (result.IsFailure)
        {
            SetDatabaseMessage(DescribeErrors(result.Errors), "danger");
            return;
        }

        var schemaHealth = await RefreshSchemaHealthAsync(profileId);
        SetDatabaseMessage(
            schemaHealth?.RequiresAction == true
                ? schemaHealth.Summary
                : "Current database schema applied.",
            schemaHealth?.RequiresAction == true ? "warning" : "success");
    }

    private async Task<Result> ApplySchemaForProfileAsync(Guid profileId)
    {
        schemaBusyProfileId = profileId;
        try
        {
            return await DatabaseProfileWorkspaceService.ApplySchemaAsync(profileId);
        }
        finally
        {
            schemaBusyProfileId = null;
        }
    }

    private async Task OpenTransferDialogAsync(Guid targetProfileId)
    {
        transferDialogOpen = true;
        transferBusy = true;
        transferTargetProfileId = targetProfileId;
        transferSourceProfileId = null;
        transferTargetSchemaHealth = null;
        transferSourceSchemaHealth = null;
        transferItems = [];
        transferSources = [];
        selectedTransferItemKeys.Clear();
        transferMessage = null;
        transferMessageTone = "neutral";

        try
        {
            transferSources = await DatabaseProfileWorkspaceService.ListTransferSourcesAsync(targetProfileId);
            transferSourceProfileId = ResolveDefaultTransferSource(targetProfileId);
        }
        catch (Exception ex)
        {
            transferMessage = $"Could not load transfer sources: {ex.Message}";
            transferMessageTone = "danger";
        }
        finally
        {
            transferBusy = false;
        }

        if (transferSourceProfileId.HasValue)
        {
            await RefreshTransferPreviewAsync(selectAvailableItems: true);
        }
    }

    private Guid? ResolveDefaultTransferSource(Guid targetProfileId)
    {
        if (currentSelection is not null &&
            currentSelection.ActiveProfileId != targetProfileId &&
            transferSources.Any(source => source.ProfileId == currentSelection.ActiveProfileId))
        {
            return currentSelection.ActiveProfileId;
        }

        return transferSources.FirstOrDefault()?.ProfileId;
    }

    private async Task ChangeTransferSourceAsync(ChangeEventArgs args)
    {
        if (!Guid.TryParse(args.Value?.ToString(), out var sourceProfileId))
        {
            transferSourceProfileId = null;
            transferItems = [];
            selectedTransferItemKeys.Clear();
            transferSourceSchemaHealth = null;
            return;
        }

        transferSourceProfileId = sourceProfileId;
        await RefreshTransferPreviewAsync(selectAvailableItems: true);
    }

    private async Task RefreshTransferPreviewAsync(bool selectAvailableItems)
    {
        if (!transferSourceProfileId.HasValue || !transferTargetProfileId.HasValue)
        {
            transferItems = [];
            selectedTransferItemKeys.Clear();
            transferSourceSchemaHealth = null;
            transferTargetSchemaHealth = null;
            return;
        }

        transferBusy = true;
        transferMessage = null;
        try
        {
            await RefreshTransferSchemaHealthAsync();
            if (TransferSchemaRequiresAction)
            {
                transferItems = [];
                selectedTransferItemKeys.Clear();
                transferMessage = "Resolve or apply the current schema before previewing transfer settings.";
                transferMessageTone = "warning";
                return;
            }

            transferItems = await DatabaseProfileWorkspaceService.PreviewTransferAsync(
                transferSourceProfileId.Value,
                transferTargetProfileId.Value);

            if (selectAvailableItems)
            {
                selectedTransferItemKeys.Clear();
                foreach (var item in transferItems.Where(item => item.IsAvailable))
                {
                    selectedTransferItemKeys.Add(item.Descriptor.Key);
                }
            }
            else
            {
                selectedTransferItemKeys.IntersectWith(transferItems.Select(item => item.Descriptor.Key));
            }
        }
        catch (Exception ex)
        {
            transferItems = [];
            selectedTransferItemKeys.Clear();
            transferMessage = $"Could not preview settings transfer: {ex.Message}";
            transferMessageTone = "danger";
        }
        finally
        {
            transferBusy = false;
        }
    }

    private async Task RefreshTransferSchemaHealthAsync()
    {
        transferTargetSchemaHealth = transferTargetProfileId.HasValue
            ? await RefreshSchemaHealthAsync(transferTargetProfileId.Value)
            : null;
        transferSourceSchemaHealth = transferSourceProfileId.HasValue
            ? await RefreshSchemaHealthAsync(transferSourceProfileId.Value)
            : null;
    }

    private async Task ApplyTransferTargetSchemaAsync()
    {
        if (!transferTargetProfileId.HasValue)
        {
            return;
        }

        await ApplyTransferSchemaAsync(transferTargetProfileId.Value, "target");
    }

    private async Task ApplyTransferSourceSchemaAsync()
    {
        if (!transferSourceProfileId.HasValue)
        {
            return;
        }

        await ApplyTransferSchemaAsync(transferSourceProfileId.Value, "source");
    }

    private async Task ApplyTransferSchemaAsync(Guid profileId, string role)
    {
        transferBusy = true;
        transferMessage = null;
        var result = await ApplySchemaForProfileAsync(profileId);
        transferBusy = false;
        if (result.IsFailure)
        {
            transferMessage = DescribeErrors(result.Errors);
            transferMessageTone = "danger";
            await RefreshTransferSchemaHealthAsync();
            return;
        }

        await RefreshTransferSchemaHealthAsync();
        if (TransferSchemaRequiresAction)
        {
            transferMessage = $"Schema apply finished, but the {role} database still needs attention.";
            transferMessageTone = "warning";
            return;
        }

        await RefreshTransferPreviewAsync(selectAvailableItems: true);
        if (string.IsNullOrWhiteSpace(transferMessage))
        {
            transferMessage = $"Current schema applied to the {role} database.";
            transferMessageTone = "success";
        }
    }

    private void ToggleTransferItem(string key, ChangeEventArgs args)
    {
        var selected = args.Value is bool value
            ? value
            : string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        if (selected)
        {
            selectedTransferItemKeys.Add(key);
            return;
        }

        selectedTransferItemKeys.Remove(key);
    }

    private async Task TransferSelectedSettingsAsync()
    {
        if (!transferSourceProfileId.HasValue || !transferTargetProfileId.HasValue)
        {
            transferMessage = "Select a source and target database before transferring settings.";
            transferMessageTone = "warning";
            return;
        }

        transferBusy = true;
        transferMessage = null;
        var result = await DatabaseProfileWorkspaceService.TransferSettingsAsync(new DatabaseTransferRequest
        {
            SourceProfileId = transferSourceProfileId.Value,
            TargetProfileId = transferTargetProfileId.Value,
            ItemKeys = selectedTransferItemKeys.ToList(),
            ReplaceExisting = true
        });
        transferBusy = false;

        transferMessage = string.Join(" ", result.Items.Select(item => $"{item.Label}: {item.Message}"));
        transferMessageTone = result.IsSuccess ? "success" : "danger";
        SetDatabaseMessage(result.IsSuccess
            ? $"Transferred {result.RecordsCopied} setting record(s)."
            : "One or more settings groups could not be transferred.",
            result.IsSuccess ? "success" : "danger");

        await RefreshTransferPreviewAsync(selectAvailableItems: false);
        await ReloadAsync(transferTargetProfileId.Value);
    }

    private Task CloseTransferDialog()
    {
        transferDialogOpen = false;
        transferBusy = false;
        return Task.CompletedTask;
    }

    private async Task CreateCloneAsync()
    {
        if (currentSelection is null)
        {
            SetDatabaseMessage("An active runtime profile is required before you can create a clone.", "warning");
            return;
        }

        databaseBusy = true;
        var result = await DatabaseProfileWorkspaceService.CloneAsync(
            currentSelection.ActiveProfileId,
            cloneDisplayName,
            DatabaseSnapshotTransportKind.Local);
        databaseBusy = false;
        if (result.IsFailure)
        {
            SetDatabaseMessage(DescribeErrors(result.Errors), "danger");
            return;
        }

        latestSnapshotPackagePath = result.Value!.PackagePath;
        snapshotPackagePath = result.Value.PackagePath;
        await ReloadAsync(result.Value.ProfileId);
        SetDatabaseMessage("Clone profile created from the active runtime snapshot. Activate it when you are ready to branch.", "success");
    }

    private async Task CreateLocalSnapshotAsync()
    {
        if (currentSelection is null)
        {
            SetDatabaseMessage("An active runtime profile is required before you can save a snapshot.", "warning");
            return;
        }

        databaseBusy = true;
        var result = await DatabaseProfileWorkspaceService.CreateSnapshotAsync(
            currentSelection.ActiveProfileId,
            DatabaseSnapshotTransportKind.Local);
        databaseBusy = false;
        if (result.IsFailure)
        {
            SetDatabaseMessage(DescribeErrors(result.Errors), "danger");
            return;
        }

        latestSnapshotPackagePath = result.Value!.PackagePath;
        snapshotPackagePath = result.Value.PackagePath;
        SetDatabaseMessage($"Local snapshot saved to {result.Value.PackagePath}.", "success");
    }

    private async Task CreateIpfsSnapshotAsync()
    {
        if (currentSelection is null)
        {
            SetDatabaseMessage("An active runtime profile is required before you can publish a snapshot.", "warning");
            return;
        }

        databaseBusy = true;
        var result = await DatabaseProfileWorkspaceService.CreateSnapshotAsync(
            currentSelection.ActiveProfileId,
            DatabaseSnapshotTransportKind.Ipfs);
        databaseBusy = false;
        if (result.IsFailure)
        {
            SetDatabaseMessage(DescribeErrors(result.Errors), "danger");
            return;
        }

        latestSnapshotPackagePath = result.Value!.PackagePath;
        latestSnapshotCid = result.Value.IpfsCid;
        snapshotPackagePath = result.Value.PackagePath;
        snapshotCid = result.Value.IpfsCid ?? string.Empty;
        SetDatabaseMessage(
            string.IsNullOrWhiteSpace(result.Value.IpfsCid)
                ? "IPFS snapshot was created but no CID was returned."
                : $"Snapshot published to IPFS as {result.Value.IpfsCid}.",
            string.IsNullOrWhiteSpace(result.Value.IpfsCid) ? "warning" : "success");
    }

    private async Task RestoreLocalSnapshotAsync()
    {
        databaseBusy = true;
        var result = await DatabaseProfileWorkspaceService.MaterializeSnapshotAsync(new DatabaseSnapshotMaterializationRequest
        {
            DisplayName = snapshotProfileName,
            PackagePath = snapshotPackagePath
        });
        databaseBusy = false;
        if (result.IsFailure)
        {
            SetDatabaseMessage(DescribeErrors(result.Errors), "danger");
            return;
        }

        latestSnapshotPackagePath = result.Value!.PackagePath;
        await ReloadAsync(result.Value.ProfileId);
        SetDatabaseMessage("Snapshot restored into a new local working-copy profile. Activate it to switch the runtime.", "success");
    }

    private async Task RestoreIpfsSnapshotAsync()
    {
        databaseBusy = true;
        var result = await DatabaseProfileWorkspaceService.MaterializeSnapshotAsync(new DatabaseSnapshotMaterializationRequest
        {
            DisplayName = snapshotProfileName,
            SnapshotCid = snapshotCid
        });
        databaseBusy = false;
        if (result.IsFailure)
        {
            SetDatabaseMessage(DescribeErrors(result.Errors), "danger");
            return;
        }

        latestSnapshotPackagePath = result.Value!.PackagePath;
        latestSnapshotCid = result.Value.IpfsCid;
        await ReloadAsync(result.Value.ProfileId);
        SetDatabaseMessage("IPFS snapshot restored into a new local working-copy profile. Activate it to switch the runtime.", "success");
    }

    private async Task ActivateProfileAsync()
    {
        if (!databaseProfileModel.Id.HasValue)
        {
            SetDatabaseMessage("Save the profile before activating it.", "warning");
            return;
        }

        var profileId = databaseProfileModel.Id.Value;
        databaseBusy = true;
        var schemaHealth = await RefreshSchemaHealthAsync(profileId);
        if (schemaHealth?.RequiresAction == true)
        {
            databaseBusy = false;
            SetDatabaseMessage("Apply the current schema before activating this data source.", "warning");
            return;
        }

        var result = await DatabaseProfileWorkspaceService.ActivateProfileAsync(profileId);
        databaseBusy = false;
        if (result.IsFailure)
        {
            SetDatabaseMessage(DescribeErrors(result.Errors), "danger");
            return;
        }

        SetDatabaseMessage("Database activation requested. The shell will reload a safe route for the new runtime profile.", "info");
    }

    private async Task DeleteProfileAsync()
    {
        if (!databaseProfileModel.Id.HasValue)
        {
            return;
        }

        databaseBusy = true;
        var result = await DatabaseProfileWorkspaceService.DeleteProfileAsync(databaseProfileModel.Id.Value);
        databaseBusy = false;
        if (result.IsFailure)
        {
            SetDatabaseMessage(DescribeErrors(result.Errors), "danger");
            return;
        }

        await ReloadAsync(preferCurrentSelection: true);
        SetDatabaseMessage("Data source deleted.", "success");
    }

    private void ResetProfileSearch()
    {
        profileSearch = string.Empty;
    }

    private void SetDatabaseMessage(string message, string tone)
    {
        databaseMessage = message;
        databaseMessageTone = tone;
        switch (tone)
        {
            case "success":
                NotificationService.Success("Data source updated", message);
                break;
            case "warning":
                NotificationService.Warning("Data source needs attention", message);
                break;
            case "danger":
                NotificationService.Error("Data source operation failed", message);
                break;
            case "info":
                NotificationService.Info("Data source update", message);
                break;
            default:
                NotificationService.Info("Data source update", message);
                break;
        }
    }

    private Task RefreshSelectedSchemaHealthAsync()
    {
        return databaseProfileModel.Id.HasValue
            ? RefreshSchemaHealthAsync(databaseProfileModel.Id.Value)
            : Task.CompletedTask;
    }

    private async Task<DatabaseProfileSchemaHealth?> RefreshSchemaHealthAsync(Guid profileId)
    {
        var schemaHealth = await DatabaseProfileWorkspaceService.GetSchemaHealthAsync(profileId);
        schemaHealthByProfileId[profileId] = schemaHealth;
        return schemaHealth;
    }

    private DatabaseProfileSchemaHealth? TryGetSchemaHealth(Guid profileId)
    {
        return schemaHealthByProfileId.TryGetValue(profileId, out var schemaHealth)
            ? schemaHealth
            : null;
    }

    private void RefreshSnapshotDrafts()
    {
        cloneDisplayName = currentSelection is null
            ? "Snapshot clone"
            : $"{currentSelection.DisplayName} clone";

        snapshotProfileName = currentSelection is null
            ? "Snapshot working copy"
            : $"{currentSelection.DisplayName} working copy";
    }

    private static string DescribeErrors(IReadOnlyList<Error> errors)
    {
        return string.Join(" ", errors.Select(error => error.Message));
    }

    private static string DescribeSchemaStatus(DatabaseProfileSchemaHealth schemaHealth)
    {
        return schemaHealth.Status switch
        {
            DatabaseProfileSchemaStatus.Current => "Schema current",
            DatabaseProfileSchemaStatus.NeedsMigration => "Needs schema",
            DatabaseProfileSchemaStatus.Unavailable => "Schema check failed",
            _ => "Schema unknown"
        };
    }

    private static string DescribeSchemaTone(DatabaseProfileSchemaHealth schemaHealth)
    {
        return schemaHealth.Status switch
        {
            DatabaseProfileSchemaStatus.Current => "success",
            DatabaseProfileSchemaStatus.NeedsMigration => "warning",
            DatabaseProfileSchemaStatus.Unavailable => "danger",
            _ => "neutral"
        };
    }

    private static AlertStyle ResolveSchemaAlertStyle(DatabaseProfileSchemaHealth schemaHealth)
    {
        return schemaHealth.Status switch
        {
            DatabaseProfileSchemaStatus.Unavailable => AlertStyle.Danger,
            DatabaseProfileSchemaStatus.NeedsMigration => AlertStyle.Warning,
            _ => AlertStyle.Info
        };
    }

    private static bool HasSchemaDetails(DatabaseProfileSchemaHealth schemaHealth)
    {
        return schemaHealth.PendingMigrations.Count > 0 || schemaHealth.SchemaIssues.Count > 0;
    }

    private static string DescribeSchemaDetails(DatabaseProfileSchemaHealth schemaHealth)
    {
        if (schemaHealth.PendingMigrations.Count > 0)
        {
            var visibleMigrations = schemaHealth.PendingMigrations.Take(3).ToList();
            var suffix = schemaHealth.PendingMigrations.Count > visibleMigrations.Count
                ? $" and {schemaHealth.PendingMigrations.Count - visibleMigrations.Count} more"
                : string.Empty;
            return $"Pending: {string.Join(", ", visibleMigrations)}{suffix}.";
        }

        var visibleIssues = schemaHealth.SchemaIssues.Take(4).ToList();
        var issueSuffix = schemaHealth.SchemaIssues.Count > visibleIssues.Count
            ? $" and {schemaHealth.SchemaIssues.Count - visibleIssues.Count} more"
            : string.Empty;
        return $"Missing: {string.Join(", ", visibleIssues)}{issueSuffix}.";
    }

    private static string BuildProfileSummary(DatabaseProfileSummary profile)
    {
        var lastUsed = profile.LastUsedUtc.HasValue
            ? $"Last used {FormatTimestamp(profile.LastUsedUtc.Value)}"
            : $"Created {FormatTimestamp(profile.CreatedUtc)}";
        return $"{profile.Descriptor} · {lastUsed}";
    }

    private static string DescribeProvider(DatabaseProviderKind providerKind)
    {
        return providerKind switch
        {
            DatabaseProviderKind.Sqlite => "SQLite",
            DatabaseProviderKind.PostgreSql => "PostgreSQL",
            DatabaseProviderKind.InMemory => "In-memory",
            _ => providerKind.ToString()
        };
    }

    private static string DescribeSource(DatabaseProfileSourceKind sourceKind)
    {
        return sourceKind switch
        {
            DatabaseProfileSourceKind.ManagedSqlite => "Managed SQLite",
            DatabaseProfileSourceKind.ExternalSqliteFile => "External SQLite file",
            DatabaseProfileSourceKind.ImportedSqlite => "Imported SQLite file",
            DatabaseProfileSourceKind.PostgresConnection => "PostgreSQL connection",
            DatabaseProfileSourceKind.SnapshotCache => "Snapshot cache",
            DatabaseProfileSourceKind.IpfsSnapshot => "IPFS snapshot",
            DatabaseProfileSourceKind.InMemory => "In-memory",
            _ => sourceKind.ToString()
        };
    }

    private static string DescribeResolutionSource(DatabaseProfileResolutionSource resolutionSource)
    {
        return resolutionSource switch
        {
            DatabaseProfileResolutionSource.ExplicitOverride => "Explicit startup override",
            DatabaseProfileResolutionSource.PersistedActiveProfile => "Last active profile",
            DatabaseProfileResolutionSource.PersistedCatalogFallback => "Persisted catalog fallback",
            DatabaseProfileResolutionSource.LegacyDiscovery => "Legacy discovery",
            DatabaseProfileResolutionSource.AutoProvisionedManagedSqlite => "Auto-provisioned managed SQLite",
            _ => resolutionSource.ToString()
        };
    }

    private static string DescribeEditorLead(DatabaseProfileEditorModel model)
    {
        return model.ProviderKind switch
        {
            DatabaseProviderKind.Sqlite when model.SourceKind == DatabaseProfileSourceKind.ManagedSqlite
                => "Managed SQLite keeps both the database file and workspace root under the control plane for predictable local switching.",
            DatabaseProviderKind.Sqlite when model.SourceKind is DatabaseProfileSourceKind.SnapshotCache or DatabaseProfileSourceKind.IpfsSnapshot
                => "Snapshot-backed profiles materialize into a local control-plane working copy so branch-style edits and managed files can diverge safely from the source snapshot.",
            DatabaseProviderKind.Sqlite
                => "External or imported SQLite profiles point at an existing file path and keep the workspace root explicit.",
            DatabaseProviderKind.PostgreSql
                => "PostgreSQL profiles carry the connection metadata needed to test, create, and activate a runtime database safely.",
            DatabaseProviderKind.InMemory
                => "In-memory profiles are primarily for test and override scenarios.",
            _ => "Edit the saved data source metadata and runtime path details."
        };
    }

    private static string FormatTimestamp(DateTimeOffset value)
    {
        return value.LocalDateTime.ToString("g");
    }


@using CanDoItAll.Components.BaseLib
@inject ProjectStructureAgentAdministrationService AdministrationService
@inject ProjectManagementKnowledgeService KnowledgeService

<div class="flex min-h-full flex-col gap-6" data-testid="settings-project-structure-agent-panel">
    <EditForm Model="settingsModel" OnValidSubmit="SaveSettingsAsync">
        <div class="flex min-h-full flex-col gap-6">
            <FormSection Title="Central project-structure MCP settings"
                         Description="These values define how remote workstation MCP clients find the main CanDoItAll machine and which setup script operators should use.">
                <SummaryTiles>
                    <SummaryTile Label="Profiles" Value="@profiles.Count.ToString()" HelperText="Registered agent profiles." />
                    <SummaryTile Label="Enabled" Value="@profiles.Count(item => item.IsEnabled).ToString()" HelperText="Profiles currently active." Tone="success" />
                    <SummaryTile Label="Base URL" Value="@BaseUrlSummary" HelperText="Central machine address used by remote MCP clients." Tone="info" />
                    <SummaryTile Label="Knowledge" Value="@knowledgeEntries.Count.ToString()" HelperText="Seeded guidance entries visible in settings and API." />
                </SummaryTiles>

                <div class="mt-6 grid gap-4 md:grid-cols-2">
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700">Central base URL</label>
                        <InputText @bind-Value="settingsModel.CentralBaseUrl" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" data-testid="project-structure-settings-base-url" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700">Install script path</label>
                        <InputText @bind-Value="settingsModel.InstallScriptPath" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                    </div>
                </div>

                <div class="mt-4 grid gap-4 md:grid-cols-3">
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700">Setup README path</label>
                        <InputText @bind-Value="settingsModel.SetupReadmePath" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700">Default auto-approve up to (minutes)</label>
                        <InputNumber @bind-Value="settingsModel.DefaultAutoApproveMinutes" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700">Default approval required over (minutes)</label>
                        <InputNumber @bind-Value="settingsModel.DefaultApprovalRequiredMinutes" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                    </div>
                </div>
            </FormSection>

            <StickyActionFooter StatusLabel="Project-structure MCP settings" StatusMessage="@settingsMessage" StatusTone="success">
                <PrimaryActions>
                    <button type="submit" class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white" data-testid="project-structure-settings-save">Save central settings</button>
                </PrimaryActions>
            </StickyActionFooter>
        </div>
    </EditForm>

    <div class="grid gap-6 xl:grid-cols-[22rem,1fr]">
        <div class="space-y-4 rounded-3xl border border-slate-200 bg-white p-4 shadow-sm">
            <div class="flex items-center justify-between gap-4">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Agent profiles</p>
                    <h2 class="text-lg font-semibold text-slate-950">Project-structure MCP agents</h2>
                </div>
                <button type="button" class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700" @onclick="ResetProfileAsync" data-testid="project-structure-profile-new">New profile</button>
            </div>

            <div class="space-y-2">
                <input @bind="profileSearch" @bind:event="oninput" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700" placeholder="Search profiles" />
                <button type="button" class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700" @onclick="ResetProfileSearch">Reset</button>
            </div>

            @if (FilteredProfiles.Count == 0)
            {
                <EmptyState Eyebrow="No agents" Title="Create the first project-structure agent profile" Description="Profiles appear here after they are saved." />
            }
            else
            {
                <div class="space-y-3">
                    @foreach (var profile in FilteredProfiles)
                    {
                        <SelectionListItem Title="@profile.Name"
                                           Eyebrow="@profile.TokenPreview"
                                           Meta="@profile.CapabilityMask.ToString()"
                                           Summary="@BuildProfileSummary(profile)"
                                           IsSelected="@(profileModel.Id == profile.Id)"
                                           OnSelect="@(() => EditProfileAsync(profile.Id))">
                            <Status>
                                <StatusBadge Tone="@(profile.IsEnabled ? "success" : "warning")" Text="@(profile.IsEnabled ? "Enabled" : "Disabled")" />
                            </Status>
                        </SelectionListItem>
                    }
                </div>
            }
        </div>

        <EditForm Model="profileModel" OnValidSubmit="SaveProfileAsync">
            <div class="flex min-h-full flex-col gap-6 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Project-structure MCP profile</p>
                    <h2 class="text-xl font-semibold text-slate-950">@(profileModel.Id.HasValue ? profileModel.Name : "New project-structure agent")</h2>
                    <p class="text-sm leading-6 text-slate-600">Keep capabilities, approval limits, project overrides, and workstation setup guidance in one operator-facing surface.</p>
                </div>

                <FormSection Title="Profile identity" Description="Define the operator-facing label and whether the central API should accept this profile.">
                    <div class="grid gap-4 md:grid-cols-2">
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700">Profile name</label>
                            <InputText @bind-Value="profileModel.Name" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" data-testid="project-structure-profile-name" />
                        </div>
                        <div class="flex items-end">
                            <label class="flex w-full items-center gap-2 rounded-xl bg-white px-3 py-2 text-sm text-slate-700">
                                <InputCheckbox @bind-Value="profileModel.IsEnabled" />
                                Profile enabled
                            </label>
                        </div>
                    </div>

                    <div class="mt-4">
                        <label class="mb-1 block text-sm font-medium text-slate-700">Description</label>
                        <InputTextArea @bind-Value="profileModel.Description" class="min-h-24 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                    </div>

                    <div class="mt-4">
                        <label class="mb-1 block text-sm font-medium text-slate-700">Operator notes</label>
                        <InputTextArea @bind-Value="profileModel.Notes" class="min-h-20 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                    </div>
                </FormSection>

                <FormSection Title="Capabilities" Description="The central API enforces these permissions for every request authenticated with this profile token.">
                    <div class="grid gap-3 md:grid-cols-2" data-testid="project-structure-capabilities">
                        @foreach (var capability in CapabilityOptions)
                        {
                            <label class="flex items-center gap-2 rounded-xl bg-slate-50 px-3 py-2 text-sm text-slate-700">
                                <input type="checkbox" checked="@HasProfileCapability(capability.Capability)" @onchange="args => ToggleProfileCapability(capability.Capability, args.Value)" data-testid="@capability.TestId" />
                                @capability.Label
                            </label>
                        }
                    </div>
                </FormSection>

                <FormSection Title="Approval policy" Description="Thresholds are enforced centrally. Set a value of 0 to disable that threshold.">
                    <div class="grid gap-4 md:grid-cols-3">
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700">Auto-approve up to (minutes)</label>
                            <InputNumber @bind-Value="profileModel.AutoApproveMinutes" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" data-testid="project-structure-profile-auto-approve" />
                        </div>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700">Approval required over (minutes)</label>
                            <InputNumber @bind-Value="profileModel.ApprovalRequiredMinutes" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" data-testid="project-structure-profile-approval-required" />
                        </div>
                        <div class="flex items-end">
                            <label class="flex w-full items-center gap-2 rounded-xl bg-slate-50 px-3 py-2 text-sm text-slate-700">
                                <InputCheckbox @bind-Value="profileModel.RequireApprovalForAllMutations" />
                                Require approval for every mutation
                            </label>
                        </div>
                    </div>
                </FormSection>

                <FormSection Title="Token and workstation setup" Description="The token is encrypted at rest. Rotate it when a workstation changes or the token leaks.">
                    <div class="grid gap-4 md:grid-cols-[1fr_auto]">
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700">Profile token</label>
                            <input class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-700"
                                   value="@DisplayToken"
                                   readonly
                                   data-testid="project-structure-profile-token" />
                        </div>
                        <div class="flex items-end">
                            <button type="button" class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700" @onclick="RotateToken" data-testid="project-structure-profile-rotate-token">Rotate token on save</button>
                        </div>
                    </div>

                    @if (currentSetupGuide is null)
                    {
                        <div class="mt-4 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-slate-600">
                            Save the profile to generate workstation setup guidance.
                        </div>
                    }
                    else
                    {
                        <div class="mt-4 space-y-4 rounded-2xl border border-slate-200 bg-slate-50 p-4" data-testid="project-structure-setup-guide">
                            <div class="grid gap-4 md:grid-cols-2">
                                <div>
                                    <p class="mb-1 text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Local settings file</p>
                                    <textarea class="min-h-40 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 font-mono text-xs text-slate-700" readonly>@currentSetupGuide.SettingsJson</textarea>
                                </div>
                                <div class="space-y-4">
                                    <div>
                                        <p class="mb-1 text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Install command</p>
                                        <textarea class="min-h-24 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 font-mono text-xs text-slate-700" readonly data-testid="project-structure-setup-command">@currentSetupGuide.PowerShellCommand</textarea>
                                    </div>
                                    <div>
                                        <p class="mb-1 text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Codex config section</p>
                                        <textarea class="min-h-28 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 font-mono text-xs text-slate-700" readonly>@currentSetupGuide.CodexConfigSnippet</textarea>
                                    </div>
                                </div>
                            </div>

                            <div class="rounded-2xl border border-slate-200 bg-white p-3 text-sm text-slate-600">
                                <p><span class="font-semibold text-slate-900">Base URL:</span> @currentSetupGuide.BaseUrl</p>
                                <p><span class="font-semibold text-slate-900">Settings file:</span> @currentSetupGuide.SettingsFilePath</p>
                                <p><span class="font-semibold text-slate-900">README:</span> @currentSetupGuide.ReadmePath</p>
                                <p class="mt-2">@currentSetupGuide.TokenUsageNote</p>
                            </div>
                        </div>
                    }
                </FormSection>

                <FormSection Title="Project overrides" Description="Overrides replace the profile defaults for a specific project when the central API evaluates that project scope.">
                    <div class="space-y-4" data-testid="project-structure-profile-overrides">
                        @if (profileModel.ProjectOverrides.Count == 0)
                        {
                            <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-slate-600">
                                No project-specific overrides are configured yet.
                            </div>
                        }

                        @foreach (var overrideModel in profileModel.ProjectOverrides)
                        {
                            <div class="space-y-4 rounded-2xl border border-slate-200 bg-slate-50 p-4" data-testid="project-structure-override-card">
                                <div class="flex items-start justify-between gap-4">
                                    <div class="grid flex-1 gap-4 md:grid-cols-2">
                                        <div>
                                            <label class="mb-1 block text-sm font-medium text-slate-700">Project</label>
                                            <InputSelect @bind-Value="overrideModel.ProjectId" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" @bind-Value:after="() => SyncOverrideProjectName(overrideModel)">
                                                <option value="@Guid.Empty">Select project</option>
                                                @foreach (var projectChoice in projectChoices)
                                                {
                                                    <option value="@projectChoice.Id">@projectChoice.Name</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div class="flex items-end">
                                            <label class="flex w-full items-center gap-2 rounded-xl bg-white px-3 py-2 text-sm text-slate-700">
                                                <InputCheckbox @bind-Value="overrideModel.IsEnabled" />
                                                Override enabled
                                            </label>
                                        </div>
                                    </div>

                                    <button type="button" class="rounded-xl border border-rose-300 bg-rose-50 px-3 py-2 text-xs font-semibold text-rose-700" @onclick="@(() => RemoveOverride(overrideModel))">Remove</button>
                                </div>

                                <div class="grid gap-3 md:grid-cols-2">
                                    @foreach (var capability in CapabilityOptions)
                                    {
                                        <label class="flex items-center gap-2 rounded-xl bg-white px-3 py-2 text-sm text-slate-700">
                                            <input type="checkbox" checked="@HasOverrideCapability(overrideModel, capability.Capability)" @onchange="args => ToggleOverrideCapability(overrideModel, capability.Capability, args.Value)" />
                                            @capability.Label
                                        </label>
                                    }
                                </div>

                                <div class="grid gap-4 md:grid-cols-3">
                                    <div>
                                        <label class="mb-1 block text-sm font-medium text-slate-700">Auto-approve up to (minutes)</label>
                                        <InputNumber @bind-Value="overrideModel.AutoApproveMinutes" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                                    </div>
                                    <div>
                                        <label class="mb-1 block text-sm font-medium text-slate-700">Approval required over (minutes)</label>
                                        <InputNumber @bind-Value="overrideModel.ApprovalRequiredMinutes" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                                    </div>
                                    <div class="flex items-end">
                                        <label class="flex w-full items-center gap-2 rounded-xl bg-white px-3 py-2 text-sm text-slate-700">
                                            <InputCheckbox @bind-Value="overrideModel.RequireApprovalForAllMutations" />
                                            Require approval for every mutation
                                        </label>
                                    </div>
                                </div>
                            </div>
                        }

                        <button type="button" class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700" @onclick="AddOverride" data-testid="project-structure-profile-add-override">Add project override</button>
                    </div>
                </FormSection>

                <FormSection Title="Knowledge guidance" Description="This is the current static provider content served by the central API for planning, approval, and reporting discussions.">
                    <div class="grid gap-4 xl:grid-cols-2" data-testid="project-structure-knowledge-list">
                        @foreach (var entry in knowledgeEntries)
                        {
                            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                                <div class="flex items-center justify-between gap-4">
                                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">@entry.Category</p>
                                    @if (entry.IsMissionAnchor)
                                    {
                                        <StatusBadge Tone="info" Text="Mission" />
                                    }
                                </div>
                                <h3 class="mt-2 text-base font-semibold text-slate-950">@entry.Title</h3>
                                <p class="mt-1 text-sm leading-6 text-slate-600">@entry.Summary</p>
                                <p class="mt-3 text-sm leading-6 text-slate-700">@entry.Guidance</p>
                            </div>
                        }
                    </div>
                </FormSection>

                <StickyActionFooter StatusLabel="Project-structure MCP profiles" StatusMessage="@profileMessage" StatusTone="success">
                    <SecondaryActions>
                        <button type="button" class="rounded-xl border border-slate-300 bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700" @onclick="ResetProfileAsync">Clear</button>
                    </SecondaryActions>
                    <PrimaryActions>
                        <button type="submit" class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white" data-testid="project-structure-profile-save">Save profile</button>
                    </PrimaryActions>
                    <DangerActions>
                        @if (profileModel.Id.HasValue)
                        {
                            <button type="button" class="inline-flex items-center rounded-xl border border-rose-300 bg-rose-50 px-4 py-2 text-sm font-semibold text-rose-700" @onclick="DeleteProfileAsync">Delete</button>
                        }
                    </DangerActions>
                </StickyActionFooter>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private static readonly CapabilityOption[] CapabilityOptions =
    [
        new(ProjectStructureAgentCapability.ReadStructure, "Read structure", "project-structure-capability-read"),
        new(ProjectStructureAgentCapability.MutateStructure, "Mutate structure", "project-structure-capability-mutate"),
        new(ProjectStructureAgentCapability.ImportStructure, "Import structures", "project-structure-capability-import"),
        new(ProjectStructureAgentCapability.ReadKnowledge, "Read knowledge", "project-structure-capability-knowledge"),
        new(ProjectStructureAgentCapability.ManageLeases, "Manage leases", "project-structure-capability-leases")
    ];

    private ProjectStructureAgentWorkspaceSettingsModel settingsModel = new();
    private ProjectStructureAgentProfileEditorModel profileModel = new();
    private IReadOnlyList<ProjectStructureAgentProfileSummary> profiles = [];
    private IReadOnlyList<ProjectStructureProjectChoice> projectChoices = [];
    private IReadOnlyList<ProjectManagementKnowledgeEntry> knowledgeEntries = [];
    private ProjectStructureAgentSetupGuide? currentSetupGuide;
    private string? settingsMessage;
    private string? profileMessage;
    private string profileSearch = string.Empty;

    private IReadOnlyList<ProjectStructureAgentProfileSummary> FilteredProfiles => profiles
        .Where(profile =>
            string.IsNullOrWhiteSpace(profileSearch) ||
            profile.Name.Contains(profileSearch, StringComparison.OrdinalIgnoreCase) ||
            profile.Description.Contains(profileSearch, StringComparison.OrdinalIgnoreCase) ||
            profile.TokenPreview.Contains(profileSearch, StringComparison.OrdinalIgnoreCase))
        .OrderBy(profile => profile.Name, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private string BaseUrlSummary => string.IsNullOrWhiteSpace(settingsModel.CentralBaseUrl)
        ? "Not configured"
        : settingsModel.CentralBaseUrl;

    private string DisplayToken => string.IsNullOrWhiteSpace(profileModel.TokenValue)
        ? (profileModel.GenerateNewToken ? "Generated on save" : "No token")
        : profileModel.TokenValue;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        settingsModel = await AdministrationService.GetSettingsAsync();
        profiles = await AdministrationService.ListProfilesAsync();
        projectChoices = await AdministrationService.ListProjectChoicesAsync();
        knowledgeEntries = await KnowledgeService.QueryAsync(new ProjectManagementKnowledgeQuery(Take: 6));
        profileModel = profiles.Count > 0
            ? await AdministrationService.GetProfileAsync(profiles[0].Id)
            : await AdministrationService.GetProfileAsync(null);
        await RefreshSetupGuideAsync();
    }

    private async Task SaveSettingsAsync()
    {
        try
        {
            await AdministrationService.SaveSettingsAsync(settingsModel);
            settingsMessage = "Central project-structure MCP settings saved.";
            await RefreshSetupGuideAsync();
        }
        catch (InvalidOperationException ex)
        {
            settingsMessage = ex.Message;
        }
    }

    private async Task SaveProfileAsync()
    {
        var result = await AdministrationService.SaveProfileAsync(profileModel);
        profileMessage = result.IsSuccess
            ? "Project-structure MCP profile saved."
            : string.Join(" ", result.Errors.Select(error => error.Message));

        if (!result.IsSuccess)
        {
            return;
        }

        profiles = await AdministrationService.ListProfilesAsync();
        projectChoices = await AdministrationService.ListProjectChoicesAsync();
        profileModel = await AdministrationService.GetProfileAsync(result.Value);
        await RefreshSetupGuideAsync();
    }

    private async Task EditProfileAsync(Guid id)
    {
        profileModel = await AdministrationService.GetProfileAsync(id);
        await RefreshSetupGuideAsync();
    }

    private async Task ResetProfileAsync()
    {
        profileModel = await AdministrationService.GetProfileAsync(null);
        profileMessage = null;
        await RefreshSetupGuideAsync();
    }

    private async Task DeleteProfileAsync()
    {
        if (!profileModel.Id.HasValue)
        {
            return;
        }

        await AdministrationService.DeleteProfileAsync(profileModel.Id.Value);
        profiles = await AdministrationService.ListProfilesAsync();
        await ResetProfileAsync();
        profileMessage = "Project-structure MCP profile deleted.";
    }

    private async Task RefreshSetupGuideAsync()
    {
        currentSetupGuide = profileModel.Id.HasValue
            ? await AdministrationService.BuildSetupGuideAsync(profileModel.Id.Value)
            : null;
    }

    private void RotateToken()
    {
        profileModel.GenerateNewToken = true;
        profileModel.TokenValue = string.Empty;
        profileMessage = "A new token will be generated when you save the profile.";
    }

    private void AddOverride()
    {
        profileModel.ProjectOverrides.Add(new ProjectStructureAgentProjectOverrideEditorModel
        {
            CapabilityMask = profileModel.CapabilityMask,
            AutoApproveMinutes = profileModel.AutoApproveMinutes,
            ApprovalRequiredMinutes = profileModel.ApprovalRequiredMinutes,
            RequireApprovalForAllMutations = profileModel.RequireApprovalForAllMutations,
            IsEnabled = true
        });
    }

    private void RemoveOverride(ProjectStructureAgentProjectOverrideEditorModel overrideModel)
    {
        profileModel.ProjectOverrides.Remove(overrideModel);
    }

    private void SyncOverrideProjectName(ProjectStructureAgentProjectOverrideEditorModel overrideModel)
    {
        overrideModel.ProjectName = projectChoices.FirstOrDefault(item => item.Id == overrideModel.ProjectId)?.Name ?? string.Empty;
    }

    private static string BuildProfileSummary(ProjectStructureAgentProfileSummary profile)
    {
        return $"{profile.ProjectOverrideCount} override(s) | {profile.AutoApproveMinutes}m auto | {profile.ApprovalRequiredMinutes}m approval";
    }

    private bool HasProfileCapability(ProjectStructureAgentCapability capability)
    {
        return (profileModel.CapabilityMask & capability) == capability;
    }

    private void ToggleProfileCapability(ProjectStructureAgentCapability capability, object? rawValue)
    {
        if (rawValue is bool isEnabled && isEnabled)
        {
            profileModel.CapabilityMask |= capability;
            return;
        }

        profileModel.CapabilityMask &= ~capability;
    }

    private static bool HasOverrideCapability(ProjectStructureAgentProjectOverrideEditorModel overrideModel, ProjectStructureAgentCapability capability)
    {
        return (overrideModel.CapabilityMask & capability) == capability;
    }

    private static void ToggleOverrideCapability(ProjectStructureAgentProjectOverrideEditorModel overrideModel, ProjectStructureAgentCapability capability, object? rawValue)
    {
        if (rawValue is bool isEnabled && isEnabled)
        {
            overrideModel.CapabilityMask |= capability;
            return;
        }

        overrideModel.CapabilityMask &= ~capability;
    }

    private void ResetProfileSearch()
    {
        profileSearch = string.Empty;
    }

    private sealed record CapabilityOption(ProjectStructureAgentCapability Capability, string Label, string TestId);
}

@page "/settings"
@using CanDoItAll.ComponentKit.Components
@using CanDoItAll.Modules.Security
@inject WorkspaceService WorkspaceService
@inject SecretService SecretService

<PageTitle>Settings</PageTitle>

<div class="space-y-6">
    <PageHeader Eyebrow="Settings"
                Title="Workspace defaults and providers"
                Description="Configure workspace defaults, encrypted secrets, and provider profiles for OpenAI and Ollama." />

    <div class="grid gap-4 xl:grid-cols-2">
        <SectionCard Title="Workspace defaults" Description="These defaults shape how the rest of the application boots and which provider profile new prompt sessions prefer.">
            <EditForm Model="settingsModel" OnValidSubmit="SaveSettingsAsync">
                <div class="space-y-4">
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700">Workspace name</label>
                        <InputText @bind-Value="settingsModel.WorkspaceName" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700">Default output format</label>
                        <InputText @bind-Value="settingsModel.DefaultPromptOutputFormat" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700">Default provider</label>
                        <InputSelect @bind-Value="settingsModel.DefaultProviderProfileId" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm">
                            <option value="">None</option>
                            @foreach (var provider in providers)
                            {
                                <option value="@provider.Id">@provider.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700">Notes</label>
                        <InputTextArea @bind-Value="settingsModel.Notes" class="min-h-28 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                    </div>

                    <button type="submit" class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white">Save defaults</button>
                    @if (!string.IsNullOrWhiteSpace(settingsMessage))
                    {
                        <p class="text-sm text-emerald-700">@settingsMessage</p>
                    }
                </div>
            </EditForm>
        </SectionCard>

        <SectionCard Title="Secret vault" Description="Secrets are encrypted at rest and referenced by other modules instead of duplicating raw values.">
            <EditForm Model="secretModel" OnValidSubmit="SaveSecretAsync">
                <div class="space-y-4">
                    <div class="grid gap-4 md:grid-cols-2">
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700">Name</label>
                            <InputText @bind-Value="secretModel.Name" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                        </div>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700">Kind</label>
                            <InputSelect @bind-Value="secretModel.Kind" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm">
                                @foreach (var kind in Enum.GetValues<SecretKind>())
                                {
                                    <option value="@kind">@kind</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700">Secret value</label>
                        <InputText @bind-Value="secretModel.SecretValue" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" type="password" />
                    </div>
                    <div class="grid gap-4 md:grid-cols-2">
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700">Scope</label>
                            <InputText @bind-Value="secretModel.Scope" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                        </div>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700">Rotation note</label>
                            <InputText @bind-Value="secretModel.RotationNote" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                        </div>
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700">Metadata JSON</label>
                        <InputTextArea @bind-Value="secretModel.MetadataJson" class="min-h-20 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                    </div>

                    <div class="flex flex-wrap gap-2">
                        <button type="submit" class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white">Save secret</button>
                        <button type="button" class="inline-flex items-center rounded-xl border border-slate-300 bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700" @onclick="ResetSecretAsync">Clear</button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(secretMessage))
                    {
                        <p class="text-sm text-emerald-700">@secretMessage</p>
                    }

                    <div class="space-y-2">
                        @foreach (var secret in secrets)
                        {
                            <button type="button" class="flex w-full items-center justify-between rounded-2xl border border-slate-200 bg-slate-50 px-3 py-3 text-left" @onclick="() => EditSecretAsync(secret.Id)">
                                <span>
                                    <span class="block text-sm font-semibold text-slate-900">@secret.Name</span>
                                    <span class="block text-xs text-slate-500">@secret.Kind • @secret.Scope</span>
                                </span>
                                <span class="text-xs text-slate-500">@secret.UpdatedAtUtc.LocalDateTime:g</span>
                            </button>
                        }
                    </div>
                </div>
            </EditForm>
        </SectionCard>
    </div>

    <SectionCard Title="Provider profiles" Description="Provider profiles stay provider-specific, but the rest of the application only consumes the neutral profile contract.">
        <EditForm Model="providerModel" OnValidSubmit="SaveProviderAsync">
            <div class="grid gap-4 xl:grid-cols-[1.3fr_0.9fr]">
                <div class="space-y-4">
                    <div class="grid gap-4 md:grid-cols-2">
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700">Profile name</label>
                            <InputText @bind-Value="providerModel.Name" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                        </div>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700">Provider kind</label>
                            <InputSelect @bind-Value="providerModel.ProviderKind" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm">
                                @foreach (var kind in Enum.GetValues<ProviderKind>())
                                {
                                    <option value="@kind">@kind</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <div class="grid gap-4 md:grid-cols-2">
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700">Base URL</label>
                            <InputText @bind-Value="providerModel.BaseUrl" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                        </div>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700">Default model</label>
                            <InputText @bind-Value="providerModel.DefaultModel" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                        </div>
                    </div>
                    <div class="grid gap-4 md:grid-cols-2">
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700">API key secret</label>
                            <InputSelect @bind-Value="providerModel.ApiKeySecretId" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm">
                                <option value="">None</option>
                                @foreach (var secret in secrets)
                                {
                                    <option value="@secret.Id">@secret.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700">Timeout (seconds)</label>
                            <InputNumber @bind-Value="providerModel.TimeoutSeconds" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                        </div>
                    </div>
                    <div class="grid gap-3 md:grid-cols-2">
                        <label class="flex items-center gap-2 rounded-xl bg-slate-50 px-3 py-2 text-sm text-slate-700"><InputCheckbox @bind-Value="providerModel.IsEnabled" /> Enabled</label>
                        <label class="flex items-center gap-2 rounded-xl bg-slate-50 px-3 py-2 text-sm text-slate-700"><InputCheckbox @bind-Value="providerModel.SupportsStreaming" /> Streaming</label>
                        <label class="flex items-center gap-2 rounded-xl bg-slate-50 px-3 py-2 text-sm text-slate-700"><InputCheckbox @bind-Value="providerModel.SupportsToolCalling" /> Tool calling</label>
                        <label class="flex items-center gap-2 rounded-xl bg-slate-50 px-3 py-2 text-sm text-slate-700"><InputCheckbox @bind-Value="providerModel.SupportsStructuredOutput" /> Structured output</label>
                        <label class="flex items-center gap-2 rounded-xl bg-slate-50 px-3 py-2 text-sm text-slate-700"><InputCheckbox @bind-Value="providerModel.SupportsVision" /> Vision</label>
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700">Extra settings JSON</label>
                        <InputTextArea @bind-Value="providerModel.ExtraSettingsJson" class="min-h-20 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                    </div>

                    <div class="flex flex-wrap gap-2">
                        <button type="submit" class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white">Save provider</button>
                        <button type="button" class="inline-flex items-center rounded-xl border border-slate-300 bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700" @onclick="ResetProviderAsync">Clear</button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(providerMessage))
                    {
                        <p class="text-sm text-emerald-700">@providerMessage</p>
                    }
                </div>

                <div class="space-y-3">
                    @foreach (var provider in providers)
                    {
                        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                            <div class="flex items-start justify-between gap-3">
                                <div>
                                    <p class="text-sm font-semibold text-slate-900">@provider.Name</p>
                                    <p class="text-xs text-slate-500">@provider.ProviderKind • @provider.DefaultModel</p>
                                </div>
                                <StatusBadge Tone="@(provider.IsEnabled ? "success" : "warning")" Text="@(provider.IsEnabled ? "Enabled" : "Disabled")" />
                            </div>
                            <p class="mt-3 break-all text-xs text-slate-600">@provider.BaseUrl</p>
                            <p class="mt-2 text-xs text-slate-500">@provider.LastHealthStatus</p>
                            <div class="mt-3 flex flex-wrap gap-2">
                                <button type="button" class="inline-flex items-center rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700" @onclick="() => EditProviderAsync(provider.Id)">Edit</button>
                                <button type="button" class="inline-flex items-center rounded-xl border border-sky-300 bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-700" @onclick="() => TestProviderAsync(provider.Id)">Health</button>
                                <button type="button" class="inline-flex items-center rounded-xl border border-rose-300 bg-rose-50 px-3 py-1.5 text-xs font-semibold text-rose-700" @onclick="() => DeleteProviderAsync(provider.Id)">Delete</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </EditForm>
    </SectionCard>
</div>

@code {
    private WorkspaceSettingsModel settingsModel = new();
    private SecretEditorModel secretModel = new()
    {
        Kind = SecretKind.ApiKey
    };
    private ProviderProfileEditorModel providerModel = new()
    {
        ProviderKind = ProviderKind.OpenAi,
        BaseUrl = "https://api.openai.com/v1/models",
        DefaultModel = "gpt-4.1",
        TimeoutSeconds = 45,
        IsEnabled = true,
        SupportsStreaming = true,
        SupportsToolCalling = true,
        SupportsStructuredOutput = true
    };
    private IReadOnlyList<ProviderProfileSummary> providers = [];
    private IReadOnlyList<SecretListItem> secrets = [];
    private string? settingsMessage;
    private string? secretMessage;
    private string? providerMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        settingsModel = await WorkspaceService.GetSettingsAsync();
        providers = await WorkspaceService.ListProviderProfilesAsync();
        secrets = await WorkspaceService.ListSecretsAsync();
    }

    private async Task SaveSettingsAsync()
    {
        await WorkspaceService.SaveSettingsAsync(settingsModel);
        settingsMessage = "Workspace defaults saved.";
        providers = await WorkspaceService.ListProviderProfilesAsync();
    }

    private async Task SaveSecretAsync()
    {
        var result = await SecretService.SaveAsync(secretModel);
        secretMessage = result.IsSuccess ? "Secret saved." : string.Join(" ", result.Errors.Select(error => error.Message));
        if (result.IsSuccess)
        {
            await ResetSecretAsync();
            secrets = await WorkspaceService.ListSecretsAsync();
        }
    }

    private async Task EditSecretAsync(Guid id)
    {
        var model = await SecretService.GetAsync(id);
        if (model is not null)
        {
            secretModel = model;
        }
    }

    private Task ResetSecretAsync()
    {
        secretModel = new SecretEditorModel
        {
            Kind = SecretKind.ApiKey
        };
        return Task.CompletedTask;
    }

    private async Task SaveProviderAsync()
    {
        var result = await WorkspaceService.SaveProviderAsync(providerModel);
        providerMessage = result.IsSuccess ? "Provider profile saved." : string.Join(" ", result.Errors.Select(error => error.Message));
        if (result.IsSuccess)
        {
            providers = await WorkspaceService.ListProviderProfilesAsync();
            await ResetProviderAsync();
        }
    }

    private async Task EditProviderAsync(Guid id)
    {
        providerModel = await WorkspaceService.GetProviderAsync(id);
    }

    private async Task TestProviderAsync(Guid id)
    {
        var result = await WorkspaceService.TestProviderAsync(id);
        providerMessage = result.Message;
        providers = await WorkspaceService.ListProviderProfilesAsync();
    }

    private async Task DeleteProviderAsync(Guid id)
    {
        await WorkspaceService.DeleteProviderAsync(id);
        providers = await WorkspaceService.ListProviderProfilesAsync();
        providerMessage = "Provider profile deleted.";
    }

    private Task ResetProviderAsync()
    {
        providerModel = new ProviderProfileEditorModel
        {
            ProviderKind = ProviderKind.OpenAi,
            BaseUrl = "https://api.openai.com/v1/models",
            DefaultModel = "gpt-4.1",
            TimeoutSeconds = 45,
            IsEnabled = true,
            SupportsStreaming = true,
            SupportsToolCalling = true,
            SupportsStructuredOutput = true
        };
        return Task.CompletedTask;
    }
}

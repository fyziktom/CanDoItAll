@page "/settings"
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Modules.Security
@using CanDoItAll.Modules.Workspace.Pages.Components
@using Microsoft.AspNetCore.Components
@inject WorkspaceService WorkspaceService
@inject SecretService SecretService
@inject NavigationManager Navigation

<PageTitle>Settings</PageTitle>

<PageScaffold>
    <Header>
        <PageHeader Eyebrow="Settings"
                    Title="Workspace defaults, data sources, and providers"
                    Description="Manage workspace defaults, runtime data sources, encrypted secrets, and provider profiles as separate jobs instead of one long settings page." />
    </Header>

    <Lead>
        <SummaryTiles>
            <SummaryTile Label="Providers" Value="@providers.Count.ToString()" HelperText="Configured provider profiles." />
            <SummaryTile Label="Enabled" Value="@providers.Count(item => item.IsEnabled).ToString()" HelperText="Profiles currently enabled." Tone="success" />
            <SummaryTile Label="Secrets" Value="@secrets.Count.ToString()" HelperText="Stored encrypted secrets." />
        </SummaryTiles>

        <SecondaryTabs Items="SettingsTabs" SelectedKey="@settingsTab" SelectedKeyChanged="HandleSettingsTabChanged" />
    </Lead>

    <ChildContent>
        @if (string.Equals(settingsTab, "workspace", StringComparison.Ordinal))
        {
            <EditForm Model="settingsModel" OnValidSubmit="SaveSettingsAsync">
                <Stack Class="min-h-full" GapScale="LayoutGap.XXLarge">
                    <FormSection Title="Workspace defaults" Description="These values define how the rest of the app boots and which provider profile new prompt sessions prefer.">
                        <div>
                            <label class="cda-field-label">Workspace name</label>
                            <InputText @bind-Value="settingsModel.WorkspaceName" class="cda-input" />
                        </div>
                        <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                            <div>
                                <label class="cda-field-label">Default output format</label>
                                <InputText @bind-Value="settingsModel.DefaultPromptOutputFormat" class="cda-input" />
                            </div>
                            <div>
                                <label class="cda-field-label">Default provider</label>
                                <InputSelect @bind-Value="settingsModel.DefaultProviderProfileId" class="cda-input">
                                    <option value="">None</option>
                                    @foreach (var provider in providers)
                                    {
                                        <option value="@provider.Id">@provider.Name</option>
                                    }
                                </InputSelect>
                            </div>
                        </Grid>
                    </FormSection>

                    <FormSection Title="Workspace notes" Description="Keep any operating notes or setup caveats close to the defaults.">
                        <div>
                            <label class="cda-field-label">Notes</label>
                            <InputTextArea @bind-Value="settingsModel.Notes" class="cda-input cda-input--textarea min-h-32" />
                        </div>
                    </FormSection>

                    <StickyActionFooter StatusLabel="Workspace defaults" StatusMessage="@settingsMessage" StatusTone="success">
                        <PrimaryActions>
                            <Button Text="Save defaults" Type="submit" />
                        </PrimaryActions>
                    </StickyActionFooter>
                </Stack>
            </EditForm>
        }
        else if (string.Equals(settingsTab, "data-sources", StringComparison.Ordinal))
        {
            <DatabaseSourcesSettingsPanel />
        }
        else if (string.Equals(settingsTab, "storage", StringComparison.Ordinal))
        {
            <StorageSettingsPanel />
        }
        else if (string.Equals(settingsTab, "secrets", StringComparison.Ordinal))
        {
            <ListDetailShell ListPaneWidth="24rem">
                <ListHeader>
                    <ListPanelHeader Title="Secret vault" Description="Encrypted secrets are stored once and referenced from other modules." Count="@($"{FilteredSecrets.Count} secret(s)")">
                        <Actions>
                            <Button Text="New secret" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="ResetSecretAsync" />
                        </Actions>
                        <Filters>
                            <FilterBar ResultText="@($"{FilteredSecrets.Count} matching secret(s)")">
                                <input @bind="secretSearch" @bind:event="oninput" class="cda-input min-w-[14rem] flex-1" placeholder="Search secrets" />
                                <Button Text="Reset" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="ResetSecretSearch" />
                            </FilterBar>
                        </Filters>
                    </ListPanelHeader>
                </ListHeader>

                <ListContent>
                    @if (FilteredSecrets.Count == 0)
                    {
                        <EmptyState Eyebrow="No secrets" Title="Add the first secret" Description="Secrets appear here after they are saved through the vault editor." />
                    }
                    else
                    {
                        <Stack GapScale="LayoutGap.Medium">
                            @foreach (var secret in FilteredSecrets)
                            {
                                <SelectionListItem Title="@secret.Name"
                                                   Eyebrow="@secret.Kind.ToString()"
                                                   Meta="@secret.Scope"
                                                   Summary="@FormatTimestamp(secret.UpdatedAtUtc)"
                                                   IsSelected="@(secretModel.Id == secret.Id)"
                                                   OnSelect="@(() => EditSecretAsync(secret.Id))">
                                    <Status>
                                        <StatusBadge Tone="info" Text="@secret.Kind.ToString()" />
                                    </Status>
                                </SelectionListItem>
                            }
                        </Stack>
                    }
                </ListContent>

                <DetailHeader>
                    <Stack GapScale="LayoutGap.Tiny">
                        <p class="cda-eyebrow">Secret editor</p>
                        <h2 class="cda-title-xl">@(secretModel.Id.HasValue ? secretModel.Name : "New secret")</h2>
                        <p class="cda-body-muted">Secrets stay encrypted at rest and can be referenced from providers, resources, or other modules.</p>
                    </Stack>
                </DetailHeader>

                <DetailContent>
                    <EditForm Model="secretModel" OnValidSubmit="SaveSecretAsync">
                        <Stack Class="min-h-full" GapScale="LayoutGap.XXLarge">
                            <FormSection Title="Secret metadata" Description="Name the secret clearly and capture its usage scope.">
                                <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                    <div>
                                        <label class="cda-field-label">Name</label>
                                        <InputText @bind-Value="secretModel.Name" class="cda-input" />
                                    </div>
                                    <div>
                                        <label class="cda-field-label">Kind</label>
                                        <InputSelect @bind-Value="secretModel.Kind" class="cda-input">
                                            @foreach (var kind in Enum.GetValues<SecretKind>())
                                            {
                                                <option value="@kind">@kind</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </Grid>
                                <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                    <div>
                                        <label class="cda-field-label">Scope</label>
                                        <InputText @bind-Value="secretModel.Scope" class="cda-input" />
                                    </div>
                                    <div>
                                        <label class="cda-field-label">Rotation note</label>
                                        <InputText @bind-Value="secretModel.RotationNote" class="cda-input" />
                                    </div>
                                </Grid>
                            </FormSection>

                            <FormSection Title="Encrypted payload" Description="The raw value is only edited here, while other areas consume references to the saved record.">
                                <div>
                                    <label class="cda-field-label">Secret value</label>
                                    <InputText @bind-Value="secretModel.SecretValue" class="cda-input" type="password" />
                                </div>
                                <div>
                                    <label class="cda-field-label">Metadata JSON</label>
                                    <InputTextArea @bind-Value="secretModel.MetadataJson" class="cda-input cda-input--textarea min-h-24" />
                                </div>
                            </FormSection>

                            <StickyActionFooter StatusLabel="Secret vault" StatusMessage="@secretMessage" StatusTone="success">
                                <SecondaryActions>
                                    <Button Text="Clear" ButtonStyle="ButtonStyle.Light" Click="ResetSecretAsync" />
                                </SecondaryActions>
                                <PrimaryActions>
                                    <Button Text="Save secret" Type="submit" />
                                </PrimaryActions>
                                <DangerActions>
                                    @if (secretModel.Id.HasValue)
                                    {
                                        <Button Text="Delete" ButtonStyle="ButtonStyle.Danger" Click="DeleteSecretAsync" />
                                    }
                                </DangerActions>
                            </StickyActionFooter>
                        </Stack>
                    </EditForm>
                </DetailContent>
            </ListDetailShell>
        }
        else if (string.Equals(settingsTab, "providers", StringComparison.Ordinal))
        {
            <ListDetailShell ListPaneWidth="25rem">
                <ListHeader>
                    <ListPanelHeader Title="Provider profiles" Description="Provider-specific settings live here, while the rest of the product consumes the neutral provider contract." Count="@($"{FilteredProviders.Count} profile(s)")">
                        <Actions>
                            <Button Text="New provider" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="ResetProviderAsync" />
                        </Actions>
                        <Filters>
                            <FilterBar ResultText="@($"{FilteredProviders.Count} matching profile(s)")">
                                <input @bind="providerSearch" @bind:event="oninput" class="cda-input min-w-[14rem] flex-1" placeholder="Search providers" />
                                <Button Text="Reset" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="ResetProviderSearch" />
                            </FilterBar>
                        </Filters>
                    </ListPanelHeader>
                </ListHeader>

                <ListContent>
                    @if (FilteredProviders.Count == 0)
                    {
                        <EmptyState Eyebrow="No providers" Title="Add the first provider profile" Description="Provider profiles appear here after they are saved." />
                    }
                    else
                    {
                        <Stack GapScale="LayoutGap.Medium">
                            @foreach (var provider in FilteredProviders)
                            {
                                <SelectionListItem Title="@provider.Name"
                                                   Eyebrow="@provider.ConnectorDisplayName"
                                                   Meta="@provider.DefaultModel"
                                                   Summary="@provider.BaseUrl"
                                                   IsSelected="@(providerModel.Id == provider.Id)"
                                                   OnSelect="@(() => EditProviderAsync(provider.Id))">
                                    <Status>
                                        <StatusBadge Tone="@(provider.IsEnabled ? "success" : "warning")" Text="@(provider.IsEnabled ? "Enabled" : "Disabled")" />
                                    </Status>
                                </SelectionListItem>
                            }
                        </Stack>
                    }
                </ListContent>

                <DetailHeader>
                    <Stack GapScale="LayoutGap.Tiny">
                        <p class="cda-eyebrow">Provider editor</p>
                        <h2 class="cda-title-xl">@(providerModel.Id.HasValue ? providerModel.Name : "New provider profile")</h2>
                        <p class="cda-body-muted">Profiles keep connector transport, capability flags, and health status in one editor.</p>
                    </Stack>
                </DetailHeader>

                <DetailContent>
                    <EditForm Model="providerModel" OnValidSubmit="SaveProviderAsync">
                        <Stack Class="min-h-full" GapScale="LayoutGap.XXLarge">
                            <FormSection Title="Connector identity" Description="Choose the connector plugin first, then fill only the schema fields that plugin exposes.">
                                <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                    <div>
                                        <label class="cda-field-label">Profile name</label>
                                        <InputText @bind-Value="providerModel.Name" class="cda-input" data-testid="provider-name-input" />
                                    </div>
                                    <div>
                                        <label class="cda-field-label">Connector plugin</label>
                                        <InputSelect @bind-Value="providerModel.ConnectorPluginKey" @bind-Value:after="HandleProviderPluginChangedAsync" class="cda-input" data-testid="provider-plugin-select">
                                            @foreach (var manifest in providerManifests)
                                            {
                                                <option value="@manifest.PluginKey">@manifest.DisplayName</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </Grid>

                                @if (SelectedProviderManifest is not null)
                                {
                                    <Alert AlertStyle="AlertStyle.Info">
                                        <p class="font-semibold">@SelectedProviderManifest.DisplayName</p>
                                        <p class="mt-1 break-all">Plugin key: @SelectedProviderManifest.PluginKey</p>
                                        <p class="mt-1">@SelectedProviderManifest.HealthCheck.Summary</p>
                                    </Alert>
                                }

                                <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                    @foreach (var field in SelectedProviderFields)
                                    {
                                        <ConnectorConfigFieldEditor Field="field"
                                                                    State="providerModel.Configuration"
                                                                    InputClass="cda-input"
                                                                    TestId="@ResolveProviderFieldTestId(field)" />
                                    }
                                </Grid>
                            </FormSection>

                            <FormSection Title="Auth and capabilities" Description="Attach the secret reference and advertise what the profile supports.">
                                <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                    <div>
                                        <label class="cda-field-label">API key secret</label>
                                        <InputSelect @bind-Value="providerModel.ApiKeySecretId" class="cda-input" data-testid="provider-secret-select">
                                            <option value="">None</option>
                                            @foreach (var secret in secrets)
                                            {
                                                <option value="@secret.Id">@secret.Name</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </Grid>

                                <Grid Gap="LayoutGap.Medium" ColumnsMd="2">
                                    <label class="cda-inline-option"><InputCheckbox @bind-Value="providerModel.IsEnabled" /> Enabled</label>
                                    <label class="cda-inline-option"><InputCheckbox @bind-Value="providerModel.SupportsStreaming" /> Streaming</label>
                                    <label class="cda-inline-option"><InputCheckbox @bind-Value="providerModel.SupportsToolCalling" /> Tool calling</label>
                                    <label class="cda-inline-option"><InputCheckbox @bind-Value="providerModel.SupportsStructuredOutput" /> Structured output</label>
                                    <label class="cda-inline-option"><InputCheckbox @bind-Value="providerModel.SupportsVision" /> Vision</label>
                                </Grid>
                            </FormSection>

                            <StickyActionFooter StatusLabel="Provider profiles" StatusMessage="@providerMessage" StatusTone="success">
                                <SecondaryActions>
                                    <Button Text="Clear" ButtonStyle="ButtonStyle.Light" Click="ResetProviderAsync" />
                                    @if (providerModel.Id.HasValue)
                                    {
                                        <Button Text="Health" ButtonStyle="ButtonStyle.Info" Click="@(() => TestProviderAsync(providerModel.Id.Value))" />
                                    }
                                </SecondaryActions>
                                <PrimaryActions>
                                    <Button Text="Save provider" Type="submit" data-testid="provider-save-button" />
                                </PrimaryActions>
                                <DangerActions>
                                    @if (providerModel.Id.HasValue)
                                    {
                                        <Button Text="Delete" ButtonStyle="ButtonStyle.Danger" Click="@(() => DeleteProviderAsync(providerModel.Id.Value))" />
                                    }
                                </DangerActions>
                            </StickyActionFooter>
                        </Stack>
                    </EditForm>
                </DetailContent>
            </ListDetailShell>
        }
        else
        {
            <ProjectStructureAgentSettingsPanel />
        }
    </ChildContent>
</PageScaffold>




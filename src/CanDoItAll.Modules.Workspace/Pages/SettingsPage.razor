@page "/settings"
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Modules.Security
@inject WorkspaceService WorkspaceService
@inject SecretService SecretService

<PageTitle>Settings</PageTitle>

<PageScaffold>
    <Header>
        <PageHeader Eyebrow="Settings"
                    Title="Workspace defaults and providers"
                    Description="Manage workspace defaults, encrypted secrets, and provider profiles as three separate jobs instead of one long settings page." />
    </Header>

    <Lead>
        <SummaryTiles>
            <SummaryTile Label="Providers" Value="@providers.Count.ToString()" HelperText="Configured provider profiles." />
            <SummaryTile Label="Enabled" Value="@providers.Count(item => item.IsEnabled).ToString()" HelperText="Profiles currently enabled." Tone="success" />
            <SummaryTile Label="Secrets" Value="@secrets.Count.ToString()" HelperText="Stored encrypted secrets." />
            <SummaryTile Label="Default provider" Value="@DefaultProviderLabel" HelperText="Workspace default for new prompt sessions." Tone="info" />
        </SummaryTiles>

        <SecondaryTabs Items="SettingsTabs" SelectedKey="@settingsTab" SelectedKeyChanged="HandleSettingsTabChanged" />
    </Lead>

    <ChildContent>
        @if (string.Equals(settingsTab, "workspace", StringComparison.Ordinal))
        {
            <EditForm Model="settingsModel" OnValidSubmit="SaveSettingsAsync">
                <div class="flex min-h-full flex-col gap-6">
                    <FormSection Title="Workspace defaults" Description="These values define how the rest of the app boots and which provider profile new prompt sessions prefer.">
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700">Workspace name</label>
                            <InputText @bind-Value="settingsModel.WorkspaceName" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                        </div>
                        <div class="grid gap-4 md:grid-cols-2">
                            <div>
                                <label class="mb-1 block text-sm font-medium text-slate-700">Default output format</label>
                                <InputText @bind-Value="settingsModel.DefaultPromptOutputFormat" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                            </div>
                            <div>
                                <label class="mb-1 block text-sm font-medium text-slate-700">Default provider</label>
                                <InputSelect @bind-Value="settingsModel.DefaultProviderProfileId" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm">
                                    <option value="">None</option>
                                    @foreach (var provider in providers)
                                    {
                                        <option value="@provider.Id">@provider.Name</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                    </FormSection>

                    <FormSection Title="Workspace notes" Description="Keep any operating notes or setup caveats close to the defaults.">
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700">Notes</label>
                            <InputTextArea @bind-Value="settingsModel.Notes" class="min-h-32 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                        </div>
                    </FormSection>

                    <StickyActionFooter StatusLabel="Workspace defaults" StatusMessage="@settingsMessage" StatusTone="success">
                        <PrimaryActions>
                            <button type="submit" class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white">Save defaults</button>
                        </PrimaryActions>
                    </StickyActionFooter>
                </div>
            </EditForm>
        }
        else if (string.Equals(settingsTab, "secrets", StringComparison.Ordinal))
        {
            <ListDetailShell ListPaneWidth="24rem">
                <ListHeader>
                    <ListPanelHeader Title="Secret vault" Description="Encrypted secrets are stored once and referenced from other modules." Count="@($"{FilteredSecrets.Count} secret(s)")">
                        <Actions>
                            <button type="button" class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700" @onclick="ResetSecretAsync">New secret</button>
                        </Actions>
                        <Filters>
                            <FilterBar ResultText="@($"{FilteredSecrets.Count} matching secret(s)")">
                                <input @bind="secretSearch" @bind:event="oninput" class="min-w-[14rem] flex-1 rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700" placeholder="Search secrets" />
                                <button type="button" class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700" @onclick="ResetSecretSearch">Reset</button>
                            </FilterBar>
                        </Filters>
                    </ListPanelHeader>
                </ListHeader>

                <ListContent>
                    @if (FilteredSecrets.Count == 0)
                    {
                        <EmptyState Eyebrow="No secrets" Title="Add the first secret" Description="Secrets appear here after they are saved through the vault editor." />
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var secret in FilteredSecrets)
                            {
                                <SelectionListItem Title="@secret.Name"
                                                   Eyebrow="@secret.Kind.ToString()"
                                                   Meta="@secret.Scope"
                                                   Summary="@FormatTimestamp(secret.UpdatedAtUtc)"
                                                   IsSelected="@(secretModel.Id == secret.Id)"
                                                   OnSelect="@(() => EditSecretAsync(secret.Id))">
                                    <Status>
                                        <StatusBadge Tone="info" Text="@secret.Kind.ToString()" />
                                    </Status>
                                </SelectionListItem>
                            }
                        </div>
                    }
                </ListContent>

                <DetailHeader>
                    <div class="space-y-1">
                        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Secret editor</p>
                        <h2 class="text-xl font-semibold text-slate-950">@(secretModel.Id.HasValue ? secretModel.Name : "New secret")</h2>
                        <p class="text-sm leading-6 text-slate-600">Secrets stay encrypted at rest and can be referenced from providers, resources, or other modules.</p>
                    </div>
                </DetailHeader>

                <DetailContent>
                    <EditForm Model="secretModel" OnValidSubmit="SaveSecretAsync">
                        <div class="flex min-h-full flex-col gap-6">
                            <FormSection Title="Secret metadata" Description="Name the secret clearly and capture its usage scope.">
                                <div class="grid gap-4 md:grid-cols-2">
                                    <div>
                                        <label class="mb-1 block text-sm font-medium text-slate-700">Name</label>
                                        <InputText @bind-Value="secretModel.Name" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                                    </div>
                                    <div>
                                        <label class="mb-1 block text-sm font-medium text-slate-700">Kind</label>
                                        <InputSelect @bind-Value="secretModel.Kind" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm">
                                            @foreach (var kind in Enum.GetValues<SecretKind>())
                                            {
                                                <option value="@kind">@kind</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </div>
                                <div class="grid gap-4 md:grid-cols-2">
                                    <div>
                                        <label class="mb-1 block text-sm font-medium text-slate-700">Scope</label>
                                        <InputText @bind-Value="secretModel.Scope" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                                    </div>
                                    <div>
                                        <label class="mb-1 block text-sm font-medium text-slate-700">Rotation note</label>
                                        <InputText @bind-Value="secretModel.RotationNote" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                                    </div>
                                </div>
                            </FormSection>

                            <FormSection Title="Encrypted payload" Description="The raw value is only edited here, while other areas consume references to the saved record.">
                                <div>
                                    <label class="mb-1 block text-sm font-medium text-slate-700">Secret value</label>
                                    <InputText @bind-Value="secretModel.SecretValue" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" type="password" />
                                </div>
                                <div>
                                    <label class="mb-1 block text-sm font-medium text-slate-700">Metadata JSON</label>
                                    <InputTextArea @bind-Value="secretModel.MetadataJson" class="min-h-24 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                                </div>
                            </FormSection>

                            <StickyActionFooter StatusLabel="Secret vault" StatusMessage="@secretMessage" StatusTone="success">
                                <SecondaryActions>
                                    <button type="button" class="rounded-xl border border-slate-300 bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700" @onclick="ResetSecretAsync">Clear</button>
                                </SecondaryActions>
                                <PrimaryActions>
                                    <button type="submit" class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white">Save secret</button>
                                </PrimaryActions>
                                <DangerActions>
                                    @if (secretModel.Id.HasValue)
                                    {
                                        <button type="button" class="inline-flex items-center rounded-xl border border-rose-300 bg-rose-50 px-4 py-2 text-sm font-semibold text-rose-700" @onclick="DeleteSecretAsync">Delete</button>
                                    }
                                </DangerActions>
                            </StickyActionFooter>
                        </div>
                    </EditForm>
                </DetailContent>
            </ListDetailShell>
        }
        else
        {
            <ListDetailShell ListPaneWidth="25rem">
                <ListHeader>
                    <ListPanelHeader Title="Provider profiles" Description="Provider-specific settings live here, while the rest of the product consumes the neutral provider contract." Count="@($"{FilteredProviders.Count} profile(s)")">
                        <Actions>
                            <button type="button" class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700" @onclick="ResetProviderAsync">New provider</button>
                        </Actions>
                        <Filters>
                            <FilterBar ResultText="@($"{FilteredProviders.Count} matching profile(s)")">
                                <input @bind="providerSearch" @bind:event="oninput" class="min-w-[14rem] flex-1 rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700" placeholder="Search providers" />
                                <button type="button" class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700" @onclick="ResetProviderSearch">Reset</button>
                            </FilterBar>
                        </Filters>
                    </ListPanelHeader>
                </ListHeader>

                <ListContent>
                    @if (FilteredProviders.Count == 0)
                    {
                        <EmptyState Eyebrow="No providers" Title="Add the first provider profile" Description="Provider profiles appear here after they are saved." />
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var provider in FilteredProviders)
                            {
                                <SelectionListItem Title="@provider.Name"
                                                   Eyebrow="@provider.ProviderKind.ToString()"
                                                   Meta="@provider.DefaultModel"
                                                   Summary="@provider.BaseUrl"
                                                   IsSelected="@(providerModel.Id == provider.Id)"
                                                   OnSelect="@(() => EditProviderAsync(provider.Id))">
                                    <Status>
                                        <StatusBadge Tone="@(provider.IsEnabled ? "success" : "warning")" Text="@(provider.IsEnabled ? "Enabled" : "Disabled")" />
                                    </Status>
                                </SelectionListItem>
                            }
                        </div>
                    }
                </ListContent>

                <DetailHeader>
                    <div class="space-y-1">
                        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Provider editor</p>
                        <h2 class="text-xl font-semibold text-slate-950">@(providerModel.Id.HasValue ? providerModel.Name : "New provider profile")</h2>
                        <p class="text-sm leading-6 text-slate-600">Profiles keep provider-specific transport, capability flags, and health status in one editor.</p>
                    </div>
                </DetailHeader>

                <DetailContent>
                    <EditForm Model="providerModel" OnValidSubmit="SaveProviderAsync">
                        <div class="flex min-h-full flex-col gap-6">
                            <FormSection Title="Provider identity" Description="Define the provider kind, transport endpoint, and default model.">
                                <div class="grid gap-4 md:grid-cols-2">
                                    <div>
                                        <label class="mb-1 block text-sm font-medium text-slate-700">Profile name</label>
                                        <InputText @bind-Value="providerModel.Name" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                                    </div>
                                    <div>
                                        <label class="mb-1 block text-sm font-medium text-slate-700">Provider kind</label>
                                        <InputSelect @bind-Value="providerModel.ProviderKind" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm">
                                            @foreach (var kind in Enum.GetValues<ProviderKind>())
                                            {
                                                <option value="@kind">@kind</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </div>
                                <div class="grid gap-4 md:grid-cols-2">
                                    <div>
                                        <label class="mb-1 block text-sm font-medium text-slate-700">Base URL</label>
                                        <InputText @bind-Value="providerModel.BaseUrl" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                                    </div>
                                    <div>
                                        <label class="mb-1 block text-sm font-medium text-slate-700">Default model</label>
                                        <InputText @bind-Value="providerModel.DefaultModel" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                                    </div>
                                </div>
                            </FormSection>

                            <FormSection Title="Auth and capabilities" Description="Attach the secret reference and advertise what the profile supports.">
                                <div class="grid gap-4 md:grid-cols-2">
                                    <div>
                                        <label class="mb-1 block text-sm font-medium text-slate-700">API key secret</label>
                                        <InputSelect @bind-Value="providerModel.ApiKeySecretId" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm">
                                            <option value="">None</option>
                                            @foreach (var secret in secrets)
                                            {
                                                <option value="@secret.Id">@secret.Name</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <div>
                                        <label class="mb-1 block text-sm font-medium text-slate-700">Timeout (seconds)</label>
                                        <InputNumber @bind-Value="providerModel.TimeoutSeconds" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                                    </div>
                                </div>

                                <div class="grid gap-3 md:grid-cols-2">
                                    <label class="flex items-center gap-2 rounded-xl bg-white px-3 py-2 text-sm text-slate-700"><InputCheckbox @bind-Value="providerModel.IsEnabled" /> Enabled</label>
                                    <label class="flex items-center gap-2 rounded-xl bg-white px-3 py-2 text-sm text-slate-700"><InputCheckbox @bind-Value="providerModel.SupportsStreaming" /> Streaming</label>
                                    <label class="flex items-center gap-2 rounded-xl bg-white px-3 py-2 text-sm text-slate-700"><InputCheckbox @bind-Value="providerModel.SupportsToolCalling" /> Tool calling</label>
                                    <label class="flex items-center gap-2 rounded-xl bg-white px-3 py-2 text-sm text-slate-700"><InputCheckbox @bind-Value="providerModel.SupportsStructuredOutput" /> Structured output</label>
                                    <label class="flex items-center gap-2 rounded-xl bg-white px-3 py-2 text-sm text-slate-700"><InputCheckbox @bind-Value="providerModel.SupportsVision" /> Vision</label>
                                </div>

                                <div>
                                    <label class="mb-1 block text-sm font-medium text-slate-700">Extra settings JSON</label>
                                    <InputTextArea @bind-Value="providerModel.ExtraSettingsJson" class="min-h-24 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                                </div>
                            </FormSection>

                            <StickyActionFooter StatusLabel="Provider profiles" StatusMessage="@providerMessage" StatusTone="success">
                                <SecondaryActions>
                                    <button type="button" class="rounded-xl border border-slate-300 bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700" @onclick="ResetProviderAsync">Clear</button>
                                    @if (providerModel.Id.HasValue)
                                    {
                                        <button type="button" class="rounded-xl border border-sky-300 bg-sky-50 px-4 py-2 text-sm font-semibold text-sky-700" @onclick="@(() => TestProviderAsync(providerModel.Id.Value))">Health</button>
                                    }
                                </SecondaryActions>
                                <PrimaryActions>
                                    <button type="submit" class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white">Save provider</button>
                                </PrimaryActions>
                                <DangerActions>
                                    @if (providerModel.Id.HasValue)
                                    {
                                        <button type="button" class="inline-flex items-center rounded-xl border border-rose-300 bg-rose-50 px-4 py-2 text-sm font-semibold text-rose-700" @onclick="@(() => DeleteProviderAsync(providerModel.Id.Value))">Delete</button>
                                    }
                                </DangerActions>
                            </StickyActionFooter>
                        </div>
                    </EditForm>
                </DetailContent>
            </ListDetailShell>
        }
    </ChildContent>
</PageScaffold>

@code {
    private WorkspaceSettingsModel settingsModel = new();
    private SecretEditorModel secretModel = NewSecret();
    private ProviderProfileEditorModel providerModel = NewProvider();
    private IReadOnlyList<ProviderProfileSummary> providers = [];
    private IReadOnlyList<SecretListItem> secrets = [];
    private string? settingsMessage;
    private string? secretMessage;
    private string? providerMessage;
    private string settingsTab = "workspace";
    private string secretSearch = string.Empty;
    private string providerSearch = string.Empty;

    private IReadOnlyList<SecondaryTabItem> SettingsTabs =>
    [
        new("workspace", "Workspace"),
        new("secrets", "Secrets", secrets.Count.ToString()),
        new("providers", "Providers", providers.Count.ToString())
    ];

    private IReadOnlyList<SecretListItem> FilteredSecrets => secrets
        .Where(secret =>
            string.IsNullOrWhiteSpace(secretSearch) ||
            secret.Name.Contains(secretSearch, StringComparison.OrdinalIgnoreCase) ||
            secret.Scope.Contains(secretSearch, StringComparison.OrdinalIgnoreCase))
        .OrderBy(secret => secret.Name)
        .ToList();

    private IReadOnlyList<ProviderProfileSummary> FilteredProviders => providers
        .Where(provider =>
            string.IsNullOrWhiteSpace(providerSearch) ||
            provider.Name.Contains(providerSearch, StringComparison.OrdinalIgnoreCase) ||
            provider.DefaultModel.Contains(providerSearch, StringComparison.OrdinalIgnoreCase) ||
            provider.BaseUrl.Contains(providerSearch, StringComparison.OrdinalIgnoreCase))
        .OrderBy(provider => provider.Name)
        .ToList();

    private string DefaultProviderLabel => providers.FirstOrDefault(provider => provider.Id == settingsModel.DefaultProviderProfileId)?.Name ?? "None";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        settingsModel = await WorkspaceService.GetSettingsAsync();
        providers = await WorkspaceService.ListProviderProfilesAsync();
        secrets = await WorkspaceService.ListSecretsAsync();
    }

    private async Task SaveSettingsAsync()
    {
        await WorkspaceService.SaveSettingsAsync(settingsModel);
        settingsMessage = "Workspace defaults saved.";
        providers = await WorkspaceService.ListProviderProfilesAsync();
    }

    private async Task SaveSecretAsync()
    {
        var result = await SecretService.SaveAsync(secretModel);
        secretMessage = result.IsSuccess ? "Secret saved." : string.Join(" ", result.Errors.Select(error => error.Message));
        if (result.IsSuccess)
        {
            secrets = await WorkspaceService.ListSecretsAsync();
            await ResetSecretAsync();
        }
    }

    private async Task EditSecretAsync(Guid id)
    {
        var model = await SecretService.GetAsync(id);
        if (model is not null)
        {
            secretModel = model;
        }
    }

    private async Task DeleteSecretAsync()
    {
        if (!secretModel.Id.HasValue)
        {
            return;
        }

        await SecretService.DeleteAsync(secretModel.Id.Value);
        secrets = await WorkspaceService.ListSecretsAsync();
        secretMessage = "Secret deleted.";
        await ResetSecretAsync();
    }

    private Task ResetSecretAsync()
    {
        secretModel = NewSecret();
        return Task.CompletedTask;
    }

    private async Task SaveProviderAsync()
    {
        var result = await WorkspaceService.SaveProviderAsync(providerModel);
        providerMessage = result.IsSuccess ? "Provider profile saved." : string.Join(" ", result.Errors.Select(error => error.Message));
        if (result.IsSuccess)
        {
            providers = await WorkspaceService.ListProviderProfilesAsync();
            await ResetProviderAsync();
        }
    }

    private async Task EditProviderAsync(Guid id)
    {
        providerModel = await WorkspaceService.GetProviderAsync(id);
    }

    private async Task TestProviderAsync(Guid id)
    {
        var result = await WorkspaceService.TestProviderAsync(id);
        providerMessage = result.Message;
        providers = await WorkspaceService.ListProviderProfilesAsync();
    }

    private async Task DeleteProviderAsync(Guid id)
    {
        await WorkspaceService.DeleteProviderAsync(id);
        providers = await WorkspaceService.ListProviderProfilesAsync();
        providerMessage = "Provider profile deleted.";
        await ResetProviderAsync();
    }

    private Task ResetProviderAsync()
    {
        providerModel = NewProvider();
        return Task.CompletedTask;
    }

    private Task HandleSettingsTabChanged(string key)
    {
        settingsTab = key;
        return Task.CompletedTask;
    }

    private void ResetSecretSearch() => secretSearch = string.Empty;

    private void ResetProviderSearch() => providerSearch = string.Empty;

    private static string FormatTimestamp(DateTimeOffset timestamp) => timestamp.LocalDateTime.ToString("g");

    private static SecretEditorModel NewSecret() => new()
    {
        Kind = SecretKind.ApiKey,
        Scope = "workspace"
    };

    private static ProviderProfileEditorModel NewProvider() => new()
    {
        ProviderKind = ProviderKind.OpenAi,
        BaseUrl = "https://api.openai.com/v1/models",
        DefaultModel = "gpt-4.1",
        TimeoutSeconds = 45,
        IsEnabled = true,
        SupportsStreaming = true,
        SupportsToolCalling = true,
        SupportsStructuredOutput = true
    };
}



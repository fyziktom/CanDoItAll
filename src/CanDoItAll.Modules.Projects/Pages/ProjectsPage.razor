@page "/projects"
@* codex-capsule
kind: page
name: ProjectsPage
summary: Guides project creation and editing through a staged wizard-first flow that feeds the rest of the workspace.
owns: project-list, project-wizard, phase-planning
deps: ProjectsService, IProjectWorkbenchSeedService, NavigationManager
risks: stale-project-selection, weak-linked-object-handoff
tests: component:ProjectsPageTests, e2e:projects-smoke
*@
@using CanDoItAll.SharedKernel
@inject ProjectsService ProjectsService
@inject IProjectWorkbenchSeedService ProjectWorkbenchSeedService
@inject NavigationManager Navigation

<PageTitle>Projects</PageTitle>

<div class="space-y-6">
    <PageHeader Eyebrow="Projects"
                Title="Project workspace"
                Description="Create, refine, and reopen projects through a staged authoring wizard instead of one long direct form." />

    <div class="grid gap-4 xl:grid-cols-[0.9fr_1.1fr]">
        <SectionCard Title="Projects" Description="Open a project into its own work item or start a new guided session.">
            <div class="space-y-4">
                <div class="flex flex-wrap gap-2">
                    <button type="button"
                            class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white"
                            data-testid="projects-new-button"
                            @onclick="OpenNewWizardAsync">
                        New project
                    </button>
                    <button type="button"
                            class="inline-flex items-center rounded-xl border border-slate-300 bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700"
                            @onclick="NavigateHome">
                        Back to dashboard
                    </button>
                </div>

                @if (projectSummaries.Count == 0)
                {
                    <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-4 py-6 text-sm text-slate-600">
                        No projects exist yet. Start with the wizard so the first project opens with identity, phases, and stack choices already framed.
                    </div>
                }
                else
                {
                    @foreach (var project in projectSummaries)
                    {
                        <div class="rounded-[1.6rem] border border-slate-200 bg-slate-50 px-4 py-4">
                            <div class="flex items-start justify-between gap-3">
                                <div>
                                    <p class="text-sm font-semibold text-slate-900">@project.Name</p>
                                    <p class="mt-1 text-xs text-slate-500">@project.Status · @project.CurrentPhase · @project.PhaseCount phase(s)</p>
                                </div>
                                <span class="text-xs text-slate-500">@project.UpdatedAtUtc.LocalDateTime:g</span>
                            </div>

                            <div class="mt-4 flex flex-wrap gap-2">
                                <button type="button" class="rounded-xl bg-slate-900 px-3 py-2 text-xs font-semibold text-white" @onclick="() => OpenProjectTab(project.Id)">Open work item</button>
                                <button type="button" class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700" @onclick="() => OpenStructure(project.Id)">Structure</button>
                                <button type="button" class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700" @onclick="() => OpenCalendar(project.Id)">Calendar</button>
                            </div>
                        </div>
                    }
                }
            </div>
        </SectionCard>

        <SectionCard Title="Project wizard" Description="Identity, phase planning, stack profile, linked objects, and review are staged so the project can move naturally into the workbench.">
            @if (!showWizard)
            {
                <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-5 py-8 text-sm text-slate-600">
                    Select an existing project or start a new one to open the guided authoring flow.
                </div>
            }
            else
            {
                <div class="space-y-5">
                    <div class="flex flex-wrap gap-2">
                        @for (var stepIndex = 0; stepIndex < wizardSteps.Length; stepIndex++)
                        {
                            var isActive = stepIndex == wizardStep;
                            <button type="button"
                                    class="rounded-full px-3 py-2 text-xs font-semibold uppercase tracking-[0.18em] @(isActive ? "bg-slate-900 text-white" : "bg-slate-100 text-slate-600")"
                                    @onclick="() => wizardStep = stepIndex">
                                @(stepIndex + 1). @wizardSteps[stepIndex]
                            </button>
                        }
                    </div>

                    <EditForm Model="editor" OnValidSubmit="SaveAsync">
                        <div class="space-y-4">
                            @switch (wizardStep)
                            {
                                case 0:
                                    <div class="grid gap-4 md:grid-cols-2">
                                        <div>
                                            <label class="mb-1 block text-sm font-medium text-slate-700">Name</label>
                                            <InputText @bind-Value="editor.Name" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" data-testid="project-name-input" />
                                        </div>
                                        <div>
                                            <label class="mb-1 block text-sm font-medium text-slate-700">Current phase</label>
                                            <InputText @bind-Value="editor.CurrentPhase" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                                        </div>
                                    </div>

                                    <div class="grid gap-4 md:grid-cols-2">
                                        <div>
                                            <label class="mb-1 block text-sm font-medium text-slate-700">Status</label>
                                            <InputSelect @bind-Value="editor.Status" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm">
                                                @foreach (var status in Enum.GetValues<ProjectStatus>())
                                                {
                                                    <option value="@status">@status</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div>
                                            <label class="mb-1 block text-sm font-medium text-slate-700">Target date</label>
                                            <InputDate @bind-Value="editor.TargetDateUtc" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                                        </div>
                                    </div>

                                    <div>
                                        <label class="mb-1 block text-sm font-medium text-slate-700">Description</label>
                                        <InputTextArea @bind-Value="editor.Description" class="min-h-24 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                                    </div>
                                    <div>
                                        <label class="mb-1 block text-sm font-medium text-slate-700">Objective</label>
                                        <InputTextArea @bind-Value="editor.Objective" class="min-h-24 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                                    </div>
                                    break;
                                case 1:
                                    <div class="space-y-3">
                                        <div class="flex items-center justify-between">
                                            <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Dates and phases</h3>
                                            <button type="button" class="rounded-xl border border-slate-300 bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700" @onclick="AddPhaseAsync">
                                                Add phase
                                            </button>
                                        </div>
                                        @foreach (var phase in editor.Phases)
                                        {
                                            <div class="grid gap-3 rounded-2xl border border-slate-200 bg-slate-50 p-3 md:grid-cols-5">
                                                <InputText @bind-Value="phase.Name" class="rounded-xl border border-slate-300 px-3 py-2 text-sm md:col-span-2" />
                                                <InputSelect @bind-Value="phase.Status" class="rounded-xl border border-slate-300 px-3 py-2 text-sm">
                                                    @foreach (var status in Enum.GetValues<ProjectPhaseStatus>())
                                                    {
                                                        <option value="@status">@status</option>
                                                    }
                                                </InputSelect>
                                                <InputDate @bind-Value="phase.StartDateUtc" class="rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                                                <InputDate @bind-Value="phase.EndDateUtc" class="rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                                                <InputTextArea @bind-Value="phase.Goal" class="min-h-16 rounded-xl border border-slate-300 px-3 py-2 text-sm md:col-span-4" />
                                                <button type="button" class="rounded-xl border border-rose-300 bg-rose-50 px-3 py-2 text-sm font-semibold text-rose-700" @onclick="() => RemovePhaseAsync(phase)">
                                                    Remove
                                                </button>
                                            </div>
                                        }
                                    </div>
                                    break;
                                case 2:
                                    <div class="space-y-3">
                                        <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Stack profile</h3>
                                        @foreach (var option in editor.Options.OrderBy(item => item.Category))
                                        {
                                            <div class="grid gap-3 rounded-2xl border border-slate-200 bg-slate-50 p-3 md:grid-cols-3">
                                                <div class="rounded-xl bg-white px-3 py-2 text-sm font-semibold text-slate-700">@option.Category</div>
                                                <InputText @bind-Value="option.OptionName" class="rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                                                <InputText @bind-Value="option.Notes" class="rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                                            </div>
                                        }
                                    </div>
                                    break;
                                case 3:
                                    <div class="space-y-3">
                                        <div class="flex items-center justify-between">
                                            <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Linked object planning</h3>
                                            <button type="button" class="rounded-xl border border-slate-300 bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700" @onclick="AddStarterObject">
                                                Add planned object
                                            </button>
                                        </div>

                                        @if (starterObjects.Count == 0)
                                        {
                                            <p class="text-sm text-slate-500">Capture the initial notes, decisions, milestones, or repositories you want to create first when the structure canvas opens.</p>
                                        }
                                        else
                                        {
                                            @foreach (var starter in starterObjects)
                                            {
                                                <div class="grid gap-3 rounded-2xl border border-slate-200 bg-slate-50 p-3 md:grid-cols-4">
                                                    <InputSelect @bind-Value="starter.ObjectType" class="rounded-xl border border-slate-300 px-3 py-2 text-sm">
                                                        @foreach (var kind in starterObjectKinds)
                                                        {
                                                            <option value="@kind">@kind</option>
                                                        }
                                                    </InputSelect>
                                                    <InputText @bind-Value="starter.Title" class="rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                                                    <InputText @bind-Value="starter.Subtitle" class="rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                                                    <button type="button" class="rounded-xl border border-rose-300 bg-rose-50 px-3 py-2 text-sm font-semibold text-rose-700" @onclick="() => starterObjects.Remove(starter)">
                                                        Remove
                                                    </button>
                                                </div>
                                            }
                                        }
                                    </div>
                                    break;
                                default:
                                    <div class="space-y-4">
                                        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                                            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Review</p>
                                            <p class="mt-2 text-lg font-semibold text-slate-900">@editor.Name</p>
                                            <p class="mt-1 text-sm text-slate-600">@editor.Description</p>
                                            <p class="mt-3 text-sm text-slate-700">Current phase: @editor.CurrentPhase</p>
                                            <p class="mt-1 text-sm text-slate-700">Planned phases: @editor.Phases.Count</p>
                                            <p class="mt-1 text-sm text-slate-700">Starter graph objects: @starterObjects.Count</p>
                                        </div>

                                        <div class="rounded-2xl border border-sky-200 bg-sky-50 p-4 text-sm text-sky-800">
                                            Finishing the wizard should lead into the structure or calendar workbench so the project can continue as an artifact-driven session.
                                        </div>
                                    </div>
                                    break;
                            }

                            <div class="flex flex-wrap items-center justify-between gap-2 border-t border-slate-200 pt-4">
                                <div class="flex flex-wrap gap-2">
                                    <button type="button" class="rounded-xl border border-slate-300 bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700" disabled="@(wizardStep == 0)" @onclick="PreviousStep">
                                        Back
                                    </button>
                                    <button type="button" class="rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700" disabled="@(wizardStep == wizardSteps.Length - 1)" @onclick="NextStep">
                                        Next
                                    </button>
                                </div>

                                <div class="flex flex-wrap gap-2">
                                    <button type="submit" class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white" data-testid="project-save-button">
                                        Save project
                                    </button>
                                    <button type="button" class="inline-flex items-center rounded-xl border border-sky-300 bg-sky-50 px-4 py-2 text-sm font-semibold text-sky-700" @onclick="SaveAndOpenStructureAsync">
                                        Save and open structure
                                    </button>
                                    @if (editor.Id.HasValue)
                                    {
                                        <button type="button" class="inline-flex items-center rounded-xl border border-rose-300 bg-rose-50 px-4 py-2 text-sm font-semibold text-rose-700" @onclick="DeleteAsync">Delete</button>
                                    }
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(message))
                            {
                                <p class="text-sm text-emerald-700">@message</p>
                            }
                        </div>
                    </EditForm>
                </div>
            }
        </SectionCard>
    </div>
</div>

@code {
    private static readonly string[] wizardSteps = ["Identity", "Dates and phases", "Stack profile", "Linked objects", "Review"];

    private static readonly ProjectObjectType[] starterObjectKinds =
    [
        ProjectObjectType.Note,
        ProjectObjectType.Decision,
        ProjectObjectType.Milestone,
        ProjectObjectType.Repository,
        ProjectObjectType.Link
    ];

    [SupplyParameterFromQuery(Name = "projectId")]
    public Guid? ProjectIdQuery { get; set; }

    private IReadOnlyList<ProjectSummary> projectSummaries = [];
    private ProjectEditorModel editor = new();
    private readonly List<StarterObjectDraft> starterObjects = [];
    private string? message;
    private int wizardStep;
    private bool showWizard;

    protected override async Task OnParametersSetAsync() => await LoadAsync(ProjectIdQuery);

    private async Task LoadAsync(Guid? selectedProjectId = null)
    {
        projectSummaries = await ProjectsService.ListAsync();
        editor = await ProjectsService.GetAsync(selectedProjectId);
        showWizard = selectedProjectId.HasValue || showWizard;
        if (!selectedProjectId.HasValue)
        {
            starterObjects.Clear();
        }
    }

    private async Task OpenNewWizardAsync()
    {
        editor = await ProjectsService.GetAsync(null);
        starterObjects.Clear();
        wizardStep = 0;
        showWizard = true;
        message = null;
    }

    private void OpenProjectTab(Guid id) => Navigation.NavigateTo($"/projects?projectId={id}");

    private Task AddPhaseAsync()
    {
        editor.Phases.Add(new ProjectPhaseEditorModel());
        return Task.CompletedTask;
    }

    private Task RemovePhaseAsync(ProjectPhaseEditorModel phase)
    {
        editor.Phases.Remove(phase);
        return Task.CompletedTask;
    }

    private void AddStarterObject()
        => starterObjects.Add(new StarterObjectDraft());

    private void NextStep()
        => wizardStep = Math.Min(wizardSteps.Length - 1, wizardStep + 1);

    private void PreviousStep()
        => wizardStep = Math.Max(0, wizardStep - 1);

    private async Task SaveAsync()
    {
        var result = await ProjectsService.SaveAsync(editor);
        message = result.IsSuccess ? "Project saved." : string.Join(" ", result.Errors.Select(error => error.Message));
        projectSummaries = await ProjectsService.ListAsync();
        if (result.IsSuccess)
        {
            if (starterObjects.Count > 0)
            {
                await ProjectWorkbenchSeedService.SeedProjectObjectsAsync(
                    result.Value,
                    starterObjects
                        .Where(item => !string.IsNullOrWhiteSpace(item.Title))
                        .Select(item => new ProjectObjectSeedDraft(item.ObjectType, item.Title, item.Subtitle, item.Subtitle))
                        .ToList());
                starterObjects.Clear();
                message = "Project saved and starter objects seeded to the structure workbench.";
            }

            editor = await ProjectsService.GetAsync(result.Value);
            showWizard = true;
            if (ProjectIdQuery != result.Value)
            {
                Navigation.NavigateTo($"/projects?projectId={result.Value}");
            }
        }
    }

    private async Task SaveAndOpenStructureAsync()
    {
        await SaveAsync();
        if (editor.Id.HasValue)
        {
            Navigation.NavigateTo($"/projects/{editor.Id.Value}/structure");
        }
    }

    private async Task DeleteAsync()
    {
        if (!editor.Id.HasValue)
        {
            return;
        }

        await ProjectsService.DeleteAsync(editor.Id.Value);
        await LoadAsync();
        showWizard = false;
        message = "Project deleted.";
    }

    private void OpenStructure(Guid projectId) => Navigation.NavigateTo($"/projects/{projectId}/structure");

    private void OpenCalendar(Guid projectId) => Navigation.NavigateTo($"/projects/{projectId}/calendar");

    private void NavigateHome() => Navigation.NavigateTo("/");

    private sealed class StarterObjectDraft
    {
        public ProjectObjectType ObjectType { get; set; } = ProjectObjectType.Note;
        public string Title { get; set; } = string.Empty;
        public string Subtitle { get; set; } = string.Empty;
    }
}

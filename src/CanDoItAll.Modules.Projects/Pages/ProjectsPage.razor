@page "/projects"
@* codex-capsule
kind: page
name: ProjectsPage
summary: Guides project creation and editing through a staged wizard-first flow that feeds the rest of the workspace.
owns: project-list, project-wizard, phase-planning
deps: ProjectsService, IProjectWorkbenchSeedService, NavigationManager
risks: stale-project-selection, weak-linked-object-handoff
tests: component:ProjectsPageTests, e2e:projects-smoke
*@
@using CanDoItAll.ComponentKit.Components
@using CanDoItAll.SharedKernel
@inject ProjectsService ProjectsService
@inject IProjectWorkbenchSeedService ProjectWorkbenchSeedService
@inject NavigationManager Navigation

<PageTitle>Projects</PageTitle>

<PageScaffold>
<Header>
<PageHeader Eyebrow="Projects"
Title="Project workspace"
Description="Create, refine, and reopen projects through a staged authoring flow with predictable list selection, sections, and save actions.">
<Actions>
<button type="button"
class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white"
data-testid="projects-new-button"
@onclick="OpenNewWizardAsync">
New project
</button>
<button type="button"
class="inline-flex items-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700"
@onclick="NavigateHome">
Back to dashboard
</button>
</Actions>
</PageHeader>
</Header>

<ChildContent>
<ListDetailShell>
<ListHeader>
<ListPanelHeader Title="Projects"
Description="Select a project to continue editing it, or start a new guided workspace."
Count="@($"{FilteredProjectSummaries.Count} item(s)")">
<Filters>
<FilterBar ResultText="@($"{FilteredProjectSummaries.Count} matching project(s)")">
<input @bind="projectSearch"
@bind:event="oninput"
class="min-w-[14rem] flex-1 rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700"
placeholder="Search projects" />
<InputSelect @bind-Value="statusFilter" class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700">
<option value="">All statuses</option>
@foreach (var status in Enum.GetValues<ProjectStatus>())
{
<option value="@status.ToString()">@status</option>
}
</InputSelect>
<button type="button"
class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700"
@onclick="ResetFilters">
Reset
</button>
</FilterBar>
</Filters>
</ListPanelHeader>
</ListHeader>
<ListContent>
@if (FilteredProjectSummaries.Count == 0)
{
<EmptyState Eyebrow="No projects"
Title="Start the first project workspace"
Description="Projects appear here once they have been saved through the staged authoring flow.">
<Actions>
<button type="button"
class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white"
@onclick="OpenNewWizardAsync">
New project
</button>
</Actions>
</EmptyState>
}
else
{
<div class="space-y-3">
@foreach (var project in FilteredProjectSummaries)
{
<SelectionListItem Title="@project.Name"
Meta="@($"{project.Status} / {project.CurrentPhase} / {project.PhaseCount} phase(s)")"
Summary="@($"Updated {project.UpdatedAtUtc.LocalDateTime:g}")"
IsSelected="@(editor.Id == project.Id && showWizard)"
OnSelect="@(() => SelectProject(project.Id))">
<Status>
<StatusBadge Tone="info" Text="@project.Status.ToString()" />
</Status>
<Actions>
<div class="flex flex-wrap gap-2">
<button type="button"
class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700"
@onclick="@(() => OpenStructure(project.Id))">
Structure
</button>
<button type="button"
class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700"
@onclick="@(() => OpenCalendar(project.Id))">
Calendar
</button>
</div>
</Actions>
</SelectionListItem>
}
</div>
}
</ListContent>
<DetailHeader>
@if (showWizard)
{
<div class="space-y-3">
<div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
<div class="space-y-1">
<p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Project editor</p>
<h2 class="text-xl font-semibold text-slate-950">@(editor.Id.HasValue ? editor.Name : "New project")</h2>
<p class="text-sm leading-6 text-slate-600">Identity, phase planning, stack profile, linked objects, and review now follow one shared detail-pane structure.</p>
</div>
<div class="flex flex-wrap items-center gap-2">
<StatusBadge Tone="info" Text="@editor.Status.ToString()" />
<StatusBadge Tone="neutral" Text="@($"{editor.Phases.Count} phase(s)")" />
</div>
</div>

<SecondaryTabs Items="WizardTabs"
SelectedKey="@wizardStep.ToString()"
SelectedKeyChanged="HandleWizardTabChanged" />
</div>
}
else
{
<div class="space-y-1">
<p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Project editor</p>
<h2 class="text-xl font-semibold text-slate-950">No project selected</h2>
<p class="text-sm leading-6 text-slate-600">Choose a project from the list or start a new one to open the guided authoring flow.</p>
</div>
}
</DetailHeader>
<DetailContent>
@if (!showWizard)
{
<EmptyState Eyebrow="Ready to start"
Title="Open a project or create one"
Description="The detail pane stays focused on the active project so the next step is always obvious.">
<Actions>
<button type="button"
class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white"
@onclick="OpenNewWizardAsync">
New project
</button>
</Actions>
</EmptyState>
}
else
{
<EditForm Model="editor" OnValidSubmit="SaveAsync">
<div class="flex min-h-full flex-col gap-6">
<SummaryTiles>
<SummaryTile Label="Step" Value="@($"{wizardStep + 1} / {wizardSteps.Length}")" HelperText="@wizardSteps[wizardStep]" Tone="info" />
<SummaryTile Label="Phases" Value="@editor.Phases.Count.ToString()" HelperText="Current planned delivery stages." />
<SummaryTile Label="Starter objects" Value="@starterObjects.Count.ToString()" HelperText="Seed items for the structure workbench." />
<SummaryTile Label="Current phase" Value="@(string.IsNullOrWhiteSpace(editor.CurrentPhase) ? "Unset" : editor.CurrentPhase)" HelperText="What the project is actively working on." />
</SummaryTiles>

@switch (wizardStep)
{
case 0:
<FormSection Title="Identity"
Description="Frame the project clearly before moving into phases and downstream workbench actions.">
<div class="grid gap-4 md:grid-cols-2">
<div>
<label class="mb-1 block text-sm font-medium text-slate-700">Name</label>
<InputText @bind-Value="editor.Name" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" data-testid="project-name-input" />
</div>
<div>
<label class="mb-1 block text-sm font-medium text-slate-700">Current phase</label>
<InputText @bind-Value="editor.CurrentPhase" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
</div>
</div>

<div class="grid gap-4 md:grid-cols-2">
<div>
<label class="mb-1 block text-sm font-medium text-slate-700">Status</label>
<InputSelect @bind-Value="editor.Status" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm">
@foreach (var status in Enum.GetValues<ProjectStatus>())
{
<option value="@status">@status</option>
}
</InputSelect>
</div>
<div>
<label class="mb-1 block text-sm font-medium text-slate-700">Target date</label>
<InputDate @bind-Value="editor.TargetDateUtc" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
</div>
</div>

<div>
<label class="mb-1 block text-sm font-medium text-slate-700">Description</label>
<InputTextArea @bind-Value="editor.Description" class="min-h-24 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
</div>

<div>
<label class="mb-1 block text-sm font-medium text-slate-700">Objective</label>
<InputTextArea @bind-Value="editor.Objective" class="min-h-24 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
</div>
</FormSection>
break;
case 1:
<FormSection Title="Dates and phases"
Description="Keep phase planning explicit so the project calendar and workbench stay aligned."
Actions="PhaseActions">
@if (editor.Phases.Count == 0)
{
<EmptyState Eyebrow="No phases"
Title="Add the first phase"
Description="Phases become the backbone for structure, validation, and calendar work.">
<Actions>
<button type="button"
class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white"
@onclick="AddPhaseAsync">
Add phase
</button>
</Actions>
</EmptyState>
}
else
{
<div class="space-y-4">
@foreach (var phase in editor.Phases)
{
<div class="rounded-[1.35rem] border border-slate-200 bg-white p-4">
<div class="grid gap-3 md:grid-cols-5">
<InputText @bind-Value="phase.Name" class="rounded-xl border border-slate-300 px-3 py-2 text-sm md:col-span-2" />
<InputSelect @bind-Value="phase.Status" class="rounded-xl border border-slate-300 px-3 py-2 text-sm">
@foreach (var status in Enum.GetValues<ProjectPhaseStatus>())
{
<option value="@status">@status</option>
}
</InputSelect>
<InputDate @bind-Value="phase.StartDateUtc" class="rounded-xl border border-slate-300 px-3 py-2 text-sm" />
<InputDate @bind-Value="phase.EndDateUtc" class="rounded-xl border border-slate-300 px-3 py-2 text-sm" />
<InputTextArea @bind-Value="phase.Goal" class="min-h-16 rounded-xl border border-slate-300 px-3 py-2 text-sm md:col-span-4" />
<button type="button"
class="rounded-xl border border-rose-300 bg-rose-50 px-3 py-2 text-sm font-semibold text-rose-700"
@onclick="@(() => RemovePhaseAsync(phase))">
Remove
</button>
</div>
</div>
}
</div>
}
</FormSection>
break;
case 2:
<FormSection Title="Stack profile"
Description="Capture the main platform decisions once so downstream prompts and validations inherit the same context.">
<div class="space-y-4">
@foreach (var option in editor.Options.OrderBy(item => item.Category))
{
<div class="grid gap-3 rounded-[1.35rem] border border-slate-200 bg-white p-4 md:grid-cols-3">
<div class="rounded-xl bg-slate-50 px-3 py-2 text-sm font-semibold text-slate-700">@option.Category</div>
<InputText @bind-Value="option.OptionName" class="rounded-xl border border-slate-300 px-3 py-2 text-sm" />
<InputText @bind-Value="option.Notes" class="rounded-xl border border-slate-300 px-3 py-2 text-sm" />
</div>
}
</div>
</FormSection>
break;
case 3:
<FormSection Title="Linked object planning"
Description="Capture the first notes, milestones, repositories, or links that should appear when the structure workbench opens."
Actions="StarterActions">
@if (starterObjects.Count == 0)
{
<EmptyState Eyebrow="No starter objects"
Title="Seed the first artifacts"
Description="Add the initial objects you expect to create right after the project workspace is saved.">
<Actions>
<button type="button"
class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white"
@onclick="AddStarterObject">
Add planned object
</button>
</Actions>
</EmptyState>
}
else
{
<div class="space-y-4">
@foreach (var starter in starterObjects)
{
<div class="grid gap-3 rounded-[1.35rem] border border-slate-200 bg-white p-4 md:grid-cols-4">
<InputSelect @bind-Value="starter.ObjectType" class="rounded-xl border border-slate-300 px-3 py-2 text-sm">
@foreach (var kind in starterObjectKinds)
{
<option value="@kind">@kind</option>
}
</InputSelect>
<InputText @bind-Value="starter.Title" class="rounded-xl border border-slate-300 px-3 py-2 text-sm" />
<InputText @bind-Value="starter.Subtitle" class="rounded-xl border border-slate-300 px-3 py-2 text-sm" />
<button type="button"
class="rounded-xl border border-rose-300 bg-rose-50 px-3 py-2 text-sm font-semibold text-rose-700"
@onclick="@(() => starterObjects.Remove(starter))">
Remove
</button>
</div>
}
</div>
}
</FormSection>
break;
default:
<FormSection Title="Review"
Description="Confirm the project shape before opening the next workbench surface.">
<div class="grid gap-4 lg:grid-cols-2">
<div class="rounded-[1.35rem] border border-slate-200 bg-white p-4">
<p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Project</p>
<p class="mt-2 text-lg font-semibold text-slate-950">@editor.Name</p>
<p class="mt-2 text-sm leading-6 text-slate-600">@editor.Description</p>
</div>
<div class="rounded-[1.35rem] border border-sky-200 bg-sky-50/70 p-4 text-sm leading-6 text-sky-900">
Finishing the wizard keeps the project editor intact, refreshes the list selection, and can open the protected structure workbench immediately when needed.
</div>
</div>
</FormSection>
break;
}

<FormSection Title="Readiness snapshot"
Description="Keep the summary near the save actions so the user does not have to scroll back to understand what is about to be saved.">
<div class="grid gap-4 md:grid-cols-3">
<div class="rounded-[1.2rem] bg-white px-4 py-3">
<p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Name</p>
<p class="mt-2 text-sm font-semibold text-slate-950">@(string.IsNullOrWhiteSpace(editor.Name) ? "Unnamed project" : editor.Name)</p>
</div>
<div class="rounded-[1.2rem] bg-white px-4 py-3">
<p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Current phase</p>
<p class="mt-2 text-sm font-semibold text-slate-950">@(string.IsNullOrWhiteSpace(editor.CurrentPhase) ? "Unset" : editor.CurrentPhase)</p>
</div>
<div class="rounded-[1.2rem] bg-white px-4 py-3">
<p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Starter objects</p>
<p class="mt-2 text-sm font-semibold text-slate-950">@starterObjects.Count</p>
</div>
</div>
</FormSection>

<StickyActionFooter StatusLabel="Project save state"
StatusMessage="@message"
StatusTone="success">
<SecondaryActions>
<button type="button"
class="rounded-xl border border-slate-300 bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700"
disabled="@(wizardStep == 0)"
@onclick="PreviousStep">
Back
</button>
<button type="button"
class="rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700"
disabled="@(wizardStep == wizardSteps.Length - 1)"
@onclick="NextStep">
Next
</button>
</SecondaryActions>
<PrimaryActions>
<button type="submit"
class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white"
data-testid="project-save-button">
Save project
</button>
<button type="button"
class="inline-flex items-center rounded-xl border border-sky-300 bg-sky-50 px-4 py-2 text-sm font-semibold text-sky-700"
@onclick="SaveAndOpenStructureAsync">
Save and open structure
</button>
</PrimaryActions>
<DangerActions>
@if (editor.Id.HasValue)
{
<button type="button"
class="inline-flex items-center rounded-xl border border-rose-300 bg-rose-50 px-4 py-2 text-sm font-semibold text-rose-700"
@onclick="DeleteAsync">
Delete
</button>
}
</DangerActions>
</StickyActionFooter>
</div>
</EditForm>
}
</DetailContent>
</ListDetailShell>
</ChildContent>
</PageScaffold>

@code {
private static readonly string[] wizardSteps = ["Identity", "Dates and phases", "Stack profile", "Linked objects", "Review"];

private static readonly ProjectObjectType[] starterObjectKinds =
[
ProjectObjectType.Note,
ProjectObjectType.Decision,
ProjectObjectType.Milestone,
ProjectObjectType.Repository,
ProjectObjectType.Link
];

[SupplyParameterFromQuery(Name = "projectId")]
public Guid? ProjectIdQuery { get; set; }

private IReadOnlyList<ProjectSummary> projectSummaries = [];
private ProjectEditorModel editor = new();
private readonly List<StarterObjectDraft> starterObjects = [];
private string? message;
private int wizardStep;
private bool showWizard;
private string projectSearch = string.Empty;
private string statusFilter = string.Empty;

private IReadOnlyList<ProjectSummary> FilteredProjectSummaries => projectSummaries
.Where(project =>
(string.IsNullOrWhiteSpace(projectSearch) ||
project.Name.Contains(projectSearch, StringComparison.OrdinalIgnoreCase) ||
project.CurrentPhase.Contains(projectSearch, StringComparison.OrdinalIgnoreCase)) &&
(string.IsNullOrWhiteSpace(statusFilter) ||
string.Equals(project.Status.ToString(), statusFilter, StringComparison.OrdinalIgnoreCase)))
.OrderByDescending(project => project.UpdatedAtUtc)
.ToList();

private IReadOnlyList<SecondaryTabItem> WizardTabs => wizardSteps
.Select((step, index) => new SecondaryTabItem(index.ToString(), $"{index + 1}. {step}"))
.ToList();

private RenderFragment PhaseActions => @<button type="button"
class="inline-flex items-center rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700"
@onclick="AddPhaseAsync">
Add phase
</button>;

private RenderFragment StarterActions => @<button type="button"
class="inline-flex items-center rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700"
@onclick="AddStarterObject">
Add planned object
</button>;

protected override async Task OnParametersSetAsync() => await LoadAsync(ProjectIdQuery);

private async Task LoadAsync(Guid? selectedProjectId = null)
{
projectSummaries = await ProjectsService.ListAsync();
editor = await ProjectsService.GetAsync(selectedProjectId);
showWizard = selectedProjectId.HasValue || showWizard;
if (!selectedProjectId.HasValue)
{
starterObjects.Clear();
}
}

private async Task OpenNewWizardAsync()
{
editor = await ProjectsService.GetAsync(null);
starterObjects.Clear();
wizardStep = 0;
showWizard = true;
message = null;

if (ProjectIdQuery.HasValue)
{
Navigation.NavigateTo("/projects", replace: true);
}
}

private void SelectProject(Guid id)
=> Navigation.NavigateTo($"/projects?projectId={id}");

private Task HandleWizardTabChanged(string key)
{
if (int.TryParse(key, out var parsed))
{
wizardStep = parsed;
}

return Task.CompletedTask;
}

private Task AddPhaseAsync()
{
editor.Phases.Add(new ProjectPhaseEditorModel());
return Task.CompletedTask;
}

private Task RemovePhaseAsync(ProjectPhaseEditorModel phase)
{
editor.Phases.Remove(phase);
return Task.CompletedTask;
}

private void AddStarterObject()
=> starterObjects.Add(new StarterObjectDraft());

private void NextStep()
=> wizardStep = Math.Min(wizardSteps.Length - 1, wizardStep + 1);

private void PreviousStep()
=> wizardStep = Math.Max(0, wizardStep - 1);

private void ResetFilters()
{
projectSearch = string.Empty;
statusFilter = string.Empty;
}

private async Task SaveAsync()
{
var result = await ProjectsService.SaveAsync(editor);
message = result.IsSuccess ? "Project saved." : string.Join(" ", result.Errors.Select(error => error.Message));
projectSummaries = await ProjectsService.ListAsync();
if (result.IsSuccess)
{
if (starterObjects.Count > 0)
{
await ProjectWorkbenchSeedService.SeedProjectObjectsAsync(
result.Value,
starterObjects
.Where(item => !string.IsNullOrWhiteSpace(item.Title))
.Select(item => new ProjectObjectSeedDraft(item.ObjectType, item.Title, item.Subtitle, item.Subtitle))
.ToList());
starterObjects.Clear();
message = "Project saved and starter objects seeded to the structure workbench.";
}

editor = await ProjectsService.GetAsync(result.Value);
showWizard = true;
if (ProjectIdQuery != result.Value)
{
Navigation.NavigateTo($"/projects?projectId={result.Value}");
}
}
}

private async Task SaveAndOpenStructureAsync()
{
await SaveAsync();
if (editor.Id.HasValue)
{
Navigation.NavigateTo($"/projects/{editor.Id.Value}/structure");
}
}

private async Task DeleteAsync()
{
if (!editor.Id.HasValue)
{
return;
}

await ProjectsService.DeleteAsync(editor.Id.Value);
await LoadAsync();
showWizard = false;
message = "Project deleted.";
Navigation.NavigateTo("/projects", replace: true);
}

private void OpenStructure(Guid projectId) => Navigation.NavigateTo($"/projects/{projectId}/structure");

private void OpenCalendar(Guid projectId) => Navigation.NavigateTo($"/projects/{projectId}/calendar");

private void NavigateHome() => Navigation.NavigateTo("/");

private sealed class StarterObjectDraft
{
public ProjectObjectType ObjectType { get; set; } = ProjectObjectType.Note;
public string Title { get; set; } = string.Empty;
public string Subtitle { get; set; } = string.Empty;
}
}
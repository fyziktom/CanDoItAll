@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using CanDoItAll.Modules.Projects
@using CanDoItAll.SharedKernel

<section class="projects-board flex min-h-[26rem] w-full flex-col overflow-hidden rounded-[1.85rem] border border-slate-200 bg-white/92 shadow-sm shadow-slate-200/60"
         data-testid="projects-board">
    <Stack GapScale="LayoutGap.Medium"
           Class="border-b border-slate-200 px-4 py-4 sm:px-5"
           data-testid="projects-command-bar">
        <Split Breakpoint="LayoutBreakpoint.Xl"
               Gap="LayoutGap.Large"
               AlignItems="AlignItems.Start"
               JustifyContent="JustifyContent.SpaceBetween">
            <Stack GapScale="LayoutGap.Small" Orientation="Orientation.Horizontal"
                   Class="min-w-0 flex-1 w-full">
                <Cluster Class="min-w-0">
                    <h2 class="text-lg font-semibold tracking-tight text-slate-950">Portfolio board</h2>
                    <Pill Tone="PillTone.Info"
                          Text="@($"{FilteredProjectSummaries.Count} visible")" />
                    <HelpPopover RootClass="pf-help-popover pf-help-popover--header"
                                 ToggleClass="pf-help-popover__toggle pf-help-popover__toggle--compact"
                                 AriaLabel="Show portfolio board help"
                                 Title="Show portfolio board help"
                                 Heading="Portfolio board"
                                 Body="Search, inspect, edit, and jump into dashboard, structure, or calendar from one compact board without losing the project list."
                                 Tip="Keep deeper work in focused tabs and use the board for fast scanning." />
                </Cluster>
                <Cluster Gap="LayoutGap.Small"
                         Class="min-w-0">
                    <Pill Tone="PillTone.Info"
                          Text="@($"{ProjectSummaries.Count(project => project.Status == ProjectStatus.Active)} active")" />
                    <Pill Tone="PillTone.Neutral"
                          Text="@($"{ProjectSummaries.Count(project => project.Status == ProjectStatus.Draft)} draft")" />
                    <Pill Tone="PillTone.Warn"
                          Token="UPD"
                          Text="@LatestUpdatedProjectLabel" />
                    <HelpPopover RootClass="pf-help-popover flex items-center"
                                 ToggleClass="pf-help-popover__toggle pf-help-popover__toggle--compact"
                                 AriaLabel="Show latest updated project details"
                                 Title="Show latest updated project details"
                                 Heading="Latest updated project"
                                 Body="@LatestUpdatedProjectHelper" />
                </Cluster>
           

                <Cluster JustifyContent="JustifyContent.End">
                    <Button Class="cda-button--quick"
                            Icon="add"
                            title="Create project"
                            aria-label="Create project"
                            data-testid="projects-new-button"
                            Click="OpenNewProject" />
                    <Button ButtonStyle="ButtonStyle.Light"
                            Class="cda-button--quick"
                            Icon="dashboard"
                            title="Open dashboard"
                            aria-label="Open dashboard"
                            Click="NavigateHome" />
                    <HelpPopover RootClass="pf-help-popover flex items-center"
                                 ToggleClass="pf-help-popover__toggle pf-help-popover__toggle--compact"
                                 AriaLabel="Show project relationship filter help"
                                 Title="Show project relationship filter help"
                                 Heading="Project relationship filter"
                                 Body="@HierarchyFilterHelper"
                                 Tip="Pick a project first, then narrow to parents, subprojects, or related items." />
                </Cluster>
            </Stack>
        </Split>

        <Toolbar Class="rounded-[1.35rem] border border-slate-200/90 bg-slate-50/85 p-3 shadow-none">
            <div class="projects-board__filters">
                <PrefixedField Prefix="FIND"
                               Class="min-w-0">
                    <input value="@ProjectSearch"
                           @oninput="HandleProjectSearchInput"
                           class="cda-input cda-input--toolbar h-10"
                           placeholder="Search by name or current phase"
                           data-testid="projects-search-input" />
                </PrefixedField>
                <PrefixedField Prefix="STATUS"
                               Suffix="V"
                               PrefixPaddingRem="4.6"
                               SuffixPaddingRem="2.25"
                               StackOnMobile="true"
                               Class="min-w-0">
                    <InputSelect @bind-Value="StatusFilterProxy"
                                 class="cda-input cda-input--toolbar h-10 appearance-none">
                        <option value="">All statuses</option>
                        @foreach (var status in Enum.GetValues<ProjectStatus>())
                        {
                            <option value="@status.ToString()">@status</option>
                        }
                    </InputSelect>
                </PrefixedField>
                <PrefixedField Prefix="REL"
                               Suffix="V"
                               PrefixPaddingRem="3.1"
                               SuffixPaddingRem="2.25"
                               StackOnMobile="true"
                               Class="min-w-0">
                    <InputSelect @bind-Value="RelatedPartyCategoryFilterProxy"
                                 class="cda-input cda-input--toolbar h-10 appearance-none"
                                 data-testid="project-related-party-category-filter">
                        <option value="">Any relationship</option>
                        @foreach (var category in Enum.GetValues<ProjectPartyPortfolioCategory>())
                        {
                            <option value="@category.ToString()">@ResolveCategoryLabel(category)</option>
                        }
                    </InputSelect>
                </PrefixedField>
                <PrefixedField Prefix="PARTY"
                               Suffix="V"
                               PrefixPaddingRem="4.2"
                               SuffixPaddingRem="2.25"
                               StackOnMobile="true"
                               Class="min-w-0">
                    <InputSelect @bind-Value="RelatedPartyValueFilterProxy"
                                 class="cda-input cda-input--toolbar h-10 appearance-none"
                                 data-testid="project-related-party-value-filter">
                        <option value="">Any party</option>
                        @foreach (var value in AvailableRelatedPartyValues)
                        {
                            <option value="@value">@value</option>
                        }
                    </InputSelect>
                </PrefixedField>
                <PrefixedField Prefix="PROJECT"
                               Suffix="V"
                               PrefixPaddingRem="4.9"
                               SuffixPaddingRem="2.25"
                               StackOnMobile="true"
                               Class="min-w-0">
                    <InputSelect @bind-Value="HierarchyFilterProjectIdProxy"
                                 class="cda-input cda-input--toolbar h-10 appearance-none"
                                 data-testid="hierarchy-filter-project">
                        <option value="">Any project</option>
                        @foreach (var project in ProjectSummaries.OrderBy(project => project.Name))
                        {
                            <option value="@project.Id">@project.Name</option>
                        }
                    </InputSelect>
                </PrefixedField>
                <PrefixedField Prefix="LINK"
                               Suffix="V"
                               PrefixPaddingRem="3.8"
                               SuffixPaddingRem="2.25"
                               StackOnMobile="true"
                               Class="min-w-0">
                    <InputSelect @bind-Value="HierarchyFilterModeProxy"
                                 class="cda-input cda-input--toolbar h-10 appearance-none"
                                 data-testid="hierarchy-filter-mode">
                        <option value="">All links</option>
                        <option value="children">Subprojects</option>
                        <option value="parents">Parents</option>
                        <option value="related">Related</option>
                    </InputSelect>
                </PrefixedField>
                <Button ButtonStyle="ButtonStyle.Light"
                        Class="cda-button--quick"
                        Icon="restart_alt"
                        title="Reset filters"
                        aria-label="Reset filters"
                        Click="ResetFilters" />
            </div>
        </Toolbar>

        <Toolbar Class="rounded-[1.35rem] border border-slate-200/90 bg-white/90 p-3 shadow-none"
                 data-testid="projects-package-toolbar">
            <div class="projects-board__package">
                <Cluster Gap="LayoutGap.Small"
                         Class="min-w-0">
                    <Pill Tone="PillTone.Info"
                          Text="Projects zip" />
                    @if (IsProjectPackageBusy)
                    {
                        <StatusBadge Tone="info" Text="Working" />
                    }
                </Cluster>
                <PrefixedField Prefix="ZIP"
                               PrefixPaddingRem="3.2"
                               Class="min-w-0">
                    <input value="@ProjectPackagePath"
                           @oninput="HandleProjectPackagePathInput"
                           class="cda-input cda-input--toolbar h-10"
                           placeholder="Package path"
                           data-testid="projects-package-path-input" />
                </PrefixedField>
                <Cluster Gap="LayoutGap.Small"
                         JustifyContent="JustifyContent.End"
                         Class="min-w-0">
                    <Button Class="cda-button--quick"
                            Icon="file_download"
                            title="Export projects package"
                            aria-label="Export projects package"
                            Disabled="@IsProjectPackageBusy"
                            IsBusy="@IsProjectPackageBusy"
                            data-testid="projects-export-package-button"
                            Click="ExportProjectsPackage" />
                    <Button ButtonStyle="ButtonStyle.Light"
                            Class="cda-button--quick"
                            Icon="file_upload"
                            title="Import projects package"
                            aria-label="Import projects package"
                            Disabled="@IsProjectPackageBusy"
                            data-testid="projects-import-package-button"
                            Click="ImportProjectsPackage" />
                </Cluster>
                @if (!string.IsNullOrWhiteSpace(ProjectPackageMessage))
                {
                    <p class="projects-board__package-message @(IsProjectPackageMessageError ? "projects-board__package-message--error" : "projects-board__package-message--success")"
                       data-testid="projects-package-message">
                        @ProjectPackageMessage
                    </p>
                }
            </div>
        </Toolbar>
    </Stack>

    <ListDetailShell ListPaneWidth="22rem"
                     Dense="true"
                     ListPaneClass="min-h-0"
                     DetailPaneClass="min-h-0"
                     data-testid="projects-tree-workspace">
        <ListHeader>
            <ListPanelHeader Title="Portfolio tree"
                             Dense="true"
                             Count="@($"{ProjectTreeNodes.Count} root(s)")"
                             HelpText="Use the hierarchy tree to choose a project without leaving the portfolio board." />
        </ListHeader>
        <ListContent>
            <div class="h-full min-h-0 overflow-y-auto pr-1"
                 style="scrollbar-gutter:stable;"
                 data-testid="projects-tree-scroll">
                <TreeView Items="@ProjectTreeNodes"
                          Style="TreeViewStyle.Workbench"
                          AriaLabel="Project hierarchy"
                          EmptyText="No projects match the current filters."
                          OnSelect="HandleProjectTreeSelectAsync"
                          OnToggle="HandleProjectTreeToggleAsync" />
            </div>
        </ListContent>
        <DetailHeader>
            <Cluster Gap="LayoutGap.Small"
                     JustifyContent="JustifyContent.SpaceBetween"
                     Class="min-w-0">
                <div class="min-w-0">
                    <p class="cda-eyebrow cda-eyebrow--tight">Portfolio board</p>
                    <h3 class="truncate text-base font-semibold text-slate-950">@SelectedTreeProjectName</h3>
                </div>
                <Pill Tone="PillTone.Info"
                      Text="@($"{FilteredProjectSummaries.Count} visible")" />
            </Cluster>
        </DetailHeader>
        <DetailContent>
            <div class="projects-board__cards-scroll h-full min-h-0 overflow-y-auto pr-1"
                 style="scrollbar-gutter:stable;"
                 data-testid="projects-cards-scroll">
                @if (FilteredProjectSummaries.Count == 0)
                {
                    <EmptyState Eyebrow="No matching projects"
                                Title="Adjust the filters or start a new project"
                                Description="When projects match the current filters, they appear here as compact cards with overview and dashboard actions.">
                        <Actions>
                            <Button Text="New project" Click="OpenNewProject" />
                        </Actions>
                    </EmptyState>
                }
                else
                {
                    <Grid Gap="LayoutGap.Medium"
                          ColumnsLg="2"
                          Columns2Xl="3">
                        @foreach (var project in FilteredProjectSummaries)
                        {
                            <article class="@ProjectsPresentation.GetProjectCardCss(project.Status)" data-testid="project-card">
                        <Cluster AlignItems="AlignItems.Start"
                                 Wrap="FlexWrap.NoWrap"
                                 Gap="LayoutGap.Medium">
                            <div class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border border-white/70 bg-white/90 text-xs font-bold uppercase tracking-[0.18em] text-slate-600 shadow-sm">
                                @ProjectsPresentation.GetProjectMonogram(project.Name)
                            </div>
                            <div class="min-w-0 flex-1">
                                <Split Breakpoint="LayoutBreakpoint.None"
                                       Gap="LayoutGap.Medium"
                                       AlignItems="AlignItems.Start"
                                       JustifyContent="JustifyContent.SpaceBetween"
                                       Wrap="FlexWrap.Wrap">
                                    <div class="min-w-0">
                                        <p class="cda-eyebrow cda-eyebrow--tight text-slate-400">Project</p>
                                        <h3 class="mt-1 text-base font-bold tracking-tight text-slate-950">@project.Name</h3>
                                    </div>
                                    <StatusBadge Tone="@ProjectsPresentation.GetStatusTone(project.Status)" Text="@project.Status.ToString()" />
                                </Split>
                                <p class="mt-2 text-sm leading-5 text-slate-500">@(string.IsNullOrWhiteSpace(project.CurrentPhase) ? "Current phase not set yet." : project.CurrentPhase)</p>
                                @if (!string.IsNullOrWhiteSpace(project.PrimaryCustomerName) ||
                                     !string.IsNullOrWhiteSpace(project.PrimaryDeliveryUnitName) ||
                                     !string.IsNullOrWhiteSpace(project.PrimaryOwnerName))
                                {
                                    <div class="mt-3 space-y-1.5 text-sm text-slate-600"
                                         data-testid="project-card-related-parties">
                                        @if (!string.IsNullOrWhiteSpace(project.PrimaryCustomerName))
                                        {
                                            <p><span class="font-semibold text-slate-800">Customer:</span> @project.PrimaryCustomerName</p>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(project.PrimaryDeliveryUnitName))
                                        {
                                            <p><span class="font-semibold text-slate-800">Delivery unit:</span> @project.PrimaryDeliveryUnitName</p>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(project.PrimaryOwnerName))
                                        {
                                            <p><span class="font-semibold text-slate-800">Owner:</span> @project.PrimaryOwnerName</p>
                                        }
                                    </div>
                                }
                                @if ((project.RelatedParties?.Count ?? 0) > 0)
                                {
                                    <Cluster Gap="LayoutGap.XSmall"
                                             Class="mt-3">
                                        @foreach (var item in project.RelatedParties!.Take(4))
                                        {
                                            <Pill Tone="@(item.IsPrimary ? PillTone.Info : PillTone.Neutral)"
                                                  Text="@($"{item.Label}: {item.DisplayName}")" />
                                        }
                                    </Cluster>
                                }
                            </div>
                        </Cluster>

                        <Cluster Gap="LayoutGap.XSmall"
                                 Class="mt-4">
                            <StatusBadge Tone="neutral" Text="@($"{project.PhaseCount} phases")" />
                            <StatusBadge Tone="neutral" Text="@($"{project.ParentCount} parents")" />
                            <StatusBadge Tone="info" Text="@($"{project.ChildCount} subprojects")" />
                            <StatusBadge Tone="neutral" Text="@($"Updated {project.UpdatedAtUtc.LocalDateTime:g}")" />
                        </Cluster>

                        <CardActions Secondary="true" Class="mt-4 border-white/70">
                            <Cluster>
                                <Button Class="cda-button--quick"
                                        Icon="visibility"
                                        title="Preview project"
                                        aria-label="Preview project"
                                        data-testid="project-card-details-button"
                                        Click="@(() => OpenProjectPreview.InvokeAsync(project.Id))" />
                                <Button ButtonStyle="ButtonStyle.Light"
                                        Class="cda-button--quick"
                                        Icon="subdirectory_arrow_right"
                                        title="Open hierarchy"
                                        aria-label="Open hierarchy"
                                        data-testid="project-card-subprojects-button"
                                        Click="@(() => OpenHierarchyModal.InvokeAsync(project.Id))" />
                            </Cluster>
                            <Cluster Gap="LayoutGap.XSmall">
                                <Button ButtonStyle="ButtonStyle.Light"
                                        Size="ButtonSize.Small"
                                        Class="cda-button--quick"
                                        Icon="dashboard"
                                        title="Open dashboard tab"
                                        aria-label="Open dashboard tab"
                                        Click="@(() => OpenProjectDashboard.InvokeAsync(project.Id))" />
                                <Button ButtonStyle="ButtonStyle.Light"
                                        Size="ButtonSize.Small"
                                        Class="cda-button--quick"
                                        Icon="account_tree"
                                        title="Open structure"
                                        aria-label="Open structure"
                                        Click="@(() => OpenStructure.InvokeAsync(project.Id))" />
                                <Button ButtonStyle="ButtonStyle.Light"
                                        Size="ButtonSize.Small"
                                        Class="cda-button--quick"
                                        Icon="hub"
                                        title="Open processes"
                                        aria-label="Open processes"
                                        Click="@(() => OpenProcesses.InvokeAsync(project.Id))" />
                                <Button ButtonStyle="ButtonStyle.Light"
                                        Size="ButtonSize.Small"
                                        Class="cda-button--quick"
                                        Icon="calendar_month"
                                        title="Open calendar"
                                        aria-label="Open calendar"
                                        Click="@(() => OpenCalendar.InvokeAsync(project.Id))" />
                                <Button ButtonStyle="ButtonStyle.Light"
                                        Size="ButtonSize.Small"
                                        Class="cda-button--quick"
                                        Icon="timeline"
                                        title="Open Mermaid Gantt"
                                        aria-label="Open Mermaid Gantt"
                                        data-testid="project-card-gantt-button"
                                        Click="@(() => OpenGanttPreview.InvokeAsync(project.Id))" />
                            </Cluster>
                        </CardActions>
                            </article>
                        }
                    </Grid>
                }
            </div>
        </DetailContent>
    </ListDetailShell>
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ProjectSummary> ProjectSummaries { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<ProjectSummary> FilteredProjectSummaries { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<ProjectHierarchyLinkSummary> HierarchyLinks { get; set; } = [];

    [Parameter]
    public string ProjectSearch { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ProjectSearchChanged { get; set; }

    [Parameter]
    public string StatusFilter { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> StatusFilterChanged { get; set; }

    [Parameter]
    public string RelatedPartyCategoryFilter { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> RelatedPartyCategoryFilterChanged { get; set; }

    [Parameter]
    public string RelatedPartyValueFilter { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> RelatedPartyValueFilterChanged { get; set; }

    [Parameter]
    public IReadOnlyList<string> AvailableRelatedPartyValues { get; set; } = [];

    [Parameter]
    public string HierarchyFilterProjectId { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> HierarchyFilterProjectIdChanged { get; set; }

    [Parameter]
    public string HierarchyFilterMode { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> HierarchyFilterModeChanged { get; set; }

    [Parameter]
    public string HierarchyFilterHelper { get; set; } = string.Empty;

    [Parameter]
    public string LatestUpdatedProjectLabel { get; set; } = string.Empty;

    [Parameter]
    public string LatestUpdatedProjectHelper { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OpenNewProject { get; set; }

    [Parameter]
    public EventCallback NavigateHome { get; set; }

    [Parameter]
    public EventCallback ResetFilters { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenProjectPreview { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenHierarchyModal { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenProjectDashboard { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenStructure { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenProcesses { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenCalendar { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenGanttPreview { get; set; }

    [Parameter]
    public string ProjectPackagePath { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ProjectPackagePathChanged { get; set; }

    [Parameter]
    public string? ProjectPackageMessage { get; set; }

    [Parameter]
    public bool IsProjectPackageMessageError { get; set; }

    [Parameter]
    public bool IsProjectPackageBusy { get; set; }

    [Parameter]
    public EventCallback ExportProjectsPackage { get; set; }

    [Parameter]
    public EventCallback ImportProjectsPackage { get; set; }

    private readonly HashSet<string> expandedProjectTreeNodeIds = [];
    private Guid? selectedTreeProjectId;

    private IReadOnlyList<TreeViewNode> ProjectTreeNodes
        => ProjectPortfolioTreeNodeBuilder.Build(
            FilteredProjectSummaries,
            HierarchyLinks,
            selectedTreeProjectId,
            expandedProjectTreeNodeIds);

    private string SelectedTreeProjectName
        => selectedTreeProjectId.HasValue
            ? FilteredProjectSummaries.FirstOrDefault(project => project.Id == selectedTreeProjectId.Value)?.Name ?? "Selected project"
            : "All filtered projects";

    private async Task HandleProjectTreeSelectAsync(string nodeId)
    {
        if (!ProjectPortfolioTreeNodeBuilder.TryReadProjectId(nodeId, out var projectId))
        {
            return;
        }

        selectedTreeProjectId = projectId;
        await OpenProjectPreview.InvokeAsync(projectId);
    }

    private Task HandleProjectTreeToggleAsync(string nodeId)
    {
        if (!expandedProjectTreeNodeIds.Add(nodeId))
        {
            expandedProjectTreeNodeIds.Remove(nodeId);
        }

        return Task.CompletedTask;
    }

    private string ProjectSearchProxy
    {
        get => ProjectSearch;
        set => _ = ProjectSearchChanged.InvokeAsync(value);
    }

    private Task HandleProjectSearchInput(ChangeEventArgs args)
    {
        return ProjectSearchChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    }

    private Task HandleProjectPackagePathInput(ChangeEventArgs args)
    {
        return ProjectPackagePathChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    }

    private string StatusFilterProxy
    {
        get => StatusFilter;
        set => _ = StatusFilterChanged.InvokeAsync(value);
    }

    private string RelatedPartyCategoryFilterProxy
    {
        get => RelatedPartyCategoryFilter;
        set => _ = RelatedPartyCategoryFilterChanged.InvokeAsync(value);
    }

    private string RelatedPartyValueFilterProxy
    {
        get => RelatedPartyValueFilter;
        set => _ = RelatedPartyValueFilterChanged.InvokeAsync(value);
    }

    private string HierarchyFilterProjectIdProxy
    {
        get => HierarchyFilterProjectId;
        set => _ = HierarchyFilterProjectIdChanged.InvokeAsync(value);
    }

    private string HierarchyFilterModeProxy
    {
        get => HierarchyFilterMode;
        set => _ = HierarchyFilterModeChanged.InvokeAsync(value);
    }

    private static string ResolveCategoryLabel(ProjectPartyPortfolioCategory category)
    {
        return category switch
        {
            ProjectPartyPortfolioCategory.DeliveryUnit => "Delivery unit",
            ProjectPartyPortfolioCategory.AiAgent => "AI agent",
            _ => category.ToString()
        };
    }
}

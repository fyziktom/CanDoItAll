@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Modules.Projects
@using CanDoItAll.SharedKernel

@if (IsOpen)
{
    @if (IsEditorMode)
    {
        <EditForm Model="Editor" OnValidSubmit="HandleSaveAsync">
            <Dialog IsOpen="true"
                    Eyebrow="Project editor"
                    Title="@(Editor.Id.HasValue ? Editor.Name : "New project")"
                    Subtitle="Use the editor only when you need to shape the project deeply. The main page stays dedicated to scanning cards and opening focused tabs."
                    Size="ModalSize.Wide"
                    ShowCloseButton="false"
                    TestId="projects-editor-modal"
                    OnClose="Close">
                <HeaderActions>
                    @if (Editor.Id.HasValue)
                    {
                        <Button ButtonStyle="ButtonStyle.Light"
                                Text="Back to details"
                                Click="SwitchToOverview" />
                    }
                    <Button ButtonStyle="ButtonStyle.Light"
                            Text="Close"
                            Click="Close" />
                </HeaderActions>
                <ChildContent>
                    <div class="cda-stack-4">
                        <div class="flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">
                            <SecondaryTabs Items="WizardTabs"
                                           SelectedKey="@WizardStep.ToString()"
                                           SelectedKeyChanged="WizardTabChanged" />

                            <div class="flex flex-wrap items-center gap-2">
                                <StatusBadge Tone="@ProjectsPresentation.GetStatusTone(Editor.Status)" Text="@Editor.Status.ToString()" />
                                <StatusBadge Tone="neutral" Text="@($"{Editor.Phases.Count} phase(s)")" />
                                <StatusBadge Tone="info" Text="@($"{StarterObjects.Count} starter object(s)")" />
                            </div>
                        </div>

                        <SummaryTiles>
                            <SummaryTile Label="Step" Value="@($"{WizardStep + 1} / {WizardSteps.Count}")" HelperText="@WizardSteps[WizardStep]" Tone="info" />
                            <SummaryTile Label="Current phase" Value="@(string.IsNullOrWhiteSpace(Editor.CurrentPhase) ? "Unset" : Editor.CurrentPhase)" HelperText="The phase the workspace should foreground." />
                            <SummaryTile Label="Target date" Value="@ProjectsPresentation.FormatDate(Editor.TargetDateUtc)" HelperText="Leave empty when timing is still fluid." />
                            <SummaryTile Label="Stack decisions" Value="@MeaningfulOptions.Count.ToString()" HelperText="Profile choices already captured for prompts and validation." />
                        </SummaryTiles>

                        @switch (WizardStep)
                        {
                            case 0:
                                <FormSection Title="Identity"
                                             Description="Frame the project clearly before moving into phases and downstream workbench actions.">
                                    <ChildContent>
                                        <div class="grid gap-4 lg:grid-cols-2">
                                            <div>
                                                <label class="cda-field-label">Name</label>
                                                <InputText @bind-Value="Editor.Name" class="cda-input" data-testid="project-name-input" />
                                            </div>
                                            <div>
                                                <label class="cda-field-label">Current phase</label>
                                                <InputText @bind-Value="Editor.CurrentPhase" class="cda-input" />
                                            </div>
                                        </div>

                                        <div class="grid gap-4 lg:grid-cols-2">
                                            <div>
                                                <label class="cda-field-label">Status</label>
                                                <InputSelect @bind-Value="Editor.Status" class="cda-input">
                                                    @foreach (var status in Enum.GetValues<ProjectStatus>())
                                                    {
                                                        <option value="@status">@status</option>
                                                    }
                                                </InputSelect>
                                            </div>
                                            <div>
                                                <label class="cda-field-label">Target date</label>
                                                <InputDate @bind-Value="Editor.TargetDateUtc" class="cda-input" />
                                            </div>
                                        </div>

                                        <div>
                                            <label class="cda-field-label">Description</label>
                                            <InputTextArea @bind-Value="Editor.Description" class="cda-input cda-input--textarea min-h-28" />
                                        </div>

                                        <div>
                                            <label class="cda-field-label">Objective</label>
                                            <InputTextArea @bind-Value="Editor.Objective" class="cda-input cda-input--textarea min-h-28" />
                                        </div>
                                    </ChildContent>
                                </FormSection>
                                break;
                            case 1:
                                <FormSection Title="Dates and phases"
                                             Description="Keep phase planning explicit so the project calendar and workbench stay aligned.">
                                    <Actions>
                                        <Button ButtonStyle="ButtonStyle.Light"
                                                Text="Add phase"
                                                Click="AddPhase" />
                                    </Actions>
                                    <ChildContent>
                                        @if (Editor.Phases.Count == 0)
                                        {
                                            <EmptyState Eyebrow="No phases"
                                                        Title="Add the first phase"
                                                        Description="Phases become the backbone for structure, validation, and calendar work.">
                                                <Actions>
                                                    <Button Text="Add phase" Click="AddPhase" />
                                                </Actions>
                                            </EmptyState>
                                        }
                                        else
                                        {
                                            <div class="cda-stack-4">
                                                @foreach (var phase in Editor.Phases)
                                                {
                                                    <div class="cda-panel-card">
                                                        <div class="grid gap-3 xl:grid-cols-5">
                                                            <InputText @bind-Value="phase.Name" class="cda-input xl:col-span-2" />
                                                            <InputSelect @bind-Value="phase.Status" class="cda-input">
                                                                @foreach (var status in Enum.GetValues<ProjectPhaseStatus>())
                                                                {
                                                                    <option value="@status">@status</option>
                                                                }
                                                            </InputSelect>
                                                            <InputDate @bind-Value="phase.StartDateUtc" class="cda-input" />
                                                            <InputDate @bind-Value="phase.EndDateUtc" class="cda-input" />
                                                            <InputTextArea @bind-Value="phase.Goal" class="cda-input cda-input--textarea min-h-20 xl:col-span-4" />
                                                            <Button ButtonStyle="ButtonStyle.Danger"
                                                                    Text="Remove"
                                                                    Size="ButtonSize.Small"
                                                                    Click="@(() => RemovePhase.InvokeAsync(phase))" />
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </ChildContent>
                                </FormSection>
                                break;
                            case 2:
                                <FormSection Title="Stack profile"
                                             Description="Capture the main platform decisions once so downstream prompts and validations inherit the same context.">
                                    <ChildContent>
                                        <div class="grid gap-4 lg:grid-cols-2">
                                            @foreach (var option in Editor.Options.OrderBy(item => item.Category))
                                            {
                                                <div class="cda-panel-card">
                                                    <div class="mb-3 rounded-xl bg-slate-50 px-3 py-2 text-sm font-semibold text-slate-700">@option.Category</div>
                                                    <div class="grid gap-3">
                                                        <InputText @bind-Value="option.OptionName" class="cda-input" />
                                                        <InputText @bind-Value="option.Notes" class="cda-input" />
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </ChildContent>
                                </FormSection>
                                break;
                            case 3:
                                <FormSection Title="Linked object planning"
                                             Description="Capture the first notes, milestones, repositories, or links that should appear when the structure workbench opens.">
                                    <Actions>
                                        <Button ButtonStyle="ButtonStyle.Light"
                                                Text="Add planned object"
                                                Click="AddStarterObject" />
                                    </Actions>
                                    <ChildContent>
                                        @if (StarterObjects.Count == 0)
                                        {
                                            <EmptyState Eyebrow="No starter objects"
                                                        Title="Seed the first artifacts"
                                                        Description="Add the initial objects you expect to create right after the project workspace is saved.">
                                                <Actions>
                                                    <Button Text="Add planned object" Click="AddStarterObject" />
                                                </Actions>
                                            </EmptyState>
                                        }
                                        else
                                        {
                                            <div class="cda-stack-4">
                                                @foreach (var starter in StarterObjects)
                                                {
                                                    <div class="cda-panel-card grid gap-3 xl:grid-cols-4">
                                                        <InputSelect @bind-Value="starter.ObjectType" class="cda-input">
                                                            @foreach (var kind in StarterObjectKinds)
                                                            {
                                                                <option value="@kind">@kind</option>
                                                            }
                                                        </InputSelect>
                                                        <InputText @bind-Value="starter.Title" class="cda-input" />
                                                        <InputText @bind-Value="starter.Subtitle" class="cda-input" />
                                                        <Button ButtonStyle="ButtonStyle.Danger"
                                                                Text="Remove"
                                                                Size="ButtonSize.Small"
                                                                Click="@(() => RemoveStarterObject.InvokeAsync(starter))" />
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </ChildContent>
                                </FormSection>
                                break;
                            default:
                                <FormSection Title="Review"
                                             Description="Confirm the project shape before opening the next workbench surface.">
                                    <ChildContent>
                                        <div class="grid gap-4 xl:grid-cols-[minmax(0,1.15fr)_minmax(18rem,0.85fr)]">
                                            <div class="cda-panel-card">
                                                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Project summary</p>
                                                <p class="mt-2 text-lg font-semibold text-slate-950">@(string.IsNullOrWhiteSpace(Editor.Name) ? "Unnamed project" : Editor.Name)</p>
                                                <p class="mt-2 text-sm leading-6 text-slate-600">@(string.IsNullOrWhiteSpace(Editor.Description) ? "No description captured yet." : Editor.Description)</p>
                                            </div>

                                            <div class="cda-panel-card border-sky-200 bg-sky-50/80 text-sm leading-6 text-sky-900">
                                                Saving keeps the card list current, preserves the modal context, and lets the user open structure or calendar tabs only when they actually need a larger work surface.
                                            </div>
                                        </div>

                                        <div class="grid gap-4 md:grid-cols-3">
                                            <div class="cda-metric-card">
                                                <p class="cda-metric-card__label">Status</p>
                                                <p class="cda-metric-card__value">@Editor.Status</p>
                                            </div>
                                            <div class="cda-metric-card">
                                                <p class="cda-metric-card__label">Phases</p>
                                                <p class="cda-metric-card__value">@Editor.Phases.Count</p>
                                            </div>
                                            <div class="cda-metric-card">
                                                <p class="cda-metric-card__label">Starter objects</p>
                                                <p class="cda-metric-card__value">@StarterObjects.Count</p>
                                            </div>
                                        </div>
                                    </ChildContent>
                                </FormSection>
                                break;
                        }
                    </div>
                </ChildContent>
                <Footer>
                    <div class="flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">
                        <div class="space-y-1">
                            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Project save state</p>
                            <p class="text-sm @(IsErrorMessage ? "text-rose-700" : "text-slate-600")">@(string.IsNullOrWhiteSpace(Message) ? "Save keeps the grid in sync without leaving the page." : Message)</p>
                        </div>

                        <div class="flex flex-wrap items-center gap-2">
                            <Button ButtonStyle="ButtonStyle.Light"
                                    Text="Back"
                                    Disabled="@(WizardStep == 0)"
                                    Click="PreviousStep" />
                            <Button ButtonStyle="ButtonStyle.Light"
                                    Text="Next"
                                    Disabled="@(WizardStep == WizardSteps.Count - 1)"
                                    Click="NextStep" />
                            <Button Type="submit"
                                    Text="Save project"
                                    data-testid="project-save-button" />
                            <Button ButtonStyle="ButtonStyle.Info"
                                    Text="Save and open structure"
                                    Click="SaveAndOpenStructure" />
                            @if (Editor.Id.HasValue)
                            {
                                <Button ButtonStyle="ButtonStyle.Light"
                                        Text="Open dashboard tab"
                                        Click="OpenProjectDashboard" />
                                <Button ButtonStyle="ButtonStyle.Danger"
                                        Text="Delete"
                                        Click="Delete" />
                            }
                        </div>
                    </div>
                </Footer>
            </Dialog>
        </EditForm>
    }
    else
    {
        <Dialog IsOpen="true"
                Eyebrow="Project details"
                Title="@(string.IsNullOrWhiteSpace(Editor.Name) ? "Project overview" : Editor.Name)"
                Subtitle="This modal keeps the overview compact. Use the focused tabs only when the work really needs structure, calendar, or a dedicated dashboard route."
                Size="ModalSize.Wide"
                ShowCloseButton="false"
                TestId="projects-detail-modal"
                OnClose="Close">
            <HeaderActions>
                <StatusBadge Tone="@ProjectsPresentation.GetStatusTone(Editor.Status)" Text="@Editor.Status.ToString()" />
                <StatusBadge Tone="neutral" Text="@($"{Editor.Phases.Count} phase(s)")" />
                <Button ButtonStyle="ButtonStyle.Light"
                        Text="Close"
                        Click="Close" />
            </HeaderActions>
            <ChildContent>
                <div class="cda-stack-4">
                    <SummaryTiles>
                        <SummaryTile Label="Current phase" Value="@(string.IsNullOrWhiteSpace(Editor.CurrentPhase) ? "Unset" : Editor.CurrentPhase)" HelperText="The phase currently highlighted for delivery." Tone="info" />
                        <SummaryTile Label="Target date" Value="@ProjectsPresentation.FormatDate(Editor.TargetDateUtc)" HelperText="Leave flexible when the delivery window is still moving." />
                        <SummaryTile Label="Last updated" Value="@ProjectsPresentation.FormatTimestamp(LastUpdatedAtUtc)" HelperText="Pulled from the live project list." />
                        <SummaryTile Label="Stack decisions" Value="@MeaningfulOptions.Count.ToString()" HelperText="Filled stack-profile entries captured for this project." Tone="warning" />
                    </SummaryTiles>

                    <div class="grid gap-4 xl:grid-cols-[minmax(0,1.15fr)_minmax(18rem,0.85fr)]">
                        <section class="cda-surface-card">
                            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Description</p>
                            <p class="mt-3 text-sm leading-6 text-slate-700">@(string.IsNullOrWhiteSpace(Editor.Description) ? "No description has been captured for this project yet." : Editor.Description)</p>

                            <p class="mt-6 text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Objective</p>
                            <p class="mt-3 text-sm leading-6 text-slate-700">@(string.IsNullOrWhiteSpace(Editor.Objective) ? "No explicit objective has been recorded yet." : Editor.Objective)</p>
                        </section>

                        <section class="cda-surface-card--soft">
                            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Next actions</p>
                            <div class="mt-4 grid gap-3">
                                <Button Class="w-full"
                                        Text="Edit project"
                                        Click="SwitchToEditor" />
                                <Button ButtonStyle="ButtonStyle.Light"
                                        Class="w-full"
                                        Text="Open dashboard tab"
                                        Click="OpenProjectDashboard" />
                                <Button ButtonStyle="ButtonStyle.Light"
                                        Class="w-full"
                                        Text="Open structure"
                                        Disabled="@(!Editor.Id.HasValue)"
                                        Click="HandleOpenStructureAsync" />
                                <Button ButtonStyle="ButtonStyle.Light"
                                        Class="w-full"
                                        Text="Open calendar"
                                        Disabled="@(!Editor.Id.HasValue)"
                                        Click="HandleOpenCalendarAsync" />
                            </div>
                        </section>
                    </div>

                    <section class="cda-surface-card">
                        <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                            <div>
                                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Phase plan</p>
                                <h3 class="mt-1 text-lg font-semibold text-slate-950">Delivery sequence</h3>
                            </div>
                            <StatusBadge Tone="neutral" Text="@($"{Editor.Phases.Count} phase(s)")" />
                        </div>

                        @if (Editor.Phases.Count == 0)
                        {
                            <p class="mt-4 text-sm leading-6 text-slate-600">No phase plan exists yet. Use the editor to map the first delivery stages before opening structure or calendar tabs.</p>
                        }
                        else
                        {
                            <div class="mt-4 grid gap-3 lg:grid-cols-2">
                                @foreach (var phase in Editor.Phases.OrderBy(ProjectsPresentation.GetPhaseOrderKey).ThenBy(item => item.Name))
                                {
                                    <div class="cda-panel-card--soft">
                                        <div class="flex items-start justify-between gap-3">
                                            <div class="min-w-0">
                                                <p class="text-sm font-semibold text-slate-950">@phase.Name</p>
                                                <p class="mt-1 text-xs uppercase tracking-[0.18em] text-slate-500">@phase.Status</p>
                                            </div>
                                            <StatusBadge Tone="@ProjectsPresentation.GetPhaseStatusTone(phase.Status)" Text="@phase.Status.ToString()" />
                                        </div>
                                        <p class="mt-3 text-sm leading-6 text-slate-600">@(string.IsNullOrWhiteSpace(phase.Goal) ? "No goal has been captured for this phase yet." : phase.Goal)</p>
                                        <p class="mt-3 text-xs font-medium text-slate-500">@($"{ProjectsPresentation.FormatDate(phase.StartDateUtc)} to {ProjectsPresentation.FormatDate(phase.EndDateUtc)}")</p>
                                    </div>
                                }
                            </div>
                        }
                    </section>

                    <section class="cda-surface-card">
                        <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
                            <div>
                                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Stack profile</p>
                                <h3 class="mt-1 text-lg font-semibold text-slate-950">Captured platform choices</h3>
                            </div>
                            <StatusBadge Tone="warning" Text="@($"{MeaningfulOptions.Count} filled")" />
                        </div>

                        @if (MeaningfulOptions.Count == 0)
                        {
                            <p class="mt-4 text-sm leading-6 text-slate-600">No stack profile has been captured yet. The editor can record platform, storage, testing, deployment, and external dependency choices.</p>
                        }
                        else
                        {
                            <div class="mt-4 grid gap-3 lg:grid-cols-2">
                                @foreach (var option in MeaningfulOptions.OrderBy(item => item.Category).ThenBy(item => item.OptionName))
                                {
                                    <div class="cda-panel-card--soft">
                                        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">@option.Category</p>
                                        <p class="mt-2 text-sm font-semibold text-slate-950">@(string.IsNullOrWhiteSpace(option.OptionName) ? "Not specified" : option.OptionName)</p>
                                        <p class="mt-2 text-sm leading-6 text-slate-600">@(string.IsNullOrWhiteSpace(option.Notes) ? "No notes recorded." : option.Notes)</p>
                                    </div>
                                }
                            </div>
                        }
                    </section>
                </div>
            </ChildContent>
            <Footer>
                <div class="flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">
                    <div class="space-y-1">
                        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Project dashboard</p>
                        <p class="text-sm text-slate-600">Use the modal to inspect and decide. Use tabs only when you want the project overview or a deeper work surface to stay open alongside other work.</p>
                    </div>

                    <div class="flex flex-wrap items-center gap-2">
                        <Button ButtonStyle="ButtonStyle.Light"
                                Text="Edit project"
                                Click="SwitchToEditor" />
                        <Button Text="Open dashboard tab"
                                Click="OpenProjectDashboard" />
                    </div>
                </div>
            </Footer>
        </Dialog>
    }
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public bool IsEditorMode { get; set; }

    [Parameter, EditorRequired]
    public ProjectEditorModel Editor { get; set; } = default!;

    [Parameter, EditorRequired]
    public IList<StarterObjectDraft> StarterObjects { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<ProjectObjectType> StarterObjectKinds { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<ProjectSummary> ProjectSummaries { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<string> WizardSteps { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<SecondaryTabItem> WizardTabs { get; set; } = default!;

    [Parameter]
    public int WizardStep { get; set; }

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public bool IsErrorMessage { get; set; }

    [Parameter]
    public EventCallback Close { get; set; }

    [Parameter]
    public EventCallback SwitchToOverview { get; set; }

    [Parameter]
    public EventCallback SwitchToEditor { get; set; }

    [Parameter]
    public EventCallback<string> WizardTabChanged { get; set; }

    [Parameter]
    public EventCallback AddPhase { get; set; }

    [Parameter]
    public EventCallback<ProjectPhaseEditorModel> RemovePhase { get; set; }

    [Parameter]
    public EventCallback AddStarterObject { get; set; }

    [Parameter]
    public EventCallback<StarterObjectDraft> RemoveStarterObject { get; set; }

    [Parameter]
    public EventCallback PreviousStep { get; set; }

    [Parameter]
    public EventCallback NextStep { get; set; }

    [Parameter]
    public EventCallback Save { get; set; }

    [Parameter]
    public EventCallback SaveAndOpenStructure { get; set; }

    [Parameter]
    public EventCallback Delete { get; set; }

    [Parameter]
    public EventCallback OpenProjectDashboard { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenStructure { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenCalendar { get; set; }

    private IReadOnlyList<ProjectOptionEditorModel> MeaningfulOptions => Editor.Options
        .Where(option => !string.IsNullOrWhiteSpace(option.OptionName) || !string.IsNullOrWhiteSpace(option.Notes))
        .ToList();

    private DateTimeOffset? LastUpdatedAtUtc => Editor.Id.HasValue
        ? ProjectSummaries.FirstOrDefault(project => project.Id == Editor.Id.Value)?.UpdatedAtUtc
        : null;

    private Task HandleSaveAsync()
        => Save.InvokeAsync();

    private Task HandleOpenStructureAsync()
        => Editor.Id.HasValue
            ? OpenStructure.InvokeAsync(Editor.Id.Value)
            : Task.CompletedTask;

    private Task HandleOpenCalendarAsync()
        => Editor.Id.HasValue
            ? OpenCalendar.InvokeAsync(Editor.Id.Value)
            : Task.CompletedTask;
}

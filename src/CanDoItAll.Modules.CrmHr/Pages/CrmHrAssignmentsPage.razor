@page "/crm-hr/assignments"
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Modules.Projects
@inject ProjectsService ProjectsService
@inject ProjectPartyIntegrationService ProjectPartyIntegrationService
@inject HrService HrService
@inject NavigationManager Navigation
@inject NotificationService NotificationService

<PageTitle>CRM / HR Assignments</PageTitle>

<PageScaffold MaxWidthClass="max-w-full">
    <Header>
        <PageHeader Eyebrow="CRM / HR"
                    Title="Assignments workspace"
                    Description="Keep commercial, staffing, and project allocations aligned with the live project portfolio." />
    </Header>

    <ChildContent>
        <Stack GapScale="LayoutGap.Large">
            <CrmHrSecondaryTabs SelectedKey="assignments" />

            <SummaryTiles>
                <SummaryTile Label="Projects"
                             Value="@projectSummaries.Count.ToString()"
                             HelperText="Projects currently available for CRM-HR relationship binding." />
                <SummaryTile Label="Open requests"
                             Value="@staffingDashboard.OpenRequestCount.ToString()"
                             HelperText="Open staffing demand across the CRM-HR module." Tone="info" />
                <SummaryTile Label="Open demand"
                             Value="@($"{staffingDashboard.OpenDemandPercent:0.##}%")"
                             HelperText="Requested allocation still flowing through open staffing requests." Tone="warning" />
                <SummaryTile Label="Bench"
                             Value="@staffingDashboard.BenchCount.ToString()"
                             HelperText="Profiles currently available for staffing." Tone="success" />
                <SummaryTile Label="Overallocated"
                             Value="@staffingDashboard.OverallocatedCount.ToString()"
                             HelperText="Profiles already exceeding available capacity." Tone="danger" />
            </SummaryTiles>

            <ProjectPartyAssignmentPanel Projects="projectSummaries"
                                         SelectedProjectId="selectedProjectId"
                                         SelectedProjectIdChanged="HandleProjectChanged"
                                         Draft="draftAssignment"
                                         PartyOptions="partyOptions"
                                         Assignments="assignments"
                                         SaveDraft="SaveDraftAsync"
                                         ResetDraft="ResetDraftAsync"
                                         DeleteAssignment="DeleteAssignmentAsync"
                                         OpenStructure="OpenStructure" />

            <Grid Gap="LayoutGap.Large" ColumnsLg="2">
                <StaffingRequestEditor Draft="staffingRequestDraft"
                                       SkillCatalog="skillCatalog"
                                       PartyOptions="partyOptions"
                                       Requests="staffingRequests"
                                       SaveRequest="SaveStaffingRequestAsync"
                                       ResetRequest="ResetStaffingRequestAsync"
                                       DeleteRequest="DeleteStaffingRequestAsync" />

                <ProjectAllocationEditor Draft="allocationDraft"
                                         PartyOptions="partyOptions"
                                         Allocations="AllocationAssignments"
                                         SkillCatalog="skillCatalog"
                                         Candidates="staffingCandidates"
                                         CandidateSearchText="candidateSearchText"
                                         CandidateSearchTextChanged="HandleCandidateSearchTextChanged"
                                         CandidateSkillFilter="candidateSkillFilter"
                                         CandidateSkillFilterChanged="HandleCandidateSkillFilterChanged"
                                         CandidateAvailabilityFilter="candidateAvailabilityFilter"
                                         CandidateAvailabilityFilterChanged="HandleCandidateAvailabilityFilterChanged"
                                         SearchCandidates="SearchCandidatesAsync"
                                         ResetCandidateFilters="ResetCandidateFiltersAsync"
                                         SaveAllocation="SaveAllocationAsync"
                                         ResetAllocation="ResetAllocationAsync"
                                         DeleteAllocation="DeleteAllocationAsync" />
            </Grid>
        </Stack>
    </ChildContent>
</PageScaffold>

@code {
    [SupplyParameterFromQuery(Name = "projectId")]
    public Guid? ProjectIdQuery { get; set; }

    private IReadOnlyList<ProjectSummary> projectSummaries = [];
    private IReadOnlyList<ProjectPartyOption> partyOptions = [];
    private IReadOnlyList<ProjectPartyAssignmentDetail> assignments = [];
    private IReadOnlyList<SkillCatalogItemModel> skillCatalog = [];
    private IReadOnlyList<StaffingRequestItemModel> staffingRequests = [];
    private IReadOnlyList<StaffingCandidateItemModel> staffingCandidates = [];
    private StaffingDashboardModel staffingDashboard = new(0, 0m, 0, 0);
    private Guid? selectedProjectId;
    private Guid? handledProjectId;
    private string candidateSearchText = string.Empty;
    private string candidateSkillFilter = string.Empty;
    private string candidateAvailabilityFilter = string.Empty;
    private ProjectPartyAssignmentUpsertRequest draftAssignment = CreateProjectAssignmentDraft();
    private ProjectPartyAssignmentUpsertRequest allocationDraft = CreateAllocationDraft();
    private StaffingRequestEditorModel staffingRequestDraft = CreateStaffingRequestDraft();

    private IReadOnlyList<ProjectPartyAssignmentDetail> AllocationAssignments => assignments
        .Where(item =>
            item.AllocationPercent.HasValue
            || item.Role is ProjectPartyAssignmentRole.TeamMember
                or ProjectPartyAssignmentRole.DeliveryUnit
                or ProjectPartyAssignmentRole.Manager
                or ProjectPartyAssignmentRole.AiAgent
                or ProjectPartyAssignmentRole.Reviewer
                or ProjectPartyAssignmentRole.WorkItemAssignee)
        .OrderByDescending(item => item.IsPrimary)
        .ThenBy(item => item.PartyDisplayName, StringComparer.OrdinalIgnoreCase)
        .ToList();

    protected override async Task OnParametersSetAsync()
    {
        projectSummaries = await ProjectsService.ListAsync();
        if (!selectedProjectId.HasValue && ProjectIdQuery.HasValue)
        {
            selectedProjectId = ProjectIdQuery.Value;
        }
        else if (!selectedProjectId.HasValue && projectSummaries.Count > 0)
        {
            selectedProjectId = projectSummaries[0].Id;
        }

        if (handledProjectId != selectedProjectId)
        {
            handledProjectId = selectedProjectId;
            await ReloadSelectionAsync();
        }
    }

    private async Task HandleProjectChanged(Guid? projectId)
    {
        selectedProjectId = projectId;
        handledProjectId = projectId;
        await ReloadSelectionAsync();
    }

    private async Task ReloadSelectionAsync()
    {
        skillCatalog = await HrService.ListSkillCatalogAsync();
        staffingDashboard = await HrService.GetStaffingDashboardAsync();

        if (!selectedProjectId.HasValue)
        {
            partyOptions = [];
            assignments = [];
            staffingRequests = [];
            staffingCandidates = [];
            ResetDraft();
            ResetAllocationDraft();
            ResetStaffingRequestDraft();
            return;
        }

        partyOptions = await ProjectPartyIntegrationService.ListPartyOptionsAsync(selectedProjectId.Value);
        assignments = await ProjectPartyIntegrationService.ListAssignmentsDetailedAsync(selectedProjectId.Value);
        staffingRequests = await HrService.ListStaffingRequestsAsync(selectedProjectId.Value);
        await LoadStaffingCandidatesAsync();
        ResetDraft();
        ResetAllocationDraft();
        ResetStaffingRequestDraft();
    }

    private async Task LoadStaffingCandidatesAsync()
    {
        staffingCandidates = await HrService.SearchStaffingCandidatesAsync(
            ResolveCandidateSkillId(),
            candidateSearchText,
            ResolveCandidateAvailabilityState());
    }

    private Guid? ResolveCandidateSkillId()
    {
        return Guid.TryParse(candidateSkillFilter, out var skillId) ? skillId : null;
    }

    private WorkforceAvailabilityState? ResolveCandidateAvailabilityState()
    {
        return Enum.TryParse<WorkforceAvailabilityState>(candidateAvailabilityFilter, out var availabilityState)
            ? availabilityState
            : null;
    }

    private async Task SaveDraftAsync()
    {
        if (!selectedProjectId.HasValue)
        {
            NotificationService.Warning("Assignment not saved", "Choose a project before saving an assignment.");
            return;
        }

        draftAssignment.ProjectId = selectedProjectId.Value;
        var result = await ProjectPartyIntegrationService.SaveAssignmentAsync(draftAssignment);
        if (!result.IsSuccess)
        {
            NotificationService.Error("Assignment save failed", result.Errors.FirstOrDefault()?.Message ?? "Unable to save the assignment.");
            return;
        }

        NotificationService.Success("Assignment saved", "Project assignment saved.");
        await ReloadSelectionAsync();
    }

    private async Task SaveAllocationAsync()
    {
        if (!selectedProjectId.HasValue)
        {
            NotificationService.Warning("Allocation not saved", "Choose a project before saving an allocation.");
            return;
        }

        allocationDraft.ProjectId = selectedProjectId.Value;
        allocationDraft.Source = "crm-hr-ui";
        var result = await ProjectPartyIntegrationService.SaveAssignmentAsync(allocationDraft);
        if (!result.IsSuccess)
        {
            NotificationService.Error("Allocation save failed", result.Errors.FirstOrDefault()?.Message ?? "Unable to save the allocation.");
            return;
        }

        NotificationService.Success("Allocation saved", "Project allocation saved.");
        await ReloadSelectionAsync();
    }

    private async Task SaveStaffingRequestAsync()
    {
        staffingRequestDraft.ProjectId = selectedProjectId;
        var result = await HrService.SaveStaffingRequestAsync(staffingRequestDraft);
        if (result.IsFailure)
        {
            NotificationService.Error("Staffing request save failed", string.Join(" ", result.Errors.Select(error => error.Message)));
            return;
        }

        NotificationService.Success("Staffing request saved", "Staffing request saved.");
        await ReloadSelectionAsync();
    }

    private async Task SearchCandidatesAsync()
    {
        await LoadStaffingCandidatesAsync();
    }

    private Task HandleCandidateSearchTextChanged(string value)
    {
        candidateSearchText = value;
        return Task.CompletedTask;
    }

    private Task HandleCandidateSkillFilterChanged(string value)
    {
        candidateSkillFilter = value;
        return Task.CompletedTask;
    }

    private Task HandleCandidateAvailabilityFilterChanged(string value)
    {
        candidateAvailabilityFilter = value;
        return Task.CompletedTask;
    }

    private async Task ResetDraftAsync()
    {
        ResetDraft();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ResetAllocationAsync()
    {
        ResetAllocationDraft();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ResetStaffingRequestAsync()
    {
        ResetStaffingRequestDraft();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ResetCandidateFiltersAsync()
    {
        candidateSearchText = string.Empty;
        candidateSkillFilter = string.Empty;
        candidateAvailabilityFilter = string.Empty;
        await LoadStaffingCandidatesAsync();
    }

    private async Task DeleteAssignmentAsync(Guid assignmentId)
    {
        await ProjectPartyIntegrationService.DeleteAssignmentAsync(assignmentId);
        NotificationService.Warning("Assignment deleted", "Project assignment deleted.");
        await ReloadSelectionAsync();
    }

    private async Task DeleteAllocationAsync(Guid assignmentId)
    {
        await ProjectPartyIntegrationService.DeleteAssignmentAsync(assignmentId);
        NotificationService.Warning("Allocation deleted", "Project allocation deleted.");
        await ReloadSelectionAsync();
    }

    private async Task DeleteStaffingRequestAsync(Guid staffingRequestId)
    {
        await HrService.DeleteStaffingRequestAsync(staffingRequestId);
        NotificationService.Warning("Staffing request deleted", "Staffing request deleted.");
        await ReloadSelectionAsync();
    }

    private Task OpenStructure(Guid projectId)
    {
        Navigation.NavigateTo($"/projects/{projectId}/structure");
        return Task.CompletedTask;
    }

    private void ResetDraft()
    {
        draftAssignment = CreateProjectAssignmentDraft(selectedProjectId);
    }

    private void ResetAllocationDraft()
    {
        allocationDraft = CreateAllocationDraft(selectedProjectId);
    }

    private void ResetStaffingRequestDraft()
    {
        staffingRequestDraft = CreateStaffingRequestDraft(selectedProjectId);
    }

    private static ProjectPartyAssignmentUpsertRequest CreateProjectAssignmentDraft(Guid? projectId = null)
    {
        return new ProjectPartyAssignmentUpsertRequest
        {
            ProjectId = projectId ?? Guid.Empty,
            Role = ProjectPartyAssignmentRole.Customer,
            Source = "crm-hr-ui",
            IsPrimary = true
        };
    }

    private static ProjectPartyAssignmentUpsertRequest CreateAllocationDraft(Guid? projectId = null)
    {
        return new ProjectPartyAssignmentUpsertRequest
        {
            ProjectId = projectId ?? Guid.Empty,
            Role = ProjectPartyAssignmentRole.TeamMember,
            Source = "crm-hr-ui",
            IsPrimary = false,
            AllocationPercent = 100m
        };
    }

    private static StaffingRequestEditorModel CreateStaffingRequestDraft(Guid? projectId = null)
    {
        return new StaffingRequestEditorModel
        {
            ProjectId = projectId,
            AllocationPercent = 100m,
            Status = StaffingRequestStatus.Open
        };
    }
}

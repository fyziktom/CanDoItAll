@page "/crm-hr/directory"
@inject PartyDirectoryService PartyDirectoryService
@inject PartyDirectoryManagementService ManagementService
@inject NavigationManager Navigation
@inject NotificationService NotificationService

<PageTitle>CRM / HR Directory</PageTitle>

<PageScaffold MaxWidthClass="max-w-full">
    <Header>
        <PageHeader Eyebrow="CRM / HR"
                    Title="Party directory"
                    Description="Create and maintain shared party records for people, organizations, delivery units, and AI agents before downstream CRM or HR workflows branch into specialized screens."
                    Compact="true">
            <Stats>
                <CompactStat Label="directory"
                             Value="@directoryItems.Count.ToString()"
                             TooltipText="All saved party records in the shared directory." />
                <CompactStat Label="visible"
                             Value="@FilteredParties.Count.ToString()"
                             TooltipText="Records matching the current filters."
                             Tone="info" />
                <CompactStat Label="organizations"
                             Value="@directoryItems.Count(item => item.PartyType == PartyType.Organization || item.PartyType == PartyType.OrganizationUnit).ToString()"
                             TooltipText="Organization and unit records available to CRM and HR."
                             Tone="success" />
                <CompactStat Label="sensitive"
                             Value="@directoryItems.Count(item => item.IsSensitive).ToString()"
                             TooltipText="Records that require careful downstream handling."
                             Tone="warning" />
            </Stats>
            <Actions>
                <PageHeaderActionButton Icon="person_add"
                                        Label="New party"
                                        TooltipText="Create a new shared party record."
                                        ButtonStyle="ButtonStyle.Primary"
                                        Click="CreateNewAsync"
                                        data-testid="crmhr-directory-new-button" />
            </Actions>
        </PageHeader>
    </Header>

    <ChildContent>
        <Stack GapScale="LayoutGap.Large">
            <CrmHrSecondaryTabs SelectedKey="directory" />

            <PartyImportExportActions ExportPartyIds="@FilteredParties.Select(item => item.Id).ToList()"
                                      ImportApplied="HandleImportAppliedAsync" />

            <ListDetailShell ListPaneWidth="27rem">
                <ListHeader>
                    <ListPanelHeader Title="Directory"
                                     Description="Search by name, role, tag, email, phone, or code, then continue editing the selected party in place."
                                     Count="@($"{FilteredParties.Count} record(s)")">
                        <Filters>
                            <FilterBar ResultText="@($"{FilteredParties.Count} matching record(s)")">
                                <input @bind="searchText"
                                       @bind:event="oninput"
                                       class="cda-input min-w-[16rem] flex-1"
                                       placeholder="Search name, role, tag, email, phone, or code"
                                       data-testid="crmhr-directory-search" />
                                <InputSelect @bind-Value="typeFilter"
                                             class="cda-input"
                                             data-testid="crmhr-directory-type-filter">
                                    <option value="">All types</option>
                                    @foreach (var partyType in Enum.GetValues<PartyType>())
                                    {
                                        <option value="@partyType.ToString()">@partyType</option>
                                    }
                                </InputSelect>
                                <InputSelect @bind-Value="statusFilter"
                                             class="cda-input"
                                             data-testid="crmhr-directory-status-filter">
                                    <option value="">All statuses</option>
                                    @foreach (var lifecycleStatus in Enum.GetValues<PartyLifecycleStatus>())
                                    {
                                        <option value="@lifecycleStatus.ToString()">@lifecycleStatus</option>
                                    }
                                </InputSelect>
                                <Button Text="Reset"
                                        ButtonStyle="ButtonStyle.Light"
                                        Size="ButtonSize.Small"
                                        Click="ResetFilters" />
                            </FilterBar>
                        </Filters>
                    </ListPanelHeader>
                </ListHeader>

                <ListContent>
                    @if (FilteredParties.Count == 0)
                    {
                        <EmptyState Eyebrow="Directory is empty"
                                    Title="Create the first shared party record"
                                    Description="The shell route is ready. Save a party here to prove the CRM / HR module persists and reloads correctly.">
                            <Actions>
                                <Button Text="Create party"
                                        Click="CreateNewAsync" />
                            </Actions>
                        </EmptyState>
                    }
                    else
                    {
                        <Stack GapScale="LayoutGap.Medium">
                            @foreach (var item in FilteredParties)
                            {
                                <div data-testid="crmhr-directory-item">
                                    <SelectionListItem Title="@item.DisplayName"
                                                       Eyebrow="@item.PartyType.ToString()"
                                                       Meta="@BuildMeta(item)"
                                                       Summary="@BuildSummary(item)"
                                                       IsSelected="@(editor.Id == item.Id)"
                                                       OnSelect="@(() => SelectPartyAsync(item.Id))">
                                        <Status>
                                            <Cluster Gap="LayoutGap.Small">
                                                <StatusBadge Tone="@ResolveStatusTone(item.LifecycleStatus)" Text="@item.LifecycleStatus.ToString()" />
                                                @if (item.IsSensitive)
                                                {
                                                    <StatusBadge Tone="warning" Text="Sensitive" />
                                                }
                                            </Cluster>
                                        </Status>
                                    </SelectionListItem>
                                </div>
                            }
                        </Stack>
                    }
                </ListContent>

                <DetailHeader>
                    <Stack GapScale="LayoutGap.Medium">
                        <Split Gap="LayoutGap.Medium">
                            <Stack GapScale="LayoutGap.Tiny">
                                <p class="cda-eyebrow">Party editor</p>
                                <h2 class="cda-title-xl">@EditorTitle</h2>
                                <p class="cda-body-muted">Keep one durable identity record here before opportunity, workforce, recruiting, or assignment flows attach their own details.</p>
                            </Stack>
                            <Cluster Gap="LayoutGap.Small">
                                <StatusBadge Tone="@ResolveStatusTone(editor.LifecycleStatus)" Text="@editor.LifecycleStatus.ToString()" />
                                <StatusBadge Tone="neutral" Text="@editor.PartyType.ToString()" />
                                @if (editor.IsSensitive)
                                {
                                    <StatusBadge Tone="warning" Text="Sensitive" />
                                }
                            </Cluster>
                        </Split>

                        <div class="rounded-[1.25rem] border border-slate-200 bg-slate-50/90 px-4 py-4">
                            <p class="cda-eyebrow">Directory stewardship</p>
                            <p class="mt-2 text-sm leading-6 text-slate-700">
                                This directory now owns shared identity details, addresses, relationships, duplicate handling, and CSV stewardship so later CRM and HR screens can build on one trusted party record.
                            </p>
                        </div>
                    </Stack>
                </DetailHeader>

                <DetailContent>
                    <EditForm Model="editor" OnValidSubmit="SaveAsync">
                        <Stack Class="min-h-full" GapScale="LayoutGap.XXLarge">
                            <FormSection Title="Identity"
                                         Description="Capture the durable identity fields that let one record participate in CRM, HR, recruiting, and AI-agent flows.">
                                <Grid Gap="LayoutGap.Large" ColumnsMd="3">
                                    <div>
                                        <label class="cda-field-label">Type</label>
                                        <InputSelect @bind-Value="editor.PartyType"
                                                     class="cda-input"
                                                     data-testid="crmhr-party-type">
                                            @foreach (var partyType in Enum.GetValues<PartyType>())
                                            {
                                                <option value="@partyType">@partyType</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <div>
                                        <label class="cda-field-label">Status</label>
                                        <InputSelect @bind-Value="editor.LifecycleStatus"
                                                     class="cda-input"
                                                     data-testid="crmhr-party-status">
                                            @foreach (var lifecycleStatus in Enum.GetValues<PartyLifecycleStatus>())
                                            {
                                                <option value="@lifecycleStatus">@lifecycleStatus</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <div>
                                        <label class="cda-field-label">External code</label>
                                        <InputText @bind-Value="editor.ExternalCode"
                                                   class="cda-input"
                                                   data-testid="crmhr-party-external-code" />
                                    </div>
                                </Grid>

                                <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                    <div>
                                        <label class="cda-field-label">Display name</label>
                                        <InputText @bind-Value="editor.DisplayName"
                                                   class="cda-input"
                                                   data-testid="crmhr-party-display-name" />
                                    </div>
                                    <div>
                                        <label class="cda-field-label">Preferred name</label>
                                        <InputText @bind-Value="editor.PreferredName"
                                                   class="cda-input"
                                                   data-testid="crmhr-party-preferred-name" />
                                    </div>
                                </Grid>

                                <div>
                                    <label class="cda-field-label">Legal name</label>
                                    <InputText @bind-Value="editor.LegalName"
                                               class="cda-input"
                                               data-testid="crmhr-party-legal-name" />
                                </div>
                            </FormSection>

                            <FormSection Title="Classification and contact"
                                         Description="Keep role, tags, and direct contact details near the core identity so CRM, HR, and recruiting flows all start from the same party record.">
                                <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                    <div>
                                        <label class="cda-field-label">Primary role</label>
                                        <InputSelect @bind-Value="editor.PrimaryRoleKindText"
                                                     class="cda-input"
                                                     data-testid="crmhr-party-role">
                                            <option value="">No primary role yet</option>
                                            @foreach (var roleKind in Enum.GetValues<PartyRoleKind>())
                                            {
                                                <option value="@roleKind.ToString()">@roleKind</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <div>
                                        <label class="cda-field-label">Tags</label>
                                        <InputText @bind-Value="editor.TagsText"
                                                   class="cda-input"
                                                   placeholder="customer, priority, berlin"
                                                   data-testid="crmhr-party-tags" />
                                    </div>
                                </Grid>

                                <Grid Gap="LayoutGap.Large" ColumnsMd="2">
                                    <div>
                                        <label class="cda-field-label">Primary email</label>
                                        <InputText @bind-Value="editor.PrimaryEmail"
                                                   class="cda-input"
                                                   data-testid="crmhr-party-email" />
                                    </div>
                                    <div>
                                        <label class="cda-field-label">Primary phone</label>
                                        <InputText @bind-Value="editor.PrimaryPhone"
                                                   class="cda-input"
                                                   data-testid="crmhr-party-phone" />
                                    </div>
                                </Grid>

                                <Stack GapScale="LayoutGap.Medium" Class="mt-5">
                                    <Split Gap="LayoutGap.Medium"
                                           AlignItems="AlignItems.Center"
                                           JustifyContent="JustifyContent.SpaceBetween">
                                        <div>
                                            <p class="cda-eyebrow">Additional role assignments</p>
                                            <p class="mt-1 text-sm leading-6 text-slate-600">Keep more than one business role on the same party instead of creating duplicate directory records.</p>
                                        </div>
                                        <Button Text="Add role"
                                                ButtonStyle="ButtonStyle.Light"
                                                Size="ButtonSize.Small"
                                                Click="AddAdditionalRole"
                                                data-testid="crmhr-party-role-add" />
                                    </Split>

                                    @if (editor.AdditionalRoles.Count == 0)
                                    {
                                        <div class="rounded-[1.25rem] border border-dashed border-slate-300 bg-slate-50/70 px-4 py-4 text-sm leading-6 text-slate-600">
                                            No secondary roles defined yet.
                                        </div>
                                    }
                                    else
                                    {
                                        @for (var index = 0; index < editor.AdditionalRoles.Count; index++)
                                        {
                                            var role = editor.AdditionalRoles[index];
                                            <PanelCard Soft="true">
                                                <Grid Gap="LayoutGap.Medium" ColumnsLg="4">
                                                    <div>
                                                        <label class="cda-field-label">Role kind</label>
                                                        <InputSelect @bind-Value="role.RoleKind"
                                                                     class="cda-input"
                                                                     data-testid="@($"crmhr-party-extra-role-kind-{index}")">
                                                            @foreach (var roleKind in Enum.GetValues<PartyRoleKind>())
                                                            {
                                                                <option value="@roleKind">@roleKind</option>
                                                            }
                                                        </InputSelect>
                                                    </div>
                                                    <div class="lg:col-span-2">
                                                        <label class="cda-field-label">Role title</label>
                                                        <InputText @bind-Value="role.Title"
                                                                   class="cda-input"
                                                                   data-testid="@($"crmhr-party-extra-role-title-{index}")" />
                                                    </div>
                                                    <div class="flex items-end justify-end">
                                                        <Button Text="Remove"
                                                                ButtonStyle="ButtonStyle.Danger"
                                                                Size="ButtonSize.Small"
                                                                Click="@(() => RemoveAdditionalRole(index))"
                                                                data-testid="@($"crmhr-party-extra-role-remove-{index}")" />
                                                    </div>
                                                </Grid>

                                                <Grid Gap="LayoutGap.Medium" ColumnsLg="3" Class="mt-4">
                                                    <div>
                                                        <label class="cda-field-label">Valid from</label>
                                                        <InputDate @bind-Value="role.ValidFromUtc"
                                                                   class="cda-input"
                                                                   data-testid="@($"crmhr-party-extra-role-start-{index}")" />
                                                    </div>
                                                    <div>
                                                        <label class="cda-field-label">Valid to</label>
                                                        <InputDate @bind-Value="role.ValidToUtc"
                                                                   class="cda-input"
                                                                   data-testid="@($"crmhr-party-extra-role-end-{index}")" />
                                                    </div>
                                                    <div>
                                                        <label class="cda-field-label">Notes</label>
                                                        <InputText @bind-Value="role.Notes"
                                                                   class="cda-input"
                                                                   data-testid="@($"crmhr-party-extra-role-notes-{index}")" />
                                                    </div>
                                                </Grid>
                                            </PanelCard>
                                        }
                                    }
                                </Stack>

                                <div>
                                    <label class="cda-field-label">Summary</label>
                                    <InputTextArea @bind-Value="editor.Summary"
                                                   class="cda-input cda-input--textarea min-h-24"
                                                   data-testid="crmhr-party-summary" />
                                </div>
                            </FormSection>

                            <FormSection Title="Contact methods and addresses"
                                         Description="Keep secondary contact methods and structured addresses on the shared party record so downstream screens do not need their own copies.">
                                <Stack GapScale="LayoutGap.XLarge">
                                    <PartyContactMethodsEditor ContactPoints="editor.AdditionalContactPoints" />
                                    <PartyAddressesEditor Addresses="editor.Addresses" />
                                </Stack>
                            </FormSection>

                            <FormSection Title="Context and handling"
                                         Description="Keep operational context visible on the shared party record while timeline, opportunity, workforce, and assignment flows layer on later.">
                                @if (editor.Id.HasValue)
                                {
                                    <SensitiveDataCallout IsSensitive="editor.IsSensitive"
                                                         LastChangedBy="@editor.LastChangedBy"
                                                         UpdatedAtUtc="editor.UpdatedAtUtc"
                                                         DataTestId="crmhr-directory-sensitive-callout" />
                                }

                                <Grid Gap="LayoutGap.Large" ColumnsMd="3">
                                    <div>
                                        <label class="cda-field-label">Region</label>
                                        <InputText @bind-Value="editor.Region"
                                                   class="cda-input"
                                                   data-testid="crmhr-party-region" />
                                    </div>
                                    <div>
                                        <label class="cda-field-label">Country code</label>
                                        <InputText @bind-Value="editor.CountryCode"
                                                   class="cda-input"
                                                   data-testid="crmhr-party-country" />
                                    </div>
                                    <div>
                                        <label class="cda-field-label">Time zone</label>
                                        <InputText @bind-Value="editor.TimeZone"
                                                   class="cda-input"
                                                   data-testid="crmhr-party-timezone" />
                                    </div>
                                </Grid>

                                <label class="cda-inline-option">
                                    <InputCheckbox @bind-Value="editor.IsSensitive"
                                                   data-testid="crmhr-party-sensitive" />
                                    Mark as sensitive
                                </label>

                                <div>
                                    <label class="cda-field-label">Operational notes</label>
                                    <InputTextArea @bind-Value="editor.Notes"
                                                   class="cda-input cda-input--textarea min-h-28"
                                                   data-testid="crmhr-party-notes" />
                                </div>

                                <div class="rounded-[1.25rem] border border-slate-200 bg-slate-50/80 px-4 py-4"
                                     data-testid="crmhr-confidential-notes-panel">
                                    <Split Gap="LayoutGap.Medium"
                                           AlignItems="AlignItems.Start"
                                           JustifyContent="JustifyContent.SpaceBetween">
                                        <div class="min-w-0">
                                            <p class="cda-eyebrow">Confidential notes</p>
                                            <h3 class="mt-1 text-lg font-semibold text-slate-950">HR-only and sensitive note stream</h3>
                                            <p class="mt-3 text-sm leading-6 text-slate-600">
                                                Keep high-sensitivity notes separate from broad operational context so downstream CRM-HR screens do not overexpose private detail.
                                            </p>
                                        </div>
                                        <Button Text="Add confidential note"
                                                ButtonStyle="ButtonStyle.Light"
                                                Size="ButtonSize.Small"
                                                Type="button"
                                                Disabled="@(!editor.IsSensitive)"
                                                Click="AddConfidentialNote"
                                                data-testid="crmhr-confidential-note-add" />
                                    </Split>

                                    @if (!editor.IsSensitive)
                                    {
                                        <div class="mt-4 rounded-[1rem] border border-amber-200 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-800">
                                            Mark this record as sensitive before storing confidential notes.
                                        </div>
                                    }
                                    else if (editor.ConfidentialNotes.Count == 0)
                                    {
                                        <div class="mt-4 rounded-[1rem] border border-dashed border-slate-300 bg-white/80 px-4 py-4 text-sm leading-6 text-slate-600">
                                            No confidential notes stored yet.
                                        </div>
                                    }
                                    else
                                    {
                                        <Stack GapScale="LayoutGap.Medium" Class="mt-4">
                                            @for (var index = 0; index < editor.ConfidentialNotes.Count; index++)
                                            {
                                                var note = editor.ConfidentialNotes[index];
                                                <div class="rounded-[1rem] border border-slate-200 bg-white px-4 py-4"
                                                     data-testid="crmhr-confidential-note-item">
                                                    <Grid Gap="LayoutGap.Medium" ColumnsMd="4">
                                                        <div>
                                                            <label class="cda-field-label">Category</label>
                                                            <InputSelect @bind-Value="note.Category"
                                                                         class="cda-input"
                                                                         data-testid="@($"crmhr-confidential-note-category-{index}")">
                                                                @foreach (var category in ConfidentialNoteCategories)
                                                                {
                                                                    <option value="@category">@category</option>
                                                                }
                                                            </InputSelect>
                                                        </div>
                                                        <div class="md:col-span-2">
                                                            <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Stewardship</p>
                                                            <p class="mt-1 text-sm leading-6 text-slate-700">
                                                                Created @FormatMoment(note.CreatedAtUtc) by @FormatActor(note.CreatedBy)
                                                            </p>
                                                            <p class="text-sm leading-6 text-slate-600">
                                                                Updated @FormatMoment(note.UpdatedAtUtc)
                                                            </p>
                                                        </div>
                                                        <div class="flex items-start justify-end">
                                                            <Button Text="Remove"
                                                                    ButtonStyle="ButtonStyle.Danger"
                                                                    Size="ButtonSize.Small"
                                                                    Type="button"
                                                                    Click="@(() => RemoveConfidentialNote(index))"
                                                                    data-testid="@($"crmhr-confidential-note-remove-{index}")" />
                                                        </div>
                                                    </Grid>

                                                    <div class="mt-4">
                                                        <label class="cda-field-label">Confidential note</label>
                                                        <InputTextArea @bind-Value="note.NoteText"
                                                                       class="cda-input cda-input--textarea min-h-24"
                                                                       data-testid="@($"crmhr-confidential-note-text-{index}")" />
                                                    </div>
                                                </div>
                                            }
                                        </Stack>
                                    }
                                </div>

                                <Stack GapScale="LayoutGap.XLarge">
                                    <InteractionTimeline Items="activityTimeline"
                                                        Eyebrow="Party history"
                                                        Title="Recent interactions, changes, and follow-ups"
                                                        Description="Directory edits, CRM interactions, recruiting state changes, and workforce or AI updates stay visible in one place for the selected party."
                                                        EmptyEyebrow="No party activity"
                                                        EmptyTitle="No saved activity for this party"
                                                        EmptyDescription="Save the party and related CRM-HR workflows to start building a shared history." />

                                    <SurfaceCard>
                                        <p class="cda-eyebrow">Project assignments</p>
                                        <h3 class="mt-1 text-lg font-semibold text-slate-950">Assignments and delivery context</h3>
                                        <p class="mt-3 text-sm leading-6 text-slate-600">
                                            Project-party links stay visible here so staffing, ownership, and stakeholder context do not require a separate workbench pass.
                                        </p>

                                        @if (projectAssignments.Count == 0)
                                        {
                                            <div class="mt-5">
                                                <EmptyState Eyebrow="No assignments"
                                                            Title="This party is not linked to a project yet"
                                                            Description="Project, staffing, and stakeholder assignments will appear here after they are saved from project-aware flows." />
                                            </div>
                                        }
                                        else
                                        {
                                            <Stack GapScale="LayoutGap.Small" Class="mt-5">
                                                @foreach (var assignment in projectAssignments)
                                                {
                                                    <div class="rounded-[1.25rem] border border-slate-200 bg-slate-50/80 px-4 py-4"
                                                         data-testid="crmhr-party-assignment-item">
                                                        <Split Gap="LayoutGap.Medium">
                                                            <div class="min-w-0">
                                                                <p class="text-sm font-semibold text-slate-950">@assignment.ProjectName</p>
                                                                <p class="mt-2 text-xs uppercase tracking-[0.18em] text-slate-500">@assignment.AssignmentKind / @assignment.NodeKey</p>
                                                                <p class="mt-2 text-xs text-slate-500">@BuildAssignmentSchedule(assignment)</p>
                                                                @if (!string.IsNullOrWhiteSpace(assignment.Notes))
                                                                {
                                                                    <p class="mt-3 text-sm leading-6 text-slate-600">@assignment.Notes</p>
                                                                }
                                                            </div>
                                                            <Cluster Gap="LayoutGap.Small">
                                                                @if (assignment.IsPrimary)
                                                                {
                                                                    <StatusBadge Tone="success" Text="Primary" />
                                                                }
                                                                @if (assignment.AllocationPercent.HasValue)
                                                                {
                                                                    <StatusBadge Tone="info" Text="@($"{assignment.AllocationPercent.Value:0.##}%")" />
                                                                }
                                                            </Cluster>
                                                        </Split>
                                                    </div>
                                                }
                                            </Stack>
                                        }
                                    </SurfaceCard>
                                </Stack>
                            </FormSection>

                            <FormSection Title="Relationships and duplicate stewardship"
                                         Description="Model org structure and safe deduplication here so downstream CRM, workforce, recruiting, and assignment flows inherit trusted references.">
                                <Stack GapScale="LayoutGap.XLarge">
                                    <PartyRelationshipsEditor CurrentPartyId="editor.Id"
                                                             Relationships="relationships"
                                                             AvailableParties="RelationshipOptions" />

                                    @if (!editor.Id.HasValue)
                                    {
                                        <div class="rounded-[1.25rem] border border-dashed border-slate-300 bg-slate-50/70 px-4 py-4 text-sm leading-6 text-slate-600">
                                            Save the party first to evaluate duplicate candidates against persisted directory records.
                                        </div>
                                    }
                                    else
                                    {
                                        <Stack GapScale="LayoutGap.Medium">
                                            <Split Gap="LayoutGap.Medium"
                                                   AlignItems="AlignItems.Center"
                                                   JustifyContent="JustifyContent.SpaceBetween">
                                                <div>
                                                    <p class="cda-eyebrow">Potential duplicates</p>
                                                    <p class="mt-1 text-sm leading-6 text-slate-600">Candidates are ranked by external code, normalized names, and contact value overlap.</p>
                                                </div>
                                                <StatusBadge Tone="@(duplicateCandidates.Count == 0 ? "success" : "warning")"
                                                             Text="@(duplicateCandidates.Count == 0 ? "No duplicates" : $"{duplicateCandidates.Count} candidate(s)")" />
                                            </Split>

                                            @if (duplicateCandidates.Count == 0)
                                            {
                                                <div class="rounded-[1.25rem] border border-dashed border-slate-300 bg-slate-50/70 px-4 py-4 text-sm leading-6 text-slate-600">
                                                    No duplicate candidates are currently detected for this party.
                                                </div>
                                            }
                                            else
                                            {
                                                @foreach (var candidate in duplicateCandidates)
                                                {
                                                    <PanelCard Soft="true">
                                                        <Split Gap="LayoutGap.Medium"
                                                               AlignItems="AlignItems.Start"
                                                               JustifyContent="JustifyContent.SpaceBetween">
                                                            <div class="min-w-0">
                                                                <p class="text-sm font-semibold text-slate-950">@candidate.DisplayName</p>
                                                                <p class="mt-1 text-xs uppercase tracking-[0.18em] text-slate-500">@candidate.PartyType / @candidate.LifecycleStatus</p>
                                                                @if (!string.IsNullOrWhiteSpace(candidate.Summary))
                                                                {
                                                                    <p class="mt-3 text-sm leading-6 text-slate-700">@candidate.Summary</p>
                                                                }
                                                                <p class="mt-3 text-sm leading-6 text-slate-700">Reasons: @string.Join(", ", candidate.MatchReasons)</p>
                                                            </div>
                                                            <Button Text="Merge into current party"
                                                                    ButtonStyle="ButtonStyle.Warning"
                                                                    Size="ButtonSize.Small"
                                                                    Click="@(() => OpenMergeDialog(candidate))"
                                                                    data-testid="@($"crmhr-merge-open-{candidate.Id:N}")" />
                                                        </Split>
                                                    </PanelCard>
                                                }
                                            }
                                        </Stack>
                                    }
                                </Stack>
                            </FormSection>

                            <StickyActionFooter StatusLabel="Party save state"
                                                StatusTone="success">
                                <SecondaryActions>
                                    <Button Text="New party"
                                            ButtonStyle="ButtonStyle.Light"
                                            Click="CreateNewAsync" />
                                </SecondaryActions>
                                <PrimaryActions>
                                    <Button Text="Save party"
                                            Type="submit"
                                            data-testid="crmhr-party-save-button" />
                                </PrimaryActions>
                            </StickyActionFooter>
                        </Stack>
                    </EditForm>

                    <PartyMergeDialog IsOpen="@isMergeDialogOpen"
                                      CurrentPartyDisplayName="@editor.DisplayName"
                                      Candidate="@mergeCandidate"
                                      OnClose="HandleMergeCloseAsync"
                                      OnConfirm="HandleMergeConfirmAsync" />
                </DetailContent>
            </ListDetailShell>
        </Stack>
    </ChildContent>
</PageScaffold>

@code {
    [SupplyParameterFromQuery(Name = "partyId")]
    public Guid? PartyIdQuery { get; set; }

    private static readonly IReadOnlyList<string> ConfidentialNoteCategories = PartyConfidentialNoteCategories.All;

    private IReadOnlyList<PartyDirectoryListItemModel> directoryItems = [];
    private PartyEditorViewModel editor = PartyEditorViewModel.CreateNew();
    private List<PartyRelationshipEditorModel> relationships = [];
    private IReadOnlyList<PartyDuplicateCandidateModel> duplicateCandidates = [];
    private IReadOnlyList<CrmAccountActivityTimelineItemModel> activityTimeline = [];
    private IReadOnlyList<PartyProjectAssignmentItemModel> projectAssignments = [];
    private PartyDuplicateCandidateModel? mergeCandidate;
    private bool isMergeDialogOpen;
    private string? handledPartyKey;
    private string searchText = string.Empty;
    private string typeFilter = string.Empty;
    private string statusFilter = string.Empty;

    private IReadOnlyList<PartyDirectoryListItemModel> FilteredParties => directoryItems
        .Where(MatchesSearch)
        .Where(MatchesType)
        .Where(MatchesStatus)
        .ToList();

    private IReadOnlyList<PartyDirectoryListItemModel> RelationshipOptions => directoryItems
        .Where(item => item.Id != editor.Id)
        .ToList();

    private string EditorTitle => editor.Id.HasValue ? editor.DisplayName : "New party";

    protected override async Task OnParametersSetAsync()
    {
        var currentPartyKey = PartyIdQuery?.ToString("N") ?? "new";
        if (string.Equals(currentPartyKey, handledPartyKey, StringComparison.Ordinal) && directoryItems.Count > 0)
        {
            return;
        }

        handledPartyKey = currentPartyKey;
        await LoadAsync(PartyIdQuery);
    }

    private async Task LoadAsync(Guid? selectedPartyId, bool clearMessage = true)
    {
        directoryItems = await PartyDirectoryService.ListDirectoryAsync();

        if (selectedPartyId.HasValue)
        {
            await LoadEditorAsync(selectedPartyId.Value, clearMessage);
            return;
        }

        editor = PartyEditorViewModel.CreateNew();
        ResetDirectoryDetailState();
    }

    private async Task SelectPartyAsync(Guid partyId)
    {
        await LoadEditorAsync(partyId);
        Navigation.NavigateTo($"/crm-hr/directory?partyId={partyId}", replace: true);
    }

    private async Task LoadEditorAsync(Guid partyId, bool clearMessage = true)
    {
        var party = await PartyDirectoryService.GetPartyAsync(partyId);
        if (party is null)
        {
            editor = PartyEditorViewModel.CreateNew();
            ResetDirectoryDetailState();
        }
        else
        {
            editor = PartyEditorViewModel.FromEditorModel(party);
            await LoadDirectoryDetailStateAsync(partyId);
        }

    }

    private Task CreateNewAsync()
    {
        editor = PartyEditorViewModel.CreateNew();
        ResetDirectoryDetailState();
        handledPartyKey = "new";
        Navigation.NavigateTo("/crm-hr/directory", replace: true);
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        var result = await PartyDirectoryService.SavePartyAsync(editor.ToEditorModel());
        if (result.IsFailure)
        {
            NotificationService.Warning("Party was not saved", string.Join(" ", result.Errors.Select(error => error.Message)));
            return;
        }

        var savedPartyId = result.Value;
        editor.Id = savedPartyId;
        handledPartyKey = savedPartyId.ToString("N");

        var relationshipSaveResult = await ManagementService.SaveRelationshipsAsync(
            savedPartyId,
            relationships,
            editor.LastChangedBy);

        if (relationshipSaveResult.IsFailure)
        {
            directoryItems = await PartyDirectoryService.ListDirectoryAsync();
            duplicateCandidates = await ManagementService.FindPotentialDuplicatesAsync(savedPartyId);
            NotificationService.Warning(
                "Party saved with relationship issue",
                $"Relationships were not updated. {string.Join(" ", relationshipSaveResult.Errors.Select(error => error.Message))}");
            Navigation.NavigateTo($"/crm-hr/directory?partyId={savedPartyId}", replace: true);
            return;
        }

        NotificationService.Success("Party saved", "Party saved.");
        await LoadAsync(savedPartyId, clearMessage: false);
        Navigation.NavigateTo($"/crm-hr/directory?partyId={savedPartyId}", replace: true);
    }

    private async Task HandleImportAppliedAsync()
    {
        await LoadAsync(editor.Id, clearMessage: false);
    }

    private void AddAdditionalRole()
    {
        editor.AdditionalRoles.Add(new PartyRoleAssignmentEditorModel
        {
            RoleKind = PartyRoleKind.Stakeholder,
            Title = "Stakeholder"
        });
    }

    private void AddConfidentialNote()
    {
        editor.ConfidentialNotes.Add(new PartyConfidentialNoteEditorModel
        {
            Category = PartyConfidentialNoteCategories.HumanResources,
            CreatedBy = editor.LastChangedBy,
            CreatedAtUtc = DateTimeOffset.UtcNow,
            UpdatedAtUtc = DateTimeOffset.UtcNow
        });
    }

    private void RemoveAdditionalRole(int index)
    {
        editor.AdditionalRoles.RemoveAt(index);
    }

    private void RemoveConfidentialNote(int index)
    {
        editor.ConfidentialNotes.RemoveAt(index);
    }

    private void OpenMergeDialog(PartyDuplicateCandidateModel candidate)
    {
        mergeCandidate = candidate;
        isMergeDialogOpen = true;
    }

    private Task HandleMergeCloseAsync()
    {
        isMergeDialogOpen = false;
        mergeCandidate = null;
        return Task.CompletedTask;
    }

    private async Task HandleMergeConfirmAsync(string reason)
    {
        if (editor.Id is not Guid retainedPartyId || mergeCandidate is null)
        {
            return;
        }

        var result = await ManagementService.MergePartyAsync(
            retainedPartyId,
            mergeCandidate.Id,
            editor.LastChangedBy,
            reason);

        if (result.IsFailure || result.Value is not PartyMergeSummaryModel summary)
        {
            NotificationService.Warning("Party merge failed", string.Join(" ", result.Errors.Select(error => error.Message)));
            return;
        }

        await HandleMergeCloseAsync();
        NotificationService.Success("Party merged", summary.Summary);
        handledPartyKey = retainedPartyId.ToString("N");
        await LoadAsync(retainedPartyId, clearMessage: false);
        Navigation.NavigateTo($"/crm-hr/directory?partyId={retainedPartyId}", replace: true);
    }

    private async Task LoadDirectoryDetailStateAsync(Guid partyId)
    {
        relationships = (await ManagementService.ListRelationshipsAsync(partyId))
            .Select(MapRelationship)
            .ToList();
        duplicateCandidates = await ManagementService.FindPotentialDuplicatesAsync(partyId);
        activityTimeline = await PartyDirectoryService.ListPartyActivityTimelineAsync(partyId);
        projectAssignments = await PartyDirectoryService.ListPartyProjectAssignmentsAsync(partyId);
        mergeCandidate = null;
        isMergeDialogOpen = false;
    }

    private void ResetDirectoryDetailState()
    {
        relationships = [];
        duplicateCandidates = [];
        activityTimeline = [];
        projectAssignments = [];
        mergeCandidate = null;
        isMergeDialogOpen = false;
    }

    private void ResetFilters()
    {
        searchText = string.Empty;
        typeFilter = string.Empty;
        statusFilter = string.Empty;
    }

    private bool MatchesSearch(PartyDirectoryListItemModel item)
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return true;
        }

        var normalizedSearch = searchText.Trim();
        return item.DisplayName.Contains(normalizedSearch, StringComparison.OrdinalIgnoreCase)
            || item.ExternalCode.Contains(normalizedSearch, StringComparison.OrdinalIgnoreCase)
            || item.Summary.Contains(normalizedSearch, StringComparison.OrdinalIgnoreCase)
            || item.PrimaryEmail.Contains(normalizedSearch, StringComparison.OrdinalIgnoreCase)
            || item.PrimaryPhone.Contains(normalizedSearch, StringComparison.OrdinalIgnoreCase)
            || item.Tags.Any(tag => tag.Contains(normalizedSearch, StringComparison.OrdinalIgnoreCase))
            || item.Roles.Any(role => role.ToString().Contains(normalizedSearch, StringComparison.OrdinalIgnoreCase));
    }

    private bool MatchesType(PartyDirectoryListItemModel item)
    {
        return string.IsNullOrWhiteSpace(typeFilter)
            || string.Equals(item.PartyType.ToString(), typeFilter, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesStatus(PartyDirectoryListItemModel item)
    {
        return string.IsNullOrWhiteSpace(statusFilter)
            || string.Equals(item.LifecycleStatus.ToString(), statusFilter, StringComparison.OrdinalIgnoreCase);
    }

    private static PartyRelationshipEditorModel MapRelationship(PartyRelationshipListItemModel relationship)
    {
        return new PartyRelationshipEditorModel
        {
            Id = relationship.Id,
            RelatedPartyId = relationship.RelatedPartyId,
            RelationshipKind = relationship.RelationshipKind,
            IsOutgoing = relationship.IsOutgoing,
            IsPrimary = relationship.IsPrimary,
            StartDateUtc = relationship.StartDateUtc,
            EndDateUtc = relationship.EndDateUtc,
            Notes = relationship.Notes
        };
    }

    private static string BuildMeta(PartyDirectoryListItemModel item)
    {
        var roleText = item.Roles.Count == 0
            ? item.PartyType == PartyType.AiAgent
                ? "AI agent"
                : "Unclassified"
            : string.Join(", ", item.Roles);
        var tagText = item.Tags.Count == 0 ? "No tags" : string.Join(", ", item.Tags);
        return $"{roleText} / {tagText}";
    }

    private static string BuildSummary(PartyDirectoryListItemModel item)
    {
        if (!string.IsNullOrWhiteSpace(item.PrimaryEmail))
        {
            return item.PrimaryEmail;
        }

        if (!string.IsNullOrWhiteSpace(item.PrimaryPhone))
        {
            return item.PrimaryPhone;
        }

        return string.IsNullOrWhiteSpace(item.Summary) ? item.ExternalCode : item.Summary;
    }

    private static string BuildAssignmentSchedule(PartyProjectAssignmentItemModel assignment)
    {
        var allocation = assignment.AllocationPercent.HasValue
            ? $"{assignment.AllocationPercent.Value:0.##}% allocation"
            : "No allocation set";
        var window = assignment.StartsOn.HasValue || assignment.EndsOn.HasValue
            ? $"{assignment.StartsOn?.ToString("d") ?? "Open"} -> {assignment.EndsOn?.ToString("d") ?? "Open"}"
            : "No schedule window";
        return $"{allocation} / {window}";
    }

    private static string ResolveStatusTone(PartyLifecycleStatus lifecycleStatus)
    {
        return lifecycleStatus switch
        {
            PartyLifecycleStatus.Active => "success",
            PartyLifecycleStatus.Candidate or PartyLifecycleStatus.Prospect => "info",
            PartyLifecycleStatus.Former or PartyLifecycleStatus.Inactive => "warning",
            PartyLifecycleStatus.Archived => "neutral",
            _ => "neutral"
        };
    }

    private static string FormatActor(string actor)
    {
        return string.IsNullOrWhiteSpace(actor) ? "Unknown" : actor;
    }

    private static string FormatMoment(DateTimeOffset value)
    {
        if (value == default)
        {
            return "not saved yet";
        }

        return value.LocalDateTime.ToString("g");
    }

    private sealed class PartyEditorViewModel
    {
        public Guid? Id { get; set; }

        public PartyType PartyType { get; set; } = PartyType.Person;

        public PartyLifecycleStatus LifecycleStatus { get; set; } = PartyLifecycleStatus.Draft;

        public string DisplayName { get; set; } = string.Empty;

        public string LegalName { get; set; } = string.Empty;

        public string PreferredName { get; set; } = string.Empty;

        public string ExternalCode { get; set; } = string.Empty;

        public string Summary { get; set; } = string.Empty;

        public string Notes { get; set; } = string.Empty;

        public string TagsText { get; set; } = string.Empty;

        public string Region { get; set; } = string.Empty;

        public string CountryCode { get; set; } = string.Empty;

        public string TimeZone { get; set; } = string.Empty;

        public bool IsSensitive { get; set; }

        public string ExtendedDataJson { get; set; } = "{}";

        public string LastChangedBy { get; set; } = "crm-hr-ui";

        public DateTimeOffset? UpdatedAtUtc { get; set; }

        public string PrimaryRoleKindText { get; set; } = string.Empty;

        public string PrimaryEmail { get; set; } = string.Empty;

        public string PrimaryPhone { get; set; } = string.Empty;

        public List<PartyRoleAssignmentEditorModel> AdditionalRoles { get; set; } = [];

        public List<PartyContactPointEditorModel> AdditionalContactPoints { get; set; } = [];

        public List<PartyAddressEditorModel> Addresses { get; set; } = [];

        public List<PartyConfidentialNoteEditorModel> ConfidentialNotes { get; set; } = [];

        public static PartyEditorViewModel CreateNew()
        {
            return new PartyEditorViewModel();
        }

        public static PartyEditorViewModel FromEditorModel(PartyEditorModel model)
        {
            var roles = model.Roles.Select(CloneRole).ToList();
            var primaryRoleIndex = FindPrimaryRoleIndex(roles);
            var primaryRole = primaryRoleIndex >= 0 ? roles[primaryRoleIndex] : null;

            var contactPoints = model.ContactPoints.Select(CloneContactPoint).ToList();
            var primaryEmailIndex = FindPrimaryContactIndex(contactPoints, PartyContactType.Email);
            var primaryPhoneIndex = FindPrimaryContactIndex(contactPoints, PartyContactType.Phone);

            return new PartyEditorViewModel
            {
                Id = model.Id,
                PartyType = model.PartyType,
                LifecycleStatus = model.LifecycleStatus,
                DisplayName = model.DisplayName,
                LegalName = model.LegalName,
                PreferredName = model.PreferredName,
                ExternalCode = model.ExternalCode,
                Summary = model.Summary,
                Notes = model.Notes,
                TagsText = string.Join(", ", model.Tags),
                Region = model.Region,
                CountryCode = model.CountryCode,
                TimeZone = model.TimeZone,
                IsSensitive = model.IsSensitive,
                ExtendedDataJson = model.ExtendedDataJson,
                LastChangedBy = string.IsNullOrWhiteSpace(model.LastChangedBy) ? "crm-hr-ui" : model.LastChangedBy,
                UpdatedAtUtc = model.UpdatedAtUtc,
                PrimaryRoleKindText = primaryRole?.RoleKind.ToString() ?? string.Empty,
                PrimaryEmail = primaryEmailIndex >= 0 ? contactPoints[primaryEmailIndex].Value : string.Empty,
                PrimaryPhone = primaryPhoneIndex >= 0 ? contactPoints[primaryPhoneIndex].Value : string.Empty,
                AdditionalRoles = roles
                    .Where((_, index) => index != primaryRoleIndex)
                    .Select(CloneRole)
                    .ToList(),
                AdditionalContactPoints = contactPoints
                    .Where((_, index) => index != primaryEmailIndex && index != primaryPhoneIndex)
                    .Select(CloneContactPoint)
                    .ToList(),
                Addresses = model.Addresses.Select(CloneAddress).ToList(),
                ConfidentialNotes = model.ConfidentialNotes.Select(CloneConfidentialNote).ToList()
            };
        }

        public PartyEditorModel ToEditorModel()
        {
            return new PartyEditorModel
            {
                Id = Id,
                PartyType = PartyType,
                LifecycleStatus = LifecycleStatus,
                DisplayName = DisplayName,
                LegalName = LegalName,
                PreferredName = PreferredName,
                ExternalCode = ExternalCode,
                Summary = Summary,
                Notes = Notes,
                Tags = TagsText
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .ToList(),
                Region = Region,
                CountryCode = CountryCode,
                TimeZone = TimeZone,
                IsSensitive = IsSensitive,
                ExtendedDataJson = string.IsNullOrWhiteSpace(ExtendedDataJson) ? "{}" : ExtendedDataJson,
                LastChangedBy = LastChangedBy,
                UpdatedAtUtc = UpdatedAtUtc,
                Roles = BuildRoles(),
                ContactPoints = BuildContactPoints(),
                Addresses = Addresses
                    .Where(address => !string.IsNullOrWhiteSpace(address.Line1))
                    .Select(CloneAddress)
                    .ToList(),
                ConfidentialNotes = ConfidentialNotes
                    .Where(note => !string.IsNullOrWhiteSpace(note.NoteText))
                    .Select(CloneConfidentialNote)
                    .ToList()
            };
        }

        private List<PartyRoleAssignmentEditorModel> BuildRoles()
        {
            var roles = new List<PartyRoleAssignmentEditorModel>();
            if (Enum.TryParse<PartyRoleKind>(PrimaryRoleKindText, ignoreCase: true, out var primaryRole))
            {
                roles.Add(new PartyRoleAssignmentEditorModel
                {
                    RoleKind = primaryRole,
                    Title = primaryRole.ToString(),
                    IsPrimary = true
                });
            }

            roles.AddRange(AdditionalRoles
                .Where(role => !string.IsNullOrWhiteSpace(role.Title) || Enum.IsDefined(role.RoleKind))
                .Select(role => new PartyRoleAssignmentEditorModel
                {
                    Id = role.Id,
                    RoleKind = role.RoleKind,
                    Title = string.IsNullOrWhiteSpace(role.Title) ? role.RoleKind.ToString() : role.Title.Trim(),
                    IsPrimary = false,
                    ValidFromUtc = role.ValidFromUtc,
                    ValidToUtc = role.ValidToUtc,
                    Notes = role.Notes.Trim()
                }));

            return roles;
        }

        private List<PartyContactPointEditorModel> BuildContactPoints()
        {
            var contactPoints = new List<PartyContactPointEditorModel>();
            AddPrimaryContactPoint(contactPoints, PartyContactType.Email, PrimaryEmail, "Primary email");
            AddPrimaryContactPoint(contactPoints, PartyContactType.Phone, PrimaryPhone, "Primary phone");

            contactPoints.AddRange(AdditionalContactPoints
                .Where(contactPoint => !string.IsNullOrWhiteSpace(contactPoint.Value))
                .Select(contactPoint => new PartyContactPointEditorModel
                {
                    Id = contactPoint.Id,
                    ContactType = contactPoint.ContactType,
                    Label = string.IsNullOrWhiteSpace(contactPoint.Label) ? contactPoint.ContactType.ToString() : contactPoint.Label.Trim(),
                    Value = contactPoint.Value.Trim(),
                    NormalizedValue = NormalizeContactValue(contactPoint.ContactType, contactPoint.Value),
                    IsPrimary = false,
                    IsPublic = contactPoint.IsPublic,
                    Notes = contactPoint.Notes.Trim()
                }));

            return contactPoints;
        }

        private static void AddPrimaryContactPoint(
            ICollection<PartyContactPointEditorModel> contactPoints,
            PartyContactType contactType,
            string value,
            string label)
        {
            if (string.IsNullOrWhiteSpace(value))
            {
                return;
            }

            contactPoints.Add(new PartyContactPointEditorModel
            {
                ContactType = contactType,
                Label = label,
                Value = value.Trim(),
                NormalizedValue = NormalizeContactValue(contactType, value),
                IsPrimary = true,
                IsPublic = true
            });
        }

        private static int FindPrimaryRoleIndex(IReadOnlyList<PartyRoleAssignmentEditorModel> roles)
        {
            if (roles.Count == 0)
            {
                return -1;
            }

            for (var index = 0; index < roles.Count; index++)
            {
                if (roles[index].IsPrimary)
                {
                    return index;
                }
            }

            return 0;
        }

        private static int FindPrimaryContactIndex(
            IReadOnlyList<PartyContactPointEditorModel> contactPoints,
            PartyContactType contactType)
        {
            for (var index = 0; index < contactPoints.Count; index++)
            {
                if (contactPoints[index].ContactType == contactType && contactPoints[index].IsPrimary)
                {
                    return index;
                }
            }

            for (var index = 0; index < contactPoints.Count; index++)
            {
                if (contactPoints[index].ContactType == contactType)
                {
                    return index;
                }
            }

            return -1;
        }

        private static PartyRoleAssignmentEditorModel CloneRole(PartyRoleAssignmentEditorModel role)
        {
            return new PartyRoleAssignmentEditorModel
            {
                Id = role.Id,
                RoleKind = role.RoleKind,
                Title = role.Title,
                IsPrimary = role.IsPrimary,
                ValidFromUtc = role.ValidFromUtc,
                ValidToUtc = role.ValidToUtc,
                Notes = role.Notes
            };
        }

        private static PartyContactPointEditorModel CloneContactPoint(PartyContactPointEditorModel contactPoint)
        {
            return new PartyContactPointEditorModel
            {
                Id = contactPoint.Id,
                ContactType = contactPoint.ContactType,
                Label = contactPoint.Label,
                Value = contactPoint.Value,
                NormalizedValue = contactPoint.NormalizedValue,
                IsPrimary = contactPoint.IsPrimary,
                IsPublic = contactPoint.IsPublic,
                Notes = contactPoint.Notes
            };
        }

        private static PartyAddressEditorModel CloneAddress(PartyAddressEditorModel address)
        {
            return new PartyAddressEditorModel
            {
                Id = address.Id,
                AddressType = address.AddressType,
                Line1 = address.Line1,
                Line2 = address.Line2,
                City = address.City,
                Region = address.Region,
                PostalCode = address.PostalCode,
                CountryCode = address.CountryCode,
                IsPrimary = address.IsPrimary,
                Notes = address.Notes
            };
        }

        private static PartyConfidentialNoteEditorModel CloneConfidentialNote(PartyConfidentialNoteEditorModel note)
        {
            return new PartyConfidentialNoteEditorModel
            {
                Id = note.Id,
                Category = note.Category,
                NoteText = note.NoteText,
                CreatedBy = note.CreatedBy,
                CreatedAtUtc = note.CreatedAtUtc,
                UpdatedAtUtc = note.UpdatedAtUtc
            };
        }

        private static string NormalizeContactValue(PartyContactType contactType, string value)
        {
            var trimmedValue = value.Trim();
            return contactType switch
            {
                PartyContactType.Phone => new string(trimmedValue.Where(character => char.IsDigit(character) || character == '+').ToArray()),
                _ => trimmedValue.ToLowerInvariant()
            };
        }
    }
}

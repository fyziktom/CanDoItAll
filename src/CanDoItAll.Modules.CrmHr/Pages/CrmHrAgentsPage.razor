@page "/crm-hr/agents"
@inject AiAgentService AiAgentService
@inject NavigationManager Navigation

<PageTitle>CRM / HR Agents</PageTitle>

<PageScaffold>
    <Header>
        <PageHeader Eyebrow="CRM / HR"
                    Title="Agent workspace"
                    Description="Treat AI agents as first-class directory parties, then bind provider configuration, capabilities, stewardship, and review state without creating a second registry.">
            <Actions>
                <Button Text="Open directory"
                        ButtonStyle="ButtonStyle.Light"
                        Click="OpenDirectory" />
            </Actions>
        </PageHeader>
    </Header>

    <ChildContent>
        <Stack GapScale="LayoutGap.Large">
            <CrmHrSecondaryTabs SelectedKey="agents" />

            <SummaryTiles>
                <SummaryTile Label="Agent parties"
                             Value="@agentItems.Count.ToString()"
                             HelperText="Directory parties typed as AI agents." />
                <SummaryTile Label="Bound providers"
                             Value="@agentItems.Count(item => item.HasProfile && !string.IsNullOrWhiteSpace(item.ProviderName)).ToString()"
                             HelperText="Agents already linked to a Workspace provider profile." Tone="info" />
                <SummaryTile Label="Review required"
                             Value="@agentItems.Count(item => item.ValidationStatus == AiValidationStatus.ReviewRequired).ToString()"
                             HelperText="Profiles waiting for governance review." Tone="warning" />
                <SummaryTile Label="Without profile"
                             Value="@agentItems.Count(item => !item.HasProfile).ToString()"
                             HelperText="Agent identities that still need operational metadata." Tone="success" />
            </SummaryTiles>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="@ResolveMessageClasses()"
                     data-testid="crmhr-agent-message">
                    @message
                </div>
            }

            <ListDetailShell ListPaneWidth="30rem">
                <ListHeader>
                    <ListPanelHeader Title="Agent roster"
                                     Description="Create AI-agent parties, then bind their provider profile, owner, capabilities, and review state on the same durable directory identity."
                                     Count="@($"{FilteredItems.Count} visible agent(s)")">
                        <Filters>
                            <FilterBar ResultText="@($"{FilteredItems.Count} matching agent(s)")">
                                <input @bind="searchText"
                                       @bind:event="oninput"
                                       class="cda-input min-w-[16rem] flex-1"
                                       placeholder="Search agent, provider, owner, model, or summary"
                                       data-testid="crmhr-agent-search" />
                                <InputSelect @bind-Value="validationFilter"
                                             class="cda-input"
                                             data-testid="crmhr-agent-validation-filter">
                                    @foreach (var filter in ValidationFilters)
                                    {
                                        <option value="@filter.Value">@filter.Label</option>
                                    }
                                </InputSelect>
                                <Button Text="Reset"
                                        ButtonStyle="ButtonStyle.Light"
                                        Size="ButtonSize.Small"
                                        Click="ResetFilters" />
                            </FilterBar>
                        </Filters>
                    </ListPanelHeader>
                </ListHeader>

                <ListContent>
                    <EditForm Model="quickCreateEditor" OnValidSubmit="CreateAgentAsync">
                        <SurfaceCard Soft="true">
                            <p class="cda-eyebrow">Quick create</p>
                            <h3 class="mt-1 text-lg font-semibold text-slate-950">AI agent party</h3>
                            <p class="mt-2 text-sm leading-6 text-slate-600">
                                Create the durable directory identity first. Provider binding, ownership, capabilities, and governance land on the same record in the detail pane.
                            </p>

                            <Grid Gap="LayoutGap.Medium" ColumnsMd="2" Class="mt-4">
                                <div>
                                    <label class="cda-field-label">Agent name</label>
                                    <InputText @bind-Value="quickCreateEditor.Name"
                                               class="cda-input"
                                               data-testid="crmhr-agent-name" />
                                </div>
                                <div>
                                    <label class="cda-field-label">External code</label>
                                    <InputText @bind-Value="quickCreateEditor.ExternalCode"
                                               class="cda-input"
                                               data-testid="crmhr-agent-code" />
                                </div>
                            </Grid>

                            <div class="mt-4">
                                <label class="cda-field-label">Summary</label>
                                <InputTextArea @bind-Value="quickCreateEditor.Summary"
                                               class="cda-input min-h-[6rem]"
                                               data-testid="crmhr-agent-summary" />
                            </div>

                            <Cluster Gap="LayoutGap.Small" Class="mt-4">
                                <Button Text="Create AI agent"
                                        Type="submit"
                                        data-testid="crmhr-agent-save-button" />
                            </Cluster>
                        </SurfaceCard>
                    </EditForm>

                    @if (FilteredItems.Count == 0)
                    {
                        <EmptyState Eyebrow="No AI agents yet"
                                    Title="Create the first reusable agent identity"
                                    Description="Use the quick-create form to register an AI agent as a directory party before provider and governance details are added." />
                    }
                    else
                    {
                        <Stack GapScale="LayoutGap.Medium" Class="mt-5">
                            @foreach (var item in FilteredItems)
                            {
                                <div data-testid="crmhr-agent-item">
                                    <SelectionListItem Title="@item.DisplayName"
                                                       Eyebrow="AI agent"
                                                       Meta="@BuildItemMeta(item)"
                                                       Summary="@BuildItemSummary(item)"
                                                       IsSelected="@(selectedWorkspace?.PartyId == item.PartyId)"
                                                       OnSelect="@(() => SelectPartyAsync(item.PartyId))">
                                        <Status>
                                            <Cluster Gap="LayoutGap.Small">
                                                <StatusBadge Tone="@ResolveValidationTone(item.ValidationStatus)" Text="@ResolveValidationText(item)" />
                                                <StatusBadge Tone="@ResolveExecutionTone(item.ExecutionMode)" Text="@ResolveExecutionText(item)" />
                                            </Cluster>
                                        </Status>
                                    </SelectionListItem>
                                </div>
                            }
                        </Stack>
                    }
                </ListContent>

                <DetailHeader>
                    @if (selectedWorkspace is null)
                    {
                        <SurfaceCard Soft="true">
                            <p class="cda-eyebrow">No AI agent selected</p>
                            <h2 class="mt-1 text-lg font-semibold text-slate-950">Choose an agent from the list</h2>
                            <p class="mt-3 text-sm leading-6 text-slate-600">
                                The detail surface shows provider binding, steward ownership, execution mode, and capability guardrails after you select an AI-agent party.
                            </p>
                            <Cluster Gap="LayoutGap.Small" Class="mt-4">
                                <Button Text="Open directory"
                                        ButtonStyle="ButtonStyle.Light"
                                        Click="OpenDirectory" />
                            </Cluster>
                        </SurfaceCard>
                    }
                    else
                    {
                        <SurfaceCard>
                            <Split Gap="LayoutGap.Medium">
                                <div class="min-w-0">
                                    <p class="cda-eyebrow">Agent summary</p>
                                    <h2 class="mt-1 text-lg font-semibold text-slate-950">@selectedWorkspace.DisplayName</h2>
                                    @if (!string.IsNullOrWhiteSpace(selectedWorkspace.Summary))
                                    {
                                        <p class="mt-3 text-sm leading-6 text-slate-600">@selectedWorkspace.Summary</p>
                                    }
                                </div>
                                <Cluster Gap="LayoutGap.Small">
                                    <StatusBadge Tone="@ResolveValidationTone(profileEditor.ValidationStatus)" Text="@profileEditor.ValidationStatus.ToString()" />
                                    <StatusBadge Tone="@ResolveExecutionTone(profileEditor.ExecutionMode)" Text="@profileEditor.ExecutionMode.ToString()" />
                                </Cluster>
                            </Split>

                            <Grid Gap="LayoutGap.Medium" ColumnsMd="2" Class="mt-5">
                                <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 px-4 py-4">
                                    <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Provider</p>
                                    <p class="mt-1 text-sm font-medium text-slate-950"
                                       data-testid="crmhr-agent-summary-provider">@FormatValue(selectedWorkspace.ProviderName)</p>
                                </div>
                                <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 px-4 py-4">
                                    <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Owner / steward</p>
                                    <p class="mt-1 text-sm font-medium text-slate-950"
                                       data-testid="crmhr-agent-summary-owner">@FormatValue(selectedWorkspace.OwnerName)</p>
                                </div>
                                <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 px-4 py-4">
                                    <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Execution mode</p>
                                    <p class="mt-1 text-sm font-medium text-slate-950">@profileEditor.ExecutionMode</p>
                                </div>
                                <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 px-4 py-4">
                                    <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Capabilities</p>
                                    <p class="mt-1 text-sm font-medium text-slate-950"
                                       data-testid="crmhr-agent-summary-capabilities">@profileEditor.Capabilities.Count</p>
                                </div>
                            </Grid>
                        </SurfaceCard>
                    }
                </DetailHeader>

                <DetailContent>
                    @if (selectedWorkspace is null)
                    {
                        <EmptyState Eyebrow="Agent workspace ready"
                                    Title="Select an agent to continue"
                                    Description="Provider binding, capabilities, owner, and review state appear here after you choose an AI agent from the roster." />
                    }
                    else
                    {
                        <EditForm Model="profileEditor" OnValidSubmit="SaveAgentProfileAsync">
                            <Stack GapScale="LayoutGap.Large">
                                <AiAgentProfileEditor Model="profileEditor"
                                                      OwnerOptions="selectedWorkspace.OwnerOptions"
                                                      ProviderOptions="selectedWorkspace.ProviderOptions" />

                                <Cluster Gap="LayoutGap.Small">
                                    <Button Text="Save AI agent profile"
                                            Type="submit"
                                            data-testid="crmhr-agent-profile-save-button" />
                                    <Button Text="Open directory record"
                                            ButtonStyle="ButtonStyle.Light"
                                            Click="OpenDirectory" />
                                </Cluster>
                            </Stack>
                        </EditForm>
                    }
                </DetailContent>
            </ListDetailShell>
        </Stack>
    </ChildContent>
</PageScaffold>

@code {
    private static readonly IReadOnlyList<ValidationFilterOption> ValidationFilters =
    [
        new(string.Empty, "All validation states"),
        new("unconfigured", "Without profile"),
        new(nameof(AiValidationStatus.Draft), "Draft"),
        new(nameof(AiValidationStatus.ReviewRequired), "ReviewRequired"),
        new(nameof(AiValidationStatus.Approved), "Approved"),
        new(nameof(AiValidationStatus.Suspended), "Suspended")
    ];

    [SupplyParameterFromQuery(Name = "partyId")]
    public Guid? PartyIdQuery { get; set; }

    private readonly QuickCreateAgentModel quickCreateEditor = new();
    private IReadOnlyList<AiAgentListItemModel> agentItems = [];
    private AiAgentWorkspaceModel? selectedWorkspace;
    private AiAgentProfileEditorModel profileEditor = new();
    private string searchText = string.Empty;
    private string validationFilter = string.Empty;
    private string? handledPartyKey;
    private string? messageRetentionPartyKey;
    private string? message;
    private string messageTone = "success";

    private IReadOnlyList<AiAgentListItemModel> FilteredItems => agentItems
        .Where(MatchesSearch)
        .Where(MatchesValidation)
        .OrderBy(item => item.DisplayName)
        .ToList();

    protected override async Task OnParametersSetAsync()
    {
        await LoadItemsAsync();

        var targetPartyId = PartyIdQuery;
        if (!targetPartyId.HasValue && agentItems.Count > 0)
        {
            targetPartyId = agentItems[0].PartyId;
        }

        var targetKey = targetPartyId?.ToString("N") ?? "none";
        if (handledPartyKey == targetKey && selectedWorkspace is not null)
        {
            return;
        }

        if (targetPartyId.HasValue)
        {
            var workspace = await AiAgentService.GetAgentWorkspaceAsync(targetPartyId.Value);
            if (workspace is null && agentItems.Count > 0)
            {
                workspace = await AiAgentService.GetAgentWorkspaceAsync(agentItems[0].PartyId);
                targetKey = agentItems[0].PartyId.ToString("N");
            }

            if (workspace is not null)
            {
                var preserveMessage = string.Equals(messageRetentionPartyKey, targetKey, StringComparison.Ordinal);
                ApplyLoadedWorkspace(workspace, clearMessage: !preserveMessage);
                if (preserveMessage)
                {
                    messageRetentionPartyKey = null;
                }

                handledPartyKey = targetKey;
                return;
            }
        }

        selectedWorkspace = null;
        profileEditor = new();
        handledPartyKey = "none";
        message = null;
    }

    private async Task LoadItemsAsync()
    {
        agentItems = await AiAgentService.ListAgentDirectoryAsync();
    }

    private void ApplyLoadedWorkspace(AiAgentWorkspaceModel workspace, bool clearMessage)
    {
        selectedWorkspace = workspace;
        profileEditor = new AiAgentProfileEditorModel
        {
            Id = workspace.Profile.Id,
            PartyId = workspace.Profile.PartyId,
            ProviderProfileId = workspace.Profile.ProviderProfileId,
            DefaultModel = workspace.Profile.DefaultModel,
            ExecutionMode = workspace.Profile.ExecutionMode,
            OwnerPartyId = workspace.Profile.OwnerPartyId,
            ValidationStatus = workspace.Profile.ValidationStatus,
            LastReviewedOn = workspace.Profile.LastReviewedOn,
            Notes = workspace.Profile.Notes,
            ExtendedDataJson = workspace.Profile.ExtendedDataJson,
            LastChangedBy = workspace.Profile.LastChangedBy,
            Capabilities = workspace.Profile.Capabilities
                .Select(capability => new AiCapabilityEditorModel
                {
                    Name = capability.Name,
                    Scope = capability.Scope,
                    ToolAccess = capability.ToolAccess,
                    Limitations = capability.Limitations,
                    Notes = capability.Notes
                })
                .ToList()
        };

        if (clearMessage)
        {
            message = null;
            messageTone = "success";
        }
    }

    private async Task ReloadSelectedAgentAsync(bool clearMessage)
    {
        if (selectedWorkspace is null)
        {
            return;
        }

        await LoadItemsAsync();
        var workspace = await AiAgentService.GetAgentWorkspaceAsync(selectedWorkspace.PartyId);
        if (workspace is not null)
        {
            ApplyLoadedWorkspace(workspace, clearMessage);
        }
    }

    private Task SelectPartyAsync(Guid partyId)
    {
        Navigation.NavigateTo($"/crm-hr/agents?partyId={partyId}");
        return Task.CompletedTask;
    }

    private void OpenDirectory()
    {
        if (selectedWorkspace is null)
        {
            Navigation.NavigateTo("/crm-hr/directory");
            return;
        }

        Navigation.NavigateTo($"/crm-hr/directory?partyId={selectedWorkspace.PartyId}");
    }

    private async Task CreateAgentAsync()
    {
        if (string.IsNullOrWhiteSpace(quickCreateEditor.Name))
        {
            message = "AI agent name is required.";
            messageTone = "danger";
            return;
        }

        var result = await AiAgentService.CreateAgentAsync(
            quickCreateEditor.Name,
            quickCreateEditor.ExternalCode,
            quickCreateEditor.Summary,
            "crm-hr-ui");
        if (result.IsFailure)
        {
            message = string.Join(" ", result.Errors.Select(error => error.Message));
            messageTone = "danger";
            return;
        }

        quickCreateEditor.Name = string.Empty;
        quickCreateEditor.ExternalCode = string.Empty;
        quickCreateEditor.Summary = string.Empty;

        await LoadItemsAsync();
        messageRetentionPartyKey = result.Value.ToString("N");
        var workspace = await AiAgentService.GetAgentWorkspaceAsync(result.Value);
        if (workspace is not null)
        {
            ApplyLoadedWorkspace(workspace, clearMessage: false);
            handledPartyKey = workspace.PartyId.ToString("N");
        }

        message = "AI agent created.";
        messageTone = "success";
        Navigation.NavigateTo($"/crm-hr/agents?partyId={result.Value}", replace: true);
    }

    private async Task SaveAgentProfileAsync()
    {
        var result = await AiAgentService.SaveAgentProfileAsync(profileEditor);
        if (result.IsFailure)
        {
            message = string.Join(" ", result.Errors.Select(error => error.Message));
            messageTone = "danger";
            return;
        }

        await ReloadSelectedAgentAsync(clearMessage: false);
        message = "AI agent profile saved.";
        messageTone = "success";
    }

    private void ResetFilters()
    {
        searchText = string.Empty;
        validationFilter = string.Empty;
    }

    private bool MatchesSearch(AiAgentListItemModel item)
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return true;
        }

        return item.DisplayName.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || item.ProviderName.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || item.OwnerName.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || item.DefaultModel.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || item.Summary.Contains(searchText, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesValidation(AiAgentListItemModel item)
    {
        if (string.IsNullOrWhiteSpace(validationFilter))
        {
            return true;
        }

        if (string.Equals(validationFilter, "unconfigured", StringComparison.OrdinalIgnoreCase))
        {
            return !item.HasProfile;
        }

        return string.Equals(item.ValidationStatus?.ToString(), validationFilter, StringComparison.OrdinalIgnoreCase);
    }

    private static string BuildItemMeta(AiAgentListItemModel item)
    {
        var parts = new List<string>
        {
            item.HasProfile ? ResolveValidationText(item) : "No profile"
        };

        if (!string.IsNullOrWhiteSpace(item.ProviderName))
        {
            parts.Add($"Provider: {item.ProviderName}");
        }

        if (!string.IsNullOrWhiteSpace(item.OwnerName))
        {
            parts.Add($"Owner: {item.OwnerName}");
        }

        return string.Join(" / ", parts);
    }

    private static string BuildItemSummary(AiAgentListItemModel item)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(item.DefaultModel))
        {
            parts.Add(item.DefaultModel);
        }

        if (item.CapabilityCount > 0)
        {
            parts.Add($"{item.CapabilityCount} capability record(s)");
        }

        if (parts.Count > 0)
        {
            return string.Join(" / ", parts);
        }

        return string.IsNullOrWhiteSpace(item.Summary)
            ? "Agent identity exists, but provider and governance metadata still need to be captured."
            : item.Summary;
    }

    private static string ResolveValidationText(AiAgentListItemModel item)
    {
        return item.ValidationStatus?.ToString() ?? "No profile";
    }

    private static string ResolveExecutionText(AiAgentListItemModel item)
    {
        return item.ExecutionMode?.ToString() ?? "Unbound";
    }

    private static string ResolveValidationTone(AiValidationStatus? validationStatus)
    {
        return validationStatus switch
        {
            AiValidationStatus.ReviewRequired => "warning",
            AiValidationStatus.Approved => "success",
            AiValidationStatus.Suspended => "danger",
            AiValidationStatus.Draft => "base",
            _ => "neutral"
        };
    }

    private static string ResolveExecutionTone(AiExecutionMode? executionMode)
    {
        return executionMode switch
        {
            AiExecutionMode.Local => "info",
            AiExecutionMode.Remote => "primary",
            AiExecutionMode.ThirdParty => "warning",
            _ => "neutral"
        };
    }

    private string ResolveMessageClasses()
    {
        return messageTone == "danger"
            ? "rounded-[1.25rem] border border-rose-200 bg-rose-50 px-4 py-4 text-sm font-medium text-rose-700"
            : "rounded-[1.25rem] border border-emerald-200 bg-emerald-50 px-4 py-4 text-sm font-medium text-emerald-700";
    }

    private static string FormatValue(string value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Not set" : value;
    }

    private sealed class QuickCreateAgentModel
    {
        public string Name { get; set; } = string.Empty;
        public string ExternalCode { get; set; } = string.Empty;
        public string Summary { get; set; } = string.Empty;
    }

    private sealed record ValidationFilterOption(string Value, string Label);
}

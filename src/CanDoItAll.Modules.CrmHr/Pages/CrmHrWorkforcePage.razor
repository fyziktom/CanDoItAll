@page "/crm-hr/workforce"
@inject HrService HrService
@inject PartyDirectoryService PartyDirectoryService
@inject NavigationManager Navigation

<PageTitle>CRM / HR Workforce</PageTitle>

<PageScaffold>
    <Header>
        <PageHeader Eyebrow="CRM / HR"
                    Title="Workforce workspace"
                    Description="Keep worker identity, delivery-unit structure, manager lines, and commercial staffing metadata on the shared party model instead of splitting people ops and delivery records.">
            <Actions>
                <Button Text="Open directory"
                        ButtonStyle="ButtonStyle.Light"
                        Click="OpenDirectory" />
            </Actions>
        </PageHeader>
    </Header>

    <ChildContent>
        <Stack GapScale="LayoutGap.Large">
            <CrmHrSecondaryTabs SelectedKey="workforce" />

            <SummaryTiles>
                <SummaryTile Label="Profiles"
                             Value="@workforceItems.Count(item => item.HasProfile).ToString()"
                             HelperText="Parties with an attached workforce profile." />
                <SummaryTile Label="Bench"
                             Value="@workforceItems.Count(item => item.AvailabilityState == WorkforceAvailabilityState.Bench).ToString()"
                             HelperText="Profiles currently light enough to staff quickly." Tone="success" />
                <SummaryTile Label="Near available"
                             Value="@workforceItems.Count(item => item.AvailabilityState == WorkforceAvailabilityState.NearAvailable).ToString()"
                             HelperText="Profiles becoming available within the next month." Tone="warning" />
                <SummaryTile Label="Overallocated"
                             Value="@workforceItems.Count(item => item.AvailabilityState == WorkforceAvailabilityState.Overallocated).ToString()"
                             HelperText="Profiles whose project demand exceeds available capacity." Tone="danger" />
                <SummaryTile Label="Without profile"
                             Value="@workforceItems.Count(item => !item.HasProfile && item.PartyType == PartyType.Person).ToString()"
                             HelperText="People already in the directory who still need workforce metadata." Tone="info" />
            </SummaryTiles>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="@ResolveMessageClasses()"
                     data-testid="crmhr-workforce-message">
                    @message
                </div>
            }

            <ListDetailShell ListPaneWidth="30rem">
                <ListHeader>
                    <ListPanelHeader Title="Workforce records"
                                     Description="Select a worker or delivery unit to manage employment type, reporting line, home unit, searchable skills, and allocation-driven availability."
                                     Count="@($"{FilteredItems.Count} visible record(s)")">
                        <Filters>
                            <FilterBar ResultText="@($"{FilteredItems.Count} matching record(s)")">
                                <input @bind="searchText"
                                       @bind:event="oninput"
                                       class="cda-input min-w-[16rem] flex-1"
                                       placeholder="Search person, skill, proficiency, location, seniority, manager, or role"
                                       data-testid="crmhr-workforce-search" />
                                <InputSelect @bind-Value="kindFilter"
                                             class="cda-input"
                                             data-testid="crmhr-workforce-kind-filter">
                                    <option value="">All workforce kinds</option>
                                    @foreach (var workforceKind in Enum.GetValues<WorkforceKind>())
                                    {
                                        <option value="@workforceKind.ToString()">@workforceKind</option>
                                    }
                                </InputSelect>
                                <InputSelect @bind-Value="skillFilter"
                                             class="cda-input"
                                             data-testid="crmhr-workforce-skill-filter">
                                    <option value="">All skills</option>
                                    @foreach (var skill in skillCatalog.OrderBy(item => item.Category).ThenBy(item => item.Name))
                                    {
                                        <option value="@skill.Id.ToString("D")">@skill.Name (@skill.Category)</option>
                                    }
                                </InputSelect>
                                <InputSelect @bind-Value="availabilityFilter"
                                             class="cda-input"
                                             data-testid="crmhr-workforce-availability-filter">
                                    <option value="">Any availability</option>
                                    @foreach (var availabilityState in Enum.GetValues<WorkforceAvailabilityState>())
                                    {
                                        <option value="@availabilityState.ToString()">@availabilityState</option>
                                    }
                                </InputSelect>
                                <Button Text="Reset"
                                        ButtonStyle="ButtonStyle.Light"
                                        Size="ButtonSize.Small"
                                        Click="ResetFilters" />
                            </FilterBar>
                        </Filters>
                    </ListPanelHeader>
                </ListHeader>
                <ListContent>
                    <EditForm Model="deliveryUnitEditor" OnValidSubmit="CreateDeliveryUnitAsync">
                        <SurfaceCard Soft="true">
                            <p class="cda-eyebrow">Quick create</p>
                            <h3 class="mt-1 text-lg font-semibold text-slate-950">Delivery unit</h3>
                            <p class="mt-2 text-sm leading-6 text-slate-600">
                                Create an organization unit with delivery semantics directly from the workforce route when staffing needs a team home before the broader directory card is filled out.
                            </p>

                            <Grid Gap="LayoutGap.Medium" ColumnsMd="2" Class="mt-4">
                                <div>
                                    <label class="cda-field-label">Unit name</label>
                                    <InputText @bind-Value="deliveryUnitEditor.Name"
                                               class="cda-input"
                                               data-testid="crmhr-delivery-unit-name" />
                                </div>
                                <div>
                                    <label class="cda-field-label">External code</label>
                                    <InputText @bind-Value="deliveryUnitEditor.ExternalCode"
                                               class="cda-input"
                                               data-testid="crmhr-delivery-unit-code" />
                                </div>
                            </Grid>

                            <div class="mt-4">
                                <label class="cda-field-label">Summary</label>
                                <InputTextArea @bind-Value="deliveryUnitEditor.Summary"
                                               class="cda-input min-h-[6rem]"
                                               data-testid="crmhr-delivery-unit-summary" />
                            </div>

                            <Cluster Gap="LayoutGap.Small" Class="mt-4">
                                <Button Text="Create delivery unit"
                                        Type="submit"
                                        data-testid="crmhr-delivery-unit-save-button" />
                            </Cluster>
                        </SurfaceCard>
                    </EditForm>

                    @if (FilteredItems.Count == 0)
                    {
                        <EmptyState Eyebrow="No workforce records yet"
                                    Title="Start from the shared directory"
                                    Description="Create people or delivery-unit parties and then use this route to add workforce metadata without duplicating identity." />
                    }
                    else
                    {
                        <Stack GapScale="LayoutGap.Medium" Class="mt-5">
                            @foreach (var item in FilteredItems)
                            {
                                <div data-testid="crmhr-workforce-item">
                                    <SelectionListItem Title="@item.DisplayName"
                                                       Eyebrow="@BuildItemEyebrow(item)"
                                                       Meta="@BuildItemMeta(item)"
                                                       Summary="@BuildItemSummary(item)"
                                                       IsSelected="@(selectedWorkspace?.PartyId == item.PartyId)"
                                                       OnSelect="@(() => SelectPartyAsync(item.PartyId))">
                                        <Status>
                                            <Cluster Gap="LayoutGap.Small">
                                                <StatusBadge Tone="@ResolveKindTone(item.WorkforceKind)" Text="@ResolveKindText(item)" />
                                                <StatusBadge Tone="@ResolveStatusTone(item.Status)" Text="@item.Status" />
                                                @if (item.IsSensitive)
                                                {
                                                    <StatusBadge Tone="warning" Text="Sensitive" />
                                                }
                                                @if (item.AvailabilityState.HasValue)
                                                {
                                                    <StatusBadge Tone="@ResolveAvailabilityTone(item.AvailabilityState.Value)"
                                                                 Text="@item.AvailabilityState.Value.ToString()" />
                                                }
                                            </Cluster>
                                        </Status>
                                    </SelectionListItem>
                                </div>
                            }
                        </Stack>
                    }
                </ListContent>

                <DetailHeader>
                    @if (selectedWorkspace is null)
                    {
                        <SurfaceCard Soft="true">
                            <p class="cda-eyebrow">No workforce record selected</p>
                            <h2 class="mt-1 text-lg font-semibold text-slate-950">Choose a party from the list</h2>
                            <p class="mt-3 text-sm leading-6 text-slate-600">
                                The workforce detail surface shows reporting line, home unit, profile economics, searchable skills, and allocation-driven capacity after you select a person or delivery unit.
                            </p>
                            <Cluster Gap="LayoutGap.Small" Class="mt-4">
                                <Button Text="Open directory"
                                        ButtonStyle="ButtonStyle.Light"
                                        Click="OpenDirectory" />
                            </Cluster>
                        </SurfaceCard>
                    }
                    else
                    {
                        <SurfaceCard>
                            <Split Gap="LayoutGap.Medium">
                                <div class="min-w-0">
                                    <p class="cda-eyebrow">Workforce summary</p>
                                    <h2 class="mt-1 text-lg font-semibold text-slate-950">@selectedWorkspace.DisplayName</h2>
                                    @if (!string.IsNullOrWhiteSpace(selectedWorkspace.Summary))
                                    {
                                        <p class="mt-3 text-sm leading-6 text-slate-600">@selectedWorkspace.Summary</p>
                                    }
                                    <p class="mt-3 text-sm font-medium text-slate-700"
                                       data-testid="crmhr-workforce-availability-message">
                                        @selectedWorkspace.CapacitySummary.AvailabilityMessage
                                    </p>
                                </div>
                                <Cluster Gap="LayoutGap.Small">
                                    <StatusBadge Tone="@ResolveKindTone(profileEditor.WorkforceKind)" Text="@profileEditor.WorkforceKind.ToString()" />
                                    <StatusBadge Tone="@ResolveStatusTone(profileEditor.Status)" Text="@profileEditor.Status" />
                                    <StatusBadge Tone="@ResolveAvailabilityTone(selectedWorkspace.CapacitySummary.AvailabilityState)"
                                                 Text="@selectedWorkspace.CapacitySummary.AvailabilityState.ToString()" />
                                </Cluster>
                            </Split>

                            <div class="mt-5">
                                <SensitiveDataCallout IsSensitive="selectedWorkspace.IsSensitive"
                                                     LastChangedBy="@selectedWorkspace.LastChangedBy"
                                                     UpdatedAtUtc="selectedWorkspace.UpdatedAtUtc"
                                                     DataTestId="crmhr-workforce-sensitive-callout"
                                                     StandardDescription="Use this summary before staffing or line-management changes so ownership and broad visibility stay explicit."
                                                     SensitiveDescription="Sensitive workforce records stay out of global search while still preserving assignment, manager, and capacity context for trusted operators." />
                            </div>

                            <Grid Gap="LayoutGap.Medium" ColumnsMd="4" Class="mt-5">
                                <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 px-4 py-4">
                                    <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Home unit</p>
                                    <p class="mt-1 text-sm font-medium text-slate-950"
                                       data-testid="crmhr-workforce-summary-home-unit">@FormatValue(selectedWorkspace.HomeUnitName)</p>
                                </div>
                                <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 px-4 py-4">
                                    <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Manager</p>
                                    <p class="mt-1 text-sm font-medium text-slate-950"
                                       data-testid="crmhr-workforce-summary-manager">@FormatValue(selectedWorkspace.ManagerName)</p>
                                </div>
                                <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 px-4 py-4">
                                    <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Primary email</p>
                                    <p class="mt-1 text-sm font-medium text-slate-950">@FormatValue(selectedWorkspace.PrimaryEmail)</p>
                                </div>
                                <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 px-4 py-4">
                                    <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Primary phone</p>
                                    <p class="mt-1 text-sm font-medium text-slate-950">@FormatValue(selectedWorkspace.PrimaryPhone)</p>
                                </div>
                                <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 px-4 py-4">
                                    <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Available now</p>
                                    <p class="mt-1 text-sm font-medium text-slate-950">@FormatPercent(selectedWorkspace.CapacitySummary.AvailablePercent)</p>
                                </div>
                                <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 px-4 py-4">
                                    <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Next availability</p>
                                    <p class="mt-1 text-sm font-medium text-slate-950">@FormatDate(selectedWorkspace.CapacitySummary.NextAvailabilityOn)</p>
                                </div>
                                <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 px-4 py-4">
                                    <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Contract end</p>
                                    <p class="mt-1 text-sm font-medium text-slate-950">@FormatDate(selectedWorkspace.Profile.EndDate)</p>
                                </div>
                                <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 px-4 py-4">
                                    <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Searchable skills</p>
                                    <p class="mt-1 text-sm font-medium text-slate-950">@FormatValue(BuildSkillCoverage(selectedWorkspace.Skills))</p>
                                </div>
                            </Grid>
                        </SurfaceCard>
                    }
                </DetailHeader>

                <DetailContent>
                    @if (selectedWorkspace is null)
                    {
                        <EmptyState Eyebrow="Workforce workspace ready"
                                    Title="Select a worker or unit to continue"
                                    Description="Profile editing, skill coverage, capacity blocks, and project allocations appear here after you choose a party from the workforce list." />
                    }
                    else
                    {
                        <Stack GapScale="LayoutGap.Large">
                            <EditForm Model="profileEditor" OnValidSubmit="SaveWorkforceProfileAsync">
                                <FormSection Title="Workforce profile"
                                             Description="Keep employment type, commercial rate context, and org-structure metadata attached to the same Party identity used by CRM and project flows.">
                                    <Grid Gap="LayoutGap.Large" ColumnsMd="3">
                                        <div>
                                            <label class="cda-field-label">Workforce kind</label>
                                            <InputSelect @bind-Value="profileEditor.WorkforceKind"
                                                         class="cda-input"
                                                         data-testid="crmhr-workforce-kind">
                                                @foreach (var workforceKind in AvailableWorkforceKinds)
                                                {
                                                    <option value="@workforceKind">@workforceKind</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div>
                                            <label class="cda-field-label">Status</label>
                                            <InputSelect @bind-Value="profileEditor.Status"
                                                         class="cda-input"
                                                         data-testid="crmhr-workforce-status">
                                                @foreach (var status in WorkforceStatuses)
                                                {
                                                    <option value="@status">@status</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div>
                                            <label class="cda-field-label">Employee code</label>
                                            <InputText @bind-Value="profileEditor.EmployeeCode"
                                                       class="cda-input"
                                                       data-testid="crmhr-workforce-employee-code" />
                                        </div>
                                    </Grid>

                                    <Grid Gap="LayoutGap.Large" ColumnsMd="3" Class="mt-5">
                                        <div>
                                            <label class="cda-field-label">Job title</label>
                                            <InputText @bind-Value="profileEditor.JobTitle"
                                                       class="cda-input"
                                                       data-testid="crmhr-workforce-job-title" />
                                        </div>
                                        <div>
                                            <label class="cda-field-label">Discipline</label>
                                            <InputText @bind-Value="profileEditor.Discipline"
                                                       class="cda-input"
                                                       data-testid="crmhr-workforce-discipline" />
                                        </div>
                                        <div>
                                            <label class="cda-field-label">Seniority</label>
                                            <InputSelect @bind-Value="profileEditor.Seniority"
                                                         class="cda-input"
                                                         data-testid="crmhr-workforce-seniority">
                                                @foreach (var seniority in SeniorityValues)
                                                {
                                                    <option value="@seniority">@seniority</option>
                                                }
                                            </InputSelect>
                                        </div>
                                    </Grid>

                                    <Grid Gap="LayoutGap.Large" ColumnsMd="2" Class="mt-5">
                                        <div>
                                            <label class="cda-field-label">Home unit</label>
                                            <InputSelect @bind-Value="profileEditor.HomeUnitPartyId"
                                                         class="cda-input"
                                                         data-testid="crmhr-workforce-home-unit">
                                                <option value="">No home unit</option>
                                                @foreach (var unit in selectedWorkspace.HomeUnitOptions)
                                                {
                                                    <option value="@unit.Id">@unit.DisplayName (@unit.PartyType)</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div>
                                            <label class="cda-field-label">Manager</label>
                                            <InputSelect @bind-Value="profileEditor.ManagerPartyId"
                                                         class="cda-input"
                                                         data-testid="crmhr-workforce-manager">
                                                <option value="">No manager</option>
                                                @foreach (var manager in selectedWorkspace.ManagerOptions)
                                                {
                                                    <option value="@manager.Id">@manager.DisplayName</option>
                                                }
                                            </InputSelect>
                                        </div>
                                    </Grid>

                                    <Grid Gap="LayoutGap.Large" ColumnsMd="3" Class="mt-5">
                                        <div>
                                            <label class="cda-field-label">Start date</label>
                                            <InputDate @bind-Value="profileEditor.StartDate"
                                                       class="cda-input"
                                                       data-testid="crmhr-workforce-start-date" />
                                        </div>
                                        <div>
                                            <label class="cda-field-label">End date</label>
                                            <InputDate @bind-Value="profileEditor.EndDate"
                                                       class="cda-input"
                                                       data-testid="crmhr-workforce-end-date" />
                                        </div>
                                        <div>
                                            <label class="cda-field-label">Capacity hours / week</label>
                                            <InputNumber @bind-Value="profileEditor.CapacityHoursPerWeek"
                                                         class="cda-input"
                                                         data-testid="crmhr-workforce-capacity" />
                                        </div>
                                    </Grid>

                                    <Grid Gap="LayoutGap.Large" ColumnsMd="2" Class="mt-5">
                                        <div>
                                            <label class="cda-field-label">Location</label>
                                            <InputText @bind-Value="profileEditor.Location"
                                                       class="cda-input"
                                                       data-testid="crmhr-workforce-location" />
                                        </div>
                                        <div>
                                            <label class="cda-field-label">Time zone</label>
                                            <InputText @bind-Value="profileEditor.TimeZone"
                                                       class="cda-input"
                                                       data-testid="crmhr-workforce-timezone" />
                                        </div>
                                    </Grid>

                                    <Grid Gap="LayoutGap.Large" ColumnsMd="2" Class="mt-5">
                                        <div>
                                            <label class="cda-field-label">Internal cost rate</label>
                                            <InputNumber @bind-Value="profileEditor.InternalCostRate"
                                                         class="cda-input"
                                                         data-testid="crmhr-workforce-internal-rate" />
                                        </div>
                                        <div>
                                            <label class="cda-field-label">External billing rate</label>
                                            <InputNumber @bind-Value="profileEditor.ExternalBillingRate"
                                                         class="cda-input"
                                                         data-testid="crmhr-workforce-external-rate" />
                                        </div>
                                    </Grid>

                                    <div class="mt-5">
                                        <label class="cda-field-label">Notes</label>
                                        <InputTextArea @bind-Value="profileEditor.Notes"
                                                       class="cda-input min-h-[9rem]"
                                                       data-testid="crmhr-workforce-notes" />
                                    </div>

                                    <Cluster Gap="LayoutGap.Small" Class="mt-5">
                                        <Button Text="Save workforce profile"
                                                Type="submit"
                                                data-testid="crmhr-workforce-save-button" />
                                        <Button Text="Open directory record"
                                                ButtonStyle="ButtonStyle.Light"
                                                Click="OpenDirectory" />
                                    </Cluster>
                                </FormSection>
                            </EditForm>

                            <SkillMatrixPanel SkillCatalog="selectedWorkspace.SkillCatalog"
                                              Skills="selectedWorkspace.Skills"
                                              SkillDraft="skillEditor"
                                              SkillDefinitionDraft="skillDefinitionEditor"
                                              SavePartySkill="SavePartySkillAsync"
                                              SaveSkillDefinition="SaveSkillDefinitionAsync"
                                              DeletePartySkill="DeletePartySkillAsync" />

                            <CapacityTimelinePanel CapacitySummary="selectedWorkspace.CapacitySummary"
                                                   CapacityBlocks="selectedWorkspace.CapacityBlocks"
                                                   ProjectAllocations="selectedWorkspace.ProjectAllocations"
                                                   CapacityBlockDraft="capacityBlockEditor"
                                                   SaveCapacityBlock="SaveCapacityBlockAsync"
                                                   DeleteCapacityBlock="DeleteCapacityBlockAsync"
                                                   OpenProject="OpenProjectAsync" />

                            <div data-testid="crmhr-workforce-timeline">
                                <InteractionTimeline Items="activityTimeline"
                                                    Eyebrow="Workforce history"
                                                    Title="Recent staffing, lifecycle, and audit activity"
                                                    Description="Workforce profile saves, archive/reactivate events, recruiting transitions, and related CRM-HR changes stay visible here for the selected party."
                                                    EmptyEyebrow="No workforce history"
                                                    EmptyTitle="No saved history for this record"
                                                    EmptyDescription="Save a workforce profile or related CRM-HR workflow to build the shared audit trail." />
                            </div>
                        </Stack>
                    }
                </DetailContent>
            </ListDetailShell>
        </Stack>
    </ChildContent>
</PageScaffold>

@code {
    [SupplyParameterFromQuery(Name = "partyId")]
    public Guid? PartyIdQuery { get; set; }

    private static readonly IReadOnlyList<string> WorkforceStatuses =
    [
        "Planned",
        "Active",
        "Leave",
        "Inactive",
        "Alumni"
    ];

    private static readonly IReadOnlyList<string> SeniorityValues =
    [
        string.Empty,
        "Associate",
        "Mid",
        "Senior",
        "Lead",
        "Principal"
    ];

    private readonly DeliveryUnitQuickCreateModel deliveryUnitEditor = new();
    private readonly SkillDefinitionEditorModel skillDefinitionEditor = new()
    {
        IsActive = true
    };
    private IReadOnlyList<WorkforceListItemModel> workforceItems = [];
    private IReadOnlyList<SkillCatalogItemModel> skillCatalog = [];
    private IReadOnlyList<CrmAccountActivityTimelineItemModel> activityTimeline = [];
    private WorkforceWorkspaceModel? selectedWorkspace;
    private WorkforceProfileEditorModel profileEditor = new();
    private PartySkillEditorModel skillEditor = CreatePartySkillEditor(Guid.Empty);
    private CapacityBlockEditorModel capacityBlockEditor = CreateCapacityBlockEditor(Guid.Empty);
    private string searchText = string.Empty;
    private string kindFilter = string.Empty;
    private string skillFilter = string.Empty;
    private string availabilityFilter = string.Empty;
    private string? handledPartyKey;
    private string? message;
    private string messageTone = "success";

    private IReadOnlyList<WorkforceKind> AvailableWorkforceKinds
        => selectedWorkspace is null
            ? Enum.GetValues<WorkforceKind>()
            : selectedWorkspace.PartyType == PartyType.Person
                ? [WorkforceKind.Employee, WorkforceKind.Contractor, WorkforceKind.Freelancer]
                : [WorkforceKind.DeliveryUnit];

    private IReadOnlyList<WorkforceListItemModel> FilteredItems => workforceItems
        .Where(MatchesSearch)
        .Where(MatchesKind)
        .Where(MatchesSkill)
        .Where(MatchesAvailability)
        .OrderBy(item => item.DisplayName)
        .ToList();

    protected override async Task OnParametersSetAsync()
    {
        await LoadItemsAsync();

        var targetPartyId = PartyIdQuery;
        if (!targetPartyId.HasValue && workforceItems.Count > 0)
        {
            targetPartyId = workforceItems[0].PartyId;
        }

        var targetKey = targetPartyId?.ToString("N") ?? "none";
        if (handledPartyKey == targetKey && selectedWorkspace is not null)
        {
            return;
        }

        if (targetPartyId.HasValue)
        {
            var workspace = await HrService.GetWorkforceWorkspaceAsync(targetPartyId.Value);
            if (workspace is null && workforceItems.Count > 0)
            {
                workspace = await HrService.GetWorkforceWorkspaceAsync(workforceItems[0].PartyId);
                targetKey = workforceItems[0].PartyId.ToString("N");
            }

            if (workspace is not null)
            {
                ApplyLoadedWorkspace(workspace, clearMessage: true);
                activityTimeline = await PartyDirectoryService.ListPartyActivityTimelineAsync(workspace.PartyId);
                handledPartyKey = targetKey;
                return;
            }
        }

        selectedWorkspace = null;
        activityTimeline = [];
        profileEditor = new();
        skillEditor = CreatePartySkillEditor(Guid.Empty);
        capacityBlockEditor = CreateCapacityBlockEditor(Guid.Empty);
        handledPartyKey = "none";
        message = null;
    }

    private async Task LoadItemsAsync()
    {
        workforceItems = await HrService.ListWorkforceDirectoryAsync();
        skillCatalog = await HrService.ListSkillCatalogAsync();
    }

    private void ApplyLoadedWorkspace(WorkforceWorkspaceModel workspace, bool clearMessage)
    {
        selectedWorkspace = workspace;
        skillCatalog = workspace.SkillCatalog;
        profileEditor = new WorkforceProfileEditorModel
        {
            Id = workspace.Profile.Id,
            PartyId = workspace.Profile.PartyId,
            WorkforceKind = workspace.Profile.WorkforceKind,
            EmployeeCode = workspace.Profile.EmployeeCode,
            JobTitle = workspace.Profile.JobTitle,
            Discipline = workspace.Profile.Discipline,
            Seniority = workspace.Profile.Seniority,
            HomeUnitPartyId = workspace.Profile.HomeUnitPartyId,
            ManagerPartyId = workspace.Profile.ManagerPartyId,
            StartDate = workspace.Profile.StartDate,
            EndDate = workspace.Profile.EndDate,
            Location = workspace.Profile.Location,
            TimeZone = workspace.Profile.TimeZone,
            InternalCostRate = workspace.Profile.InternalCostRate,
            ExternalBillingRate = workspace.Profile.ExternalBillingRate,
            CapacityHoursPerWeek = workspace.Profile.CapacityHoursPerWeek,
            Status = workspace.Profile.Status,
            Notes = workspace.Profile.Notes,
            LastChangedBy = workspace.Profile.LastChangedBy
        };
        skillEditor = CreatePartySkillEditor(workspace.PartyId);
        capacityBlockEditor = CreateCapacityBlockEditor(workspace.PartyId);

        if (clearMessage)
        {
            message = null;
            messageTone = "success";
        }
    }

    private async Task ReloadSelectedPartyAsync(bool clearMessage)
    {
        if (selectedWorkspace is null)
        {
            return;
        }

        await LoadItemsAsync();
        var workspace = await HrService.GetWorkforceWorkspaceAsync(selectedWorkspace.PartyId);
        if (workspace is not null)
        {
            ApplyLoadedWorkspace(workspace, clearMessage);
            activityTimeline = await PartyDirectoryService.ListPartyActivityTimelineAsync(workspace.PartyId);
        }
    }


<FormSection Title="Capacity and allocations"
             Description="Capacity windows and project allocations stay on the same workforce record so conflict detection is grounded in live project commitments.">
    @{
        var capacitySummary = CapacitySummary ?? DefaultCapacitySummary;
    }

    <Grid Gap="LayoutGap.Medium" ColumnsLg="4">
        <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 px-4 py-4">
            <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Availability</p>
            <p class="mt-1 text-sm font-semibold text-slate-950"
               data-testid="crmhr-capacity-availability-message">@capacitySummary.AvailabilityMessage</p>
        </div>
        <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 px-4 py-4">
            <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Weekly capacity</p>
            <p class="mt-1 text-sm font-semibold text-slate-950">@($"{capacitySummary.CapacityHoursPerWeek:0.##}h")</p>
        </div>
        <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 px-4 py-4">
            <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Active allocations</p>
            <p class="mt-1 text-sm font-semibold text-slate-950">@FormatPercent(capacitySummary.ActiveAllocationPercent)</p>
        </div>
        <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 px-4 py-4">
            <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Blocked</p>
            <p class="mt-1 text-sm font-semibold text-slate-950">@FormatPercent(capacitySummary.ActiveBlockedPercent)</p>
        </div>
    </Grid>

    @if (capacitySummary.IsOverallocated)
    {
        <div class="mt-4 rounded-[1.2rem] border border-rose-200 bg-rose-50 px-4 py-4 text-sm font-medium text-rose-700"
             data-testid="crmhr-capacity-conflict-callout">
            Conflict: project allocations and capacity blocks exceed 100% of available capacity. Resolve the overlap before staffing additional work.
        </div>
    }
    else if (capacitySummary.IsBench)
    {
        <div class="mt-4 rounded-[1.2rem] border border-emerald-200 bg-emerald-50 px-4 py-4 text-sm font-medium text-emerald-700">
            Bench signal: this profile is currently lightly committed and should be considered for open staffing requests.
        </div>
    }

    <Grid Gap="LayoutGap.Large" ColumnsLg="2" Class="mt-6">
        <SurfaceCard>
            <p class="cda-eyebrow">Capacity block</p>
            <h3 class="mt-1 text-lg font-semibold text-slate-950">Add leave or reserve time</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
                Use partial blocks for leave, reserve, or temporary unavailability so availability math stays explicit.
            </p>

            <Grid Gap="LayoutGap.Medium" ColumnsMd="3" Class="mt-4">
                <FormField Text="Block type">
                    <InputSelect @bind-Value="CapacityBlockDraft.BlockKind"
                                 class="cda-input"
                                 data-testid="crmhr-capacity-block-kind">
                        @foreach (var blockKind in Enum.GetValues<CapacityBlockKind>())
                        {
                            <option value="@blockKind">@blockKind</option>
                        }
                    </InputSelect>
                </FormField>
                <FormField Text="Starts on">
                    <InputDate @bind-Value="CapacityBlockDraft.StartDate"
                               class="cda-input"
                               data-testid="crmhr-capacity-block-start-date" />
                </FormField>
                <FormField Text="Ends on">
                    <InputDate @bind-Value="CapacityBlockDraft.EndDate"
                               class="cda-input"
                               data-testid="crmhr-capacity-block-end-date" />
                </FormField>
            </Grid>

            <Grid Gap="LayoutGap.Medium" ColumnsMd="2" Class="mt-4">
                <FormField Text="Blocked %">
                    <InputNumber @bind-Value="CapacityBlockDraft.Percentage"
                                 class="cda-input"
                                 data-testid="crmhr-capacity-block-percentage" />
                </FormField>
                <FormField Text="Notes">
                    <InputText @bind-Value="CapacityBlockDraft.Notes"
                               class="cda-input"
                               data-testid="crmhr-capacity-block-notes" />
                </FormField>
            </Grid>

            <Cluster Gap="LayoutGap.Small" Class="mt-4">
                <Button Text="Save capacity block"
                        Click="SaveCapacityBlock"
                        data-testid="crmhr-capacity-block-save-button" />
            </Cluster>
        </SurfaceCard>

        <SurfaceCard Soft="true">
            <p class="cda-eyebrow">Forward look</p>
            <h3 class="mt-1 text-lg font-semibold text-slate-950">Availability outlook</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
                Project allocations are read directly from project-party assignments, so this view is already bidirectional with the project module.
            </p>

            <Stack GapScale="LayoutGap.Small" Class="mt-4">
                <div class="rounded-[1.1rem] border border-slate-200 bg-white px-4 py-3">
                    <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Available now</p>
                    <p class="mt-1 text-sm font-semibold text-slate-950">@FormatPercent(capacitySummary.AvailablePercent)</p>
                </div>
                <div class="rounded-[1.1rem] border border-slate-200 bg-white px-4 py-3">
                    <p class="text-xs uppercase tracking-[0.18em] text-slate-500">State</p>
                    <Cluster Gap="LayoutGap.Small" Class="mt-2">
                        <StatusBadge Tone="@ResolveAvailabilityTone(capacitySummary.AvailabilityState)"
                                     Text="@capacitySummary.AvailabilityState.ToString()" />
                        @if (capacitySummary.NextAvailabilityOn.HasValue)
                        {
                            <StatusBadge Tone="info"
                                         Text="@($"Next: {capacitySummary.NextAvailabilityOn.Value:yyyy-MM-dd}")" />
                        }
                    </Cluster>
                </div>
                <div class="rounded-[1.1rem] border border-slate-200 bg-white px-4 py-3">
                    <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Project allocations</p>
                    <p class="mt-1 text-sm font-semibold text-slate-950">@ProjectAllocations.Count allocation(s)</p>
                </div>
            </Stack>
        </SurfaceCard>
    </Grid>

    <Grid Gap="LayoutGap.Large" ColumnsLg="2" Class="mt-6">
        <SurfaceCard Soft="true">
            <p class="cda-eyebrow">Capacity blocks</p>
            <h3 class="mt-1 text-lg font-semibold text-slate-950">@CapacityBlocks.Count block(s)</h3>

            @if (CapacityBlocks.Count == 0)
            {
                <p class="mt-3 text-sm leading-6 text-slate-600">No leave or reserve blocks are currently recorded.</p>
            }
            else
            {
                <Stack GapScale="LayoutGap.Medium" Class="mt-4">
                    @foreach (var block in CapacityBlocks)
                    {
                        <PanelCard data-testid="crmhr-capacity-block-item">
                            <Split Gap="LayoutGap.Medium"
                                   AlignItems="AlignItems.Start"
                                   JustifyContent="JustifyContent.SpaceBetween">
                                <div class="min-w-0 space-y-1">
                                    <p class="text-base font-semibold text-slate-950">@block.BlockKind</p>
                                    <p class="text-sm text-slate-600">
                                        @($"{block.StartDate:yyyy-MM-dd} -> {block.EndDate:yyyy-MM-dd}") / @FormatPercent(block.Percentage)
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(block.RelatedProjectName))
                                    {
                                        <p class="text-sm text-slate-600">Project: @block.RelatedProjectName</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(block.Notes))
                                    {
                                        <p class="text-sm leading-6 text-slate-600">@block.Notes</p>
                                    }
                                </div>
                                <Cluster Gap="LayoutGap.Small">
                                    <StatusBadge Tone="@(block.IsActive ? "warning" : block.IsFuture ? "info" : "base")"
                                                 Text="@(block.IsActive ? "Active" : block.IsFuture ? "Future" : "Past")" />
                                    <Button Text="Delete"
                                            ButtonStyle="ButtonStyle.Danger"
                                            Size="ButtonSize.Small"
                                            Click="@(() => DeleteCapacityBlock.InvokeAsync(block.Id))"
                                            data-testid="crmhr-capacity-block-delete-button" />
                                </Cluster>
                            </Split>
                        </PanelCard>
                    }
                </Stack>
            }
        </SurfaceCard>

        <SurfaceCard>
            <p class="cda-eyebrow">Project allocations</p>
            <h3 class="mt-1 text-lg font-semibold text-slate-950">@ProjectAllocations.Count project-linked commitment(s)</h3>

            @if (ProjectAllocations.Count == 0)
            {
                <p class="mt-3 text-sm leading-6 text-slate-600">No project allocations are currently pushing capacity from the project module.</p>
            }
            else
            {
                <Stack GapScale="LayoutGap.Medium" Class="mt-4">
                    @foreach (var allocation in ProjectAllocations)
                    {
                        <PanelCard data-testid="crmhr-workforce-allocation-item">
                            <Split Gap="LayoutGap.Medium"
                                   AlignItems="AlignItems.Start"
                                   JustifyContent="JustifyContent.SpaceBetween">
                                <div class="min-w-0 space-y-1">
                                    <p class="text-base font-semibold text-slate-950">@allocation.ProjectName</p>
                                    <p class="text-sm text-slate-600">@allocation.Role / @FormatPercent(allocation.AllocationPercent)</p>
                                    @if (allocation.StartsOn.HasValue || allocation.EndsOn.HasValue)
                                    {
                                        <p class="text-sm text-slate-600">
                                            @($"{FormatDate(allocation.StartsOn)} -> {FormatDate(allocation.EndsOn)}")
                                        </p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(allocation.Notes))
                                    {
                                        <p class="text-sm leading-6 text-slate-600">@allocation.Notes</p>
                                    }
                                </div>
                                <Cluster Gap="LayoutGap.Small">
                                    <StatusBadge Tone="@(allocation.IsActive ? "success" : allocation.IsFuture ? "info" : "base")"
                                                 Text="@(allocation.IsActive ? "Active" : allocation.IsFuture ? "Future" : "Past")" />
                                    <Button Text="Open project"
                                            ButtonStyle="ButtonStyle.Light"
                                            Size="ButtonSize.Small"
                                            Click="@(() => OpenProject.InvokeAsync(allocation.ProjectId))"
                                            data-testid="crmhr-workforce-open-project" />
                                </Cluster>
                            </Split>
                        </PanelCard>
                    }
                </Stack>
            }
        </SurfaceCard>
    </Grid>
</FormSection>

@code {
    private static readonly WorkforceCapacitySummaryModel DefaultCapacitySummary =
        new(40m, 0m, 0m, 100m, WorkforceAvailabilityState.Bench, "Bench or lightly committed.", null, false, true);

    [Parameter]
    public WorkforceCapacitySummaryModel? CapacitySummary { get; set; }

    [Parameter]
    public IReadOnlyList<CapacityBlockItemModel> CapacityBlocks { get; set; } = [];

    [Parameter]
    public IReadOnlyList<ProjectAllocationItemModel> ProjectAllocations { get; set; } = [];

    [Parameter]
    public CapacityBlockEditorModel CapacityBlockDraft { get; set; } = new();

    [Parameter]
    public EventCallback SaveCapacityBlock { get; set; }

    [Parameter]
    public EventCallback<Guid> DeleteCapacityBlock { get; set; }

    [Parameter]
    public EventCallback<Guid> OpenProject { get; set; }

    private static string ResolveAvailabilityTone(WorkforceAvailabilityState availabilityState)
    {
        return availabilityState switch
        {
            WorkforceAvailabilityState.Overallocated => "danger",
            WorkforceAvailabilityState.Bench => "success",
            WorkforceAvailabilityState.NearAvailable => "warning",
            _ => "info"
        };
    }

    private static string FormatPercent(decimal value)
    {
        return $"{value:0.##}%";
    }

    private static string FormatDate(DateOnly? value)
    {
        return value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "Open";
    }
}

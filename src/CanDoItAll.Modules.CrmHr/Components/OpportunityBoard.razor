@foreach (var stage in Enum.GetValues<OpportunityStage>())
{
    var stageOpportunities = Opportunities
        .Where(item => item.Stage == stage)
        .OrderByDescending(item => item.UpdatedAtUtc)
        .ToList();
    var weightedValue = stageOpportunities.Sum(item => (item.Amount ?? 0m) * item.ProbabilityPercent / 100m);

    <SurfaceCard Soft="@(stage is OpportunityStage.Won or OpportunityStage.Lost)"
                 data-testid="@($"crmhr-opportunity-column-{stage.ToString().ToLowerInvariant()}")">
        <Split Gap="LayoutGap.Medium"
               AlignItems="AlignItems.Start"
               JustifyContent="JustifyContent.SpaceBetween">
            <div class="min-w-0">
                <p class="cda-eyebrow">@ResolveStageEyebrow(stage)</p>
                <h3 class="mt-1 text-lg font-semibold text-slate-950">@stage</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600">@ResolveStageDescription(stage)</p>
            </div>
            <Cluster Gap="LayoutGap.Small">
                <StatusBadge Tone="@ResolveStageTone(stage)" Text="@($"{stageOpportunities.Count}")" />
                @if (weightedValue > 0)
                {
                    <StatusBadge Tone="neutral" Text="@($"Weighted {weightedValue:0.##}")" />
                }
            </Cluster>
        </Split>

        @if (stageOpportunities.Count == 0)
        {
            <div class="mt-4 rounded-[1.2rem] border border-dashed border-slate-300 bg-slate-50/70 px-4 py-4 text-sm leading-6 text-slate-600">
                No opportunities in this stage yet.
            </div>
        }
        else
        {
            <Stack GapScale="LayoutGap.Small" Class="mt-4">
                @foreach (var opportunity in stageOpportunities)
                {
                    var latestHistory = opportunity.StageHistory.FirstOrDefault();
                    var primaryPartner = opportunity.Parties.FirstOrDefault(item => item.Role == OpportunityPartyRole.Partner);

                    <div class="rounded-[1.25rem] border px-4 py-4 @(SelectedOpportunityId == opportunity.Id ? "border-sky-400 bg-sky-50/70" : "border-slate-200 bg-white")"
                         data-testid="@($"crmhr-opportunity-card-{opportunity.Id:N}")">
                        <Split Gap="LayoutGap.Small"
                               AlignItems="AlignItems.Start"
                               JustifyContent="JustifyContent.SpaceBetween">
                            <div class="min-w-0">
                                <p class="text-sm font-semibold text-slate-950">@opportunity.Title</p>
                                <p class="mt-1 text-xs uppercase tracking-[0.18em] text-slate-500">
                                    @opportunity.OpportunitySource / @opportunity.OwnerDisplayName
                                </p>
                                @if (!string.IsNullOrWhiteSpace(opportunity.DeliveryUnitDisplayName))
                                {
                                    <p class="mt-2 text-sm text-slate-600">Delivery unit: @opportunity.DeliveryUnitDisplayName</p>
                                }
                                @if (primaryPartner is not null)
                                {
                                    <p class="mt-1 text-sm text-slate-600">Partner: @primaryPartner.DisplayName</p>
                                }
                            </div>
                            <StatusBadge Tone="@ResolveStageTone(opportunity.Stage)"
                                         Text="@ResolveValueLabel(opportunity)" />
                        </Split>

                        @if (!string.IsNullOrWhiteSpace(opportunity.Summary))
                        {
                            <p class="mt-3 text-sm leading-6 text-slate-600">@opportunity.Summary</p>
                        }

                        <Cluster Gap="LayoutGap.Small" Class="mt-4">
                            <Button Text="Open"
                                    Size="ButtonSize.Small"
                                    Click="@(() => SelectOpportunity.InvokeAsync(opportunity.Id))"
                                    data-testid="@($"crmhr-opportunity-select-{opportunity.Id:N}")" />
                            @if (CanAdvance(opportunity.Stage))
                            {
                                <Button Text="@($"Advance to {ResolveNextStage(opportunity.Stage)}")"
                                        ButtonStyle="ButtonStyle.Light"
                                        Size="ButtonSize.Small"
                                        Click="@(() => AdvanceOpportunityStage.InvokeAsync(opportunity.Id))"
                                        data-testid="@($"crmhr-opportunity-advance-{opportunity.Id:N}")" />
                            }
                            @if (!string.IsNullOrWhiteSpace(opportunity.LinkedProjectName))
                            {
                                <StatusBadge Tone="success" Text="Linked project" />
                            }
                        </Cluster>

                        <p class="mt-3 text-xs uppercase tracking-[0.18em] text-slate-500">
                            @(latestHistory is null
                                ? $"Updated {opportunity.UpdatedAtUtc:yyyy-MM-dd}"
                                : $"Last movement {latestHistory.ChangedAtUtc:yyyy-MM-dd} by {latestHistory.ChangedBy}")
                        </p>
                    </div>
                }
            </Stack>
        }
    </SurfaceCard>
}

@code {
    [Parameter]
    public IReadOnlyList<CrmOpportunityDetailModel> Opportunities { get; set; } = [];

    [Parameter]
    public Guid? SelectedOpportunityId { get; set; }

    [Parameter]
    public EventCallback<Guid> SelectOpportunity { get; set; }

    [Parameter]
    public EventCallback<Guid> AdvanceOpportunityStage { get; set; }

    private static bool CanAdvance(OpportunityStage stage)
    {
        return stage is not OpportunityStage.Won and not OpportunityStage.Lost;
    }

    private static OpportunityStage ResolveNextStage(OpportunityStage stage)
    {
        return stage switch
        {
            OpportunityStage.Identified => OpportunityStage.Qualified,
            OpportunityStage.Qualified => OpportunityStage.Proposal,
            OpportunityStage.Proposal => OpportunityStage.Negotiation,
            OpportunityStage.Negotiation => OpportunityStage.Won,
            _ => stage
        };
    }

    private static string ResolveStageTone(OpportunityStage stage)
    {
        return stage switch
        {
            OpportunityStage.Identified => "neutral",
            OpportunityStage.Qualified => "info",
            OpportunityStage.Proposal => "warning",
            OpportunityStage.Negotiation => "warning",
            OpportunityStage.Won => "success",
            OpportunityStage.Lost => "danger",
            _ => "neutral"
        };
    }

    private static string ResolveStageEyebrow(OpportunityStage stage)
    {
        return stage switch
        {
            OpportunityStage.Identified => "Discovery",
            OpportunityStage.Qualified => "Validation",
            OpportunityStage.Proposal => "Commercial",
            OpportunityStage.Negotiation => "Close plan",
            OpportunityStage.Won => "Closed won",
            OpportunityStage.Lost => "Closed lost",
            _ => "Pipeline"
        };
    }

    private static string ResolveStageDescription(OpportunityStage stage)
    {
        return stage switch
        {
            OpportunityStage.Identified => "New demand signals and early shaping before qualification.",
            OpportunityStage.Qualified => "Confirmed demand, owner, and commercial fit.",
            OpportunityStage.Proposal => "Proposal and commercial packaging are in play.",
            OpportunityStage.Negotiation => "Decision path is active and close planning matters.",
            OpportunityStage.Won => "Closed work that should hand off into project context.",
            OpportunityStage.Lost => "Historically visible losses with reason capture.",
            _ => "Opportunity pipeline stage."
        };
    }

    private static string ResolveValueLabel(CrmOpportunityDetailModel opportunity)
    {
        if (!opportunity.Amount.HasValue)
        {
            return $"{opportunity.ProbabilityPercent}%";
        }

        return $"{opportunity.CurrencyCode} {opportunity.Amount.Value:0.##}";
    }
}

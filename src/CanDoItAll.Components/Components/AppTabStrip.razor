@namespace CanDoItAll.Components
@using CanDoItAll.SharedKernel

<div class="flex flex-col gap-1.5 px-1 @(Compact ? "" : "pb-1")">
    <div class="flex flex-col gap-2 xl:flex-row xl:items-center xl:justify-between">
        <div class="flex min-w-0 flex-wrap items-center gap-1.5">
            @foreach (var tab in InlineTabs)
            {
                @RenderTab(tab)
            }
        </div>

        <div class="flex flex-shrink-0 flex-wrap items-center gap-1.5">
            @if (Items.Count > InlineTabLimit || RecentTabs.Count > 0)
            {
                <input @bind="searchText"
                       @bind:event="oninput"
                       placeholder="Search tabs"
                       class="w-36 rounded-lg border border-slate-200 bg-white px-2 py-1 text-xs text-slate-700 outline-none transition focus:border-slate-400" />
            }

            @if (OverflowTabs.Count > 0)
            {
                <details class="group relative">
                    <summary class="cursor-pointer list-none rounded-lg border border-slate-200 bg-slate-50 px-2 py-1 text-xs font-semibold text-slate-700">
                        +@OverflowTabs.Count
                    </summary>
                    <div class="absolute right-0 z-20 mt-2 w-80 rounded-2xl border border-slate-200 bg-white p-3 shadow-2xl shadow-slate-900/10">
                        <div class="space-y-2">
                            @foreach (var tab in OverflowTabs)
                            {
                                <button type="button"
                                        class="flex w-full items-center justify-between rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-left text-sm text-slate-700 transition hover:border-slate-300 hover:bg-slate-100"
                                        @onclick="() => Activate.InvokeAsync(tab.TabId)">
                                    <span class="min-w-0">
                                        <span class="block truncate font-semibold text-slate-900">@tab.Title</span>
                                        <span class="block truncate text-xs text-slate-500">@tab.TabGroup / @tab.Route</span>
                                    </span>
                                    @if (tab.IsSleeping)
                                    {
                                        <span class="rounded-full bg-slate-200 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-slate-700">zZ</span>
                                    }
                                </button>
                            }
                        </div>
                    </div>
                </details>
            }

            @if (RecentTabs.Count > 0)
            {
                <details class="group relative">
                    <summary class="cursor-pointer list-none rounded-lg border border-slate-200 bg-slate-50 px-2 py-1 text-xs font-semibold text-slate-700">
                        Reopen
                    </summary>
                    <div class="absolute right-0 z-20 mt-2 w-72 rounded-2xl border border-slate-200 bg-white p-3 shadow-2xl shadow-slate-900/10">
                        <div class="space-y-2">
                            @foreach (var recent in FilteredRecentTabs)
                            {
                                <button type="button"
                                        class="flex w-full items-center justify-between rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-left text-sm text-slate-700 transition hover:border-slate-300 hover:bg-slate-100"
                                        title="Reopen recent tab"
                                        @onclick="() => ReopenRecent.InvokeAsync(recent.TabId)">
                                    <span class="min-w-0">
                                        <span class="block truncate font-semibold text-slate-900">@recent.Title</span>
                                        <span class="block truncate text-xs text-slate-500">@recent.TabGroup / @recent.Route</span>
                                    </span>
                                    <span class="text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-500">restore</span>
                                </button>
                            }
                        </div>
                    </div>
                </details>
            }
        </div>
    </div>

    @if (ShowActiveSummary && ActiveTab is not null)
    {
        <div class="flex flex-col gap-2 rounded-xl border border-slate-200/80 bg-slate-50/80 px-3 py-2 xl:flex-row xl:items-center xl:justify-between">
            <div class="flex min-w-0 flex-wrap items-center gap-1.5">
                <p class="text-xs font-semibold text-slate-900">@ActiveTab.Title</p>
                <span class="rounded-full bg-white px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-[0.2em] text-slate-500">@ActiveTab.TabGroup</span>
                @if (!string.IsNullOrWhiteSpace(ActiveTab.ProjectName))
                {
                    <span class="rounded-full bg-sky-50 px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-[0.2em] text-sky-700">@ActiveTab.ProjectName</span>
                }
                <span class="truncate text-[10px] text-slate-400">@ActiveTab.Route</span>
            </div>

            <div class="flex flex-shrink-0 items-center gap-1">
                <button type="button"
                        class="rounded-lg border border-slate-200 bg-white px-2 py-1 text-[10px] font-semibold text-slate-600 hover:bg-slate-50"
                        title="Close other tabs"
                        @onclick="() => CloseOthers.InvokeAsync(ActiveTab.TabId)">
                    Close others
                </button>
                <button type="button"
                        class="rounded-lg border border-slate-200 bg-white px-2 py-1 text-[10px] font-semibold text-slate-600 hover:bg-slate-50"
                        title="Close tabs to the right"
                        @onclick="() => CloseRight.InvokeAsync(ActiveTab.TabId)">
                    Close right
                </button>
            </div>
        </div>
    }
</div>

@code {
    private const int InlineTabLimit = 6;
    private string searchText = string.Empty;

    [Parameter]
    public IReadOnlyList<WorkbenchTabState> Items { get; set; } = [];

    [Parameter]
    public IReadOnlyList<WorkbenchTabState> RecentTabs { get; set; } = [];

    [Parameter]
    public string? ActiveTabId { get; set; }

    [Parameter]
    public bool ShowActiveSummary { get; set; } = true;

    [Parameter]
    public bool Compact { get; set; }

    [Parameter]
    public EventCallback<string> Activate { get; set; }

    [Parameter]
    public EventCallback<string> Close { get; set; }

    [Parameter]
    public EventCallback<string> MoveLeft { get; set; }

    [Parameter]
    public EventCallback<string> MoveRight { get; set; }

    [Parameter]
    public EventCallback<string> TogglePin { get; set; }

    [Parameter]
    public EventCallback<string> ToggleSleep { get; set; }

    [Parameter]
    public EventCallback<string> CloseOthers { get; set; }

    [Parameter]
    public EventCallback<string> CloseRight { get; set; }

    [Parameter]
    public EventCallback<string> CloseBackground { get; set; }

    [Parameter]
    public EventCallback<string> ReopenRecent { get; set; }

    private WorkbenchTabState? ActiveTab => Items.FirstOrDefault(tab => string.Equals(tab.TabId, ActiveTabId, StringComparison.Ordinal));

    private IReadOnlyList<WorkbenchTabState> FilteredTabs
        => string.IsNullOrWhiteSpace(searchText)
            ? Items
            : Items.Where(tab =>
                    tab.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    tab.Route.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(tab.ProjectName, searchText, StringComparison.OrdinalIgnoreCase))
                .ToList();

    private IReadOnlyList<WorkbenchTabState> InlineTabs => FilteredTabs.Take(InlineTabLimit).ToList();

    private IReadOnlyList<WorkbenchTabState> OverflowTabs => FilteredTabs.Skip(InlineTabLimit).ToList();

    private IReadOnlyList<WorkbenchTabState> FilteredRecentTabs
        => string.IsNullOrWhiteSpace(searchText)
            ? RecentTabs
            : RecentTabs.Where(tab =>
                    tab.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    tab.Route.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                .ToList();

    private RenderFragment RenderTab(WorkbenchTabState tab) => @<div class="group/tab inline-flex items-center gap-1 rounded-lg border px-2 py-1 text-xs transition @(IsActive(tab) ? "border-slate-900 bg-slate-900 text-white" : "border-transparent bg-slate-100/80 text-slate-600 hover:border-slate-200 hover:bg-slate-50")">
        <button type="button" class="inline-flex min-w-0 items-center gap-1.5 text-left" @onclick="() => Activate.InvokeAsync(tab.TabId)">
            <span class="max-w-[9rem] truncate font-medium">@tab.Title</span>
            @if (tab.IsDirty)
            {
                <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
            }
            @if (tab.IsPinned)
            {
                <span class="text-[9px] font-semibold uppercase text-sky-400">pin</span>
            }
        </button>

        <div class="hidden items-center gap-0.5 text-[9px] font-semibold group-hover/tab:inline-flex @(IsActive(tab) ? "inline-flex" : "")">
            <button type="button" class="rounded px-1 py-0.5 opacity-60 transition hover:opacity-100" title="Move left" @onclick="() => MoveLeft.InvokeAsync(tab.TabId)">&#x2039;</button>
            <button type="button" class="rounded px-1 py-0.5 opacity-60 transition hover:opacity-100" title="Move right" @onclick="() => MoveRight.InvokeAsync(tab.TabId)">&#x203A;</button>
            <button type="button" class="rounded px-1 py-0.5 opacity-60 transition hover:opacity-100" title="Pin tab" @onclick="() => TogglePin.InvokeAsync(tab.TabId)">pin</button>
            <button type="button" class="rounded px-1 py-0.5 opacity-60 transition hover:opacity-100" title="Sleep/wake" @onclick="() => ToggleSleep.InvokeAsync(tab.TabId)">zZ</button>
            @if (tab.CanClose)
            {
                <button type="button" class="rounded px-1 py-0.5 opacity-60 transition hover:opacity-100" title="Close tab" @onclick="() => Close.InvokeAsync(tab.TabId)">x</button>
            }
        </div>
    </div>;

    private bool IsActive(WorkbenchTabState tab)
        => string.Equals(tab.TabId, ActiveTabId, StringComparison.Ordinal);
}

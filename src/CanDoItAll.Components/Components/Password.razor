<input type="password"
       @attributes='AdditionalAttributes.WithClass("rz-input w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800")'
       value="@Value"
       placeholder="@Placeholder"
       @onchange="OnChangedAsync"
        />

@code {
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<string?> Change { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task OnChangedAsync(ChangeEventArgs args)
    {
        var next = args.Value?.ToString();
        Value = next;
        await ValueChanged.InvokeAsync(next);
        await Change.InvokeAsync(next);
    }
}






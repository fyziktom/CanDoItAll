@namespace CanDoItAll.Components
@using CanDoItAll.Components.BaseLib

<Stack Gap="0.5rem"
       Class="rz-form-field"
       AdditionalAttributes="AdditionalAttributes">
    @if (!string.IsNullOrWhiteSpace(Text))
    {
        <label class="text-xs font-semibold uppercase tracking-wide text-slate-500">@Text</label>
    }
    <Cluster Wrap="FlexWrap.NoWrap"
             Gap="LayoutGap.Small"
             AlignItems="AlignItems.Center">
        @if (Start is not null)
        {
            <div class="rz-form-field-start">@Start</div>
        }
        <div class="flex-1">
            @ChildContent
        </div>
        @if (End is not null)
        {
            <div class="rz-form-field-end">@End</div>
        }
    </Cluster>
</Stack>

@code {
    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Start { get; set; }

    [Parameter]
    public RenderFragment? End { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}





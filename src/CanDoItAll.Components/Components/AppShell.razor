@namespace CanDoItAll.Components
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.SharedKernel

<div class="@ResolveRootClass()"
     style="@ResolveRootStyle()">
    <div class="@ResolveFrameClass()"
         style="@ResolveFrameStyle()">
        <aside class="cda-shell-sidebar @(Mode == AppShellMode.FocusWorkbench ? "cda-shell-sidebar--focus" : "cda-shell-sidebar--standard")">
                <Stack GapScale="LayoutGap.Large"
                       Class="mb-7">
                    <Stack GapScale="LayoutGap.Tiny">
                        <p class="cda-eyebrow text-sky-300 tracking-[0.35em]">CanDoItAll</p>
                        <h1 class="@(Mode == AppShellMode.FocusWorkbench ? "text-xl" : "text-2xl") font-semibold tracking-tight text-white">Local delivery workbench</h1>
                        <p class="text-sm leading-6 text-slate-400">Projects, prompts, validation, scheduling, and evidence in one recoverable workspace.</p>
                    </Stack>

                    @if (Workspaces.Count > 0)
                    {
                        <Stack GapScale="LayoutGap.Small"
                               Class="cda-shell-card-dark">
                            <p class="cda-eyebrow cda-eyebrow--tight text-slate-400 tracking-[0.28em]">Workspace</p>
                            @foreach (var workspace in Workspaces)
                            {
                                <button type="button"
                                        class="cda-shell-pick-button @(workspace.Id == ActiveWorkspaceId ? "cda-shell-pick-button--active" : "cda-shell-pick-button--inactive")"
                                        @onclick="() => SelectWorkspace.InvokeAsync(workspace.Id)">
                                    <span class="block text-sm font-semibold">@workspace.Title</span>
                                    <span class="mt-1 block text-xs leading-5 text-slate-400">@workspace.Description</span>
                                </button>
                            }
                        </Stack>
                    }

                    @if (!string.IsNullOrWhiteSpace(ProjectContextTitle))
                    {
                        <div class="cda-shell-card-info">
                            <p class="cda-eyebrow cda-eyebrow--tight text-sky-300 tracking-[0.28em]">Project Context</p>
                            <p class="mt-2 text-sm font-semibold text-white">@ProjectContextTitle</p>
                            @if (!string.IsNullOrWhiteSpace(PhaseContextTitle))
                            {
                                <p class="mt-1 text-xs text-slate-300">@PhaseContextTitle</p>
                            }
                        </div>
                    }
                </Stack>

                <nav class="space-y-2">
                    @foreach (var item in NavigationItems)
                    {
                        var normalizedCurrentRoute = string.IsNullOrWhiteSpace(CurrentRoute) ? "/" : $"/{CurrentRoute.TrimStart('/')}";
                        var isActive = IsRouteMatch(normalizedCurrentRoute, item.Route);
                    <button type="button"
                            class="cda-shell-nav-button @(isActive ? "cda-shell-nav-button--active" : "cda-shell-nav-button--inactive")"
                            @onclick="() => Navigate.InvokeAsync(item.Route)">
                        <span class="cda-shell-nav-icon" aria-hidden="true"><Icon Name="@item.Icon" /></span>
                        <span class="space-y-1 min-w-0 flex-1">
                            <span class="flex items-start gap-2">
                                <span class="block text-sm font-semibold">@item.Title</span>
                                @if (!string.IsNullOrWhiteSpace(item.BadgeText))
                                {
                                    <span class="inline-flex min-w-6 items-center justify-center rounded-full bg-sky-400/15 px-2 py-1 text-[0.65rem] font-semibold leading-none text-sky-200"
                                          data-testid="@($"shell-nav-badge-{item.Route.Trim('/').Replace('/', '-') }")">
                                        @item.BadgeText
                                    </span>
                                }
                            </span>
                            <span class="block text-xs leading-5 text-slate-400">@item.Description</span>
                        </span>
                    </button>
                }
            </nav>

                @if (OpenedProjects.Count > 0)
                    {
                        <Stack GapScale="LayoutGap.Small"
                               Class="mt-8">
                            <p class="cda-eyebrow cda-eyebrow--tight text-slate-400 tracking-[0.3em]">Opened Projects</p>
                            @foreach (var item in OpenedProjects)
                            {
                                <button type="button"
                                    class="cda-shell-card-dark w-full text-left transition hover:bg-white/10"
                                    @onclick="() => OpenWorkbenchItem.InvokeAsync(item.TabId)">
                                <span class="block text-sm font-semibold text-white">@item.Title</span>
                                <span class="mt-1 block text-xs text-slate-400">@item.TabKind / @item.Route</span>
                                </button>
                            }
                        </Stack>
                }

                @if (OpenedSessions.Count > 0)
                    {
                        <Stack GapScale="LayoutGap.Small"
                               Class="mt-8">
                            <p class="cda-eyebrow cda-eyebrow--tight text-slate-400 tracking-[0.3em]">Prompt Sessions</p>
                            @foreach (var item in OpenedSessions)
                            {
                                <button type="button"
                                    class="cda-shell-card-dark w-full text-left transition hover:bg-white/10"
                                    @onclick="() => OpenWorkbenchItem.InvokeAsync(item.TabId)">
                                <span class="block text-sm font-semibold text-white">@item.Title</span>
                                <span class="mt-1 block text-xs text-slate-400">@item.Route</span>
                                </button>
                            }
                        </Stack>
                }
        </aside>

        <main class="flex min-w-0 min-h-0 flex-1 flex-col gap-2">
            <details class="cda-shell-mobile-panel">
                <summary class="cursor-pointer list-none text-sm font-semibold text-slate-900">
                    Workspace navigation
                </summary>
                <Stack GapScale="LayoutGap.Large"
                       Class="mt-4">
                    @if (Workspaces.Count > 0)
                    {
                        <Grid Gap="LayoutGap.Small"
                              ColumnsMd="3">
                            @foreach (var workspace in Workspaces)
                            {
                                <button type="button"
                                        class="cda-shell-mobile-card @(workspace.Id == ActiveWorkspaceId ? "cda-shell-mobile-card--active" : "cda-shell-mobile-card--inactive")"
                                        @onclick="() => SelectWorkspace.InvokeAsync(workspace.Id)">
                                    <span class="block text-sm font-semibold">@workspace.Title</span>
                                    <span class="mt-1 block text-xs leading-5 @(workspace.Id == ActiveWorkspaceId ? "text-slate-200" : "text-slate-500")">@workspace.Description</span>
                                </button>
                            }
                        </Grid>
                    }

                    <Grid Gap="LayoutGap.Small"
                          ColumnsLg="2">
                        @foreach (var item in NavigationItems)
                        {
                            var normalizedCurrentRoute = string.IsNullOrWhiteSpace(CurrentRoute) ? "/" : $"/{CurrentRoute.TrimStart('/')}";
                            var isActive = IsRouteMatch(normalizedCurrentRoute, item.Route);
                            <button type="button"
                                    class="cda-shell-mobile-card @(isActive ? "cda-shell-mobile-card--active" : "cda-shell-mobile-card--inactive")"
                                    @onclick="() => Navigate.InvokeAsync(item.Route)">
                                <span class="cda-eyebrow inline-flex @(isActive ? "text-slate-200" : "text-slate-500")" aria-hidden="true"><Icon Name="@item.Icon" /></span>
                                <span class="mt-2 flex items-center gap-2 text-sm font-semibold">
                                    <span>@item.Title</span>
                                    @if (!string.IsNullOrWhiteSpace(item.BadgeText))
                                    {
                                        <span class="inline-flex min-w-6 items-center justify-center rounded-full bg-sky-500/10 px-2 py-1 text-[0.65rem] font-semibold leading-none @(isActive ? "text-slate-50" : "text-sky-700")"
                                              data-testid="@($"shell-nav-badge-{item.Route.Trim('/').Replace('/', '-') }-mobile")">
                                            @item.BadgeText
                                        </span>
                                    }
                                </span>
                                <span class="mt-1 block text-xs leading-5 @(isActive ? "text-slate-200" : "text-slate-500")">@item.Description</span>
                            </button>
                        }
                    </Grid>

                    @if (OpenedProjects.Count > 0 || OpenedSessions.Count > 0)
                    {
                        <Grid Gap="LayoutGap.Large"
                              ColumnsLg="2">
                            @if (OpenedProjects.Count > 0)
                            {
                                <Stack GapScale="LayoutGap.Small">
                                    <p class="cda-eyebrow">Opened Projects</p>
                                    @foreach (var item in OpenedProjects)
                                    {
                                        <button type="button"
                                                class="cda-shell-mobile-card cda-shell-mobile-card--inactive w-full text-sm"
                                                @onclick="() => OpenWorkbenchItem.InvokeAsync(item.TabId)">
                                            <span class="block font-semibold text-slate-900">@item.Title</span>
                                            <span class="mt-1 block text-xs text-slate-500">@item.Route</span>
                                        </button>
                                    }
                                </Stack>
                            }

                            @if (OpenedSessions.Count > 0)
                            {
                                <Stack GapScale="LayoutGap.Small">
                                    <p class="cda-eyebrow">Prompt Sessions</p>
                                    @foreach (var item in OpenedSessions)
                                    {
                                        <button type="button"
                                                class="cda-shell-mobile-card cda-shell-mobile-card--inactive w-full text-sm"
                                                @onclick="() => OpenWorkbenchItem.InvokeAsync(item.TabId)">
                                            <span class="block font-semibold text-slate-900">@item.Title</span>
                                            <span class="mt-1 block text-xs text-slate-500">@item.Route</span>
                                        </button>
                                    }
                                </Stack>
                            }
                        </Grid>
                    }
                </Stack>
            </details>

            <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="min-w-0 flex-1">
                    <AppTabStrip Items="Tabs"
                                 RecentTabs="RecentTabs"
                                 ActiveTabId="ActiveTabId"
                                 ShowActiveSummary="ShowTabSummary"
                                 Compact="@(Mode == AppShellMode.FocusWorkbench)"
                                 Activate="SelectTab"
                                 Close="CloseTab"
                                 MoveLeft="MoveLeft"
                                 MoveRight="MoveRight"
                                 TogglePin="ToggleTabPin"
                                 ToggleSleep="ToggleTabSleep"
                                 CloseOthers="CloseOtherTabs"
                                 CloseRight="CloseTabsToRight"
                                 CloseBackground="CloseBackgroundTabs"
                                 ReopenRecent="ReopenRecentTab" />
                </div>

                @if (TopBar is not null)
                {
                    <div class="min-w-0 flex-shrink-0">
                        @TopBar
                    </div>
                }
            </div>

            <div class="@ResolveBodyRegionClass()">
                @if (Mode == AppShellMode.FocusWorkbench)
                {
                    <div class="@ResolveBodyHostClass()">
                        @Body
                    </div>
                }
                else
                {
                    <section class="cda-shell-body-surface">
                        @Body
                    </section>
                }

                @if (ShowRightRail)
                {
                    <aside class="@ResolveRightRailClass()">
                        @RightRail
                    </aside>
                }
            </div>

            @if ((ShowRightRail || ShowCollapsedRail) && RightRail is not null)
            {
                <details class="cda-shell-rail-collapse @(ShowRightRail ? "2xl:hidden" : string.Empty)">
                    <summary class="cursor-pointer list-none text-sm font-semibold text-slate-900">
                        @CollapsedRailLabel
                    </summary>
                    <div class="mt-4">
                        @RightRail
                    </div>
                </details>
            }
        </main>
    </div>
</div>

@code {
    [Parameter]
    public AppShellMode Mode { get; set; } = AppShellMode.StandardPage;

    [Parameter]
    public bool ShowRightRail { get; set; } = true;

    [Parameter]
    public bool ShowCollapsedRail { get; set; }

    [Parameter]
    public bool ShowTabSummary { get; set; } = true;

    [Parameter]
    public string CollapsedRailLabel { get; set; } = "Workspace context";

    [Parameter]
    public IReadOnlyList<ShellNavigationItem> NavigationItems { get; set; } = [];

    [Parameter]
    public IReadOnlyList<ShellWorkspaceItem> Workspaces { get; set; } = [];

    [Parameter]
    public string ActiveWorkspaceId { get; set; } = string.Empty;

    [Parameter]
    public string CurrentRoute { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<WorkbenchTabState> Tabs { get; set; } = [];

    [Parameter]
    public IReadOnlyList<WorkbenchTabState> RecentTabs { get; set; } = [];

    [Parameter]
    public IReadOnlyList<WorkbenchTabState> OpenedProjects { get; set; } = [];

    [Parameter]
    public IReadOnlyList<WorkbenchTabState> OpenedSessions { get; set; } = [];

    [Parameter]
    public string? ActiveTabId { get; set; }

    [Parameter]
    public string? ProjectContextTitle { get; set; }

    [Parameter]
    public string? PhaseContextTitle { get; set; }

    [Parameter]
    public EventCallback<string> SelectWorkspace { get; set; }

    [Parameter]
    public EventCallback<string> Navigate { get; set; }

    [Parameter]
    public EventCallback<string> OpenWorkbenchItem { get; set; }

    [Parameter]
    public EventCallback<string> SelectTab { get; set; }

    [Parameter]
    public EventCallback<string> CloseTab { get; set; }

    [Parameter]
    public EventCallback<string> MoveLeft { get; set; }

    [Parameter]
    public EventCallback<string> MoveRight { get; set; }

    [Parameter]
    public EventCallback<string> ToggleTabPin { get; set; }

    [Parameter]
    public EventCallback<string> ToggleTabSleep { get; set; }

    [Parameter]
    public EventCallback<string> CloseOtherTabs { get; set; }

    [Parameter]
    public EventCallback<string> CloseTabsToRight { get; set; }

    [Parameter]
    public EventCallback<string> CloseBackgroundTabs { get; set; }

    [Parameter]
    public EventCallback<string> ReopenRecentTab { get; set; }

    private string ResolveBodyRegionClass()
    {
        if (ShowRightRail)
        {
            return "grid min-h-0 flex-1 gap-2 2xl:grid-cols-[minmax(0,1fr)_20rem]";
        }

        return Mode == AppShellMode.FocusWorkbench
            ? "flex min-h-0 flex-1 flex-col"
            : "block";
    }

    private string ResolveBodyHostClass()
    {
        return Mode == AppShellMode.FocusWorkbench
            ? "min-w-0 min-h-0 flex-1 overflow-hidden"
            : "min-w-0";
    }

    private string ResolveRightRailClass()
    {
        return Mode == AppShellMode.FocusWorkbench
            ? "cda-shell-rail min-h-0 overflow-hidden"
            : "cda-shell-rail";
    }

    private string ResolveRootClass()
    {
        return "cda-shell-root";
    }

    private string ResolveFrameClass()
    {
        return Mode == AppShellMode.FocusWorkbench
            ? "cda-shell-frame cda-shell-frame--focus"
            : "cda-shell-frame";
    }

    private string? ResolveRootStyle()
    {
        return Mode == AppShellMode.FocusWorkbench
            ? "height:100vh;overflow:hidden;"
            : null;
    }

    private string? ResolveFrameStyle()
    {
        return Mode == AppShellMode.FocusWorkbench
            ? "height:100%;min-height:0;overflow:hidden;"
            : null;
    }

    [Parameter]
    public RenderFragment? TopBar { get; set; }

    [Parameter]
    public RenderFragment? Body { get; set; }

    [Parameter]
    public RenderFragment? RightRail { get; set; }

    private static bool IsRouteMatch(string currentRoute, string navigationRoute)
    {
        if (string.Equals(navigationRoute, "/", StringComparison.Ordinal))
        {
            return string.Equals(currentRoute, "/", StringComparison.OrdinalIgnoreCase);
        }

        return string.Equals(currentRoute, navigationRoute, StringComparison.OrdinalIgnoreCase) ||
               currentRoute.StartsWith($"{navigationRoute}/", StringComparison.OrdinalIgnoreCase);
    }
}

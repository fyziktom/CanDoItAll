@namespace CanDoItAll.Components
@typeparam TValue

<input type="checkbox"
       @attributes='AdditionalAttributes.WithClass("rz-checkbox h-4 w-4 rounded border-slate-300 text-indigo-600")'
       name="@Name"
       checked="@ResolveIsChecked()"
       @onchange="OnChangedAsync"
        />

@code {
    [Parameter]
    public TValue? Value { get; set; }

    [Parameter]
    public EventCallback<TValue?> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<TValue?> Change { get; set; }

    [Parameter]
    public string? Name { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool ResolveIsChecked()
    {
        if (Value is bool boolValue)
        {
            return boolValue;
        }

        if (Value is null)
        {
            return false;
        }

        if (typeof(TValue) == typeof(bool?))
        {
            var nullableValue = (bool?)(object)Value;
            return nullableValue.GetValueOrDefault();
        }

        return false;
    }

    private async Task OnChangedAsync(ChangeEventArgs args)
    {
        var checkedValue = args.Value is bool boolValue && boolValue;
        var converted = ConvertFromBool(checkedValue);
        Value = converted;
        await ValueChanged.InvokeAsync(converted);
        await Change.InvokeAsync(converted);
    }

    private static TValue? ConvertFromBool(bool value)
    {
        if (typeof(TValue) == typeof(bool))
        {
            return (TValue)(object)value;
        }

        if (typeof(TValue) == typeof(bool?))
        {
            bool? nullable = value;
            return (TValue)(object)nullable;
        }

        return default;
    }
}






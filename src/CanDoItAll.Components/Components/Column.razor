@namespace CanDoItAll.Components
<div @attributes='AdditionalAttributes.WithClassAndStyle("rz-col", BuildStyle())'>
    @ChildContent
</div>

@code {
    [Parameter]
    public int? Size { get; set; }

    [Parameter]
    public int? SizeMD { get; set; }

    [Parameter]
    public int? SizeXL { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string BuildStyle()
    {
        var size = NormalizeSize(Size ?? 12);
        var sizeMd = NormalizeSize(SizeMD ?? size);
        var sizeXl = NormalizeSize(SizeXL ?? sizeMd);

        return string.Create(
            System.Globalization.CultureInfo.InvariantCulture,
            $"--rz-col-size:{size};--rz-col-md-size:{sizeMd};--rz-col-xl-size:{sizeXl};");
    }

    private static int NormalizeSize(int size)
    {
        return Math.Clamp(size, 1, 12);
    }
}





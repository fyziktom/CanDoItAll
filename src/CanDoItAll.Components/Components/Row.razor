@namespace CanDoItAll.Components
<div @attributes='AdditionalAttributes.WithClassAndStyle("rz-row grid grid-cols-12", BuildStyle())'>
    @ChildContent
</div>

@code {
    [Parameter]
    public string? Gap { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string BuildStyle()
    {
        var gap = string.IsNullOrWhiteSpace(Gap)
            ? "0"
            : Gap;

        return $"display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:{gap};";
    }
}





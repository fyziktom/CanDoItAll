@namespace CanDoItAll.Components
@if (!string.IsNullOrWhiteSpace(Name))
{
    var iconName = ResolveIconName(Name);
    if (iconName is not null)
    {
        <span @attributes='AdditionalAttributes.WithClass("rz-icon cda-material-icon material-icons")' aria-hidden="true">@iconName</span>
    }
    else
    {
        <span @attributes='AdditionalAttributes.WithClass("rz-icon-fallback")' title="@($"Unknown icon token: {Name}")" aria-hidden="true">@Name</span>
    }
}

@code {
    [Parameter]
    public string? Name { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private static string? ResolveIconName(string? iconToken)
    {
        if (MaterialIconCatalog.TryResolveIconName(iconToken, out var iconName))
        {
            return iconName;
        }

        return null;
    }
}

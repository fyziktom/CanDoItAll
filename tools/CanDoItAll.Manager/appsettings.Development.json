{
  "Manager": {
    "AutoStartTailwindWatch": true,
    "CleanupWorkspaceProcessesOnStart": true,
    "TailwindEchoOutputToConsole": true,
    "TailwindInstallDependenciesIfMissing": true,
    "WatchDetailedErrorsEnabled": true,
    "WatchDisableAppHost": true,
    "WatchDisableBuildServers": false,
    "WatchDisableSharedCompilation": false,
    "WatchEchoOutputToConsole": true,
    "WatchLaunchProfile": "https",
    "WatchSkipRestore": true,
    "WatchSuppressBrowserRefresh": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}

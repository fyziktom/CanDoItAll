# Local development defaults. Do not reuse these credentials on a shared host.
COMPOSE_PROJECT_NAME=candoitall-app
CDA_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
APP_IMAGE=candoitall-app:dev
APP_MEMORY_LIMIT=2g
APP_CPU_LIMIT=2.0
APP_PID_LIMIT=512
DOTNET_SDK_VERSION=10.0.302
DOTNET_RUNTIME_VERSION=10.0.10
CANDOITALL_HOST_BINDING_ID=candoitall-compose
DB_PASSWORD_FILE=.secrets/db-password
POSTGRES_IMAGE_TAG=16-alpine
POSTGRES_PORT=5432
POSTGRES_DB=candoitall_development
POSTGRES_USER=candoitall
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_CPU_LIMIT=1.0
POSTGRES_PID_LIMIT=256

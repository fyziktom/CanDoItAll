using CanDoItAll.Mcp.SshOps.Configuration;
using CanDoItAll.Mcp.SshOps.Tools;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Hosting;
using Microsoft.Extensions.Logging;
using ModelContextProtocol.Server;

var settingsPath = Environment.GetEnvironmentVariable("CANDOITALL_MCP_SETTINGS_PATH")
    ?? throw new InvalidOperationException("CANDOITALL_MCP_SETTINGS_PATH is required.");

var builder = Host.CreateEmptyApplicationBuilder(settings: null);

builder.Configuration.AddJsonFile(settingsPath, optional: false, reloadOnChange: false);
builder.Configuration.AddEnvironmentVariables(prefix: "CANDOITALL_MCP_");

builder.Logging.ClearProviders();
builder.Logging.AddConsole(options =>
{
    options.LogToStandardErrorThreshold = LogLevel.Trace;
});

builder.Services
    .AddOptions<McpServerOptions>()
    .Bind(builder.Configuration)
    .ValidateDataAnnotations()
    .ValidateOnStart();

builder.Services.AddHttpClient();

builder.Services
    .AddMcpServer()
    .WithStdioServerTransport()
    .WithToolsFromAssembly();

builder.Services.AddCanDoItAllSshOpsCore(builder.Configuration);

await using var host = builder.Build();
await host.RunAsync();

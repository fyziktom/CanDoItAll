@namespace CanDoItAll.Modules.Processes
@using CanDoItAll.Components.Common

<Stack GapScale="LayoutGap.Large"
       Class="processes-runs-tab-shell"
       data-testid="processes-runs-tab-shell">
    @if (Presenter.HasSelectedProcess)
    {
        <SurfaceCard Soft="true"
                     data-testid="processes-selected-run-summary">
            @if (Presenter.SelectedRun is null)
            {
                <Stack GapScale="LayoutGap.Tiny">
                    <p class="cda-eyebrow">Run focus</p>
                    <h3 class="text-lg font-semibold text-slate-950">Select a run from Activity to inspect its details</h3>
                    <p class="text-sm leading-6 text-slate-600">
                        Launch planning and live monitoring stay available without a selected run.
                        Execution controls, coordination, and evidence open once you choose a runtime run from history.
                    </p>
                </Stack>
            }
            else
            {
                var selectedRun = Presenter.SelectedRun!;
                <Split Gap="LayoutGap.Medium">
                    <Stack GapScale="LayoutGap.Tiny">
                        <p class="cda-eyebrow">Selected run</p>
                        <h3 class="text-lg font-semibold text-slate-950">@selectedRun.Name</h3>
                        <p class="text-sm leading-6 text-slate-600">@Presenter.BuildRunSummary(selectedRun)</p>
                        <p class="text-sm leading-6 text-slate-500">
                            @Presenter.FormatCost(selectedRun.EstimatedCost) estimated / @Presenter.FormatCost(selectedRun.ActualCost) actual
                        </p>
                        @if (!string.IsNullOrWhiteSpace(Presenter.SelectedRunHealth.ActionableReason))
                        {
                            <p class="text-sm leading-6 text-slate-600">@Presenter.SelectedRunHealth.ActionableReason</p>
                        }
                    </Stack>
                    <Cluster Gap="LayoutGap.Small"
                             Wrap="FlexWrap.Wrap">
                        <StatusBadge Tone="@Presenter.ResolveRunTone(selectedRun.Status)"
                                     Text="@selectedRun.Status.ToString()" />
                        <StatusBadge Tone="neutral"
                                     Text="@selectedRun.OperatingMode.ToString()" />
                        <StatusBadge Tone="neutral"
                                     Text="@($"{selectedRun.TotalStepCount} steps")" />
                        <StatusBadge Tone="info"
                                     Text="@(string.IsNullOrWhiteSpace(selectedRun.ManagerAgentName) ? "manager: default" : $"manager: {selectedRun.ManagerAgentName}")" />
                        @if (selectedRun.HierarchyDepth > 0)
                        {
                            <StatusBadge Tone="neutral"
                                         Text="@($"subprocess depth {selectedRun.HierarchyDepth}")" />
                        }
                        <StatusBadge Tone="info"
                                     Text="@($"{Presenter.SelectedRunHealth.LatestAttemptCount} attempts")" />
                        @if (Presenter.SelectedRunHealth.PendingApprovalCount > 0)
                        {
                            <StatusBadge Tone="warning"
                                         Text="@($"{Presenter.SelectedRunHealth.PendingApprovalCount} approvals waiting")" />
                        }
                        @if (Presenter.SelectedRunHealth.MissingArtifactCount > 0)
                        {
                            <StatusBadge Tone="warning"
                                         Text="@($"{Presenter.SelectedRunHealth.MissingArtifactCount} missing artifacts")" />
                        }
                        @if (Presenter.SelectedRunHealth.DeadLetteredOutboxCount > 0)
                        {
                            <StatusBadge Tone="danger"
                                         Text="@($"{Presenter.SelectedRunHealth.DeadLetteredOutboxCount} dead-lettered")" />
                        }
                        @if (Presenter.SelectedRunHealth.InvariantDiagnosticCount > 0)
                        {
                            <StatusBadge Tone="warning"
                                         Text="@($"{Presenter.SelectedRunHealth.InvariantDiagnosticCount} diagnostics")" />
                        }
                        @if (Presenter.SelectedRunHealth.RecommendedAction != ProcessStepRecoveryOption.None)
                        {
                            <StatusBadge Tone="info"
                                         Text="@($"recommended: {Presenter.FormatRecoveryAction(Presenter.SelectedRunHealth.RecommendedAction)}")" />
                        }
                        <StatusBadge Tone="neutral"
                                     Text="@($"updated {selectedRun.UpdatedAtUtc.LocalDateTime:g}")" />
                    </Cluster>
                </Split>
            }
        </SurfaceCard>
    }

    <Tabs SelectedIndex="@selectedRunViewIndex"
          SelectedIndexChanged="HandleSelectedRunViewChanged"
          Variant="@(TabsVariant.WorkspaceSecondary)"
          BorderMode="@(TabsBorderMode.Soft)"
          Tone="@(TabsTone.Secondary)"
          OverflowMode="@(TabsOverflowMode.Auto)"
          PanelOverflowMode="@(TabsPanelOverflowMode.Auto)"
          Class="w-full min-w-0"
          AriaLabel="Process runs workspace sections"
          data-testid="processes-runs-tabs">
        <TabItems>
            <TabsItem Text="Launch">
                <ProcessWorkspaceRunsLaunchSection Presenter="Presenter" />
            </TabsItem>

            <TabsItem Text="Activity">
                <Stack GapScale="LayoutGap.Large">
                    <ProcessWorkspaceRunsActiveSection Presenter="Presenter" />
                    <ProcessWorkspaceRunsLifecycleSection Presenter="Presenter" />
                </Stack>
            </TabsItem>

            <TabsItem Text="Control">
                @if (Presenter.SelectedRun is null)
                {
                    <EmptyState Eyebrow="No run selected"
                                Title="Choose a run before using operator controls"
                                Description="Escalations, approvals, rework requests, and the attempt timeline are attached to one durable runtime run." />
                }
                else
                {
                    <ProcessWorkspaceRunsOperatorConsoleSection Presenter="Presenter" />
                }
            </TabsItem>

            <TabsItem Text="Execution">
                @if (Presenter.SelectedRun is null)
                {
                    <EmptyState Eyebrow="No run selected"
                                Title="Choose a run from Activity first"
                                Description="Execution metrics, runtime canvas state, and technical execution telemetry are attached to the selected runtime run." />
                }
                else
                {
                    <Stack GapScale="LayoutGap.Large">
                        <ProcessWorkspaceRunsSummarySection Presenter="Presenter" />
                        <ProcessWorkspaceRunsRuntimeHostReadbackSection Presenter="Presenter" />
                        <ProcessWorkspaceRunsCanvasSection Presenter="Presenter" />
                        <ProcessWorkspaceRunsExecutionSection Presenter="Presenter" />
                    </Stack>
                }
            </TabsItem>

            <TabsItem Text="Graphs">
                @if (Presenter.SelectedRun is null)
                {
                    <EmptyState Eyebrow="No run selected"
                                Title="Choose a run from Activity first"
                                Description="Run graphs are scoped to one durable process run." />
                }
                else if (!string.IsNullOrWhiteSpace(Presenter.SelectedRunGraphsError))
                {
                    <EmptyState Eyebrow="Graphs unavailable"
                                Title="Run graph data could not be loaded"
                                Description="@Presenter.SelectedRunGraphsError" />
                }
                else if (Presenter.SelectedRunGraphsLoading)
                {
                    <LoadingState Title="Loading run graphs"
                                  Description="Collecting metrics for the selected process run." />
                }
                else
                {
                    <Stack GapScale="LayoutGap.Medium"
                           data-testid="processes-selected-run-graphs-tab">
                        <Cluster Gap="LayoutGap.Small"
                                 JustifyContent="JustifyContent.End">
                            <Button Text="Refresh"
                                    Icon="refresh"
                                    ButtonStyle="ButtonStyle.Light"
                                    Size="ButtonSize.Small"
                                    Disabled="@Presenter.SelectedRunGraphsLoading"
                                    IsBusy="@Presenter.SelectedRunGraphsLoading"
                                    Click="Presenter.RefreshSelectedRunGraphsAsync"
                                    data-testid="processes-run-graphs-refresh-button" />
                        </Cluster>
                        <ProcessObservationGraphsPanel Snapshot="@Presenter.SelectedRunGraphsSnapshot"
                                                       TestId="processes-run-graphs-panel"
                                                       EmptyEyebrow="Run graphs"
                                                       EmptyTitle="No run graph data"
                                                       EmptyDescription="No runtime metrics matched the selected process run."
                                                       CostDescription="Selected process run." />
                    </Stack>
                }
            </TabsItem>

            <TabsItem Text="Coordination">
                @if (Presenter.SelectedRun is null)
                {
                    <EmptyState Eyebrow="No run selected"
                                Title="Choose a run before editing coordination data"
                                Description="Assignments and direct role messaging stay attached to one durable run so staffing decisions remain reviewable." />
                }
                else
                {
                    <Stack GapScale="LayoutGap.Large">
                        <ProcessWorkspaceRunsAssignmentsSection Presenter="Presenter" />
                        <ProcessWorkspaceRunsMessagingSection Presenter="Presenter" />
                    </Stack>
                }
            </TabsItem>

            <TabsItem Text="Evidence">
                @if (Presenter.SelectedRun is null)
                {
                    <EmptyState Eyebrow="No run selected"
                                Title="Choose a run before reviewing its evidence"
                                Description="Artifacts, decisions, work briefs, and conformance observations remain grouped under the selected runtime run." />
                }
                else
                {
                    <ProcessWorkspaceRunsArtifactsSection Presenter="Presenter" />
                }
            </TabsItem>
        </TabItems>
    </Tabs>
</Stack>

@code {
    private const int SelectedRunGraphsTabIndex = 4;

    private int selectedRunViewIndex = 1;

    [Parameter, EditorRequired]
    public ProcessWorkspace.ProcessWorkspaceRunsTabPresenter Presenter { get; set; } = default!;

    private async Task HandleSelectedRunViewChanged(int index)
    {
        selectedRunViewIndex = index;
        if (index == SelectedRunGraphsTabIndex)
        {
            await Presenter.EnsureSelectedRunGraphsLoadedAsync();
        }
    }
}

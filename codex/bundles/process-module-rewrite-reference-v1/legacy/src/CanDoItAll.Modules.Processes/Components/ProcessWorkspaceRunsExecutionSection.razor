@namespace CanDoItAll.Modules.Processes
@using CanDoItAll.AgentFramework.Models

<SectionCard Title="Technical execution runs"
             Description=""
             HelpText="Process automation is only reviewable if the underlying technical execution runs, approvals, checkpoints, tool receipts, and produced artifacts remain visible beside the canonical process state.">
    @if (Presenter.OutboxRecords.Count > 0)
    {
        <SurfaceCard Soft="true"
                     data-testid="processes-automation-outbox-ledger">
            <Split Gap="LayoutGap.Medium">
                <div>
                    <p class="cda-eyebrow">Automation outbox</p>
                    <h3 class="mt-1 text-base font-semibold text-slate-950">Dispatch health</h3>
                </div>
                <Cluster Gap="LayoutGap.Small">
                    <StatusBadge Tone="warning"
                                 Text="@($"{Presenter.OutboxRecords.Count(item => item.HealthStatus is ProcessOutboxHealthStatus.Pending or ProcessOutboxHealthStatus.Leased or ProcessOutboxHealthStatus.WaitingToRetry)} pending")" />
                    <StatusBadge Tone="danger"
                                 Text="@($"{Presenter.OutboxRecords.Count(item => item.HealthStatus == ProcessOutboxHealthStatus.DeadLettered)} dead-lettered")" />
                    <StatusBadge Tone="mint"
                                 Text="@($"{Presenter.OutboxRecords.Count(item => item.HealthStatus == ProcessOutboxHealthStatus.Completed)} completed")" />
                </Cluster>
            </Split>
            <Stack GapScale="LayoutGap.Small"
                   Class="mt-4">
                @foreach (var outboxRecord in Presenter.OutboxRecords)
                {
                    <SurfaceCard Soft="true">
                        <Split Gap="LayoutGap.Small">
                            <div>
                                <p class="text-sm font-semibold text-slate-950">@outboxRecord.CommandKey</p>
                                <p class="mt-1 text-xs uppercase tracking-[0.18em] text-slate-500">
                                    @outboxRecord.Trigger / attempts @outboxRecord.AttemptCount
                                </p>
                                @if (!string.IsNullOrWhiteSpace(outboxRecord.LastError))
                                {
                                    <p class="mt-2 text-sm leading-6 text-slate-600">@outboxRecord.LastError</p>
                                }
                            </div>
                            <Cluster Gap="LayoutGap.Small">
                                <StatusBadge Tone="@ResolveOutboxTone(outboxRecord.HealthStatus)"
                                             Text="@outboxRecord.HealthStatus.ToString()" />
                                @if (outboxRecord.NextAttemptAtUtc.HasValue)
                                {
                                    <StatusBadge Tone="neutral"
                                                 Text="@($"next {outboxRecord.NextAttemptAtUtc.Value.ToLocalTime():g}")" />
                                }
                                @if (outboxRecord.LeaseExpiresAtUtc.HasValue)
                                {
                                    <StatusBadge Tone="info"
                                                 Text="@($"lease {outboxRecord.LeaseExpiresAtUtc.Value.ToLocalTime():g}")" />
                                }
                            </Cluster>
                        </Split>
                    </SurfaceCard>
                }
            </Stack>
        </SurfaceCard>
    }

    @if (Presenter.WorkflowRuns.Count > 0)
    {
        <SurfaceCard Soft="true"
                     data-testid="processes-workflow-run-ledger">
            <Split Gap="LayoutGap.Medium">
                <div>
                    <p class="cda-eyebrow">Workflow executions</p>
                    <h3 class="mt-1 text-base font-semibold text-slate-950">MAF workflow role runs</h3>
                </div>
                <Cluster Gap="LayoutGap.Small">
                    <StatusBadge Tone="info"
                                 Text="@($"{Presenter.WorkflowRuns.Count} linked")" />
                    <StatusBadge Tone="warning"
                                 Text="@($"{Presenter.WorkflowRuns.Count(item => item.PendingRequestCount > 0)} pending input")" />
                </Cluster>
            </Split>
            <Stack GapScale="LayoutGap.Small"
                   Class="mt-4">
                @foreach (var workflowRun in Presenter.WorkflowRuns)
                {
                    <SurfaceCard Soft="true">
                        <Split Gap="LayoutGap.Small">
                            <div>
                                <p class="text-sm font-semibold text-slate-950">@workflowRun.WorkflowName</p>
                                <p class="mt-1 text-xs uppercase tracking-[0.18em] text-slate-500">
                                    @(string.IsNullOrWhiteSpace(workflowRun.StepTitle) ? "Run-level workflow" : workflowRun.StepTitle)
                                    / @workflowRun.Backend
                                </p>
                                @if (!string.IsNullOrWhiteSpace(workflowRun.Summary))
                                {
                                    <p class="mt-2 text-sm leading-6 text-slate-600">@workflowRun.Summary</p>
                                }
                                <p class="mt-2 text-xs text-slate-500">@workflowRun.WorkflowRunId</p>
                            </div>
                            <Cluster Gap="LayoutGap.Small">
                                <StatusBadge Tone="@ResolveWorkflowTone(workflowRun.State)"
                                             Text="@workflowRun.State.ToString()" />
                                <StatusBadge Tone="info"
                                             Text="@($"{workflowRun.ArtifactCount} artifacts")" />
                                <StatusBadge Tone="warning"
                                             Text="@($"{workflowRun.PendingRequestCount} pending requests")" />
                            </Cluster>
                        </Split>
                    </SurfaceCard>
                }
            </Stack>
        </SurfaceCard>
    }

    @if (Presenter.ExecutionRuns.Count == 0 && Presenter.WorkflowRuns.Count == 0)
    {
        <EmptyState Eyebrow="No executions"
                    Title="No technical execution runs recorded"
                    Description="This run has not dispatched any AgentFramework-backed work yet, or the selected executor is still human-only." />
    }
    else if (Presenter.ExecutionRuns.Count > 0)
    {
        <Stack GapScale="LayoutGap.Medium">
            @foreach (var executionRun in Presenter.ExecutionRuns)
            {
                <SurfaceCard Soft="true">
                    <Split Gap="LayoutGap.Medium">
                        <div>
                            <p class="cda-eyebrow">@(string.IsNullOrWhiteSpace(executionRun.StepTitle) ? "Run-level automation" : executionRun.StepTitle)</p>
                            <h3 class="mt-1 text-lg font-semibold text-slate-950">@executionRun.Title</h3>
                            <p class="mt-2 text-sm leading-6 text-slate-600">
                                @executionRun.AgentName
                                @if (!string.IsNullOrWhiteSpace(executionRun.AgentRoleTitle))
                                {
                                    <span> / @executionRun.AgentRoleTitle</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(executionRun.ProviderName))
                                {
                                    <span> / @executionRun.ProviderName</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(executionRun.Model))
                                {
                                    <span> / @executionRun.Model</span>
                                }
                            </p>
                        </div>
                        <Cluster Gap="LayoutGap.Small">
                            <StatusBadge Tone="@executionRun.StatusTone"
                                         Text="@executionRun.StatusBadgeText" />
                            @if (!string.IsNullOrWhiteSpace(executionRun.RawStatusBadgeText))
                            {
                                <StatusBadge Tone="neutral"
                                             Text="@executionRun.RawStatusBadgeText" />
                            }
                            <StatusBadge Tone="neutral"
                                         Text="@($"{executionRun.LogEntryCount} logs")" />
                        </Cluster>
                    </Split>

                    @if (!string.IsNullOrWhiteSpace(executionRun.InputSummary))
                    {
                        <p class="mt-4 text-sm leading-6 text-slate-600">
                            <span class="font-semibold text-slate-950">Prompt</span>
                            <span>: @executionRun.InputSummary</span>
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(executionRun.ResultSummary))
                    {
                        <p class="mt-3 text-sm leading-6 text-slate-600">
                            <span class="font-semibold text-slate-950">Result</span>
                            <span>: @executionRun.ResultSummary</span>
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(executionRun.StatusDetail))
                    {
                        <p class="mt-3 text-sm leading-6 text-slate-600">
                            <span class="font-semibold text-slate-950">Process status</span>
                            <span>: @executionRun.StatusDetail</span>
                        </p>
                    }

                    <Cluster Gap="LayoutGap.Small"
                             Class="mt-4">
                        <StatusBadge Tone="info"
                                     Text="@($"created {executionRun.CreatedAtUtc.ToLocalTime():g}")" />
                        <StatusBadge Tone="neutral"
                                     Text="@($"updated {executionRun.UpdatedAtUtc.ToLocalTime():g}")" />
                        @if (executionRun.StartedAtUtc.HasValue)
                        {
                            <StatusBadge Tone="neutral"
                                         Text="@($"started {executionRun.StartedAtUtc.Value.ToLocalTime():g}")" />
                        }
                        @if (executionRun.CompletedAtUtc.HasValue)
                        {
                            <StatusBadge Tone="mint"
                                         Text="@($"completed {executionRun.CompletedAtUtc.Value.ToLocalTime():g}")" />
                        }
                        <StatusBadge Tone="info"
                                     Text="@($"{executionRun.Artifacts.Count} artifacts")" />
                        <StatusBadge Tone="warning"
                                     Text="@($"{executionRun.Approvals.Count} approvals")" />
                        <StatusBadge Tone="info"
                                     Text="@($"{executionRun.Checkpoints.Count} checkpoints")" />
                        <StatusBadge Tone="neutral"
                                     Text="@($"{executionRun.ToolReceipts.Count} tool receipts")" />
                    </Cluster>

                    <Grid Gap="LayoutGap.Medium"
                          ColumnsLg="2"
                          Class="mt-4">
                        <SurfaceCard>
                            <p class="cda-eyebrow">Produced artifacts</p>
                            @if (executionRun.Artifacts.Count == 0)
                            {
                                <p class="mt-3 text-sm leading-6 text-slate-500">No execution artifacts were persisted for this run.</p>
                            }
                            else
                            {
                                <Stack GapScale="LayoutGap.Small"
                                       Class="mt-3">
                                    @foreach (var artifact in executionRun.Artifacts)
                                    {
                                        <SurfaceCard Soft="true">
                                            <p class="text-sm font-semibold text-slate-950">@artifact.DisplayName</p>
                                            <p class="mt-1 text-xs uppercase tracking-[0.18em] text-slate-500">@artifact.ArtifactKind / @artifact.ContentType</p>
                                            @if (!string.IsNullOrWhiteSpace(artifact.Summary))
                                            {
                                                <p class="mt-2 text-sm leading-6 text-slate-600">@artifact.Summary</p>
                                            }
                                            <p class="mt-2 text-xs text-slate-500">@artifact.RelativePath</p>
                                        </SurfaceCard>
                                    }
                                </Stack>
                            }
                        </SurfaceCard>

                        <Stack GapScale="LayoutGap.Medium">
                            <SurfaceCard>
                                <p class="cda-eyebrow">Approvals and checkpoints</p>
                                @if (executionRun.Approvals.Count == 0 && executionRun.Checkpoints.Count == 0)
                                {
                                    <p class="mt-3 text-sm leading-6 text-slate-500">This execution run did not pause for approvals or emit resumable checkpoints.</p>
                                }
                                else
                                {
                                    @if (executionRun.Approvals.Count > 0)
                                    {
                                        <Stack GapScale="LayoutGap.Small"
                                               Class="mt-3">
                                            @foreach (var approval in executionRun.Approvals)
                                            {
                                                <SurfaceCard Soft="true">
                                                    <Split Gap="LayoutGap.Small">
                                                        <div>
                                                            <p class="text-sm font-semibold text-slate-950">@approval.ToolName</p>
                                                            <p class="mt-1 text-xs uppercase tracking-[0.18em] text-slate-500">@approval.ToolKind</p>
                                                        </div>
                                                        <StatusBadge Tone="@ResolveApprovalTone(approval)"
                                                                     Text="@approval.Status.ToString()" />
                                                    </Split>
                                                    @if (!string.IsNullOrWhiteSpace(approval.Details))
                                                    {
                                                        <p class="mt-2 text-sm leading-6 text-slate-600">@approval.Details</p>
                                                    }
                                                </SurfaceCard>
                                            }
                                        </Stack>
                                    }

                                    @if (executionRun.Checkpoints.Count > 0)
                                    {
                                        <Stack GapScale="LayoutGap.Small"
                                               Class="mt-3">
                                            @foreach (var checkpoint in executionRun.Checkpoints)
                                            {
                                                <SurfaceCard Soft="true">
                                                    <Split Gap="LayoutGap.Small">
                                                        <div>
                                                            <p class="text-sm font-semibold text-slate-950">@checkpoint.CheckpointKind</p>
                                                            <p class="mt-1 text-xs uppercase tracking-[0.18em] text-slate-500">@checkpoint.CapturedAtUtc.ToLocalTime().ToString("g")</p>
                                                        </div>
                                                        <StatusBadge Tone="@ResolveCheckpointTone(checkpoint)"
                                                                     Text="@checkpoint.RunState.ToString()" />
                                                    </Split>
                                                </SurfaceCard>
                                            }
                                        </Stack>
                                    }
                                }
                            </SurfaceCard>

                            <SurfaceCard>
                                <p class="cda-eyebrow">Tool receipts</p>
                                @if (executionRun.ToolReceipts.Count == 0)
                                {
                                    <p class="mt-3 text-sm leading-6 text-slate-500">No tool receipts were captured for this execution run.</p>
                                }
                                else
                                {
                                    <Stack GapScale="LayoutGap.Small"
                                           Class="mt-3">
                                        @foreach (var receipt in executionRun.ToolReceipts)
                                        {
                                            <SurfaceCard Soft="true">
                                                <p class="text-sm font-semibold text-slate-950">@receipt.ToolName</p>
                                                <p class="mt-1 text-xs uppercase tracking-[0.18em] text-slate-500">@receipt.ToolFamily / @receipt.RiskClass</p>
                                                @if (!string.IsNullOrWhiteSpace(receipt.RequestSummary))
                                                {
                                                    <p class="mt-2 text-sm leading-6 text-slate-600">@receipt.RequestSummary</p>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(receipt.ExitSummary))
                                                {
                                                    <p class="mt-2 text-sm leading-6 text-slate-600">@receipt.ExitSummary</p>
                                                }
                                            </SurfaceCard>
                                        }
                                    </Stack>
                                }
                            </SurfaceCard>
                        </Stack>
                    </Grid>
                </SurfaceCard>
            }
        </Stack>
    }
</SectionCard>

@code {
    [Parameter, EditorRequired]
    public ProcessWorkspace.ProcessWorkspaceRunsTabPresenter Presenter { get; set; } = default!;

    private static string ResolveApprovalTone(ProcessExecutionApprovalViewModel approval)
    {
        return approval.Status switch
        {
            ExecutionApprovalStatus.Approved => "mint",
            ExecutionApprovalStatus.Rejected => "danger",
            _ => "warning"
        };
    }

    private static string ResolveCheckpointTone(ProcessExecutionCheckpointViewModel checkpoint)
    {
        return checkpoint.PendingApprovalCount > 0
            ? "warning"
            : checkpoint.RunState == ExecutionState.Failed
                ? "danger"
                : "info";
    }

    private static string ResolveOutboxTone(ProcessOutboxHealthStatus status)
    {
        return status switch
        {
            ProcessOutboxHealthStatus.Completed => "mint",
            ProcessOutboxHealthStatus.DeadLettered => "danger",
            ProcessOutboxHealthStatus.Leased => "info",
            ProcessOutboxHealthStatus.WaitingToRetry => "warning",
            _ => "neutral"
        };
    }

    private static string ResolveWorkflowTone(WorkflowRunState state)
    {
        return state switch
        {
            WorkflowRunState.Completed => "mint",
            WorkflowRunState.Failed => "danger",
            WorkflowRunState.Cancelled => "neutral",
            WorkflowRunState.WaitingForInput => "warning",
            WorkflowRunState.Running => "info",
            _ => "neutral"
        };
    }
}

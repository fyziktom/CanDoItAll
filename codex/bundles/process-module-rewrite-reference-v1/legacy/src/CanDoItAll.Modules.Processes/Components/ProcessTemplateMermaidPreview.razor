@namespace CanDoItAll.Modules.Processes
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using CanDoItAll.Components.Mermaid

<SurfaceCard Class="min-w-0"
             data-testid="@TestId">
    <MermaidDiagram Title="@Title"
                    Description="@Description"
                    Source="@Definition"
                    Options="@PreviewOptions"
                    PanZoomEnabled="true"
                    ShowControls="true"
                    Style="--cda-mermaid-min-height:20rem;"
                    data-testid="@($"{TestId}-diagram")" />
</SurfaceCard>

@code {
    private static readonly MermaidDiagramOptions PreviewOptions = new()
    {
        SecurityLevel = "loose",
        FlowchartUseMaxWidth = true,
        HtmlLabels = true,
        ArchitectureRandomize = false
    };

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Definition { get; set; } = string.Empty;

    [Parameter]
    public string SourcePath { get; set; } = string.Empty;

    [Parameter]
    public string TestId { get; set; } = string.Empty;

    private string? Description => string.IsNullOrWhiteSpace(SourcePath) ? null : SourcePath;
}

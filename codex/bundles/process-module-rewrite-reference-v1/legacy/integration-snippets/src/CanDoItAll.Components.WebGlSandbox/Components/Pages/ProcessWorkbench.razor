@namespace CanDoItAll.Components.WebGlSandbox.Components
@page "/"
@page "/webgl/process-workbench"
@inject NavigationManager NavigationManager
@inject ProcessWebGlSandboxSession Session
@using CanDoItAll.Components.OverlayLib
@using CanDoItAll.Modules.Processes

<PageTitle>WebGL Process Workbench</PageTitle>

<PageScaffold Mode="PageScaffoldMode.FocusWorkbench"
              FillHeight="true"
              MaxWidthClass="max-w-[1900px]"
              data-testid="webgl-process-workbench-page">
    <Header>
        <div class="webgl-page-hero @(IsStageMaximized ? "webgl-page-hero--compact" : null)">
            <div>
                <p class="webgl-page-hero__eyebrow">Concept review surface</p>
                <h1 class="webgl-page-hero__title">Process templates in navigable 3D</h1>
                <p class="webgl-page-hero__summary">The runtime stays universal and JS-owned, while this sandbox owns template switching, in-memory edits, center-lane scene projection, role spread, and proof-friendly 3D navigation.</p>
            </div>

            <div class="webgl-page-hero__meta">
                <StatusBadge Text="@Session.CurrentTemplate.Complexity" Tone="@ResolveComplexityTone(Session.CurrentTemplate.Complexity)" />
                <StatusBadge Text="@ResolveCameraViewLabel(Session.CameraViewMode)" Tone="neutral" />
                <StatusBadge Text="@ResolveLayoutLabel(Session.LayoutMode)" Tone="neutral" />
                <StatusBadge Text="@($"{Session.NodeSpacingFactor:0.##}x spacing")" Tone="neutral" />
                <StatusBadge Text="@($"{currentSurface.Nodes.Count} nodes")" Tone="info" />
                <StatusBadge Text="@($"{currentSurface.Edges.Count} edges")" Tone="accent" />
                @if (IsStageMaximized)
                {
                    <StatusBadge Text="Stage maximized" Tone="warning" />
                }
            </div>
        </div>
    </Header>

    <Lead>
        @if (!IsStageMaximized)
        {
            <SectionCard Title="Review controls"
                         Description="Template selection, layout recomposition, and export stay host-owned, while the stage toolbar, settings panel, and context menu now live inside WebGL."
                         HeaderActions="BuildLeadActions">
                <Stack Orientation="Orientation.Horizontal"
                       Wrap="FlexWrap.Wrap"
                       GapScale="LayoutGap.Medium"
                       AlignItems="AlignItems.End">
                    <FormField Text="Template" ContainerClass="webgl-control-field">
                        <DropDown TValue="string"
                                  Data="@Session.Templates"
                                  TextProperty="@nameof(ProcessWebGlTemplateDescriptor.DisplayName)"
                                  ValueProperty="@nameof(ProcessWebGlTemplateDescriptor.Key)"
                                  Value="@Session.SelectedTemplateKey"
                                  ValueChanged="HandleTemplateChangedAsync" />
                    </FormField>

                    <FormField Text="View preset" ContainerClass="webgl-control-field">
                        <DropDown TValue="string"
                                  Data="@ViewPresetOptions"
                                  TextProperty="@nameof(ChoiceItem.Label)"
                                  ValueProperty="@nameof(ChoiceItem.Value)"
                                  Value="@Session.ViewPreset"
                                  ValueChanged="HandleViewPresetChangedAsync" />
                    </FormField>

                    <FormField Text="Layout algorithm" ContainerClass="webgl-control-field">
                        <DropDown TValue="string"
                                  Data="@LayoutModeOptions"
                                  TextProperty="@nameof(ChoiceItem.Label)"
                                  ValueProperty="@nameof(ChoiceItem.Value)"
                                  Value="@Session.LayoutMode"
                                  ValueChanged="HandleLayoutModeChangedAsync" />
                    </FormField>

                    <FormField Text="Camera view" ContainerClass="webgl-control-field">
                        <Stack Orientation="Orientation.Horizontal"
                               Wrap="FlexWrap.Wrap"
                               GapScale="LayoutGap.Small"
                               AlignItems="AlignItems.Center">
                            @foreach (var option in CameraViewOptions)
                            {
                                <Button Text="@option.Label"
                                        ButtonStyle="@(string.Equals(option.Value, Session.CameraViewMode, StringComparison.Ordinal) ? ButtonStyle.Primary : ButtonStyle.Light)"
                                        Variant="@(string.Equals(option.Value, Session.CameraViewMode, StringComparison.Ordinal) ? Variant.Filled : Variant.Outlined)"
                                        Click="@(() => HandleCameraViewChangedAsync(option.Value))" />
                            }
                        </Stack>
                    </FormField>

                    <FormField Text="Node spacing" ContainerClass="webgl-control-field">
                        <Stack Orientation="Orientation.Horizontal"
                               Wrap="FlexWrap.Wrap"
                               GapScale="LayoutGap.Small"
                               AlignItems="AlignItems.Center">
                            <Button Text="Tighter"
                                    Icon="remove"
                                    Click="HandleDecreaseSpacingAsync"
                                    data-testid="webgl-sandbox-spacing-decrease" />
                            <Button Text="Wider"
                                    Icon="add"
                                    Click="HandleIncreaseSpacingAsync"
                                    data-testid="webgl-sandbox-spacing-increase" />
                            <StatusBadge Text="@($"{Session.NodeSpacingFactor:0.##}x")" Tone="info" />
                        </Stack>
                    </FormField>

                    <Button Text="Recompose"
                            Icon="route"
                            Click="HandleRecomposeAsync"
                            data-testid="webgl-sandbox-recompose" />
                    <Button Text="Reset edits"
                            Icon="refresh"
                            Click="HandleResetAsync"
                            data-testid="webgl-sandbox-reset" />
                    <Button Text="Export image"
                            Icon="image"
                            Click="HandleExportAsync"
                            data-testid="webgl-sandbox-export" />
                    <Button Text="Components toolbox"
                            Icon="inventory_2"
                            Click="ShowToolboxWindowAsync"
                            data-testid="webgl-sandbox-show-toolbox-window" />
                    <Button Text="Selection window"
                            Icon="dock_to_right"
                            Click="ShowSelectionWindowAsync"
                            data-testid="webgl-sandbox-show-selection-window" />
                    <Button Text="Command log"
                            Icon="description"
                            Click="ShowCommandWindowAsync"
                            data-testid="webgl-sandbox-show-command-window" />
                </Stack>
            </SectionCard>
        }
    </Lead>

    <SecondaryRail>
        @if (!IsStageMaximized)
        {
            <SectionCard Title="Template brief"
                         Description="@Session.CurrentTemplate.Summary">
                <Stack GapScale="LayoutGap.Small">
                    <StatusBadge Text="@Session.CurrentTemplate.DisplayName" Tone="info" />
                    <StatusBadge Text="@($"{Session.CurrentTemplate.StepCount} steps")" Tone="accent" />
                    <p class="webgl-rail-copy">Expanded representative pack: baseline, dense, delivery, AI, and release-control flows are all projected from repository templates instead of demo-only data.</p>
                </Stack>
            </SectionCard>

            <SectionCard Title="Selection"
                         Description="The sandbox inspector stays outside the universal runtime so the component remains reusable.">
                <Stack GapScale="LayoutGap.Small">
                    <StatusBadge Text="@SelectedNodeTitle" Tone="info" />
                    <p class="webgl-rail-copy">@SelectedNodeSummary</p>
                    @if (selectedNode is not null && selectedNode.Anchors.Count > 0)
                    {
                        <div class="webgl-chip-cluster">
                            @foreach (var anchor in selectedNode.Anchors.Take(6))
                            {
                                <span class="webgl-chip">@anchor.Label</span>
                            }
                        </div>
                    }
                </Stack>
            </SectionCard>

            <SectionCard Title="In-scene authoring"
                         Description="Connect, reconnect, delete, selection, and display settings now live in the WebGL toolbar and right-click menu instead of host-side forms.">
                <Stack GapScale="LayoutGap.Medium">
                    <p class="webgl-rail-copy">Use the in-scene toolbar to switch between selection, delete, connect, and reconnect modes. Right-clicking the stage, a node, or a connection opens the WebGL context menu for scene-specific actions.</p>
                    <p class="webgl-rail-copy">The settings panel now controls node label density, grid visibility, anchor visibility, edge labels, diagnostics, and runtime-only scene filters for role and branch helper nodes.</p>
                </Stack>
            </SectionCard>

            <SectionCard Title="Command log"
                         Description="Recent sandbox-only actions prove edits stay isolated and reversible.">
                <Stack GapScale="LayoutGap.Small">
                    @foreach (var entry in Session.CommandLog)
                    {
                        <div class="webgl-command-entry">
                            <strong>@entry.Title</strong>
                            <span>@entry.Detail</span>
                        </div>
                    }
                </Stack>
            </SectionCard>
        }
    </SecondaryRail>

    <ChildContent>
        @if (IsStageMaximized)
        {
            <div class="webgl-stage-backdrop" aria-hidden="true"></div>
        }

        <SectionCard Title="Process concept stage"
                     Description="JS owns the perspective renderer, the in-scene toolbar and context menu, hit-testing, and semantic automation bridge while the sandbox owns route state and in-memory edits.">
            <div class="webgl-stage-frame @(IsStageMaximized ? "webgl-stage-frame--maximized" : null)" data-testid="webgl-sandbox-stage">
                <div class="webgl-stage-overlay-host" data-cda-overlay-frame="true" data-cda-overlay-container="true">
                    <WebGlWorkbench @ref="workbench"
                                    Surface="@currentSurface"
                                    SelectionChanged="HandleSelectionChanged"
                                    NodesMoved="HandleNodesMoved"
                                    ConnectionChangeRequested="HandleConnectionChangeRequested"
                                    DeleteRequested="HandleDeleteRequested"
                                    StateChanged="HandleStateChanged"
                                    ChromeActionRequested="HandleChromeActionRequestedAsync" />

                    @if (toolboxWindowState.IsVisible)
                    {
                        <OverlayWindow WindowId="webgl-components-toolbox-overlay"
                                       Title="Components library"
                                       Kicker="Generic toolbox"
                                       Summary="The shared overlay toolbox now hosts role and step templates for WebGL authoring too."
                                       AriaLabel="WebGL components toolbox"
                                       TestId="webgl-components-toolbox-window"
                                       DefaultPlacement="top-left"
                                       DefaultWidth="368"
                                       DefaultHeight="420"
                                       MinWidth="320"
                                       MinHeight="260"
                                       MaxWidth="420"
                                       MaxHeight="560"
                                       BodyClass="webgl-overlay-window__body"
                                       ContainerSelector="[data-cda-overlay-container]"
                                       State="@toolboxWindowState"
                                       StateChanged="HandleToolboxWindowStateChangedAsync">
                            <OverlayComponentToolbox TestId="webgl-components-toolbox"
                                                     AriaLabel="WebGL components library"
                                                     Class="webgl-components-toolbox"
                                                     Eyebrow="3D authoring"
                                                     Title="Process components"
                                                     Summary="Seed new roles and steps directly into the in-memory 3D definition."
                                                     SearchText="@toolboxSearchText"
                                                     SearchTextChanged="HandleToolboxSearchChangedAsync"
                                                     SearchPlaceholder="Search process components"
                                                     SearchTestId="webgl-components-toolbox-search"
                                                     Sections="@ToolboxSections"
                                                     Badges="@ToolboxBadges"
                                                     ItemSelected="HandleToolboxItemSelectedAsync" />
                        </OverlayWindow>
                    }

                    @if (selectionWindowState.IsVisible)
                    {
                        <OverlayWindow WindowId="webgl-selection-overlay"
                                       Title="Selection"
                                       Kicker="Shared overlay"
                                       Summary="This inspector now uses the extracted floating-window library over the WebGL stage."
                                       AriaLabel="WebGL selection window"
                                       TestId="webgl-selection-window"
                                       DefaultPlacement="top-right"
                                       DefaultWidth="360"
                                       DefaultHeight="285"
                                       MinWidth="300"
                                       MinHeight="220"
                                       MaxWidth="420"
                                       MaxHeight="360"
                                       BodyClass="webgl-overlay-window__body"
                                       ContainerSelector="[data-cda-overlay-container]"
                                       State="@selectionWindowState"
                                       StateChanged="HandleSelectionWindowStateChangedAsync">
                            <div class="webgl-overlay-window__panel">
                                <div class="webgl-overlay-window__metric-row">
                                    <StatusBadge Text="@SelectedNodeTitle" Tone="info" />
                                    @if (selectedNode is not null)
                                    {
                                        <StatusBadge Text="@selectedNode.Kind" Tone="neutral" />
                                    }
                                </div>
                                <p class="webgl-rail-copy">@SelectedNodeSummary</p>

                                @if (selectedNode is not null)
                                {
                                    <div class="webgl-overlay-window__stats">
                                        <div>
                                            <span class="webgl-overlay-window__label">Family</span>
                                            <strong>@selectedNode.Family</strong>
                                        </div>
                                        <div>
                                            <span class="webgl-overlay-window__label">Anchors</span>
                                            <strong>@selectedNode.Anchors.Count</strong>
                                        </div>
                                        <div>
                                            <span class="webgl-overlay-window__label">Connections</span>
                                            <strong>@SelectedNodeConnectionCount</strong>
                                        </div>
                                    </div>

                                    @if (selectedNode.Anchors.Count > 0)
                                    {
                                        <div class="webgl-chip-cluster">
                                            @foreach (var anchor in selectedNode.Anchors.Take(6))
                                            {
                                                <span class="webgl-chip">@anchor.Label</span>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="webgl-overlay-window__hint">Select a node in the scene to inspect its anchor layout, family, and connection load.</p>
                                }
                            </div>
                        </OverlayWindow>
                    }

                    @if (commandWindowState.IsVisible)
                    {
                        <OverlayWindow WindowId="webgl-command-overlay"
                                       Title="Command log"
                                       Kicker="Shared overlay"
                                       Summary="Recent host-side actions stay visible while the camera moves and the stage maximizes."
                                       AriaLabel="WebGL command log window"
                                       TestId="webgl-command-window"
                                       DefaultPlacement="top-left"
                                       DefaultWidth="330"
                                       DefaultHeight="320"
                                       MinWidth="280"
                                       MinHeight="220"
                                       MaxWidth="380"
                                       MaxHeight="420"
                                       BodyClass="webgl-overlay-window__body"
                                       ContainerSelector="[data-cda-overlay-container]"
                                       State="@commandWindowState"
                                       StateChanged="HandleCommandWindowStateChangedAsync">
                            <div class="webgl-overlay-window__panel">
                                <p class="webgl-overlay-window__hint">The log proves the overlay window remains interactive while the WebGL stage handles selection, camera changes, and recomposition.</p>
                                <div class="webgl-overlay-window__log">
                                    @foreach (var entry in Session.CommandLog.Take(6))
                                    {
                                        <div class="webgl-command-entry">
                                            <strong>@entry.Title</strong>
                                            <span>@entry.Detail</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </OverlayWindow>
                    }
                </div>
            </div>
        </SectionCard>
    </ChildContent>
</PageScaffold>

@code {
    private static readonly IReadOnlyList<ChoiceItem> ViewPresetOptions =
    [
        new("Overview", WebGlWorkbenchViewPresets.Overview),
        new("Roles", WebGlWorkbenchViewPresets.Roles),
        new("Dependencies", WebGlWorkbenchViewPresets.Dependencies),
        new("Branching", WebGlWorkbenchViewPresets.Branching),
        new("Focus", WebGlWorkbenchViewPresets.Focus)
    ];

    private static readonly IReadOnlyList<ChoiceItem> LayoutModeOptions =
    [
        new("Center lane", WebGlWorkbenchLayoutModes.CenterLane),
        new("Alternating arc", WebGlWorkbenchLayoutModes.AlternatingArc),
        new("Layered orbit", WebGlWorkbenchLayoutModes.LayeredOrbit),
        new("Critical path spine", WebGlWorkbenchLayoutModes.CriticalPathSpine),
        new("Fan-out corridor", WebGlWorkbenchLayoutModes.FanoutCorridor),
        new("Radial burst", WebGlWorkbenchLayoutModes.RadialBurst)
    ];

    private static readonly IReadOnlyList<ChoiceItem> CameraViewOptions =
    [
        new("Perspective", WebGlWorkbenchCameraViewModes.Perspective),
        new("XY", WebGlWorkbenchCameraViewModes.XY),
        new("XZ", WebGlWorkbenchCameraViewModes.XZ),
        new("YZ", WebGlWorkbenchCameraViewModes.YZ)
    ];

    private const string ShowToolboxWindowChromeActionId = "host:show-toolbox-window";
    private const string ShowSelectionWindowChromeActionId = "host:show-selection-window";
    private const string ShowCommandWindowChromeActionId = "host:show-command-window";

    [SupplyParameterFromQuery(Name = "template")]
    public string? TemplateQuery { get; set; }

    [SupplyParameterFromQuery(Name = "camera")]
    public string? CameraQuery { get; set; }

    [SupplyParameterFromQuery(Name = "view")]
    public string? ViewQuery { get; set; }

    private WebGlWorkbench workbench = default!;
    private WebGlWorkbenchSurface currentSurface = new();
    private string toolboxSearchText = string.Empty;
    private OverlayWindowState toolboxWindowState = OverlayWindowState.Normalize(new OverlayWindowState
    {
        IsVisible = true,
        Left = 24,
        Top = 112,
        Width = 368,
        Height = 420
    });
    private OverlayWindowState selectionWindowState = OverlayWindowState.Normalize(new OverlayWindowState
    {
        IsVisible = true,
        Width = 360,
        Height = 285
    });
    private OverlayWindowState commandWindowState = OverlayWindowState.Normalize(new OverlayWindowState
    {
        IsVisible = true,
        IsMinimized = true,
        Left = 792,
        Top = 336,
        Width = 330,
        Height = 320
    });

    private RenderFragment BuildLeadActions => builder =>
    {
        builder.OpenComponent<StatusBadge>(0);
        builder.AddAttribute(1, nameof(StatusBadge.Text), Session.LastExportCharacterCount > 0
            ? $"{Session.LastExportCharacterCount} export chars"
            : "No export yet");
        builder.AddAttribute(2, nameof(StatusBadge.Tone), Session.LastExportCharacterCount > 0 ? "success" : "neutral");
        builder.CloseComponent();
    };

    protected override void OnParametersSet()
    {
        Session.ApplyRouteState(TemplateQuery, CameraQuery, ViewQuery);
        RefreshSurface();
    }

    private WebGlWorkbenchNode? selectedNode
        => currentSurface.Nodes.FirstOrDefault(node =>
            currentSurface.UiState.SelectedNodeIds.Contains(node.Id, StringComparer.Ordinal));

    private string SelectedNodeTitle => selectedNode?.Title ?? "Nothing selected";

    private bool IsStageMaximized => currentSurface.UiState.IsStageMaximized;

    private int SelectedNodeConnectionCount
        => selectedNode is null
            ? 0
            : currentSurface.Edges.Count(edge =>
                string.Equals(edge.SourceNodeId, selectedNode.Id, StringComparison.Ordinal) ||
                string.Equals(edge.TargetNodeId, selectedNode.Id, StringComparison.Ordinal));

    private string SelectedNodeSummary
        => selectedNode is null
            ? "Pick a node in the stage or use the semantic controls to inspect the current selection."
            : string.IsNullOrWhiteSpace(selectedNode.Description)
                ? selectedNode.Subtitle
                : selectedNode.Description;

    private IReadOnlyList<OverlayToolboxBadge> ToolboxBadges
        =>
        [
            new OverlayToolboxBadge(Session.CurrentTemplate.DisplayName, "info", "webgl-components-toolbox-template-badge"),
            new OverlayToolboxBadge($"{FilteredToolboxItemCount} items", "neutral", "webgl-components-toolbox-count-badge")
        ];

    private IReadOnlyList<OverlayToolboxSection> ToolboxSections => BuildToolboxSections();

    private int FilteredToolboxItemCount
        => ToolboxSections.Sum(section => section.Groups.Sum(group => group.Items.Count));

    private async Task HandleTemplateChangedAsync(string? templateKey)
        => await NavigateAsync(templateKey, Session.CameraViewMode, Session.ViewPreset);

    private async Task HandleViewPresetChangedAsync(string? viewPreset)
        => await NavigateAsync(Session.SelectedTemplateKey, Session.CameraViewMode, viewPreset);

    private async Task HandleCameraViewChangedAsync(string? cameraViewMode)
        => await NavigateAsync(Session.SelectedTemplateKey, cameraViewMode, Session.ViewPreset);

    private Task HandleLayoutModeChangedAsync(string? layoutMode)
    {
        Session.Recompose(layoutMode);
        RefreshSurface();
        return Task.CompletedTask;
    }

    private Task HandleSelectionChanged(WebGlSelectionChangedEventArgs args)
    {
        Session.SetSelectedNode(args.PrimaryNodeId);
        return RefreshSurfaceAsync();
    }

    private Task HandleNodesMoved(WebGlNodeMovedEventArgs args)
    {
        Session.ApplyNodesMoved(args.Positions);
        return RefreshSurfaceAsync();
    }

    private Task HandleConnectionChangeRequested(WebGlConnectionChangeRequest request)
    {
        Session.ApplyConnectionChange(request);
        return RefreshSurfaceAsync();
    }

    private Task HandleDeleteRequested(WebGlDeleteRequest request)
    {
        Session.ApplyDeleteRequest(request);
        return RefreshSurfaceAsync();
    }

    private Task HandleStateChanged(string stateJson)
    {
        Session.ApplyUiState(WebGlWorkbenchUiState.Parse(stateJson));
        return RefreshSurfaceAsync();
    }

    private async Task HandleResetAsync()
    {
        Session.Reset();
        await RefreshSurfaceAsync();
        await Task.Yield();
        if (workbench is not null)
        {
            await workbench.FitViewToSceneAsync();
        }
    }

    private async Task HandleRecomposeAsync()
    {
        Session.Recompose();
        await RefreshSurfaceAsync();
        await Task.Yield();
        if (workbench is not null)
        {
            await workbench.FitViewToSceneAsync();
        }
    }

    private Task HandleDecreaseSpacingAsync()
    {
        Session.AdjustNodeSpacing(-1);
        return RefreshSurfaceAsync();
    }

    private Task HandleIncreaseSpacingAsync()
    {
        Session.AdjustNodeSpacing(1);
        return RefreshSurfaceAsync();
    }

    private async Task HandleExportAsync()
    {
        if (workbench is null)
        {
            return;
        }

        var imageLength = await workbench.CaptureImageLengthAsync();
        Session.RecordExport(imageLength);
        await RefreshSurfaceAsync();
    }

    private Task HandleToolboxSearchChangedAsync(string? value)
    {
        toolboxSearchText = value?.Trim() ?? string.Empty;
        return InvokeAsync(StateHasChanged);
    }

    private async Task HandleToolboxItemSelectedAsync(string actionId)
    {
        var authoredNodeId = Session.AddToolboxComponent(actionId, selectedNode?.Id);
        if (string.IsNullOrWhiteSpace(authoredNodeId))
        {
            return;
        }

        await RefreshSurfaceAsync();
        await Task.Yield();
        if (workbench is not null)
        {
            await workbench.FocusNodeAsync(authoredNodeId);
        }
    }

    private Task HandleToolboxWindowStateChangedAsync(OverlayWindowState state)
    {
        toolboxWindowState = OverlayWindowState.Normalize(state);
        ApplyOverlayToolbarActions();
        return InvokeAsync(StateHasChanged);
    }

    private Task HandleSelectionWindowStateChangedAsync(OverlayWindowState state)
    {
        selectionWindowState = OverlayWindowState.Normalize(state);
        ApplyOverlayToolbarActions();
        return InvokeAsync(StateHasChanged);
    }

    private Task HandleCommandWindowStateChangedAsync(OverlayWindowState state)
    {
        commandWindowState = OverlayWindowState.Normalize(state);
        ApplyOverlayToolbarActions();
        return InvokeAsync(StateHasChanged);
    }

    private Task ShowToolboxWindowAsync()
    {
        toolboxWindowState = OverlayWindowState.Normalize(new OverlayWindowState
        {
            IsVisible = true,
            IsMinimized = false,
            Left = toolboxWindowState.Left,
            Top = toolboxWindowState.Top,
            Width = toolboxWindowState.Width,
            Height = toolboxWindowState.Height
        });
        ApplyOverlayToolbarActions();
        return InvokeAsync(StateHasChanged);
    }

    private Task ShowSelectionWindowAsync()
    {
        selectionWindowState = OverlayWindowState.Normalize(new OverlayWindowState
        {
            IsVisible = true,
            IsMinimized = false,
            Left = selectionWindowState.Left,
            Top = selectionWindowState.Top,
            Width = selectionWindowState.Width,
            Height = selectionWindowState.Height
        });
        ApplyOverlayToolbarActions();
        return InvokeAsync(StateHasChanged);
    }

    private Task ShowCommandWindowAsync()
    {
        commandWindowState = OverlayWindowState.Normalize(new OverlayWindowState
        {
            IsVisible = true,
            IsMinimized = false,
            Left = commandWindowState.Left,
            Top = commandWindowState.Top,
            Width = commandWindowState.Width,
            Height = commandWindowState.Height
        });
        ApplyOverlayToolbarActions();
        return InvokeAsync(StateHasChanged);
    }

    private async Task NavigateAsync(string? templateKey, string? cameraMode, string? viewPreset)
    {
        var template = string.IsNullOrWhiteSpace(templateKey)
            ? Session.SelectedTemplateKey
            : templateKey;
        var camera = string.IsNullOrWhiteSpace(cameraMode)
            ? Session.CameraViewMode
            : cameraMode;
        var view = string.IsNullOrWhiteSpace(viewPreset)
            ? Session.ViewPreset
            : viewPreset;
        var query = new List<string>
        {
            $"template={Uri.EscapeDataString(template)}",
            $"camera={Uri.EscapeDataString(camera)}"
        };

        if (!string.Equals(view, WebGlWorkbenchViewPresets.Overview, StringComparison.Ordinal))
        {
            query.Add($"view={Uri.EscapeDataString(view)}");
        }

        NavigationManager.NavigateTo($"/webgl/process-workbench?{string.Join("&", query)}");
        await Task.CompletedTask;
    }

    private void RefreshSurface()
    {
        currentSurface = Session.BuildSurface();
        ApplyOverlayToolbarActions();
    }

    private void ApplyOverlayToolbarActions()
    {
        currentSurface.Chrome.ToolbarActions.Clear();

        if (!toolboxWindowState.IsVisible)
        {
            currentSurface.Chrome.ToolbarActions.Add(new WebGlWorkbenchChromeToolbarAction
            {
                Id = ShowToolboxWindowChromeActionId,
                Label = "Show components toolbox",
                Glyph = "toolbox",
                Tone = "neutral",
                IconOnly = true,
                Width = 44,
                IsVisible = true
            });
        }

        if (!selectionWindowState.IsVisible)
        {
            currentSurface.Chrome.ToolbarActions.Add(new WebGlWorkbenchChromeToolbarAction
            {
                Id = ShowSelectionWindowChromeActionId,
                Label = "Show selection window",
                Glyph = "inspector",
                Tone = "accent",
                IconOnly = true,
                Width = 44,
                IsVisible = true
            });
        }

        if (!commandWindowState.IsVisible)
        {
            currentSurface.Chrome.ToolbarActions.Add(new WebGlWorkbenchChromeToolbarAction
            {
                Id = ShowCommandWindowChromeActionId,
                Label = "Show command log",
                Glyph = "log",
                Tone = "neutral",
                IconOnly = true,
                Width = 44,
                IsVisible = true
            });
        }
    }

    private Task HandleChromeActionRequestedAsync(string actionId)
    {
        if (string.Equals(actionId, ShowToolboxWindowChromeActionId, StringComparison.Ordinal))
        {
            return ShowToolboxWindowAsync();
        }

        if (string.Equals(actionId, ShowSelectionWindowChromeActionId, StringComparison.Ordinal))
        {
            return ShowSelectionWindowAsync();
        }

        if (string.Equals(actionId, ShowCommandWindowChromeActionId, StringComparison.Ordinal))
        {
            return ShowCommandWindowAsync();
        }

        return Task.CompletedTask;
    }

    private Task RefreshSurfaceAsync()
    {
        RefreshSurface();
        return InvokeAsync(StateHasChanged);
    }

    private IReadOnlyList<OverlayToolboxSection> BuildToolboxSections()
    {
        var groups = Session.ToolboxGroups
            .Select(group =>
            {
                var items = group.Actions
                    .Where(MatchesToolboxSearch)
                    .Select(action => new OverlayToolboxItem(
                        action.ActionId,
                        action.Label,
                        action.Summary,
                        Tone: action.Tone,
                        Icon: ResolveToolboxIcon(action.ActionId),
                        DataTestId: $"webgl-components-toolbox-{action.ActionId}"))
                    .ToList();

                return new OverlayToolboxGroup(
                    group.Key,
                    group.Title,
                    group.Summary,
                    items,
                    IsExpanded: true,
                    DataTestId: $"webgl-components-toolbox-group-{group.Key}",
                    BodyDataTestId: $"webgl-components-toolbox-group-body-{group.Key}");
            })
            .Where(group => group.Items.Count > 0)
            .ToList();

        if (groups.Count == 0)
        {
            return [];
        }

        return
        [
            new OverlayToolboxSection(
                "webgl-process-components",
                "Process components",
                "Reuse the same toolbox contract while authoring directly inside the 3D workbench.",
                groups,
                Tone: "accent",
                IsExpanded: true,
                DataTestId: "webgl-components-toolbox-section",
                BodyDataTestId: "webgl-components-toolbox-section-body")
        ];
    }

    private bool MatchesToolboxSearch(ProcessCanvasToolboxAction action)
    {
        if (string.IsNullOrWhiteSpace(toolboxSearchText))
        {
            return true;
        }

        return action.Label.Contains(toolboxSearchText, StringComparison.OrdinalIgnoreCase) ||
            action.Summary.Contains(toolboxSearchText, StringComparison.OrdinalIgnoreCase);
    }

    private static string ResolveToolboxIcon(string actionId)
    {
        var normalized = (actionId ?? string.Empty).Trim().ToLowerInvariant();
        if (normalized.Contains("role", StringComparison.Ordinal))
        {
            return "person_add";
        }

        if (normalized.Contains("intake", StringComparison.Ordinal))
        {
            return "playlist_add_check";
        }

        if (normalized.Contains("decision", StringComparison.Ordinal))
        {
            return "call_split";
        }

        if (normalized.Contains("architecture", StringComparison.Ordinal))
        {
            return "architecture";
        }

        if (normalized.Contains("qa", StringComparison.Ordinal))
        {
            return "fact_check";
        }

        if (normalized.Contains("security", StringComparison.Ordinal))
        {
            return "security";
        }

        if (normalized.Contains("release", StringComparison.Ordinal))
        {
            return "check";
        }

        if (normalized.Contains("deploy", StringComparison.Ordinal))
        {
            return "rocket_launch";
        }

        if (normalized.Contains("retro", StringComparison.Ordinal))
        {
            return "history";
        }

        return "hub";
    }

    private static string ResolveComplexityTone(string complexity)
    {
        return complexity switch
        {
            "Simple" => "success",
            "Medium" => "info",
            "Complex" => "accent",
            "Dense" => "warning",
            _ => "neutral"
        };
    }

    private static string ResolveLayoutLabel(string layoutMode)
    {
        return WebGlWorkbenchLayoutModes.Normalize(layoutMode) switch
        {
            WebGlWorkbenchLayoutModes.AlternatingArc => "Alternating arc",
            WebGlWorkbenchLayoutModes.LayeredOrbit => "Layered orbit",
            WebGlWorkbenchLayoutModes.CriticalPathSpine => "Critical spine",
            WebGlWorkbenchLayoutModes.FanoutCorridor => "Fan-out corridor",
            WebGlWorkbenchLayoutModes.RadialBurst => "Radial burst",
            _ => "Center lane"
        };
    }

    private static string ResolveCameraViewLabel(string cameraViewMode)
    {
        return WebGlWorkbenchCameraViewModes.Normalize(cameraViewMode) switch
        {
            WebGlWorkbenchCameraViewModes.XY => "XY view",
            WebGlWorkbenchCameraViewModes.XZ => "XZ view",
            WebGlWorkbenchCameraViewModes.YZ => "YZ view",
            _ => "Perspective"
        };
    }

    private sealed record ChoiceItem(string Label, string Value);
}

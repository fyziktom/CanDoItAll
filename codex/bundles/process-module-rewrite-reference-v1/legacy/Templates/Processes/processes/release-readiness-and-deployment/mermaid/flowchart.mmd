flowchart LR
%% process-key: release-readiness-and-deployment
%% definition-doc: processes/release-readiness-and-deployment/definition.md
    step_scope_freeze(["Freeze release scope and deployment boundary<br/><sub>scope-freeze</sub><br/><i>Make the release target explicit</i>"])
    step_readiness_synthesis["Synthesize readiness evidence and open risks<br/><sub>readiness-synthesis</sub><br/><i>Gather all proof into one release lens</i>"]
    step_cutover_rehearsal["Rehearse cutover and confirm watch coverage<br/><sub>cutover-rehearsal</sub><br/><i>Operational readiness is rehearsed, not assumed</i>"]
    step_security_and_go_no_go{"Run final security review and go/no-go approval<br/><sub>security-and-go-no-go</sub><br/><i>The last gate decides under explicit conditions</i>"}
    step_execute_cutover["Execute cutover and observe live telemetry<br/><sub>execute-cutover</sub><br/><i>Run only inside the approved envelope</i>"]
    step_stabilize_and_close(["Confirm stability, close watch, and capture learning<br/><sub>stabilize-and-close</sub><br/><i>A release ends only after stability is explicit</i>"])
    step_scope_freeze --> step_readiness_synthesis
    step_readiness_synthesis --> step_cutover_rehearsal
    step_cutover_rehearsal --> step_security_and_go_no_go
    step_security_and_go_no_go --> step_execute_cutover
    step_execute_cutover --> step_stabilize_and_close

sequenceDiagram
%% process-key: incident-response
    participant role_triage_lead as Triage lead
    participant role_resolver as Resolver
    participant role_approver as Approver
    participant system as Incident response and escalation
    role_triage_lead->>system: Acknowledge and classify incident
    system-->>role_triage_lead: evidence -> Incident triage note
    role_resolver->>system: Diagnose probable cause
    system-->>role_resolver: evidence -> Diagnosis evidence pack
    role_triage_lead->>system: Approve escalation path
    system-->>role_triage_lead: evidence -> Escalation approval record

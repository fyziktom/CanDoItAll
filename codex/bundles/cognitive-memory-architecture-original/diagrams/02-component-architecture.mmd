        Sem[SemanticCompletion Driver]
    end

    subgraph Cognitive[Cognitive Memory Module]
        SourceIngest[Source Ingestion Service]
        SourceManifest[Source Manifest Store]
        Canonical[Canonicalization Engine]
        Feature[Feature Extraction]

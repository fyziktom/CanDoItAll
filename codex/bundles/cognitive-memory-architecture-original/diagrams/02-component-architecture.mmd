        Graph[Memory Graph Service]
        Items[Memory Item Store]
        Activation[Activation + Confidence Engine]
        Coverage[Knowledge Coverage Service]
        Epistemic[Epistemic Drive Engine]
        Learning[Learning Task Orchestrator]
        Projection[Qdrant Projection Manager]
        Recall[Recall Orchestrator]
        Context[Context Pack Builder]
        Consolidation[Consolidation Engine]
        Review[Human Review Queue]
        Audit[Memory Audit/Trace Service]
    end


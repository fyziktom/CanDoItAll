@page "/"

<PageTitle>TetrisGame</PageTitle>

<div class="tetris-shell">
    <header class="tetris-hero">
        <div>
            <p class="eyebrow">Blazor WebAssembly PWA</p>
            <h1>TetrisGame</h1>
            <p class="lead">Stack the blocks, clear the lines, and keep the board under control.</p>
        </div>
        <button class="btn btn-light tetris-action" @onclick="Restart">Restart</button>
    </header>

    <section class="tetris-stage" aria-label="Tetris board">
        <div class="board" role="application" aria-label="Tetris board">
            @for (var row = 0; row < Board.GetLength(0); row++)
            {
                @for (var column = 0; column < Board.GetLength(1); column++)
                {
                    var filled = Board[row, column];
                    <div class="cell @(filled ? "filled" : null)"></div>
                }
            }
        </div>

        <aside class="tetris-panel">
            <h2>Current state</h2>
            <ul>
                <li>Lines cleared: @LinesCleared</li>
                <li>Blocks placed: @BlocksPlaced</li>
                <li>Board focus: @BoardFocus</li>
            </ul>
            <p class="status">@StatusMessage</p>
            <div class="controls">
                <button class="btn btn-primary" @onclick="FillSamplePattern">Fill sample pattern</button>
                <button class="btn btn-outline-light" @onclick="ClearBoard">Clear board</button>
            </div>
        </aside>
    </section>
</div>

@code {
    private const int Rows = 10;
    private const int Columns = 10;
    private readonly bool[,] board = new bool[Rows, Columns];
    private int linesCleared;
    private int blocksPlaced;
    private string boardFocus = "idle";
    private string statusMessage = "The board is ready for a first placement.";

    private bool[,] Board => board;
    private int LinesCleared => linesCleared;
    private int BlocksPlaced => blocksPlaced;
    private string BoardFocus => boardFocus;
    private string StatusMessage => statusMessage;

    private void FillSamplePattern()
    {
        ClearBoard();
        board[8, 3] = true;
        board[8, 4] = true;
        board[8, 5] = true;
        board[9, 5] = true;
        board[9, 6] = true;
        blocksPlaced = 5;
        boardFocus = "sample-pattern";
        statusMessage = "Sample pattern placed. The board shows the first reviewable Tetris surface.";
    }

    private void ClearBoard()
    {
        for (var row = 0; row < Rows; row++)
        {
            for (var column = 0; column < Columns; column++)
            {
                board[row, column] = false;
            }
        }

        linesCleared = 0;
        blocksPlaced = 0;
        boardFocus = "clear";
        statusMessage = "The board was cleared and is ready for another placement.";
    }

    private void Restart()
    {
        ClearBoard();
        statusMessage = "Restarted and ready for play.";
    }
}

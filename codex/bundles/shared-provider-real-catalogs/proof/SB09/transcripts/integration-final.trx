info: CanDoItAll.Composition.LlmChatOperationDispatcherHostedService[0]&#xD;
      Starting 1 LLM Chat dispatcher worker(s). CandidateBatchSize=16 MaximumQueuedAge=00:05:00 MaximumOperationDuration=00:30:00.&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (5ms) [Parameters=[@p0='?' (DbType = Int32), @p1='?' (DbType = Int32), @p2='?' (DbType = Int32), @p3='?' (DbType = DateTime), @p4='?' (DbType = Int32)], CommandType='Text', CommandTimeout='15']&#xD;
      WITH candidates AS&#xD;
(&#xD;
    SELECT event."OperationId", event."Sequence"&#xD;
    FROM "LlmChats_Operations" AS operation&#xD;
    INNER JOIN "LlmChats_OperationEvents" AS event&#xD;
        ON event."OperationId" = operation."Id"&#xD;
    WHERE operation."Status" IN (&#xD;
        @p0,&#xD;
        @p1,&#xD;
        @p2)&#xD;
      AND operation."CompletedAtUtc" &lt; @p3&#xD;
    ORDER BY operation."CompletedAtUtc", event."OperationId", event."Sequence"&#xD;
    LIMIT @p4&#xD;
    FOR UPDATE OF event SKIP LOCKED&#xD;
)&#xD;
DELETE FROM "LlmChats_OperationEvents" AS event&#xD;
USING candidates&#xD;
WHERE event."OperationId" = candidates."OperationId"&#xD;
  AND event."Sequence" = candidates."Sequence"&#xD;

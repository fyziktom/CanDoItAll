info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (3ms) [Parameters=[@p='?' (DbType = Int32)], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT p."RunId", p."UpdatedAtUtc"&#xD;
      FROM process_runtime_states AS p&#xD;
      WHERE p."Status" = 'Blocked'&#xD;
      ORDER BY p."UpdatedAtUtc" DESC, p."RunId" DESC&#xD;
      LIMIT @p&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (4ms) [Parameters=[@p='?' (DbType = Int32)], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT p."RunId", p."UpdatedAtUtc"&#xD;
      FROM process_runtime_states AS p&#xD;
      WHERE p."Status" IN ('Completed', 'Failed', 'Cancelled', 'Blocked') AND EXISTS (&#xD;
          SELECT 1&#xD;
          FROM process_runtime_step_assignments AS p0&#xD;
          WHERE p0."RunId" = p."RunId" AND p0."LaunchVariablesJson" LIKE '%"ParentProcessRunId"%')&#xD;
      ORDER BY p."UpdatedAtUtc" DESC, p."RunId" DESC&#xD;
      LIMIT @p&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (3ms) [Parameters=[], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT p."LaunchVariablesJson"&#xD;
      FROM process_runtime_step_assignments AS p&#xD;
      INNER JOIN process_runtime_states AS p0 ON p."RunId" = p0."RunId"&#xD;
      WHERE p0."Status" NOT IN ('Completed', 'Failed', 'Cancelled', 'Blocked') AND p."LaunchVariablesJson" LIKE '%"ParentProcessRunId"%' AND p."LaunchVariablesJson" LIKE '%"ParentProcessStepId"%'&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (2ms) [Parameters=[@p='?' (DbType = Int32)], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT p."RunId", p."Status", p."UpdatedAtUtc"&#xD;
      FROM process_runtime_states AS p&#xD;
      WHERE p."Status" IN ('Active', 'Created')&#xD;
      ORDER BY p."UpdatedAtUtc" DESC, p."RunId" DESC&#xD;
      LIMIT @p&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (6ms) [Parameters=[@p='?' (DbType = Int32)], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT a."Id", a."ComponentJson"&#xD;
      FROM "AgentFramework_WorkflowComponents" AS a&#xD;
      WHERE a."PromptGalleryBindingSchemaVersion" &lt; 1&#xD;
      ORDER BY a."Id"&#xD;
      LIMIT @p&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (3ms) [Parameters=[@p='?' (DbType = Int32)], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT a."VersionId", a."CreatedAtUtc", a."DefinitionJson", a."Description", a."InstructionSnapshotSchemaVersion", a."Name", a."PreferredBackend", a."Revision", a."Status", a."UpdatedAtUtc", a."WorkflowId"&#xD;
      FROM "AgentFramework_WorkflowDefinitions" AS a&#xD;
      WHERE a."InstructionSnapshotSchemaVersion" &lt; 3&#xD;
      ORDER BY a."VersionId"&#xD;
      LIMIT @p&#xD;

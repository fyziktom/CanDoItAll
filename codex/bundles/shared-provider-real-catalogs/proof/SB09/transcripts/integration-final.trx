      WHERE l."Status" IN (0, 1, 4) AND (l."ExecutionOwnerId" IS NULL OR l."LeaseExpiresAtUtc" IS NULL OR l."LeaseExpiresAtUtc" &lt;= @observedAtUtc)&#xD;
      ORDER BY l."StartedAtUtc", l."Id"&#xD;
      LIMIT @p&#xD;

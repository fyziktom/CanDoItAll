info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (5ms) [Parameters=[@p='?' (DbType = Int32)], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT a."Id", a."ComponentJson"&#xD;
      FROM "AgentFramework_WorkflowComponents" AS a&#xD;
      WHERE a."PromptGalleryBindingSchemaVersion" &lt; 1&#xD;
      ORDER BY a."Id"&#xD;
      LIMIT @p&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (12ms) [Parameters=[@interruptedBeforeUtc='?' (DbType = DateTime), @p='?' (DbType = Int32)], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT w."Id"&#xD;
      FROM "Workspace_SharedProviderInvocations" AS w&#xD;
      WHERE w."Outcome" = 'InProgress' AND w."StartedAtUtc" &lt;= @interruptedBeforeUtc&#xD;
      ORDER BY w."StartedAtUtc", w."Id"&#xD;
      LIMIT @p&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (8ms) [Parameters=[@p='?' (DbType = Int32)], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT a."VersionId", a."CreatedAtUtc", a."DefinitionJson", a."Description", a."InstructionSnapshotSchemaVersion", a."Name", a."PreferredBackend", a."Revision", a."Status", a."UpdatedAtUtc", a."WorkflowId"&#xD;
      FROM "AgentFramework_WorkflowDefinitions" AS a&#xD;
      WHERE a."InstructionSnapshotSchemaVersion" &lt; 3&#xD;
      ORDER BY a."VersionId"&#xD;
      LIMIT @p&#xD;

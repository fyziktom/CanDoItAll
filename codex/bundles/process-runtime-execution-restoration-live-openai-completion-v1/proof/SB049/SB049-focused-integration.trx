info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (2ms) [Parameters=[@p='?', @p4='?' (DbType = DateTime), @p5='?' (DbType = DateTime), @outboxId='?' (DbType = Guid), @now='?' (DbType = DateTime)], CommandType='Text', CommandTimeout='15']&#xD;
      UPDATE "Processes_Outbox" AS p&#xD;
      SET "LeaseToken" = @p,&#xD;
          "LeaseExpiresAtUtc" = @p4,&#xD;
          "UpdatedAtUtc" = @p5&#xD;
      WHERE p."Id" = @outboxId AND p."Status" = 0 AND (p."NextAttemptAtUtc" IS NULL OR p."NextAttemptAtUtc" &lt;= @now) AND (p."LeaseExpiresAtUtc" IS NULL OR p."LeaseExpiresAtUtc" &lt;= @now)&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (1ms) [Parameters=[@outboxId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT p."Id", p."AttemptCount", p."CommandKey", p."CompletedAtUtc", p."CreatedAtUtc", p."LastAttemptAtUtc", p."LastError", p."LeaseExpiresAtUtc", p."LeaseToken", p."NextAttemptAtUtc", p."PayloadJson", p."ProcessDefinitionId", p."ProcessRunId", p."ProjectId", p."Status", p."UpdatedAtUtc"&#xD;
      FROM "Processes_Outbox" AS p&#xD;
      WHERE p."Id" = @outboxId&#xD;
      LIMIT 1&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (2ms) [Parameters=[@p='?' (DbType = DateTime), @p5='?' (DbType = DateTime), @outboxId='?' (DbType = Guid), @leaseToken='?', @now='?' (DbType = DateTime)], CommandType='Text', CommandTimeout='15']&#xD;
      UPDATE "Processes_Outbox" AS p&#xD;
      SET "AttemptCount" = p."AttemptCount" + 1,&#xD;
          "LastAttemptAtUtc" = @p,&#xD;
          "UpdatedAtUtc" = @p5&#xD;
      WHERE p."Id" = @outboxId AND p."Status" = 0 AND p."LeaseToken" = @leaseToken AND p."LeaseExpiresAtUtc" IS NOT NULL AND p."LeaseExpiresAtUtc" &gt; @now AND (p."NextAttemptAtUtc" IS NULL OR p."NextAttemptAtUtc" &lt;= @now)&#xD;

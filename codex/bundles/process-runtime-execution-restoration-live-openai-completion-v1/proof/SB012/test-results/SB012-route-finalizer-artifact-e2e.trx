info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (1ms) [Parameters=[@request_ProcessDefinitionId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT p."Id", p."ActivePublishedVersionId", p."AutonomyLevel", p."ConcurrencyToken", p."CreatedAtUtc", p."Criticality", p."CustomerName", p."GovernanceNotes", p."InterfaceContractSummary", p."Name", p."NextVersionNumber", p."OwnerName", p."ProjectId", p."Slug", p."Status", p."Summary", p."UpdatedAtUtc", p."ValueStatement"&#xD;
      FROM "Processes_Definitions" AS p&#xD;
      WHERE p."Id" = @request_ProcessDefinitionId&#xD;
      LIMIT 2&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (2ms) [Parameters=[@definition_Id='?' (DbType = Guid), @definition_ActivePublishedVersionId_Value='?' (DbType = Guid)], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT p."Id", p."ChangeSummary", p."ConcurrencyToken", p."ConstitutionRuleSummary", p."ContractMode", p."CreatedAtUtc", p."GovernancePolicySummary", p."ImportWarnings", p."ImportedFrom", p."ManagerAgentOverrideId", p."ManagerAgentOverrideName", p."OperatingModeSummary", p."ProcessDefinitionId", p."PublishedAtUtc", p."PublishedBy", p."SimulationReadinessSummary", p."Status", p."UpdatedAtUtc", p."VersionNumber"&#xD;
      FROM "Processes_DefinitionVersions" AS p&#xD;
      WHERE p."ProcessDefinitionId" = @definition_Id AND p."Id" = @definition_ActivePublishedVersionId_Value AND p."Status" = 'Published'&#xD;
      LIMIT 2&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (2ms) [Parameters=[@publishedVersion_Id='?' (DbType = Guid)], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT p."Id", p."AllowsFallback", p."CanvasX", p."CanvasY", p."DefaultAllocationPercent", p."DisplayName", p."DisplayOrder", p."IsRequired", p."Key", p."PreferredExecutorKind", p."PreferredProjectAssignmentRole", p."PreferredWorkflowDefinitionId", p."PreferredWorkflowVersionId", p."ProcessDefinitionVersionId", p."Purpose", p."RequiresExplicitApproval", p."RoleTemplateSnapshotName", p."RoleTemplateSourceKey", p."SnapshotSummary", p."StaffingIntent"&#xD;
      FROM "Processes_RoleRequirements" AS p&#xD;
      WHERE p."ProcessDefinitionVersionId" = @publishedVersion_Id&#xD;
      ORDER BY p."DisplayOrder"&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (1ms) [Parameters=[@publishedVersion_Id='?' (DbType = Guid)], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT p."Id", p."AllowedOperations", p."AllowsManualSkip", p."AllowsSafeRefusal", p."BranchCanvasX", p."BranchCanvasY", p."CanvasX", p."CanvasY", p."DecisionRightsSummary", p."DecisionRoleRequirementId", p."EvidenceContractSummary", p."ExceptionPolicySummary", p."InputContractSummary", p."Key", p."Notes", p."OperationTargetScope", p."OrderIndex", p."OutputContractSummary", p."ProcessDefinitionVersionId", p."RequiresApproval", p."RequiresDecisionRecord", p."StepKind", p."SubprocessDefinitionId", p."SubprocessDefinitionSnapshotName", p."Subtitle", p."TargetLeadHours", p."Title"&#xD;
      FROM "Processes_StepDefinitions" AS p&#xD;
      WHERE p."ProcessDefinitionVersionId" = @publishedVersion_Id&#xD;
      ORDER BY p."OrderIndex"&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (1ms) [Parameters=[@stepIds='?' (DbType = Object)], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT p."Id", p."DependsOnBranchOutcomeId", p."DependsOnStepId", p."DisplayOrder", p."StepDefinitionId"&#xD;
      FROM "Processes_StepDependencies" AS p&#xD;
      WHERE p."StepDefinitionId" = ANY (@stepIds)&#xD;
      ORDER BY p."DisplayOrder"&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (1ms) [Parameters=[@stepIds='?' (DbType = Object)], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT p."Id", p."FallbackOrder", p."IsRequired", p."RebindPolicySummary", p."ResponsibilityKind", p."RoleRequirementId", p."StepDefinitionId"&#xD;
      FROM "Processes_StepRoleRequirements" AS p&#xD;
      WHERE p."StepDefinitionId" = ANY (@stepIds)&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (1ms) [Parameters=[@stepIds='?' (DbType = Object)], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT p."Id", p."Description", p."DisplayOrder", p."Key", p."StepDefinitionId", p."Title"&#xD;
      FROM "Processes_StepBranchOutcomes" AS p&#xD;
      WHERE p."StepDefinitionId" = ANY (@stepIds)&#xD;
      ORDER BY p."DisplayOrder"&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (1ms) [Parameters=[@stepIds='?' (DbType = Object)], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT p."Id", p."AllowedFutureUsageSummary", p."ArtifactKind", p."IsRequired", p."RetentionDays", p."SensitivityLevel", p."StepDefinitionId", p."SubprocessChildArtifactExpectationId", p."Title", p."TrustRequirement", p."ValidationRequirementSummary", p."WorkflowOutputId", p."WorkflowOutputKind", p."WorkflowOutputName"&#xD;
      FROM "Processes_ArtifactExpectations" AS p&#xD;
      WHERE p."StepDefinitionId" = ANY (@stepIds)&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (3ms) [Parameters=[], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT a."VersionId", a."CreatedAtUtc", a."DefinitionJson", a."Description", a."Name", a."PreferredBackend", a."Status", a."UpdatedAtUtc", a."WorkflowId"&#xD;
      FROM "AgentFramework_WorkflowDefinitions" AS a&#xD;
      ORDER BY a."UpdatedAtUtc" DESC, a."CreatedAtUtc" DESC&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (3ms) [Parameters=[@context_Definition_Id='?' (DbType = Guid), @p='?' (DbType = Int32)], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT p."Id", p."ActualCost", p."CompletedAtUtc", p."ConcurrencyToken", p."CreatedAtUtc", p."EstimatedCost", p."ExecutorSnapshotSummary", p."FirstTimeRightPercent", p."GovernanceSnapshot", p."HierarchyDepth", p."ManagerAgentId", p."ManagerAgentName", p."Name", p."OperatingMode", p."ParentRunId", p."ParentStepRunId", p."PolicySnapshot", p."ProcessDefinitionId", p."ProcessDefinitionVersionId", p."ProjectId", p."ReplayPackageKey", p."RootRunId", p."SlaAttainmentPercent", p."StartedAtUtc", p."Status", p."TriggerReason", p."UpdatedAtUtc"&#xD;
      FROM "Processes_Runs" AS p&#xD;
      WHERE p."ProcessDefinitionId" = @context_Definition_Id&#xD;
      ORDER BY COALESCE(p."CompletedAtUtc", p."StartedAtUtc", p."UpdatedAtUtc") DESC&#xD;
      LIMIT @p&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (1ms) [Parameters=[@definitionId='?' (DbType = Guid), @runId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT p."Id", p."PayloadJson"&#xD;
      FROM "Processes_Outbox" AS p&#xD;

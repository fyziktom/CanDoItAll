{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicandoitall.com/schemas/maf-approval-decision.schema.json",
  "title": "Request-Specific Approval Decision",
  "type": "object",
  "required": [
    "sessionId",
    "decisions"
  ],
  "properties": {
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "expectedSessionStateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "approvalId",
          "approved"
        ],
        "properties": {
          "approvalId": {
            "type": "string",
            "minLength": 1
          },
          "approved": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "maxLength": 2000
          },
          "expectedFingerprint": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
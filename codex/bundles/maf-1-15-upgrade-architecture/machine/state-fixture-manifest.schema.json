{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicandoitall.com/schemas/maf-state-fixture-manifest.schema.json",
  "title": "MAF Cross-Version State Fixture Manifest",
  "type": "object",
  "required": [
    "fixtureId",
    "sourceFrameworkVersion",
    "fixtureKind",
    "sha256",
    "sanitized",
    "expectedTargetOutcome"
  ],
  "properties": {
    "fixtureId": {
      "type": "string",
      "minLength": 1
    },
    "sourceFrameworkVersion": {
      "type": "string",
      "minLength": 1
    },
    "targetFrameworkVersion": {
      "type": "string"
    },
    "fixtureKind": {
      "enum": [
        "chat-session",
        "provider-conversation",
        "function-approval",
        "mcp-approval",
        "mixed-tools",
        "attachment-scrub",
        "governed-step",
        "background-response",
        "handoff",
        "workflow-checkpoint",
        "a2a-session",
        "rollback"
      ]
    },
    "historyMode": {
      "enum": [
        "framework-managed",
        "provider-managed",
        "isolated",
        "workflow",
        "not-applicable"
      ]
    },
    "hasPendingApprovals": {
      "type": "boolean"
    },
    "pendingApprovalCount": {
      "type": "integer",
      "minimum": 0
    },
    "containsRequestScopedAttachments": {
      "type": "boolean"
    },
    "sanitized": {
      "const": true
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "createdAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "sourceCommit": {
      "type": "string"
    },
    "generatorTest": {
      "type": "string"
    },
    "expectedTargetOutcome": {
      "enum": [
        "native-restore",
        "provider-continuation",
        "transcript-fallback",
        "approval-reissue",
        "trusted-bridge",
        "typed-incompatible",
        "checkpoint-resume",
        "rollback-restore-required"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
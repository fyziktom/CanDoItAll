{
  "repositoryRootPath": "<absolute repository root>",
  "testWorkspaces": [
    "<only relevant .sln/.slnx/.csproj paths>"
  ],
  "changes": [
    {
      "path": "src/<actual changed file>",
      "lineRanges": [
        {
          "startLine": 1,
          "endLine": 1
        }
      ],
      "behaviorIntent": "Unknown"
    }
  ],
  "contextOnlyPaths": [
    "src/<inspected but unchanged helper>"
  ],
  "maxVisitedMembers": 300,
  "maxSelectors": 100,
  "maxReasonPaths": 200
}

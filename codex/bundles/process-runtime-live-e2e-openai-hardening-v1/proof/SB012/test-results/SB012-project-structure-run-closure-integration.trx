info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (1ms) [Parameters=[@definitionId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT p."Id", p."ActivePublishedVersionId", p."AutonomyLevel", p."ConcurrencyToken", p."CreatedAtUtc", p."Criticality", p."CustomerName", p."GovernanceNotes", p."InterfaceContractSummary", p."Name", p."NextVersionNumber", p."OwnerName", p."ProjectId", p."Slug", p."Status", p."Summary", p."UpdatedAtUtc", p."ValueStatement"&#xD;
      FROM "Processes_Definitions" AS p&#xD;
      WHERE p."Id" = @definitionId&#xD;
      LIMIT 2&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (2ms) [Parameters=[@definition_Id='?' (DbType = Guid), @definition_ActivePublishedVersionId_Value='?' (DbType = Guid)], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT p."Id", p."ChangeSummary", p."ConcurrencyToken", p."ConstitutionRuleSummary", p."ContractMode", p."CreatedAtUtc", p."GovernancePolicySummary", p."ImportWarnings", p."ImportedFrom", p."ManagerAgentOverrideId", p."ManagerAgentOverrideName", p."OperatingModeSummary", p."ProcessDefinitionId", p."PublishedAtUtc", p."PublishedBy", p."SimulationReadinessSummary", p."Status", p."UpdatedAtUtc", p."VersionNumber"&#xD;
      FROM "Processes_DefinitionVersions" AS p&#xD;
      WHERE p."ProcessDefinitionId" = @definition_Id AND p."Id" = @definition_ActivePublishedVersionId_Value AND p."Status" = 'Published'&#xD;
      LIMIT 2&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (2ms) [Parameters=[@publishedVersion_Id='?' (DbType = Guid)], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT p."Id", p."AllowsFallback", p."CanvasX", p."CanvasY", p."DefaultAllocationPercent", p."DisplayName", p."DisplayOrder", p."IsRequired", p."Key", p."PreferredExecutorKind", p."PreferredProjectAssignmentRole", p."PreferredWorkflowDefinitionId", p."PreferredWorkflowVersionId", p."ProcessDefinitionVersionId", p."Purpose", p."RequiresExplicitApproval", p."RoleTemplateSnapshotName", p."RoleTemplateSourceKey", p."SnapshotSummary", p."StaffingIntent"&#xD;
      FROM "Processes_RoleRequirements" AS p&#xD;
      WHERE p."ProcessDefinitionVersionId" = @publishedVersion_Id&#xD;
      ORDER BY p."DisplayOrder"&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (2ms) [Parameters=[@roleIds='?' (DbType = Object)], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT p."Id", p."IsRequired", p."MinimumYearsExperience", p."RoleRequirementId", p."SkillId"&#xD;
      FROM "Processes_RoleSkillRequirements" AS p&#xD;
      WHERE p."RoleRequirementId" = ANY (@roleIds)&#xD;
      ORDER BY p."MinimumYearsExperience"&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (4ms) [Parameters=[@processDefinitionId='?' (DbType = Guid), @processDefinitionVersionId='?' (DbType = Guid), @projectId='?' (DbType = Guid), @planName='?', @operatingMode='?', @triggerReason='?', @requestedBy='?'], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT p."Id", p."UpdatedAtUtc"&#xD;
      FROM "Processes_LaunchPlans" AS p&#xD;
      WHERE p."ProcessDefinitionId" = @processDefinitionId AND p."ProcessDefinitionVersionId" = @processDefinitionVersionId AND p."ProjectId" = @projectId AND p."Name" = @planName AND p."OperatingMode" = @operatingMode AND p."TriggerReason" = @triggerReason AND p."RequestedBy" = @requestedBy AND p."GeneratedRunId" IS NULL AND p."Status" IN ('Draft', 'ChangesRequested')&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (6ms) [Parameters=[@projectId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT c."Id", c."ProjectId", c."PartyId", c."AssignmentKind", c0."DisplayName", c0."PartyType", c."NodeKey", c."IsPrimary", c."AllocationPercent", c."StartsAtUtc", c."EndsAtUtc", c."Notes"&#xD;
      FROM "CrmHr_ProjectPartyAssignments" AS c&#xD;
      INNER JOIN "CrmHr_Parties" AS c0 ON c."PartyId" = c0."Id"&#xD;
      WHERE c."ProjectId" = @projectId&#xD;
      ORDER BY c."NodeKey", c."AssignmentKind", c."IsPrimary" DESC, c0."DisplayName"&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (3ms) [Parameters=[@projectId_Value='?' (DbType = Guid)], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT p."Id", p."CreatedAtUtc", p."CurrentPhase", p."Description", p."Name", p."Objective", p."Slug", p."Status", p."TargetDateUtc", p."UpdatedAtUtc"&#xD;
      FROM "Projects_Projects" AS p&#xD;
      WHERE p."Id" = @projectId_Value&#xD;
      LIMIT 1&#xD;

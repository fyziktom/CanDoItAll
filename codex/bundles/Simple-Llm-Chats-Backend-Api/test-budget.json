{
  "schemaVersion": 1,
  "policy": "Full solution and complete Unit/Integration project runs are forbidden before SB11.",
  "normalSubbundle": {
    "maxAffectedProjectBuilds": 3,
    "maxFocusedTestCommands": 4,
    "requiresFilter": true,
    "forbiddenTargets": [
      "CanDoItAll.slnx",
      "tests/Unit/CanDoItAll.Tests.Unit/CanDoItAll.Tests.Unit.csproj without --filter",
      "tests/Integration/CanDoItAll.Tests.Integration/CanDoItAll.Tests.Integration.csproj without --filter",
      "tests/Playwright",
      "Category=LiveProcess",
      "Category=LongRunning",
      "Category=Quarantined"
    ]
  },
  "checkpoints": {
    "CP0": "No broad test command.",
    "CP1": "Union of LlmChat and LlmConversation focused filters only.",
    "CP2": "Focused HTTP + migration + backend filters only."
  },
  "finalSubbundle": {
    "allowStableSolutionGate": true,
    "maxStableSolutionTestRuns": 1,
    "allowUnfilteredSuite": false,
    "allowPlaywright": false,
    "commandsSource": "docs/testing.md"
  }
}

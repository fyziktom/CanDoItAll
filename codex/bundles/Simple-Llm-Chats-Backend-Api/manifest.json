    "included": [
      "ordinary LLM chat product domain and canonical models",
      "definition revisioning and lifecycle",
      "PostgreSQL transcript and product persistence",
      "profile-generation-fenced provider execution",
      "provider/model-specific thinking-effort selection and capability projection",
      "turn operation idempotency, cancellation, recovery and usage audit",
      "HTTP API and focused API/PostgreSQL tests",
      "cross-platform static and CI-ready validation",
      "versioned database-transfer support through the canonical transfer mechanism",
      "documented future-readiness for enterprise chatbot deployments without dormant adapters"
    ],
    "excluded": [
      "Razor/UI implementation",
      "floating chat catalog integration",
      "shared chat component extraction",
      "Project Structure context provider",
      "file and image upload UI",
      "voice UI",
      "external chatbot deployments and channel adapters",
      "streaming transport",
      "agent tools, skills, memory, approvals and process integration"
    ]
  },

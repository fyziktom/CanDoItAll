        <StdOut>{"SchemaConformance":true,"Operation":"ImageGenerations","Schema":{"required":["model","prompt"],"type":"object","properties":{"model":{"maxLength":80,"minLength":80,"pattern":"^sp1\\.(?!0{32}\\.)[0-9a-f]{32}\\.[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$","type":"string","description":"Opaque canonical sp1 routing identifier returned by the catalog; never substitute an upstream model name."},"prompt":{"maxLength":1048576,"minLength":1,"pattern":"^[^\\u0000]*$","type":"string"},"n":{"maximum":16,"minimum":1,"type":"integer","description":"Defaults to one. The resolved provider can enforce a lower limit (currently four for image adapters)."},"size":{"enum":["256x256","512x512","1024x1024","1024x1536","1536x1024","auto"],"type":"string"},"quality":{"enum":["standard","hd","low","medium","high","auto"],"type":"string"},"response_format":{"enum":["b64_json"],"type":"string"},"output_format":{"enum":["png","jpeg","webp"],"type":"string"}},"additionalProperties":false,"description":"Strict, case-sensitive OpenAI-compatible subset. Unknown and duplicate properties are rejected. JSON depth is at most 32 and the UTF-8 body is bounded by the endpoint/provider limit. Text limits count UTF-16 code units. Model capabilities and configured token/image limits are checked at dispatch. Only client-executed function tools and data-URI image input are supported; no remote URLs, files, audio, hosted tools, stored responses, background jobs, or previous_response_id. After streaming headers, upstream failure aborts the transport and does not produce a successful terminal event."},"Cases":[{"Payload":{"model":"sp1.53f874b50c204feca0afa68381afa4cc.6GqYPGURrKeo0oAOsY6DUeey1fabAtmCljk-HoGz7_4","prompt":"Hello"},"Accepted":true},{"Payload":{"model":"sp1.53f874b50c204feca0afa68381afa4cc.6GqYPGURrKeo0oAOsY6DUeey1fabAtmCljk-HoGz7_4","prompt":"Hello","n":4,"response_format":"b64_json","output_format":"webp","size":"auto","quality":"high"},"Accepted":true},{"Payload":{"model":"sp1.53f874b5
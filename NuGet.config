<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="CanDoItAllLocalExceptions" value="ExternalPackages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="CanDoItAllLocalExceptions">
      <package pattern="CanDoItAll.Components.Sandbox" />
    </packageSource>
  </packageSourceMapping>
</configuration>

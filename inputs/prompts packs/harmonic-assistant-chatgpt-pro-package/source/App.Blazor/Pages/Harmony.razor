@page "/harmony"
@implements IAsyncDisposable
@using App.Blazor.Models
@using MusicTheory.Core.Generation.Realtime
@using MusicTheory.Core.Models
@using MusicTheory.Core.Recognition
@using MusicTheory.Core.Theory
@inject IMidiService MidiService
@inject RealtimeChordDetectionSessionService ChordDetectionSession
@inject HarmonicAssistantSessionService HarmonicAssistantSession
@inject HarmonicAssistantCanvasInterop CanvasInterop

<div class="page-shell">
    <RadzenStack Gap="1rem">
        <div class="hero-card">
            <h1>Realtime Harmonic Assistant</h1>
            <p>Past, present, and predicted harmony rendered on canvas with mood-aware branching suggestions.</p>
        </div>

        <RadzenCard class="panel-card">
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeXL="8">
                    <RadzenText TextStyle="TextStyle.H6">Mood controls</RadzenText>
                    <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="0.8rem" style="margin-top:0.6rem">
                        <RadzenFormField Text="Brighter ↔ Darker">
                            <ChildContent>
                                <RadzenSlider TValue="double" Min="0" Max="1" Step="0.01" Value="@settings.Brightness" Change="OnBrightnessChanged" Style="width:220px" />
                            </ChildContent>
                        </RadzenFormField>
                        <RadzenFormField Text="Simple ↔ Colorful">
                            <ChildContent>
                                <RadzenSlider TValue="double" Min="0" Max="1" Step="0.01" Value="@settings.Colorfulness" Change="OnColorfulnessChanged" Style="width:220px" />
                            </ChildContent>
                        </RadzenFormField>
                        <RadzenFormField Text="Style">
                            <ChildContent>
                                <RadzenDropDown TValue="StylePackPreset" Data="@stylePresets" Value="@settings.StylePack" Change="OnStyleChanged" Style="width:220px" />
                            </ChildContent>
                        </RadzenFormField>
                        <RadzenFormField Text="History steps">
                            <ChildContent>
                                <RadzenSlider TValue="int" Min="8" Max="256" Step="1" Value="@settings.HistorySteps" Change="OnHistoryStepsChanged" Style="width:220px" />
                            </ChildContent>
                        </RadzenFormField>
                    </RadzenStack>

                    <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="0.5rem" style="margin-top:0.75rem">
                        <RadzenButton Text="Verse" ButtonStyle="@(settings.Section == HarmonicSectionType.Verse ? ButtonStyle.Primary : ButtonStyle.Light)" Click="@(() => ChangeSectionAsync(HarmonicSectionType.Verse))" />
                        <RadzenButton Text="Chorus" ButtonStyle="@(settings.Section == HarmonicSectionType.Chorus ? ButtonStyle.Primary : ButtonStyle.Light)" Click="@(() => ChangeSectionAsync(HarmonicSectionType.Chorus))" />
                        <RadzenButton Text="Bridge" ButtonStyle="@(settings.Section == HarmonicSectionType.Bridge ? ButtonStyle.Primary : ButtonStyle.Light)" Click="@(() => ChangeSectionAsync(HarmonicSectionType.Bridge))" />
                        <RadzenButton Text="Give me a chorus" Icon="auto_awesome" Click="GiveChorusAsync" />
                        <RadzenButton Text="Give me a verse" Icon="music_note" ButtonStyle="ButtonStyle.Light" Click="GiveVerseAsync" />
                        <RadzenButton Text="Reset" Icon="restart_alt" ButtonStyle="ButtonStyle.Light" Click="ResetAsync" />
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeXL="4">
                    <RadzenText TextStyle="TextStyle.H6">MIDI status</RadzenText>
                    <div class="status-chip @(MidiService.IsSupported ? "status-chip-online" : string.Empty)" data-testid="midi-status" style="margin-top:0.5rem">
                        @StatusText
                    </div>
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.45rem" style="margin-top:0.75rem">
                        <RadzenSwitch Value="@settings.LockKey" Change="OnLockKeyChangedAsync" />
                        <span>Lock key</span>
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.45rem" style="margin-top:0.5rem">
                        <RadzenSwitch Value="@showDebug" Change="OnShowDebugChanged" />
                        <span>Show debug</span>
                    </RadzenStack>
                    <RadzenText TextStyle="TextStyle.Body2" style="margin-top:0.5rem">Fallback manual input</RadzenText>
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.45rem" style="margin-top:0.25rem">
                        <RadzenTextBox @bind-Value="manualChord" Placeholder="e.g. Cmaj7" Style="width:120px" />
                        <RadzenButton Text="Apply" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="ApplyManualChordAsync" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <RadzenCard class="panel-card">
            <canvas @ref="canvasRef" class="harmony-canvas"></canvas>
        </RadzenCard>

        @if (showDebug)
        {
            <RadzenCard class="panel-card">
                <RadzenText TextStyle="TextStyle.H6">Debug panel</RadzenText>
                <RadzenRow Gap="1rem" style="margin-top:0.55rem">
                    <RadzenColumn Size="12" SizeXL="4">
                        <RadzenText TextStyle="TextStyle.Subtitle2">Top detection candidates</RadzenText>
                        @if (latestDetection.Candidates.Count == 0)
                        {
                            <RadzenText TextStyle="TextStyle.Body2">No detection candidates.</RadzenText>
                        }
                        else
                        {
                            <ul class="summary-list">
                                @foreach (var candidate in latestDetection.Candidates.Take(5))
                                {
                                    <li>@candidate.DisplayName | score @candidate.Score.ToString("0.00")</li>
                                }
                            </ul>
                        }
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeXL="4">
                        <RadzenText TextStyle="TextStyle.Subtitle2">Pitch-class scores (top 8)</RadzenText>
                        @if (latestScoreSnapshot.RankedPitchClassScores.Count == 0)
                        {
                            <RadzenText TextStyle="TextStyle.Body2">No pitch-class score profile.</RadzenText>
                        }
                        else
                        {
                            <ul class="summary-list">
                                @foreach (var item in latestScoreSnapshot.RankedPitchClassScores.Take(8))
                                {
                                    <li>@PitchMath.ToNoteName(item.PitchClass, EnharmonicPreference.Sharps).Token | @item.Score.ToString("0.000")</li>
                                }
                            </ul>
                        }

                        <RadzenText TextStyle="TextStyle.Subtitle2" style="margin-top:0.65rem">Inferred scale context</RadzenText>
                        @if (latestDetection.InferredScaleContext.Count == 0)
                        {
                            <RadzenText TextStyle="TextStyle.Body2">No inferred context.</RadzenText>
                        }
                        else
                        {
                            <ul class="summary-list">
                                @foreach (var scale in latestDetection.InferredScaleContext.Take(4))
                                {
                                    <li>@scale.Name | @scale.Confidence.ToString("0.00")</li>
                                }
                            </ul>
                        }
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeXL="4">
                        <RadzenText TextStyle="TextStyle.Subtitle2">Top suggestion paths (reasons)</RadzenText>
                        @if (update.Suggestions.Count == 0)
                        {
                            <RadzenText TextStyle="TextStyle.Body2">No harmonic suggestions yet.</RadzenText>
                        }
                        else
                        {
                            @foreach (var path in update.Suggestions.Take(3))
                            {
                                <div class="dashboard-action-card" style="margin-top:0.45rem">
                                    <RadzenText TextStyle="TextStyle.Caption">p @path.Probability.ToString("P0") | score @path.Score.ToString("0.00")</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Caption">@string.Join(" -> ", path.Steps.Select(step => step.ChordName))</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Caption">@string.Join(", ", path.Steps.SelectMany(step => step.Reasons).Distinct())</RadzenText>
                                </div>
                            }
                        }
                    </RadzenColumn>
                </RadzenRow>
            </RadzenCard>
        }

        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeXL="5">
                <RadzenCard class="panel-card">
                    <RadzenText TextStyle="TextStyle.H6">Recent chord history</RadzenText>
                    @if (update.State.History.Count == 0)
                    {
                        <RadzenText TextStyle="TextStyle.Body2">No history yet. Play or enter a chord to begin.</RadzenText>
                    }
                    else
                    {
                        <ul class="summary-list">
                            @foreach (var item in update.State.History.TakeLast(8).Reverse())
                            {
                                <li>@item.TimestampUtc.ToLocalTime().ToString("T") - @item.Candidates.First().DisplayName</li>
                            }
                        </ul>
                    }
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeXL="7">
                <RadzenCard class="panel-card">
                    <RadzenText TextStyle="TextStyle.H6">Predicted harmony paths</RadzenText>
                    @if (update.Suggestions.Count == 0)
                    {
                        <RadzenText TextStyle="TextStyle.Body2">No suggestions available yet.</RadzenText>
                    }
                    else
                    {
                        @foreach (var path in update.Suggestions.Take(4))
                        {
                            <div class="dashboard-action-card" style="margin-top:0.45rem">
                                <RadzenText TextStyle="TextStyle.Subtitle2">@path.KeyDisplayName | Probability @path.Probability.ToString("P0")</RadzenText>
                                <RadzenText TextStyle="TextStyle.Caption">@string.Join(" -> ", path.Steps.Select(step => step.ChordName))</RadzenText>
                                <RadzenText TextStyle="TextStyle.Caption">Reasons: @string.Join(", ", path.Steps.SelectMany(step => step.Reasons).Distinct())</RadzenText>
                            </div>
                        }
                    }
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>
    </RadzenStack>
</div>

@code {
    private readonly StylePackPreset[] stylePresets = Enum.GetValues<StylePackPreset>();

    private AssistantSettings settings = new();
    private HarmonicAssistantUpdate update = new(HarmonicAssistantState.Default, Array.Empty<HarmonicSuggestionPath>());
    private RealtimeChordDetectionResult latestDetection = new(
        Snapshot: new RealtimeChordWindowSnapshot(
            ActiveNotes: Array.Empty<RealtimeActiveNoteInfo>(),
            ActivePitchClasses: Array.Empty<int>(),
            DuplicatePitchClassCounts: new Dictionary<int, int>(),
            BassPitchClass: null,
            SustainPedalDown: false,
            IsStable: false,
            TooManyNotes: false,
            WindowSpanMs: 0,
            TimestampMs: 0),
        Candidates: Array.Empty<RealtimeChordCandidate>(),
        HasDenseClusterWarning: false,
        WarningMessage: null,
        InferredScaleContext: Array.Empty<CandidateScaleSuggestion>());
    private RealtimeNoteScoreSnapshot latestScoreSnapshot = RealtimeNoteScoreSnapshot.Empty();
    private ElementReference canvasRef;
    private bool canvasReady;
    private bool disposed;
    private bool useCanvasV2 = true;
    private bool showDebug;
    private string manualChord = "Cmaj7";

    private string StatusText
    {
        get
        {
            if (!MidiService.IsSupported)
            {
                return "No MIDI device connected - Web MIDI requires HTTPS or localhost.";
            }

            if (!MidiService.IsInitialized)
            {
                return "No MIDI device connected - MIDI has not been initialized yet.";
            }

            if (string.IsNullOrWhiteSpace(MidiService.ConnectedInputId))
            {
                return "No MIDI device connected";
            }

            return "MIDI input connected";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        HarmonicAssistantSession.UpdateChanged += HandleAssistantUpdateChanged;
        await HarmonicAssistantSession.StartAsync();
        await HarmonicAssistantSession.ConfigureAsync(settings);
        update = HarmonicAssistantSession.CurrentUpdate;
        latestDetection = ChordDetectionSession.CurrentResult;
        latestScoreSnapshot = ChordDetectionSession.CurrentScoreSnapshot;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || disposed)
        {
            return;
        }

        try
        {
            await CanvasInterop.InitializeAsync(canvasRef);
            await CanvasInterop.ObserveResizeAsync(canvasRef);
            canvasReady = true;
            await RenderCanvasAsync();
        }
        catch
        {
            canvasReady = false;
        }
    }

    private void HandleAssistantUpdateChanged(HarmonicAssistantUpdate assistantUpdate)
    {
        if (disposed)
        {
            return;
        }

        update = assistantUpdate;
        latestDetection = ChordDetectionSession.CurrentResult;
        latestScoreSnapshot = ChordDetectionSession.CurrentScoreSnapshot;
        _ = InvokeAsync(async () =>
        {
            if (disposed)
            {
                return;
            }

            try
            {
                await RenderCanvasAsync();
                StateHasChanged();
            }
            catch
            {
                // Ignore late render calls during navigation/disposal.
            }
        });
    }

    private Task OnBrightnessChanged(double value)
    {
        settings = settings with { Brightness = Math.Clamp(value, 0, 1) };
        return HarmonicAssistantSession.ConfigureAsync(settings);
    }

    private Task OnColorfulnessChanged(double value)
    {
        settings = settings with { Colorfulness = Math.Clamp(value, 0, 1) };
        return HarmonicAssistantSession.ConfigureAsync(settings);
    }

    private Task OnHistoryStepsChanged(int value)
    {
        settings = settings with { HistorySteps = Math.Clamp(value, 8, 256) };
        return HarmonicAssistantSession.ConfigureAsync(settings);
    }

    private Task OnStyleChanged(object value)
    {
        if (value is StylePackPreset preset)
        {
            settings = settings with { StylePack = preset };
        }

        return HarmonicAssistantSession.ConfigureAsync(settings);
    }

    private Task ChangeSectionAsync(HarmonicSectionType section)
    {
        settings = settings with { Section = section };
        return HarmonicAssistantSession.ConfigureAsync(settings);
    }

    private Task GiveChorusAsync()
    {
        settings = settings with { Section = HarmonicSectionType.Chorus, Colorfulness = 0.65 };
        return HarmonicAssistantSession.ConfigureAsync(settings);
    }

    private Task GiveVerseAsync()
    {
        settings = settings with { Section = HarmonicSectionType.Verse, Colorfulness = 0.35 };
        return HarmonicAssistantSession.ConfigureAsync(settings);
    }

    private Task OnLockKeyChangedAsync(bool value)
    {
        settings = settings with { LockKey = value };
        return HarmonicAssistantSession.ConfigureAsync(settings);
    }

    private void OnShowDebugChanged(bool value)
    {
        showDebug = value;
    }

    private Task ApplyManualChordAsync()
    {
        return HarmonicAssistantSession.SubmitManualChordAsync(manualChord);
    }

    private async Task ResetAsync()
    {
        HarmonicAssistantSession.Reset();
        update = HarmonicAssistantSession.CurrentUpdate;
        await HarmonicAssistantSession.ConfigureAsync(settings);
    }

    private async Task RenderCanvasAsync()
    {
        if (!canvasReady || disposed)
        {
            return;
        }

        if (useCanvasV2)
        {
            var snapshotV2 = BuildCanvasSnapshotV2(update);
            await CanvasInterop.RenderV2Async(snapshotV2);
            return;
        }

        var snapshot = BuildCanvasSnapshot(update);
        await CanvasInterop.RenderAsync(snapshot);
    }

    private HarmonicAssistantCanvasSnapshotV2 BuildCanvasSnapshotV2(HarmonicAssistantUpdate assistantUpdate)
    {
        var nodes = new List<HarmonicCanvasNodeV2>();
        var edges = new List<HarmonicCanvasEdgeV2>();

        var historySteps = Math.Clamp(settings.HistorySteps, 8, 256);
        var history = assistantUpdate.State.History.TakeLast(historySteps).ToArray();
        var currentHistoryIndex = history.Length - 1;
        for (var i = 0; i < history.Length; i++)
        {
            var eventItem = history[i];
            var candidate = eventItem.Candidates.FirstOrDefault();
            if (candidate is null)
            {
                continue;
            }

            var id = $"history-{i}";
            var isCurrent = i == currentHistoryIndex;
            var xIndex = i - currentHistoryIndex;
            var metrics = HarmonyVisualMapping.Compute(candidate.Chord);
            nodes.Add(new HarmonicCanvasNodeV2(
                Id: id,
                Label: candidate.DisplayName,
                Kind: isCurrent ? "current" : "history",
                IsCurrent: isCurrent,
                XIndex: xIndex,
                PathId: null,
                StepIndex: null,
                Probability: Math.Clamp(candidate.Probability, 0.0, 1.0),
                WorldY: metrics.WorldY,
                Color: metrics.ColorHex,
                Meta: new Dictionary<string, object?>
                {
                    ["rootPitchClass"] = candidate.Chord.RootPitchClass,
                    ["symbol"] = candidate.Chord.Definition.Symbol,
                    ["timestampUtc"] = eventItem.TimestampUtc.ToString("O")
                }));

            if (i > 0)
            {
                edges.Add(new HarmonicCanvasEdgeV2($"history-{i - 1}", id, "history", 0.5));
            }
        }

        var suggestions = assistantUpdate.Suggestions.Take(4).ToArray();
        for (var pathIndex = 0; pathIndex < suggestions.Length; pathIndex++)
        {
            var path = suggestions[pathIndex];
            var pathId = $"p{pathIndex}";
            var parentId = history.Length == 0 ? null : $"history-{currentHistoryIndex}";
            for (var stepIndex = 0; stepIndex < path.Steps.Count; stepIndex++)
            {
                var step = path.Steps[stepIndex];
                var id = $"future-{pathIndex}-{stepIndex}";
                var metrics = GetVisualMetricsFromChordName(step.ChordName);
                nodes.Add(new HarmonicCanvasNodeV2(
                    Id: id,
                    Label: step.ChordName,
                    Kind: "future",
                    IsCurrent: false,
                    XIndex: stepIndex + 1,
                    PathId: pathId,
                    StepIndex: stepIndex + 1,
                    Probability: Math.Clamp(path.Probability, 0.0, 1.0),
                    WorldY: metrics.WorldY,
                    Color: metrics.ColorHex,
                    Meta: new Dictionary<string, object?>
                    {
                        ["pathProbability"] = path.Probability,
                        ["stepScore"] = step.Score,
                        ["suggestedScale"] = step.SuggestedScale
                    }));

                if (parentId is not null)
                {
                    edges.Add(new HarmonicCanvasEdgeV2(
                        parentId,
                        id,
                        "prediction",
                        Math.Clamp(path.Probability, 0.0, 1.0)));
                }

                parentId = id;
            }
        }

        var currentNode = nodes.FirstOrDefault(node => node.IsCurrent);
        var horizonSteps = suggestions.Length == 0 ? 0 : suggestions.Max(path => path.Steps.Count);
        var caption = suggestions.Length == 0
            ? "Awaiting stable chord detection."
            : $"Suggestions update in under 250 ms. Top path probability {suggestions[0].Probability:P0}.";
        return new HarmonicAssistantCanvasSnapshotV2(
            Nodes: nodes,
            Edges: edges,
            Caption: caption,
            Layout: new HarmonicCanvasLayoutV2(history.Length, horizonSteps),
            RenderHints: new HarmonicCanvasRenderHintsV2(currentNode?.WorldY));
    }

    private static HarmonyVisualMetrics GetVisualMetricsFromChordName(string chordName)
    {
        if (TryParseChordFromDisplayName(chordName, out var chord))
        {
            return HarmonyVisualMapping.Compute(chord);
        }

        return HarmonyVisualMapping.Compute(ChordBuilder.Build(0, "maj"));
    }

    private static bool TryParseChordFromDisplayName(string? value, out ChordInstance chord)
    {
        chord = ChordBuilder.Build(0, "maj");
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        var text = value.Trim();
        if (text.Length < 1)
        {
            return false;
        }

        var rootLength = text.Length >= 2 && (text[1] == '#' || text[1] == 'b' || text[1] == 'B') ? 2 : 1;
        var rootToken = text[..rootLength];
        var symbolRaw = rootLength >= text.Length ? "maj" : text[rootLength..];
        if (!NoteName.TryParse(rootToken, out var noteName))
        {
            return false;
        }

        if (!TryNormalizeChordSymbol(symbolRaw, out var symbol))
        {
            return false;
        }

        chord = ChordBuilder.Build(PitchMath.ToPitchClass(noteName), symbol);
        return true;
    }

    private static bool TryNormalizeChordSymbol(string? value, out string symbol)
    {
        symbol = "maj";
        if (string.IsNullOrWhiteSpace(value))
        {
            return true;
        }

        var normalized = value.Trim();
        if (ChordLibrary.TryGet(normalized, out _))
        {
            symbol = normalized;
            return true;
        }

        var aliases = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["m"] = "min",
            ["m7"] = "min7",
            ["m9"] = "min9",
            ["m11"] = "min11",
            ["m13"] = "min13",
            ["major"] = "maj",
            ["minor"] = "min",
            ["dom7"] = "7",
            ["ø"] = "m7b5",
            ["o"] = "dim"
        };

        if (aliases.TryGetValue(normalized, out var mapped) && ChordLibrary.TryGet(mapped, out _))
        {
            symbol = mapped;
            return true;
        }

        return false;
    }

    private static HarmonicAssistantCanvasSnapshot BuildCanvasSnapshot(HarmonicAssistantUpdate assistantUpdate)
    {
        var nodes = new List<HarmonicCanvasNode>();
        var edges = new List<HarmonicCanvasEdge>();

        var history = assistantUpdate.State.History.TakeLast(8).ToArray();
        for (var i = 0; i < history.Length; i++)
        {
            var eventItem = history[i];
            var candidate = eventItem.Candidates.FirstOrDefault();
            if (candidate is null)
            {
                continue;
            }

            var id = $"history-{i}";
            var x = 80 + i * 120;
            var y = 120;
            nodes.Add(new HarmonicCanvasNode(
                Id: id,
                Label: candidate.DisplayName,
                X: x,
                Y: y,
                Weight: Math.Clamp(candidate.Probability, 0.15, 1),
                Kind: i == history.Length - 1 ? "current" : "history",
                IsCurrent: i == history.Length - 1));

            if (i > 0)
            {
                edges.Add(new HarmonicCanvasEdge($"history-{i - 1}", id, 0.5, "history"));
            }
        }

        var suggestions = assistantUpdate.Suggestions.Take(3).ToArray();
        for (var pathIndex = 0; pathIndex < suggestions.Length; pathIndex++)
        {
            var path = suggestions[pathIndex];
            var parentId = history.Length == 0 ? null : $"history-{history.Length - 1}";
            for (var stepIndex = 0; stepIndex < path.Steps.Count; stepIndex++)
            {
                var step = path.Steps[stepIndex];
                var id = $"future-{pathIndex}-{stepIndex}";
                var x = 220 + stepIndex * 170;
                var y = 220 + pathIndex * 85;
                nodes.Add(new HarmonicCanvasNode(
                    Id: id,
                    Label: step.ChordName,
                    X: x,
                    Y: y,
                    Weight: Math.Clamp(path.Probability + 0.12, 0.1, 1),
                    Kind: "future",
                    IsCurrent: false));

                if (parentId is not null)
                {
                    edges.Add(new HarmonicCanvasEdge(parentId, id, Math.Clamp(path.Probability + 0.15, 0.18, 1), "prediction"));
                }

                parentId = id;
            }
        }

        var caption = suggestions.Length == 0
            ? "Awaiting stable chord detection."
            : $"Suggestions update in under 250 ms. Top path probability {suggestions[0].Probability:P0}.";
        return new HarmonicAssistantCanvasSnapshot(nodes, edges, caption);
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        HarmonicAssistantSession.UpdateChanged -= HandleAssistantUpdateChanged;
        try
        {
            await CanvasInterop.DisposeAsync();
        }
        catch
        {
            // Ignore disposal races during route transitions.
        }
    }
}

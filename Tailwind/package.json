{
  "name": "candoitall-main-tailwind",
  "private": true,
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "scripts": {
    "build": "tailwindcss -i ./input.css -o ../src/App/CanDoItAll.Web/wwwroot/css/output.css",
    "watch": "tailwindcss -i ./input.css -o ../src/App/CanDoItAll.Web/wwwroot/css/output.css --watch=always"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true
  }
}

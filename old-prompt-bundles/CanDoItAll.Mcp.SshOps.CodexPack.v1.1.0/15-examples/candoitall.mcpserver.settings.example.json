{
  "server": {
    "name": "CanDoItAll.Mcp.SshOps",
    "defaultTarget": "staging-01",
    "logLevel": "Information"
  },
  "transport": {
    "backend": "SshNet",
    "connectTimeoutSeconds": 15,
    "operationTimeoutSeconds": 120,
    "uploadTimeoutSeconds": 120,
    "downloadTimeoutSeconds": 120
  },
  "security": {
    "allowDangerousRawExec": false,
    "redactEnvironmentVariableNames": [
      "POSTGRES_PASSWORD",
      "IPFS_SWARM_KEY",
      "LETSENCRYPT_DNS_API_TOKEN",
      "SSH_PRIVATE_KEY"
    ]
  },
  "defaults": {
    "remoteStateRoot": "/opt/candoitall/.mcp-state",
    "stackRoot": "/opt/candoitall/stacks",
    "backupRoot": "/opt/candoitall/backups",
    "proxyDockerNetwork": "proxy",
    "operationPollSeconds": 2,
    "httpProbeTimeoutSeconds": 10
  },
  "targets": [
    {
      "name": "staging-01",
      "host": "203.0.113.10",
      "port": 22,
      "user": "deployer",
      "privateKeyEnvVar": "CANDOITALL_SSH_PRIVATE_KEY_STAGING_01",
      "privateKeyPassphraseEnvVar": "CANDOITALL_SSH_PRIVATE_KEY_PASSPHRASE_STAGING_01",
      "hostKeyVerification": {
        "mode": "PinnedFingerprint",
        "fingerprint": "SHA256:REPLACE_WITH_REAL_FINGERPRINT"
      },
      "allowedRoots": [
        "/opt/candoitall",
        "/etc/traefik"
      ],
      "docker": {
        "binaryPath": "docker",
        "composePluginCommand": "docker compose"
      },
      "traefik": {
        "stackName": "infra-traefik",
        "stackPath": "/opt/candoitall/stacks/infra-traefik",
        "acmeStoragePath": "/opt/candoitall/stacks/infra-traefik/data/acme.json",
        "proxyNetwork": "proxy"
      },
      "validation": {
        "healthEndpoint": "https://api-staging.example.com/health",
        "certificateHostnames": [
          "api-staging.example.com"
        ]
      },
      "guards": {
        "allowSudo": true,
        "allowDockerPrune": false
      }
    }
  ]
}

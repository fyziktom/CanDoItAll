{
  "mcpServers": {
    "candoitall-ssh-ops": {
      "command": "dotnet",
      "args": [
        "/absolute/path/to/CanDoItAll.Mcp.SshOps/bin/Debug/net10.0/CanDoItAll.Mcp.SshOps.dll"
      ],
      "env": {
        "CANDOITALL_MCP_SETTINGS_PATH": "/absolute/path/to/candoitall.mcpserver.settings.json",
        "CANDOITALL_SSH_PRIVATE_KEY_STAGING_01": "-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"
      }
    }
  }
}

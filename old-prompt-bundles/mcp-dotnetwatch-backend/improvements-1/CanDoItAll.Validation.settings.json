{
  "Server": {
    "Name": "CanDoItAll.Mcp.DotNetWatch",
    "WorkspaceRoot": "C:\\repositories\\CanDoItAll",
    "SolutionPath": "CanDoItAll.slnx"
  },
  "DefaultApp": {
    "ProjectPath": "src/CanDoItAll.Web/CanDoItAll.Web.csproj",
    "WorkingDirectory": "src/CanDoItAll.Web",
    "Mode": "WatchRun",
    "Configuration": "Debug",
    "Framework": null,
    "LaunchProfile": "https",
    "Arguments": [],
    "Urls": [
      "https://localhost:7411",
      "http://localhost:5141"
    ],
    "EnvironmentOverlay": {
      "ASPNETCORE_ENVIRONMENT": "Development",
      "DOTNET_ENVIRONMENT": "Development",
      "DOTNET_CLI_UI_LANGUAGE": "en"
    }
  },
  "Health": {
    "Enabled": true,
    "Urls": [
      "https://localhost:7411/_dev/runtime"
    ],
    "TimeoutMs": 5000,
    "PollIntervalMs": 500,
    "StableSuccessCount": 1,
    "AcceptInsecureLocalhostHttps": true,
    "AllowedHosts": [
      "localhost",
      "127.0.0.1",
      "::1"
    ]
  },
  "Build": {
    "DefaultTargetPath": "CanDoItAll.slnx",
    "DefaultWhenAppRunning": "StopAndResume",
    "DefaultTimeoutMs": 1800000,
    "ExtraArguments": []
  },
  "Tests": {
    "DefaultTargetPath": "tests/CanDoItAll.Tests.Unit/CanDoItAll.Tests.Unit.csproj",
    "DefaultWhenAppRunning": "StopAndResume",
    "DefaultTimeoutMs": 1800000,
    "RunnerPreference": "Auto",
    "DefaultFilter": null,
    "Projects": [
      "tests/CanDoItAll.Tests.Unit/CanDoItAll.Tests.Unit.csproj",
      "tests/CanDoItAll.Mcp.DotNetWatch.Tests/CanDoItAll.Mcp.DotNetWatch.Tests.csproj"
    ]
  },
  "Logs": {
    "BufferCapacity": 5000,
    "PersistToFile": true,
    "Folder": ".mcp-state/validation-2/logs",
    "MaxFileSizeMb": 50,
    "RedactionEnabled": true,
    "IncludeSystemEvents": true
  },
  "Process": {
    "GracefulStopTimeoutMs": 1000,
    "ForceKillAfterMs": 5000,
    "CleanupStaleManagedProcessesOnStartup": true,
    "RegistryPath": ".mcp-state/validation-2/process-registry.json",
    "UsePollingFileWatcher": false
  },
  "Backend": {
    "Enabled": true,
    "BindHost": "127.0.0.1",
    "RegistrationPath": ".mcp-state/validation-2/backend/registration.json",
    "LaunchLockPath": ".mcp-state/validation-2/backend/launch.lock",
    "StartupTimeoutMs": 30000,
    "StartupPollIntervalMs": 250
  },
  "Waits": {
    "DefaultAppWaitTimeoutMs": 120000,
    "DefaultOperationWaitTimeoutMs": 1800000,
    "DefaultPollIntervalMs": 500,
    "DefaultQuietPeriodMs": 2000
  },
  "Security": {
    "AllowedProjectRoots": [
      "src",
      "tests",
      "tools"
    ],
    "AllowExternalHealthHosts": false,
    "AllowedEnvironmentKeys": [
      "ASPNETCORE_ENVIRONMENT",
      "ASPNETCORE_URLS",
      "DOTNET_ENVIRONMENT",
      "DOTNET_USE_POLLING_FILE_WATCHER",
      "DetailedErrors",
      "DOTNET_CLI_UI_LANGUAGE"
    ]
  }
}

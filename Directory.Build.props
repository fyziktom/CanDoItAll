<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <CanDoItAllComponentsPackageVersion>0.1.15</CanDoItAllComponentsPackageVersion>
    <CanDoItAllFileToolsPackageVersion>0.1.15</CanDoItAllFileToolsPackageVersion>
    <MicrosoftAspNetCoreComponentsVersion>10.0.10</MicrosoftAspNetCoreComponentsVersion>
    <MicrosoftExtensionsPackageVersion>10.0.10</MicrosoftExtensionsPackageVersion>
    <DefaultItemExcludes>
      $(DefaultItemExcludes);
      .mcp-state/**;
      .artifacts/**;
      playwright-report/**;
      test-results/**;
      TestResults/**;
      coverage/**;
      screenshots/**;
    </DefaultItemExcludes>
  </PropertyGroup>
</Project>

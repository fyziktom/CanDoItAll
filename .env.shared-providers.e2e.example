# Tracked non-secret defaults. The E2E tool writes generated credentials to the ignored artifact root.
E2E_COMPOSE_PROJECT_NAME=candoitall-shared-providers-e2e
E2E_ARTIFACT_ROOT=./.artifacts/shared-providers-e2e
E2E_APP_IMAGE=candoitall-shared-providers:e46f81d5
E2E_UPSTREAM_IMAGE=candoitall-shared-providers-upstream:e46f81d5
E2E_CENTRAL_PORT=5210
E2E_CLIENT_A_PORT=5211
E2E_CLIENT_B_PORT=5212
E2E_UPSTREAM_PORT=5213
E2E_PERSONAL_UPSTREAM_PORT=5214
E2E_POSTGRES_PORT=55432
E2E_DB_ADMIN_PASSWORD_FILE=.artifacts/shared-providers-e2e/runtime-secrets/db-admin-password
E2E_DB_CENTRAL_PASSWORD_FILE=.artifacts/shared-providers-e2e/runtime-secrets/db-central-password
E2E_DB_CLIENT_A_PASSWORD_FILE=.artifacts/shared-providers-e2e/runtime-secrets/db-client-a-password
E2E_DB_CLIENT_B_PASSWORD_FILE=.artifacts/shared-providers-e2e/runtime-secrets/db-client-b-password
E2E_DB_CENTRAL_CONNECTION_STRING_FILE=.artifacts/shared-providers-e2e/runtime-secrets/db-central-connection-string
E2E_DB_CLIENT_A_CONNECTION_STRING_FILE=.artifacts/shared-providers-e2e/runtime-secrets/db-client-a-connection-string
E2E_DB_CLIENT_B_CONNECTION_STRING_FILE=.artifacts/shared-providers-e2e/runtime-secrets/db-client-b-connection-string
E2E_API_CENTRAL_SIGNING_KEY_FILE=.artifacts/shared-providers-e2e/runtime-secrets/api-central-signing-key
E2E_API_CLIENT_A_SIGNING_KEY_FILE=.artifacts/shared-providers-e2e/runtime-secrets/api-client-a-signing-key
E2E_API_CLIENT_B_SIGNING_KEY_FILE=.artifacts/shared-providers-e2e/runtime-secrets/api-client-b-signing-key
E2E_UPSTREAM_DATA_TOKEN_FILE=.artifacts/shared-providers-e2e/runtime-secrets/upstream-data-token
E2E_UPSTREAM_CONTROL_TOKEN_FILE=.artifacts/shared-providers-e2e/runtime-secrets/upstream-control-token
E2E_PERSONAL_UPSTREAM_DATA_TOKEN_FILE=.artifacts/shared-providers-e2e/runtime-secrets/personal-upstream-data-token
E2E_PERSONAL_UPSTREAM_CONTROL_TOKEN_FILE=.artifacts/shared-providers-e2e/runtime-secrets/personal-upstream-control-token
E2E_APP_UID=1654
E2E_APP_GID=1654
DOTNET_SDK_VERSION=10.0.302
DOTNET_RUNTIME_VERSION=10.0.10
POSTGRES_IMAGE_TAG=16-alpine
BUSYBOX_VERSION=1.37.0-musl

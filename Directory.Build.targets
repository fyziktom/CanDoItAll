<Project>
  <PropertyGroup>
    <CopyRepositoryTemplatesToOutput Condition="'$(CopyRepositoryTemplatesToOutput)' == ''">true</CopyRepositoryTemplatesToOutput>
    <CanDoItAllComponentsRepositoryRoot Condition="'$(CanDoItAllComponentsRepositoryRoot)' == ''">$(MSBuildThisFileDirectory)..\CanDoItAll.Components</CanDoItAllComponentsRepositoryRoot>
    <CanDoItAllFileToolsRepositoryRoot Condition="'$(CanDoItAllFileToolsRepositoryRoot)' == ''">$(MSBuildThisFileDirectory)..\CanDoItAll.FileTools</CanDoItAllFileToolsRepositoryRoot>
    <UseLocalCanDoItAllLibraries Condition="'$(UseLocalCanDoItAllLibraries)' == ''">false</UseLocalCanDoItAllLibraries>
    <ShouldUnsetParentConfigurationAndPlatform Condition="'$(UseLocalCanDoItAllLibraries)' == 'true'">false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseLocalCanDoItAllLibraries)' == 'true'">
    <DefineConstants>$(DefineConstants);CANDOITALL_FILETOOLS_DIRECT_SOURCE</DefineConstants>
  </PropertyGroup>

  <Target
    Name="ValidateLocalCanDoItAllLibraryProvenance"
    BeforeTargets="CollectPackageReferences;PrepareForBuild"
    Condition="'$(UseLocalCanDoItAllLibraries)' == 'true'">
    <Error
      Condition="'$(CanDoItAllComponentsExpectedCommit)' == ''"
      Text="Explicit source mode requires CanDoItAllComponentsExpectedCommit." />
    <Error
      Condition="'$(CanDoItAllFileToolsExpectedCommit)' == ''"
      Text="Explicit source mode requires CanDoItAllFileToolsExpectedCommit." />
    <Error
      Condition="!Exists('$(CanDoItAllComponentsRepositoryRoot)\.git')"
      Text="Explicit source mode requires a Components Git checkout at '$(CanDoItAllComponentsRepositoryRoot)'." />
    <Error
      Condition="!Exists('$(CanDoItAllFileToolsRepositoryRoot)\.git')"
      Text="Explicit source mode requires a FileTools Git checkout at '$(CanDoItAllFileToolsRepositoryRoot)'." />

    <Exec
      Command="git -c safe.directory=&quot;$(CanDoItAllComponentsRepositoryRoot)&quot; -C &quot;$(CanDoItAllComponentsRepositoryRoot)&quot; rev-parse HEAD"
      ConsoleToMsBuild="true"
      StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_ActualCanDoItAllComponentsCommitLine" />
    </Exec>
    <Exec
      Command="git -c safe.directory=&quot;$(CanDoItAllFileToolsRepositoryRoot)&quot; -C &quot;$(CanDoItAllFileToolsRepositoryRoot)&quot; rev-parse HEAD"
      ConsoleToMsBuild="true"
      StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_ActualCanDoItAllFileToolsCommitLine" />
    </Exec>
    <Exec
      Command="git -c safe.directory=&quot;$(CanDoItAllComponentsRepositoryRoot)&quot; -C &quot;$(CanDoItAllComponentsRepositoryRoot)&quot; status --porcelain --untracked-files=no"
      ConsoleToMsBuild="true"
      StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_CanDoItAllComponentsStatusLine" />
    </Exec>
    <Exec
      Command="git -c safe.directory=&quot;$(CanDoItAllFileToolsRepositoryRoot)&quot; -C &quot;$(CanDoItAllFileToolsRepositoryRoot)&quot; status --porcelain --untracked-files=no"
      ConsoleToMsBuild="true"
      StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_CanDoItAllFileToolsStatusLine" />
    </Exec>

    <PropertyGroup>
      <_ActualCanDoItAllComponentsCommit>@(_ActualCanDoItAllComponentsCommitLine)</_ActualCanDoItAllComponentsCommit>
      <_ActualCanDoItAllFileToolsCommit>@(_ActualCanDoItAllFileToolsCommitLine)</_ActualCanDoItAllFileToolsCommit>
    </PropertyGroup>
    <Error
      Condition="'$(_ActualCanDoItAllComponentsCommit)' != '$(CanDoItAllComponentsExpectedCommit)'"
      Text="Components source commit '$(_ActualCanDoItAllComponentsCommit)' does not match expected commit '$(CanDoItAllComponentsExpectedCommit)'." />
    <Error
      Condition="'$(_ActualCanDoItAllFileToolsCommit)' != '$(CanDoItAllFileToolsExpectedCommit)'"
      Text="FileTools source commit '$(_ActualCanDoItAllFileToolsCommit)' does not match expected commit '$(CanDoItAllFileToolsExpectedCommit)'." />
    <Error
      Condition="'@(_CanDoItAllComponentsStatusLine)' != ''"
      Text="Components source checkout must be clean before it can support a validated source-mode claim." />
    <Error
      Condition="'@(_CanDoItAllFileToolsStatusLine)' != ''"
      Text="FileTools source checkout must be clean before it can support a validated source-mode claim." />

  </Target>

  <Target Name="ValidateCanDoItAllLibraryMode" BeforeTargets="CollectPackageReferences;PrepareForBuild">
    <Error
      Condition="'$(UseLocalCanDoItAllLibraries)' != 'true' and '$(UseLocalCanDoItAllLibraries)' != 'false'"
      Text="UseLocalCanDoItAllLibraries must be explicitly true or false." />
  </Target>

  <ItemGroup Condition="'$(UseLocalCanDoItAllLibraries)' == 'true'">
    <_LocalCanDoItAllComponentsPackage Include="@(PackageReference->WithMetadataValue('Identity', 'CanDoItAll.Components.BaseLib'))" />
    <_LocalCanDoItAllComponentsPackage Include="@(PackageReference->WithMetadataValue('Identity', 'CanDoItAll.Components.CanvasLib'))" />
    <_LocalCanDoItAllComponentsPackage Include="@(PackageReference->WithMetadataValue('Identity', 'CanDoItAll.Components.Charts'))" />
    <_LocalCanDoItAllComponentsPackage Include="@(PackageReference->WithMetadataValue('Identity', 'CanDoItAll.Components.Common'))" />
    <_LocalCanDoItAllComponentsPackage Include="@(PackageReference->WithMetadataValue('Identity', 'CanDoItAll.Components.Gantt'))" />
    <_LocalCanDoItAllComponentsPackage Include="@(PackageReference->WithMetadataValue('Identity', 'CanDoItAll.Components.Mermaid'))" />
    <_LocalCanDoItAllComponentsPackage Include="@(PackageReference->WithMetadataValue('Identity', 'CanDoItAll.Components.OverlayLib'))" />
    <_LocalCanDoItAllComponentsPackage Include="@(PackageReference->WithMetadataValue('Identity', 'CanDoItAll.Components.QRCode'))" />
    <_LocalCanDoItAllComponentsPackage Include="@(PackageReference->WithMetadataValue('Identity', 'CanDoItAll.Components.WebGlLib'))" />
    <_LocalCanDoItAllComponentsPackage Include="@(PackageReference->WithMetadataValue('Identity', 'CanDoItAll.Components.WebGlRunLib'))" />
    <_LocalCanDoItAllFileToolsPackage Include="@(PackageReference->WithMetadataValue('Identity', 'CanDoItAll.FileTools.Abstractions'))" />
    <_LocalCanDoItAllFileToolsPackage Include="@(PackageReference->WithMetadataValue('Identity', 'CanDoItAll.FileTools.Desktop'))" />
    <_LocalCanDoItAllFileToolsPackage Include="@(PackageReference->WithMetadataValue('Identity', 'CanDoItAll.FileTools.FileBrowser.Components'))" />
    <_LocalCanDoItAllFileToolsPackage Include="@(PackageReference->WithMetadataValue('Identity', 'CanDoItAll.FileTools.FileBrowser.Core'))" />
    <_LocalCanDoItAllFileToolsPackage Include="@(PackageReference->WithMetadataValue('Identity', 'CanDoItAll.FileTools.FileInteraction.Components'))" />
    <_LocalCanDoItAllFileToolsPackage Include="@(PackageReference->WithMetadataValue('Identity', 'CanDoItAll.FileTools.FileInteraction.Core'))" />
    <_LocalCanDoItAllFileToolsPackage Include="@(PackageReference->WithMetadataValue('Identity', 'CanDoItAll.FileTools.FileInteraction.Markdown'))" />
    <_LocalCanDoItAllFileToolsPackage Include="@(PackageReference->WithMetadataValue('Identity', 'CanDoItAll.FileTools.Providers.FileSystem'))" />

    <PackageReference Remove="@(_LocalCanDoItAllComponentsPackage);@(_LocalCanDoItAllFileToolsPackage)" />
    <ProjectReference Include="@(_LocalCanDoItAllComponentsPackage->'$(CanDoItAllComponentsRepositoryRoot)\src\%(Identity)\%(Identity).csproj')" />
    <ProjectReference Include="@(_LocalCanDoItAllFileToolsPackage->'$(CanDoItAllFileToolsRepositoryRoot)\src\%(Identity)\%(Identity).csproj')" />
  </ItemGroup>

  <ItemGroup>
    <RepositoryTemplateContent Include="$(MSBuildThisFileDirectory)Templates\**\*.*" />
  </ItemGroup>

  <Target Name="CopyRepositoryTemplates" AfterTargets="Build" Condition="'$(CopyRepositoryTemplatesToOutput)' == 'true' and '@(RepositoryTemplateContent)' != ''">
    <MakeDir Directories="$(TargetDir)Templates" />
    <Copy
      SourceFiles="@(RepositoryTemplateContent)"
      DestinationFiles="@(RepositoryTemplateContent->'$(TargetDir)Templates\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>

{
  "Server": {
    "Name": "CanDoItAll.Mcp.SshOps",
    "StateDirectory": ".mcp-state/sshops",
    "LogDirectory": ".mcp-state/sshops/logs",
    "MaxBundleBytes": 67108864,
    "AllowDangerousRawExec": true
  },
  "Transport": {
    "Backend": "sshnet",
    "ConnectTimeoutSeconds": 20,
    "CommandTimeoutSeconds": 300,
    "UploadTimeoutSeconds": 300
  },
  "Security": {
    "RequireHostKeyPinningInProduction": false,
    "RedactSecretsInLogs": true,
    "DenyAgentForwarding": true,
    "DenyPasswordAuthentication": false
  },
  "Defaults": {
    "RemoteStateRoot": "/home/pi/candoitall/.mcp-state",
    "StacksRoot": "/home/pi/candoitall/stacks",
    "SecretsRoot": "/home/pi/candoitall/secrets",
    "AllowedRoots": [
      "/home/pi/candoitall"
    ],
    "ComposeApplyTimeoutSeconds": 900,
    "HttpWaitTimeoutSeconds": 180,
    "CertWaitTimeoutSeconds": 600,
    "PostgresWaitTimeoutSeconds": 120,
    "OperationPollIntervalSeconds": 5
  },
  "RemoteJobs": {
    "Root": "/home/pi/candoitall/.mcp-state/jobs",
    "DefaultDetachedThresholdSeconds": 20,
    "RetentionDays": 14,
    "GracefulCancelSeconds": 10
  },
  "Revisions": {
    "Enabled": true,
    "KeepLast": 20,
    "BackupBeforeOverwrite": true
  },
  "Redaction": {
    "Patterns": [
      "BEGIN OPENSSH PRIVATE KEY",
      "root",
      "POSTGRES_PASSWORD=",
      "IPFS_SWARM_KEY"
    ],
    "ReplaceWith": "***REDACTED***"
  },
  "Targets": [
    {
      "Name": "rpi3-test",
      "Host": "192.168.10.191",
      "Port": 22,
      "User": "rpi",
      "Sudo": {
        "Mode": "sudo-n",
        "Command": "sudo -n"
      },
      "Auth": {
        "PasswordEnv": "CANDOITALL_RPI3_TEST_SSH_PASSWORD"
      },
      "HostKeyVerification": {
        "Mode": "fingerprintSha256",
        "Value": "SHA256:WPx5mLR4Z0P7xhg9Z1gpWDTqkNL2pS1dQjoeuFSM1qw"
      },
      "Paths": {
        "RemoteStateRoot": "/home/pi/candoitall/.mcp-state",
        "StacksRoot": "/home/pi/candoitall/stacks",
        "SecretsRoot": "/home/pi/candoitall/secrets",
        "AllowedRoots": [
          "/home/pi/candoitall"
        ]
      },
      "Docker": {
        "ComposeCommand": "docker compose",
        "RequiredNetworks": [
          "proxy"
        ],
        "DefaultLoggingDriver": "local"
      },
      "Traefik": {
        "StackName": "infra-traefik",
        "ResolverName": "local-selfsigned"
      },
      "Validation": {
        "PublicAppHost": "192.168.10.191",
        "DefaultHealthPath": "/health",
        "CertificateDomains": [
          "192.168.10.191"
        ]
      },
      "Guards": {
        "AllowBootstrap": true,
        "AllowComposeExec": true,
        "AllowRawExec": true
      }
    }
  ]
}
